"start":20701,"end":20709}],[{"start":20717,"end":20726}],[{"start":20764,"end":20780}],[{"start":20798,"end":20819}],[{"start":20858,"end":20872}],[{"start":20904,"end":20951}],[{"start":20959,"end":21029}],[{"start":21047,"end":21055}],[{"start":21087,"end":21183}],[{"start":21215,"end":21230}],[{"start":21248,"end":21294}],[{"start":21302,"end":21364}],[{"start":21409,"end":21464}],[{"start":21495,"end":21502}],[{"start":21534,"end":21543}],[{"start":21574,"end":21604}],[{"start":21622,"end":21720}],[{"start":21752,"end":21801}],[{"start":21832,"end":21856}],[{"start":21888,"end":21921}],[{"start":21952,"end":21974}],[{"start":22006,"end":22030}],[{"start":22062,"end":22149}],[{"start":22180,"end":22187}],[{"start":22219,"end":22244}],[{"start":22306,"end":22314}],[{"start":22338,"end":22341}],[{"start":22349,"end":22369}],[{"start":22377,"end":22419}],[{"start":22451,"end":22457}],[{"start":22475,"end":22563}],[{"start":22571,"end":22582}],[{"start":22590,"end":22600}],[{"start":22610,"end":22611}],[{"start":22621,"end":22668}],[{"start":22709,"end":22728}],[{"start":22736,"end":22782}],[{"start":22790,"end":22841}],[{"start":22910,"end":22951}],[{"start":23014,"end":23036}],[{"start":23078,"end":23094}],[{"start":23126,"end":23181}],[{"start":23243,"end":23277}],[{"start":23340,"end":23349}],[{"start":23385,"end":23403}],[{"start":23421,"end":23427}],[{"start":23489,"end":23509}],[{"start":23578,"end":23586}],[{"start":23618,"end":23631}],[{"start":23649,"end":23692}],[{"start":23723,"end":23727}],[{"start":23751,"end":23798}],[{"start":23806,"end":23839}],[{"start":23848,"end":23849}],[{"start":23858,"end":23916}],[{"start":23924,"end":23938}],[{"start":23947,"end":23948}],[{"start":23957,"end":23989}],[{"start":24021,"end":24029}],[{"start":24047,"end":24065}],[{"start":24132,"end":24147}],[{"start":24161,"end":24162}],[{"start":24171,"end":24207}],[{"start":24220,"end":24221}],[{"start":24231,"end":24242}],[{"start":24250,"end":24288}],[{"start":24306,"end":24361}],[{"start":24369,"end":24433}],[{"start":24498,"end":24515}],[{"start":24553,"end":24568}],[{"start":24629,"end":24659}],[{"start":24670,"end":24679}],[{"start":24742,"end":24778}],[{"start":24810,"end":24813}],[{"start":24874,"end":24950}],[{"start":24958,"end":25004}],[{"start":25022,"end":25059}],[{"start":25067,"end":25121}],[{"start":25129,"end":25214}],[{"start":25277,"end":25308}],[{"start":25346,"end":25376}],[{"start":25437,"end":25463}],[{"start":25471,"end":25570}],[{"start":25578,"end":25647}],[{"start":25655,"end":25843}],[{"start":25851,"end":25957}],[{"start":25965,"end":25976}],[{"start":25984,"end":26048}],[{"start":26056,"end":26095}],[{"start":26103,"end":26247}],[{"start":26255,"end":26277}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_027.ks","basename":"SC_M_027.ks","indexIds":{"「わかってるよ、彼の事は任せ給え。[l]\n二人とも":0,"呉":1,"呉も自重自愛し給えよ。[l]\nさ、少年、後部座席に移って身を伏せるのだ」":2,"そう言って道具さんが僕の肩を叩いた御陰で、\n":3,"漸く我に返った。":4,"「え？[l]\nだって二人は」":5,"確かに僕は腕力に自信のない非体育系男子だが、\n幾ら何でも女子高生二人にそんな危険な事をさせて\n自分は安全地帯に留まるというのは……":6,"「よ、様子を見に行くなら僕も行きますよっ！」":7,"じゃないと僕が今日呼ばれた意味が無いであろう。":8,"「駄目」":9,"「それは駄目にゃ！」":10,"二人が同時に僕に対し拒否の言を発した。[l]\n戸惑う僕に道具さんが言う。":11,"「大丈夫だよ。[l]\n彼女達の事は聞いてないのかね？」":12,"「は？」":13,"「まあ何にせよ、\n君に何かあった時の方が問題なのだ。[l]\n心配は要らない、万が一の時は僕も加勢するさ。":14,"大したことはないと思うが――\n重ねて言うが克杖くん、姫様くん、深追いはするなよ。[l]\nご覧の通り彼が心配するからね」":15,"「解ってる。[l]\n確認するだけ。[l]\n――キンキュウだししょうがないです」":16,"「積極的な害意があるにゃら、\nとっくに何かしてきてるにゃろうしな」":17,"「ィカリを忘れずに」":18,"「え？[l]\nあ？」":19,"怒り？":20,"「ああ、少年は気にしなくて結構。[l]\nこう視えて彼女達はこの土地の者だよ。[l]\n信頼してあげてくれ給え」":21,"「え、慣れてるからとかそういう話とは何か違う気が……」":22,"いや、":23,"先":24,"刻からの彼女等の応対を視る限り、\n確かに手慣れた感じと言うか、決して初めてじゃないのであろうが、\n……それはそれで不可解な事だけども、":25,"「彼女達はその為に居るからね」":26,"「？[l]\nそれは、」":27,"「さっさとうごけ、ばか」":28,"既に車外に出ていた狩屋が、運転席のドアを開けて僕を引き出した。[l]\nそして道具さんと僕を後部座席に押し込み、":29,"「（ぜったいに、\nこっちみんにゃよ！！[l]\nアタマ下げてろ！！！）」":30,"窓に顔を押し付けて、狩屋が『小声で怒鳴った』。":31,"二人は足早に木立の中に去っていった――らしい。[l]\nがさがさと音が遠ざかっていく。":32,"仕方がないので、足場の部分にしゃがみ込み、\n上半身はシートに向かって伏せるような体勢を取る。":33,"まるで避難訓練のようで、\nこう、\n据わりの悪い気持ちだ。":34,"勿論女子二人に任せっきりで自分がこうしている事への\n後ろめたさがそうさせてる一因でもあるのだろうが……":35,"そして再び静寂が訪れた。":36,"すると、道具さんが小声で話し出す。":37,"「（僕は現場担当じゃないんだよ。[l]\nあくまで後方支援、補助や補佐、便利屋のようなものだ。[l]\n僕一人では単なる器用貧乏と言い換えても良い）」":38,"「（現場って何の話、）」":39,"「（………）」":40,"だんまりを決め込んだのか、返事はなかった。[l]\n単に状況がそうさせたのかも知れないが、":41,"「（………？！）」":42,"数分、否、数秒後の事だった、":43,"刻のとも違う、\n蔵の中で聞いたのとも違う、\nどちらかと言えばあの、\n式の最中にきこえた脳に直接響くような、":44,"おぁああああああああああああああああああん":45,"オトがきこえた――":46,"すると、やはり、\n首が、熱くて、\nまた、\n止まる、":47,"意志とは無関係に、[l]\n身体が、[l]\n意志を離れる。":48,"耳も聞こえるし呼吸もしてる、が、\n自由にならない。":49,"うお、これ、は――":50,"「っぇあ、\nあれ？」":51,"彼の時とは違い、音が止むと僕の身体はものの数秒で平常に戻った。[l]\nな、なんだったんだ？":52,"「どうかしたかね？」":53,"「あいえ、何でもないです……」":54,"とは言え、状況が好転した訳ではない。[l]\n緊迫したまま無言の時間が過ぎていく。":55,"先刻道具さんは、\n恐らく大きな生物で、\n獣の類だと言った。":56,"その推論が正しいのなら、\n導き出されるものは、\n熊、狐狸、猿、精々が大きめの野良犬といったところだろう。":57,"真":58,"逆ヒトという可能性は、[l]\n……何とも言えない。":59,"況してや彼女達の眷属をころした何者かが\n居るのであろう状況下では、\nＵＭＡを想定するよりは余程現実的かも知れない。":60,"しかし、だとすると、\n彼女達はその為に居る――とはどういう事だ？":61,"こういう状況はよくあることで、\nそれに対する備えは常にしてある、\nと、\n平たく受け取ればそういう事なんだろうが、":62,"この場合は――幾ら何でもヒト相手ではないだろうと思うけど――\n危険野生動物への対処？[l]\nやや北方とはいえ、確かに動物は居るのだろうけども、":63,"狩猟をするにしたって、猟銃も何もないじゃないか。[l]\nそもそも所持の許可が……":64,"「怖いかね？」":65,"突然、道具さんが訊いてきた。":66,"「はい？[l]\nあ、いえ大丈夫ですが……[l]\n緊張はしてますけど」":67,"「恐怖とは何だと思う？」":68,"「過剰な想像力から来る不安だよ。[l]\n全てではないだろうがね。":69,"だが、想像力が無ければ不安というものに\n":70,"苛まれることはないという意味で、\n或る意味で説明にはなると理解頂けるだろうか。":71,"想像力豊かな人間というのは、\n常に諸刃の剣を振るっているに等しい。[l]\nここで言うのは生命の危機に際して感じる自衛本能とは\n少々違うのだが」":72,"その話はどこかで聞いたことが……[l]\nある気がするが、\nそれが今何の関係が。":73,"「想像力という資質を必要とするある種の人間は、\n常に大量の恐怖と戦わねばならないという代償を払っている。[l]\n勿論巧く添い遂げる才能を有する者も居るがね。[l]\nいずれ":74,"鼬ごっこではあるんだが、」":75,"そこで道具さんはこちらの顔色を":76,"窺い、\nすぐ視線を外して続けた。":77,"「受け入れるか徹底的に排除するか、\n一生ついて回るのだろうなあ。[l]\nさもなくば":78,"己が想像力を恒久的に欠く以外にないからね。[l]\nそれは『ある資質の一端』を欠くのと同義だから」":79,"「え、ええと、はあ……」":80,"言ってる意味は分かりますが意義が解らないんです。":81,"「肉体の資質、思考構造の資質、\n分かつことは出来ないしね、\nどっちにしろ難儀なんだよ。":82,"まあ煩悶があるが故に対処法としての手段を産んだ――\nいや、産む事もある。[l]\n塞翁が馬、因果の連なりは――\n後は、自分以外の思考主体と接し群れる事も割と肝要だ。":83,"自己思考のスパイラルに陥ると非常に厄介だ。[l]\nそれを避ける為の手段でもある――のかな」":84,"「な……何がです？」":85,"「例えば猫を飼うとかだ」":86,"ねこ……":87,"一瞬頭の隅の何処かが澄み渡るかのような、\n刹那の活性化をしたような感覚に見舞われたが、":88,"……恐らく最近、猫というキーワードに敏感になってるから[l]\nであろう。":89,"「猫は飼い慣らすの難しいですけどね……」":90,"「その通り。[l]\n犬のようにはいかないね。[l]\n飼うと言っても精々己の居住空間内にて\n餌付けするといった風情だろう。":91,"懐く程度のことはあるだろうが、\n完全に行動を律するのは困難だろうなあ。[l]\nさせたと思い込んでる方々も居るだろうがね、\n":92,"遍くそういうものは勘違いだ」":93,"「ううん、まあ、聞きますねそういう話も」":94,"今の状況では少々乗り辛い話題であるので、\nどうにもリアクションもぎこちなくなるし。":95,"仕方なく何故こんな話を……[l]\nと問うと、":96,"「この地は猫に深い":97,"縁があるのは知ってる、のだろう？[l]\n無聊の慰めになるかと思ってね。[l]\n少年なら理解出来るだろうと見込んだのだけれど」":98,"と仰った。":99,"うーん……":100,"実は姫様ちゃんと同類なんだろうかこの":101,"女":102,"性は。[l]\n勝手に僕に対し何かを期待なさってる気配が……[l]\n猫に関しても、意識的にその話題を選んだようだが、\n――何故？":103,"そしてそんな雑談にかまけていられるという事は、\n余程あの二人を信頼してるという事なのだろうか。":104,"「はあ、まあ、その、\nありがとうございます。[l]\n御陰様で……うーん、分からないことはないですけど、[l]\nあはははは……」":105,"愛想笑いでお茶を濁すほかなかった。":106,"「そう、笑いは":107,"佳きものだ少年。[l]\n場を":108,"弁えてさえいればね。[l]\nヒト以外では":109,"凡そ":110,"威":111,"嚇の意だがそれでよい。[l]\nそうそう例の、ニヤニヤ笑いを残して消えるのも」":112,"猫だね。":113,"「………」":114,"外つ國のお話にそういうのが確かに出てくる。":115,"が、ですから、[l]\n何で猫に拘るのでしょう。[l]\n何で僕にそれを話すのでしょう。[l]\nいやその、無聊の慰めだとは言われたけどもさ……":116,"僕としてはやはり姫様ちゃんと狩屋が気になるわけで、\nそんな僕の反応があまりにも鈍かった所為か、\n道具さんも駄話を続けるのを止したようだ。":117,"「ま、お":118,"為ごかしはそれ位にしておこう。":119,"君が最も今知りたいであろう事柄に関しては、\nそうだね、\nそのうち厭でも知る所となろうから――\n今僕の口から説明するのは止そう。":120,"それが皆にとっての愉悦となるだろう」":121,"あの、お":122,"為ごかしって、\nどっちかというと悪意めいて言ったって事ですか。":123,"後半も意味が分からないし、\nこの現状くらいは説明してくれても罰は当たらないと\n思うのです。":124,"「なー、なー、なー、なー……」":125,"突然鼻歌を歌い出す道具さん。[l]\n場が持たないのに耐えられなかったのか……[l]\nしかしリアクションに困る僕が更に空気を微妙にするのであった。":126,"「なー、なー、なななななな」":127,"……。":128,"心配要らないという事を":129,"殊":130,"更強調したいのかしらん。":131,"――。":132,"場は決して和まず、\nどうやら僕が一方的に気まずいだけの沈黙の後、\n暫くして、\n彼女達が戻ってきた。":133,"かなり長い時間が経ったと思っていたが、\n時計を視ると数分だったようだ。":134,"「見失った……にゃわ」":135,"「捕捉し損ねました……[l]\n確認も出来なかった……[l]\nこっちは無事……？」":136,"「こっちは何ともなかったよ、\nそっちこそ大丈夫？」":137,"「うむ、此方は何事もない。[l]\nトウビョウは？」":138,"「多分……」":139,"「どっかに行っちゃったけど\n積極的にこっちに興味は無かったようだし\n追跡は専門家に任せるにょう」":140,"「まあ、あまりにも急だったしね。[l]\n場の制約も多かったし気にすることはない。[l]\nキンキュウ時に深追いしても仕方ないだろうし。[l]\n身体の方は大丈夫かね？」":141,"「ばかにすんにゃよ……[l]\nこれでもカリヤの……コウケイにゃからな……」":142,"「私は大丈夫」":143,"何か二人とも血の気が引いてる感があるけど……[l]\n顔色なんて、漫画みたいに明確に分かるものではないから\n何とも言えない。[l]\nそれに、":144,"「け、警察に連絡しないんですか？[l]\nく、熊か何かだとしても色々何かその、して貰うべき事とかが……」":145,"「処置は適切に行われるよ。[l]\n少年が気にすることはない。":146,"三春の家は今デリケートな状況だし、\n――ま、\n僕等を含め三春の家には事態に対処する特権的な手段があるからね」":147,"「……は、はあ」":148,"何か質問と回答の間にもの凄い齟齬がある気がするんですが……[l]\nしかし、\n何か不穏当な内容を言われてる気配もそこはかとなくするので\n深く突っ込むのも止した。":149,"「まあまあ、\nここは黙って得られた安息を享受し給え。":150,"今はまあ、\nそうだね、\n好奇心猫を殺すと言うだろう。[l]\nこの地に於ける三春の影響力……今更知らぬ訳でもなかろうし」":151,"「え、や、その」":152,"「トモさん、\nその言い方はどうかとおもう……」":153,"「真言さんは怖がらなくても大丈夫」":154,"や、怖がってるというか……":155,"「ははは、\nそんなに身構えることはないよ。[l]\n少年が思ってるようなモノではない。":156,"姫様君が言ったように、\n君が憂慮するような事にはならないさ。":157,"さて、と。[l]\nとは言え警戒は必要か。[l]\n":158,"巧":159,"遅は":160,"拙":161,"速に如かず、で取りかかるとしようか」":162,"「う、は、はあ……」":163,"皆で当初の乗り配置に戻る。":164,"「運転大丈夫かね？」":165,"「僕は待ってただけですから大丈夫ですが……[l]\nほ、本当に良いんですか？[l]\n今日は止めとくとか、人を呼ぶとかしなくても良いと……」":166,"「大丈夫です」":167,"狩屋は無言だったが、\n事態を憂いているからではないようだった。":168,"極度の疲労というか、\n脱力というか、\n『問題は解決せぬまでも事態は掌握している』が故の、\n安心から来るぐったり感の様に視える。":169,"あくまで僕の主観だから何とも言えないが……":170,"そして姫様ちゃん、\n力強く言ってくれるのは有り難いのだけれど、\n彼女の言動は何かしらに偏ってる気がしてどうにも、\n言葉通りに受け取りづらい印象に……":171,"ほんと彼女には悪いんだけど。":172,"「ううん……まあ、わかったよ。[l]\n兎に角気をつけて運転します――\nこれこのまままっすぐですか？」":173,"「……回に限っては致し方あるまいね。[l]\n当主殿と選律君には連絡しておくよ。":174,"どうせ今回は特殊な訳だし。[l]\n":175,"栖":176,"後":177,"奉":178,"仕の本儀には流石に、\n彼を参加させることは出来ないしねえ。":179,"冬夏君が少々ナーバスなのが気になるが、\nまあ、明日学校に行けばすぐ土日休暇だ。[l]\n祭まで二週間だし色々としなければならない事が山積みだからね。":180,"――ん？[l]\nああ、御免。[l]\n何だって？」":181,"「兄ぃが、このまま道にゃりでいいかって」":182,"狩屋の様子を窺ったりと逡巡してるうちに、\n後部座席組、というか姫様ちゃんと何やら話し込んでいたらしい。[l]\n僕の声が聞こえていなかった道具さんに\nその狩屋がフォローしてくれた。":183,"「ん、そうそう。[l]\n記憶が確かならもうすぐの筈だがね。[l]\nちゃんとした駐車場は無いから現場に行ったら\n適当な場所を指定するよ」":184,"「了解です。[l]\nでは、出ますよ」":185,"周囲全方向に注意を傾けつつエンジンをかけ、\nリスタート。":186,"流石に車内に会話は無い。[l]\n道具さんはいつでも深刻そうな顔をしないので\nそれに救われてはいるが……":187,"先刻の話で言えば、\n恐怖とは過剰な想像力だという。":188,"僕個人の見解だと、\nつまり具象化された解答が視えないものに対して、":189,"いくつもの選択肢を考えるという行為、\nその行為の過程で生じるネガティブな解答、\nそれが恐怖、というか不安の一端なのかといった風なのだが、":190,"まあ他人とのコミュニケーションにおいても、\n沈黙をされるとどうすることもできない、少なくとも僕はそうだ。":191,"幸い母さんを始め大神とか宮さんとか、\n身の回りには頼みもしないのによく喋る手合いが多いので\n普段は気にならないが、":192,"電話に出ないとか、メールで返事が遅いとか、\n状況の改善は相手次第という状況に於いて、\n沈黙或いはノーリアクションというのは決定的に、\n僕が僕自身を":193,"苛む要素となる。":194,"いらぬ想像が為されてどんどん気が滅入る。[l]\nそういう意味で僕は確かに想像力の過剰な部類に\n入るのかも知れない。":195,"ただ、いつも脳が空転してるので\n寝て忘れて何とか遣り過ごしてるだけだ。":196,"だから、そう、\nたとえその理由がキライだろうとイヤだろうと、\n明瞭に解答――反応を示してさえくれれば、\n寧ろ安寧を得られる場合もあるだろう。":197,"しかし、沈黙、[l]\n解答の視えない状況、[l]\n身の振り方が判然としない状態、\nそれは――":198,"「そう言えばええと、二週間後予定の祭ですけど、\nやっぱり延期順延は無いんでしょうかね？」":199,"会ってそれほど間もない間柄……否、だからこそかも知れないが、[l]\nどうにも沈黙に耐えられなくなり何とか話題を探し出して話を\n振ってみる。":200,"先程の道具さん達の会話から漏れ聞こえ思い出したのだが、\n一応念押しの為に訊いてみたのだ。[l]\n道具さんが決定権持ってる訳じゃないだろうが。":201,"まあ、場繋ぎの話題だし。[l]\n恐らく祭は強行される気配が濃厚だと宮さんも冬夏のおっかさんも\n言ってた訳だし。":202,"「ん？[l]\nそうか、旅行者の君にとっては重要事だね。[l]\n君は冬夏君の御母堂にも会ったのだろう？」":203,"「ええ、一応……」":204,"「彼女の言ったとおりだよ。[l]\n計画通り":205,"恙":206,"無く事が進められるべく僕等は動いている」":207,"「成る程、\nいや、楽しみにしてます。[l]\nこの旅行の目的はまさにその祭ですから……」":208,"「一月前から長期滞在までしてくれてるのだからね、\nこちらも善処するよ。[l]\nだろう？[l]\n君達」":209,"「……はい」":210,"「……おういえー」":211,"「まあ、残念な点があるとすれば、\n当日我々は少年とデェトする事が出来ないという点かな……[l]\n主催運営神事執行の側だからねえ」":212,"「いやいやその、\nお気持ちだけ受け取っておきます……」":213,"実際僕も、調査の進展によってはやらねばならない事がある。[l]\n色んな意味でなるべく穏便に事は進めたいけど……":214,"「……ょうぶ」":215,"「んに？」":216,"「ああ、其処の広い所に停めてくれ給え」":217,"「あっと、はいはい」":218,"格別眼前が開けるわけでもなく、\n山中のどん詰まりのような場所に到着した。[l]\n奥に続く道はあるようだが、車では厳しそうだ。":219,"この辺りで四月中旬の山中では、\n流石に草がぼうぼうとまではいかないが、":220,"手入れをしてある気配はなかった為、\n頻繁に人が立ち入る事はないであろうという事情は\n伺える。":221,"まあ、三春の私有地にわざわざ入り込もうなんていうのは、\n……本家の人等とかか。":222,"実際に秘された祭儀を行うのは此処でなくて、\n九抱山となる訳だが、\n果たして向こうはどんな感じなのだか。[l]\n此処以上の山奥だろうしなあ。":223,"「では作業に入る前に、\n結界を解かなければならないのだ。[l]\nまあ来給え」":224,"「け、結界？」":225,"姫様ちゃんと狩屋は何も言わない。":226,"四人揃って少し進むと、\nチェーンやら鉄条網やらが朽ちた柵に張り巡らされた格好で\n配備されており、":227,"その少しだけ奥には\n注連縄らしき……\nらしきというのは":228,"紙":229,"垂の形が少々特殊に見えるからで、":230,"それに加えて三春の家にあったいやに丈の高い\n――とは言え周りの木々には劣るが――\nこれまた様式のよく分からない鳥居らしきものが立っていた。":231,"僕が神妙にそれを視ていると、\n":232,"道具さんは手前のバリケード状のそれを、\n鍵らしきものを使って開けた。":233,"「結界を解く……て、[l]\nああ、少々違うものを想像してました。[l]\nそういうことですか……」":234,"誰かの影響って訳ではないが、\n今時分に結界がどうの、と聞くとどうにも、\n超常的というか、漫画的なものを想像してしまう。":235,"「ああ、まあ少々鯱張った言い方だったか。[l]\n結界解除である事に変わりはないのだがね。[l]\nところで――」":236,"と、道具さんは狩屋の方を向いた。":237,"「姫様君は兎も角、\n克杖君、今日も静かだなあ、\n僕と一緒じゃ緊張するかい？」":238,"「にっ？！[l]\n":239,"いあ、べ、別にそんにゃことは……」":240,"「彼女はあれで礼儀正しくて古式ゆかしい、\n加えて内気で人見知りのする学校では優等生なんだな。[l]\n身内とは言え僕のように年に数回しか会わない人間の前では\n萎縮してしまうようなんだ」":241,"と今度は僕の方を向いて言う。":242,"え、此奴が礼儀正しくて？[l]\n古式ゆかしい？[l]\n内気で人見知り？[l]\n萎縮？？":243,"僕ぁ初見にもかかわらず、\nいきなり強烈な罵声を浴びせられておりますが！？":244,"「君の前では結構砕けてるんだろう？[l]\n妬けるね」":245,"いやいやいや、\n単に姫様ちゃんと僕の妙な過剰接近に対する防衛反応というか、\n妙な言い方だけど『恋敵』と思われたからではないかと……":246,"「………か、杖……」":247,"「にゃ！[l]\nちょ！[l]\nちが！」":248,"この場合、味噌糞に僕を貶すのも或る意味で道具さんの言を\n肯定する事になってしまうからか、\nそれ以上何も言えない狩屋。":249,"僕もいちいち反応して居られない、と言うかね、\nもうそう言う弄りは足りてるんです。[l]\n大体、結構状況は緊迫してた筈じゃないのか。[l]\nそれとも本当に、既に懸案事項じゃないのか？":250,"「まあ、愉快な雑談はそこまでに、\nほら、\n":251,"速に如かずって\n御自分で仰ってたでしょう」":252,"「分かった分かった。[l]\n済まないね、克杖君姫様君」":253,"僕には何も謝辞は無いのね。[l]\nいいけどさ別に……":254,"さて、\n３人は揃って鳥居……\n便宜上、もうそう呼んでしまうが、その下に立ち、[l]\n上方に顔を向けて黙祷をしているようだった。":255,"遅れて僕もその横に並び、同様に":256,"倣う。":257,"「……？[l]\nな、何か特殊な作法とかあるんでしょうか？」":258,"口の中でもごもごと何かを唱えてるようだが、\n流石に初見でそれを模倣するには無理がある。":259,"「ミ・キャミャルキャラモロコネコナメタサキャラ\nタサコネタサメミャラメンカヤコネキャ・ワ。":260,"作法ねえ……まあ、[l]\n少年は取り敢えず聖域に入る心構えを観想すれば":261,"佳い。[l]\n今言った":262,"文":263,"言覚えろと言っても酷だしねえ」":264,"「あれ、そ、それは――」":265,"あの式の謎言語……":266,"チノ嬢も何かに付け言ってくるみゃんみゃんにゃんたら、\n全部同じに聞こえるし、彼女が言ってたのと同じ文字列かどうかは\n僕の記憶力では参照出来ないけども……":267,"「聞いているとは思うが、\nこの文言の構成言語に関して具体的な解析を試みるのは\n止した方が賢明だ。":268,"ましてこの聖域下に於いてそのような所業……[l]\n考えただけでもぞっとしないね」":269,"「や、了解してますよ、\n僕もこれで敬虔な人間なのです」":270,"にしても、\n『そっち』方面を嗜好してる割に、\nこの手の正式な作法を心得てる訳ではない僕がみても、\nあまり視ない作法だと思う。":271,"個人の屋敷神である事とか、例の謎言語を使用してる時点でまあ、\n余所とは違うんだろうけど、\nそれとあとは略式なのかもな。[l]\nそもそも参拝じゃあないんだけど。":272,"取り敢えず何となく目を瞑り、\n何となく心中で拝んでから、\n眼を開き彼女達に頷いた。":273,"「克杖君、ここからは折角だから君が説明するかい？[l]\n僕がしゃしゃり出なければ元来君の役目だったのだろう、\n":274,"屹":275,"度」":276,"「にゃ、べつにそこまで決めてたわけじゃ……[l]\n":277,"き、きーちゃ？」":278,"「道具さんお願いします」":279,"「はいはい、了解したよ。[l]\nさて、少年の為に一度、斎場に行こうか。[l]\nそれとも二人はもう車から荷下ろしするかね？」":280,"狩屋もそういうポジションぽいけど、\n僕まで何かこう変な板挟みになってる感がすごいしてるんですが。[l]\n道具さんが変な梃入れ……それは逆だ、ええと、[l]\n不和のリンゴを放るような真似ばかりするからなあ。":281,"もっと普通の表現があったような気がするけども、\n何故か今は浮かんでこないのだった。":282,"――こんなだから道具さんやらに、\n『そっち方面』の嗜好と思われるんだろうかなあ。":283,"「……私も行きます」":284,"「すぐ近くにゃしういも行くにょう」":285,"「ん。[l]\nではいざ行かん。参られい」":286,"「は、お手数おかけします」":287,"結局４人でぞろぞろ移動を開始する。":288,"鳥居の下を":289,"潜ると、\n在るのか無いのかギリギリの存在感の石段らしき平らな石が\nそこはかとない間隔で敷かれており、\n一端下り坂になった後その倍程の高さを頂点とする上り坂となった。":290,"これも寡聞にしてあまり視ない様式だが、\nまあ神社そのものではないからかも知れず、":291,"――それよりもこの道程、\n距離的には確かに大したことはないが、\n廃材持って往復するには結構な険しさだと思うよ……":292,"石段、と言うよりも坂を登り切ると、\n平らではあるが決して見晴らしの良くない、\nややすり鉢状になった場所に出た。":293,"其処には社なんだか社務所なんだか、\nはたまた倉庫なのか判然としない微妙な小屋があり、\nその前にはまた細い縄に紙垂を付けたものが、\n等間隔に十本、円形に立てられた棒に張られていた。":294,"その縄によって囲まれた円の中は、\n確かに何かを燃やした様な煤らしき黒い":295,"滓やらが視える。[l]\nたき火かキャンプファイアーの跡とでも言おうか。[l]\n三春家の庭や登り口にあった鳥居は此処には無かった。":296,"にしても、\n天気はかなり良いのに、\n此処は上方をも樹木が覆いつくし、\n木漏れ日がぎりぎり降ってくる程度だ。":297,"針葉樹林なのでこの時期この地方でも、\n恐らくは年中こんな雰囲気なのだろうと見受けられる。":298,"「さて、この結界も今解くのでね。[l]\nあの中心に廃材を放ってくれればよいと言うわけだ。[l]\n諒解して戴けたかね少年？」":299,"「あ、はい、分かりました」":300,"「じゃあ少々其処で待っていてくれ給え。[l]\n今結界を解く」":301,"「ふぅー、ち、近いと思ってたけど、\n結構しんどかったにょう……[l]\n歳かにゃあ……」":302,"少々遅れていた狩屋と姫様ちゃんが僕の横に並んだ。[l]\n狩屋、言い出してついて来たは良いが、\n息あがっとるがな。":303,"姫様ちゃんは……いつも通りの表情……[l]\nしんどそうと言えばしんどそうではあるけど……":304,"「後で増血食しよう」":305,"「にゃっ♪\nらにゃー！[l]\n":306,"きーちゃん家で、兄ぃが帰ってからにゃな」":307,"「……うん」":308,"ん、何か微妙に険のある会話が聞こえてきてるんですが……":309,"姫様ちゃんと眼が合った。":310,"「あ──、\n":311,"その、御免なさい」":312,"「？[l]\nあ、いやいや、何も言ってないし……」":313,"「そっちは美味しくないので……[l]\n真言さんとの食事の後で私達だけで」":314,"「栄養補給にゃっ。[l]\nじょ、女子にはいろいろあるざます」":315,"「や、だから何も言ってないから……[l]\n別に気にしてないし。[l]\nお前の口調が変な事の方が気になるわ」":316,"「そんな、ず……」":317,"「や！だから！[l]\n他意はにゃいの！！[l]\nそろそろわかってきーちゃぁ！！」":318,"それは僕も言いたいのですが……[l]\nいや、だからって姫様ちゃんが\nスキとかキライとかそういう事でも\nないんだけど。":319,"「そ、それよりもほら道具さんの作業も済んだようだし！[l]\n戻ろう！[l]\n仕事仕事！」":320,"視線の先には確かに縄の一部を解き終えて\n戻ってくる道具さんが。":321,"しかし、":322,"「ほら、やっぱり君等は気が置けない仲じゃないか。[l]\n妬けるねえ」":323,"だあああ。[l]\n今事態を収束させようとしてたんですがぁ！":324,"──結局、\n恨めしげな姫様ちゃんとそれを必死で宥める狩屋、\n煽るだけ煽ってあとはほったらかしの道具さん、[l]\nいつものように流されるままの僕。":325,"多少":326,"謀ってるとは言え、\n別に敵対してるわけでもないし、\n懐柔策としては良い傾向なんだろうけども、":327,"こんなに":328,"長":329,"閑でいいのか。[l]\nそれとも今だけなのだろうか。":330,"まこくんはいまたのしい？":331,"──どうだろう。":332,"……あと二週間か。":333,"「こ、今度こそ車行きましょうか」":334,"気を取り直して、\n車へと戻る我々。":335,"道中でもまた道具さんが言う。":336,"「実際の行為は兎も角として、\n女子っていうのはこの手の話でご飯何杯でもイけるんだなあ。":337,"こう視えて僕も女子の端くれだからね。[l]\n愉快を信条にしている以上、\n弄れる機会は逃さぬよ。[l]\n特に君は──」":338,"な、なんですか。":339,"「そういう星の下に生まれているようだし。[l]\n恐らく常日頃そういう環境に居るのだと見受けるがね。[l]\n何か強力な女子の匂いが君を包んでいるぞぅ。[l]\nうひひひひ」":340,"「その笑い止めてください……」":341,"心当たりが……約一名、思いっきり居ますし。[l]\nてか何でピンポイントでその笑い方？":342,"背後から迫る姫様ちゃんの視線の方が今は強力な\nプレッシャーとなっていますゆえ、\nとっとと作業に入りましょう。":343,"と言う訳で、\n車まで戻ると、何とか平静を取り戻した狩屋が、\n早速座席の方から何かを放って来た。":344,"「これ、軍手」":345,"「ああ、さんくす」":346,"「あーいきーちゃ、これっ。[l]\nで、これトモさん」":347,"姫様は無言で軍手を受け取り、それをはめる。[l]\n何か僕の、如何にも使い古しくさいこの汚れ軍手とは\nえらい違う真新しいやつですな。[l]\nまあ女子ですし別にいいんだけど……":348,"「まああれだ、\n手伝うと言っては来たがね、\n実労働力としては期待しないよう頼むよ」":349,"「まあ……そもそも兄ぃをこき使う予定にゃったし」":350,"「いやいやお前、\n僕も道具さんと同じ事を伝えただろう昨日」":351,"「男子と女子じゃ根本的に体格差があるにゃろ」":352,"「今時流行らんぞ、男らしくとか女らしくとか……」":353,"「ふむ、そうだねえ。[l]\nしかし男女の性差は機能や仕様の差以外では\n個体差とでも言おうか、\nジェンダーを語るにしても気を使わねばならない御時世……」":354,"「いあ、その」":355,"「そんな小難しいことを話していた訳ではなくですね」":356,"「……みなさん」":357,"うっ。":358,"僕等３人はそそくさと準備に取り掛かった。":359,"あんな……な眼で視られたらなあ……[l]\n狩屋じゃないが思わず身が竦みます。":360,"「さて──」":361,"此処から彼処まで廃材を運ぶわけね……[l]\n一個一個がそんなでもないとは言え、\n距離もそんなではないとは言え、\n道程のコンディションがなかなかに厳しげ。":362,"まあ、覚悟決めるかぁ。":363,"こういうのは流されて":364,"只":365,"管無心にやるに限るんだ。[l]\nと、\n今回の一連で僕が得た境地のひとつですよ。":366,"そして、体感的には一時間あるかないか。":367,"結局、\n動いてしまえばあっという間というか、\n案ずるより産むが易しというか。":368,"作業自体は心得通り、無心でやってるうちに終わっていた。[l]\nそもそも只の運搬作業ではあるし。":369,"「ああー、終わった終わったぁ。[l]\n明日筋肉痛とかなりそうだなこれ……」":370,"「兄ぃってばもうだらしにぇえにゃあ。[l]\n":371,"やっぱ歳かにょう、いやだいやだ」":372,"「お前が呼び出したん…う、[l]\nいや、そのちがうんです、姫様ちゃんが悪いと言ってるわけではなくて！」":373,"「……私はだいじょうぶです。[l]\n──自信がありますから」":374,"「あわわわわ……んぬ、":375,"んお？[l]\nにゃ、にゃん」":376,"何のですか？":377,"「──あなたに………れない……自信……」":378,"「……にゃ？？」":379,"「や、僕を視るなって……」":380,"狩屋が『理解不能』という表情をしてこっちを向いたが、\n僕にも聞こえてなかった。":381,"「……」":382,"はにかみとニヤリの中間くらいの表情で姫様ちゃんは、\nとことこ歩いてきて僕の横についた。":383,"思わず身構えてしまう間もなく狩屋が割って入り、\nその反動で":384,"蹌":385,"踉ける僕、\n焦って僕の腕をがっしと掴む狩屋、\nどの行為に対してかは定かではないが息を呑む姫様ちゃん、":386,"という混迷の様相を呈す僕等を":387,"余":388,"所に、\n再び結界を張り終えた道具さんがこちらを振り返る。":389,"「んっ。んんっ」":390,"咳払いをし僕等が静止するのを待って、":391,"「大儀であった皆の衆。[l]\n":392,"諸":393,"姉の御陰で無事に職務を遂げた。[l]\nさてさて、そこな助っ人、\n":394,"此":395,"度の働き真に上々なり。":396,"よって褒美を遣わすぅ。[l]\n──そうだね？[l]\n姫様君」":397,"あってるのかあってないのか僕にも判別つきかねる\n時代劇がかった口調、そして大仰な舞台芝居的所作で言う。":398,"で、最後の言葉を振られた姫様ちゃんが、\n作業の所為か、先程までの遣り取りの所為なのか、\nやや上気した顔で言った。":399,"「はいっ、私を、……違う。[l]\n":400,"私の……家で、お昼ごはん……」":401,"「プラス、アルファがあるわけだねえ。[l]\n克杖君も":402,"漸く報われる訳だ」":403,"「にゃ、や、やだにゃあ……[l]\nそんにゃことは……おほほほほ」":404,"「？」":405,"「ん？[l]\nああ、克杖君にとっても眼福とでも言おうか、\nまあ報酬と言うのは人それぞれであるから、\n説明するのは難しいのだがね。":406,"同一事象に対して少年がどう思うかは君次第だし、\n取り敢えずその都度判断してくれ給え」":407,"……眼福。[l]\n目の保養って事ですか？[l]\nにゃんで？":408,"は！[l]\nま、まさか……何かしらイカガワシイ……[l]\nいや、しかし女子にとってだから……":409,"でも狩屋にとっての……場合はどっち？[l]\nどっちでもどうかと思うけど……[l]\nいやいや、そもそもそんなこと自体ですな、\n想像する方が間違って、":410,"「おい！兄ぃ！！[l]\nぼーとしてんにゃ。行くにゃよ」":411,"「あ、あれっ？[l]\nおあ、待った待った今行くって」":412,"知らぬ間に移動を開始していた３人を慌てて追い掛けた。":413,"うーん、\n僕も宮さんの攻撃のおかげで随分枯れたと思ってたが、\nどうやらそうでもないのか。[l]\n幸か不幸か知らないけども……[l]\nや、そんなことはどうでもええねん。":414,"何はともあれ、\n過度な期待……いやいや、妄想は受け流し！[l]\n彼女の家、\n『嘉多里辺茶屋』にて\n昼食だ。":415,"それと──[l]\n@r本作業……本儀式とやらは僕は関与出来ないらしいからなあ。[l]\n調査の観点から言えば、\nそっちにも参加させて貰えるに越したことはないのだろうが、\n明確に僕に対し言った訳ではないにせよ、\n既に道具さんが釘刺し発言してるし、\nそれはここまで僕を身内扱いしてる人間が\n駄目だという領域という事になる。":416,"そこにはなかなか踏み込めなさそうだし、\n……狩屋にとっての眼福が何なのかは兎も角、[l]\n何かしら宮さんに報告できる情報が得られればいいんだ、\nけ、ど、も──\n……会食だものなあ。":417,"帰りも僕の運転である。":418,"行きにあんな事があったので、\n相当気を遣い、周囲に気を配りながら、\n安全、且つ迅速にその場を抜けるように走った。":419,"幸い、何事もなく舗装された車道に戻ることが出来、\n僕の肩の力も抜けた。":420,"他の３人は少々無口ではあったが、\n怖がったりとか、そういう感じではなかった。[l]\n先刻もそうだったけど、\n警戒心は解いてないがよくあることだから\n必要以上に気にはしない──\nそういった感じの態度で、\n極めて落ち着いていた……ように視えた。":421,"あくまで、神経質になっていた僕の主観だけど。":422},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_027.ks","relPath":"/data/scenario/SC_M_027.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":423,"length":423,"percent":100},"cellInfo":[[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"t":"HU"}],[null,{"v":1}],[null,{"t":"HU","v":1}],null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"t":"HU","v":1}],null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"t":"HU"}],null,null,null,[null,{"t":"HU","v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],[null,{"t":"HU","v":1}],[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"t":"HU"}],null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,null,[null,{"v":1}],null,null,[null,{"t":"HU","v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[79,1],"note":"完成"},"/data/scenario/SC_M_028.ks":{"data":[["以前一階の土産屋部分には入ったことがあるので\n初見という訳ではなかったが、\n二階の語り部フロアには初めて入る。[l]\nこういう古民家系は、『ねこざんまい』とか本家とか、\n実生活に実際存在してた物だから、\nこう、格別日常と差異を見出しにくいというか、\n既視感がばりばりでよくわからなくなるんだなあ僕の場合。","以前进过一楼的土产店部分，\n所以不算初见，\n但二楼的说书楼层是第一次进。[l]\n这类古民宅风格的，像『猫三昧』啦本家啦，\n实际生活中本就存在，\n该怎么说呢，特别难与日常区分开来，\n既视感强烈到我完全搞不清状况啊。"],["と言うか、食事処も二階にあるとは気付かなんだ。[l]\n只でさえ空転脳の所持者たる僕、飯窪真言、\n前回はその存在が分からなかったのですわ。[l]\n看板には民芸話の公演時間と料金しか書いてなかったし……[l]\n──否、よく見れば、それにも張り紙がしてあった。[l]\n今はそちらは中止してる、らしい。[l]\n忌中につき……か。","或者说，都没注意到餐厅也在二楼。[l]\n本就大脑空空如也的我，饭洼真言，\n上次根本不知道它的存在呢。[l]\n招牌上只写着民艺故事的演出时间和票价……[l]\n——不，仔细看的话，那里也贴着告示。[l]\n现在那边似乎暂停营业。[l]\n因在服丧期间……吗。"],["しかし、祭は決行しようとしてるわけだ……","然而，祭典却打算照常举行……"],["人死にがあった正確な日時は僕も知らないが、\n祭りは月末だから、起きた日によってはぎりぎり忌明けしてる\nかも知れないが……[l]\n知狡さんが情報を仕入れた日イクォールだとすると、\n喪は四十九日ある訳で、\nまだ忌中の最中に祭を行うという事になる。","虽然我也不清楚确切的死亡日期，\n但祭典在月底，按发生日期算或许勉强赶得上丧期结束\n也说不定……[l]\n若以知狡阿姨获取情报的日子为基准，\n丧期有四十九天，\n那就意味着要在服丧期间举办祭典。"],["こういう場合、\n神事仏事一般的にどっちを優先させるのかは知らないし、\n一般化しても仕方ないのだろうが、\nどうにも彼女達の祭りへの執念ともいえる態度は\n部外者から視れば不思議に思えなくもない。[l]\nそしてそれを見越してる本家、宮さん達。","这种场合下，\n神事佛事一般会优先哪边我是不清楚，\n即便归纳共性也无济于事吧，\n但她们对祭典堪称执念的态度\n在外人眼里难免觉得不可思议。[l]\n而对此早有预料的本家与宫司们。"],["双方、一体何をしてるのか、否、したいのか。[l]\nその","双方究竟在搞什么，不，是想搞什么。[l]\n被卷进"],["直","这场风波"],["中に駆り出された僕は、\nそれこそ一体、何をしてるんだろうかなあ。","正中心的我，\n说到底又到底在干什么呢。"],["「話を担当する土地の古老にはね、\n多少出入りを遠慮してもらう事態……になったが故なのだよ。","「负责讲解的当地老人们呢，\n多少也要回避出入的场合……也是无可奈何。"],["本来ならば祭の観光客を大量に捕まえられるタイミングなのだが\n致し方あるまいね。[l]\nまあ、当日辺りはどうなる…のかな？[l]\nそこまでは僕も関知してないのだなあ」","本来正是能吸引大批祭典观光客的时机\n但实在没办法呢。[l]\n嘛，当天会怎样…呢？[l]\n那部分我也没掌握详情啊」"],["その人達は三春の眷属というより、雇われのような距離感らしい。[l]\n長く歴史を持つ割に、実際の血縁者はそんなに居ないのだ。[l]\n少々不思議な事ではあるな……","那些人与其说是三春眷属，更像是雇佣关系的疏离感。[l]\n明明历史悠久，实际有血缘关系的却没几个。[l]\n多少有点不可思议啊……"],["今朝の道具さんの話だと、三春の眷属──つまり東西併せた七家も、\n血縁集団同士ではないと言う事だし……[l]\n過去に三春という本家があり、\n分家に分かれたという訳ではないのだ。","今早道具小姐说过，三春眷属──即东西合流的七家，\n并非血缘集团同士的关系……[l]\n过去虽存在三春本家，\n但并非分家独立的形式。"],["うーん、\nまあ、伝統、しかもカミサマがらみとあっては、\n個々の事情もあるし、さっき思ったように\n一般化など出来ないのだろう。","唔——\n嘛，传统、更何况涉及神明之事，\n各家自有隐情，正如方才所想\n终究无法一概而论吧。"],["長い歴史があるならば、\n逆にそれだけ変遷を経る期間があったという\n事で、その時々にしか分からない理由で何かがあったのかも知れず。","既然历史悠长，\n反倒说明有足够时间经历变迁\n或许存在某些唯有特定时期才能理解的缘由。"],["「で、今ここを仕切ってるのは姫様君の姉、\n","「所以现在这里主事的是姫様的姐姐，\n"],["運君という訳だ。[l]\n勿論三春の家がバックアップはしてる筈だがね。","也就是运小姐。[l]\n当然三春家应该提供了后援。"],["まあ姫様君に負けず劣らず……否、姉だから順序は逆かもだが、[l]\n兎も角気の強いしっかりした女子だよ」","嘛比起姫様也不遑多让……不，因为是姐姐或许该反过来说，[l]\n总之是个强势能干的姑娘哟」"],["「はあ……でも食事処は大丈夫なんですか？[l]\n従業員とか……」","「哈啊……但食堂没问题吗？[l]\n员工之类的……」"],["「だいじょぶですよー」","「没问题的啦—」"],["「んだにゃあ。[l]\n腕のいい人がいるからにぇ」","「当然喵。[l]\n因为有好手艺的人在嘛」"],["「少数精鋭なんですよー」","「走精兵路线啦—」"],["「きーちゃと在夜っちの家はにゃな、\n昔からそうにゃん。[l]\nコスト削減にぇ」","「小姬和在夜家向来喵，\n就是这么运作的喵。[l]\n节省成本嘛」"],["「少ない労力で大きな効果ですよねー、\nローコストハイリターンですよー」","「以少博多很划算啦—\n低成本高回报哟—」"],["その言葉、","这说法"],["遣い方合ってるのかな……[l]\nまあ、言ってることは分かるけど。","用得对吗……[l]\n嘛，意思倒是明白。"],["うーん、\n……言っちゃ何だが、","唔——\n……说来可能失礼，"],["玄ノ森は観光地としてそれなりに人出はあっても、\n","玄之森作为观光地虽有一定客流，\n"],["件の祭の時がメインだろうし、\nオフィス街でもないから年がら年中外食ランチの客が、\nという状況はあまりないのだろう。","但主要靠那场祭典撑着，\n又不是商业区哪来全年不断的午餐外食客，\n这种情况应该不多见吧。"],["それこそ先日行ったあの定食屋とか、\n初日のドライブイン的ラーメン屋とか、\n学生か運搬業者さんの御用達の店というなら判るが、","要说前几天去的定食屋，\n或是首日路过的那种公路餐馆风拉面店，\n作为学生或运输业者的定点食堂倒能理解，"],["それらにしたって客層故に通学路か大通り沿いにある訳で、\n此処のように、明確な観光拠点の中の食堂では余程の事がないと\n店員を沢山抱える理由もなさそうではある。","但那些店也因客源特性开在通学路或主干道旁，\n像这种明确作为观光据点的食堂，除非特殊情况\n似乎没理由雇太多店员。"],["事実そういう理由かどうかは知らないが、\n……収容人数もそれほどのキャパじゃなさそうだし、[l]\nいずれ使う人間は少数でも事足りるのだろう。","实际是否如此虽不清楚，\n……接待量看起来也不像需要大场面的样子，[l]\n横竖少数人手就够用了吧。"],["「ふうん……[l]\nメニューもそんなにヴァリエーションがない……[l]\nい、いや、厳選されたものばかりだしね！」","「哼嗯……[l]\n菜单也没多少花样……[l]\n不、不过都是精选的啦！」"],["「おー、\nこの芋団子とかおすすめなんですよー。[l]\n今日のコースに入ってたかな？」","「哦——\n这个芋头团子很推荐哦——[l]\n今天套餐里有吗？」"],["「ふむ、\nやっぱり最近の子は訛りがなくて少々物足りないなあ。","「唔——\n果然现在的孩子没口音总觉得缺了点啥。"],["メディアの力というのはだからこう、\n好みじゃないのだよ。[l]\n好きになれないね」","所以说媒体这种力量啊，\n我不太喜欢呢。[l]\n实在没法喜欢」"],["「トモちゃんいっつも難しいこと言うから、\n在夜よくわかんないですよー」","「道具姐老是说难懂的话，\n在夜完全听不懂啦——」"],["しかし、そう言う在夜ちゃんのイントネーション、\nやっぱり中央とはちょっと違うんだけど。","不过说着这话的在夜酱的语调，\n果然和中央地区还是有点不同。"],["アクセントの位置が、トモちゃんの『ト』じゃないってあんまり\n向こうじゃ聞かないパターンだなー。","重音位置不在道具的『道』上这种模式，\n在那边基本听不到呢——"],["「そういえば価無ちゃはどうにゃんですの？[l]\nそれこそ、ばりっばりの西國訛り……」","「说起来价无酱怎样喵？[l]\n那可是地道的西部腔调……」"],["「あぁー、\nそうだねえ。[l]\n彼女は少々","「啊——\n确实呢。[l]\n她稍微"],["姦しい位のお喋りで……[l]\n『あれ』も久々に会って","有点话痨到吵人……[l]\n见到『那位』时"],["辟","惊"],["易してたがね」","慌失措的样子」"],["「あれ？へきえき？」","「咦？惊慌？」"],["「にゃにゃ、まだむずかしいにゃなー在夜っちには。[l]\nういもそういやまだ会ってにゃいけど──\n","「喵喵，对在夜酱来说还太难了喵——[l]\n说起来我也还没见到——\n"],["もう来てるんですに？」","已经来了喵？」"],["「おや、まだ会ってなかったか。[l]\nそうだね、\n僕は前入りしたけど彼女達は式の前日に到着した筈だから……[l]\nもう三春邸に滞在中だと思うよ」","「哎呀，还没见到吗。[l]\n是啊，\n我提前入住了但她们应该是仪式前一天才到……[l]\n现在应该住在三春府上」"],["「カナ……ってどなた様？」","「ka na……是哪位？」"],["「玖威価無、僕等西部の眷属、言ってなかったかな？[l]\nまだ小学生……中学生だったか。","「玖威价无，我们西部的眷属，没说过吗？[l]\n还是小学生……或是初中生。"],["僕は向こうでも浮いた厄介者扱いなものでね、\n細事を把握できるほど密な交流をしてないのだよ。[l]\nすまないね」","我在那边也算异类麻烦人物，\n没密切到能掌握细枝末节的程度。[l]\n抱歉啊」"],["ああ、聞いてたような聞いてないような……[l]\n玖威家自体の事は勿論宮さん達からも聞いているが、\nしかし名前と年齢層は初耳だった気がする。[l]\n……そろそろ脳が空転もしてるしな！","啊，好像听过又好像没听过……[l]\n玖威家的事当然从宫大人那里听说过，\n但名字和年龄层应该是第一次听说。[l]\n……脑子都快转不动了！」"],["「まあ、この辺りの方言は目上とかに喋るには\nフランク過ぎる印象だしね……[l]\n西國辺りの強烈な主張を持った訛りとは違うし、\n僕とか初対面の相手にはなかなか使いにくい、よねえ？」","「况且这带的方言对长辈说话时\n显得太过随意……[l]\n和西部那种强烈主张的腔调不同，\n像我这种初次见面的对象很难用呢，对吧？」"],["まさに今朝、\nそういう話をしたのだ。[l]\n道具さんと。","就在今早，\n还聊过这个话题。[l]\n和道具小姐。"],["「んだっちゃ？\nとか、[l]\nんだべ？\nとか、","「咋整啊？\n之类的，[l]\n是不？\n之类的，"],["よっぽど仲良い友達同士じゃないと\n出ないですねー」","不是关系特别铁的朋友\n根本不会说呢——」"],["「んーだべなー」","「嗯——是不——」"],["僕も出身地とは言え早々に中央に越した為、\nうっすら知ってる程度なのであった。[l]\n決して記憶力があれだからではない！","我虽说是本地人但很早就搬去中央，\n也就知道个大概罢了。[l]\n绝对不是记忆力太差的缘故！"],["そのうろ覚えの訛りでも、\n在夜ちゃんには通じたようだった。","即便是这种模糊记忆的方言，\n在夜酱似乎也能听懂。"],["「んだ。[l]\nわかってっちゃ」","「嗯。[l]\n俺懂啦」"],["「んだや、つかえんだっちゃ。[l]\nあんだなにす、わだしのまえではさっぱどしゃべんねのにっさ、\nやんだのすか、きらいなんだべ」","「是啊，用不着啦。[l]\n你这家伙在我面前倒是完全不装腔作势，\n是讨厌我吗？」"],["「んだごといってねっちゃ、\nあに、あんだそんなむつけんすなぁー。[l]\n","「别这么说嘛，\n哥，你也太见外了吧。[l]\n"],["あっはははははっ。[l]\nすごいですねぇートモちゃんはー」","啊哈哈哈。[l]\n超厉害呢道具酱——」"],["いやいやいや、いつもは仰々しい喋り方で思わず忘れますけども、\n道具さん、貴女は確か西國の人ですよね……[l]\nそっちの訛りはおくびにも出さないのに一体何故。","不不不，虽然平时说话夸张得让人容易忘记，\n道具小姐，你应该是西国出身吧……[l]\n明明完全不带那边口音，这到底为啥啊。"],["「気にしたらだめにゃぜ兄ぃ、\nペース乱されるだけにゃ……」","「别在意啦大哥，\n节奏会被打乱的啦……」"],["「あ？[l]\nあ、ああ……」","「啊？[l]\n啊、啊啊……」"],["まあ、此奴も特殊な喋り方だけど……[l]\n今にして思えばそういや、\n以前視せられた大神のチャット人格とやらがこんなだった気が。","不过这家伙说话方式也挺特别的……[l]\n现在回想起来，\n之前看到的大神的聊天人格好像就是这种调调。"],["アナクロ人間にはどうにもついていけない領域というか、\n端から視るとなかなかに奇異な光景だった覚えがある。[l]\n悪いとは言わないけど……\nリアルを知ってると違和感ばりばりなのは否めませんですよ。","对于守旧派来说完全是跟不上的领域，\n旁观时觉得真是相当奇异的景象。[l]\n倒不是说不好……\n但知道现实情况的话违和感简直爆棚啊。"],["僕も元はこの辺の人間だとは言っても、\n本家の人間、知狡さん始め宮さんもチノ嬢も、\nそれこそ大神の彼女さんもあんな喋りだし、\nそもそも幼少期の記憶が──","虽说我原本也是这一带的人，\n本家的人、知狡阿姨还有宫小姐和千乃小姐，\n就连大神的那位女友说话也是这副德行，\n说到底幼年时期的记忆——"],["しろのしろ。[l]\n\nわれは──","白中之白。[l]\n\n吾乃——"],["はっ。[l]\n何かフラッシュバックと言うか、\n気が遠くなった。[l]\n……お腹空いて更に脳が空転し出したか。","哈。[l]\n像是闪回般，\n意识开始飘远。[l]\n……肚子饿到脑子开始空转了吗。"],["朝飯はおにぎりで、途中土産物のバナナなんとか食したとは言え、\n身体の疲労に加え、……あの出来事で精神的に相当疲弊したし。","早饭只吃了饭团，路上勉强啃了作为土产的香蕉，\n身体疲劳加上……那件事造成的精神消耗实在太大了。"],["「にしても姫様ちゃん、まだかな？」","「话说姫様怎么还没来？」"],["姫様ちゃんは到着するなり、\n準備があると言ってどこかに行ってしまった。","姫様刚到就说要准备什么，\n转眼就不见人影了。"],["狩屋は手伝うか","狩屋正在纠结是去帮忙"],["在","还是陪在"],["夜ちゃんの相手をするか迷った挙げ句、\n楽しみは後にとっとくとか言って、\n今そこで在夜ちゃんと遊んでる訳だが。","夜玩，\n最后说着快乐要留到后面，\n现在正和在那边的在夜玩耍中。"],["ととととと、と様子を窺いに行きかけた在夜ちゃん、\n何かの気配を感じたのか途中で立ち止まり、\nこちらに向けて言った。","蹑手蹑脚想去打探情况的在夜，\n似乎察觉到什么突然停住脚步，\n转头对我们说道。"],["「あーっ、","「啊——"],["姉","姐姐"],["様今くるですよー」","大人马上就来啦——」"],["「！！」","「！！」"],["「ふむ、待ちかねたね」","「嗯，等很久了呢」"],["「おお」","「噢」"],["在夜ちゃんが向かっていた先の、\n厨房というかスタッフオンリー的な扉が開き、\nそこから出てきた──","在夜面对着的方向，\n那扇像是厨房或员工专用的门突然打开，\n从中走出来的——"],["ややや？","等等等等？"],["──誰？","——谁啊？"],["「…お待たせしました」","「…久等了」"],["姫様ちゃん？","姫様？"],["あれ髪の毛が……","咦头发怎么……"],["──あ、ああ～ウィッグか！","——啊～是假发！"],["「いやしかし、これはこれは……」","「不是这也太……」"],["これは店員と言うかウェイトレス……なのかこれ。[l]\n言っちゃ悪いけど田舎の土産屋にしては、\nかなりアヴァンギャルドな制服だなあ。","这算是店员还是女招待……来着。[l]\n说句失礼的，作为乡下土产店的制服，\n未免也太前卫了吧。"],["大神とかから聞いて情報だけは知ってる、\n中央の某電気街にあるというメイドなんとかの類？","虽然从大神那里听说过相关情报，\n就是中央区某电器街上的女仆什么的那类店？"],["いや、特徴的な制服のファミレスは昔からあったと聞くが、\nまあいずれそういう店は、\nこっちが入るのに気後れするのだけど僕の場合。[l]\n大神からも一度誘われたけども固辞した過去もあるし。","不过听说以前就有这种特色制服的连锁餐厅，\n总之对我来说，\n进这种店还是会有点心理障碍。[l]\n之前大神也邀请过我一次，但我坚决拒绝了。"],["アナクロ人間にはどうにも……それは関係ないか……","对我这种老古董来说实在是……不过这和现在没关系……"],["つーか、\nわざわざカツラまで装着するんだ……[l]\nすごいこだわりと言うか……[l]\n僕が女装させられたのにはこういう背景があったのかも知れないな。","话说，\n居然特意戴上假发……[l]\n该说是很讲究吗……[l]\n说不定我被迫女装也是有这种背景原因。"],["和装をベースに、前髪の揃ったおかっぱでロングのウィッグ、\nエプロンが無ければ所謂この國の\nトラディショナルドールといった風情。","以和服为基础，戴着齐刘海长直发的假发，\n要是没有围裙简直就是这个国家\n所谓的传统人偶风格。"],["そうか、座敷童がモデルかな？[l]\n六母屋も妖怪推しで売ってるし、\n土地柄としては正しい判断かもなあ。","原来如此，是以座敷童子为原型吗？[l]\n六母屋也是主打妖怪主题，\n从当地特色来看算是正确判断吧。"],["──狩屋の眼福ってこれのことか。[l]\nそういや前に、しばらく視てないから視たいなーとかなんとか\n言ってたような。","──原来狩屋说的眼福是指这个。[l]\n记得他之前说过什么好久没看了想看看之类\n的话。"],["「にゃ～～ん、きーちゃぁちょぉぐっじょぶにゃんですけど！！[l]\n写メ撮っていい？いい？」","「喵～～小姬今天超～级可爱喵！！[l]\n可以拍照吗？可以吗？」"],["ああ、やっぱそのようだな……[l]\n眼がハートになっとる。[l]\n只でさえ女子のツボはわからんのに此奴のは更に複雑だからなあ。","啊，果然是这样……[l]\n眼睛都变成心形了。[l]\n本来就不懂女生的萌点，这家伙的喜好更是复杂。"],["いやいや、姫様ちゃんが可愛くないと言ってる訳じゃないけど。[l]\n主に女子に視られるその手のテンションがどうにも、\n理解に苦しむだけ。","不不，不是说姫様不可爱。[l]\n主要是女生们看到这种场景时的兴奋状态，\n实在让人难以理解。"],["と、\nそこで姫様ちゃんは何か発声練習的な行動をし出した。","这时\n姫様突然开始做发声练习般的动作。"],["「……ん、んんっ。[l]\nあ、あー。[l]\nごふっげふげふん」","「……嗯、嗯嗯。[l]\n啊、啊——[l]\n咳咳咳嗯」"],["咳き込んだ。[l]\n気管にいったなあれ。","呛到了。[l]\n是呛到气管了吧。"],["だ、大丈夫か……[l]\n","没、没事吧……[l]\n"],["先","不知道是不是刚"],["刻の追跡が効いてるのか、\n否、単純に後片付けも肉体労働だった訳で、\n少々疲れが出てるのかしらん。","才的追踪导致的，\n或者说单纯因为收拾残局也是体力活，\n可能有点累着了。"],["お、立ち直った。","噢，缓过来了。"],["「いらっしゃいよぐきたこど、\nゆっくりしてけさい～」","「欢迎光临gu ki ta ko do，\n请慢慢休息呀～」"],["うっ！[l]\n訛りは兎も角これは、\nえ、営業ヴォイスだ！","呜！[l]\n口音先不论，\n这、这是营业用声线！"],["流石にチノ嬢の声帯模写並のギャップはないけど、\n普段が普段だけに結構驚いた。","虽然比不上千乃小姐的声带模仿那么有反差，\n但以她平时的样子来说已经很让人吃惊了。"],["しかし、すぐにいつもの調子に戻って続けた。[l]\n今のは決まり文句みたいなもんだったのかな。[l]\nコンビニの『いらっしゃいませこんにちわ～』的な？","不过马上就恢复成平常的语气继续说话。[l]\n刚才那个大概是固定台词之类的？[l]\n就像便利店的『欢迎光临您好～』那种？"],["「今日は色々お手伝いいただきありがとうございました。[l]\nこれより御礼のお食事を振る舞いたく」","「今天承蒙各位多方协助实在感谢。[l]\n接下来请允许我们用答谢餐点款待」"],["ま、まあ、\n表情の方はまだ堅いね。[l]\nやっぱり劇的に変えるのは本人も恥ずいのかも。","不、不过\n表情还是有点僵硬呢。[l]\n果然要突然转变本人也会害羞吧。"],["ウィッグつけてるんだし突き抜ければ良いと思うんだけど、\n……そこは我が身を思い起こしてしまい、[l]\nこれ以上は何とも言えぬ。","反正都戴着假发了干脆豁出去多好，\n……但想到自己也有类似经历，[l]\n就不便多说什么了。"],["「まあまあ姫様君、\n今日はお硬い挨拶は抜きにしようじゃないか。[l]\n肉体労働の後だし、君自身も大変だろう。[l]\n大丈夫、彼も気に入ってくれてるよ」","「好啦好啦姫様君，\n今天就不必这么正式的问候了。[l]\n刚干完体力活，你自己也很累吧。[l]\n放心，他也很中意你哦」"],["「え？[l]\nあ、うん、似合ってるよ、\nいい感じっす」","「咦？[l]\n啊、嗯、很合适哦，\n感觉超棒」"],["ちょぉぐっじょぶ！とも言おうとしたけど、[l]\n馬鹿にしてると思われても困るし止めておいた。[l]\n取り敢えず親指を立ててみせると、\n照れたのか、頬を赤らめて俯く姫様ちゃん。","差点就要说出超绝可爱！但[l]\n怕被误会成在嘲讽就忍住了。[l]\n总之先竖起大拇指，\n姫様酱害羞得脸颊泛红低下头。"],["「真言さんは……」","「真言先生……」"],["「？」","「？」"],["「写メは……」","「合照的话……」"],["「え？[l]\nあ、ああ、では折角だから……」","「咦？[l]\n啊、啊啊、既然难得机会……」"],["じ、自分からっ？","主、主动要求吗？"],["……ばしゃばしゃ写メ撮ってる狩屋を視てると、[l]\nなんかこう気が引けるというものだけども、\nこの場合、撮らない方が失礼ぽい流れになっとるし。","……看着咔嚓咔嚓猛拍的狩屋，[l]\n总觉得有点退缩，\n但这种情况不拍反而更失礼。"],["携帯を向けると、\n何気にポージングをとる姫様ちゃん。[l]\nしかし、僕のシャッター音より\n狩屋のが数倍回多く鳴り響くのであった。","举起手机时，\n姫様酱若无其事摆起姿势。[l]\n然而比起我的快门声，\n狩屋的相机声响亮了数倍。"],["僕を弄るでもなく突っかかるでもなく、\n黙々と撮影してる狩屋。[l]\nう、うーん。","既不捉弄我也不抬杠，\n默默拍摄的狩屋。[l]\n唔、嗯——"],["てかねえ、アナクロ人間には写メ撮る習慣がないんすよ。[l]\nレンズ向けるのもシャッター押すのにもいちいち抵抗が……[l]\nそれこそメディアでそう言う場面を客観的に視せられて、\nあれな印象植え付けられてるからかもだけど。","话说啊，老古董人类根本没有拍照习惯。[l]\n光是镜头对准和按下快门就各种抗拒……[l]\n可能因为媒体总让我旁观这种场景，\n被植入了那种印象吧。"],["大神あたりは、\n写真はがっつり専門機たるデジカメで撮るしね。","像大神他们，\n拍照都用专业数码相机呢。"],["取り敢えず、二、三枚撮らせていただきました。[l]\nすると微笑ましく見守っていた在夜ちゃんが、","总之先拍了两三张。[l]\n这时含笑旁观的在夜酱"],["「よろしいですか皆様ー？[l]\nえとですねー、\n今日は貸し切りですからー。","「各位准备好了吗～？[l]\n那个～\n今天包场了哦～"],["コースは姉様が考えましたけど、\n","菜单是姐姐设计的，\n"],["ゴエンリョなくお好きなものを言ってくださいねー」","请别客气随意点单呢～」"],["と言った。","如此宣布道。"],["当然と言っては失礼だけども本格的に前菜やら主菜やらがどうの、\nというフルコースが元よりある訳ではないので、\nそれに相当するような感じを在りモノのメニューから\n姫様ちゃんが見繕ったという事らしい。","虽然这么说很失礼但并非正规前菜主菜俱全的\n全套料理，\n而是姫様酱用现有菜单\n搭配出类似效果的组合。"],["デザート類は充実してそうだけどメインは何だろ？","甜品种类丰富但主菜是啥？"],["「にゃふぅー、堪能したにー。[l]\n","「喵呼～享用完毕～[l]\n"],["ささ、ごっはんごっはん！」","来来、开饭开饭！」"],["「まずは山菜でオードブルなのですよー」","「首先是山野菜前拼盘哦～」"],["「あ、お茶も今のうちにくれるかい？」","「啊、现在要上茶吗？」"],["「畏まりました」","「遵命」"],["ま、折角だし愉しみにしとくか。","嘛、难得机会就好好享受吧。"],["──にしても、","——即便如此，"],["交流が深くなればなるほど、\nやはり心のどこかで罪悪感が増していくのは否めない。[l]\nそうだ、なんで僕は、","越是深入交流，\n心底滋生的罪恶感就越发强烈。[l]\n对了、为什么我"],["「どうぞ、粗茶ですが」","「请用、粗茶而已」"],["「あ、ありがとう」","「谢、谢谢」"],["姫様ちゃんが皆の前に湯飲みに注がれた良い香りの茶を\n配膳していく。[l]\n手伝う在夜ちゃん。","姫様酱将注入茶杯的香茗\n依次端给众人。[l]\n帮忙的在夜酱。"],["あれ？[l]\n今何か僕は、\n……。","咦？[l]\n刚才我好像\n……。"],["一瞬浮かんだ基本的にして致命的な疑問は、\n今ので打ち消されてしまい、\n二度と思い出せなかった。","脑海中闪过的根本性致命疑问，\n被此刻情景冲散，\n再也未能想起。"],["僕の煩悶を余所に、\nあちらはあちらで何かしら面倒そうな気配の会話を\nしてる模様。","无暇顾及我的烦恼，\n那边似乎也在进行着什么麻烦的对话\n的样子。"],["「運君はやっぱり顔出さないか」","「运君果然还是不肯露面啊」"],["「はい」","「是」"],["「ここんとこ色々で忙しいのでー。[l]\n（ちょっと機嫌わるいんですよー）」","「最近因为各种事情很忙啦——[l]\n（心情有点糟糕呢——）」"],["「ふむ。[l]\nまあ、しっかり者ではあるが恥ずかしがり屋でも\nあるからなあ。[l]\nそっとしておくか」","「嗯。[l]\n虽说是个可靠的孩子但也很容易害羞\n呢。[l]\n还是别打扰她吧」"],["道具さんにしては殊勝な態度を示し、\n誰に向けてともなく","道具小姐难得表现出体贴的态度，\n对着虚空般"],["「自分と自分以外、\nたった二人でも彼我が揃えば諍いも起こるか……」","「自己与他人，\n哪怕只有两人也会产生争执吗……」"],["言ってることは至極普通の事だが、\n今この状況で具体的に何を指すかまでは当然僕に判る筈もなく、\n自分の記憶力に悶々とし","说的虽是极其平常的道理，\n但此刻具体所指何事我自然无从知晓，\n只能为模糊的记忆力"],["乍らも、\n今は前菜を食すのみ。","暗自焦躁，\n眼下只管享用前菜。"],["うーん、\n旅館のとも違う、何とも言えぬ素朴な味わい。","唔——\n不同于旅馆风味，难以言喻的质朴口感。"],["「じゃ、御礼は言っておいて呉れ給え。[l]\n今日も美味いよこれは」","「那替我向她说声谢谢。[l]\n今天也很美味呢这个」"],["「はぁーい、\n伝えときますよー」","「好——\n会转达的哟——」"],["姫様ちゃんもそうだが、母親亡くした直後だろうに、\n健気というか、\n精神的にダメージを受けてる感じは微塵もないように\n視えるなあ。","姫様也是，明明母亲刚去世不久，\n该说是坚强还是，\n完全看不出精神受创的\n痕迹啊。"],["三春という大きなバックの庇護があるから心配していないのか、\n","是因为有三春这样的大靠山所以不担心，\n"],["外","还是说即便表面"],["見は明るく振る舞っても心で泣いてるのか、\n兎に角強い子達なのか、","上表现得开朗乐观，内心却在哭泣呢，\n总之都是些坚强的孩子，"],["―― 人死になど意に介さない程に薄情、\nという線は無いと思いたいけど。","――但愿不至于冷漠到\n对死亡无动于衷的地步。"],["まあ……運姉さんとやらは、[l]\nなんか顔出してもくれないようだし、色々あるのかも知れないな。","不过……那位运姐姐，[l]\n既然不肯露面，或许也有苦衷吧。"],["「次はですねー、\nお吸い物ですよー、ええとですね……」","「接下来呢——\n是清汤哟——呃那个……」"],["何か具体的な名前を言われたけども、\n要は……まあその名の通りお吸い物で、[l]\nつみれか何かが具のあっさりめのものであった。","虽然报了具体名称，\n总之……就是字面意思的清汤，[l]\n配着鱼肉丸子之类清淡的配料。"],["何はともあれ、\n出されたものを有り難く戴きます。","无论如何，\n心怀感激地享用呈上的食物。"],["メインディッシュはいきなり定食みたい──量は流石にそれなりで、\nレディースセットみたいな──なのが出てきた。","主菜突然变成定食风格——分量倒是适中，\n像是女士套餐——的餐点被端了上来。"],["単体メニューとしては、\n山菜そばと鶏肉丼のセットらしいが、\n本来付いていたであろう味噌汁と漬け物は外されてたようだ。[l]\nまー、前菜とスープとかぶるしね……","单点菜单来看，\n应该是山菜荞麦面与鸡肉盖饭的组合，\n原本该有的味噌汤和腌菜似乎被去掉了。[l]\n嘛——和前菜汤品重复了嘛……"],["きぃあたりだったら全部単体時のボリュウムでも\n喰い尽くすんだろうが、僕的には丁度良い。[l]\nちなみに親子丼ではないが生卵が単品で添えてあった。[l]\n杉屋の愉快メニューのようでこれはこれで。","要是小贵的话就算全部按单点分量\n也能吃完吧，对我来说刚好。[l]\n顺便虽然不是亲子盖饭但单独配了生鸡蛋。[l]\n杉屋的趣味菜单就这样吧。"],["何というか、\n食材の一個一個がいちいち美味いなあ。[l]\nやっぱり水からして違うとこうも変わるものか。","该怎么说，\n每种食材都格外美味啊。[l]\n果然连水质不同都能带来这么大变化。"],["水に関しては宮さんも最初から言ってたことだが、\n向こうで水道水自炊したってどうにもならんように、\n構成する素材が根源から違うんでは比較のしようもないね。","关于水宫小姐早就说过，\n就像在那边用自来水做饭也无济于事，\n构成素材从根源上就不同根本无法比较呢。"],["食は生命の基本だものなあ、\n状況的に複雑な気分ではあるけれど、\nしっかと噛みしめましょう……","饮食是生命的基本啊，\n虽然心情复杂，\n还是好好咀嚼吧……"],["あらかた全員がメインを食した頃に、\n例の芋団子とやらも出てきたが、\n形状としては餅に近く、かなり不思議な視た目＆味だった。","当大伙儿差不多都把主菜吃完时，\n传说中的芋头丸子也端上来了，\n外形更接近年糕，模样和味道都相当奇妙。"],["や、旨いんだけど、あまり他にこういう食物を視たことないので、\n例えるのが難しいな。[l]\nそして最後に例の『ねこまたのしっぽ』が配られて、\n何茶か判らないが心地よい風味のあるお茶で締め。","啊、虽然好吃，但很少见到这类食物，\n实在很难形容呢。[l]\n最后分发的是那个『猫叉尾』，\n配着不知什么茶但风味怡人的茶水收尾。"],["「ほんとは善哉とかにしたかったんですけどー、\n人数分はすこーし大変だったのでー。[l]\n手抜きですけどごめんなさいー」","「其实本来想做成善哉之类的——\n不过人数份稍微有点吃力——[l]\n偷工减料了真是抱歉啦——」"],["「あ、だいじょぶ気にしないで、\nというかこちらこそ色々とありがとうです。[l]\n十分戴きました」","「啊、没关系不用在意，\n倒不如说我们才要感谢各种款待。[l]\n已经吃得很满足了」"],["「……これ……」","「……这是……」"],["「？[l]\nあ、ああ、え？[l]\nくれるの？」","「？[l]\n啊、啊啊，咦？[l]\n要给我吗？」"],["未開封１５個入りの『ねこまたのしっぽ』を、\n土産として手渡された。","未开封的15个装『猫叉尾』，\n作为伴手礼递了过来。"],["「いえ……今後ともうちを宜しくお願いします」","「不……今后也请多关照本店」"],["こうやってほのぼのとした","进行着这样温馨的"],["遣り取りをしてると、\nどうしてもカウンター的に罪悪感が湧き上がってしまう。[l]\n冬夏に至っては、\n式の潜入からこっち秘密のままで何も言ってないし──\n……彼女達とも、まるで暫く会ってないような錯覚に陥るが、[l]\nそもそも知り合ってから数日しか経ってない仲なんだよな。[l]\nいや、きぃは昔会ってる──かも、という状況だが──としても、\n付き合いとしては短い期間であろう。","互动时，\n柜台这边的罪恶感总会不由自主涌上来。[l]\n至于冬夏，\n从仪式潜入至今都守口如瓶什么都没说——\n……甚至会产生和她们许久未见的错觉，[l]\n可实际上我们认识才不过几天而已。[l]\n不、和小贵可能以前见过——大概，即便如此——\n交往的时间也算很短吧。"],["それでもこうしておかしな具合に交流があったり、\n気に掛かったりするのは、\nやはり感情移入というか、接触の仕方が強烈すぎて、\nまるで長い付き合いの仲というか、\n昔から知ってる同士の間柄のような、\nうーん、それはこっちに来てから会う人会う人みんな\n強烈ではあるけども、[l]\n@r非日常的イヴェントの共有による錯覚なのかなあ。","即便如此还能产生这种奇妙的交集，\n让人挂念，\n果然是因为代入感或者说接触方式太过强烈，\n简直像交往多年的老友，\n又似自幼相识的故交，\n唔、不过来这里后遇到的人个个都是\n这么强烈就是了，[l]\n@r莫非是共享非日常事件产生的错觉吧。"],["吊り橋の出会い……は違うか。[l]\n学生は文化祭後にカップル出来まくり的心情効果とでも言おうか……","吊桥效应的邂逅……倒也不对。[l]\n该说是学生文化祭后容易成双成对的心理效应吗……"],["まあ、それは兎も角。[l]\n何度も言うようだが、僕等は決して敵対したい訳じゃないし、\n穏便に事が進むならそれに越したことはないのだから、[l]\n@r……","嘛，这个暂且不论。[l]\n再三强调，我们绝对没有敌对的意图，\n若能和平解决自是再好不过，[l]\n@r……"],["刻忘れてしまった基本的な疑念、[l]\nそれが引き起こす不安、\n罪悪感が何故か頭を離れない。","被逐渐遗忘的根本疑虑，[l]\n由此引发的不安，\n不知为何萦绕不去的罪恶感。"],["普段は空腹の脳空転の時に起こる、\n精神の安定を欠く状態が今、食後に起こるのは珍しい。[l]\n@r二律背反……[l]\n@rそんな言葉も頭をかすめるが、","平时只在空腹脑缺氧时出现的\n精神失衡状态，此刻竟发生在餐后实属罕见。[l]\n@r二律背反……[l]\n@r这个词也在脑海闪过，"],["「どうしたね少年。[l]\n流石に疲れたかい？[l]\nそれとも眠いのかな？[l]\n食事の後は血が胃に行くしねえ」","「怎么了少年。[l]\n果然累了吗？[l]\n还是说困了呢？[l]\n饭后血液都流向胃部了嘛」"],["そう、\n結局僕の思考はそこまでで、\nあとは身体の欲求に勝てません。","就这样，\n我的思考到此为止，\n终究敌不过身体的需求。"],["「うーん、そうかも知れませんけど、\n大丈夫です」","「唔、或许是吧，\n不过没关系」"],["程よく冷めたお茶を眠気覚ましに飲み干して、\n僕は気を立て直した。","为驱散睡意灌下恰到好处温凉的茶水，\n我重新打起精神。"],["不安は消えていたが、\nチョーカーを巻いた首が熱い。","不安虽已消散，\n戴着项圈的脖颈却阵阵发烫。"],["そこからは、腹ごなしに若干の雑談──\n僕は流石に愛想振りまく程度で、\n突っ込んだ話は出来なかったけども──をしていると、","从那之后，为了消食稍微闲聊了一会儿──\n我当然只能勉强应付着说些客套话，\n没法深入交谈──正这么想着时，"],["柱に取り付けられていた古い振り子時計が丁度二時の鐘を打ち、\n切りが良い時間という事で解散する事になった。","钉在柱子上的老旧摆钟恰好敲响两点钟声，\n趁着这个合适的时间点便决定解散了。"],["今夜には正式名称を『","今晚似乎会举行正式名称为『"],["栖","栖"],["後","后"],["奉","奉"],["仕』というらしい、\n今日の一連の後片付け、つまりどんと祭のような本祭儀が\n行われるらしいが、","仕』的仪式，\n也就是今天这系列收尾工作，类似庄重祭祀般的正式仪式\n看样子要举办了，"],["やはり僕が潜入……いや、手伝いだろうと参加出来るような\nものではないようだ。","但果然不是我能够潜入……不对，就算是帮忙也\n无法参与的类型吧。"],["念のため訊いてはみたものの、","虽然为保险起见试着问了下，"],["「一応提案ですけど……[l]\nもしそちらさえ良ければ、\n片付けの本作業の方もですね、\nお手伝いは出来ますが」","「虽然只是个提议……[l]\n如果你们那边没问题的话，\n收尾工作的主要部分\n我也可以帮忙的」"],["「おうあ、だめにゃよ」","「啊呀，不行喵」"],["「……」","「……」"],["「ふむ。[l]\nお心遣いは有り難いし、\n個人的には是非ともお願いしたいところなのだがね。","「嗯。[l]\n这份心意令人感激，\n我个人是非常想拜托你的。"],["やはりこれは……家の問題、プライベートな行事だからね。[l]\n気持ちだけ貰っておくよ」","但毕竟这是……家族内部事务，属于私人性质的活动。[l]\n心意我们就心领了」"],["ということで矢張り駄目だった。[l]\n今日の収穫は、報告するには\n少々微妙な感じになってしまったなあ……[l]\n姫様ちゃんへの話もご期待に添えたかどうかだし……","于是果然还是没成功。[l]\n今天的收获要说汇报的话，\n感觉变得有点微妙了啊……[l]\n对姫様酱的说辞也不知道能否让她满意……"],["「ま、少年とはこれからも長い付き合いになりそうだからね、\n先も言った通り、我等の身内になることがあれば、\nいずれご助力を願う事もあるだろう。[l]\n諸々話せる事も増えるだろうが、」","「嘛，反正和少年你今后还要长期打交道，\n就像之前说的，如果你成为我们家族成员的话，\n迟早会需要你协助的。[l]\n能聊的事情也会多起来吧，」"],["そこで道具さんは眼を瞑り視線を断った上で、","说到这里道具小姐闭上眼睛移开视线，"],["「誰を選ぶかという問題もあるからね。[l]\nそこは是非慎重に選択をして貰いたいところだなあ」","「毕竟还涉及要选择谁的问题呢。[l]\n这点希望你务必慎重考虑啊」"],["「ぶふっ」","「噗咳」"],["「げほっ、げほげほ」","「咳咳、咳咳咳」"],["慌ててお茶を飲む。[l]\n自分だけが弄られてるなら兎も角、\n第三者が絡む話をされるとリアクションが難しい……","慌忙喝了口茶。[l]\n光是自己被调侃倒也罢了，\n一旦牵扯到第三方的话题就难以反应……"],["その点宮さんは、たいがい自分を肴に話を振るから楽は楽だね。[l]\n幸い、姫様ちゃんも狩屋も格別反応しないので助かった。[l]\n流石身内、馴れてるのかしらん。","这方面宫小姐就很好，她总拿自己当话题引子所以很轻松。[l]\n幸好姫様酱和狩屋都没什么特别反应。[l]\n不愧是自家人，是已经习惯了吧。"],["在夜ちゃんは単に分かってない感じだが、それでよい。[l]\nそのまま純朴に育っていただきたいものよ……","在夜妹妹看起来完全没听懂，这样正好。[l]\n希望她就这么纯真地长大吧……"],["と、道具さんがある提案をしてきた。","这时道具小姐提出了某个建议。"],["「ふむ、ともあれだ、\n日曜には恐らく──\n祭の実行の如何が決定されるだろう。","「嗯，总之呢，\n周日应该会──\n确定是否执行祭典。"],["君にも連絡してあげようと思うが、\n嫌かね？」","我想也通知你一声，\n会嫌麻烦吗？」"],["「え？[l]\nあ、いえそこは是非、お手数でなければ……」","「诶？[l]\n啊、不会的如果方便的话务必……」"],["「僕の番号は……これだね。[l]\n君のは後で克杖君から聞いておく。","「我的号码是……这个。[l]\n你的我稍后会向克杖君打听。"],["克杖君だね知ってるのは？[l]\nああそう。[l]\nそれこそ冬夏君にお願いしても良いのだが」","你知道克杖君的号码吧？[l]\n啊对。[l]\n其实拜托冬夏君转达也可以的」"],["「ああ、その辺はお任せします。[l]\nご迷惑にならない方法で……」","「啊，这部分就交给您了。[l]\n只要不造成困扰的方式……」"],["正直、冬夏には色々黙ったままなので、\n若干気が引けるが、\nここで誰それが良いです、とはっきり指定すると……[l]\nまた色々と面倒なイジリが始まりそうだったので止した。","说实话，因为对冬夏隐瞒了很多事，\n稍微有点过意不去，\n但要是明确指定由谁转达的话……[l]\n感觉又会引发麻烦的调侃就作罢了。"],["提案自体は有益だし。[l]\n──まあ、ほぼやる方向で確定してるんだろうけどね……","提议本身很有帮助。[l]\n──不过基本上已经确定要举办了吧……"],["冬夏も眷属一派とは仲は良くないようだから、\n妥当な線で道具さん本人か狩屋からの連絡とみた。","冬夏似乎和眷属一派关系也不太好，\n所以合理推测是道具小姐本人或狩屋那边联系的吧。"],["「じゃーですね、\n（そろそろ運姉様が怒りそうなので）\nおひらきにしましょうかー」","「那~就这样，\n（差不多运姐姐要生气了）\n我们散会吧~」"],["「ふむ、\n僕もそろそろ用足しに行くかな」","「嗯，\n我也该去办点事了」"],["「あ、今日はほんとに御馳走様、\n大変に美味しかったです」","「啊今天真的承蒙款待，\n非常美味」"],["「じゃーういは片付け手伝ってぇ、\n今晩は増血食にゃのうー」","「那~我来帮忙收拾吧，\n今晚要吃增血食哦~」"],["ごちそうさまでしたぁ～。","多谢款待啦~"],["皆が席を立って各自動き出すと、\n姫様ちゃんがとことこと寄ってきた。","当众人离席各自行动时，\n姫様酱啪嗒啪嗒地凑了过来。"],["「……真言さん」","「……真言先生」"],["「あ、なに？」","「啊，怎么了？」"],["「（あとで……二人きりでお話したいです）」","「（之后……想和您单独谈谈）」"],["「え、ええっ？！」","「诶，诶诶？！」"],["思わず狩屋の様子を確認する僕。","我不由自主地确认狩屋的动向。"],["……","……"],["幸か不幸か、奴は既に在夜ちゃんと後片付けに精を出しており、\nこちらには気付いてない。","不知幸运与否，那家伙正和在夜酱专心收拾餐具，\n没注意到这边。"],["や、ま、まあ気にすることでもないんだけど、\n通例こういう場面では彼奴が面倒ごとを、と思ったからで、\n別に他意はないよ！","虽、虽然也不是需要在意的事，\n但按惯例这种场面那家伙总会惹麻烦，\n绝对没有其他意思哦！"],["「今すぐ","「现在"],["何","还"],["時とは言えませんが……[l]\n近いうちに必ず連絡しますから」","说不好具体是什么时候……[l]\n但近期一定会联系您」"],["情報収集の意味合いで今日は全く進展がなかった、\n否、道具さんから聞いてもいない大量の情報供給はあったとは言え、\nそういう感じだったし、","从情报收集的角度看今天毫无进展，\n不，虽说从道具小姐那里获得了大量未主动询问的情报，\n就是这种感觉，"],["僕も姫様ちゃんには、\nあの式に関してちゃんと話せてなかったしなあ。[l]\n大神からの忠告があるから、\nどこまで言えるかどうかという問題はあるにしろ、","我和姫様酱之间，\n关于那个仪式也没能好好说明。[l]\n虽然有大神的警告，\n存在能说到什么程度的问题，"],["聞いている人間が限られる状況ならば、\n多少は込み入った話も出来るかも知れない。","但如果听众有限的话，\n或许能谈些更深入的内容。"],["なので、\nこれは、\n言い方が悪いと言うか、姫様ちゃんには悪いかもだけど、\n渡りに船なのかも知れない。","所以，\n这个，\n虽然说法可能不太妥当，对姫様酱或许有些抱歉，\n说不定正是瞌睡遇到枕头。"],["……よもや、[l]\nあまり自分で言うと自意識過剰臭いので言いたくはないが、\n告白される訳じゃないよねえ。","……总不至于，[l]\n自己说出来显得太自作多情所以不想说，\n该不会是要告白吧。"],["おほほほほ。[l]\nうへへへへ。[l]\n──狩屋がどう誤解するかが面倒どころだけど。","哦呵呵呵。[l]\n嘿嘿嘿嘿。[l]\n──比起这个，狩屋会怎么误会才更麻烦。"],["「えーと、\nまあその、\n取り敢えず大丈夫だと思う……から、[l]\nじゃあ都合の良い時にでも連絡くれればいいよ」","「那个，\n总之，\n暂时应该没问题……所以，[l]\n等你方便时联系我就好」"],["「はいっ」","「好的！」"],["周りを見回すと、\n道具さんは既に居らず、\n狩屋と在夜ちゃんも厨房の方に行ったらしく誰もいなかった。","环顾四周，\n道具小姐已经不在，\n狩屋和在夜酱似乎也去了厨房，空无一人。"],["嵐の去った春の日の午後、\n異様な程の、静けさと澄み渡った空気を透過してくる光、\n五感が冴え渡るようなこの感じ。","风暴过后的春日午后，\n异常澄澈的寂静中穿透而来的阳光，\n这种五感格外敏锐的感觉。"],["ああ、[l]\n思考が鋭敏化すると不安が生じる。","啊，[l]\n思维越是敏锐就越容易不安。"],["だから僕はいつも脳を空転させて……","所以我总是让大脑放空……"],["「──とさん？[l]\n真言さん」","「──喂？[l]\n真言先生」"],["「……え、[l]\nあ。ごめん。[l]\nぼーっとしてた、\nじゃ、じゃあ帰るよ、あんまり力になれなくて御免ね」","「……诶、[l]\n啊。抱歉。[l]\n刚才在发呆、\n那、那我先回去了，没能帮上什么忙真对不起」"],["「いえ、そうじゃなくて……」","「不是，您误会了……」"],["？[l]\nな、なんだ？","？[l]\n怎、怎么了？"],["「お土産……忘れもの……」","「伴手礼……您落下的……」"],["「えっ。あっ！！[l]\nご、ごめん！！","「咦。啊！！[l]\n对、对不起！！"],["ほんっとに申し訳ない！！[l]\n失礼しました！！[l]\n有り難く戴きます！！」","真的非常抱歉！！[l]\n失礼了！！[l]\n我会心怀感激收下的！！」"],["──。","──。"],["店の外に出ると、\n道具さんが車で出るところだった。","走出店铺时、\n道具小姐正要驾车离开。"],["見送りに降りてきた姫様ちゃんと僕に向かって\n手を振りながら、何処かに向かって車を走らせていった。","她对着下车送行的姫様酱和我\n挥了挥手，驾车驶向某处。"],["騒がしい人、というと語弊があるな、\n場を引っかき回す人であったなあ。","说是吵闹的人可能不太准确、\n该说是会搅乱场面的人吧。"],["まあミコ……卑尊さんがあんな態度だったのも頷ける。[l]\nしかしきぃも大変な人に見込まれたものだ。[l]\n宮さんに振り回されっぱなしの僕が言うのもあれだけど……","不过小贵……卑尊医生那种态度也能理解。[l]\n但能被这么厉害的人物看中，小贵也不简单啊。[l]\n虽然被宫小姐耍得团团转的我说这话有点那啥……"],["僕ぁ、\n最早、周囲の全てから振り回されてると\n言っていいんじゃないかしらん。","我啊、\n现在简直可以说是\n被周围所有人牵着鼻子走呢。"],["さて、","话说，"],["姫様ちゃんとは後でマンツーマンで話す機会が出来たとして、\n今後はどうしたものか。[l]\n道具さんから祭の開催に関しても情報は貰えそうだし……","就算之后有机会和姫様酱单独谈话、\n接下来该怎么办呢。[l]\n关于祭典举办的情报应该能从道具小姐那里获取……"],["何にせよ宮さんにお伺いを立てる他ないかなあ。","总之还是得先请示宫小姐吧。"],["今し方歓待を受けたとはいえ、\n早起きに加え肉体労働、精神負担も大きかったし、\n今夜はがっつり休眠したい気分ではあるけど。","虽说刚刚受到热情款待、\n但早起加上体力劳动和精神压力都很大、\n今晚真想好好睡一觉。"],["疲れの度合いで言ったら","要说疲劳程度、"],["件の式の時の方が何倍も\nしんどかったのだが、\n今日は単純にその日の分が加算されてるからかねえ。[l]\n式直後よりもぐったり感がある。","上次仪式时要比现在\n辛苦好几倍、\n但今天可能是叠加了当天的份吧。[l]\n比仪式刚结束时还要虚脱。"],["「……取り敢えずこの土産でも献上しようっと」","「……总之先把这个伴手礼献上吧」"],["宮さんにはあげないと","虽然不送给宫小姐"],["煩そうなので確定としても、\n是非知狡さんには日頃の感謝を込めて食して戴きたいところ。[l]\n地元民として珍しくも何ともないかも知れないけど、\nなんか最近元気ないし。","肯定会很烦人是确定的、\n但真心希望知狡阿姨也能品尝这份日常的谢意。[l]\n对本地人来说可能不算稀罕物、\n但她最近好像没什么精神。"],["「じゃあ帰るかぁ。[l]\nまるでこの嵐の後の静けさの中を……あれ？[l]\n嵐の前、だっけ。[l]\nまあいいや」","「该回去了啊。[l]\n仿佛行走在这暴风雨后的宁静中……咦？[l]\n是暴风雨前才对吧。[l]\n算了无所谓」"],["独り言を言いつつ土産を小脇に抱えて、\n僕はこの、\n異常に透き通った空気と無慈悲な陽光の中、\n冷たい風に吹かれながら宿への帰路を歩き出した。[l]\n帰りは徒歩って、今考えると変な計画たててもうたな……[l]\nまあ腹ごなしになると思えば丁度良いか。[l]\n眠くなってたし。","一边自言自语一边夹着伴手礼、\n我在这\n异常通透的空气与毒辣阳光下、\n迎着冷风踏上了返回旅馆的路。[l]\n选择步行回去，现在想想真是制定了奇怪计划呢……[l]\n不过当作消食的话倒正合适。[l]\n而且刚才也犯困。"],["六母屋が視えてくると、[l]\n駐車場横の植え込みの石垣に人影が確認出来た。","当六母屋映入眼帘时、[l]\n发现停车场旁灌木丛的石垣上有个人影。"],["「（……おんや？）」","「（……咦？）」"],["その人影は、\nパーカーのフードを目深に被り、\n膝を抱えて座っている。","那个人影\n把连帽衫的兜帽拉得很低、\n抱膝坐着。"],["どうやら女性のようだけど、\nでかいスポーツバッグを横に置いたままである。[l]\n宿泊者ならばチェックインすればいいと思うんだけど、\n──早く来すぎたとか？","看起来像是女性、\n旁边放着巨大的运动包。[l]\n如果是住客应该去办理入住才对、\n──是来得太早了吗？"],["いや、幾ら知狡さんでも、\nそこまで融通利かない事はないよな……[l]\nまずあの人が受け付けする訳じゃないだろし、","不、就算知狡阿姨再怎样，\n也不至于那么不通人情吧……[l]\n首先那个人根本不会负责接待工作，"],["まさか、\n不審者…？","难不成，\n可疑分子…？"],["宮さんの悪戯にしては……[l]\n身長がちっとある感じだし、\nあの人はもうちっと直接的でピーな事をするしな！","要说是宫小姐的恶作剧……[l]\n身高感觉有点对不上，\n那个人肯定会用更直接更哔——的方式搞事啦！"],["ちょっと凝視しすぎたか、","可能盯得太久了，"],["「……ぅっ」","「……呜」"],["その人物がこちらに反応した。","那人对我产生了反应。"],["すると、ざっ。と立ち上がり。","接着，沙——地站起身。"],["「おそい」","「太慢了」"],["あああ、あ、れ？","啊、啊、啊咧？"],["僕の眼前まで早歩きでやってきて、\nぶわさっとフードを取り払ったその人物は、","快步走到我眼前，\n哗啦一声掀开兜帽的那人，"],["宮さんではなくて、","并不是宫小姐，"],["ふふふ。","呵呵呵。"],["そこには泣き笑いのように口を尖らせて、\nしかしガーゼを当ててない方の碧い眼には不敵な笑みを\n","只见她似哭似笑地撅着嘴，\n但没贴纱布的那只碧蓝眼眸里\n"],["湛える、","漾着挑衅般的笑意，"],["「おかえりなさい、真言さん」","「欢迎回来，真言君」"],["冬夏が居た。","是冬夏。"],["「とぁっ、と、う、\nた、たた、ただいもん……」","「诶、诶、呜、\n我、我我、我回了……」"],["「おっ。[l]\nじゃあおかいもん！ってなにそれ？[l]\n変なの、おもしろいね。[l]\nあっははははは」","「噢。[l]\n那个“我回了”！这算什么招呼啊？[l]\n好奇怪，真有趣。[l]\n啊哈哈哈」"],["今日も事が起こりすぎる。","今天发生的事实在太多。"],["まだ、終わらないっていうのか。","难道还没结束吗。"],["現実感の無い事象が立て続けに起きて、[l]\n僕は目眩を覚えた。","接连发生缺乏现实感的事件，[l]\n我感到一阵眩晕。"],["思わず後ろ手にお土産を隠してはみたけれど、[l]\n色々覚悟が必要、かもなあ……","虽然下意识把土特产藏到身后，[l]\n但可能要做好各种心理准备……"]],"context":[["SC_M_028.ks/index/1/text"],["SC_M_028.ks/index/3/text"],["SC_M_028.ks/index/5/text"],["SC_M_028.ks/index/7/text"],["SC_M_028.ks/index/9/text"],["SC_M_028.ks/index/11/text"],["SC_M_028.ks/index/13/text"],["SC_M_028.ks/index/15/text"],["SC_M_028.ks/index/17/text"],["SC_M_028.ks/index/19/text"],["SC_M_028.ks/index/21/text"],["SC_M_028.ks/index/23/text"],["SC_M_028.ks/index/25/text"],["SC_M_028.ks/index/27/text"],["SC_M_028.ks/index/29/text"],["SC_M_028.ks/index/32/text"],["SC_M_028.ks/index/34/text"],["SC_M_028.ks/index/36/text"],["SC_M_028.ks/index/38/text"],["SC_M_028.ks/index/40/text"],["SC_M_028.ks/index/42/text"],["SC_M_028.ks/index/44/text"],["SC_M_028.ks/index/46/text"],["SC_M_028.ks/index/48/text"],["SC_M_028.ks/index/50/text"],["SC_M_028.ks/index/52/text"],["SC_M_028.ks/index/54/text"],["SC_M_028.ks/index/57/text"],["SC_M_028.ks/index/59/text"],["SC_M_028.ks/index/61/text"],["SC_M_028.ks/index/63/text"],["SC_M_028.ks/index/65/text"],["SC_M_028.ks/index/67/text"],["SC_M_028.ks/index/69/text"],["SC_M_028.ks/index/71/text"],["SC_M_028.ks/index/73/text"],["SC_M_028.ks/index/75/text"],["SC_M_028.ks/index/77/text"],["SC_M_028.ks/index/79/text"],["SC_M_028.ks/index/81/text"],["SC_M_028.ks/index/83/text"],["SC_M_028.ks/index/85/text"],["SC_M_028.ks/index/87/text"],["SC_M_028.ks/index/89/text"],["SC_M_028.ks/index/91/text"],["SC_M_028.ks/index/94/text"],["SC_M_028.ks/index/96/text"],["SC_M_028.ks/index/98/text"],["SC_M_028.ks/index/100/text"],["SC_M_028.ks/index/102/text"],["SC_M_028.ks/index/104/text"],["SC_M_028.ks/index/106/text"],["SC_M_028.ks/index/108/text"],["SC_M_028.ks/index/110/text"],["SC_M_028.ks/index/112/text"],["SC_M_028.ks/index/114/text"],["SC_M_028.ks/index/116/text"],["SC_M_028.ks/index/118/text"],["SC_M_028.ks/index/120/text"],["SC_M_028.ks/index/122/text"],["SC_M_028.ks/index/124/text"],["SC_M_028.ks/index/127/text"],["SC_M_028.ks/index/129/text"],["SC_M_028.ks/index/131/text"],["SC_M_028.ks/index/133/text"],["SC_M_028.ks/index/135/text"],["SC_M_028.ks/index/137/text"],["SC