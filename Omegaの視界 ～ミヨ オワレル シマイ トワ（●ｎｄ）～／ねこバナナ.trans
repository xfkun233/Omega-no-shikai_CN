start":10788,"end":10800}],[{"start":10806,"end":10826}],[{"start":10838,"end":10876}],[{"start":10882,"end":10889}],[{"start":10953,"end":10958}],[{"start":10964,"end":10977}],[{"start":11016,"end":11024}],[{"start":11060,"end":11064}],[{"start":11114,"end":11123}],[{"start":11129,"end":11161}],[{"start":11175,"end":11180}],[{"start":11186,"end":11197}],[{"start":11211,"end":11221}],[{"start":11227,"end":11232}],[{"start":11238,"end":11244}],[{"start":11260,"end":11293}],[{"start":11307,"end":11323}],[{"start":11329,"end":11341}],[{"start":11386,"end":11410}],[{"start":11452,"end":11470}],[{"start":11476,"end":11492}],[{"start":11508,"end":11527}],[{"start":11533,"end":11550}],[{"start":11566,"end":11582}],[{"start":11621,"end":11628}],[{"start":11634,"end":11642}],[{"start":11678,"end":11701}],[{"start":11719,"end":11728}],[{"start":11746,"end":11756}],[{"start":11795,"end":11801}],[{"start":11807,"end":11820}],[{"start":11883,"end":11903}],[{"start":11909,"end":11983}],[{"start":12028,"end":12038}],[{"start":12044,"end":12056}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_012.ks","basename":"SC_M_012.ks","indexIds":{"闇の中に思考のみがあり":0,"恐らく脳髄といういち器官が、":1,"特殊に活性したときに生じる反応の":2,"その反応そのものであって":3,"我は言語を知るので":4,"言語にて構成されるのだが":5,"脳も":6,"眼も":7,"側も":8,"泌も":9,"口も":10,"精も":11,"骨も肉も":12,"依代も":13,"はねも":14,"あぽとすもねくろすも":15,"分かたれ奪われて。":16,"カミにホウじられた。":17,"九つの魂。":18,"猫魂。":19,"自律回路。":20,"我は有機なり、":21,"我は幽鬼なり、":22,"我は誘起なり。":23,"骸に憑きて動かすもの。":24,"Electricity。":25,"飯食（イーハ）。":26,"すなわち第十相。":27,"肉の檻枷の虜囚。":28,"ぱら・みあきす・めいる。":29,"無楽の病。":30,"ＮＡＩ。":31,"ななむしる。":32,"アリスの詩。":33,"病死手。":34,"此岸たる黒、":35,"彼岸たる白。":36,"甘き声が響く。":37,"ああ懐かしい。":38,"其処に居たの。":39,"漸く逢えたな。":40,"おぎやあああ。":41,"おわああああ。":42,"まこくん。":43,"がまんしてる？":44,"んむー。":45,"のうがくうてんですか。":46,"さあ。":47,"しんでみますか？":48,"てきは●●。":49,"よるはみかた。":50,"おめがのひとみ。":51,"きこえますかとらいのしきが？":52,"ないんらいう゛ず。":53,"さんさんさん。":54,"いいくぼまこと。イーハ。":55,"「――はっ。":56,"……宮さ？の声が？？":57,"…おわあああ？！」":58,"一瞬驚くも、身体は俊敏に反応できず。":59,"眠りの中なのか覚醒したのかも曖昧なまま、\nただ宮さんの声が聞こえ続ける。":60,"「んむ。":61,"目が覚めましたね。":62,"気分どうですかまこくん？":63,"大丈夫？」":64,"覗き込むようにこちらを見下ろす宮さんがいた。":65,"ああ、目覚める直前のはやっぱり宮さんの声か。":66,"夢と融合してた…。":67,"って、あれ。":68,"今みていた、\n夢らしきものの記憶は瞬時に消え失せたようで、\n………。":69,"全く思い出せません。":70,"それよりもまず目前のリアルに対処しよう、\n思わず後頭部をまさぐり、ただの枕であることを確認する。":71,"「何してるんですかまこくん？」":72,"「え？あ、\nいやなんでも。":73,"ちょっとしたトラウマです」":74,"念のためだ。":75,"そうそう何度も女子におちょくられては悲しすぎる。":76,"決して期待していた訳ではない。":77,"…残念、とは思ってないから。":78,"念のため。":79,"そんな余裕無いです。":80,"まだ上体も起こ…せないな。":81,"「知狡とチノは後で来ますけど。":82,"宮がまこくんのお世話をしてあげてたんです。":83,"がっつり寝顔は見させて貰いました。":84,"…うひひ、\nあとで鏡みてみてね♪」":85,"「あのね…":86,"あなたは修学旅行中の男子ですか。":87,"ああもう、人が寝てる間に何したんですか～…」":88,"「額に文字なんてベタいことはしてませんよーだ」":89,"「逆に怖いんですけど…":90,"てかそれ以前にこの状況は一体どういう事、なんでしょう。":91,"えーと、確か？本家に行ったはずですよね僕は？」":92,"「んむ？":93,"覚えてない？":94,"頭打ったかな？」":95,"額に手を当てこちらの眼を覗き込むように近づいてくる。":96,"思わず視線を逸らしてしまう。":97,"近い近い近い…":98,"近いって宮さん。":99,"「いやいやいや、\nちょっと寝起きで混乱してるだけ、です多分。":100,"最近変な夢ばっかりでして…":101,"旅疲れですかねえ……":102,"ああええと、何があったんだったか………」":103,"そうか。":104,"家宝のなんとかまめって仮面を視ていたらば、\n突然倒れてしまったのだった。":105,"「お昼ご飯は、残念ですが一緒は無理ぽかったので、\n先に宮だけ摂りました。":106,"まこくんお腹はどう？":107,"何か食べられそう？」":108,"「ええと、ん？":109,"今何時です？」":110,"「昼の二時でーす」":111,"「うあ！？":112,"僕どんだけ寝込んでたんだ…":113,"ああ、時間知ったら急に飢餓感が襲ってきました…」":114,"「うひひ、\nそんだけ食欲あるなら心配要らないようですね。":115,"安心しました。":116,"取り敢えず、おにぎり、茶漬けは用意してありますけど。":117,"パンがお好みならそれでも」":118,"「あーえーと、":119,"じゃお茶漬けで…梅でお願いします」":120,"「はぁい♪":121,"あ・な・た」":122,"「止めて下さいって…」":123,"「うひひひひひっ。":124,"まこくん揶うの面白いにゃあ。":125,"ん、それはさておき、今持ってきますね。":126,"待ってて下さい」":127,"にゃあってまた、どこぞの女子みたいな真似を…":128,"揶うっていやあ、猫は鼠だの土竜だの、\n捕まえても直ぐには殺さずいたぶるっつーもんね…":129,"………。":130,"いたぶられてる獲物なのか僕は。":131,"ん？":132,"いたぶられてるというか嬲られてる？":133,"どっちでもいいですが。":134,"あーもう色んな人の口癖に感染しちょる。":135,"己が希薄だとすぐ他人色に染まっちゃうんだなあこれが。":136,"反省しよ…":137,"――にしても。":138,"「こちとらー明日は大変だってのに、\n世は静かだなあ……」":139,"耳鳴り聞こえる程に静かだ。":140,"『ねこざんまい』も山近くで静閑だったが、\n此処いら辺の静けさはその比じゃない。":141,"部屋の防音性も高いし…":142,"って、あ？":143,"此処誰の部屋だ？":144,"僕の部屋じゃないな。僕の部屋はもちっと川の音とかが…":145,"「あ？":146,"此処宮さんの部屋か…おいおい……」":147,"何で僕の部屋に寝かせてくれないんだよ…":148,"此処は階も上だし、運ぶだけ無駄な労力要ったろうに…":149,"大体、自分の部屋に帰る僕の足労はどうなる。":150,"…う、まさか宮さん使用中の布団とかじゃないよなこれ。":151,"旅館だしあんま関係ないか。":152,"「うーんしかし…」":153,"一体何があったのか。":154,"無難に考えれば、やっぱ空腹と緊張か。":155,"或いは前日の女子まみれで疲れてたか。":156,"はたまた閉塞空間で一瞬でも恐慌状態に陥ったか。":157,"閉所恐怖症ではないと思ってたんだけどなあ…":158,"向こうのアパートも本棚でぎちぎちの狭いとこで\n生活してた訳だし…":159,"「（まこくーん。":160,"入るよぉー）」":161,"こつこつ、という音と共に扉の外から声がした。":162,"「はぁーい」":163,"上体を何とか起こす。":164,"おっ……と、まだ頭に鈍痛が走るな…":165,"ふうぅ…":166,"「お待たせぇ～」":167,"「あ、ありがとうございますー」":168,"お盆の上に、丼一杯分のご飯にラップ掛けたものと\n魔法瓶に空の茶碗に湯飲み二つ、そして箸に茶漬けの素が載ってる。":169,"卓袱台の上に置き、宮さんは寝てる僕の横に\nちょこんと座った。":170,"「好きなくらい適当によそってください。":171,"あ、飲み物":172,"白":173,"湯になっちゃいますね」":174,"「あーいいですいいです、":175,"調子戻ったら普通に何か買って飲みますから…」":176,"「一応ご飯はチンして来たので、\n時間経つと冷めますよ。":177,"お茶漬けだから関係ないかもですが。":178,"まあ無理しないで下さい。":179,"よそってあげましょうか？」":180,"「…ええと、いいですかねお願いしても」":181,"「はい、ちょっと待ってて下さい」":182,"優しくそう言って宮さんは卓袱台へ。":183,"ちょっとまだ本調子じゃなくて、\n思わず甘えてしまったが…失敗したかなあ…":184,"静かな部屋に、こう二人きりというのは、\n…照れる。":185,"というより、こっちが床に伏せている状態が、\nまるで幼き日の、\n風邪をひいて寝込んでいる自分、\nそして看病してくれる母さん、":186,"のような何とも言えないこそばゆさがもう身悶えしたい程に今、僕を襲っていますよ。":187,"今はあんな母さんでも、昔は――":188,"まあ、過去記憶が超曖昧な僕が言っても説得力無いけど。":189,"メディアに埋め込まれた後付記憶かもしれないしな、\n温かい母親像なんて。":190,"と、独り空想に耽ったところでこの状況は。":191,"静けさが相まって、間が持たない。":192,"無音であるが故に、余計な思索を妨げるものもない。":193,"おかしな事を考えてしまうわけではないが、\nつまり、照れるしかないというか。":194,"看病という状況て、\n常日頃顔を合わせてる者同士の場合は、\n普段の関係性とは違う側面の表出に他ならず、\n否、側面というよりステージの階層の差か、\n仮面の内側が視られてしまう恥ずかしさが半端じゃない。":195,"人ん家に泊まるのが苦手な人っているけども、\nそういう理由かもなあ。":196,"そして、\n静けさの中に宮さんと二人って、\nシチュエーションはあんまり変わらないはずなのに、\nバイトしてるときとはやっぱり違う。":197,"上体起きてるとは言っても、布団に入ってるのがあれなのかな…":198,"『横になる』という行為、状況自体、無防備そのものだし。":199,"「さ、できましたよぉ。":200,"召・し・上・が・れ・♪」":201,"「…なんか宮さんここんとこハイぽいですよね…":202,"木":203,"天":204,"蓼でも嗅いだんですか」":205,"なんでわかったの？」":206,"「や、\n冗談はいいです、\nどっこいしょ、どうも、頂きます」":207,"ようよう鈍痛も収まってきたので、\n布団から出て卓袱台に向かう。":208,"そこで己が身をふと確認するが、\n…さすがに勝手に着替えさせられては居なかったか。":209,"ふーやれやれ。":210,"「窓開けて良いすかね」":211,"「どぞ」":212,"上方階なのでか、風が強めに吹き込む。":213,"茶漬けみたいな、摂食にあたり必要以上に音の出る食物、\n粛々とした雰囲気の中食べられませんからな！":214,"「宮も":215,"湯だけお付き合いしますね」":216,"と言って、宮さんは湯飲みに湯を注いだ。":217,"ずずずー…":218,"外界の音を細く聴きつ、しばらく二人の湯を啜る音が\n部屋に響いていた。":219,"なんだこの状況。":220,"思わず二人で笑い合うのであった。":221,"食事が済むと、":222,"「さ、大事をとらないと。":223,"明日のこともありますし。":224,"寝て下さい寝て下さい。":225,"そう、こっちのほうがかーあいいねえ、うひひ」":226,"せっつかれ、思わずまた布団に入ってしまう僕。":227,"喰ってすぐ寝ると…じゃなく、":228,"「あのねだから、」":229,"――額に手を当てられた。":230,"駄目だって…":231,"そういうのが、\nその手の冷たさが、\n恥ずかしすぎる……":232,"「にひひ」":233,"「………」":234,"「あまり心配かけないでね」":235,"「………はあ」":236,"「じゃ片づけてきます」":237,"すっくと立ち上がる宮さん。":238,"すると今まで全く意識してなかったのだが、\n空腹が満たされた所為か、復調してきた所為か、\n宮さんの脚。":239,"何か、突然眼に入ってきた。":240,"えー、ちょっと無防備なのではないでしょうか。":241,"「あの…初日の件もあるし、":242,"あまりこう言うのも何ですが、\n僕がこう寝てる体勢なのにですね、":243,"そうその、僕の周りをスカートでうろうろしない方が\n良いんではないですかね…」":244,"すると不思議そうに振り向く。":245,"「もしかして」":246,"「はい？」":247,"「宮で変な想像してたりして？":248,"大丈夫ですよぉ。":249,"今はちゃんとほら」":250,"「…っ！うや！！なにを…":251,"……あのそれ、ちゃんととかそういう問題？」":252,"捲るな捲るな。":253,"宮さんがスカートたくし上げると、\n下にはえーとこれ、ブルマですか。を、穿いておられた。":254,"あの写メで穿いてたやつだな…":255,"初日はさんざ人をスケベ呼ばわりしたろうに。":256,"もっと所作は貞淑に貞淑に。":257,"「女子のエロは何基準なのかさっぱりわからんですよ…」":258,"「ま、今のは気付け代わりです。":259,"今日はきっと旅疲れが出たんでしょうね。":260,"そろそろ真面目に調子戻してもらわないと、\n明日がありますから。":261,"眼の保養にもなったでしょお？":262,"サービスサービス」":263,"まあその一瞬どきっとはしましたが…":264,"結局アナタは僕を寝かしたいのか起こしたいのか。":265,"「…向こうさんにも同じこと言いましたけどね、\n宮さんのセクハラで僕は女性不信気味になってるんですから…":266,"もう少し妥当な距離で僕と接してくださいませんか」":267,"「んむー？":268,"これでも距離置いてますよ。":269,"もっと近づいて欲しいのかな？」":270,"「毎度宮さんとの会話は止めどきが難しいですね、":271,"あはは。":272,"はいもう結構です部屋に帰ります僕」":273,"布団から出て、身支度を整える。":274,"実際もうそろそろ帰った方が良いだろう。":275,"それこそ食事した所為か復調もして来ていたし。":276,"というかそれ故に今度は本意気で眠くなりつつあった。":277,"此処でマジ寝したらほんとに洒落にならない。":278,"色んな意味で。":279,"「あぁん、ちょっと待ってくださいよお。":280,"これ片付けてくるまでで良いですからぁ」":281,"「はいはい、ってああ、\n御陰様でもう大分調子戻りましたから、\n僕片付けますよ自分で」":282,"「もーっ、そんなに怒んないで下さい。":283,"じゃあ今晩は宮は用事あるので、\nまた、夕飯一緒に食べられません。":284,"残念ですが別々です。":285,"明日はまこくん、いよいよ三春のとこに潜入ですし、\nまたしばらく一緒になれないかもです」":286,"「怒ってませんよ別に。":287,"で、はいそうですね」":288,"「なのでまこくん。":289,"今日は宮がおまじないをしてあげます。":290,"…ちょっとこっち来て目瞑って」":291,"基本警戒したまま僕は、":292,"仕方ないので宮さんに近づき眼を閉じた。":293,"何するのよ…":294,"向かい合い、":295,"いつの間にか窓が閉められて音がしないこの部屋で、":296,"すると宮さんの手が僕の首にかけられ、":297,"首に、":298,"ひやりと。":299,"擽るような。":300,"冷たい指が絡まった。":301,"「………？」":302,"「うひひ。":303,"期待しちゃいましたか？":304,"残念でした。":305,"超健全なプレゼント、\nお守りです。":306,"もう眼開けても良いですよ」":307,"首に何かが巻かれている。":308,"が、首なので視えない。":309,"眼を開けようが閉じてようが関係ないじゃん。":310,"「あ、鏡は自分のお部屋でね」":311,"はいはい。":312,"そういや先刻、何やら顔を確認しろと…":313,"「じゃまこくん、\n明日は頑張って。":314,"そのチョーカー、外しちゃ駄目ですよ」":315,"チョーカーなのなこれは。":316,"と、手をひらひら振って僕を部屋から出す。":317,"やっぱりいつもの様に、\n自分からはあっさりと打ち切る宮さんであった。":318,"良いけど別に。":319,"閉じた扉。":320,"部屋の前に暫し立ち止まり、":321,"「…愛してます」":322,"呟いた。":323,"今回は何も無しか。":324,"ってかリアクションないとこれじゃ単なる一方的な告白じゃないかよ。":325,"違う違う。":326,"そんなんじゃないって。":327,"恥ずかしいなあもう！":328,"帰るます！":329,"言語も変！！":330,"茶漬けの食器とかを洗い場に返却したりと\n後片付けも終わり、":331,"晩飯は今日も件のラーメン屋かな…":332,"と思いつつ部屋に戻った。":333,"早速洗面所の鏡を視ると、首に巻いてあったのは――":334,"鈴の絵が描いてあるチョーカーだった。":335,"いつも宮さんが着けてるのと同じ。":336,"そういや先刻は宮さん着けてなかったな。":337,"…まさか現物付与じゃないだろうな。":338,"と視線を顔の方に移していくとだ、":339,"「………うあ。":340,"…………うああ」":341,"おいおい先刻これで人前うろうろしてたのか僕は…":342,"額に文字ならぬ――":343,"唇を押し付けた跡が。":344,"「あの人ぁ…":345,"ほんっと意味不明だわ……」":346,"この晩この後はもうあまりよく覚えてない。":347,"知狡さんは来てくれたがチノ嬢は用事だとかで来ず、\nその流れで知狡さんと飯を喰い、明日の為の準備をし、\n風呂に入って速攻寝たのだった。":348,"と、朝になっていた。":349,"時間が跳んだようだった。":350},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_012.ks","relPath":"/data/scenario/SC_M_012.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":351,"length":351,"percent":100},"cellInfo":[null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"t":"HU","v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"t":"HU"}],null,null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1}],null,null,null,[null,{"t":"HU"}],null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,[null,{"t":"HU"}],null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,[null,{"t":"HU"}],null,null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,[null,{"t":"HU"}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,[null,{"t":"HU","v":1}],null,null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,null,null,[null,{"t":"HU"}],null,null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"t":"HU"}],null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[113,0],"note":"完成"},"/data/scenario/SC_M_013.ks":{"data":[["宮さんのお守りが利いた訳でもないんだろうが、\n昨日の変調は跡形もなく失せて、\nどうやら我が身体、復調を為したようである。","虽然应该不是宫小姐的护身符生效，\n但昨天的不适已消失无踪，\n看来我的身体恢复如常了。"],["それもそうだ、時間が跳んだ錯覚に陥る程に熟睡したようだし。[l]\nただまあ、脳の回転に於いてはいつも通りかな。","这也难怪，毕竟睡得那么沉都有时间错位感了。[l]\n不过大脑运转还是老样子。"],["格別すっきりしてる訳でも無し、\n空腹になれば空転し出すだろうけども。","既没有特别清醒，\n饿肚子的话估计又会宕机吧。"],["今日が三春の家に行く日だというのもあったが、\n実際本当に昨日のあれで本家の用事は済んだ事になったらしい。","虽然今天是要去三春家的日子，\n但实际上昨天那件事似乎已经算完成本家任务了。"],["あれからは何も言われてない。","之后没人再提过。"],["今朝方、知狡さんが改めて僕の見舞いに来てくれたが、\n首に巻かれた宮さんのチョーカーを視るなり、\nまた微妙な顔をして変な納得をしたようだった。","今早知狡阿姨特意来看望我，\n看到我脖子上宫小姐的项圈后，\n又露出微妙表情似乎明白了什么。"],["で、当の宮さんはもう居らず、\n挨拶も何も出来ずに今日も僕は出かけます。","而宫小姐本人早已不见踪影，\n连道别都没有，今天我又要出门了。"],["それは別にいいんだが、\n実際あの人は何をしてるんだかなあ。","这倒无所谓，\n不过那个人到底在忙什么呢。"],["さて、きぃは流石に今日は携帯稼働させているはずなので、\n連絡つけて早めに合流しとこう。[l]\n具体的な決行時間が分からない以上仕方ない。","话说小贵的手机今天总该开机了吧，\n联系上早点会合吧。[l]\n既然具体行动时间不明也没办法。"],["さあ、どこまで心して掛かるか。[l]\n基本的に使命の本命は祭儀の時になるはずだが、\n早めにケリがついてくれるならそれに越したことはない――\nんだが…","来吧，看我能谨慎到什么程度。[l]\n原则上重头戏该是祭典仪式时，\n若能提前解决自然最好――\n但是…"],["それ以前に祭が行われるかは、まだ未確定なのだ。[l]\nその所為で僕は学校まで辞めさせられて此処に居るのだ。","在那之前祭典能否举行还是未知数。[l]\n正因如此我才被迫退学来到此处。"],["三春の母上様は何とかするつもりと仰せだったが、\nどうするんだか。[l]\n身内の不審死、警察沙汰にしないつもりか。[l]\nそれともそもそも不審な点など無いのか。","三春家的夫人表示会想办法处理，\n但具体要怎么做呢。[l]\n是打算把亲属离奇死亡的事压下来不让警方介入吗。[l]\n还是说这件事本身就没有可疑之处？"],["宮さんやかれお嬢が、\nあれは人為的な人死にと言ってはいたんだが、","虽然宫小姐和卡蕾欧小姐\n都坚称那是人为制造的命案，"],["そうであろうと事故だろうと、\nどっちだとしても隠すべき醜聞だと、三春家は判断している、\nという事になるのか？","但无论真相是谋杀还是事故，\n三春家都认定这是必须遮掩的丑闻，\n是这么回事吗？"],["地元有力者とて、現実問題としてどこまで仕切れるもんなのだか。","就算是地方权贵，从现实角度来说，到底能掌控到何种地步呢。"],["ああ、それにしてもどうにもなあ。[l]\n言い出せばそもそもの始まりからしてだが、\n突然多数の女子達との出会いやら、昨日の仮面の事やら、\n僕を取り巻く環境の激変はどうだろう。","啊，不过说到底还是无解啊。[l]\n要说起来从最初开始，\n突然与众多女孩相遇啦，昨天面具事件啦，\n我周遭环境的剧烈变化该怎么形容呢。"],["不穏…とまでは言わないにせよ、[l]\n目まぐるしいなあ事象の起こりが。","虽不至于说是危机四伏，[l]\n但事态发展也太过眼花缭乱了。"],["昔の記憶が曖昧だから何とも言えないが、\n人生でこんなに高密度で事が起こるのって珍しい気が。","因为过去的记忆模糊所以不好断言，\n但人生中发生如此高密度的事件应该很罕见吧。"],["人間生きてりゃ、そういう波はあるんだろうけど。[l]\n平々凡々な人生と波瀾万丈な人生、一体どちらがレアなのか。","虽说人活着总会经历些风浪。[l]\n平平无奇的人生与波澜万丈的人生，到底哪边更稀有呢。"],["確率グラフ？で言えば山の両端、珍しさでは同等かねえ。[l]\nま、物事は縦ですっぱり割り切れるもんでもないし、\nん？横割りか？[l]\nどっちでもいいですけどね。","用概率分布图来说就是山峰的两端，稀有程度相当吧。[l]\n嘛，世事也不能这么干脆地一刀切，\n嗯？横向切割？[l]\n怎样都无所谓啦。"],["いずれ理系文系とか、ＡＢＯ型だとか男とか女とか、\nそういうカテゴリに綺麗に収まることなんかほとんどないって事さな。","说到底理科文科啊、ABO血型啊、男人女人啊，\n这世上很少有能完美归类的事情。"],["全てが理路整然と分類できたほうが分かり易いし\n自分が世の中の法則を分かった気になれるからあれだが、\n実際そんな小難しい理屈でなくとも、僕とて本棚整理するときは\nカテゴライズには毎度頭を悩まされるのだ。","虽然万物若能条理分明地分类会更容易理解，\n也让人自以为掌握了世间法则，\n但实际上就算不扯这些深奥道理，我整理书架时\n也总为分类标准头疼。"],["判型で分けるべきか、作家で分けるべきか、\nジャンルなのか出版元なのか。[l]\n読む頻度による利便性なのか収納見た目の美しさなのか。","该按开本分？按作家分？\n按体裁还是出版社？[l]\n考虑阅读频率的便利性还是收纳外观的美观度？"],["そんな事をしてる間にあっ夕方だ！[l]\n…という事が何度あったことか。","纠结这些的功夫转眼就到傍晚！[l]\n...这种事发生过多少次了。"],["――まあ全く以てどうでもいいことだった。","――说到底根本无关紧要。"],["そうか、朝飯前だもんな。[l]\n早速空転もしようというものだ。[l]\nとっとと食事して今日に備えよう。","对了，反正还没吃早饭。[l]\n正好可以让脑子空转一下。[l]\n赶紧吃完准备迎接今天吧。"],["「きぃは…別にいいか、誘わんでも」","「小贵...算了，不叫她了」"],["喚んだら大喜びで速攻飛んで来そうだけど。[l]\nまあ、僕も今のところ貯金暮らしだし、\nこないだみたいな量を喰われても賄い切れるか心配だので。","虽然喊她的话肯定会欢天喜地立刻飞奔过来。[l]\n毕竟我现在靠存款过日子，\n要是她又像上次那样暴饮暴食我可负担不起。"],["って喚んだ時点で僕奢りみたいに想定せんでもいいんだが、\nなにせ自称ビンボー少女を飯に喚んでおいて、\n割り勘なんて言った日にぁ…[l]\nくわばらくわばら…","虽说喊人时倒没打算请客，\n但既然叫了自称贫穷少女来吃饭，\n要是提出AA制的话...[l]\n阿弥陀佛阿弥陀佛..."],["……これって忌避け落雷避けの呪文だっけか。[l]\nってまた変な方向に思考が横滑りしてるわ。[l]\n朝飯喰うんだ朝飯。朝飯を！","……这是避雷驱邪的咒语来着？[l]\n啊又往奇怪的方向胡思乱想了。[l]\n吃早饭吃早饭。专心吃早饭！"],["ここは旅館だが、ホテルのようにロビーにバイキング形式の食堂もあるゆえ、適当にチョイスし席に着き、食事開始。","虽是旅馆却有酒店式自助餐厅，随意取餐就座开动。"],["あんまり人も居ない。[l]\nあー、牛乳美味いなあ…","没什么客人。[l]\n啊——牛奶真好喝..."],["「Good Morning。[l]\nん？[l]\nGuten Morgen？[l]\nいや、お早う御座いますか」","「Good Morning。[l]\n嗯？[l]\nGuten Morgen？[l]\n不对，该说早安才对」"],["「おわ！？[l]\nい、居たんですか。[l]\nおは、お早うございます…」","「哇！？[l]\n原、原来您在啊。[l]\n早、早安...」"],["振り向くとチノ嬢が昨日と同じ姿で立っていた。[l]\n無駄な考え事をしていた所為もあるが、\n全く気付かなかった。[l]\nてか真後ろから近づかれてたし！[l]\nあぶな、牛乳噴くとこだった。","一回头发现千乃小姐以和昨天相同的姿态站在那里。[l]\n虽然也有胡思乱想的缘故，\n但完全没察觉到。[l]\n不如说根本是从正后方靠近的啊！[l]\n危险、差点把牛奶喷出来了。"],["「所用があった私は昨日見舞いに行けなかったので今来ました。[l]\nご機嫌は如何です？[l]\n","「我昨天有事没能来探望。[l]\n您身体可好？[l]\n"],["ああ…鈴が付けられてますね」","啊…挂着铃铛呢」"],["「鈴…[l]\nあ、これですか」","「铃…[l]\n啊、是这个吗」"],["宮さんから貰ったチョーカーを指した。[l]\n確かに柄は鈴だけども。[l]\n鼠が猫に付けようとして云々って話があったなあ。[l]\nあれ結局付けたんだっけ？付けられなかたんだっけ？[l]\n目的とその条件の順序が逆で基本的に無理問答なパターンだっけ？[l]\n炎の魔剣を得るには…それはまた別の話か、って。[l]\n今日は何かというと横滑るなあ。いかんなあ。","指了指宫小姐送的项圈。[l]\n花纹确实是铃铛没错。[l]\n好像有老鼠想给猫戴铃铛的典故来着。[l]\n最后到底戴没戴成来着？[l]\n根本是目的和条件倒置的死循环问题吧？[l]\n要获得火焰魔剑的话…那又是另一回事了。[l]\n今天思维怎么老是跑偏。不妙啊。"],["「ふむ。[l]\n好くお似合いです。[l]\n良かったですね宮店長からの下賜ですね」","「嗯。[l]\n很适合您。[l]\n能获赠宫店长的赏赐真是太好了」"],["下賜…[l]\n高貴な人物から下の者に物を与えることですね。[l]\n下（くだ）し賜（たまわ）る事ね。","赏赐…[l]\n就是指高贵之人向地位低下者赐予物品吧。[l]\n就是赐予下方之人东西这回事。"],["「まあ、或る意味まさしく下賜された物ですけどね。[l]\nどうせ宮さんと僕はそういう間柄です。[l]\nえ、て何で分かるんですか、\nこれが宮さんから貰った物だって」","「嘛、某种意义上确实是赏赐物。[l]\n反正宫小姐和我就是这种关系。[l]\n咦、为什么你会知道，\n这是宫小姐送的东西」"],["「察してしまうのですよ私は」","「因为我能洞察到呀」"],["「そ、そうすか。[l]\nそういやそうでしたねあはは…」","「这、这样啊。[l]\n说起来确实是这样呢哈哈…」"],["昨日から察しまくりでおられます事で。[l]\n本当にテレパスか何かじゃないのか。","从昨天开始就一直在疯狂洞察呢。[l]\n该不会真有心灵感应什么的吧。"],["「ま、今日の事に関しましては、\nどうかお気楽に。[l]\n月末まで待てば祭はあるんですし」","「关于今天的事，\n请放轻松。[l]\n等到月末祭典就会举办的」"],["「えー、まだわかんないって話じゃなかったでしたっけ。[l]\nさっきもそれ考えてましたけど、\n殺…ええと、事件がまだ未解決のままで、[l]\nやれてしまうもんですかね？」","「诶—不是说还不确定吗。[l]\n刚才我也在考虑这个，\n杀…呃、案件还没解决的情况下，[l]\n真的能办吗？」"],["「どうあれやりますね彼女等は」","「无论如何她们都会办的」"],["な、何故断言できるんでしょうカ。","为、为什么能这么断言啊。"],["「延期とか多少規模が縮小されるとか…」","「可能会延期或缩小规模…」"],["「まだ公に事件と謂われた訳でもなく、\n事故…そうですね、この辺だと肉食野生動物もいますから[l]\nいくらでも無難な方向に持っていけますかね。[l]\n色んな事情がこの土地にはありますしね。[l]\nヒトは思考道筋が選択可能な条件の場合は、\n都合の良い方を採るように出来てますから、\nいくらでも有耶無耶に出来ます」","「毕竟尚未正式定性为案件，\n事故…说起来这附近也有肉食性野生动物[l]\n总能往稳妥的方向引导吧。[l]\n这片土地有各种特殊情状呢。[l]\n人类在可选择思考路径时，\n天生就会选取对自己有利的，\n总能含糊其辞蒙混过去」"],["少なくとも土地の者に対してはね、と彼女は言った。","至少对本地人是这样，她补充道。"],["「動物ですか……[l]\n熊とかですか。[l]\n狼ですか」","「动物吗……[l]\n熊之类的？[l]\n还是狼？」"],["「ん？どっちでもいいですけど」","「嗯？都无所谓啦」"],["や、狼はこの國にはもう居ません…","不、这个国家已经没有狼了…"],["「ともあれ先刻申しました通り、\nそもそも事件性を見出してるのは当事者達と我々だけで、\n対外的にはまだ不穏なアナウンスはしていないんです。[l]\n下々の者にしたって、\nあ、私が彼らを下にみてるんではないですよ。[l]\n三春にスキャンダルがあっては困りますしね、\n祭は貴重な外貨稼ぎ…ん？外貨ではないな。","「正如方才所说，\n发现案件性质的只有当事人和我们，\n对外尚未发布任何不安定公告。[l]\n至于底层民众…\n啊、我并非看不起他们。[l]\n毕竟三春家不能传出丑闻，\n祭典是重要的外汇收入…咦？也不算外汇。"],["観光資源としてのイヴェントですから\n敢えて中止を望む者は居ませんよ。[l]\nそうでなくても祭事や神事というものは、\n古くから人の死に優先する事はままあるでしょう。","毕竟这是作为观光资源的庆典活动\n没人会刻意希望中止的。[l]\n即便不是如此，祭祀活动这类事情\n自古以来就常有优先于人之生死的情况吧。"],["祭自体で死人が出たりすることは勿論、贄を捧げるものすらあった訳ですから」","别说祭典本身出过人命，甚至还有过献祭活人的传统呢」"],["「まあ、そういう事もあったかも知れませんが、\nそれを良しと享受しても構わないかどうかは別でしょう…」","「嘛，虽然可能存在过这种事\n但能否认同并接受就是另一回事了…」"],["しかしそうなるといよいよもって僕が\n早入りした意味がないんでは…[l]\nもう諦めてるから良いけどさあ……","可这样一来我不就\n白提前过来了吗…[l]\n反正我都放弃学业了倒也无所谓啦……"],["「良いじゃないですか。[l]\n女子達との楽しい交わりもあったようですし。[l]\nいずれ今回の事は突発事故であることに違いは有りません。","「不是挺好的嘛。[l]\n看来您和姑娘们相处得很愉快呢。[l]\n说到底这次事件终归是突发事故。"],["備えあれば憂い無し、\n備わらんことを一人に求むるなかれ、\n","有备则无患\n勿苛责未备之人\n"],["ん？違うか？[l]\nどっちでもいいですが」","嗯？说错了？[l]\n怎样都无所谓啦」"],["また僕は何も言ってませんが…[l]\nそして後者は全く意味が違うって。[l]\nこの人もズレ幅激しくなってきたな。","虽然我压根没提过这事…[l]\n而且后半句完全不是这个意思啊。[l]\n这位的脱线程度也越来越夸张了。"],["飯窪関係者は本当にびっくり人間である事を基準に\n集められてるんじゃ…[l]\n筆頭の知狡さんからして何か様子が変…あれが常態だったかどうかは定かじゃないけど、","饭洼相关人士怕不是专挑\n惊世骇俗之人聚集的…[l]\n光是领头的知狡阿姨就够反常…虽说不知那是否算常态"],["少なくとも度が過ぎる真面目さは変と評されても仕方ない部分はある。","但那份过度的认真被当成怪人也无可厚非。"],["「実際どういう形で彼等が誤魔化すかは、\nその時が来れば分かる事ですが。","「实际上他们会如何蒙混过关\n等时候到了自然知晓。"],["仰々しく報じられたり深読みしなければ、\n誰も気にもしないレヴェルの話なのですよ、おそらくは。","只要不大肆报道或过度解读\n恐怕根本没人会在意这种程度的事吧。"],["じゃあ私もこれで。[l]\n宮店長の祝福あれ。[l]\nGood Luck。","那我也就此告辞。[l]\n愿宫店长保佑您。[l]\nGood Luck。"],["ミ・キャミャルキャラモロコネコナメタサキャラ\nタサコネタサメミャラメンカヤコネキャ・ワ」","mi・kya mya ru kya ra mo ro ko ne ko na me ta sa kya ra\nta sa ko ne ta sa me mya ra me n ka ya ko ne kya・wa」"],["はい？[l]\n最後なんて言った？","啊？[l]\n最后说了啥？"],["「みゃんみゃんきゃらきゃらわ？」","「喵喵迦拉迦拉哇？」"],["彼女は恭しく会釈をし、立ち去ってしまった。","她恭敬地行礼后便离开了。"],["……かれお嬢の使う言葉は只のエセ外國人だったけど、[l]\nチノ嬢のはよく分からんなあ。[l]\nサンスクリット…とも違う感じだし……","……卡蕾欧小姐用的只是伪外语[l]\n但千乃小姐的就完全搞不懂了。[l]\n感觉也不是梵文……"],["なうまくさんまんだぼだなんあびらうんけんそわか…[l]\nおんまかきゃらやそわか…","南无妙法莲华经……[l]\n唵摩诃迦罗耶莎婆诃…"],["──んー、わからん。やっぱり違うという事しか。","──嗯ー，不懂。只能确定不是那个。"],["どっちにしても疲れる事には変わりなし、\nどうしたもんかなあ。","总之都挺费神的\n该怎么办才好呢。"],["この件が終わったら実際どうなるんだろ。[l]\n『ねこざんまい』は向こうにあるし、\n最後にゃまたあっちに戻るのかな。","这事结束后到底会变成怎样。[l]\n『猫三昧』在那边\n最后该不会又要回那边吧。"],["でも本家は僕に、\n何かしらの役なり職なりを ","不过本家或许\n想给我安排 "],["宛 いたいのかも知れないしなあ。","某个职位或差事。"],["あの家宝とやらの面の関係上、\n男子は何かしら特殊な立ち位置みたいな事も言っていたし、\nそうならこっちに住む事になるんだろうか。","考虑到那个传家宝的渊源\n他们说过男性似乎有特殊地位\n真要那样就得住这边了吧。"],["未だ向こう在住の母さんの件もあれば旅館の今後の事もあるわで、\nなーんかややこしくなりそうな気配はするなー…[l]\n知狡さん、早く結婚して子供つくればいいのに。","既有仍住在那边的母亲要照顾，又有旅馆今后的发展\n总觉得会变得超麻烦啊ー…[l]\n知狡阿姨早点结婚生子不就好了。"],["…余計ややこしくなるか？[l]\nま、跡目争いなんかするつもりはないし、\n生活保障さえしてくれれば僕ぁどんなポジションだろうと\n構わないんだが。","…会更混乱吧？[l]\n反正我没打算争继承权\n只要保障基本生活，什么职位\n我都无所谓。"],["周りが、かれお嬢とかチノ嬢とかみたいな人だらけになるというのはあれだけども…","不过周围全是卡蕾欧小姐、千乃小姐这类人就…"],["ま、いいや。[l]\n獲らぬ狸の何とやら。","嘛，算了。[l]\n抓不到的狸猫，说什么都没用。"],["中断していた朝食を摂り終え、\nなるべく黒め地味めの服を選んで着用したのを、\nお手洗いの姿見で確認し、","把中断的早餐吃完后，\n尽量选了件黑色朴素的衣服穿上，\n在洗手间的穿衣镜前确认，"],["首のチョーカーに触れて\nま、少しは祈ってみたりだ。[l]\nと同時に、…昨夜の額のあれを思い出しそうになる。","摸了摸脖子上的项圈\n嘛，姑且也祈祷了一下。[l]\n同时差点回想起…昨晚额头那档子事。"],["あぶねえあぶねえ、これからって時に動揺してどうする。[l]\nここは幸いにも手洗い場、\n水でばっしゃばっしゃ顔を洗う。","好险好险，这节骨眼上动摇可不行。[l]\n幸好这里是洗手台，\n哗啦哗啦地用冷水洗脸。"],["ふいー、\nさて。[l]\n行こうか。","呼咿——\n好了。[l]\n该走了吧。"],["外に出て電話する。[l]\nこないだの時に大体の時間として決めた九時はもう廻ってるし、\nもう準備もしとるだろう。","到外面去打电话。[l]\n之前约好的大致时间九点已经过了，\n应该已经准备好了吧。"],["………。[l]\n出ないな。","………。[l]\n没人接啊。"],["………。[l]\n遅いな。[l]\n……お、ようやく出た。","………。[l]\n真慢。[l]\n……哦、终于接了。"],["「もしもし僕ですけど」","「喂喂是我」"],["「んあー…誰？[l]\nふぉ？[l]\nあ、ああ！[l]\nふええ、おはよぉ、まこちゃん」","「嗯啊——…谁？[l]\n嚯？[l]\n啊、啊啊！[l]\n呜诶~早啊~真酱」"],["何かすっげえがっさがさの","刚才那声音粗"],["濁","哑"],["声だったな。[l]\n寝起きかよ。[l]\n時は金なりがどうのって言ってなかったか？言ってない？","得离谱啊。[l]\n刚睡醒吗这家伙。[l]\n之前不是说时间就是金钱啥的吗？没说过？"],["「…ああおはよう。[l]\n寝てるとこ悪いけどもな、\n大丈夫か今？","「…啊早。[l]\n虽然吵醒你不好意思，\n现在方便吗？"],["そろそろ時間なんだけど。[l]\nこっちはもう待ち合わせ場行こうと思うんだけども…」","差不多到时间了。[l]\n我这边已经准备去集合地点了…」"],["「ふああ…[l]\nあぁーいいよぉー。[l]\nダッシュで行くっすよぉ」","「哈啊…[l]\n啊——好吧——。[l]\n我会冲刺过去的哟」"],["大丈夫かほんとに。[l]\nてか朝飯どうする気だ。[l]\n起き抜けだったろう。","真的没问题吗。[l]\n话说早饭打算怎么解决。[l]\n你刚起床吧。"],["「ふえ？[l]\n朝ご飯は基本的に抜いてるのさ。[l]\n…ま、事情は訊かないで欲しいのだわ」","「诶？[l]\n早饭我基本都不吃的啦。[l]\n…嘛、具体原因就别问啦」"],["普通はダイエットとかなんだろうけど、\nお前の場合は明らかにまあ、節約ぽいのが悲しいなあ。[l]\n訊かないでおいてやるよ…","一般人可能是为了减肥之类的，\n但你这明显是，呃，为了省钱吧真让人心酸啊。[l]\n不问就不问吧…"],["「じゃこないだの公園で良いか？」","「那上次那个公园行不？」"],["「あ、駄目だね。[l]\n何か知り合いがすぐ近くに住んでるから見つかるって\n冬夏言ってたのさ。","「啊、不行呢。[l]\n因为有个熟人住在附近会被发现\n冬夏这么说的啦。"],["あのね、あの自販機小屋が良いのだわ。[l]\n冬夏ん家にそれなりに近いし」","我说啊、那个自动贩卖机小屋就不错。[l]\n离冬夏家也挺近的」"],["「あ、成る程ね。[l]\nそういや姫様ちゃんお目付役だって言ってたな」","「啊、原来如此。[l]\n说起来姫様酱说过自己是监察员呢」"],["「あーそうその","「啊对就是那个"],["娘。[l]\n昨日まこちゃん電話が繋がらなかったからさ、\n言うの忘れてたのだわ」","姑娘。[l]\n昨天真酱电话打不通来着、\n结果忘记告诉你了呢」"],["そうか、地下に居た時かなあ。[l]\n寝込んでた間は着信も無かったしな。","这样啊、可能当时在地下吧。[l]\n昏睡期间也没收到来电呢。"],["「ああ、悪かった。[l]\nじゃそこ行くわ」","「啊啊、抱歉。[l]\n那我这就过去」"],["「おっけ。[l]\n多分まこちゃんが先に着くでしょ。[l]\n待ってて欲しいのだわ」","「好嘞。[l]\n估计小真会先到吧。[l]\n希望你能等着我呐」"],["「はいよ。[l]\n……パンと牛乳でも買ってこうか？」","「好嘞。[l]\n……要顺路买点面包牛奶吗？」"],["「………！！[l]\nふ、ふええ、\nそ、それはどうにも…いや、そこまでしてもらっては…っ！！」","「………！！[l]\n呜、呜诶诶，\n这、这怎么好意思…不、不用做到这种地步…！！」"],["……まあ、いいけどなそれくらいなら。","……嘛，这种程度倒无所谓啦。"],["「腹の虫に鳴かれでもしたらこっちも困るしさ…[l]\nまあ遠慮するな。今回は」","「要是让你饿得肚子咕咕叫我也过意不去…[l]\n别客气啦。这次就」"],["今回も、というべきか。","或者说，每次都是。"],["「えっへへへへへ。[l]\nじゃマジ速攻行くからよろしこ！！」","「诶嘿嘿嘿嘿嘿。[l]\n那我这就火速出发啦！！」"],["ぶつ。","咚。"],["…わっかりやすい奴だなあ……[l]\n電話、あっさり切られる事に耐えられない人、\n結構いる筈だから気を付けろきぃ。","…真是个易懂的家伙啊……[l]\n这世上啊，意外地有很多\n受不了被突然挂电话的人，你可得当心点小贵。"],["まあそれはさておきだ。[l]\n途中コンビニもないのにうっかりそのつもりで出てしまい、\n幸いにも見つけたちっさい米屋みたいな処で、\nきぃの為にアンパンと牛乳を買い例の自販機小屋に着くと、","不过这都是题外话。[l]\n明明沿途根本没有便利店，却不自觉用这个理由出门，\n所幸在找到的一家寒碜米铺里，\n给小贵买了豆沙包和牛奶赶到自动贩卖机小屋时，"],["「えっへへへへへぇー。[l]\nおっはよう」","「诶嘿嘿嘿嘿嘿～[l]\n早呀」"],["きぃが来ていた。[l]\nお前どんだけ…[l]\nいくら僕が買い物してた時間があるとはいえ、\nどういう脚力…というか食欲してるんだ、[l]\nいやさ、食に対する執念か……","小贵已经在那儿了。[l]\n你这家伙到底…[l]\n就算把我去买东西的时间算上，\n这脚程…或者说这食欲是怎么回事，[l]\n不对，该说是对食物的执念吧……"],["「…おう。[l]\nほらこれ」","「…哟。[l]\n给」"],["袋ごと放ると、ボールを投げられた犬の如く大喜びでキャッチする。","整袋抛过去时，她像接到飞盘的狗般欢天喜地地接住。"],["「さんくすまこちゃん、\nありがたくいただきますのだわっ」","「谢谢小真，\n那我就不客气开动啦」"],["そう言って速攻パンを食し出すきぃ。[l]\n…まあ、この勢いなら、[l]\n食事時間が今後の動きに支障をきたすことはないだろう。[l]\nものの数分だなこれは……[l]\n自販機小屋が待ち合わせ場所なのに、\nなんで僕もわざわざ牛乳買ってしまったかなあ。[l]\nなんか、アンパンと牛乳っていう組み合わせに変な普遍性を\n思い込んでるというか。[l]\n瓶のがそれぽいんだけど、さすがに紙パックではあるが。","说着就狼吞虎咽啃起面包的小贵。[l]\n…看这架势，[l]\n应该不会因为吃饭耽误后续行动吧。[l]\n顶多几分钟的事儿……[l]\n明明自动贩卖机小屋是集合地点，\n我为啥还特意买牛奶呢。[l]\n总觉得对豆沙包配牛奶这种组合\n有种奇怪的执念。[l]\n虽然瓶装更有那味儿，但毕竟只有纸盒装。"],["ずぎゅるるる…とストローから音がし、その丁度飲み終えと同時に。","咕噜噜噜…吸管发出声响的瞬间，"],["トゥルルルルルルル。","嘟噜噜噜噜。"],["振動と共に僕の携帯が鳴った。[l]\nこの黒電話の着信音――冬夏からの電話だった。","手机随着震动响起。[l]\n这个复古铃声――是冬夏打来的。"],["「おはようお二人さん。[l]\n覚悟はいいかな？」","「早上好二位。[l]\n准备好了吗？」"],["数分後。","数分钟后。"],["冬夏は、朝の散歩と偽って僕らの居た自販機小屋に来たらしい。[l]\n日曜という事もあってラフな…ラフかこれは。[l]\n僕は服飾に全く明るくないのであれだが、\nまあ要するに私服でいらっしゃったのです冬夏さんは。","冬夏假装晨练来到我们所在的贩卖机小屋。[l]\n因为是周日所以穿得很休闲…这算休闲吗。[l]\n我对服装一窍不通，\n总之冬夏小姐穿的是便服。"],["「母様は私に留守番押し付けて行ったから、\nま、ある意味好都合だね。[l]\n派手なことしなければ私が黙ってるだけでも大丈夫そうってこと」","「母亲把看家任务甩给我就出门了，\n嘛，某种意义上正合适。[l]\n只要不闹出大动静，我睁只眼闭只眼应该没问题」"],["とは言え、全くの一人という訳ではなく、\n他の家人も居るらしいので、極力見つからないようにしないと、","不过家里并非空无一人，\n还有其他家庭成员在，必须尽量隐蔽行动，"],["バレたときに犯人が唯一の妖しい部外者である我々に確定されてしまう。","否则暴露时嫌疑会直接锁定在我们这几个可疑的外人身上。"],["堂々とは行けない、という事らしい。[l]\nホントかよ。スニーキングかよ。[l]\n派手なことしなくても見つかったらミスじゃ難易度高いじゃないかよ。","意思是不能大摇大摆行动。[l]\n真假。要潜行啊。[l]\n就算不闹出动静，被发现的话难度不就飙升了吗。"],["…なんか冬夏、少しばかり状況を愉しもうとしてないか。[l]\nこないだ何か変に深刻な","…冬夏该不会在享受这种状况吧。[l]\n上次还一副苦大仇深的"],["貌してたと思ったのは気の所為かなあ…","觉得装模作样大概是错觉吧…"],["「ただ、ちょっとここんとこ、\nおいたが過ぎててさ。[l]\nあんまり信用されてないかも？","「只是最近这段时间，\n玩笑开过头了啦。[l]\n可能不太被信任了？"],["というかいきなり真面目に言うこと聞くのも気持ち悪がられるかも？[l]\n的なね、不安はあるかなあ」","或者说突然认真听话反而会让人起鸡皮疙瘩？[l]\n之类的啦，有点不安呢」"],["あの、ちょっと、どんどん難度が…","那个、稍等、难度越来越…"],["「綾目だの狩屋だの、母様が私に黙って仕込んでそうだし、\n早めに事は済まそ。[l]\n今の処は――うごいてないようだから」","「又是绫目又是狩屋的，母亲大人肯定背着我偷偷布置了什么，\n趁早了结比较好。[l]\n目前看来――她们还没动静」"],["仕込むって…罠か何かか彼女達は。[l]\nそれに彼女らの去就はどうやって把握してるのか。","布置…是指陷阱之类的吗她们。[l]\n而且怎么掌握她们行踪的。"],["単に視認しただけか、\n……まさかチノ嬢並の察しスキルですか。[l]\nあのひとの場合はテレパスと言っても過言では無いが。","单纯靠目视确认吗，\n……总不会是有千乃小姐级别的洞察力吧。[l]\n那位的能力说是心灵感应都不为过。"],["「…で、まあ、早めに動いた方が良いのには[l]\nもう一つ理由があってね、\nお昼を挟むのは正直怖いんだよね。","「…另外嘛，要尽早行动还有[l]\n另一个理由，\n说实话很怕拖到午间时段。"],["食事には出ないといけないんだ私」","我必须出席用餐」"],["前にも聞いたが、\n例のおっかさんが栄養管理うるさいからだそうだ。","之前也听说过，\n据说那位老妈对营养管理特别啰嗦。"],["本来は外食禁止というか、きっちり家での献立があるらしい。[l]\nしかし、先日のきぃ御用達の店を知ってた通り、\n何度もその言い付けは破ってるようだが。","本来应该是禁止外食的，家里有严格制定的菜单。[l]\n不过从她知道小贵常去的店来看，\n这条禁令早就被打破很多次了。"],["「ほら、こないだなんか帰るなりそれで怒られたんだよ。[l]\n…姫様か克杖が言い付けたのかもしれないけど。","「你看，前几天刚回家就为这个挨骂了。[l]\n…可能是姫様或克杖告的状。"],["と言うわけで先刻のきぃの話じゃないけど、\n時間は無いんだ。午前中でどうにかして欲しいのね」","所以就像刚才小贵说的，\n时间不多了。希望上午能搞定啦」"],["午後か夜には、母上殿が帰ってくるんだろうしなあ。","下午或晚上母亲大人就该回来了吧。"],["「ま、まあねえ。","「嘛、嘛～"],["明確な目的があるなら、時間なくてもすぐ終わる筈だし、\n単なる好奇心なら短時間でも構わない訳だし\n大丈夫でしょう、かね？きぃ？」","要是有明确目的，时间短也能很快解决，\n单纯满足好奇心的话花点时间也无所谓\n没问题的对吧～？小贵？」"],["少々きぃに対しての牽制というか、\nあいつの目的が曖昧だから","多少带点牵制小贵的意味，\n因为那家伙目的太模糊"],["明","连我"],["瞭とは僕も断じる事が出来ない。","也无法断言说（情况）已经很明确了。"],["「ふえ？」","「呜诶？」"],["「ま、いずれその条件で問題があっても\n修正のしようがないんだけど。[l]\n御免ね二人とも」","「嘛，就算事后因此出问题\n也没法修正了。[l]\n抱歉啦两位」"],["「あー気にしないさ。[l]\nそれより冬夏の顔色の方が気になるのだわ」","「啊～别在意。[l]\n倒是冬夏的脸色更让人担心呢」"],["え？[l]\nそんなに悪そうか？[l]\n僕にはいつも通りに視えたが、流石、女子は気付くのか。","诶？[l]\n有那么糟吗？[l]\n我看着和平时没两样，不愧是女生更敏锐吗。"],["まがりなりにも診療所バイトしてるだけのことはある。","毕竟在诊所打工不是白干的。"],["当然医療行為自体はやってないだろうけど、\n門前の小僧習わぬ経を読むという奴か、偉いもんだ…[l]\nと思ったが、当の冬夏自身は完全にスルー。","虽然应该没参与实际诊疗，\n但近朱者赤这说法真不假，厉害…[l]\n正这么想着，当事人冬夏却完全没接茬。"],["「本当は積極的な目的があるんだろうにね？」","「其实是有更积极的目的吧？」"],["う。[l]\nギャグ的流れで出て来得る台詞とは言え、\n今の僕には心臓に悪い。","呜。[l]\n虽然像是玩笑话的接梗台词，\n现在听来简直刺激心脏。"],["取り敢えず自分の態度はまた誤魔化し気味に、","姑且又用含糊的态度"],["「え、いやそのそんなことは…」","「哎、没没那回事…」"],["と、きぃに視線を向けると、","朝小贵使眼色时，"],["「ふえ？[l]\nあー、どうなのさ？[l]\nえへへ、わたしは…好奇心だけだけどぉ、[l]\n出来れば…視ておきたいのだわ」","「呜诶？[l]\n啊～怎么说呢？[l]\n嘿嘿，人家只是…单纯好奇啦～[l]\n可能的话…想亲眼看看呢」"],["と、こいつも視線定まらずといった風であった。[l]\n冬夏の体調不良を押してまで決行する程の具体的な理由は無いが、\n好奇心のが強いのだろう。[l]\nさすがに自分でも我が侭と知っているが故のその態度か。[l]\nそれとも、言えないけれども何か強い理由でもあるのか。","而、这家伙也是目光游移不定的样子。[l]\n虽没有具体到值得让冬夏抱病坚持执行的理由，\n大概是好奇心太强了吧。[l]\n或许正因为自己也明白这是任性才摆出这种态度？[l]\n又或者，是有难以启齿的强烈理由呢。"],["「ま、あまり多くは訊かないでおこう。[l]\nふふ、私も人が良いねえ」","「嘛，我还是别问太多好了。[l]\n呵呵，我这人也是太好说话了呢」"],["「あ、そう…[l]\nまあ本当にそんな深刻な話でもないから…[l]\n何事に関しても察してくれる人は系として嫌いじゃない系だし、\n取り敢えずそういう事にしておこうか…」","「啊，这样…[l]\n其实也不是什么严重的事啦…[l]\n不管怎么说，那种能洞察一切的人，作为搭档来讲也不是让人讨厌的类型，\n总之就先这么着吧…」"],["「そそ、\nほら、時は金なりっていうさ。[l]\n何とかの考え休むに似たりというのだわ」","「对、对了，\n你看，俗话说时间就是金钱。[l]\n想破脑袋也白搭嘛」"],["僕が電話するまで寝ていた人間がそれを言うか。[l]\n結局冬夏がああ言ったので、\nきぃの微妙な立ち振る舞いも放置して話を進める。[l]\n僕自身の方を突っ込まれる事になっても困るしー。","明明是被我电话吵醒的人在说这种话。[l]\n结果因为冬夏那么说了，\n就无视小贵微妙的举止继续话题。[l]\n要是被追问我的情况也很麻烦啊——"],["「きぃ、あんまり浮かれない。[l]\nいくら私と母様が仲悪くても、\n――今はまだ事を荒立てたくないんだ。[l]\n二人には悪いけどあんまり派手なことは…ね」","「小贵，别太得意忘形。[l]\n就算我和母亲大人关系再差，\n――现在还不想把事情闹大。[l]\n虽然对你们俩不好意思但太招摇的事还是…算了吧」"],["…『今は』？[l]\nそれって……","…『现在还』？[l]\n这意思是……"],["「ふええ、\nそのうちやらかすってことだね？」","「呜诶——\n迟早会搞出事情来的意思咯？」"],["お前…[l]\nお前は察しない奴だな。[l]\n少しはスルーしてあげなさい。","你这…[l]\n你这家伙真是不懂察言观色啊。[l]\n偶尔也该学会装糊涂。"],["あっさりデリケートそうな部分拾いやがって…[l]\nしょうがない。","居然轻描淡写就戳中敏感部位…[l]\n真拿你没办法。"],["「そういえばさ冬夏、\n気になってる事が一個あって…」","「话说冬夏，\n有件事我挺在意的…」"],["一応フォローで話題転換のつもりだったのだが、\nやや身構える冬夏。","本打算用这句话转换话题打圆场，\n冬夏却略显戒备。"],["「例の此処のあの、祭？[l]\nどうなるかまだ決まって…ないよね？」","「就是这里那个，祭典？[l]\n还没决定要…怎么办对吧？」"],["「…ああ、その話ね。[l]\nうーーーーん、とね、\nまだ聞いてないね。[l]\nでも」","「…啊，那件事啊。[l]\n嗯——————，那个呢，\n还没听说呢。[l]\n不过」"],["きっとやるよ、予定通りに。[l]\nと、チノ嬢が今朝言ったような事を言った。","肯定会按计划举行的。[l]\n说了和千乃小姐今早类似的话。"],["「私達は祭儀の主催だし、\n私個人も儀礼に参加しなくちゃいけないんだよ。[l]\n下の方の祭、一緒に行ければ好かったんだけどね…[l]\nあ、それ以前にまことさん、祭まで此処に居るの？」","「我们可是祭典的主办方，\n我个人也必须参加仪式的。[l]\n要是能和大家一起去山下祭典就好了…[l]\n啊，话说回来真言先生会待到祭典那天吗？」"],["「そうだね、日がずれ込みそうなら諦める感じかなあ…[l]\n結構先だもんねえ…」","「是啊，如果日期错开可能就算了…[l]\n毕竟还早得很呢…」"],["と言っておく。","先这么回应。"],["「わたしはどうしてるかなあ。[l]\n――仕事…だろうな」","「我的话会怎样呢。[l]\n――工作…吧」"],["遠い眼をしてきぃが","小贵望着远方"],["独り","独自"],["言ちた。[l]\nチノ嬢が言うように当日は稼ぎ時だろうし、\nきぃも","低语。[l]\n正如千乃小姐所说当天正是赚钱时机，\n小贵大概"],["出","也"],["店とかで臨時バイトのしどころだろう。[l]\n診療所がどんだけ忙しいかによるだろうけど。","会去店里打临时工吧。[l]\n不过要看诊所忙不忙了。"],["「まま、二人とも、気にしないで。[l]\n僕も人混み苦手だし、祭の日まで居るとしても、\n夜は旅館で部屋から雰囲気だけ愉しむ予定」","「算了，你们俩都别在意。[l]\n我本来就不擅长人挤人，就算待到祭典那天，\n晚上也打算在旅馆房间里感受气氛就好」"],["基本的に祭の日は任務決行の日であるので、\n同行の約束は当然ながら問題外だ。[l]\n…そもそも三春の人間とこうも接触してるという状況で、[l]\nどこまで誤魔化すべきなのか少々自信が無いんだけども。[l]\nこの流れだと、冬夏や姫様ちゃん…狩屋は別として、[l]\nに、直接協力仰げそうな感触もあるし……[l]\nともあれ今のところは、我ながら稚拙ではあるけれど、\nあらゆる事柄を極力グレーにしておく他に良策が思いつかない。[l]\n全く以て、流され巻き込まれキャラであるなあ…[l]\nいずれ巻き込み張本人の宮さんに相談しなければ。","基本上祭典当天就是执行任务的日子，\n同行的约定自然不在考虑范围内。[l]\n…说到底和三春家的人保持这种程度的接触，[l]\n到底该隐瞒到什么程度我实在没什么自信。[l]\n照这个趋势来看，除了冬夏和姫様…狩屋另当别论，[l]\n感觉也能直接寻求她们的协助……[l]\n总之现阶段虽然连我自己都觉得手段拙劣，\n除了尽量把所有事情都保持暧昧状态外想不出更好的办法。[l]\n完全就是个随波逐流的被动角色啊…[l]\n迟早得找那个始作俑者宫小姐商量。"],["「取り敢えずそれはそれ、\n無駄話が長引いちゃったしじゃあ――行こうか」","「总之先这样，\n闲扯太久了那就――出发吧」"],["「おけー」","「好嘞」"],["「まあまあ、そんな深刻な貌しないでよ。[l]\nこないだ言った通り、ま、大丈夫、でしょう」","「好啦好啦别摆出那么严肃的表情。[l]\n就像之前说的，嗯，没问题的，大概」"],["ふう、と眼を瞑り深呼吸する冬夏。","冬夏闭着眼睛做了个深呼吸。"],["その時、\n僕ら三人の周りの視界が…[l]\n……歪んだようにみえた。","就在那时，\n我们三人周围的视界…[l]\n……似乎产生了扭曲。"],["空間が、映画やＴＶのＣＧ効果のように、\n一瞬透明な","空间就像电影电视的CG特效般，\n瞬间浮现出透明"],["漣が帯状に走ったようにみえたのだ。","的带状涟漪。"],["トランジションエフェクトというか、\n走査線が走ったというか――","像是转场效果，\n又像是扫描线闪过――"],["「………？[l]\n何だ？どうした？」","「………？[l]\n怎么了？发生什么？」"],["そしてその歪みの消えしなに、\n何か白いモノが今、視界を","而在那扭曲消失的刹那，\n有什么白色的东西刚刚掠过"],["過って、\n――消えた。","视野，\n――消失了。"],["ああ。[l]\n猫が、","啊。[l]\n是猫，"],["…猫だ？[l]\n何で猫という認識が引き出されるんだ？[l]\nあの時のように──\nや、それもそうだが、","…猫吗？[l]\n为什么会下意识觉得是猫？[l]\n就像那时候一样——\n不，虽然确实如此，"],["「お、おい」","「喂、喂」"],["思わずきぃを視るが、\n何にも反応した様子はない。[l]\n冬夏は僕の呟きを、彼女自身に向けた心配の語として\n受け取ったらしく、\n眼を開けこちらに微笑みを返した。","我不由自主看向小贵，\n但她似乎完全没有察觉异样。[l]\n冬夏似乎把我的低语当成\n在担心她，\n睁开眼睛对我回以微笑。"],["「ふええ？[l]\nだいじょぶ冬夏？[l]\n緊張したさ？っれとも貧血なのだわ？」","「呜诶？[l]\n没事吧冬夏？[l]\n是紧张了咩？还是贫血了呐？」"],["「………っん、おーけ。[l]\n大丈夫、なんでもない。[l]\nまだこの…眼が、ね。疼くの」","「………嗯，没~事。[l]\n没关系，没什么大不了的。[l]\n只是这个…眼睛啦。有点刺痛」"],["気のせいか。[l]\n昨日の本家から、何か視界に変なモノが映るなあ。","是错觉吗。[l]\n从昨天在本家开始，视野里就老是出现奇怪的东西。"],["何かの残像か、眼ん中のゴミか何かか…[l]\nそういえば大神も『視える』人らしいが、\n奴が言うには、疲労困憊した時によくそうなるそうだ。","不知是残像还是眼睛里的灰尘什么的…[l]\n说起来大神好像也是『能看见』的人，\n据那家伙说疲劳过度时经常会出现这种情况。"],["確かにここんとこ、身も心も疲れてきてるぽいし、\nあれかな、一応医者行こうかなあ…[l]\nでもここいらの…ああ、例の診療所があるか。","确实最近身心都有些透支了，\n要不…还是去看看医生吧…[l]\n不过这附近…啊对了，有那家诊所来着。"],["今日先生を迎えに行ったということは、\n明日すぐではごたごたしてそうだな。","既然今天去接医生了，\n明天突然过去可能会手忙脚乱吧。"],["――というかそれ以前に、あんまり三春の関係筋とは\n接触しない方が良いんだろうけど…[l]\nきぃにお願いすれば大丈夫かなあ。","――不对在那之前，最好还是不要\n和三春相关人士接触…[l]\n拜托小贵的话应该没问题吧。"],["取り敢えず、この件終わったら宮さんに報告がてら\nお伺いを立てるか。[l]\n旅館に薬くらいあるかもだしー。","总之等这件事结束后，\n就去向宫小姐汇报顺便请示吧。[l]\n旅馆里说不定也有常备药呢—。"],["にしても、\nねこがなんなんだよ、僕のあたまよ。","不过话说回来、\n猫到底是怎么回事啊，我的脑袋啊。"],["「…あとちょっとね、あれが重くてさ」","「…还差一点啦、那个太重了」"],["………ああ。[l]\n冬夏のほうはそれですか。[l]\n成る程ねえ。[l]\n先刻の貴奴の診たても間違ってなかったのか。[l]\nにしても、相変わらず男子にとってリアクションに困る話題を\nあっさり言ってくれるなあ。","………啊啊。[l]\n冬夏那边是这个情况吗。[l]\n原来如此啊。[l]\n看来刚才贵奴的诊断也没错呢。[l]\n不过她还是一如既往地、\n随口就说些让男生不知如何接话的内容呢。"],["「大丈夫？[l]\n無理しないでよ」","「没关系吗？[l]\n别太勉强哦」"],["「良いんだって。…あ、後でまた何か奢ってもらおうかな」","「都说没关系啦…啊，要不待会儿再让你请客好了」"],["なんてねそれってまた母様に怒られるよ、と小声で笑いつつ、\n冬夏は僕らに移動を促した。","「开玩笑的啦，这样又会被妈妈骂的」，她小声笑着，\n冬夏催促我们动身。"],["「あ、ええと、一応別々に行ったほうが良くない？」","「啊、那个…我们分开走是不是比较好？」"],["「ん？[l]\nそんなことない。[l]\nだいじょぶ。[l]\n寧ろみんな固まって動いてくれる？」","「嗯？[l]\n没那回事。[l]\n没问题的。[l]\n不如说大家能一起行动吗？」"],["あ、そう。[l]\nまあこの場合は下手な時間差作っても、\n全員揃うまでは入り口外で立ち往生だもんな。[l]\n素直に従いましょう。","啊、也是。[l]\n这种场合就算刻意错开时间，\n在全员到齐前也只能在入口干等着呢。[l]\n老实跟着走吧。"],["「さあさあ、へびがでるかじゃがでるか…あれ？」","「来来来，是会冒出蛇呢还是冒出长虫呢…咦？」"],["「どっちも蛇だそれ。[l]\n正確には…鬼？あれ、仏？」","「两边都是蛇啦。[l]\n准确说是…鬼？不对，是佛？」"],["「君等はほんと…お気楽だね……」","「你们真是…心够大的……」"],["はは、と力なく笑って冬夏は歩き出した。","哈哈，冬夏无力地笑了笑，迈步向前走去。"]],"context":[["SC_M_013.ks/index/1/text"],["SC_M_013.ks/index/3/text"],["SC_M_013.ks/index/5/text"],["SC_M_013.ks/index/7/text"],["SC_M_013.ks/index/9/text"],["SC_M_013.ks/index/11/text"],["SC_M_013.ks/index/13/text"],["SC_M_013.ks/index/15/text"],["SC_M_013.ks/index/17/text"],["SC_M_013.ks/index/19/text"],["SC_M_013.ks/index/21/text"],["SC_M_013.ks/index/23/text"],["SC_M_013.ks/index/25/text"],["SC_M_013.ks/index/27/text"],["SC_M_013.ks/index/29/text"],["SC_M_013.ks/index/31/text"],["SC_M_013.ks/index/33/text"],["SC_M_013.ks/index/35/text"],["SC_M_013.ks/index/37/text"],["SC_M_013.ks/index/39/text"],["SC_M_013.ks/index/41/text"],["SC_M_013.ks/index/43/text"],["SC_M_013.ks/index/45/text"],["SC_M_013.ks/index/47/text"],["SC_M_013.ks/index/49/text"],["SC_M_013.ks/index/51/text"],["SC_M_013.ks/index/53/text"],["SC_M_013.ks/index/55/text"],["SC_M_013.ks/index/57/text"],["SC_M_013.ks/index/59/text"],["SC_M_013.ks/index/61/text"],["SC_M_013.ks/index/63/text"],["SC_M_013.ks/index/65/text"],["SC_M_013.ks/index/67/text"],["SC_M_013.ks/index/69/text"],["SC_M_013.ks/index/71/text"],["SC_M_013.ks/index/74/text"],["SC_M_013.ks/index/76/text"],["SC_M_013.ks/index/78/text"],["SC_M_013.ks/index/80/text"],["SC_M_013.ks/index/82/text"],["SC_M_013.ks/index/84/text"],["SC_M_013.ks/index/86/text"],["SC_M_013.ks/index/88/text"],["SC_M_013.ks/index/90/text"],["SC_M_013.ks/index/92/text"],["SC_M_013.ks/index/94/text"],["SC_M_013.ks/index/96/text"],["SC_M_013.ks/index/98/text"],["SC_M_013