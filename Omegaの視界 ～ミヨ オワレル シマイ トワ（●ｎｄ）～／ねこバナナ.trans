29,"end":341}],[{"start":347,"end":359}],[{"start":373,"end":436}],[{"start":444,"end":459}],[{"start":467,"end":481}],[{"start":489,"end":527}],[{"start":535,"end":539},{"start":545,"end":549},{"start":555,"end":559}],[{"start":565,"end":569}],[{"start":575,"end":579}],[{"start":585,"end":598}],[{"start":607,"end":670}],[{"start":676,"end":680}],[{"start":689,"end":736}],[{"start":742,"end":747}],[{"start":753,"end":758}],[{"start":764,"end":778}],[{"start":788,"end":797}],[{"start":803,"end":817}],[{"start":823,"end":830},{"start":950,"end":957},{"start":1002,"end":1009},{"start":1027,"end":1034}],[{"start":836,"end":850}],[{"start":856,"end":870}],[{"start":876,"end":897}],[{"start":907,"end":920}],[{"start":930,"end":940}],[{"start":963,"end":977}],[{"start":983,"end":992}],[{"start":1015,"end":1021}],[{"start":1040,"end":1045}],[{"start":1051,"end":1065}],[{"start":1075,"end":1095}],[{"start":1101,"end":1119}],[{"start":1129,"end":1146}],[{"start":1156,"end":1170}],[{"start":1180,"end":1202}],[{"start":1212,"end":1232}],[{"start":1242,"end":1326}],[{"start":1332,"end":1335}],[{"start":1341,"end":1345}],[{"start":1361,"end":1362}],[{"start":1372,"end":1383}],[{"start":1389,"end":1466}],[{"start":1472,"end":1476}],[{"start":1482,"end":1496}],[{"start":1505,"end":1506}],[{"start":1516,"end":1545}],[{"start":1558,"end":1578}],[{"start":1587,"end":1602}],[{"start":1611,"end":1619}],[{"start":1625,"end":1723}],[{"start":1736,"end":1818}],[{"start":1824,"end":1857}],[{"start":1870,"end":1914}],[{"start":1920,"end":1990}],[{"start":2000,"end":2015}],[{"start":2025,"end":2044}],[{"start":2057,"end":2075}],[{"start":2084,"end":2110}],[{"start":2119,"end":2164}],[{"start":2170,"end":2233}],[{"start":2246,"end":2283}],[{"start":2292,"end":2374}],[{"start":2380,"end":2404}],[{"start":2414,"end":2482}],[{"start":2492,"end":2515}],[{"start":2524,"end":2547}],[{"start":2553,"end":2689}],[{"start":2702,"end":2738}],[{"start":2744,"end":2821}],[{"start":2831,"end":2850}],[{"start":2856,"end":2866}],[{"start":2878,"end":2890}],[{"start":2905,"end":3101}],[{"start":3107,"end":3163}],[{"start":3172,"end":3219}],[{"start":3225,"end":3252}],[{"start":3262,"end":3282}],[{"start":3292,"end":3324}],[{"start":3334,"end":3353}],[{"start":3363,"end":3371}],[{"start":3381,"end":3382}],[{"start":3392,"end":3396}],[{"start":3406,"end":3429}],[{"start":3442,"end":3502}],[{"start":3516,"end":3530}],[{"start":3540,"end":3642}],[{"start":3652,"end":3658}],[{"start":3672,"end":3696}],[{"start":3710,"end":3779}],[{"start":3789,"end":3826}],[{"start":3832,"end":3844}],[{"start":3850,"end":3852}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_029.ks","basename":"SC_S_029.ks","indexIds":{"み、\nに、なってンだか、":0,"……っえぐぁ。":1,"駄目だ、安定しねぇ。[l]\nざわざわする、気分が悪ぃ。[l]\n頭が":2,"逆":3,"上せたようなこの感じはなんだ。":4,"悪いもンでも喰った後の、\nガスが溜まったようなあの感じが、":5,"考えることを邪魔しやがって、\nそれが苛苛の原因になって、\n":6,"おえ゛っ。":7,"……そんだけじゃねえし。":8,"手か、腕か知らねェが、\n":9,"痒ぃつーか、\n手の届かない肉の中にその場所があるあの感じ、\n掻いても掻いても掻いてもカイてもカイてもかいても、":10,"むずむずしたままおさまんねぇ、":11,"苛苛が、そのままむかつきに、":12,"暴発する、暴発する、\nあああああもうっっだらっっんなんだてめえ！！！":13,"………。":14,"鎮まれ。":15,"抑えろ。":16,"クダラナイ事で心動かすな。":17,"「短気は損気……というか、[l]\n　　　　真に相手をミクダしたいのなら、\n　　　　居丈高に構えるよりは、──」":18,"軽蔑だ。":19,"「認める必要など毛程も無いよ。[l]\n　　　　ただ瑣事に煩わされる必要も無いから──」":20,"無視しろ。":21,"受け流せ。":22,"ああああああああああああ、\n":23,"知ったことか！！！":24,"うぜぇものはうぜぇべや！！！":25,"………………。":26,"沸点通ると一瞬気が遠くなる。":27,"軽いリセット喰らった感じで。":28,"そこから醒める方向に転換する事もあれば、\n":29,"そのまま頭ん中真っ赤に、\n":30,"眼の前がまっかに、\n":31,"今回は醒める方で落ち着いた。":32,"大きく息を吸う、\n":33,"そしてはく。":34,"げふぅっ。":35,"でけえ●●●が口から出て、\n":36,"ようやく身体の方も、落ち着いた、らしい。":37,"あの時のアレもミになって、るのか、\n":38,"ああ、毎度毎度毎度毎度思うのは、\n":39,"喰う、のは、しあわせだが、\n":40,"ミになるという結果も良いことなんだろうが、\n":41,"その過程が、喰った後のこのプロセスが、\n":42,"どうにもつらい時間だ、わ。[l]\nもう少しスムーズに動いて欲しい。[l]\nそういえば薬、まだだった。[l]\nそうか、その所為もあった……のかも。":43,"水……":44,"で薬……":45,"億":46,"劫だけど、起き上がる。":47,"身体を起こして背筋を伸ばすと、\n何かが通った感じで、\n錯覚だろうけどお腹の具合も頭の方もすっきりと、\n……やっぱ姿勢も原因かなあ？":48,"ふぁっ。":49,"急に立ち上がったからか、め、":50,"目":51,"眩が……[l]\n血が下に、\nきがとおく、\n":52,"「キミは、あれらがミドリノハヤシと──」":53,"「Ｙがね、肝要だったのだ──」":54,"「通例なら──」":55,"……もう少しで、[l]\nこんな状況も、\nほんとうにおわるのかな。[l]\n最近は特に前の出来事が、\nえーと、ソーマトー？みたいに？[l]\nやけに思い出して、\n":56,"「何しろＹの振舞は、あれの愚行のそもそもの原因……[l]\n　　　　たとえ一方的なものでもね。[l]\n　　　　まさにキミはその犠牲者になりかけて──」":57,"ああ、\n難しい事は昔から、\nよく分からないけど、\n":58,"「特に僕等……八相の眷属の場合は、[l]\n　　　　各相が分かたれているから──」":59,"一揃えのうちどれかが取り分け群を抜くということは、\n逆に言えば、比べて他が駄目というか、\nそれぞれが独立してればまだしも、\n":60,"勉強はしたからそのくらいは、\n":61,"だからつまりは何かが常に欠けていて、\n":62,"「キミがみにもつのはその中でも──」":63,"「つまり根源的で、避けられない、いかなるものも──」":64,"「僕がある程度は軽減に貢献できるだろう、しかし、\n　　　　根本的な解決には、──」":65,"一箇所が突出してるから不自然さが、\n違和感が浮き彫りになるとかどうとか、\nまあ、腫れ物だってそうだろうけど、\n":66,"「と言う訳でだ、\n　　　　特に全体を統合するのに大事なのは、──」":67,"「キミのそれが●相、\n　　　　つまり●●に特化しているのと同様に、\n　　　　彼女のあれは●●●●に特化している。[l]\n　　　　故に、──」":68,"それが、今年もやってきて、しかも他に気を取られて":69,"漫ろだと、\n……でもどういう理由とかはもう、[l]\n正直どうでもよくて。[l]\nそれをどうにかすればいいなら、\n":70,"げほっ、\n……まだちょっと、つらいな。":71,"「ＸＸＸ？[l]\n　　　　ああ、──」":72,"●●……には、[l]\n多分、\n憧れというか、崇拝みたいな、\nいや、渇望、やっかみ、羨望、嫉妬、\n要するに、羨ましさが、\nああ自分が●●だったらいいのに。[l]\n●●は完全だ。[l]\nずるい。[l]\nだから、\n":73,"「初めはすべて●●という話がある、\n　　　　発生の途中で、──」":74,"ずっとそうだった。[l]\n●●になりたかった……んだろうと思う。[l]\nひとに言われてこんな……してるけど、[l]\nほんとうは、\n":75,"自分だって、\n●●がよかった。":76,"●●がよかったのに。":77,"●●なら、……ちゃんと。":78,"「確かに●●でない存在など、\n　　　　単に配偶子としてのヴァリエーションの為の\n　　　　ものでしかない、\n　　　　と極論することも出来なくはなかろうな。[l]\n　　　　実際は複雑な要素があるだろうし、\n　　　　それがもし是非の非ならば\n　　　　とうに淘汰されている構造だろうから、\n　　　　……まあ何にせよ、基本としてのユニットは──」":79,"また眠くなってきた……[l]\n寝るのは好き……[l]\n寝てしまえばその間は、\nなにも……":80,"「……巧くは、否、多くは言えないが、[l]\n　　　　キミはきっと大丈夫、なにしろ──」":81,"もう、\n独りでイキたいと思ったりもするけど、\n":82,"あの時に知ってしまったことがあるから、\n":83,"少ないけれど、だからこそ確実に、\n強く、鮮明で鮮烈な、\n":84,"『良き記憶』、『真っ当な想い出』が、\n":85,"だから、未練が、":86,"渇":87,"望が、\n":88,"そんな仕合わせがあると知ってしまった、から、\n":89,"「下手に欠片を口にしてしまえば、\n　　　　空腹感はより一層、\n　　　　何も口にせぬよりも増してしまう、\n":90,"その先をソウゾウしてしまう。":91,"あるモノゴトの一端を知る、というのは、\n　　　　知らぬ時には無かった筈の、\n　　　　埋めるべき、\n　　　　或いは埋まらぬ空白をも\n　　　　自覚してしまう──事でもあるのだ。":92,"しかしね、\n":93,"ああ好奇心猫を殺すとはどういう意味だったか──\n":94,"まあいずれにしても、だ。[l]\n　　　　知らなければ良かったと思っても、\n　　　　それは最早、\n　　　　肉の方が。":95,"欠けている、と懊悩することになるのだ、\n　　　　そう、●●に──」":96,"……餓えてしまうの、だ、":97,"わ。":98},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_029.ks","relPath":"/data/scenario/SC_S_029.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":96,"length":99,"percent":96.96969696969697},"cacheResetOnChange":{},"cellInfo":[]},"/data/scenario/SC_S_030.ks":{"data":[["「……お゛えぇ」","「……呕呃呃」"],["「？[l]\nだいじょぶですか？」","「？[l]\n没事吧？」"],["「さんくー、おけー。[l]\nきにせず」","「桑克-、OK。[l]\n别在意」"],["「はぁ……」","「哈啊……」"],["「それより準備しっかり頼むぜよ。[l]\n急な話だから見落とし忘れ物とかありそうでさ」","「比起这个准备工作给我认真点啊。[l]\n突然通知肯定会有疏漏和忘带东西的情况吧」"],["「う、私もあんまり信頼しないでください……[l]\n全力は尽くしますケド……」","「呜、请别太信任我……[l]\n虽然我会全力以赴就是了……」"],["「気張りすぎない程度で、\nでもなるだけ抜かりなくよろしく」","「别太勉强自己，\n但尽量别出纰漏拜托了」"],["全","全"],["自","自"],["動","动"],["鏖","鏖"],["殺、\n鉄槌下した気配がしたな。[l]\nやっぱきっちり大人しくはしてないじゃんか。","杀、\n感觉到铁锤落下的气息了呢。[l]\n果然没老老实实待着嘛。"],["暖機運転というか、\n多分、いや、\n制御した故にあの規模ですんだのか、\n制御出来てない故の漏れなのか、\nどっちにしても不要な動きなんだろうに、\n全自動のまままともにヒトの世に放ったら、\n……。[l]\n不謹慎ながら判断に迷ってしまうのが、\n今のヒトの世の切なさであることよ。","说是预热也好，\n大概，不，\n是因为受到控制才只造成那种规模的破坏，\n还是失控导致的能量泄漏呢，\n无论哪种都是多余的动作啊，\n要是全自动状态下直接放到人类社会，\n……。[l]\n虽然不谨慎但令人犹豫的判断，\n正是当今人类社会的悲哀之处。"],["向こうさんにしてみても、\nまともな計画に組み込むには弊害がありすぎる駒の筈だが。[l]\nそれでも今回、しかも大がかりな劇の筈のこの茶番の舞台裏に、\n敢えてあれを起用してきたのは──\n使い道としては、\n……恐らくは更なる、しかも予期せぬ揺らぎの発生の期待、[l]\nそれか、文字通り雑魚の掃討、\n或いは牽制か。[l]\nしかし牽制、抑止力という意味じゃ、\nその威力を知るモノにしか効果ないだろに。[l]\nもしLu=Leの残党連中に対してであれば逆効果でもある。[l]\n寧ろ誘き出したい筈な訳だしな。[l]\n真面目な世直しのつもりだとすれば、\n殊勝な心懸けつうか御苦労なことだけども、\nわざわざこの時この場ですることじゃない。[l]\nとなればやっぱし、\nあの兄貴の単なる『揃いの美学』か？","对那位来说，\n本该是弊大于远无法纳入正经计划的棋子。[l]\n即便如此这次——而且本该是大型戏剧的这场闹剧幕后，\n特意启用那家伙的原因是——\n用途方面，\n……恐怕是期待引发更多预料之外的波动，[l]\n要么就是字面意义的杂鱼清扫，\n或者是牵制吧。[l]\n但作为牵制或威慑手段，\n只对知晓其威力的人有效吧。[l]\n如果针对Lu=Le残党反而会起反效果。[l]\n按理说应该更想引蛇出洞才对。[l]\n若说是真心想整顿世道，\n虽然值得敬佩或者说辛苦了，\n没必要特意选在这个时间地点。[l]\n这么说果然还是，\n那位大哥单纯的『成套美学』作祟？"],["──かれおんを除く知人だの身の回りの人等に、\n色々根回しやら何やらして準備していたらば、\n結局出発までに時間喰ってしまった。[l]\nまだ派手に動かない方がよさげだから新幹線移動を選択。[l]\n切符自体は普通に取れたが、\n出立は２６日にずれこんでしもた。[l]\nかれおんの方の調整もあったとは言え、\nイーくんにはちと気の毒な展開だ。[l]\n多分……、フォローしてくれる女子っこが、[l]\nいる……っぽいな。[l]\nすまぬがある程度はそっちに任せます。[l]\n俺では出来ない慰めが出来るだろうし……","——除了卡蕾欧之外的熟人啦身边人啦，\n各种打点准备导致，\n结果出发时间被拖延了。[l]\n考虑到不引人注目更好就选了新干线。[l]\n车票倒是正常买到了，\n出发日却拖到了26号。[l]\n虽说也有卡蕾欧那边的调整因素，\n对阿伊来说挺过意不去的。[l]\n大概……会有女孩子，[l]\n帮他打圆场……的样子。[l]\n抱歉这部分就交给你了。[l]\n有些安慰只有你能做到……"],["にしても、他に懸念があるとすれば、\n実働状態にある","话虽如此，其他值得担忧的是，\n正处于运作状态的"],["件の、","那个，"]],"context":[["SC_S_030.ks/index/1/text"],["SC_S_030.ks/index/3/text"],["SC_S_030.ks/index/5/text"],["SC_S_030.ks/index/7/text"],["SC_S_030.ks/index/9/text"],["SC_S_030.ks/index/11/text"],["SC_S_030.ks/index/13/text"],["SC_S_030.ks/index/15/text"],["SC_S_030.ks/index/17/text"],["SC_S_030.ks/index/19/text"],["SC_S_030.ks/index/21/text"],["SC_S_030.ks/index/23/text"],["SC_S_030.ks/index/25/text"],["SC_S_030.ks/index/27/text"],["SC_S_030.ks/index/29/text"],["SC_S_030.ks/index/31/text"],["SC_S_030.ks/index/33/text"]],"tags":[],"parameters":[[{"start":185,"end":193}],[{"start":223,"end":243}],[{"start":273,"end":296}],[{"start":326,"end":332}],[{"start":362,"end":408}],[{"start":438,"end":480}],[{"start":510,"end":543}],[{"start":589,"end":590}],[{"start":600,"end":601}],[{"start":610,"end":611}],[{"start":621,"end":622}],[{"start":631,"end":679}],[{"start":685,"end":852}],[{"start":858,"end":1262}],[{"start":1268,"end":1559}],[{"start":1565,"end":1594}],[{"start":1605,"end":1608}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_030.ks","basename":"SC_S_030.ks","indexIds":{"「……お゛えぇ」":0,"「？[l]\nだいじょぶですか？」":1,"「さんくー、おけー。[l]\nきにせず」":2,"「はぁ……」":3,"「それより準備しっかり頼むぜよ。[l]\n急な話だから見落とし忘れ物とかありそうでさ」":4,"「う、私もあんまり信頼しないでください……[l]\n全力は尽くしますケド……」":5,"「気張りすぎない程度で、\nでもなるだけ抜かりなくよろしく」":6,"全":7,"自":8,"動":9,"鏖":10,"殺、\n鉄槌下した気配がしたな。[l]\nやっぱきっちり大人しくはしてないじゃんか。":11,"暖機運転というか、\n多分、いや、\n制御した故にあの規模ですんだのか、\n制御出来てない故の漏れなのか、\nどっちにしても不要な動きなんだろうに、\n全自動のまままともにヒトの世に放ったら、\n……。[l]\n不謹慎ながら判断に迷ってしまうのが、\n今のヒトの世の切なさであることよ。":12,"向こうさんにしてみても、\nまともな計画に組み込むには弊害がありすぎる駒の筈だが。[l]\nそれでも今回、しかも大がかりな劇の筈のこの茶番の舞台裏に、\n敢えてあれを起用してきたのは──\n使い道としては、\n……恐らくは更なる、しかも予期せぬ揺らぎの発生の期待、[l]\nそれか、文字通り雑魚の掃討、\n或いは牽制か。[l]\nしかし牽制、抑止力という意味じゃ、\nその威力を知るモノにしか効果ないだろに。[l]\nもしLu=Leの残党連中に対してであれば逆効果でもある。[l]\n寧ろ誘き出したい筈な訳だしな。[l]\n真面目な世直しのつもりだとすれば、\n殊勝な心懸けつうか御苦労なことだけども、\nわざわざこの時この場ですることじゃない。[l]\nとなればやっぱし、\nあの兄貴の単なる『揃いの美学』か？":13,"──かれおんを除く知人だの身の回りの人等に、\n色々根回しやら何やらして準備していたらば、\n結局出発までに時間喰ってしまった。[l]\nまだ派手に動かない方がよさげだから新幹線移動を選択。[l]\n切符自体は普通に取れたが、\n出立は２６日にずれこんでしもた。[l]\nかれおんの方の調整もあったとは言え、\nイーくんにはちと気の毒な展開だ。[l]\n多分……、フォローしてくれる女子っこが、[l]\nいる……っぽいな。[l]\nすまぬがある程度はそっちに任せます。[l]\n俺では出来ない慰めが出来るだろうし……":14,"にしても、他に懸念があるとすれば、\n実働状態にある":15,"件の、":16},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_030.ks","relPath":"/data/scenario/SC_S_030.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":17,"length":17,"percent":100},"cacheResetOnChange":{},"cellInfo":[null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"lastSelectedCell":[5,3]},"/data/scenario/SC_S_031.ks":{"data":[["スロタラスモルト。","斯洛塔拉斯莫尔特。"],["NKナンバーの三番目、\nあの兄貴が記述にも絡んだ豪華装丁、\nアイドリング状態にした時点で自動起動の自動操縦、\n制御するには停止状態か手動操作への変更が必要。[l]\nとは言えデフォルトの基本設定は自動なうえ、\n……マニュアル操作の場合でも、[l]\n否、特にその場合はユーザーの人品骨柄によっては非常に危険だ。[l]\n自動時はユーザーの──主として視覚と聴覚情報から判断された、\n『現行犯』に対し最大同時発射数７５発の『","NK编号的第三位，\n那位大哥也参与设计的豪华装帧，\n进入怠速状态时自动启动的自动驾驶，\n要控制必须处于停止状态或切换至手动操作。[l]\n虽说默认基础设定本就是自动模式，\n……即便是手动操作时，[l]\n不，尤其那种情况下根据使用者的人品可能会非常危险。[l]\n自动模式下会根据使用者的——主要是视觉与听觉信息判断，\n对『现行犯』发射最多75发同时的『"],["錨』が放出、\n対象が意識下無意識下において最も嫌悪する状況での『制裁』が、\n──つまり●とは限らない訳で、\n当然場合によっては相当にグロい事になり、\n●の方がマシと思おうものなら尚更そっちへの救済は断たれて──\n結果として勧善懲悪になったケースでも、\nそれに対し喝采出来る範疇を越えている。[l]\n執行猶予は６日間、\n期間中に再犯或いは累犯した場合は即時執行されて、\nPHASE:5の強化能を遺憾なく発揮、\n対象、しばしば複数の対象同士での自滅を促進すると。[l]\n微罪の場合は等価制裁ですむけれど、\nそもそもそんな微罪では反応しないから大概は過剰段階まで進む。[l]\nタマは発射直後に即座に再装填される為、\n","锚』，\n在对象潜意识最厌恶的情境下实施『制裁』，\n——也就是说未必是●，\n当然某些情况下会变得相当血腥，\n要是觉得●还算好的话反而会断绝那条救济途径——\n即便最终达成惩恶扬善的结果，\n也早已超出值得喝彩的范畴。[l]\n缓刑期6天，\n期间再犯或累犯立即执行，\n充分发挥PHASE:5的强化性能，\n促使目标——经常是多个目标互相自灭。[l]\n轻罪可处以等价制裁，\n但轻微罪行根本不会触发反应，多数会升级到过激阶段。[l]\n弹体发射后即刻自动装填，\n"],["──ん。","——嗯。"],["自動に範囲内を無差別、から改訂されたか？[l]\nユーザー次第では大した変更にはならないが、\n多少はマシか……[l]\n否、単にコンフィグ","从自动无差别范围内攻击修订过来了？[l]\n对某些使用者来说算不上重大改动，\n多少温和些了吧……[l]\n不，单纯只是调整了"],["弄っただけぽいな。[l]\nまあいいか、\nその行為自体に多少はその意思アリと思うべきだろ。","配置文件而已。[l]\n算了无所谓，\n这种行为本身多少能证明其主观意愿吧。"],["いずれ今の所こっちの現場に投入はされず……[l]\n……真逆あの兄貴、[l]\n俺に対しての牽制じゃねーだろうな。[l]\n深読みすれば俺と、延いてはかれおんの現地入りの為の誘導？[l]\nだとすると──\n","反正现阶段不会投入我们这边现场……[l]\n……完全相反那位大哥，[l]\n该不会是在牵制我吧。[l]\n往深想可能是为了引导我和卡蕾欧介入当地？[l]\n这样的话——\n"],["何かやらせたいのかね？","是想让我们做点什么吗？"],["「言われんでも友人を慰めに今こうやって動いてはいる……[l]\nよっと」","「不用你说我也正为安慰朋友行动着……[l]\n好了」"],["俺の事自体は連中に報告が回ってるだろうが、\n俺に自覚ありと知ってるのは今のところかれおんだけだ。[l]\nそんな状況でわざわざこちらに布石を打つ面倒を仕掛けるか？","我的事他们应该都收到报告了，\n但知道我有自觉的目前只有卡蕾欧。[l]\n这种状况下会特意费心给我们下先手棋？"],["まあ考えるだけ無駄だわな。[l]\nあの兄貴に関しては特にそうだが──\nかれおんに聞いても詮無い事案でもある。[l]\n傾向と対策程度はあるにせよフレキシブルに対応するべし。","算了想也是白费功夫。[l]\n特别是关于那位大哥的事——\n问卡蕾欧也是白搭。[l]\n虽有些倾向性对策但该灵活应对。"],["「まずはその兄妹アイの憐れな被害者、\n巻き込まれ主人公のイーくんか」","「首先是那对兄妹中的爱妹妹可怜受害者，\n被卷入的男主角小伊吧」"],["凹んでる……というよりか、[l]\nまだ混乱……してんのかなぁ。","消沉……倒不如说，[l]\n还处在混乱……状态吧。"],["その割に自分が何者かに関しては、\n……それ程じゃないのか。[l]\n向こうのあれらの御陰か、異能自体にも抵抗はさほどないようだ。[l]\n俺やらあの店長の仕込みとは別方向での許容……？[l]\nちと気になるな。[l]\nそれとも気のせいか。[l]\nまあ何にせよ、\n俺の事までバラされたのは寧ろ幸運と視るべきか。[l]\n今の状態で俺と会って、どう反応するかにもよるけども、\n正直なところ、\nヒトにホントウのことを話すのはいつだって気が重いもんだ。[l]\n出来れば避けたい。[l]\nまことがいつわりよりもいいとはかぎらないし、\n……ああ、向こうのあれら自体にも何か不穏な……[l]\nあの兄貴達は勿論、\nなるべく要素の個個には干渉したくないが、\nこの場合はどうしたものか。[l]\nこと●●沙汰……の場合はまさに犬も食わぬと言われちゃってるからね？","可相比之下关于自己是谁这件事，\n……倒没那么在意嘛。[l]\n多亏对面那些家伙的缘故，对异能本身似乎也没太大抵触。[l]\n和我和那个店长的培养是不同方向的适应性……？[l]\n有点在意啊。[l]\n还是说我多心了。[l]\n嘛总之，\n我的事被抖出来反倒该说是幸运吧。[l]\n虽然还得看现在这状态下见到我会有啥反应，\n说实话，\n对人讲真话总是件沉重的事啊。[l]\n能避免的话真想避免。[l]\n真言也不见得就比谎言好，\n……啊啊，对面那些家伙本身也透着股不安分的……[l]\n那些大哥们当然不用说，\n虽然原则上不想干涉各个要素，\n但这种情况该怎么办呢。[l]\n涉及到●●的事……可是连狗都懒得理的那种哦？"],["いずれやはり、\nあの萌え店長か。そうなのか。[l]\n俺自身が前にそういう前振りしたかも知らんが、\nいーくん、\n本気で行く気もあったんか。","到头来还是得找，\n那个萌系店长吧。果然如此么。[l]\n可能我自己之前也做过类似铺垫，\n饭君，\n你是真打算去啊。"],["「こればかりは──」","「唯独这件事──」"],["………。[l]\n何しろ古より","………。[l]\n毕竟自古以来"],["凡","平"],["百土地時代で物語の素材として\n延々使われてきても尚、幾度も幾度も、\n飽きたらず主題題材となる──","凡在百土地时代作为故事素材\n被反复使用至今仍无数次地，\n成为永不厌倦的主题──"],["「アイで全てが狂う……ってかなぁ」","「爱会让一切失控……是吧」"],["その本来が●●に根ざす物だとしても、\n否、だからこその、Ｙを武力として扱う奴等だったな。","即便其本质植根于●●，\n不、正因如此，那些把Y当作武力使用的家伙们才更甚。"],["今回に限って言えば奴等自身が施したＹの","仅就这次而言，他们对Y实施的"],["歪な処置、\nその歪みが一体どう影響するのか。","扭曲处置，\n这扭曲究竟会造成什么影响。"],["「ぬ、だけんども、更にちっとばかしズれてるな」","「唔、不过偏差好像更大了些」"],["裏切り裏切られ、というよりも、\nまあ地雷を踏まれたというか……[l]\n明文化し辛いところを責められた所為で余計に苛立ちが増してるんだな。[l]\n好意というのは一方的であるが故に、\n一歩間違うと逆恨みになるという。[l]\n何しろその相手のリアクションには、\n好意という性質上当然色よいものを望むが、\n期待通りでない返しの場合でも、\nそれをなじる訳にはいかないし。","与其说是背叛与被背叛，\n不如说是踩到地雷了吧……[l]\n因为那些难以明言的隐痛被指责，火气反而更大了。[l]\n好意正因为是单方面的，\n稍有不慎就会变成怨恨。[l]\n毕竟对于对方的反应，\n出于好意当然会期待积极回应，\n但就算回应不如预期，\n也没法责怪人家。"],["当然と言えば当然のコミュニケーションでありながら、\nヒトの♂と♀の場合は若干事情が複雑になるのが常で……[l]\nＹ抑圧の所為で免疫も無かった所に、\n此処に来て一気に大量の♀と接触したのも、\nイーくんにとっては負荷がでかかったろうし、\n──まあ、身も蓋もなく言っちゃえば、\n自覚のない『●●い』というのは、\n往々にして苛立ちを生ずるものであって、\nそれこそ有り体に言えば理性と感情の狭間での、\nあんびばれんとな苦悩が──\n","虽是理所当然的交流模式，\n但涉及人类♂与♀时情况总会复杂些……[l]\nY压抑导致毫无免疫力的情况下，\n突然接触大量♀，\n对饭君来说负担太大了吧，\n──嘛，说穿就是，\n无自觉的『●●化』，\n往往只会催生焦躁，\n说白了就是理性与感情夹缝间的，\n这种暧昧不清的苦恼──\n"],["「どっちつかずでやり過ごせないなら、\n彼岸か此岸か、己で決めねーとなあ。[l]\n他人……つーか相手は何もしてくれん、[l]\nそんな義理なぞ","「如果无法模棱两可地混过去，\n总得自己决定是彼岸还是此岸啊。[l]\n别人……或者说对方什么都不会做，[l]\n这种情分"],["欠","连"],["片も無い場合が殆どだから尚更……[l]\n","碎片都不剩的情况更甚……[l]\n"],["況してや向こうさんはあの──」","更何况那位可是──」"],["……某テンチョウ様と来た日には。","……偏偏还是那位店主大人。"],["更に前段階でのその店長の存在が、\n刷り込みにもなってしまってたのが誤算だろう。[l]\n従属の為の仕込みのつもりもあったんだろが、\n……いあ、単なるアソビ、面白いからだろかな……[l]\nどっちにしても、\n","更何况前阶段那位店长的存在，\n甚至成了心理暗示的源头，这才是失算之处吧。[l]\n本意或许是为驯化作铺垫，\n……呀啊，单纯觉得好玩、有趣罢了……[l]\n无论哪种情况，\n"],["酷な事したもんだ。[l]\nせめてはっきり引導渡してやるとか、\nその前段階での釘刺しだの、\n……それこそそんな義理ぁ向こうさんには、ないなあ。[l]\nあの店長に限ったことじゃないが……[l]\n大概の場合♂が割りを喰う──様に視えるのは、\n俺も♂だからなのかねぇ。[l]\nこればっかりはなあ。[l]\nわざわざ、\nデータ検証する手間を掛ける価値のある話題でもなし……[l]\n変な含みやら気を持たしたりも、\nあれにとっちゃ遊び、遊戯愉悦の類なんだろし。[l]\n遊びは基本、自己","都做得太过分了。[l]\n至少该明确给个了断，\n或是事先打好预防针，\n……这种人情义理对那位来说本就不存在吧。[l]\n虽不仅限于那个店长……[l]\n多数情况下♂总是吃亏──看起来如此，\n莫非因为俺也是♂吗。[l]\n唯独这点真没辙啊。[l]\n特地\n花功夫验证数据也没意义……[l]\n那些暧昧暗示与撩拨，\n对那家伙而言不过是游戏取乐罢了。[l]\n游戏本质上若不自我"],["完結するもんでないと困るのになあ。[l]\nそうでない場合なら双方同意でなけりゃ、\n単に","闭环可就麻烦了啊。[l]\n若非如此又未经双方同意，\n无非"],["傍","是"],["迷","令"],["惑な戯れ事なんだが。[l]\n複数人で行う以上は厳格なルールが必要で、\nそうなったらもうアソビというよりは、\n……詭弁かそんな話は。[l]\nどうあれ、あれには悪意が……そう、[l]\nあれのあれは明確な悪意と定義し難い故に、\n糾弾しようにもおかしな具合だし、\n兎に角せ……まあ、面倒だ。只管に面倒だ。","人困扰的恶作剧罢了。[l]\n多人参与时更需要严格规则，\n到那份上已算不得游戏，\n……诡辩之类的说辞。[l]\n总之那家伙的恶意……该说，[l]\n因其恶意难以明确定义，\n连谴责都显得滑稽，\n总之……唉，麻烦。纯粹就是麻烦。"],["いずれそんな調子じゃから、\n一段落ついた頃にゃー、\nその苦悩はそのまんま憎しみに転化しかねない。","照这趋势发展下去，\n等告一段落时——\n那份痛苦会直接转化成恨意吧。"],["だが幾ら何でも相手が悪い、玉砕、返り討ち、\n恨み言を並べてぶつけるが関の山。","但无论如何对方更恶劣，自取灭亡、反遭报复，\n最多也就咒骂几句出气。"],["それでもいいならまあ、あれだが……","若觉得无所谓倒随他去……"],["……ああ、","……啊，"],["そうだそうだ忘れてたな。","对对差点忘了。"],["そういったもろもろは、\n内容はどうあれ、\nあくまで互いにバカ正直で表裏が無い場合の話だ。","上述种种情况，\n无论具体内容，\n都建立在双方毫无城府的前提下。"],["自分が悪者になりたくないが故に、\n自分からは能動的に引導を渡さずに、\n相手が決裂の引き鉄を引いたと責めるに値する行動を取るまで、\nひたすらに待ち、或いは罠を仕掛け、\nつまりは『お前の所為』と言いたいが為に、\n場合によっては、\n理詰めで考えれば理不尽な決裂の理由を無理矢理に探しだし定義するやつも、\n結構な割合で居るということ、\n","有人为逃避恶名，\n既不主动斩断关系，\n反而等待甚至设套诱使对方做出可指责的决裂行为，\n一味等待或设下陷阱，\n无非是想归咎于『都是你的错』，\n甚至有人\n会强行找出并定义在逻辑上根本站不住脚的决裂理由，\n这类人不在少数，\n"],["……まあ、要するにある種の社交辞令と言えなくも無いのだけれど、[l]\nヒトは言葉でのコミュニケーションに特化しすぎた。[l]\n真に受けるものもやはり、\n結構な割合で居るだろうな。","……嘛，某种程度上也算社交辞令吧，[l]\n人类过度依赖语言沟通了。[l]\n把客套话当真的人，\n想必也相当多吧。"],["論点がずれとるけど。","虽然跑题了。"],["要するに相手のコトバってのは、\n額面通り受け取って良いものかは常に疑う余地があるが、\nヒトがコトバで遣り取りする以上は……","总之对方的话语，\n永远值得怀疑是否该照单全收，\n但既然人类靠语言交流……"],["おやあ、\nそんな間に、\nどんどん黒く、荒れていって……るか？[l]\nＹを抑圧されてた分反動がでかいか？[l]\nそれとは無関係？[l]\n","哎呀，\n转眼间\n就变得漆黑狂暴……了？[l]\n是压抑Y染色体后的剧烈反噬？[l]\n抑或与此无关？[l]\n"],["Ｃは執着強いと同時に異常に飽きっぽいんだが、\nやっぱイーくんはちょっと違う方向かもなあ。[l]\n","C虽然执着心强但同时也异常容易厌倦，\n不过饭君可能有点不太一样吧。[l]\n"],["Ｄとも勿論違う……ってか、[l]\nＨはＩに先立つという厭な符合もあることだし、\n大変だなあ面倒だなあ、\n……あれだなあ。[l]\nああもうそんでまた、\n混乱し正常な判断をし難い状況では、\nフリーズするかキレるのが","当然和D也不同……应该说，[l]\nH比I先出现这种讨厌的巧合也存在，\n真是麻烦啊超烦人啊，\n……就是那个吧。[l]\n啊啊又来了，\n在混乱难以做出正常判断的情况下，\n要么死机要么暴走"],["常","是"],["套ではあるが、\nいーくんの起き方次第じゃ余波が相当に──\nカタルシスならぬカタストロフィが、\n只でさえ『deus ex machina』て言うのは、\n","常态来着，\n根据饭君的起床方式余波可能会相当——\n不是宣泄而是灾难，\n本来『机械降神』这种东西就够，\n"],["……あれ、大分ずれたな。[l]\nまー独り思考はもういいやこの辺でね。","……啊，完全跑题了。[l]\n嘛—独自思考就到此为止吧。"],["うちあたりがどう言おうと、\n結局はあれといーくんの問題……ではあるんだけどなあ。","不管我们怎么说，\n说到底还是那家伙和饭君的问题……虽然是这样啦。"],["「……我慢出来ん時だって、あるわな、ヒトとして」","「……作为人类总有忍无可忍的时候呢」"],["………。[l]\nとにかく我が","………。[l]\n总之希望我"],["朋イーくんにはシあわせになって貰いたい。[l]\n俺が何とかしてみせるとは言わないが、\nそれがＣから脱却しＤへと進んだ俺のイズムだからな。[l]\nお前に直で拒否られない限りは、\nヘルプするつもりだが──\n","的朋友饭君能获得幸福。[l]\n虽然不敢打包票说我能搞定，\n但这就是我从C脱离转向D的主义啊。[l]\n只要你不直接拒绝，\n我就打算帮忙——\n"],["ひとつ、いやさふたつほど気になるのは、\n何か強固なジャミングみたいなにおい、\nそれと未だよくわからんねこのけはいが──\n","不过有一两个在意的事，\n总觉得有某种强烈的干扰气息，\n还有至今搞不懂的猫的动静——\n"],["ん？","嗯？"],["あ……んだと？","啊……啥来着？"],["だとすると一体何を、シタイっての？","那到底是想干，啥啊？"],["あーもうだから俺、\nだから、\n","啊—所以我才，\n所以说，\n"],["お前等みたいなのがキライなんだ。","最讨厌你们这种家伙了。"]],"context":[["SC_S_031.ks/index/1/text"],["SC_S_031.ks/index/3/text"],["SC_S_031.ks/index/5/text"],["SC_S_031.ks/index/8/text"],["SC_S_031.ks/index/10/text"],["SC_S_031.ks/index/12/text"],["SC_S_031.ks/index/14/text"],["SC_S_031.ks/index/17/text"],["SC_S_031.ks/index/19/text"],["SC_S_031.ks/index/21/text"],["SC_S_031.ks/index/23/text"],["SC_S_031.ks/index/25/text"],["SC_S_031.ks/index/27/text"],["SC_S_031.ks/index/29/text"],["SC_S_031.ks/index/31/text"],["SC_S_031.ks/index/33/text"],["SC_S_031.ks/index/35/text"],["SC_S_031.ks/index/37/text"],["SC_S_031.ks/index/39/text"],["SC_S_031.ks/index/41/text"],["SC_S_031.ks/index/43/text"],["SC_S_031.ks/index/45/text"],["SC_S_031.ks/index/47/text"],["SC_S_031.ks/index/49/text"],["SC_S_031.ks/index/51/text"],["SC_S_031.ks/index/53/text"],["SC_S_031.ks/index/56/text"],["SC_S_031.ks/index/58/text"],["SC_S_031.ks/index/60/text"],["SC_S_031.ks/index/63/text"],["SC_S_031.ks/index/65/text"],["SC_S_031.ks/index/67/text"],["SC_S_031.ks/index/70/text"],["SC_S_031.ks/index/72/text"],["SC_S_031.ks/index/74/text"],["SC_S_031.ks/index/76/text"],["SC_S_031.ks/index/78/text"],["SC_S_031.ks/index/80/text"],["SC_S_031.ks/index/82/text"],["SC_S_031.ks/index/84/text"],["SC_S_031.ks/index/86/text"],["SC_S_031.ks/index/88/text"],["SC_S_031.ks/index/90/text"],["SC_S_031.ks/index/92/text"],["SC_S_031.ks/index/95/text"],["SC_S_031.ks/index/97/text"],["SC_S_031.ks/index/99/text"],["SC_S_031.ks/index/101/text"],["SC_S_031.ks/index/104/text"],["SC_S_031.ks/index/107/text"],["SC_S_031.ks/index/109/text"],["SC_S_031.ks/index/111/text"],["SC_S_031.ks/index/114/text"],["SC_S_031.ks/index/116/text"],["SC_S_031.ks/index/118/text"],["SC_S_031.ks/index/120/text"],["SC_S_031.ks/index/122/text"],["SC_S_031.ks/index/125/text"],["SC_S_031.ks/index/128/text"],["SC_S_031.ks/index/130/text"],["SC_S_031.ks/index/132/text"],["SC_S_031.ks/index/134/text"],["SC_S_031.ks/index/137/text"]],"tags":[],"parameters":[[{"start":168,"end":177}],[{"start":183,"end":423}],[{"start":434,"end":791}],[{"start":801,"end":805}],[{"start":811,"end":890}],[{"start":900,"end":952}],[{"start":958,"end":1073}],[{"start":1083,"end":1094}],[{"start":1170,"end":1209}],[{"start":1248,"end":1336}],[{"start":1342,"end":1439}],[{"start":1486,"end":1524}],[{"start":1554,"end":1589}],[{"start":1595,"end":2029}],[{"start":2035,"end":2119}],[{"start":2166,"end":2176}],[{"start":2206,"end":2224}],[{"start":2234,"end":2235}],[{"start":2245,"end":2301}],[{"start":2344,"end":2361}],[{"start":2389,"end":2437}],[{"start":2443,"end":2462}],[{"start":2473,"end":2499}],[{"start":2542,"end":2565}],[{"start":2595,"end":2807}],[{"start":2813,"end":3059}],[{"start":3108,"end":3189}],[{"start":3199,"end":3200}],[{"start":3210,"end":3230}],[{"start":3243,"end":3258}],[{"start":3288,"end":3304}],[{"start":3310,"end":3427}],[{"start":3437,"end":3719}],[{"start":3735,"end":3786}],[{"start":3796,"end":3797}],[{"start":3807,"end":3808}],[{"start":3818,"end":3994}],[{"start":4000,"end":4056}],[{"start":4062,"end":4104}],[{"start":4110,"end":4127}],[{"start":4133,"end":4138}],[{"start":4144,"end":4156}],[{"start":4162,"end":4214}],[{"start":4220,"end":4412}],[{"start":4422,"end":4523}],[{"start":4529,"end":4539}],[{"start":4545,"end":4614}],[{"start":4620,"end":4703}],[{"start":4716,"end":4768}],[{"start":4781,"end":4910}],[{"start":4921,"end":4922}],[{"start":4932,"end":5019}],[{"start":5029,"end":5067}],[{"start":5073,"end":5117}],[{"start":5160,"end":5184}],[{"start":5216,"end":5234}],[{"start":5244,"end":5361}],[{"start":5371,"end":5439}],[{"start":5449,"end":5451}],[{"start":5457,"end":5464}],[{"start":5470,"end":5487}],[{"start":5493,"end":5512}],[{"start":5522,"end":5538}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_031.ks","basename":"SC_S_031.ks","indexIds":{"スロタラスモルト。":0,"NKナンバーの三番目、\nあの兄貴が記述にも絡んだ豪華装丁、\nアイドリング状態にした時点で自動起動の自動操縦、\n制御するには停止状態か手動操作への変更が必要。[l]\nとは言えデフォルトの基本設定は自動なうえ、\n……マニュアル操作の場合でも、[l]\n否、特にその場合はユーザーの人品骨柄によっては非常に危険だ。[l]\n自動時はユーザーの──主として視覚と聴覚情報から判断された、\n『現行犯』に対し最大同時発射数７５発の『":1,"錨』が放出、\n対象が意識下無意識下において最も嫌悪する状況での『制裁』が、\n──つまり●とは限らない訳で、\n当然場合によっては相当にグロい事になり、\n●の方がマシと思おうものなら尚更そっちへの救済は断たれて──\n結果として勧善懲悪になったケースでも、\nそれに対し喝采出来る範疇を越えている。[l]\n執行猶予は６日間、\n期間中に再犯或いは累犯した場合は即時執行されて、\nPHASE:5の強化能を遺憾なく発揮、\n対象、しばしば複数の対象同士での自滅を促進すると。[l]\n微罪の場合は等価制裁ですむけれど、\nそもそもそんな微罪では反応しないから大概は過剰段階まで進む。[l]\nタマは発射直後に即座に再装填される為、\n":2,"──ん。":3,"自動に範囲内を無差別、から改訂されたか？[l]\nユーザー次第では大した変更にはならないが、\n多少はマシか……[l]\n否、単にコンフィグ":4,"弄っただけぽいな。[l]\nまあいいか、\nその行為自体に多少はその意思アリと思うべきだろ。":5,"いずれ今の所こっちの現場に投入はされず……[l]\n……真逆あの兄貴、[l]\n俺に対しての牽制じゃねーだろうな。[l]\n深読みすれば俺と、延いてはかれおんの現地入りの為の誘導？[l]\nだとすると──\n":6,"何かやらせたいのかね？":7,"「言われんでも友人を慰めに今こうやって動いてはいる……[l]\nよっと」":8,"俺の事自体は連中に報告が回ってるだろうが、\n俺に自覚ありと知ってるのは今のところかれおんだけだ。[l]\nそんな状況でわざわざこちらに布石を打つ面倒を仕掛けるか？":9,"まあ考えるだけ無駄だわな。[l]\nあの兄貴に関しては特にそうだが──\nかれおんに聞いても詮無い事案でもある。[l]\n傾向と対策程度はあるにせよフレキシブルに対応するべし。":10,"「まずはその兄妹アイの憐れな被害者、\n巻き込まれ主人公のイーくんか」":11,"凹んでる……というよりか、[l]\nまだ混乱……してんのかなぁ。":12,"その割に自分が何者かに関しては、\n……それ程じゃないのか。[l]\n向こうのあれらの御陰か、異能自体にも抵抗はさほどないようだ。[l]\n俺やらあの店長の仕込みとは別方向での許容……？[l]\nちと気になるな。[l]\nそれとも気のせいか。[l]\nまあ何にせよ、\n俺の事までバラされたのは寧ろ幸運と視るべきか。[l]\n今の状態で俺と会って、どう反応するかにもよるけども、\n正直なところ、\nヒトにホントウのことを話すのはいつだって気が重いもんだ。[l]\n出来れば避けたい。[l]\nまことがいつわりよりもいいとはかぎらないし、\n……ああ、向こうのあれら自体にも何か不穏な……[l]\nあの兄貴達は勿論、\nなるべく要素の個個には干渉したくないが、\nこの場合はどうしたものか。[l]\nこと●●沙汰……の場合はまさに犬も食わぬと言われちゃってるからね？":13,"いずれやはり、\nあの萌え店長か。そうなのか。[l]\n俺自身が前にそういう前振りしたかも知らんが、\nいーくん、\n本気で行く気もあったんか。":14,"「こればかりは──」":15,"………。[l]\n何しろ古より":16,"凡":17,"百土地時代で物語の素材として\n延々使われてきても尚、幾度も幾度も、\n飽きたらず主題題材となる──":18,"「アイで全てが狂う……ってかなぁ」":19,"その本来が●●に根ざす物だとしても、\n否、だからこその、Ｙを武力として扱う奴等だったな。":20,"今回に限って言えば奴等自身が施したＹの":21,"歪な処置、\nその歪みが一体どう影響するのか。":22,"「ぬ、だけんども、更にちっとばかしズれてるな」":23,"裏切り裏切られ、というよりも、\nまあ地雷を踏まれたというか……[l]\n明文化し辛いところを責められた所為で余計に苛立ちが増してるんだな。[l]\n好意というのは一方的であるが故に、\n一歩間違うと逆恨みになるという。[l]\n何しろその相手のリアクションには、\n好意という性質上当然色よいものを望むが、\n期待通りでない返しの場合でも、\nそれをなじる訳にはいかないし。":24,"当然と言えば当然のコミュニケーションでありながら、\nヒトの♂と♀の場合は若干事情が複雑になるのが常で……[l]\nＹ抑圧の所為で免疫も無かった所に、\n此処に来て一気に大量の♀と接触したのも、\nイーくんにとっては負荷がでかかったろうし、\n──まあ、身も蓋もなく言っちゃえば、\n自覚のない『●●い』というのは、\n往々にして苛立ちを生ずるものであって、\nそれこそ有り体に言えば理性と感情の狭間での、\nあんびばれんとな苦悩が──\n":25,"「どっちつかずでやり過ごせないなら、\n彼岸か此岸か、己で決めねーとなあ。[l]\n他人……つーか相手は何もしてくれん、[l]\nそんな義理なぞ":26,"欠":27,"片も無い場合が殆どだから尚更……[l]\n":28,"況してや向こうさんはあの──」":29,"……某テンチョウ様と来た日には。":30,"更に前段階でのその店長の存在が、\n刷り込みにもなってしまってたのが誤算だろう。[l]\n従属の為の仕込みのつもりもあったんだろが、\n……いあ、単なるアソビ、面白いからだろかな……[l]\nどっちにしても、\n":31,"酷な事したもんだ。[l]\nせめてはっきり引導渡してやるとか、\nその前段階での釘刺しだの、\n……それこそそんな義理ぁ向こうさんには、ないなあ。[l]\nあの店長に限ったことじゃないが……[l]\n大概の場合♂が割りを喰う──様に視えるのは、\n俺も♂だからなのかねぇ。[l]\nこればっかりはなあ。[l]\nわざわざ、\nデータ検証する手間を掛ける価値のある話題でもなし……[l]\n変な含みやら気を持たしたりも、\nあれにとっちゃ遊び、遊戯愉悦の類なんだろし。[l]\n遊びは基本、自己":32,"完結するもんでないと困るのになあ。[l]\nそうでない場合なら双方同意でなけりゃ、\n単に":33,"傍":34,"迷":35,"惑な戯れ事なんだが。[l]\n複数人で行う以上は厳格なルールが必要で、\nそうなったらもうアソビというよりは、\n……詭弁かそんな話は。[l]\nどうあれ、あれには悪意が……そう、[l]\nあれのあれは明確な悪意と定義し難い故に、\n糾弾しようにもおかしな具合だし、\n兎に角せ……まあ、面倒だ。只管に面倒だ。":36,"いずれそんな調子じゃから、\n一段落ついた頃にゃー、\nその苦悩はそのまんま憎しみに転化しかねない。":37,"だが幾ら何でも相手が悪い、玉砕、返り討ち、\n恨み言を並べてぶつけるが関の山。":38,"それでもいいならまあ、あれだが……":39,"……ああ、":40,"そうだそうだ忘れてたな。":41,"そういったもろもろは、\n内容はどうあれ、\nあくまで互いにバカ正直で表裏が無い場合の話だ。":42,"自分が悪者になりたくないが故に、\n自分からは能動的に引導を渡さずに、\n相手が決裂の引き鉄を引いたと責めるに値する行動を取るまで、\nひたすらに待ち、或いは罠を仕掛け、\nつまりは『お前の所為』と言いたいが為に、\n場合によっては、\n理詰めで考えれば理不尽な決裂の理由を無理矢理に探しだし定義するやつも、\n結構な割合で居るということ、\n":43,"……まあ、要するにある種の社交辞令と言えなくも無いのだけれど、[l]\nヒトは言葉でのコミュニケーションに特化しすぎた。[l]\n真に受けるものもやはり、\n結構な割合で居るだろうな。":44,"論点がずれとるけど。":45,"要するに相手のコトバってのは、\n額面通り受け取って良いものかは常に疑う余地があるが、\nヒトがコトバで遣り取りする以上は……":46,"おやあ、\nそんな間に、\nどんどん黒く、荒れていって……るか？[l]\nＹを抑圧されてた分反動がでかいか？[l]\nそれとは無関係？[l]\n":47,"Ｃは執着強いと同時に異常に飽きっぽいんだが、\nやっぱイーくんはちょっと違う方向かもなあ。[l]\n":48,"Ｄとも勿論違う……ってか、[l]\nＨはＩに先立つという厭な符合もあることだし、\n大変だなあ面倒だなあ、\n……あれだなあ。[l]\nああもうそんでまた、\n混乱し正常な判断をし難い状況では、\nフリーズするかキレるのが":49,"常":50,"套ではあるが、\nいーくんの起き方次第じゃ余波が相当に──\nカタルシスならぬカタストロフィが、\n只でさえ『deus ex machina』て言うのは、\n":51,"……あれ、大分ずれたな。[l]\nまー独り思考はもういいやこの辺でね。":52,"うちあたりがどう言おうと、\n結局はあれといーくんの問題……ではあるんだけどなあ。":53,"「……我慢出来ん時だって、あるわな、ヒトとして」":54,"………。[l]\nとにかく我が":55,"朋イーくんにはシあわせになって貰いたい。[l]\n俺が何とかしてみせるとは言わないが、\nそれがＣから脱却しＤへと進んだ俺のイズムだからな。[l]\nお前に直で拒否られない限りは、\nヘルプするつもりだが──\n":56,"ひとつ、いやさふたつほど気になるのは、\n何か強固なジャミングみたいなにおい、\nそれと未だよくわからんねこのけはいが──\n":57,"ん？":58,"あ……んだと？":59,"だとすると一体何を、シタイっての？":60,"あーもうだから俺、\nだから、\n":61,"お前等みたいなのがキライなんだ。":62},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_031.ks","relPath":"/data/scenario/SC_S_031.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":63,"length":63,"percent":100},"cacheResetOnChange":{},"cellInfo":[]},"/data/scenario/SC_S_032.ks":{"data":[["「……忘れてたなぁ……」","「……差点忘了呢……」"],["大事な事を。","重要的事。"],["「これも彼奴自身の仕業だとしたら、\nまあ、あれじゃが……[l]\n流石にこれは、\n俺単体ではどうしようもなぁいぜよー」","「如果这也是那家伙自己搞的鬼，\n嘛，虽然那个……[l]\n但这次这个，\n光靠我一个人实在没辙啊—」"],["独りごちるも、\nかれおんは隣の座席で既に寝入っている。","虽然自言自语着，\n卡蕾欧已经在邻座睡熟了。"],["「……仮に車中泊を免れたとしても……[l]\n予定よりは大分遅れるなぁ……[l]\n向こうのローカル線のダイヤによっては、\n駅からの移動手段が無ぇすよ……[l]\n大枚はたいてタクシー……も覚悟しとかにゃならんか」","「……就算不用在车里过夜……[l]\n也比原计划晚很多啊……[l]\n根据那边地方列车的时刻表，\n可能连从车站去的交通工具都没……[l]\n得做好花大钱打车的……觉悟才行」"],["大雪で新幹線が止まった。","大雪导致新干线停运了。"],["普通に午後発の新幹線で出たら、\nかなり突発的な大雪──４月末だからそら突発だろうさ──が、\n向こうに近づくにつれ強く降ってるという事だった。[l]\n場所によって吹雪いたりもあるようで、\nニュース確認する限り、玄ノ森には風はそんなにないようだが、\nいずれ運行には影響してることに変わりはない。","本来坐下午的新干线出发，\n结果遇到突发性大雪——毕竟是四月底确实突然——\n越靠近目的地雪下得越大。[l]\n有些地方还形成了暴风雪，\n看新闻玄之森那边风倒是不大，\n但总之对运行还是有影响。"],["南の方で、\n台風の時期に豪雨で列車が止まる事ぁ経験してるけんども、\nこっちのこれは、\n実は初だった。","在南方时，\n经历过台风季因暴雨停运，\n但北方这种，\n其实还是第一次。"],["「どうなんだろな、実際雪で止まる場合って、\n復旧どんくらいかかるかのう……[l]\n降雪自体はかなりゲリラくさいし、\n風さえ弱まれば何とかなるのか？[l]\n雪はすぐ止むだろうが──」","「实际因雪停运的话，\n恢复要多久呢……[l]\n降雪本身就很游击战风格，\n只要风小点就能解决吗？[l]\n雪应该很快会停吧——」"],["前の車両だか単に遠い席なのか、\nサラリーマンのおっさんが、\nでけえ濁声で乗務員に食って掛かってるのが分かる。[l]\n気持ちは分かるが、空気が悪くなるからやめてくれ。[l]\n音響ってのはヒトの想像以上に、\n行動心理に影響すんだぜ。[l]\nそれにあれだ、\nそんな所に全自動鏖殺の遣い手でも居合わせようもんなら、","不知是前面车厢还是单纯隔得远的座位，\n有个上班族大叔，\n用超粗的沙哑嗓门怼乘务员的动静传了过来。[l]\n心情能理解，但别搞得空气这么僵啊。[l]\n声音这玩意儿啊，\n对人的行为心理影响可比想象中大多了。[l]\n再说了，\n要是那种地方刚好坐着全自动虐杀高手的话，"],["「……おーやだやだ。[l]\n考えたくねっすなぁ」","「……哎哟喂喂。[l]\n简直不敢想啊」"],["一発で、\nああいう●●は確実にやられるわい。[l]\n視られる以前に、\n何しろ『音』がばりばりに──","一眨眼功夫，\n那种●●绝对会被干掉吧。[l]\n都不用被看见，\n毕竟『声音』会彻底暴露──"],["「……お、流石に黙ったか」","「……哦，总算闭嘴了」"],["言っても詮無い事くらい、\nオトナなら判りやがれ。[l]\n糾弾すべきモノとタイミングの視極めが大事なんだろうが。[l]\n何事も建前と大義名分なのだぞ、ヒトの社会では。[l]\n自分のストレス発散の為だけにぴーちく囀るのは、\n●だけで視飽きてるんだっっての。","说了也没用这种事，\n是大人就该懂吧混蛋。[l]\n重要的是看清该谴责的对象和时机吧。[l]\n在人类社会里凡事都要讲场面话和大义名分啊。[l]\n只为发泄自己压力就叽叽喳喳乱叫，\n光是看着●就腻烦到极点了啊。"],["さて、\n早速その音響効果でこっちまでささくれ立っちったが、\n実際、\n物理的にどうにもならないからと言って、\n素直に諦めるしかないのは確かに歯痒い。[l]\n自分だけの問題ならまだしも、\n相手がある事に関しては、\nその痛みの我慢を強要する事に成りかねないし、\nとは言え、\n矢張りどうしようもないことはどうしようもない、","那么，\n这音效立刻让我也烦躁起来了，\n实际上，\n虽说物理上确实无能为力，\n但只能老实放弃确实让人窝火。[l]\n如果只是自己的问题倒还好，\n涉及他人的事情时，\n很可能就变成强迫对方忍耐痛苦，\n话虽如此，\n无可奈何的事终究无可奈何，"],["………。",""],["参ったな。","真难搞啊。"],["取り敢えず、\nさっきのおっさんみたいに周囲に当たり散らさずに居るのが、\nせめてもの抵抗というか、","总之，\n至少别像刚才那大叔那样对周围乱发脾气，\n算是微不足道的抵抗吧，"],["弁えか。","或者说识相？"],["「………特に誰からもメールも着信もなし、ってか」","「………尤其谁都没发邮件也没来电，真是的」"],["あすこに近づくにつれ、\nなるべく『","随着靠近那边，\n尽量『"],["お","哦"],["と","如此"],["なし』くすることにしたので、\nイーくんの状況はもう人並みに想像するしかない。","不搞』事情的决定，\n关于小E的状况只能像常人那样想象了。"],["この身体が物理的にあの領内に入る以上、\n迂闊なことをして連中の網に引っ掛かるのは面倒だし、[l]\n本番でごたごたに巻き込まれた場合に備え、\n色々温存しておくに越したことはない。[l]\n無論最低限の常駐は展開するが、\nかれおんのあれでなきゃ検索には引っ掛からないだろうし、[l]\nまあそこはなんとかなるだろう。[l]\n多少気が引けるが、\n肝心な時に動けないのでは向かう意味もない。[l]\n本末転倒だ。","既然这具身体物理上踏入了那片领地，\n贸然行动被那群人的网缠住会很麻烦，[l]\n为了防备正式行动时被卷入混乱，\n保留些实力总没坏处。[l]\n当然最低限度的常驻防护会展开，\n只要不是卡蕾欧那种级别应该不会被检索到，[l]\n嘛那边总会有办法的吧。[l]\n虽然有点过意不去，\n但关键时刻动不了的话去就没意义了。[l]\n本末倒置啊。"],["何しろ間違いなければ彼処に張られた結界は、\n『","毕竟如果没错的话那边张开的结界，\n『"],["縛狼","缚狼"],["の紐","之绳"],["に似る』の名の許に仕切られた連中の構成、[l]\n偶然とは言え俺にとってはイヤな……[l]\n","似态』名义下那帮人布置的架构，[l]\n虽说是偶然但对我来说真是讨厌……[l]\n"],["験が悪いったらねー。[l]\nそういう意味では、\nかれおんにとっても決して気持ちの良い話ではないが、[l]\nまあ、[l]\nいずれにせよ、[l]\n俺個人の意思としては戦争しに行く訳じゃないし、[l]\n戦闘状態さえ避ければ……","要说运气差可真是没谁了。[l]\n从这个意义上来说，\n对卡蕾欧来说也绝不是件愉快的事，[l]\n不过，[l]\n总之，[l]\n就我个人意愿而言并不是要去打仗，[l]\n只要避开战斗状态就……"],["いや、[l]\nなんつーかその、[l]\n要するに言い訳だ。","不、[l]\n该怎么说呢那个、[l]\n总之就是借口。"],["本心としては、これ以上は直視、直知に耐えないから……だろうな。","真心话是，已经无法再直视、直面下去了吧……"],["俺にとってこの程度、何を今更なんだよ、[l]\n的な話かも知れないが、[l]\n何しろ最も近しい存在、[l]\n何も知らない幼い弟にも等しい、[l]\n……情の入る相手にさえ、[l]\n超然として居られるならば、[l]\n俺とてＤとして連中と袂を分かっていないのだ。","对我而言这种程度，现在才来说什么啊、[l]\n大概就是这种话吧、[l]\n毕竟是最亲近的存在、[l]\n等同于毫不知情的年幼弟弟、[l]\n……就连对投入感情的对象、[l]\n若能保持超然态度的话、[l]\n我作为D也不会和他们分道扬镳吧。"],["あれから永いこと、永いこと独りでいたんだ。","从那之后漫长地、漫长地独自活着。"],["彼処に『在る』のは絶対にイヤだったし、[l]\n全き自分の意思で彼処をおん","绝对不愿『存在』于彼处、[l]\n虽凭完全自我意志从彼处"],["出はしたが、[l]\nそれでも人の中で、[l]\n他と違うと自覚しながらずっと独りで居るのは、","逃了出来、[l]\n即便如此在人群中、[l]\n自觉与他人不同却始终孤独生存的时光、"],["とても遣り切れない時間だった。","实在是难以忍受。"],["人の肉を","披着"],["纏い、[l]\n幾人もの","人皮、[l]\n借助众多"],["相","戏"],["手の腹を借りて、[l]\n繰り返し繰り返し、[l]\n死と、[l]新生、[l]死と、[l]新生、[l]\n慣れや諦観や恭順や感化や同化やなんやを経て、[l]\n人としての日常に埋もれて、[l]\n矛盾を抱え込む割り切れないものども──[l]\n論理だけでなく、[l]\n楽になろうと幸せになろうと努力や苦行を耐え、[l]\n創造し、歩みを進め、[l]\nいざその技術や環境を得ては堕落し生きる力を失っていく、[l]\n元の木阿弥、いや、前より悪化さえさせ、[l]\nそれでも尚、[l]\nヒトが自然と呼ぶヒト以外の存在同様、[l]\n世界に生まれ出でて存在すること自体は拒否されていないこの、[l]\nしかしただそれだけの、[l]\n自分達（ヒトという種）の危機をこの惑星のものと置き換えて、[l]\n実のところ御為ごかしでしかない建前故に誰も本気で案じることもない、[l]\nしかし本音で語り合うにはあまりにも、[l]\n欲望を満たすためのおおきなアタマを持ったどうぶつ、[l]\n──その人間達との関わり合いの中で、","他人掌心、[l]\n反反复复地、[l]\n死亡、[l]新生、[l]死亡、[l]新生、[l]\n历经习惯死心恭顺感化同化种种、[l]\n埋没于人类日常中、[l]\n那些怀抱矛盾无法割舍之物──[l]\n不仅限于逻辑、[l]\n为轻松幸福而忍受努力苦行、[l]\n创造并迈步前行、[l]\n一旦获得技术环境却又堕落丧失生存力量、[l]\n前功尽弃不、甚至变本加厉、[l]\n即便如此、[l]\n人类与被称作自然的非人存在同样、[l]\n诞生于世存在本身未被否定的这个、[l]\n然而仅此而已的、[l]\n将我们（人类种）的危机置换为星球危机、[l]\n实则冠冕堂皇的表面文章导致无人真心忧虑、[l]\n但要真心交谈又太过、[l]\n长着大脑袋满足欲望的动物、[l]\n──在与这些人类的牵扯中、"],["摩滅こそしなかったものの、[l]\n自己保存の意義だけを拠り所にするには、[l]\n多少は自我というものを希薄にせねば耐えられなかったあの時間、[l]\n茫洋と渡世を送り、[l]\n御陰で","虽未磨损殆尽、[l]\n若仅以自我保存意义为依托、[l]\n就不得不稍许稀释自我才能忍受的那段时光、[l]\n浑浑噩噩度日、[l]\n托此福"],["外","算"],["面と","表"],["内","里"],["面を並立させる術には長けるも、[l]\nさして目的があるでもなかったあの頃、[l]\n自己消滅という選択肢を選ばなかったのは、[l]\n単に臆病で意気地なしだったからだし、[l]\n事実放っておけば俺は延々と在り続けるものであり、[l]\n自滅するには逆に多大な労力を要するものだったから、[l]\n諾々と存在することに甘んじて今まで来た。","并存的伎俩倒是娴熟、[l]\n也没什么明确目的的那段岁月、[l]\n未选择自我毁灭这条路、[l]\n纯粹是因为懦弱没骨气、[l]\n事实上放任不管我就会永远存在下去、[l]\n自我毁灭反而需要耗费巨大精力、[l]\n便苟且偷生随波逐流至今。"],["しかし同じ受肉したものでも、[l]\nあれはまた別だったんだな。[l]\nヒトの肉を得ることは、[l]\nアソビをする余裕が他より余分にできる事でもあり、[l]\n俺の苦しみの源はあれにとっては逆に僥倖そのものだ。[l]\n彼の連中はまさに主従が錯綜していて、[l]\nまるで●●と●●●のようだが、[l]\nいずれにしても、[l]\nＥＧｏの捉え方が俺とは違った、[l]\nＣの在り方に同調は出来なかった、[l]\n故の出奔なのだから。[l]\nあれらによって調整された筈の俺が、[l]\nあれらと意見の相違を視るとは皮肉なもんだ。","但同样是获得肉体的存在，[l]\n那家伙却是完全不同的情况。[l]\n获得人类肉体这件事，[l]\n意味着能比其他存在多出享乐的余裕，[l]\n我的痛苦根源对那家伙而言反倒是天大的幸运。[l]\n他们那群人主从关系错综复杂，[l]\n简直就像●●和●●●一样，[l]\n但无论如何，[l]\n他们对EGo的理解与我不同，[l]\n无法认同C的存在方式，[l]\n所以才选择出走。[l]\n本该被他们调整过的我，[l]\n如今竟会与他们产生意见分歧真是讽刺。"],["手前味噌な解釈ではあるが、[l]\nＣ→Ｄの移相とは、[l]\n他者の存在を慮るものへの変遷の意を含むのではなかろうか。[l]\n最初の階段を上ること、[l]\nそれは、[l]\n打算だけではない結びつきで群れなすものへの、[l]\n真実はどうあれだから俺は、[l]\n","虽然这是自我标榜式的解读，[l]\nC→D的相位转移，[l]\n或许包含着对顾及他人存在之物的变迁意味吧。[l]\n登上最初的阶梯，[l]\n那便是，[l]\n向并非仅凭算计维系的群体纽带，[l]\n无论真相如何所以我才，[l]\n"],["所","的"],["謂青臭い、モノのミカタ、[l]\nそういう価値観が根底にあったから、[l]\n結局、[l]\nヒトの中で生きるに於いて、[l]\n理に勝って非に落ちる事しきり、[l]\n……感情的になれといってる訳じゃない、[l]\nそれこそあれらの原理だ──[l]\nただ、自然に湧き上がるこのおもい、[l]\nそういった部分が、[l]\n或る意味で究極に本来的なそのおもいの表出、[l]\nヒトのそれをみせつけられること、[l]\nそれだけが俺にとっての恍惚だったから、[l]\n──それは勿論、誕生と死の重要性が、[l]\n俺と他では違うからかも知れないが、[l]\nそれでも、[l]\nその根本が結局は自己満足でしかなくても、[l]\n自分を護る為に全てに開き直って他人を傷付けるよりはいい。[l]\n時には嘘でも同情でも偽善でも、[l]\n全ての時と場合において、真実──を語ること──が、[l]\n必ずしも冴えたコトであるとは思えない。","说什么幼稚、护短、[l]\n正因为骨子里有这种价值观，[l]\n到头来，[l]\n在人类社会中生存时，[l]\n屡屡因理性获胜却陷入谬误，[l]\n……倒也不是说要感情用事，[l]\n那才正中了他们的下怀──[l]\n只是，自然涌现的这份心意，[l]\n这些部分，[l]\n某种意义上正是最纯粹的本心流露，[l]\n能目睹人类展现这样的心意，[l]\n仅此便是我无上的欢愉，[l]\n──当然也可能因为，[l]\n我对生死重要性的认知与他人不同，[l]\n即便如此，[l]\n就算这本质终究只是自我满足，[l]\n也比为自保而破罐破摔伤害他人强。[l]\n有时即便是谎言、同情或伪善，[l]\n在所有时间与场合都坚持说真话──这种行为──[l]\n未必就是明智之举。"],["好奇心よりも、[l]\n想像力を、[l]\nそして","比起好奇心，[l]\n更需想象力，[l]\n以及"],["弁えること。","懂得分寸。"],["あれらに敵対したい訳じゃない。[l]\n違う選択をしただけだ。[l]\nそこを間違うと、[l]\n干渉のて──","并非要与他们为敌。[l]\n只是做出了不同的选择。[l]\n若搞错这点，[l]\n干涉之──"],["「……ふがっ……」","「……呜嘎……」"],["「……よっく寝とるなー」","「……睡得可真香啊ー」"],["ああ、俺もちとばかし感傷に浸りすぎたな。","啊，我也稍微有点太过沉溺于感伤了。"],["「にしても……","「话虽如此……"],["愛いやつじゃのう」","真是可爱的小家伙呢」"],["漸く出逢えた、\n同じステージで語り合える","终于相遇的，\n能在同一舞台对话的"],["希","希"],["有なこの２人、\nこの存在は確かに、\n確かに今の俺の支えだ。","珍贵的这两人，\n这份存在确实，\n确实支撑着现在的我。"],["どんなに人がくだらないものでも、\nこのセカイが最悪の箱庭でも、その中で、\n存在していく意義を──たとえ転嫁であっても、\n思わせてくれるのは、","无论人们认为多么无聊的东西，\n即便这个世界是最糟糕的盆景庭院，在其中，\n让我感受到存在下去的意义──哪怕只是转嫁的，\n都是你给予的。"],["「……勝手ですまん、……」","「……擅自这么做真是抱歉……」"],["今までの永きにわたり、\nその殆どがヒトの領域でしか語ることが出来ない中で、\nそう、\nこのタイミングも恐らくはいーくんの影響ではあるかもだが、","迄今为止的漫长岁月里，\n其中绝大部分都只能在人类领域中言说，\n没错，\n这个时机恐怕也受到饭君的影响吧，"],["いーくんには人として、\n助けになりたい。","作为人类而言，\n我想帮助饭君。"],["いずれもう、\nセーブ不能のラスダンに向かう段階、\n最後の敵……交戦する気はないにせよ、[l]\nまー、救済ＮＰＣとしてエンディングまで無駄な力は使わぬに限る。","反正迟早，\n都会进入无法存档的最终决战阶段，\n最后的敌人……虽无交战之意，[l]\n嘛～作为救济NPC直到结局前最好别浪费多余力气。"],["覚は……[l]\n生き死にの勝負事には有用──\n先手を取る裏をかく、\nつまりは相手を負かす為の、\n対敵方向のスキルだ。[l]\n情報収集つーのは分析されるためにそうされるのであって、\nそれをして平和的に遣うって事はあまりない。[l]\nあっても自分が我慢する方向にしかならないだろう。","觉（能力）……[l]\n在生死较量中才有用武之地──\n抢占先机出其不意，\n说到底就是为了击败对手，\n属于对抗性质的技能。[l]\n所谓情报收集本就是用来被分析的，\n很少会有人将其用于和平途径。[l]\n就算有也只会让自己陷入忍气吞声的境地。"],["敢えてその善行的有意を求めても、\n精精が皆を丸く収め…ようとする為の下調べ、[l]\nそして結局のところ、\n歪みや嘘無くそれを為すのは不可能だ。[l]\n如何なる嘘を吐くが良き","即便刻意追求这种善行意义，\n充其量不过是让大伙儿圆满收场…的事前调查，[l]\n但归根结底，\n不带扭曲与谎言根本无法实现。[l]\n该撒怎样的谎才好"],["倫か、\nその検討の材料になるだけだ。","是伦理吗，\n终究只是供权衡的材料罢了。"],["つまり、\n温存云々以前に、\n","也就是说，\n在考虑保留之前，\n"],["朋","对朋"],["輩に対しては本来あまり向けたくないもんだし。","友本来就不太想动用这能力啊。"],["「まあ、面倒に考えることもないか……」","「算了，也不用想得太复杂……」"],["直接、かたりあうのが、[l]\nきっといいんだ。[l]\n人として生きるなら。","直接对话沟通，[l]\n肯定更好。[l]\n若要以人类身份活下去的话。"],["それが彼か、俺かは、[l]\n成り行き次第だけどな。","至于那个人是他还是我，[l]\n就看事态发展了。"],["ともあれ、\n今から、まして助力たらんとしているならば、\nヒト並みであることがよきフィルターになるだろう。","总之，\n既然现在要伸出援手，\n保持人类水准就是最好的过滤器。"],["「どっちにしても、\nイキモノはたたかわねばならない、\nかならずどこかの局面で」","「无论如何，\n活着就必须战斗，\n必定会在某个时刻」"],["我を通すべく尽力し立ち振る舞うのも、[l]\n無論在るべき姿の一つであるし、[l]\n相争うのがこのセカイのルールだとしても、[l]\nそれでも、[l]\n『全員』がそうやって開き直る必要はないんだからな。[l]\n疑問を持ちながら、[l]\n愉しみなど感じず出来れば避けたいと願いながら、[l]\n存在していたっていいだろうと俺は思う。","为贯彻自我而全力以赴的姿态，[l]\n自然也是应有的存在方式之一，[l]\n即便相争是这世界的规则，[l]\n即便如此，[l]\n也并非『所有人』都需要这样破罐破摔啊。[l]\n怀着疑问，[l]\n感受不到乐趣只求能避则避，[l]\n我觉得这样存在下去也未尝不可。"],["そしてそういう我を通そうとする俺も、\n詰まるところは同じ。","而这样试图贯彻自我的我，\n说到底也是一样。"],["大義名分など関係はない。","与大义名分毫无关系。"],["共存し得るか将又、\n先へ続くものは一つしか選ばれないのか。","是能够共存，\n还是只能选择一条路走到黑？"],["結局はそういうことだ。","终究就是这么回事。"],["「人工物でさえも自然、世界の拒否しなかった存在、[l]\n不平等たる状況があり得るコトを含めてこそ完璧に平等な状態、[l]\n理不尽ですら存在するコトが完全、[l]\n節度自体にも節度を、[l]\n言う事を信じるなという言を信じるか信じないか、[l]\n不都合な事項が載っていない辞書は十全でないということか……」","「连人造物都被自然、世界所接纳的存在，[l]\n包含可能产生不平等的状况才是真正完美的平等，[l]\n连无理之事都存在才算完整，[l]\n对节制本身也要保持节制，[l]\n该不该相信『不要轻信言论』这句言论，[l]\n没记载不利事项的辞典就不算完备吗……」"],["……よくわからんようになってきた。","……越来越搞不懂了。"],["まあそんなことは置いといて、[l]\n向こうで逢えたならば、[l]\nこういった小理屈はともかくヒト並みの、[l]\n心遣いはするつもりだ。","嘛那种事就先放一边，[l]\n要是在那边遇上的话，[l]\n这些歪理暂且不论至少会像普通人那样，[l]\n好好表达心意的。"],["さて、[l]\nいーくんのこの無連絡状況は、\n吉兆なのか凶兆なのか。","那么，[l]\n饭君这种失联状况，\n究竟是吉兆还是凶兆呢。"],["まさかもう片が付いてるってことは無いだろうが、\nどうやったって最後には、場合によっちゃそれ以前に、[l]\nあの店長とは、本人がサシで遣り合わなきゃならない。[l]\nいーくんの選択が","总不至于已经完事了吧，\n但无论如何到最后，搞不好在那之前，[l]\n都必须和那位店长单独做个了断。[l]\n无论饭君选择"],["Ｙｅ",""],["ｓだろうと","s还是"],["Ｘだろうと、[l]\nそれはそうなんだ。","X，[l]\n这点都不会变。"],["いずれコトの前に余計な事をして本番に差し支えては意味がない。[l]\nなるたけ応戦しないよう心懸けるとしても──\n俺は俺で、その後、その次がある。","若在正事前节外生枝导致耽误正事就本末倒置了。[l]\n虽然我会尽量克制应战冲动——\n但我也有我的，之后，以及更之后的安排。"],["「……お、動くか」","「……哦，要行动了吗」"],["独り思考に入り込んでる内に、\nどうやら","沉浸在独自思考的期间，\n似乎"],["現","现"],["世でぁ事態が進行していたか。[l]\nただ、窓の外を視るに、\n矢張り着く頃には、","事态已在世间推进了？[l]\n不过望向窗外，\n果然抵达时已是，"],["「",""],["冥ぇよなあ、これはもう……」","冥界般的景象了啊，这简直……」"],["色んな意味で面倒な展開を、[l]\n色んな意味で覚悟せにゃならん、[l]てことか。","各种意义上的麻烦展开，[l]\n必须做好各种意义上的觉悟，[l]就是这么回事吧。"]],"context":[["SC_S_032.ks/index/1/text"],["SC_S_032.ks/index/3/text"],["SC_S_032.ks/index/5/text"],["SC_S_032.ks/index/7/text"],["SC_S_032.ks/index/9/text"],["SC_S_032.ks/index/11/text"],["SC_S_032.ks/index/13/text"],["SC_S_032.ks/index/15/text"],["SC_S_032.ks/index/17/text"],["SC_S_032.ks/index/19/text"],["SC_S_032.ks/index/21/text"],["SC_S_032.ks/index/23/text"],["SC_S_032.ks/index/25/text"],["SC_S_032.ks/index/27/text"],["SC_S_032.ks/index/29/text"],["SC_S_032.ks/index/31/text"],["SC_S_032.ks/index/33/text"],["SC_S_032.ks/index/35/text"],["SC_S_032.ks/index/37/text"],["SC_S_032.ks/index/39/text"],["SC_S_032.ks/index/41/text"],["SC_S_032.ks/index/43/text"],["SC_S_032.ks/index/45/text"],["SC_S_032.ks/index/47/text"],["SC_S_032.ks/index/49/text"],["SC_S_032.ks/index/51/text"],["SC_S_032.ks/index/53/text"],["SC_S_032.ks/index/55/text"],["SC_S_032.ks/index/57/text"],["SC_S_032.ks/index/60/text"],["SC_S_032.ks/index/62/text"],["SC_S_032.ks/index/64/text"],["SC_S_032.ks/index/66/text"],["SC_S_032.ks/index/68/text"],["SC_S_032.ks/index/70/text"],["SC_S_032.ks/index/72/text"],["SC_S_032.ks/index/74/text"],["SC_S_032.ks/index/76/text"],["SC_S_032.ks/index/78/text"],["SC_S_032.ks/index/80/text"],["SC_S_032.ks/index/82/text"],["SC_S_032.ks/index/84/text"],["SC_S_032.ks/index/86/text"],["SC_S_032.ks/index/88/text"],["SC_S_032.ks/index/90/text"],["SC_S_032.ks/index/92/text"],["SC_S_032.ks/index/94/text"],["SC_S_032.ks/index/96/text"],["SC_S_032.ks/index/99/text"],["SC_S_032.ks/index/101/text"],["SC_S_032.ks/index/103/text"],["SC_S_032.ks/index/105/text"],["SC_S_032.ks/index/107/text"],["SC_S_032.ks/index/109/text"],["SC_S_032.ks/index/111/text"],["SC_S_032.ks/index/113/text"],["SC_S_032.ks/index/115/text"],["SC_S_032.ks/index/117/text"],["SC_S_032.ks/index/119/text"],["SC_S_032.ks/index/121/text"],["SC_S_032.ks/index/123/text"],["SC_S_032.ks/index/125/text"],["SC_S_032.ks/index/127/text"],["SC_S_032.ks/index/129/text"],["SC_S_032.ks/index/131/text"],["SC_S_032.ks/index/133/text"],["SC_S_032.ks/index/135/text"],["SC_S_032.ks/index/137/text"],["SC_S_032.ks/index/139/text"],["SC_S_032.ks/index/141/text"],["SC_S_032.ks/index/144/text"],["SC_S_032.ks/index/146/text"],["SC_S_032.ks/index/148/text"],["SC_S_032.ks/index/150/text"],["SC_S_032.ks/index/152/text"],["SC_S_032.ks/index/154/text"],["SC_S_032.ks/index/156/text"],["SC_S_032.ks/index/158/text"],["SC_S_032.ks/index/160/text"],["SC_S_032.ks/index/162/text"],["SC_S_032.ks/index/164/text"],["SC_S_032.ks/index/166/text"],["SC_S_032.ks/index/168/text"],["SC_S_032.ks/index/170/text"],["SC_S_032.ks/index/172/text"],["SC_S_032.ks/index/174/text"],["SC_S_032.ks/index/176/text"],["SC_S_032.ks/index/178/text"],["SC_S_032.ks/index/180/text"],["SC_S_032.ks/index/182/text"],["SC_S_032.ks/index/184/text"],["SC_S_032.ks/index/186/text"],["SC_S_032.ks/index/188/text"],["SC_S_032.ks/index/190/text"],["SC_S_032.ks/index/192/text"],["SC_S_032.ks/index/194/text"],["SC_S_032.ks/index/196/text"],["SC_S_032.ks/index/198/text"]],"tags":[],"parameters":[[{"start":160,"end":172}],[{"start":196,"end":202}],[{"start":258,"end":328}],[{"start":354,"end":385}],[{"start":415,"end":535}],[{"start":561,"end":573}],[{"start":579,"end":744}],[{"start":750,"end":812}],[{"start":842,"end":948}],[{"start":976,"end":1157}],[{"start":1191,"end":1219}],[{"start":1247,"end":1308}],[{"start":1342,"end":1355}],[{"start":1381,"end":1527}],[{"start":1533,"end":1726}],[{"start":1736,"end":1740}],[{"start":1746,"end":1751}],[{"start":1757,"end":1813}],[{"start":1824,"end":1828}],[{"start":1858,"end":1882}],[{"start":1944,"end":1965}],[{"start":1974,"end":1975}],[{"start":1984,"end":1985}],[{"start":1994,"end":2036}],[{"start":2042,"end":2277}],[{"start":2283,"end":2310}],[{"start":2319,"end":2321}],[{"start":2330,"end":2332}],[{"start":2341,"end":2390}],[{"start":2404,"end":2538}],[{"start":2544,"end":2580}],[{"start":2586,"end":2617}],[{"start":2634,"end":2785}],[{"start":2791,"end":2812}],[{"start":2818,"end":2858}],[{"start":2867,"end":2920}],[{"start":2930,"end":2945}],[{"start":2951,"end":2955}],[{"start":2965,"end":2980}],[{"start":2989,"end":2990}],[{"start":2999,"end":3516}],[{"start":3526,"end":3632}],[{"start":3642,"end":3643}],[{"start":3653,"end":3655}],[{"start":3665,"end":3666}],[{"start":3675,"end":3863}],[{"start":3869,"end":4172}],[{"start":4178,"end":4330}],[{"start":4344,"end":4345}],[{"start":4355,"end":4828}],[{"start":4834,"end":4865}],[{"start":4876,"end":4882}],[{"start":4888,"end":4952}],[{"start":5028,"end":5037}],[{"start":5067,"end":5079}],[{"start":5103,"end":5123}],[{"start":5153,"end":5160}],[{"start":5169,"end":5178}],[{"start":5208,"end":5232}],[{"start":5242,"end":5243}],[{"start":5253,"end":5290}],[{"start":5296,"end":5378}],[{"start":5412,"end":5425}],[{"start":5453,"end":5535}],[{"start":5545,"end":5569}],[{"start":5575,"end":5665}],[{"start":5682,"end":5849}],[{"start":5855,"end":5957}],[{"start":5967,"end":5989}],[{"start":5995,"end":6013}],[{"start":6027,"end":6028}],[{"start":6037,"end":6059}],[{"start":6089,"end":6108}],[{"start":6134,"end":6179}],[{"start":6185,"end":6214}],[{"start":6220,"end":6280}],[{"start":6310,"end":6357}],[{"start":6385,"end":6575}],[{"start":6581,"end":6614}],[{"start":6620,"end":6632}],[{"start":6638,"end":6671}],[{"start":6677,"end":6688}],[{"start":6718,"end":6890}],[{"start":6920,"end":6937}],[{"start":6943,"end":7022}],[{"start":7028,"end":7069}],[{"start":7075,"end":7177}],[{"start":7186,"end":7188}],[{"start":7197,"end":7202}],[{"start":7212,"end":7235}],[{"start":7241,"end":7321}],[{"start":7351,"end":7360}],[{"start":7388,"end":7411}],[{"start":7421,"end":7422}],[{"start":7432,"end":7479}],[{"start":7513,"end":7514}],[{"start":7524,"end":7538}],[{"start":7562,"end":7606}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_032.ks","basename":"SC_S_032.ks","indexIds":{"「……忘れてたなぁ……」":0,"大事な事を。":1,"「これも彼奴自身の仕業だとしたら、\nまあ、あれじゃが……[l]\n流石にこれは、\n俺単体ではどうしようもなぁいぜよー」":2,"独りごちるも、\nかれおんは隣の座席で既に寝入っている。":3,"「……仮に車中泊を免れたとしても……[l]\n予定よりは大分遅れるなぁ……[l]\n向こうのローカル線のダイヤによっては、\n駅からの移動手段が無ぇすよ……[l]\n大枚はたいてタクシー……も覚悟しとかにゃならんか」":4,"大雪で新幹線が止まった。":5,"普通に午後発の新幹線で出たら、\nかなり突発的な大雪──４月末だからそら突発だろうさ──が、\n向こうに近づくにつれ強く降ってるという事だった。[l]\n場所によって吹雪いたりもあるようで、\nニュース確認する限り、玄ノ森には風はそんなにないようだが、\nいずれ運行には影響してることに変わりはない。":6,"南の方で、\n台風の時期に豪雨で列車が止まる事ぁ経験してるけんども、\nこっちのこれは、\n実は初だった。":7,"「どうなんだろな、実際雪で止まる場合って、\n復旧どんくらいかかるかのう……[l]\n降雪自体はかなりゲリラくさいし、\n風さえ弱まれば何とかなるのか？[l]\n雪はすぐ止むだろうが──」":8,"前の車両だか単に遠い席なのか、\nサラリーマンのおっさんが、\nでけえ濁声で乗務員に食って掛かってるのが分かる。[l]\n気持ちは分かるが、空気が悪くなるからやめてくれ。[l]\n音響ってのはヒトの想像以上に、\n行動心理に影響すんだぜ。[l]\nそれにあれだ、\nそんな所に全自動鏖殺の遣い手でも居合わせようもんなら、":9,"「……おーやだやだ。[l]\n考えたくねっすなぁ」":10,"一発で、\nああいう●●は確実にやられるわい。[l]\n視られる以前に、\n何しろ『音』がばりばりに──":11,"「……お、流石に黙ったか」":12,"言っても詮無い事くらい、\nオトナなら判りやがれ。[l]\n糾弾すべきモノとタイミングの視極めが大事なんだろうが。[l]\n何事も建前と大義名分なのだぞ、ヒトの社会では。[l]\n自分のストレス発散の為だけにぴーちく囀るのは、\n●だけで視飽きてるんだっっての。":13,"さて、\n早速その音響効果でこっちまでささくれ立っちったが、\n実際、\n物理的にどうにもならないからと言って、\n素直に諦めるしかないのは確かに歯痒い。[l]\n自分だけの問題ならまだしも、\n相手がある事に関しては、\nその痛みの我慢を強要する事に成りかねないし、\nとは言え、\n矢張りどうしようもないことはどうしようもない、":14,"………。":15,"参ったな。":16,"取り敢えず、\nさっきのおっさんみたいに周囲に当たり散らさずに居るのが、\nせめてもの抵抗というか、":17,"弁えか。":18,"「………特に誰からもメールも着信もなし、ってか」":19,"あすこに近づくにつれ、\nなるべく『":20,"お":21,"と":22,"なし』くすることにしたので、\nイーくんの状況はもう人並みに想像するしかない。":23,"この身体が物理的にあの領内に入る以上、\n迂闊なことをして連中の網に引っ掛かるのは面倒だし、[l]\n本番でごたごたに巻き込まれた場合に備え、\n色々温存しておくに越したことはない。[l]\n無論最低限の常駐は展開するが、\nかれおんのあれでなきゃ検索には引っ掛からないだろうし、[l]\nまあそこはなんとかなるだろう。[l]\n多少気が引けるが、\n肝心な時に動けないのでは向かう意味もない。[l]\n本末転倒だ。":24,"何しろ間違いなければ彼処に張られた結界は、\n『":25,"縛狼":26,"の紐":27,"に似る』の名の許に仕切られた連中の構成、[l]\n偶然とは言え俺にとってはイヤな……[l]\n":28,"験が悪いったらねー。[l]\nそういう意味では、\nかれおんにとっても決して気持ちの良い話ではないが、[l]\nまあ、[l]\nいずれにせよ、[l]\n俺個人の意思としては戦争しに行く訳じゃないし、[l]\n戦闘状態さえ避ければ……":29,"いや、[l]\nなんつーかその、[l]\n要するに言い訳だ。":30,"本心としては、これ以上は直視、直知に耐えないから……だろうな。":31,"俺にとってこの程度、何を今更なんだよ、[l]\n的な話かも知れないが、[l]\n何しろ最も近しい存在、[l]\n何も知らない幼い弟にも等しい、[l]\n……情の入る相手にさえ、[l]\n超然として居られるならば、[l]\n俺とてＤとして連中と袂を分かっていないのだ。":32,"あれから永いこと、永いこと独りでいたんだ。":33,"彼処に『在る』のは絶対にイヤだったし、[l]\n全き自分の意思で彼処をおん":34,"出はしたが、[l]\nそれでも人の中で、[l]\n他と違うと自覚しながらずっと独りで居るのは、":35,"とても遣り切れない時間だった。":36,"人の肉を":37,"纏い、[l]\n幾人もの":38,"相":39,"手の腹を借りて、[l]\n繰り返し繰り返し、[l]\n死と、[l]新生、[l]死と、[l]新生、[l]\n慣れや諦観や恭順や感化や同化やなんやを経て、[l]\n人としての日常に埋もれて、[l]\n矛盾を抱え込む割り切れないものども──[l]\n論理だけでなく、[l]\n楽になろうと幸せになろうと努力や苦行を耐え、[l]\n創造し、歩みを進め、[l]\nいざその技術や環境を得ては堕落し生きる力を失っていく、[l]\n元の木阿弥、いや、前より悪化さえさせ、[l]\nそれでも尚、[l]\nヒトが自然と呼ぶヒト以外の存在同様、[l]\n世界に生まれ出でて存在すること自体は拒否されていないこの、[l]\nしかしただそれだけの、[l]\n自分達（ヒトという種）の危機をこの惑星のものと置き換えて、[l]\n実のところ御為ごかしでしかない建前故に誰も本気で案じることもない、[l]\nしかし本音で語り合うにはあまりにも、[l]\n欲望を満たすためのおおきなアタマを持ったどうぶつ、[l]\n──その人間達との関わり合いの中で、":40,"摩滅こそしなかったものの、[l]\n自己保存の意義だけを拠り所にするには、[l]\n多少は自我というものを希薄にせねば耐えられなかったあの時間、[l]\n茫洋と渡世を送り、[l]\n御陰で":41,"外":42,"面と":43,"内":44,"面を並立させる術には長けるも、[l]\nさして目的があるでもなかったあの頃、[l]\n自己消滅という選択肢を選ばなかったのは、[l]\n単に臆病で意気地なしだったからだし、[l]\n事実放っておけば俺は延々と在り続けるものであり、[l]\n自滅するには逆に多大な労力を要するものだったから、[l]\n諾々と存在することに甘んじて今まで来た。":45,"しかし同じ受肉したものでも、[l]\nあれはまた別だったんだな。[l]\nヒトの肉を得ることは、[l]\nアソビをする余裕が他より余分にできる事でもあり、[l]\n俺の苦しみの源はあれにとっては逆に僥倖そのものだ。[l]\n彼の連中はまさに主従が錯綜していて、[l]\nまるで●●と●●●のようだが、[l]\nいずれにしても、[l]\nＥＧｏの捉え方が俺とは違った、[l]\nＣの在り方に同調は出来なかった、[l]\n故の出奔なのだから。[l]\nあれらによって調整された筈の俺が、[l]\nあれらと意見の相違を視るとは皮肉なもんだ。":46,"手前味噌な解釈ではあるが、[l]\nＣ→Ｄの移相とは、[l]\n他者の存在を慮るものへの変遷の意を含むのではなかろうか。[l]\n最初の階段を上ること、[l]\nそれは、[l]\n打算だけではない結びつきで群れなすものへの、[l]\n真実はどうあれだから俺は、[l]\n":47,"所":48,"謂青臭い、モノのミカタ、[l]\nそういう価値観が根底にあったから、[l]\n結局、[l]\nヒトの中で生きるに於いて、[l]\n理に勝って非に落ちる事しきり、[l]\n……感情的になれといってる訳じゃない、[l]\nそれこそあれらの原理だ──[l]\nただ、自然に湧き上がるこのおもい、[l]\nそういった部分が、[l]\n或る意味で究極に本来的なそのおもいの表出、[l]\nヒトのそれをみせつけられること、[l]\nそれだけが俺にとっての恍惚だったから、[l]\n──それは勿論、誕生と死の重要性が、[l]\n俺と他では違うからかも知れないが、[l]\nそれでも、[l]\nその根本が結局は自己満足でしかなくても、[l]\n自分を護る為に全てに開き直って他人を傷付けるよりはいい。[l]\n時には嘘でも同情でも偽善でも、[l]\n全ての時と場合において、真実──を語ること──が、[l]\n必ずしも冴えたコトであるとは思えない。":49,"好奇心よりも、[l]\n想像力を、[l]\nそして":50,"弁えること。":51,"あれらに敵対したい訳じゃない。[l]\n違う選択をしただけだ。[l]\nそこを間違うと、[l]\n干渉のて──":52,"「……ふがっ……」":53,"「……よっく寝とるなー」":54,"ああ、俺もちとばかし感傷に浸りすぎたな。":55,"「にしても……":56,"愛いやつじゃのう」":57,"漸く出逢えた、\n同じステージで語り合える":58,"希":59,"有なこの２人、\nこの存在は確かに、\n確かに今の俺の支えだ。":60,"どんなに人がくだらないものでも、\nこのセカイが最悪の箱庭でも、その中で、\n存在していく意義を──たとえ転嫁であっても、\n思わせてくれるのは、":61,"「……勝手ですまん、……」":62,"今までの永きにわたり、\nその殆どがヒトの領域でしか語ることが出来ない中で、\nそう、\nこのタイミングも恐らくはいーくんの影響ではあるかもだが、":63,"いーくんには人として、\n助けになりたい。":64,"いずれもう、\nセーブ不能のラスダンに向かう段階、\n最後の敵……交戦する気はないにせよ、[l]\nまー、救済ＮＰＣとしてエンディングまで無駄な力は使わぬに限る。":65,"覚は……[l]\n生き死にの勝負事には有用──\n先手を取る裏をかく、\nつまりは相手を負かす為の、\n対敵方向のスキルだ。[l]\n情報収集つーのは分析されるためにそうされるのであって、\nそれをして平和的に遣うって事はあまりない。[l]\nあっても自分が我慢する方向にしかならないだろう。":66,"敢えてその善行的有意を求めても、\n精精が皆を丸く収め…ようとする為の下調べ、[l]\nそして結局のところ、\n歪みや嘘無くそれを為すのは不可能だ。[l]\n如何なる嘘を吐くが良き":67,"倫か、\nその検討の材料になるだけだ。":68,"つまり、\n温存云々以前に、\n":69,"朋":70,"輩に対しては本来あまり向けたくないもんだし。":71,"「まあ、面倒に考えることもないか……」":72,"直接、かたりあうのが、[l]\nきっといいんだ。[l]\n人として生きるなら。":73,"それが彼か、俺かは、[l]\n成り行き次第だけどな。":74,"ともあれ、\n今から、まして助力たらんとしているならば、\nヒト並みであることがよきフィルターになるだろう。":75,"「どっちにしても、\nイキモノはたたかわねばならない、\nかならずどこかの局面で」":76,"我を通すべく尽力し立ち振る舞うのも、[l]\n無論在るべき姿の一つであるし、[l]\n相争うのがこのセカイのルールだとしても、[l]\nそれでも、[l]\n『全員』がそうやって開き直る必要はないんだからな。[l]\n疑問を持ちながら、[l]\n愉しみなど感じず出来れば避けたいと願いながら、[l]\n存在していたっていいだろうと俺は思う。":77,"そしてそういう我を通そうとする俺も、\n詰まるところは同じ。":78,"大義名分など関係はない。":79,"共存し得るか将又、\n先へ続くものは一つしか選ばれないのか。":80,"結局はそういうことだ。":81,"「人工物でさえも自然、世界の拒否しなかった存在、[l]\n不平等たる状況があり得るコトを含めてこそ完璧に平等な状態、[l]\n理不尽ですら存在するコトが完全、[l]\n節度自体にも節度を、[l]\n言う事を信じるなという言を信じるか信じないか、[l]\n不都合な事項が載っていない辞書は十全でないということか……」":82,"……よくわからんようになってきた。":83,"まあそんなことは置いといて、[l]\n向こうで逢えたならば、[l]\nこういった小理屈はともかくヒト並みの、[l]\n心遣いはするつもりだ。":84,"さて、[l]\nいーくんのこの無連絡状況は、\n吉兆なのか凶兆なのか。":85,"まさかもう片が付いてるってことは無いだろうが、\nどうやったって最後には、場合によっちゃそれ以前に、[l]\nあの店長とは、本人がサシで遣り合わなきゃならない。[l]\nいーくんの選択が":86,"Ｙｅ":87,"ｓだろうと":88,"Ｘだろうと、[l]\nそれはそうなんだ。":89,"いずれコトの前に余計な事をして本番に差し支えては意味がない。[l]\nなるたけ応戦しないよう心懸けるとしても──\n俺は俺で、その後、その次がある。":90,"「……お、動くか」":91,"独り思考に入り込んでる内に、\nどうやら":92,"現":93,"世でぁ事態が進行していたか。[l]\nただ、窓の外を視るに、\n矢張り着く頃には、":94,"「":95,"冥ぇよなあ、これはもう……」":96,"色んな意味で面倒な展開を、[l]\n色んな意味で覚悟せにゃならん、[l]てことか。":97},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_032.ks","relPath":"/data/scenario/SC_S_032.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":95,"length":98,"percent":96.93877551020408},"cacheResetOnChange":{},"cellInfo":[]},"/data/scenario/SC_S_033.ks":{"data":[["遅れた新幹線から列車乗り継ぎ終えて、\n玄ノ森駅に着いた頃にゃ結局、\nとうに銀行の窓口業務は終了している時間。","从延误的新干线换乘列车后，\n到达玄之森站时终究，\n早已过了银行柜台业务结束的时间。"],["まだ真っ暗でこそ無いが、\nちんたらしてたら速攻で闇に包まれるだろう。[l]\n何しろ、","虽说还没完全暗下来，\n但再磨蹭马上就会被黑暗吞噬吧。[l]\n毕竟，"],["「街灯も","「连路灯"],["疎ら、\n店もろくすっぽねーんだな……[l]\n駅前ですらこんなか……」","都稀稀拉拉，\n店铺也基本没开张……[l]\n站前都这副德性……」"],["向こうから来たばっかだから相対的な感覚だろうけど。","可能因为刚从大城市过来才有这种对比感。"],["「えと、確か中心街は寧ろ、\n駅前から離れた別の通りに、\nなるそうデス」","「呃，记得中心街区反而，\n是在离站前很远的另一条街，\n据说呢」"],["「成る程ね。[l]\nまー別に観光しに来た訳じゃないし、\nとっとと動きましょか」","「原来如此。[l]\n嘛反正也不是来观光的，\n赶紧行动吧」"],["と言っても……[l]\n足の確保はせにゃあ、\n闇雲に動いたって詮方ない。[l]\n迂闊にかれおんのあれを使うのは危険にすぎるし、\n俺自身をモロに出すのも厳しい。","话虽如此……[l]\n不先确保交通工具，\n乱跑也是白费力气。[l]\n贸然使用卡蕾欧的那个太危险，\n我自己完全暴露也很棘手。"],["あんだかな、\n予定通りに着いてさえいれば、\nおよそのアタリから何とか出来る時間もあっただろうが、","这下可好，\n要是按原计划到达的话，\n至少还有时间从大致范围想办法，"],["──ん、\nなんだ。[l]\n居るな。","——嗯，\n什么啊。[l]\n有人呢。"],["これは、","这是，"],["「……おや、[l]\n向こうさんの方からお出迎え……か？[l]\n気付かれてたんかな？」","「……哎呀，[l]\n对方主动来迎接……吗？[l]\n早就被发现了吗？」"],["「ハイ？[l]\n……っあおっ！」","「咦？[l]\n……哇哦！」"],["「おや。[l]\nこれは奇遇……いや、[l]\nそれ以前の問題でしょうか。[l]\n……いえ、正直、[l]\nどちらでもいいんですがね。[l]\n久しぶり、カレ」","「哎呀。[l]\n真是巧遇……不对，[l]\n应该说比那更严重的问题吧。[l]\n……不、老实说，[l]\n怎样都无所谓啦。[l]\n好久不见，卡蕾」"],["「あ、あわ、あの、す、す、」","「啊、啊哇、那个、对、对、」"],["「……どうも、お初にお眼にかかります。[l]\nこの","「……初次见面。[l]\n这个"],["女","性也说过、"],["性の彼氏やらしてもらってます、\n大神っていうモンですが」","性别的男朋友请多指教，\n我叫大神」"],["思ったより小さいな実物は。[l]\nというかコスプレかこれ。[l]\n中央とか大都市ならまだしも、\nちーっとばかし、浮いてないか。[l]\nそれともそのへんも防壁か何か張ってるのかな、\nよもや踏み絵的な意味合い……否、[l]\nそれぁ考えすぎだぁな。[l]\nそれに声が何というか、\nなんつーの？","实物比想象中娇小呢。[l]\n或者说这是cosplay吗。[l]\n在中央或者大城市倒也罢了，\n在这种小地方、会不会太显眼了点。[l]\n还是说这附近也张开了防壁什么的，\n该不会有什么试探的意味……不、[l]\n那也太想太多了。[l]\n而且声音该怎么说，\n叫什么来着？"],["所","的"],["謂声優くさいつーか？","该说很有声优范儿吗？"],["と、\n俺の印象批評……言葉合ってるかはさておき、[l]\nその心の内を知ってか知らずか\n眼前の女性、蒼白穿の遣い手にして、\nかれおんの直上らしき女性は、挨拶を返してきた。","如此\n我的印象批评……用词是否准确另当别论，[l]\n不知她是否察觉了这番心思\n眼前的女性——苍白穿刺的使用者、\n看似地位高于卡蕾欧的女子回应了问候。"],["「ああ、……アナタが。[l]\nこれはまた──いえ、\n申し訳ありません、挨拶が遅れました。[l]\n伺っております、\nどうぞ宜しく。[l]\n千野チノがワタシの名前です」","「啊啊……原来您就是。[l]\n这可真是——不、\n失礼了，没能及时问候。[l]\n久仰大名，\n请多关照。[l]\n我叫千野千乃」"],["「いえいえ、お気になさらずこちらこそ、\n話は聞いてますし、\nえー、その、\nそちらも色々御存知のようですし？[l]\n流石は、そっちの方はお強い──という事で宜しいか？」","「哪里哪里不必在意我才是，\n事情我都听说了，\n那个、就是、\n您这边似乎也知道不少情况？[l]\n不愧是、那边的人果然厉害——可以这么说吧？」"],["俺としては悪意も敵意も無いが、\n向こうも、今この瞬間そうだとは限らねー。[l]\n前情報やらその他諸々から総合的に、\n恐らくは問題無いだろうと判断してるのと、\nまあ結局は、\n隠しても無駄だからこうしてるだけで……ああ、[l]\nまあ、腹芸は使いまくってる訳だが、\n何にせよ意思は伝えねば話が進まない。[l]\nだから諸事情鑑みて、多少大胆にいかせてもらった。[l]\nかれおんは気が気でないようだけどな……[l]\nまーまー、俺だって無根拠じゃないんだよ、\n多分大丈夫って言ったろ。多分て。[l]\nそんなにびびんなって……って何か別の理由？","我虽没有恶意或敌意，\n但对方此刻未必如此。[l]\n综合事前情报和其他因素，\n判断应该没问题才这么做，\n说到底、\n反正隐瞒也没用才这样的……啊、[l]\n不过确实用了不少心计，\n总之不传达意图就无法推进。[l]\n所以综合考虑各种情况、请允许我稍微大胆些。[l]\n卡蕾欧好像很不安的样子……[l]\n好啦好啦、我也不是毫无根据的、\n不是说过大概没问题嘛。大概啦。[l]\n别那么紧张……还是说有其他原因？"],["「は、あわわ……あうあう」","「哈、啊哇哇……啊呜啊呜」"],["……まあいいや。","……算了。"],["「ああ、その点に関しましては申し訳ありませんが、\n買い被りですね」","「啊、关于这点很抱歉、\n您过誉了」"],["「？」",""],["「言うなれば今のこれは気分転換の類の結果です、\n宵の散策中だったのですよ、ワタシは。[l]\n最近調子が芳しくありませんでね、\n少しばかりリフレッシュしようと外を歩いておりました」","「要说的话现在这样是转换心情的结果，\n我正在夜游散步呢。[l]\n最近状态不太好，\n想稍微透透气才出来走走」"],["「はあ、それはまた、ど偉い確率で……」","「哈、那可真是、惊人的概率呢……」"],["……。[l]\nまあ、……そういうこったな。[l]\n上司殿も当然そこは認識してるだろうが、\nいーくんにせよ当事者にせよ、\n自覚の有無は関係ねーし、\nさっすが主人公、イベント起こすなあ。[l]\nバッドＥＤフラグイベじゃないことを祈るぜよ。","……。[l]\n嘛，……就是这么回事吧。[l]\n上司大人当然也意识到这点了吧，\n无论是饭君还是当事人，\n有没有自觉都无所谓，\n真不愧是主角，总能触发事件啊。[l]\n祈祷别是坏结局flag事件吧。"],["「カレ、何してるんです」","「卡蕾，你在干什么」"],["「へっ、\nあああ、あの、\nあっ、その、御調子の方が、」","「嘿，\n啊啊啊，那个，\n啊、这个、您身体情况，」"],["「ワタシは貴女を責めるつもりはありません。[l]\n視て分からないですか」","「我并没有责备您的意思。[l]\n看不出来吗」"],["「……だ、大丈夫なんですか……？」","「……真、真的不要紧吗……？」"],["「心配ありがとう。[l]\n問題はない……というよりも、[l]\nああ、どちらの件に対する心配ですかね？[l]\nまあどっちでもいいですがね。[l]\n少なくともワタシの方から、このことをあの方に進言する、\nつもりはありません」","「谢谢关心。[l]\n没有问题……或者说，[l]\n啊，您是指哪件事的担忧呢？[l]\n嘛反正都无所谓啦。[l]\n至少我不会主动向那位大人，\n提起这件事」"],["「……」",""],["俺の前でそれを言う？","当着我的面说这个？"],["あのゲーム大好き萌店長が、\nネタバレ嫌いだからって理由か？","因为那个超爱游戏的萌系店长，\n最讨厌剧透这个理由吗？"],["もしそういう事なら、\n俺もかれおんも一連の流れの渦中に、\n突発的事象因子……つまりは、[l]\nあれへの面白ネタとして組み込もうって事になるから、\nむっともしようが、","如果是这样的话，\n我和卡蕾欧也会被卷进事件漩涡，\n成为突发事态因子……也就是，[l]\n被当成那家伙的搞笑素材对吧，\n虽然也没办法，"],["まあしかし、どうやらそればっかでもないのか？[l]\n揺れている……感じがする。[l]\n何となく感じてはいたが、\nあれらの中枢よりは","不过看来也不全是这个原因？[l]\n感觉……在动摇。[l]\n虽然隐约察觉到了，\n比起那些核心成员"],["此","来"],["方寄りの心的構造のようだし、\nかれおんと似通ってる部分も、あ、順番逆か。[l]\nさっすがかれおんの上司、\n中枢上位の割りにはＤに近しい……否、[l]\n上位だからか？[l]\nま、いずれにしても、\n少なくとも問われるまでは黙っててくれるって事だわさ。","心理构造更偏向方阵营呢，\n和卡蕾欧相似的部分也...啊顺序反了。[l]\n真不愧是卡蕾欧的上司，\n作为核心高层却接近D级...不对，[l]\n正因为是高层吗？[l]\n嘛，总之，\n至少在被质问前会保持沉默对吧。"],["それとま、一応突っ込んどくか。","顺便再确认一下吧。"],["「何にしてもあまり驚いた感じじゃ、\nありませんね？[l]\nホントに偶然です？」","「不管怎样您看起来都不太惊讶，\n不是吗？[l]\n真的是偶然吗？」"],["「通常ならば、\n視た眼で判断すると足をすくわれますよと、\nお返しする所ですがね。[l]\nまあ──ご覧の通りの風体ですので。[l]\n正確に説明するならば、\n一瞬驚愕し、すぐさまある節に思い当たり、\nあとはそれに即した振る舞いをしているつもりでして、\n驚いたように視えぬのも然り、\n而してそう断言するには、\n……いえ、まあ、どっちでもいいんですがね。[l]\nいずれ今この邂逅の瞬間まで、\nアナタ達の事は一切合切、思いも寄りませんでした。[l]\nそれは本当ですよ。[l]\n何しろそこの不肖の部下には、\n……正確には弟子と言った方が表現的には近い、[l]\nああ、まあどちらでもいいです。[l]\nえー、なんでしたかね、\n──ですからね、\nばれていた訳ではありませんよ。[l]\nええ、この邂逅は、\n偶然……です、かね。[l]\n済みませんね、先にお話した通り、\n少々体調精神ともに状態が芳しくない──いえ、\n十全ではないようです。[l]\nしかと伝えられてないようでしても容赦を願えれば」","「通常来说，\n若用肉眼判断会被绊倒呢，\n本该如此回敬您的。[l]\n嘛──毕竟如您所见是这副模样。[l]\n若要准确说明的话，\n瞬间惊愕后立刻联想到某个关节，\n之后便打算据此采取行动，\n看不出惊讶也是理所当然，\n而要如此断言的话，\n……不，嘛，怎样都无所谓啦。[l]\n至少直到此刻相遇的瞬间前，\n对你们的事完全不曾料想到。[l]\n这是实话哦。[l]\n毕竟那边不成器的部下──\n……准确说称为弟子更贴切，[l]\n啊，嘛怎样都好。[l]\n呃─该怎么说呢，\n──所以说啊，\n并非被识破了哟。[l]\n是的，这场相遇，\n是偶然……吧。[l]\n很抱歉呢，正如先前所言，\n身心状态都稍欠佳──不，\n似乎算不上万全。[l]\n即便未能准确传达也望海涵」"],["「ああ、いえ、\nお察しします、問題ありません。[l]\nであれば、\nこのような立ち話長話、良いんですか？[l]\nあれでしたら──」","「啊、不、\n我明白的、没问题。[l]\n既然如此、\n像这样站着长谈、可以吗？[l]\n如果是那样的话──」"],["取り敢えずかれおんは最前から、\n俺の後ろに隠れるようにしているが、\nそれは俺がそういう位置取りをしたからで、\n今の彼女は単に、話に入って来れない不器用な女子なだけだ。[l]\nなるたけ二人が話さずに済むようにそうしてるから当たり前。[l]\nまあ、向こうさんもやっぱ気は遣ってくれてるらしいし、\n色んな意味でこの出会いは僥倖の気配がする。[l]\n思ってた以上に、","总之卡蕾欧从刚才开始、\n就一直躲在我身后、\n那是我故意让她站那个位置的、\n现在的她只是个笨拙到插不进话题的姑娘罢了。[l]\n为了尽量不让两人交谈才这么安排、理所当然。[l]\n嘛、看来对方也确实在顾虑着、\n从各种意义上来说这次相遇都带着幸运的气息。[l]\n比想象中、"],["遙かに話の通じる人だった。","要通情达理得多的人。"],["「ああ……そうですね」","「啊……是这样呢」"],["彼女は","她"],["一",""],["時視上げるような仕草をし、\n言った。","做出仰望时间的动作、\n说道。"],["「あるでしょうからね、此処で話すは色々障りが。[l]\n幾ら","「毕竟在这里说话会有各种妨碍吧。[l]\n就算"],["人","人"],["足が","脚"],["疎らとはいえ、\n……しかし、そちらもそう時間はないのでしょう。[l]\n何処かで落ち着くような真似をしても始まらないのでは？」","虽说稀稀落落的，\n……不过，你那边时间也不多了吧。[l]\n就算找个地方安顿下来也无济于事不是吗？」"],["「あー……[l]\nまあ、そうすね。[l]\nでは、\n単刀直入に一つだけ伺いたい事がありまして。[l]\n彼の行方、御存知ないですか」","「啊——……[l]\n嘛，确实呢。[l]\n那么，\n我就单刀直入地问一件事。[l]\n他的下落，您知道吗」"],["「！」",""],["まあ、或る程度は賭だが、\nやっぱこのひと『いいヒト』だぜ。[l]\nかれおん、もう少し信用してあげなって……[l]\n出来ない理由があるならしゃあないが、\nいずれにせよ、\n何とかなる、そういう雰囲気を視出した。[l]\n無論、最悪の場合は最終手段に出るしかないが、\n色んな意味で避けて通りたい方法だわな。","嘛，虽然某种程度上是在赌，\n不过这人果然是个『好家伙』啊。[l]\n卡蕾欧啊，再多信任他一点嘛……[l]\n如果有做不到的理由那也没办法，\n但无论如何，\n总觉得总会有办法的。[l]\n当然，最坏情况下只能采取最终手段，\n但无论从哪个角度看都是想尽量避免的方法啊。"],["「カレ？[l]\nああ、彼。[l]\n残念ながら今は放置してまして、\n然るべき時が来れば否応無しに探し出すのですが──\n大変心苦しいのですがね、\n現時点では把握していないのですよ。[l]\n祭の前日までは、\n考える時間を与えようとの上意がありまして。[l]\nああ、……後でカレにそう伝えてくれますか。[l]\n今はて、て……」","「卡蕾？[l]\n啊啊，她。[l]\n遗憾的是目前暂时搁置着，\n等到时机成熟自然会不由分说把她找出来——\n虽然非常过意不去，\n现阶段确实不清楚下落呢。[l]\n祭典前一天为止，\n上层的意思是给她留些考虑时间。[l]\n啊，……之后能帮我转告她这句话吗。[l]\n现在正、正在……」"],["「テンパって？」","「手忙脚乱？」"],["「ああ、ありがとうございます。[l]\nテンパってるようですのでね、\nまあ、内部事情なのでアナタは気にしなくて結構ですよ。[l]\nそうですね、\n逆に言えば上が動くには猶予が少なくとも、\n数日ある、\nと言うことですのでね、\nとはいってもアナタも今は地道に動くしかないでしょうから。[l]\n早めの起動を推奨します」","「啊啊，非常感谢。[l]\n看来确实有些慌乱，\n不过这是内部事务您不必在意。[l]\n是啊，\n反过来说高层行动前至少还有\n几天\n缓冲期，\n当然您现在也只能按部就班行动吧。[l]\n建议尽早启动」"],["「……おおあ」","「……呜哇」"],["「情けないことにワタシは申し上げた通り、\nやや本調子ではないようでして。[l]\nあまり余計な事象にかまける余裕が正直無いのです。[l]\nですから、\n色々、思う所もありますのでね、\nアナタさえ宜しければ、\n今は互いに不干渉、視て視ぬふりが肝要ですかね。[l]\n今のワタシの処理能力には少々厳しい懸案……懸案？[l]\nまあ、どうでもよろしい、\nともあれ、\n今回のような事象は元来制御出来るか出来ないのかという、」","「说来惭愧正如方才所言，\n我目前状态稍欠佳。[l]\n老实说没精力应付额外状况。[l]\n所以，\n各方面都有些想法，\n只要您不介意，\n现在互相保持距离装没看见比较妥当。[l]\n以我当前处理能力实在棘手的难题……难题？[l]\n嘛，怎样都好，\n总之，\n这类事件原本就存在能否控制的问题——」"],["「ええ、はあ」","「嗯嗯，哈啊」"],["──月の雫の？","——月之泪的？"],["「彼自身の問題に加え、\nただでさえ我々のトップは●●●ですのでね。[l]\nどうなるかはまるで保証出来兼ねますが」","「除了她自身问题外，\n毕竟我们的顶头上司本就是●●●。[l]\n完全无法预料会发展成怎样」"],["……どうやら思った以上にいける口じゃんな。","……看来比预想的更好说话嘛。"],["「……まあ、察してくださってありがたいことです。[l]\n……えー、もしや、以前──」","「……您能理解真是帮大忙了。[l]\n……呃，莫非以前——」"],["「『会う機会があったと思しき当時』、\n既にワタシは今の位置でしたが、\nprojectそのものに深く関与はしていませんがね。[l]\nしかしアナタの方も『あの四人』は既知、\n識っていたのではないですか。[l]\nまあ","「『疑似有过见面机会的那时候』，\n我虽已位居现职，\n但并未深入参与project本身。[l]\n不过您应该也知道『那四人』，\n早就认识了吧。[l]\n嘛"],["屹","屹"],["度、それと同程度ですよこちらもね。[l]\nいずれにせよ、\nこういったカタチで会うのは初めてでしょう」","程度而言彼此彼此。[l]\n无论如何，\n以这种形式见面还是头回吧」"],["「？？、？？？」",""],["「なるほどねぇ……[l]\nおっと、」","「原来如此……[l]\n哎呀，」"],["会社員は兎も角、\n部活で遅いらしい学生達の帰宅時間にあたりそうなのか、\n人の気配が濃密になり出した。","上班族姑且不论，\n恰逢社团活动晚归的学生们放学时段，\n周遭人声逐渐嘈杂起来。"],["「じゃあ、俺等、野暮用があるんで、\nこっちとしてもなるべく","「那我们先告辞了还有些俗务，\n这边也会尽量"],["干","避"],["渉はしないつもりですが、\n此処には──友人の力になりに来たもんですから。[l]\nその障碍になるようなモンとは、或る程度……ま、[l]\nチノさんは『関係ない』でしょうけどね？[l]\nあはははは」","免干涉，\n来这儿本就是为了帮朋友忙。[l]\n至于可能造成阻碍的存在，某种程度上……哎，[l]\n千乃小姐应该『无关』吧？[l]\n啊哈哈哈」"],["「……もっと早くに、そして深く知り合うべきでしたかね。[l]\nカレとももっと話すべきでした」","「……或许该更早些深入交往。[l]\n也该和她多聊聊的」"],["「いやぁ～……[l]\nま、これから幾らでも、\nいえ、\nあまり変な事をいうと彼女さんに誤解されますんでアレですけど。[l]\nま、仲良くやっていけますよ、\n今後とも」","「哎呀～……[l]\n嘛、今后还有的是机会，\n不、\n说太多怪话会被那位小姐误会所以还是算了。[l]\n嘛、总能友好相处的，\n今后也请多指教」"],["「……ああ、[l]\n車、レンタルするのでしょう。[l]\n案内しますよ。[l]\n今の時間だと応対を望めないかもしれませんが、\n場合によってはワタシが口利きしましょう。[l]\nこちらです。[l]\nカレ」","「……啊，[l]\n是要租车对吧。[l]\n我来带路。[l]\n这个时间可能没人接待，\n必要时我可以帮忙牵线。[l]\n这边请。[l]\n卡蕾」"],["「はぅっ、はい？！」","「哈呜，是？！」"],["「もっと落ち着きなさい。[l]\nしっかり彼氏さんのお役に立つように」","「再冷静些。[l]\n好好给男朋友帮忙」"],["返事を待たず、\nすーーーーっ……と、[l]\n滑るように歩き出すチノさん。[l]\n俺等はついて行く。","不等回应，\n咻————……地，[l]\n千乃小姐如滑行般迈步。[l]\n我们跟了上去。"],["歩きながら、彼女は独り言のように呟く。","走着走着，她自言自语般低喃。"],["全体への貢献と調和を望むことは、[l]\n　必ずしもシュの存続にとってプラスではない、[l]\n　両者が拮抗或いは行ったり来たり、[l]\n　生物はそのミに既に備えている恒常性をもってして、[l]\n　その場に留まる為に走り続ける、[l]\n　停滞は存在しないと同義、[l]\n　Asleep, with still hands……という訳にはいかない。[l]\n　手を取り合って……行けるのならばどんなに良かったか、[l]\n　しかしどうにもこのセカイは最悪の箱庭──","期望对整体做出贡献并保持和谐，[l]\n　未必对舒的存续有利，[l]\n　两者抗衡或来回拉锯，[l]\n　生物早已在其基因中具备的恒常性，[l]\n　为了停留在原地而不断奔跑，[l]\n　与停滞不存在同义，[l]\n　Asleep, with still hands……这样可不行。[l]\n　若能携手共进……该有多好，[l]\n　但无论如何这个世界都是最糟糕的箱庭──"],["「──なのでね、\nそうですね……[l]\nどちらかに振り切れさえしなければ、\n","「——所以说，\n是啊……[l]\n只要不彻底倒向某边，\n"],["啀み合おうが争う事になろうが、\nヴァリエーションとして両者が同時に在るのが、」","纵使相互撕咬争斗，\n作为变体让两者同时共存，」"],["「──健全な在り方なんでしょうよ。[l]\n俺もそう思います。[l]\nイヤな事ですがね。[l]\n","「——才是健全的存在方式吧。[l]\n我也这么认为。[l]\n虽然很讨厌就是了。[l]\n"],["チ","对"],["カ","捉"],["ラ","拉"],["な","千"],["き","咔"],["も","乃"],["のにとっては大変に厳しい","来说实在严苛"],["仕","的"],["様です。[l]\nいずれ言えそうなのは、\nヒトがどう思い考えようと、\n競争原理というものが……[l]\nライバルにせよ天敵にせよ、\nそうですね相争う事が、能力にしろ技術にしろ、\n存在者の在り方に進化……或いは変化を","局面。[l]\n迟早能说出口的是，\n无论人类如何思考，\n竞争原理这东西……[l]\n无论是竞争对手或天敌，\n没错相互争斗这件事，无论能力或技术，\n都为存在者的形态带来进化……或是改变"],["齎してきた、[l]\nという歴史的事実ですかね。[l]\n残念乍ら」","，[l]\n算是历史事实吧。[l]\n遗憾得很」"],["……一応、[l]\n長々レスポンスしてみたけど、\n我ながらそんな場合なんだろか。[l]\nかれおんは俺を挟んでこの人の反対側について歩いている。[l]\nちらと両方の様子を窺うが、\nチノさんの方は害意敵意の有無以前に、\n揺れている感もさることながら、\n心","……姑且，[l]\n长篇大论了一番，\n自己都觉得是不是场合不对。[l]\n卡蕾欧隔着我和这人走在相反侧。[l]\n偷瞄两人神情，\n千乃小姐别说敌意恶意，\n不仅心绪动摇明显，\n更"],["焉に在らず感も","有种神游天外"],["益","的"],["益──ああ、\n人のことは言えんのだが。","益──啊啊、\n虽然我也没资格说别人。"],["何にしろ、[l]\n会話を合わせてはみたものの結局何が、\n言いたいんだろかな？","总之、[l]\n虽然试着配合对话但到底想、\n表达什么呢？"],["と思って次の句を待ってたんだが、\n何故だか向こうさん黙ったまま、\n気まずい間が出来てしまったので、","正想着等待下一句话时、\n不知为何对方一直沉默、\n结果造成了尴尬的冷场、"],["合ってるかどうか分かりませんが、[l]\nと前置きして場繋ぎの会話を始めた。","虽然不确定是否合适、[l]\n还是以这句开场白开始了过渡性对话。"],["「結局、\n主体たる存在が二個以上あるからには、\nどんな形であれ、\n両者間に争いを含む","「说到底、\n既然存在两个以上的主体、\n无论以何种形式、\n两者之间必然会产生"],["関","关"],["わ","包"],["り","含"],["合","市"],["いが形成されるのは、\nまー必定でしょうよ。[l]\nそれにあれですね、\n抗体ってのは抗原なくしては作れないもんだし、\n無菌状態で生き抜くのでも無い限り、\n早めに免疫はつくらないとねえ、\nオトナになってからじゃ」","争斗的、\n嘛──这是必然的吧。[l]\n而且那个啊、\n抗体没有抗原就造不出来、\n除非能在无菌状态下生存、\n不早点建立免疫力的话、\n等到变成大人就」"],["遅い、というか、\n場合によっては致命的な結果になり得る。","太迟了，或者说、\n某些情况下可能导致致命后果。"],["事実病気じゃなかろうと、\n普段の生活における対人対物対事他諸々関係、\n若い頃に免疫力を培っておかないと、\nなまじオトナという立ち位置の所為でそのデメリットが倍加され、\n自他共に損害迷惑を被る。[l]\nそういう意味じゃ餓鬼ん時の学校なんてのは、\n学んだ学問的要素が事実役に立つとかではなくて、\n彼処での生活を余儀なくされること自体を含め、\n彼処で体験させられるそのものが、\n予防接種のようなもんなんだわな。[l]\nその後世間に独り放り出される前に、\n少しでも衝撃をマシにしてやろうという、\nありがたい心遣いだ。[l]\n逆に言えば、\n抗原たり得ない、緩い培地で培養された温室育ちがどうなるか、\n世間は分かってる筈なのに、\n過保護なのか自分達だけの利を求めた結果か、\n……そっから先はまあ言わぬが花じゃね。","实际上就算没生病、\n日常生活中对人处事等各种关系、\n年轻时若不培养免疫力、\n反而会因大人这个身份让弊端加倍、\n给自己和他人造成损失麻烦。[l]\n从这个意义来说小鬼时期的学校、\n与其说学到的知识真有用、\n不如说包括被迫在那里生活本身、\n在那里被迫体验的一切、\n都像是预防接种呢。[l]\n在被独自抛进社会之前、\n试图稍微减轻冲击的、\n这份用心实在可贵。[l]\n反过来说、\n在无法成为抗原的温和培养基里长大的温室花朵会怎样、\n世人应该心知肚明、\n究竟是过度保护还是只顾自身利益、\n……再往下说就煞风景了。」"],["などと思っていると、","正这么想着时、"],["「……テンテキが、要りますか。[l]\nどうあっても。[l]\nコウゲンあってのコウタイ、\nゼロからプラスは、マイナスよりも困難か──\nああ、いえ、なんでもありません」","「……需要、天敌吗。[l]\n无论如何都需要。[l]\n有抗原才有抗体、\n从零到正数比负数更困难──\n啊不，没什么」"],["やっと話出したと思ったら、\nまた独り言のような具合でよく判らん。","刚以为她终于要开口、\n结果又像自言自语般难以理解。"],["しかし、","然而，"],["一瞬、自嘲気味に嗤ったように……思えた。[l]\nマスクしてっから雰囲気だけど。[l]\nそして彼女は続ける。","一瞬间仿佛带着自嘲般笑了……似乎。[l]\n毕竟戴着口罩只能看氛围。[l]\n接着她继续说道："],["「とまれ──[l]\nいずれ疑問を感じているとは言っても、\n我等のトップたるあの方とも、\n袂を分かつつもりもありませんでね、\nただ、[l]\nもし●の所為ならば、[l]\nアナタ達を……いえ、」","「总之──[l]\n虽说确实心存疑问、\n但也没打算和那位、\n我们组织的首领分道扬镳、\n只是、[l]\n如果是●的缘故、[l]\n把你们……不、」"],["そこでげほっ、と咳き込む仕草をし、\n此方も言いましょう単刀直入に、と言った。","突然做出「咳哼」的呛咳动作、\n这边也直截了当地说。"],["「チズルが余計な事……いえ、[l]\n己を弁えない愚挙に出るよりは、\nアナタ達に盤上に乗って貰った方が、\n色々な面に於いて無難だと判断しています」","「小知多管闲事……不、[l]\n与其做出不自量力的蠢事，\n让你们登上棋盘，\n从各方面考量都更为稳妥」"],["「……？！」",""],["俺等二人が黙ってると、","见我们二人沉默，"],["ワタシが直で動くのはルートも結果も或る意味で、\n先が──","由我直接行动的话路线和结果某种意义上，\n未来──"],["そこまで言って、\n再度咳き込むチノさん。[l]\n体調が悪いというよりは、\n奥歯に物が挟まったような、\n言いづらいことなのか、\n単に思考→実際口にするの変換整理がついてないのか、\nいずれ伝えたい事とはあまり関係のない項だったようで、\nそれはどっちでも良いんですが、と続けた。","说到此处，\n千乃女士再次咳嗽起来。[l]\n与其说是身体不适，\n更像是如鲠在喉，\n难以启齿之事，\n单纯是思考→实际说出口的转换尚未理顺，\n似乎与真正想传达的内容关联不大，\n她继续道「这些都不重要」。"],["「そう言った打算も、あるのですよ。[l]\nワタシには。[l]\n疑問に思っていたようなので、\n過不足の程度はあれど説明を加えました。[l]\n軽蔑しますか？」","「这类算计，[l]\n我也是有的。[l]\n既然你们心存疑虑，\n虽详略不一还是作了说明。[l]\n要鄙视我吗？」"],["単刀直入というか、\n本題の件名だけずばっと言っては呉れたようだが、\n背景その他の説明を、\n少なくとも口にはしていない……してるんかな今ので？[l]\nまあ、\n全部ワかれというにはちっと、常人には厳しいだろうな。[l]\nそこはそれ、\n色々、\n察した上での口上だろーからな向こうさんも。[l]\nなので、\n俺も言葉を返す。","说是单刀直入，\n倒像是只把正题标题甩了出来，\n背景说明之类的，\n至少没明说……刚才那算说了吗？[l]\n不过，\n要普通人全盘理解未免强人所难。[l]\n对方那番说辞，\n想必也是\n经过深思熟虑的吧。[l]\n因此，\n我也回应道。"],["「単刀直入、結構だと思いますよ？[l]\nま、それとは別問題で、\n俺は兎も角、大事な部下を……なんつーんすかね、[l]\nそういう風に視れるんだとしたら、\nそれぁー俺の心証も害されますけどね。[l]\n今回のその件についちゃぁ要するに、\n俺に対する絶対的信頼と受け止めますよ」","「单刀直入，我觉得挺好？[l]\n当然这是两码事，\n我姑且不论，重要部下被……该怎么说呢，[l]\n若真被如此看待，\n可是会让我心寒的。[l]\n关于这次事件，\n我就当作是对我的绝对信任了」"],["「………まあ、[l]\n………、[l]\n……どっちでも、どうとでも取って頂いて結構ですが」","「………也罢，[l]\n………，[l]\n……随您怎么理解都行」"],["「まーなるたけ余計な事はしないつもりスけどね。[l]\nそれに、そっちの思惑はどうあれ俺は、\nこいつとあいつ、\n相手が誰であろうと絶対に害させませんよ。[l]\nそういう意味で、その信用は裏切らない──つもりです。[l]\n俺個人の意思としてはスけど」","「嘛～我尽量不多管闲事。[l]\n况且无论你们作何打算，\n这家伙和那家伙，\n我绝不会让任何人伤害他们。[l]\n在这个意义上，这份信用我不会辜负──我是这么想的。[l]\n至少出于我个人意志」"],["関わらせない、という選択肢込みでな。[l]\n向こうさん次第の部分もあるしのう。","包括「不让其卷入」这个选项。[l]\n也要看对方态度啊。"],["……てか、やっぱ戦闘状態有り得る事態か……[l]\nきついなあ。","……话说果然可能演变成战斗状态吗……[l]\n真头疼。"],["あー、そういえば、\nっつーかチズルって誰だっけな？","啊对了，\n说起来小知是谁来着？」"],["「………信頼、否、期待というのは、[l]\n暗に脅迫しているとも言えましょう。[l]\nかといって、\n無条件の信用をする程アナタを識っている訳でもないですし、\nですからこれは、\nあとは、\n………。[l]\n我等の上は予測の範疇や予定調和的な縛りを越えた突発的事象を、\n大変に好むという事もありますけれど、\nそこを敢えてワタシがどうこう手を講じるなどとは、\n大変に","「………信赖、不、期待这种东西，[l]\n也可视为变相威胁。[l]\n话虽如此，\n我也没有熟识到能无条件信任你的程度，\n所以这件事，\n剩下的，\n………。[l]\n虽然我们上层极其热衷于超出预测范畴、打破既定规则的突发事件，\n但若要我对此特意采取措施，\n实在是\n非常"],["烏","恬"],["滸がましいのですが、\n………、[l]\n………、[l]\nワタシの、判断は、\n………、[l]\nこちらのトップの為になる行為と断じました。[l]\n今、\nいろいろな、意味で」","虽然有点厚脸皮，\n………，[l]\n………，[l]\n我的，判断是，\n………，[l]\n认定这是有利于我方首领的行为。[l]\n现在，\n在各种，意义上」"],["覚悟は決めました、\nと小さく彼女は言った。","已经下定决心了，\n她轻声说道。"],["……ん～～、まあ、あれだな、","……嗯～～，嘛，就是那个啦，"],["「んなに深刻ならなくて済む──と思いますよ。[l]\n俺等は勿論、\nそちらさんの敵になりに来たのじゃないし、\nそれに多分、彼奴自身が、何とかします。[l]\nその、そちらのトップの件に関してもス。[l]\nま、俺はフォローに徹するという奴で……」","「我觉得不用搞得那么严重──[l]\n我们当然，\n不是来与你们为敌的，\n而且多半那家伙自己会想办法。[l]\n关于，你们首领的事也是。[l]\n嘛，我会专心做好支援工作……」"],["「……ええ……[l]\nああ、\nチズルにも……べきか、それとも……」","「……嗯……[l]\n啊，\n要不要也告诉小知……还是说……」"],["聞こえてるのかいないのか、\n独り言のように呟き、\nまた沈黙状態に突入したので、\n……ってか遠いな目的地までよぅ、[l]\nそれにチズルって誰だっけな？[l]\nってそれはさておき、\n間を持たすために俺が再度口を開く。[l]\nかれおんはもうだんまり決め込んじまってるし、\n早く着かないもんかしらん。","不知是否听见了，\n她像自言自语般嘀咕着，\n又陷入了沉默状态，\n……话说目的地还真远啊，[l]\n而且小知是谁来着？[l]\n总之先不管这个，\n为了打破沉默我再次开口。[l]\n卡蕾欧已经彻底保持沉默，\n能不能快点到啊。"],["「と言うわけで今回のめこぼしに関しましては、\n大変ありがたく謝辞を述べさせて頂き、\n不言実行をもってお返しできればと、\nそういう所存でおります所存で」","「关于这次的疏忽，\n请允许我致以诚挚的谢意，\n希望能以实际行动作为回报，\n就是这样想的」"],["「……あははははははははは」","「……啊哈哈哈哈哈哈"],["「……？[l]\n……？」",""],["初見の印象からは少し想像し難い、\n柔和且つ快活な声で、\n突然彼女が笑い出す。","与初见印象稍显不符的，\n柔和而爽朗的笑声中，\n她突然笑了起来。"],["俺の２度言いに受けたのか、\n他の理由故かは兎も角、\nやっぱこの人にしては珍しい反応だったんだろう、\n様子を確認するに若干引いてる感のあるかれおん。","不知是因为我重复了两次，\n还是其他什么原因，\n这对她来说应该算是罕见反应吧，\n观察发现卡蕾欧似乎有点被吓到。"],["ま、そこはそれだ、\n奇矯な叫び声出された訳でもなし、\n鬱々と仏頂面で居られるよりはいい。[l]\nああ……この人はマスクだからあれだけど。","嘛，不过这样也好，\n总比发出怪叫，\n或是板着脸生闷气强。[l]\n啊……不过这人戴着口罩就是了。"],["「まあ、\nいずれ貴女にはまた、\nきっちり挨拶に伺いますよ。[l]\n嫁の上司には色々そん後もお世話になるでしょうし──」","「总之，\n改日必定会，\n正式登门致意。[l]\n毕竟妻子的上司今后还要多关照──」"],["「……わかりました。[l]\nこれですっきりした、……ん？吹っ切れた？[l]\n……まあ、ええ。そんな、[l]\n──気がします。それと」","「……明白了。[l]\n这下清爽多了，……咦？释怀了？[l]\n……嘛，好的。那种，[l]\n──感觉。还有」"],["こちらも、\n末永いお付き合いを期待します──","我们这边也，\n期待长期合作──"],["「はい？はい？[l]\nハッ、\nよ、よめ……」","「诶？啥？[l]\n哈，\n妻、妻子……」"],["「ああ、言った舌の根の乾かぬうちに引き留めるが如き長話、\nすみませんでしたね。[l]\nさて、頃合い良く目的の場は、ああ、あれですね」","「啊，刚说完就又要开始长篇大论，\n真是抱歉呢。[l]\n正好目的地也快到了，啊，就是那里」"],["錯乱しそうになったかれおんの思考を断ち切るが如く、\n瞬時に場を仕切るチノさん。[l]\nま、かれおんには後でじっくり説明する要があるっつーか、\nこの人も含めて三者面談、\n色々相談も出来そうなんで、\n良かった良かった。","仿佛要切断即将陷入混乱的卡蕾欧的思绪般，\n千乃小姐瞬间掌控了场面。[l]\n嘛、关于卡蕾欧的事之后还得好好说明一下该怎么说呢、\n包括这位在内需要三方会谈、\n似乎也能商量各种事情、\n太好了太好了。"],["そっちの件はさておき、","那边的事暂且不论、"],["取り敢えず俺等の我を通しに行くという、\nこっちの件もどうにかしにゃならん。","总之我们要先去贯彻自己的主张、\n这边的事也得想办法解决才行。"],["世界の淘汰構造に則り、\n責を負う覚悟をもって臨まんとかや。","遵循世界的淘汰结构、\n怀着承担责任的觉悟去面对吧。"],["通らぬものは通らぬ。[l]\n通るものは通る。[l]\nが、\n通そうと動かぬ限りは、\n舞台にすら上がれない。[l]\n事を成さんとするならば、\n我を通さんとするならば。","行不通的就是行不通。[l]\n能通过的自然能通过。[l]\n但是、\n除非主动采取行动去推动、\n否则连舞台都登不上去。[l]\n若要成就事业、\n若要贯彻自我。"],["自分の方からは動かずに手をこまぬいたまま、\n諾々と在るだけで、\n闘わずして決着がつけられればどんなに楽で平和だろうか。","若只是袖手旁观毫不作为、\n唯唯诺诺地存在着、\n不战而决该是多么轻松和平啊。"],["しかし、\nコトバを遣うヒトですら、\n容易に不和の道を選択しうるように、\n組まれてあるこの基本構造下では、","然而、\n就连使用语言的人类、\n都能轻易选择不和之路、\n在这个既定的基本结构下、"],["Asleep, with still hands……という訳にはいかない。","Asleep, with still hands……是不可能的。"],["まあ詮方ないやな、\nセカイが俺等を止めるまでは動くさ。[l]\n俺等の選択が拒否されるまでは、\nセカイが俺等を止める選択をするまでは──","嘛反正也没办法啦、\n在世界阻止我们之前都会继续行动的。[l]\n直到我们的选择被拒绝为止、\n直到世界做出阻止我们的选择为止──"],["それも、\n察して貰えてることだろう。","这些、\n你也应该能察觉到吧。"],["「ではどうぞ。[l]\n不慮の場合に備え、\n手続きが済むまでは此処で待ちましょう」","「那么请便。[l]\n为防意外情况、\n在手续办完前请在此等候」"],["「あ、どうもっす。[l]\n……なーかれおんさん。[l]\nだからそんなに鯱張んなくていいんだって。[l]\n行こうぜほれ」","「啊、多谢。[l]\n……喂—卡蕾欧小姐。[l]\n所以说不用那么紧张啦。[l]\n来咱们走吧」"],["「はっあわわあわわ」","「啊哇哇哇哇」"],["こけつまろびつ俺についてくるかれおん。[l]\nチノさんは視ないフリをしてどこか遠くに顔を向けた。[l]\n俺もふと遠景に視軸を向けたが、\nもう結構暗いなあ……","跌跌撞撞跟着我走的卡蕾欧。[l]\n千乃小姐装作没看见把脸转向远处。[l]\n我也下意识望向远景、\n天色已经相当暗了呢……"],["何はともあれ、\n危惧は杞憂に終わりなんとか車はレンタルできた。","总之、\n担忧成了杞人忧天总算租到了车。"],["外で待っていたチノさんに礼を述べ、\n俺は既に店の係の人に案内されかけてたが、\nいよいよチノさんがかれおんを呼び止めた。[l]\n……まあ色々察して俺は店員さんについてくとしよう。","向在外等候的千乃小姐道谢后、\n我正要跟着店员进去时、\n千乃小姐终于叫住了卡蕾欧。[l]\n……嘛考虑到各种情况我还是跟着店员先进去吧。"],["「──それよりもカレ、\nもし何処かでアイかお嬢を視たら、\n教えなさい。[l]\n接触はしないで結構ですのでね。[l]\nただし、貴女のあれは控えた方がいいでしょう、\n特にフハイが全動した後は」","「──比起这个卡蕾、\n如果在哪里看到爱或大小姐、\n要告诉我。[l]\n不需要主动接触。[l]\n不过你那招最好也收起来、\n尤其是在腐坏全开之后」"],["「え、……と、つまり」","「诶、……那个、意思是」"],["「要するに、\nそこまでして検索の要は無い、という事です。[l]\n余程の事が無い限りは、\n常駐以下程度に抑えた方が無難でしょう。[l]\n検索すべきモノがそうそうあるとは、\n現段階では思えませんが、\n先の二人の様子が気に掛かるというのも、ありますしね。[l]\nあの方ならまだしも、\nお嬢を刺激するのは宜しくないでしょう。[l]\nそれと──」","「总而言之，\n意思是没必要做到那种程度的搜索。[l]\n除非发生相当严重的事态，\n控制在常驻以下程度比较稳妥吧。[l]\n现阶段并不认为，\n有那么多值得搜索的东西，\n不过也确实在意先前那两人的状况。[l]\n若是那位倒也罢了，\n刺激大小姐可不太妥当。[l]\n另外──」"],["「……はっ」","「……哈」"],["「……ＧＷに気をつけなさい。[l]\n野放しで此の地に居るようですから」","「……当心GW。[l]\n他似乎正在这片区域自由活动」"],["もし何かあれば、対応もやむなし──\n或いはその彼が守ってくれるでしょう。","若发生意外，采取应对措施也是不得已──\n或许那位会保护你吧。"],["この劇は、[l]\n今、急の段階に差し掛かっています。[l]\nあの日まであと","这场戏剧，[l]\n现在正进入紧要阶段。[l]\n距离那天"],["僅か、[l]\nアナタのもう一つは、triggerであり９。[l]\n此度の劇で、その両方に立ち会うも或る意味では当然だったかも、\n知れません。","仅剩，[l]\n你的另一个身份既是trigger也是9。[l]\n在这次戏剧中同时见证两者，\n或许也是某种必然。"],["ただ、","只是，"],["我々の一部が思っているような、\n蓋然、必然、\n物語としての結構性などというものは、\n『deus ex machina』には意の外、\nというよりも、\nだからこその『キカイジカケのカミ』ですよ。[l]\nそして司書長はそれの顕現を望んでいます。[l]\n","像我们部分成员所认为的那种，\n或然、必然、\n作为故事的结构性之类的东西，\n对『机械降神』而言实属意外，\n不如说，\n正因如此才是『机关装置之神』啊。[l]\n而司书长正期待着它的显现。[l]\n"],["努","务"],["々忘れることなきよう。","必铭记于心。"],["……では、","……那么，"],["久し振りに逢えて良かった。[l]\nワタシは所用ありますのでね、\nそろそろ戻ります。[l]\n彼に宜しく。[l]\nOmegaの瞳の祝福あれ──","久别重逢真是太好了。[l]\n我还有公务在身，\n这就告辞了。[l]\n代我向他问好。[l]\n愿Omega之瞳庇佑你──"],["「………」",""],["俺が戻ると、既にチノさんは居なかった。","等我回来时，千乃小姐已经离开了。"],["……ＧＷ？[l]\n……デウスエクスマキナ？","……GW？[l]\n……机械降神？"],["「まーいいか、\n早速行こうか、\n……腹減ってる？[l]\n出来れば奴をみっけてから、\n一緒に喰うのがベストだけんども」","「嘛算了，\n赶紧出发吧，\n……肚子饿了吗？[l]\n要是能先找到那家伙，\n一起吃饭就最理想了」"],["「へっ？[l]\nあ、いえ、大丈夫デス、あ、でもお手洗いだけ……」","「诶？[l]\n啊、不、不要紧的，啊、不过请让我去趟洗手间……」"],["「へいへい、\nじゃ、此処にいるから」","「好嘞好嘞，\n那我就在这儿等着」"],["取り敢えずは、\n海岸か。","总之先去\n海岸吧。"],["イーくんかどうかは兎も角、\n何か引っ掛かるあの、\n未だ識らずの何かがあるらしき、\nよくわからんが１３番目があるらしき、","不管是不是小伊，\n总觉得那里有什么\n尚未知晓的\n说不清道不明的第13号事物，"],["あの海岸、\n彼処に、\n多分。","那片海岸，\n就在\n那里。"],["……多分。","……大概。"]],"context":[["SC_S_033.ks/index/1/text"],["SC_S_033.ks/index/3/text"],["SC_S_033.ks/index/5/text"],["SC_S_033.ks/index/7/text"],["SC_S_033.ks/index/9/text"],["SC_S_033.ks/index/11/text"],["SC_S_033.ks/index/13/text"],["SC_S_033.ks/index/15/text"],["SC_S_033.ks/index/17/text"],["SC_S_033.ks/index/19/text"],["SC_S_033.ks/index/21/text"],["SC_S_033.ks/index/23/text"],["SC_S_033.ks/index/25/text"],["SC_S_033.ks/index/27/text"],["SC_S_033.ks/index/29/text"],["SC_S_033.ks/index/31/text"],["SC_S_033.ks/index/33/text"],["SC_S_033.ks/index/35/text"],["SC_S_033.ks/index/37/text"],["SC_S_033.ks/index/39/text"],["SC_S_033.ks/index/41/text"],["SC_S_033.ks/index/43/text"],["SC_S_033.ks/index/45/text"],["SC_S_033.ks/index/47/text"],["SC_S_033.ks/index/49/text"],["SC_S_033.ks/index/51/text"],["SC_S_033.ks/index/53/text"],["SC_S_033.ks/index/55/text"],["SC_S_033.ks/index/57/text"],["SC_S_033.ks/index/59/text"],["SC_S_033.ks/index/61/text"],["SC_S_033.ks/index/63/text"],["SC_S_033.ks/index/65/text"],["SC_S_033.ks/index/67/text"],["SC_S_033.ks/index/69/text"],["SC_S_033.ks/index/71/text"],["SC_S_033.ks/index/73/text"],["SC_S_033.ks/index/75/text","SC_S_033.ks/index/251/text"