tart":4734,"end":5018}],[{"start":5027,"end":5028}],[{"start":5037,"end":5072}],[{"start":5102,"end":5136}],[{"start":5167,"end":5386}],[{"start":5396,"end":5397}],[{"start":5406,"end":5415}],[{"start":5445,"end":5488}],[{"start":5519,"end":5609}],[{"start":5639,"end":5651}],[{"start":5682,"end":5923}],[{"start":5936,"end":5937}],[{"start":5946,"end":5952}],[{"start":5982,"end":6053}],[{"start":6084,"end":6468}],[{"start":6498,"end":6591}],[{"start":6622,"end":6783}],[{"start":6813,"end":6850}],[{"start":6881,"end":7196}],[{"start":7226,"end":7244}],[{"start":7298,"end":7559}],[{"start":7589,"end":7657}],[{"start":7688,"end":7712}],[{"start":7742,"end":7760}],[{"start":7791,"end":8164}],[{"start":8194,"end":8304}],[{"start":8370,"end":8486}],[{"start":8517,"end":8620}],[{"start":8650,"end":8677}],[{"start":8708,"end":8836}],[{"start":8866,"end":8898}],[{"start":8929,"end":9097}],[{"start":9110,"end":9194}],[{"start":9208,"end":9236}],[{"start":9266,"end":9271}],[{"start":9302,"end":9778}],[{"start":9808,"end":9846}],[{"start":9877,"end":10015}],[{"start":10025,"end":10029}],[{"start":10038,"end":10086}],[{"start":10116,"end":10131}],[{"start":10162,"end":10607}],[{"start":10637,"end":10649}],[{"start":10680,"end":10907}],[{"start":10937,"end":11002}],[{"start":11033,"end":11185}],[{"start":11215,"end":11324}],[{"start":11355,"end":11438}],[{"start":11468,"end":11498}],[{"start":11579,"end":11595}],[{"start":11626,"end":11649}],[{"start":11679,"end":11712}],[{"start":11743,"end":11760}],[{"start":11790,"end":11799}],[{"start":11879,"end":11889},{"start":12183,"end":12193}],[{"start":11921,"end":11939}],[{"start":12003,"end":12044}],[{"start":12076,"end":12126}],[{"start":12286,"end":12324}],[{"start":12354,"end":12386}],[{"start":12480,"end":12496}],[{"start":12526,"end":12538}],[{"start":12569,"end":12576}],[{"start":12606,"end":12632}],[{"start":12662,"end":12702}],[{"start":12733,"end":12742}],[{"start":12772,"end":12795}],[{"start":12825,"end":12864}],[{"start":12894,"end":12941}],[{"start":12971,"end":13019}],[{"start":13050,"end":13176}],[{"start":13206,"end":13234}],[{"start":13318,"end":13323}],[{"start":13353,"end":13396}],[{"start":13460,"end":13511}],[{"start":13541,"end":13548}],[{"start":13579,"end":13607}],[{"start":13637,"end":13646}],[{"start":13723,"end":13751}],[{"start":13781,"end":13839}],[{"start":13870,"end":13967}],[{"start":13997,"end":14030}],[{"start":14061,"end":14206}],[{"start":14236,"end":14320}],[{"start":14351,"end":14533}],[{"start":14563,"end":14572}],[{"start":14603,"end":14706}],[{"start":14736,"end":14785}],[{"start":14816,"end":14822}],[{"start":14953,"end":14974}],[{"start":14987,"end":14988}],[{"start":14997,"end":15001}],[{"start":15011,"end":15012}],[{"start":15021,"end":15027}],[{"start":15041,"end":15042}],[{"start":15052,"end":15166}],[{"start":15175,"end":15176}],[{"start":15186,"end":15214}],[{"start":15224,"end":15278}],[{"start":15288,"end":15326}],[{"start":15391,"end":15409}],[{"start":15419,"end":15539}],[{"start":15547,"end":15589}],[{"start":15595,"end":15771}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_049.ks","basename":"SC_E_049.ks","indexIds":{"「まだ……寝てるんですか？」":0,"「え？[l]\nえ、ええ、今はそうね。[l]\n食事は摂ってるようだけど、\nそれ以外の時は眠ってるわ」":1,"「あ……わない方が……」":2,"「そうね、まだそっとしておくべきでしょう。[l]\n何しろ大事が控えてるのよ。[l]\nもうあと一週間……ああ、[l]\n丁度いいわ、一週間前なら学校はもう休めるわね？[l]\n例の特例扱い、まだ通じるんでしょ？[l]\nあなたもそうしたら？[l]\nああ……それとも──」":3,"「え？[l]\nいえあ、私のことはいいんです、\nきーちゃを、お願いします……」":4,"「分かってるわ、心配しないで。[l]\nあなたとあの子だけの問題でもないし、\nこっちも大変なんだけど──\n……あ、そうそう、彼女から伝言、[l]\n預かってるわよ」":5,"「え？」":6,"「どこだったかしら……[l]\nああ、これね。[l]\n手紙……というかメモかしらね。[l]\n中身は視てないわ。[l]\nもし何か深刻な事とか、\n祭儀に関しての重大事だったら教えて。[l]\nま、そうだったらあなただけに伝えるなんて筈もないと思って、\nプライベートな用件と察して私も確認してないんだけど」":7,"「はあ、ありがとうございます……」":8,"「色々あるでしょうけど、あなたもしっかりするのよ。[l]\n今年は例年通りとはいかないから、\nいつにもまして不測の事態が懸念されるの。[l]\n事が事だけにみだりに口には出せないけど、\nみんな大変なのよ。[l]\nじゃ、何かあったら言いなさい。[l]\nじゃあね」":9,"「あの、……いえ、はい……」":10,"「なんぞ慌ただしいですなぁ。[l]\n卑尊ちゃんこそちゃんと休んだ方がええですよぅ、\nって、あら、もういってもうたわ。[l]\n克杖ちゃん、大丈夫？」":11,"「あ、ええ、そうだ、\n冬夏ちゃ……は」":12,"「万事順調ですよぅ。[l]\nまあ、……祭儀までは大人しくさせよう思ってますけど。[l]\n何しろおっきなことが控えてますからねぃ、\nせやから克杖ちゃんも無理せんとしっかり備えておいて……[l]\nあら」":13,"「………」":14,"「と、うかちゃ」":15,"「……あ、」":16,"「（ま、姫様ちゃんがちょーーっとばかし手荒に連れてきたから、\nまぁだ御機嫌斜めやってねぇ、\nあ、克杖ちゃんも姫様ちゃんも気にせんとって、\nお二人はねぇ、やるべきことをやっただけやし、\n冬夏ちゃんも身体ん方はもうええ筈やけど、\nまだ調子ようないんかも知れませんなぁ……[l]\nまああれです、後で私もとりなしますよって、\n多分冬夏ちゃんもすぐに許してくれますよぅ）」":17,"「ああ、こちらにいらした。[l]\n刀自殿、\nこちらの刀自殿がお呼びですが？」":18,"「あらまぁ、\nほんになんも出来ん子ぉやねぇあん":19,"娘は、[l]\nあ、今言うたんは秘密ですよぅ克杖ちゃん。[l]\nほなねぇ。[l]\n道具ちゃん今行きますよぅ」":20,"「どうせ瑣事でしょうがね、\nあの方にとっては何もかもが御手に余りなさるようで──\nま、刀自殿もご愁傷様です。[l]\nいってらっしゃいませ」":21,"「……」":22,"「ああ、キミも居たのか。[l]\n聞こえてたかい？[l]\nまああれだね、キミはそれこそ東部御付きだし、\nイヤという程知ってるだろうが、\nあの方も仰ってたろう、\n僕等がこんな事言ってたなんてね、\n秘密秘密、御内密に頼むよ」":23,"「そ、その……」":24,"「誰もが知っていても、\n詳らかにせぬ方がいい事もあるからね。[l]\n思慮分別もなく、\n愚直に事実を明け透けに叙述すれば良い訳じゃないだろう？[l]\n言うまでもないがね。[l]\nそうではないなどと声高に主張するのが居るのは、\n建前を隠れ蓑にする愚劣なのがいるからだ。[l]\n両者とも、\n手段と目的を取り違っている点に於いて全くの同類だがね。[l]\nコトバでつくるルールというのは本当に、」":25,"「あ、あの、」":26,"「ふむ、\n冬夏君はなぁ……イイ娘なんだがねぇ……[l]\nむ、キミの事もちゃあんと評価してるよ。[l]\n優等生には優等生の、\n跳ね返りには跳ね返りの──\nポジション自体もさることながら、\nそれぞれに必要とされる素養もある訳でね。[l]\n克杖君も冬夏君と同様に、\n各々しっかりよくやっていると思うよ。[l]\nなかなかどうして、\n僕は評価……こう言うと":27,"烏":28,"滸がましいか。[l]\nスキだよ、キミのようなイき方も」":29,"「あうあ、その、ちょっと、いいでしょうか……」":30,"「ふむ？」":31,"「無理……ですよね……」":32,"「む、\nその言葉少ないを察するに、\n姫様君……の、あの状態、[l]\nのことかな。[l]\nあの夜は非常に驚いたが──」":33,"「ええ、その、それで、\nきーちゃを……なんとか……治すっていうか、[l]\nそのために、」":34,"「ああ、ミコのアレか。[l]\nキミも察しているようだが、難しい、だろうねぇ。[l]\n今言ったあの夜の、\n冬夏君の治療というイレギュラーな事態が無くとも、\n特に今回は外せない大仕事が待ってるからね。[l]\nそれこそ特禁級でもなければ……[l]\nまあ、だから極めて不可能に近い、だろうな。[l]\nそもそもミコのアレが役に立つかな？[l]\nあれは……ああ、済まないね。[l]\nネガティヴな事を言って心配させるつもりではないのだよ。[l]\nただ、ミコのアレはどちらかというと●●を●●るもので、\n修●というよりは修●──なのかな。[l]\n本来的には":35,"其":36,"方も可能なのだろうが、\n我々のような":37,"一":38,"分では、\n……まあそれに、[l]\nそんなに心配する事もないと思うがね──」":39,"「そ…うでしょうか……[l]\n神蝕……されてませんか、きーちゃは？[l]\n私、その、言葉だけしか知らないし、\nでも、やっぱり様子がおかしくなったのは、」":40,"「ふむ、\nだが当初の施行直後は特に問題は無かったがなあ。[l]\n姉の資質を遙かに凌駕していた彼女だったのだし、\nそれともあの少年が来てから──とか？[l]\n僕が此方に来たタイミングとそう違わないのであれば、\nそれ以前の最近の彼女を知らない僕には判じようがないのだけれど」":41,"「……兄ぃ……が？……あ」":42,"「まあ、一応詳しく聞かせてくれるかね。[l]\nあぁ………いや、何でもないよ。[l]\nすまないね、続けてくれ」":43,"「はあ……ええと──」":44,"「……ふむ……[l]\nまあ、伝え聞くその状況の先触れ、\nのようにも思えるかも知れないな。[l]\nただ、情報として識っている『神蝕』は、\nもう少し激しい結果をもたらす筈だから──」":45,"「そっ、その、\nじゃあ、念のためなにか手だてを講じるとか、」":46,"「一応特禁級常駐に於いて、\nあの様な事態──『神蝕のような状態』だね、\nが、起きた場合に対処せんとした遣り方は考えてはあった、\nんだがね。[l]\n臨床試験をした訳ではない、あくまで机上の論理なのだよ。[l]\n空論とまでは言わないが、\nやはり実例を直接視知った上での……[l]\n……そのような知見に即した手段よりは劣る……のかな。[l]\nまあ、\n一応その対処法だが、\nそうだね、縷々変化している今回のような諸事情を考慮してみても、\n上申する価値はあるかなあ……[l]\nああ、":47,"僕":48,"等は十八二式（とうやにのしき）とヨんでいる。[l]\nただ──」":49,"「な、何か不安要素があるんですか？[l]\n副作用とか……？」":50,"「少々危険、と言うかなぁ……[l]\n安静にしてる分にはまあ問題は無いのだろうが、\n他者との不用意な接触は──\n当人はもとより周囲にね、影響が及び兼ねない、かな。[l]\nふむ、先程からどうも歯切れが悪くなってしまうな。[l]\nすっきりしない返答で申し訳ないのだが。[l]\n何しろ先刻言ったようにそっちはまだ実地検証してないからね。[l]\n無論、\n万事問題無く在るべく構築された":51,"様":52,"式ではあるけれど」":53,"「周囲に……って、[l]\n何か、その、\n感染するとか共鳴するとか……」":54,"「いや、もっと直接的物理的な話でね。[l]\n逆に言えば接触を避ければ……つまり、[l]\n隔離まではいかずとも軟禁しておけば、\nさしたる障害は起きないだろう」":55,"「え、ど、どういう……」":56,"「すまない、どうも分かりやすい説明が困難だ。[l]\n否、簡単な事なのだろうが、\n今は話し手たる僕の方に問題があってね、\n懸案事項を今山程抱えていて一つ事に集中し兼ねるのだよ。[l]\nそれは兎も角、まあ、そうだな、\n感情をうまく制御し難くなる、というか、\n優先順位が狂うというか──\nふむ、今此処で具体的に説明しても仕方ないか、\nまあ至極簡単に言えば、\n理性より先に本能が強まる、ように視えるだろうというのが、\n":57,"我":58,"々の見解だ」":59,"「考えるより手が先に出る……って事でしょうか……[l]\nあ、の、\nでも、そんな、もうそんな状態の兆候なら、\n出て……」":60,"「そうなのか？[l]\nああ、先刻の話だとそう……思えるかも知れないな。[l]\nただこちらが想定していたのは、\nあくまで主に効率的に敵──自己を害するものとたたかう面に関して、\nだったからで、\n通常の生活行動の範囲では……いやまて、[l]\nそれ以前の問題だなこれは。[l]\n今は十八二式を施してない状態なのだから、\nふむ、真逆自力……？[l]\n否、偶然か、\n──ああ、きっと疲れているのだと思うよ。[l]\n僕にも覚えがあるが、\n極度に眠かったり疲労している時には事の優先順位は変わるし、\n行為へのリミッターも緩むからね、\n遊女さんの訃からこっち、禁級続きは勿論、例の少年との接触やら、\nこないだの騒ぎやら、\n祭儀への緊張もあるかも知れないな」":61,"「冬夏ちゃへのあれも、そうなんでしょうか……？[l]\nきーちゃと冬夏ちゃ、仲が良いとは確かに言えませんけど、\n幾ら何でも行き過ぎ、です、\nそれにも何か関係が……」":62,"「あれは確かに驚いたが……[l]\nミコのチカラを信じているが故なのかな。[l]\nしかし確かに今回のタイミングでは賢明な手とは言えないな。[l]\n『うちの』刀自殿が、\n許可したのかも知れないがね。[l]\nキミも命じられて彼女を限解したのだろう。[l]\nそのとき聞いてないか？」":63,"「いえ、特になにも……[l]\nきーちゃが心配でそれどころじゃ……」":64,"「ふむ。[l]\nまあともあれ、キミがそれ程言うならば、\n僕の方から上申しておこう。[l]\nまあ先刻から言っているように、\n十八二式はやや戦闘に向き過ぎる様式だが、\n内面に向け自壊するよりはマシだろうな。[l]\nそれに現状では或る意味でタイミングは良いと言える、\n祭儀に向けて例の襲撃犯への防衛策ともなるからね。[l]\n上への通りも良いかもしれないな。[l]\nただ、\n──いずれその場凌ぎには違いないからね、\n本来ならば避けて済むに越したことはないのだろうが、\n何しろ今回はあのお方が居るからね、\n多少の無理は強いられるだろう」":65,"「はいっ、是非、お願いします……！」":66,"「どうあれ克杖君も暫く休んだ方が良いな。[l]\n残酷な言い方になるが、やはりキミに出来る事は今のところ無い。[l]\n任せておき給え、姫様君は僕等が何とかするよ。[l]\nそれは約束しよう。[l]\nまあ、気を紛らわしたければ、\n例の──彼と会って来るのもいいかもなあ。[l]\n彼は何というか、そういう空気を醸す人物だし、\nふふ愉しいからねぇあの少年は。[l]\n君等もこの短期間で急速に親密度を上げてるというか……[l]\n姫様君はなにかと御執心のようだし」":67,"「え？[l]\nあ、そういえば……言伝が、[l]\n………。[l]\n………？、！[l]\n………んい？？！！」":68,"「ふうん？[l]\n視ても構わないかね？」":69,"「へ？！[l]\nあっ、あっ」":70,"「無論内容は他言しないよ。[l]\n………。[l]\n………。[l]\n……ふむ、[l]\n不謹慎だが何気に卑猥ともとれる文面、\n妙に詩的でもあるし、何のコトだろうな。[l]\n伝言にしてはあまりに抽象的に過ぎるから、\n何かをして欲しい訳では無いのかも知れないね。[l]\nまあ今の彼女に具体的な何かを求めるのは酷かもだが……[l]\nいずれ、\nやはりあの少年に、\n何か思い入れがあるんではなかろうかね。[l]\nただ、克杖君込みで書いてあるのが気にはなるかなあ。[l]\n通常そういった事はそうそうないだろうからねぇ……[l]\nこの状況で敢えてそういった●らな事をわざわざキミに、\n──ん、それ以前に、\n克杖君には心当たりないのかね」":71,"「え゛、や、その、自分のに関してはその、\nないです……けど、[l]\nただその、\n最近はずっと様子がおかしかったから……[l]\nその流れかなぁ、とは、思えますけど、\nあああ、あのっ」":72,"「こういう事言うのってどうかと、\n分かってますけど、あの、\n………、[l]\n………、[l]\n………、きっ、[l]\nきーちゃがこんな風になるの、\nわかって、その、みんな、あの、えーと、」":73,"「……ふむ、[l]\nどうあれ言い訳になるだろうし、\nキミが僕等を責めたいのなら止めるつもりもないんだがね、\n………そうだな、[l]\n遊女さんに限らず、一相綾目の者は●を──」":74,"「……え？[l]\nき、聞こえませんでした……」":75,"「だから運君は或る意味ではしあわせなのだがな……[l]\n当人には未だ確執があるようだが──\nまあ、そうだな、\n僕が向こうに居る所為で──\n彼女の側に常駐出来ない状態で事を進めたのは、\n確かに不用意だったかも知れない」":76,"「え？[l]\nいえ、なんというか、そういうことでは……」":77,"「ただひとつだけ言わせて貰えれば、\n姫様君のあの強い親和性は、\n恐らくは途中からは自分の意思も相当量影響して、いる。[l]\nそうでなければ●すぎだ。[l]\n何しろ継いでから、特禁級常駐にしてからは尚更、\n日が浅いのだからね。[l]\nその点は計算外だった。[l]\n或いは……[l]\n":78,"若しかすると、彼女は彼女なりの、\n遊女さんへの孝行のつもりかも知れないなあ……[l]\nいずれ基本的な所で、\n彼女本人の素養が高いのは確かだし、\n":79,"運君はそう言う意味でも、ああ、在夜君はもしかすると──」":80,"「……？」":81,"「ふむ、まあそれはいいだろう。[l]\n姫様君の事は、\n親和性が高いが故の神蝕……の気配でもあるが、[l]\nその親和性の高いが故に未だしっかり自制出来ている、\nとも言える。[l]\n先刻も言った通り、\n伝え聞く『本来的な神蝕』であれば、\nとっくに●●でなくなっていてもおかしくはないのだからね。[l]\nだから後ろ向きとはいえ、\n安心は出来るのではないかね。[l]\nもとよりピーキーチューンではあるが、\n……ふむ、[l]\n姫様君は更に自己改変しているかも知れないな。[l]\nそれも上申が通ったら僕が確認してみよう。[l]\nだが何よりも、\nあの方々の意思が──横車を押させた事実だ。[l]\n彼女等におもねったつもりは無いが、\n否、だからこそ悪いのかも知れないな……[l]\n新たな段階への好奇心、\nそういったものが僕の中では優先された事は否めない。[l]\nそういう意味では君にも申し訳ないと思っている」":82,"「いっ、今から止める事は！[l]\nで、き……駄目なんでしょうか……」":83,"「心苦しいけれど僕も一介の構成員だからね。[l]\n意思決定に関わる事は何とも言える立場じゃないのだ、\n申し訳ないけれど。[l]\nただ、そうだな、\n少なくとも祭が終わるまでは……[l]\n先刻の話じゃないがそれこそ、\n何より上の方が":84,"赦しては":85,"呉れないだろう。[l]\n連日の騒ぎ、特に例の襲撃者の存在、\n君等の役割は重要だ」":86,"「……お、きて……ですか……」":87,"「我等が鉄の掟、\nあまり滅多なことは口にしないが賢明だ。[l]\n覚悟があるのなら──\n………、[l]\n………、[l]\n………。[l]\nキミには言うまでもないな。[l]\n克杖君は良き決断をすると信じているよ。[l]\n素晴らしきみらいの為にね。[l]\nま、先刻言った通り、\n姫様君の事に関しては上申するし、\n返答如何に関わらず僕等は全力を尽くすよ。[l]\nあの我等が頭領、此方の刀自殿がアテにならないのは分かるさ、\n何しろ大事にしていた御息女のバースデーも失念する位だからね。[l]\nそんなこんなを重々承知してる僕が言うのだ。[l]\n信頼すべきものは視誤らないよ。[l]\nだから、\n僕等に任せて欲しい。[l]\nそして安心してキミはキミのしたいことを、\n克杖君自身ですることだ。[l]\nその選択は大いに●●を●●●●てくれるだろう──」":88,"「……したい、こと……」":89,"「まあ、謝っておくが、\n今の僕は先程言ったように、\n他人に気を回せるような状況じゃない。[l]\n深刻に聞こえたかも知れないが僕のこの口跡の所為であって、\n格別今回の件が深刻という訳じゃないのだ。[l]\nいつだって何事に対しても僕はこういう語り口だからね。[l]\nまあ疲労の御陰で多少理性の制限が緩いのと脈絡が混乱している位だ。[l]\nだから、そう固くなりなさんな。[l]\n脱力し給え、脱力」":90,"「……お願いします、きーちゃのこと、[l]\n私に出来る事あったら何でも言ってください、\nじゃあ、あの、ちょっと私」":91,"「ふむ。[l]\nじゃあ君には、\n流れから言って彼の事を宜しく頼むとしようか。[l]\n連絡してみるといいだろう。[l]\n……場合によっては外泊でも構わないだろうよ。[l]\nその辺りの事情は察しているつもりだよ？[l]\n皆には言っておくから──\nん？」":92,"「その、仰ってる意味はよくわかりませんけど、\nあ、あのやっぱりどうしても、\n………、[l]\n………どうしても、[l]\nきーちゃに、\n会えませんか……？[l]\nせめて……」":93,"「ふむ──\nまあ顔を視る程度なら構わないだろう。[l]\nが、起こさないに越したことはないし、\nその配慮は頼むよ。[l]\nでは行こうか」":94,"「あ、はい、すみません、\nありがとうございます……」":95,"「……あら？どうしたの二人して」":96,"「ん、まあ、すぐに済むよ、\n少々……」":97,"「な、なによ……え？[l]\n（冬……のだってまだ完……）」":98,"「（……だから……はないし……）」":99,"「（………ぁ、）」":100,"「………♪、♪……」":101,"「（………………ぅ…ってる……？）」":102,"「克杖君、話はついたよ。[l]\nさ、ミコに怒られない内にさっさと済まそう」":103,"「何よ、私が悪者みたいに言わないでくれる。[l]\nあら、貴女もまだあまり歩き回らないで──」":104,"「ほら、\n向こうは向こうに任せておき給え。[l]\nこっちだ」":105,"「え、と、冬夏ちゃ……？[l]\nあ、すみません、今……」":106,"「……熱……は、ないな……ふむ」":107,"「……きーちゃ……、っ」":108,"「………む？」":109,"「……くるから……かならず……あの……とさんも……」":110,"「……え？[l]\nなに？[l]\nと、あの、何か言ってます……っ」":111,"「しっ、騒がずに」":112,"「……ふすぅーー……すぅ………しゅうぅ………」":113,"「ま、ことさん？[l]\n真言さん？[l]\nあ、兄ぃがどう──」":114,"「……あのひと………わなきゃ……かつえも………ねが……[l]\n……うかさん……が……」":115,"「な、なに………？[l]\nわ、わかんない…よぅ…[l]\nきーちゃ、きーちゃぁ、」":116,"「……寝言だよ。[l]\n僕等の気配で少しばかり覚醒してしまったのかな。[l]\n君に対して明確な意図で話しかけているのではないようだ。[l]\n……さ、[l]\n満足したかね？[l]\nこのまま眼を覚まさないうちに──」":117,"「……っひぅ？？！！[l]\nきっ、きーちゃ！？」":118,"「……！」":119,"「………い、痛い、え？[l]\n起きたの？[l]\nきーちゃ？きーちゃ！」":120,"「いかんな、やはり今は刺激しない方が良いだろう。[l]\nまずは部屋から出ようか、\nさ」":121,"「え、でも、」":122,"「お互いの為だ。[l]\nワカルだろう。ほら──」":123,"「きーちゃぁ……」":124,"「……克杖君、血が出てるか？[l]\n大丈夫か？」":125,"「きーちゃ……、[l]\n………、[l]\n………、[l]\n……あ、私は大丈夫、です、けど……」":126,"「やはりそっとしておいた方が良いな。[l]\n治療……処置は抜かりなくしておくよ。[l]\n心配は要らない。[l]\n先刻も言った通りだが、\nキミは寧ろこの状況では、」":127,"「わ、かってます、はい、\n……何かあったら連絡、ください」":128,"「キミの方もね。[l]\n言ったように他の人等には僕から言っておく、\n祭儀に支障が出ない程度には、\n休んだり、或いは落ち着く為に色々するのも良かろう。[l]\n姫様君からのその言伝に思案を巡らすやら、\nそうそう、先刻も言ったが例の少年に会って来るもよし」":129,"「あ、そ……いえば……、[l]\nはっ？[l]\nあ、はい、えー、はぁ、\nと、とにかくほんとに、よろしくお願いします、\nきーちゃのこと……」":130,"「その腕本当に大丈夫かい？[l]\n無理はしなさんなよ。[l]\n……そうか、[l]\nふむ。[l]\nまあキミは取り敢えず、\nもう少し我を通そうと思ってみても良いんではないかな。[l]\nああいや、\n深い意味はないのだが。[l]\n何しろ今回のは大事（たいじ）だからね。[l]\n諸々万全にしておき給え」":131,"「……はぁ……？」":132,"「ふふ、軽ぅく受け流して頂ければ結構。[l]\nキミの家の方も、頭領様がフォローしてる筈だからね。[l]\n御母堂の事は気に掛けずとも大丈夫だ。[l]\nでは行ってくると良い。気をつけて」":133,"「…………………はい。[l]\nほんとに、よろしくお願いします、いろいろ、\nではっ」":134,"「了解了解」":135,"「……想像以上にめまぐるしいなあ。[l]\n":136,"支":137,"流なのか":138,"本":139,"流なのか、\n":140,"将":141,"又全き別の流れなのか、\nどのみちをセンしようと、行き着く先は、\n……同じ夜かそれとも己次第か。[l]\nえらぶそのすじ、\n吉と出るか凶と出るか、\n彼女も彼も、彼女も彼女も──\nさても":142,"此":143,"度の劇は因果な事であることよ。[l]\nイキモノの":144,"性のひとつとして、\nそは享受せし表裏一体陰と陽、苦痛と快楽か。[l]\nモラル・ジレンマ、どの":145,"倫を選ぶのか。[l]\nどのようなケシキがミライにたちあらわれるのか」":146,"それにしても流石は雫、\n話に":147,"違わぬなんて●●しい存在。[l]\n嗚呼面白きかな、愉しきかな。[l]\nこころより感謝するよ、\nほんとうに、\n此度の邂逅は僕にとって此の上無い僥倖だった。[l]\n今はシュシを●●●だけの●●だとしても、":148,"そのタネはしっかと蒔いておいて貰えれば、\n必ずや素晴らしいミをなす事だろう。":149,"そのシュウカクにまで責を負うかどうかは……ま、当人次第だな。[l]\nまあ、僕としても精一杯のフォローはさせて貰うつもりだよ。[l]\n今は精精愉しんでおくが良い。[l]\n快楽に身を委ねるも後ろめたからぬ意味がある。[l]\nさて、僕は僕で、決められた仕事をせねばだ。[l]\nまずは眼前のフラグから立てるとしようか──":150},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_049.ks","relPath":"/data/scenario/SC_E_049.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":145,"length":151,"percent":96.02649006622516},"cacheResetOnChange":{},"cellInfo":[]},"/data/scenario/SC_E_050.ks":{"data":[["寓話（fable）を話そう。","来讲个寓言（fable）吧。"],["事実史実を語る訳ではないからそう心得ておくこと。","并非讲述史实事实，还望谨记。」"],["あるころ、\nひとびとは食事をするのに道具を使うことはなかった。[l]\n手掴み、かぶりつき、\n身体そのものを使っていた。","在某个时代，\n人们吃饭时并不使用道具。[l]\n用手抓、用嘴啃、\n直接用身体进食。"],["あるときフォークとナイフをつかうもの、\nスプーンをつかうもの、\n箸をつかうもの、\n要するに食器をつかうようになった。[l]\n楽で効率的な食事の仕方というものが考え出された。","后来出现了使用刀叉的人、\n使用勺子的人、\n使用筷子的人、\n总之开始使用餐具了。[l]\n人们发明了轻松高效的进食方式。"],["それぞれは、\nその食材や料理法に適した、\n言わば必要に迫られて発生したものでね、\nどれか一つが席巻するということはなかった。[l]\n固形物はまあ、どれでも扱えるかもしれないけどね、\nスープを箸では食せない……まあ、[l]\n少なくとも至難の業だし、\n","这些餐具、\n都是根据食材和烹饪方式、\n说白了就是被需求逼出来的产物、\n倒也没有哪种能一统天下。[l]\n固体食物嘛，用哪种大概都行、\n但筷子可喝不了汤……呃、[l]\n至少是超高难度、\n"],["ス","既"],["プ","然"],["ー",""],["ン、","有"],["匙というものがあるのに、\nわざわざ","汤匙这种东西、\n谁会特"],["フ","意"],["ォ","用"],["クや","刀叉或"],["箸で汁物は食べたくはないだろう。","筷子去喝汤啊。"],["ところがね、\nあるとき、\n……例えばの話だよ。[l]\n先割れスプーンというものが大流行したと思ってくれ。[l]\n他の食器はそれより劣る、という風潮が","可是呢、\n某天开始、\n……打个比方啦。[l]\n假设分叉勺突然爆火。[l]\n其他餐具都不如它好的风气"],["蔓","蔓"],["延った。[l]\nんむ、……先割れスプーンだと、[l]\n複数の食器の役を兼ねているという実際の利点があるから、\nちょっと喩えとして相応しくないか。[l]\nまあ、箸にしようか。[l]\n箸が大流行して、他の食器が作られなくなった、或いは評価が下げられて、\nつくる側もあまり数をつくってくれないという状況になった、と思ってくれればいい。[l]\nこうなると食の方もだね、\n箸で食べやすい物しか、料理店も出してくれなくなるね？[l]\nスープやカレーが食べたくても、\n世の中には、\n流行っているという理由で丼物、麺類の店しかなくなった。[l]\n市場の選択肢は狭まり、おかしなフィードバックを続けるが、\nまあ、経営するものというのはお金が稼げなければならないのだよ、\nだからね、\nまあ、いずれ『箸は古い』という風評が世間に広まるまでは、\n或いは自分達でそういう風に情報操作をするまで──\n実際にはそうそう出来るコトではないが、した、出来たと思い込むまで──\n我も我もと、\n……まあね、そういうものだ。[l]\n抗うのは中々に勇気が要るし、正しき選択をするというよりは、\n覚悟や美意識の問題であって、責任というものもしっかり付随するからね。[l]\n何でもかでも意思を貫くことが尊きコトではないよ。[l]\n闇雲であってはいけない。","延开来。[l]\n嗯……不过分叉勺确实、[l]\n兼具多种餐具功能这点很实用、\n当例子可能不太合适？[l]\n那就换成筷子吧。[l]\n假设筷子突然爆火，其他餐具停产或遭贬低、\n厂商也不愿多生产的情况出现了。[l]\n这样一来饮食界也、\n餐馆只会提供适合筷子吃的菜了对吧？[l]\n就算想喝汤吃咖喱、\n世上也只剩\n盖饭和面馆这种当红店铺了。[l]\n市场选择越来越窄，形成诡异循环、\n毕竟经营者总要赚钱嘛、\n所以呢、\n直到『筷子过时了』的传闻扩散之前、\n或者他们自己操控舆论之前——\n虽然实际很难做到，但只要自以为做到了——\n大家就会争相效仿、\n……唉，世道如此。[l]\n反抗需要莫大勇气，这无关正确选择、\n而是觉悟与审美的问题，还要背负相应责任。[l]\n并非所有坚持都值得歌颂。[l]\n不能盲目固执。"],["おっと、\n今は別のお話だ。","啊呀、\n这又是另一个话题了。"],["そのうちにね、\nみんなが箸だけをつくるものだから、\n如何に余所と違った箸をつくるか、という風潮が広がる訳だ。","久而久之、\n既然全民都造筷子、\n自然就流行起制造特色筷子了。"],["例えば、\n軽くて携帯性に優れているとか、\nデザインが人間工学的に良いとか、\n根付け細工のように、持ち手の先端部が精巧に彫刻されているもの、\n色やら造形が派手で美しいとか、\nまあ、そういった進化……否、変化かな……[l]\nつまり他との区別が必要になるな。","比如说、\n重量轻且便于携带啊、\n设计符合人体工学啊、\n就像根付工艺品那样，握柄顶端雕刻得极为精巧、\n色彩造型华丽美观啊、\n总之这类进化……不，应该算变化吧……[l]\n总之必须和其他产品有所区别。"],["それでも、箸は箸だ。[l]\n食材をつまむものなんだ。[l]\nそれが道具としての本質だろう？[l]\n手を汚すことなく、\n食べ物を挟み、\n摘み、\n口に運ぶ為のモノなんだよ、箸は。","即便如此，筷子终究是筷子。[l]\n本质是用来夹取食物的工具。[l]\n这才是作为道具的本质对吧？[l]\n为了避免弄脏手、\n用来夹住食物、\n拈取、\n送入口中的东西，这就是筷子。"],["ところが、だ。","然而问题来了。"],["あるとき、\n先の例で言えば、\n箸の彫刻細工、色、デザインに、\n重き価値をみいだしてしまうものがあらわれる。","某天开始、\n用刚才的例子来说、\n出现了特别重视筷子雕刻工艺、色彩和设计的群体。\n他们从中发现了重要价值。"],["すると、\nつくる側にも、そこのみを重視して箸をつくり出す者がでてくるね。[l]\nまあ、箸として最低限の機能を持たせてあるなら、\nそれは単なる付随価値として、\n余所との差別化として許容範囲ではあるだろう。[l]\nしかし、\nある者は、\n造形し易いという理由で、\nそして造形美に傾向した箸が売れるという理由で、\n紙粘土で箸をつくり出したのだ。","于是、\n制造商中也出现了专攻这些方面来制作筷子的人。[l]\n只要保证筷子具备基本功能、\n把这些附加价值当作、\n与其他产品的差异化卖点，倒也在容许范围内。[l]\n可是、\n有人、\n以方便造型为由、\n更因为造型美观的筷子好卖、\n竟用纸黏土制作起筷子。"],["木彫りであるならまだしも、\nそれでは、\nまあ、説明は要らないね？","若是木雕倒也罢了、\n这种材质、\n应该不需要解释了吧？"],["そして普通ならば、そんなものは淘汰されていく筈なんだが、\n何故かつかう側、この場合は買う側かな、そちらに、\n同調するものが多くあらわれる、ことがある。","照理说这种东西本该被淘汰、\n但不知为何使用者——这里该说是购买者吧、\n竟出现了大量跟风者。"],["紙粘土であれ造形彫刻が美しくなければ、\n箸ではないとまで、言い切る者すらあらわれる。","甚至有人宣称、\n若纸黏土筷子的造型雕刻不够精美、"],["流石に、こればかりは流行といっても、\n道具の本質からは完全に外れている。[l]\n紙粘土の箸は、まあ、多少しっかりした固形物は摘めたろうが、\n麺類や汁気の多い食事には到底耐えられない。[l]\n試したことはないけど、\nラッカー塗ったとしても無理だろうなあ……[l]\n耐久性は勿論のこと、何より心情的に結構きつくないかい？[l]\n単なる鑑賞物なら良かったんだろうがね。[l]\n売れる食器がほぼ箸しかないセカイで、\n全てのひとが箸に観賞性のみを求めることなんかある訳もない。[l]\nああ、くどいようだけど、例え話だからね。","就算打着流行的旗号、\n也完全背离了道具的本质。[l]\n纸黏土筷子嘛，勉强能夹起些结实固体、\n但面对汤面类食物根本无能为力。[l]\n虽然没实际试过、\n就算刷上漆也撑不住吧……[l]\n耐用性先不说，心理上就挺难受的不是吗？[l]\n要是纯粹当观赏品倒还说得过去。[l]\n在餐具市场几乎被筷子垄断的世界里、\n怎么可能所有人都只追求筷子的观赏性。[l]\n啊，虽然啰嗦但重申这只是比喻。"],["ともあれ、このままでは、\n生命の本質たる食事がままならないという事態に陥った。[l]\n箸が古い廃れたもの、という風評のシフトよりも遙かに速く、\n箸自体が使えなくなっていった。","总之事态发展到、\n连维系生命的日常饮食都难以维持的地步。[l]\n比起'筷子过时'的风评转向、\n筷子本身更快地失去了使用价值。"],["そして、\nつくり手がもう、機能を果たさない箸しかつくってくれなくなっていたから、\nみんな、箸を使うことはなくなった。[l]\n洗練の遅れは否めなくとも、別の食器を大急ぎで生産しだした。[l]\n食事処も、箸を不要とする食事を売り出し始めるし、\n食べる側も言うに及ばず。[l]\n皆が、色んな局面において衰微し始めた。","由于、\n制造商已不再生产具备实用功能的筷子、\n人们彻底放弃了使用筷子。[l]\n尽管工艺粗糙，还是紧急转产其他餐具。[l]\n餐馆也开始供应无需筷子的餐食、\n食客们自然紧随其后。[l]\n各方各面都开始全面衰退。"],["しかし、そこで、だ。[l]\nひとつとびに、\n食器というもの自体がいかん、と宣う者があらわれてね。","但就在这时、[l]\n突然冒出、\n宣称餐具本身就有问题的家伙。"],["いうなれば、\n●った原点回帰。[l]\nこれは、状況を打開する冴えた道、と、言えるのかなあ、\nんむー、\n衰退した食器業界に貢献をするとは言い難いのは確かだね。[l]\nつまり、その者が言うには、\n","说白了，\n●的原点回归。[l]\n这或许称得上是打破现状的明智之路吧，\n嗯唔——\n确实很难说这对衰退的餐具行业有什么贡献。[l]\n简而言之，那人的主张是\n"],["素手で食事をすべし、と。","应当徒手进食。"],["どうおもう？","你觉得呢？"],["ああ、正否という秤にかける必要はないし出来ないよ。[l]\nただ、キミがどうおもうかだ。[l]\nまあ、キミなら……","啊，没必要也无法用是非的天平来衡量。[l]\n只取决于你怎么想。[l]\n不过如果是你的话……"]],"context":[["SC_E_050.ks/index/1/text"],["SC_E_050.ks/index/3/text"],["SC_E_050.ks/index/5/text"],["SC_E_050.ks/index/7/text"],["SC_E_050.ks/index/9/text"],["SC_E_050.ks/index/12/text"],["SC_E_050.ks/index/14/text"],["SC_E_050.ks/index/16/text","SC_E_050.ks/index/26/text"],["SC_E_050.ks/index/18/text"],["SC_E_050.ks/index/20/text"],["SC_E_050.ks/index/22/text"],["SC_E_050.ks/index/24/text"],["SC_E_050.ks/index/28/text"],["SC_E_050.ks/index/30/text"],["SC_E_050.ks/index/32/text"],["SC_E_050.ks/index/34/text"],["SC_E_050.ks/index/36/text"],["SC_E_050.ks/index/38/text"],["SC_E_050.ks/index/40/text"],["SC_E_050.ks/index/42/text"],["SC_E_050.ks/index/44/text"],["SC_E_050.ks/index/46/text"],["SC_E_050.ks/index/48/text"],["SC_E_050.ks/index/50/text"],["SC_E_050.ks/index/52/text"],["SC_E_050.ks/index/54/text"],["SC_E_050.ks/index/56/text"],["SC_E_050.ks/index/58/text"],["SC_E_050.ks/index/60/text"],["SC_E_050.ks/index/62/text"],["SC_E_050.ks/index/64/text"],["SC_E_050.ks/index/66/text"],["SC_E_050.ks/index/69/text"],["SC_E_050.ks/index/71/text"],["SC_E_050.ks/index/73/text"]],"tags":[],"parameters":[[{"start":137,"end":151}],[{"start":157,"end":181}],[{"start":187,"end":258}],[{"start":264,"end":366}],[{"start":372,"end":520}],[{"start":534,"end":535}],[{"start":544,"end":545}],[{"start":554,"end":555},{"start":626,"end":627}],[{"start":564,"end":566}],[{"start":576,"end":597}],[{"start":606,"end":607}],[{"start":616,"end":617}],[{"start":636,"end":638}],[{"start":651,"end":667}],[{"start":673,"end":763}],[{"start":773,"end":774}],[{"start":783,"end":1429}],[{"start":1435,"end":1452}],[{"start":1458,"end":1520}],[{"start":1526,"end":1676}],[{"start":1682,"end":1793}],[{"start":1799,"end":1806}],[{"start":1812,"end":1877}],[{"start":1883,"end":2087}],[{"start":2093,"end":2133}],[{"start":2139,"end":2222}],[{"start":2228,"end":2274}],[{"start":2280,"end":2577}],[{"start":2583,"end":2682}],[{"start":2688,"end":2867}],[{"start":2873,"end":2929}],[{"start":2935,"end":3051}],[{"start":3061,"end":3073}],[{"start":3091,"end":3097}],[{"start":3115,"end":3179}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_050.ks","basename":"SC_E_050.ks","indexIds":{"寓話（fable）を話そう。":0,"事実史実を語る訳ではないからそう心得ておくこと。":1,"あるころ、\nひとびとは食事をするのに道具を使うことはなかった。[l]\n手掴み、かぶりつき、\n身体そのものを使っていた。":2,"あるときフォークとナイフをつかうもの、\nスプーンをつかうもの、\n箸をつかうもの、\n要するに食器をつかうようになった。[l]\n楽で効率的な食事の仕方というものが考え出された。":3,"それぞれは、\nその食材や料理法に適した、\n言わば必要に迫られて発生したものでね、\nどれか一つが席巻するということはなかった。[l]\n固形物はまあ、どれでも扱えるかもしれないけどね、\nスープを箸では食せない……まあ、[l]\n少なくとも至難の業だし、\n":4,"ス":5,"プ":6,"ー":7,"ン、":8,"匙というものがあるのに、\nわざわざ":9,"フ":10,"ォ":11,"クや":12,"箸で汁物は食べたくはないだろう。":13,"ところがね、\nあるとき、\n……例えばの話だよ。[l]\n先割れスプーンというものが大流行したと思ってくれ。[l]\n他の食器はそれより劣る、という風潮が":14,"蔓":15,"延った。[l]\nんむ、……先割れスプーンだと、[l]\n複数の食器の役を兼ねているという実際の利点があるから、\nちょっと喩えとして相応しくないか。[l]\nまあ、箸にしようか。[l]\n箸が大流行して、他の食器が作られなくなった、或いは評価が下げられて、\nつくる側もあまり数をつくってくれないという状況になった、と思ってくれればいい。[l]\nこうなると食の方もだね、\n箸で食べやすい物しか、料理店も出してくれなくなるね？[l]\nスープやカレーが食べたくても、\n世の中には、\n流行っているという理由で丼物、麺類の店しかなくなった。[l]\n市場の選択肢は狭まり、おかしなフィードバックを続けるが、\nまあ、経営するものというのはお金が稼げなければならないのだよ、\nだからね、\nまあ、いずれ『箸は古い』という風評が世間に広まるまでは、\n或いは自分達でそういう風に情報操作をするまで──\n実際にはそうそう出来るコトではないが、した、出来たと思い込むまで──\n我も我もと、\n……まあね、そういうものだ。[l]\n抗うのは中々に勇気が要るし、正しき選択をするというよりは、\n覚悟や美意識の問題であって、責任というものもしっかり付随するからね。[l]\n何でもかでも意思を貫くことが尊きコトではないよ。[l]\n闇雲であってはいけない。":16,"おっと、\n今は別のお話だ。":17,"そのうちにね、\nみんなが箸だけをつくるものだから、\n如何に余所と違った箸をつくるか、という風潮が広がる訳だ。":18,"例えば、\n軽くて携帯性に優れているとか、\nデザインが人間工学的に良いとか、\n根付け細工のように、持ち手の先端部が精巧に彫刻されているもの、\n色やら造形が派手で美しいとか、\nまあ、そういった進化……否、変化かな……[l]\nつまり他との区別が必要になるな。":19,"それでも、箸は箸だ。[l]\n食材をつまむものなんだ。[l]\nそれが道具としての本質だろう？[l]\n手を汚すことなく、\n食べ物を挟み、\n摘み、\n口に運ぶ為のモノなんだよ、箸は。":20,"ところが、だ。":21,"あるとき、\n先の例で言えば、\n箸の彫刻細工、色、デザインに、\n重き価値をみいだしてしまうものがあらわれる。":22,"すると、\nつくる側にも、そこのみを重視して箸をつくり出す者がでてくるね。[l]\nまあ、箸として最低限の機能を持たせてあるなら、\nそれは単なる付随価値として、\n余所との差別化として許容範囲ではあるだろう。[l]\nしかし、\nある者は、\n造形し易いという理由で、\nそして造形美に傾向した箸が売れるという理由で、\n紙粘土で箸をつくり出したのだ。":23,"木彫りであるならまだしも、\nそれでは、\nまあ、説明は要らないね？":24,"そして普通ならば、そんなものは淘汰されていく筈なんだが、\n何故かつかう側、この場合は買う側かな、そちらに、\n同調するものが多くあらわれる、ことがある。":25,"紙粘土であれ造形彫刻が美しくなければ、\n箸ではないとまで、言い切る者すらあらわれる。":26,"流石に、こればかりは流行といっても、\n道具の本質からは完全に外れている。[l]\n紙粘土の箸は、まあ、多少しっかりした固形物は摘めたろうが、\n麺類や汁気の多い食事には到底耐えられない。[l]\n試したことはないけど、\nラッカー塗ったとしても無理だろうなあ……[l]\n耐久性は勿論のこと、何より心情的に結構きつくないかい？[l]\n単なる鑑賞物なら良かったんだろうがね。[l]\n売れる食器がほぼ箸しかないセカイで、\n全てのひとが箸に観賞性のみを求めることなんかある訳もない。[l]\nああ、くどいようだけど、例え話だからね。":27,"ともあれ、このままでは、\n生命の本質たる食事がままならないという事態に陥った。[l]\n箸が古い廃れたもの、という風評のシフトよりも遙かに速く、\n箸自体が使えなくなっていった。":28,"そして、\nつくり手がもう、機能を果たさない箸しかつくってくれなくなっていたから、\nみんな、箸を使うことはなくなった。[l]\n洗練の遅れは否めなくとも、別の食器を大急ぎで生産しだした。[l]\n食事処も、箸を不要とする食事を売り出し始めるし、\n食べる側も言うに及ばず。[l]\n皆が、色んな局面において衰微し始めた。":29,"しかし、そこで、だ。[l]\nひとつとびに、\n食器というもの自体がいかん、と宣う者があらわれてね。":30,"いうなれば、\n●った原点回帰。[l]\nこれは、状況を打開する冴えた道、と、言えるのかなあ、\nんむー、\n衰退した食器業界に貢献をするとは言い難いのは確かだね。[l]\nつまり、その者が言うには、\n":31,"素手で食事をすべし、と。":32,"どうおもう？":33,"ああ、正否という秤にかける必要はないし出来ないよ。[l]\nただ、キミがどうおもうかだ。[l]\nまあ、キミなら……":34},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_050.ks","relPath":"/data/scenario/SC_E_050.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":34,"length":35,"percent":97.14285714285714},"cellInfo":[]},"/data/scenario/SC_E_051.ks":{"data":[["「じゃあ、デッドライン決めとこうか？[l]\n幾ら手の内にあるといったって、\nいつまでもずるずる放置って訳にはいかないしね」","「那先定个截止日期如何？[l]\n就算手里握着再多筹码，\n也不能永远拖拖拉拉放着不管啊」"],["「……さて、[l]\n如何致しましょうか。[l]\n祭儀の行われるギリギリまでとしても、\n４月２９日、前日土曜までですか。[l]\n当日の処理でも構わなければ３０日日曜まで待てましょう」","「……那么，[l]\n该如何是好。[l]\n就算拖到祭典举行的最后时限，\n也不过是4月29日，前一周六为止。[l]\n若能接受当天处理的话倒是可以等到30日周日」"],["「んー、\nギリまで待った方が何か愉快な事、\n起きる可能性は高まるだろうけどね……[l]\nこちらからせっつかないといけない事態に、\nなるかな？[l]\n逃げる事こそしないだろうけど、\n……これくらいの決断、[l]\n●ならきっちりしてくれると思うけど」","「嗯——\n虽然拖到最后关头的话，\n发生什么有趣事情的可能性会更高吧……[l]\n但演变成需要我们催促的局面，\n真的好吗？[l]\n倒不至于逃跑，\n……这种程度的决断，[l]\n●应该能干脆利落地做出来吧」"],["「…そうでしょうか？」","「…果真如此吗？」"],["「んむ？[l]\nああ、まあそう言われれば、\n彼は、\n今までも──そう仕組んだとは言え──、\n","「嗯唔？[l]\n啊，这么说来，\n他啊，\n迄今为止——虽说是被设计的——\n"],["諾","诺"],["々と流されて巻き込まれてきたんだけれど、[l]\n","诺地被推着走被卷进来，[l]\n"],["今度は、[l]\n彼は、[l]\nまこくんは、[l]\n来るさ、[l]\nんむ。[l]\nどっちの選択肢を選んでにしろ、[l]\n私の手から出て行くなんて、[l]\n有り得ないし。[l]\n赦さないし。[l]\n行かせないし。[l]\n彼自身にとってもその方が、[l]\nほら、あれだよ。[l]\n大体あれとは約束してた事だろ、[l]\n今更、」","但这次，[l]\n他，[l]\n小真他，[l]\n会来的，[l]\n嗯唔。[l]\n无论选择哪条路，[l]\n从我手中逃脱这种事，[l]\n绝无可能。[l]\n绝不原谅。[l]\n绝不放行。[l]\n对他来说这样也是，[l]\n你看，就是那个。[l]\n基本上算是约定过的事吧，[l]\n事到如今，」"],["「──あの、」","「——那个，」"],["「んむ？[l]\nああ、まあ……[l]\nいや、もういいや。[l]\nなんでもない。[l]\nなんでもないよ。[l]\nそんな眼で視ないでくれる？[l]\nん゛っ、んむ、ん。[l]\nそうだなあ、\nフハイらの対事象下モード移行の手間もあるけど──\n直前の２９日土曜をデッドラインとしよう。[l]\nそれまでに彼が戻ってこなければ、\n………私の前に連れてきて。[l]\n彼が決めていなければ、\nその時はその場で、」","「嗯唔？[l]\n啊啊，嘛……[l]\n不，算了。[l]\n没什么。[l]\n没什么啦。[l]\n别用那种眼神看我行吗？[l]\n嗯、嗯唔、嗯。[l]\n是啊，\n虽然切换弗亥他们的对事项下层模式也挺费事──\n就以刚过去的29号周六为截止日吧。[l]\n如果那时他还没回来的话，\n………带到我面前来。[l]\n如果他还没决定的话，\n到时候就在现场，」"],["「引導を渡すのですか」","「要下最后通牒吗」"],["「私が、\n","「我，\n"],["……………………[l]\nんむ、\nまあ、\nいいや。[l]\nその時考える。[l]\nま、どうあれその後にすべきことは決まってるしね。[l]\nそう、\nその事だけどさ。[l]\nキリアケとIg:TYPE･MEGA-D「P+」の準備は兎も角、[l]\n他の装備はどうなってる？」","……………………[l]\n嗯唔，\n嘛，\n算了。[l]\n到时候再想。[l]\n反正之后该做的事早就定好了。[l]\n对了，\n就那件事啊。[l]\n雾明和Ig:TYPE･MEGA-D「P+」的准备姑且不论，[l]\n其他装备怎么样了？」"],["「──え、あ、はあ、\n魔眼の刺し手の具足ですか？[l]\nチズルが用意するでしょう。[l]\n魔眼の差し手は、\n黄金四つ目の仮面を被りて黒衣朱裳を着し、\nその手に……[l]\n──その手に？」","「──诶、啊、哈，\n是说魔眼杀手的甲胄吗？[l]\n小知会准备的吧。[l]\n魔眼杀手者，\n当戴黄金四目假面着黑衣朱裳，\n其手执……[l]\n──其手执？」"],["「矛を持ちて敵を除するもの、だろ。[l]\nそのためのキリアケだろう──」","「持矛以除敌者，对吧。[l]\n为此才需要雾明吧──」"],["「待ってください……なにか、[l]\nわすれているようなきが、\n………？[l]\nワタシともあろうものが、\n………？[l]\nおかしい……」","「请稍等……总觉得，[l]\n好像忘记了什么，\n………？[l]\n以我之身竟会，\n………？[l]\n奇怪……」"],["「？」",""],["「………おかしい………[l]\n………？[l]\n………？[l]\n……………」","「………奇怪………[l]\n………？[l]\n………？[l]\n……………」"],["「んむー、\n確かにキミらしくないな。[l]\n先刻からちょっと顔色もおかしいよ？[l]\n今更自己の体調管理を説諭もなかろうけど、\nまあ、大事を取って休んでおくでも良いよ。[l]\n","「嗯唔——\n确实不像你的作风。[l]\n刚才起脸色就不太对劲？[l]\n事到如今也不必说教注意身体，\n不过保险起见还是休息下吧。[l]\n"],["四重","四重"],["奏","奏"],["団のお","团的守"],["守りはIronに任せてしまって──」","护就交给Iron──」"],["「……まあ、[l]\n……ええ、いえ、どっちでも──[l]\nいや、何とかします」","「……也罢，[l]\n……嗯、不、都行——[l]\n不，我会想办法」"],["「ふうん？[l]\nまあ、主としてEnderが頭痛のタネなんだろうしね。[l]\n矢張りIronに言ってきっちりして貰おうか」","「哼嗯？[l]\n毕竟主要头疼的是Ender嘛。[l]\n果然还是让Iron来妥善处理吧」"],["「はあ……[l]\n取り敢えずその具足に関しては","「哈啊……[l]\n总之那套甲胄"],["彼","那"],["女が、\n飯窪（Ｅ凹）本家の方にて整える次第の筈で……[l]\n後でまた確認及び指示はしておきますが」","女人，\n饭洼（E凹）本家那边应该会整备妥当……[l]\n稍后再确认并下达指示」"],["「……どうにもお互い調子が出ないね。[l]\nあれかなあ、\n私は特にそうだけど、\n雑念を払って机に","「……看来大家都状态不佳啊。[l]\n莫非是，\n尤其是我，\n摒除杂念伏案"],["齧り付く事が、\n必ずしも仕事の効率化能率化を促す訳じゃないよね？[l]\nまさにコトバではあらわせねども、\nそは集中と拡散の落差の狭間に、\n","啃食，\n未必真能提升工作效率吧？[l]\n虽难以言表，\n然于集中与扩散的落差夹缝间，\n"],["ツ","捕"],["カ","捉"],["ミとるものこそ愉にして悦、\nつまり」","其物方为悦乐，\n换言之」"],["「『乍ら』にも関わらず視界によぎるそれこそ、\n理の外側にありて","「『虽』如此却掠过视野之物，\n正位于理之外侧"],["尚視えるもの。[l]\n……より","尚能看见之物。[l]\n……比起"],["好き、我等の求むそれ、[l]\nコトバにすると逃げゆくを、\n固着するのは","喜欢，我等所求之物，[l]\n一旦化作言语就会逃逸，\n能将其固着的"],["我がソの音──\nですか」","唯有我之音──\n是吗」"],["「Ｙ突き刺したる魔眼の刺し手、\n●●●の●●にして我等のしもべ、だったかな。[l]\nどうだったっけ？[l]\nまあいい、それはそうとしてだ、\n要するに今は、\n玩具がね、\n手元に無いが故のこの、\n中途半端な集中がかえって宜しくない感じ。[l]\n手持ち無沙汰というか、\n気分転換に丁度良いアソビが無いって言うのは、\nどうも腰が落ち着かない……って事じゃないのかな、[l]\n今のこのモヤモヤした感じは」","「Y贯穿的魔眼之刺客，\n●●●的●●亦是我等仆从，对吧。[l]\n具体是怎样来着？[l]\n算了无所谓，重点是，\n简而言之现在，\n因为玩具啊，\n不在手边的缘故，\n这种半吊子的专注反而很糟糕。[l]\n说是百无聊赖也好，\n没有适合转换心情的消遣，\n总觉得坐立不安……不就是这么回事吗，[l]\n现在这种烦躁的感觉」"],["「そう、かも知れませんね……」","「或许……是这样呢……」"],["「必然的にその為の玩具の選択基準は、\n非常にデリケートになるしね……[l]\n腰を据えるには時間もテンションも半端、\nかといって手応えの無い行為では意味がない、\n丁度具合の好い、\n最も気持ちいい感触のアソビ、\nそういうのは中々──」","「必然为此选择玩具的标准，\n也会变得极其苛刻……[l]\n要定下心需要时间和情绪都恰到好处，\n但毫无反馈的行为又毫无意义，\n那种刚好合适的，\n最能带来愉悦触感的游戏，\n这种实在很难──」"],["「ええ──」","「没错──」"],["「適度に相互を行ったり来たり出来る案配が望まれる、\n要するに両方が両方へのクールダウンな訳だからね。[l]\nんむ、\nどんな仕事でも休憩を入れた方が効率はいい、\n節度さえ守れば──\nいずれにしろ、\nそういった玩具は手元にあってこそ意味もある、\n今はそう、\nやるゲームが何も無くて、\n読みたい本も視たいテレビも何もない、\nでも時間は半端にある、\n而して寝る訳にもいかない、\n手慰みでもしてないとなーんか、困る、\nそういうシチュエーション、\nわかるだろ？」","「希望能适度在两者间来回切换，\n毕竟双方都能为彼此冷却热情嘛。[l]\n嗯唔，\n任何工作穿插休息效率都会更高，\n只要保持节制──\n总之，\n这类玩具在手边才有意义，\n现在却，\n没有能玩的游戏，\n想读的书想看的电视全都没有，\n但时间又不上不下，\n况且也不能睡觉，\n不找点乐子的话总感觉……很难熬，\n这种情境，\n你懂吧？」"],["「え？[l]\nああ、そう──ですね。[l]\nままあることです」","「咦？[l]\n啊，确实──是这样呢。[l]\n常有的事」"],["「そういうことだね。[l]\nがっつり据え置き機でやるようなゲームを、\n気分転換に用いるのには無理がある。[l]\n片手間にそこそこプレイ出来るからこそ、\n集中へのよすがに丁度良かったのに、\nそう言う意味でも、\nああもう、\nまこくん、\nすっごく好かったのに、」","「就是这么回事。[l]\n要用需要全神贯注的主机游戏，\n来转换心情实在勉强。[l]\n正因能随手玩上片刻，\n才刚好成为专注的依托，\n从这个意义上说，\n啊啊真是，\n小真，\n明明超级合适的，」"],["「……あの、」","「……那个，」"],["「──んむ？[l]\nだから、\nどうしてそういう眼をするのさ。[l]\n私が、この白のミルハが、\nセンチメンタルになってるとでも？[l]\n今までだって至上命題不変不動の私が、\n……まあ、この辺で止めとこう。[l]\nそれこそらしくない話だな。[l]\nてかさ、\nキミも何か最近そこ突っ込んで来るな？[l]\n大体、こないだの宣告までは結構放置してたろ、\n相手もあんまりしてなかった、\n向こうのあの","「──嗯？[l]\n所以说，\n干嘛用那种眼神看我啊。[l]\n难道我，这个白色的米尔哈，\n突然变得多愁善感了不成？[l]\n至今为止都秉持至上命题岿然不动的我，\n……算了，到此为止吧。[l]\n再说下去可就不像我了。[l]\n话说啊，\n你最近不也总爱往那方面钻牛角尖吗？[l]\n明明直到上次宣战前都挺放任自流的，\n对方也没怎么主动出击，\n那边那群"],["娘等任せだった訳だし、\nその辺の俗物ぱんぴーじゃあるまいしっ、\nああもう、\n決着の視えない","丫头片子负责的烂摊子，\n又不是什么庸俗的色情狂魔，\n啊啊烦死了，\n为这种看不到结局的"],["浮","悬"],["動","动"],["状","浮"],["態に苛つくなんてのは私の役じゃない！[l]\n違うって。[l]\nなってないってば。[l]\nなってないよ。[l]\n私は兄様に、兄様、\n………[l]\n──ノートどうした？」","状态焦躁根本不符合我的作风！[l]\n不是的。[l]\n都说没有啦。[l]\n才没有呢。[l]\n我对兄长大人，兄长大人，\n………[l]\n──Note怎么了？」"],["「……。[l]\nああ、あの方とは繋ぎが取れませんね……[l]\nいつも単独行動でらしたので気付きませんでしたが、\n改めて連絡しようとしたら──\nどうにも不通なのです」","「……。[l]\n啊，那位目前联系不上呢……[l]\n平时总单独行动所以没注意到，\n想重新联络时却发现──\n完全不通信号」"],["「こんな時に何してるんだ彼奴は。[l]\nと言うか、キミ真逆あの女に何かされてないか？[l]\nその変調も彼奴の所為じゃないだろうな」","「这种时候那家伙在搞什么鬼。[l]\n不如说，你没被那个女人暗中动手脚吧？[l]\n这次异常应该不是那混蛋搞的？」"],["「……少なくとも、[l]\n何かをされた覚えは、ありませんが、\n何かをされたなら無論覚えが在る筈も無く、\n──それにそんな事をする意味があるでしょうか」","「……至少，[l]\n不记得有被做过什么，\n若真被做了什么自然也不会有记忆，\n──况且她这么做有什么意义呢」"],["「……ふうん。[l]\n分かったよ。[l]\nいいよ、もうどっちでも。[l]\nはっ、\nはハッ！[l]\n彼奴如きのハラスメント、\n仮に策謀だったとしても、\nそれに心煩わされる程こちとら落ちちゃいないよ！[l]\n落ちてない！[l]\nただどうもこうも、\nああもう苛苛するだけだっ！[l]\nそれだけのことだ！！」","「……哼嗯。[l]\n知道了。[l]\n无所谓，怎样都好。[l]\n哈，\n哈啊！[l]\n就凭那货的骚扰手段，\n就算真是阴谋，\n我们也没落魄到会被扰乱心神！[l]\n才没落魄！[l]\n只是无论如何，\n啊啊现在只觉得火大而已！[l]\n仅此而已！！」"],["「………」",""],["「ああ、御免。[l]\nま、いい。[l]\nいざとなればこの苛立ちだって、\n『大いなる紅き眼と白をまとう災』への糧にしてやるさ。[l]\nその前段階でコトは済みそうだけどね、\n発散の為だろうと彼奴への制裁だろうと、\nその気になったら躊躇なんてしないからそのつもりで。[l]\nそういう意味でも、\nキミは来る日に備えてしっかり復調させること。[l]\nで？[l]\n他に何かあるか？」","「啊，抱歉。[l]\n嘛，算了。[l]\n真到万不得已时，这份焦躁\n就当作献给『着白衣的绯红大灾』的祭品吧。[l]\n不过在那之前应该就能解决了，\n不管是为了发泄还是制裁那混蛋，\n我动手时可不会犹豫你最好记着。[l]\n正因如此，\n你要在决战日前彻底恢复状态。[l]\n所以？[l]\n还有其他事吗？」"],["「……ああ、[l]\nそういえば、先程の話にも出ましたがね、\n実際Enderが臍を曲げてまして。[l]\n当日までには何とかするようにとIronにも伝えてはありますが、\n御承知の通り暖簾に腕押し糠に釘、でしょうね。[l]\nフロシルクと異なりIgは損傷を受けたわけではありませんから、\n彼女の単体としての役、機能に問題はありませんが、\n代わりのアソビでも与えない限りは、\nごねるでしょうね」","「……啊啊、[l]\n说起来、刚才的对话里也提到过、\n实际上Ender正在闹别扭呢。[l]\n虽然也跟Iron说过尽量在当天前解决、\n但您也知道这根本是徒劳无功对吧。[l]\n和弗洛希尔克不同Ig并没有受到损伤、\n她作为个体的职责和功能都没有问题、\n但如果不给点替代的消遣、\n估计会继续闹腾吧」"],["「彼女ね……[l]\n臍を曲げてようと無かろうとあんまり変わらない気も\nするけど……[l]\nまあ代替行為の供与に関しては却下だな。[l]\nそれで？」","「她啊……[l]\n闹不闹别扭感觉都没什么\n差别就是了……[l]\n不过提供替代行为的要求我驳回。[l]\n然后呢？」"],["「向こうで待たされていた時点で、\n相当フラストレーションを溜めていたようですからね。[l]\n今回はそれ故の暴走でもあり、\n更に言うならば、\nそれ故に出鼻を","「在那边待命的时候、\n似乎积攒了相当多的不满呢。[l]\n这次暴走也是这个原因、\n更进一步说、\n正因为如此才更让人觉得"],["挫かれた感を多く受けたようです。[l]\n単独での暴走こそ未だしておりませんが、\n放置しておけば時間の問題かも知れませんがね。[l]\n今の処はIronだけでなく\n四重奏団総出で宥めにかかってるようです。[l]\nそういう訳で──\n実際のダメージを受けたShackleよりも、\nIronの方が心労絶えぬようですが。[l]\nそれに話では向こう待機の時より既に、\n様子はおかしかったらしく」","出师不利的挫败感很强烈。[l]\n虽然还没发展到单独暴走、\n但放任不管可能只是时间问题。[l]\n目前不仅是Iron\n四重奏团全员都在安抚她。[l]\n所以──\n比起实际受伤的Shackle、\nIron那边似乎更心力交瘁呢。[l]\n而且听说从待命时开始、\n状态就不太正常了」"],["「Ironのか？[l]\nなんなんだ、\n私達の間でおかしな病気でも流行してるのか？[l]\n変調だらけだな……[l]\nとは言え、そのIronだけど、\nキミにフォロー頼む程の事でもない……んだろ？[l]\nじゃあ、\n待って貰うしかないな。[l]\n美味しい物でも食べさせてやってよ。[l]\n何しろ向こうよりは水も好いし……」","「Iron吗？[l]\n搞什么、\n我们中间是流行什么怪病了吗？[l]\n到处都是异常状况……[l]\n不过话说回来、那个Iron、\n应该没严重到需要你专门跟进吧……对吧？[l]\n那就、\n只能让她等着了。[l]\n给她吃点好吃的吧。[l]\n毕竟这边水质比那边好……」"],["「ワタシとしては待機組も気になる所ではあるのですが、\n色々な意味で詮無いコトですかね。[l]\nまあ、\n……それはどちらでも、[l]\nZenonあたりも居ますし問題はないでしょう」","「就我而言待机组也让人在意、\n但各种意义上都无可奈何呢。[l]\n反正、\n……那些都无所谓、[l]\n有Zenon在应该没问题吧」"],["「彼女等の配備に関しては、\n大元は兄様の采配だ。[l]\n私が兎や角言う事じゃない。[l]\n前も言ったろう。[l]\nIronにせよ何にせよ元アレの改宗組から、\nNKも総動員してるんだしね、\nもとより","「她们的部署安排、\n原本就是兄长大人的决策。[l]\n轮不到我指手画脚。[l]\n之前也说过了。[l]\n无论是Iron还是其他从原教改宗过来的人、\n连NK都全员出动了、\n本来"],["上","就"],["意","不"],["下","该"],["達はアテにせずとも、\n選ぶべきものを選び取るのが我々だ。[l]\n……そして何があろうと、[l]\n彼が──ダレを選ぼうと、\n私がすべてトリシキルんだから。[l]\nかわることはない。[l]\nそう──いうこと、なんだよ。[l]\nさ！[l]\n彼のコトは置いとくとして、まずは」","指望上面指示、\n选择该选的道路才是我们的作风。[l]\n……无论发生什么、[l]\n他──不管选择谁、\n我都会全部吞噬殆尽。[l]\n不会改变。[l]\n就是──这么回事、啊。[l]\n好了！[l]\n他的事先放一边、首先」"],["「は？[l]\nああ、ええ、\n今劇のマストのひとつ、\nミリアムの確保……否、[l]\nLu=Leの残党の殲滅」","「哈？[l]\n啊啊，嗯嗯，\n今剧的必须事项之一，\n确保米莉安姆……不，[l]\n歼灭Lu=Le残党」"],["「ああそうだ。[l]\n舞台に上がって来さえすれば、\nミリアム当人には抗う術なんか無さそうだし……[l]\n後は壊れ損ないのケル＝ベロア、じゃあ言わずもがな、\nんむー……[l]\n矢張り例の不確定要素なり、\nそうだな……後はまこくんが、[l]\n……。[l]\n彼が、\n●●してくるパターン──とかどうだろか。[l]\nんむ、……」","「啊对。[l]\n只要登上舞台，\n米莉安姆本人看起来也没反抗手段……[l]\n剩下的破烂货凯尔=贝萝娅，那就不必多说了，\n嗯唔——……[l]\n果然还有那个不确定因素，\n是啊……还有就是小真，[l]\n……。[l]\n他，\n●●过来的模式——之类的会怎样呢。[l]\n嗯唔，……」"],["「……どうしました？[l]\nイーハが？」","「……怎么了？[l]\n伊哈吗？」"],["「イーハ？[l]\n……ああ、まこくんのことか。[l]\nいや、\nまあ、\n懸念があるとすれば、\nもしまこくんが──彼女等と結託したなら、\nそこからミリアムに情報が流れる可能性がある事くらいだが……[l]\nただ、その場合でも、\n『イーハが手の内に入った』というコトで、\n寧ろ強気になって我々に歯向かってくるんじゃないか。[l]\nそうさ、どう転ぼうとも、\n………、[l]\n──ああそうだ、\n懸念というのは間違いだった。[l]\n愉しみじゃないか、余興としても。[l]\n彼が私に敵対する、だなんて、\n●●るなんてさ、\nそんな、愉快な話──」","「伊哈？[l]\n……啊，小真的事啊。[l]\n不，\n嘛，\n要说顾虑的话，\n如果小真——和她们联手的话，\n米莉安姆可能会得到情报这点吧……[l]\n不过，即便如此，\n『伊哈落入掌控』这件事，\n反而会让他们更有底气来对抗我们吧。[l]\n是啊，无论怎么发展，\n………，[l]\n——啊对了，\n说顾虑是错的。[l]\n不是挺有趣吗，当作余兴节目。[l]\n他与我为敌，什么的，\n●●什么的，\n这么，愉快的事——」"],["「……ええ」","「……嗯」"],["「……さて……だ、[l]\n先刻の台詞じゃないが、\n私も久々にモードを引き上げてみたいしね。[l]\n『","「……那么……啊，[l]\n虽然刚才说过，\n我也久违地想提升下模式呢。[l]\n『"],["大い","伟大"],["なる","的"],["紅き","红"],["眼と","眼与"],["白を","裹"],["まと","着"],["う災』──までは贅沢としても、\nさあ、\nどこまでイかせてくれるか愉しみだ。[l]\nどうあれ現状で私に本気出させてくれるとすれば、\nそれは──」","白的灾祸』——虽说是奢侈，\n来吧，\n能让我兴奋到什么程度真令人期待。[l]\n总之现阶段能让我认真的话，\n那就是——」"],["「今劇の本義をお忘れ無きよう、\nすべてに優先されるのは──」","「请别忘了今剧的本义，\n最优先的是——」"],["「ワかってるよ。[l]\n本義は兄様の望み、\nつまり私が愉悦を得ることだろ。[l]\nその経緯の過程でマストだってしっかりこなすさ。[l]\nそれも兄様の望みではあるから……[l]\n……あのさ、そろそろ寝させてもらっていいかい？」","「知道啦。[l]\n本义是兄长的愿望，\n也就是我获得愉悦对吧。[l]\n过程中该做的事都会好好完成的。[l]\n那也是兄长的愿望……[l]\n……那个，差不多该让我睡了吧？」"],["「お疲れ──な訳では無いようですね」","「辛苦了——看来倒也不是呢」"],["「まあね。[l]\n少し、鎮めて整理したいだけ。[l]\n手慰むモノが無いなら寝るのがベターだしね、\nま、すぐ起きるよ。[l]\nキミも休みたいなら休んで構わないよ？[l]\n四重奏団の事はどうしても気になるなら、\nそうだなあやっぱりIronに言っておくしかないだろうが……[l]\n彼女自身にも休養が必要そうなら、\n………どうしたものかな。[l]\nああもう、\nあれだ、知狡にでも言って滋養のあるものでも差し入れさせといて」","「算是吧。[l]\n只是想稍微冷静下来整理下思绪。[l]\n要是没有消遣的东西还是睡觉比较好吧，\n嘛，很快就会起来的。[l]\n你想休息的话也没关系哦？[l]\n要是实在在意四重奏团的事，\n果然还是得和Iron说一声吧……[l]\n如果她本人也需要休养的话，\n………该怎么办呢。[l]\n啊真是的，\n对了，要不让知狡送点滋补品过去」"],["「いえ、まあ、ワタシは大丈夫ですので──」","「不，那个，我没事的──」"],["「ホントかい？[l]\n無理はしないでよ。[l]\nどうあれ、\nキリアケとIg:TYPE･MEGA-D「P+」はいつでもいけるように。[l]\n可能ならフハイらにフォロー付けといて。[l]\nああ、あと、下の祭もいつも通り滞りなく進むようにね」","「真的假的？[l]\n可别逞强啊。[l]\n无论如何，\n基里亚克和Ig:TYPE･MEGA-D「P+」要随时能出动。[l]\n可能的话让弗海他们跟着支援下。[l]\n啊对了，下面的祭祀活动也要像往常一样顺利推进」"],["「わかってます」","「明白」"],["「じゃあ、ごめんね。[l]\n寝てくる。[l]\nよく寝るから寝子と言うとか言わないとか──ってね。[l]\nああ、今回の会話の中で、\n失言あったら後で改めて謝るよ、\nお互いどうも、本調子でないようだし、\n柄じゃないとか言わないでよ、\n何というか──興奮してる、\nどうにかしないと、\n止まらない、\n暴走しちゃうくらい、\n……うひひ、[l]\nだめだめ、\nあ、\n悪いね。[l]\nじゃほんとにいくから。[l]\nあとよろしく」","「那、抱歉啦。[l]\n我去睡了。[l]\n因为很能睡所以叫寝子（睡子）什么的才不是呢──开玩笑的。[l]\n啊、这次对话中、\n要是说了不该说的话之后会再道歉的、\n反正我俩状态都不太对劲、\n别说这不适合你之类的话啦、\n该怎么说呢──好兴奋、\n不想办法控制的话、\n停不下来、\n简直要暴走了、\n……呜嘻嘻、[l]\n不行不行、\n啊、\n不好意思。[l]\n那我真走啦。[l]\n之后就拜托了」"],["「ええ。[l]\nごゆっくり。[l]\nOmegaの瞳の祝福あれ」","「嗯嗯。[l]\n请好好休息。[l]\n愿Omega之瞳保佑你」"],["「……この","「……这个"],["滾りを、[l]\n受け止めてくれるなら、\nどんなカタチでも。[l]\n宮も、受け止めますから。[l]\nどんな","若你愿接纳这份炽热，[l]\n无论以何种形式。\n宫也会全盘接受。[l]\n无论怎样的[l]\n戏耍，"],["遊","妓"],["戯でも、\n愉しめますから。[l]\nそのかわり、\nあんまり待たせないでね。[l]\n焦らされるのは好みじゃないのです。[l]\n折角ここまでの前戯、\nお膳立て、……[l]\nちゃんと続き、してくれますよね？[l]\nそうですよね、まこくん？[l]\n宮は、まこくんとなら──」","都能乐在其中。\n不过——[l]\n可别让我等太久。\n被吊胃口可不是我的喜好。[l]\n难得铺垫至此的[l]\n前戏、布局……\n你会好好继续下去对吧？[l]\n没错吧，小真？[l]\n若是和小真一起，宫——[l]\n「爱！！！！！"],["「………。[l]\n………。[l]\n………。[l]\n……はっ、[l]\n………、[l]\n一旦、ワタシも寝てみるべきか、\n何かが、\nワタシ達だけでなく、\n………。[l]\n──ああ、どっちにしても四重奏団の様子は、\n確認して……」","「………。[l]\n………。[l]\n………。[l]\n……哈、[l]\n………、[l]\n或许我也该暂时睡一下、\n有什么东西、\n不仅是我们、\n………。[l]\n──啊，总之四重奏团的情况、\n得去确认……」"],["とぅるるるる………","嘟噜噜噜………"],["「……おや、[l]\nIronに繋がらないとは珍しい……」","「……哎呀、[l]\n联系不上Iron倒是少见……」"],["ピッ。","哔。"],["「何処に居る？[l]\n……まあ、連絡がつかない程度の事自体は、[l]\n通常起こりえない事ではない、\nごく普通の事象……[l]\n彼女の状態も万全ではないらしいし、\nだ、が、\n………。[l]\n………。[l]\n………。[l]\nこれは、\nどっちでも、」","「你在哪里？[l]\n……不过联系不上这种事本身、[l]\n倒也不是不可能发生的、\n很普通的情况……[l]\n她的状态似乎也不在最佳、\n但、是、\n………。[l]\n………。[l]\n………。[l]\n这是、\n哪种情况、」"],["いいことなのか？","算是好事吗？"],["「はい、あんでしょか」","「嗯，您说呢」"],["「Ironは居ますか其処に？」","「Iron在那儿吗？」"],["「あー、その事でちょっとごたごたありまして、\n彼奴にしちゃ珍しく、\n黙ってどっか行っちまったみたいで」","「啊——这事儿有点乱、\n那家伙难得、\n居然默不作声就跑没影了」"],["「何？」","「什么？」"],["「お嬢が探しに……否、鬱憤晴らしに出掛けました。[l]\n宥めようにもアイが居なけりゃ私らじゃどうにも」","「大小姐去找……不，是去发泄情绪了。[l]\n想劝架可爱不在的话我们根本没法子」"],["「独りでですか？」","「独自去的？」"],["「そうですね」","「是的」"],["「大事は控えてるにしちゃ箍ァ緩んでるかもですが、\nま、別に珍しい事じゃないんじゃないすか？[l]\nちゃんと戻ってくるでしょうよ。[l]\n兎に角、私らの努力の甲斐無くお嬢はずっと機嫌悪ィし、\nアイはこっち来る前ッから、\n様子がおかしいっちゃおかしかったですけどね。[l]\nああ、それも報告済みでしたか。[l]\nえー、\nあれでしたら探しに出ますか？」","「虽说大事当前箍儿有点松了、\n嘛，倒也不算多稀罕事吧？[l]\n总会好好回来的。[l]\n总之我们白费功夫大小姐一直心情很差、\n爱在来这儿之前、\n状态就有点不对劲了。[l]\n啊，这事已经汇报过了是吧。[l]\n呃——\n要派人去找吗？」"],["「……貴女はフロスの事もありますし、[l]\nアルコと一緒に大人しくなさい。[l]\nただ、\nあの二人の帰還が極度に遅い場合はワタシにも連絡を」","「……你还要照看弗洛斯、[l]\n和阿露子一起老实待着。[l]\n只是、\n若那两人迟迟未归务必联系我」"],["「了解しました。[l]\nこんなの平素の事、なんでもないと思いますがねェ」","「明白了。[l]\n这种日常小事，根本不算啥啦」"],["「否、GWと再遭遇の危惧、があるのか……？[l]\nだが、いや、………。[l]\n………駄目だ、[l]\n………、[l]\n下手な考え休むに似たり……か[l]\n………言われた通り、少し、休む、べき、だな……」","「不，是担心与GW再度遭遇……？[l]\n但，不对，………。[l]\n………不行、[l]\n………、[l]\n胡思乱想不如睡觉……么[l]\n………听你的，稍微，休息，一下，好了……」"]],"context":[["SC_E_051.ks/index/1/text"],["SC_E_051.ks/index/3/text"],["SC_E_051.ks/index/5/text"],["SC_E_051.ks/index/7/text"],["SC_E_051.ks/index/9/text"],["SC_E_051.ks/index/12/text"],["SC_E_051.ks/index/14/text"],["SC_E_051.ks/index/17/text"],["SC_E_051.ks/index/19/text"],["SC_E_051.ks/index/21/text"],["SC_E_051.ks/index/23/text"],["SC_E_051.ks/index/25/text"],["SC_E_051.ks/index/28/text"],["SC_E_051.ks/index/30/text"],["SC_E_051.ks/index/32/text"],["SC_E_051.ks/index/34/text"],["SC_E_051.ks/index/36/text"],["SC_E_051.ks/index/38/text"],["SC_E_051.ks/index/40/text"],["SC_E_051.ks/index/43/text"],["SC_E_051.ks/index/45/text"],["SC_E_051.ks/index/47/text"],["SC_E_051.ks/index/49/text"],["SC_E_051.ks/index/51/text"],["SC_E_051.ks/index/53/text"],["SC_E_051.ks/index/55/text"],["SC_E_051.ks/index/57/text"],["SC_E_051.ks/index/59/text"],["SC_E_051.ks/index/61/text"],["SC_E_051.ks/index/63/text"],["SC_E_051.ks/index/66/text"],["SC_E_051.ks/index/68/text"],["SC_E_051.ks/index/70/text"],["SC_E_051.ks/index/72/text"],["SC_E_051.ks/index/74/text"],["SC_E_051.ks/index/76/text"],["SC_E_051.ks/index/78/text"],["SC_E_051.ks/index/80/text"],["SC_E_051.ks/index/82/text"],["SC_E_051.ks/index/84/text"],["SC_E_051.ks/index/86/text"],["SC_E_051.ks/index/88/text"],["SC_E_051.ks/index/90/text"],["SC_E_051.ks/index/92/text"],["SC_E_051.ks/index/94/text"],["SC_E_051.ks/index/96/text"],["SC_E_051.ks/index/98/text"],["SC_E_051.ks/index/100/text"],["SC_E_051.ks/index/102/text"],["SC_E_051.ks/index/104/text"],["SC_E_051.ks/index/106/text"],["SC_E_051.ks/index/108/text"],["SC_E_051.ks/index/110/text"],["SC_E_051.ks/index/112/text"],["SC_E_051.ks/index/114/text"],["SC_E_051.ks/index/116/text","SC_E_051.ks/index/212/text","SC_E_051.ks/index/230/text"],["SC_E_051.ks/index/118/text"],["SC_E_051.ks/index/120/text"],["SC_E_051.ks/index/122/text"],["SC_E_051.ks/index/124/text"],["SC_E_051.ks/index/126/text"],["SC_E_051.ks/index/128/text"],["SC_E_051.ks/index/130/text"],["SC_E_051.ks/index/132/text"],["SC_E_051.ks/index/134/text"],["SC_E_051.ks/index/136/text"],["SC_E_051.ks/index/138/text"],["SC_E_051.ks/index/140/text"],["SC_E_051.ks/index/142/text"],["SC_E_051.ks/index/144/text"],["SC_E_051.ks/index/146/text"],["SC_E_051.ks/index/148/text"],["SC_E_051.ks/index/150/text"],["SC_E_051.ks/index/152/text"],["SC_E_051.ks/index/154/text"],["SC_E_051.ks/index/156/text"],["SC_E_051.ks/index/158/text"],["SC_E_051.ks/index/160/text"],["SC_E_051.ks/index/162/text"],["SC_E_051.ks/index/164/text"],["SC_E_051.ks/index/166/text"],["SC_E_051.ks/index/168/text"],["SC_E_051.ks/index/170/text"],["SC_E_051.ks/index/172/text"],["SC_E_051.ks/index/174/text"],["SC_E_051.ks/index/176/text"],["SC_E_051.ks/index/178/text"],["SC_E_051.ks/index/180/text"],["SC_E_051.ks/index/182/text"],["SC_E_051.ks/index/184/text"],["SC_E_051.ks/index/186/text"],["SC_E_051.ks/index/188/text"],["SC_E_051.ks/index/190/text"],["SC_E_051.ks/index/192/text"],["SC_E_051.ks/index/194/text"],["SC_E_051.ks/index/196/text","SC_E_051.ks/index/198/text","SC_E_051.ks/index/208/text","SC_E_051.ks/index/210/text"],["SC_E_051.ks/index/200/text"],["SC_E_051.ks/index/202/text","SC_E_051.ks/index/214/text","SC_E_051.ks/index/238/text"],["SC_E_051.ks/index/204/text"],["SC_E_051.ks/index/206/text"],["SC_E_051.ks/index/216/text"],["SC_E_051.ks/index/218/text"],["SC_E_051.ks/index/220/text"],["SC_E_051.ks/index/222/text"],["SC_E_051.ks/index/224/text"],["SC_E_051.ks/index/226/text"],["SC_E_051.ks/index/228/text"],["SC_E_051.ks/index/232/text"],["SC_E_051.ks/index/234/text"],["SC_E_051.ks/index/236/text"],["SC_E_051.ks/index/240/text"]],"tags":[],"parameters":[[{"start":169,"end":238}],[{"start":297,"end":403}],[{"start":434,"end":585}],[{"start":614,"end":625}],[{"start":660,"end":718}],[{"start":732,"end":733}],[{"start":743,"end":767}],[{"start":799,"end":1011}],[{"start":1070,"end":1077}],[{"start":1108,"end":1357}],[{"start":1386,"end":1397}],[{"start":1428,"end":1433}],[{"start":1463,"end":1630}],[{"start":1659,"end":1776}],[{"start":1807,"end":1847}],[{"start":1876,"end":1963}],[{"start":1994,"end":1997}],[{"start":2026,"end":2075}],[{"start":2106,"end":2210}],[{"start":2223,"end":2225}],[{"start":2234,"end":2235}],[{"start":2244,"end":2247}],[{"start":2256,"end":2274}],[{"start":2303,"end":2350}],[{"start":2381,"end":2450}],[{"start":2479,"end":2506}],[{"start":2516,"end":2517}],[{"start":2526,"end":2583}],[{"start":2614,"end":2674}],[{"start":2684,"end":2765}],[{"start":2779,"end":2780}],[{"start":2790,"end":2791}],[{"start":2801,"end":2823}],[{"start":2852,"end":2887}],[{"start":2897,"end":2916}],[{"start":2925,"end":2968}],[{"start":2977,"end":2993}],[{"start":3024,"end":3265}],[{"start":3294,"end":3309}],[{"start":3340,"end":3479}],[{"start":3508,"end":3514}],[{"start":3545,"end":3826}],[{"start":3855,"end":3894}],[{"start":3925,"end":4085}],[{"start":4114,"end":4121}],[{"start":4152,"end":4393}],[{"start":4402,"end":4459}],[{"start":4469,"end":4470}],[{"start":4480,"end":4481}],[{"start":4491,"end":4492}],[{"start":4502,"end":4609}],[{"start":4638,"end":4736}],[{"start":4767,"end":4840}],[{"start":4869,"end":4956}],[{"start":4987,"end":5181}],[{"start":5210,"end":5215},{"start":10231,"end":10236},{"start":10722,"end":10727}],[{"start":5246,"end":5471}],[{"start":5500,"end":5724}],[{"start":5755,"end":5844}],[{"start":5873,"end":5966}],[{"start":5976,"end":6202}],[{"start":6233,"end":6426}],[{"start":6455,"end":6560}],[{"start":6591,"end":6713}],[{"start":6723,"end":6724}],[{"start":6734,"end":6735}],[{"start":6744,"end":6745}],[{"start":6755,"end":6921}],[{"start":6950,"end":7019}],[{"start":7050,"end":7250}],[{"start":7279,"end":7303}],[{"start":7334,"end":7666}],[{"start":7695,"end":7701}],[{"start":7732,"end":7794}],[{"start":7804,"end":7806}],[{"start":7815,"end":7817}],[{"start":7826,"end":7828}],[{"start":7837,"end":7839}],[{"start":7848,"end":7850}],[{"start":7859,"end":7861}],[{"start":7870,"end":7957}],[{"start":7986,"end":8020}],[{"start":8051,"end":8183}],[{"start":8212,"end":8230}],[{"start":8261,"end":8508}],[{"start":8537,"end":8558}],[{"start":8589,"end":8727}],[{"start":8756,"end":8764}],[{"start":8795,"end":9065}],[{"start":9119,"end":9158}],[{"start":9226,"end":9231}],[{"start":9241,"end":9309}],[{"start":9319,"end":9320}],[{"start":9330,"end":9498}],[{"start":9601,"end":9752}],[{"start":9811,"end":9820},{"start":9830,"end":9839},{"start":10172,"end":10181},{"start":10189,"end":10198}],[{"start":9872,"end":9904}],[{"start":9932,"end":9935},{"start":10264,"end":10267},{"start":11198,"end":11201}],[{"start":9966,"end":10128}],[{"start":10156,"end":10164}],[{"start":10302,"end":10313}],[{"start":10393,"end":10408}],[{"start":10439,"end":10498}],[{"start":10527,"end":10531}],[{"start":10562,"end":10617}],[{"start":10646,"end":10655}],[{"start":10686,"end":10693}],[{"start":10758,"end":10963}],[{"start":10992,"end":11074}],[{"start":11130,"end":11170}],[{"start":11263,"end":11383}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_051.ks","basename":"SC_E_051.ks","indexIds":{"「じゃあ、デッドライン決めとこうか？[l]\n幾ら手の内にあるといったって、\nいつまでもずるずる放置って訳にはいかないしね」":0,"「……さて、[l]\n如何致しましょうか。[l]\n祭儀の行われるギリギリまでとしても、\n４月２９日、前日土曜までですか。[l]\n当日の処理でも構わなければ３０日日曜まで待てましょう」":1,"「んー、\nギリまで待った方が何か愉快な事、\n起きる可能性は高まるだろうけどね……[l]\nこちらからせっつかないといけない事態に、\nなるかな？[l]\n逃げる事こそしないだろうけど、\n……これくらいの決断、[l]\n●ならきっちりしてくれると思うけど」":2,"「…そうでしょうか？」":3,"「んむ？[l]\nああ、まあそう言われれば、\n彼は、\n今までも──そう仕組んだとは言え──、\n":4,"諾":5,"々と流されて巻き込まれてきたんだけれど、[l]\n":6,"今度は、[l]\n彼は、[l]\nまこくんは、[l]\n来るさ、[l]\nんむ。[l]\nどっちの選択肢を選んでにしろ、[l]\n私の手から出て行くなんて、[l]\n有り得ないし。[l]\n赦さないし。[l]\n行かせないし。[l]\n彼自身にとってもその方が、[l]\nほら、あれだよ。[l]\n大体あれとは約束してた事だろ、[l]\n今更、」":7,"「──あの、」":8,"「んむ？[l]\nああ、まあ……[l]\nいや、もういいや。[l]\nなんでもない。[l]\nなんでもないよ。[l]\nそんな眼で視ないでくれる？[l]\nん゛っ、んむ、ん。[l]\nそうだなあ、\nフハイらの対事象下モード移行の手間もあるけど──\n直前の２９日土曜をデッドラインとしよう。[l]\nそれまでに彼が戻ってこなければ、\n………私の前に連れてきて。[l]\n彼が決めていなければ、\nその時はその場で、」":9,"「引導を渡すのですか」":10,"「私が、\n":11,"……………………[l]\nんむ、\nまあ、\nいいや。[l]\nその時考える。[l]\nま、どうあれその後にすべきことは決まってるしね。[l]\nそう、\nその事だけどさ。[l]\nキリアケとIg:TYPE･MEGA-D「P+」の準備は兎も角、[l]\n他の装備はどうなってる？」":12,"「──え、あ、はあ、\n魔眼の刺し手の具足ですか？[l]\nチズルが用意するでしょう。[l]\n魔眼の差し手は、\n黄金四つ目の仮面を被りて黒衣朱裳を着し、\nその手に……[l]\n──その手に？」":13,"「矛を持ちて敵を除するもの、だろ。[l]\nそのためのキリアケだろう──」":14,"「待ってください……なにか、[l]\nわすれているようなきが、\n………？[l]\nワタシともあろうものが、\n………？[l]\nおかしい……」":15,"「？」":16,"「………おかしい………[l]\n………？[l]\n………？[l]\n……………」":17,"「んむー、\n確かにキミらしくないな。[l]\n先刻からちょっと顔色もおかしいよ？[l]\n今更自己の体調管理を説諭もなかろうけど、\nまあ、大事を取って休んでおくでも良いよ。[l]\n":18,"四重":19,"奏":20,"団のお":21,"守りはIronに任せてしまって──」":22,"「……まあ、[l]\n……ええ、いえ、どっちでも──[l]\nいや、何とかします」":23,"「ふうん？[l]\nまあ、主としてEnderが頭痛のタネなんだろうしね。[l]\n矢張りIronに言ってきっちりして貰おうか」":24,"「はあ……[l]\n取り敢えずその具足に関しては":25,"彼":26,"女が、\n飯窪（Ｅ凹）本家の方にて整える次第の筈で……[l]\n後でまた確認及び指示はしておきますが」":27,"「……どうにもお互い調子が出ないね。[l]\nあれかなあ、\n私は特にそうだけど、\n雑念を払って机に":28,"齧り付く事が、\n必ずしも仕事の効率化能率化を促す訳じゃないよね？[l]\nまさにコトバではあらわせねども、\nそは集中と拡散の落差の狭間に、\n":29,"ツ":30,"カ":31,"ミとるものこそ愉にして悦、\nつまり」":32,"「『乍ら』にも関わらず視界によぎるそれこそ、\n理の外側にありて":33,"尚視えるもの。[l]\n……より":34,"好き、我等の求むそれ、[l]\nコトバにすると逃げゆくを、\n固着するのは":35,"我がソの音──\nですか」":36,"「Ｙ突き刺したる魔眼の刺し手、\n●●●の●●にして我等のしもべ、だったかな。[l]\nどうだったっけ？[l]\nまあいい、それはそうとしてだ、\n要するに今は、\n玩具がね、\n手元に無いが故のこの、\n中途半端な集中がかえって宜しくない感じ。[l]\n手持ち無沙汰というか、\n気分転換に丁度良いアソビが無いって言うのは、\nどうも腰が落ち着かない……って事じゃないのかな、[l]\n今のこのモヤモヤした感じは」":37,"「そう、かも知れませんね……」":38,"「必然的にその為の玩具の選択基準は、\n非常にデリケートになるしね……[l]\n腰を据えるには時間もテンションも半端、\nかといって手応えの無い行為では意味がない、\n丁度具合の好い、\n最も気持ちいい感触のアソビ、\nそういうのは中々──」":39,"「ええ──」":40,"「適度に相互を行ったり来たり出来る案配が望まれる、\n要するに両方が両方へのクールダウンな訳だからね。[l]\nんむ、\nどんな仕事でも休憩を入れた方が効率はいい、\n節度さえ守れば──\nいずれにしろ、\nそういった玩具は手元にあってこそ意味もある、\n今はそう、\nやるゲームが何も無くて、\n読みたい本も視たいテレビも何もない、\nでも時間は半端にある、\n而して寝る訳にもいかない、\n手慰みでもしてないとなーんか、困る、\nそういうシチュエーション、\nわかるだろ？」":41,"「え？[l]\nああ、そう──ですね。[l]\nままあることです」":42,"「そういうことだね。[l]\nがっつり据え置き機でやるようなゲームを、\n気分転換に用いるのには無理がある。[l]\n片手間にそこそこプレイ出来るからこそ、\n集中へのよすがに丁度良かったのに、\nそう言う意味でも、\nああもう、\nまこくん、\nすっごく好かったのに、」":43,"「……あの、」":44,"「──んむ？[l]\nだから、\nどうしてそういう眼をするのさ。[l]\n私が、この白のミルハが、\nセンチメンタルになってるとでも？[l]\n今までだって至上命題不変不動の私が、\n……まあ、この辺で止めとこう。[l]\nそれこそらしくない話だな。[l]\nてかさ、\nキミも何か最近そこ突っ込んで来るな？[l]\n大体、こないだの宣告までは結構放置してたろ、\n相手もあんまりしてなかった、\n向こうのあの":45,"娘等任せだった訳だし、\nその辺の俗物ぱんぴーじゃあるまいしっ、\nああもう、\n決着の視えない":46,"浮":47,"動":48,"状":49,"態に苛つくなんてのは私の役じゃない！[l]\n違うって。[l]\nなってないってば。[l]\nなってないよ。[l]\n私は兄様に、兄様、\n………[l]\n──ノートどうした？」":50,"「……。[l]\nああ、あの方とは繋ぎが取れませんね……[l]\nいつも単独行動でらしたので気付きませんでしたが、\n改めて連絡しようとしたら──\nどうにも不通なのです」":51,"「こんな時に何してるんだ彼奴は。[l]\nと言うか、キミ真逆あの女に何かされてないか？[l]\nその変調も彼奴の所為じゃないだろうな」":52,"「……少なくとも、[l]\n何かをされた覚えは、ありませんが、\n何かをされたなら無論覚えが在る筈も無く、\n──それにそんな事をする意味があるでしょうか」":53,"「……ふうん。[l]\n分かったよ。[l]\nいいよ、もうどっちでも。[l]\nはっ、\nはハッ！[l]\n彼奴如きのハラスメント、\n仮に策謀だったとしても、\nそれに心煩わされる程こちとら落ちちゃいないよ！[l]\n落ちてない！[l]\nただどうもこうも、\nああもう苛苛するだけだっ！[l]\nそれだけのことだ！！」":54,"「………」":55,"「ああ、御免。[l]\nま、いい。[l]\nいざとなればこの苛立ちだって、\n『大いなる紅き眼と白をまとう災』への糧にしてやるさ。[l]\nその前段階でコトは済みそうだけどね、\n発散の為だろうと彼奴への制裁だろうと、\nその気になったら躊躇なんてしないからそのつもりで。[l]\nそういう意味でも、\nキミは来る日に備えてしっかり復調させること。[l]\nで？[l]\n他に何かあるか？」":56,"「……ああ、[l]\nそういえば、先程の話にも出ましたがね、\n実際Enderが臍を曲げてまして。[l]\n当日までには何とかするようにとIronにも伝えてはありますが、\n御承知の通り暖簾に腕押し糠に釘、でしょうね。[l]\nフロシルクと異なりIgは損傷を受けたわけではありませんから、\n彼女の単体としての役、機能に問題はありませんが、\n代わりのアソビでも与えない限りは、\nごねるでしょうね」":57,"「彼女ね……[l]\n臍を曲げてようと無かろうとあんまり変わらない気も\nするけど……[l]\nまあ代替行為の供与に関しては却下だな。[l]\nそれで？」":58,"「向こうで待たされていた時点で、\n相当フラストレーションを溜めていたようですからね。[l]\n今回はそれ故の暴走でもあり、\n更に言うならば、\nそれ故に出鼻を":59,"挫かれた感を多く受けたようです。[l]\n単独での暴走こそ未だしておりませんが、\n放置しておけば時間の問題かも知れませんがね。[l]\n今の処はIronだけでなく\n四重奏団総出で宥めにかかってるようです。[l]\nそういう訳で──\n実際のダメージを受けたShackleよりも、\nIronの方が心労絶えぬようですが。[l]\nそれに話では向こう待機の時より既に、\n様子はおかしかったらしく」":60,"「Ironのか？[l]\nなんなんだ、\n私達の間でおかしな病気でも流行してるのか？[l]\n変調だらけだな……[l]\nとは言え、そのIronだけど、\nキミにフォロー頼む程の事でもない……んだろ？[l]\nじゃあ、\n待って貰うしかないな。[l]\n美味しい物でも食べさせてやってよ。[l]\n何しろ向こうよりは水も好いし……」":61,"「ワタシとしては待機組も気になる所ではあるのですが、\n色々な意味で詮無いコトですかね。[l]\nまあ、\n……それはどちらでも、[l]\nZenonあたりも居ますし問題はないでしょう」":62,"「彼女等の配備に関しては、\n大元は兄様の采配だ。[l]\n私が兎や角言う事じゃない。[l]\n前も言ったろう。[l]\nIronにせよ何にせよ元アレの改宗組から、\nNKも総動員してるんだしね、\nもとより":63,"上":64,"意":65,"下":66,"達はアテにせずとも、\n選ぶべきものを選び取るのが我々だ。[l]\n……そして何があろうと、[l]\n彼が──ダレを選ぼうと、\n私がすべてトリシキルんだから。[l]\nかわることはない。[l]\nそう──いうこと、なんだよ。[l]\nさ！[l]\n彼のコトは置いとくとして、まずは」":67,"「は？[l]\nああ、ええ、\n今劇のマストのひとつ、\nミリアムの確保……否、[l]\nLu=Leの残党の殲滅」":68,"「ああそうだ。[l]\n舞台に上がって来さえすれば、\nミリアム当人には抗う術なんか無さそうだし……[l]\n後は壊れ損ないのケル＝ベロア、じゃあ言わずもがな、\nんむー……[l]\n矢張り例の不確定要素なり、\nそうだな……後はまこくんが、[l]\n……。[l]\n彼が、\n●●してくるパターン──とかどうだろか。[l]\nんむ、……」":69,"「……どうしました？[l]\nイーハが？」":70,"「イーハ？[l]\n……ああ、まこくんのことか。[l]\nいや、\nまあ、\n懸念があるとすれば、\nもしまこくんが──彼女等と結託したなら、\nそこからミリアムに情報が流れる可能性がある事くらいだが……[l]\nただ、その場合でも、\n『イーハが手の内に入った』というコトで、\n寧ろ強気になって我々に歯向かってくるんじゃないか。[l]\nそうさ、どう転ぼうとも、\n………、[l]\n──ああそうだ、\n懸念というのは間違いだった。[l]\n愉しみじゃないか、余興としても。[l]\n彼が私に敵対する、だなんて、\n●●るなんてさ、\nそんな、愉快な話──」":71,"「……ええ」":72,"「……さて……だ、[l]\n先刻の台詞じゃないが、\n私も久々にモードを引き上げてみたいしね。[l]\n『":73,"大い":74,"なる":75,"紅き":76,"眼と":77,"白を":78,"まと":79,"う災』──までは贅沢としても、\nさあ、\nどこまでイかせてくれるか愉しみだ。[l]\nどうあれ現状で私に本気出させてくれるとすれば、\nそれは──」":80,"「今劇の本義をお忘れ無きよう、\nすべてに優先されるのは──」":81,"「ワかってるよ。[l]\n本義は兄様の望み、\nつまり私が愉悦を得ることだろ。[l]\nその経緯の過程でマストだってしっかりこなすさ。[l]\nそれも兄様の望みではあるから……[l]\n……あのさ、そろそろ寝させてもらっていいかい？」":82,"「お疲れ──な訳では無いようですね」":83,"「まあね。[l]\n少し、鎮めて整理したいだけ。[l]\n手慰むモノが無いなら寝るのがベターだしね、\nま、すぐ起きるよ。[l]\nキミも休みたいなら休んで構わないよ？[l]\n四重奏団の事はどうしても気になるなら、\nそうだなあやっぱりIronに言っておくしかないだろうが……[l]\n彼女自身にも休養が必要そうなら、\n………どうしたものかな。[l]\nああもう、\nあれだ、知狡にでも言って滋養のあるものでも差し入れさせといて」":84,"「いえ、まあ、ワタシは大丈夫ですので──」":85,"「ホントかい？[l]\n無理はしないでよ。[l]\nどうあれ、\nキリアケとIg:TYPE･MEGA-D「P+」はいつでもいけるように。[l]\n可能ならフハイらにフォロー付けといて。[l]\nああ、あと、下の祭もいつも通り滞りなく進むようにね」":86,"「わかってます」":87,"「じゃあ、ごめんね。[l]\n寝てくる。[l]\nよく寝るから寝子と言うとか言わないとか──ってね。[l]\nああ、今回の会話の中で、\n失言あったら後で改めて謝るよ、\nお互いどうも、本調子でないようだし、\n柄じゃないとか言わないでよ、\n何というか──興奮してる、\nどうにかしないと、\n止まらない、\n暴走しちゃうくらい、\n……うひひ、[l]\nだめだめ、\nあ、\n悪いね。[l]\nじゃほんとにいくから。[l]\nあとよろしく」":88,"「ええ。[l]\nごゆっくり。[l]\nOmegaの瞳の祝福あれ」":89,"「……この":90,"滾りを、[l]\n受け止めてくれるなら、\nどんなカタチでも。[l]\n宮も、受け止めますから。[l]\nどんな":91,"遊":92,"戯でも、\n愉しめますから。[l]\nそのかわり、\nあんまり待たせないでね。[l]\n焦らされるのは好みじゃないのです。[l]\n折角ここまでの前戯、\nお膳立て、……[l]\nちゃんと続き、してくれますよね？[l]\nそうですよね、まこくん？[l]\n宮は、まこくんとなら──」":93,"「………。[l]\n………。[l]\n………。[l]\n……はっ、[l]\n………、[l]\n一旦、ワタシも寝てみるべきか、\n何かが、\nワタシ達だけでなく、\n………。[l]\n──ああ、どっちにしても四重奏団の様子は、\n確認して……」":94,"とぅるるるる………":95,"「……おや、[l]\nIronに繋がらないとは珍しい……」":96,"ピッ。":97,"「何処に居る？[l]\n……まあ、連絡がつかない程度の事自体は、[l]\n通常起こりえない事ではない、\nごく普通の事象……[l]\n彼女の状態も万全ではないらしいし、\nだ、が、\n………。[l]\n………。[l]\n………。[l]\nこれは、\nどっちでも、」":98,"いいことなのか？":99,"「はい、あんでしょか」":100,"「Ironは居ますか其処に？」":101,"「あー、その事でちょっとごたごたありまして、\n彼奴にしちゃ珍しく、\n黙ってどっか行っちまったみたいで」":102,"「何？」":103,"「お嬢が探しに……否、鬱憤晴らしに出掛けました。[l]\n宥めようにもアイが居なけりゃ私らじゃどうにも」":104,"「独りでですか？」":105,"「そうですね」":106,"「大事は控えてるにしちゃ箍ァ緩んでるかもですが、\nま、別に珍しい事じゃないんじゃないすか？[l]\nちゃんと戻ってくるでしょうよ。[l]\n兎に角、私らの努力の甲斐無くお嬢はずっと機嫌悪ィし、\nアイはこっち来る前ッから、\n様子がおかしいっちゃおかしかったですけどね。[l]\nああ、それも報告済みでしたか。[l]\nえー、\nあれでしたら探しに出ますか？」":107,"「……貴女はフロスの事もありますし、[l]\nアルコと一緒に大人しくなさい。[l]\nただ、\nあの二人の帰還が極度に遅い場合はワタシにも連絡を」":108,"「了解しました。[l]\nこんなの平素の事、なんでもないと思いますがねェ」":109,"「否、GWと再遭遇の危惧、があるのか……？[l]\nだが、いや、………。[l]\n………駄目だ、[l]\n………、[l]\n下手な考え休むに似たり……か[l]\n………言われた通り、少し、休む、べき、だな……」":110},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_051.ks","relPath":"/data/scenario/SC_E_051.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":109,"length":111,"percent":98.1981981981982},"cellInfo":[null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[7,1]},"/data/scenario/SC_E_052.ks":{"data":[["ヒトはまっとうに生きていれば、\nいえ、そんなに堅苦しい言い方せんでもね、\nただただ暮らしてるだけでもね、\n前に進むもの、\n","人只要正经过日子、\n不，不用说得这么死板、\n就算只是浑浑噩噩活着、\n也在向前迈进、\n"],["精進、なんて大仰な言い方せんでもね。","精进什么的，不说这么夸张也行。"],["黙っとってもそうなるんが正道ですよぅ。[l]\nならんいうことは、よっぽど無自覚か、\nそん気がないぃゆうことですからねぃ。","就算闷声不响那也是正道哟。[l]\n要说为啥不行的话，要么是太不自觉，\n要么就是压根没那心思呗。"],["せやからね。","所以说啊。"],["懐古趣味……ならぬ懐古主義？","怀旧趣味……不如说怀古主义？"],["どうもそういうんはこう、\nすっきりしませんねぇ、\nなんといいましょうか、\n","总觉得这类玩意儿吧，\n让人不太痛快呢，\n该怎么说呢，\n"],["旧き良きものなどありませんのに。","根本不存在什么过去的美好事物。"],["そこがわからんと、\n","要是搞不明白这点，\n"],["自分の頭がやわぁかいときの初経験が、\nいいもんとして脳みそに銘記されとるだけ、\nだから誰でも自分の世代のが一番ええと、\n思うてしまうんですかねぃ。","不过是把脑子还天真时的初次体验，\n当作好东西刻在脑浆里罢了，\n所以谁都会觉得自己那代最棒，\n忍不住这么想对吧。"],["最","最"],["初","初"],["の","的"],["衝","冲"],["撃勝ちですよぅ。","击胜利哟。"],["第一印象いうんはなかなか拭えんもんでしょ？[l]\nそうでなくても、\nそん人にとってはそれ以降は全部、\n例え世に出た順序が逆だとしても、\n初回の二番煎じに視えてまう──事もあるわけやからね。[l]\nどの世代、どの世相に属してたかによって、\n周囲への同調、周りと同じ事してへんとコワイとか、\nはたまたその逆、同じ事するんがイヤやとか、\nま、どっちも自分と他という相対的な位置に眼ぇ向けてる話やよって、\n方向が真逆なだけでまあ、\n一緒の話ですねぇ。","第一印象这东西可不容易抹掉吧？[l]\n就算不是这样，\n对那人来说之后的一切，\n哪怕问世顺序相反，\n看起来都像是初代的山寨版——这种情况也是有的啦。[l]\n根据所属世代和时代氛围不同，\n有人会迎合周围，害怕和旁人不一样，\n也有人反过来，讨厌随大流，\n咳，反正两者都是盯着自己和他人的相对位置，\n只是方向完全相反，\n本质没啥区别啦。"],["えぇとなんでしたっけね？[l]\nああ、\nだから特禁級とか使役場開放の話は抵抗なかったようですよぅ。[l]\nそそ、あれ。[l]\nあれも","哎哟刚才说到哪儿来着？[l]\n啊啊，\n所以对特禁级啊使役场开放之类倒是没啥抵触呢。[l]\n对对，就那个。[l]\n那个也"],["外","算"],["法外道みたいなもんな筈やけどね。[l]\n結局はそういうことです。[l]\nヒトはみぃんな、自分が好しとするモンが是なんです。[l]\n論理的に詰めていったら理屈に合わんはずの事でも、\n本人の中ではアリなんですなぁ。[l]\nま、うちも含めてそうでないヒトの方が少ないでしょから、\nそこは責めんとってね。","旁门左道之流才对嘛。[l]\n说到底就是这么回事。[l]\n人类啊，都把自己喜欢的东西当成真理。[l]\n就算逻辑上推敲起来根本说不通的事，\n在本人心里也是成立的哟。[l]\n嘛，包括我在内，不是这样的人反而少见，\n就别苛责啦。"],["でもやね、\n古いモンがええと思い込んでまうんは、\nどうかと思いますなぁ。","不过啊，\n总觉得老东西就是好，\n这毛病可不太妙。"],["だってねぃ、\nおおきゅうなってから、\n例えば今スキなマンガとかテレビとか、ありますでしょ？[l]\nまたみてみ？[l]\nがっかりさせられますよぅ。","因为呀，\n等长大以后，\n比如现在喜欢的漫画啊电视剧啊，有吧？[l]\n再回头看的话？[l]\n会大失所望哟。"],["想い出いうんはね、\n美化されるもんなんよねぇ。","回忆这东西啊，\n本来就是会被美化的嘛。"],["でも、\nそれが健全いうもんなんよ。[l]\nそうでなければ、\nそんひとは全然成長してへんことになりますよって、\n懐かしいと思うことはあっても、\n実際に『昔ならば好かった』いうことはそうそうない、\nいうんがま、うちの経験上はね、多いです。","不过，\n这样才健康啦。[l]\n要不然的话，\n就说明那人根本没成长过，\n虽然偶尔会怀念过去，\n但实际觉得『要是当年就好了』的情况其实很少，\n至少以我的经验来看，大多如此。"],["ああ、そうやねぇ、\n例えば肉体的な衰えが、\n物理的相対的に過去のがええ具合、いうんはありますよ。","啊对的对的，\n比如身体机能衰退时，\n客观上确实会觉得过去比较强啦。"],["何にも考えんと『あえて昔のように』するんはね、\nうち的にはどうにもいただけませんなぁ。[l]\n約款やらシキタリ守るいうならまだしも、\n","啥都不想就『刻意复古』这种做法啊，\n咱家实在是难以苟同呢。[l]\n要是说遵守规章条例倒也罢了，\n"],["──ええ。[l]\n後ろからくるものへのやっかみかどうかは\nひとによりますやろけどね、\nそういう事はようあることなんです。","──嗯。[l]\n至于是否出于对后来者的嫉妒\n这得看个人情况啦，\n这种事很常见的。"],["でもやね、\n新しかろが古かろが、\n出来る人材と出来ない人材がいるだけなんですよ。","不过啊，\n新也好旧也罢，\n只不过是有能人才和无能人才之分罢了。"],["昔がええとか、今のがええとか、\nちゃいますよ。そんなんは。[l]\n設問からしておかしな話ですやんか。[l]\n昔も今も、\n優秀なお方と●●な●がおるいうだけのことですわ。","说什么过去好现在好，\n才不是呢。那种说法。[l]\n这问题本身就很奇怪吧。[l]\n过去现在都一样，\n只不过是有优秀人士和●●●之分而已啦。"],["そこがわからんと、\n単に未成熟な時代のモノそのものを再現されても、\n当時を知るモンが懐かしむ以外になんの意味もありません。[l]\n『それが目的』ならええけどもね。[l]\nなんでもかんでも『古き良き』なんて修辞をつかうんは如何なものか。","要是搞不明白这点，\n单纯重现不成熟时代的产物本身，\n除了让经历过的人怀旧之外毫无意义。[l]\n『要是就图这个』那倒另当别论。[l]\n动不动就套用『美好旧时光』这种修辞算什么嘛。"],["古き良き、というんはね、\n今の●●な●が視失うてる根源たる本質を、\nワカってるモンがきっちり汎用的に再現或いは応用できてる、\nそういう場合にのみ当てはまるコトバであって、\n古いモンが何時如何なる場合でもまるで優にあたるが如く振る舞われるのは、\nどうなんやろかと思う訳ですよぅ。","所谓美好旧时光啊，\n是指明白人能把当下●●●们丢失的根源性本质，\n妥妥地进行普适性重现或应用，\n仅限这种情况才能用的词儿，\n要是觉得旧事物在任何情况下都绝对优越，\n咱家觉得这很有问题呢。"],["色褪せない良さ──とかよう言いますな？","说什么历久弥新的美好──"],["それは付随的に説明されとりますように、\n時代を超えて変わらないモン、\nつまり普遍的、本質的な、\n『良さの良さたる","就像附带说明那样，\n是指超越时代不变的东西，\n也就是普世的、本质的，\n『美好之所以美好"],["所","的"],["以のエッセンス』だから、です。","的核心精髓』使然。"],["『古いからええ』訳ではないですねぃ。","可不是『因为古老就好』呢。"],["そこを履き違えますとね、\n古い遣り方なら何でもええもんとゴカイする御仁も出て来ますのよぅ。","要是搞错这点啊，\n就会冒出把古老做法全都当宝贝的糊涂虫呢。"],["ほんまにええとこは残して、\nちゃぁんと進化してるモノゴトもぎょうさんあるでしょ？[l]\nさっきも言うたけども、\nそのつもりでやっとったら前に進むんは自然の理ぃなんやからね。","真正好的部分保留下来，\n好好进化的事物不也多得是吗？[l]\n刚才也说过，\n怀着这种心态做事前进才是自然之理嘛。"],["勿論、進化してるつもりが、\n理屈やら何やら捏ねくり回してるうちに、\n……誰かさんはＰの","当然也有本想进化，\n却在搬弄道理的过程中，\n……某位说是P的"],["悪","恶"],["業と言うてましたかな、[l]\n良きエッセンスごと改変してもうて、\n結果改悪、いうモノゴトもありますからねぃ。[l]\nそういうのに限って、\n古き良き時代に戻ろ、いう話になるんですわ、\nところが。","业障来着，[l]\n把好的精髓也改掉，\n结果越改越糟的情况呢。[l]\n偏偏这种时候，\n就会冒出回到美好旧时代的论调，\n可是啊。"],["そもそもそのエッセンスがわからんとそうなった、\nその経過を知らん、いや、寧ろ知ったつもりになっとる輩が、\n良きエッセンスでなく、\n『なるべくしてなった進化を単に逆行』させて、\n昔はこうやったねぇ、というんです。[l]\nそういうんに限ってまた、\n例えばやけどね、名前やら呼び方やらの、\n本質とは違う部分、『がわ』の部分だけを古式ゆかしくしただけで、\n肝心のキモの部分はぜぇんぜん、別モンに変えてもうてるにも関わらず、\n原点回帰をうたってみたり、\n……まあ、『がわ』を守る価値観もあるにはありますけどね。[l]\nそん場合でも、\n大抵は『がわ』しかないモンの場合ですわ。[l]\nちゃあんと『ミ』もある場合は、\n……どやろうねぇ。","根本是因为没搞懂那个精髓才变成这样，\n不了解经过──不、是自以为了解的家伙们，\n不去传承好的精髓，\n『单纯逆向操作必然的进化』，\n说什么过去都是这么做的。[l]\n偏偏这种人啊，\n举个例来说吧，\n只把名字叫法这些非本质的『形式』部分复古，\n关键核心却完全偷梁换柱，\n还高喊什么回归原点，\n……嘛，『形式』也有其守护价值就是了。[l]\n不过这种时候，\n多半是只有『形式』可守的情况啦。[l]\n要是连『内涵』也齐全的话，\n……该怎么说呢。"],["改悪いうのはたいがい、\n過保護になってもうてる感じの場合です。[l]\n幾らヒトが──いえ、生き物が常に、水が低いところに流れるよに、\n兎に角ラクに、楽になろうとするいうてもね、\nせやねえ、\n例えば、解答をスキなときにすぐ教えてくれるクイズ、\n頼んでへんのに司会から答えぇ言われるような状態は、\nもう遊戯でもなんでもないやねぇ？","所谓改恶嘛，大多都是\n过度保护过头的感觉啦。[l]\n无论人类——不，生物总是像水往低处流般，\n总之就是会想方设法图轻松、图省事对吧，\n是嘞是嘞，\n比如说那种会立刻告诉你答案的猜谜游戏，\n明明没请求主持人却主动把答案说出来的状态，\n那根本算不上游戏了吧？"],["現状を過保護思ぅてるんはまあええとしましょか、\n実際今言ったような、行為の本末転倒はようあることですよぅ。[l]\nだからといって、\nそれを昔に戻すいうて、\nクイズの出題行為自体にいらん手続きつくるとか──\n例えば必ず出題に五分十分かかるとか、\n解答は口頭でなく手で紙に書かなあかんとか、\nしかもその紙","觉得现状是过度保护倒也无妨啦，\n实际上刚才说的那种本末倒置的行为可常见得很哟。[l]\n但即便如此，\n说要回归过去，\n给猜谜出题行为本身添加多余手续什么的——\n比如每题必须花上五到十分钟啦，\n答案必须手写在纸上不能口头回答啦，\n而且那张纸"],["漉いてこいとか墨すって筆で書くとこから始めぃとか、\nあとはそやねぇ、\n問題なり出題場所がえらい遠い所に","还得自己亲手抄造研墨用毛笔书写什么的，\n还有就是啊，\n把题目或出题地点设在"],["設えてあって、\nそこまで絶対徒歩で行かなあかん、自転車車電車も通信機器も駄目、\nとか言い出すような──そういう、\n面倒なんが古き良き在り方ではないですよ。","超远的地方，\n规定必须步行前往不准骑车坐车用通讯设备，\n诸如此类——这些\n麻烦玩意儿可算不上什么优良传统哟。"],["そういうんは単なる時間稼ぎにしかならんし、\nほんまにただただ時間使わせたいだけ言うなら別やね、\n……ま、後は肉体使わす事自体が目的とか、主旨がずれてる場合もあるやろけど、[l]\nそういうんは『やらせたいのはクイズではない』んやろから仕方在りません、\nで済ますほかないですけどねぃ。[l]\nそういうんはまあ、また別の次元の話でね。[l]\n本質だけ残しても飾りやらで飽きがこんようにする工夫は必要、\nていうんはワカりますね？[l]\nさっきも言ったちゃんと前に進むべくして成る変化はあるんです。[l]\n演出なんかを派手にしたり綺麗にしたり、\n司会者や回答者をみんながよう知ってるひとにするとか、\nうちも今ぱっ……と思いつく手段はそんなとこですがね、[l]\nま、今してるんは例えの話ですから気にせんとってね。","这种搞法纯粹是在浪费时间，\n真要单纯想消耗时间那另当别论，\n……嘛，也有些情况是故意折腾肉体或主旨跑偏啦，[l]\n那种就属于『想让人做的根本不是猜谜』所以没辙，\n只能随他去了呗。[l]\n那种情况嘛，属于另一个次元的话题了。[l]\n保留本质的同时用装饰防止腻味的巧思是必要的，\n这个道理懂的吧？[l]\n刚才也说过存在理应发生的正向变化。[l]\n把演出搞得更华丽精美啦，\n让主持人和答题者都选知名人士啦，\n咱现在能啪地……想到的手段也就这些啦，[l]\n嘛，现在说的都是比喻别太较真哈。"],["で、\nクイズっていうんはね、\n問題聞いて、それを理屈捏ねたり、前もって増やしといた知識やらで、\nほんで解くんが行為の本質でしょ？","那么，\n所谓猜谜啊，\n听完题目后，用逻辑推敲或是预先储备的知识，\n最后解出答案才是行为本质对吧？"],["今の過保護があかんいうても、\nそのあかんところは、\n行為の本質たる『解答を考えるという事』を、\n主催がフォローしすぎてるトコやら、\n『装飾やヴァリエーションとして余所と差別化する為に付け足した、\n演出やら何やらの本質とは無関係の部分』が、\n肥大化しすぎて本質を隠してもうたトコであって、\n行為を円滑に行うために進化させてきた手順やらをやね、\n昔は善かったぁ言うてただただ面倒にさしてどないなりますの。","说现在过度保护不行，\n但这个不行之处在于，\n主办方过度干预了行为本质的『思考解答这件事』，\n或是那些\n『为了通过装饰和花样与别家区分而附加的、\n与演出等本质无关的部分』，\n过度膨胀反而掩盖了本质，\n至于为了让行为更顺畅而进化的步骤嘛，\n说什么过去更好结果只是平添麻烦有啥意义嘛。"],["ええですか、\n過保護過ぎるからいうてわざと不便にすることはないんです。[l]\n●●な●に限って、\n本質を捉えてないからそういう遣り方をしなはったり、\nそのくせ演出やらの付け足し部分にばっかり眼ぇがいってね、\nデコレーションはえらい綺麗で手ぇが込んでて美味しそう、\nやけどスポンジ部分がハリボテとか上げ底のケーキを有り難がるような、\nそんなんは──\n","听好了，\n没必要因为太过度保护就故意搞得不方便。[l]\n偏偏是●●的●，\n因为没抓住本质才会搞这种操作，\n反而把注意力全放在演出之类的附加部分上，\n装饰搞得超精美做工考究看起来超美味，\n结果蛋糕胚是空壳或者垫高的玩意儿还当个宝，\n这种——\n"],["悪手です。","就是臭棋。"],["まあ、知ってて誤魔化しにつこうてる事もあるんですが。[l]\nあとは、そうやね、プロトタイプと量産型、果たしてどっちがええのか、\nそういう話もね、あるんですけど。[l]\nゲームとかやりますでしょ？[l]\n伝説の武器とか、強い装備は古いモンと、\nそういうお約束になってる事が多いでしょう。[l]\n現実の道具やら兵器でいうたら、\n単純に視て普通はそれこそ最新鋭が良さげに思えますな。[l]\n古くて価値でるんは骨董とか学術的資料性の高いモンとか……[l]\nま、ゲームとかの話やとね、\n要するに『過去に今より進んだ文明があった』ちゅう説明も出来ますよって、\nあとは最近はほんまに過去の技術の方が効率ええいうて、\n色々みなおされてる場合もありますし、\n一緒くたにするんは乱暴やけども。[l]\n本来ならば目的やら優先順位やらで考える事かも知れませんなぁ。","嘛，虽然也有明知是糊弄却故意为之的情况。[l]\n还有就是，嗯对啦，原型机和量产型，到底哪个更好，\n这类话题呢，也是存在的。[l]\n你们玩过游戏吧？[l]\n传说武器啊强力装备什么的，往往都是些老古董，\n这种套路很常见对吧。[l]\n但要是说到现实的道具或兵器，\n单纯来看通常都会觉得最新锐的更好吧。[l]\n老旧却有价值的都是古董或学术资料性强的玩意儿……[l]\n嘛，如果是游戏之类的设定，\n说白了就是可以用『过去存在比现在更先进的文明』来解释啦，\n而且最近确实有些古早技术效率更高，\n各种被重新审视的情况也有，\n混为一谈虽然粗暴了些。[l]\n本来或许该根据目的和优先级来考虑呢。"],["どっちにしてもやね、\nどうも、\nうちらとは見解の異なる方々が多くいらはりますようでねぃ。[l]\n悪いとは言いませんけど……ああ、悪手って言うてもうてるね、[l]\nま、きにせんとってくださいねぇ。","不管怎样啊，\n总觉得，\n和我们见解不同的人似乎特别多呢。[l]\n倒不是说不好……啊，您刚才说这是恶手对吧，[l]\n嘛，请别太在意啦。"],["ひとはみな、前の方がええ、いう事があるんは当然ですよぅ。[l]\n『慣れ』がありますからねぃ。","人们觉得从前更好也是很自然的嘛。[l]\n毕竟有『习惯』这个因素在呢。"],["ただ『それだけのこと』でもあるんですけどね？","不过『也就仅此而已』罢了？"],["やったら新し遣り方にもすぐ慣れるもんです。[l]\nヒト……いえ、生き物いうんはね、[l]\n対応して変化してくもんです。[l]\nしたたかです。[l]\nま、それを長いモンに巻かれるとか、\n自分というモンがないみたいな捉え方をすることもあるでしょし、\nそれも悪いとは言いません、言えませんねぇ。[l]\nただ、ま、そうやね、\n頑なに個を重んじるにも時と場合、\n社会構造と切れてるか切れてへんか……[l]\nまあ、柔軟にいったらええのと思いますよ。","真要尝试的话很快就能适应新方式的。[l]\n人类……不，生物这种东西啊，[l]\n本来就是会应对变化逐渐适应的。[l]\n很顽强的。[l]\n嘛，虽然也可能被漫长的时间裹挟，\n产生仿佛失去自我的认知方式，\n这也不算坏事，不如说没法断言是坏事呢。[l]\n只是，嗯对啦，\n过分固执地强调个性也要看时机场合，\n是否与社会结构脱节……[l]\n总之保持灵活就好啦。"],["ひとはそうそうお堅い存在じゃない筈なんです。","人类本不该是那么死板的存在。"],["それ以前にこのセカイはすっぱり割り切れるもんではないんよ。[l]\n清濁は常に……ああ、まだ難しいかもねぇ。[l]\nせやからうちが今長々言うてきたんもね、\n違うおもたら違うと思っておったらええんですよぅ。[l]\nただ、まあ、\n","更何况这个世界本来就不是非黑即白的。[l]\n清浊总是……啊，可能说得太深奥了。[l]\n所以我刚才长篇大论这些啊，\n觉得不对的话就当耳旁风就行啦。[l]\n不过嘛，\n"],["そういうわけでね。","就是这么回事。"],["あんお方は、\nどちらかいいますとね、\n──ま、●●な●……ですかねぃ。[l]\n今の話に関して言うと、これが融通が利かんいう話でね。[l]\nうちらだけやったら、こんな面倒なコトせんでもええねやろうけど、\n我ぁを通そうとするお人相手には、\nこっちが柔軟におるだけ損してしまいますなぁ。","那位大人呢，\n要说的话，\n──嘛，●●的●……是吧。[l]\n结合刚才的话题，这就是不懂变通的问题啦。[l]\n光是我们的话倒不必这么麻烦，\n但面对固执己见的人，\n单方面灵活应对只会吃亏呢。"],["さっきも言うたように、\nうちらはね、\n前に進むもんなんやと思うんです。[l]\n過去にしがみついて、幻でしかない過去の栄光にすがる老人に、\n古き良きという自己満足でしかない虚像の為に、\n足引っ張られるなんて以ての外でしょぅ？[l]\nそんな悪手は、","就像刚才说的，\n我们啊，\n认为应该不断向前迈进。[l]\n被沉溺过去、 clinging to illusory glory的老顽固们，\n为了所谓美好往昔的自我满足式幻象，\n拖后腿这种事绝对不可原谅对吧？[l]\n此等恶手，"],["通りません。","断难容忍。"],["せやから、","所以，"]],"context":[["SC_E_052.ks/index/1/text"],["SC_E_052.ks/index/4/text"],["SC_E_052.ks/index/6/text"],["SC_E_052.ks/index/8/text"],["SC_E_052.ks/index/10/text"],["SC_E_052.ks/index/12/text"],["SC_E_052.ks/index/15/text"],["SC_E_052.ks/index/17/text"],["SC_E_052.ks/index/20/text"],["SC_E_052.ks/index/22/text"],["SC_E_052.ks/index/24/text"],["SC_E_052.ks/index/26/text"],["SC_E_052.ks/index/28/text"],["SC_E_052.ks/index/30/text"],["SC_E_052.ks/index/32/text"],["SC_E_052.ks/index/34/text"],["SC_E_052.ks/index/36/text"],["SC_E_052.ks/index/38/text"],["SC_E_052.ks/index/40/text"],["SC_E_052.ks/index/42/text"],["SC_E_052.ks/index/44/text"],["SC_E_052.ks/index/46/text"],["SC_E_052.ks/index/48/text"],["SC_E_052.ks/index/50/text"],["SC_E_052.ks/index/53/text"],["SC_E_052.ks/index/55/text"],["SC_E_052.ks/index/57/text"],["SC_E_052.ks/index/59/text"],["SC_E_052.ks/index/61/text"],["SC_E_052.ks/index/63/text"],["SC_E_052.ks/index/65/text"],["SC_E_052.ks/index/67/text"],["SC_E_052.ks/index/69/text"],["SC_E_052.ks/index/71/text"],["SC_E_052.ks/index/73/text"],["SC_E_052.ks/index/75/text"],["SC_E_052.ks/index/77/text"],["SC_E_052.ks/index/79/text"],["SC_E_052.ks/index/81/text"],["SC_E_052.ks/index/83/text"],["SC_E_052.ks/index/85/text"],["SC_E_052.ks/index/87/text"],["SC_E_052.ks/index/89/text"],["SC_E_052.ks/index/91/text"],["SC_E_052.ks/index/93/text"],["SC_E_052.ks/index/95/text"],["SC_E_052.ks/index/97/text"],["SC_E_052.ks/index/99/text"],["SC_E_052.ks/index/102/text"],["SC_E_052.ks/index/104/text"],["SC_E_052.ks/index/106/text"],["SC_E_052.ks/index/108/text"],["SC_E_052.ks/index/110/text"],["SC_E_052.ks/index/112/text"],["SC_E_052.ks/index/114/text"],["SC_E_052.ks/index/116/text"],["SC_E_052.ks/index/119/text"],["SC_E_052.ks/index/121/text"],["SC_E_052.ks/index/123/text"],["SC_E_052.ks/index/125/text"],["SC_E_052.ks/index/127/text"]],"tags":[],"parameters":[[{"start":142,"end":215}],[{"start":225,"end":243}],[{"start":249,"end":317}],[{"start":323,"end":329}],[{"start":335,"end":349}],[{"start":355,"end":400}],[{"start":410,"end":426}],[{"start":432,"end":442}],[{"start":452,"end":537}],[{"start":553,"end":554}],[{"start":564,"end":565}],[{"start":575,"end":576}],[{"start":586,"end":587}],[{"start":597,"end":605}],[{"start":611,"end":872}],[{"start":878,"end":960}],[{"start":969,"end":970}],[{"start":980,"end":1152}],[{"start":1158,"end":1202}],[{"start":1208,"end":1296}],[{"start":1302,"end":1329}],[{"start":1335,"end":1476}],[{"start":1482,"end":1538}],[{"start":1544,"end":1619}],[{"start":1629,"end":1701}],[{"start":1707,"end":1755}],[{"start":1761,"end":1861}],[{"start":1867,"end":2000}],[{"start":2006,"end":2164}],[{"start":2170,"end":2189}],[{"start":2195,"end":2263}],[{"start":2272,"end":2273}],[{"start":2283,"end":2298}],[{"start":2304,"end":2322}],[{"start":2328,"end":2377}],[{"start":2383,"end":2481}],[{"start":2487,"end":2538}],[{"start":2548,"end":2549}],[{"start":2559,"end":2675}],[{"start":2681,"end":3048}],[{"start":3054,"end":3245}],[{"start":3251,"end":3429}],[{"start":3438,"end":3497}],[{"start":3508,"end":3597}],[{"start":3603,"end":4001}],[{"start":4007,"end":4083}],[{"start":4089,"end":4321}],[{"start":4327,"end":4529}],[{"start":4539,"end":4544}],[{"start":4550,"end":4976}],[{"start":4982,"end":5095}],[{"start":5101,"end":5151}],[{"start":5157,"end":5179}],[{"start":5185,"end":5443}],[{"start":5449,"end":5471}],[{"start":5477,"end":5605}],[{"start":5615,"end":5624}],[{"start":5630,"end":5794}],[{"start":5800,"end":5946}],[{"start":5954,"end":5960}],[{"start":5966,"end":5971}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_052.ks","basename":"SC_E_052.ks","indexIds":{"ヒトはまっとうに生きていれば、\nいえ、そんなに堅苦しい言い方せんでもね、\nただただ暮らしてるだけでもね、\n前に進むもの、\n":0,"精進、なんて大仰な言い方せんでもね。":1,"黙っとってもそうなるんが正道ですよぅ。[l]\nならんいうことは、よっぽど無自覚か、\nそん気がないぃゆうことですからねぃ。":2,"せやからね。":3,"懐古趣味……ならぬ懐古主義？":4,"どうもそういうんはこう、\nすっきりしませんねぇ、\nなんといいましょうか、\n":5,"旧き良きものなどありませんのに。":6,"そこがわからんと、\n":7,"自分の頭がやわぁかいときの初経験が、\nいいもんとして脳みそに銘記されとるだけ、\nだから誰でも自分の世代のが一番ええと、\n思うてしまうんですかねぃ。":8,"最":9,"初":10,"の":11,"衝":12,"撃勝ちですよぅ。":13,"第一印象いうんはなかなか拭えんもんでしょ？[l]\nそうでなくても、\nそん人にとってはそれ以降は全部、\n例え世に出た順序が逆だとしても、\n初回の二番煎じに視えてまう──事もあるわけやからね。[l]\nどの世代、どの世相に属してたかによって、\n周囲への同調、周りと同じ事してへんとコワイとか、\nはたまたその逆、同じ事するんがイヤやとか、\nま、どっちも自分と他という相対的な位置に眼ぇ向けてる話やよって、\n方向が真逆なだけでまあ、\n一緒の話ですねぇ。":14,"えぇとなんでしたっけね？[l]\nああ、\nだから特禁級とか使役場開放の話は抵抗なかったようですよぅ。[l]\nそそ、あれ。[l]\nあれも":15,"外":16,"法外道みたいなもんな筈やけどね。[l]\n結局はそういうことです。[l]\nヒトはみぃんな、自分が好しとするモンが是なんです。[l]\n論理的に詰めていったら理屈に合わんはずの事でも、\n本人の中ではアリなんですなぁ。[l]\nま、うちも含めてそうでないヒトの方が少ないでしょから、\nそこは責めんとってね。":17,"でもやね、\n古いモンがええと思い込んでまうんは、\nどうかと思いますなぁ。":18,"だってねぃ、\nおおきゅうなってから、\n例えば今スキなマンガとかテレビとか、ありますでしょ？[l]\nまたみてみ？[l]\nがっかりさせられますよぅ。":19,"想い出いうんはね、\n美化されるもんなんよねぇ。":20,"でも、\nそれが健全いうもんなんよ。[l]\nそうでなければ、\nそんひとは全然成長してへんことになりますよって、\n懐かしいと思うことはあっても、\n実際に『昔ならば好かった』いうことはそうそうない、\nいうんがま、うちの経験上はね、多いです。":21,"ああ、そうやねぇ、\n例えば肉体的な衰えが、\n物理的相対的に過去のがええ具合、いうんはありますよ。":22,"何にも考えんと『あえて昔のように』するんはね、\nうち的にはどうにもいただけませんなぁ。[l]\n約款やらシキタリ守るいうならまだしも、\n":23,"──ええ。[l]\n後ろからくるものへのやっかみかどうかは\nひとによりますやろけどね、\nそういう事はようあることなんです。":24,"でもやね、\n新しかろが古かろが、\n出来る人材と出来ない人材がいるだけなんですよ。":25,"昔がええとか、今のがええとか、\nちゃいますよ。そんなんは。[l]\n設問からしておかしな話ですやんか。[l]\n昔も今も、\n優秀なお方と●●な●がおるいうだけのことですわ。":26,"そこがわからんと、\n単に未成熟な時代のモノそのものを再現されても、\n当時を知るモンが懐かしむ以外になんの意味もありません。[l]\n『それが目的』ならええけどもね。[l]\nなんでもかんでも『古き良き』なんて修辞をつかうんは如何なものか。":27,"古き良き、というんはね、\n今の●●な●が視失うてる根源たる本質を、\nワカってるモンがきっちり汎用的に再現或いは応用できてる、\nそういう場合にのみ当てはまるコトバであって、\n古いモンが何時如何なる場合でもまるで優にあたるが如く振る舞われるのは、\nどうなんやろかと思う訳ですよぅ。":28,"色褪せない良さ──とかよう言いますな？":29,"それは付随的に説明されとりますように、\n時代を超えて変わらないモン、\nつまり普遍的、本質的な、\n『良さの良さたる":30,"所":31,"以のエッセンス』だから、です。":32,"『古いからええ』訳ではないですねぃ。":33,"そこを履き違えますとね、\n古い遣り方なら何でもええもんとゴカイする御仁も出て来ますのよぅ。":34,"ほんまにええとこは残して、\nちゃぁんと進化してるモノゴトもぎょうさんあるでしょ？[l]\nさっきも言うたけども、\nそのつもりでやっとったら前に進むんは自然の理ぃなんやからね。":35,"勿論、進化してるつもりが、\n理屈やら何やら捏ねくり回してるうちに、\n……誰かさんはＰの":36,"悪":37,"業と言うてましたかな、[l]\n良きエッセンスごと改変してもうて、\n結果改悪、いうモノゴトもありますからねぃ。[l]\nそういうのに限って、\n古き良き時代に戻ろ、いう話になるんですわ、\nところが。":38,"そもそもそのエッセンスがわからんとそうなった、\nその経過を知らん、いや、寧ろ知ったつもりになっとる輩が、\n良きエッセンスでなく、\n『なるべくしてなった進化を単に逆行』させて、\n昔はこうやったねぇ、というんです。[l]\nそういうんに限ってまた、\n例えばやけどね、名前やら呼び方やらの、\n本質とは違う部分、『がわ』の部分だけを古式ゆかしくしただけで、\n肝心のキモの部分はぜぇんぜん、別モンに変えてもうてるにも関わらず、\n原点回帰をうたってみたり、\n……まあ、『がわ』を守る価値観もあるにはありますけどね。[l]\nそん場合でも、\n大抵は『がわ』しかないモンの場合ですわ。[l]\nちゃあんと『ミ』もある場合は、\n……どやろうねぇ。":39,"改悪いうのはたいがい、\n過保護になってもうてる感じの場合です。[l]\n幾らヒトが──いえ、生き物が常に、水が低いところに流れるよに、\n兎に角ラクに、楽になろうとするいうてもね、\nせやねえ、\n例えば、解答をスキなときにすぐ教えてくれるクイズ、\n頼んでへんのに司会から答えぇ言われるような状態は、\nもう遊戯でもなんでもないやねぇ？":40,"現状を過保護思ぅてるんはまあええとしましょか、\n実際今言ったような、行為の本末転倒はようあることですよぅ。[l]\nだからといって、\nそれを昔に戻すいうて、\nクイズの出題行為自体にいらん手続きつくるとか──\n例えば必ず出題に五分十分かかるとか、\n解答は口頭でなく手で紙に書かなあかんとか、\nしかもその紙":41,"漉いてこいとか墨すって筆で書くとこから始めぃとか、\nあとはそやねぇ、\n問題なり出題場所がえらい遠い所に":42,"設えてあって、\nそこまで絶対徒歩で行かなあかん、自転車車電車も通信機器も駄目、\nとか言い出すような──そういう、\n面倒なんが古き良き在り方ではないですよ。":43,"そういうんは単なる時間稼ぎにしかならんし、\nほんまにただただ時間使わせたいだけ言うなら別やね、\n……ま、後は肉体使わす事自体が目的とか、主旨がずれてる場合もあるやろけど、[l]\nそういうんは『やらせたいのはクイズではない』んやろから仕方在りません、\nで済ますほかないですけどねぃ。[l]\nそういうんはまあ、また別の次元の話でね。[l]\n本質だけ残しても飾りやらで飽きがこんようにする工夫は必要、\nていうんはワカりますね？[l]\nさっきも言ったちゃんと前に進むべくして成る変化はあるんです。[l]\n演出なんかを派手にしたり綺麗にしたり、\n司会者や回答者をみんながよう知ってるひとにするとか、\nうちも今ぱっ……と思いつく手段はそんなとこですがね、[l]\nま、今してるんは例えの話ですから気にせんとってね。":44,"で、\nクイズっていうんはね、\n問題聞いて、それを理屈捏ねたり、前もって増やしといた知識やらで、\nほんで解くんが行為の本質でしょ？":45,"今の過保護があかんいうても、\nそのあかんところは、\n行為の本質たる『解答を考えるという事』を、\n主催がフォローしすぎてるトコやら、\n『装飾やヴァリエーションとして余所と差別化する為に付け足した、\n演出やら何やらの本質とは無関係の部分』が、\n肥大化しすぎて本質を隠してもうたトコであって、\n行為を円滑に行うために進化させてきた手順やらをやね、\n昔は善かったぁ言うてただただ面倒にさしてどないなりますの。":46,"ええですか、\n過保護過ぎるからいうてわざと不便にすることはないんです。[l]\n●●な●に限って、\n本質を捉えてないからそういう遣り方をしなはったり、\nそのくせ演出やらの付け足し部分にばっかり眼ぇがいってね、\nデコレーションはえらい綺麗で手ぇが込んでて美味しそう、\nやけどスポンジ部分がハリボテとか上げ底のケーキを有り難がるような、\nそんなんは──\n":47,"悪手です。":48,"まあ、知ってて誤魔化しにつこうてる事もあるんですが。[l]\nあとは、そうやね、プロトタイプと量産型、果たしてどっちがええのか、\nそういう話もね、あるんですけど。[l]\nゲームとかやりますでしょ？[l]\n伝説の武器とか、強い装備は古いモンと、\nそういうお約束になってる事が多いでしょう。[l]\n現実の道具やら兵器でいうたら、\n単純に視て普通はそれこそ最新鋭が良さげに思えますな。[l]\n古くて価値でるんは骨董とか学術的資料性の高いモンとか……[l]\nま、ゲームとかの話やとね、\n要するに『過去に今より進んだ文明があった』ちゅう説明も出来ますよって、\nあとは最近はほんまに過去の技術の方が効率ええいうて、\n色々みなおされてる場合もありますし、\n一緒くたにするんは乱暴やけども。[l]\n本来ならば目的やら優先順位やらで考える事かも知れませんなぁ。":49,"どっちにしてもやね、\nどうも、\nうちらとは見解の異なる方々が多くいらはりますようでねぃ。[l]\n悪いとは言いませんけど……ああ、悪手って言うてもうてるね、[l]\nま、きにせんとってくださいねぇ。":50,"ひとはみな、前の方がええ、いう事があるんは当然ですよぅ。[l]\n『慣れ』がありますからねぃ。":51,"ただ『それだけのこと』でもあるんですけどね？":52,"やったら新し遣り方にもすぐ慣れるもんです。[l]\nヒト……いえ、生き物いうんはね、[l]\n対応して変化してくもんです。[l]\nしたたかです。[l]\nま、それを長いモンに巻かれるとか、\n自分というモンがないみたいな捉え方をすることもあるでしょし、\nそれも悪いとは言いません、言えませんねぇ。[l]\nただ、ま、そうやね、\n頑なに個を重んじるにも時と場合、\n社会構造と切れてるか切れてへんか……[l]\nまあ、柔軟にいったらええのと思いますよ。":53,"ひとはそうそうお堅い存在じゃない筈なんです。":54,"それ以前にこのセカイはすっぱり割り切れるもんではないんよ。[l]\n清濁は常に……ああ、まだ難しいかもねぇ。[l]\nせやからうちが今長々言うてきたんもね、\n違うおもたら違うと思っておったらええんですよぅ。[l]\nただ、まあ、\n":55,"そういうわけでね。":56,"あんお方は、\nどちらかいいますとね、\n──ま、●●な●……ですかねぃ。[l]\n今の話に関して言うと、これが融通が利かんいう話でね。[l]\nうちらだけやったら、こんな面倒なコトせんでもええねやろうけど、\n我ぁを通そうとするお人相手には、\nこっちが柔軟におるだけ損してしまいますなぁ。":57,"さっきも言うたように、\nうちらはね、\n前に進むもんなんやと思うんです。[l]\n過去にしがみついて、幻でしかない過去の栄光にすがる老人に、\n古き良きという自己満足でしかない虚像の為に、\n足引っ張られるなんて以ての外でしょぅ？[l]\nそんな悪手は、":58,"通りません。":59,"せやから、":60},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_052.ks","relPath":"/data/scenario/SC_E_052.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":61,"length":61,"percent":100},"cellInfo":[]},"/data/scenario/SC_E_053.ks":{"data":[["このクライ空間に、\n","才会在这个 cry 空间里，\n"],["随分と長い間、\n","停留了，\n"],["留まっていたのですね。","相当漫长的时光。"],["過ぎたる光も真の闇と同様に眼を眩ますもの、\n","过分的光明与真正的黑暗同样令人目眩，\n"],["いずれもひとつの安らぎの在り方と言えましょう。","或许都是安息的不同形态。"],["すべてに眼を瞑るも、ミの処し方としては、\n","闭目无视一切，作为处置方式，\n"],["●●●●●ですよ。","●●●●●哟。"],["さて、\n","那么，\n"],["気分は如何です。","心情如何。"],["ちゃんとメザメていますか？","有好好苏醒过来吗？"],["………。",""],["初めまして……？","初次见面……？"],["いえ。私達はもう何度も会っていますよ。","不。我们已经见过很多次了哟。"],["そう、\n","没错，\n"],["そうです。","就是这样。"],["私です。覚えていますね？","是我。还记得吗？"],["お久しぶりです。","好久不见。"],["──。",""],["まだ瑣末な混乱はあれど、\n","虽然还有些琐碎的混乱，\n"],["どうやら、思い出してきたようですね、\n","看来，你似乎逐渐想起来了，\n"],["不正操作されていた部分の記憶の恢復はメザましい。[l]\n結構ですよ。[l]\n今までの経過から視るにやや急……唐突とも思える程です。[l]\n時此処に至って急激に、\n","被非法操作的那部分记忆恢复得真令人欣慰。[l]\n没关系哟。[l]\n从迄今为止的经过来看稍显急促……甚至让人觉得有些唐突。[l]\n时至此刻突然，\n"],["いえ、勿論、","不，当然，"],["好きコトですよ。[l]\nただ──何か","我很喜欢这样。[l]\n只是──有什么"],["契","契"],["機でも？[l]\n誰かがあなたに真実の一端でも告げましたか。","机吗？[l]\n莫非有人向你透露了部分真相。"],["いえ、\n確認です。単なるね。[l]\nそうですか。[l]\nなのであれば。","不，\n只是确认。随口问问罢了。[l]\n这样啊。[l]\n如果是这样的话。"],["やはり雫の波紋、その","果然水滴的波纹，那"],["漣が、\n","涟漪，\n"],["深","深"],["泥さざめかし、\n","搅动泥淖，\n"],["萎れ","使枯萎"],["靡かぬ旗をもふるいたたせ。[l]\n錆び付いた歯車に油差す、\n一滴、それは物語の中心に落つ、\nひとによりては","让不飘扬的旗帜也猎猎作响。[l]\n给生锈的齿轮上油，\n一滴，它落在故事的中心，\n对某些人而言"],["乾","干"],["坤","坤"],["一",""],["擲の──\n","掷的──\n"],["おや、まだ混乱が収まった訳ではないですか。[l]\n整然要素たる記憶の処理は兎も角も、\n心身の","哎呀，看来混乱还没有完全平息呢。[l]\n井然有序的记忆处理姑且不论，\n身心的"],["瑕","瑕"],["疵修繕は簡単には行きませんか。[l]\n","疵修复可没那么容易吧。[l]\n"],["如","如"],["何せん","毕竟"],["謀られていた時が永すぎた様ですね。[l]\nまあ、それも十全なるＣＡＴのチカラを取り戻せれば、\n瑣末な","被算计的时间似乎太长了点呢。[l]\n不过，只要能完全取回CAT的力量，\n这些琐碎的"],["コトガラと成り果てましょう。","小事终将不成问题。"],["今暫くの辛抱ですよ。","暂时再忍耐一下吧。"],["かならずあなたは十全の、\n","你一定会完全恢复，\n"],["……ええ、そのヤクをふられた者ですから。","……嗯，毕竟你是被下了那种药的人啊。"],["おや、\nえもいわれぬ、\n","哎呀，\n难以言喻的，\n"],["●●な感情が、\n","●●的感情，\n"],["ああ、それも","啊，那也"],["好きコトですよ。[l]\n●●は源泉として、\n大変に有用、効率の良いもので、\n","我很喜欢。[l]\n●●作为源泉，\n是非常有用、效率极高的东西，\n"],["catalysis……",""],["……？",""],["寧ろ、イカリ？[l]\nにくしみ？[l]\nあなたにイツワりをふきこんだものへの？","倒不如说，愤怒？[l]\n憎恨？[l]\n对向你灌输伊兹瓦的那些人的？"],["妬か、\n","嫉妒吗，\n"],["まあ、それは今は未だ蓄積して置いてください。[l]\n向けるべき対象については追追お話しましょう。[l]\nですから、\n","嘛，那些现在还请继续积累着吧。[l]\n关于该指向的对象我们会慢慢详谈。[l]\n所以说，\n"],["まだ、休んでおきましょうか。[l]\nもう少しばかり、\n出番までは時があるのですよ。[l]\nその時が来れば、否応無く喚び出されるのですしね──\n","还是先休息一下吧。[l]\n距离登场\n还有些时间呢。[l]\n等到那时，就会被不由分说地召唤出来──\n"],["──ああ、\nほら、\nさあ、\n感じませんか。","──啊啊，\n你看，\n来吧，\n感觉到了吗。"],["あなたに近しい","与你亲近的"],["旧き","古老"],["朋が、\n近くに来ている。[l]\nあなたをたすけてくれるひとりです。[l]\n他にも幾人か、\n","友人，\n正在靠近。[l]\n是来助你一臂之力的人。[l]\n除此之外还有几位，\n"],["ええ。","嗯。"],["あなたがたの復権も間近ですね。","你们东山再起的日子也近在眼前了。"],["ニクキモノを払い除け、\n","扫除那些碍眼的家伙，\n"],["本来の──いえ、それ以上の存在に、\n","回归原本──不，成为更超然的存在，\n"],["その通過儀礼において、\n","在这场成人礼中，\n"],["あなたとそこのそれは、\n","你和那位，\n"],["かけまくもすばらしき、──\n","将会成就无上荣光──\n"],["（……或いは、[l]ひとばしら。）","（……亦或是，[l]独木难支。）"]],"context":[["SC_E_053.ks/index/1/text"],["SC_E_053.ks/index/4/text"],["SC_E_053.ks/index/7/text"],["SC_E_053.ks/index/9/text"],["SC_E_053.ks/index/12/text"],["SC_E_053.ks/index/14/text"],["SC_E_053.ks/index/17/text"],["SC_E_053.ks/index/19/text"],["SC_E_053.ks/index/22/text"],["SC_E_053.ks/index/24/text"],["SC_E_053.ks/index/26/text"],["SC_E_053.ks/index/28/text"],["SC_E_053.ks/index/30/text"],["SC_E_053.ks/index/32/text"],["SC_E_053.ks/index/35/text"],["SC_E_053.ks/index/37/text"],["SC_E_053.ks/index/39/text"],["SC_E_053.ks/index/41/text","SC_E_053.ks/index/43/text","SC_E_053.ks/index/45/text"],["SC_E_053.ks/index/47/text"],["SC_E_053.ks/index/50/text"],["SC_E_053.ks/index/53/text"],["SC_E_053.ks/index/56/text"],["SC_E_053.ks/index/58/text"],["SC_E_053.ks/index/60/text"],["SC_E_053.ks/index/62/text"],["SC_E_053.ks/index/64/text"],["SC_E_053.ks/index/66/text"],["SC_E_053.ks/index/68/text"],["SC_E_053.ks/index/71/text"],["SC_E_053.ks/index/73/text"],["SC_E_053.ks/index/76/text"],["SC_E_053.ks/index/78/text"],["SC_E_053.ks/index/80/text"],["SC_E_053.ks/index/82/text"],["SC_E_053.ks/index/84/text"],["SC_E_053.ks/index/86/text"],["SC_E_053.ks/index/89/text"],["SC_E_053.ks/index/91/text"],["SC_E_053.ks/index/93/text"],["SC_E_053.ks/index/96/text"],["SC_E_053.ks/index/98/text"],["SC_E_053.ks/index/100/text"],["SC_E_053.ks/index/102/text"],["SC_E_053.ks/index/104/text"],["SC_E_053.ks/index/106/text"],["SC_E_053.ks/index/109/text"],["SC_E_053.ks/index/111/text"],["SC_E_053.ks/index/114/text"],["SC_E_053.ks/index/117/text"],["SC_E_053.ks/index/119/text"],["SC_E_053.ks/index/122/text"],["SC_E_053.ks/index/124/text"],["SC_E_053.ks/index/126/text"],["SC_E_053.ks/index/128/text"],["SC_E_053.ks/index/131/text"],["SC_E_053.ks/index/134/text"],["SC_E_053.ks/index/137/text"],["SC_E_053.ks/index/139/text"],["SC_E_053.ks/index/141/text"],["SC_E_053.ks/index/143/text"],["SC_E_053.ks/index/146/text"],["SC_E_053.ks/index/148/text"],["SC_E_053.ks/index/150/text"],["SC_E_053.ks/index/153/text"],["SC_E_053.ks/index/156/text"],["SC_E_053.ks/index/159/text"],["SC_E_053.ks/index/162/text"],["SC_E_053.ks/index/165/text"]],"tags":[],"parameters":[[{"start":127,"end":137}],[{"start":147,"end":155}],[{"start":165,"end":176}],[{"start":182,"end":204}],[{"start":214,"end":237}],[{"start":243,"end":264}],[{"start":274,"end":283}],[{"start":289,"end":293}],[{"start":303,"end":311}],[{"start":317,"end":330}],[{"start":336,"end":340}],[{"start":346,"end":354}],[{"start":360,"end":379}],[{"start":385,"end":389}],[{"start":399,"end":404}],[{"start":410,"end":422}],[{"start":428,"end":436}],[{"start":442,"end":445},{"start":451,"end":454},{"start":460,"end":463}],[{"start":469,"end":482}],[{"start":492,"end":511}],[{"start":521,"end":614}],[{"start":624,"end":630}],[{"start":639,"end":661}],[{"start":671,"end":672}],[{"start":682,"end":715}],[{"start":721,"end":768}],[{"start":774,"end":784}],[{"start":796,"end":800}],[{"start":813,"end":814}],[{"start":824,"end":832}],[{"start":846,"end":848}],[{"start":858,"end":923}],[{"start":933,"end":934}],[{"start":944,"end":945}],[{"start":955,"end":956}],[{"start":966,"end":971}],[{"start":981,"end":1035}],[{"start":1044,"end":1045}],[{"start":1054,"end":1073}],[{"start":1087,"end":1088}],[{"start":1097,"end":1100}],[{"start":1111,"end":1169}],[{"start":1194,"end":1208}],[{"start":1214,"end":1224}],[{"start":1230,"end":1243}],[{"start":1253,"end":1273}],[{"start":1279,"end":1295}],[{"start":1305,"end":1313}],[{"start":1323,"end":1329}],[{"start":1338,"end":1384}],[{"start":1394,"end":1405}],[{"start":1411,"end":1414}],[{"start":1420,"end":1467}],[{"start":1473,"end":1477}],[{"start":1487,"end":1553}],[{"start":1563,"end":1646}],[{"start":1656,"end":1689}],[{"start":1695,"end":1702}],[{"start":1712,"end":1714}],[{"start":1724,"end":1781}],[{"start":1791,"end":1794}],[{"start":1800,"end":1815}],[{"start":1821,"end":1833}],[{"start":1843,"end":1861}],[{"start":1871,"end":1883}],[{"start":1893,"end":1905}],[{"start":1915,"end":1929}],[{"start":1989,"end":2006}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_053.ks","basename":"SC_E_053.ks","indexIds":{"このクライ空間に、\n":0,"随分と長い間、\n":1,"留まっていたのですね。":2,"過ぎたる光も真の闇と同様に眼を眩ますもの、\n":3,"いずれもひとつの安らぎの在り方と言えましょう。":4,"すべてに眼を瞑るも、ミの処し方としては、\n":5,"●●●●●ですよ。":6,"さて、\n":7,"気分は如何です。":8,"ちゃんとメザメていますか？":9,"………。":10,"初めまして……？":11,"いえ。私達はもう何度も会っていますよ。":12,"そう、\n":13,"そうです。":14,"私です。覚えていますね？":15,"お久しぶりです。":16,"──。":17,"まだ瑣末な混乱はあれど、\n":18,"どうやら、思い出してきたようですね、\n":19,"不正操作されていた部分の記憶の恢復はメザましい。[l]\n結構ですよ。[l]\n今までの経過から視るにやや急……唐突とも思える程です。[l]\n時此処に至って急激に、\n":20,"いえ、勿論、":21,"好きコトですよ。[l]\nただ──何か":22,"契":23,"機でも？[l]\n誰かがあなたに真実の一端でも告げましたか。":24,"いえ、\n確認です。単なるね。[l]\nそうですか。[l]\nなのであれば。":25,"やはり雫の波紋、その":26,"漣が、\n":27,"深":28,"泥さざめかし、\n":29,"萎れ":30,"靡かぬ旗をもふるいたたせ。[l]\n錆び付いた歯車に油差す、\n一滴、それは物語の中心に落つ、\nひとによりては":31,"乾":32,"坤":33,"一":34,"擲の──\n":35,"おや、まだ混乱が収まった訳ではないですか。[l]\n整然要素たる記憶の処理は兎も角も、\n心身の":36,"瑕":37,"疵修繕は簡単には行きませんか。[l]\n":38,"如":39,"何せん":40,"謀られていた時が永すぎた様ですね。[l]\nまあ、それも十全なるＣＡＴのチカラを取り戻せれば、\n瑣末な":41,"コトガラと成り果てましょう。":42,"今暫くの辛抱ですよ。":43,"かならずあなたは十全の、\n":44,"……ええ、そのヤクをふられた者ですから。":45,"おや、\nえもいわれぬ、\n":46,"●●な感情が、\n":47,"ああ、それも":48,"好きコトですよ。[l]\n●●は源泉として、\n大変に有用、効率の良いもので、\n":49,"catalysis……":50,"……？":51,"寧ろ、イカリ？[l]\nにくしみ？[l]\nあなたにイツワりをふきこんだものへの？":52,"妬か、\n":53,"まあ、それは今は未だ蓄積して置いてください。[l]\n向けるべき対象については追追お話しましょう。[l]\nですから、\n":54,"まだ、休んでおきましょうか。[l]\nもう少しばかり、\n出番までは時があるのですよ。[l]\nその時が来れば、否応無く喚び出されるのですしね──\n":55,"──ああ、\nほら、\nさあ、\n感じませんか。":56,"あなたに近しい":57,"旧き":58,"朋が、\n近くに来ている。[l]\nあなたをたすけてくれるひとりです。[l]\n他にも幾人か、\n":59,"ええ。":60,"あなたがたの復権も間近ですね。":61,"ニクキモノを払い除け、\n":62,"本来の──いえ、それ以上の存在に、\n":63,"その通過儀礼において、\n":64,"あなたとそこのそれは、\n":65,"かけまくもすばらしき、──\n":66,"（……或いは、[l]ひとばしら。）":67},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_053.ks","relPath":"/data/scenario/SC_E_053.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":63,"length":68,"percent":92.64705882352942},"cellInfo":[]},"/data/scenario/SC_E_054.ks":{"data":[["閉ざされたハコについての話をしよう。","来说说关于封闭之箱的故事吧。"],["多分キミも知ってるだろうけど。","虽然你可能也听说过。"],["異説諸々あるだろうが、\nボク等のお気に入りの型は次のようなものでね。","虽然存在各种不同说法，\n但我们钟意的版本是这样的。"],["ああ、その前に。","啊，在此之前。"],["そう。","对了。"],["人口に膾炙しているものは、\nその意図が『どちら』なのかよく判らないだろう。[l]\nボクが寡聞にして知らないだけかもだがね。","广为流传的那个版本，\n根本搞不清其意图是『哪一种』吧。[l]\n也可能是我孤陋寡闻了。"],["何故って、災厄が世に放たれて実害を及ぼしているのなら、\nハコの底に希望が残ったとて、\nつまりセカイに希望は無いというコトになるよね？","你想啊，如果灾祸已肆虐世间造成实际危害，\n就算箱底还留有希望，\n不就等于说这世界根本没有希望吗？"],["まあ、つまりそういうペシミズムな話だというなら話は早いが、\nどうも、\nそういう訳でもないじゃないか。[l]\nどちらかと言えば肯定的に捉えられるだろう、あの話は。","当然，如果这纯粹是个悲观主义故事倒简单了，\n但总觉得，\n似乎并非如此呢。[l]\n要说的话那个故事应该能被积极解读吧。"],["単に事実……というと語弊があるかも知れないが、[l]\n単なる『話』に後代のヒトが勝手に意味づけをした、\nその『作家』達の解釈の違いなだけかも知れないけどね。[l]\nそもそもおきたデキゴト自体には、\n深い意味は無いのかも知れないな。","单纯的事实……这么说可能不太准确，[l]\n或许是后世之人擅自给单纯的『故事』赋予意义，\n只是那些『作家』们的解读不同罢了。[l]\n说到底事件本身，\n或许并没有深层含义。"],["まあ、仮にあの話が、\n何らかの結果や現象が先にありき、\nその説明体系としてのマイソロジーだとすれば、\nオハナシとしての結構性や解釈について深く探る意味も無為というもの。[l]\nだからこれはいつものように、\nボク等の思考遊戯の類と思ってくれればいい。","不过假设那个故事，\n是先有某种结果或现象，\n再作为解释体系而生的神话的话，\n深究其故事结构与解读意义就显得徒劳了。[l]\n所以这次也和往常一样，\n就当是我们的小脑洞游戏就好。"],["ああ、それでね。[l]\nボク等のスキな解釈というのは、\n","啊，说到这个。[l]\n我们喜欢的解读是，\n"],["箱の中に残り世に放たれなかったのは","箱中残留未释放于世的是"],["前","前"],["兆であって、\nつまり先のコトが一切予知出来なくなったコトが、\n即ち「希望」だ。","兆，\n亦即完全无法预知未来之事，\n这本身就是「希望」。"],["という型。","这样的版本。"],["ネタバレをよしとせず、\n突発的イベントを愉悦として重んじる、\n我等には、\nまあその不確定性の云々も込みでね、\n大変興味深い……というか、[l]\nシンパシーをもてる思考経路だと思うよ。","不喜剧透，\n崇尚突发事件的愉悦性，\n对我们而言，\n当然也包括那份不确定性，\n非常有趣……或者说，[l]\n是能产生共鸣的思考路径。"],["しかし同時に、\n","但与此同时，\n"],["ボク等は閉ざされたハコを開ける者でもある。","我们也是开启封闭之箱的人。"],["矛盾しているようだが、\n同時に成り立ちうる、而して一見相反する要素というのは、\nセカイに氾濫しているんだよ。[l]\nそれらの視極めが出来るようにならねばね。","虽然看似矛盾，\n但同时成立的、乍看相互对立的要素，\n在这世上比比皆是哟。[l]\n必须练就看透这些的本事才行啊。"],["モノゴトを単純化し縦割りのカテゴライズをして満足出来る位置にいてはならない。","不能停留在将事物简单化分门别类就满足的位置上。"],["ツールは場に応じて使い分けるのがよい。","工具要根据场合灵活使用才好。"],["頑なであるな、[l]\n柔軟であれ、[l]\nヤワらかきことは壊れぬことでもある、\n","别太顽固，[l]\n要懂得变通，[l]\n柔软之物反而难以损毁，\n"],["そしてそれでもなお、不変ではなく成長を。","即便如此仍要追求成长而非不变。"],["つまり、\nだから、\n","也就是说，\n所以说，\n"],["そう、\n","没错，\n"],["……ああ、もう寝てしまったかい。","……啊，已经睡着了么。"],["つまりだから、\n","也就是说所以，\n"],["コトバでは決して伝わらぬコトがあるんだ、\n","有些事是言语绝对无法传达的，\n"],["喧","喧"],["伝してはならぬコトがあるんだ、\n第三の眼に","有些事是不该传达的，\n向第三只眼"],["曝され『要らぬもの（P's Sense Of Value）』に心乱されぬよう、\n建前本音判例言い訳を混同しないよう、\n己のカラダでワカル必要がある。","暴露『多余之物（P's Sense Of Value）』而不被扰乱心神，\n不混淆场面话真心话判例借口，\n必须用身体去理解。"],["ああそうだよ、\n","啊没错，\n"],["ボクはキミに、コトバ無しに伝えなければならない、\n","我必须不用言语向你传达，\n"],["ヒト以外のように。","就像非人类那样。"],["出来れば自力で学んで欲しかったが、\n","本希望你能自行领悟，\n"],["はじまりがあやまちであるならば、\n","若开端就是错误的话，\n"],["これもまたボクに課せられた──\n","这也是赋予我的——\n"]],"context":[["SC_E_054.ks/index/1/text"],["SC_E_054.ks/index/3/text"],["SC_E_054.ks/index/5/text"],["SC_E_054.ks/index/7/text"],["SC_E_054.ks/index/9/text"],["SC_E_054.ks/index/11/text"],["SC_E_054.ks/index/13/text"],["SC_E_054.ks/index/15/text"],["SC_E_054.ks/index/17/text"],["SC_E_054.ks/index/19/text"],["SC_E_054.ks/index/21/text"],["SC_E_054.ks/index/24/text"],["SC_E_054.ks/index/26/text"],["SC_E_054.ks/index/28/text"],["SC_E_054.ks/index/30/text"],["SC_E_054.ks/index/32/text"],["SC_E_054.ks/index/34/text"],["SC_E_054.ks/index/37/text"],["SC_E_054.ks/index/39/text"],["SC_E_054.ks/index/41/text"],["SC_E_054.ks/index/43/text"],["SC_E_054.ks/index/45/text"],["SC_E_054.ks/index/48/text"],["SC_E_054.ks/index/50/text"],["SC_E_054.ks/index/53/text","SC_E_054.ks/index/58/text"],["SC_E_054.ks/index/56/text"],["SC_E_054.ks/index/61/text"],["SC_E_054.ks/index/64/text"],["SC_E_054.ks/index/67/text"],["SC_E_054.ks/index/69/text"],["SC_E_054.ks/index/71/text"],["SC_E_054.ks/index/73/text"],["SC_E_054.ks/index/76/text"],["SC_E_054.ks/index/79/text"],["SC_E_054.ks/index/81/text"],["SC_E_054.ks/index/84/text"],["SC_E_054.ks/index/87/text"]],"tags":[],"parameters":[[{"start":179,"end":197}],[{"start":203,"end":218}],[{"start":224,"end":262}],[{"start":268,"end":276}],[{"start":282,"end":285}],[{"start":291,"end":360}],[{"start":366,"end":440}],[{"start":448,"end":540}],[{"start":548,"end":679}],[{"start":687,"end":831}],[{"start":839,"end":871}],[{"start":881,"end":898}],[{"start":908,"end":909}],[{"start":919,"end":966}],[{"start":972,"end":977}],[{"start":983,"end":1094}],[{"start":1100,"end":1108}],[{"start":1118,"end":1139}],[{"start":1145,"end":1235}],[{"start":1241,"end":1279}],[{"start":1285,"end":1304}],[{"start":1310,"end":1358}],[{"start":1368,"end":1388}],[{"start":1394,"end":1408}],[{"start":1418,"end":1422},{"start":1454,"end":1458}],[{"start":1432,"end":1448}],[{"start":1468,"end":1476}],[{"start":1486,"end":1507}],[{"start":1522,"end":1523}],[{"start":1534,"end":1559}],[{"start":1569,"end":1651}],[{"start":1657,"end":1665}],[{"start":1675,"end":1700}],[{"start":1710,"end":1719}],[{"start":1725,"end":1743}],[{"start":1753,"end":1770}],[{"start":1780,"end":1796}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_054.ks","basename":"SC_E_054.ks","indexIds":{"閉ざされたハコについての話をしよう。":0,"多分キミも知ってるだろうけど。":1,"異説諸々あるだろうが、\nボク等のお気に入りの型は次のようなものでね。":2,"ああ、その前に。":3,"そう。":4,"人口に膾炙しているものは、\nその意図が『どちら』なのかよく判らないだろう。[l]\nボクが寡聞にして知らないだけかもだがね。":5,"何故って、災厄が世に放たれて実害を及ぼしているのなら、\nハコの底に希望が残ったとて、\nつまりセカイに希望は無いというコトになるよね？":6,"まあ、つまりそういうペシミズムな話だというなら話は早いが、\nどうも、\nそういう訳でもないじゃないか。[l]\nどちらかと言えば肯定的に捉えられるだろう、あの話は。":7,"単に事実……というと語弊があるかも知れないが、[l]\n単なる『話』に後代のヒトが勝手に意味づけをした、\nその『作家』達の解釈の違いなだけかも知れないけどね。[l]\nそもそもおきたデキゴト自体には、\n深い意味は無いのかも知れないな。":8,"まあ、仮にあの話が、\n何らかの結果や現象が先にありき、\nその説明体系としてのマイソロジーだとすれば、\nオハナシとしての結構性や解釈について深く探る意味も無為というもの。[l]\nだからこれはいつものように、\nボク等の思考遊戯の類と思ってくれればいい。":9,"ああ、それでね。[l]\nボク等のスキな解釈というのは、\n":10,"箱の中に残り世に放たれなかったのは":11,"前":12,"兆であって、\nつまり先のコトが一切予知出来なくなったコトが、\n即ち「希望」だ。":13,"という型。":14,"ネタバレをよしとせず、\n突発的イベントを愉悦として重んじる、\n我等には、\nまあその不確定性の云々も込みでね、\n大変興味深い……というか、[l]\nシンパシーをもてる思考経路だと思うよ。":15,"しかし同時に、\n":16,"ボク等は閉ざされたハコを開ける者でもある。":17,"矛盾しているようだが、\n同時に成り立ちうる、而して一見相反する要素というのは、\nセカイに氾濫しているんだよ。[l]\nそれらの視極めが出来るようにならねばね。":18,"モノゴトを単純化し縦割りのカテゴライズをして満足出来る位置にいてはならない。":19,"ツールは場に応じて使い分けるのがよい。":20,"頑なであるな、[l]\n柔軟であれ、[l]\nヤワらかきことは壊れぬことでもある、\n":21,"そしてそれでもなお、不変ではなく成長を。":22,"つまり、\nだから、\n":23,"そう、\n":24,"……ああ、もう寝てしまったかい。":25,"つまりだから、\n":26,"コトバでは決して伝わらぬコトがあるんだ、\n":27,"喧":28,"伝してはならぬコトがあるんだ、\n第三の眼に":29,"曝され『要らぬもの（P's Sense Of Value）』に心乱されぬよう、\n建前本音判例言い訳を混同しないよう、\n己のカラダでワカル必要がある。":30,"ああそうだよ、\n":31,"ボクはキミに、コトバ無しに伝えなければならない、\n":32,"ヒト以外のように。":33,"出来れば自力で学んで欲しかったが、\n":34,"はじまりがあやまちであるならば、\n":35,"これもまたボクに課せられた──\n":36},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_054.ks","relPath":"/data/scenario/SC_E_054.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":37,"length":37,"percent":100},"cellInfo":[]},"/data/scenario/SC_E_055.ks":{"data":[["ちくしょーが、\nやっぱりだめだ、\n忘れられるかあんなこと！！！","可恶，\n果然还是不行，\n怎么可能忘记那种事！！！"],["「いらいらいらいらいらいらするっ！」","「烦死了烦死了烦死了烦死了烦死了！」"],["例えば、\n　","比如说，\n　"],["何でも","并非"],["彼でも新しければ良いというものでもないよ。[l]\n　新機軸……という名目で打ち出される諸々のコトガラ、[l]\n　あるだろう。[l]\n　『真に新機軸』なのか、つまりそれまで全く思いも寄らなかった、[l]\n　それ以前よりもベターなものなのか、は、[l]\n　まあ、即座には判断出来ないんだろうが、[l]\n","只要是新的连他都可以接受啊。[l]\n　打着新创意……名号推出的种种事物，[l]\n　确实存在吧。[l]\n　究竟是『真正的新创意』，即完全超乎想象的，[l]\n　还是比从前更好的东西，这个嘛，[l]\n　虽然无法立刻判断，[l]\n"],["単に、今までも発案されていたものの、[l]\n　検討の上で既にいただけないモノとして廃棄されてきた案だとしたら？","但如果只是过去就有人提出过，[l]\n　经讨论后已被判定为不可取的废弃方案呢？"],["今まで世に出なかったのには相応の理由があるとしたら？","如果至今未问世是有相应理由的呢？"],["やってみなければわからない、[l]\n　それはそうだけどね。[l]\n　先人の","不尝试就不会知道，[l]\n　话是这么说没错啦。[l]\n　也没必要"],["智","特"],["慧をわざわざ軽んじる事もないかな。[l]\n　とは言え、[l]\n　時は移ろうものだからね。[l]\n　無論、以前は相応しくなかった環境が、[l]\n　今ならば合致、有用たり得るコトガラへと変化することは、[l]\n　あるだろう。","意轻视前人的智慧吧。[l]\n　话虽如此，[l]\n　时代总在变迁嘛。[l]\n　当然，过去不合适的环境，[l]\n　如今可能变得匹配且有用的事物，[l]\n　也是存在的。"],["いずれ愉快に掻き回す覚悟でないなら、[l]\n　検討考察は必要だろうさ。","若没有彻底搅个天翻地覆的觉悟，[l]\n　讨论考察还是有必要的吧。"],["だったらどう、しろって！","那到底要怎样啦！"],["「アイっ！！！[l]\nいるのいないのどっちよ！？！」","到底在不在啊！？！」[l]\n就算是恋人，"],["「っさいなあ、\n折角全員で大人しくさせたと思ったら、\nすぐこの有様かよ、\nアイもとっとと相手してやって……[l]\nんぁ？[l]\nおよ？[l]\n……居ないなぁそう言えば。[l]\nあっれー、\nいつからだ？」","「吵死了啊，\n好不容易让所有人都安静下来了，\n马上又变成这副德性，\n爱也赶紧去应付一下……[l]\n嗯啊？[l]\n咦？[l]\n……说起来好像不在呢。[l]\n哎呀—，\n从什么时候开始的？」"],["「ん？[l]\nああ、お嬢が落ち着いてからは、\n私も部屋に籠もってたからな……[l]\n居ないのか？」","「嗯？[l]\n啊，自从大小姐冷静下来后，\n我也一直关在房间里……[l]\n不在吗？」"],["「あー、どうだろな。[l]\nそんな大仰なもンじゃないだろけどな。[l]\n姿を視てないってだけだから。[l]\nただお嬢が探してるってことぁ、\n呼び掛けの届かんトコにはいるんだろうが」","「啊—，谁知道呢。[l]\n倒也不是什么大不了的事吧。[l]\n只是没看到人影而已。[l]\n不过大小姐既然在找，\n说明她待在听不到呼唤的地方吧」"],["「それは……場合によっては大仰にもなる話じゃないのか？」","「那……根据情况不也可能是很严重的事吗？」"],["「今更餓鬼じゃあるまいし、\nあいつがどこほっつき歩こうと普通の事だろうが。[l]\n","「现在又不是闹鬼的时候，\n那家伙到处闲逛也很正常吧。[l]\n"],["先","不"],["刻も常態に視えたがな」","每时每刻都看着才奇怪」"],["「どうも来る前から様子は","「总觉得来之前的样子就"],["怪","很"],["訝しかったが、\n……真逆なあ、[l]\n今更この","可疑，\n……完全相反啊，[l]\n事到如今总不可能是"],["時機でお嬢に愛想が尽きた訳でもあるまいし、\nいや、だが……」","在这种时候对大小姐感到厌烦了吧，\n不，但是……」"],["何故後発がそうやって『新発見』の勘違いをするのか、[l]\n　というと、[l]\n　","为什么后来者会那样误以为是『新发现』呢，[l]\n　要说的话，[l]\n　"],["偏に、[l]\n　失敗策や廃案はなかなか記録……否、[l]\n　記録はされるかも知れないけれどね、[l]\n　恥ずべきモノとして封印糊塗されてしまって、[l]\n　他人に開帳され難いからだ。","无非是，[l]\n　失败方案和废案很难被记录……不，[l]\n　记录或许会有，[l]\n　但作为可耻的东西被粉饰掩盖，[l]\n　难以为他人所见。"],["それには他にも副作用があってね、[l]\n　要するに、[l]\n　正解に到までに通った筈の、[l]\n　膨大な失敗、ミス、試行錯誤、廃棄された別の選択などなど、[l]\n　それらが秘される事により、[l]\n　まるで一発で正解の解答に至ったように錯覚される、[l]\n　という事だ。","除此之外还有其他副作用，[l]\n　简而言之，[l]\n　在抵达正确答案之前理应经历的，[l]\n　大量的失败、错误、尝试、被舍弃的其他选择等等，[l]\n　由于这些被隐藏，[l]\n　就会让人产生仿佛一下子就找到正确答案的错觉，[l]\n　就是这么回事。"],["まあ、今言ったようなのは、[l]\n　ある著名人の受け売りだけどね。","嘛，刚才说的那些，[l]\n　其实是某位名人的二手观点啦。"],["この星は奇跡の惑星とか、よく言うだろう。[l]\n　こんな条件、確率、都合のいいのはそうそう無いのだろう。[l]\n　無いのだろうが、[l]\n　都合の悪かった所に発生した生命が『当たり』たるこの惑星を[l]\n　いいなあ、と","这颗星球常被称作奇迹之星对吧。[l]\n　这种条件、概率、恰到好处的情况可不多见。[l]\n　虽然不多见，[l]\n　但诞生在恶劣环境中的生命体[l]\n　应该不会"],["羨む訳ではないだろう。","羡慕这个『中奖』的星球吧。"],["だって当たりではなかった場合は、[l]\n　そう考える主体も存在しないのだからね。[l]\n　当たりたる環境に発生したのは逆に当然でもあって、[l]\n　当たりだから、当たりなんだよ。[l]\n　ふふ、ややこしいがね。","因为若是没中奖的话，[l]\n　连产生这种想法的主体都不会存在啊。[l]\n　反过来在理想环境中诞生也是理所当然，[l]\n　正因为中奖了，所以才叫中奖。[l]\n　呵呵，虽然有点绕呢。"],["当たりの環境に成るために、[l]\n　数々の条件を次々クリアしたような錯覚、[l]\n　あらゆる試練を突破したような被選択的優越感、[l]\n　精子の受精の話であるとか、[l]\n　ある種の詭弁だと僕は思うが──[l]\n　『外れていたかもしれない存在』があるという前提での考え方だろうからね、[l]\n　要するに、[l]\n　普通の事を普通でなく思わせる為の、[l]\n　つまり、詭弁さ。","为了成为天选的环境，[l]\n　仿佛接连满足无数条件的错觉，[l]\n　突破所有试炼的被选择优越感，[l]\n　说什么精子受精之类的，[l]\n　我觉得不过是某种诡辩——[l]\n　这大概是以『可能存在落选者』为前提的思考方式吧，[l]\n　说到底，[l]\n　就是为了把寻常之事说得非同寻常，[l]\n　换言之，诡辩罢了。"],["それでボクのはどうだっていうの、\n","那你倒是说说我的算什么，\n"],["「いねーの？！[l]\nいんの？！[l]\nどっちだろーと即","「没饭吃的？！[l]\n有饭吃的？！[l]\n到底是哪个啦快"],["返","回"],["事しろっての！！！」","答我啊！！！」"],["起きてしまった時点でその事象単体においては確率は１０割だろう。[l]\n　籤の個数と引く人数が同数で、ハズレ無しなら、[l]\n　かならずその一回で当たりは出るよね。[l]\n　『被抽選者それぞれに人格があって、[l]\n　その中で己が当たりになる確率』は、[l]\n　あるだろうし低いのだろうがね。[l]\n　レアを落とす確率を上げる為に、[l]\n　効率プレイに走る気持ちも充分に……ああ、[l]\n　それは別の話だけど。[l]\n　[l]\n　まあ、とは言え、[l]\n　勿論全員が被抽選者で無い場合も、空籤がある場合もあるからね、[l]\n　その場合は抽選は一回一回行われるから\n　当たりが出ない時も当然ある。[l]\n　ただ、\n","当事件发生的瞬间，其单独存在的概率就是100%。[l]\n　如果签的数量和抽签人数相同，且没有空签的话，[l]\n　必然会在那一次抽中对吧。[l]\n　『每个被抽选者都具有人格，[l]\n　其中自己成为天选者的概率』，[l]\n　虽然存在但想必很低吧。[l]\n　为了提升掉落稀有物品的概率，[l]\n　全力投入效率攻略的心情也完全可以理解……啊，[l]\n　不过那是另一回事了。[l]\n　[l]\n　嘛，话虽如此，[l]\n　当然也存在全员都非被抽选者，或者有空签的情况，[l]\n　这种时候抽选会一轮轮进行\n　自然也有抽不中的时候。[l]\n　只不过，\n"],["空籤アリ、の場合でも、人格がなければ元より無いのと一緒だし、[l]\n　被抽選者としての、個としての主体の話ならば、[l]\n　選ばれたり、[l]\n　当たりに当該する確率は確かに低いものとして存在するし、[l]\n　結局皆それに一喜一憂するというのも理解しないではないのだけどね。","即便存在空签的情况，若没有人格原本就毫无意义，[l]\n　如果讨论作为被抽选者的个体主体性的话，[l]\n　被选中、[l]\n　成为天选者的概率确实很低，[l]\n　最终大家为此患得患失的心情倒也不是不能理解。"],["そういった意味で、呼び水たる月の雫というのは、[l]\n","从这个意义上说，所谓引月之雫，[l]\n"],["んむ？[l]\n　話が見事に逸れたな。[l]\n　えーと……","嗯？[l]\n　话题彻底跑偏了啊。[l]\n　呃……"],["「あんだよ、ほんとに居ないぽいな。[l]\n","「搞什么，真的好像不在哎。[l]\n"],["化","化"],["粧","妆"],["室……って訳でもないよな？」","室……也不像吧？」"],["「さあ、どうだろうな。[l]\nこのところの変調が体調からのものならば、\n籠もってる可能性はあるが──調べてくるか？」","「谁知道呢。[l]\n如果最近的异常是身体原因，\n倒可能躲起来了——要去找找看吗？」"],["「まあ、そこまでは……いーんじゃないか、あとで。[l]\nお嬢が鎮まってくれさえすりゃ──\nつーかいい加減、マジでお","「啊，那倒不必……饭觉得不用急，待会儿再说。[l]\n只要大小姐能冷静下来——\n不如说真的受够了，该不会是"],["守りに疲れたんじゃないのか。[l]\n先刻の宥め賺し作業がトドメだったりしてな。[l]\nんで案外、ここにきて堪忍袋の緒が切れたとかよ……[l]\nま、[l]\n逆にそっとしといてやんのがいーんじゃねーのかな」","守护到精疲力尽了吧。[l]\n刚才的安抚工作说不定成了压垮骆驼的最后一根稻草。[l]\n搞不好突然在这儿忍无可忍爆发了什么的……[l]\n嘛，[l]\n反过来放着不管说不定才是饭的正确做法吧」"],["「……あれがそんなふうなつくりとは思えんが……[l]\nまあ、そうだな……[l]\n変調を来してはいたようだからな……」","「……不觉得那家伙是这种构造啊……[l]\n不过，也是……[l]\n毕竟确实出现了异常……」"],["定番には定番たる","经典之所以成为经典"],["所","的"],["以がある。[l]\n　相対的──つまり他者という基準ありきの、[l]\n　単なる逸脱、個性の履き違えは論外としても、[l]\n　かといって記号をその意味でなく形象でのみなぞるのもまた、[l]\n　同等に冴えないがね。[l]\n　だから、[l]\n　","自有其道理。[l]\n　相对性——即以他者为基准的前提下，[l]\n　单纯的偏离或个性错位姑且不论，[l]\n　但若仅凭外形临摹符号而忽视其含义，[l]\n　同样乏善可陈呢。[l]\n　所以说，[l]\n　"],["彼でも、[l]\n　新しければ良いというものでもないのさ。[l]\n　あ、品質状態としてのそれは別だよ。","也并非新鲜就好。[l]\n　啊，物品的品质状态另当别论。[l]\n　「什么鬼！！！」"],["「んなんだ！！！」","「开什么玩笑！！！」"],["ボクのIgは！[l]\n失敗した前の遣り方を教訓に、[l]\n改めて良しとされた冴えた遣り方じゃないのか！[l]\n書式が違ったくらいで、\n","我的Ig是！[l]\n以失败的前车之鉴为教训，[l]\n这不正是重新被认可的绝妙做法吗！[l]\n不过是格式不同而已，\n"],["「んでだ！！！[l]\nあんなカビの生えた旧来の、」","「所以啊！！！[l]\n那种发霉的老古董，」"],["ただまあ、量産型の完成度とは別にね、[l]\n　プロトタイプとしての、[l]\n　ピーキーでありながら且つ","不过嘛，和量产型的完成度无关，[l]\n　作为原型机，[l]\n　虽然性能不稳定但同时"],["融通","灵活"],["のき","性"],["きやすさと言うのも、[l]\n　時には有用で、\n","这种特质，[l]\n　有时也很管用，\n"],["遣い手にもＣＡＴにも──こっちにも向こうにも──過度の負担を与える事無く、\narchivingに特化したボクのテトなら、\n","既不会给使用者或CAT——这边那边都——造成过度负担，\n如果是专精archiving的我的Tet的话，\n"],["「ちくしょう！！！[l]\n","「可恶！！！[l]\n"],["魔","魔"],["眼","眼"],["の","的"],["刺","刺"],["し","穿"],["手なんか！！！[l]\n単なるハカいしぃだろぉが！！！[l]\ngest──」","什么手啊！！！[l]\n不就是块破石头吗！！！[l]\ngest──」"],["いやだ！！！[l]\nいやだいやだい・や・だ！！！","不要啊！！！[l]\n不要不要不・要・啊！！！"],["昔言われた事なんか、[l]\n何でいまごろ、[l]\n思い出したくもないのに、[l]\nいわれたときはなんともおもわなかったのに、[l]\n","以前被说过的事、[l]\n为什么到现在、[l]\n明明根本不想回忆、[l]\n被说的时候明明毫无感觉的、[l]\n"],["Scaning Error\n",""],["フォーマットが違います\n","格式不符\n"],["処理を実行出来ません\n","无法执行处理\n"],["できません\n","办不到\n"],["はじめからやりな\n","给我从头开始做\n"],["「出掛けるっ！！！[l]\nアイはみつけたら叱る！！！[l]\nすぐ帰るから心配無用っ！！！」","「我出门啦！！！[l]\n爱要是发现了会骂人的！！！[l]\n马上就回来不用担心啦！！！」"],["「あ？[l]\nあー、おい、ちょ、」","「啊？[l]\n啊——喂、等、」"],["だん！！！","咚！！！"],["「………」",""],["「……いいんかな？」","「……这样真的好吗？」"],["「……上に報告だけでもすべきかな……」","「……至少该向上头汇报下吧……」"],["とぅるるるる。","嘟噜噜噜噜。"],["「お、噂をすればだ」","「啊、说曹操曹操到」"],["とぅるるる、\nピッ。","嘟噜噜噜、\n哔。"],["「はい、あんでしょか」","「嗯，您说呢」"],["「Ironは居ますか其処に？」","「Iron在那儿吗？」"],["「あー、その事でちょっとごたごたありまして──」","「啊——那件事稍微有点麻烦——」"]],"context":[["SC_E_055.ks/index/1/text"],["SC_E_055.ks/index/3/text"],["SC_E_055.ks/index/5/text"],["SC_E_055.ks/index/7/text","SC_E_055.ks/index/109/text"],["SC_E_055.ks/index/9/text"],["SC_E_055.ks/index/12/text"],["SC_E_055.ks/index/14/text"],["SC_E_055.ks/index/16/text"],["SC_E_055.ks/index/18/text"],["SC_E_055.ks/index/20/text"],["SC_E_055.ks/index/22/text"],["SC_E_055.ks/index/24/text"],["SC_E_055.ks/index/26/text"],["SC_E_055.ks/index/28/text"],["SC_E_055.ks/index/30/text"],["SC_E_055.ks/index/32/text"],["SC_E_055.ks/index/34/text"],["SC_E_055.ks/index/36/text"],["SC_E_055.ks/index/39/text"],["SC_E_055.ks/index/41/text"],["SC_E_055.ks/index/43/text"],["SC_E_055.ks/index/45/text"],["SC_E_055.ks/index/47/text"],["SC_E_055.ks/index/49/text"],["SC_E_055.ks/index/51/text"],["SC_E_055.ks/index/53/text"],["SC_E_055.ks/index/55/text"],["SC_E_055.ks/index/57/text"],["SC_E_055.ks/index/59/text"],["SC_E_055.ks/index/61/text"],["SC_E_055.ks/index/63/text"],["SC_E_055.ks/index/65/text"],["SC_E_055.ks/index/67/text"],["SC_E_055.ks/index/70/text"],["SC_E_055.ks/index/72/text"],["SC_E_055.ks/index/74/text"],["SC_E_055.ks/index/76/text"],["SC_E_055.ks/index/79/text"],["SC_E_055.ks/index/81/text"],["SC_E_055.ks/index/