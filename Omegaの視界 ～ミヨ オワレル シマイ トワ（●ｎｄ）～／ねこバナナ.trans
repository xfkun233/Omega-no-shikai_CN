,"end":28184}],[{"start":28277,"end":28293}],[{"start":28341,"end":28400}],[{"start":28524,"end":28528}],[{"start":28624,"end":28636}],[{"start":28672,"end":28675}],[{"start":28685,"end":28691}],[{"start":28701,"end":28715}],[{"start":28725,"end":28731}],[{"start":28741,"end":28751}],[{"start":28823,"end":28836}],[{"start":28928,"end":28968}],[{"start":28980,"end":28994}],[{"start":29002,"end":29044}],[{"start":29052,"end":29083}],[{"start":29091,"end":29154}],[{"start":29190,"end":29209}],[{"start":29245,"end":29249}],[{"start":29257,"end":29280}],[{"start":29292,"end":29302}],[{"start":29348,"end":29349}],[{"start":29359,"end":29360}],[{"start":29370,"end":29371}],[{"start":29380,"end":29382}],[{"start":29420,"end":29429}],[{"start":29435,"end":29518}],[{"start":29524,"end":29553}],[{"start":29559,"end":29621}],[{"start":29627,"end":29633}],[{"start":29669,"end":29687}],[{"start":29719,"end":29730}],[{"start":29770,"end":29771}],[{"start":29780,"end":29781}],[{"start":29790,"end":29791}],[{"start":29801,"end":29809}],[{"start":29883,"end":29884}],[{"start":29893,"end":29897}],[{"start":29906,"end":29932}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_075.ks","basename":"SC_M_075.ks","indexIds":{"間一髪、":0,"と言って良いのかどうか。":1,"状況の詳細を把握するより前に、\n":2,"宮さん……モードは既にミルハの……あれは、[l]\n中位（Mode:Medium）か？[l]\n兎に角、その振り下ろされた紅腕の先に、\n何者かの存在を":3,"視":4,"咎めた僕は、":5,"思わず割って入っていた。":6,"其処に横たわってるのは、[l]\n":7,"襤":8,"褸":9,"屑のようになって、[l]\nぴくりとも動かない、":10,"「……お。[l]\nおおおおおっ？[l]\nおおおおおおおお！！」":11,"「……お、そかった？[l]\nのか？[l]\nというか、\nなんでお前が宮さんと、」":12,"「すごい！[l]\nすごぉい！！[l]\n全然気付かなかった！！！[l]\nどういう技？[l]\n宮に気付かせないでここまで接近するなんて、」":13,"「僕が分かるか？！[l]\nお前っ、[l]音だよなっ？[l]\n西石音、[l]つーか──」":14,"「──」":15,"僕の、[l]\n鼓動が早鐘を打つ、[l]\nどくどくと脈打つ血流が、[l]\n頭の中を駆け巡り、":16,"一瞬気が遠くなった──":17,"「んむっ、シカトですか。[l]\nこんなになるまで待たせておいて、\nその仕打ちは酷いですっ。[l]\nそこのそれだって、」":18,"音……きぃ……が、[l]\nなぜ、":19,"「まこくんがもうちょーーっと早く、\n宮の所に来て呉れてれば、\nこんなにならずに済んだのに」":20,"聞こえてくる言葉に僕は、\n頭が真っ白になって、":21,"「──んたがっ！！！」":22,"「ダマレ若僧」":23,"「あぁっ？！」":24,"「早とちりにも程があるぞ。[l]\nマンガかキミは。[l]\nそんな雑魚、わざわざ殺す訳がないだろ」":25,"「？！[l]\nはっ？！！」":26,"「大事なまこくんのオトモダチを、\n……まあ、[l]\nまこくんを怒らせる為の──\n本気出さす餌にしても良かったけどね、\nこれがまた、\nまこくんとは別の意味で特殊なんだよね。[l]\n遣りようによってはまだ使いようもあるし、\nこれも":27,"蒐":28,"集":29,"者の":30,"性というかな、\nそういう":31,"貴":32,"重":33,"存":34,"在をばっさり切り捨てるのも、\nなかなか抵抗があるですよ。[l]\nただ、」":35,"飽きたので。":36,"「戦闘フェイズを終了させたわけです。[l]\nまこくんが来なかったら、\nチノに強制改宗でもして貰おうと思ってたの。[l]\nわかった？」":37,"……宮さんは、[l]\n何でもないことを話すみたいに、\nそしてまるで、[l]\n駄駄を捏ねるコドモに言い聞かせるように、\nつまり、[l]\n優しさと冷静さ、[l]\nそれに少しの苛立ちを込めて、[l]\n僕に語り続けた。":38,"「……あなたは……[l]いったい何が……」":39,"「んむ？[l]\n目的だの何だの、そういうのはどうだってね、\nなんだっていいじゃないですか。[l]\nああ、[l]\nそれとそこのそれね、[l]\nどうやらまこくんのことが、」":40,"「……いいです、知ってます。[l]\nでも黙っててください」":41,"──":42,"漸く、":43,"……混乱が収まった僕は、[l]\n宮さんの暴言……挑発のつもりなのか本心なのか、[l]\nそれを努めて聞き流しながら、":44,"傍らの音──きぃに視線を移した。":45,"よく眼を凝らせば、\n確かに、[l]\n息はしているようだった。[l]\nだが、……。":46,"「んむー、仕返しされたっ。[l]\nその言い方だと、\n『全部分かっ』た上での発言ですね？[l]\n……もし本人から、[l]\n『ほんとうのこと』を告白されてたら、\nどうするつもりだったのかな？」":47,"………。":48,"──彼奴は、[l]\n自分で分かってた、\nでも我慢するつもりでいた、[l]\n墓場まで持っていくって書いていた──":49,"冬夏が、あんな事をする程に忌み嫌っていた、[l]\n姫様ちゃんがしたのと同じようなこと、[l]\n『してはならないこと』をした、[l]\nその報いという自責の念なのかも知れない、":50,"それとも、[l]\n冬夏の想いを慮った上での、\n友人への優しさだったのかも知れない、":51,"或いは全く知る由もない、\n彼奴自身の問題、理由があったのかも知れない、":52,"それでも、":53,"それでも尚、あふれ出る、\n抑えがたい感情が、[l]\nそれが僕等の逃れ難き衝動、":54,"Ｙの欲動……":55,"それは、":56,"優先順位を狂わせ、[l]\nそして治まると決まって訪れる後悔や虚脱、\nなのに、[l]それなのに、[l]\nおわるまでは、きづくことのできない、":57,"………、":58,"貴女方にはきっとわからない……！":59,"「……どうって、──」":60,"僕の様な者が想像するのも烏滸がましい、\n壮絶な苦しみや葛藤や、[l]\nそれこそ想像もつかない……否、[l]\n想像する行為すら拒絶されて然るべき、\nきっとそんな、":61,"それでも彼奴は、":62,"きぃは、":63,"「……関係ないでしょう今は、[l]\nいえ、あなたには」":64,"僕はそう言ったけれど、\n半ば八つ当たりだった。":65,"実際、[l]\nもし、話す機会が与えられたとしても、\n僕はきぃに何を言えたのだろう。":66,"僕には、":67,"わからない……":68,"宮さんはそんな僕のこころを視透かすように、\n話し続ける。":69,"「関係ないって？[l]\nふぅーん。[l]\nまーいいです。[l]\n":70,"でもま、ほら、\nアイはね、平等なんて言葉からは、\nかなーり懸け離れたものでしょお」":71,"「……？」":72,"「この世から憎しみや争いを無くそうと思ったら、\n愛も否定しなきゃならないという矛盾ね。[l]\nアイは全てを狂わすものですよ。[l]\n単純に、\nひとりの人間を複数人が同時に好きになったら？[l]\nその逆でも良いけど」":73,"「……」":74,"「愛し合う者、恋人同士になるというコトが、\nある種の契約──同時には他人とそういう関係を築かない、\nという、少なくとも現在この國で道徳観念、\n美徳とされるその構造ある限りは、\n必ず誰かが選ばれる、或いは誰も選ばれない、\n取捨選択されてしまうでしょうに。[l]\n平等──つまりは、\n『いつでもだれとでも』いい、\nという形式をとらないかぎりは、」":75,"「アイ故に、起きる悲しみ。[l]\n誰も、悪くするつもりがなくとも。[l]\n所謂悪念がこの世から消えたとしても、\n選ばれないモノはこうやって存在し続ける。[l]\nそうでなくしたいなら、\n契約で縛るような関係性の構造も、\n否定せざるを得ないのかな？[l]\nと言うよりもね、\nあ、そうそう、\n単数だろうと複数だろうと、\n言い寄ってきた相手が好みじゃなくて、\nそいつに好かれる事自体がイヤ、\nって場合も勿論あるでしょ。[l]\nそだそだ、どうこういうそれ以前の問題だよねこれは」":76,"「……それは何かの言い訳なんでしょうか？[l]\n先手を打ったおつもりで？」":77,"自分でも何を言ってるのか、\n理路整然したものとは懸け離れてると、\nそれは分かっていたけれど、\n口を衝いて出た言葉はそれだった。":78,"これじゃまるで、\n……相変わらず僕は……":79,"「べぇつにぃ。[l]\n一般論のつもりですけど？[l]\n仮に『争い』は無くっても、\n辛いことや悲しいこと、\nヤな気分って無くならないね、\nというあくまでも一例ですよ。[l]\nというかさぁ、[l]\n":80,"まこくんだって、[l]今、[l]\n……人のこと言える？」":81,"「それはどういう──」":82,"「あれだけ仕込んだのに、\n宮だけを●●●と思ってたのに……」":83,"さぁああぁぁぁぁぁぁ…………":84,"ざわ……ざわざわざわざわ…………":85,"その時一陣の夜風が吹き抜けて、":86,"あのひとが何と言ったのかは解らなかった。":87,"風が止むと、\nこっちを視て、\n宮さんはにこりと笑った。":88,"「ま、そのうちチノでも来るでしょ。[l]\nそこのそれ、処置頼めば？[l]\n……結局独りで来たんですもんね？[l]\n宮に会う為にね？」":89,"最後の言葉が、\nあのひとらしからぬ、\n何かすがるような感じがしたので。":90,"僕はつい今までのあのひとの、\n傍若無人な言い様を忘れて、":91,"「そうです」":92,"明瞭とそう、口にした。":93,"「そっか……[l]\n嬉しいです」":94,"「……そりゃ、どうも……」":95,"僕の頭の中で、[l]\n激しく思考の作用反作用が。[l]\n激しい歓喜と、[l]\n自己防衛の為の疑心暗鬼、":96,"ぼくだってうれしいけれど、[l]\nこのひとのことばをうのみにしては、[l]\nまにうけてしまっては、":97,"……きっと傷付くんだ。":98,"だけれど、":99,"「で、[l]\nどうするか、きめた？」":100,"………問いに対する、":101,"『その問い方に対する』返答は、":102,"僕の中の色んな要素と違っていたから、":103,"思考が、脳が空転して、":104,"………臨戦態勢をとったままのシロを鎮めた。":105,"「──あなたの言うように、[l]\n":106,"八":107,"相達を滅ぼして、\nカミを取り戻そうとは、[l]\n思いません」":108,"「ほう」":109,"「あなたがそうしようとするなら、[l]\n僕があなたを止めます」":110,"「ほうほう」":111,"「………」":112,"「いいんじゃない？[l]\n結局、\n愉しければ、私はどちらでも。[l]\n獲物はなんだっていいの。[l]\n生きさえ良ければ。[l]\nま、\n止めることが出来るかどうかは、[l]\n──残念ながらアレだけど？」":113,"ざわ………………":114,"「それにしても──」":115,"先程から吹いているような、\n少し強めの風があるくらいで、":116,"「やけに静かです……ね、[l]\nもっとこう、[l]\n──あの時の六母屋の地下みたく、\n『最後の舞台』が大仰に用意されてるのかと思ってました」":117,"途中で冬夏と狩屋に会ってある程度の事情を知り、\n今ここできぃを確認して、\n……行動の真意は知れねども、[l]\nどうやら宮さんが何かする以前に、\n事が起きてしまったらしいこと、":118,"つまり、\n恐らくは予定が大幅に狂った──或いは、[l]\n……宮さんの事だから、[l]\nそもそもが行き当たりばったりで、\n結局お粗末になったってだけの、\nそういう事なのかも知れないけれど、":119,"──そういえば、八相が散り散りばらばらって事は、\n今頃道具さんや、\n姫様ちゃんはどうなっているんだろう……？[l]\n大神が来てるなら、フォローしてくれてるといいけど……":120,"「なぁに言ってるんですか。[l]\nまこくんが速攻話を決めてれば、\n役者もちゃぁんと揃い踏み、\n豪華なイベント起こせたのに。[l]\n自業自得というものですよ」":121,"……じゃあ、[l]\n僕のあの彷徨も、\n或る意味良かったって、言えるのかな……":122,"「それに──[l]\nらすとばとぅだからって、\n派手派手しいばっかりじゃ能がないし。[l]\n最後の決着は、[l]\nアイ対する二つの存在が、[l]\n色んな思いを込めて粛々と遣り合う、[l]\n切なく苦しい、戦いのヒアイを噛み締めながらの、[l]\n葛藤に満ちたものであっても、[l]\n良いんじゃないの？[l]\n誰にも理解されないまま、\nお互いにくだらないと、間違っていると分かっていても、\n戦って決着をつけなければならない──\n":123,"遊":124,"戯としては兎も角、\n":125,"戯":126,"曲としてはそういうのもありでしょぉ？[l]\n敵を倒して気分スッキリ、[l]\nそんなのに該当するような敵らしい敵、[l]\n悪悪しい悪の":127,"親":128,"玉なんか、[l]\n中々居ないよぉ？」":129,"……。[l]\nそれには少し異論を唱えたくなるけど……":130,"そんな僕の":131,"黙りを無視して、\n宮さんは、":132,"「それにね、\nこの國ではね、[l]\n昔からバッドエンドの方が受けるんですよ？[l]\n知ってるでしょぉキミなら？[l]\n今じゃあっちに":133,"気":134,"触れちゃって、[l]\n悲劇の原作モノですら無理矢理ハッピーな終わりにしたり、\nま、勿論その逆、[l]\n死をかたりさえすれば感動、[l]みたいな風潮もあるですがね、\nいずれそれらしい記号があれば、[l]\nヒトの感情は簡単に動いちゃうもんだし、\n別に恥じることではないですけど、[l]うひひ」":135,"徐々に僕に近づきながら、":136,"「──年寄りは、[l]\nそのオハナシの要素、記号に対して、[l]\n長生きした分経験も多くて、[l]その中には、[l]\n該当する類似記憶も多くなるから涙もろくなるだけ、[l]\n自分で勝手に自分の類似記憶と関連付けて、\n勝手に自分の中で物語りを想像してそれに励起されてる、[l]\nそういうことかな。[l]\nだから、[l]\n──昨今はメディアが氾濫してるからね、\n小さい頃から実体験以外の情報があるからだろうか、[l]\n簡単に●●とか言うことも出来る。[l]\nそうでなくても最近は、\n物事に対する評価が『最高』とか『最低』とか、[l]\n何でもかんでも超とかカリスマとか神とかつけてみたり、[l]\nＭＡＸ両極端で評するじゃん。[l]\n雑多に氾濫する情報を効率的に取捨選択するために、\n手早く○×振り分ける為の行為かもですが、\nんむ？[l]\nそれとも、敢えて全部同じにして、[l]\n差別してません、みんな平等に仲良しこよし、[l]\nって言いたいのかな？[l]\nその割には優勝とか金メダルとか、\nスポーツに限ってはヘンな精神論振りかざして、\nみんな熱くなるよねぇ。[l]\nま、色んな意見があるのは構わないでしょうけど、\nそれぞれが勝手に思ってればいいだけでしょうに、\nうひひ、[l]\n私達のような年寄りから視ますとね、\n結局価値を愚弄してるように視えて悲しいです」":137,"と、":138,"嘯いた。":139,"「……道具さん並に話が逸れてきましたよ。[l]\n……僕は、」":140,"「誰だっけそれ？[l]\nそれより、」":141,"と宮さんが僕の発言を遮った。":142,"「♂♀がこれから":143,"眼":144,"合いをって時に、\nギャラリーがわんさといたらやりにくいでしょぉ？[l]\nそれとも、[l]\n……まさかまこくん、[l]\n視られながらの方が燃えるとか」":145,"「──。[l]\n確かに僕は、\n二人以上と同時に会話するのが苦手です。[l]\n集団の中で、自我を押し出して主張するのがキライです。[l]\n対象がブレて集中出来ませんから。[l]\n話すなら、話す相手が定まってないと、\n集団に属するなら、自分の立ち位置が確定してないと、\n僕は落ち着かない、どうしていいかわからない、\nでも、」":146,"これからは。":147,"まるであなたたちのようで皮肉だけど、\nそういう相対的な構造よりももっとヨキものが、\nあるのだと。[l]\nそれはあなたたちや彼女達との関わりで気付いた、\n今更ながら、\nでもまだ手遅れでないのなら、":148,"「僕はヒトのなかで、\n何が良いのか迷いながら生きていきます。[l]\n白と黒、[l]\n全てがはっきりと振り分けられぬがこの世界です。[l]\nスキかキライかでモノを視るのは避けられなくとも、\n全てが計算や法則で出来ている世界であれ、\nそう割り切って、[l]\n──悲しみも喜びも超越した振りをするよりは、\n素直に、時に姑息、そういう曖昧さを併せ持ち、\n清濁併せ呑みながらも、\n善悪なんてものは存在しないと知りながら、\nそれでも善きものとして在ろうと思う、\nそう思うことが出来る、\nヒトとしてそういう健全な、」":149,"大神のような、":150,"Ｃとは違う、Ｄ──":151,"「なぁんか、\nスルーされたっぽくてアレですね、[l]\nすっごい宮がすべったみたいでヤな感じです。[l]\n前のまこくんだったら──[l]\n……ってあれ？[l]\n今更だけどどっち？[l]\nまこくん……？[l]\nで合ってる？のかな？」":152,"「僕は、僕です。[l]\nミルハ……宮さん。[l]\nあなた──と僕が、勘違いしてただけで」":153,"「んむ？[l]\n勘違い？」":154,"「……ここで詳しく説明すんのも場違いですが、[l]\n僕はイツワのイーハであり飯窪真言です。[l]\n上書きでも仮置きでもなんでもなく、\n単に忘れていた、それだけです。[l]\n僕はずっと──あの時から今までも、\nずっと僕のままでした」":155,"そして無論、言い出さなかったけれども、[l]\n僕があなたを信用してなかったという証、[l]\nそしてあなたの兄さんの、[l]\n……否、[l]それこそこのひとには言える事ではない。":156,"「……あははははは」":157,"「イツワ……否、[l]\nまこくんらしいと言えばまこくんらしいですね。[l]\nあははは、うひひ……[l]\nそして、」":158,"「雫のフラグ立ての一環でもあるってとこかな。[l]\n三重偉大は顕現──[l]した訳だ」":159,"「……いえ、[l]\n加えて魔眼の刺し手でもある僕は、\nさしずめ四重偉大とでも言いましょうか、\nこの四ツ目の仮面のように」":160,"「んむ？[l]\nお、そうなる？[l]\nあ！[l]\nそれで思い出したっ。[l]\n":161,"四重奏団の連中、一体──ってあれ？[l]\nそれ、似てるけど、\nキリアケじゃ……ない？[l]\nおよ？」":162,"「……何を今更的な話に、[l]\n急に沢山気付き出しましたね……[l]\nそれも、最強の白ミルハの余裕がなせる業ですか」":163,"「んむ、まっねー。[l]\nそういう訳で説明はしなくても結構だけど。[l]\n何であろうと軽くいなしてあげるから。[l]\n大体、まこくんは、\n『ソフトウェアを遣う事』は出来ても、\n設計技術的な話分かんないだろし」":164,"「……ええ、[l]\nまあ、仰る通り」":165,"──そう、[l]\n僕はアナクロ趣味なんだ、[l]\nあなたや大神と特に違うところは、[l]\n例えば、[l]\n僕はパソコンが苦手、いや、厭うてるといってもいい。[l]\n自分で把握できる、掌握できる領域を越えたツールを使うのは、\n落ち着かないというか、\nだから、":166,"ＣＡＴのチカラにも執着はない。":167,"僕がデータより実際の書籍が好きというのも、\n趣味嗜好云々よりもそういうのが根底に在るのかも知れない、\n勿論、\nあれば便利で効率的であろうことも承知してる、\nそれにアナログだったり単純なもの、\n物理的に在るモノならば掌握出来るというのも、\n思い込み、幻想に過ぎない、\nでも、[l]\n僕には合わないんだよ、\n僕自身がこういう思考をするのも、\nヒトの肉を持ちたる故かも知れない、\n自分の関知してない、出来ない所で、\n何かが起きてるというのは、\n不安で仕方なくって、":168,"……そう言えば、想像力は諸刃の剣だと、[l]\nそういう言葉もあった、":169,"だから、":170,"だから、[l]\n直接話を、言葉を僕自身の口から伝えたくて、\nきた。":171,"「そろそろ、\n立ち話も飽きてきた？[l]\n２人でミリアムでも追っかけるって手もあるけど、\n何やら思い詰めてますねまこくん？[l]\nその様子じゃ、[l]\n私とどーおしても、シたいのかな？[l]\nいいよぉ、\nじゃーあぁ、\nその謎のＣＡＴがどんなもんか、\nみせてみてくださいな♪」":172,"「……わかりました。[l]\nでも、\nその前に、」":173,"その前に。":174,"勿論、":175,"もちろんっ、":176,"「勿論返事は分かってるけどっ、\nこれだけはどうしても、\nはっきり言っておきたいんだよっ」":177,"「？[l]\nなんでしょう」":178,"「すきです──」":179,"「僕は貴女が好きだ、[l]\n痛い程大好きだ、[l]\n再会したときからずっと貴女が、\n貴女だけが、[l]\n好きでした。[l]\n貴女の事を考えるだけで、\n胸を締め付けられた、[l]\n貴女と会えない時は辛かった、\n相手にして貰えた時はそれだけで、[l]\n尻尾があれば千切れる程に振ってたと思う、\nそれくらいに、[l]\nそれくらいにっ、[l]\n……貴女が大好きでした」":180,"「……[l]それはどうも」":181,"「でも、今はもう、」":182,"キライです。[l]\n　　顔も視たくないし声も聞きたくありません。[l]\n　　貴女は僕の最も軽蔑する類の存在の中のひとりです。":183,"「僕は、」":184,"あなたのことが、[l]\n　　だいきらいだ。":185,"「……はー……[l]\nすっきりしました」":186,"「で？[l]\nキミの中だけでのケジメはついた訳ね？[l]\nもういい？」":187,"「ケジメ……そう、[l]\nケジメですよ。[l]\n僕等":188,"男には、[l]Ｙの保持者には、\n貴女方には絶対にワからない、[l]\n":189,"どうしようもない抑え":190,"難い、[l]\n外に出さなきゃ溢れてしまうような、[l]\n熱い":191,"滾りがあるんですっ、\nたとえ":192,"詰られようがっ、」":193,"ぎゃいぃぃぃーーーん":194,"「軽蔑されようがっ、\nはっきりと立ち位置を確定させなきゃ、\nいらぬ想像に身を苛まれるからっ、」":195,"ぼすっ！！！":196,"「貴女方は遊びのつもりでしてるかも知れないですが、[l]\nそんなちょっかいに、[l]\n心身削らされてまで、[l]\n付き合わされるのは、[l]\nもう金輪際御免なんですっ！！！」":197,"ぶあぁん！！":198,"「……あーあ、[l]\n地雷踏みですよね、\nこういうのは」":199,"「は？！」":200,"「いいです。[l]\n言ってワカルようなら、\nそんな地雷をそもそも踏まないし」":201,"「……っ」":202,"……恐ろしく、[l]\nイヤな気分になる。[l]\n先程からのシロとの攻撃も、[l]\n避けられるか防がれてる。[l]\nが、何より精神面に、\n今の言葉は、":203,"冷たく、深々と、刺さった。":204,"「大体、まこくんが言ってる事は、[l]\nそれはそっちの都合というか勝手な感想でしょぉ？[l]\n宮が、\n好きになってと一言でも頼みましたか？」":205,"「……自分の都合の良い所では論理を持ち出して、[l]\nそれ以外では自分の望む結果を満たすために、\nあらゆる不条理を貫く癖に……」":206,"「んむ？[l]\n何か言いたいの？[l]\nほんとなら、\nとっくにウザいの一言で終わらせてるよまこくん？[l]\n他の女子に言ってたら、\n怖がられるよドン引きされるよ？[l]\n止しなよこういうの。[l]\n無粋もいいとこだしさぁ。[l]\nキミならワカルと思ってこう説明もしてあげてるけど、\n本来ならば、一蹴されておわりだよ？[l]\n兎に角こっちはね、\n":207,"自":208,"己":209,"満":210,"足に付き合うような、[l]\n":211,"優":212,"し":213,"く":214,"暖かい":215,"理":216,"想":217,"の":218,"女":219,"性でも何でもないの」":220,"しぃーーーーーん……":221,"僕は、":222,"肩の力をすっと抜いた。":223,"あなたこそ、":224,"僕の地雷を踏んで踏んで、[l]\n踏みまくってるんだ宮さん。":225,"「──ええ、そりゃそうでしょうね、\nわかってます。[l]\nそう思います。[l]\n貴女方……いえ、あなたは、[l]\n自分の思うとおりの、望むかたちより先への、\n想定外の侵入は、[l]\n断固拒否してくるんですもんね、[l]\nでもそれはこちらとてそうだと思います、\nお互い様のことだと思います、[l]\nそれを遣り過ごしたり諦めたりしながら、\n世の中の♂♀は、\n何とかやっていってるんだろって思うけど、[l]\nそれを":226,"許せないのがきっと貴女なんだ、\nですから、」":227,"──息が、\n詰まりそうで。[l]\n涙が出そうなくらいに。":228,"だから僕は一瞬間を空けた。[l]\n素早く大きく、冷たい息を吸い込んだ。":229,"「……まあ、そういうことで、[l]\n貴女への想いは、今言葉にして、\nジイでも何でもどう受け取って貰っても結構、\n大体ぶちまけました。[l]\nこれからは、\n………、[l]\n愚痴はもう言いません。[l]\n今言った通り、これからは、\n──冷静な思考、\nお仕事の……いえ、[l]\n":230,"お●●●の時間です、\nミルハ」":231,"「……は？」":232,"宮さんは、\n急に叫んだ。":233,"「何も聞こうとしなかったくせにっ、\n保身の自己完結って訳だ、[l]\n♂ってのはほんっとにだっせぇなあ、\nだから結局──」":234,"「聞くまでもっ、\nないでしょっ、\nあなたは──」":235,"ぎあーーーーーぁぁん":236,"……今更っ、[l]\n今更勝手な事をっ！":237,"愚痴はもう言わないって言ったけど、\n言ったけど！！！":238,"「……ちっ、[l]\nそれにっ、[l]\n無粋結構、\n僕は野暮の極みのようなもんですからねっ、[l]\n何しろ生まれはこんな北の地、\n妖怪をあしらった旅館の経営者が親族、\n粋なんてモノは糞喰らえ、なんです、[l]\nミエやなんだのや、[l]知ったことか、[l]\nあなたが勝手に設えたテストの、[l]\n採点なんかされたくはない！！！[l]\n僕の行為に正解不正解を判定して、\n地雷がどうとか、[l]\nそれはこっちの台詞だ！！」":239,"「ついてない格好をつけてみたところで、\n結局自分の想定の外側から責められるのが怖いんだろ！[l]\n予防線張っといて傷付かないようにしたいだけなんだろ！」":240,"「貴女だっ……て！[l]\nそうだろうが！！！[l]\n粋だ何だって言って、言い訳にしか聞こえねえんだよ！！！[l]\nはっきりキライと言ってさえくれりゃ、」":241,"……ながく苦しむ事もなかったのに……っ！！！":242,"「キライではないですよ」":243,"……。":244,"「でも♂♀の……[l]\n":245," 伴":246,"侶の関係になれるかって言ったら、\n答えは":247,"Ｎ ":248,"ｏ」":249,"わかってる、わかってるけど、":250,"「兎も角さあ、\n理由とか心情とか、[l]\n得手勝手に解釈されたままだとこっちだって不本意だっての。[l]\nさっき自分で言ってたようだけど、\n私は私の深ぁい理由で、\nまこくんとは、できま──」":251,"「いちいち言わないでいいですっ。[l]\nまともにぶつけ合うには、\n♂と♀では":252,"式が違い過ぎる、[l]\n何から何まで、\n会話ですら同じステージで行われていない！[l]\n価値観の優先順位も情報整理の仕方も取捨選択も、\n肉のレベルから違う僕と貴女では、」":253,"──自分を、世界を、\n虚構をそうと承知で己から騙されていかなけれりゃ、":254,"つらいだけの、\nかなしいだけの、\n冷徹で無慈悲なこの、\n最悪の箱庭で、\n":255,"界を":256,"維":257,"持する為、\nそれだけの為に相争って存続しようとする意思存在として、[l]\n『眼をもつ主観』として\n未来永劫誰かが『そこ』に在るためになら、[l]\nどんな悲しみも苦しみも許容するこの、":258,"世界で生きていくのはきついのに、":259,"「噛み合わない会話ですらも、\n貴女の中では、\n自己、そして自分の意見がしっかりと中心に据えられているから、\n何にも支障がない、\n僕等のように社会との相対的な位置で己を測る遣り方では、\n到底太刀打ちの出来ない武装ですよね！[l]\n決めた事項ありきで構築されるその論理は、\n僕のように『話せばワカル』という幻想を抱くモノにとって、\n理屈や論理や社会の中で生きてきた論法では、……っ」":260,"ぜったいにつなぎ止めることは、\nましてや射止めることなんて、":261,"──できない……っ！！！！":262,"「……ヒートアップしてきたなぁまこくん。[l]\nちょと偏見に満ちた危険な言い方だぞ。[l]\n♀は♀で恐ろしく面倒な──ニンゲン関係、\n世間というのがあるからね。[l]\n♂が河原で殴り合って友情育むような単純な構造じゃ、\nないのだよ？[l]\nアナタガタとは別にね、\n肉体的な色々もあるにせよ、\nそっちを知ってれば今のまこくんの言葉、\nそうそう言えるものではない筈だよ。[l]\nそれに。[l]\n♂は♂でケモノのようにボスとそれ以外、\nというヒエラルキー構造で、\nキミの言う所の社会内部の相対的な立ち位置を、\n測る遣り方で自分の価値やなんやを夢想するのだろ。[l]\nだから、\n自分という絶対中心が無いから、\n社会の内部における相対的位相、\n立ち位置が、\nずれたり崩れたりしただけで、\nあっさり駄目になるのが君等だろうよ」":263,"「……それはそうでしょう。[l]\n全部が全部そうだとか違うとか、\n今そんな話をした所で詮無いので止しますが、\n要するに優劣を付けるものでは無いにせよ、\n違うって事でしょう、\n僕等は。[l]\nでも、」":264,"──それでも。":265,"「僕等はお互いを、\nそうやって、違いを誤解したまま、[l]\n絶対に解り合えないまま、[l]\nだからこそ、\n解らないのが当たり前なのなら、」":266,"……いや、こんなことを語っても意味がない。":267,"「んー」":268,"「……なんでも、ありません、[l]\n言うのは止めました。[l]\n……ええ、[l]\n──僕等は単なる配偶子のバリエーション、\nパターンを増やす為だけにつくられた、\n不確定性の種だ！[l]\nＹは有意識視界存在のＶを増やし、\nどうあっても先へ残そうとする為の予防線に過ぎない。[l]\nきっと本来であればＸＸだけで事足りてたのでしょう、\n魔眼質者に♂が著しく少ないのも、\n実はその辺が関係してるんじゃないですかね……っ！」":269,"「……私が言うのも何だけど、[l]\n何の話してるのだろうか、今これ」":270,"「うそうそ。[l]\n私も伊達に永く在る訳じゃ無し、\n貴方の言わんとしてる事は、\nま、\n解らないとは言わないよ。[l]\nでも、」":271,"「私は貴方を好きではあるけれど、\nそういう存在は貴方だけとは限らないし、\nその点を縛るつもりもない。[l]\n良いなあと思えば、\n私は誰とでも●るし、\nそれこそまこくん、\nまこくんは要するに●たいだけじゃないのかな？[l]\n先刻からＹがどうとか言ってるし」":272,"「……それは、」":273,"「……ま、[l]\nとは言っても？[l]\n今までは●るに値する相手なんか、\nまるで居なかったですからね。[l]\n兄様は別格としても──\nまこくんが初めてそう思わせた●なのは確かです。[l]\nそこは悦んで良いですよ。[l]\nただ、──」":274,"「キミはヒトとして、\n健全に生きたいと言ったな？[l]\nと言うことは、[l]\n":275,"綾目やそこのＧＷは、\nオトモダチはどうする気だ？[l]\n両方とも──」":276,"●●●●●だぞ。":277,"「ヒトとして生きるなら、\n当然このままにしてはおけないな？[l]\nかといって、\n償わせるにも、\n誰が信じる？[l]\nあれらの所業を」":278,"「……":279,"私":280,"達の、[l]\n下に来い、\nまこくん。[l]\nそうすれば綾目だろうと其処のそれだろうと、\nそう、[l]\n":281,"三 ":282,"春の":283,"娘だろうと、\n好きなように保護も処置もしてやろう。[l]\n今更彼女達を殲滅しろなんて言わないよ。[l]\nだから、[l]\n……私の":284,"小":285,"姓になれ」":286,"「…[l]…[l]…[l]…[l]…[l]…[l]…[l]…[l]…」":287,"「………………」":288,"「……今は、」":289,"「うん」":290,"「……脳が、[l]空転して、[l]\n判断が、[l]出来ません。[l]\nでも、」":291,"「僕は貴女と──[l]貴女の言葉で言うなら\n":292,"ばなきゃいけない、\nそうでしょう。[l]\nだから、[l]\n……僕が負かされたら、[l]\n………貴女の言うとおりにします。[l]\nその代わり、[l]彼女達の事も、[l]\n宜しくお願いします。[l]\nでも、僕が勝ったなら──」":293,"「……自我を通す為に、[l]\n彼女達に償いを強いる、\nそういうこと？」":294,"「…………………………」":295,"「………ま、[l]\nいいです。[l]\nまこくんが勝つ前提の話をしても、\n無意味極まりないですし？[l]\nそれに、\n言いましたが、\nヒトの法で償わせるには、状況が状況です」":296,"「そう……ですね。[l]\nまずは、\n貴女を負かしてから──です」":297,"……正直、":298,"宮さんの問いには、[l]\nどうあっても、\n答えられるとは思えなかった。":299,"そして、[l]\n我が身の力……":300,"都":301,"合":302,"よ":303,"フ":304,"ラ":305,"グ":306,"た":307,"て":308,"る":309,"在、[l]\n":310,"そ":311,"強引":312,"に":313,"決着":314,"を":315,"つ":316,"け":317,"在の、[l]\nその力の発揮を切に、":318,"切に願うしかなかった。":319,"……イーハとしての自分を思い出しても、[l]\n結局は、[l]\n流され型主人公のまま、なんだな、僕は……":320,"「んむっ、\nわかりました。[l]\nじゃあそろそろ、[l]\n":321,"お互いモヤモヤは水に流して、うひひ、」":322,"遊びましょう。":323,"「なんだかんだ言っても、\nまこくんにしか、[l]\n──宮の相手、出来ないんですからね？」":324,"「……あはは」":325,"僭越ながら。":326,"光栄です。":327,"そう、やっぱり、[l]\n直接会って、[l]視て、[l]話してると、[l]\nむかついて、[l]悲しくて、[l]……でも嬉しくて、":328,"僕は憎み合いたくない、[l]だから、[l]さよなら\n　　嫌いだけど、[l]憎んではいません。":329,"そんな冷静で御行儀の良い、\n垢抜けた思考は、[l]\n会ってしまったらすぐに飛んでしまったけれど、":330,"♂♀のことなんて、[l]\nロジカルと最もかけ離れたところにある事項、[l]\nエロスだろうとなんだろうと、[l]\n本能により近い所にある精神活動だろう。":331,"僕等はＹの欲動には逆らい難く、[l]\nそれに振り回される憐れな存在。":332,"だから。":333,"そうであるがゆえに、[l]断ち切ろうとつとめよう。":334,"必死で──。":335,"「……本気、出してくれるんすね、僕程度相手に」":336,"──眼前に立ち顕れるは、\n白のミルハの":337,"全":338,"動":339," 様":340,"式、[l]\n『大いなる紅き眼と白をまとう災』。":341,"「あ、ただ、コトを始め……やりあう前に」":342,"「んむ？[l]\nなんですか」":343,"「取り敢えず音を避難させてくださると、\n僕も遠慮せずにやれるんですけど」":344,"「……おおう、[l]\n結構放置してたけど大丈夫かな？[l]\nお？」":345,"「？」":346,"「じゃすとたいみん。[l]\nおーい、こっち」":347,"「あ」":348,"宮さんが僕の後方に向けて手を振るので、\n不思議に思い振り向くと、":349,"チノ嬢が":350,"彼":351,"Ｃ":352,"Ａ":353,"Ｔと共に、":354,"今し方現れた所だった。":355,"チノ嬢は僕を視て一瞬止まったようだが、\nそれだけだ。[l]\nお互いに話すことも無かった。[l]\n":356,"彼女はすぐに宮さんと何やら会話を始め、\n音はチノ嬢と共に何処かへ消えた。":357,"それを視ながら、\n僕の心にある思考が去来する。":358,"──僕が、\n彼女に言わないまま、\nどうしても宮さんと戦わねばならない理由が、\nもうひとつある、":359,"最後に言われた、\nあのひとの双子の兄に。[l]\nそのことばが。":360,"ボクには妹がいる、[l]\n　　最も愛する存在。":361,"でも、●●●●すぎた。":362,"「おさなきものにはお仕置きを、[l]\nしなきゃいけない時がある──」":363,"強くなるというのは、":364,"完":365,"す":366,"るというのは、":367,"負けや失敗を知らない綺麗な存在のままで居ることじゃない。":368,"バッドエンド含めて、リストは埋めねばならない。":369,"不可能の文字がない辞書は、":370,"不完全なんだ。":371,"それをなすのが──":372,"「ほんとにすげぇゲーマーってことでしょ、[l]\n宮さん」":373,"……正直僕には理解の及ばない、世界だけどっ！":374,"それこそ大神なら──":375,"大神、どうなってるんだろう……":376,"「おまたせ」":377,"……宮さんが、[l]\n僕の前に再び立つ。":378,"暗き山中、夜の闇の中、\n宮さんの白き紅きその姿は、":379,"懐かしき、畏れを呼び起こす、\nかつて敵対していた時そのままの、":380,"──うつくしくいとおしいすがた。":381,"「……だるいデモはスキップされちゃいますからね。[l]\nさ、[l]もう我慢の限界、[l]\nはやく──」":382,"こいっ！":383,"「……ふぅーーーー──」":384,"さあ、":385,"ここからは、":386,"純粋にたたかうあいてどうし、":387,"たたかって、":388,"あなたを負かします。":389,"「全力で、宮さん……っ！」":390,"無敗というのは強さじゃない、[l]\n　　負けの恐怖を知らないと言うことは":391,"脆さは、時に致命的なんだよ。":392,"弱さを知るものが優しさを知る、\n　　そういうお為ごかしを言うつもりはないよ。":393,"おとなになってからの麻疹は、\n　　重篤になり兼ねない。":394,"●としてもう少し早く気付くべきだった。[l]\n　　他にいるであろう本当の敵性体に、\n　　本番で負かされる前に、":395,"キミという最もあれに近づけ得る存在に、":396,"託そう。":397,"自分で出来ない歯痒さを、どうかわかって欲しい、":398,"あのこを宜しく頼む、":399,"飯":400,"窪":401,"真":402,"言。":403,"あのなあカルロサ。":404,"あんたの言ってる事は相変わらず過保護で、[l]\n自分勝手で、[l]\n駄目押しに他人を巻き込みまくるっていう、[l]\n極め付きに傍迷惑な話だよ。":405,"でもそれを承諾したのも、[l]僕の、[l]僕自身の決断だ。":406,"今、こうしてあのひとと遣り合える役を、[l]\nあんな昔から割り振ってくれた事にだけは、[l]\n感謝してるよ。":407,"だから精精、":408,"あんたの望みが叶う事を祈っててくれ。":409,"猫の王の封印、[l]\n":410,"僕":411,"と":412,"冬":413,"夏のこめしもの、":414,"「":415,"Seal":416,"\"O\"、[l]\nいくぞ！！！！！！！！！！」":417},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_075.ks","relPath":"/data/scenario/SC_M_075.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":397,"length":418,"percent":94.97607655502392},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[390,1]},"/data/scenario/SC_M_076.ks":{"data":[["まさに初太刀とも言うべき、[l]\n『大いなる紅き眼と白をまとう災』その紅腕による、[l]\n第一撃は宮さんから放たれた。","堪称最初一刀的，[l]\n『裹挟着伟大红眼与白的灾厄』其红腕发出的，[l]\n第一击由小宫放出。"],["シロは防御しこそすれ、\n基本的には僕が装備品の様にして遣うものだから、\n脊髄反射並の回路迂回で放たれる紅腕とは速度のレベルが違う。","小白虽然会防御，\n但基本是作为我的装备来使用，\n与通过脊髓反射级回路迂回发出的红腕速度不在一个层次。"],["……あのモードは顔が視えなくなるから、[l]\nこちらも変に気後れせずに済むけれど、[l]\nどっちにしても、\n僕から手を出す事は出来なかっただろう。[l]\n何にせよファーストアタックは取られた形になる。","……那个模式会看不见脸，[l]\n这样我也能避免莫名畏缩，[l]\n但无论如何，\n我大概都没法主动出手吧。[l]\n总之先手是被对方抢到了。"],["こっちも仮面で顔は視えないはずだけど、\nそんなのを気にしてくれるようなひとだったら、\nそもそも今こんなに苦労してないわな。","我戴着面具应该也看不见脸，\n但要是会在意这种事的人，\n一开始就不会这么辛苦了吧。"],["ざしゅぅ、","嚓咻，"],["「ふっ、」","「呵，」"],["息を吐き出す。","吐出一口气。"],["紅腕による攻撃は、\n予備動","红腕的攻击，\n虽非"],["作無しから繰り出される訳じゃないが、\n身体から分離してるときはその限りじゃないし、[l]\n","完全无预备动作，\n但与身体分离时就不受此限，[l]\n"],["連","连"],["続","续"],["打","打"],["撃に","化作击"],["鋭","锐"],["爪","爪"],["斬","斩"],["撃という、[l]\n","所谓击、[l]\n"],["単純にして明快、\n相手にダメージを与えるべくして繰り出される、[l]\n小細工なしの","既单纯又明确、\n正是为给予对手伤害而施展、[l]\n毫无花招的"],["業。","业。"],["それに足も尻尾も翼も、\nその気になれば攻撃に回せる。","连双脚尾巴翅膀、\n只要想都能转为攻势。"],["今の僕のように、遣い手とＣＡＴ、[l]\nというプロセスやルートが無駄に多い遣り方は、\n我が身そのものと言ってもいい、\n初太刀の時のように、\n脊髄反射に近い宮さんの遣り方とは自ずと差が出る。","就像现在的我一样，使役者与CAT、[l]\n这种流程和路线都过于繁琐的操纵方式、\n可以说就是我自身的写照、\n与初次挥刀时、\n近乎脊髓反射的宫式战法自然存在差距。"],["「ひゅっ！」","「咻！」"],["──他の汎用ＣＡＴがそうであるように、[l]\nシロは攻防を同時にこなす役を担うが、","──正如其他通用型CAT那样、[l]\n白同时肩负着攻防一体的职责、"],["装備品のように従属しながらも、\n","虽像装备品般处于从属地位、\n"],["半","半"],["自律","自律"],["的","的"],["行","行"],["動も出来てるらしい。[l]\nしかも、[l]\n恐らくかなり反応速度が速くチューンされており、\n僕の意思や認識を上回る反応で、","却似乎仍保有自主行动能力。[l]\n不仅如此、[l]\n恐怕还被调校出相当迅捷的反应速度、\n以超越我意志与认知的反应、"],["「んっ！」","「嗯！」"],["ぎゅにぃ、","咕唧、"],["奇妙な音……或いは鳴き声を出しながら、","发出怪异声响……或者说鸣叫声的同时、"],["受けからのカウンター、","从格挡转为反击、"],["「でやぁっ！！！」","「看招！！！」"],["「きかな──いって！！」","「别小──瞧人！！」"],["更にそれを受け流されたりし、[l]\n地面を抉り、時に木々を破壊しながら、","甚至能将那些攻势悉数化解、[l]\n剐蹭着地面，时而摧折林木、"],["僕らは遊んでいる。","我们在玩耍。"],["そう、[l]\nこれは","没错，[l]\n这是"],["遊","妓"],["戯だ。","场游戏。"],["最早、\n何の為だとか、[l]\n思いがどうとか、[l]\nそういうものは、[l]\n主軸とはずれていた。","早已，\n为了什么、[l]\n怀着怎样的想法、[l]\n这些玩意儿，[l]\n都偏离了主轴。"],["個殺してのぞむもの、","通过杀戮追求之物、"],["目的と手段は混淆して、[l]\nただひたすらに、","目的与手段混淆不清、[l]\n只是纯粹地、"],["あいてをたおすこと。","将对方击倒。"],["それに集中していくうちに、","在专注于此的过程中，"],["「──ああああ、[l]\nまだ身体のがおっつかないっ！！！」","「──啊啊啊、[l]\n身体还是跟不上啊！！！」"],["思考と身体のリンクがまだぎこちない！！！","思维与身体的链接还很生涩！！！"],["大神言う所の、\n久々にやるゲームは操作系の勘が戻るまで、[l]\n勝手が違ってあっと言う間に──","正如大神所说、\n时隔许久再玩游戏时，在操作手感恢复之前、[l]\n会因不习惯而转眼间──"],["ひぃーーーーーーにょうううう、","咿呀呀呀呀呀呀尿呜呜呜、"],["だおああああん！！","呜啊啊啊啊啊！！"],["「ガードが出来ても今のは避けれてなきゃっ、」","「就算能防御刚才那招要是躲不开的话，」"],["「にぃぃいぃぃいいいいいいいいいっ」","「呜噫噫噫噫噫噫噫噫噫——」"],["「攻撃次第では一撃死ダメージ通るからねっ！」","「根据攻击类型可能会一击毙命哦！」"],["例の誰かさんが基礎の書式設計した筈のこのシロは、[l]\n宮さんの……本気攻撃にも耐えうる数値設定に、[l]\nしてあって然るべきだと思うが、[l]\nそんな想定を越えてるのか、[l]\nあの兄貴が知らず知らず妹馬鹿っぷりを出しちゃってたのか、","按理说那位某人应该做过基础数值设计的这个系统，[l]\n宫小姐的……连认真攻击都能承受的参数设定，[l]\n本该如此才对，[l]\n是超出了这种预期吗，[l]\n还是那个大哥不知不觉就暴露出妹控本性了呢，"],["「──流石に痛ってぇっ！」","「──果然好痛啊！」"],["ガードの上から削られるっ……！","隔着防御都被削血……！"],["更に、[l]\n肉体的にというよりも、[l]\n精神的な圧倒感とでも言おうか、[l]\n攻撃される威圧感と言うのは、[l]\n子供の頃の仕込み以来ほぼ喧嘩と無縁の、[l]\nしがない文系男子として生きてきた僕にとっては、[l]\nなかなかに、","而且，[l]\n与其说是物理层面，[l]\n不如说是精神上的碾压感，[l]\n这种遭受攻击的压迫感，[l]\n对于自幼习武后就几乎与打架无缘、[l]\n作为平凡文科男活到现在的我而言，[l]\n实在是，"],["だぁん！","咚！"],["「んむ、[l]んむ、[l]んむー、[l]\nまだだよぉ、これはまだ小ぱんち程度だからねぇ、[l]\nこれで回復つかってるようじゃ、\nあっと言う間に──」","「嗯唔、[l]嗯唔、[l]嗯唔──、[l]\n还不行哦、这才只是小拳拳的程度呢、[l]\n要是这种程度就用回复的话、\n转眼间就会──」"],["ぶぅん！","嗡！"],["……おっかねぇって！","……超可怕的好吗！"],["「御忠告どうも……」","「承蒙忠告……」"],["やっぱパリィ重視でいかなきゃきついか……","果然不主攻格挡的话会很吃力啊……"],["取り敢えず、ぎこちないなりに、[l]\n身体は勝手に動く。[l]\n宮さんや大神程は遊ばないけど、\nそれでも昔取った杵柄、","总之、尽管动作笨拙、[l]\n身体却擅自行动起来。[l]\n虽然不像宫小姐或大神那样游刃有余、\n但毕竟是从前练就的本事、"],["車や自転車の運転と一緒で、\n肉体記憶はそうそう忘れない、\nが、\n先刻の感想通り、\n操作系の勘が戻るにはもうちょっと、","就像开车骑自行车一样、\n肌肉记忆可没那么容易忘记、\n不过、\n正如刚才的感想、\n要找回操作系的手感还得再、"],["ひーーーーーーーーー","咿────────"],["「！！！」",""],["びゅお！","咻！"],["ぎゃむーーーーん！！！！","嘎呜──────！！！！"],["「あっだぁ！」","「好痛啊！」"],["……だから危ないって！","……所以说很危险啊！"],["「そーですそーです、受けるならそんな感じ、[l]\nでもまだ力を逃がし切れてないですね。[l]\n","「对对对、要接招的话就是那种感觉、[l]\n但还没完全卸掉力道呢。[l]\n"],["そんなじゃはじかれモーション大きすぎて反撃、\n出来ないでしょぉ」","这样弹反动作太大反而会、\n没法反击吧啊啊」"],["「……っでででで、[l]わかってますよっ」","「……可可可可、[l]我知道啦！」"],["さんざん眠った事による、\n頭ん中の再構成は出来てるとしても、[l]\nその分逆に身体の方がまだ、\n寝惚けが残ってるっ！","虽然因为睡了个够、\n脑子里的重构算是完成了、[l]\n但身体反而还残留着、\n刚睡醒的迷糊感！"],["ううっ、[l]\nシロのセミオートさが、\nまだ仇になりかねない程度の肉体のこなれ、[l]\n早く何としてでも調子を戻さねばならない。","呜呜、[l]\n小白的半自动特性、\n配上这具尚未磨合到位的身体、[l]\n必须尽快想办法恢复状态才行。"],["僕としての、\n初めてのまともな実戦が、[l]\nラスボス……[l]いや裏の隠しボス並の、[l]\nそんなのと、[l]\n操作系があやふやなコンディションで遣り合うとは、[l]\n無茶な話ではあったんだろうけど、[l]\nそんな、[l]復調を待てる余裕がいつだってあるわけじゃ、","作为我的、\n第一次正经实战、[l]\n最终BOSS……[l]不隐藏关BOSS级别的、[l]\n那种对手、[l]\n居然要在操作不稳定的状态下硬刚、[l]\n虽然确实太乱来了、[l]\n但哪有什么、[l]等着慢慢恢复的余裕啊、"],["「ねえしっ！！！」","「根本不存在嘛！！！」"],["「かまーん♪」","「锵—♪」"],["じゃりっ！","沙啦！"],["「──しゅっ！！」","「——咻！！」"],["地面に突き刺し、\n高飛びのようにっ、","刺入地面，\n如同高跳般，"],["「相手の飛び込み迎撃技くらい警戒なさいっ」","「至少该提防对手的飞身迎击技吧」"],["跳びつつ引き抜くその抵抗感をそのまま威力に乗せてっ、","借着跃起拔刀时的阻力顺势增强威力，"],["「………！！！」",""],["シロ自身の、[l]\n恐るべき精度を持つ的確な重心移動も相まって、","白自身的、[l]\n再加上那拥有惊人精度的精准重心移动、"],["肩口めがけ振り下ろしっ、","瞄准肩头挥砍而下、"],["「おっ」","「噢」"],["ぎぃん！","吱——！"],["当然ガードされるけど、接触点を軸に、\n","虽然理所当然被格挡了，但以接触点为轴、\n"],["梃の要領で後ろに回り込むっ、","利用杠杆原理旋身绕到后方、"],["ざざざざ！","唰唰唰唰！"],["翼をっ、","对着翅膀、"],["「──ち！！！」","「──咿！！！」"],["「おしいなー」","「可惜啊—」"],["………あぶな、","………好险、"],["カウンターこそ喰らわずに済んだが、\n軸がずれてたら直撃してた……","虽然总算没吃到反击、\n要是轴心偏了就直接命中了……"],["今更ながら、[l]\n全身にびっしりと、[l]\nイヤな汗をかいている事に気付く。","直到现在才注意到、[l]\n全身上下、[l]\n早已沁满令人不适的冷汗。"],["……こっちの大技すら、[l]\n事も無げに対処してくる宮さんは、[l]\nどう考えてもまだまだ本気じゃない。","……就连我的大招，[l]\n都能轻松化解的宫小姐，[l]\n怎么看都还没动真格。"],["「……さすが、[l]\n最強の白、[l]ですね、[l]これは、[l]\nとても……」","「……不愧是、[l]\n最强的白，[l]呢，[l]这个、[l]\n实在……」"],["かてるきがしません──","看不到胜算——"],["理屈や思いとは関係なく、\n感想としてそう思う。[l]\n完全に、こっちのレベル足りてない。","无关理论与信念、\n作为感想如此认为。[l]\n完全就是，这边的水平不够。"],["かつて僕が完全にその軍門に下らざるを得なかった、[l]\nＷＣＬの白透女、[l]\n","正如昔日我不得不彻底臣服于其麾下的、[l]\nWCL的白透女、[l]\n"],["パラミアキス♀の受肉せし姿、[l]\nミルハ・クララ・リデル──そして、","帕拉米亚基斯♀的肉身化身、[l]\n米尔哈・克拉拉・利德尔——以及、"],["宮岡門王水。","宫冈门王水。"],["僕を","只要"],["仆したのはこの肉の祖先、\nつまり最初の魔眼の刺し手だから、[l]\n宮さんとの直接対決は初だが、","被我打倒的是这具肉体的祖先，\n也就是初代魔眼杀手，[l]\n虽然这是首次与宫小姐正面交锋，"],["Lu=Leの中では唯一とも言える対抗手段の筈だった、\n黒のイツワ、[l]\n同じパラミアキス＝アンセスターとは言え、[l]\nやっぱりＸＸとはその構造が、","但在Lu=Le中本该是唯一的对抗手段、\n黑之伊兹瓦、[l]\n虽同为帕拉米亚基斯=祖先、[l]\n果然XX的结构还是、"],["……それ以前に、[l]\nその魔眼の刺し手に敗れてる訳だしなあ……","……不、在那之前、[l]\n毕竟已经败给那个魔眼杀手了啊……"],["それでも、\n甘かった、とは思わない。","即便如此、\n也并不觉得是天真所致。"],["当時とは違う、\n今の僕には背負ったものがある。","与那时不同、\n如今的我有所背负之物。"],["が、","但，"],["「……クエストリタイア……[l]いや、リセット、[l]\n違うな……[l]いっそ電源落としたい……」","「……任务放弃……[l]不、重置、[l]\n不对……[l]干脆想直接关机……」"],["大神のよく言う台詞だが、\n思わず口を衝いて出ていた。","虽然是大神常挂嘴边的台词、\n却不由自主脱口而出。"],["「彼奴が仮に助勢に入っても……[l]\nどうかな……標的分散くらいにしかならないか……」","「就算那家伙来助阵……[l]\n恐怕……也只能起到分散目标的作用吧……」"],["が、[l]\n僕の追い詰められた状況を全く意に介す様子もなく、\n宮さんは、[l]\nあの頭部からでも、\n内の表情がワカルくらいに愉しげな声で、","但，[l]\n她对我被逼入绝境的状况毫不在意，\n宫小姐，[l]\n即便从那个头部，\n也能听出她愉悦到能想象内部表情的声音，"],["「──まこくんはいま、」","「——小真现在、」"],["たのしい？","开心吗？"],["そう、言った。","如此、说道。"],["「宮はね、\n愉しいですよぉ。[l]\n獲物を狩るのにはね、\n強烈な歓喜があるのです。[l]\n私達には争いを愉しめるべく、\n設計され仕込まれた何かが、\nあるんじゃないかという気がしますよ。[l]\nゲームは、[l]\n相手を殺すリスクを無くすべく規則をつくり、\n互いに承知の上でわざわざ相争うという、\nヒトの作り上げた文化のひとつ。[l]\nヒトは戦うのが──[l]正確には相手を負かすのが、[l]\n大好きなのですよ、まこくん」","「宫啊，\n可愉快了哟。[l]\n狩猎猎物的时候啊，\n会有强烈的欢愉呢。[l]\n我觉得我们体内大概被设计安装了\n某种能享受争斗的\n机关吧。[l]\n游戏啊，[l]\n是为了消除杀死对方的风险而制定规则，\n让彼此在明知故犯的情况下刻意争斗，\n是人类创造的文化之一。[l]\n人类就是喜欢战斗──[l]准确说是喜欢战胜对手，[l]\n最喜欢了呢，小真」"],["「……」",""],["言ってる事はご尤もと思うし、\n実際、[l]\n僕もこの状況は、[l]\n辛いとか、苦しいとか、\nそういう感情に支配されてる訳では無かった。","她说的话我觉得很有道理，\n实际上，[l]\n我现在的处境[l]\n也并非被痛苦、煎熬之类的\n情绪所支配。"],["如何にして負けずにすむべく動くか、[l]\nそして相手を負かすか、[l]\nそのことに全力を尽くしている、","满脑子都是如何行动才能不输，[l]\n以及如何战胜对手，[l]\n全身心投入其中，"],["その感じは、\n決して悪いものじゃなく──","这种感觉\n倒也不坏──"],["「テレビで負けず嫌いなタレントは散見するだろ？[l]\nあのさまをご覧よ。[l]\nあれこそが、\nヒトのその元来的な一面を雄弁に物語る一例だ」","「电视上经常能看到不服输的艺人吧？[l]\n看看那副德性。[l]\n那正是\n人类与生俱来本性的绝佳例证」"],["「……は？[l]\nあ、え、ええ、\nまあ」","「……哈？[l]\n啊、呃、嗯，\n这个嘛」"],["「♂と♀のそれでは、\n先刻の話の通り、すこぉしベースにずれがあるけどね。[l]\nま、[l]\nどんなに平和主義を語ろうとしたって、\n争いを止めろ、という名目で争わざるを得ない。[l]\nシュプレヒコールは物理的攻撃ではないが、\n傍から視ていて十分に、\n攻撃的だろ？」","「♂和♀的争斗\n就像刚才说的，基础参数有点偏差就是了。[l]\n不过，[l]\n就算再怎么宣扬和平主义，\n以制止争斗为名本身就不得不争斗。[l]\n口号虽然不算物理攻击，\n但在旁人看来\n足够具有攻击性了吧？」"],["何度でも言うが間違ってると言ってる訳じゃない、\n生きるってことは我を通すって事でもあるし、\nそのためには争わない事など有り得ない。[l]\n説得でさえ、相手を負かす事には変わりない。","我再强调这不是说你们错了，\n活着就是要贯彻自我，\n为此不可能避免争斗。[l]\n就连说服对方，本质上也是战胜对方。"],["差異があるとすれば、\n要は、相手が納得するかしないかだけだ。","要说区别的话，\n关键只在于对方是否认同。"],["ヒトは言語を手に入れた御陰で、\n『論理』というアリもしない虚構の真実に振り回されて、[l]\nしてもいい争いとしてはいけない争いが混淆としてしまった。[l]\nだから勘違いする者も現れるのさ。","人类因为掌握了语言，\n反被『逻辑』这种荒唐的虚构真相耍得团团转，[l]\n把可以争斗和不该争斗的事混为一谈了。[l]\n所以才会出现误解者啊。"],["──そう宮さんは言った。","──宫这么说道。"],["「……何にしても、あなたから言われるのは、[l]\nものすごくこう、\n腑に落ちません」","「……不管怎么说，从你嘴里讲出来[l]\n总觉得\n特别难以接受」"],["「んむっ。[l]\nいいですよーだ。[l]\n","「嗯唔。[l]\n没关系啦～[l]\n"],["さて、カラダの方は回復した？」","话说身体恢复了吗？」"],["「はい？」","「啊？」"],["「もうイけるみたいですね？[l]\nじゃ、また始めますよ」","「看来已经可以了？[l]\n那就重新开始咯」"],["ぅみぃーーーーーーーーーん！！！","呜咿——————！！！"],["「げ、\nま、」","「呜、\n等、」"],["ひゅうーーーー…","咻————…"],["「ってくれったって、\nは、はやぇっ！」","「都说让你等等，\n太、太快了！」"],["ずざ！","嚓！"],["し、[l]シロの御陰で何とか、[l]\n避け切った。","多、[l]多亏了白帮忙，[l]\n总算躲开了。"],["が、視点が定まらないうちに、\n視界外から、","但、在视线还没聚焦时，\n从视野死角，"],["だぁーーーーーん！！！！","咚——————！！！！"],["「っなに！！[l]\n何がっ」","「什、[l]\n么鬼」"],["「前の動きから次を予測して、\n相手が視界内に無くとも回避行動をする！[l]\n視点変更なんか待ってたら、」","「根据前一个动作预判下一步，\n就算目标不在视野内也能闪避！[l]\n要是傻等视角切换的话，」"],["びゅあ！！！！","咻啊！！！！"],["「ぬぎぎ………！！！！！！！」","「唔呃呃………！！！！！！！」"],["「理不尽にハメられる羽目になりますよ！[l]\n魔眼質者の魔眼とは便宜的な言い様、\n逆説的に、[l]\n視えずとも視る、それこそが資質なり！！！」","「就会被迫陷入单方面挨打的局面！[l]\n所谓魔眼使者的魔眼不过是权宜说法，\n反过来说，[l]\n不见而见、那才是真正的资质！！！」"],["「でぇりゃ！！！」","「看招！！！」"],["ばみゅふ。","啪咻。"],["「きゃふぁっ？！[l]\n痛っったぁーーー！！！」","「嘎呜？！[l]\n痛痛痛————！！！」"],["……ヘンに軽い音だったが、[l]\nほぼシロに任せっきりの盲撃ちが、\nどうやら視界外でヒットしたらしい。","……明明是轻飘飘的声音，[l]\n几乎全靠白进行的盲打，\n似乎意外命中了视野外的目标。"],["「へ、へんなとこ攻撃しないでくださいっ！！！」","「别、别打奇怪的地方啊！！！」"],["「はっ？！[l]\nど、どこ……じゃねーよ、[l]\n今更何を言ってんですかっ、\n僕等は今──」","「哈？！[l]\n谁、谁管你哪儿……[l]\n现在说这个太迟了吧，\n我们现在——」"],["どぎゃす！","咚咔！"],["「……[l]～[l]～[l]～～～～！！！！！！！！！！」",""],["し、[l]シロがガードに入った御陰で、[l]\n何とか直撃は避けたが、","多、[l]多亏白及时防御，[l]\n勉强避开了直击，"],["「あ、[l]あんたな、[l]\n今、[l]恐ろしい所を狙ってきただろっ！」","「喂、[l]你这家伙，[l]\n刚才、[l]瞄准了很危险的位置吧！」"],["「あたた……ちっ、[l]\nこの際だからCAsTrateしたっていいじゃんっ！[l]\n宮のPageになるなら丁度良いでしょぉ？！」","「你丫……啧，[l]\n干脆把你阉了也行吧！[l]\n反正要成为宫的Page正合适对吧？！」"],["「ばっ、\n馬鹿言いなさんな！！！[l]\nてか勝負もまだ決まってもないのに」","「笨、\n别说蠢话！！！[l]\n再说胜负都还没定呢」"],["「だって、\nまこくんが宮のものになったら、\nほかの♀に眼移りなんてさせませんもん」","「因为啊，\n要是小真变成宫的东西，\n就不会让你看别的♀一眼了」"],["……このひとぁ、どこまでも……っ、","……这人真是、没完没了……"],["「──、[l]\n……ぼ、[l]僕は、[l]さっきもっ、[l]いいましたがっ、」","「——，[l]\n……我、[l]我刚才也、[l]说过了，」"],["一度距離を取る僕等。","我们暂时拉开距离。"],["すぐさまシロが羽を広げて搦めようとするも、\nあっさりと──[l]華麗に回避された。","虽然白立刻展开羽翼试图缠绕，\n却被干脆利落地——[l]华丽闪避。"],["「僕とて♂です！[l]\n宮さん達の仕込みたる、\nＹの抑えも外されたのでっ、」","「我也是♂啊！[l]\n宫小姐你们设置的，\nY染色体抑制也解除了，」"],["だからこそ、\nあれだけあなたに対してぶちまけられたのだし、","正因如此，\n才能对你那样毫无保留，"],["「僕はこれから、\n積極的に、\nお相手を探すんですからっ！[l]\n……あれ？」","「从今以后，\n我要主动，\n去寻找伴侣了！[l]\n……咦？」"],["再び視界から宮さんが消えた。","宫小姐再次从视野中消失。"],["と、","这时、"],["どぅご！","咚嘎！"],["「が[l]…[l]…[l]っは」","「咕[l]…[l]…[l]啊」"],["──シロが","——白"],["自","自"],["動","动"],["防","挡"],["御してくれたが、\n今度は先刻の比じゃなかったようで、[l]\nそれごと背中に平手でビンタされた……らしい。[l]\nガードの上からがっつり削る……くらいの、[l]\n強烈な……","虽然被制服了，\n但这次似乎和刚才完全不是一个级别，[l]\n连带着被一巴掌扇在背上……的样子。[l]\n隔着护甲都被狠狠削掉一层……程度的，[l]\n强烈……"],["「っっっ……、[l]\nいで、[l]いでででで」","「呜……、[l]\n疼、[l]疼疼疼疼」"],["どう、[l]やら、[l]\nうしろから、[l]\n羽交い締めのような、[l]形で、[l]\nさらに宮さんが僕の顎を掴んで、[l]\n……すぐそこに、[l]宮さんの、[l]\n紅い眼が──","被、[l]用[l]\n从背后、[l]\n像是锁喉的、[l]姿势、[l]\n接着宫小姐又扣住我的下巴、[l]\n……近在咫尺的、[l]宫小姐的、[l]\n赤红眼瞳──"],["「それってあのこたちのことですね？[l]\nさて、[l]どれかな？[l]それともひとりじゃないのかな？」","「你指的是那些孩子对吧？[l]\n那么、[l]是哪个呢？[l]还是说不止一个？」"],["ぐ、","咕、"],["ぐは、","咕哈、"],["ぎりりりりりり………","咯吱吱吱吱………"],["宮さんが、[l]\nそう、[l]言いながら、[l]\nチョークしたままで、[l]\nぼくのひだりうでを──","宫小姐、[l]\n一边、[l]这么说着、[l]\n维持着锁喉姿势、[l]\n将我的左臂──"],["「なぁんかむかつきますよね」","「总觉得很火大呢」"],["ばぎっ、びちびちびち、ぶしゅ！","嘎嘣、噼里啪啦、噗嗤！"],["「！！！！！！！！！！」",""],["ばぐぅん。","吧唧。"],["「ん、おいし♪[l]\nうひひ」","「嗯、好吃♪[l]\n嘻嘻」"],["締め付けていた僕を放り投げ、\n地面に転がった僕を視ながら、[l]\n──表情が視えないから着ぐるみのようで、[l]\nそれなのに仕草だけは可愛らしく、","把钳制中的我甩飞出去、\n俯视着滚落在地的我、[l]\n──因为看不到表情就像穿着玩偶服、[l]\n可举止却格外可爱、"],["「あっ、♂にとっては右手が恋人でしたっけ？[l]\nまちがいたーん」","「啊、♂的右手才是恋人来着？[l]\n搞错啦ー」"],["そう言って、[l]\n……今まで付いていた僕の左腕は、[l]\nあのひとの胃の腑に消えた。","这么说着、[l]\n……原本连接着的左臂、[l]\n已消失在那人的胃袋里。"],["「……それは利き手によるでしょうけど、」","「……这要看惯用手吧，」"],["僕の左腕は既に、\nシロによって速やかに再生されている。","我的左臂早已、\n被白迅速再生完毕。"],["少々熱いくらいで、\nもう、[l]\n行動に支障はないまでに回復しているのが分かる。","虽然还有点发热、\n但已经、[l]\n恢复到不影响行动的程度了。"],["「何のつもりですっ、[l]\nすっげぇ──[l]痛かったんですけど」","「你什么意思、[l]\n超──[l]痛的好吗」"],["無論、シロに限らず、\n十全なＣＡＴの役割の一つがこれなので、\n宮さんにしても、\n確信犯的に……[l]否、それは言葉の使い方が違う、[l]\n僕が腕を治せる事を分かった上での行動だろうから、\nつまりは、","当然、不限于白、\n这是完备型CAT的职能之一、\n即便是宫小姐、\n也是明知故犯……[l]不、这说法不对、[l]\n她是清楚我能再生手臂才这么做的、\n也就是说、"],["「あんたさっきあれだけ、\n……、ああもう！[l]\n何すか、\n何か高度な戦術的意味合いですか？！」","「你刚才明明那么、\n……、啊啊烦死了！[l]\n干嘛啊、\n有什么高深的战术意图吗？！」"],["「んむ？[l]\nなぁんでしょうねぇー。[l]\nあてこすり？[l]\nじぇらしー？[l]\n──うひひ、思わずカッとなりました。[l]\nごめんなさいです」","「嗯哼？[l]\n谁知道呢ー。[l]\n指桑骂槐？[l]\n撒娇耍赖？[l]\n──嘻嘻，不小心就上火啦。[l]\n对不起嘛」"],["ったく、\nこのひとと来た日には……","真是的、\n碰上这家伙的日子……"],["やっぱりわかんねぇっ。[l]\nあんたがそんなだから、\nはっきりキラってくれないからっ、\n僕は──","果然还是搞不懂啊。[l]\n就因为你这样、\n不肯明确说喜欢我、\n我才──"],["「じゃあ、\n一撃ノーガードで喰らってあげます。[l]\nそれから仕切り直し、おけ？[l]\n……さっきみたいなのは無しですよ」","「那、\n就让你吃记无防备的直拳吧。[l]\n然后重新开始，行不？[l]\n……刚才那种可不算数哦」"],["「……んな事言っといてそっちこそ、[l]\nカウンターとか無しですよ、」","「……嘴上这么说你自己倒是、[l]\n别给我搞反击啊、」"],["ご、りっ！","咕、哩！"],["「………あれ」","「………啊咧」"],["「………」",""],["「……あの……」","「……那个……」"],["「………か、顔狙いますか？[l]\n女子の顔面にモロって、\nだ、ダメージはないですけど？[l]\n確かに先刻とは違う場所でしたけど？[l]\nおおお、驚きました、想定外だったので」","「………要、要打脸吗？[l]\n直接往女生脸上招呼、\n虽、虽然不会造成伤害？[l]\n确实和刚才位置不同就是了？[l]\n哇哦吓死了，完全出乎意料」"],["「え、あ、すいません喧嘩慣れしてないもんで……」","「啊、抱、抱歉我不太会打架……」"],["というか、[l]\n一撃喰らわせたれ……[l]って考えた瞬間、[l]\n極自然に、\nボディの方が痛そうだな、\nって思ってしまったのだった。[l]\n更に言い訳するようだけど、\nそれでもこっちは平手打ちの感覚でいたのに、\nシロが拡大解釈して自動で威力を上げるべく動作したのか。","或者说、[l]\n想着让你吃记狠的……[l]的瞬间、[l]\n本能地、\n觉得打身体会更痛、\n就这么出手了。[l]\n虽然听起来像狡辩、\n但我这边本意只是扇个巴掌的程度、\n是白擅自扩大解释自动提升了威力吧。"],["とは言っても、\nそれでもダメージは通らなかったらしいけど、\nまあ、\n今ので何とか出来ると思った訳じゃなし、\nまだまだ、","话虽如此、\n似乎也没造成实际伤害、\n不过、\n倒也不是觉得这招能搞定什么、\n还远远、"],["「……じゃ、[l]\nお遊びの再開。[l]\nまだデキますよね？」","「……那、[l]\n游戏重新开始。[l]\n还能继续对吧？」"],["「……らじゃー。[l]\n勿論、[l]ヤれます……っ！！！」","「……人家才不要。[l]\n当然，[l]可以做……！！！」"],["……まだまだ夜は長い──","……长夜漫漫──"],["「な、なんかどきどきが止まらない……[l]\n状況的に当たり前かもだけど……」","「心、心跳快得停不下来……[l]\n虽然这状况也很正常啦……」"],["「焦らず……でも急いで……[l]\nあ、でも免許もにゃいのにどうしよう？」","「别急……但得快些……[l]\n啊可是连驾照都没有怎么办？」"],["「ま、まずは駐車場着いてから考えよう……[l]\n眼の前の事から集中集中、\nこつこつと、[l]\n一段一段……[l]おわが！？」","「总、总之先到停车场再想……[l]\n集中精神处理眼前的事、\n脚踏实地、[l]\n一步一脚印……[l]呜哇！？」"],["ずりざざざざ！！！","滋溜唰唰唰唰！！！"],["「──っ………？！？！[l]\n………、[l]\n………は、[l]\nは、[l]はあ、[l]はぁ、[l]はぁあ～～～、[l]\nびっくりしたぁ～～～～もう！！！」","「──呜………？！？！[l]\n………、[l]\n………啊、[l]\n啊、[l]哈啊、[l]哈啊、[l]哈啊啊～～～、[l]\n吓死人了啦～～～～真是的！！！」"],["「あせった、[l]あ、[l]あぶなかったぁ……[l]\nと、[l]冬夏ちゃは無事、ういも、[l]にゃんとかだいじょぶ、\nこ、[l]こんなときに滑るにゃんて心臓にわ、[l]悪すぎる」","「慌死了、[l]啊、[l]好险好险……[l]\n冬、[l]冬夏酱没事，我也、[l]喵星人还活着、\n这、[l]这种时候打滑对心脏太、[l]太不友好了」"],["「………ん」","「………嗯」"],["「こないだの雪かな？[l]\n……まあいいや、[l]\n転ばなきゃいいんだいっ、[l]\nう、[l]でも」","「是前几天的积雪吗？[l]\n……算了、[l]\n没摔倒就万事大吉、[l]\n呜、[l]可是」"],["「………ぅ」","「………呜」"],["「ちょ、[l]ちょっと足首ヘンな力入った、[l]かな、[l]\nぐねった感が──」","「稍、[l]稍等脚踝好像使错力了、[l]大概、[l]\n有种扭到的感觉──」"],["ずき。","抽痛。"],["「………っ」","「………呃」"],["「い、[l]だ、[l]だいじょぶ、[l]いける！[l]\nいけるけどっ」","「没、[l]没、[l]没问题、[l]我能行！[l]\n能行但是」"],["「………ぅっ」","「………呜」"],["「や、[l]やばい、[l]だめ、[l]\n泣きそう、[l]\nこんな真っ暗で緊張要素多すぎのストレス環境下に晒されて、\n立て続けに訳の分かんない事起こりまくりで、\nぎりぎりのとこで踏ん張ってたのに、[l]\nこんなこと起きたらもう、\n糸切れるよ、[l]いと、[l]いとの、[l]いとが、[l]\nき、きれちゃうってばっ！！！[l]\nあああ、もう、」","「啊、[l]糟糕、[l]不行、[l]\n要哭了、[l]\n被暴露在这种漆黑又充满紧张要素的高压环境下、\n接二连三发生莫名其妙的事情、\n明明已经在极限边缘硬撑了、[l]\n发生这种事的话、\n弦要断了、[l]弦、[l]弦的、[l]弦要、[l]\n断、断掉了啦！！！[l]\n啊啊、真是的、」"],["「……っ、[l]……」","「……呜、[l]……」"],["「（泣きたい泣きたい泣きたいっ、\n泣きたいよぉーーーーーっ！！！[l]\nでもだめだめだめだめだめだめだめだっ！！！！！！！）」","「（好想哭好想哭好想哭、\n人家超想哭啊啊啊啊啊——！！！[l]\n但是不行不行不行不行不行不行不行啊！！！！！！！）」"],["「……ぁ」","「……啊」"],["「……ふーーーーー……[l]\nはーーーーー………[l]\n………。[l]\n……うっし」","「……呼ーーーーー……[l]\n哈ーーーーー………[l]\n………。[l]\n……好嘞」"],["「……く」","「……唔」"],["「乗り越えた。[l]\nごめん冬夏ちゃ、[l]\nちょっとテンパっちったぃ」","「跨越了。[l]\n对不起冬夏酱、[l]\n稍微有点手忙脚乱啦」"],["「こんばんは」","「晚上好」"],["「ぎゃーーーーーーーーーーーーーーー！！！！！！！」","「呀ーーーーーーーーーーーーーーー！！！！！！！」"],["「………ぅぁ」","「………呜啊」"],["ざわざわ……","嘈杂……"],["「ああ、直截的な害意は無いのでご安心ください。[l]\n狩屋克杖さんと──三春冬夏さん。[l]\nそうですね？」","「啊，请放心我并无直接恶意。[l]\n狩屋克杖小姐与──三春冬夏小姐。[l]\n对吧？」"],["「……だっ、[l]\nだぁっどっ、\nどなたさま、[l]ですかっ？」","「……呜、[l]\n呜哇哇、\n您是哪位、[l]吗？」"],["「名前を知っている事を告げる事で、\n敵意を殺ごうという小手先の","「通过告知知晓姓名这件事、\n这种试图消除敌意的"],["業も、\nそれなりに通じる様ですね……[l]\nまあそれはさておき、[l]\n","小伎俩、\n看来也还算有效呢……[l]\n不过这个暂且不提、[l]\n"],["──私は、[l]真然名無と呼ばれる者です。[l]\n貴女達の主筋にはお世話になっております」","──我是、[l]名为真然名无之人。[l]\n承蒙贵方主家关照」"],["「はっ？！[l]\nあ、あの、え？[l]\n冬夏ちゃ……[l]には聞けないしっ、[l]\nど、どうしよう」","「哈？！[l]\n啊、那个、咦？[l]\n冬夏酱……[l]的事情问不出口啊、[l]\n怎、怎么办」"],["「そんなに構えなくても大丈夫ですよ。[l]\nああ、身の証は、このＣＡＴを以てして──」","「不必如此戒备也没关系哦。[l]\n啊，身份证明的话，就用这个CAT来──」"],["「……！？[l]\nあ、[l]あうあ、[l]そ、[l]え？！[l]\nど、[l]ど、」","「……！？[l]\n啊、[l]啊呜啊、[l]那、[l]诶？！[l]\n这、[l]这、」"],["「ご理解頂けましたようで幸いです。[l]\nさて、本題ですが……[l]\n私は──[l]敵ではありません。[l]\nが、[l]\n残念乍ら味方でもありません。[l]\n全ての要素にBiasをかけるもの。[l]\n矛盾して聞こえますでしょうけど、\nそういうものなのです」","「能获得理解真是太好了。[l]\n那么进入正题……[l]\n我──[l]并非敌人。[l]\n但、[l]\n遗憾的是也并非同伴。[l]\n是为所有要素施加Bias的存在。[l]\n听起来很矛盾吧、\n但这就是我的本质」"],["「えあっ、う、」","「诶啊、唔、」"],["「それでは、告げます。[l]\n今宵の劇──[l]祭儀の終エンを以て、\n貴女方八相をシュから解放しましょう。[l]\nそのインガを断ち切りに","「那么，宣告吧。[l]\n今夜的戏剧──[l]以祭仪的终焉为界，\n将贵方八相从シュ中解放吧。[l]\n为了斩断那份因果"],["罷り","特此"],["越した次第」","才跨越至此」"],["「……！」",""],["「はえ？！」","「啊诶？！」"],["「貴女方にはよきみらいを選択できる権利が、\n時を置かずして与えられる事でしょう。[l]\nその為には、[l]\nその選択を成すには、[l]\n貴女方の","「您有权选择美好的未来，\n想必不久后就会赋予您吧。[l]\n为此，[l]\n要做出那个选择，[l]\n您的"],["Ｃ",""],["Ａ",""],["Ｔは仇なすものに他ならない。[l]\n本来貴女達が持つべきものでは無かったのですしね。[l]\n『真に持つべきひと』の元へお返しするのが道理、\n冬夏さんは特に、[l]\nそう思ってらっしゃるでしょう」","T不过是仇敌罢了。[l]\n这本就不该是你们拥有的东西。[l]\n『理应归还给真正该持有之人』，\n尤其是冬夏小姐，[l]\n您也是这么想的吧」"],["「？！」",""],["「而して、\n冬夏さんのカミは既に持つべき者に渡った様子。[l]\nですから、」","「而，\n冬夏小姐的头发似乎已交给应得之人了。[l]\n所以，」"],["「──はっ」","「──哈」"],["「貴女達は２人とも、[l]\n……礎たり得るジョセイ。[l]\n劇の登場人物にはならずに済むやも知れないが、」","「您们二位，[l]\n……或可成为基石之女性。[l]\n或许不必沦为戏剧中的登场人物，」"],["その舞台裏でホンをつむぐものにはなるかもしれない。","但可能会在幕后编织剧本。"],["「ですからお二人に危害を加えはしませんし、\nさせませんよ。[l]\nただ──、[l]\nそれは渡して貰いましょう」","「因此我们不会伤害二位，\n也不会允许他人伤害。[l]\n只是──，[l]\n那个请交出来吧」"],["「？！[l]\nか、カリヤ……？」","「？！[l]\n卡、卡利亚……？」"],["「代わりに、\n冬夏さん……[l]と、[l]\n貴女の足は治して差し上げましょう。[l]\n早々に下界に降りるが得策かと」","「作为交换，\n冬夏小姐……[l]以及，[l]\n我会治好您的腿。[l]\n尽快返回下界方为上策」"],["「え？[l]\nあ、あれっ？！」","「诶？[l]\n啊、啊咧？！」"],["「……あ、え……？」","「……啊、呃……？」"],["「問題無いですね？[l]\n何よりです。[l]\nさて──」","「没问题吧？[l]\n再好不过。[l]\n那么──」"],["「……え、ええと……」","「……呃、那个……」"],["「……（こくん）」","「……（点头）」"],["「……こ、これ、ですか……」","「……这、这个吗……」"],["かさり。","咔嚓。"],["「ふふ。[l]\nありがとう克杖さん。[l]\nお二人とも──[l]今まで御苦労さまでした。[l]\n良き伴侶をみつけ、子を成すが宜しいでしょう。[l]\n貴女方双方共に、[l]\n良き家庭を、お持ちになりますように」","「呵呵。[l]\n谢谢克杖小姐。[l]\n二位──[l]一直以来辛苦了。[l]\n愿你们找到良缘，孕育子嗣。[l]\n愿您们双方，[l]\n都能建立美满的家庭」"],["───の祝福あれ。","───愿赐予祝福。"],["「……あ、れ？[l]\nい、いない……」","「……啊咧？[l]\n不、不见了……」"],["「と、冬夏ちゃ、だいじょぶ？[l]\nもういいの？！」","「冬、冬夏酱，没事吧？[l]\n已经可以了吗？！」"],["「……う、[l]うん……[l]\nでも──」","「……嗯、[l]嗯……[l]\n但是──」"],["「既に月狂跳の新たなるは姿を現そうとしている。[l]\n次ノ女、[l]\n紅白分かちシアイのはじむるをのぞむ──」","「新月狂跳的新姿态即将显现。[l]\n次之女，[l]\n静待红白分离之爱萌芽──」"],["時機を待ちなさい、\n　　さすれば──","请静候时机，\n　　届时──"],["「──さあ、[l]\nお待たせしました。[l]\nそちらの用件を済ませに──行きましょう」","「──来吧，[l]\n久等了。[l]\n让我们去完成您的事务吧」"],["どれだけ時間が経ったのか、","不知过了多久，"],["ランナーズハイのような、\nおかしな高揚感に包まれていた。","如同跑步者的亢奋般，\n被一种奇妙的快感包围着。"],["感覚は鋭敏になり、研ぎ澄まされ、\n身体の動きも大分こなれて来ていた。[l]\n操作感覚は完全に僕のものとなっていた。","感官变得敏锐而清晰，\n身体的行动也愈发流畅自如。[l]\n操作感已经完全成为我的一部分。"],["シロの反応速度も宮さんに引けを取らぬ程までに。","白的反应速度甚至不输给宫小姐。"],["だから今僕等は、","所以现在的我们，"],["武闘というよりまるで舞踏のように。","与其说是武斗不如说更像在舞蹈。"],["「なんて、愉しいんだろう、\nやはり！[l]\nたたかいこそが！！[l]\n存在するモノの喜びだ、\nまだそうは思えませんかっ」","「多么、令人愉悦啊，\n果然！[l]\n战斗才是！！[l]\n存在之物的喜悦，\n你还不这么认为吗」"],["「残念ながら、\nやっぱりそこまではっ」","「遗憾的是，\n果然还是没能到那种程度」"],["「んむー、[l]\n一晩中、\n二人でこうしてたいねーって、\n思ってたのにっ」","「嗯唔——，[l]\n明明整晚，\n都想和你就这样待在一起——，\n这么想着的」"],["「どうせ朝までやり合うんなら、\nもっと生産的な行為でっ、\n汗かきたいもんですけどこっちはぁああっ」","「既然要干到天亮的话，\n用更富有生产性的行为、\n来流汗才是正理吧啊啊啊」"],["「そっち系の話も、\n何の恥じらいもなく言うようになっちゃってっ、\n記憶取り戻したらすっかり年相応ですかまこくん？」","「连那种话题，\n都能毫不羞耻地说出口了，\n恢复记忆后完全变成符合年龄的样子了呢小真？」"],["「先刻自分でも言ってたでしょうがっ。[l]\n♂ってのはそういうのは敏感に反応するんで、","「刚才你自己不也说过嘛。[l]\n♂这种东西对那种事会敏感反应的，"],["すっ！」","嘶——！」"],["なんて軽口も、[l]\nそろそろ、[l]\n正直、[l]\nこなれてきたとは言え、[l]\n集中も、[l]気力も、[l]かなり、","这类玩笑话，[l]\n差不多，[l]\n老实说，[l]\n虽说已渐入佳境，[l]\n但集中力、[l]气力、[l]也都，"],["厳しいっ！","快到极限了！"],["「んむー。[l]\nなぁんで♂はすぐにそっち方向に話がいっちゃうかなぁ。[l]\nっと、」","「嗯唔——。[l]\n为什么♂总是立刻把话题带往那个方向啊。[l]\n话说，」"],["「……？」",""],["宮さんが急に、\n距離を取って、構えも解いた。","宫小姐突然，\n拉开距离，解除了架势。"],["「……な、なんです」","「……怎、怎么了」"],["僕は、[l]\nまたぞろ","我，[l]\n还以为又要"],["詰られるのかと思った、[l]\nが、","被说教了，[l]\n但，"],["「クエの制限時間がもう近いです。[l]\nそう、[l]\n夜が明けちゃったら色々面倒ですので、\nミリアムの件も残ってますのでね、[l]\nチノも放置しっぱって訳にもいかないので、\nんむ、十分愉しめました。[l]\nありがとうです。[l]\nおつかれさまでした。[l]\n可能ならばまたよろです。[l]\nじゃあ、[l]\n──そろそろ締めに入るぞ」","「任务时限快到了。[l]\n毕竟，[l]\n天亮后会有各种麻烦事，\n米莉安姆的事情也还没解决，[l]\n总不能一直放着千乃不管，\n嗯唔，已经足够尽兴了。[l]\n谢谢你。[l]\n辛苦了。[l]\n可能的话下次再约。[l]\n那么，[l]\n──差不多该收尾了」"],["？",""],["……あれ？","……咦？"],["なんで、眼の前が星空、","为什么、眼前突然出现星空，"],["そんで身体が浮いて","接着身体飘了起来"],["どしゃっ","咚嚓"],["ると思ったらいでで、背中から落ち","刚这么想着就后背朝下坠落"],["だん　ごろごろ　ずざざざ　ざざ","咕噜咕噜 哗啦啦啦 沙沙"],["て転がって景色がぐるんぐるんに","翻滚着景色天旋地转"],["ばらばらららら　からーん","噼里啪啦　哐——"],["って、ああ、仮面が壊されたのか。[l]\nこれもＣＡＴだってのに、[l]\nあんな風に破壊されんの","地，啊啊，面具被打碎了吗。[l]\n明明这也是CAT的说，[l]\n居然被那样破坏掉"],["ずきっ","刺痛"],["かはっ、","哈啊、"],["「あ゛、[l]が、[l]か、」","「啊、[l]嘎、[l]啊、」"],["い、[l]きが、","噫、[l]气息、"],["し、[l]シロっ……","嘶、[l]小白……"],["「んむ、加減もばっちりですな。[l]\n生かさず殺さず、[l]\nあとは","「嗯唔、力度也恰到好处呢。[l]\n让你求生不得求死不能、[l]\n接下来"],["捕","只"],["獲ってとこですが」","差捕获这一步了」"],["──こっちは硬直してた訳でも何でもないのに、","──我这边明明既没有僵直也没有任何异常、"],["避けようとする反応も何も、","却连试图躲避的反应都、"],["全て越えた速度で、","被远超认知的速度彻底压制、"],["あの間合いから、","从那个距离、"],["なにしてくれてるんだ……[l]よ……","开什么玩笑……[l]啊……"],["「最後にもう一度だけ訊こう、[l]\nまこくんが、[l]\n自分から、[l]\n私の、[l]\n……宮の","「最后再问一次、[l]\n小真、[l]\n你主动、[l]\n成为我的、[l]\n……宫家的"],["小","家"],["姓になるつもりは無いの？」","姓氏的打算吗？」"],["自分から言えって……[l]のか……？","要我主动说出来……[l]吗……？"],["ばかやろう……[l]あの兄貴……[l]\nぜんぜん、[l]\n勝ちの眼なんか、","混蛋……[l]那个大哥……[l]\n完全、[l]\n没有胜算、"],["それとも、[l]\nそもそも担がれたのかな……[l]\nあのひとの遊び相手にする為に……","或者说、[l]\n根本就是被推出来当替死鬼的吧……[l]\n为了给那个人当玩物……"],["でもまあ、","不过嘛、"],["……これはこれで……[l]あり……[l]か……","……这样也好……[l]吧……[l]呢……"],["姫様ちゃんや……[l]きぃのことは……[l]たのみます……","姫様……[l]和小贵……[l]就拜托了……"],["ぼくはもう……","我已经……"],["………。",""],["──？",""],["しかし……","然而……"],["いつまで経ってもとどめの一撃はなく、","迟迟没有等到致命一击、"],["宮さんが視ている先には──","宫小姐凝视的前方──"]],"context":[["SC_M_076.ks/index/1/text"],["SC_M_076.ks/index/3/text"],["SC_M_076.ks/index/5/text"],["SC_M_076.ks/index/7/text"],["SC_M_076.ks/index/9/text"],["SC_M_076.ks/index/11/text"],["SC_M_076.ks/index/13/text"],["SC_M_076.ks/index/15/text"],["SC_M_076.ks/index/17/text"],["SC_M_076.ks/index/20/text"],["SC_M_076.ks/index/22/text"],["SC_M_076.ks/index/24/text"],["SC_M_076.ks/index/26/text"],["SC_M_076.ks/index/28/text"],["SC_M_076.ks/index/30/text"],["SC_M_076.ks/index/32/text"],["SC_M_076.ks/index/34/text"],["SC_M_076.ks/index/37/text"],["SC_M_076.ks/index/39/text"],["SC_M_076.ks/index/41/text"],["SC_M_076.ks/index/43/text"],["SC_M_076.ks/index/45/text"],["SC_M_076.ks/index/47/text"],["SC_M_076.ks/index/49/text"],["SC_M_076.ks/index/52/text"],["SC_M_076.ks/index/54/text"],["SC_M_076.ks/index/56/text"],["SC_M_076.ks/index/58/text"],["SC_M_076.ks/index/60/text"],["SC_M_076.ks/index/62/text"],["SC_M_076.ks/index/65/text"],["SC_M_076.ks/index/67/text"],["SC_M_076.ks/index/69/text"],["SC_M_076.ks/index/71/text"],["SC_M_076.ks/index/73/text"],["SC_M_076.ks/index/75/text"],["SC_M_076.ks/index/77/text"],["SC_M_076.ks/index/79/text"],["SC_M_076.ks/index/81/text"],["SC_M_076.ks/index/83/text"],["SC_M_076.ks/index/85/text"],["SC_M_076.ks/index/87/text"],["SC_M_076.ks/index/89/text"],["SC_M_076.ks/index/91/text"],["SC_M_076.ks/index/93/text"],["SC_M_076.ks/index/95/text"],["SC_M_076.ks/index/97/text"],["SC_M_076.ks/index/99/text"],["SC_M_076.ks/index/101/text"],["SC_M_076.ks/index/103/text"],["SC_M_076.ks/index/106/text"],["SC_M_076.ks/index/108/text"],["SC_M_076.ks/index/110/text"],["SC_M_076.ks/index/112/text"],["SC_M_076.ks/index/114/text"],["SC_M_076.ks/index/116/text"],["SC_M_076.ks/index/118/text"],["SC_M_076.ks/index/120/text"],["SC_M_076.ks/index/122/text"],["SC_M_076.ks/index/125/text"],["SC_M_076.ks/index/127/text"],["SC_M_076.ks/index/129/text"],["SC_M_076.ks/index/131/text"],["SC_M_076.ks/index/133/text"],["SC_M_076.ks/index/135/text"],["SC_M_076.ks/index/137/text"],["SC_M_076.ks/index/139/text"],["SC_M_076.ks/index/142/text"],["SC_M_076.ks/index/144/text"],["SC_M_076.ks/i