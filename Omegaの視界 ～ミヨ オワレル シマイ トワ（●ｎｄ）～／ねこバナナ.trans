.ks/index/287/text"],["SC_E_030.ks/index/289/text"],["SC_E_030.ks/index/291/text"],["SC_E_030.ks/index/293/text"],["SC_E_030.ks/index/295/text"],["SC_E_030.ks/index/297/text"],["SC_E_030.ks/index/299/text"],["SC_E_030.ks/index/301/text"],["SC_E_030.ks/index/303/text"],["SC_E_030.ks/index/305/text"],["SC_E_030.ks/index/307/text"],["SC_E_030.ks/index/309/text"],["SC_E_030.ks/index/311/text"],["SC_E_030.ks/index/313/text"],["SC_E_030.ks/index/315/text"],["SC_E_030.ks/index/317/text"],["SC_E_030.ks/index/319/text"],["SC_E_030.ks/index/321/text"],["SC_E_030.ks/index/323/text"],["SC_E_030.ks/index/325/text"],["SC_E_030.ks/index/327/text"],["SC_E_030.ks/index/329/text"],["SC_E_030.ks/index/331/text"],["SC_E_030.ks/index/333/text"],["SC_E_030.ks/index/335/text"],["SC_E_030.ks/index/337/text"],["SC_E_030.ks/index/339/text"],["SC_E_030.ks/index/341/text"],["SC_E_030.ks/index/343/text"],["SC_E_030.ks/index/345/text"],["SC_E_030.ks/index/347/text"],["SC_E_030.ks/index/349/text"],["SC_E_030.ks/index/351/text"],["SC_E_030.ks/index/353/text"],["SC_E_030.ks/index/355/text"],["SC_E_030.ks/index/357/text"],["SC_E_030.ks/index/359/text"],["SC_E_030.ks/index/361/text"],["SC_E_030.ks/index/363/text"],["SC_E_030.ks/index/365/text"],["SC_E_030.ks/index/367/text"],["SC_E_030.ks/index/369/text"],["SC_E_030.ks/index/371/text"],["SC_E_030.ks/index/373/text"],["SC_E_030.ks/index/375/text"],["SC_E_030.ks/index/377/text"],["SC_E_030.ks/index/379/text"],["SC_E_030.ks/index/381/text"],["SC_E_030.ks/index/383/text"],["SC_E_030.ks/index/385/text"],["SC_E_030.ks/index/387/text"],["SC_E_030.ks/index/389/text"],["SC_E_030.ks/index/391/text"],["SC_E_030.ks/index/393/text"],["SC_E_030.ks/index/395/text"]],"tags":[],"parameters":[[{"start":170,"end":208}],[{"start":243,"end":257}],[{"start":287,"end":313}],[{"start":348,"end":355}],[{"start":385,"end":467}],[{"start":475,"end":541}],[{"start":549,"end":650}],[{"start":658,"end":660}],[{"start":671,"end":722}],[{"start":730,"end":825}],[{"start":860,"end":932}],[{"start":962,"end":1063}],[{"start":1098,"end":1135}],[{"start":1141,"end":1198}],[{"start":1228,"end":1276}],[{"start":1282,"end":1338}],[{"start":1373,"end":1457}],[{"start":1487,"end":1562}],[{"start":1568,"end":1621}],[{"start":1662,"end":1720}],[{"start":1728,"end":1781}],[{"start":1789,"end":1854}],[{"start":1884,"end":1963}],[{"start":1971,"end":2026}],[{"start":2034,"end":2082}],[{"start":2117,"end":2184}],[{"start":2192,"end":2245}],[{"start":2275,"end":2289}],[{"start":2324,"end":2357}],[{"start":2365,"end":2426}],[{"start":2434,"end":2493}],[{"start":2501,"end":2539}],[{"start":2547,"end":2610}],[{"start":2640,"end":2723}],[{"start":2758,"end":2810}],[{"start":2818,"end":2866}],[{"start":2874,"end":2975}],[{"start":3005,"end":3075}],[{"start":3083,"end":3194}],[{"start":3229,"end":3248}],[{"start":3254,"end":3313}],[{"start":3349,"end":3422}],[{"start":3430,"end":3486}],[{"start":3496,"end":3524}],[{"start":3532,"end":3637}],[{"start":3672,"end":3719}],[{"start":3727,"end":3791}],[{"start":3821,"end":3944}],[{"start":3979,"end":4051}],[{"start":4059,"end":4110}],[{"start":4140,"end":4207}],[{"start":4215,"end":4311}],[{"start":4319,"end":4382}],[{"start":4417,"end":4426}],[{"start":4437,"end":4504}],[{"start":4512,"end":4590}],[{"start":4598,"end":4692}],[{"start":4700,"end":4817}],[{"start":4825,"end":4876}],[{"start":4884,"end":4962}],[{"start":4998,"end":5042}],[{"start":5050,"end":5128}],[{"start":5163,"end":5217}],[{"start":5225,"end":5259}],[{"start":5267,"end":5327}],[{"start":5335,"end":5370}],[{"start":5378,"end":5413}],[{"start":5443,"end":5553}],[{"start":5561,"end":5644}],[{"start":5652,"end":5695}],[{"start":5703,"end":5742}],[{"start":5777,"end":5829}],[{"start":5837,"end":5877}],[{"start":5885,"end":5969}],[{"start":5999,"end":6083}],[{"start":6091,"end":6137}],[{"start":6172,"end":6267}],[{"start":6275,"end":6325}],[{"start":6355,"end":6367}],[{"start":6402,"end":6418}],[{"start":6426,"end":6486}],[{"start":6522,"end":6562}],[{"start":6597,"end":6654}],[{"start":6662,"end":6695}],[{"start":6705,"end":6752}],[{"start":6782,"end":6864}],[{"start":6872,"end":6894}],[{"start":6905,"end":6912}],[{"start":6947,"end":7001}],[{"start":7009,"end":7020}],[{"start":7031,"end":7071}],[{"start":7079,"end":7147}],[{"start":7155,"end":7198}],[{"start":7228,"end":7259}],[{"start":7268,"end":7269}],[{"start":7279,"end":7318}],[{"start":7326,"end":7364}],[{"start":7372,"end":7437}],[{"start":7445,"end":7520}],[{"start":7528,"end":7584}],[{"start":7592,"end":7599}],[{"start":7608,"end":7609}],[{"start":7618,"end":7662}],[{"start":7697,"end":7801}],[{"start":7818,"end":7819}],[{"start":7829,"end":7917}],[{"start":7947,"end":8004}],[{"start":8039,"end":8147}],[{"start":8177,"end":8229}],[{"start":8235,"end":8286}],[{"start":8321,"end":8356}],[{"start":8386,"end":8489}],[{"start":8497,"end":8567}],[{"start":8608,"end":8648}],[{"start":8656,"end":8732}],[{"start":8740,"end":8784}],[{"start":8792,"end":8884}],[{"start":8892,"end":8925}],[{"start":8933,"end":9002}],[{"start":9010,"end":9076}],[{"start":9084,"end":9123}],[{"start":9153,"end":9258}],[{"start":9266,"end":9327}],[{"start":9335,"end":9379}],[{"start":9387,"end":9486}],[{"start":9494,"end":9508}],[{"start":9518,"end":9519}],[{"start":9528,"end":9536}],[{"start":9571,"end":9633}],[{"start":9641,"end":9776}],[{"start":9784,"end":9846}],[{"start":9876,"end":9929}],[{"start":9937,"end":9995}],[{"start":10003,"end":10095}],[{"start":10130,"end":10224}],[{"start":10254,"end":10310}],[{"start":10318,"end":10371}],[{"start":10381,"end":10382}],[{"start":10391,"end":10420}],[{"start":10455,"end":10514}],[{"start":10522,"end":10601}],[{"start":10609,"end":10640}],[{"start":10648,"end":10719}],[{"start":10755,"end":10809}],[{"start":10844,"end":10909}],[{"start":10917,"end":10999}],[{"start":11029,"end":11078}],[{"start":11113,"end":11168}],[{"start":11198,"end":11297}],[{"start":11332,"end":11432}],[{"start":11462,"end":11485}],[{"start":11520,"end":11554}],[{"start":11562,"end":11626}],[{"start":11634,"end":11708}],[{"start":11716,"end":11797}],[{"start":11827,"end":11844}],[{"start":11879,"end":11953}],[{"start":11983,"end":12052}],[{"start":12087,"end":12117}],[{"start":12125,"end":12203}],[{"start":12211,"end":12309}],[{"start":12317,"end":12352}],[{"start":12360,"end":12437}],[{"start":12467,"end":12567}],[{"start":12575,"end":12612}],[{"start":12620,"end":12705}],[{"start":12740,"end":12815}],[{"start":12823,"end":12922}],[{"start":12952,"end":12977}],[{"start":13012,"end":13087}],[{"start":13095,"end":13188}],[{"start":13224,"end":13298}],[{"start":13306,"end":13397}],[{"start":13405,"end":13463}],[{"start":13471,"end":13549}],[{"start":13557,"end":13621}],[{"start":13656,"end":13725}],[{"start":13733,"end":13810}],[{"start":13840,"end":13911}],[{"start":13919,"end":13984}],[{"start":13992,"end":14089}],[{"start":14097,"end":14170}],[{"start":14205,"end":14286}],[{"start":14294,"end":14370}],[{"start":14400,"end":14447}],[{"start":14455,"end":14524}],[{"start":14559,"end":14609}],[{"start":14639,"end":14649}],[{"start":14684,"end":14724}],[{"start":14820,"end":14989}],[{"start":14997,"end":15180}],[{"start":15188,"end":15282}],[{"start":15330,"end":15355}],[{"start":15391,"end":15507}],[{"start":15517,"end":15644}],[{"start":15692,"end":15708}],[{"start":15744,"end":15812}],[{"start":15860,"end":15892}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_030.ks","basename":"SC_E_030.ks","indexIds":{"「例の借り受けた封紙ですが、\nペイルホワイトも遣って精査したところ」":0,"「ん、\n何かした？」":1,"「かなり厭な気分ですね、\n愉しくは無いです」":2,"「解析面倒？」":3,"「複雑とか難解というよりも、\nformatのレベルから別の書式になっている気配がしますね。[l]\n単純に既存の感覚で、という訳にはいかないのですよ。":4,"勿論貴女の初見で大体合ってはいますが、\n思った以上に弄ってあってですね、\n技術の世代的には寧ろ数段先を行っています。":5,"書式から違うので単純に世代比較は出来ませんが、\n認証方式から起動音の複雑化までまさに次世代型とでも\n言いましょうか、\n貴女も言ってました汎用化、否、逆にpersonalizeか？":6,"まあ":7,"件のLinkableFormを目指そうとしていると考えれば\n納得のいく方向への技術特化ですね。":8,"興味深くもあるのですが、\n……ああ、セキュリティと思われていたのは[l]\nどちらかというとバグですかね。[l]\nエラーを起こしてハングしていたものを誤解されたのかと」":9,"「成る程ね。[l]\nともあれ劣化移植でも無ければ海賊版でも無い、\n独自形式ってやつ？[l]\nじゃあ私でも解除無理かなあ」":10,"「認証方式がかなり有用に……否危険というべきか……[l]\nああ、すみません。[l]\n要素は兎も角構造の方は大分──ん？[l]\n逆かも知れませんが、それはどっちでもいいんですがね」":11,"「え、何の話さ。[l]\nま、でも、破棄された失敗作ってとこでしょ。":12,"これ自体はつかえるシロモノじゃなそう。[l]\nところが、\nねこの封紙であることには変わりない──」":13,"「そうです。[l]\nそれは我等の視る眼がそう感得してるので\n間違いはありません。":14,"大体今回の出所はドレミリアの裔のあの蔵からであって、\n我々とにせよ彼女等とにせよ無関係だとは考えにくい」":15,"「結局の所、\nそもそもこの封紙が在った、という事実自体が、\n別のある事実を指し示している状態が、\nキミの気分を穏やかならぬものにしてるのかい？」":16,"「お察しの通り、\nこの紙封の存在は、\n我々の与り知らぬ所、及び方法で、\narchiveをしている者が居る、という事を示します。":17,"ねこの存在自体はツェロルの件があるのでまだ\n了解出来ますが、\narchiveが可能な者は」":18,"「当初からわかってた通り、\n基本的にはテトライを使用せねばならない。[l]\nそれは我々の専売の筈だ。":19,"これがもたらされた瞬間からある事実は容易に推察されていたし、\nそれについても既に私の所見は語った。":20,"その、\n真っ先に思い浮かんだ内通の容疑者は、\nあの女な訳だけれど……[l]\n──ペイルホワイトはなんて？」":21,"「ワタシより司書長に近しい彼女に\nペイルホワイトなんて通じませんよ。[l]\nもとより職権濫用を慎み自制を旨とし、\n不要な介入はしない、":22,"という一文を自戒の一部に書き込んでいますワタシ\nとしては、\n能力を超えた詮索は知らぬが花です。":23,"ん？[l]\n違いますね？[l]\n何でしたかね、こういう時に使用する慣用表現──」":24,"「なんでもいいって。[l]\n触らぬ神に祟りなし？[l]\nなんか違う気もするなぁ。[l]\n……どっちでもいいよ。":25,"それよりあの女だよ。[l]\nこないだは私情が先走って断定しかけちゃったけど、\nんむー……」":26,"「パラドックスがありますか」":27,"「そうだね……[l]\n先日のあれは私情願望に基づく予断だ。":28,"冷静に考えてあの女は、\nここまで露骨な……つまり、[l]\n出元が特定できるような不手際をするタマじゃない。":29,"手際がおかしく視える時は兄様関係の事を為す時だし、\nそもそも『私と敵対する』のは『兄様と敵対する』のと同義だ。":30,"私にとってはそれにかこつけてあの女を排除したい気持ちは\n山々だけど、":31,"……気色の悪い話だが、[l]\n兄様に奉仕するのが生き甲斐のあの女がそんな真似する筈がない。[l]\nしかし──」":32,"「動けない八相自身は兎も角も、\n彼女がわざわざこの地でそれをしたとするのも\n考えにくいですしね。[l]\n灯台もと暗しを狙ったとすれば別ですが」":33,"「否、此処で行う利点はそれなりにある、\nのは解るんだけど、\n矢張り動機が分からないなあ。":34,"私は動機至上主義じゃないけれど、\nあの女に関しては色んな意味で行動原理が単純明快だから。":35,"基本的にそうと確定が容易な、\n確信的背信行為、明確な抗議行動。[l]\n叛意丸出しとしか視えない行動を示して何の得がある？[l]\nましてや兄様に奉仕する事以外興味のないあれが──」":36,"「となれば残る納得しうる仮説としては、\nミリアムや残党が独自に開発したか──\nその場合、八相の関与は不明ですが、三春の蔵……":37,"あの多少カラクリの仕込まれた建造物から見つかった以上、\n少なくとも彼処の深奥に出入り可能な位置に居る者でしょう。[l]\nドレミリアの裔達の知る所なのかは別ですが。[l]\nお飾りですからねあの血統は」":38,"「まあね。[l]\nそうだな……":39,"キサムラのユーザーがそれなりの資質者であれば、\n考えられなくもないんだけど。[l]\n確か西部だったか」":40,"「そうですね。[l]\n現ユーザーは奇士道具、\n他の八相と比べ世代交代を先延ばしに、\n割合長期に渡りその地位に留まってます。":41,"若しかしたら独自にprot-einでアンチエイジングしている\n可能性もあり、\nその場合は相当遣い":42,"熟せている\nヘヴィユーザーという事になりますが。":43,"西部に関しては常駐が居ない為、\n詳細は現時点では何とも言えませんがね。[l]\nいずれLinkableFormの傾向は偶然そう視えるだけで、\n単純に十全の封紙を自力で得ようとしているのか」":44,"「まあ、彼等にツェロルが揃っているとすれば、\n独自開発も多少は容易になるだろうからね。":45,"最悪『生のまま』を得ることも出来ようが、\n流石に調伏は八相風情じゃ無理だろうな。[l]\nただの野良になるだけだ」":46,"「もし奇士道具がこの封紙製作に密接に咬んでるならば、\nつい最近まで開発は行われていなかったという事になりますし、\nそれなら未だ実験段階だとしても頷けますね。[l]\n多少腕があったとしても、代替での不老などたかが知れている」":47,"「考えようによっては、\nその短期間でここまでの開発を行った、という事だけどね。[l]\nあくまで奇士の仕業と仮定しての話だけれど。":48,"……まて、[l]\nもしそうでなくても、\nツェロルは目覚めてる可能性があるという事か？」":49,"「強固にPHASE:5で不正操作出来れば或いは、\n眠ったまま仮覚醒状態にした上での\n出芽を促す事は可能かも知れません。":50,"本当に目覚めていれば周辺は大変面倒な事に\nなっているでしょうからね、\n少なくとも東部でそういう動きは視えませんし、\n或いは眠らせたままで出芽を制御する術を編み出したか？":51,"ツェロルを連れ去ったであろう運び手の姉妹も\n未だ行方が知れず、\nその彼女が何かしら動いているかも知れませんし」":52,"「残党の去就は未だ":53,"詳らかでないしね。[l]\nただ、実験という側面が見え隠れしてる事からも、\n大量の検体があったのだ、と考えるのが普通だ。":54,"彼の話じゃこのカミも『大量にあった中の１枚』だった\nようだし、\nその『大量のカミ』のうち、\nどれだけがこのイリーガルと同じなのか──":55,"単なるフェイクも混ざってたとは思うけど、\n隠蔽された先でさらに偽装をする手間を考えると……[l]\n普通に考えて其処にあったのは実験過程の封紙、\n或いはそのジャンク。":56,"我々でさえアーカイヴのデータをやりくりしてる中で、\n野良がそんなに簡単に蒐集出来る程に存在してるとは思えない。[l]\nどういう方法をとったかは知らないが、\n猫の萌芽を確保して出芽をさせているのは確定的だろうな。":57,"ま、いずれ十全のねこのない八相には難しくとも、\n姉妹の残党が動いた可能性もあるにはある、のか。":58,"そうなるとあの女でなくともarchiveが可能な条件を\n保持している可能性が全くない訳じゃないんだな。[l]\nあくまで零で無いだけだが……」":59,"「テトライを用いずにarchive……[l]\n方法があるなら興味はありますがね。":60,"今回の一連の中でもし、\nそれらの技術が接収出来そうならばそれも\n視野に入れてはおきます──\nNote殿の暗躍が無かった場合、ですが」":61,"「何にしても当初考えていたよりも、\nあぁ～っもうっっ、\nはるかに面倒なコトが起きてるなぁっ。":62,"そもそも彼処には、\n二枚目と八枚目しかない筈だったでしょぉ？":63,"仮にあったとしても精々、\n過去の蒐集過程で回収してたかも知れない劣化散逸雑魚程度、\nと思ってたんだけど。":64,"何なんだ一体。[l]\n雫の余波、愉快でない方向に発露してるか？":65,"んむー、ほぼ決まりなんだから、\n彼にはちゃんとしてほしいなあ」":66,"「自覚的に雫の能力発揮されても恐ろしいだけですがね。[l]\nま、今の貴女の言葉はちょっとした弱音と察しておきます。[l]\n確かに、今回の劇は望む結果だけを視れば過程は\nさほど面倒ではなかった筈で。":67,"その単純な過程を愉快にすべく『偶さか』誕生した……[l]\n否、この場合は卵が先か鶏が先かという問題が、\nなるべくしてなったと言えばそうである絡まり方、":68,"さて……ん？[l]\nああ、すみませんね。[l]\nどっちでもいいですか。":69,"雫に関してはただ其処に在るを受け入れる、\n数値化言語化はあまり意味を」":70,"「おおっともういいってば。[l]\nどんなに最悪のケースでも、\n私が出張れば済む話だから。":71,"そうならない事を祈るのみだなあ、\n兄様の期待に添うのが最優先事項だしっ。":72,"まあ証拠が無い…というよりは他の可能性がまだ[l]\nある以上、\nあの女も放置するしかないか。[l]\n泳がすという意味では意味が無い訳でもないし」":73,"「先日言いましたが、\n『次のゲェム』の計画という勅命アリ、\nという話もありますし、\n司書長がNote殿の何をも把握してない事はないと思いますが。":74,"咎め無く動いているという事は、\n少なくとも支障を来す要素ではないと視て良いのでは？」":75,"「分かったよ。[l]\nもうあの女に関して思索巡らすのも馬鹿馬鹿しくなってきた。[l]\n私は純粋に遊戯、今回の劇を愉しみたいのに、\n余計な要素ちらつかせてくるからさ……":76,"ま、いいや。[l]\n最強の白はそんな事では揺るがない！[l]\n私は兄様に従うのみっ」":77,"「ある一点を除きですか」":78,"「んむ？[l]\nまあね。":79,"一点で済むかどうかはわかんないけど、\nモチベーション的に集約すると一点と言えるかな。[l]\nところでさ」":80,"「ツェロルの居場所ですか？[l]\nあの蔵の可能性を考えていたのでしょう」":81,"「話が早いね。[l]\nそう、封紙の件がなくとも、\nやつらが持ってるとすれば彼処が最も自然だからね。":82,"ベタに過ぎるとしても、\nあんな巨大なモノを隠匿するのに奇を":83,"衒った所で\nハイリスクなだけだ。[l]\n色んな仕掛けもしてあるんだろ？あの蔵」":84,"「Ｅ凹のIgの格納場程度には。[l]\n元々は二枚目と八枚目、及び他の可能性や偽装に付随して\n蒐集された大量の古書の類を収蔵する為のものでしたからね。":85,"若しあれを隠匿するとすれば\nまさにお":86,"誂え向きかと」":87,"「今回の事で、\n奴等が確保してる可能性はかなり高まった訳だから、\nちょっと突っ込んで調べ……":88,"あ、\nあの時、":89,"件の封紙にかまけて話打ち切ったけど、\n彼はその辺り何か知ってないのかな？":90,"んむぅ、しかし何か視てたなら既に報告の一つも……[l]\n否、今の彼の空転脳からしてそれっきり忘れ去ったという\n可能性も？":91,"んむむ、後で追求しとこう。[l]\nあの時は他の愉しみに眼がいっちゃっててさ…」":92,"「起きた事象としては恐らく弱い故に彼も\nそのまま小事と":93,"看":94,"做して忘れたのでしょうから\n実際接触があったとしても微妙でしょうがね。":95,"いずれツェロルの探索は別働隊の仕事ですので\nどちらでもよいでしょう。":96,"向こうでの噂通りならばあれに関する\npriorityは低い……いえ、[l]\n難易度が低めに設定されてましたからね。":97,"全体の中の要素ではありましたが必須フラグとしては\n定義されておらず、\n或いは既に立っていた、確証を得ていたのかも\n知れません。":98,"我々に知らされていないのは、\n言った通り優先順位が低いのか、\n別働隊で事足りると判断されたのか、":99,"言うまでも無い":100,"瑣":101,"事なのか、\n故あって秘匿されたのか、\n確証もないのに噂だけが立ったのか」":102,"「状況を把握していたとすれば、\nこのイレギュラーな封紙に関して情報が無いのはおかしいよねえ。[l]\nまあそれもあの女が咬んでいて隠されてるとすれば、\n状況的に筋が通らなくもないんだが…":103,"不":104,"灰が張り巡らされてるこの地で、\nあれを隠匿しうる状況としてもそれが楽な推理。[l]\nただ、やっぱり『あの女の行動原理』としては\n筋が通らないんだよなあ」":105,"「となればやはりミリアム達が知らぬ間に力をつけたのですかね。[l]\n向こうが得ている情報の鮮度が違うとか」":106,"「前も言ったが、SHOBに関しては考えにくいかなあ。[l]\nケルベ＝ロアはあの時壊れかけにしてやったのに、\nそんな余裕あるとは思えないけど。[l]\nだからこそわざわざ八相の祭儀もしてるんだろ」":107,"「とは言え腐っても八人姉妹の長姉のfamiliar、\n『ＷＥ』の中でも高位の十装備型ですからね。":108,"先日ご自分で言ってましたが、\n彼にも気付きかけるくらいの稼働は\nまだしている様ですし」":109,"「まさに『猫に九魂あり』か。[l]\nしぶといことこの上なしと」":110,"「ただarchiveが行えるかどうかとなると、\nIgの代行は無理でしょうね。[l]\nそもそもテトライは相の特化云々では無く──\nケルベが身を以て学んだ……可能性も無いではないですが、":111,"それこそ誰がIgを喰らわせる機会があったか、\nという問題があります。[l]\n刺し手のfirstとも交戦はしていない筈ですし」":112,"「んむ。[l]\n今のところ、\nあの女が信念を曲げたのでない限り、":113,"可能性としては八相、のキサムラが代替prot-einの応用で\n独自に開発した線が濃厚か。[l]\nクイとタマズサも咬んでる可能性はあるね。":114,"ただ、\n東西の意志の統一が図れてない気配も\nそこからは臭って来る訳だな。":115,"奴等はそもそも不完全になったあれの不老化をどうこうするために\nわざわざ面倒な祭儀事をしてる訳で、\n奇士あたりが単独でアンチエイジングする\nなぞ許されてない筈だ。":116,"本来の不老化は別の相だし、\n何らかの確執が生じてるのかも。":117,"それに、\nツェロルは仮にとして、\nイリーガル封紙が東部にあったのは、\n西部同士でも一枚岩では無い可能性があるが……":118,"そこはまだ弱いかな。[l]\n西部の仕切りにしても、実力とポジションのギャップを\n考えれば叛意の要素はいくらでもある。":119,"ただあれだけは当初からの人間だし、\n何故今更、という疑問はあるけどね」":120,"「彼女は八相の実質上の最長老で実力者でもありますし、\nそれ故に何時でも簒奪出来るはずのトップを\n永代に渡りドレミリアの裔に委ねたままでいた事が\n彼女の忠誠心の表れかと認識していましたが。":121,"だからこその、\n重要事は全てドレミリアの裔の下で行われる、\nと言う前提で設計された箱庭の配備でしたからね。":122,"ミリアムも今にして思えば西部仕切の方と密接に関係\nしていたのかも知れませんが──":123,"彼処は過去より外つ國との交流もある、\n彼女にとって不自然ではない地な訳で、\nねこが其処彼処に居るわけではない状況でクイの力は存分に\n発揮出来ないと視縊っていたかも知れません。":124,"そうですね、常駐させるべきは":125,"彼":126,"方だったか──」":127,"「まあ、\n今更たらればの話をしてもしょうがないし、\nそもそも兄様が配置しないと言ったんだから良いんじゃない。":128,"実際玉梓のスキャンもこっちでやってるんだし……[l]\nイーハもこっちで繋いだんだしね。[l]\nそれに、\n彼の誕生が無ければ今回の劇も無かった話だ、\n全てが前提条件を旨として配備されたものでない以上、\n多少の隙はしょうがないよ。":129,"愉しみが増えたと思うことにしよう。[l]\nどうあれ倒す相手が居なければ狩もゲェムも成り立たないのだ\nからね」":130,"「雫の余波だとすればかなりの広域、\nButterflyEffect的に連鎖が起きてるのでしょうが。":131,"元より複雑系じみたこの劇では\n端から組み込み済みとは言え、\nカタストロフィへの流れはいただきかね……":132,"まあ、そこでdeus ex machinaへの期待がかかる\nと言った所ですか。[l]\n三重偉大ともなれば少々ややこしいですが、\n始末は己でつけて頂くという事で」":133,"「決められた一本道のシナリオをトレースするだけじゃ\nつまらないのは確かだからね。[l]\nまあ兎に角、サブは後での愉しみにとっておけるし、\nメインを今は考えとこうか」":134,"「そうですね……[l]\nああ、それと忘れておいでかも知れませんが、\n八相の構成者をころしたもの、":135,"我等の手の者では無い以上、\n放置した場合危険な因子になる可能性もありますがね。[l]\n彼も":136,"其":137,"方方面に関して情報を得た訳では\nないのでしょう？」":138,"「ああ、何やら今日も物騒だからボディーガードで\n八相の連中の手伝いに行ってるらしいけど、\nどうだかな、":139,"先刻帰って来るなり、件のドレミリアの末裔に連れ回されて\n今もドライブの真っ最中だよ。[l]\n戻ってきたらツェロルの事含めて報告はさせるけどね。":140,"真に雫たる者なら、\n都合良く犯人と鉢合わせてるかもっ。":141,"……にしても、[l]\nいかな我々が『Ｙの欲動』を強固に抑制してるからとは言え、\n私以外の女子に遊ばれてるのはなんか悔しいなあ」":142,"「ドレミリアの直系……[l]\n貴女方にとって遠い親戚ですが、\n最早どちらでもいいことですか」":143,"「ま、\n多少は感慨深いところが無くもないけど、\nドレはアリスの血統とは言え、\n傍系の中の生き残り風情だし。":144,"興味があるのは『今のあの彼女』の方だね。[l]\nポジション的にも色々使えそうだし。[l]\nみためは兎も角、ポテンシャルまで再現してないことを祈るよ」":145,"「推察が正しければあれも雫の影響でしょうからね、\n何らかのpieceではあるのでしょうが」":146,"「何にしろ、\n犯人に関しては有効な要素たらんとしてあの女が\n放置を進言してたんじゃなかった？」":147,"「劇中の接触は危険だが八相の遣い手をころせる者ならば、\nいずれカイシュウ出来れば同志なり得る可能性アリと。[l]\nかなり興味を示していましたね。[l]\nもしGWであれば──」":148,"「よくよく考えればそんな物騒な因子放置して良い訳あるか？[l]\nまさかあの女私達にまで不正操作仕掛けてたんじゃないだろうな。[l]\nfirewallあるのに効くわけないとは思うが……」":149,"「確かあの場では司書長の是とするに従ったかと」":150,"「ああ、そうか。[l]\nんむー、我ながらちと自戒しないとか。":151,"セカイはスキかキライかとは言え、\nアンチノミー下じゃ二者択一という訳にもいかず、\n優先順位の振り分けが問題だね。":152,"そう言う意味では間違った事をしてはいないけど──\n流石に、\n私以外に実戦闘担当は配備されてない現状も\nそろそろ心許ないか……":153,"本気でCovenの招集かけるかな。[l]\nあ、疑ってるのは兄様じゃなくてあの女だからね。[l]\nさて、招集するとしても問題は犬番のあの娘だが……」":154,"「Ｄは絡ませないという方針では？」":155,"「うーん…[l]\nまあそれはそうか。[l]\n犯人なんてフェンリロスで検索かければ速攻な気もするけど……[l]\nそれも無粋？」":156,"「というより、\nKaleidoを喚ぶとオウトも同行してきませんかね。[l]\n何も知らずに行楽目当てで来るならまだしも──」":157,"「その辺、オウトの自覚がどれだけあるか次第、\nかな？":158,"実はオウトとは、\n彼絡みで間接的に接触した事あるんだけどね、\n全く気付けなかった。[l]\nfirewallも展開してるんだろうが……":159,"消失したと思われていた期間に、\n我々の知らない方向へ進化していたとすれば、\nＤとして我々が把握してる論理上の範囲から、\n更に逸脱した能力を有していてもおかしくはないしなあ。":160,"それより、向こうがこっちに気付いてる場合が\n問題の気がするよ。":161,"Kaleidoからの話を総合すれば、\nだいぶ物わかりは良い様だし、\n気付いていたならそれなりの行動は既にとってると\n思うけど……」":162,"「フェンリロスを以てして匂う程度では、\n貴女に視抜けなかったとしても致し方ないですよ。[l]\n彼等の召喚に関しては先日貴女に人選任せられましたので、\n案は練っていたのですがね。":163,"実戦闘担当の四人を招集、\n残りは待機維持──否、ガード強化で待機。":164,"Enderナンバーが此方に来ますので、\n-cideのスロタラスモルトを中心にNKナンバーは向こうにて\n臨戦態勢で、Kaleidoとオウトは極力絡ませない」":165,"「で、取り敢えずは行ってみるか。[l]\nま、オウトはそこまで気にしなくていいや。[l]\n時期を除けば動きとしては当初の予定通りだしね。":166,"最悪、兄様にはゴメンして私か彼で強行、結果だけ貰おう。[l]\n彼さえ何とかなれば一応は兄様も満足だと思うけど──\nあー……、[l]\n知狡はキリアケとの認証断ったままだよね？」":167,"「ですね。[l]\n再度認証要請しますか？」":168,"「まあ保険としてだし、\nキリアケとて汎用なだけだから、\nどうしても厭がるようなら別にいいよ。[l]\nあんまり相性も良くないし。":169,"現実ちゃんがいれば別だけど──\n土地の者にはあんまり派手に動いて貰いたくないんだ。[l]\nそもそもＥ凹のは専守防衛的に調整してるんだったか。[l]\nキリアケ以外」":170,"「現状Ｅ凹直系以外の此処の常駐ユーザーは……七人、[l]\n和音は──無いでしたかね。無いですね。[l]\nどっちでもいいですか其処は。":171,"尚、ねこですが、[l]\n跫猫（キョウミョウ）、冬眠鼠（ヤマネ）、髯婦蒼（ゼンフソウ）、\n瑕能連火（カノレンカ）、五百枝阿（イオエア）、\n春木盗（ハルキドル）、":172,"そして不灰（フハイ）、麒麟緋（キリアケ）ですね。[l]\nキリアケを除き全て箱庭の環境維持調整に特化してます。":173,"各ユーザーも完全に事務職と言っていい人員なので\n確かに戦力としては見込めませんね。[l]\nでなければわざわざCovenも招集してないですが。":174,"ワタシは久しく会ってませんが、\n此処の人員とねこは瞬間出力を低くする代わり\n過有効稼働期間が永くなっている筈で」":175,"「ああ、そうだったそうだった。[l]\n人前に出ない前提だったし発布もかなり昔だったからね、\n当時は和音もつけなかったんだ。":176,"うーん、\nま、四重奏団（クァルテット）だけで取り敢えず最低限の保険にはなるだろ。[l]\nEnderが張り切りすぎるのだけは心配だけど……」":177,"「Ironに一応釘を刺してはおきますが。[l]\nん？[l]\n釘を刺せと釘を刺すか？[l]\nまあ、どちらでもいいですね。":178,"ただEnderの配備に関しては、\n貴女の前で言いたくはありませんが、\n司書長の意図がどこにあるのか大変微妙ですよ。":179,"仮に因子がGWだとすれば、\nそのPHASE如何では大変面倒なコトになるでしょうが、\n……ま、これ以上は止しましょう。[l]\nいずれNote殿に関しては意識はしておきます。":180,"今回も単独行動ばかりでワタシも去就は把握してないのですよ。[l]\n司書長の勅命で動いているという話、\n嘘ではない事を祈るのみです」":181,"「全く以て兄様ってば、\nなんであの女を手放さないんだろうな……[l]\nそこだけは私が幾ら言っても真面目に聞いてくれないとこ\nなんだよね……":182,"あ、そうだ、いくら急ぎだって、\n箒で来るならそれなりの対策して、\nそうでなくても目立たない格好で来るように\n言っといてくれる？」":183,"「了解です。[l]\n可能かどうかは保証できませんが、\n劇に支障がない程度には。":184,"最悪PHASE:2効果常駐させますが──\nああ、そろそろ彼とドレミリアの裔が、\n……何やら愉快そうな状況で戻ってくるかと」":185,"「んむ？[l]\nなんだろ、仲が進展でもしたのかな。[l]\nうーん、それはそれで──」":186,"「妬けるのですか？」":187,"「うひひ、\nヒミツにしとくよ。[l]\nじゃあ、お疲れ、また後で」":188,"さて、\nLinkableFormへの実験開発か……[l]\nねこの側により重き選択権を委ねる遣り方は、\nツェロルのような侵蝕事故を起こす可能性が増す\nばかりと思うが……[l]\n或いはそれこそが目的か？[l]\nだとしたら何故？[l]\nパストラリー……[l]\n認証の新しい方法……":189,"まあ、\nどんなことを企もうと、\n私と完全に覚醒する彼が揃えば。[l]\n制圧してお仕舞いだ。[l]\nどんなことをしてこようと、\n完全に粉砕できる。[l]\n只でさえイニシアチブは我等が握っているんだ。[l]\n胡蝶の夢、どちらを選択するにしろ、\n……ああ、ちょっと疲れたな。[l]\n少し頭使いすぎた。":190,"んー、背伸びっ。[l]\n──目指す結末を完遂すれば、\nあとは過程を愉しむだけ。[l]\nその中であの女の背信が確定すれば、\nそれはそれでとても愉しい、方向だ。":191,"「お前がもし私と兄様の邪魔をしたかったのなら──」":192,"うひひ。[l]\n\n兄様、ごめんなさいね。[l]\n\nそのときは私、\n\n容赦なんてしないよ。[l]\n\n兄様の許可なんて待てないかも、\n\n先に●っちゃうかも。":193,"だって、もう我慢できないよ？[l]\n\nずっとずっと我慢してたんだから、\n\nもういいでしょぉ？[l]\n\n●らせてくれても。[l]\n\nああ、もうっ、\n\n早く、早く●りたいなぁっ。":194,"「だめ、興奮してきちゃったかも」":195,"だめだめ、まだ早いっ。[l]\n\n鎮めなきゃ、[l]\n\nそれには、だから、[l]\n\nんっ。":196,"「帰ってきたらたっくさん、\n弄ってあげますね。まこくん」":197},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_030.ks","relPath":"/data/scenario/SC_E_030.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":198,"length":198,"percent":100},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[111,0]},"/data/scenario/SC_E_031.ks":{"data":[["@r「すきなものがなくなることは\nかなしくつらい、\nさみしい」[l]\n@r「うん」[l]\n@r「忘れないように、ボクらはその証を残そうとする」[l]\n@r「おはか？」","@r「喜欢的东西消失\n是悲伤痛苦的，\n寂寞的」[l]\n@r「嗯」[l]\n@r「为了不忘记，我们要留下证明」[l]\n@r「坟墓吗？」"],["@r「よくわかるね。[l]\nそうだな……[l]\n奥の院、奥津城、猫三昧、ハカ、\nヒトは死を隠すもの──\n遠ざけるものだけれど、\n同時に必ず直視するための機構をも配する。[l]\nなぜなら、\n眼を背けようとも逸らそうとも、\nそれは厳然として現前にあることだからね。[l]\nだけれども、\nそれは辛く悲しい、\n逃げたくもなる、\nああ、\nすきなものがなくなる場合に限るけどね。","@r「你很懂嘛。[l]\n是啊……[l]\n奥之院、奥津城、猫三昧、墓场、\n人类会将死亡隐藏起来──\n虽然会刻意疏远，\n但同时必然配备着必须直面它的机制。[l]\n因为，\n无论试图移开视线或逃避，\n它都严酷地存在于眼前啊。[l]\n不过，\n那终究是痛苦悲伤的、\n会让人想逃离的、\n啊啊、\n仅限于失去心爱之物时呢。"],["@r直接対峙する覚悟がね、肝要なんだよ。[l]\n@r受け入れること、たたかうことでわかりあえることはあるんだ。[l]\nそうでないこともあるところが厄介ではあるけどね。[l]\n武器を手に、防具を身につけても、\nその色や形を責められて、\n全く意図しない闘いを強いられてそれに負けることはあるから……[l]\nそこに例え自己の主義主張が無かったとしても、\n指摘されれば簡単に修正できるものだったとしても、\nそれを論拠に、それを気に掛けなかったコト自体を論拠に、\n相手をキラウ、こともある。[l]\nまあ、たたかいというのはそういうモノで、\n準備万端にシ合える事の方がむずか……[l]\nああ、難しかったか。[l]\nええと何の話だっけ？","@r直面它的觉悟啊，才是最重要的。[l]\n@r通过接受、战斗，有些事情是可以互相理解的。[l]\n但也有无法理解的时候，这才是麻烦之处。[l]\n即使手握武器，身穿防具，\n也会因为颜色或形状被指责，\n被迫进行完全出乎意料的战斗并输掉……[l]\n即使那其中并没有自己的主张，\n即使被指出后可以轻易修正，\n但以此为理由，以没有在意它本身为理由，\n有时候也会杀死对方。[l]\n嘛，战斗就是这样，\n要准备周全反而更困难……[l]\n啊，是很难啊。[l]\n呃，刚才在说什么来着？"],["@rああ、辛く悲しいこのセカイにおいて。[l]\nそんなセカイであっても、[l]\n@rただ、少しの間でも、安らぎを得たい。与えたい。[l]\n@rだから、この子の眠る場所を──[l]\n@rそうだね、お城を、[l]\n@rキミがなにかに直面したときに、\n思いをはせるよすがとなるものを、」[l]\n@r「なにいってるかわかんなぃ～」","@r啊啊，在这痛苦又悲伤的世界里。[l]\n即便是在这样的世界中，[l]\n@r也只想，哪怕片刻也好，获得安宁。给予安宁。[l]\n@r所以，要为这个孩子打造安眠之处──[l]\n@r对了，就用城堡吧，[l]\n@r当你面临困境时，\n能成为寄托思念的依靠之物，」[l]\n@r「完全听不懂在说啥啦～」"],["@r「んむ？[l]\nあ、ごめんね。[l]\n癖なんだよ。[l]\n@rそうだな……[l]\n今からみんなでこの子のお城をつくる。[l]\nそこにはこう、これがいいな……[l]\nこの石に、墓碑銘を刻もうね。[l]\nボヒメイって言っても解らないかな？[l]\nまあ、言い習わしはこの際無視して結構だよ。[l]\n語義が解れば──","@r「嗯唔？[l]\n啊，抱歉。[l]\n这是老毛病了。[l]\n@r这样吧……[l]\n现在开始大家一起给这孩子造城堡。[l]\n这里要这样，这个不错呢……[l]\n在这块石头上刻墓志铭吧。[l]\n说墓碑铭你可能听不懂？[l]\n嘛，这种老规矩现在无视就好。[l]\n只要明白含义──"],["@r@r@r（混乱と暫しの間）[l]\n@r@rこのEpitaphを忘れずに。[l]\n@rMeMento-Mori……わかる？」[l]\n@r「めめんとぉ…もり？」","@r@r@r（混乱与短暂的间隙）[l]\n@r@r请别忘记这段Epitaph（碑文）。[l]\n@rMeMento-Mori（铭记死亡）……明白吗？」[l]\n@r「么么托…毛里？」"],["@r「シを思え、シを忘れるな……[l]\n簡単に言うと、\n今を楽しめということ。[l]\nボクらはこの最悪の箱庭に放たれた哀れな人形だけれども、\nその悲しみや辛さをわかちあい生き抜く為の友人がいる」[l]\n@r「んー？」[l]\n@r「それがねこさ」[l]\n@r「ねこ！」[l]\n@r「このセカイを楽しくいきる手助けをしてくれるトモダチだよ」[l]\n@r「そのこもねこね」","@r「铭记死亡，勿忘死亡……[l]\n简单来说，\n就是要享受当下。[l]\n我们虽是被抛入这最糟糕箱庭的可悲人偶，\n但仍有共同分担悲伤痛苦、携手活下去的伙伴」[l]\n@r「嗯——？」[l]\n@r「那就是猫咪啦」[l]\n@r「猫咪！」[l]\n@r「是帮我们在这个世界快乐生活的好朋友哦」[l]\n@r「那孩子也是猫猫呢」"],["@r「そう。[l]\nこの子は今、\n永い眠りについてるけれど、\n目覚めたときはきっと、\nキミのトモダチになってくれる、\nだから、」[l]\n@r忘れるな、いつしか思い出すんだよ。[l]\n@rこの子のオクツキを。[l]\n@rそのEpitaph、\n@r墓碑銘を詠み上げよう──","@r「是啊。[l]\n这孩子现在，\n正陷入长眠之中，\n但当她醒来时，\n一定会成为你的朋友，\n所以，」[l]\n@r别忘了，终有一天会想起来的。[l]\n@r关于这孩子的一切。[l]\n@r那段Epitaph，\n@r让我们咏唱这墓志铭──"],["@r@r@r（混濁として明瞭にならない）[l]\n@r@r（阻害されている）[l]\n@r@r（まだ早い）[l]\n@r@r（まだ知らない方がいい）","@r@r@r（浑浊而难以明晰）[l]\n@r@r（受到阻碍）[l]\n@r@r（为时尚早）[l]\n@r@r（还是不知为妙）"],["@r@r（結果は同じでも経緯が問題だ）[l]\n@r@r（今は空転させるが無難）[l]\n@r@r（やり過ごせ）[l]\n@r@r（時機を見誤ると無為な煩悶に身を焦がすので）","@r@r（纵使结果相同过程才是关键）[l]\n@r@r（此刻空转方为上策）[l]\n@r@r（暂且回避）[l]\n@r@r（若错失时机会陷入无谓的苦恼）"],["@r@r（まだだめ。）[l]\n@r@r（ん、今はだめ……）[l]\n@r@r（なんか……なつかしいな……なんでかな……）[l]\n@r@r（ヤハリ──）","@r@r（还不行。）[l]\n@r@r（嗯，现在不行……）[l]\n@r@r（总觉得……好怀念啊……为什么呢……）[l]\n@r@r（果然──）"],["@r@r@r身、\n笑む、\nSeal\"O\"のしろ、\n十ノ飯食と産土の城。[l]\n@rこれはハカである。[l]\n@r口は飯のヒトの為に、\n@rしのめの具足、ホウキなり。","@r@r@r身，\n笑，\nSeal\"O\"之白，\n十之饭食与产土之城。[l]\n@r此为墓也。[l]\n@r口为食饭之人，\n@r蓑之具足，帚是也。"],["@r偽具。[l]\n@rM3EW\nEpitaph\n@rしをおもえ、しをわすれるな。[l]\n@rくちルより最後の壮美を。[l]\n@rきのやまうかならずかならず。[l]\n@r意、\n@r閉じるワが名はいつわ。","@r伪具。[l]\n@rM3EW\nEpitaph\n@r铭记死，勿忘死。[l]\n@r自口生至最终壮美。[l]\n@r木山必归必归。[l]\n@r意，\n@r闭锁之轮其名即伪。"],["@r@r@r「しろのしろ、とおのいーはとーぶすなのしろ」[l]\n@r@r@r「寝てるだけなんだ」","@r@r@r「白之白，远之饭乃十具素之白」[l]\n@r@r@r「只是沉睡着而已」"],["@r「そう、ボクらのトモダチは、\n死なない●こ。[l]\nこの最悪の舞台で、\nなるべく上手く立ち回れるように、\n演じきることが出来るように、\nその力を貸してくれる、\nボクらのルーツがヨんでくれた究極の美の体現、アイらしいけもの」","@r「没错，我们的朋友是，\n不死之●子。[l]\n在这最糟糕的舞台上，\n为了能尽量巧妙周旋，\n为了能完美演绎到底，\n将这份力量借予我们，\n由我们根源咏唱出的终极美之体现，名为爱的似兽之物」"],["@r「？」[l]\n@r「まあ、死なないというのは大げさだけれどね。[l]\n限りなくそれに近い、\nボクらヒトにとってみれば……[l]\nおっとごめん、\n難しい話だね」[l]\n@r「ぜんぜんわかんない」[l]\n@r「……」","@r「？」[l]\n@r「嘛，虽说不会死是夸张了点。[l]\n但已无限接近，\n对我们人类而言……[l]\n啊抱歉，\n说得太深奥了呢」[l]\n@r「完全听不懂」[l]\n@r「……」"],["@r「ワカルということは必ずしも言葉を伴わないし、\nこのセカイで意思在るモノの殆どは、\nそれとは別の形のコミュニケーション手段を持ってるんだよ。[l]\nコトバは、なるべく汎用性を持たせるべく開発されてきた手段だが、\n同時にあらゆるモノを簡易に規定して表面だけとは言え画一化を\nしてしまう諸刃の剣だ。[l]\nそれでも、捨てるには及ばないけどね。[l]\n他にも方法ある、と言うことさえアタマの片隅に置いておけば」[l]\n@r「わかんないー」","@r「理解未必需要言语相伴，\n这世上多数有意识的存在，\n都拥有其他形式的沟通手段。[l]\n语言虽是人为开发的通用手段，\n但同时也是将万物简化为表面规范\n的双刃剑。[l]\n即便如此，也不至于要舍弃。[l]\n只要记得还有其他方法存在就好」[l]\n@r「听不懂啦ー」"],["@r「あはは、まあ厭でも知る事になるさ、\nさあ、この（不明瞭）か。[l]\n目印は、何がいいかな。[l]\n@rこの石と木が良いか。[l]\n@rじゃあ、木でこう……つくって。[l]\n今碑をつくってあげよう。","@r「啊哈哈，反正迟早都会知道的啦，\n来，这个（模糊不清）吗？[l]\n标记，用什么好呢。[l]\n@r这块石头和木头不错吧。[l]\n@r那就用木头这样……做个。[l]\n现在给你立个碑吧。"],["@r（記憶混濁）[l]\n@rじゃ、一緒に君たちの手紙でも入れてみるかい？[l]\nへえ、そっちの子は……この子が」[l]\n@r「あわわわわいっちゃだめーーー！！」","@r（记忆混乱）[l]\n@r要顺便把你们写的信也放进去吗？[l]\n嘿，那边的孩子是……这孩子」[l]\n@r「哇啊啊啊不行不行————！！」"],["@r「ははは、いいじゃないか。[l]\nお似合いだよ？[l]\n折角だから今約束してしまえば、え？[l]\n勿論、（不明瞭）だよ。[l]\nキミも、\nそっちの子も、\n……そっちのキミも──[l]\n愉しい劇を演じるシカクがあるようだから──」","@r「哈哈哈，有什么关系嘛。[l]\n很相配哦？[l]\n难得的机会不如现在约定好，嗯？[l]\n当然，（模糊不清）啦。[l]\n你也是，\n那边的孩子也是，\n……那边的你也是——[l]\n看来都有出演欢乐剧目的资格呢——」"],["@r「……」[l]\n@r「……っちの子達も、ね」[l]\n@r「劇？[l]\nお遊戯のこと？[l]\n冬夏お遊戯とくいだよー、\nお母様とたっくさん練習してるから」","@r「……」[l]\n@r「……那边的孩子们也是呢」[l]\n@r「剧？[l]\n是说游戏吗？[l]\n冬夏最擅长玩游戏啦，\n和妈妈练习过好多次呢」"],["@r「うん、キミ、とてもイイよ。[l]\nそう、そして、\nウタは魔法、\nオトは素晴らしきシキ。[l]\nオトの紡ぎ手のイトはフヘンなり。[l]\nそれは言葉の外にあるもの。[l]\nキミたちには、ワカルはず」","@r「嗯，你，非常棒哦。[l]\n对，然后，\n歌是魔法，\n音是绝妙的式。[l]\n音之纺者的线永不枯竭。[l]\n那是言语之外的事物。[l]\n你们一定能，理解的」"],["@r「…ゎかります」[l]\n@r「きーちゃん？」[l]\n@r「………」[l]\n@r「──おまえ、だれ？」","@r「…我明白」[l]\n@r「小姬？」[l]\n@r「………」[l]\n@r「──你是谁？」"],["@r「そうか、キミ、もう出来るハズだよ？[l]\nカミを遺すウタもペンも、つかいかたをしってるだろ？[l]\n@r（記憶混濁）\n@rじゃあ、\nさっきの誓いと共に、\nボクのアイするもののために祈ってほしい──」","@r「这样啊，你，应该已经能做到吧？[l]\n留存神明的歌与笔的用法，都知道吧？[l]\n@r（记忆混乱）\n@r那么，\n连同刚才的誓言，\n请为我所爱之物祈祷吧——」"]],"context":[["SC_E_031.ks/index/1/text"],["SC_E_031.ks/index/3/text"],["SC_E_031.ks/index/5/text"],["SC_E_031.ks/index/7/text"],["SC_E_031.ks/index/9/text"],["SC_E_031.ks/index/11/text"],["SC_E_031.ks/index/13/text"],["SC_E_031.ks/index/15/text"],["SC_E_031.ks/index/17/text"],["SC_E_031.ks/index/19/text"],["SC_E_031.ks/index/21/text"],["SC_E_031.ks/index/23/text"],["SC_E_031.ks/index/25/text"],["SC_E_031.ks/index/27/text"],["SC_E_031.ks/index/29/text"],["SC_E_031.ks/index/31/text"],["SC_E_031.ks/index/33/text"],["SC_E_031.ks/index/35/text"],["SC_E_031.ks/index/37/text"],["SC_E_031.ks/index/39/text"],["SC_E_031.ks/index/41/text"],["SC_E_031.ks/index/43/text"],["SC_E_031.ks/index/45/text"],["SC_E_031.ks/index/47/text"]],"tags":[],"parameters":[[{"start":157,"end":268}],[{"start":274,"end":511}],[{"start":517,"end":884}],[{"start":892,"end":1093}],[{"start":1101,"end":1297}],[{"start":1305,"end":1411}],[{"start":1419,"end":1650}],[{"start":1658,"end":1838}],[{"start":1844,"end":1945}],[{"start":1951,"end":2063}],[{"start":2069,"end":2171}],[{"start":2177,"end":2295}],[{"start":2303,"end":2445}],[{"start":2453,"end":2517}],[{"start":2525,"end":2664}],[{"start":2672,"end":2816}],[{"start":2824,"end":3078}],[{"start":3086,"end":3213}],[{"start":3221,"end":3319}],[{"start":3327,"end":3473}],[{"start":3481,"end":3585}],[{"start":3593,"end":3719}],[{"start":3727,"end":3799}],[{"start":3807,"end":3935}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_031.ks","basename":"SC_E_031.ks","indexIds":{"@r「すきなものがなくなることは\nかなしくつらい、\nさみしい」[l]\n@r「うん」[l]\n@r「忘れないように、ボクらはその証を残そうとする」[l]\n@r「おはか？」":0,"@r「よくわかるね。[l]\nそうだな……[l]\n奥の院、奥津城、猫三昧、ハカ、\nヒトは死を隠すもの──\n遠ざけるものだけれど、\n同時に必ず直視するための機構をも配する。[l]\nなぜなら、\n眼を背けようとも逸らそうとも、\nそれは厳然として現前にあることだからね。[l]\nだけれども、\nそれは辛く悲しい、\n逃げたくもなる、\nああ、\nすきなものがなくなる場合に限るけどね。":1,"@r直接対峙する覚悟がね、肝要なんだよ。[l]\n@r受け入れること、たたかうことでわかりあえることはあるんだ。[l]\nそうでないこともあるところが厄介ではあるけどね。[l]\n武器を手に、防具を身につけても、\nその色や形を責められて、\n全く意図しない闘いを強いられてそれに負けることはあるから……[l]\nそこに例え自己の主義主張が無かったとしても、\n指摘されれば簡単に修正できるものだったとしても、\nそれを論拠に、それを気に掛けなかったコト自体を論拠に、\n相手をキラウ、こともある。[l]\nまあ、たたかいというのはそういうモノで、\n準備万端にシ合える事の方がむずか……[l]\nああ、難しかったか。[l]\nええと何の話だっけ？":2,"@rああ、辛く悲しいこのセカイにおいて。[l]\nそんなセカイであっても、[l]\n@rただ、少しの間でも、安らぎを得たい。与えたい。[l]\n@rだから、この子の眠る場所を──[l]\n@rそうだね、お城を、[l]\n@rキミがなにかに直面したときに、\n思いをはせるよすがとなるものを、」[l]\n@r「なにいってるかわかんなぃ～」":3,"@r「んむ？[l]\nあ、ごめんね。[l]\n癖なんだよ。[l]\n@rそうだな……[l]\n今からみんなでこの子のお城をつくる。[l]\nそこにはこう、これがいいな……[l]\nこの石に、墓碑銘を刻もうね。[l]\nボヒメイって言っても解らないかな？[l]\nまあ、言い習わしはこの際無視して結構だよ。[l]\n語義が解れば──":4,"@r@r@r（混乱と暫しの間）[l]\n@r@rこのEpitaphを忘れずに。[l]\n@rMeMento-Mori……わかる？」[l]\n@r「めめんとぉ…もり？」":5,"@r「シを思え、シを忘れるな……[l]\n簡単に言うと、\n今を楽しめということ。[l]\nボクらはこの最悪の箱庭に放たれた哀れな人形だけれども、\nその悲しみや辛さをわかちあい生き抜く為の友人がいる」[l]\n@r「んー？」[l]\n@r「それがねこさ」[l]\n@r「ねこ！」[l]\n@r「このセカイを楽しくいきる手助けをしてくれるトモダチだよ」[l]\n@r「そのこもねこね」":6,"@r「そう。[l]\nこの子は今、\n永い眠りについてるけれど、\n目覚めたときはきっと、\nキミのトモダチになってくれる、\nだから、」[l]\n@r忘れるな、いつしか思い出すんだよ。[l]\n@rこの子のオクツキを。[l]\n@rそのEpitaph、\n@r墓碑銘を詠み上げよう──":7,"@r@r@r（混濁として明瞭にならない）[l]\n@r@r（阻害されている）[l]\n@r@r（まだ早い）[l]\n@r@r（まだ知らない方がいい）":8,"@r@r（結果は同じでも経緯が問題だ）[l]\n@r@r（今は空転させるが無難）[l]\n@r@r（やり過ごせ）[l]\n@r@r（時機を見誤ると無為な煩悶に身を焦がすので）":9,"@r@r（まだだめ。）[l]\n@r@r（ん、今はだめ……）[l]\n@r@r（なんか……なつかしいな……なんでかな……）[l]\n@r@r（ヤハリ──）":10,"@r@r@r身、\n笑む、\nSeal\"O\"のしろ、\n十ノ飯食と産土の城。[l]\n@rこれはハカである。[l]\n@r口は飯のヒトの為に、\n@rしのめの具足、ホウキなり。":11,"@r偽具。[l]\n@rM3EW\nEpitaph\n@rしをおもえ、しをわすれるな。[l]\n@rくちルより最後の壮美を。[l]\n@rきのやまうかならずかならず。[l]\n@r意、\n@r閉じるワが名はいつわ。":12,"@r@r@r「しろのしろ、とおのいーはとーぶすなのしろ」[l]\n@r@r@r「寝てるだけなんだ」":13,"@r「そう、ボクらのトモダチは、\n死なない●こ。[l]\nこの最悪の舞台で、\nなるべく上手く立ち回れるように、\n演じきることが出来るように、\nその力を貸してくれる、\nボクらのルーツがヨんでくれた究極の美の体現、アイらしいけもの」":14,"@r「？」[l]\n@r「まあ、死なないというのは大げさだけれどね。[l]\n限りなくそれに近い、\nボクらヒトにとってみれば……[l]\nおっとごめん、\n難しい話だね」[l]\n@r「ぜんぜんわかんない」[l]\n@r「……」":15,"@r「ワカルということは必ずしも言葉を伴わないし、\nこのセカイで意思在るモノの殆どは、\nそれとは別の形のコミュニケーション手段を持ってるんだよ。[l]\nコトバは、なるべく汎用性を持たせるべく開発されてきた手段だが、\n同時にあらゆるモノを簡易に規定して表面だけとは言え画一化を\nしてしまう諸刃の剣だ。[l]\nそれでも、捨てるには及ばないけどね。[l]\n他にも方法ある、と言うことさえアタマの片隅に置いておけば」[l]\n@r「わかんないー」":16,"@r「あはは、まあ厭でも知る事になるさ、\nさあ、この（不明瞭）か。[l]\n目印は、何がいいかな。[l]\n@rこの石と木が良いか。[l]\n@rじゃあ、木でこう……つくって。[l]\n今碑をつくってあげよう。":17,"@r（記憶混濁）[l]\n@rじゃ、一緒に君たちの手紙でも入れてみるかい？[l]\nへえ、そっちの子は……この子が」[l]\n@r「あわわわわいっちゃだめーーー！！」":18,"@r「ははは、いいじゃないか。[l]\nお似合いだよ？[l]\n折角だから今約束してしまえば、え？[l]\n勿論、（不明瞭）だよ。[l]\nキミも、\nそっちの子も、\n……そっちのキミも──[l]\n愉しい劇を演じるシカクがあるようだから──」":19,"@r「……」[l]\n@r「……っちの子達も、ね」[l]\n@r「劇？[l]\nお遊戯のこと？[l]\n冬夏お遊戯とくいだよー、\nお母様とたっくさん練習してるから」":20,"@r「うん、キミ、とてもイイよ。[l]\nそう、そして、\nウタは魔法、\nオトは素晴らしきシキ。[l]\nオトの紡ぎ手のイトはフヘンなり。[l]\nそれは言葉の外にあるもの。[l]\nキミたちには、ワカルはず」":21,"@r「…ゎかります」[l]\n@r「きーちゃん？」[l]\n@r「………」[l]\n@r「──おまえ、だれ？」":22,"@r「そうか、キミ、もう出来るハズだよ？[l]\nカミを遺すウタもペンも、つかいかたをしってるだろ？[l]\n@r（記憶混濁）\n@rじゃあ、\nさっきの誓いと共に、\nボクのアイするもののために祈ってほしい──」":23},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_031.ks","relPath":"/data/scenario/SC_E_031.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":24,"length":24,"percent":100},"cellInfo":[]},"/data/scenario/SC_E_032.ks":{"data":[["今日は色々遊んであげようと思ったけど、\nま、\nなんかフラストレーションは消化できちゃったから。[l]\n別にいいかと思って。[l]\n例の報告に関しても明晩とかで構わないでしょ。","今天本想陪你们多玩会儿的，\n不过，\n莫名的不爽已经发泄完了。[l]\n觉得无所谓了。[l]\n那件事的报告明晚再说也行吧。"],["ドレの裔もなんか熱くなってたし、\n引っ掻き回してみるのも愉快そうではあったけど……[l]\nCovenの招集の件もあるし、[l]\n@r@r@rえ？","德雷的末裔好像也挺来劲的，\n虽然搅乱局面看起来也挺有趣……[l]\n还有女巫集会的召集令，[l]\n@r@r@r诶？"],["妬いてるかどうかはヒ・ミ・ツ、だってば。[l]\nそんなどうでも良い事を聞くなんて珍しいね。[l]\nキミも割といいひとだなー。[l]\nいあいあ昔からそうだけど。","有没有吃醋是秘・密・哦。[l]\n会问这种无关紧要的事真少见呢。[l]\n你人还挺不错的嘛—。[l]\n虽然从以前开始就这样啦。"],["常任のXⅢ/LCW electedには中々いないタイプだよね。[l]\nだから好きだよキミのことは。","在常任的XⅢ/LCW elected里是很少见的类型呢。[l]\n所以喜欢你啊。"],["彼の気持ちねえ、\n嬉しくなくはないよ。[l]\nただ、\nそういう感情はなんだろうな、\nだからって能動的に応えるのには少々、\nなんていうか、説明が長くなるんだけどさ。[l]\n兄様にも怒られたくないし。","他的心意嘛，\n倒也不是不开心。[l]\n只是，\n这种感情该怎么说呢，\n要主动回应的话总觉得有点，\n怎么说呢，解释起来会很长的。[l]\n也不想被兄长大人骂。"],["そうだ。[l]\nそれより、\nキリアケも一応彼用に準備しておいて。[l]\n四重奏団はあの娘がいるから、\n正直アテにならないでしょ、デリケェトな事象には。","是啊。[l]\n比起那个，\n基里亚克也先给他准备好吧。[l]\n四重奏团有那丫头在，\n说实话靠不住吧，对精密事项而言。"],["彼本人に対処して貰う為には、\nMEGA-D以外の装備をさせないとね。[l]\n肉としてはあの娘の子な訳だし多分すんなり行くんじゃない。","为了让他本人来处理，\n得让他装备MEGA-D以外的武装才行呢。[l]\n肉体层面毕竟是那丫头的孩子应该会很顺利吧。"],["まあ血統なんてそれこそアテにならないけど。[l]\nそこは雫、愉快な方に揺らがせてくれるだろう。","不过血统这种东西本来就不靠谱就是了。[l]\n这方面雫会让我们往有趣的方向发展吧。"],["放置しすぎ？[l]\n少しくらいレスが無いからってそんなに\n過敏に辛くなるモノなのかい？[l]\nそういうヒト、居ないとは言わないけどさあ、\n若輩とは言え彼とて子供じゃないだろ。[l]\n@rキミの言うのも判るけどさ。","放置太久了？[l]\n就因为我稍微没回消息\n就会难受得这么夸张吗？[l]\n这种人倒也不是没有啦，\n虽说资历尚浅但他也不是小孩子了。[l]\n@r你说的我也懂啦。"],["まあ、でもしょうがないよね、\n彼と私は●●でもないし、\nなにかしらの契約で縛られてる関係でもなし。[l]\n契約だなんて糞程の価値もない……って私が言う台詞じゃないね？[l]\nうひひ。","不过嘛也是没办法的事，\n我和他又不是●●关系，\n也不是被某种契约束缚的关系。[l]\n契约什么的连狗屎都不如……这话不该从我嘴里说出来吧？[l]\n嘻嘻。"],["劇が全て潤滑に終わったうえで、\n兄様に言われれば別だけどね。[l]\n@rんむ？","除非整场戏圆满结束后，\n兄长大人有令那另当别论。[l]\n@r嗯唔？"],["だから、別に嫌いって訳じゃないよ。[l]\n先刻も言ったじゃないか。[l]\n余程の能無しからでなければ、\n好かれればそれなりに嬉しいでしょ。","所以说并不是讨厌他啦。[l]\n刚才不也说了嘛。[l]\n只要不是特别无能的人，\n被喜欢的话总会有点开心的。"],["そういう意味では彼は嘱望されて組み込まれたコマでもあるし、\n遊んでるのは愉しいからね、\n好意は有り難く受け取れるけど。","从这个意义上说他是被寄予厚望才纳入的棋子，\n玩弄起来很有趣嘛，\n好意我还是会感激地收下。"],["んむー、確かに今は大分思い入れ出来ちゃったかもだけど、\n彼に対する評価基準は複数あるし、これから、\nそれのどれが上がってどれが下がるということはあるだろうけど、\n彼の存在自体に対する動かない部分に関しては確保してある訳だしさ、\n彼自身の","嗯唔——确实现在可能投入了不少感情，\n但评价他的标准有很多，今后\n哪些标准会提升哪些会下降都说不定，\n不过关于他存在本身不可动摇的部分已经确保好了，\n他自身的"],["自","自"],["我が何かしらその辺を、\n今後変に刺激はしてくるかも知れないけどさ、\nだからといって、\n私の行動理念をねじ曲げる程の影響力があるかと言われれば、[l]\n@r@r@rそれはないよね。","我的某些方面\n今后可能会被奇怪地刺激到，\n即便如此，\n要说是否有扭曲我行动理念的影响力，[l]\n@r@r@r那是不可能的吧。"],["あれ。キミまで感情移入してる？[l]\n随分彼に執心してない？[l]\nKaleidoの指導してるうちに人心付いた？[l]\nや、だからね、私もキライって訳じゃないってば。[l]\nただ、──","哎呀。连你都感情用事了？[l]\n是不是太执着于他了？[l]\n指导Kaleido的过程中产生人情味了？[l]\n都、都说了我也不讨厌他啦！[l]\n只是——"],["@r@r@r彼に好かれようと嫌われようと、[l]\n@rああそう、[l]\n@rと思うだけだよ？","@r@r@r不管被他喜欢还是讨厌，[l]\n@r啊对了，[l]\n@r我只是这么觉得而已？"],["@r@r@r私の方から引導を渡す義理も恩も、[l]\n@rあると思う？","@r@r@r从我这边给予引导的情义或恩情，[l]\n@r你觉得存在吗？"],["@r@r@rねえ？[l]\n@r@r@r多少はあるか。","@r@r@r呐？[l]\n@r@r@r多少有一点吧。"],["@r@r@rでもま、[l]\n@r私は別にどっちでもいいけど？","@r@r@r不过嘛，[l]\n@r我其实都无所谓啦？"]],"context":[["SC_E_032.ks/index/1/text"],["SC_E_032.ks/index/3/text"],["SC_E_032.ks/index/5/text"],["SC_E_032.ks/index/7/text"],["SC_E_032.ks/index/9/text"],["SC_E_032.ks/index/11/text"],["SC_E_032.ks/index/13/text"],["SC_E_032.ks/index/15/text"],["SC_E_032.ks/index/17/text"],["SC_E_032.ks/index/19/text"],["SC_E_032.ks/index/21/text"],["SC_E_032.ks/index/23/text"],["SC_E_032.ks/index/25/text"],["SC_E_032.ks/index/27/text"],["SC_E_032.ks/index/29/text"],["SC_E_032.ks/index/31/text"],["SC_E_032.ks/index/33/text"],["SC_E_032.ks/index/35/text"],["SC_E_032.ks/index/37/text"],["SC_E_032.ks/index/39/text"],["SC_E_032.ks/index/41/text"]],"tags":[],"parameters":[[{"start":135,"end":238}],[{"start":246,"end":336}],[{"start":344,"end":435}],[{"start":443,"end":496}],[{"start":504,"end":626}],[{"start":634,"end":725}],[{"start":733,"end":807}],[{"start":815,"end":866}],[{"start":874,"end":1002}],[{"start":1010,"end":1117}],[{"start":1125,"end":1174}],[{"start":1182,"end":1263}],[{"start":1271,"end":1338}],[{"start":1346,"end":1480}],[{"start":1489,"end":1490}],[{"start":1499,"end":1610}],[{"start":1618,"end":1726}],[{"start":1736,"end":1800}],[{"start":1808,"end":1854}],[{"start":1862,"end":1904}],[{"start":1912,"end":1954}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_032.ks","basename":"SC_E_032.ks","indexIds":{"今日は色々遊んであげようと思ったけど、\nま、\nなんかフラストレーションは消化できちゃったから。[l]\n別にいいかと思って。[l]\n例の報告に関しても明晩とかで構わないでしょ。":0,"ドレの裔もなんか熱くなってたし、\n引っ掻き回してみるのも愉快そうではあったけど……[l]\nCovenの招集の件もあるし、[l]\n@r@r@rえ？":1,"妬いてるかどうかはヒ・ミ・ツ、だってば。[l]\nそんなどうでも良い事を聞くなんて珍しいね。[l]\nキミも割といいひとだなー。[l]\nいあいあ昔からそうだけど。":2,"常任のXⅢ/LCW electedには中々いないタイプだよね。[l]\nだから好きだよキミのことは。":3,"彼の気持ちねえ、\n嬉しくなくはないよ。[l]\nただ、\nそういう感情はなんだろうな、\nだからって能動的に応えるのには少々、\nなんていうか、説明が長くなるんだけどさ。[l]\n兄様にも怒られたくないし。":4,"そうだ。[l]\nそれより、\nキリアケも一応彼用に準備しておいて。[l]\n四重奏団はあの娘がいるから、\n正直アテにならないでしょ、デリケェトな事象には。":5,"彼本人に対処して貰う為には、\nMEGA-D以外の装備をさせないとね。[l]\n肉としてはあの娘の子な訳だし多分すんなり行くんじゃない。":6,"まあ血統なんてそれこそアテにならないけど。[l]\nそこは雫、愉快な方に揺らがせてくれるだろう。":7,"放置しすぎ？[l]\n少しくらいレスが無いからってそんなに\n過敏に辛くなるモノなのかい？[l]\nそういうヒト、居ないとは言わないけどさあ、\n若輩とは言え彼とて子供じゃないだろ。[l]\n@rキミの言うのも判るけどさ。":8,"まあ、でもしょうがないよね、\n彼と私は●●でもないし、\nなにかしらの契約で縛られてる関係でもなし。[l]\n契約だなんて糞程の価値もない……って私が言う台詞じゃないね？[l]\nうひひ。":9,"劇が全て潤滑に終わったうえで、\n兄様に言われれば別だけどね。[l]\n@rんむ？":10,"だから、別に嫌いって訳じゃないよ。[l]\n先刻も言ったじゃないか。[l]\n余程の能無しからでなければ、\n好かれればそれなりに嬉しいでしょ。":11,"そういう意味では彼は嘱望されて組み込まれたコマでもあるし、\n遊んでるのは愉しいからね、\n好意は有り難く受け取れるけど。":12,"んむー、確かに今は大分思い入れ出来ちゃったかもだけど、\n彼に対する評価基準は複数あるし、これから、\nそれのどれが上がってどれが下がるということはあるだろうけど、\n彼の存在自体に対する動かない部分に関しては確保してある訳だしさ、\n彼自身の":13,"自":14,"我が何かしらその辺を、\n今後変に刺激はしてくるかも知れないけどさ、\nだからといって、\n私の行動理念をねじ曲げる程の影響力があるかと言われれば、[l]\n@r@r@rそれはないよね。":15,"あれ。キミまで感情移入してる？[l]\n随分彼に執心してない？[l]\nKaleidoの指導してるうちに人心付いた？[l]\nや、だからね、私もキライって訳じゃないってば。[l]\nただ、──":16,"@r@r@r彼に好かれようと嫌われようと、[l]\n@rああそう、[l]\n@rと思うだけだよ？":17,"@r@r@r私の方から引導を渡す義理も恩も、[l]\n@rあると思う？":18,"@r@r@rねえ？[l]\n@r@r@r多少はあるか。":19,"@r@r@rでもま、[l]\n@r私は別にどっちでもいいけど？":20},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_032.ks","relPath":"/data/scenario/SC_E_032.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":21,"length":21,"percent":100},"cellInfo":[]},"/data/scenario/SC_E_033.ks":{"data":[["「ぶーぶーぶー」","「哔哔哔——"],["「………」",""],["「っまんない！！！[l]\n超ひま！！ドヒマ！！ドイヒー！！」","「超——无聊！！[l]\n超级闲！！闲爆了！！闲到发霉！！」"],["「（…どこで覚えてくるんだ？[l]\nあういう言い回し）」","「（…从哪儿学来这种话？[l]\n啊这种腔调）」"],["「（店長がよくご覧になるヴァラエティーショウで\nよく使われるものに影響を受けたかと）」","「（店长常看的综艺节目里\n经常出现的用语被影响了吧）」"],["「（お嬢にも録画分送ってんのかよ？！）」","「（连录像都传给大小姐了吗？！）」"],["「（司書長に送ってる分をあの方と一緒に視聴してるかと）」","「（应该是把寄给司书长的录像带和那位一起观看了吧）」"],["「（…よくわからんが難儀だなあ。[l]\n國違ってもそういうのって視られるもんなの？[l]\n機械的にさあ）」","「（…不太明白但真是够呛啊。[l]\n就算国家不同那种东西也会被看到吗？[l]\n机械性地啦）」"],["「（お前は物を知らなすぎだな）」","「（你这家伙懂得实在太少了）」"],["「（うるさいな。[l]\n一通りなぞった位は知ってるよ。[l]\nお前みたいにリアルタイムで情報おっかける程の\n興味が無いだけ。","「（吵死了。[l]\n基本流程我还是知道的。[l]\n只是没兴趣像你那样实时追踪信息\n到那种程度而已。"],["だから今現在どうなってるかって意味で確認したんだろが。[l]\nしかも世間話的なライトなレベルでだっ）」","所以你刚才是在确认现状到底怎样对吧。[l]\n而且还是闲聊程度的轻量级话题）」"],["「（成る程な。[l]\nまあ折角こうして一堂に会したのだ、\n後でみっちりと教授してやろう。[l]\nヘヴィな領域まで）」","「（原来如此。[l]\n不过难得像这样齐聚一堂，\n待会儿就好好给你补课吧。[l]\n直到重口味领域）」"],["「（いらないっての。[l]\nMPとしてはだなぁ、\nヒトの構築したIT系の情報とか余計なもの眼に入れたくないんだよ。","「（才不要呢。[l]\n作为MP来说啊，\n人类构建的IT系信息之类的多余东西根本不想看。"],["影響される程ヤワじゃないけど気持ち悪いだろ。[l]\n色気はもっとどうこうしたいけどなああたしも）」","虽然不至于被影响那么脆弱但很恶心吧。[l]\n不过色情方面我倒想多接触点呢）」"],["「（あはははは）」","「（啊哈哈哈）」"],["「（そこ、なに静かーに大口開けて笑ってるんだ）」","「（那边，干嘛突然张大嘴安静地笑啊）」"],["「（いずれこの國の文化への親和か……[l]\n司書長の仕込みが利いてるという事だな。[l]\nお前も今少し、いや、言うまい。","「（看来是对这个国家的文化产生亲和力了……[l]\n说明司书长的特训见效了呢。[l]\n你最近也稍微...不，还是不说了。"],["今は","现在"],["唯","只"],["々、\n四重奏団（クァルテット）の一人としての自覚を望むだけ）」","希望你能牢记\n作为四重奏团（Quartet）一员的自觉）」"],["「（あたしぁやるときゃやるって。[l]\n知ってんだろ、あたしは本番以外で\n余計なエネルギー遣いたくないタイプなの。[l]\nズれた事なんかしてないからそこんとこ間違わないで。","「（我该出手时自然会出手。[l]\n你知道的吧，我是除了正式演出外\n不想浪费多余能量的类型。[l]\n又没捅什么篓子别搞错了。"],["…まあ、んな事はどうでもいいや。[l]\nそだな、うちらが仕込まれてるのは確かだわな。[l]\n幸か不幸かはわからんけど…）」","…算了，这种事怎样都行。[l]\n是啊，我们确实被特训了呢。[l]\n不知是幸运还是不幸…）」"],["「っかもヤれるかどうかは状況次第！？[l]\nせっっっっっっっかくの本番チャンス、\n模擬戦じゃない遊びが出来るかもなのにっ！","「搞不好能不能出手还要看情况！？[l]\n难得难得的正式演出机会，\n说不定能玩真的不是模拟战啊！"],["あああああああああああ、\n狩りたい狩りたい狩、り、た、いっ！[l]\nアイっ！」","啊啊啊啊啊啊啊啊啊，\n好想猎杀好想猎杀猎、杀、想、要！[l]\n爱！」"],["「聞いてますよお嬢」","「我在听呢大小姐」"],["「連絡まだーーっ？」","「联络还没来——？」"],["「まだですね」","「还没有呢」"],["「っちから聞いてみよーよ！[l]\n連絡がっ、遅いだろ！遅いよね！遅すぎる！！」","「主动去问问啊！[l]\n联络太、慢了吧！太慢了！慢过头了！！」"],["「気持ちはよく分かりますが、\nそれは禁じられてます。[l]\n向こうには箱庭維持の常駐組含めた十分な数の同胞が居ますから、\n不測の事態で連絡が滞ることはまずありません。","「您的心情我很理解，\n但那是被禁止的。[l]\n那边有包括箱庭维护常驻组在内的充足同胞，\n基本不会因意外情况导致联络延迟。"],["先程から申し上げてる通り向こうから連絡が来ない限り、\n出番はないのですよお嬢。","正如刚才所说只要对面没联系，\n就没我们出场机会啊大小姐。"],["電波状態は良好ですしメール問い合わせも１０分おきにしてます。[l]\n固定電話は言わずもがな、連絡がないのであれば何事も起きてはいません」","电波状态良好邮件也是每10分钟确认一次。[l]\n固定电话更不用说，没联络就代表平安无事」"],["「（なんか今日ちっと冷たくないか？[l]\nIronにしてはさ。[l]\n心入れ替えた？）」","「（今天是不是有点冷淡？[l]\n对Iron来说。[l]\n洗心革面了？）」"],["「（……Ironは元アレだから、[l]\n多少気が立ってるかもね。","「（……Iron原本是那个，[l]\n可能有点紧张吧。"],["改宗したとは言え、\n今回は長姉と残党ともやり合う可能性があるし。[l]\nまああの娘（こ）に関してはあれでもまだ生ぬるい）」","虽说已经改宗了，\n这次可能要同时对付长姐和残党。[l]\n不过对那孩子来说现在这样还算太温柔了）」"],["「（……ああ、そらそうさな…ってえ、[l]\n改宗弱まってるとかって話か？[l]\nそれはお前、）」","「（……啊，确实是这样呢…话说，[l]\n是说改宗变弱了之类的吗？[l]\n你这家伙，）」"],["「きゅう、きょく、てきに、ヒマ過ぎる！！[l]\nめんどーなことしてないでさぁ、\nさくさくさくっ！！[l]\nっと終わらせちゃえばいいじゃん！？","「极、极、度、无聊透顶！！[l]\n别整这些麻烦事儿了，\n唰唰唰地！！[l]\n干脆利落搞定不就好了！？"],["ボクが出れば、テトで、\nイツワの断片（フラグメント）なんてあっつーーーーーまに！！[l]\nリ・ユニオン、完了！！[l]\n司書長さまおおよろこび！！おわり！！","只要我出手，用TET，\n伊兹瓦的碎片（Fragment）什么的瞬间就能————搞定！！[l]\n再・统合，完成！！[l]\n司书长大人开心得不得了！！结束！！"],["にゃのに！！！[l]\nにゅあんでめんどくせーーーことだらだらだらだらだらだら、\nむだなきづかいはじたいをこんめいさせるだけでだれのとくにも\nならねーーーーーーのにっ！！！」","才怪呢！！！[l]\n明明净是些烦死————人的破事儿，\n无谓的顾虑只会把局面搅得一团乱\n对谁都没好处————的说！！！」"],["「（……まあ、精神構造的にバランスを欠く何かがあった[l]\nのかも知れないな。[l]\nペイルホワイトの改宗が弱体化したとは思えない。[l]\nというより、単に──）」","「（……或许精神构造上确实存在某种失衡[l]\n也说不定。[l]\n我不认为佩尔怀特的改宗会弱化。[l]\n说到底，单纯只是──）」"],["「（まあIronのコンディションが少々悪かろうと\n穴にはなるまいよ。[l]\nNKのABCも揃っているのだし）」","「（就算Iron状态稍微差了点\n也不至于拖后腿。[l]\nNK的ABC也都到齐了）」"],["「レスポンスが良好なのがいいゲームの条件だ！！！[l]\nリ・アクションしかり！！！[l]\nレスの遅いのぁ自重してもらわねあこまる！！！[l]\nあああああああああああああ」","「响应速度快才是好游戏的条件！！！[l]\n再・反应也一样！！！[l]\n反应慢的家伙给老子自重啊混蛋！！！[l]\n啊啊啊啊啊啊啊啊啊」"],["「禅、あの、お嬢に──」","「禅，那个，对大小姐──」"],["「は、牛乳で宜しいですかな」","「要、要加牛奶吗」"],["「ええ、砂糖を入れて温めお願いします」","「嗯，请加糖加热」"],["「（\"Y\"trieb仮性…だっけ？とは言え、[l]\n流石はEnder、相も変わらずお嬢はお嬢だね。[l]\nそう言えばささこは？）」","「（\"Y\"trieb假性…来着？虽说如此，[l]\n不愧是Ender，大小姐果然还是那个大小姐呢。[l]\n话说小纱子在哪？）」"],["「（ささこ…ちょっと待て、[l]\n──ああ、ESS:BoobyAce、灰野、ささこね。[l]\n…あのさ、うちらで和音使い合う意味あるか？[l]\nてかあんたも順応早すぎ、よく覚えてんな）」","「（小纱子…等一下、[l]\n──啊啊、ESS:BoobyAce、灰野、是小纱子啊。[l]\n…那个啊、咱们互相用和音有啥意义吗？[l]\n话说你也适应得太快了吧、记性真好）」"],["「（いや、サクラがズボラなだけだな）」","「（不，只是樱太懒散罢了）」"],["「（ぅっさいな。[l]\nあ？今の駄洒落かよおい。[l]\nそれよりそのささこ、どうした）」","「（吵死了。[l]\n啊？刚才那是冷笑话吗喂。[l]\n比起那个、那个小纱子、怎么了）」"],["「（あの","「（那个"],["娘も元アレだから何となくね。[l]\n…おや、ああ、寝てるな）」","孩子原本也是那边的人所以嘛。[l]\n…哎呀，啊，睡着了呢）」"],["「（ちっさいまんまの方々は呑気なもんだわねえ。[l]\nって、ヤエスウラちゃんも寝てるってか。[l]\nあいつの呑気はどうかとおもう。[l]\nメイクも落とさんとようグースカ寝られるな……）」","「（小不点们还真是心大啊。[l]\n等等，八重浦酱也睡着了？[l]\n那家伙的心大程度有问题吧。[l]\n妆都不卸就能呼呼大睡……）」"],["「（うらは基本的に静的バックアップ担当だからだろう）」","「（小里本来就是负责静态备份的）」"],["「（いや、それは関係ないなあいつの場合）」","「（不，那家伙的情况和这个无关）」"],["「（根本的に緊張感が足りない）」","「（根本上是缺乏紧张感）」"],["「（単にぐうたら）」","「（单纯是懒）」"],["「（……まあ、真実寝ていようが起きていようが、[l]\n事が起きるまではする事が無いのは確かだ。[l]\n放っておくがいいさ）」","「（……反正无论睡着还是醒着，[l]\n在事情发生前确实无事可做。[l]\n随她去吧）」"],["「（NKのABCが聞いて呆れるわ。[l]\n自覚がどうしたって話なら、\nあたしよりうらに言ってやんなよ）」","「（NK的ABC听了都要傻眼。[l]\n要说自觉性问题的话，\n你该去和小里说而不是我）」"],["「（私とて彼女と会う頻度はそれ程でもない）」","「（我和她见面的频率也没那么高）」"],["「（ライトなレベルでの世間話の中の言い回し\nだっつんだよ。[l]\nどっかの誰かみたいに真面目さが揚げ足取り\nになってるぞ）」","「（都说了是闲聊程度的客套话\n而已啦。[l]\n别像某些人那样把认真劲儿用在\n抬杠上啊）」"],["「（此奴のは実際単なる揚げ足取りだろ）」","「（这家伙根本就是在故意抬杠吧）」"],["「（その通り、\n分かって言っている。","「（正是如此，\n我明知故犯。"],["揶","揶"],["揄","揄"],["嘲","嘲"],["弄の類だな）」","讽之类吧）」"],["「（……はいはい。[l]\nどうせあたしぁ脊髄反射、フィジカル担当ですよーだ。[l]\nにしても）」","「（……是是是。[l]\n反正我就是条件反射的体力担当啦ー。[l]\n不过）」"],["「待たされるのは厭、\nまたされるのはいや、\nマタサレルのは、\nイー、ヤーーーーー！！","「等待令人厌烦，\n重复更是讨厌，\n被要求等待，\n噫呀————！！"],["待つのは良いけど待たされるのは死ぬほどイ、ヤッ！！！[l]\nいーかげんにしろよもぉおおおおおおおおおっ！！！！！！[l]\nだーーーーーーーーーーーーーーーーーーーっ、","等人可以但被放鸽子简直要命啊啊啊！！！[l]\n饭你适可而止吧噢噢噢噢噢噢噢！！！！！！[l]\n哒——————————————————、"],["連絡よこせ店長！！！[l]\n遊びたい！[l]\n狩りたい！[l]\nゲームしたい！」","快联系我啊店长！！！[l]\n想玩！[l]\n想狩猎！[l]\n想打游戏！」"],["「お静かに、向こうでは寝てる人達も──」","「请安静，对面还有人正在──」"],["「（寝てる連中は起きないだろうけど、\n実際もういい加減うるさいのは確か……[l]\n──ゲーム、\nゲームねえ。）","「（睡着的人应该不会醒，\n但确实已经吵到不行……[l]\n──游戏，\n游戏啊。）"],["なあ、ゲーム機かなんかないっけ？[l]\n店長好きそうだろそういうの」","喂，游戏机什么的有没有？[l]\n店长应该喜欢这类吧」"],["「あるにはありまするが……[l]\n私室には立ち入りを禁止されておりまして」","「有倒是有……[l]\n但禁止进入私人房间」"],["「ぁんで！？したい！！やりたい！！なんかしたい！！」","「为啥！？要玩！！想玩！！总得干点什么！！」"],["「駄目ですよお嬢」","「不行啊大小姐」"],["「あっ、あっ、\nそいえば店長から","「啊、啊、\n说起来店长"],["言","有"],["伝ありました！[l]\n禅さん、冷蔵庫の上に……」","留言！[l]\n禅先生，冰箱上面……」"],["「……Kaleido、御免なさい」","「……Kaleido，对不起」"],["「はい？[l]\nいえいえお気にせず！！[l]\nあっとそれですよ、サンクスです」","「嗯？[l]\n没事没事别在意！！[l]\n啊对就是这个，多谢啦」"],["「なになにーーー？[l]\nお、boardgameじゃん！[l]\nあなろぐだけどだがそこがよい！！」","「什么什么ーーー？[l]\n哦，是桌游嘛！[l]\n虽然是山寨货但正合我意！！」"],["「えーと、\n多人数用ですね。[l]\n起きてる方々…で行けそうですけど[l]\n──皆様？」","「呃，\n这是多人用的。[l]\n醒着的各位…应该能凑齐[l]\n──诸位？」"],["「はい、参加します」","「好，我参加」"],["「はいはい付き合います。[l]\n（Kaleidoも気苦労が絶えんね……新参者は大変だ……）」","「好啦好啦陪你玩。[l]\n（Kaleido也真不容易……新人就是辛苦……）」"],["「（あたしぁ逆に羨ましいよ、\nリアル年齢とみためが一致してる頃はこう……[l]\n初々しいっつーか、まあ、今後がきついってのはあるけどさあ）\nあ、あたしもやる、あんたもだな？」","「（我反而羡慕呢，\n实际年龄和外表相符的时候就是这样……[l]\n该说青涩吗，嘛，虽然今后会吃苦头就是了）\n啊，我也来，你也参加吧？」"],["「構わんよ。禅とシカネは？」","「无所谓啦。禅和鹿音呢？」"],["「わたしぃー？[l]\n私はいいけどさぁー、やるとなれば手加減出来ないよぅ？[l]\nお嬢そんでいいかなぁ？」","「我ー？[l]\n我倒是无所谓啦ー，但玩起来可不会手下留情哟？[l]\n大小姐这样也行吗ー？」"],["「あったりまえじゃん！[l]\nボクも全力でいくかんね！！[l]\n行く！視る！勝つ！」","「那不是当然吗！[l]\n本大爷也要全力以赴！！[l]\n上！看！赢！」"],["「私は遠慮させて戴きます。[l]\n雑務がありますので」","「请允许我谢绝。[l]\n还有杂务要处理」"],["「まー連絡も待たなきゃならないからね。[l]\nそれを怠っちゃお嬢も本末転倒だし」","「嘛——毕竟还得等联络呢。[l]\n要是疏忽这点小姐可就本末倒置啦」"],["「あの、何でしたらワタシが電話番……」","「那个、要不我来负责接电话……」"],["「いえ、私が抜けまする、\nそれこそ──手加減が出来ません」","「不，由我抽身处理，\n毕竟——我可不会手下留情」"],["「…あ、ああ、店長相手に散々ガチプレイ済みってか……」","「…啊、啊啊，已经和店长认真较量过好几次了是吧……」"],["「左様でございます。[l]\n未だ未熟者、故意に手を抜くなど器用な真似事は」","「正是如此。[l]\n在下尚不成熟，故意放水这等精巧把戏」"],["「あはぁ」","「啊哈」"],["「ささ、カレ早く来な」","「好啦好啦卡蕾快过来」"],["「はははいっ」","「好好好的」"],["「これルールはっ！？」","「这规则是啥！？」"],["「えーとルーレットを回して……の前にええと色々配…るのかな？[l]\nはぐぅ、少々お待ちを……」","「呃—先转轮盘……不对之前要分配各种…来着？[l]\n唔咕、稍等一下下……」"],["「ん、知らぬ間に寝床に」","「嗯，不知不觉就在被窝里了」"],["「お、やっばぃ、寝てたのか。[l]\n──今何時だ？」","「哇、糟了、睡着了吗。[l]\n——现在几点？」"],["「あ、起きられましたか。[l]\n皆様も。[l]\n丁度宜しい。","「啊、您醒了吗。[l]\n各位也是。[l]\n时机正好。"],["たった今連絡が御座いました。[l]\n予定が変更されたらしく、\n臨時連絡がThousandBrainsより」","刚刚收到联络。[l]\n据说计划有变，\nThousandBrains发来临时通知」"],["「！！！[l]\n出番きた？きたな？そうだな？！」","「！！！[l]\n轮到我们了？来了吧？是吧是吧？！」"],["「声でかいよお嬢」","「声音太大啦小姐」"],["「気付けには丁度良いでしょう。[l]\n禅、続けてください」","「正好清醒了吧。[l]\n禅，请继续」"],["「Kaleido…かれおは残留待機、例のＤと","「Kaleido…卡蕾欧留守待机，特别注意别让那个D"],["思しき人物を[l]\n事象に参画させないように留意すること。[l]\nなのでこれより自立単独行動を許可されます。","疑似人物[l]\n介入事件。[l]\n因此即刻起批准单独自由行动。"],["四重奏団（クァルテット）のみ、\n週明けを目処にこちらに、\nNK:AntLion…白雨カゲロウのコモンマイトサス及び、[l]\nNK:-cide…水小月シカネのスロタラスモルトは何時でも起動可能状態に。","四重奏团（Quartet）成员\n以周初为限前来汇合\nNK:AntLion…白雨蜉蝣的科蒙迈特萨斯及[l]\nNK:-cide…水小月鹿音的斯洛塔拉斯莫尔特随时可启动"],["他は待機──\nとのことです」","其余人员待命——\n以上」"],["「了解」","「收到」"],["「ははは、はいぃっ……」","「哈哈哈，好～的……」"],["「…んはは！[l]\nわたしの？[l]\nんふふふ」","「…嗯哈哈！[l]\n我的？[l]\n嗯哼哼」"],["「NKは後始末担当だろうよ。[l]\nどういうことだ？[l]\nうらの放置は兎も角、\nこいつを……」","「NK是负责善后的吧。[l]\n什么意思？[l]\n暂且不管那些杂鱼\n但这家伙……」"],["「うはぁ、シンコウ速めるんだろうねぇ。[l]\n手加減無しの速攻かな？[l]\nそれとも──","「呜哇，是要加速推进吧。[l]\n毫不留情的速攻吗？[l]\n还是说——"],["嬲りの大暴れかな？[l]\nんふふ、んふふふふ」","要玩虐杀大暴走呢？[l]\n嗯呵呵，嗯呵呵呵」"],["「お前の出番は大抵コトの後だろが。[l]\nどっちにしろ、まだ暖機運転待機って事だからな。[l]\n呼び出しされない限りこっち来るんじゃないよ。[l]\n（お嬢みたいに暴走してくれるなよ？）」","「你这家伙出场多半都在事后吧。[l]\n总之现在还处于预热待命阶段。[l]\n除非被召唤否则别过来啊。[l]\n（可别像小姐那样暴走哦？）」"],["「わかってるってぇ。[l]\nなにしろ、","「知道啦～[l]\n说到底"],["こないだの大雨の日に交差点歩いてたら歩行者青なのに\nすげぇスピードで左折で入ってくる車が連続きやがって\nしかもそういうのに限って子供同乗させてるオバサンな\n雨降ってて前も視えづらいんだか便所でクソしてえのか","前阵子下大雨时我在绿灯人行道上走着\n突然连续冲出来好几辆高速左转的车\n而且这种时候偏都是载着孩子的欧巴桑\n下雨天看不清前面是在厕所拉屎吗"],["なんにもみえてねえのかしらねえけどそいつらいったと\n思ったらすげぇ勢いで雨脚と風が鬼激しくなりやがって\nこっちきてから買ったばっかの傘が一発でトびやがった\nからさ、","虽然啥都看不见但总觉得那家伙来过\n刚这么想雨势和风就突然变得超猛烈\n来这边刚买的伞直接一击报废了\n所以说啊、"],["結構なゲージが溜まっちゃってるんだよぅ！[l]\n今回用に前から随分我慢してたからなぁ～、\nもう本起動さしたらあっという間、\nそこら中にまき散らす勢いだと思うよ。","能量槽已经攒得超满了啦！[l]\n为了这次可是从之前就憋了很久呢～\n要是现在正式启动的话转眼间、\n估计能把周围都轰得乱七八糟哦。"],["（暴走だなんて勿体ないこと、私がする訳ないでしょ？[l]\n溜めて溜めて溜めて出すのが好いんだからサぁ）」","（暴走什么的太浪费了，我才不会干呢？[l]\n人家最喜欢攒啊攒啊攒到爆再释放啦♡）"],["「わぁった、もういい、起きしなに思い出させるな。[l]\nあんたのあれぁ……[l]\n──あんまし視たいとも思わないし」","「知道啦知道啦快住口，别在起床时让我回想起来。[l]\n你那个……[l]\n──根本不想再看第二眼」"],["「そうかなぁ？[l]\nまさにストレス解消じゃないさ、\n視てる方もスカッとしないあれ？」","「是吗～？[l]\n明明超解压的、\n看着不也觉得超爽快吗？」"],["「それぁない。ないわ。[l]\n手間暇かかってようが四重奏団のエンソウの方がマシだよ。[l]\nお前のあれは……どんだけ回数視ても馴れん。[l]\n動かしてる時のお前自身も込みで」","「才怪。完全不会。[l]\n就算费工夫也比四重奏团的演奏强百倍。[l]\n你那玩意儿……看多少次都习惯不了。[l]\n连你操作时的样子都包括在内」"],["「んふふ。[l]\nまさに触手淫獣ってかんじでねぇ？","「嗯哼哼。[l]\n简直就是触手淫兽对吧？"],["O.T.Anchor同時多重ロックオンしてぇ、\n一気にぶっ放すとこなんか快感だよ？[l]\nオートはアレだけどマニュアルにすれば任意でイけるよぉ」","O.T.Anchor同时多重锁定、\n一口气发射的时候超爽的哟？[l]\n自动模式不行但手动就能随心所欲了呢♡」"],["「それがアレだっつんだよ。[l]\nなんだよショクシュインジュウって。[l]\nそんな良いものか？[l]\n要するに●こだろ、●こ」","「所以说那个很恶心啊。[l]\n什么触手淫兽的。[l]\n哪有那么美好？[l]\n说白了就是●器吧，●器」"],["「いいじゃんー、\nそもそもスロは、\n記述設計から調整まで司書長が監修してるんだよ。","「有什么关系嘛ー、\n本来这个系统、\n从代码设计到调试都是司书长监修的。"],["スペックがぁ、RulerOnlyぃ。[l]\n文句があるならあのお方にどうぞぉ」","规格可是RulerOnly哟。[l]\n有意见请找那位大人投诉啦♡」"],["「……んなことぁ分かってるよ。[l]\n文句も言うつもりも無いけどな、\n別にSROはお前の専売じゃないだろが」","「……这种事我当然知道。[l]\n虽然也没打算抱怨、\n但SRO又不是你的专利」"],["「そんな事よりもだ、\nいずれ此処で我々が想像した所でそれは想像に過ぎない。[l]\nさっさと準備をするがいい」","「比起这个、\n我们在这里想象终究只是想象。[l]\n快点做准备才是正经」"],["「当たり前のことをさも","「别把理所当然的事"],["賢しげに言ってんじゃねー。[l]\nあんたこそとっとと準備しな」","说得像多有深度似的。[l]\n你才该赶紧准备」"],["「そうだな、\nあんた等の仲が良いのはよっく分かったから、","「确实、\n你们感情好我已经充分了解了、"],["ほれ、\n両者ともとっとと準備なさいな。[l]\nとは言え、週明けと言うことは──後２日？３日？」","喂、\n两位都快点准备吧。[l]\n不过说到下周开始的话──还有2天？3天？」"],["「そうですね。[l]\n目安ですのでその近辺という事に」","「是的。[l]\n只是预估所以大概是那个时间段」"],["「んじゃあ、名指しされてない連中は精々待っててくれよ。[l]\n予定変更なんて毎度の事だしな、何時交代なるか、\n知れたもんじゃないけど。","「那没被点名的家伙就乖乖等着吧。[l]\n反正改计划是家常便饭、什么时候换班、\n谁说得准呢。"],["かれお、は──\nじゃ、彼氏と宜しくやっといて。[l]\nおほほ、役得役得ぅ」","至于卡蕾欧──\n那就和男朋友好好相处吧。[l]\n哦呵呵，真是美差美差呀♡」"],["「へあっ、かかか関係ないでスよっ」","「哎哈、跟跟跟我没关系啦」"],["「さて、","「那么、"],["姦し四重奏団（クァルテット）、\nいざ参らん……２、３日後に」","淫乱四重奏团（Quartetto）、\n这就去……两三天后」"],["「あいよ。[l]\nこんだけ揃ってのオンなんざ久々だからなぁ。[l]\n本気で万全を期すなら軽めのクエでもこなしてから、\nと行きたいとこだが」","「好嘞。[l]\n全员集合上线可是好久没干了。[l]\n要确保万无一失的话本该先做几个简单任务、\n不过现在也顾不上了」"],["「それは無粋、という事ですね」","「那就是不识趣的意思对吧」"],["「まーそういう事だな。[l]\nお嬢もあんまり期待し過ぎなさんなよ。[l]\n実際にドンパチするかはまだ不確定なんだからな。","「嘛~就是这么回事。[l]\n大小姐你也别期待过头了啊。[l]\n实际干不干架还说不准呢。」"],["アイ、お前さんもちゃんとブレーキ踏みなよ。[l]\nで、何で来いって？」","爱，你也该好好踩刹车了。[l]\n所以，说要怎么过来？」"],["「箒で来るならそれなりの対策を講じ、\nそうでなくても目立たない格好で来るように、\n必要ならばPHASE:2効果常駐とのことです」","「若乘扫帚前来就需做好相应准备，\n即便不然也请以不显眼的装扮前来，\n必要时需保持PHASE:2效果常驻」"],["「いまさらちんたら行けませんでしょ！！！[l]\n箒で！！！」","「现在哪还能慢悠悠过去啊！！！[l]\n用扫帚！！！」"],["「それはつまり要するにin full regimentalsでってこったな？」","「这意思说白了就是要全副武装对吧？」"],["「通常の交通手段が無理ならそういう事だな」","「常规交通手段行不通的话就是这么回事」"],["「そうですね、私のｖ☆で」","「是啊，用我的v☆」"],["「いや……でもどっちにしたって昼間はナシだろ」","「不……但不管怎样白天都不行吧」"],["「彼処は空港が遠い、陸路でよかろうよ。[l]\n日程も余裕がある。[l]\n無為に箒で行くことはない」","「那边机场远，走陆路就行。[l]\n日程也充裕。[l]\n没必要特意骑扫帚」"],["「待て、だから今何時だっての」","「等等，所以现在几点」"],["「約……午前５時ですが」","「大约……凌晨五点」"],["「……。[l]\n諸々条件考えると平日下りが良さそうだな？","「……。[l]\n综合各种条件平日下行班次比较合适？"],["じゃ、土日で準備して月曜朝イチで向かうか。[l]\nどうせ現地着くのは夕方だろうし、\nあの格好で行くったって夜行動のが良いんだろ」","那就周末准备，周一清早出发吧。[l]\n反正到当地也是傍晚，\n就算那副打扮去也是夜间行动比较好吧」"],["「そうなるな。[l]\n禅、チケット取っといてくれる？」","「确实如此。[l]\n禅，能帮忙订票吗？」"],["「ぶー！！！箒つかえば経費削減だのに！！！」","「呜！！！用扫帚还能节省经费呢！！！」"],["「違う意味で浪費するだろ、\nどっちにしろ週明け目処って言われてるんだから諦めな。[l]\n目処が立っただけ有り難く思いなって」","「反而会造成其他浪费，\n既然说了以周初为目标就死心吧。[l]\n能有眉目就该感恩了」"],["「うぐ。[l]\nそれもそうか」","「唔。[l]\n这么说也是」"],["「お嬢は自分で定めた期限は大人しく待てる立派なスキルの持主ですから」","「大小姐可是拥有能老实等待自定期限的优秀技能呢」"],["「あーそーですか。[l]\nご立派なことで……[l]\nじゃ、禅、あたしらが行った後は他の連中宜しく頼むわ、","「啊~这样啊。[l]\n真是了不起呢……[l]\n那禅，我们走后其他人就拜托了，"],["かれお、ま、寂しくなったら彼氏と来なよ」","卡蕾欧，寂寞了就带男朋友来呗」"],["「逆説的だな」","「真矛盾啊」"],["「あんでもよかべえ。[l]\nどうせ店長もそんくらい眼くじら立てねーだろうさ。[l]\n面白くなるならどうとだって」","「也没啥不好吧。[l]\n反正店长也不会那么较真。[l]\n只要有趣怎样都行」"],["「ワタシは……彼と一緒に居ます……」","「我会……和他在一起……」"],["「ほれ！[l]\n準備だ準備！！[l]\n準備するのだ！！！」","「喏！[l]\n准备啊准备！！[l]\n快做准备！！！」"],["我等あやまたず。[l]\nOmegaの瞳の祝福のあらんことを──","吾等必将无误。[l]\n愿Omega之瞳赐福──"]],"context":[["SC_E_033.ks/index/1/text","SC_E_033.ks/index/5/text"],["SC_E_033.ks/index/3/text","SC_E_033.ks/index/7/text"],["SC_E_033.ks/index/9/text"],["SC_E_033.ks/index/11/text"],["SC_E_033.ks/index/13/text"],["SC_E_033.ks/index/15/text"],["SC_E_033.ks/index/17/text"],["SC_E_033.ks/index/19/text"],["SC_E_033.ks/index/21/text"],["SC_E_033.ks/index/23/text"],["SC_E_033.ks/index/25/text"],["SC_E_033.ks/index/27/text"],["SC_E_033.ks/index/29/text"],["SC_E_033.ks/index/31/text"],["SC_E_033.ks/index/33/text"],["SC_E_033.ks/index/35/text"],["SC_E_033.ks/index/37/text"],["SC_E_033.ks/index/39/text"],["SC_E_033.ks/index/41/text"],["SC_E_033.ks/index/43/text"],["SC_E_033.ks/index/45/text"],["SC_E_033.ks/index/47/text"],["SC_E_033.ks/index/49/text"],["SC_E_033.ks/index/51/text"],["SC_E_033.ks/index/53/text"],["SC_E_033.ks/index/55/text"],["SC_E_033.ks/index/57/text"],["SC_E_033.ks/index/59/text"],["SC_E_033.ks/index/61/text"],["SC_E_033.ks/index/63/text"],["SC_E_033.ks/index/65/text"],["SC_E_033.ks/index/67/text"],["SC_E_033.ks/index/69/text"],["SC_E_033.ks/index/71/text"],["SC_E_033.ks/index/73/text"],["SC_E_033.ks/index/75/text"],["SC_E_033.ks/index/77/text"],["SC_E_033.ks/index/79/text"],["SC_E_033.ks/index/81/text"],["SC_E_033.ks/index/83/text"],["SC_E_033.ks/index/85/text"],["SC_E_033.ks/index/87/text"],["SC_E_033.ks/index/89/text"],["SC_E_033.ks/index/91/text"],["SC_E_033.ks/index/93/text"],["SC_E_033.ks/index/95/text"],["SC_E_033.ks/index/97/text"],["SC_E_033.ks/index/99/text"],["SC_E_033.ks/index/101/text"],["SC_E_033.ks/index/103/text"],["SC_E_033.ks/index/105/text"],["SC_E_033.ks/index/107/text"],["SC_E_033.ks/index/109/text"],["SC_E_033.ks/index/111/text"],["SC_E_033.ks/index/113/text"],["SC_E_033.ks/index/115/text"],["SC_E_033.ks/index/117/text"],["SC_E_033.ks/index/119/text"],["SC_E_033.ks/index/121/text"],["SC_E_033.ks/ind