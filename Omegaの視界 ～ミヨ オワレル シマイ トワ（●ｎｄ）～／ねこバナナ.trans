nd":16273}],[{"start":16281,"end":16352}],[{"start":16360,"end":16363}],[{"start":16395,"end":16401}],[{"start":16431,"end":16480}],[{"start":16512,"end":16553}],[{"start":16583,"end":16642}],[{"start":16668,"end":16702}],[{"start":16763,"end":16777}],[{"start":16809,"end":16835}],[{"start":16865,"end":16870}],[{"start":16896,"end":16966}],[{"start":16974,"end":16982}],[{"start":16990,"end":17024}],[{"start":17056,"end":17086}],[{"start":17112,"end":17189}],[{"start":17219,"end":17288}],[{"start":17314,"end":17401}],[{"start":17409,"end":17418}],[{"start":17426,"end":17435}],[{"start":17443,"end":17463}],[{"start":17471,"end":17486}],[{"start":17494,"end":17540}],[{"start":17570,"end":17613}],[{"start":17639,"end":17644}],[{"start":17652,"end":17720}],[{"start":17728,"end":17761}],[{"start":17771,"end":17772}],[{"start":17782,"end":17806}],[{"start":17814,"end":17876}],[{"start":17884,"end":17935}],[{"start":17967,"end":18013}],[{"start":18043,"end":18059}],[{"start":18085,"end":18169}],[{"start":18177,"end":18238}],[{"start":18256,"end":18257}],[{"start":18267,"end":18297}],[{"start":18307,"end":18308}],[{"start":18318,"end":18336}],[{"start":18366,"end":18390}],[{"start":18398,"end":18433}],[{"start":18441,"end":18480}],[{"start":18512,"end":18568}],[{"start":18598,"end":18657}],[{"start":18665,"end":18702}],[{"start":18710,"end":18780}],[{"start":18788,"end":18865}],[{"start":18891,"end":18899}],[{"start":18907,"end":18952}],[{"start":18982,"end":19068}],[{"start":19076,"end":19148}],[{"start":19156,"end":19171}],[{"start":19245,"end":19269}],[{"start":19299,"end":19328}],[{"start":19336,"end":19412}],[{"start":19438,"end":19466}],[{"start":19474,"end":19532}],[{"start":19540,"end":19551}],[{"start":19559,"end":19578}],[{"start":19586,"end":19593}],[{"start":19601,"end":19629}],[{"start":19637,"end":19663}],[{"start":19693,"end":19748}],[{"start":19834,"end":19860}],[{"start":19890,"end":19944}],[{"start":19952,"end":19984}],[{"start":20016,"end":20055}],[{"start":20081,"end":20122}],[{"start":20152,"end":20217}],[{"start":20243,"end":20256}],[{"start":20286,"end":20305}],[{"start":20337,"end":20361}],[{"start":20387,"end":20418}],[{"start":20448,"end":20460}],[{"start":20492,"end":20498}],[{"start":20528,"end":20587}],[{"start":20595,"end":20652}],[{"start":20660,"end":20683}],[{"start":20691,"end":20759}],[{"start":20785,"end":20826}],[{"start":20834,"end":20892}],[{"start":20924,"end":20930}],[{"start":20960,"end":21037}],[{"start":21045,"end":21061}],[{"start":21087,"end":21133}],[{"start":21165,"end":21186}],[{"start":21212,"end":21236}],[{"start":21244,"end":21258}],[{"start":21266,"end":21291}],[{"start":21299,"end":21312}],[{"start":21320,"end":21333}],[{"start":21363,"end":21401}],[{"start":21434,"end":21466}],[{"start":21552,"end":21590}],[{"start":21676,"end":21692}],[{"start":21700,"end":21731}],[{"start":21739,"end":21770}],[{"start":21778,"end":21821}],[{"start":21847,"end":21859}],[{"start":21867,"end":21903}],[{"start":21935,"end":21965}],[{"start":21991,"end":22004}],[{"start":22012,"end":22080}],[{"start":22112,"end":22151}],[{"start":22177,"end":22187}],[{"start":22195,"end":22207}],[{"start":22215,"end":22281}],[{"start":22289,"end":22353}],[{"start":22361,"end":22440}],[{"start":22472,"end":22484}],[{"start":22510,"end":22520}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_033.ks","basename":"SC_M_033.ks","indexIds":{"「ああ……[l]\n滅っ茶苦茶疲れた今日はぁ～あ～あ～～～…っと」":0,"部屋に戻るなり身体を伸ばし、\n全身の骨をならす。":1,"うっ、結構ばっきぼっきいってるな。":2,"主に精神的に……という印象が強かったけど、[l]\n単純に午前中に肉体労働して、\n午後も引き続いて車の運転しっぱなしに加え、":3,"海で戯れて、\nカラオケ二回分してるんだもんな。":4,"昼も晩も豪勢めの食事だったとは言え、\nそら心身疲弊もしますわなぁ。[l]\nいやだから、寧ろ疲れた身体に食物入れたら、\n血が胃に行くんだって。":5,"眠いんだって。[l]\nこっちきてからほぼ２週間、\nそろそろ疲れがどっと出る頃なのかも知れないけど。":6,"何にせよ、今日はその、\n朝から晩まで色んな意味で格別だった訳で、\n実際冬夏のノリも非常にこう、\n視てて疲れるというか、":7,"宮さんとは似てるようで違うオーラだし、\n先刻の晩飯の時はふっとトーンダウンが混じったり、\nそれこそ午前中のあれやらこれやら……[l]\nああもう、僕はなにかの特異点なのですかしら？":8,"事が起こりすぎて起こりすぎて、\nこのままじゃ僕ぁもう怒りすぎちゃうよ！！":9,"……ほれ、疲れてるでしょう。[l]\n語感的にも無理があるしようー。":10,"その疲れの所為か、\nどうも":11,"先":12,"刻から、\n何か忘れてる気がしてならないんだよなあ……":13,"ずっと引っ掛かってる事があるんだけど……":14,"「出ないものは出ないか……[l]\n致し方なし、\n今日はもう寝るすかねえ」":15,"ほんとに大事な事ならば、\n体力戻った時にでも思い出すだろう。[l]\n……僕の脳では如何にも心許ないが、[l]\n最近何気に変な活性化をみせてるしな！":16,"って、\nそもそも":17,"端から思い出せない時点でアウトなんだが。[l]\n寝ると忘れる体質でもあるしなあ……":18,"とは言え、こればっかりはどうすることも出来ぬ。":19,"「食事の前後と眠いときは、\n思考したり他人と会話してはいけないんだぜ……[l]\nふぁ～あ……」":20,"──ツかれてるときは、制御のステージが、":21,"──つまり肉が楽な方を選択するから、理性に拠った配慮の余地が、":22,"なんだっけ、それは、\nああ、大神が……言ってたような……":23,"「いかん、思考の振れ幅がすごくなってきた、\nってこう独り言が増えるのも特徴なんだよね、\nうひひひひひ」":24,"独り虚しく":25,"嗤ってみる。":26,"まあ、独り暮らしの時は、\nしなけりゃならない家事──自炊だの掃除だの洗濯だの──が\nあったから、\n多少はしゃっきりせざるを得ない瞬間が必ずあった訳だが、":27,"「……滞在してるうちは、その気になれば、[l]\nこのまま何も考えずに寝てしまえるんだよな」":28,"結構な長逗留になって、\nこう色々人任せな生活してると、\n後で日常に戻った時が心配だなあ。":29,"風呂も此処じゃ自分で沸かしたりしないし……":30,"ああ、風呂と言えば、\nあのお二方は今連れ風呂真っ最中だけれど──\nどうなってるのかねえ。":31,"変に仲良くはなってたようだけども、\n冬夏が何かしら宮さんの発言にトーンダウンさせられたり\nしてたし、\n変な問題起こしてなきゃいいけど……":32,"何と言っても、\nこの接触が果たして吉と出るか凶と出るかは、\n僕にはとんと見当も付かない。":33,"いかな懐柔策を採るにしたって、\n誤魔化し誤魔化しの事象下において、\nあんまり当事者に直截的に絡む人数増やすのは、\n得策じゃないだろうに。":34,"口裏合わせも面倒だし、\n既に宮さん自身ちょっと危うかったしな。":35,"それに──":36,"そう、脳が変に活性化というか、\n僕の過去記憶が何気に戻りつつある……っぽいのも、[l]\n気にはなるけども、\n実際仕事にはあまり関係ないだろうし、":37,"ん？":38,"きぃの件があるか……":39,"冬夏も心配してたし、\nそれにかこつけてちょっと繋ぎ取ってみるか？[l]\nでもそれでもし、":40,"何か黒い、きな臭い方向へと話が進展してしまったら──":41,"とそこまで考えて、\n僕の脳の論理的思考を司る部分は限界を迎えた。":42,"嗚呼、脳が空転しまくって、\n思考が":43,"只":44,"管拡散していく～……。":45,"「果たして今日は実のある１日だったのかどうなのか、\nもう憶えてないや……」":46,"独りごちて明かりを消そうとすると、":47,"ここここん。":48,"扉が叩かれた。":49,"え、誰よ？[l]\n宮さんかなあ。":50,"あ、そう言えば仕事の話がなんたらかんたら──":51,"否応なく僕の脳は、ある程度まで覚醒する。[l]\nまあ脳を動かすには相手が居た方がいいのは自明の理、\nひとりでするのとは全然……":52,"「（もしもぉし、寝ちゃってますかぁー？）」":53,"あれ？":54,"声の調子としては潜めてるんだろうが、\n扉越しでもしっかり聞こえるそれは、":55,"「……冬夏？[l]\nなんで？」":56,"兎に角扉を開けてみる。":57,"「あは。[l]\n起きてた。[l]\n宮さまに場所聞いたのー。":58,"だいじょぶ？[l]\n入れて入れて」":59,"明らかに風呂上がりの浴衣、といった":60,"体で、\n何というか、艶めかしいっていうの？[l]\n金髪碧眼にも馴れてきたけども、\nこう、妙なギャップで……ねえ？":61,"流石に眼帯は新しいのになってて、\n濡れ髪からはその、":62,"「………」":63,"シャンプーなのか何なのか、\n女子の場合色々つけてそうでよく判らないけども、\n所謂そういう匂いが、":64,"僕の脇をすり抜けて部屋に入ろうとするものだから\nくん、と香るのです。":65,"近い近い、近いって！":66,"「ん？」":67,"あの、そしてそこで立ち止まらないでください。":68,"「や、え？[l]\nじゃない、そのですね……[l]\n宮さんじゃあるまいし早く、って、はッ！[l]\nよもや一緒に……」":69,"さっと冬夏から離れて、\n入り口の外に身を乗り出し視回す僕。":70,"……少なくともぱっと視は居る気配無いな。":71,"「……居ないのか」":72,"と、":73,"じと眼でこちらを視る冬夏と眼が合った。":74,"「んだかなー……[l]\n……えーーーーーーと、[l]\nん。[l]\nや、負けません私」":75,"「その反応もよく判らないんですけど、\n……つーか、[l]\nなんか二人似て来てね？」":76,"それってなんかやばくね？":77,"「うひひ？ってかんじ？[l]\nんー、なーんか、\n深ぁいところで同じニオイを感じたのは\nあるかも。":78,"なんかね、\n母様とは全然違うんだけど。[l]\nどっちかっていうと道具さんと……[l]\nん？あ、何でもない。":79,"宮さま、\n最初会ったときは":80,"吃":81,"驚したけど、\n話してるうちにね、\nどんどん好きになって。":82,"お風呂でも盛り上がったよ？[l]\nいっっろんな事教えて貰ったしっ。":83,"ん。[l]\n確かに、\n今後もいいお友達でいれそう」":84,"「そらぁ良かことで……[l]\n個人的には色々と恐ろしいですだが……」":85,"先刻の想像じゃないが、\n宮さんが二人になるような状況は……":86,"うっ、胃の辺りが……":87,"「それより、早く入れてほしいんですけど？」":88,"「え？[l]\nあ、ああごめんなさい、どうぞどうぞ」":89,"……つーかさ、何で断らないの僕？":90,"そうは言ってももう入り口からは中に入ってるからさぁ……[l]\n風邪引かれても困るし……":91,"「ほー、やっぱおんなじだねー」":92,"冬夏は先刻の僕と同じ感想を漏らす。":93,"「う～んちょっと長逗留でね、\n既に若干生活臭が出てるかもだけど…」":94,"「んー、綺麗だよー。[l]\n真言さんもお風呂入ったの？」":95,"繋げて言うので一瞬戸惑ったが、\n別に体臭がどうとかいう話ではなく、\n単純に風呂にはもう入ったのか、という質問だったらしい。":96,"「うん、あとは寝ようとしてた……」":97,"「次は一緒に入ろね。[l]\nあんまりカラダに自信ないけど。":98,"少しはその……愉しませれれればって[l]\nしだがんじゃった、\nあははは、":99,"ん、ま、兎に角スタイルはしょうがないからね、\n補って余りある、何かしらのサーヴィスする」":100,"「え？[l]\nそ、それはどうなんでしょうカ……[l]\nう、うーん断るのも失礼……ですか？[l]\nこの場合」":101,"「約束ね。[l]\n私も愉しみにしてます」":102,"「ひえー………」":103,"ま、まあ、\n女子の……に限らずこういう約束て、[l]\n大体は社交辞令であるのが常だしな！[l]\n冬夏も多分忘れるであろう。":104,"大神はがっつり有言実行タイプというか、\n冗談だと思ってたのが本気だったりするので\n大変ややこしい。":105,"「取り敢えず布団敷く。[l]\n真言さんの、もちょっとそっちに寄せといて」":106,"は？":107,"何故？":108,"いあ、寄せるのじゃなく、敷くって、え？":109,"「ん、\n脱力して話ししようよってトコかな。[l]\n本音も出やすいでしょ？[l]\n暗いしぃ、普段よりプライベートな気分になれるしぃ」":110,"「ちょちょちょっと待った、」":111,"「お泊まりした夜って言えば、\nそういうのがお決まりのコースでしょぉ？」":112,"「修学旅行の夜かよ！[l]\n定番過ぎ！[l]\nその語尾の感じも何かちょっと怖いです！」":113,"……まあ、実際冬夏にしてみればそんなとこか。[l]\nいやいやいやいやいやいや、":114,"「それにあのね定番ったって普通そういうの、\n同性同士でスルモノデス！！[l]\n男女七歳にして席を同じうせずって言ってだね、\nそんな僕とアナタで」":115,"いや、僕が今更言っても説得力が無いですかそうですか、\nじゃなくて、":116,"「終わったら帰るから。[l]\nそんな警戒しなくっても、\nえへへ、取って喰ったりしないってば」":117,"「ほんとかいな……[l]\nって、\n取って喰うってその表現もちっとどうかと思う、\n色んな意味で」":118,"昨今の若人が使う感じじゃなくね？とか、[l]\nそういう意味ですよ。":119,"別に残って欲しいとか期待してる訳じゃないけども、\n例えばマジ寝しちゃったらどないすんねん。":120,"「心配ご無用です。[l]\nじゃ、電気消すねー」":121,"「はっ？！[l]\n何で！！」":122,"「ん？[l]\nだって本心ぶつけ合うにはそれなりの\nロケーションじゃないと。[l]\nそれとも何かしちゃうつもりかな？":123,"あはは、出来るなら……してもいいけどね。[l]\n真言さんてば、\n据え膳を視て視ぬ振りするひとだからなー。[l]\nそういうとこがいいんだけど」":124,"「……この短期間であなた、[l]\n相当宮さんに感化されたな？[l]\nや、それはどにがぐ、\nそそそそそれは幾ら何でも」":125,"「じゃー消しまーす」":126,"完全に無視ですね？":127,"よくよく考えれば感化されるまでもなく、\n冬夏はそういうキャラだった気もする……[l]\n出会いからして膝枕だったもんな……":128,"据え膳もまた言い回し的にこう、アレでしょうに、\n妙齢の娘さんなのによう知ってるな……[l]\nたまにそういう所あるよなあ冬夏。":129,"……書庫の町のトップの娘たる面目躍如とでも[l]\n言うべきか。":130,"ぱちん。":131,"うあ！[l]\nほんとに電気消した！！":132,"真っ暗闇ではないけれど、\n寝るには十分の暗さのつまり、\nええ？！":133,"「あーあ、":134,"何しても宮さま宮さま、ね。[l]\n結局は跡追いかぁ……[l]\nなんだかなー。悔しいなー。切ないなー」":135,"「何言ってるのかよく判らないですが、\nってもう布団入ってるし！」":136,"「んー、だから真言さんも早く寝て寝て。[l]\n私明日早いんだから」":137,"「うぇぇええーー………」":138,"……。[l]\nこうなったらもう、\n横になるしかないです……":139,"「ん。[l]\nあははっ。[l]\n何か、あは、笑っちゃうね、あははは」":140,"「照れ笑いするくらいならお止しなさいよ……[l]\nあはははは……」":141,"宮さんで多少免疫あるけれど、\nやっぱりこのシチュエーションでは、\n……笑うしかないよ、実際。":142,"なんだこの感じ。[l]\nなんだこの状況。":143,"同じ布団でないだけマシだが、\n──いや、あんまかわらん。[l]\nなにこれ？！[l]\nなにがしたいのさ？！":144,"「はふぅ～～にしても今日は疲れたねー。[l]\nお疲れさまでした。[l]\nありがとうございまーす」":145,"「……ああ、まあ、[l]\n──お疲れさまでした」":146,"「……んははっ」":147,"「……あによ」":148,"「何でもないですー。[l]\n……っぷふふ。[l]\nあはははは！[l]\n……はぁあ～～ーーーーーーー～～～～～！！！」":149,"「？？！！？？！！」":150,"突然彼女は頭を抱えて枕に突っ伏したよ？！":151,"「まずい……[l]\nやりすぎたぁ……[l]\nいただだだだだだだだだだだだだ\nひぃーーーーーん」":152,"「ど、ど、どうしたのよ」":153,"「はしゃいだ……反動が……[l]\nいま……超恥ずい……っす」":154,"「あ、ああ、それは、まあ、\nそうだろうねえ……」":155,"宮さんの域にはまだ達してないか……[l]\n半日分の反動とすればそれはかなりのもんだろうしなあ。":156,"てかまさに今の今まで、\nアナタ一体どれほどの言動……[l]\n昼会ったときも同じような後悔してたでしょうに……":157,"「やばいやばいやばいやばい、\n死にそう……恥ずくて死にそう……[l]\nだめだめだめだめだめだめだめだめ、\n私ほんとに馬鹿ほんと馬鹿何やってんのもう～～」":158,"「あははははは……[l]\nまあまあ冬夏さんよ、\n落ち着きなさいって……」":159,"枕に顔を擦り付けながら、なんかばむばむ叩きまくってますが。":160,"「手…かして……」":161,"「？」":162,"顔を伏せたまま冬夏がそろそろとこちらに手を伸ばしてきた。":163,"「…か、貸せ、とは？」":164,"「……ん……」":165,"黙って手を伸ばしたまま、\nより一層ぎゅむーと顔を枕に押しつける冬夏。":166,"「…え、こういうことかいぇ？」":167,"なんかわからないけども、\n取り敢えずその手と握手。":168,"「……うーん」":169,"これもその恥ずかし行動の一環に思えて仕方のない\n僕なんですけれど、":170,"……あれ、動かないな。":171,"「冬夏さん？」":172,"「………ふすー……」":173,"寝たんかい！！":174,"「んはは。[l]\nごめんなさい起きてます。[l]\nうっいたたたたたた、胸がぁ痛いっすぅ～、\nもう死んじゃうぅ～～」":175,"ああああ、だからそうやって恥の上塗り？してるからだろうに、[l]\nって、手は放してくれんのですかね。":176,"「まあそうやって夜呻く事は良くあることよ……[l]\n気にする事はない」":177,"「そう？」":178,"がばっとこちらを向く。":179,"「え、まあ、僕だけかも知れないけど……[l]\n過去の失敗ってのは不意に思い出されてこう、\n声に出る程恥ずかしくなる事はままあるよ。[l]\nあれはね、厳しいね……」":180,"あんまり記憶力のアレな僕でもそんな感じな訳で、\n人並みのスペックだったらそりゃあ……":181,"「兎に角、済んだことはしょうがないし、\n何事も受け止めて前に進む事が大事だよね。[l]\n……呻くくらいで済むなら、呻けばいいし」":182,"あとは時間が解決することもあるし、\n幸か不幸か、\n僕ぁ２日も寝たら大体リセットされるしなあ。":183,"「ん……[l]\nそうだよね。[l]\nあのね、まことさん、\nもう恥ずかしついでに言っちゃうけど」":184,"「はいさ、なんでしょう」":185,"「私ねぇ、\nまことさんのこと好きだよ」":186,"………。":187,"………？":188,"「はい？」":189,"「………ん～、」":190,"冬夏はずっと眼を離さない。[l]\nその、握った手も放さない。[l]\nみるみる困り顔になっていく冬夏。":191,"いや、まあ、そのですね、":192,"はい？":193,"混乱してますが、ああ、そういえば、":194,"「……んぁ。[l]\n":195,"刻…というか昼に言ってたねぇそんなことも」":196,"「違うよ」":197,"「あんなやわい意味じゃないよ」":198,"「………ん～～～～」":199,"「あなたがすき。[l]\nすきです。[l]\nまことさんがすき」":200,"……ロケーションが大事とはよく言ったもので、[l]\n暗さと、":201,"横":202,"臥体勢っていうのは、\nそういう会話も自然に思える。":203,"宮さんの添い寝とか、──冬夏の膝枕もそうだけど、\n寝てる状態というのは、\n実はかなり容易に、非日常を演出出来るものなのでは\nなかろうか。":204,"と混乱しつつ僕はどこか冷静に考えていた。[l]\n寧ろ現状を現実として認識してない、\n一種の逃避感覚なのかも、うふふ。":205,"が、それは兎も角ですね、":206,"「……なんというか、その、[l]\n大変ありがたいお言葉ではある、んだけども、\nその僕等、知り合って間もない……よね？":207,"それにその、すきにもいろいろあるし、\nやわい意味でないというのもはたしていったいどういう\nことなのやらそのね」":208,"「こういうのって感得するものだと思うのね。[l]\n言葉とか理屈とか基準がどうとかじゃない所で\nワカルものだと思ってるよ私は」":209,"感得……[l]\n最近":210,"頓に聞く言葉だけども、\nこの場合は":211,"所":212,"謂、\nびびっと来たという奴かなぁ……":213,"と、\nどうにもまるで他人事のように思考してる自分が居る。":214,"なんだろう、\nこの感じは、":215,"……まあ今まで単に経験してないシチュエーションだから、[l]\n喜怒哀楽云々よりまず混乱しているだけだと思うけど、":216,"何だろう。":217,"変に冷静な部分が頭の何処かに間違いなく存在して。":218,"心臓の鼓動は普通なら──あくまで想像だけども──\nこういうときは":219,"早":220,"鐘を打つが如く、\nドキドキしたりするんだろうが、":221,"何故か、\n脈拍は鎮静、というか、無意識的に抑えようとしてるというか、\n要するに、":222,"何だろう？":223,"「……まあ、[l]\n──そうかもねぇ……ただその人にもよるというか…、」":224,"「きらい？[l]\nだめ？私じゃあなたのになれない？[l]\n他にすきなひと居るの？[l]\nあっ、宮さま？」":225,"やっ……":226,"と言って黙る冬夏。":227,"やっぱり、と言おうとしたのかな……":228,"や、やっぱりって思われてもそれもあのその、\n宮さんとは確かにここんとこあんまり接触がないから、\n妙に気もそぞろな部分があるのかも知れず、":229,"それを敏感に察知されたのかも知れないけども、\nだからといって、":230,"……ん？[l]\nそんなに離れてた訳でもないのか、\n何か随分、\n一緒に居てないつもりだった──":231,"はっ。":232,"「いあいあいあいあ、\n彼女なんかずっと居ないし今好きって言えるような人も……[l]\nあははは……宮さんはさぁ、その……あれ？」":233,"……冬夏は再び枕に突っ伏した。":234,"──泣いてる？":235,"「わたし無茶言ってる？":236,"ほんとならね、\nここできっぱり諦める為にもさ、\n駄目ならばっさり斬り捨てて。[l]\nて言うのが格好いいよね。":237,"でも、\nそんな":238,"台":239,"詞なんて、言えないよ……":240,"私、ほんとにあなたがすきなんだよ。[l]\nわかるんだよ、あなたなんだ、って。[l]\nカラダが求めてる、アタマじゃないの。":241,"迷惑かも知れないけど……[l]\n突然過ぎてごめんとしか言えないけど……[l]\n即答貰えない時点でアウトなのかもだけど……[l]\nわたし、あなたがひつよう、なの、です、あうぅ～」":242,"話ながら僕とは反対方向を向く。[l]\nう、うーん。":243,"「な、何にしてもその、仰る通り、\n話が急すぎるし、\n僕も今混乱してるし、\n出逢ってから実際何日だっけ？":244,"お互い殆ど何も知らない訳じゃない？」":245,"と言うと、がばっとこっちに向き直る。":246,"「えぇ～結構話したよ。っていうか、[l]\nだから、\n関係ないの期間とかそういうの。":247,"貴方なの。[l]\nまことさんがすき。":248,"何でって言われても、\n言葉になんか出来ない、\n素直な私の本心」":249,"「あー、う、うーーん。[l]\nええとさ、\nじゃあ端的に言うとさ、\n──キライでは……ないよそりゃあ。":250,"だからその、\n好いてくれるコトに関してはありがとう、というか、\nうーん、えー、":251,"ただ、いきなりその、\n言われてもですな、\n心の準備と言いましょうか、":252,"ああもう、何て言ったら良いんだろな、\nここでうん、とも駄目、とも言うには判断材料が\nなさ過ぎるというか、":253,"即答はそれぁ無理だべさというか、\nね、それは冬夏から言われたんじゃなくたって、\n他のひとから言われたってきっとそうだから、\nそこは気にしないでいいよ、うん、":254,"キライとかイヤだからじゃないんだ、\nごめん、ほんとに、その、":255,"………。[l]\n………。[l]\n………あの、":256,"例えばお友達からというのはどうだろうか。[l]\n何か中間すっ飛ばしてるから驚いてるん、かなあ僕も、\nはは……」":257,"自分でも、\nこういう女子からの告白に対して、\n煮え切らないこの態度はどうかと思う、\n思うけども、":258,"嬉しくない訳じゃない、\nただ今は驚きが大きすぎて……[l]\n妙な冷静さは相変わらず思考の中に居座っているし、\nそれに──僕は、なんだ、えー、み、":259,"み？":260,"「ん。[l]\n分かってます。[l]\nごめんね。[l]\nごめん。":261,"でもね、\nすき。[l]\n………。":262,"すき、\nすき……[l]\nはふう……":263,"トモダチって、\n例えば宮さまやきぃと同列なのかな。":264,"真言さんにとって、\n他の色んな人達と一緒なのかな、\nそりゃそうか、ともだちだもんね、\n恋人じゃ、ないもんね」":265,"「うん……と、[l]\nは？」":266,"何と答えたら良いのか迷ってる内に、\n冬夏は独り語り出した。":267,"「告白なんかしないで、":268,"黙ってこのままの関係で、\nこのままの距離で、\n居続けるのも楽な選択だったんだろうなーって、\n迷ったりもしたけど、":269,"お互い、\n………、[l]\n………、[l]\n……祭が終わったらどうなってるかわかんないから。":270,"後悔したってそれこそ後の祭りだ。あはは」":271,"祭が終わったら……":272,"確かに僕は、どうなってるか──、":273,"……でも、":274,"お互いって？":275,"冬夏──？":276,"「あの──」":277,"「私ね、今すごい無理してる」":278,"今日言ったじゃない？":279,"海とか山が好きって。":280,"自分の小ささを自覚することってね、":281,"自分がセカイの中で単なる一要素でしかないんだ、って、":282,"どんなに深刻に悩んでてもセカイは、":283,"全く関係なく進んでくって事を思い知らされるのは、":284,"考えようによっては救いでもある、でしょ？":285,"でもね、やっぱり、":286,"私、今、":287,"……に側にいて欲しいんだよ。":288,"独りはイヤ。ほんとはすごく怖いよ。":289,"独りはイヤ。逃げたい。何もかもホウキして、":290,"……多分彼女はそう言った。[l]\nが、大半は枕に突っ伏していてちっとも明瞭じゃなくって、\nきっと泣いていたから、":291,"──よくわからない。":292,"「そんな理由で男にすがる女ってキライ？[l]\nでも決して道具というか、\n便利な逃げ場として視てる訳じゃない……と思う。":293,"そうとられても仕方ないけど、でも、でもね、\nアナタだから、\n真言さんだから、\n他の誰でもないまことさんだから、":294,"……ああもう死にそうだよぉ、[l]\n貴方の特別になりたい、":295,"こんなこと、ひとのおもいを強制なんて出来ないけど、[l]\nじゃあ、せめて、\n少なくともキライじゃないなら、」":296,"昼間してくれたように、":297,"一回だけぎゅってしてください。":298,"「今晩はそれで我慢するから。[l]\nそれで帰るから。":299,"迷惑かけたくないし、\nその……宮さまとのことも……[l]\n冷静に考えてみる。[l]\n勝てる相手かどうかとかさっ、あはは……」":300,"と言うと、僕の返事や今の発言に対する異論を待たず、\n布団を出て、":301,"僕の掛け布団越しに、上に被さってくる。":302,"視えるその蒼い片眼はやっぱり涙眼で、\n僕と視線を合わせないまま、\n金色の髪が僕の頬にしだれて、\nこそばゆいというか──":303,"………":304,"「……重っ」":305,"「うぞ、ほんと？！[l]\n……布団の所為よね、ん。[l]\nそうだそうだ布団のせい」":306,"「結構背高いからなぁ冬夏は……[l]\nなんて、僕がよわよわなだけだったり」":307,"「……重さは否定してくんないんだ。[l]\nいいよーだ。[l]\nこの重みがひとと重なってる実感だもんっ」":308,"一瞬だけ、強い視線で僕を直視する。[l]\nだんだんと近づき、":309,"僕の右肩の辺りに顔を埋めた。":310,"「……じゃ、[l]\nしてあげたらお戻りよ？」":311,"「……ん」":312,"何処か冷静なままなのに、\n同時に何処かでは確実に掻き乱されている、\n奇妙な感覚を覚えながら、\n僕は布団越しに冬夏を、":313,"……抱き締めた。":314,"だだだって、そうしないと、\n収拾がつかなそうだった、から……":315,"「……どうすか。[l]\nついでに尻でも触ったろうか」":316,"──つい、宮さんの責めをいなす時のような、\n『攻撃は最大の防御』的な台詞を口にしてしまった。[l]\nしもた状況が違うか、と思ったけれども、":317,"「ん、今はだめ……[l]\nありがと……[l]\nなんか……なつかしいな……なんでかな……[l]\nんふぅ……はぅ……」":318,"あああああぶなかった。[l]\nにしてもここまでしといて今更何か違うんだろか。[l]\n境界線がどこかさっぱりわからんけど、\n実際肯定されててもこまっ──":319,"ヤッパリアナタダ。":320,"ヤッパリコノコカ。":321,"……なに？[l]\nなんて言った？":322,"いや、僕も今何かを口走った──":323,"しかし、\n体勢的に互いの顔は視えてないからか、\n冬夏は何事もなかったように、":324,"「ほんとは……もっとしたいけど……[l]\nやめとくね、恥ずいから、流石に──」":325,"と言った。":326,"………だから、[l]\nこれ以上恥ずい状況てどんなだ。[l]\nえー……、げふげふ。[l]\n境界が全然分かりません。":327,"頭の中は混乱と冷静さが同居したままで、\n冬夏の息遣いだけが":328,"明":329,"瞭聞こえるなか、\n１分ほど経ったろうか、":330,"……この状態での体感時間は極めて信頼が置けないので、[l]\nもっと長かったのかも知れないし短かったのかも知れないが、":331,"兎に角あの、\nこのまま眠られても大変に困るので、\nゆっくりと冬夏の方へ顔を傾けて言う。":332,"「……さ、[l]\nお戻りなさい、自分の布団に。[l]\nじゃない、お部屋に？」":333,"「……意地悪だなぁ真言さんわぁ」":334,"僕が回していた手をゆっくり離すと、\n枯れてるにも程があるのだわ、\nと言いながら渋々彼女は起き上がって、\n……部屋には戻らず、自分の布団に入った。":335,"矢張り相当恥ずかったのだろう、\nすっぽり布団を頭から被って──\n……穴があったら入りたいのは僕の方だけど、":336,"一":337,"頻り呻いた後、\n話し始める。[l]\nだから、":338,"呻":339,"吟する位ならしなきゃいいのになあ……":340,"「昼間に海で話した、\n男の子との約束ね、":341,"………[l]\nもしね、\n子供の頃に出逢ったあの男の子、":342,"それが、\n本当に真言さんだったら、\n教えたげる。どんな約束か」":343,"「……本当にって、[l]\nどうやって確かめるんでせうか。[l]\nなにか証拠とかがあったり……？」":344,"「ん……まあ、[l]\n昼もちょっと言いかけたけど、\nほら、真言さん寝ちゃったから言いそびれてたんだよ？":345,"二人で砂の城をつくったの、\nあは、流石にそれはもう無いだろうけど。":346,"その下にね？[l]\nというか、これも先刻言ったけどお墓なのかな、\nオクツキだったかな？[l]\n城の字は入ってたはず。":347,"その時会った不思議なひとに言われて、\n……まあ、[l]\n真言さんが思い出してくれれば話は超早いんだけど、\nそうもいかなそうだから」":348,"あはは、と笑う。":349,"悪うござんしたね……[l]\nそれにそれは、その男子が確実に僕であった時の話だべさ。":350,"「実際今日、探そうかとも思ったんだけど、\n……たはは、その時はまだ告白迷ってたってゆーか、[l]\nそしたら真言さん寝ちゃうし、\n結局忘れちゃったの。":351,"目印とかもあやふやで、\n現地で思い出しながら探そうとしてたから、\nまあ、だからね、\n一緒に……みにいこうよ……今度さ……":352,"………[l]\n………」":353,"「………？[l]\nおい、寝なさんなよ？」":354,"「……あはは…起きてます。[l]\n落ちかけたけど。":355,"ん、\nそれみても思い出せなかったら真言さん、\nやっぱり違うのかもだけど。[l]\nその時は、さっきの話はヒミツのままだね、あはは」":356,"別にいいけどさそれは……落ちかけたってのはよくないが……":357,"ただ、あの時あの場所でのことが、\nここのところフラッシュバックのように顕れる情景と\n同じだとすれば、":358,"それはきぃや宮さんや、":359,"──冬夏達や飯窪家の何らかの確執？が、":360,"子供の頃から、":361,"そんな因果律なんて、\n前から仕組まれてたようで、":362,"……冬夏が、そんな僕の思考を見透かしたように言った。":363,"「運命がどうとか言うつもりはないよ……[l]\nそこまで乙女じゃないす……[l]\nただね………」":364,"「……もしもし？！[l]\n寝なさんなよ！？」":365,"「………ふひっ。[l]\nくふふ。[l]\nはぁ～あ、\nイケズなおかただなぁ真言さんて。":366,"こんなにも……すきなのに……ぐす。[l]\nやっぱり……」":367,"「……やっぱりてなんですか。[l]\nまた変な誤解をしてそうだけど……」":368,"聞こえてないのか、\n噛み合わない返事が来た──いや、そもそも独り言なのか。":369,"「……あなたと一緒なら、私、[l]\n私で居られるんだ、きっと。[l]\nだから、待つ。[l]\nん、諦めない」":370,"がばっと身体を起こす冬夏。":371,"「私の誕生日ね、\n４月２３日」":372,"「……え？[l]\nああ、そうなんだ……」":373,"あと１０日後、\n祭が予定通りならその一週間ほど前か……":374,"「返事、その時でいいよ」":375,"「……んむ」":376,"「ほんとは少しも待てないけど。[l]\nエゴだもんねそれは。[l]\n…ほんとはぜんっぜん待てないよ？私。":377,"辛いよほんとは。[l]\n待てる自信全然ないよ。[l]\nでも、……待つ。[l]\n待ってます。":378,"ただ、\n絶対、\n返事ください。":379,"それだけ約束してくれたら、\n私……待てるよ。[l]\nどっちの答えでも……いいから。[l]\n駄目な方だとしても、」":380,"もしもの時に、\n私のセカイへの未練を断ち切る後押しにはなってくれるから──":381,"すっかり鼻声になってて良く聞こえなかったけど、\n何か覚悟めいた強い意志を感じて僕は、\n戸惑うだけで。":382,"「返事……」":383,"「誕生日プレゼントだと思って、\nお話いっぱいしてくれるだけでも、いい、\nまた、会う約束を、\n待つのが楽しい未来を規定してください、":384,"そうすれば私、\n私──」":385,"幾分声の調子は戻ったと思ったのに、\nそこで冬夏は言葉が詰まって、\n顔を覆う。":386,"「……うん。[l]\n分かった……」":387,"どういう返事になるかは……正直わからないけど……":388,"僕にはすべきこともあるし……":389,"それがきみとぼくにとってどういうことになるのか……":390,"それすらもわからないが──":391,"と、再び枕に倒れ込む冬夏。":392,"「ありがと……[l]\n一方的でごめん、でもすき……だよまことさん……":393,"すぅー……[l]\n…………[l]\nすぅーー……」":394,"「んあ？[l]\nもしもし？[l]\nおいっ、寝なさんなよ？！」":395,"「え、……[l]\n──。":396,"寝、たの？[l]\n……本気で？[l]\n冬夏…？":397,"うそん、\nおい、ちょっと待て、\n……嘘だよな？":398,"ドッキリでしょ？[l]\n………。[l]\n──本気で寝ちゃった、のか？」":399,"……そ、それはどうなの。":400,"やっぱそうなるんですカ？[l]\nちょっとそれはいっくらなんでも、":401,"「冬夏？[l]\nとうかさん？[l]\n………」":402,"お、起きないっすよまじで。":403,"と、とにかくだ、\n言うだけ言って一人だけそれはどうだ！？[l]\nと、幾ら僕でも思いますよ？[l]\nそれにアナタ、":404,"「……終わったら帰るって言ったよねえ？[l]\n明日学校だったよねえ？」":405,"……マジ起きねえ！！":406,"不安的中にゃーーー！！！":407,"にしても、はうあ、どうすべえか、\n宮さんに相談……したら藪蛇？[l]\n否、しない方が、より大きな問題になる気がする！":408,"冬夏には申し訳ないけども、\nコクハクより……いやそれは言い過ぎですね、[l]\n同じくらい僕にとって深刻な問題だ。":409,"ええとええと、と、\n冬夏が起きてたときより遙かに混乱し慌てふためいて、\n取り敢えず布団から這い出て、\nそ～っと部屋を出ようとした瞬間、":410,"「！！！！！！！！！！」":411,"電話が掛かってきた。":412},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_033.ks","relPath":"/data/scenario/SC_M_033.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":404,"length":413,"percent":97.82082324455206},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[408,1]},"/data/scenario/SC_M_034.ks":{"data":[["死ぬ程焦った！！！","急到要死！！！"],["が、\n幸いにも……あれ？残念ながら？","但、\n幸运的是……咦？遗憾地说？"],["いや、兎も角、\n入り口近くまで移動してた所為か冬夏が目覚める事はなかった。[l]\n彼女もがっつり疲れてたってことか……","不、总之、\n或许是因为移动到了入口附近，冬夏并没有醒来。[l]\n看来她也累得够呛啊……"],["取り敢えず、なるべく静かに部屋を出る。","总之尽量轻手轻脚地离开房间。"],["一瞬部屋の","瞬间房间的"],["厠で話そうかとも思ったが、\n冬夏が起きてこないとも限らないし……","虽然也想过在厕所里谈，\n但冬夏说不定会醒来……"],["ま、まあ彼女の件に関してはそれ以前の問題だし、\n起きてくれるに越したことはないんだけれど、","嘛、嘛啊关于她的事本来就是更根本的问题，\n不过能醒来当然最好，"],["流石に寝てる横で声高に通話するのは","毕竟在熟睡的人旁边高声通话"],["憚られるというか、\n良心が咎めたというか、\nや、単なる甲斐性無しという説。","该说是有所顾忌，\n还是良心过不去，\n或、或者单纯就是没胆量之说。"],["ああ、色んな意味で今更、心臓がドキドキしてる……[l]\n先刻までは逆に……いやいや今はそれどころじゃない。","啊，各种意义上现在才开始心跳加速……[l]\n刚才反倒是……不不现在不是说这个的时候。"],["廊下の非常口近く、人気のなさそうな所に急ぎ移動する。[l]\n幸い電波は入っていたので、\nそのまま通話ボタンを押……す前に、[l]\n誰だ？","快步移动到走廊靠近紧急出口、看似没人的地方。[l]\n幸好有信号，\n直接按下通话按钮……之前，[l]\n是谁？"],["「これ…は、[l]\n道具さん？」","「这个…是，[l]\n道具小姐？」"],["昼間番号聞登録してたのでそうと分かったものの、\n一体何の用だろう。","虽然白天交换过号码所以知道是她，\n但到底有什么事呢。"],["ん？[l]\n確か祭の去就について連絡くれるとか……[l]\nそもそもその為に番号交換したのだ。","嗯？[l]\n记得说是要联系我关于祭的去向……[l]\n本来交换号码就是为了这个。"],["「はい、もしもし……」","「喂，您好……」"],["「ああ、寝ていたかね？[l]\n起こしてしまったのだろうか」","「啊，在睡觉吗？[l]\n是不是吵醒你了」"],["「あ、いえ、大丈夫です、\n今ちょっとばたばたしてただけで、\n寝てたわけじゃないので大丈夫です」","「啊，没，没关系，\n刚才只是有点手忙脚乱，\n不是在睡觉所以没关系」"],["「それは結構。[l]\nでは少々時間を戴くが大丈夫かな？」","「那就好。[l]\n那占用你点时间可以吗？」"],["「え、はい、だいじょう…ぶだと思います。[l]\nな、何でしょう？」","「呃，好，应该没…问题。[l]\n请、请问是什么事？」"],["状況が状況だけに、少々小声になってしまうが、\n一応聞こえてるようなので何とかなるであろう。","鉴于当前状况，声音不自觉地压低了些，\n不过对方似乎能听清，应该没问题。"],["「冬夏君の行方について何か知らないかと思ってね。[l]\nまあ、少年の立ち位置的に言いにくい事もあるだろうし、\n言える範疇で構わないよ。","「想问问你是否知道冬夏君的下落。[l]\n当然，站在少年的立场可能有些难言之隐，\n在你能说的范围内就行。"],["例えば冬夏君を我々が確保する段にしても、\n所在を少年から聞いたとは言わないので安心し給え。[l]\n言える範疇で構わないんだ。[l]\n無事かどうかであるとかね」","比如即便我们要控制冬夏君，\n也不会说是从少年这里得到的信息，请放心。[l]\n在你能说的范围内就好。[l]\n比如她是否平安之类的」"],["あれ、祭の件では無いのか。","咦，不是关于祭的事吗。"],["にしても、この道具さんの言い方は、\nまるで全部お","话说回来，这位道具小姐的说辞，\n简直就像是全都"],["視通しだと言わんばかりだなあ……[l]\nいや、完全に知ってて言ってる感じだろこれ。[l]\nそれともカマ掛けられてるのかしら？","被她看透了似的……[l]\n不，这完全就是知情者的口吻吧。[l]\n还是说在被套话？"],["「……ええ、あの後、一応会いはしました、けど、も」","「……是的，那之后我们确实见过面，不过也」"],["「ふむ。[l]\n少年から視て万事問題なさそう……だったかね？[l]\nその時もその後も、彼女は」","「嗯。[l]\n从少年看来似乎一切正常……是吗？[l]\n当时和后来，她」"],["「ええまあ、\n無事という意味ではこの上なく無事かと……","「呃那个，\n要说平安的话绝对是平安的……"],["若干その、情緒不安定と言いますか、\nちょっとだけわたわたしてた感じでしたけども、\n……はい基本的には心配ないとおもいま…す、ええ」","只是该说有点情绪不稳定，\n稍微有些慌乱的感觉，\n……嗯基本上不用担心…的，是的」"],["「成る程ね。[l]\nちなみに明日は学校なのだが……」","「原来如此。[l]\n顺便问下明天她会上学吗……」"],["「えー……と、[l]\nそれも大丈夫そうでした……少なくとも分かってはいた[l]\nようですし……え、それはもう」","「呃……那个，[l]\n看起来应该没问题……至少她是明白的[l]\n样子……啊，那个已经」"],["「ふむ、そうか。[l]\nああ、\n今し方言ったがね、\n少年に累が及ぶ様な情報の使い方はしないから安心し給え。","「嗯，这样啊。[l]\n啊，\n刚才也说过，\n不会使用可能牵连到少年的信息处理方式，请放心。"],["僕は時と場合、相手は限定されるが腹芸も通じるのでね」","我嘛，看时间和场合，虽然对象有限但也能玩点腹语术呢」"],["「はい？」","「啊？」"],["「ふふ、まあいいよ。[l]\nロジカルに攻撃するもしないも相手次第という事さ。[l]\n思考経路やルールとて所詮はヒトの考えたもの故に、\n固執するもしないもケースバイケースという奴なのだよ」","「呵呵，算了无所谓。[l]\n要不要逻辑性进攻全看对方情况。[l]\n思考路径和规则说到底都是人想出来的东西，\n要不要执着还得具体问题具体分析啊」"],["説明になってない気がするんだけど、\n相変わらずチノ嬢並に話が脱線してる？[l]\nいや、本線かも知れないんだが、\nなにぶん転換やら展開が唐突でね御二方とも……","感觉完全没解释清楚，\n还是和千乃小姐一样话题跑偏了？[l]\n不，说不定这才是主线，\n但两位的转折展开实在太突兀了……"],["「何しろ或る人物曰く、\n最悪の箱庭たるセカイに於いては、\nその場に留まりたければ走り続けなければ\nならないのだからね。","「毕竟某位人物说过，\n在最糟糕的箱庭世界里，\n想要停留在原地就必须不断奔跑\n才行呢。"],["至極単純にまとめれば、\nスキかキライか、それこそが──","简单概括的话，\n喜欢或讨厌，这才是──"],["で、少年にとって幸いなことに、\n僕はキミがお気に入りという訳だ。[l]\nん？前にも話していたかな？」","所以幸运的是少年，\n我挺中意你的。[l]\n嗯？之前说过吗？」"],["「…僕の記憶力もあれなんで申し訳ないですが、[l]\nソースが道具さんだったかは別として、\n最近やたらよく聞くっていうか、\nまあ、何かしら僕の耳には入ってくる話題ですよね……","「…我记忆力也不太行抱歉，[l]\n虽然消息来源是不是道具小姐另当别论，\n最近总听到有人说这个，\n反正总会传到我耳朵里……"],["……流行ってるんですか？」","……是流行趋势吗？」"],["「流行り──そうだな、\nどちらかというとワカル者達にとっての共通認識の\n様なモノ、思考の嗜好とでもいおうか。[l]\n勿論少年もそういう者たる資質ありと視ているが？」","「流行──这么说吧，\n更像是懂行之人之间的共识\n或者说思维偏好。[l]\n当然我认为少年也具备这种资质？」"],["「はあ…あははは、[l]\nそれで、あの結局のところですね、\nその一体全体このお電話は」","「哈…啊哈哈哈，[l]\n所以到头来，\n这通电话到底要干嘛」"],["話題が意味不明だったのもあって、\n道具さんには悪いがスルー気味の反応をしつつ、\n電話の真意を問うた。","因为话题太莫名其妙，\n虽然对道具小姐不好意思但还是敷衍着，\n直接询问电话的真实意图。"],["「ああ、そうだったそうだった。[l]\nふふふ、すまなかったね。[l]\n何だ、今日はもうお疲れのようだなあ。","「啊对，差点忘了。[l]\n呵呵，抱歉啦。[l]\n看来你今天已经很累了。"],["そうだね、……結論のみを言えば、[l]\n冬夏君の去就についての事ではあったのだが、\n初めから凡その察しは付いていたし、\nこれは確認作業のようなものだったのだからね。","好吧……直接说结论的话，[l]\n是关于冬夏去向的事，\n不过你从一开始就猜得八九不离十，\n这次只是确认流程而已。"],["そう言う意味では無駄に気苦労を掛けてしまったか。[l]\nそこは申し訳なかったが」","这么说来倒是让你白操心了呢。[l]\n这点要道歉」"],["やっぱりカマ掛けだったんかーい。[l]\nなんだかのう、と思う間こそあれ、\n再び間髪入れずに話題が急『転』回した。","果然是在下套啊喂。[l]\n刚觉得不对劲，\n话题又猝不及防地急『转』弯了。"],["「時に少年は読書が好きだね？」","「对了少年喜欢读书吧？」"],["「へ？[l]\nあ、はあ、言いましたっけ？」","「诶？[l]\n啊、嗯、我说过吗？」"],["「ははは、\nさあどうだったかね。","「哈哈哈，\n谁知道呢。"],["まあいずれ少年ならばワカルと思うよ。[l]\n小説などでよくあるだろう、これから独り言を話す、という奴だ。[l]\nそれを今から実際にしてみせるという趣向だね」","反正迟早会明白的。[l]\n小说里常见吧，那种要开始自言自语的桥段。[l]\n现在就给你现场表演这个」"],["「はあ、独り言。[l]\nえ、独り言？」","「哈啊，自言自语。[l]\n呃，自言自语？」"],["つまり何らかの大っぴらに出来ない話を一方的に\n話されるという事だろうか。","意思是要单方面讲些\n不能公开说的话？"],["まあ、それこそ今し方、\n僕に対して或る意味そう言う発言を誘導していたのだろうが、\n","不过刚才确实，\n某种意义上也是在诱导我说类似的话，\n"],["先","不"],["刻からどうにも回りくどいというか、\n……ああ、だから腹芸がどうこうっていう事なのね。","但总觉得拐弯抹角……\n……啊，所以才是腹语术那套啊。"],["つまりこっちからの質問は受け付けてくれないし、\n公式ソースとしては使ってはいけないという暗黙の了解の許で\nもたらされる非公式の情報をこれから語る、という訳のようだ。","就是说不会回答我的提问，\n在不能作为官方消息源的默契前提下\n要透露些非正式情报对吧。」"],["認識が合ってればだけど。[l]\n多分そういう事かなあ。[l]\n一体何をお話になるのでしょうか……","只要认知一致的话。[l]\n大概就是这么回事吧。[l]\n究竟要说什么呢……"],["「冬夏君においては成る","「关于冬夏君的事"],["可く速やかに、\n","最好尽快地\n"],["御","御"],["母","让"],["堂の","母亲"],["許に帰ってあげ給えと。[l]\n姫様君や克杖君が実力行使に及ぶ前に、\n事が穏便に済ませられるように。","回到佛堂那边吧。[l]\n在姫様君和克杖君动用武力之前\n让事情能和平解决。"],["何しろどうしたって、学年学級は違えども学校で会うことにはなるのだ。[l]\n今我々──三春の眷属達は祭の件で色々と神経質になっているが、\n故に今ならまだ事を荒立てずに済ませられる。","毕竟无论如何，就算年级班级不同也总会在学校碰面。[l]\n现在我们三春眷属因为祭典的事变得很敏感\n所以现在还能避免把事情闹大。"],["その前に、\n僕個人は、\n西石君の見舞いにも付き添ってあげても良いと思ってもいる。[l]\n今の西石君には友人の暖かい労りが有意だろう」","在此之前\n我个人\n也觉得可以陪西石君去探病。[l]\n现在的西石君需要朋友温暖的关怀吧」"],["「え、それなら僕も……」","「诶，那我也……」"],["「んー、少年、僕は独り言を言っているのだ、\n具体的に返答することは出来ない。[l]\n後は前に言ったことを思い出してくれ給え」","「嗯——少年，我是在自言自语\n没法具体回应你。[l]\n剩下的就回想我之前说过的话吧」"],["ああやっぱりそういう反応されるのね。[l]\nでもきぃに関しては純粋な心配なんだけど……","啊果然会是这种反应呢。[l]\n但关于小贵是真心担心的……"],["うっ、そう言えば、あんまり来て欲しくないとか言ってたか。[l]\n冬夏は良いのに？[l]\n……何かしら女子的な都合なのかな。","唔，说起来她好像说过不太希望我来着？[l]\n冬夏就可以吗？[l]\n……是有什么女生方面的原因吧。"],["それよりも、\n実力行使って何のことだ。","比起这个\n动用武力是什么意思啊。"],["まあ確かにあの二人はお目付役、\nみたいな事は言ってたけども、\n何か穏やかでない言い方だなあ……[l]\n昼間のあの時も、確かそういうの担当だとかその為の二人だとか──","虽然那两人确实说过\n要当监视者之类的话\n但这说法总觉得不太平和呢……[l]\n白天那时候也说什么这是她们的职责之类的——"],["「さて、独り言はこの位にして、だ。[l]\nときにそろそろ寒くなってはいないかね？[l]\n察するに其処は、\n屋内ではあっても部屋の中ではなさそうだが？」","「好了，自言自语就到此为止。[l]\n话说是不是开始变冷了？[l]\n我猜你现在\n虽然是在室内但不在房间里吧？」"],["「はい？[l]\nえ、あ、そうですね、まあ言われれば……」","「啊？[l]\n呃，嗯，被你这么一说……」"],["そういうのって、\n言われると途端にそういう気がしてくるんだよな。","这种事情啊\n被人提醒后就会突然觉得确实如此。"],["話は一方的にまとめられつつあったが、\nそもそも向こうからの電話だし。","虽然对话完全被对方主导着\n但本来就是对方打来的电话。"],["それは別に構わない訳で、\n実際そろそろ肌寒い気もしてきてた僕にとっては\n異論を唱える理由も無い。","这倒也没什么\n实际上我也确实开始觉得有点冷\n所以没有反对的理由。"],["「僕の独り言をどう使うかは少年の自由だが、\n冬夏君自身の為にも、そこはよく検討して欲しい。[l]\n家に連絡しづらそうなら僕に連絡をするように\n","「怎么利用我的自言自语是少年的自由\n但为了冬夏君着想，希望你能好好考虑。[l]\n如果不方便联系家里就联系我\n"],["言","有"],["付けるもよい」","也可以」"],["「はあ、\nでも僕と道具さんの繋がりやらをどう説明したらいいものか……」","「哈啊\n但我和道具小姐的关系该怎么解释才好……」"],["「ん？[l]\n何だ、説明して無かったのか。[l]\nふむ、真実をそのまま説明しづらい様であれば、\n西石君の仲介とでも言えば良いんじゃないかね。","「嗯？[l]\n怎么，你没解释过吗。[l]\n唔，如果直接说明实情有困难\n就说西石君是中间人不就好了。"],["それなら問題は無いだろう。[l]\n僕等の関係事情その他は冬夏君も知る所だし、\n見舞いに呼ぶ口実にもなる。","这样就没问题了吧。[l]\n我们的关系内情冬夏君也都知道\n也可以作为探病的借口。"],["ま、\n基本的には好きにして構わないと思うが」","嘛\n基本上随你高兴就好」"],["「あ、はあ成る程……[l]\nわかりました……」","「啊，原来如此……[l]\n明白了……」"],["「じゃあまた何かあれば連絡させて貰う。[l]\n祭の件もあるしね。[l]\nそれでは失礼するよ。[l]\nお休み」","「那有事再联系。[l]\n毕竟还有祭典的事。[l]\n先告辞了。[l]\n晚安」"],["「はい、おつかれさまです──」","「好的，辛苦了──」"],["電話を切った。","挂断了电话。"],["さて、","话说，"],["冬夏は確かにずっと此処に泊まってる訳にはいかない\nだろうし、\n何にしろ説得はしないといけないか……","冬夏确实不能一直住在这里\n吧，\n总之得想办法说服她才行……"],["あんな話の後じゃ、ちと言いづらい話題ではあるけれど、\n道具さんは兎も角、きぃに任せるならば何とかなるかも\n知れないし、","在那番谈话之后，这话题实在有点难以启齿，\n道具小姐姑且不论，如果交给小贵处理或许还有转机\n也说不定，"],["……きぃへの色々は、","……关于小贵的种种，"],["少なくとも僕が此処に来る前からあの二人は付き合いある訳だし、\n仮に、\n…仮に不審に思う所があるにしても、","至少在我来这儿之前那两人就有交情了，\n即便，\n…即便存在可疑之处，"],["それは多分、\n僕との関係性に於いてのみなのであって、\n僕という要素が介入しなければ、\nあの二人の間には何ら問題は、無いと思う。","那大概，\n也只限于与我的关系范畴，\n只要不介入我这个因素，\n那两人之间应该没有任何问题。"],["と、思う……","我是这么想的……"],["「あかん、限界やがな！」","「不行了，到极限咧！」"],["何故か西國訛りで弱音を吐いてみました。","不知为何用关西腔嘟囔起丧气话。"],["電話で眼が冴えるかと思ったら、\nもうそんな域を超えていたらしい。[l]\n脳空転がもうかなり進行してまふあああああー。","本以为通完电话会清醒些，\n看来早已超出那个阶段了。[l]\n脑浆空转已经相当严重了啊啊啊啊啊ー。"],["取り敢えず今夜はどうすべえ、\n部屋に戻っても、その、冬夏が寝とる訳だし……[l]\n冬夏に例の件を伝えるにしても明日以降だろうが、\nまずはそれ以前の話で──","总之今晚怎么办，\n回房间的话，那个、冬夏已经睡了吧……[l]\n就算要告诉冬夏那件事也得等明天以后，\n但首先在此之前──"],["……うーん、仕方ない。","……唔，没办法。"],["ここは覚悟を決めて、\n宮さんに相談しよう……","只能下定决心，\n去找宫小姐商量了……"],["はっ、日付も変わってるよ。[l]\n今日……否、もう昨日か、[l]\nどんだけ色々あったんだ。","啊，日期都变了。[l]\n今天……不对，已经是昨天了，[l]\n到底发生了多少事啊。"],["うーん、時間が時間だけに、\n電話してからの方が良いのかなあ。[l]\nそれとも直で行くべきなのかしらん。","唔，这个时间点，\n是不是先打电话比较好呢。[l]\n还是该直接上门呢。"],["「いいやもう、考える気力もない……」","「算了，已经没力气思考了……」"],["僕は宮さんの部屋へと、\n疲弊しきった身体を引きずりながら向かうことにした。","我拖着精疲力尽的身体，\n朝宫小姐房间走去。"],["……起きてると良いけど…………","……希望她还醒着…………"]],"context":[["SC_M_034.ks/index/1/text"],["SC_M_034.ks/index/3/text"],["SC_M_034.ks/index/5/text"],["SC_M_034.ks/index/7/text"],["SC_M_034.ks/index/9/text"],["SC_M_034.ks/index/11/text"],["SC_M_034.ks/index/13/text"],["SC_M_034.ks/index/15/text"],["SC_M_034.ks/index/17/text"],["SC_M_034.ks/index/19/text"],["SC_M_034.ks/index/21/text"],["SC_M_034.ks/index/23/text"],["SC_M_034.ks/index/25/text"],["SC_M_034.ks/index/27/text"],["SC_M_034.ks/index/29/text"],["SC_M_034.ks/index/31/text"],["SC_M_034.ks/index/33/text"],["SC_M_034.ks/index/35/text"],["SC_M_034.ks/index/37/text"],["SC_M_034.ks/index/39/text"],["SC_M_034.ks/index/41/text"],["SC_M_034.ks/index/43/text"],["SC_M_034.ks/index/45/text"],["SC_M_034.ks/index/47/text"],["SC_M_034.ks/index/49/text"],["SC_M_034.ks/index/51/text"],["SC_M_034.ks/index/53/text"],["SC_M_034.ks/index/55/text"],["SC_M_034.ks/index/57/text"],["SC_M_034.ks/index/59/text"],["SC_M_034.ks/index/61/text"],["SC_M_034.ks/index/63/text"],["SC_M_034.ks/index/65/text"],["SC_M_034.ks/index/67/text"],["SC_M_034.ks/index/69/text"],["SC_M_034.ks/index/71/text"],["SC_M_034.ks/index/73/text"],["SC_M_034.ks/index/75/text"],["SC_M_034.ks/index/77/text"],["SC_M_034.ks/index/79/text"],["SC_M_034.ks/index/81/text"],["SC_M_034.ks/index/83/text"],["SC_M_034.ks/index/85/text"],["SC_M_034.ks/index/87/text"],["SC_M_034.ks/index/89/text"],["SC_M_034.ks/index/91/text"],["SC_M_034.ks/index/93/text"],["SC_M_034.ks/index/95/text"],["SC_M_034.ks/index/97/text"],["SC_M_034.ks/index/99/text"],["SC_M_034.ks/index/101/text"],["SC_M_034.ks/index/103/text"],["SC_M_034.ks/index/105/text"],["SC_M_034.ks/index/107/text"],["SC_M_034.ks/index/109/text"],["SC_M_034.ks/index/112/text"],["SC_M_034.ks/index/114/text"],["SC_M_034.ks/index/116/text"],["SC_M_034.ks/index/118/text"],["SC_M_034.ks/index/120/text"],["SC_M_034.ks/index/122/text"],["SC_M_034.ks/index/125/text"],["SC_M_034.ks/index/127/text"],["SC_M_034.ks/index/129/text"],["SC_M_034.ks/index/131/text"],["SC_M_034.ks/index/133/text"],["SC_M_034.ks/index/135/text"],["SC_M_034.ks/index/137/text"],["SC_M_034.ks/index/139/text"],["SC_M_034.ks/index/141/text"],["SC_M_034.ks/index/143/text"],["SC_M_034.ks/index/145/text"],["SC_M_034.ks/index/147/text"],["SC_M_034.ks/index/149/text"],["SC_M_034.ks/index/151/text"],["SC_M_034.ks/index/153/text"],["SC_M_034.ks/index/155/text"],["SC_M_034.ks/index/157/text"],["SC_M_034.ks/index/159/text"],["SC_M_034.ks/index/162/text"],["SC_M_034.ks/index/164/text"],["SC_M_034.ks/index/166/text"],["SC_M_034.ks/index/168/text"],["SC_M_034.ks/index/170/text"],["SC_M_034.ks/index/172/text"],["SC_M_034.ks/index/174/text"],["SC_M_034.ks/index/176/text"],["SC_M_034.ks/index/178/text"],["SC_M_034.ks/index/180/text"],["SC_M_034.ks/index/182/text"],["SC_M_034.ks/index/184/text"],["SC_M_034.ks/index/186/text"],["SC_M_034.ks/index/188/text"],["SC_M_034.ks/index/190/text"],["SC_M_034.ks/index/192/text"],["SC_M_034.ks/index/194/text"],["SC_M_034.ks/index/196/text"],["SC_M_034.ks/index/198/text"],["SC_M_034.ks/index/200/text"],["SC_M_034.ks/index/202/text"],["SC_M_034.ks/index/204/text"],["SC_M_034.ks/index/206/text"],["SC_M_034.ks/index/208/text"],["SC_M_034.ks/index/210/text"],["SC_M_034.ks/index/212/text"],["SC_M_034.ks/index/214/text"],["SC_M_034.ks/index/216/text"]],"tags":[],"parameters":[[{"start":117,"end":126}],[{"start":134,"end":156}],[{"start":164,"end":231}],[{"start":239,"end":258}],[{"start":297,"end":302}],[{"start":313,"end":349}],[{"start":357,"end":406}],[{"start":414,"end":431}],[{"start":442,"end":487}],[{"start":495,"end":552}],[{"start":560,"end":640}],[{"start":700,"end":720}],[{"start":746,"end":783}],[{"start":791,"end":845}],[{"start":901,"end":912}],[{"start":944,"end":977}],[{"start":1009,"end":1064}],[{"start":1096,"end":1128}],[{"start":1160,"end":1197}],[{"start":1223,"end":1272}],[{"start":1304,"end":1379}],[{"start":1387,"end":1478}],[{"start":1504,"end":1517}],[{"start":1525,"end":1553}],[{"start":1562,"end":1632}],[{"start":1664,"end":1689}],[{"start":1721,"end":1776}],[{"start":1808,"end":1839}],[{"start":1847,"end":1920}],[{"start":1952,"end":1982}],[{"start":2014,"end":2077}],[{"start":2109,"end":2174}],[{"start":2182,"end":2208}],[{"start":2240,"end":2245}],[{"start":2277,"end":2382}],[{"start":2408,"end":2498}],[{"start":2530,"end":2601}],[{"start":2609,"end":2640}],[{"start":2648,"end":2706}],[{"start":2738,"end":2836}],[{"start":2842,"end":2855}],[{"start":2887,"end":2981}],[{"start":3013,"end":3064}],[{"start":3090,"end":3148}],[{"start":3180,"end":3241}],[{"start":3249,"end":3343}],[{"start":3351,"end":3395}],[{"start":3421,"end":3485}],[{"start":3517,"end":3532}],[{"start":3564,"end":3589}],[{"start":3621,"end":3641}],[{"start":3649,"end":3735}],[{"start":3767,"end":3790}],[{"start":3816,"end":3856}],[{"start":3864,"end":3909}],[{"start":3923,"end":3924}],[{"start":3933,"end":3979}],[{"start":3987,"end":4077}],[{"start":4085,"end":4141}],[{"start":4173,"end":4184}],[{"start":4193,"end":4201}],[{"start":4214,"end":4215}],[{"start":4224,"end":4225}],[{"start":4235,"end":4237}],[{"start":4247,"end":4304}],[{"start":4312,"end":4409}],[{"start":4417,"end":4495}],[{"start":4527,"end":4539}],[{"start":4571,"end":4641}],[{"start":4667,"end":4714}],[{"start":4722,"end":4791}],[{"start":4799,"end":4822}],[{"start":4830,"end":4924}],[{"start":4956,"end":5043}],[{"start":5075,"end":5107}],[{"start":5133,"end":5169}],[{"start":5177,"end":5215}],[{"start":5223,"end":5279}],[{"start":5311,"end":5390}],[{"start":5404,"end":5405}],[{"start":5414,"end":5421}],[{"start":5453,"end":5492}],[{"start":5524,"end":5606}],[{"start":5614,"end":5674}],[{"start":5682,"end":5708}],[{"start":5740,"end":5767}],[{"start":5799,"end":5865}],[{"start":5897,"end":5912}],[{"start":5938,"end":5945}],[{"start":6007,"end":6010}],[{"start":6018,"end":6075}],[{"start":6083,"end":6150}],[{"start":6158,"end":6168}],[{"start":6176,"end":6236}],[{"start":6244,"end":6319}],[{"start":6327,"end":6333}],[{"start":6365,"end":6377}],[{"start":6403,"end":6422}],[{"start":6430,"end":6496}],[{"start":6504,"end":6593}],[{"start":6601,"end":6612}],[{"start":6620,"end":6646}],[{"start":6654,"end":6707}],[{"start":6715,"end":6774}],[{"start":6806,"end":6824}],[{"start":6850,"end":6891}],[{"start":6899,"end":6914}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_034.ks","basename":"SC_M_034.ks","indexIds":{"死ぬ程焦った！！！":0,"が、\n幸いにも……あれ？残念ながら？":1,"いや、兎も角、\n入り口近くまで移動してた所為か冬夏が目覚める事はなかった。[l]\n彼女もがっつり疲れてたってことか……":2,"取り敢えず、なるべく静かに部屋を出る。":3,"一瞬部屋の":4,"厠で話そうかとも思ったが、\n冬夏が起きてこないとも限らないし……":5,"ま、まあ彼女の件に関してはそれ以前の問題だし、\n起きてくれるに越したことはないんだけれど、":6,"流石に寝てる横で声高に通話するのは":7,"憚られるというか、\n良心が咎めたというか、\nや、単なる甲斐性無しという説。":8,"ああ、色んな意味で今更、心臓がドキドキしてる……[l]\n先刻までは逆に……いやいや今はそれどころじゃない。":9,"廊下の非常口近く、人気のなさそうな所に急ぎ移動する。[l]\n幸い電波は入っていたので、\nそのまま通話ボタンを押……す前に、[l]\n誰だ？":10,"「これ…は、[l]\n道具さん？」":11,"昼間番号聞登録してたのでそうと分かったものの、\n一体何の用だろう。":12,"ん？[l]\n確か祭の去就について連絡くれるとか……[l]\nそもそもその為に番号交換したのだ。":13,"「はい、もしもし……」":14,"「ああ、寝ていたかね？[l]\n起こしてしまったのだろうか」":15,"「あ、いえ、大丈夫です、\n今ちょっとばたばたしてただけで、\n寝てたわけじゃないので大丈夫です」":16,"「それは結構。[l]\nでは少々時間を戴くが大丈夫かな？」":17,"「え、はい、だいじょう…ぶだと思います。[l]\nな、何でしょう？」":18,"状況が状況だけに、少々小声になってしまうが、\n一応聞こえてるようなので何とかなるであろう。":19,"「冬夏君の行方について何か知らないかと思ってね。[l]\nまあ、少年の立ち位置的に言いにくい事もあるだろうし、\n言える範疇で構わないよ。":20,"例えば冬夏君を我々が確保する段にしても、\n所在を少年から聞いたとは言わないので安心し給え。[l]\n言える範疇で構わないんだ。[l]\n無事かどうかであるとかね」":21,"あれ、祭の件では無いのか。":22,"にしても、この道具さんの言い方は、\nまるで全部お":23,"視通しだと言わんばかりだなあ……[l]\nいや、完全に知ってて言ってる感じだろこれ。[l]\nそれともカマ掛けられてるのかしら？":24,"「……ええ、あの後、一応会いはしました、けど、も」":25,"「ふむ。[l]\n少年から視て万事問題なさそう……だったかね？[l]\nその時もその後も、彼女は」":26,"「ええまあ、\n無事という意味ではこの上なく無事かと……":27,"若干その、情緒不安定と言いますか、\nちょっとだけわたわたしてた感じでしたけども、\n……はい基本的には心配ないとおもいま…す、ええ」":28,"「成る程ね。[l]\nちなみに明日は学校なのだが……」":29,"「えー……と、[l]\nそれも大丈夫そうでした……少なくとも分かってはいた[l]\nようですし……え、それはもう」":30,"「ふむ、そうか。[l]\nああ、\n今し方言ったがね、\n少年に累が及ぶ様な情報の使い方はしないから安心し給え。":31,"僕は時と場合、相手は限定されるが腹芸も通じるのでね」":32,"「はい？」":33,"「ふふ、まあいいよ。[l]\nロジカルに攻撃するもしないも相手次第という事さ。[l]\n思考経路やルールとて所詮はヒトの考えたもの故に、\n固執するもしないもケースバイケースという奴なのだよ」":34,"説明になってない気がするんだけど、\n相変わらずチノ嬢並に話が脱線してる？[l]\nいや、本線かも知れないんだが、\nなにぶん転換やら展開が唐突でね御二方とも……":35,"「何しろ或る人物曰く、\n最悪の箱庭たるセカイに於いては、\nその場に留まりたければ走り続けなければ\nならないのだからね。":36,"至極単純にまとめれば、\nスキかキライか、それこそが──":37,"で、少年にとって幸いなことに、\n僕はキミがお気に入りという訳だ。[l]\nん？前にも話していたかな？」":38,"「…僕の記憶力もあれなんで申し訳ないですが、[l]\nソースが道具さんだったかは別として、\n最近やたらよく聞くっていうか、\nまあ、何かしら僕の耳には入ってくる話題ですよね……":39,"……流行ってるんですか？」":40,"「流行り──そうだな、\nどちらかというとワカル者達にとっての共通認識の\n様なモノ、思考の嗜好とでもいおうか。[l]\n勿論少年もそういう者たる資質ありと視ているが？」":41,"「はあ…あははは、[l]\nそれで、あの結局のところですね、\nその一体全体このお電話は」":42,"話題が意味不明だったのもあって、\n道具さんには悪いがスルー気味の反応をしつつ、\n電話の真意を問うた。":43,"「ああ、そうだったそうだった。[l]\nふふふ、すまなかったね。[l]\n何だ、今日はもうお疲れのようだなあ。":44,"そうだね、……結論のみを言えば、[l]\n冬夏君の去就についての事ではあったのだが、\n初めから凡その察しは付いていたし、\nこれは確認作業のようなものだったのだからね。":45,"そう言う意味では無駄に気苦労を掛けてしまったか。[l]\nそこは申し訳なかったが」":46,"やっぱりカマ掛けだったんかーい。[l]\nなんだかのう、と思う間こそあれ、\n再び間髪入れずに話題が急『転』回した。":47,"「時に少年は読書が好きだね？」":48,"「へ？[l]\nあ、はあ、言いましたっけ？」":49,"「ははは、\nさあどうだったかね。":50,"まあいずれ少年ならばワカルと思うよ。[l]\n小説などでよくあるだろう、これから独り言を話す、という奴だ。[l]\nそれを今から実際にしてみせるという趣向だね」":51,"「はあ、独り言。[l]\nえ、独り言？」":52,"つまり何らかの大っぴらに出来ない話を一方的に\n話されるという事だろうか。":53,"まあ、それこそ今し方、\n僕に対して或る意味そう言う発言を誘導していたのだろうが、\n":54,"先":55,"刻からどうにも回りくどいというか、\n……ああ、だから腹芸がどうこうっていう事なのね。":56,"つまりこっちからの質問は受け付けてくれないし、\n公式ソースとしては使ってはいけないという暗黙の了解の許で\nもたらされる非公式の情報をこれから語る、という訳のようだ。":57,"認識が合ってればだけど。[l]\n多分そういう事かなあ。[l]\n一体何をお話になるのでしょうか……":58,"「冬夏君においては成る":59,"可く速やかに、\n":60,"御":61,"母":62,"堂の":63,"許に帰ってあげ給えと。[l]\n姫様君や克杖君が実力行使に及ぶ前に、\n事が穏便に済ませられるように。":64,"何しろどうしたって、学年学級は違えども学校で会うことにはなるのだ。[l]\n今我々──三春の眷属達は祭の件で色々と神経質になっているが、\n故に今ならまだ事を荒立てずに済ませられる。":65,"その前に、\n僕個人は、\n西石君の見舞いにも付き添ってあげても良いと思ってもいる。[l]\n今の西石君には友人の暖かい労りが有意だろう」":66,"「え、それなら僕も……」":67,"「んー、少年、僕は独り言を言っているのだ、\n具体的に返答することは出来ない。[l]\n後は前に言ったことを思い出してくれ給え」":68,"ああやっぱりそういう反応されるのね。[l]\nでもきぃに関しては純粋な心配なんだけど……":69,"うっ、そう言えば、あんまり来て欲しくないとか言ってたか。[l]\n冬夏は良いのに？[l]\n……何かしら女子的な都合なのかな。":70,"それよりも、\n実力行使って何のことだ。":71,"まあ確かにあの二人はお目付役、\nみたいな事は言ってたけども、\n何か穏やかでない言い方だなあ……[l]\n昼間のあの時も、確かそういうの担当だとかその為の二人だとか──":72,"「さて、独り言はこの位にして、だ。[l]\nときにそろそろ寒くなってはいないかね？[l]\n察するに其処は、\n屋内ではあっても部屋の中ではなさそうだが？」":73,"「はい？[l]\nえ、あ、そうですね、まあ言われれば……」":74,"そういうのって、\n言われると途端にそういう気がしてくるんだよな。":75,"話は一方的にまとめられつつあったが、\nそもそも向こうからの電話だし。":76,"それは別に構わない訳で、\n実際そろそろ肌寒い気もしてきてた僕にとっては\n異論を唱える理由も無い。":77,"「僕の独り言をどう使うかは少年の自由だが、\n冬夏君自身の為にも、そこはよく検討して欲しい。[l]\n家に連絡しづらそうなら僕に連絡をするように\n":78,"言":79,"付けるもよい」":80,"「はあ、\nでも僕と道具さんの繋がりやらをどう説明したらいいものか……」":81,"「ん？[l]\n何だ、説明して無かったのか。[l]\nふむ、真実をそのまま説明しづらい様であれば、\n西石君の仲介とでも言えば良いんじゃないかね。":82,"それなら問題は無いだろう。[l]\n僕等の関係事情その他は冬夏君も知る所だし、\n見舞いに呼ぶ口実にもなる。":83,"ま、\n基本的には好きにして構わないと思うが」":84,"「あ、はあ成る程……[l]\nわかりました……」":85,"「じゃあまた何かあれば連絡させて貰う。[l]\n祭の件もあるしね。[l]\nそれでは失礼するよ。[l]\nお休み」":86,"「はい、おつかれさまです──」":87,"電話を切った。":88,"さて、":89,"冬夏は確かにずっと此処に泊まってる訳にはいかない\nだろうし、\n何にしろ説得はしないといけないか……":90,"あんな話の後じゃ、ちと言いづらい話題ではあるけれど、\n道具さんは兎も角、きぃに任せるならば何とかなるかも\n知れないし、":91,"……きぃへの色々は、":92,"少なくとも僕が此処に来る前からあの二人は付き合いある訳だし、\n仮に、\n…仮に不審に思う所があるにしても、":93,"それは多分、\n僕との関係性に於いてのみなのであって、\n僕という要素が介入しなければ、\nあの二人の間には何ら問題は、無いと思う。":94,"と、思う……":95,"「あかん、限界やがな！」":96,"何故か西國訛りで弱音を吐いてみました。":97,"電話で眼が冴えるかと思ったら、\nもうそんな域を超えていたらしい。[l]\n脳空転がもうかなり進行してまふあああああー。":98,"取り敢えず今夜はどうすべえ、\n部屋に戻っても、その、冬夏が寝とる訳だし……[l]\n冬夏に例の件を伝えるにしても明日以降だろうが、\nまずはそれ以前の話で──":99,"……うーん、仕方ない。":100,"ここは覚悟を決めて、\n宮さんに相談しよう……":101,"はっ、日付も変わってるよ。[l]\n今日……否、もう昨日か、[l]\nどんだけ色々あったんだ。":102,"うーん、時間が時間だけに、\n電話してからの方が良いのかなあ。[l]\nそれとも直で行くべきなのかしらん。":103,"「いいやもう、考える気力もない……」":104,"僕は宮さんの部屋へと、\n疲弊しきった身体を引きずりながら向かうことにした。":105,"……起きてると良いけど…………":106},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_034.ks","relPath":"/data/scenario/SC_M_034.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":107,"length":107,"percent":100},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[64,1]},"/data/scenario/SC_M_035.ks":{"data":[["「んーーー、ぅむーーーー？[l]\nあいや、まこくん。[l]\nどしたの？」","「嗯ーーー，唔嗯ーーーー？[l]\n哎呀，是真啊。[l]\n怎么了？」"],["「えーーーーーーーーっとですね、\n夜分遅く済みません……[l]\nあの、今お時間大丈夫ですか？[l]\nというか寝てました……？」","「呃ーーーーーーーー那个，\n深夜打扰实在抱歉……[l]\n请问现在方便吗？[l]\n或者说您已经睡了……？」"],["「んむーーーー、\nん、\nまあ大丈夫ですー。[l]\nなに？」","「唔嗯ーーーー，\n嗯，\n没关系啦ー。[l]\n什么事？」"],["「えっと、\nあの、ですね」","「那个，\n就是，呃」"],["「うん」","「嗯」"],["「……なんか怒ってますか？」","「……您是不是在生气？」"],["「んむ？[l]\n別に？[l]\n何で？」","「唔嗯？[l]\n没有啊？[l]\n为什么这么问？」"],["「いや、何かリアクションがその、」","「因为您的反应有点那个，」"],["「え？[l]\nうひひ、\n別にいつも通りですけど？","「咦？[l]\n嘻嘻，\n和平常没什么两样吧？」"],["……まさかそれを確認しに来た？[l]\n怒ってるかどうかを？」","……难道你是来确认这个的？[l]\n我有没有生气？」"],["「いえいえいえいえいえ真逆そんな事で\nわざわざ……","「没有没有没有没有完全不是为这种事\n特意跑来的……"],["リアクション薄いと感じたのはたった今、\nリアルタイムでの感想ですから……[l]\nそうではなくてですね」","觉得你反应冷淡是刚刚、\n实时产生的感想而已……[l]\n不是这样的啦」"],["「んむ」","「嗯唔」"],["「あの、部屋入っても？」","「那个，能进房间吗？」"],["「んーーー、今はちょっとだめ」","「嗯——现在不太行」"],["「あ、そうですか、\nえーとじゃあ単刀直入に言いますが、」","「啊，这样啊、\n呃那我就直说了，」"],["「あ、５分……いあ、１０分待ってくれればおけー。[l]\nだいじょぶ？」","「啊，5分钟……不对、等10分钟的话可以。[l]\n没问题吧？」"],["「あ、そうですか、\n待ちます、じゃそこで待ってますんで」","「啊，这样啊、\n我等，那就在这儿等着了」"],["「うん、ごめんね」","「嗯，抱歉啦」"],["「いえいえ」","「没事没事」"],["１５分経過","15分钟过去"],["「まこくーんいいよぉ～、って、あれ？」","「真酱～可以了哟～，咦、啊咧？」"],["「………」",""],["「まぁこくぅ～ん、\n寝ちった？」","「真～酱～、\n睡着了吗？」"],["「…ふがっ。[l]\nおあ、おあようごあいあう……」","「…呼啊。[l]\n噢、噢早嗷嗷上……」"],["「お待たせしましたぁ～。[l]\nお部屋どうぞ～」","「让您久等啦～。[l]\n请进房间吧～」"],["「はっ、ああ、はい、どうもです……」","「哈、啊、好的，多谢……」"],["「どうぞー」","「请进——」"],["「お邪魔します……」","「打扰了……」"],["「さてさて。[l]\n何の御用でしょう」","「好啦好啦。[l]\n有何贵干呢」"],["「あの","「那个"],["実はですね、\n冬夏が」","其实呢、\n冬夏她」"],["「んむ、あー、\nまこくんのお部屋教えてあげたから？[l]\n行ったんだほんとに？","「嗯唔，啊——、\n因为我告诉真酱房间位置了？[l]\n真的去了吗？"],["うひひ、\n冬夏さんてばだいたぁん☆」","嘻嘻、\n冬夏酱真是的～笨蛋☆」"],["「…ええとまあそれで、[l]\n部屋で寝ちゃったんですよね、僕の。[l]\nどうしたものかと……」","「…呃那个所以、[l]\n在我房间睡着了，这个。[l]\n该怎么办才好呢……」"],["「んむ？[l]\n一緒に寝ればいいですよそれで問題なし」","「嗯唔？[l]\n一起睡不就好了这样就没问题」"],["「あ゛っ。[l]\nどっちとですよ」","「啊゛。[l]\n和谁啊喂」"],["「どっち？[l]\nああ、こっちも選択肢に入ってるんだ。","「和谁？[l]\n啊，原来我也是选项之一啊。"],["んむ、\nそれは勿論冬夏さんとですよ。[l]\n部屋に戻って何食わぬ顔をして寝るですね」","嗯唔、\n那当然是和冬夏酱啦。[l]\n回房间装作若无其事地睡觉就行」"],["「……ええと何が勿論かは分かりませんが、[l]\nそれはどう考えても無しですというかその色々とありまして」","「……虽然不明白哪里是当然、[l]\n那个怎么想都不行或者说各种原因所以」"],["「んむー、でもこっちもなー」","「嗯唔——，但我这边也——」"],["「……はぁ、なんか……[l]\n珍しいですねそういう、反応というか……[l]\nいつもだったら女子のにおいがするとか、\nいらん追求が」","「……哈啊，总觉得……[l]\n真罕见呢这种，反应或者说……[l]\n平时的话会说有女生味道啊、\n进行无谓追问之类的」"],["「へ？」","「诶？」"],["「いや、なんでもないです。[l]\nそれで、プレーンで結構です、結構なんですけどもね」","「不，没什么。[l]\n那个，普通版就行，普通版就可以啦」"],["「んむーん？[l]\nま、いいです。","「嗯唔——？[l]\n嘛，算了。"],["じゃー今夜は知狡に言って別の部屋に寝ますか。[l]\n冬夏さん起こすのもあれですし。[l]\nあ、それとも宮と入れ替わります？」","那ー今晚就告诉知狡去别的房间睡吧。[l]\n把冬夏小姐吵醒也不太好。[l]\n啊、要不然和宫换房间？」"],["「はい？[l]\nなんスかそれは」","「哈？[l]\n这啥意思啊」"],["「宮が冬夏さんと一緒にまこくんの部屋で寝て、\nまこくんが宮の部屋で寝る。[l]\nという事です。","「就是宫和冬夏小姐一起在小真房间睡，\n小真去宫的房间睡。[l]\n这么回事。"],["まこくんの懸念も解決出来るし、\n宮も冬夏さんを驚かせられるし、\n知狡の手も煩わせずに済むし、\n無難な落とし所ですよね？","既能解决小真的顾虑，\n宫又能给冬夏小姐惊喜，\n还不用麻烦知狡，\n这不是很稳妥的折中方案吗？"],["そうしましょう。[l]\nじゃ、今からまこくんの布団敷くので待っててください」","就这么定了。[l]\n那我现在去给小真铺被褥请稍等」"],["「は、え？[l]\nああ、まあそちらがそれで宜しければ……」","「啊、诶？[l]\n啊啊、既然你们觉得这样合适的话……」"],["「……部屋のもの弄っちゃ駄目ですよ。[l]\n密かにやっても分かりますからね」","「……不许乱动房间里的东西哦。[l]\n偷偷搞小动作我也会发现的」"],["「しませんよ、\nそっちこそ僕の部屋弄んないでくださいよ」","「才不会啦，\n你们那边才别乱动我房间的东西」"],["「りょうかーい♪\nあ、今日？明日？[l]\nえっと、日付変わって今日ですか。","「了ー解♪\n啊、今天？明天？[l]\n呃、过了零点算今天吧。"],["取り敢えず休みの日って事で、\nまこくんはゆっくり養生してて構いませんよ。[l]\n後々の事もありますし」","总之算是休息日，\n小真可以好好休养没关系哦。[l]\n毕竟还有后续事宜要处理」"],["「はあ、\nわかりました……[l]\nまあ何かしら瑣事があったらこなしますけど……」","「哈啊，\n明白了……[l]\n不过要是有什么琐事我还是会处理的……」"],["「あっ。[l]\n例の、お仕事関係で聞きたかった話も、\n後で改めて。[l]\nこっちから招集かけますからしばしお待ちを」","「啊。[l]\n之前说的、工作相关想请教的事，\n也等之后再说吧。[l]\n我会主动召集大家的请稍候」"],["「……ほんとに、ちゃんと喚んでくれますか？」","「……真的、会好好叫上我吗？」"],["「んむ？[l]\n勿論ですよ。[l]\n","「嗯唔？[l]\n当然啦。[l]\n"],["何","在"],["時とは明言出来ませんけど……[l]\n──いきなりどしたの？」","虽然具体时间说不好……[l]\n──突然怎么了这是？」"],["「いえ……その、[l]\n……絶対ですよ。ぜったいですよ。[l]\n僕だってこれが──\nし、ごと、なんですから。","「没……那个，[l]\n……要绝对遵守约定哦。绝对哦。[l]\n对我来说这也是──\n工、作、啊。"],["他にぃないんですからっ、\nまた会えるっていう未来を規定して……や、いや、[l]\nスケジュールはしっかりしてくれないとその、\n……不安、じゃ、ないですか……」","除此之外别无他法了，\n必须确保能再见的未来才能……啊不是，[l]\n不把日程安排清楚的话那个，\n……会、会不安的嘛……」"],["「あーもうよしよし。[l]\nこちらにも都合があるの、\nごめんね。[l]\nいいこだから待っててね」","「啊ー好了好了乖。[l]\n我们这边也有各种安排，\n对不起嘛。[l]\n好孩子要耐心等待哦」"],["「……ば、[l]\n………ああもう、僕はですね、」","「……笨、[l]\n………啊啊真是的、我啊，」"],["「あ、そか。[l]\nんむ、宮、結局確約してないよね。[l]\nでも、」","「啊、对哦。[l]\n嗯唔、宫、其实还没正式约定呢。[l]\n不过，」"],["「あれ？[l]\nおや？[l]\n何かおかしな事口走ってますよね僕。","「咦？[l]\n哎呀？[l]\n我是不是说了什么奇怪的话啊。"],["す、すみません、なんか今日は、\n疲れてる所為かかなり、\n暴走してるっていうか脳空転が激しいというか、","对、对不起、今天不知怎么的，\n可能是太累了，\n有点暴走或者说脑子转得太快，"],["なんか……[l]\nほんとにすみません……」","总之……[l]\n真的很抱歉……」"],["「分かってます。[l]\n気にしませんから。[l]\n今夜はもう寝ちゃった方が良いですよ。","「我知道的。[l]\n不用在意的。[l]\n今晚还是早点睡比较好哦。"],["じゃね、まこくん。[l]\nおやすみ。ほら、にぎにぎ。ばいばい」","再见啦，小真。[l]\n晚安。来，握握手。拜拜」"],["「……おやすみなさい」","「……晚安」"],["「僕は……あー、[l]\nなんなんだよ、ちくしょう……[l]\n訳分かんねえっ。","「我……啊——[l]\n搞什么啊，可恶……[l]\n完全搞不懂。"],["僕は、どう……[l]\n馬鹿か僕は。[l]\nあんなことの後だから、いや、\nごめん冬夏、僕自身の問題だ、よね、","我到底……[l]\n我是笨蛋吗。[l]\n因为发生了那种事，不对、\n对不起冬夏，是我自己的问题，对吧、"],["冬夏の所為じゃ……ない、[l]\nごめん、ぼくがどうかしてるんだ……」","不是冬夏的错……[l]\n抱歉，我脑子有点不正常……」"],["「寝ようもう……」","「睡吧已经……」"],["５分経過","5分钟过去"],["「なんだろうな、\nこの感じ……は、[l]\n……しい……のか……まあ……[l]\nいいか……ねてしまえば……ぜんぶ……」","「到底是怎么回事、\n这种感觉……[l]\n……是……吗……算了……[l]\n就这样吧……睡着的话……一切……」"],["「……きなの……に……が……つないって……[l]\nこ…う……」","「……小姬的……二……连……着……[l]\n这…样……」"]],"context":[["SC_M_035.ks/index/1/text"],["SC_M_035.ks/index/3/text"],["SC_M_035.ks/index/5/text"],["SC_M_035.ks/index/7/text"],["SC_M_035.ks/index/9/text"],["SC_M_035.ks/index/11/text"],["SC_M_035.ks/index/13/text"],["SC_M_035.ks/index/15/text"],["SC_M_035.ks/index/17/text"],["SC_M_035.ks/index/19/text"],["SC_M_035.ks/index/21/text"],["SC_M_035.ks/index/23/text"],["SC_M_035.ks/index/25/text"],["SC_M_035.ks/index/27/text"],["SC_M_035.ks/index/29/text"],["SC_M_035.ks/index/31/text"],["SC_M_035.ks/index/33/text"],["SC_M_035.ks/index/35/text"],["SC_M_035.ks/index/37/text"],["SC_M_035.ks/index/39/text"],["SC_M_035.ks/index/41/text","SC_M_035.ks/index/162/text"],["SC_M_035.ks/index/43/text"],["SC_M_035.ks/index/45/text","SC_M_035.ks/index/55/text","SC_M_035.ks/index/57/text"],["SC_M_035.ks/index/47/text"],["SC_M_035.ks/index/49/text"],["SC_M_035.ks/index/51/text"],["SC_M_035.ks/index/53/text"],["SC_M_035.ks/index/59/text"],["SC_M_035.ks/index/61/text"],["SC_M_035.ks/index/63/text"],["SC_M_035.ks/index/65/text"],["SC_M_035.ks/index/67/text"],["SC_M_035.ks/index/69/text"],["SC_M_035.ks/index/71/text"],["SC_M_035.ks/index/73/text"],["SC_M_035.ks/index/75/text"],["SC_M_035.ks/index/77/text"],["SC_M_035.ks/index/79/text"],["SC_M_035.ks/index/81/text"],["SC_M_035.ks/index/83/text"],["SC_M_035.ks/index/85/text"],["SC_M_035.ks/index/87/text"],["SC_M_035.ks/index/89/text"],["SC_M_035.ks/index/91/text"],["SC_M_035.ks/index/93/text"],["SC_M_035.ks/index/95/text"],["SC_M_035.ks/index/97/text"],["SC_M_035.ks/index/99/text"],["SC_M_035.ks/index/101/text"],["SC_M_035.ks/index/103/text"],["SC_M_035.ks/index/105/text"],["SC_M_035.ks/index/107/text"],["SC_M_035.ks/index/109/text"],["SC_M_035.ks/index/111/text"],["SC_M_035.ks/index/113/text"],["SC_M_035.ks/index/115/text"],["SC_M_035.ks/index/117/text"],["SC_M_035.ks/index/119/text"],["SC_M_035.ks/index/121/text"],["SC_M_035.ks/index/124/text"],["SC_M_035.ks/index/126/text"],["SC_M_035.ks/index/128/text"],["SC_M_035.ks/index/130/text"],["SC_M_035.ks/index/132/text"],["SC_M_035.ks/index/134/text"],["SC_M_035.ks/index/136/text"],["SC_M_035.ks/index/138/text"],["SC_M_035.ks/index/140/text"],["SC_M_035.ks/index/142/text"],["SC_M_035.ks/index/144/text"],["SC_M_035.ks/index/146/text"],["SC_M_035.ks/index/148/text"],["SC_M_035.ks/index/150/text"],["SC_M_035.ks/index/152/text"],["SC_M_035.ks/index/154/text"],["SC_M_035.ks/index/156/text"],["SC_M_035.ks/index/158/text"],["SC_M_035.ks/index/160/text"],["SC_M_035.ks/index/164/text"]],"tags":[],"parameters":[[{"start":170,"end":214}],[{"start":246,"end":321}],[{"start":352,"end":393}],[{"start":425,"end":442}],[{"start":473,"end":477}],[{"start":509,"end":523}],[{"start":554,"end":581}],[{"start":613,"end":630}],[{"start":661,"end":693}],[{"start":701,"end":735}],[{"start":767,"end":796}],[{"start":804,"end":863}],[{"start":894,"end":898}],[{"start":930,"end":942}],[{"start":973,"end":988}],[{"start":1020,"end":1052}],[{"start":1083,"end":1122}],[{"start":1154,"end":1186}],[{"start":1217,"end":1226}],[{"start":1258,"end":1264}],[{"start":1315,"end":1320},{"start":5001,"end":5006}],[{"start":1351,"end":1370}],[{"start":1402,"end":1407},{"start":1684,"end":1689},{"start":1721,"end":1726}],[{"start":1438,"end":1458}],[{"start":1490,"end":1519}],[{"start":1550,"end":1578}],[{"start":1610,"end":1628}],[{"start":1757,"end":1763}],[{"start":1795,"end":1805}],[{"start":1836,"end":1859}],[{"start":1891,"end":1894}],[{"start":1904,"end":1919}],[{"start":1950,"end":1997}],[{"start":2005,"end":2027}],[{"start":2059,"end":2114}],[{"start":2145,"end":2176}],[{"start":2208,"end":2229}],[{"start":2260,"end":2291}],[{"start":2299,"end":2349}],[{"start":2381,"end":2437}],[{"start":2468,"end":2482}],[{"start":2514,"end":2591}],[{"start":2622,"end":2626}],[{"start":2658,"end":2704}],[{"start":2735,"end":2756}],[{"start":2764,"end":2834}],[{"start":2866,"end":2886}],[{"start":2917,"end":2972}],[{"start":2980,"end":3051}],[{"start":3059,"end":3101}],[{"start":3133,"end":3166}],[{"start":3197,"end":3239}],[{"start":3271,"end":3303}],[{"start":3334,"end":3379}],[{"start":3387,"end":3446}],[{"start":3478,"end":3526}],[{"start":3557,"end":3627}],[{"start":3659,"end":3681}],[{"start":3712,"end":3734}],[{"start":3747,"end":3748}],[{"start":3757,"end":3791}],[{"start":3823,"end":3889}],[{"start":3897,"end":3987}],[{"start":4018,"end":4078}],[{"start":4110,"end":4138}],[{"start":4169,"end":4211}],[{"start":4243,"end":4283}],[{"start":4291,"end":4349}],[{"start":4357,"end":4382}],[{"start":4413,"end":4464}],[{"start":4472,"end":4507}],[{"start":4539,"end":4550}],[{"start":4612,"end":4658}],[{"start":4666,"end":4731}],[{"start":4739,"end":4777}],[{"start":4809,"end":4818}],[{"start":4869,"end":4873}],[{"start":4905,"end":4975}],[{"start":5038,"end":5073}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_035.ks","basename":"SC_M_035.ks","indexIds":{"「んーーー、ぅむーーーー？[l]\nあいや、まこくん。[l]\nどしたの？」":0,"「えーーーーーーーーっとですね、\n夜分遅く済みません……[l]\nあの、今お時間大丈夫ですか？[l]\nというか寝てました……？」":1,"「んむーーーー、\nん、\nまあ大丈夫ですー。[l]\nなに？」":2,"「えっと、\nあの、ですね」":3,"「うん」":4,"「……なんか怒ってますか？」":5,"「んむ？[l]\n別に？[l]\n何で？」":6,"「いや、何かリアクションがその、」":7,"「え？[l]\nうひひ、\n別にいつも通りですけど？":8,"……まさかそれを確認しに来た？[l]\n怒ってるかどうかを？」":9,"「いえいえいえいえいえ真逆そんな事で\nわざわざ……":10,"リアクション薄いと感じたのはたった今、\nリアルタイムでの感想ですから……[l]\nそうではなくてですね」":11,"「んむ」":12,"「あの、部屋入っても？」":13,"「んーーー、今はちょっとだめ」":14,"「あ、そうですか、\nえーとじゃあ単刀直入に言いますが、」":15,"「あ、５分……いあ、１０分待ってくれればおけー。[l]\nだいじょぶ？」":16,"「あ、そうですか、\n待ちます、じゃそこで待ってますんで」":17,"「うん、ごめんね」":18,"「いえいえ」":19,"１５分経過":20,"「まこくーんいいよぉ～、って、あれ？」":21,"「………」":22,"「まぁこくぅ～ん、\n寝ちった？」":23,"「…ふがっ。[l]\nおあ、おあようごあいあう……」":24,"「お待たせしましたぁ～。[l]\nお部屋どうぞ～」":25,"「はっ、ああ、はい、どうもです……」":26,"「どうぞー」":27,"「お邪魔します……」":28,"「さてさて。[l]\n何の御用でしょう」":29,"「あの":30,"実はですね、\n冬夏が」":31,"「んむ、あー、\nまこくんのお部屋教えてあげたから？[l]\n行ったんだほんとに？":32,"うひひ、\n冬夏さんてばだいたぁん☆」":33,"「…ええとまあそれで、[l]\n部屋で寝ちゃったんですよね、僕の。[l]\nどうしたものかと……」":34,"「んむ？[l]\n一緒に寝ればいいですよそれで問題なし」":35,"「あ゛っ。[l]\nどっちとですよ」":36,"「どっち？[l]\nああ、こっちも選択肢に入ってるんだ。":37,"んむ、\nそれは勿論冬夏さんとですよ。[l]\n部屋に戻って何食わぬ顔をして寝るですね」":38,"「……ええと何が勿論かは分かりませんが、[l]\nそれはどう考えても無しですというかその色々とありまして」":39,"「んむー、でもこっちもなー」":40,"「……はぁ、なんか……[l]\n珍しいですねそういう、反応というか……[l]\nいつもだったら女子のにおいがするとか、\nいらん追求が」":41,"「へ？」":42,"「いや、なんでもないです。[l]\nそれで、プレーンで結構です、結構なんですけどもね」":43,"「んむーん？[l]\nま、いいです。":44,"じゃー今夜は知狡に言って別の部屋に寝ますか。[l]\n冬夏さん起こすのもあれですし。[l]\nあ、それとも宮と入れ替わります？」":45,"「はい？[l]\nなんスかそれは」":46,"「宮が冬夏さんと一緒にまこくんの部屋で寝て、\nまこくんが宮の部屋で寝る。[l]\nという事です。":47,"まこくんの懸念も解決出来るし、\n宮も冬夏さんを驚かせられるし、\n知狡の手も煩わせずに済むし、\n無難な落とし所ですよね？":48,"そうしましょう。[l]\nじゃ、今からまこくんの布団敷くので待っててください」":49,"「は、え？[l]\nああ、まあそちらがそれで宜しければ……」":50,"「……部屋のもの弄っちゃ駄目ですよ。[l]\n密かにやっても分かりますからね」":51,"「しませんよ、\nそっちこそ僕の部屋弄んないでくださいよ」":52,"「りょうかーい♪\nあ、今日？明日？[l]\nえっと、日付変わって今日ですか。":53,"取り敢えず休みの日って事で、\nまこくんはゆっくり養生してて構いませんよ。[l]\n後々の事もありますし」":54,"「はあ、\nわかりました……[l]\nまあ何かしら瑣事があったらこなしますけど……」":55,"「あっ。[l]\n例の、お仕事関係で聞きたかった話も、\n後で改めて。[l]\nこっちから招集かけますからしばしお待ちを」":56,"「……ほんとに、ちゃんと喚んでくれますか？」":57,"「んむ？[l]\n勿論ですよ。[l]\n":58,"何":59,"時とは明言出来ませんけど……[l]\n──いきなりどしたの？」":60,"「いえ……その、[l]\n……絶対ですよ。ぜったいですよ。[l]\n僕だってこれが──\nし、ごと、なんですから。":61,"他にぃないんですからっ、\nまた会えるっていう未来を規定して……や、いや、[l]\nスケジュールはしっかりしてくれないとその、\n……不安、じゃ、ないですか……」":62,"「あーもうよしよし。[l]\nこちらにも都合があるの、\nごめんね。[l]\nいいこだから待っててね」":63,"「……ば、[l]\n………ああもう、僕はですね、」":64,"「あ、そか。[l]\nんむ、宮、結局確約してないよね。[l]\nでも、」":65,"「あれ？[l]\nおや？[l]\n何かおかしな事口走ってますよね僕。":66,"す、すみません、なんか今日は、\n疲れてる所為かかなり、\n暴走してるっていうか脳空転が激しいというか、":67,"なんか……[l]\nほんとにすみません……」":68,"「分かってます。[l]\n気にしませんから。[l]\n今夜はもう寝ちゃった方が良いですよ。":69,"じゃね、まこくん。[l]\nおやすみ。ほら、にぎにぎ。ばいばい」":70,"「……おやすみなさい」":71,"「僕は……あー、[l]\nなんなんだよ、ちくしょう……[l]\n訳分かんねえっ。":72,"僕は、どう……[l]\n馬鹿か僕は。[l]\nあんなことの後だから、いや、\nごめん冬夏、僕自身の問題だ、よね、":73,"冬夏の所為じゃ……ない、[l]\nごめん、ぼくがどうかしてるんだ……」":74,"「寝ようもう……」":75,"５分経過":76,"「なんだろうな、\nこの感じ……は、[l]\n……しい……のか……まあ……[l]\nいいか……ねてしまえば……ぜんぶ……」":77,"「……きなの……に……が……つないって……[l]\nこ…う……」":78},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_035.ks","relPath":"/data/scenario/SC_M_035.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":78,"length":79,"percent":98.73417721518987},"cellInfo":[]},"/data/scenario/SC_M_036.ks":{"data":[["その日私は、\n\n●●さんが掟を執行するのを視たのです。","那天我、\n\n目睹了●●先生执行戒律。"],["それはヤソウのシュともいうべき、\n\n忌まわしくもくだらない理由で規定された、\n\n\n\n歪の間引きです。","那正是所谓野葬的朱、\n\n基于既荒谬又可笑的理由所制定的、\n\n\n\n扭曲的淘汰。"],["\n\n私は恐ろしくて、\n\n悲しくて、\n\n誰にも云えませんでした。","\n\n我害怕得、\n\n悲伤得、\n\n不敢告诉任何人。"],["でも、\n\nこんなのはだめだと思いました。","但是、\n\n我觉得这样不行。"],["でも、\n\n私はこの一族とその眷属の頂点に位置するよう、\n\n決められた魔女の姫です。","可是、\n\n我是被指定要立于这一族及其眷属顶点的、\n\n魔女公主。"],["瑠璃にしてハリをカタキとす、りでるの裔、どれの裔、\n\n知らない、\n\nそんなのは、\n\nそこにはきーちゃんもいたのに、","瑠璃视针为仇敌，利德尔的后裔，多雷的后裔、\n\n不知道、\n\n那种事、\n\n明明小姬也在那里的、"],["\nあのこも、\n\nだめ、\n\nやめ、\n\nわたしが誰の子孫だろうと──\n\nあのひとも？","\n那孩子也、\n\n不行、\n\n住手、\n\n不管我是谁的后代——\n\n那个人也是？"],["緋色の川が、\n\nいやだ、\n\nわたしはわたし、\n\nあなたたちの人形になんて成りたくない、","绯色的河流、\n\n不要、\n\n我就是我、\n\n才不要当你们的傀儡、"],["\n……だれ？\n\nああ、あのときの。\n\nたすけてください。\n\n円環ではなく螺旋を、\n\n繰り返しではなく進展を、\n\n私達は成長することに意味がある、\n\nそうでしょ？","\n……谁？\n\n啊，那时候的。\n\n请救救我。\n\n要螺旋而非轮回、\n\n要前进而非重复、\n\n我们成长的意义就在于此、\n\n对吧？"],["あのときのあのひとたち、\n\nしろのしろはすなのおしろ、\n\nきかいじかけのかみの壮美なるもの。\nきみはわたしたちのおもいを、\n\nソンナコトハドウデモ、","那时候的那些人、\n\n白之白乃砂之御城、\n\n机械装置之神的壮美存在。\n请你继承我们的意志、\n\n那种事无论如何、"],["\n唯唯、\n\nミ・キャミャルキャラモロコネコナメタサキャラ\nタサコネタサメミャラメンカヤコネキャ・ワ。\nあのひとと繋がろう。","\n唯唯、\n\nmi・kya mya ru kya ra mo ro ko ne ko na me ta sa kya ra\nta sa ko ne ta sa me mya ra me n ka ya ko ne kya・wa。\n和那个人相连吧。"],["ツギへと、\n\nわたしたちはみな、\n\n利己的な●●●の","向着下一站、\n\n我们所有人、\n\n都是自私的●●●的"],["傀","傀"],["儡、\nあやつりにんぎょうにすぎないのだし、\n\nＭＥＭＥ？","儡、\n不过是任人摆布的提线木偶罢了、\n\nMEME？"],["\nあれ？\n\nＷＥ？３Ｅ？\n\nちがう？\n\nえ？","\n咦？\n\nWE？3E？\n\n不对吗？\n\n诶？"],["それじゃあまるで──\n\n","那简直就像──\n\n"],["しめ、","瞧、"],["「……ん……、[l]\nんん～～～～～～～、\n……～～、[l]\nん？」","「……嗯……、[l]\n嗯嗯～～～～～～～、\n……～～、[l]\n嗯？」"],["「んむ、起きた？[l]\nおはようございます」","「嗯唔、醒了吗？[l]\n早上好」"],["「……ぁ、やだ……あれ？」","「……啊、讨厌……咦？」"],["「運んだり起こしたりするのもなんでしたので、\n宮と部屋を交換してですね、\nまこくんは今宮の部屋にいます。","「因为搬运和叫醒都很麻烦、\n就和宫交换了房间呢、\n真现在在宫的房间里。"],["御不満でしょうけど、\n昨晩は宮が冬夏さんとご一緒に──\n……もしもし？」","虽然您可能会不满、\n昨晚宫和冬夏小姐一起──\n……喂喂？」"],["「え、は、はう゛ぃ……」","「诶、哈、哈呜……」"],["「うひひ、\n状況分かってない？のかな？[l]\nそれともまだ、\n夢から覚めてないのかな？」","「呜嘻嘻、\n还没搞清楚状况吗？[l]\n还是说、\n还没从梦里醒过来呢？」"],["「え…と……[l]\nまことさんのへ…や……？ここ？でふか？[l]\nんん～……？」","「呃…那个……[l]\n真言先生的房…间……？这里？睡觉？[l]\n嗯嗯～……？」"],["「ですよー。[l]\n何があったかはまこくんにも訊いてないので\n安心してください。","「是呀ー。[l]\n发生了什么也没问真\n请放心。"],["冬夏さんが寝入ってからすぐ、\n宮の所に泣きついてきたので、\n寝顔も多分そんなに視られてないしー、","冬夏小姐睡着后不久、\n就哭着跑到宫这里来了、\n睡相大概也没被看太多啦ー、"],["鼾も歯軋りも寝言も、\nなぁんにもまこくんにはバレてませんから\nご安心を」","打呼磨牙说梦话、\n全～都没有被真发现哦\n请安心吧」"],["「っっっっっはぁああああああああ…………！！[l]\nおおおお、思い出しました…ぁ……！！！","「啊啊啊啊啊啊…………！！[l]\n噢噢噢、想起来了…啊……！！！"],["あ、あうあう、す、すみませんていうか、\n私なんだかその、\nえ、そんなに酷かったです……？」","啊、啊呜啊呜、对、对不起应该说、\n我那个怎么说、\n诶、有那么糟糕吗……？」"],["「うひひ、\n冗談ですよ。","「呜嘻嘻、\n开玩笑的啦。"],["宮も仕事で色々出回ってたので\n大してご一緒出来ませんでしたが……[l]\n大変御行儀良くあらせられましたぁ」","宫也因为工作到处奔波\n没能怎么陪您呢……[l]\n但您表现得非常乖巧呢」"],["「はぁ、それは何よりです……[l]\nあわわわわわ……私ってば……[l]\n真言さんにも迷惑かけちゃった…ですよね？」","「哈、那真是太好了……[l]\n哇哇哇哇……我真是的……[l]\n也给真言先生添麻烦了吧…对吗？」"],["「んむ？[l]\nいえいえだいじょぶでしょー。[l]\nあのこにはそういうの大分馴れさせましたから」","「嗯唔？[l]\n没事没事不要紧啦ー。[l]\n那孩子早就习惯这种事了」"],["「あー、えーと………んーーー、[l]\nあの……夕べも訊いたかもですが、[l]\nお二人はその……」","「啊ー、呃ー………嗯ーーー、[l]\n那个……昨晚可能也问过了，[l]\n两位是那个……」"],["「上司と部下ですよ。[l]\nそれ以上でもそれ以下でも……[l]\nんむ、そか、\n上司以上部下未満てとこですかね」","「是上司和下属的关系哦。[l]\n既不是以上也不是以下……[l]\n嗯，这样啊，\n算是上司以上下属未满的程度吧」"],["「上司以上……あはは、何か言い方としてヘンですけど、[l]\n意味的にそれ酷過ぎますよね。[l]\n女王様と下僕ですよね、\nあは、真言さん可哀相過ぎ」","「上司以上……啊哈哈，这种说法虽然有点怪，[l]\n但意思上也太残酷了吧。[l]\n是女王和仆人的关系对吧，\n啊哈，真言先生太可怜了」"],["「うひひ、\nま、こう心配してくれる女子もいる事ですし、\nそのくらいは苛めても良いかな？とね。","「唔嘻嘻，\n嘛，毕竟也有这样关心他的女孩子在，\n稍微欺负一下也没关系吧？这样想着。"],["さて大分お眼も覚めたようですし……っと。[l]\nじゃ、学校遅れないように、\nここ朝ご飯も美味しいですよ。[l]\nではまた後程ー」","看来已经清醒得差不多了……那么。[l]\n别迟到啦，\n这里的早餐也很好吃哦。[l]\n待会儿见ー」"],["「あはは……[l]\nありがとうございますー。[l]\nまたー」","「啊哈哈……[l]\n谢谢您ー。[l]\n回头见ー」"],["しーーーーーーーーん。","静ーーーーーーーー。"],["「………えっ、えっ、えっ、[l]\nどうしよう、\n私何言ったっけ夕べ？","「………诶、诶、诶，[l]\n怎么办，\n我昨晚说了什么来着？"],["あ、うそ、やだ、\nややややや私って、ああもう、\nあうーーーーー、うあーーーーー、」","啊，骗人，不要，\n呀呀呀呀呀我真是，啊啊够了，\n啊呜ーーーーー，呜啊ーーーーー、」"],["こここここん。","咚咚咚咚咚。"],["「もしもしー、\n入ってもよろしいですかあ」","「喂喂ー，\n可以进来吗ー」"],["「ん、はーいどうぞ大丈夫」","「嗯、好ー的请进没问题」"],["「あ、おはようござーます……[l]\nってまだ布団の中じゃんよ……[l]\n──宮さんはもう？」","「啊、早上好ー……[l]\n话说还在被窝里嘛……[l]\n──宫小姐已经？」"],["「んーーーー、\nおはようー。[l]\n宮さま？知らない。[l]\nたった今出てったのに会わなかった？","「嗯ーーーー，\n早上好ー。[l]\n宫大人？不认识。[l]\n刚刚出门没碰到吗？"],["ふぅんそう。[l]\nはぅあああーーーー！！[l]\nとうっ！！！」","哼嗯这样啊。[l]\n哈啊啊啊啊————！！[l]\n咚！！！」"],["「おわ！[l]\nなんで枕投げる！？」","「哇！[l]\n干嘛扔枕头！？」"],["「あははは、なんとなく！[l]\n……あっ！！」","「啊哈哈哈，就是突然想扔！[l]\n……啊！！」"],["「ど、どしたの」","「怎、怎么了」"],["「着替えてなかった！[l]\n布団の中いますごいことに！！[l]\nこれは……やば、えろすぎ」","「还没换衣服！[l]\n被窝里现在超糟糕的！！[l]\n这是……不妙，太色了」"],["「はっ！？[l]\nでででで出て行くから早く着替えなさい！！」","「哈！？[l]\n我我我我我这就出去你快换衣服！！」"],["「ごめんなさーい！[l]\nすぐ着替えるー」","「对不起ー！[l]\n马上换ー」"],["「え、えと、ごゆっくり──」","「呃、那个、请慢慢来──」"],["どたたたたたたたた……","咚咚咚咚咚咚咚……"],["「……ふふ。あははっ。[l]\nあはははははは………[l]\nん……やっぱり私、[l]\nあなたのことすきだ。","「……呵呵。啊哈哈。[l]\n啊哈哈哈哈哈哈………[l]\n嗯……果然我，[l]\n最喜欢你了。"],["理由なんか……いいよね？[l]\n………私、[l]\n──私の全部、あなたにさらけ出すよ、\nミハルの……ことも、","理由什么的……不重要吧？[l]\n………我，[l]\n──我会把全部的自己都展现给你，\n米哈尔的……事情也是，"],["きっと私達は同じものを、\nいえ、あのときのあれがそうなら、\n……それで駄目なら、","我们一定看到了相同的东西，\n不，如果那时候那个就是的话，\n……如果那样还不行的话，"],["んーん、\n少しでも望みがあるなら、わたし、\nお返事、待ってる、待ってるから……」","嗯——嗯，\n哪怕只有一丝希望，我，\n会等着你的答复，一直等着……」"]],"context":[["SC_M_036.ks/index/1/text"],["SC_M_036.ks/index/3/text"],["SC_M_036.ks/index/5/text"],["SC_M_036.ks/index/7/text"],["SC_M_036.ks/index/9/text"],["SC_M_036.ks/index/11/text"],["SC_M_036.ks/index/13/text"],["SC_M_036.ks/index/15/text"],["SC_M_036.ks/index/17/text"],["SC_M_036.ks/index/19/text"],["SC_M_036.ks/index/21/text"],["SC_M_036.ks/index/23/text"],["SC_M_036.ks/index/25/text"],["SC_M_036.ks/index/27/text"],["SC_M_036.ks/index/29/text"],["SC_M_036.ks/index/31/text"],["SC_M_036.ks/index/34/text"],["SC_M_036.ks/index/36/text"],["SC_M_036.ks/index/38/text"],["SC_M_036.ks/index/40/text"],["SC_M_036.ks/index/42/text"],["SC_M_036.ks/index/44/text"],["SC_M_036.ks/index/46/text"],["SC_M_036.ks/index/48/text"],["SC_M_036.ks/index/50/text"],["SC_M_036.ks/index/52/text"],["SC_M_036.ks/index/54/text"],["SC_M_036.ks/index/56/text"],["SC_M_036.ks/index/58/text"],["SC_M_036.ks/index/60/text"],["SC_M_036.ks/index/62/text"],["SC_M_036.ks/index/64/text"],["SC_M_036.ks/index/66/text"],["SC_M_036.ks/index/68/text"],["SC_M_036.ks/index/70/text"],["SC_M_036.ks/index/72/text"],["SC_M_036.ks/index/74/text"],["SC_M_036.ks/index/76/text"],["SC_M_036.ks/index/78/text"],["SC_M_036.ks/index/80/text"],["SC_M_036.ks/index/82/text"],["SC_M_036.ks/index/84/text"],["SC_M_036.ks/index/86/text"],["SC_M_036.ks/index/88/text"],["SC_M_036.ks/index/90/text"],["SC_M_036.ks/index/92/text"],["SC_M_036.ks/index/94/text"],["SC_M_036.ks/index/96/text"],["SC_M_036.ks/index/98/text"],["SC_M_036.ks/index/100/text"],["SC_M_036.ks/index/102/text"],["SC_M_036.ks/index/104/text"],["SC_M_036.ks/index/106/text"],["SC_M_036.ks/index/108/text"],["SC_M_036.ks/index/110/text"],["SC_M_036.ks/index/112/text"],["SC_M_036.ks/index/114/text"],["SC_M_036.ks/index/116/text"],["SC_M_036.ks/index/118/text"],["SC_M_036.ks/index/120/text"],["SC_M_036.ks/index/122/text"]],"tags":[],"parameters":[[{"start":175,"end":210}],[{"start":220,"end":294}],[{"start":302,"end":357}],[{"start":365,"end":393}],[{"start":401,"end":458}],[{"start":466,"end":547}],[{"start":555,"end":631}],[{"start":639,"end":706}],[{"start":714,"end":846}],[{"start":854,"end":958}],[{"start":966,"end":1049}],[{"start":1057,"end":1099}],[{"start":1109,"end":1110}],[{"start":1120,"end":1160}],[{"start":1168,"end":1218}],[{"start":1228,"end":1244}],[{"start":1271,"end":1274}],[{"start":1391,"end":1437}],[{"start":1499,"end":1525}],[{"start":1555,"end":1568}],[{"start":1599,"end":1659}],[{"start":1667,"end":1711}],[{"start":1741,"end":1753}],[{"start":1784,"end":1840}],[{"start":1870,"end":1918}],[{"start":1949,"end":1997}],[{"start":2005,"end":2061}],[{"start":2080,"end":2124}],[{"start":2154,"end":2203}],[{"start":2211,"end":2264}],[{"start":2295,"end":2311}],[{"start":2319,"end":2380}],[{"start":2410,"end":2475}],[{"start":2506,"end":2562}],[{"start":2592,"end":2648}],[{"start":2679,"end":2746}],[{"start":2776,"end":2861}],[{"start":2892,"end":2946}],[{"start":2954,"end":3030}],[{"start":3079,"end":3117}],[{"start":3143,"end":3154}],[{"start":3184,"end":3226}],[{"start":3234,"end":3283}],[{"start":3309,"end":3316}],[{"start":3348,"end":3373}],[{"start":3403,"end":3416}],[{"start":3448,"end":3502}],[{"start":3532,"end":3592}],[{"start":3600,"end":3640}],[{"start":3672,"end":3694}],[{"start":3748,"end":3775}],[{"start":3807,"end":3815}],[{"start":3845,"end":3898}],[{"start":3930,"end":3964}],[{"start":3994,"end":4019}],[{"start":4051,"end":4065}],[{"start":4073,"end":4084}],[{"start":4114,"end":4178}],[{"start":4186,"end":4252}],[{"start":4260,"end":4308}],[{"start":4316,"end":4364}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_036.ks","basename":"SC_M_036.ks","indexIds":{"その日私は、\n\n●●さんが掟を執行するのを視たのです。":0,"それはヤソウのシュともいうべき、\n\n忌まわしくもくだらない理由で規定された、\n\n\n\n歪の間引きです。":1,"\n\n私は恐ろしくて、\n\n悲しくて、\n\n誰にも云えませんでした。":2,"でも、\n\nこんなのはだめだと思いました。":3,"でも、\n\n私はこの一族とその眷属の頂点に位置するよう、\n\n決められた魔女の姫です。":4,"瑠璃にしてハリをカタキとす、りでるの裔、どれの裔、\n\n知らない、\n\nそんなのは、\n\nそこにはきーちゃんもいたのに、":5,"\nあのこも、\n\nだめ、\n\nやめ、\n\nわたしが誰の子孫だろうと──\n\nあのひとも？":6,"緋色の川が、\n\nいやだ、\n\nわたしはわたし、\n\nあなたたちの人形になんて成りたくない、":7,"\n……だれ？\n\nああ、あのときの。\n\nたすけてください。\n\n円環ではなく螺旋を、\n\n繰り返しではなく進展を、\n\n私達は成長することに意味がある、\n\nそうでしょ？":8,"あのときのあのひとたち、\n\nしろのしろはすなのおしろ、\n\nきかいじかけのかみの壮美なるもの。\nきみはわたしたちのおもいを、\n\nソンナコトハドウデモ、":9,"\n唯唯、\n\nミ・キャミャルキャラモロコネコナメタサキャラ\nタサコネタサメミャラメンカヤコネキャ・ワ。\nあのひとと繋がろう。":10,"ツギへと、\n\nわたしたちはみな、\n\n利己的な●●●の":11,"傀":12,"儡、\nあやつりにんぎょうにすぎないのだし、\n\nＭＥＭＥ？":13,"\nあれ？\n\nＷＥ？３Ｅ？\n\nちがう？\n\nえ？":14,"それじゃあまるで──\n\n":15,"しめ、":16,"「……ん……、[l]\nんん～～～～～～～、\n……～～、[l]\nん？」":17,"「んむ、起きた？[l]\nおはようございます」":18,"「……ぁ、やだ……あれ？」":19,"「運んだり起こしたりするのもなんでしたので、\n宮と部屋を交換してですね、\nまこくんは今宮の部屋にいます。":20,"御不満でしょうけど、\n昨晩は宮が冬夏さんとご一緒に──\n……もしもし？」":21,"「え、は、はう゛ぃ……」":22,"「うひひ、\n状況分かってない？のかな？[l]\nそれともまだ、\n夢から覚めてないのかな？」":23,"「え…と……[l]\nまことさんのへ…や……？ここ？でふか？[l]\nんん～……？」":24,"「ですよー。[l]\n何があったかはまこくんにも訊いてないので\n安心してください。":25,"冬夏さんが寝入ってからすぐ、\n宮の所に泣きついてきたので、\n寝顔も多分そんなに視られてないしー、":26,"鼾も歯軋りも寝言も、\nなぁんにもまこくんにはバレてませんから\nご安心を」":27,"「っっっっっはぁああああああああ…………！！[l]\nおおおお、思い出しました…ぁ……！！！":28,"あ、あうあう、す、すみませんていうか、\n私なんだかその、\nえ、そんなに酷かったです……？」":29,"「うひひ、\n冗談ですよ。":30,"宮も仕事で色々出回ってたので\n大してご一緒出来ませんでしたが……[l]\n大変御行儀良くあらせられましたぁ」":31,"「はぁ、それは何よりです……[l]\nあわわわわわ……私ってば……[l]\n真言さんにも迷惑かけちゃった…ですよね？」":32,"「んむ？[l]\nいえいえだいじょぶでしょー。[l]\nあのこにはそういうの大分馴れさせましたから」":33,"「あー、えーと………んーーー、[l]\nあの……夕べも訊いたかもですが、[l]\nお二人はその……」":34,"「上司と部下ですよ。[l]\nそれ以上でもそれ以下でも……[l]\nんむ、そか、\n上司以上部下未満てとこですかね」":35,"「上司以上……あはは、何か言い方としてヘンですけど、[l]\n意味的にそれ酷過ぎますよね。[l]\n女王様と下僕ですよね、\nあは、真言さん可哀相過ぎ」":36,"「うひひ、\nま、こう心配してくれる女子もいる事ですし、\nそのくらいは苛めても良いかな？とね。":37,"さて大分お眼も覚めたようですし……っと。[l]\nじゃ、学校遅れないように、\nここ朝ご飯も美味しいですよ。[l]\nではまた後程ー」":38,"「あはは……[l]\nありがとうございますー。[l]\nまたー」":39,"しーーーーーーーーん。":40,"「………えっ、えっ、えっ、[l]\nどうしよう、\n私何言ったっけ夕べ？":41,"あ、うそ、やだ、\nややややや私って、ああもう、\nあうーーーーー、うあーーーーー、」":42,"こここここん。":43,"「もしもしー、\n入ってもよろしいですかあ」":44,"「ん、はーいどうぞ大丈夫」":45,"「あ、おはようござーます……[l]\nってまだ布団の中じゃんよ……[l]\n──宮さんはもう？」":46,"「んーーーー、\nおはようー。[l]\n宮さま？知らない。[l]\nたった今出てったのに会わなかった？":47,"ふぅんそう。[l]\nはぅあああーーーー！！[l]\nとうっ！！！」":48,"「おわ！[l]\nなんで枕投げる！？」":49,"「あははは、なんとなく！[l]\n……あっ！！」":50,"「ど、どしたの」":51,"「着替えてなかった！[l]\n布団の中いますごいことに！！[l]\nこれは……やば、えろすぎ」":52,"「はっ！？[l]\nでででで出て行くから早く着替えなさい！！」":53,"「ごめんなさーい！[l]\nすぐ着替えるー」":54,"「え、えと、ごゆっくり──」":55,"どたたたたたたたた……":56,"「……ふふ。あははっ。[l]\nあはははははは………[l]\nん……やっぱり私、[l]\nあなたのことすきだ。":57,"理由なんか……いいよね？[l]\n………私、[l]\n──私の全部、あなたにさらけ出すよ、\nミハルの……ことも、":58,"きっと私達は同じものを、\nいえ、あのときのあれがそうなら、\n……それで駄目なら、":59,"んーん、\n少しでも望みがあるなら、わたし、\nお返事、待ってる、待ってるから……」":60},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_036.ks","relPath":"/data/scenario/SC_M_036.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":61,"length":61,"percent":100},"cellInfo":[null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[10,1]},"/data/scenario/SC_M_037.ks":{"data":[["冬夏が着替えてきて、\n朝食を","冬夏换好衣服后，\n和我一起去食堂"],["摂りに一緒に食堂に向かった。","吃早餐。"],["流石の僕でも、あの、\n夕べの事を忘れた訳じゃないので、\n何というか変な空気になるかと危惧もしたけれど、\n女子ってのはそういうモノなのか、","即便是我也，那个，\n并没有忘记昨晚的事，\n虽然担心会不会变得气氛尴尬，\n但女生就是这样的生物吧，"],["やけにあっけらかんとしてるというか、\nあんまり気にもしてない感じで振る舞うので、\nちょっとばかり拍子抜けした。","意外地表现得若无其事，\n举止间似乎完全不在意的样子，\n反倒让我有点泄气。"],["返事は誕生日にくれっていう事で、\n気持ち的にケジメというか、\n切り替えしやすかったのかしら。","说是生日那天给我答复，\n从心情上来说算是划清界限，\n或许这样更容易转换心态吧。"],["或いは想像だけど、\n昨日はノリとかテンションで突っ走った部分も多分にあるだろうし、\n実際、無かった事にしたいのかも知れないね！","或者只是我的猜测，\n昨天大概也有很多是情绪上头冲动行事，\n实际上，说不定是想当作没发生过呢！"],["と思ったので、\n取り敢えず僕からはあの話題には触れない事とする。","这么想着，\n我决定暂且不主动提起那个话题。"],["「これってヴァイキング方式っていうんでしょ？[l]\nビュッフェ？だっけ？どっちでもいいけど。[l]\n何か楽しいね」","「这个就是所谓的维京式自助餐吧？[l]\n是叫buffet？记不清了。不过无所谓啦。[l]\n总觉得好开心呢」"],["「んー、そうだね。[l]\n此処は結構早い時間に開くからありがたいよ。","「嗯——是啊。[l]\n这里开门很早真是帮大忙了。"],["まあ食事に関しては外食含めて、\n色々選択肢があるようだから……[l]\nお好きな方法で」","不过餐饮方面包括外出就餐，\n好像有很多选择的样子……[l]\n请按你喜欢的方式来」"],["「ん、これいい。[l]\nこれ楽しい。美味しいし」","「嗯，这个不错。[l]\n这个好玩。又好吃」"],["自分で何かする、\nというのに妙に愉しみを感じるらしいのは昨日の色々で分かったけど、\n流石にここでは僕の後をついて回りながらの手探り状態だった。","自己动手这件事，\n从昨天的种种就能看出她似乎莫名享受，\n不过在这里还是跟在我身后摸索的状态。"],["選んだ物も結局、僕と同じだったし。[l]\nクロワッサン、牛乳、スクランブルエッグ、ウィンナー、サラダ等々、\n軽め洋食系で選択。","最后选的东西也和我一模一样。[l]\n牛角包、牛奶、炒蛋、香肠、沙拉等等，\n选了偏西式的轻食。"],["僕も此処に宿泊してからあまり利用する機会が無かったので、\n楽しいと言えば楽しい。[l]\n旅行でそこそこ馴れてるので新鮮味は","我住这儿之后也没怎么来吃过，\n要说开心确实挺开心的。[l]\n因为旅行经验还算丰富所以新鲜感"],["然","倒"],["程ないけど。","也说不上。"],["「そうねえ、この牛乳とか確かにおいしいねえ。","「确实呢，这牛奶真好喝。"],["中央の方はモノは高いし、\n種類だけはいっぱいあるけどさ、\n実際おいしいと思えるのって実はそうそう\nないんだなあ」","市中心的东西又贵，\n虽然种类倒是很多，\n但真正觉得好吃的东西其实\n没那么多呢」"],["「ん。[l]\nそだよね。[l]\n母様はその辺解ってないけどね。[l]\nステータスとしてしか判断してない。","「嗯。[l]\n就是啊。[l]\n母亲大人就不懂这些。[l]\n只会用社会地位来判断。"],["だからきぃとかと食べに行くと、\nすごい楽しいんだ。[l]\n食べるってこう、根源的ていうの？[l]\n生きるのに基本的なものじゃない？」","所以和小贵她们去吃饭时，\n就特别开心。[l]\n吃东西这种感觉，该说是根源性吗？[l]\n不就是生存最基本的需求吗？」"],["「うん」","「嗯」"],["言いながら、\nそうだ、道具さんからの言伝が……と思い出す。[l]\nでも取り敢えずは食べつつ、\n冬夏の話題の途切れるのを窺う。","正说着，\n突然想起道具有话要转达……[l]\n但决定先继续吃饭，\n等着冬夏转换话题的间隙。"],["「動物だろうと植物だろうと、\n相手の生命を取り込むって事だからさ。[l]\n虚飾にかまけて","「不管是动物还是植物，\n夺取对方生命这件事啊。[l]\n沉溺于虚饰"],["疎かにしちゃいけないと\n思うの私。","却疏忽了\n我觉得这样不行。」"],["んー、\n余裕があるって事なのかも知れないけど、\n生きるのに必要なコト以外を食事に見出すのって、\n私、きらい」","嗯——\n或许是因为生活有余裕吧，\n在进食这件事上追求生存必需之外的意义，\n我、很讨厌」"],["ま、勿論局所的な場面での個人的意見ね、\nと苦笑しながらまとめた。","嘛当然这只是局部场景下的个人观点啦，\n她苦笑着补充道。"],["重くなりかけた空気をどうにかしようとしたのだろうが、\n共感する部分もあったので僕はただ感心していただけで、\nうーん、と頷くだけの","大概是想缓解快要凝固的空气，\n不过因为我也有些共鸣，就只是佩服地听着，\n发出嗯嗯的应和声，"],["為","装"],["体。","样子。"],["というか、話す事がある、\nというのを憶えていようと集中してた所為もある。","或者说，是因为我正集中精神\n记着待会儿有事要说。」"],["「あはは……ヴァイキング楽しいって言ったばっかで[l]\n言えた台詞かって話」","「啊哈哈……明明刚说完维京料理很有趣[l]\n现在又说这种话真是矛盾呢」"],["「うーん、うー、そうねえ……」","「唔嗯、唔、这个嘛……」"],["リアクション薄すぎたか、と自省して、","反省着自己反应太冷淡，"],["「まあ、僕等は基本屍体食べてる訳だしね、\nテレビとかで肉とか食材を視て美味しそうって言ったりさ、\n看板とかで食材の動物自身に「おいしいよ！」とか言わせてるの視ると、[l]\n違和感を感じることはあるよ僕も。","「毕竟我们平时基本都在吃尸体嘛，\n看到电视里把肉类食材拍得很美味什么的，\n或是广告让作为食材的动物本身说出「很好吃哦！」的时候，[l]\n我也会觉得违和啦。"],["ま、近代になってからかもだけど、\nヒトは生き物を殺して食べるんだという事実をさ、\nそういうのをタブー視というか、\n穢れとして日常から意識的に排除してしまったから、","不过这种现象大概是近代才有的，\n人类刻意把『杀生吃肉』这个事实\n当作禁忌什么的，\n作为污秽从日常生活中屏蔽掉了，"],["うん、それで、\n","嗯，所以啊，\n"],["有","在"],["難","连"],["味も薄れてしまったという副作用も──」","带着罪恶感的滋味都变淡了——」"],["突如饒舌気味にレスする僕。[l]\nと、","我突然话多起来。[l]\n接着"],["「良くある番組でさ、\nライオンの親子にスポット当てるか、\nインパラの親子にスポット当てるかだよね。","「那些常见节目啊，\n不是给狮子母子特写，\n就是给黑斑羚母子特写对吧。"],["お腹すかせたライオンの子供に注目させてるときはさ、\n獲物狩れないのが悲劇みたいに演出するけど」","拍到饿肚子的幼狮时，\n就把捕不到猎物渲染成悲剧」"],["「インパラクローズアップしてる時は、\n狩られる事が悲劇になるわなあ」","「但镜头对准黑斑羚的时候，\n被猎食又变成悲剧了呢」"],["「で、毎度毎度、\n大自然の厳しい掟、とか言うんだナレーションが。[l]\nどっちにしてもちょっとえっ？！とかツッコミたくなるんだけど。","「然后每次每次，\n旁白都要说什么大自然残酷的法则。[l]\n不管哪种都让人想吐槽『等等这不对吧？』。"],["両方フラットに映してくれないとさ、\nどっちにもどっちの事情ってのがあるわけじゃない結局。[l]\n食べるほうも食べられるほうも、絶対何かしら食べてるんだし」","如果不把双方平等呈现的话，\n说到底两边都各有各的生存立场啊。[l]\n猎食者和被食者，肯定都要靠吃别的什么活下去」"],["「あはは……[l]\n植物をどう位置付けるかだよねえ。","「啊哈哈……[l]\n问题在于怎么定位植物呢。"],["この手の話題は、\n","这类话题要是展开说，\n"],["敷","就"],["衍すると家畜は種の存続形式としてどうかとか、\nその辺は色々あるん……だそうだけど。","会扯到家畜作为物种存续形式是否合理之类的，\n据说那边也有很多争议……"],["まあ結局、\n食材として動物を捉えるのも、或る意味では自然なわけだし、\nそういう場合、美味しそうって感想も変だとは言えず、\nなんだろう……","不过归根结底，\n将动物视为食材在某种意义上也很自然，\n这种情况下说『看起来很好吃』也不算错，\n该怎么说呢……"],["って、朝飯食べながらどんな会話してるんだ僕等は」","话说我们早餐时都在聊什么啊」"],["「あっはははは！[l]\nごめんなさーい。","「啊哈哈哈哈！[l]\n对不起啦—"],["昨日のドライブの時もそうだけど、\nあんまりいないのねこういう話についてきてくれる人。[l]\n……克杖とかは話せば通じるだろうけど、[l]\n機会無いし、友好度そんなに高くないから。","昨天开车时也是这样，\n愿意陪我聊这种话题的人真的不多呢。[l]\n……克杖的话应该能理解吧，[l]\n但没机会聊，而且友好度也没那么高。"],["というかあの","或者说那个"],["娘は──ん、いいや。[l]\nきぃとはね、その、違う方向の話ばっかりするし」","女孩——嗯，算了。[l]\n小贵她啊，总是聊些完全不同方向的话题」"],["ん、つい今し方まで、\n僕は何かを言おうとしてたんではなかったか。","嗯，直到刚才为止，\n我是不是本来想说什么来着。"],["……あれ？","……咦？"],["拙い、忘れました……[l]\n毎度の事ながらこう自分の脳が恨めしい……","糟糕，忘记了……[l]\n每次这种时候都好恨自己的脑子……"],["何だっけ？[l]\n結構大事な内容だったよな。[l]\nレスに集中しすぎて飛んでしもうたよ……","刚才想说什么？[l]\n好像是挺重要的事。[l]\n光顾着回消息结果忘得一干二净……"],["「普通はこんな事考えて生活してないんだよね。[l]\n考えずに済むならそれはそれで羨ましいけど、\n私、変かな？変なのかな」","「正常人生活中都不会想这些吧。[l]\n能不去想这些反倒让人羡慕，\n我这样很奇怪吗？很怪吧」"],["「まあ、年頃的に考えて、\n他の人だって実はそんなもんじゃない？","「嘛，按这个年纪来说，\n其他人其实也差不多吧？"],["自分以外がそう視えるのも多分、あれだ、\n皆も他人と会ってるときくらい軽薄に発散したいんだよきっと。[l]\nみんな内には色々秘めてるんじゃないかねえ……」","会觉得只有自己特别，大概是因为\n大家和别人相处时都想装得轻浮点啦。[l]\n谁心里还没藏着点什么呢……」"],["冬夏へのフォローに徹することで、\nほぼ言おうとしてた事は思考の","只顾着附和田夏的话，\n原本想说的内容就这样"],["埒","被"],["外に置かれました。","抛到九霄云外。"],["メモリも不足してりゃー演算能力、\n果ては記憶装置までもアレなスペックの僕としましては、\n事項の複数同時処理などオーバーワークも好い所でね……","像我这种内存不足运算能力低下、\n连存储设备都破破烂烂的配置，\n同时处理多线程任务实在强人所难……"],["「あはははっ、なーんかお年寄りみたいだよー。[l]\nやっぱ枯れてるよねー。","「啊哈哈，简直像个老头子似的。[l]\n果然是老化了吧。"],["ん、\nそこが、\nいいの。[l]\nたははははは……けほっ、けほけほ」","嗯，\n但这点\n很好。[l]\n哈哈哈……咳咳、咳咳」"],["「あわわわだいじょぶかいな。[l]\nさす……ったほうがいい？」","「哇哇哇你没事吧。[l]\n要不要……拍拍背？」"],["「だっ……けふっ、んっ、[l]\nだいじょぶ。[l]\nけほけほ。","「没……咳咳、嗯，[l]\n没事。[l]\n咳咳。"],["ん、んんっ。[l]\nだいじょぶ。だいじょぶです。[l]\n……あっ、やっぱりさすって貰えば良かったー。[l]\nちっ」","嗯、嗯嗯。[l]\n没事。没问题的。[l]\n……啊，果然还是该让你拍拍背的。[l]\n啧」"],["「変なとこで人のこと笑うからだよ……[l]\n人のこと笑うからだよ変なとこで」","「谁让你在奇怪的地方笑话别人……[l]\n在奇怪的地方笑话别人才会这样啦」"],["「あはは何で順番変えて繰り返すのー。[l]\n………」","「啊哈哈干嘛调换顺序重复啦。[l]\n………」"],["……？",""],["何故かそこで黙る冬夏。","冬夏不知为何突然沉默。"],["「……ん、ごめん。[l]\nなんかごめん」","「……嗯，抱歉。[l]\n总觉得该道歉」"],["「え？[l]\n何に？[l]\n年寄り臭いのは認めてるし別に問題はないす」","「诶？[l]\n为什么道歉？[l]\n我承认自己老气横秋但没什么问题啊」"],["「いい。[l]\nそういうとこ含めてさ、\nなんかね。まだちょっと混乱してるね私。[l]\n抑えが効かない感じ」","「不是。[l]\n包括这种地方在内，\n该怎么说呢。我还是有点混乱。[l]\n感觉控制不住情绪」"],["「あ、ああそうすか。[l]\nまあゆっくりお食べなさい。[l]\n遅刻しない程度に」","「啊、啊啊这样啊。[l]\n那你慢慢吃。[l]\n别迟到就行」"],["やっぱ意識してない訳では……ないんだな。[l]\nただ僕も、\n──こういう反応しかできないけど……","果然不是没有意识到……的吧。[l]\n只是我也，\n──虽然只能做出这种反应……"],["「うん……[l]\n真言さん、\n今社会人なんだよね？」","「嗯……[l]\n真言先生，\n现在是社会人士了对吧？」"],["「え、ああ、そう……だよ。[l]\n大学は辞めましたので！」","「诶、啊、是……这样。[l]\n大学已经退学了！」"],["「私も一緒に仕事したい。[l]\n……此処には居たくないよ。","「我也想和你一起工作。[l]\n……不想待在这里。"],["卒業したら、………[l]\n──まことさんと一緒がいい。[l]\n何でもするから。","毕业后，………[l]\n──想和真先生在一起。[l]\n我什么都愿意做。"],["宮さまが上司なら私も大丈夫そうだし。[l]\n必要なら勉強もする、資格も取る」","如果宫大人是上司的话我好像也能适应。[l]\n有必要的话我会学习，也会考取资格」"],["う、","呜、"],["夕べの件が無ければ、\n単なるいつもの","如果没有昨晚那件事，\n本可以当作"],["揶いの類と思えるのだが、\n今やどこまで本気なのか、","平常的玩笑话的，\n但现在完全分不清有几分认真，"],["「まじです。この上なく本気」","「是真的。再认真不过了」"],["……言い方のノリに何かギャップを感じるが、[l]\n照れ隠しだろうかなあ。","……说话方式总感觉有些违和，[l]\n大概是在掩饰害羞吧。"],["「……な、なるほど。[l]\nそうは言っても、\nそもそも僕等の仕事ってのは……","「……原、原来如此。[l]\n不过话说回来，\n我们的工作本来就是……"],["ややや、\nそれよりも、ほらこの家出だっていつまでも──」","哎呀呀，\n比起那个，你看这次离家出走总不能一直──」"],["思い出した。[l]\nそうだ。","想起来了。[l]\n对了。"],["これ幸いにと話題転換を試みる。","趁机尝试转换话题。"],["「ああ、そう言えば、\n道具さんって人、知ってる……んだよね？[l]\nその人から、","「啊、说起来，\n道具小姐这个人，你认识……的吧？[l]\n从她那里，"],["言","有"],["伝が」","有口信」"],["「道具さん？トモさんから？」","「道具小姐？从智小姐那里？」"],["実際は『独り言を聞いてました』、と言う建前だが、\nここでそれを言っても詮無いというかややこしいだけなので、\n素直に伝える事にした。","实际上只是『听到了自言自语』的托词，\n但在这里说明既无意义又会把事情复杂化，\n所以决定老实传达。"],["何で僕と彼女が知り合いになってるのかという点については、\n幸いにも冬夏はスルーしてくれたので、\n嘘吐いたりとか面倒な事はせずに済んだ。","至于为何我和她会相识这点，\n幸好冬夏没有追问，\n省去了编造谎言的麻烦。"],["それとも知らない内に説明してたんだったか？[l]\n……それこそ思い出せないが、[l]\n思い出した所で詮無い事なので早々にその道は放棄します。","还是说其实之前已经解释过了？[l]\n……这点实在想不起来，[l]\n反正想起来也无济于事，干脆放弃思考。"],["「ええと、\n早く帰って安心させなさいって、\n事が大きくなると狩屋と姫様ちゃんが──」","「那个，\n说让你早点回去好让人放心，\n事情闹大的话狩屋和姫様酱会──」"],["と言った所で、","话未说完，"],["冬夏の表情が一気に険悪になった。[l]\n場の空気が一瞬凍り付く──","冬夏的表情骤然阴沉。[l]\n空气瞬间凝固──"],["「ん。[l]\nまあ、その件は、まあ。[l]\nこちらの問題」","「嗯。[l]\n嘛，那件事，怎么说。[l]\n是我们这边的问题」"],["ま、まあ、前にキライって明言してたし、\nあの二人がそういう役割というのも既知の事実なんだろうから、\n別段不思議ではないか……[l]\nそれとも単に、この家出を咎められたからかも。","嘛、嘛，之前确实明确说过讨厌，\n那两人扮演这种角色也是众所周知的事实，\n倒也不算特别奇怪……[l]\n又或者单纯是因为离家出走被责备了。"],["しかし、\n","不过，\n"],["白","白"],["地に機嫌は悪くなったのは確かだ。[l]\n眼は据わってしまいこちらを向いてもくれない。","心情明显变差是事实。[l]\n眼神发直都不愿看向这边。"],["と言うより、\nそんな顔を視られたくない、\nといった風情だけど、あくまで僕の主観であるから……","或者说，\n不想被看到这副表情，\n大概是这样的感觉，不过终究只是我的主观判断……"],["おっと、まだ道具さんの言葉があったのだった。","哎呀、还有道具小姐的话没转达呢。"],["「あ、ああそれともう一つ、\nきぃが体調崩してるから、\nお見舞いに是非来てくれれば同道するとか……","「啊、啊啊还有就是、\n小贵身体不舒服、\n说要是去探病的话务必一起同行……"],["ちなみに僕は駄目だってさ。[l]\n理由は深く追求しなかったけど、\nまあ色んな事情があると察して遠慮する事にしたので、\nもし行くんだったら僕の分も──」","顺便说我不行来着。[l]\n虽然没深究理由、\n不过想着她肯定有各种难处就婉拒了、\n要是你去的话替我那份也──」"],["そこで何かを振り切るようにというか、","话没说完就被干脆打断、"],["宮さんが僕を嬲る時と同じ眼でこちらを視詰めると、","她用和宫小姐捉弄我时同样的眼神瞪过来、"],["「あはは。[l]\nそっか、きぃのお見舞いね。[l]\nそっちはまあ……考えても良いかな。","「啊哈哈。[l]\n这样啊、是去探望小贵呢。[l]\n这个嘛……倒是可以考虑。"],["連絡しづらいっていうか、\n実はもう繋がらなくなってたから心配だったんだ。[l]\nあのこの場合、止められてる場合があるからさ。[l]\n真言さんの分も宜しく伝えとくー」","与其说是联系不上、\n其实已经彻底失联了所以很担心。[l]\n那孩子这种情况、可能是被禁止接触了。[l]\n真言先生那份也麻烦转达啦ー」"],["「ああ、たのんます。[l]\nあれだ、差し入れ、\n代金渡すから適当に買って持ってってくれる？」","「啊啊、拜托了。[l]\n对了、慰问品、\n把钱给你随便买点带过去行吗？」"],["体調不良とは言え、\nいや、だからこそ大量に喰うかも知れんしな……","虽说身体不适、\n不、正因如此可能会暴食也说不定……"],["「ん。わかったー。[l]\nでも帰ってから実費請求しまーす」","「嗯。知道啦ー。[l]\n不过回来后会实报实销哦ー」"],["「そう？[l]\nまあ今日の内に行くのかどうかは知らんけど、\nそだな、アンパンと牛乳でも買ってってやってよ。[l]\nんでは気をつけて──」","「是吗？[l]\n虽然不知道你今天去不去得成、\n那啥、买点豆沙包和牛奶带过去吧。[l]\n那就路上小心──」"],["道具さんに宜しく、と言おうとして一応止めておく。[l]\n折角の詳細追求スルー状態、\n藪蛇になってもしょうがないし……","本想说道具小姐多保重、还是及时刹住了。[l]\n难得她主动跳过细节追问、\n要是节外生枝就得不偿失……"],["「じゃトモさんに電話しとこ。[l]\nん？[l]\nうん、今日中に行ければと思って。[l]\nだから帰りちょっと遅くなるかもねー」","「那我给友小姐打个电话。[l]\n嗯？[l]\n唔、想着今天之内能去成。[l]\n所以回来可能会晚点ー」"],["「何かあったら連絡くれれば、\n可能な範囲で対応するからそうしてよ。[l]\nじゃあそろそろ学……」","「有事就联系我、\n能力范围内会帮忙的。[l]\n那我差不多该去学……」"],["校へ、と言おうとすると、\n冬夏が視る間にニヤけ出し、","校字还没出口、\n冬夏突然露出促狭的笑容、"],["「ん、ありがとー。[l]\nあははっ」","「嗯、谢啦ー。[l]\n啊哈哈」"],["なに？[l]\n何の笑いですか？","干嘛？[l]\n这笑是什么意思？"],["「ごちそうさまでした。[l]\nあっ、もう時間やば！」","「多谢款待。[l]\n啊、时间要来不及了！」"],["「え？[l]\nそんな焦る程？[l]\nああ、準備が」","「诶？[l]\n至于这么急？[l]\n啊、准备工作」"],["「そ、色々あるのです。[l]\nほんとは見送りまでして欲しいけど、\n我慢するからね。[l]\nと言うわけでここで」","「因、因为有很多事嘛。[l]\n虽然很想让你送到最后、\n我会忍耐的。[l]\n那就到此为止」"],["「あいあい分かりました。[l]\n月並みな挨拶で申し訳ないけど、\n気をつけていってらっさい」","「好嘞好嘞明白啦。[l]\n虽然客套话很老套、\n路上小心早去早回」"],["「はーい」","「好～」"],["席を立つも、\n何故か考え込むように止まる冬夏。[l]\nなぞした？","刚要起身、\n冬夏却莫名陷入沉思般停住。[l]\n谜语人？"],["「………んー、[l]\nやっぱりフェアに行かないとね、\n宮さまに宜しくっ！[l]\nじゃ、行ってきまーす」","「………嗯ー、[l]\n果然还是得去庙会呢、\n替我向宫大人问好！[l]\n那、我出发啦ー」"],["「は？[l]\nあ、ああ冬夏」","「啊？[l]\n啊、啊啊冬夏」"],["「えぁっ、な、なに？」","「诶诶、怎、怎么了？」"],["「食器はセルフで片すシステムだから、\n僕がやっとくよ、学校遅れないようになさい！」","「餐具要自己收拾的，\n我来弄吧，你别迟到啦！」"],["「あっあっ、\nあうー、\nありがとー。[l]\nじゃまたね」","「啊、啊，\n呜——，\n谢谢啦。[l]\n回头见」"],["そして彼女は学校へ行き、\n昨日からのドタバタに","于是她前往学校，\n从昨天开始的忙乱"],["漸く、\n一段落がついたのだった。","终于，\n告一段落。"],["念のため","为防万一"],["視","视"],["回したが、\n宮さんもチノ嬢も、今朝は現れなかった。","去转了一圈，\n但宫小姐和千乃小姐今早都没出现。"],["……ふーん、あ、そうですか……","……哼嗯，啊，这样啊……"],["今日も好い天気だ。","今天也是好天气。"],["冬夏を視送った後で部屋に戻ると、\n食後も食後、血が胃に行きまくりですっかり眠くなってしまった。[l]\n夕べは寝床が変わったしなあ。","目送冬夏后回到房间，\n饭后血液全往胃部涌，困得不行。[l]\n毕竟昨晚换了睡觉的地方嘛。"],["如何に旅行慣れしてようと、\n今の部屋が２週間そこらしか滞在してなかろうと、\n……否、そうじゃないか。[l]\nあの状態では眠りも浅くなろうものだっての。","就算再怎么习惯旅行，\n现在这房间才住了两周左右，\n……不、或许不是这样。[l]\n那种状态下睡眠肯定会变浅吧。"],["そう、","没错，"],["昨夜のコクハクは、","昨晚的告白，"],["何というか、","该怎么说，"],["あまりに突飛ではあったけど、\n出逢ってからの距離感が、既に変に近すぎてたというか、\nいや、太腿との密着から始まったからという訳でも……","虽然太过突兀，\n但相遇以来的距离感本就近得反常，\n不、倒也不是因为从大腿贴贴开始的缘故……"],["た、多少はあるかもだが、\nその、兎に角、\nああ、うん、と妙に納得してる部分とか、\n変に冷静に対処してる部分とか、","虽、或许也有点关系，\n那个、总之，\n啊、嗯、有种莫名释然的部分，\n异常冷静应对的部分，"],["それもあるんだけど、\n……なんかブレーキが掛かる。","这些也确实存在，\n……但总觉得踩了刹车。"],["そこは、まあ、宮さんの所為だと思うけど……[l]\n変に警戒心強くなってるというか？[l]\nべ、別にあのひとに遠慮してる訳ではない筈だ！","这方面嘛、大概是宫小姐的缘故……[l]\n该说是警惕心莫名变强了？[l]\n才、才不是顾虑那个人呢！"],["大体あのひとぁ、","说到底那个人啊，"],["………。",""],["「そこで何で思い淀む？[l]\n……おもいよどむ？[l]\nそんな言葉あったっけかな……」","「为什么要在那儿犹豫？[l]\n……犹豫？[l]\n有这个词来着吗……」"],["えー、","呃——，"],["……何考えてたっけ？","……刚才在想什么来着？"],["「まあいいや、\n取り敢えず……今日は休めって話だし、[l]\n寝直そうかなあ。[l]\n脳も盛大に空転してるし……」","「算了无所谓，\n反正……今天说是休息日，[l]\n再睡个回笼觉吧。[l]\n脑子也空转得厉害……」"],["うーん、でも掃除の人とか来ちゃうかな。","唔——不过清洁工可能会来吧。"],["とか考えながら、\n座布団を枕に、目を","一边这么想着，\n把坐垫当枕头，"],["瞑りつつ思索に","闭眼陷入"],["耽る。","沉思。"],["そうだなあ……","是啊……"],["冬夏との記憶がもし想像通り……、[l]\nそうだ、\nどうにも最近、夢やら何やら、\n白昼夢的に漏れ出てくるかのようなあの情景、","如果和冬夏的记忆如想象般……，[l]\n对了，\n最近总有些梦境什么的，\n像白日梦般浮现的情景，"],["あの場に居た……のは誰だ？","当时在场的……是谁来着？」"],["あと宮さん……実年齢がもし……だとすれば、[l]\nあながち無い話でもないけれど、\n希望的観測、というより願望としては、\nそれはなしであって欲しいけどなあ。","还有宫小姐……实际年龄要是……的话，[l]\n倒也并非完全不可能，\n与其说是乐观推测，不如说是愿望的话，\n还是希望别是这样啊。"],["「いかん、何か気になる、が、同時にわけわからん」","「不行，总觉得在意，但同时又莫名其妙」"],["仕事も折良く休みを言い渡されてるし、\nちょっと出かけて色々視回ってみるか。","正好工作也被放了假，\n出门去各处转转吧。"],["わけわからんは訳分からんなりに、\nついでに何かその、\n訳が分かればそれはそれで宮さんへの手土産になるもの、\nかも知れないし、","莫名其妙就按莫名其妙的方式，\n顺便找找那个，\n要是能搞明白说不定能当给宫小姐的手信，\n也许吧，"],["がたがたがたがたがたがたがたがた！","嘎嗒嘎嗒嘎嗒嘎嗒嘎嗒嘎嗒嘎嗒！"],["「おわ！！」","「哇啊！！」"],["テーブルに置いてた携帯電話が派手に振動して大変驚いた。","桌上手机突然剧烈震动吓死人了。"],["電話？[l]\n誰？","电话？[l]\n谁？"],["また道具さん……じゃないな。[l]\nこれは──","又是道具小姐……不对。[l]\n这是──"],["「狩屋じゃんよ。[l]\n何で？」","「这不是狩屋嘛。[l]\n为啥？」"],["祭の件に関して伝言でも頼まれたか？","是祭典的事要传话吗？"],["「あい」","「喂」"],["「あの」","「那个」"],["「あああ、あれ？[l]\n姫様ちゃん？[l]\nどどどどどうなさった？」","「啊啊啊，咦？[l]\n姫様酱？[l]\n发发发发生什么事了？」"],["「おはようございます」","「早上好」"],["「お、はようございぁす……[l]\nな、なんでございましょうか」","「早、早上好……[l]\n请、请问有何贵干」"],["狩屋と勘違いした反動か、無意味に敬語で","可能是误认狩屋的反作用，我莫名用起敬语"],["畏まる僕。","正襟危坐。"],["「夕べは話し中でしたので。[l]\n御陰でまんじりともせず朝を迎えてしまいました」","「昨晚占线了。[l]\n托您的福睁眼到天亮呢」"],["「え？[l]\nあ。[l]\nああ、道具さんから電話来てた時かな……[l]\nご、ごめん、結構かけ直したのかな……？[l]\nあれ？[l]\nそんなに長話してたっけかなあ……」","「诶？[l]\n啊。[l]\n啊，是道具小姐来电话的时候吧……[l]\n对、对不起，该不会打了好几次吧……？[l]\n咦？[l]\n有聊那么久吗……」"],["「ごめんなさい、冗句です。[l]\n一度話し中を確認してからは昨日は疲れもありましたので、\nやることやってからしっかりと寝ました」","「抱歉，开玩笑的。[l]\n确认占线后昨天实在太累，\n做完该做的事就好好睡了」"],["……冗句……[l]\nいや、それもだが、\nやることやってって、なんですか。","……玩笑……[l]\n不，那个先不说，\n该做的事是啥啊。"],["宿題？[l]\n歯磨き？[l]\nまさか……、[l]\n丑時参とか？","作业？[l]\n刷牙？[l]\n难道……，[l]\n丑时参拜之类的？"],["んなこたないか……","怎么可能啦……"],["「え……秘密……です」","「呃……秘密……哦」"],["な、何も言ってないよ僕は？！[l]\n若干間があいただけですよ？！","我、我啥都没说啊？！[l]\n只是稍微停顿了下而已？！"],["「ああそう……あははは……[l]\nと言うか、これ狩屋の電話だよね？[l]\n最初驚いちゃってさ。[l]\n借りてるってこと？」","「啊这样……啊哈哈哈……[l]\n话说这是狩屋的电话吧？[l]\n刚开始吓一跳。[l]\n是借来的？」"],["「そうです。[l]\n横にいますよ」","「是的。[l]\n她就在旁边哦」"],["「なるほど、よ、よろしくお伝えください」","「这样啊，请、请代我问好」"],["て、あれ？[l]\n今はだから、もう学校行く時間でしょう。[l]\n先刻冬夏が登校したばかり……","等、咦？[l]\n现在这个点，该去上学了吧。[l]\n刚才冬夏才出门……"],["「今登校途中です」","「正在上学路上」"],["……もしかして、[l]\n冬夏に関する事だろうか。[l]\n道具さんの言葉が頭をよぎる。","……该不会、[l]\n是和冬夏有关的事吧。[l]\n道具小姐的话语掠过脑海。"],["実力行使て……？","武力解决……？"],["「夕べのうちに連絡が取れていれば今日放課後にでも、\nお話の約束をと思ったのですが、\nそういう事情だったので……","「如果昨晚能联系上的话本打算今天放学后、\n约您详谈的、\n但情况特殊所以……"],["仕方なくこのような時間に連絡してしまいました。[l]\nすみません。[l]\nでもどうしても……会えるのなら早くが良くて」","不得已才在这个时间联系您。[l]\n非常抱歉。[l]\n但无论如何……要见面的话还是越快越好」"],["ああー……、[l]\nあの話か。","啊——……、[l]\n是说那件事啊。"],["あの時は違うと思ったけども、\n昨夜の冬夏の事を考えると、どうにもその、\nまさかそっち方面のじゃないだろうな？[l]\nという疑念が再燃……","当时还觉得是误会、\n可联想到昨晚冬夏的状况、\n该不会真是那种方向的发展吧？[l]\n这样的疑虑再次浮现……"],["道具さんが昨日、\n","毕竟道具小姐昨天、\n"],["矢","矢"],["鱈と彼女達と契るのがどうとかいう話題振ってきてたし、よもや本気で──","鳕和她们缔结契约之类的话题都提出来了、该不会当真——"],["いやいや、それこそそんな……","不不、那种事怎么可能……"],["……うーん。","……唔嗯。"],["冬夏と姫様ちゃん、と……まあ狩屋が、[l]\nどんな対立構造になるかなぞ、恐ろしくて想像したくない。","冬夏和姫様酱、再加上狩屋的话、[l]\n会形成怎样的对立局面、光想象就让人毛骨悚然。"],["万が一の時は狩屋にヘルプ頼むか……[l]\nそれもどうだろうなあ、\nうん、単なる僕の自意識過剰である事を祈ろう。[l]\nそれで済むならなんぼでも妄想したる！","万一的话就向狩屋求助吧……[l]\n不过那样也不太妙、\n嗯、但愿只是我自我意识过剩。[l]\n要是这样就再好不过了！"],["ともあれ情報収集に重きを置いて、\nまずは実際話してみないことにはどうにもならない。","总之重点在于收集情报、\n不实际谈谈的话终究无济于事。"],["幸か不幸か、\n今日の放課後は冬夏もきぃの見舞いに行くかも知れないし、\n会うならこのタイミング、という気はするが……","幸运或不幸的是、\n今天放学后冬夏可能要去探望小贵、\n要见面的话这个时机正合适……"],["冬夏とバッティングすると色んな意味でややこしくなりそうだしなあ。[l]\n……なんかそういう事ばっかり考えてると、[l]\nほんとに二股企んでる気分になってくるけど断じて違います。","但和冬夏撞上的话各方面都会很麻烦啊。[l]\n……老想着这种事、[l]\n简直像在策划脚踏两条船似的但绝对没有！"],["ただ昨日の今日なので、\n若干思考がそっち方向に流されやすくなってるだけですよ？","只是昨天刚发生过那种事、\n思维难免会往那个方向飘而已？"],["あー、まあ、\n実際はそれどころじゃない企みをしてる訳だが、\nそれもこれも宮さんが、あのひとさえ──","啊——不过、\n实际上正在谋划比那更重要的事、\n说到底都是因为宫小姐、只要那个人——"],["「…さん。[l]\n真言さん。[l]\n電話切れました？」","「…先生。[l]\n真言先生。[l]\n电话断线了吗？」"],["「──っといや、ごめん大丈夫。[l]\nええとじゃあこちらは今日の放課後でも大丈夫だけど……[l]\n半ドンだよね今日？」","「——啊不是、抱歉没事。[l]\n那个我们今天放学后也没问题……[l]\n今天是半休制吧？」"],["「はんどん……？」","「半休……？」"],["あれ、姫様ちゃんは知らないか。[l]\nやっぱ冬夏がアナクロ気味なんだな。","哎呀、姫様酱不知道吗。[l]\n果然冬夏有点复古呢。"],["「あ、ごめん、学校が午前で終わるって事。[l]\n昼過ぎくらいからなら、そんなに遅くならずに用事も済むだろうし……」","「啊抱歉、是指学校上午就放学。[l]\n午后开始的话、应该不会太晚就能办完事……」"],["「……早めに終わらせたいですか。[l]\nあんまり一緒には居られないと──」","「……想尽早结束吗。[l]\n是不愿和我待太久——」"],["「え？[l]\nあ、いや、","「诶？[l]\n啊不是、"],["そんな深刻に受け取られてもその、\n単に一般論と言いますか、\n女子と男子が遅くまでうろうろしてますと色々と問題が」","被这么严肃理解的话那个、\n只是普遍来说、\n男女学生在外逗留太晚会引起各种问题」"],["「……半分冗句ですから気に病まないでください。[l]\nでは場所なんですけれど」","「……半开玩笑的请别在意。[l]\n那么关于地点」"],["………。[l]\n姫様ちゃんてこんな","………。[l]\n姫様酱原来"],["娘だっけ？[l]\nうぅ、そ、そう言えばそうだったような……","是这样的女孩吗？[l]\n呜、说起来好像确实……"],["「あの、先日の場所覚えてますでしょうか」","「那个、您还记得前些天那个地方吗」"],["「昨日の……あの山の中？[l]\n斎場みたいな？」","「昨天的……那座山里？[l]\n像是殡仪馆的地方？」"],["それって車ないと行けないだろうし、\n何より危険じゃないか？","那种地方没车根本去不了吧，\n更重要的是不是很危险吗？」"],["しかし","然而"],["其","其"],["処だと言う。","她却说是老地方。"],["「大丈夫です。[l]\n車は克杖の家から借りられますし……[l]\n私達が揃っていれば危険はありません」","「没问题的。[l]\n车可以从克杖家借到……[l]\n只要我们人齐就不会有危险」"],["き、きーちゃぁ！？","小、小姬！？"],["という声が電話先から聞こえた。[l]\n聞いてなかった話のようだな……","电话那头传来这样的喊声。[l]\n看来是没听说过的安排呢……"],["「そ、そうは言われても……[l]\nあれ、そういえば二人きりでって話だったような」","「可、可是就算你这么说……[l]\n啊咧、说起来好像是说要两个人单独去的」"],["待てよ、だったらわざわざ狩屋の居る横で話す事はないよな。[l]\nつまり……","等等、那就不必特意在狩屋在场的地方说这事了吧。[l]\n也就是说……"],["「あ……[l]\nすみません、\nあの、この","「啊……[l]\n不好意思，\n那个、这个"],["娘も同道させて頂けません……でしょうか」","能让这姑娘也一起同行吗……可以吗」"],["そうなる……よねえ。","果然会变成这样……呢。"],["「えーとそれはまあ、姫様ちゃんからのお誘いだった訳だし、\n姫様ちゃんさえ良ければ……あとはその狩屋本人が構わなければ[l]\nこっちは多分……」","「呃那个嘛、既然是姫様发出的邀请，\n只要姫様没意见……再加上狩屋本人不介意的话[l]\n我们这边大概……」"],["「克杖」","「克杖」"],["うにっ！？[l]\nにゃんというかその……はい……いきます……","呜咦！？[l]\n喵呜或者说那个……好的……我去……"],["というまあ、\nいつもの感じで彼奴の声がうっすら聞こえてきた。","就这样，\n隐约传来那家伙一如既往的声线。"],["「………」",""],["「こちらは問題ありません」","「我们这边没问题」"],["「だ、だいじょうぶ？[l]\n無理せず都合の良い時に──」","「真、真的不要紧吗？[l]\n不用勉强挑你方便的时候──」"],["「………あ」","「………啊」"],["「……？」",""],["「すみません、\n確定までもう少しだけお待ちください。","「抱歉，\n最终确认前请再稍等片刻。"],["また連絡します。[l]\n今日中に電話します。[l]\nごめんなさい。[l]\nでは」","我会再联系。[l]\n今天之内会打电话。[l]\n对不起。[l]\n先这样」"],["は？きーち、","哈？小贵，"],["まで聞こえていたが、","还能听到这么半句，"],["「へ？[l]\nあ」","「诶？[l]\n啊」"],["……切れた。","……挂断了。"],["なんじゃったんじゃい？？？","这算哪门子事啊？？？"],["ふと待ち受け画面になった携帯電話を視ると、\n今の時刻が……","瞥了眼恢复待机画面的手机，\n现在的时间……"],["ああ、遅刻しそうだったのかな。","啊、可能是快迟到了吧。"],["僕の記憶が確かなら、\nそろそろ学校始まる時間だったと思う。","如果我没记错的话，\n学校差不多该上课了。"],["確か授業中は携帯電話、先生に預けてて繋がらないとか、\nきぃも言ってたような気がするし、\nいずれ暫くの間は繋がらないだろう。","记得上课时手机要交给老师保管所以打不通，\n小贵好像也这么说过，\n总之暂时是联系不上了。"],["向こうから連絡寄越すって言ってたし、\n予定通り今日は海岸うろついてみようかねえ……","既然对方说了会再联系，\n今天就按原计划去海边逛逛吧……"],["きぃも何でもなきゃいいが。[l]\n……色んな意味で──","但愿小贵别出什么事。[l]\n……各种意义上──"]],"context":[["SC_M_037.ks/index/1/text"],["SC_M_037.ks/index/3/text"],["SC_M_037.ks/index/5/text"],["SC_M_037.ks/index/7/text"],["SC_M_037.ks/index/9/text"],["SC_M_037.ks/index/11/text"],["SC_M_037.ks/index/13/text"],["SC_M_037.ks/index/15/text"],["SC_M_037.ks/index/17/text"],["SC_M_037.ks/index/19/text"],["SC_M_037.