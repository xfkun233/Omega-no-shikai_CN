":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"t":"HU","v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"t":"HU","v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1}],null,[null,{"t":"HU"}],null,[null,{"t":"HU","v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"t":"HU"}],[null,{"v":1}],null,null,null,null,[null,{"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[672,0],"note":"完成"},"/data/scenario/SC_M_027.ks":{"data":[["「わかってるよ、彼の事は任せ給え。[l]\n二人とも","「我明白，他就交给我吧。[l]\n你们两个也"],["呉","务"],["呉も自重自愛し給えよ。[l]\nさ、少年、後部座席に移って身を伏せるのだ」","必多加小心。[l]\n来少年，移到后座趴下身子」"],["そう言って道具さんが僕の肩を叩いた御陰で、\n","多亏道具小姐拍肩提醒，\n"],["漸く我に返った。","我才终于回过神。"],["「え？[l]\nだって二人は」","「诶？[l]\n但她们两个」"],["確かに僕は腕力に自信のない非体育系男子だが、\n幾ら何でも女子高生二人にそんな危険な事をさせて\n自分は安全地帯に留まるというのは……","虽然我确实是不擅长运动的文弱男生，\n让两个女高中生去冒险\n自己躲在安全地带也太......"],["「よ、様子を見に行くなら僕も行きますよっ！」","「要、要去查探的话我也一起！」"],["じゃないと僕が今日呼ばれた意味が無いであろう。","不然我今天被叫来的意义何在。"],["「駄目」","「不行」"],["「それは駄目にゃ！」","「绝对不行喵！」"],["二人が同時に僕に対し拒否の言を発した。[l]\n戸惑う僕に道具さんが言う。","两人同时对我发出禁令。[l]\n道具小姐对困惑的我解释道："],["「大丈夫だよ。[l]\n彼女達の事は聞いてないのかね？」","「没关系的。[l]\n你没听说过她们的事迹吗？」"],["「は？」","「哈？」"],["「まあ何にせよ、\n君に何かあった時の方が問題なのだ。[l]\n心配は要らない、万が一の時は僕も加勢するさ。","「总之，\n你出事才是大问题。[l]\n别担心，万一有状况我也会支援。"],["大したことはないと思うが――\n重ねて言うが克杖くん、姫様くん、深追いはするなよ。[l]\nご覧の通り彼が心配するからね」","虽然我觉得不会有什么大事――\n再强调一遍克杖、姫様，不要深入。[l]\n毕竟这位小哥会担心呢」"],["「解ってる。[l]\n確認するだけ。[l]\n――キンキュウだししょうがないです」","「知道啦。[l]\n只是确认下。[l]\n――因为是紧急状况没办法嘛」"],["「積極的な害意があるにゃら、\nとっくに何かしてきてるにゃろうしな」","「要真有主动加害的意思，\n早就该动手了喵」"],["「ィカリを忘れずに」","「别忘了警戒」"],["「え？[l]\nあ？」","「咦？[l]\n啊？」"],["怒り？","愤怒？"],["「ああ、少年は気にしなくて結構。[l]\nこう視えて彼女達はこの土地の者だよ。[l]\n信頼してあげてくれ給え」","「啊，少年不必在意。[l]\n别看这样她们可是本地人。[l]\n请给予她们信任吧」"],["「え、慣れてるからとかそういう話とは何か違う気が……」","「咦，总觉得和‘因为习惯了’之类的说法不太一样……」"],["いや、","不、"],["先","从刚"],["刻からの彼女等の応対を視る限り、\n確かに手慣れた感じと言うか、決して初めてじゃないのであろうが、\n……それはそれで不可解な事だけども、","才开始观察她们的应对方式来看，\n确实有种驾轻就熟的感觉，应该绝非初次经历，\n……但即便如此仍令人费解，"],["「彼女達はその為に居るからね」","「她们正是为此而存在的」"],["「？[l]\nそれは、」","「？[l]\n那是，」"],["「さっさとうごけ、ばか」","「赶紧动起来，白痴」"],["既に車外に出ていた狩屋が、運転席のドアを開けて僕を引き出した。[l]\nそして道具さんと僕を後部座席に押し込み、","早已下车狩屋拉开驾驶座车门将我拽出。[l]\n随后把道具小姐和我塞进后座，"],["「（ぜったいに、\nこっちみんにゃよ！！[l]\nアタマ下げてろ！！！）」","「（绝对、\n不准往这边看！！[l]\n给老子低头！！！）」"],["窓に顔を押し付けて、狩屋が『小声で怒鳴った』。","狩屋把脸压在车窗上『小声地怒吼』。"],["二人は足早に木立の中に去っていった――らしい。[l]\nがさがさと音が遠ざかっていく。","两人快步消失在树丛中――应该是这样。[l]\n沙沙声逐渐远去。"],["仕方がないので、足場の部分にしゃがみ込み、\n上半身はシートに向かって伏せるような体勢を取る。","无奈之下，我蜷缩在脚踏处，\n上半身以近乎趴伏的姿势贴向座椅。"],["まるで避難訓練のようで、\nこう、\n据わりの悪い気持ちだ。","简直像防灾演练，\n这种，\n如坐针毡的感觉。"],["勿論女子二人に任せっきりで自分がこうしている事への\n後ろめたさがそうさせてる一因でもあるのだろうが……","当然把任务全丢给两位女性自己却这副模样\n这种愧疚感也是原因之一吧……"],["そして再び静寂が訪れた。","寂静再度降临。"],["すると、道具さんが小声で話し出す。","这时道具小姐小声开口："],["「（僕は現場担当じゃないんだよ。[l]\nあくまで後方支援、補助や補佐、便利屋のようなものだ。[l]\n僕一人では単なる器用貧乏と言い換えても良い）」","「（我不是现场执行人员。[l]\n说到底只是后方支援，做辅助打杂的活儿。[l]\n单干的话说得好听点也就是个样样通样样松）」"],["「（現場って何の話、）」","「（现场是指什么情况，）」"],["「（………）」","「（………）」"],["だんまりを決め込んだのか、返事はなかった。[l]\n単に状況がそうさせたのかも知れないが、","她可能打定主意沉默，没有回应。[l]\n或许只是形势所迫，"],["「（………？！）」","「（………？！）」"],["数分、否、数秒後の事だった、","几分钟后，不，是几秒后，"],["刻のとも違う、\n蔵の中で聞いたのとも違う、\nどちらかと言えばあの、\n式の最中にきこえた脳に直接響くような、","与刻不同的，\n也不同于在仓库听到的，\n更接近那种——\n仪式中途直接在大脑回响的，"],["おぁああああああああああああああああああん","呜啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊"],["オトがきこえた――","声音传来了――"],["すると、やはり、\n首が、熱くて、\nまた、\n止まる、","紧接着果然，\n脖子开始发烫，\n又来了，\n停止，"],["意志とは無関係に、[l]\n身体が、[l]\n意志を離れる。","无关意志，[l]\n身体，[l]\n脱离掌控。"],["耳も聞こえるし呼吸もしてる、が、\n自由にならない。","能听见也能呼吸，但，\n无法自由活动。"],["うお、これ、は――","呜恶，这是――"],["「っぇあ、\nあれ？」","「咳呃，\n咦？」"],["彼の時とは違い、音が止むと僕の身体はものの数秒で平常に戻った。[l]\nな、なんだったんだ？","与他那时不同，声音停止后我的身体数秒内就恢复正常。[l]\n刚、刚才那是啥？"],["「どうかしたかね？」","「出什么事了吗？」"],["「あいえ、何でもないです……」","「没、没什么……」"],["とは言え、状況が好転した訳ではない。[l]\n緊迫したまま無言の時間が過ぎていく。","话虽如此，状况并未好转。[l]\n紧绷的沉默持续蔓延。"],["先刻道具さんは、\n恐らく大きな生物で、\n獣の類だと言った。","先前道具小姐说过，\n大概是大型生物，\n属于野兽那类。"],["その推論が正しいのなら、\n導き出されるものは、\n熊、狐狸、猿、精々が大きめの野良犬といったところだろう。","如果这个推论正确的话，\n能推导出的结果，\n无非就是熊、狐狸、猴子，顶多是体型较大的野狗之类的吧。"],["真","至于"],["逆ヒトという可能性は、[l]\n……何とも言えない。","完全不是人的可能性，[l]\n……实在不好说。"],["況してや彼女達の眷属をころした何者かが\n居るのであろう状況下では、\nＵＭＡを想定するよりは余程現実的かも知れない。","更何况在她们的家属被某人杀害的\n情况下，\n比起设想成UMA，说不定更接近现实。"],["しかし、だとすると、\n彼女達はその為に居る――とはどういう事だ？","不过要是这样的话，\n她们为此存在――这又是什么意思？"],["こういう状況はよくあることで、\nそれに対する備えは常にしてある、\nと、\n平たく受け取ればそういう事なんだろうが、","虽然可以简单理解为\n这种状况很常见，\n所以平时就做好了应对准备，\n但这次的情况——"],["この場合は――幾ら何でもヒト相手ではないだろうと思うけど――\n危険野生動物への対処？[l]\nやや北方とはいえ、確かに動物は居るのだろうけども、","再怎么想也不该是人类所为吧——\n是要对付危险野生动物吗？[l]\n虽说偏北方地带确实可能有动物，"],["狩猟をするにしたって、猟銃も何もないじゃないか。[l]\nそもそも所持の許可が……","但就算要狩猎，连猎枪都没有啊。[l]\n说到底持有许可也……"],["「怖いかね？」","「害怕吗？」"],["突然、道具さんが訊いてきた。","道具突然问道。"],["「はい？[l]\nあ、いえ大丈夫ですが……[l]\n緊張はしてますけど」","「诶？[l]\n啊、不没事的……[l]\n就是有点紧张」"],["「恐怖とは何だと思う？」","「你觉得恐惧是什么？」"],["「過剰な想像力から来る不安だよ。[l]\n全てではないだろうがね。","「是过剩想象力带来的不安。[l]\n虽然不能一概而论。"],["だが、想像力が無ければ不安というものに\n","但反过来说，没有想象力就不会\n"],["苛まれることはないという意味で、\n或る意味で説明にはなると理解頂けるだろうか。","被不安折磨——\n这样解释你能理解吗？」"],["想像力豊かな人間というのは、\n常に諸刃の剣を振るっているに等しい。[l]\nここで言うのは生命の危機に際して感じる自衛本能とは\n少々違うのだが」","想象力丰富的人，\n无异于时刻挥舞着双刃剑。[l]\n这和面临生命危险时的自卫本能\n略有不同」"],["その話はどこかで聞いたことが……[l]\nある気がするが、\nそれが今何の関係が。","这话好像在哪里听过……[l]\n但和现在\n有什么关系？」"],["「想像力という資質を必要とするある種の人間は、\n常に大量の恐怖と戦わねばならないという代償を払っている。[l]\n勿論巧く添い遂げる才能を有する者も居るがね。[l]\nいずれ","「某些需要想象力这种天赋的人，\n必须永远与大量恐惧战斗作为代价。[l]\n当然也有擅长驾驭这种天赋的家伙。[l]\n终究"],["鼬ごっこではあるんだが、」","不过是场追逐游戏，」"],["そこで道具さんはこちらの顔色を","道具说着窥探"],["窺い、\nすぐ視線を外して続けた。","我的神色，\n又立刻移开视线继续道："],["「受け入れるか徹底的に排除するか、\n一生ついて回るのだろうなあ。[l]\nさもなくば","「要么全盘接受要么彻底排除，\n否则会纠缠一生吧。[l]\n除非"],["己が想像力を恒久的に欠く以外にないからね。[l]\nそれは『ある資質の一端』を欠くのと同義だから」","永久丧失自己的想象力。[l]\n那等同于失去『某种天赋的碎片』」"],["「え、ええと、はあ……」","「呃、那个，啊……」"],["言ってる意味は分かりますが意義が解らないんです。","字面意思我懂，但不明白重点。"],["「肉体の資質、思考構造の資質、\n分かつことは出来ないしね、\nどっちにしろ難儀なんだよ。","「肉体天赋与思维结构天赋，\n本就无法分割，\n总之都很棘手。"],["まあ煩悶があるが故に対処法としての手段を産んだ――\nいや、産む事もある。[l]\n塞翁が馬、因果の連なりは――\n後は、自分以外の思考主体と接し群れる事も割と肝要だ。","烦恼催生了应对手段――\n不，有时也会反着来。[l]\n塞翁失马，因果链条――\n另外，与其他思考主体接触也很重要。"],["自己思考のスパイラルに陥ると非常に厄介だ。[l]\nそれを避ける為の手段でもある――のかな」","陷入自我思考的螺旋会非常麻烦。[l]\n这或许也是规避手段」"],["「な……何がです？」","「什……什么手段？」"],["「例えば猫を飼うとかだ」","「比如养猫」"],["ねこ……","猫……"],["一瞬頭の隅の何処かが澄み渡るかのような、\n刹那の活性化をしたような感覚に見舞われたが、","仿佛脑海某处突然澄澈般的、\n被刹那间的活性化感觉所侵袭，"],["……恐らく最近、猫というキーワードに敏感になってるから[l]\nであろう。","……大概是因为最近对'猫'这个关键词变得敏感[l]\n的缘故吧。"],["「猫は飼い慣らすの難しいですけどね……」","「猫可是很难驯养的呢……」"],["「その通り。[l]\n犬のようにはいかないね。[l]\n飼うと言っても精々己の居住空間内にて\n餌付けするといった風情だろう。","「正是如此。[l]\n可没法像狗那样听话。[l]\n就算说饲养充其量也就是在自己居住空间里\n投喂食物这种程度吧。"],["懐く程度のことはあるだろうが、\n完全に行動を律するのは困難だろうなあ。[l]\nさせたと思い込んでる方々も居るだろうがね、\n","亲近人类的情况确实存在，\n但要完全规范其行为恐怕很难啊。[l]\n虽然也有自以为驯养成功的家伙，\n"],["遍くそういうものは勘違いだ」","普遍来说那都是错觉」"],["「ううん、まあ、聞きますねそういう話も」","「嗯嗯，嘛、这种说法倒也听过」"],["今の状況では少々乗り辛い話題であるので、\nどうにもリアクションもぎこちなくなるし。","在目前的情况下这个话题有点难以接话，\n反应也难免变得生硬。"],["仕方なく何故こんな話を……[l]\nと問うと、","无奈之下只好问为何要说这些……[l]\n这么一问，"],["「この地は猫に深い","「你知道这片土地与猫"],["縁があるのは知ってる、のだろう？[l]\n無聊の慰めになるかと思ってね。[l]\n少年なら理解出来るだろうと見込んだのだけれど」","有着深厚渊源吧？[l]\n想着或许能排遣无聊。[l]\n觉得如果是少年你应该能理解罢了」"],["と仰った。","她说道。"],["うーん……","唔……"],["実は姫様ちゃんと同類なんだろうかこの","其实和姫様是同类的吧这位"],["女","女"],["性は。[l]\n勝手に僕に対し何かを期待なさってる気配が……[l]\n猫に関しても、意識的にその話題を選んだようだが、\n――何故？","性。[l]\n总觉得您擅自对我有所期待……[l]\n就连猫的话题，似乎也是刻意选择的，\n――为什么？"],["そしてそんな雑談にかまけていられるという事は、\n余程あの二人を信頼してるという事なのだろうか。","而且还有闲心进行这种闲聊，\n说明您相当信任那两个人吧。"],["「はあ、まあ、その、\nありがとうございます。[l]\n御陰様で……うーん、分からないことはないですけど、[l]\nあはははは……」","「啊、那个、\n谢谢您。[l]\n托您的福……嗯、倒不是不能理解，[l]\n啊哈哈哈……」"],["愛想笑いでお茶を濁すほかなかった。","只能用敷衍的假笑蒙混过去。"],["「そう、笑いは","「没错，欢笑是"],["佳きものだ少年。[l]\n場を","美好的东西啊少年。[l]\n只要"],["弁えてさえいればね。[l]\nヒト以外では","懂得把握场合的话。[l]\n对人类以外"],["凡そ","大抵"],["威","都是威"],["嚇の意だがそれでよい。[l]\nそうそう例の、ニヤニヤ笑いを残して消えるのも」","吓之意但那样也无妨。[l]\n对对就是那个例子，留下阴森笑容消失的」"],["猫だね。","是猫呢。"],["「………」","「………」"],["外つ國のお話にそういうのが確かに出てくる。","外国的故事里确实会出现那种描写。"],["が、ですから、[l]\n何で猫に拘るのでしょう。[l]\n何で僕にそれを話すのでしょう。[l]\nいやその、無聊の慰めだとは言われたけどもさ……","不过所以说，[l]\n为什么执着于猫呢？[l]\n为什么要对我说这些呢？[l]\n不不，虽然说是为了排遣无聊啦……"],["僕としてはやはり姫様ちゃんと狩屋が気になるわけで、\nそんな僕の反応があまりにも鈍かった所為か、\n道具さんも駄話を続けるのを止したようだ。","我个人还是更在意姫様和狩屋的情况，\n或许是因为我的反应太过迟钝，\n道具小姐似乎也停止了闲扯。"],["「ま、お","「嘛，这种"],["為ごかしはそれ位にしておこう。","装模作样的对话就到此为止吧。"],["君が最も今知りたいであろう事柄に関しては、\nそうだね、\nそのうち厭でも知る所となろうから――\n今僕の口から説明するのは止そう。","关于你现在最想知道的事情，\n是啊，\n反正迟早会烦到不得不知道的――\n现在就不从我嘴里说出来了。"],["それが皆にとっての愉悦となるだろう」","那会成为大家的快乐吧」"],["あの、お","那个、糊"],["為ごかしって、\nどっちかというと悪意めいて言ったって事ですか。","弄什么的，\n不如说是带着恶意说的意思吗。"],["後半も意味が分からないし、\nこの現状くらいは説明してくれても罰は当たらないと\n思うのです。","后半段也看不懂什么意思，\n我觉得说明一下现状应该不会遭报应\n吧。"],["「なー、なー、なー、なー……」","「呐～呐～呐～呐～……」"],["突然鼻歌を歌い出す道具さん。[l]\n場が持たないのに耐えられなかったのか……[l]\nしかしリアクションに困る僕が更に空気を微妙にするのであった。","突然哼起歌来的道具小姐。[l]\n是因为受不了冷场吗……[l]\n但不知如何反应的我让气氛变得更加微妙了。"],["「なー、なー、なななななな」","「呐～呐～呐呐呐呐呐」"],["……。","……。"],["心配要らないという事を","是想强调"],["殊","完全"],["更強調したいのかしらん。","不需要担心吗。"],["――。","――。"],["場は決して和まず、\nどうやら僕が一方的に気まずいだけの沈黙の後、\n暫くして、\n彼女達が戻ってきた。","场面始终没有缓和，\n在显然只有我单方面感到尴尬的沉默后，\n过了一会儿，\n她们回来了。"],["かなり長い時間が経ったと思っていたが、\n時計を視ると数分だったようだ。","明明感觉过去了相当长时间，\n看表才发现只有几分钟。"],["「見失った……にゃわ」","「跟丢了……喵哇」"],["「捕捉し損ねました……[l]\n確認も出来なかった……[l]\nこっちは無事……？」","「没能捕捉到……[l]\n连确认都做不到……[l]\n你们这边没事……？」"],["「こっちは何ともなかったよ、\nそっちこそ大丈夫？」","「我们这边完全没问题，\n你们才不要紧吧？」"],["「うむ、此方は何事もない。[l]\nトウビョウは？」","「嗯，此方无碍。[l]\n投锚呢？」"],["「多分……」","「大概……」"],["「どっかに行っちゃったけど\n積極的にこっちに興味は無かったようだし\n追跡は専門家に任せるにょう」","「虽然跑去某处了\n但似乎对这边没什么兴趣\n追踪就交给专家吧喵」"],["「まあ、あまりにも急だったしね。[l]\n場の制約も多かったし気にすることはない。[l]\nキンキュウ時に深追いしても仕方ないだろうし。[l]\n身体の方は大丈夫かね？」","「毕竟事发太突然了。[l]\n场地限制也多，不必在意。[l]\n紧急时刻穷追不舍也没意义吧。[l]\n身体没大碍吗？」"],["「ばかにすんにゃよ……[l]\nこれでもカリヤの……コウケイにゃからな……」","「别小瞧人喵……[l]\n好歹也是卡利亚的……情面喵……」"],["「私は大丈夫」","「我没事」"],["何か二人とも血の気が引いてる感があるけど……[l]\n顔色なんて、漫画みたいに明確に分かるものではないから\n何とも言えない。[l]\nそれに、","总觉得两人都有些面无血色……[l]\n但脸色又不像漫画里那么明显\n不好断言。[l]\n再说了，"],["「け、警察に連絡しないんですか？[l]\nく、熊か何かだとしても色々何かその、して貰うべき事とかが……」","「那、不联系警察吗？[l]\n就、就算是熊什么的也该走个流程那个……」"],["「処置は適切に行われるよ。[l]\n少年が気にすることはない。","「善后工作会妥善处理的。[l]\n少年不必操心。"],["三春の家は今デリケートな状況だし、\n――ま、\n僕等を含め三春の家には事態に対処する特権的な手段があるからね」","三春家现在处境敏感，\n――况且，\n包括我们在内，三春家自有处理这类事的特权手段」"],["「……は、はあ」","「……哈、哈啊」"],["何か質問と回答の間にもの凄い齟齬がある気がするんですが……[l]\nしかし、\n何か不穏当な内容を言われてる気配もそこはかとなくするので\n深く突っ込むのも止した。","总觉得问题与答案之间存在着巨大偏差……[l]\n但，\n隐约感觉话题涉及危险内容\n便没再深究。"],["「まあまあ、\nここは黙って得られた安息を享受し給え。","「好了好了，\n诸位就安静享受这难得的安宁吧。"],["今はまあ、\nそうだね、\n好奇心猫を殺すと言うだろう。[l]\nこの地に於ける三春の影響力……今更知らぬ訳でもなかろうし」","现在嘛，\n对了，\n俗话说好奇心害死猫。[l]\n三春家在此地的影响力……诸位心知肚明吧」"],["「え、や、その」","「哎、不、那个」"],["「トモさん、\nその言い方はどうかとおもう……」","「道具小姐，\n这种说法不太妥当……」"],["「真言さんは怖がらなくても大丈夫」","「真言先生不用害怕」"],["や、怖がってるというか……","不、与其说是害怕……"],["「ははは、\nそんなに身構えることはないよ。[l]\n少年が思ってるようなモノではない。","「哈哈哈，\n不用这么紧张啦。[l]\n不是少年你想的那种东西。"],["姫様君が言ったように、\n君が憂慮するような事にはならないさ。","就像姫様君说的，\n不会发生让你担忧的事哦。"],["さて、と。[l]\nとは言え警戒は必要か。[l]\n","好了。[l]\n不过该警惕还是要警惕。[l]\n"],["巧","巧"],["遅は","迟"],["拙","不"],["速に如かず、で取りかかるとしようか」","如拙速，这就开始吧」"],["「う、は、はあ……」","「呜、哈、哈啊……」"],["皆で当初の乗り配置に戻る。","众人重新回到最初的乘车位置。"],["「運転大丈夫かね？」","「开车没问题吧？」"],["「僕は待ってただけですから大丈夫ですが……[l]\nほ、本当に良いんですか？[l]\n今日は止めとくとか、人を呼ぶとかしなくても良いと……」","「我只是在等着所以没关系……[l]\n真、真的可以吗？[l]\n今天不用暂停或者叫人之类的……」"],["「大丈夫です」","「没问题的」"],["狩屋は無言だったが、\n事態を憂いているからではないようだった。","狩屋虽然沉默，\n但似乎并非因为担心事态。"],["極度の疲労というか、\n脱力というか、\n『問題は解決せぬまでも事態は掌握している』が故の、\n安心から来るぐったり感の様に視える。","更像是极度疲劳，\n或者说虚脱，\n源于『虽未解决问题但已掌控局面』的\n那种安心带来的瘫软感。"],["あくまで僕の主観だから何とも言えないが……","当然这只是我的主观感受不好断言……"],["そして姫様ちゃん、\n力強く言ってくれるのは有り難いのだけれど、\n彼女の言動は何かしらに偏ってる気がしてどうにも、\n言葉通りに受け取りづらい印象に……","至于姫様酱，\n虽然很感谢她说话这么有底气，\n但她的言行总让人觉得带着某种偏执，\n很难完全照字面理解……"],["ほんと彼女には悪いんだけど。","虽然对她很抱歉。"],["「ううん……まあ、わかったよ。[l]\n兎に角気をつけて運転します――\nこれこのまままっすぐですか？」","「唔嗯……好吧，我知道了。[l]\n总之会小心驾驶――\n就这样直走吗？」"],["「……回に限っては致し方あるまいね。[l]\n当主殿と選律君には連絡しておくよ。","「……这次就没办法了。[l]\n我会联系当主大人和选律君。"],["どうせ今回は特殊な訳だし。[l]\n","反正这次情况特殊。[l]\n"],["栖","栖"],["後","后"],["奉","奉"],["仕の本儀には流石に、\n彼を参加させることは出来ないしねえ。","仕的本仪终究\n没法让他参与呢。"],["冬夏君が少々ナーバスなのが気になるが、\nまあ、明日学校に行けばすぐ土日休暇だ。[l]\n祭まで二週間だし色々としなければならない事が山積みだからね。","虽然有点在意冬夏君过于神经质，\n不过明天上学后马上就是周末假期了。[l]\n距离祭典还有两周，堆积如山的事情要处理呢。"],["――ん？[l]\nああ、御免。[l]\n何だって？」","――嗯？[l]\n啊，抱歉。[l]\n你说什么？」"],["「兄ぃが、このまま道にゃりでいいかって」","「大哥问继续沿这条路走行不行」"],["狩屋の様子を窺ったりと逡巡してるうちに、\n後部座席組、というか姫様ちゃんと何やら話し込んでいたらしい。[l]\n僕の声が聞こえていなかった道具さんに\nその狩屋がフォローしてくれた。","在我观察狩屋反应犹豫期间，\n后座组——准确说是姫様酱似乎正在和谁热聊。[l]\n狩屋替没听清我说话的道具\n打了圆场。"],["「ん、そうそう。[l]\n記憶が確かならもうすぐの筈だがね。[l]\nちゃんとした駐車場は無いから現場に行ったら\n適当な場所を指定するよ」","「嗯，对对。[l]\n如果记忆没错应该快到了。[l]\n没有正规停车场，到现场后\n会指定合适的停车位置」"],["「了解です。[l]\nでは、出ますよ」","「明白。[l]\n那么，出发了」"],["周囲全方向に注意を傾けつつエンジンをかけ、\nリスタート。","在全方位注意周围的同时启动引擎，\n重新上路。"],["流石に車内に会話は無い。[l]\n道具さんはいつでも深刻そうな顔をしないので\nそれに救われてはいるが……","车内果然没人交谈。[l]\n道具小姐向来不会露出凝重表情，\n这点倒是让人安心……」"],["先刻の話で言えば、\n恐怖とは過剰な想像力だという。","按刚才的话来说，\n所谓恐惧就是过剩的想象力。"],["僕個人の見解だと、\nつまり具象化された解答が視えないものに対して、","以我个人的见解，\n也就是对于看不见具体化答案的事物，"],["いくつもの選択肢を考えるという行為、\nその行為の過程で生じるネガティブな解答、\nそれが恐怖、というか不安の一端なのかといった風なのだが、","不断思考多个选项的行为，\n在这个行为过程中产生的消极答案，\n那或许就是恐惧、或者说是不安的某种表现，"],["まあ他人とのコミュニケーションにおいても、\n沈黙をされるとどうすることもできない、少なくとも僕はそうだ。","不过在与他人交流时，\n一旦遭遇沉默就束手无策，至少我是这样。"],["幸い母さんを始め大神とか宮さんとか、\n身の回りには頼みもしないのによく喋る手合いが多いので\n普段は気にならないが、","幸好从老妈到大神、宫小姐他们，\n身边多的是不用拜托就喋喋不休的家伙\n平时倒不觉得，"],["電話に出ないとか、メールで返事が遅いとか、\n状況の改善は相手次第という状況に於いて、\n沈黙或いはノーリアクションというのは決定的に、\n僕が僕自身を","但不接电话、邮件回得慢之类，\n在改善状况取决于对方的情况下，\n沉默或者说毫无反应这件事，\n绝对会成为"],["苛む要素となる。","折磨我的要素。"],["いらぬ想像が為されてどんどん気が滅入る。[l]\nそういう意味で僕は確かに想像力の過剰な部類に\n入るのかも知れない。","多余的想象让人越来越消沉。[l]\n从这个意义上说我确实属于\n想象力过剩的那类人吧。"],["ただ、いつも脳が空転してるので\n寝て忘れて何とか遣り過ごしてるだけだ。","只不过因为脑子总在空转，\n睡一觉忘掉也就勉强熬过去了。"],["だから、そう、\nたとえその理由がキライだろうとイヤだろうと、\n明瞭に解答――反応を示してさえくれれば、\n寧ろ安寧を得られる場合もあるだろう。","所以啊，\n哪怕那个理由令人讨厌或反感，\n只要给出明确的解答――哪怕是反应，\n反而有可能获得安宁。"],["しかし、沈黙、[l]\n解答の視えない状況、[l]\n身の振り方が判然としない状態、\nそれは――","但是沉默，[l]\n看不见解答的状况，[l]\n不知该如何自处的状态，\n那才是――"],["「そう言えばええと、二週間後予定の祭ですけど、\nやっぱり延期順延は無いんでしょうかね？」","「话说那个，两周后计划的祭典，\n果然还是不会延期改期吧？」"],["会ってそれほど間もない間柄……否、だからこそかも知れないが、[l]\nどうにも沈黙に耐えられなくなり何とか話題を探し出して話を\n振ってみる。","见面没多久的关系……不、正因如此才更，[l]\n实在受不了沉默便拼命找话题\n试图搭话。"],["先程の道具さん達の会話から漏れ聞こえ思い出したのだが、\n一応念押しの為に訊いてみたのだ。[l]\n道具さんが決定権持ってる訳じゃないだろうが。","这是从刚才道具小姐他们对话里零星听到的，\n算是为确认才问的。[l]\n虽然决定权不在道具小姐手里。"],["まあ、場繋ぎの話題だし。[l]\n恐らく祭は強行される気配が濃厚だと宮さんも冬夏のおっかさんも\n言ってた訳だし。","嘛，反正只是缓解冷场的话题。[l]\n毕竟宫小姐和冬夏她妈都说过\n祭典很可能强行举办。"],["「ん？[l]\nそうか、旅行者の君にとっては重要事だね。[l]\n君は冬夏君の御母堂にも会ったのだろう？」","「嗯？[l]\n对哦，对旅行者的你来说是大事。[l]\n你见过冬夏君的母亲了吧？」"],["「ええ、一応……」","「嗯，算是见过……」"],["「彼女の言ったとおりだよ。[l]\n計画通り","「正如她所说。[l]\n我们会按计划"],["恙","确保"],["無く事が進められるべく僕等は動いている」","一切顺利推进」"],["「成る程、\nいや、楽しみにしてます。[l]\nこの旅行の目的はまさにその祭ですから……」","「原来如此，\n不，我很期待。[l]\n这次旅行的目的正是那个祭典……」"],["「一月前から長期滞在までしてくれてるのだからね、\nこちらも善処するよ。[l]\nだろう？[l]\n君達」","「提前一个月就来长住，\n我们也会妥善安排的。[l]\n对吧？[l]\n各位」"],["「……はい」","「……是的」"],["「……おういえー」","「……噢耶—」"],["「まあ、残念な点があるとすれば、\n当日我々は少年とデェトする事が出来ないという点かな……[l]\n主催運営神事執行の側だからねえ」","「要说遗憾的话，\n大概就是当天我们不能陪少年约会了吧……[l]\n毕竟我们是主办方要执行神事嘛」"],["「いやいやその、\nお気持ちだけ受け取っておきます……」","「不不那个，\n您的心意我领了……」"],["実際僕も、調査の進展によってはやらねばならない事がある。[l]\n色んな意味でなるべく穏便に事は進めたいけど……","实际上我也有随着调查进展必须完成的事。[l]\n从各种意义上都想尽量稳妥地推进事情……"],["「……ょうぶ」","「……没系」"],["「んに？」","「嗯呢？」"],["「ああ、其処の広い所に停めてくれ給え」","「啊啊，请停在那片宽敞的地方吧」"],["「あっと、はいはい」","「啊、好的好的」"],["格別眼前が開けるわけでもなく、\n山中のどん詰まりのような場所に到着した。[l]\n奥に続く道はあるようだが、車では厳しそうだ。","视野并未特别开阔，\n抵达了像是山中死胡同般的地方。[l]\n深处似乎还有路，但开车恐怕难以通行。"],["この辺りで四月中旬の山中では、\n流石に草がぼうぼうとまではいかないが、","四月中旬的山中这一带，\n倒也不至于杂草丛生，"],["手入れをしてある気配はなかった為、\n頻繁に人が立ち入る事はないであろうという事情は\n伺える。","但完全看不出有人打理的样子，\n由此可以推测\n平时鲜少有人踏足。"],["まあ、三春の私有地にわざわざ入り込もうなんていうのは、\n……本家の人等とかか。","毕竟会特意闯入三春家私有地的，\n……也就本家相关人士了吧。"],["実際に秘された祭儀を行うのは此処でなくて、\n九抱山となる訳だが、\n果たして向こうはどんな感じなのだか。[l]\n此処以上の山奥だろうしなあ。","实际举行隐秘祭仪的地点并非此处，\n而是在九抱山，\n不知那边会是怎样光景。[l]\n想必比这里更深山老林吧。"],["「では作業に入る前に、\n結界を解かなければならないのだ。[l]\nまあ来給え」","「那么在开始作业前，\n必须先解除结界。[l]\n来这边吧」"],["「け、結界？」","「结、结界？」"],["姫様ちゃんと狩屋は何も言わない。","姫様和狩屋都沉默不语。"],["四人揃って少し進むと、\nチェーンやら鉄条網やらが朽ちた柵に張り巡らされた格好で\n配備されており、","四人同行片刻后，\n看到锈蚀的栅栏上缠绕着铁链与铁丝网，\n形成防护设施，"],["その少しだけ奥には\n注連縄らしき……\nらしきというのは","再稍往深处\n可见类似注连绳的……\n之所以说类似"],["紙","是因为"],["垂の形が少々特殊に見えるからで、","纸垂的形状略显特殊，"],["それに加えて三春の家にあったいやに丈の高い\n――とは言え周りの木々には劣るが――\nこれまた様式のよく分からない鳥居らしきものが立っていた。","再加上三春家宅邸里那种高得离谱的——\n（当然比周围树木还是矮些）——\n同样造型奇特的疑似鸟居矗立着。"],["僕が神妙にそれを視ていると、\n","当我严肃地观察时，\n"],["道具さんは手前のバリケード状のそれを、\n鍵らしきものを使って開けた。","道具小姐用钥匙状物品\n打开了前方的路障。"],["「結界を解く……て、[l]\nああ、少々違うものを想像してました。[l]\nそういうことですか……」","「解除结界……[l]\n啊，和我想象的有点出入。[l]\n原来是这种形式吗……」"],["誰かの影響って訳ではないが、\n今時分に結界がどうの、と聞くとどうにも、\n超常的というか、漫画的なものを想像してしまう。","倒不是受谁影响，\n只是这年头听到结界之类的说法，\n总会联想到超自然或漫画情节。"],["「ああ、まあ少々鯱張った言い方だったか。[l]\n結界解除である事に変わりはないのだがね。[l]\nところで――」","「确实，刚才的说法可能有点夸张。[l]\n不过本质确实是结界解除。[l]\n话说――」"],["と、道具さんは狩屋の方を向いた。","道具小姐转向狩屋。"],["「姫様君は兎も角、\n克杖君、今日も静かだなあ、\n僕と一緒じゃ緊張するかい？」","「姫様暂且不论，\n克杖今天也很安静呢，\n和我在一起会紧张吗？」"],["「にっ？！[l]\n","「诶？！[l]\n"],["いあ、べ、別にそんにゃことは……」","没、没那回事……」"],["「彼女はあれで礼儀正しくて古式ゆかしい、\n加えて内気で人見知りのする学校では優等生なんだな。[l]\n身内とは言え僕のように年に数回しか会わない人間の前では\n萎縮してしまうようなんだ」","「她其实是个恪守古礼的乖孩子，\n而且内向怕生，在学校可是优等生。[l]\n就算对亲戚也会在像我这样每年只见几次的人面前\n紧张得缩成一团」"],["と今度は僕の方を向いて言う。","这次是对着我解释。"],["え、此奴が礼儀正しくて？[l]\n古式ゆかしい？[l]\n内気で人見知り？[l]\n萎縮？？","哈？这家伙恪守古礼？[l]\n内向怕生？[l]\n紧张到缩团？[l]\n骗鬼呢？？"],["僕ぁ初見にもかかわらず、\nいきなり強烈な罵声を浴びせられておりますが！？","我明明初次见面，\n突然就被劈头盖脸痛骂了啊！？"],["「君の前では結構砕けてるんだろう？[l]\n妬けるね」","「在你面前算是相当放得开了吧？[l]\n真让人嫉妒呢」"],["いやいやいや、\n単に姫様ちゃんと僕の妙な過剰接近に対する防衛反応というか、\n妙な言い方だけど『恋敵』と思われたからではないかと……","不不不，\n单纯是姫様和我过度亲密接触引发的防卫反应或者说，\n虽然说法奇怪但可能是被当成『情敌』了……"],["「………か、杖……」","「………克、杖……」"],["「にゃ！[l]\nちょ！[l]\nちが！」","「喵！[l]\n等！[l]\n不是！」"],["この場合、味噌糞に僕を貶すのも或る意味で道具さんの言を\n肯定する事になってしまうからか、\nそれ以上何も言えない狩屋。","这种情况下，把我贬得一文不值某种意义上也算是\n对道具小姐言论的肯定吧，\n狩屋再也说不出更多话来。"],["僕もいちいち反応して居られない、と言うかね、\nもうそう言う弄りは足りてるんです。[l]\n大体、結構状況は緊迫してた筈じゃないのか。[l]\nそれとも本当に、既に懸案事項じゃないのか？","我也没法——或者说、\n已经受够这种戏弄了。[l]\n按理说、情况应该相当紧迫才对吧？[l]\n还是说、这真的已经不算悬案了？"],["「まあ、愉快な雑談はそこまでに、\nほら、\n","「嘛、愉快的闲聊就到此为止、\n喏、\n"],["速に如かずって\n御自分で仰ってたでしょう」","您不是自己说过\n速战速决比较好吗」"],["「分かった分かった。[l]\n済まないね、克杖君姫様君」","「知道啦知道啦。[l]\n抱歉呢、克杖君姫様君」"],["僕には何も謝辞は無いのね。[l]\nいいけどさ別に……","对我连句道歉都没有呢。[l]\n不过无所谓啦……"],["さて、\n３人は揃って鳥居……\n便宜上、もうそう呼んでしまうが、その下に立ち、[l]\n上方に顔を向けて黙祷をしているようだった。","那么、\n三人齐刷刷站在鸟居——\n虽为方便仍这么称呼——下方、[l]\n仰头默祷着。"],["遅れて僕もその横に並び、同様に","迟到的我也站到他们身旁、"],["倣う。","效仿起来。"],["「……？[l]\nな、何か特殊な作法とかあるんでしょうか？」","「……？[l]\n那、那个有什么特殊仪式之类的吗？」"],["口の中でもごもごと何かを唱えてるようだが、\n流石に初見でそれを模倣するには無理がある。","虽然她嘴里似乎也在咕哝着什么，\n但让初次见到的人模仿实在强人所难。"],["「ミ・キャミャルキャラモロコネコナメタサキャラ\nタサコネタサメミャラメンカヤコネキャ・ワ。","「mi・kya mya ru kya ra mo ro ko ne ko na me ta sa kya ra\nta sa ko ne ta sa me mya ra me n ka ya ko ne kya・wa。"],["作法ねえ……まあ、[l]\n少年は取り敢えず聖域に入る心構えを観想すれば","仪式啊……这个嘛，[l]\n少年只要先做好进入圣域的心理准备"],["佳い。[l]\n今言った","就行。[l]\n刚才那段"],["文","话"],["言覚えろと言っても酷だしねえ」","让人硬背下来也太强人所难了」"],["「あれ、そ、それは――」","「咦、那、那个是――」"],["あの式の謎言語……","那段咒文的谜之语言……"],["チノ嬢も何かに付け言ってくるみゃんみゃんにゃんたら、\n全部同じに聞こえるし、彼女が言ってたのと同じ文字列かどうかは\n僕の記憶力では参照出来ないけども……","就连千乃小姐动不动就冒出来的喵呜喵喵喵什么的，\n听起来也都差不多，她刚才念的是不是同样的字符\n以我的记忆力实在没法核对……"],["「聞いているとは思うが、\nこの文言の構成言語に関して具体的な解析を試みるのは\n止した方が賢明だ。","「虽然你在听，\n但建议不要试图具体解析这段咒文的构成语言，\n这才是明智之举。"],["ましてこの聖域下に於いてそのような所業……[l]\n考えただけでもぞっとしないね」","更何况在这圣域之下做这种事……[l]\n光是想想就让人毛骨悚然呢」"],["「や、了解してますよ、\n僕もこれで敬虔な人間なのです」","「呀、我明白的，\n我现在也算是虔诚之人了」"],["にしても、\n『そっち』方面を嗜好してる割に、\nこの手の正式な作法を心得てる訳ではない僕がみても、\nあまり視ない作法だと思う。","不过话说回来，\n尽管我本身就偏好『那边』的领域，\n但连我这种不懂正式礼仪的人看来，\n也觉得这做法不太常见。"],["個人の屋敷神である事とか、例の謎言語を使用してる時点でまあ、\n余所とは違うんだろうけど、\nそれとあとは略式なのかもな。[l]\nそもそも参拝じゃあないんだけど。","既是私人宅邸供奉的神明，又用了那种谜之语言，\n确实和普通神社不一样吧，\n可能还掺杂了简化仪式。[l]\n本来也不是正经参拜就是了。"],["取り敢えず何となく目を瞑り、\n何となく心中で拝んでから、\n眼を開き彼女達に頷いた。","总之先随便闭上眼睛，\n随便在心里拜了拜，\n睁开眼向她们点了点头。"],["「克杖君、ここからは折角だから君が説明するかい？[l]\n僕がしゃしゃり出なければ元来君の役目だったのだろう、\n","「克杖君，难得的机会从这里开始由你来说明如何？[l]\n本来我不越俎代庖的话这该是你的职责，\n"],["屹","肯定"],["度」","是这样」"],["「にゃ、べつにそこまで決めてたわけじゃ……[l]\n","「喵、倒也没特地这么规定……[l]\n"],["き、きーちゃ？」","姬、小姬？」"],["「道具さんお願いします」","「那就拜托道具小姐了」"],["「はいはい、了解したよ。[l]\nさて、少年の為に一度、斎場に行こうか。[l]\nそれとも二人はもう車から荷下ろしするかね？」","「好好好，知道啦。[l]\n那么，为了少年先去一趟斋场吧。[l]\n还是说你们俩现在就从车上卸货？」"],["狩屋もそういうポジションぽいけど、\n僕まで何かこう変な板挟みになってる感がすごいしてるんですが。[l]\n道具さんが変な梃入れ……それは逆だ、ええと、[l]\n不和のリンゴを放るような真似ばかりするからなあ。","虽然狩屋也像是那种立场，\n但连我都感觉被卷进奇怪的夹缝里了。[l]\n道具小姐总爱乱插杠子……说反了，呃，[l]\n老是干些扔“不和的苹果”的事。"],["もっと普通の表現があったような気がするけども、\n何故か今は浮かんでこないのだった。","明明应该有更普通的表达方式，\n不知为何现在就是想不起来。"],["――こんなだから道具さんやらに、\n『そっち方面』の嗜好と思われるんだろうかなあ。","――正因为这样才会被道具小姐她们\n当成是偏好『那方面』吧。"],["「……私も行きます」","「……我也去」"],["「すぐ近くにゃしういも行くにょう」","「反正很近喵呜也要去喵」"],["「ん。[l]\nではいざ行かん。参られい」","「嗯。[l]\n那就出发吧。请随行」"],["「は、お手数おかけします」","「好、麻烦您了」"],["結局４人でぞろぞろ移動を開始する。","结果四人稀稀拉拉地开始移动。"],["鳥居の下を","穿过"],["潜ると、\n在るのか無いのかギリギリの存在感の石段らしき平らな石が\nそこはかとない間隔で敷かれており、\n一端下り坂になった後その倍程の高さを頂点とする上り坂となった。","鸟居下方，\n勉强能称为石阶的平坦石块\n以似有若无的间隔铺设着，\n下坡一段后转为两倍高度的上坡。"],["これも寡聞にしてあまり視ない様式だが、\nまあ神社そのものではないからかも知れず、","这种样式我也少见多怪，\n或许因为这里本非神社，"],["――それよりもこの道程、\n距離的には確かに大したことはないが、\n廃材持って往復するには結構な険しさだと思うよ……","――比起这个，这段路\n距离虽不算长，\n但扛着废料往返应该相当吃力……"],["石段、と言うよりも坂を登り切ると、\n平らではあるが決して見晴らしの良くない、\nややすり鉢状になった場所に出た。","爬完这段该叫坡道而非石阶的路，\n来到虽平坦但视野绝称不上好、\n略呈钵状的场地。"],["其処には社なんだか社務所なんだか、\nはたまた倉庫なのか判然としない微妙な小屋があり、\nその前にはまた細い縄に紙垂を付けたものが、\n等間隔に十本、円形に立てられた棒に張られていた。","此处有座微妙小屋难以分辨是祠堂还是社务所，\n抑或是仓库，\n屋前细绳系着纸垂，\n十根等距木桩呈圆形张结。"],["その縄によって囲まれた円の中は、\n確かに何かを燃やした様な煤らしき黒い","绳圈围起的圆内，\n确实可见类似煤灰的黑色"],["滓やらが視える。[l]\nたき火かキャンプファイアーの跡とでも言おうか。[l]\n三春家の庭や登り口にあった鳥居は此処には無かった。","燃烧残留物。[l]\n该说是篝火还是营火的痕迹呢。[l]\n三春家庭院和入口处曾有的鸟居在这里并没有。"],["にしても、\n天気はかなり良いのに、\n此処は上方をも樹木が覆いつくし、\n木漏れ日がぎりぎり降ってくる程度だ。","话说回来，\n尽管天气晴好，\n此处上方也被树木彻底遮蔽，\n仅有零星阳光勉强漏下。"],["針葉樹林なのでこの時期この地方でも、\n恐らくは年中こんな雰囲気なのだろうと見受けられる。","针叶林使得这地方即便在这个季节，\n恐怕全年都是这般氛围吧。"],["「さて、この結界も今解くのでね。[l]\nあの中心に廃材を放ってくれればよいと言うわけだ。[l]\n諒解して戴けたかね少年？」","「好了，现在要解开这个结界。[l]\n只要把废料扔进那个中心就行。[l]\n少年可明白了？」"],["「あ、はい、分かりました」","「啊、是，明白了」"],["「じゃあ少々其処で待っていてくれ給え。[l]\n今結界を解く」","「那请稍候片刻。[l]\n这就解开结界」"],["「ふぅー、ち、近いと思ってたけど、\n結構しんどかったにょう……[l]\n歳かにゃあ……」","「呼——虽、虽然觉得挺近，\n实际走起来还挺累喵……[l]\n年纪大了喵……」"],["少々遅れていた狩屋と姫様ちゃんが僕の横に並んだ。[l]\n狩屋、言い出してついて来たは良いが、\n息あがっとるがな。","稍迟一步的狩屋和姫様酱并排站到了我身旁。[l]\n狩屋，主动提出跟来是挺好，\n但你这气喘吁吁的啊。"],["姫様ちゃんは……いつも通りの表情……[l]\nしんどそうと言えばしんどそうではあるけど……","姫様酱则……还是那副老样子表情……[l]\n要说累的话确实也显得有点累……"],["「後で増血食しよう」","「待会儿吃增血餐吧」"],["「にゃっ♪\nらにゃー！[l]\n","「喵呜♪\n喵呀！[l]\n"],["きーちゃん家で、兄ぃが帰ってからにゃな」","要等到小姬家，哥哥回去之后才行喵」"],["「……うん」","「……嗯」"],["ん、何か微妙に険のある会話が聞こえてきてるんですが……","嗯，怎么好像听到些气氛微妙的对话……"],["姫様ちゃんと眼が合った。","和姫様酱对上了视线。"],["「あ──、\n","「啊──\n"],["その、御免なさい」","那个，对不起」"],["「？[l]\nあ、いやいや、何も言ってないし……」","「？[l]\n啊、不不，我什么都没说啊……」"],["「そっちは美味しくないので……[l]\n真言さんとの食事の後で私達だけで」","「那边的不太好吃所以……[l]\n等和真言先生吃完饭就我们俩单独」"],["「栄養補給にゃっ。[l]\nじょ、女子にはいろいろあるざます」","「补充营养喵。[l]\n女、女孩子总有些特殊情况嘛」"],["「や、だから何も言ってないから……[l]\n別に気にしてないし。[l]\nお前の口調が変な事の方が気になるわ」","「所、所以说我真的什么都没讲……[l]\n完全没在意的。[l]\n倒是你说话腔调奇怪更让我在意」"],["「そんな、ず……」","「才没、没那……」"],["「や！だから！[l]\n他意はにゃいの！！[l]\nそろそろわかってきーちゃぁ！！」","「呀！都说了！[l]\n没有别的意思喵！！[l]\n你也该明白了吧小姬！！」"],["それは僕も言いたいのですが……[l]\nいや、だからって姫様ちゃんが\nスキとかキライとかそういう事でも\nないんだけど。","这话我也想对你说来着……[l]\n不是，倒也不是说姫様酱\n喜欢或讨厌之类的\n那种事啦。"],["「そ、それよりもほら道具さんの作業も済んだようだし！[l]\n戻ろう！[l]\n仕事仕事！」","「比、比起这个你看道具小姐工作也完成了！[l]\n回去吧！[l]\n工作工作！」"],["視線の先には確かに縄の一部を解き終えて\n戻ってくる道具さんが。","视线前方确实能看到解完部分绳索\n正往回走的道具小姐。"],["しかし、","然而，"],["「ほら、やっぱり君等は気が置けない仲じゃないか。[l]\n妬けるねえ」","「看吧，你们果然是好到不用客气的交情嘛。[l]\n真让人嫉妒啊」"],["だあああ。[l]\n今事態を収束させようとしてたんですがぁ！","啊啊啊。[l]\n我正要把事态平息下来的啊！"],["──結局、\n恨めしげな姫様ちゃんとそれを必死で宥める狩屋、\n煽るだけ煽ってあとはほったらかしの道具さん、[l]\nいつものように流されるままの僕。","──结果，\n闹别扭的姫様酱和拼命安抚的狩屋，\n光会煽风点火之后撒手不管的道具小姐，[l]\n还有照例随波逐流的我。"],["多少","虽说"],["謀ってるとは言え、\n別に敵対してるわけでもないし、\n懐柔策としては良い傾向なんだろうけども、","多少有些算计，\n但也不是敌对关系，\n作为怀柔策略应该算好趋势吧，"],["こんなに","这么"],["長","悠"],["閑でいいのか。[l]\nそれとも今だけなのだろうか。","闲真的好吗。[l]\n还是说只是暂时的呢。"],["まこくんはいまたのしい？","小真现在开心吗？"],["──どうだろう。","──谁知道呢。"],["……あと二週間か。","……还剩两周啊。"],["「こ、今度こそ車行きましょうか」","「这、这次真的该上车了吧」"],["気を取り直して、\n車へと戻る我々。","重整心情，\n我们向车子走去。"],["道中でもまた道具さんが言う。","路上道具小姐又开口道。"],["「実際の行為は兎も角として、\n女子っていうのはこの手の話でご飯何杯でもイけるんだなあ。","「实际行为姑且不论，\n女孩子聊起这种话题真是能配下好几碗饭呢。」"],["こう視えて僕も女子の端くれだからね。[l]\n愉快を信条にしている以上、\n弄れる機会は逃さぬよ。[l]\n特に君は──」","别看这样我也是女生的一员呢。[l]\n既然以快乐为信条，\n可不会放过捉弄人的机会哦。[l]\n特别是你──」"],["な、なんですか。","怎、怎么了？"],["「そういう星の下に生まれているようだし。[l]\n恐らく常日頃そういう環境に居るのだと見受けるがね。[l]\n何か強力な女子の匂いが君を包んでいるぞぅ。[l]\nうひひひひ」","「你似乎出生在那样的星辰之下呢。[l]\n想必平日里也处于那种环境吧。[l]\n有种强烈的女生气息正包裹着你呢～[l]\n呜嘻嘻嘻」"],["「その笑い止めてください……」","「请停止那种笑声……」"],["心当たりが……約一名、思いっきり居ますし。[l]\nてか何でピンポイントでその笑い方？","心里有数……至少能想到一位。[l]\n话说为什么连笑声都这么精准复刻？"],["背後から迫る姫様ちゃんの視線の方が今は強力な\nプレッシャーとなっていますゆえ、\nとっとと作業に入りましょう。","现在背后姫様酱的视线\n带来的压力更强烈，\n赶紧开始干活吧。"],["と言う訳で、\n車まで戻ると、何とか平静を取り戻した狩屋が、\n早速座席の方から何かを放って来た。","就这样，\n回到车边时，勉强恢复平静的狩屋\n立刻从座位扔来什么东西。"],["「これ、軍手」","「给，劳保手套」"],["「ああ、さんくす」","「啊，三克油」"],["「あーいきーちゃ、これっ。[l]\nで、これトモさん」","「来～小姬，这个。[l]\n然后这是给道具姐的」"],["姫様は無言で軍手を受け取り、それをはめる。[l]\n何か僕の、如何にも使い古しくさいこの汚れ軍手とは\nえらい違う真新しいやつですな。[l]\nまあ女子ですし別にいいんだけど……","姫様默不作声接过手套戴上。[l]\n这和我那双用得发臭的脏手套\n可真是天差地别的新货啊。[l]\n不过毕竟是女生倒也没关系啦……"],["「まああれだ、\n手伝うと言っては来たがね、\n実労働力としては期待しないよう頼むよ」","「嘛总之，\n虽说他是来帮忙的，\n但别指望他当实际劳动力哦」"],["「まあ……そもそも兄ぃをこき使う予定にゃったし」","「反正……本来就没打算让老哥干活」"],["「いやいやお前、\n僕も道具さんと同じ事を伝えただろう昨日」","「喂喂你这家伙，\n我昨天不是和道具小姐说过同样的话吗」"],["「男子と女子じゃ根本的に体格差があるにゃろ」","「男女体格根本有差异的吧」"],["「今時流行らんぞ、男らしくとか女らしくとか……」","「现在可不流行男子气女子气那套了……」"],["「ふむ、そうだねえ。[l]\nしかし男女の性差は機能や仕様の差以外では\n個体差とでも言おうか、\nジェンダーを語るにしても気を使わねばならない御時世……」","「嗯，确实呢。[l]\n但男女差异除了功能规格不同外，\n或许该称为个体差异，\n讨论性别议题时也得注意分寸的世道……」"],["「いあ、その」","「那个」"],["「そんな小難しいことを話していた訳ではなくですね」","「我们刚才不是在讨论这么深奥的话题」"],["「……みなさん」","「……各位」"],["うっ。","呜。"],["僕等３人はそそくさと準備に取り掛かった。","我们三人立刻手忙脚乱开始准备。"],["あんな……な眼で視られたらなあ……[l]\n狩屋じゃないが思わず身が竦みます。","被那种……眼神盯着的话……[l]\n不是狩屋也会忍不住僵住啊。"],["「さて──」","「那么──」"],["此処から彼処まで廃材を運ぶわけね……[l]\n一個一個がそんなでもないとは言え、\n距離もそんなではないとは言え、\n道程のコンディションがなかなかに厳しげ。","要把废材从这里运到那里呢……[l]\n虽说单个重量不算什么，\n距离也不算远，\n但路况条件实在够呛。"],["まあ、覚悟決めるかぁ。","算了，做好觉悟吧。"],["こういうのは流されて","这种时候"],["只","只"],["管無心にやるに限るんだ。[l]\nと、\n今回の一連で僕が得た境地のひとつですよ。","放空脑子随波逐流才是上策。[l]\n这就是\n通过这次事件领悟的境界之一。"],["そして、体感的には一時間あるかないか。","然后体感不到一小时，"],["結局、\n動いてしまえばあっという間というか、\n案ずるより産むが易しというか。","结果，\n动起来后发现转眼就完事了，\n或者说杞人忧天。"],["作業自体は心得通り、無心でやってるうちに終わっていた。[l]\nそもそも只の運搬作業ではあるし。","作业本身如预想般在放空状态下结束了。[l]\n毕竟只是搬运工作而已。"],["「ああー、終わった終わったぁ。[l]\n明日筋肉痛とかなりそうだなこれ……」","「啊～结束了结束了。[l]\n明天绝对会肌肉酸痛吧……」"],["「兄ぃってばもうだらしにぇえにゃあ。[l]\n","「老哥也太废柴了啦～[l]\n"],["やっぱ歳かにょう、いやだいやだ」","果然还是年纪大了，不要不要」"],["「お前が呼び出したん…う、[l]\nいや、そのちがうんです、姫様ちゃんが悪いと言ってるわけではなくて！」","「是你叫出来的…呜、[l]\n不、不是那样的，不是说姫様酱不好啦！」"],["「……私はだいじょうぶです。[l]\n──自信がありますから」","「……我没问题的。[l]\n──因为我有自信」"],["「あわわわわ……んぬ、","「啊哇哇哇……嗯唔、"],["んお？[l]\nにゃ、にゃん」","嗯哦？[l]\n喵、喵呜」"],["何のですか？","有什么事吗？"],["「──あなたに………れない……自信……」","「──不会被你………讨厌……自信……」"],["「……にゃ？？」","「……喵？？」"],["「や、僕を視るなって……」","「别、别盯着我看啊……」"],["狩屋が『理解不能』という表情をしてこっちを向いたが、\n僕にも聞こえてなかった。","狩屋露出『无法理解』的表情转向这边，\n但我也没听清。"],["「……」","「……」"],["はにかみとニヤリの中間くらいの表情で姫様ちゃんは、\nとことこ歩いてきて僕の横についた。","姫様酱带着介于羞涩和坏笑之间的表情，\n啪嗒啪嗒走过来站在我身旁。"],["思わず身構えてしまう間もなく狩屋が割って入り、\nその反動で","还没等我下意识戒备，狩屋就插了进来，\n反作用力让我"],["蹌","踉"],["踉ける僕、\n焦って僕の腕をがっしと掴む狩屋、\nどの行為に対してかは定かではないが息を呑む姫様ちゃん、","跄了一下，\n慌忙抓住我手臂的狩屋，\n虽然不确定是针对哪个举动但倒吸冷气的姫様酱，"],["という混迷の様相を呈す僕等を","无视呈现这般"],["余","混乱局面的"],["所に、\n再び結界を張り終えた道具さんがこちらを振り返る。","我们，\n重新布完结界的道具小姐转头看过来。"],["「んっ。んんっ」","「嗯。嗯嗯」"],["咳払いをし僕等が静止するのを待って、","她清了清嗓子等我们安静下来，"],["「大儀であった皆の衆。[l]\n","「诸位辛苦了。[l]\n"],["諸","托"],["姉の御陰で無事に職務を遂げた。[l]\nさてさて、そこな助っ人、\n","各位姐姐的福顺利完成任务。[l]\n那么那么，那边的帮手，\n"],["此","此"],["度の働き真に上々なり。","番表现着实上乘。"],["よって褒美を遣わすぅ。[l]\n──そうだね？[l]\n姫様君」","所以赐予奖励哟。[l]\n──对吧？[l]\n姫様君」"],["あってるのかあってないのか僕にも判別つきかねる\n時代劇がかった口調、そして大仰な舞台芝居的所作で言う。","这半文不白的台词我也分不清是否合适\n她用古装剧腔调配合夸张的舞台动作说道。"],["で、最後の言葉を振られた姫様ちゃんが、\n作業の所為か、先程までの遣り取りの所為なのか、\nやや上気した顔で言った。","而被点名回应的姫様酱，\n不知是因工作还是刚才的互动，\n泛着红晕开口："],["「はいっ、私を、……違う。[l]\n","「好、把我……不对。[l]\n"],["私の……家で、お昼ごはん……」","在我家……吃午饭……」"],["「プラス、アルファがあるわけだねえ。[l]\n克杖君も","「看来还有附加条件呢。[l]\n克杖君也"],["漸く報われる訳だ」","总算能得到回报了」"],["「にゃ、や、やだにゃあ……[l]\nそんにゃことは……おほほほほ」","「喵、不、不要喵……[l]\n那种事……哦呵呵呵」"],["「？」","「？」"],["「ん？[l]\nああ、克杖君にとっても眼福とでも言おうか、\nまあ報酬と言うのは人それぞれであるから、\n説明するのは難しいのだがね。","「嗯？[l]\n啊，对克杖君来说该说是眼福吧，\n毕竟所谓报酬因人而异，\n解释起来很困难呢。"],["同一事象に対して少年がどう思うかは君次第だし、\n取り敢えずその都度判断してくれ給え」","同一件事少年怎么想取决于你，\n总之每次见机行事就好」"],["……眼福。[l]\n目の保養って事ですか？[l]\nにゃんで？","……眼福。[l]\n是说养眼吗？[l]\n为什么喵？"],["は！[l]\nま、まさか……何かしらイカガワシイ……[l]\nいや、しかし女子にとってだから……","啊！[l]\n难、难道……什么下流的……[l]\n不，但对女生来说就……"],["でも狩屋にとっての……場合はどっち？[l]\nどっちでもどうかと思うけど……[l]\nいやいや、そもそもそんなこと自体ですな、\n想像する方が間違って、","可对狩屋来说……是哪边？[l]\n感觉哪边都很奇怪……[l]\n不不，从根本上说这种事本身，\n去想象就是错的，"],["「おい！兄ぃ！！[l]\nぼーとしてんにゃ。行くにゃよ」","「喂！大哥！！[l]\n别发呆了喵。要走啦喵」"],["「あ、あれっ？[l]\nおあ、待った待った今行くって」","「啊、啊咧？[l]\n哇啊、等等等等这就来」"],["知らぬ間に移動を開始していた３人を慌てて追い掛けた。","慌忙追赶起不知何时已开始移动的三人。"],["うーん、\n僕も宮さんの攻撃のおかげで随分枯れたと思ってたが、\nどうやらそうでもないのか。[l]\n幸か不幸か知らないけども……[l]\nや、そんなことはどうでもええねん。","唔——\n虽说我也以为被宫小姐攻击后已经相当萎靡了，\n但看来并非如此呢。[l]\n不知该说幸运还是不幸……[l]\n啊、这种事怎样都无所谓啦。"],["何はともあれ、\n過度な期待……いやいや、妄想は受け流し！[l]\n彼女の家、\n『嘉多里辺茶屋』にて\n昼食だ。","总之，\n过度的期待……不不、要过滤掉妄想！[l]\n在她家，\n『嘉多里边茶屋』\n吃午饭。"],["それと──[l]\n@r本作業……本儀式とやらは僕は関与出来ないらしいからなあ。[l]\n調査の観点から言えば、\nそっちにも参加させて貰えるに越したことはないのだろうが、\n明確に僕に対し言った訳ではないにせよ、\n既に道具さんが釘刺し発言してるし、\nそれはここまで僕を身内扱いしてる人間が\n駄目だという領域という事になる。","另外——[l]\n@r正式工作……那个正式仪式似乎我无法参与呢。[l]\n从调查角度来说，\n若能让我参与那边自然是最好不过，\n虽未明确对我表态，\n但道具小姐已经出言制止了，\n这意味着即便把我当自己人照顾到这种程度的人\n也认定那领域不可涉足。"],["そこにはなかなか踏み込めなさそうだし、\n……狩屋にとっての眼福が何なのかは兎も角、[l]\n何かしら宮さんに報告できる情報が得られればいいんだ、\nけ、ど、も──\n……会食だものなあ。","看来很难介入其中，\n……暂且不论对狩屋而言的眼福是什么，[l]\n只要能获取些能向宫小姐汇报的情报就好，\n可、是——\n……毕竟是聚餐啊。"],["帰りも僕の運転である。","回程也是我开车。"],["行きにあんな事があったので、\n相当気を遣い、周囲に気を配りながら、\n安全、且つ迅速にその場を抜けるように走った。","因为来时发生了那种事，\n我相当谨慎，边留意周围情况，\n边安全且迅速地驶离现场。"],["幸い、何事もなく舗装された車道に戻ることが出来、\n僕の肩の力も抜けた。","所幸平安无事地回到了铺装车道，\n我肩膀的力道也放松下来。"],["他の３人は少々無口ではあったが、\n怖がったりとか、そういう感じではなかった。[l]\n先刻もそうだったけど、\n警戒心は解いてないがよくあることだから\n必要以上に気にはしない──\nそういった感じの態度で、\n極めて落ち着いていた……ように視えた。","其他三人虽有些沉默，\n但并没有害怕或类似情绪。[l]\n刚才也是如此，\n虽未解除警戒心，因是常有之事\n便不再过度在意——\n就是这般态度，\n显得极为镇定……看起来。"],["あくまで、神経質になっていた僕の主観だけど。","当然，这只是神经质的我的主观感受。"]],"context":[["SC_M_027.ks/index/1/text"],["SC_M_027.ks/index/3/text"],["SC_M_027.ks/index/5/text"],["SC_M_027.ks/index/7/text"],["SC_M_027.ks/index/10/text"],["SC_M_027.ks/index/12/text"],["SC_M_027.ks/index/14/text"],["SC_M_027.ks/index/16/text"],["SC_M_027.ks/index/18/text"],["SC_M_027.ks/index/20/text"],["SC_M_027.ks/index/22/text"],["SC_M_027.ks/index/24/text"],["SC_M_027.ks/index/26/text"],["SC_M_027.ks/index/28/text","SC_M_027.ks/index/142/text"],["SC_M_027.ks/index/30/text"],["SC_M_027.ks/index/32/text"],["SC_M_027.ks/index/34/text"],["SC_M_027.ks/index/36/text"],["SC_M_027.ks/index/38/text"],["SC_M_027.ks/index/40/text"],["SC_M_027.ks/index/42/text"],["SC_M_027.ks/index/44/text"],["SC_M_027.ks/index/46/text"],["SC_M_027.ks/index/48/text"],["SC_M_027.ks/index/50/text","SC_M_027.ks/index/90/text"],["SC_M_027.ks/index/52/text"],["SC_M_027.ks/index/54/text"],["SC_M_027.ks/index/56/text"],["SC_M_027.ks/index/58/text"],["SC_M_027.ks/index/60/text"],["SC_M_027.ks/index/62/text"],["SC_M_027.ks/index/64/text"],["SC_M_027.ks/index/66/text"],["SC_M_027.ks/index/68/text"],["SC_M_027.ks/index/70/text"],["SC_M_027.ks/index/72/text"],["SC_M_027.ks/index/74/text"],["SC_M_027.ks/index