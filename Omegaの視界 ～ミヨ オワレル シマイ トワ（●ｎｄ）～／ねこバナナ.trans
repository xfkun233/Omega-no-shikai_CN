t":966,"end":1126}],[{"start":1155,"end":1160}],[{"start":1217,"end":1242}],[{"start":1271,"end":1319}],[{"start":1350,"end":1354}],[{"start":1383,"end":1415}],[{"start":1446,"end":1469}],[{"start":1498,"end":1523}],[{"start":1537,"end":1538}],[{"start":1548,"end":1549}],[{"start":1559,"end":1639}],[{"start":1670,"end":1761}],[{"start":1790,"end":1810}],[{"start":1841,"end":1899}],[{"start":1928,"end":1941}],[{"start":1998,"end":2034}],[{"start":2093,"end":2217}],[{"start":2274,"end":2321}],[{"start":2444,"end":2455}],[{"start":2484,"end":2508}],[{"start":2560,"end":2570}],[{"start":2579,"end":2582}],[{"start":2591,"end":2765}],[{"start":2794,"end":2896}],[{"start":2955,"end":2969}],[{"start":2998,"end":3018}],[{"start":3028,"end":3054}],[{"start":3085,"end":3136}],[{"start":3194,"end":3198}],[{"start":3229,"end":3296}],[{"start":3306,"end":3331}],[{"start":3341,"end":3382}],[{"start":3413,"end":3422}],[{"start":3448,"end":3464}],[{"start":3527,"end":3628}],[{"start":3693,"end":3836}],[{"start":3845,"end":3861}],[{"start":3875,"end":3876}],[{"start":3886,"end":3914}],[{"start":3923,"end":4135}],[{"start":4200,"end":4208}],[{"start":4260,"end":4372}],[{"start":4381,"end":4382}],[{"start":4391,"end":4393}],[{"start":4402,"end":4469}],[{"start":4524,"end":4535}],[{"start":4566,"end":4743}],[{"start":4772,"end":4851}],[{"start":4882,"end":4992}],[{"start":5021,"end":5054}],[{"start":5085,"end":5306}],[{"start":5335,"end":5342}],[{"start":5373,"end":5412}],[{"start":5441,"end":5472}],[{"start":5506,"end":5551}],[{"start":5588,"end":5598}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_060.ks","basename":"SC_E_060.ks","indexIds":{"「さて、[l]\n今日が期日（the Due Date）だな。[l]\n……残念乍ら、[l]\nまだ彼の投降の気配も無しか、な？」":0,"「今の処、誰からも連絡はありません」":1,"「………」":2,"「あぁーーーーー～～～～～っ、あ、[l]\nあぁあぁあ～～～～～んっと、[l]\n──ふぅ、[l]\n………あーぁあ。[l]\n期待外れか」":3,"「譲りに譲り、粘りに粘って23:59まで待ってはみたが──[l]\n……ま、[l]こっちで勝手に決めた日時の境目なんて、[l]\n意味なかったね。[l]\n無駄な仏心だったなあ、\n……んっとに、[l]\n残念だ。[l]\n………。[l]\n……むかつきます」":4,"「……彼の、」":5,"「四重奏団、先に喚び出しとこうか。[l]\n手配して。[l]\n具足の及びペイルの準備もね」":6,"「……了解しました」":7,"「……んむー……[l]\n……なんで、なんで来ないんですか。[l]\nまこくんにも、\n残れる道、残したのに、\n………。[l]\n……折角、………、[l]\n………苛つきます、むかつきます、[l]\n………。[l]\n………、[l]\n……連れ戻してきたら、──」":8,"「あの、」":9,"「んぁ？！[l]\n……ごめん、どうした？」":10,"「……四重奏団全団員と連絡が付きません。[l]\n他の構成員も、彼女等の行方を知りません」":11,"「あ？」":12,"「加えまして、\nチズルが、\n人事不省に陥ったと」":13,"「なんだって？[l]\nなんで。何処で」":14,"「分かりません、詰め所か、或いは持ち場なのか──\n":15,"彼":16,"女":17,"等の動向と関係があるのか、\nそれはまだ──[l]\nチズルは介抱されて休んでいます。[l]\n大事ないようで、間もなく覚醒するでしょうが、」":18,"「……んむ……[l]\nキリアケは無事なんだな？[l]\n具足の事もあるししっかりして貰いたいんだが、\n四重奏団の件も問題だ。[l]\nどうしたものか──」":19,"「……フェンリロス、使用要請しますか？」":20,"「……向こうと此処じゃ遠すぎて負荷がかかるだろうが、[l]\nやむなしだな、\n出来そうなら頼んでみて」":21,"「了解です、暫しお待ちを」":22,"「………カレ、[l]\nワタシです。[l]\nええ、………」":23,"「……あいつか？[l]\nあの女がここにきて何かしようって？[l]\n……やれるものならやってみるがいい、[l]\n今の、[l]\n……宮は、[l]ちょお不機嫌です……[l]\n後悔、[l]させて、[l]あげます──」":24,"「そうです、[l]\n構いません、[l]\n──フェンリロスの検索使用を許可する」":25,"「………どうだって？」":26,"「少々お待ちください……なんです、どうしました」":27,"「……みっ、[l]『":28,"検索に":29,"引っ掛』かりません、[l]\nいません、あの四人が、\n消失……いえ、[l]その、[l]\n視えない点が不自然に在るわけではないので、[l]\nジャムと言うよりはディスガイズの方か、それとも、[l]\n……あ、[l]それ以前の話です、[l]ね、[l]\nこ、[l]この状況が起こってる時点で、[l]言えるのは、」":30,"「……いえ、[l]結構、お疲れ様です。[l]\n何かありましたら連絡を、そちらもこちらにね。[l]\nでは。[l]\n──聞こえておいでですね？[l]\nお察しの通り、恐らくは、」":31,"「……ノート・デューだな？」":32,"「……Kaleidoのフェンリロスの眼を":33,"躱せるのは、[l]\n現存の遣い手の中では、」":34,"「あいつと、\nあの巫山戯たＣＡＴジャバンダスウォナッチアだけだ。[l]\n……う、く、」":35,"「……」":36,"「──うひひ。[l]\nくふ、ふひひひひ。[l]\n漸く、[l]\n動いてくれたか。[l]\n御陰でこちらも、":37,"この苛立ちを存分にお前にぶつけてやれるというもの、":38,"……一応確認しておいてやるが──[l]\n当然あの女にも連絡はつかないな？」":39,"「そう……ですね」":40,"みぃぃいいいいいいいぃぃぃんん。":41,"「ばっちり眠ったおかげで、\nこっちのほうはもう万端、[l]\n……何をするつもりかは知らないが、[l]\nこの私には指一本も差させない。[l]\n文字通り触れさせることもない」":42,"「奴等は放置しろ！[l]\nどうせ祭儀の際に割り込む気だろうよ、[l]\nそうでなくとも必ず捜し出し追撃してやるさ、[l]\nいいだろう、[l]\nああ、[l]\nそうか、[l]\nうひひ、[l]\nハッ！[l]\nここへ来てのその造反、":43,"好き余興じゃないか！！！[l]\n":44,"獲":45,"物は多ければ多い程面白い！！！！[l]\n今やあれ":46,"等は我等が敵だ。[l]\n八相連中の祭儀もミリアムもその残党共も、[l]\nＧＷも四重奏団もあの女も！！！[l]\n片端から私が壊してみせようじゃないか！！！[l]\n下界の祭は夕刻からとして、\n連中の祭儀儀礼は深夜0:00きっかりあの山で始まる筈だな？[l]\n知狡の復調を急げ、\nフハイらにも本来の稼働をさせろ。[l]\nさあ、[l]\n狩りをはじめるぞ！！！」":47,"「……そして、」":48,"まこくん、だけは、私が、私の、[l]\n──大事な獲物だから、[l]\nかならずつかまえて、[l]\n囁いてあげる、[l]その頸根っこを掴んで、[l]\n地べたに押し倒し抑え付け、[l]\nその":49,"耳":50,"朶を":51,"咬みながら、[l]\nイってあげる──ITISTOOLATENOW……[l]\nだってまこくんは私の……[l]ですもんね？":52,"「……それで、彼は、」":53,"「君に任せた。[l]\n必ず連れて私の前に、猟場に、引き出して。[l]\n勿論正装の方、お願いするよ。[l]\n私は先に出るから──ごめん、\nもう、大人しくなんかしてられないんだよ。[l]\n頭冷やすのも兼ねて、私は先に、向こうで待ってる。[l]\n猟場でまた会おう。[l]\nその為にも知狡の事、宜しく頼む」":54,"「──了解しました。[l]\nああ、[l]\n残留組の管理はしっかり禅に言い置いておきましょう。[l]\n彼等にまで手が及んでいる事も──」":55,"「改宗組は危険かも知れないが、\n……最悪の事態が起きても、[l]\n禅のペンパラミータなら何とかなる。[l]\nNK-ABとESSもいざとなれば調伏できるキャパもある、\n問題があるとすれば、」":56,"「スロタラスモルト、\nアイドリングさせたのは早計でしたか」":57,"「……いや、あれこそ兄様が密に設計した、[l]\n上意に沿うRulerOnlyだし、\n遣い手自身を弄った所であまり関係は無い……筈だ。[l]\nそれに、\n禅で対応が全く出来ない訳でもない、[l]\n……犠牲は強いるかもだが、致し方ないな。[l]\n大事ないよ、大事ないさ。[l]\nともあれESSは兎も角も、NKは後始末に必要だ。[l]\nおかしな事があれば即時修正対応をするように伝えて」":58,"「解りました」":59,"「……まこくんのこと、頼んだよ。[l]\nじゃあ、\n楽しい夜を」":60,"「……貴女も、どうか、[l]\nどうかご自愛なさいませ」":61,"貴女とともに、[l]\nどうか、あのものにも、[l]\n楽しき夜であるように、":62,"Omegaの瞳の──":63},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_060.ks","relPath":"/data/scenario/SC_E_060.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":62,"length":64,"percent":96.875},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[47,1]},"/data/scenario/SC_E_061.ks":{"data":[["「いよいよ明日よ、\n下の方の準備は問題無いとして、\n……憂慮すべきは本祭儀ね、[l]\nそんな状態で大丈夫なの？[l]\n貴女」","「终于到明天了，\n下层准备没有问题，\n……值得忧虑的是主祭仪呢，[l]\n那种状态真的不要紧吗？[l]\n您」"],["「……正直、[l]かなりきつい……[l]ですけど」","「……说实话，[l]相当吃力……[l]呢」"],["「今回だけよ、\n今回さえ乗り切れば──」","「就这一次，\n只要撑过这次──」"],["「……わか……[l]ってます、[l]わかってますが、」","「……明白……[l]的，[l]明白的，」"],["「ああ、僕がフォローしますから、\n貴女は他の事務仕事、お願いしますよ。[l]\nほら、行こうかミコ」","「啊啊，我会善后，\n其他事务工作就拜托您了。[l]\n来，走吧卑尊」"],["「じゃあ頼むわよ。[l]\n実際忙しいのよ私も──」","「那就交给你了。[l]\n实际上我也忙得──」"],["「トモ……」","「冬夏……」"],["「………。[l]\n行かれたか。[l]\nふむ……[l]\nああは言っても結局は下界の事すら全て人任せさ。[l]\nあのヒトはね」","「………。[l]\n已经走了吗。[l]\n嗯……[l]\n嘴上那么说结果连下界的事都全推给别人。[l]\n那个人啊」"],["「……？」",""],["「冬夏君の事はウチの","「冬夏君的事由我们"],["刀","刀"],["自殿に任せきり、\n姫様君の事も克杖君の事も、\n此度の最たる功労者たるミコに対して、\n労いの言葉も無いとはね、\n『人の上に立つ者』としての資質なぞ欠片も持ち合わせんのだろう。[l]\n『人の上に立ちたい者』の資質には恵まれているようだがな。[l]\n今あの人の頭には、\nミリアムに対しての御機嫌買いの事しかない。[l]\n……ふむ、[l]\n相変わらずということだ、\nあの俗物は」","全权交给自殿处理，\n无论是姫様大人您的事还是克杖大人的事，\n对于此次最大的功臣卑尊，\n居然连句慰劳的话都没有，\n『作为上位者』的资质怕是半点都不具备吧。[l]\n不过倒是很符合『想成为上位者之人』的资质呢。[l]\n现在那个人满脑子都是\n讨好米莉安姆的事。[l]\n……哼，[l]\n果然还是老样子，\n那个庸俗之徒」"],["「……？！[l]\nあんたいきなり何を言って、」","「……？！[l]\n你突然说什么呢，"],["「聞こえやしないよ。[l]\nそれにミコも、\nそう思ってる筈だな？[l]\nあんなモノの為に己がこんなにも、\n苦しんでいるのに、\n……なあ？[l]\n思ってるだろ？[l]\n●しない者は能無しだ。[l]\n●を●かぬ屑が。[l]\nお前などに仕切れる訳がないんだよ。[l]\n虫酸が走る。[l]\n──ああ、可哀想なミコ、我が友よ、\n僕はキミを憐れまざるを得ない。[l]\nあんな、Ｐの体現者のような屑に、\n………。[l]\nああ、こうしてアレの事を話すコト自体が、\n大変に不愉快だ」","「根本听不见啊。[l]\n而且卑尊应该\n也是这么想的吧？[l]\n为了那种货色让自己\n痛苦到这种地步，\n……对吧？[l]\n你也是这么想的吧？[l]\n●不了的人就是废物。[l]\n连●都●不了的渣滓。[l]\n怎么可能被你这种人指手画脚。[l]\n令人作呕。[l]\n──啊啊，可怜的卑尊，我的挚友啊，\n我不得不怜悯你。[l]\n那种宛如P化身的垃圾，\n………。[l]\n啊啊，光是谈论那个东西本身，\n就令人极度不快」"],["「……あんたねえ、[l]\n……ピーってなによ？」","「……我说你啊，[l]\n……哔——到底是什么？」"],["「ま、\n本来あの手の●●は黙ってたって淘汰されるもんだがね。[l]\nどうにも要らぬ横車を押してきた存在が──","「嘛，\n本来那种●●就算放着不管也会被淘汰。[l]\n偏偏有个多管闲事的家伙横插一脚——"],["尤も、\n御陰で今の僕等があるというジレンマは抗しえぬ事実……[l]\nしかし、それも、\nいずれ","不过，\n托他的福才有现在的我们...这种矛盾确实无法否认……[l]\n但是，\n只要再忍耐"],["場が変わるまで今少しの辛抱だ。[l]\n不要のモノどもは一掃されて、\n愉悦の劇がはじまる」","到局势改变就好。[l]\n等多余的家伙都被清除，\n愉悦的戏剧就会开场」"],["「……何言ってるの？[l]\nこの期に及んで、\nいえ、祭儀を明日に控えて、\n……最近、","「……胡说什么呢？[l]\n都到这个节骨眼了，\n不，明天就是祭仪了，\n……最近，"],["怪","很"],["訝しいわ、貴女、[l]\nこないだも急にヘンな","你很可疑啊，[l]\n之前还突然说些奇怪的"],["譬え話をしたり──」","比喻——」"],["「僕はみんなを愛したい。[l]\n誰かさんは狂気と捉えるかも知れないが、\n別の誰かさんのように、\n僕は──\nいや、言うまい。[l]\n言って解るものでもない、\n解られても困る、といえば困るしね」","「我想爱所有人。[l]\n或许某人会认为这是疯狂，\n但就像另一个某人那样，\n我——\n不，还是不说了。[l]\n说了也不明白，\n被理解了反而麻烦」"],["「どうしたのよ……あんたがおかしいのは知ってたけど、[l]\nこの頃は特にヘンよ、\n私より、あんたの方がツかれてんでしょ、\n禁級も続いてたし……聞いてんの？」","「怎么了……虽然知道你不太正常，[l]\n最近特别古怪，\n比起我，你才是崩溃的那个吧，\n连续禁级也……有在听吗？」"],["「──だが、\n愛せない存在もいる。[l]\nアイするモノを愛し続けるには●●て貰わねばならぬ、\nそういう存在が、……」","「──但是，\n也有无法去爱的存在。[l]\n要继续爱能●之物就必须●●掉，\n就是这样的存在……」"],["「ちょっと、\n……あんた、まさか」","「喂、\n……你该不会」"],["「──ふむ？[l]\nああ、勿論冗談だよ。[l]\nふぅ、\nミコの言うとおり、\nツかれてもいるし、\n本番を前に緊張してるかも知れないなあ。[l]\nだから、先刻の暴言、内密に頼むよ。[l]\n人はストレスに","「──嗯？[l]\n啊，当然是开玩笑的。[l]\n呼、\n正如卑尊所说、\n我也确实累坏了、\n可能是正式上场前太紧张了吧。[l]\n所以刚才的胡话，请帮我保密哦。[l]\n人一旦被"],["晒されるとどうにも、\n凶暴性が増すよね。[l]\nリミットも外れてしまうし──\nほら、実際にかのミリアム御嬢様も、\n永年のストレスから解放されて、\nすっかり立ち振る舞いから喋り口調まで、\n優雅な風にお戻りになられただろ。[l]\n追い詰められたり余裕が無い時ってのは、\nやはり本性が……いやさ優先順位が入れ替わるんだな。[l]\nまあ、\nかのお方にも本来ならまだ、\n懸念すべき事はあるんだろうがね、\nまずはガワから換えてみるのも、\n案外効果的な場合があるってことかな。[l]\nさ、[l]\nじゃあ僕等も休もうか、[l]\nおっとその前に」","压力笼罩就会、\n变得特别暴躁呢。[l]\n连限制器都会失效──\n你看，实际上那位米莉安姆大小姐、\n从长年压力中解放后、\n从举止仪态到说话腔调、\n不是完全恢复优雅做派了吗。[l]\n被逼到绝境或失去余裕时、\n果然本性就会……不该说优先顺序会重组呢。[l]\n不过、\n那位大人原本应该、\n还有值得忧虑的事、\n但先从表象着手改变、\n意外地会很有效哦。[l]\n好了、[l]\n那我们也休息吧、[l]\n啊对了在此之前」"],["「何よ、[l]\n私が今どういう状態か──」","「干嘛、[l]\n我现在什么状态──」"],["「ほら、一応、ある程度は体力を回復出来るだろう。[l]\n僕に出来る事は、\n精精がこれくらいだ」","「瞧，至少能恢复些体力吧。[l]\n我能做到的、\n也就这种程度了」"],["「……これ、キサムラで？」","「……这是用奇萨姆拉？」"],["「まあ、ミコのナガヒサの代替だよ。[l]\n所詮は一時凌ぎだが、\n無茶さえしなければ明日一日は何とか保つだろう。[l]\n全てが終わったら、\nそれからゆっくりと休むがいいよ。[l]\nだから、頑張れ」","「算是卑尊的纳伽希萨的替代品吧。[l]\n终究是权宜之计、\n只要别乱来应该能撑到明天。[l]\n等一切结束后、\n再好好休息也不迟。[l]\n所以，加油」"],["「……ありがたく受け取らせて、貰うわ、[l]\n実際あの方の","「……感激不尽收下了、[l]\n实际上那位大人的"],["Ａ",""],["Ａは、\n相当きつかった、し──」","A、\n确实相当够呛呢──」"],["「冬夏君のイレギュラーな事故さえ無ければね。[l]\nもう少しはマシだったのだろうが」","「要是冬夏君没出意外的话。[l]\n本可以更轻松些的」"],["「……ホントにそうよ……[l]それこそそっちの……[l]\n刀自殿が、余計な事言うから、[l]あの子も余計な──」","「……真是的……[l]都怪那边……[l]\n刀自大人多嘴、[l]那孩子才多管──」"],["「まあ、そう言わないで呉れ給え。[l]\nあれでもウチのトップだし、\n最古参だからねえ。[l]\nミリアムとは付き合いも長いし、\n彼女の為を思っての事だろうさ。[l]\nまあ、\nそう言う意味では姫様君は可哀想だが、\n十八二式で今の所は安定してる、\n明日何があってもあの子が、\nあの子達が対応してくれるさ」","「哎呀，别这么说嘛。[l]\n她好歹是我们首领、\n又是最年长的。[l]\n和米莉安姆交情也深、\n想必是出于好意吧。[l]\n不过、\n从这个角度说姫様确实可怜、\n但十八二式目前很稳定、\n明天无论发生什么那孩子、\n那群孩子都会处理的」"],["「……ほんとうに、」","「……真的能、」"],["「ふむ？」","「嗯？」"],["「明日の──[l]\n……今回の……祭が終わったら……[l]\n全て、良い方へ向かうのかしら、[l]\nわたしたち──」","「明天的──[l]\n……这次……祭典结束后……[l]\n一切，都会变好吧、[l]\n我们──」"],["「勿論だよ。[l]\n今回ですべてが","「当然啦。[l]\n这次就会全部"],["篩","筛"],["に","从"],["か","今"],["け","往"],["ら","后"],["れて──」","就──」"],["「……やっぱり、[l]\nあんたの口からじゃ、\nその気になんないわ……[l]\nじゃ、これ、ありがと……」","「……果然，[l]\n从你嘴里说出来，\n我就提不起劲呢……[l]\n那、这个、谢啦……」"],["「ああ、ゆっくり休んで呉れ給え、\n僕も野暮用を済ませてから休むとするよ──」","「啊啊，好好休息吧，\n我也等办完俗务后歇着──」"],["「ああ、なんて、\n……この日をどれほど待ったことか、[l]\n眉目麗しゅう、マスター、やはりあなたこそが」","「啊啊、何等、\n……我等待这一天究竟多久了，[l]\n眉目如画的主人，果然唯有您才配得上」"],["「……ありがとう。[l]\nでもこれははじまりにすぎない、\n……あとは、私のいとしきひとの、[l]\n血をまもるための、\nそして──」","「……谢谢。[l]\n但这不过是开端，\n……接下来，是为了守护我挚爱之人的，[l]\n血脉而战，\n然后──」"],["「復讐ですかいな？」","「复仇是吗？」"],["「……まさか、[l]\nこれは、\nまるで、生き写しだ、あの──」","「……怎么可能，[l]\n这简直是，\n活脱脱的翻版，那个──」"],["「……ああ、[l]しんじられ、[l]ない、[l]あのこ、」","「……啊啊，[l]难以置信，[l]那个孩子，」"],["ドレミリア・リデル──","德蕾米莉娅・利德尔──"],["「まあ、\nご覧の通り、この冬夏ちゃんは、\nあんさんが復興の旗印にするにはもってこいの、\n御容姿でらっしゃいますなぁ。[l]\nま、実際の直系の裔でもありますしね、\nあん時から長いこと、\n今までだぁいじに、この三春の血筋、\nお護り通して来た甲斐があるいうもんですわ。[l]\nただ、\n老婆心ながら言わして貰いますけど、\nそんな益にならんことよりも、\nほれ、\nこの子と静かぁに、\n心やすらかに暮らすいうんも、\n悪くないでしょうにねぃ、」","「哎呀，\n如您所见，这位冬夏小姐，\n正是阁下复兴大业最理想的，\n形象代言人呢。[l]\n况且她确实是直系后裔，\n自那时起漫长岁月，\n至今都精心维护着这三春血脉，\n总算没白费功夫呢。[l]\n只是，\n容老婆子多嘴一句，\n比起那些没益处的事，\n喏，\n和这孩子平静地，\n过些安稳日子，\n不也挺好吗？」"],["あの頃のように、ですよぅ。","就像那时候一样呀。"],["「……お前に、何がわかる、[l]\nベロア達がどれだけ、\nあいつらに、\nそれに、そのための明日だ、今更、\nお前なんかに、」","「……你懂什么，[l]\n贝萝娅她们遭受了，\n那些家伙多少，\n更何况，为此准备的明日就在眼前，事到如今，\n岂容你这种人──」"],["「そんなに眼くじら立てんでも。[l]\nいっとうお付き合いの長いウチのこと、\nほんまに信用してくれませんですなあ、\nベロアちゃんは──」","「别瞪那么大眼睛嘛。[l]\n咱们打交道这么久，\n您还真信不过老身，\n贝萝娅小姐她──」"],["「……っ、」","「……啧」"],["「ベロア、大人しくなさい」","「贝萝娅，安分点」"],["「マスターミリアム、ベロアは、」","「主人米莉安姆，贝萝娅她」"],["「ええですよぅ、\nじゃあ冬夏ちゃんと一緒にここは退場しましょ。[l]\nあとは明日の──」","「好嘞好嘞，\n那冬夏小姐咱们就先退场吧。[l]\n剩下的明天再──」"],["「……とっとと去ね」","「……赶紧滚」"],["「ベロア」","「贝萝娅」"],["「ほんま怖いですなぁベロアちゃんは。[l]\n冬夏ちゃん、ほな行きましょ」","「贝萝娅小姐真吓人呢。[l]\n冬夏小姐，咱们走咯」"],["「……ごめんなさい、マスターミリアム、[l]\nでも、」","「……对不起，主人米莉安姆，[l]\n但是，」"],["「わかってるわ、ベロア」","「我明白的，贝萝娅」"],["「うん……でも、[l]\nでもそれに、あのこは、もう、」","「嗯……但是、[l]\n但是除此之外，那孩子已经，」"],["「わかってる、[l]\nわかってるのよ、[l]\nあのこは、[l]\nあのことは違う、でも──」","「我知道、[l]\n我知道的、[l]\n那孩子、[l]\n那件事是不同的，但是──」"]],"context":[["SC_E_061.ks/index/1/text"],["SC_E_061.ks/index/3/text"],["SC_E_061.ks/index/5/text"],["SC_E_061.ks/index/7/text"],["SC_E_061.ks/index/9/text"],["SC_E_061.ks/index/11/text"],["SC_E_061.ks/index/13/text"],["SC_E_061.ks/index/15/text"],["SC_E_061.ks/index/17/text"],["SC_E_061.ks/index/19/text"],["SC_E_061.ks/index/21/text"],["SC_E_061.ks/index/23/text"],["SC_E_061.ks/index/25/text"],["SC_E_061.ks/index/27/text"],["SC_E_061.ks/index/29/text"],["SC_E_061.ks/index/31/text"],["SC_E_061.ks/index/33/text"],["SC_E_061.ks/index/35/text"],["SC_E_061.ks/index/37/text"],["SC_E_061.ks/index/39/text"],["SC_E_061.ks/index/41/text"],["SC_E_061.ks/index/43/text"],["SC_E_061.ks/index/45/text"],["SC_E_061.ks/index/47/text"],["SC_E_061.ks/index/49/text"],["SC_E_061.ks/index/51/text"],["SC_E_061.ks/index/53/text"],["SC_E_061.ks/index/55/text"],["SC_E_061.ks/index/57/text"],["SC_E_061.ks/index/59/text"],["SC_E_061.ks/index/61/text"],["SC_E_061.ks/index/63/text"],["SC_E_061.ks/index/65/text"],["SC_E_061.ks/index/67/text"],["SC_E_061.ks/index/69/text"],["SC_E_061.ks/index/71/text"],["SC_E_061.ks/index/73/text"],["SC_E_061.ks/index/75/text"],["SC_E_061.ks/index/77/text"],["SC_E_061.ks/index/79/text"],["SC_E_061.ks/index/81/text"],["SC_E_061.ks/index/83/text"],["SC_E_061.ks/index/85/text"],["SC_E_061.ks/index/87/text"],["SC_E_061.ks/index/89/text"],["SC_E_061.ks/index/91/text"],["SC_E_061.ks/index/93/text"],["SC_E_061.ks/index/95/text"],["SC_E_061.ks/index/97/text"],["SC_E_061.ks/index/99/text"],["SC_E_061.ks/index/101/text"],["SC_E_061.ks/index/103/text"],["SC_E_061.ks/index/105/text"],["SC_E_061.ks/index/107/text"],["SC_E_061.ks/index/109/text"],["SC_E_061.ks/index/111/text"],["SC_E_061.ks/index/113/text"],["SC_E_061.ks/index/115/text"],["SC_E_061.ks/index/117/text"],["SC_E_061.ks/index/119/text"],["SC_E_061.ks/index/121/text"],["SC_E_061.ks/index/123/text"],["SC_E_061.ks/index/125/text"],["SC_E_061.ks/index/127/text"],["SC_E_061.ks/index/129/text"],["SC_E_061.ks/index/131/text"],["SC_E_061.ks/index/133/text"],["SC_E_061.ks/index/135/text"],["SC_E_061.ks/index/137/text"],["SC_E_061.ks/index/139/text"],["SC_E_061.ks/index/141/text"]],"tags":[],"parameters":[[{"start":156,"end":234}],[{"start":264,"end":289}],[{"start":320,"end":344}],[{"start":374,"end":401}],[{"start":432,"end":489}],[{"start":520,"end":549}],[{"start":579,"end":585}],[{"start":616,"end":693}],[{"start":723,"end":728}],[{"start":759,"end":769}],[{"start":779,"end":780}],[{"start":790,"end":1015}],[{"start":1045,"end":1072}],[{"start":1103,"end":1399}],[{"start":1429,"end":1457}],[{"start":1488,"end":1550}],[{"start":1561,"end":1619}],[{"start":1631,"end":1683}],[{"start":1713,"end":1767}],[{"start":1776,"end":1777}],[{"start":1786,"end":1812}],[{"start":1822,"end":1832}],[{"start":1863,"end":1982}],[{"start":2012,"end":2102}],[{"start":2133,"end":2203}],[{"start":2233,"end":2254}],[{"start":2285,"end":2412}],[{"start":2422,"end":2750}],[{"start":2780,"end":2805}],[{"start":2836,"end":2891}],[{"start":2921,"end":2934}],[{"start":2965,"end":3082}],[{"start":3112,"end":3145}],[{"start":3155,"end":3156}],[{"start":3167,"end":3187}],[{"start":3218,"end":3264}],[{"start":3294,"end":3354}],[{"start":3385,"end":3570}],[{"start":3623,"end":3633}],[{"start":3664,"end":3669}],[{"start":3699,"end":3768}],[{"start":3799,"end":3820}],[{"start":3829,"end":3830}],[{"start":3839,"end":3840}],[{"start":3849,"end":3850}],[{"start":3859,"end":3860}],[{"start":3869,"end":3870}],[{"start":3879,"end":3884}],[{"start":3914,"end":3977}],[{"start":4008,"end":4050}],[{"start":4126,"end":4186}],[{"start":4216,"end":4297}],[{"start":4324,"end":4334}],[{"start":4410,"end":4449}],[{"start":4479,"end":4508}],[{"start":4562,"end":4573}],[{"start":4615,"end":4885}],[{"start":4919,"end":4932}],[{"start":4975,"end":5051}],[{"start":5078,"end":5157}],[{"start":5185,"end":5191}],[{"start":5221,"end":5234}],[{"start":5262,"end":5278}],[{"start":5305,"end":5357}],[{"start":5385,"end":5395}],[{"start":5425,"end":5430}],[{"start":5457,"end":5497}],[{"start":5557,"end":5588}],[{"start":5618,"end":5630}],[{"start":5658,"end":5689}],[{"start":5719,"end":5776}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_061.ks","basename":"SC_E_061.ks","indexIds":{"「いよいよ明日よ、\n下の方の準備は問題無いとして、\n……憂慮すべきは本祭儀ね、[l]\nそんな状態で大丈夫なの？[l]\n貴女」":0,"「……正直、[l]かなりきつい……[l]ですけど」":1,"「今回だけよ、\n今回さえ乗り切れば──」":2,"「……わか……[l]ってます、[l]わかってますが、」":3,"「ああ、僕がフォローしますから、\n貴女は他の事務仕事、お願いしますよ。[l]\nほら、行こうかミコ」":4,"「じゃあ頼むわよ。[l]\n実際忙しいのよ私も──」":5,"「トモ……」":6,"「………。[l]\n行かれたか。[l]\nふむ……[l]\nああは言っても結局は下界の事すら全て人任せさ。[l]\nあのヒトはね」":7,"「……？」":8,"「冬夏君の事はウチの":9,"刀":10,"自殿に任せきり、\n姫様君の事も克杖君の事も、\n此度の最たる功労者たるミコに対して、\n労いの言葉も無いとはね、\n『人の上に立つ者』としての資質なぞ欠片も持ち合わせんのだろう。[l]\n『人の上に立ちたい者』の資質には恵まれているようだがな。[l]\n今あの人の頭には、\nミリアムに対しての御機嫌買いの事しかない。[l]\n……ふむ、[l]\n相変わらずということだ、\nあの俗物は」":11,"「……？！[l]\nあんたいきなり何を言って、」":12,"「聞こえやしないよ。[l]\nそれにミコも、\nそう思ってる筈だな？[l]\nあんなモノの為に己がこんなにも、\n苦しんでいるのに、\n……なあ？[l]\n思ってるだろ？[l]\n●しない者は能無しだ。[l]\n●を●かぬ屑が。[l]\nお前などに仕切れる訳がないんだよ。[l]\n虫酸が走る。[l]\n──ああ、可哀想なミコ、我が友よ、\n僕はキミを憐れまざるを得ない。[l]\nあんな、Ｐの体現者のような屑に、\n………。[l]\nああ、こうしてアレの事を話すコト自体が、\n大変に不愉快だ」":13,"「……あんたねえ、[l]\n……ピーってなによ？」":14,"「ま、\n本来あの手の●●は黙ってたって淘汰されるもんだがね。[l]\nどうにも要らぬ横車を押してきた存在が──":15,"尤も、\n御陰で今の僕等があるというジレンマは抗しえぬ事実……[l]\nしかし、それも、\nいずれ":16,"場が変わるまで今少しの辛抱だ。[l]\n不要のモノどもは一掃されて、\n愉悦の劇がはじまる」":17,"「……何言ってるの？[l]\nこの期に及んで、\nいえ、祭儀を明日に控えて、\n……最近、":18,"怪":19,"訝しいわ、貴女、[l]\nこないだも急にヘンな":20,"譬え話をしたり──」":21,"「僕はみんなを愛したい。[l]\n誰かさんは狂気と捉えるかも知れないが、\n別の誰かさんのように、\n僕は──\nいや、言うまい。[l]\n言って解るものでもない、\n解られても困る、といえば困るしね」":22,"「どうしたのよ……あんたがおかしいのは知ってたけど、[l]\nこの頃は特にヘンよ、\n私より、あんたの方がツかれてんでしょ、\n禁級も続いてたし……聞いてんの？」":23,"「──だが、\n愛せない存在もいる。[l]\nアイするモノを愛し続けるには●●て貰わねばならぬ、\nそういう存在が、……」":24,"「ちょっと、\n……あんた、まさか」":25,"「──ふむ？[l]\nああ、勿論冗談だよ。[l]\nふぅ、\nミコの言うとおり、\nツかれてもいるし、\n本番を前に緊張してるかも知れないなあ。[l]\nだから、先刻の暴言、内密に頼むよ。[l]\n人はストレスに":26,"晒されるとどうにも、\n凶暴性が増すよね。[l]\nリミットも外れてしまうし──\nほら、実際にかのミリアム御嬢様も、\n永年のストレスから解放されて、\nすっかり立ち振る舞いから喋り口調まで、\n優雅な風にお戻りになられただろ。[l]\n追い詰められたり余裕が無い時ってのは、\nやはり本性が……いやさ優先順位が入れ替わるんだな。[l]\nまあ、\nかのお方にも本来ならまだ、\n懸念すべき事はあるんだろうがね、\nまずはガワから換えてみるのも、\n案外効果的な場合があるってことかな。[l]\nさ、[l]\nじゃあ僕等も休もうか、[l]\nおっとその前に」":27,"「何よ、[l]\n私が今どういう状態か──」":28,"「ほら、一応、ある程度は体力を回復出来るだろう。[l]\n僕に出来る事は、\n精精がこれくらいだ」":29,"「……これ、キサムラで？」":30,"「まあ、ミコのナガヒサの代替だよ。[l]\n所詮は一時凌ぎだが、\n無茶さえしなければ明日一日は何とか保つだろう。[l]\n全てが終わったら、\nそれからゆっくりと休むがいいよ。[l]\nだから、頑張れ」":31,"「……ありがたく受け取らせて、貰うわ、[l]\n実際あの方の":32,"Ａ":33,"Ａは、\n相当きつかった、し──」":34,"「冬夏君のイレギュラーな事故さえ無ければね。[l]\nもう少しはマシだったのだろうが」":35,"「……ホントにそうよ……[l]それこそそっちの……[l]\n刀自殿が、余計な事言うから、[l]あの子も余計な──」":36,"「まあ、そう言わないで呉れ給え。[l]\nあれでもウチのトップだし、\n最古参だからねえ。[l]\nミリアムとは付き合いも長いし、\n彼女の為を思っての事だろうさ。[l]\nまあ、\nそう言う意味では姫様君は可哀想だが、\n十八二式で今の所は安定してる、\n明日何があってもあの子が、\nあの子達が対応してくれるさ」":37,"「……ほんとうに、」":38,"「ふむ？」":39,"「明日の──[l]\n……今回の……祭が終わったら……[l]\n全て、良い方へ向かうのかしら、[l]\nわたしたち──」":40,"「勿論だよ。[l]\n今回ですべてが":41,"篩":42,"に":43,"か":44,"け":45,"ら":46,"れて──」":47,"「……やっぱり、[l]\nあんたの口からじゃ、\nその気になんないわ……[l]\nじゃ、これ、ありがと……」":48,"「ああ、ゆっくり休んで呉れ給え、\n僕も野暮用を済ませてから休むとするよ──」":49,"「ああ、なんて、\n……この日をどれほど待ったことか、[l]\n眉目麗しゅう、マスター、やはりあなたこそが」":50,"「……ありがとう。[l]\nでもこれははじまりにすぎない、\n……あとは、私のいとしきひとの、[l]\n血をまもるための、\nそして──」":51,"「復讐ですかいな？」":52,"「……まさか、[l]\nこれは、\nまるで、生き写しだ、あの──」":53,"「……ああ、[l]しんじられ、[l]ない、[l]あのこ、」":54,"ドレミリア・リデル──":55,"「まあ、\nご覧の通り、この冬夏ちゃんは、\nあんさんが復興の旗印にするにはもってこいの、\n御容姿でらっしゃいますなぁ。[l]\nま、実際の直系の裔でもありますしね、\nあん時から長いこと、\n今までだぁいじに、この三春の血筋、\nお護り通して来た甲斐があるいうもんですわ。[l]\nただ、\n老婆心ながら言わして貰いますけど、\nそんな益にならんことよりも、\nほれ、\nこの子と静かぁに、\n心やすらかに暮らすいうんも、\n悪くないでしょうにねぃ、」":56,"あの頃のように、ですよぅ。":57,"「……お前に、何がわかる、[l]\nベロア達がどれだけ、\nあいつらに、\nそれに、そのための明日だ、今更、\nお前なんかに、」":58,"「そんなに眼くじら立てんでも。[l]\nいっとうお付き合いの長いウチのこと、\nほんまに信用してくれませんですなあ、\nベロアちゃんは──」":59,"「……っ、」":60,"「ベロア、大人しくなさい」":61,"「マスターミリアム、ベロアは、」":62,"「ええですよぅ、\nじゃあ冬夏ちゃんと一緒にここは退場しましょ。[l]\nあとは明日の──」":63,"「……とっとと去ね」":64,"「ベロア」":65,"「ほんま怖いですなぁベロアちゃんは。[l]\n冬夏ちゃん、ほな行きましょ」":66,"「……ごめんなさい、マスターミリアム、[l]\nでも、」":67,"「わかってるわ、ベロア」":68,"「うん……でも、[l]\nでもそれに、あのこは、もう、」":69,"「わかってる、[l]\nわかってるのよ、[l]\nあのこは、[l]\nあのことは違う、でも──」":70},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_061.ks","relPath":"/data/scenario/SC_E_061.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":69,"length":71,"percent":97.1830985915493},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[67,1]},"/data/scenario/SC_E_062.ks":{"data":[["価無ちゃんの仕込みもすんだ、","价无的准备工作也完成了、"],["冬夏ちゃんの仕込みもすんだ。","冬夏的准备工作也完成了。"],["……ああ、[l]\nあん子に創らせとったあれが、[l]\nまだやったかしらん。","……啊啊、[l]\n让那丫头做的东西、[l]\n不知道搞定了没。"],["睡臥ノ神、すいがのかみ……と。","睡卧之神，suiga no kami……么。"],["ああ、これで万事問題無し。","啊啊，这样万事俱备。"],["あとは──","接下来──"],["あとは、","接下来、"],["あの子の為の最後の仕込みだ。","是为那孩子做的最后准备了。"],["長かったね、音。[l]\nこれでも僕はキミをずっと愛してきたし、\nこれからもそうだよ。[l]\nよりよき未来が君に訪れますように。","真漫长啊，音。[l]\n即便如此我也一直爱着你、\n今后也会继续爱你。[l]\n愿你迎来更美好的未来。"],["じゃああとは自分の力で、","之后就靠你自己的力量、"],["頑張れ──","加油吧──"],["頑張って、きーちゃ、[l]\nもう少しの辛抱、[l]\nの筈、だから、","加油啊，小姬、[l]\n再忍耐一会儿、[l]\n本应如此，所以、"],["……、",""],["兄ぃ、何してるかな……[l]\n大丈夫かな、","哥哥，现在在做什么呢……[l]\n应该没事吧、"],["あいたいな、[l]\nいろいろ、終わったら、","好想见你啊、[l]\n等一切结束后、"],["みんなで──","大家就──"],["皆様、","诸位、"],["準備は宜しいか。","准备妥当了吗。"],["●●しき劇もいよいよ山場です。","●●式剧也终于迎来高潮。"],["最後の幕が上がれば、","当最后的帷幕升起时、"],["それぞれの役を演じ切るのみ。","只需演好自己的角色。"],["そう、御随意に。","是的，请随意。"],["のびやかに。","尽情舒展。"],["如何に振る舞い、どう抗おうとも。","无论怎样表现，如何抵抗。"],["キ","机"],["カイ","会"],["ジカ","自"],["ケ","己"],["の","的"],["カ","捉"],["ミが、","把握、"],["必ずや。","必定。"],["ゴウインになろうと、決着を付けてくれます。","会做个了断，哪怕成为业因。"],["厄を怨ずるは、","怨恨灾厄者、"],["またのキカイに──","终将再逢机缘──"]],"context":[["SC_E_062.ks/index/1/text"],["SC_E_062.ks/index/3/text"],["SC_E_062.ks/index/5/text"],["SC_E_062.ks/index/7/text"],["SC_E_062.ks/index/9/text"],["SC_E_062.ks/index/11/text"],["SC_E_062.ks/index/13/text","SC_E_062.ks/index/43/text"],["SC_E_062.ks/index/15/text"],["SC_E_062.ks/index/17/text"],["SC_E_062.ks/index/19/text"],["SC_E_062.ks/index/21/text"],["SC_E_062.ks/index/23/text"],["SC_E_062.ks/index/25/text","SC_E_062.ks/index/29/text"],["SC_E_062.ks/index/27/text"],["SC_E_062.ks/index/31/text"],["SC_E_062.ks/index/33/text"],["SC_E_062.ks/index/35/text"],["SC_E_062.ks/index/37/text"],["SC_E_062.ks/index/39/text"],["SC_E_062.ks/index/41/text"],["SC_E_062.ks/index/45/text"],["SC_E_062.ks/index/47/text"],["SC_E_062.ks/index/49/text"],["SC_E_062.ks/index/51/text"],["SC_E_062.ks/index/53/text"],["SC_E_062.ks/index/55/text"],["SC_E_062.ks/index/57/text"],["SC_E_062.ks/index/59/text"],["SC_E_062.ks/index/61/text"],["SC_E_062.ks/index/63/text"],["SC_E_062.ks/index/65/text"],["SC_E_062.ks/index/67/text"],["SC_E_062.ks/index/69/text"],["SC_E_062.ks/index/71/text"],["SC_E_062.ks/index/73/text"]],"tags":[],"parameters":[[{"start":181,"end":195}],[{"start":205,"end":219}],[{"start":225,"end":270}],[{"start":276,"end":291}],[{"start":297,"end":310}],[{"start":316,"end":321}],[{"start":359,"end":363},{"start":838,"end":842}],[{"start":373,"end":387}],[{"start":393,"end":468}],[{"start":474,"end":486}],[{"start":517,"end":522}],[{"start":565,"end":606}],[{"start":616,"end":619},{"start":660,"end":663}],[{"start":625,"end":650}],[{"start":669,"end":694}],[{"start":704,"end":710}],[{"start":750,"end":753}],[{"start":783,"end":791}],[{"start":797,"end":812}],[{"start":818,"end":828}],[{"start":852,"end":866}],[{"start":872,"end":880}],[{"start":886,"end":892}],[{"start":898,"end":914}],[{"start":930,"end":931}],[{"start":941,"end":943}],[{"start":953,"end":955}],[{"start":965,"end":966}],[{"start":976,"end":977}],[{"start":986,"end":987}],[{"start":997,"end":1000}],[{"start":1010,"end":1014}],[{"start":1020,"end":1041}],[{"start":1047,"end":1054}],[{"start":1064,"end":1073}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_062.ks","basename":"SC_E_062.ks","indexIds":{"価無ちゃんの仕込みもすんだ、":0,"冬夏ちゃんの仕込みもすんだ。":1,"……ああ、[l]\nあん子に創らせとったあれが、[l]\nまだやったかしらん。":2,"睡臥ノ神、すいがのかみ……と。":3,"ああ、これで万事問題無し。":4,"あとは──":5,"あとは、":6,"あの子の為の最後の仕込みだ。":7,"長かったね、音。[l]\nこれでも僕はキミをずっと愛してきたし、\nこれからもそうだよ。[l]\nよりよき未来が君に訪れますように。":8,"じゃああとは自分の力で、":9,"頑張れ──":10,"頑張って、きーちゃ、[l]\nもう少しの辛抱、[l]\nの筈、だから、":11,"……、":12,"兄ぃ、何してるかな……[l]\n大丈夫かな、":13,"あいたいな、[l]\nいろいろ、終わったら、":14,"みんなで──":15,"皆様、":16,"準備は宜しいか。":17,"●●しき劇もいよいよ山場です。":18,"最後の幕が上がれば、":19,"それぞれの役を演じ切るのみ。":20,"そう、御随意に。":21,"のびやかに。":22,"如何に振る舞い、どう抗おうとも。":23,"キ":24,"カイ":25,"ジカ":26,"ケ":27,"の":28,"カ":29,"ミが、":30,"必ずや。":31,"ゴウインになろうと、決着を付けてくれます。":32,"厄を怨ずるは、":33,"またのキカイに──":34},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_062.ks","relPath":"/data/scenario/SC_E_062.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":34,"length":35,"percent":97.14285714285714},"cellInfo":[]},"/data/scenario/SC_E_063.ks":{"data":[["「……陽が落ちたか。[l]\n下界夜の部も21:00には落ち着く、\nそうしたら、」","「……太阳落山了啊。[l]\n下界夜间部21:00前会平静下来、\n到那时，」"],["「──フハイ全動か」","「──全腐启动」"],["「ああ、[l]チズル、もういいのですか？[l]\n倒れた原因、そして今まで何があったのかは──\n訊かない方が良いんでしょうね、\nその顔からすると」","「啊啊，[l]小知，已经可以了吗？[l]\n倒下的原因，以及至今发生的事──\n还是不要问比较好吧、\n看你这副表情」"],["「……とうに察しているのだろう？[l]\nそういう、事だ──それより」","「……早就察觉到了吧？[l]\n就是这么，回事──比起这个」"],["「ワタシの不肖の部下の面倒もみてくれたようで、\nお礼申し上げますよ。[l]\nああ、……こちらも色々ありまして。[l]\n今の今まで只管待機していました。[l]\n待っていたのですよ、彼が、」","「看来你照顾了我那不成器的手下、\n在此谢过。[l]\n啊啊，……我们这边也发生了不少事。[l]\n直到刚才都只是在待命。[l]\n一直在等着，他啊，」"],["「……真言は、[l]\n宮さんの所へ向かった。[l]\n具足も記憶も、十全でな。[l]\nそれより、私も現場に向かいたい、\n何かあったら後を頼みたいのだが」","「……真言是、[l]\n往宫小姐那边去了。[l]\n装备和记忆都完好无损。[l]\n比起这个、我也想去现场、\n若有个万一希望能托付后事」"],["「アナタが？[l]\nＣＡＴも無いのに？」","「您去？[l]\n连CAT都没有的情况下？」"],["「いざとなればキリアケがある」","「紧急时刻还有切明可用」"],["「……アナタではキリアケとの親和が低く、[l]\n言いたくはないですが足手まといになりますよ。[l]\nいえ──[l]その前に、\n彼はキリアケも持たずに？」","「……您与切明的亲和度太低、[l]\n虽不愿明说但会成为累赘的。[l]\n不──[l]在那之前、\n他连切明都没带就？」"],["「……ああ、そうだ」","「……啊啊、没错」"],["「………………。[l]\nまあ、[l]\nどっちでもいいんですがね。[l]\nいずれにしても、\n矢張り勧めませんよ」","「………………。[l]\n嘛、[l]\n其实怎样都无所谓啦。[l]\n无论如何、\n果然还是不推荐呢」"],["「何もせずに、じっとしていろと？」","「要我什么都不做、干等着吗？」"],["「……気持ちはよく分かりますが、[l]\nアナタのそういう行動は、\n俗に言う死亡フラグという奴でしてね。[l]\n端から視ていると手に取るように判るのですよ、\n『この人物は死ぬ』んだと、\n愚挙をやらかすぞと、\n蔑まれ嘲笑われますよ。[l]\n岡目八目じゃありませんが、\n視界が狭くなってはいけません。[l]\n重ねて言いますが、気持ちは分かりますけれどね」","「……您的心情我很理解、[l]\n但您那样的行动、\n正是俗称的死亡flag啊。[l]\n旁观者清得简直像摆在眼前、\n『这人要死了』啦、\n『要干蠢事』啦、\n会被轻蔑嘲笑的哦。[l]\n不是当局者迷、\n视野可不能变狭窄了。[l]\n再次声明、我完全理解您的心情呢」"],["「………」",""],["「それに、[l]\n甘やかすような弱い存在では最早無いでしょう。[l]\n彼は」","「况且、[l]\n他早已不是需要娇惯的弱者了。[l]\n那个孩子」"],["「……",""],["現","现"],["実のように、[l]\n信じて、[l]\n座して待てと……」","像实那样、[l]\n相信他、[l]\n静候佳音吧……」"],["「どうあれ、\n独りで乗り越えねばならぬ局面なのですよ。[l]\n我々が出来るのは水面下のフォローです。[l]\n表立った手助けは──そう、\nその為にわざわざ姿を晒してまで此の地に来た、\nイツワの魂の双子オウトも居るのでしょう。[l]\n","「无论如何、\n这都是必须独自跨越的局面。[l]\n我们能做的只有暗中支援。[l]\n明面上的帮助──没错、\n为此甚至不惜暴露行踪来到此地、\n不是还有伊兹瓦的灵魂双生子欧托在吗。[l]\n"],["彼の者の成すままに」","交由那位处置便好」"],["「……」",""],["「我が身可愛さで言ってる訳じゃありませんよ。[l]\nただ、\n身の丈に合わぬ行為は、\n本人だけでなく周囲にも影響を及ぼす事がままある、\nという事です。[l]\n","「绝非出于贪生怕死才这么说。[l]\n只是、\n超出能力范围的行为、\n往往不仅影响本人更会波及周遭、\n就是这个道理。[l]\n"],["実との落差を把握し、\n適当な判断をなして貰う事が、\n肝要です」","认清与实的差距、\n做出恰当判断、\n才是关键」"],["「……しかし」","「……可是」"],["「彼が戻って来るときに、\n帰ってきてもいい場所、[l]\n居てもいい場所、それを守るのも、\n立派な助けであり救いですよ、チズル」","「当他归来之时、\n守住能回得去的地方、[l]\n容得下他的位置、这也算是、\n了不起的帮助与救赎啊、小知」"],["「……そうか……」","「……这样啊……」"],["「駄目押しさせて貰えるならば、\n──そうですね、\n好意が仇なすこともあるのですよ。[l]\n殊、当人に何の了承も得ない場合はね」","「若允许我多嘴一句、\n──这么说吧、\n善意有时也会酿成恶果。[l]\n尤其当未获本人首肯之时呢」"],["「……わかったよ、[l]\nだが、何かあったら、……どうか、[l]\nあの子を頼む。[l]\n頼む相手を間違えているかも知れないが──」","「……明白了、[l]\n但若有个万一、……拜托了、[l]\n那孩子就交给你了。[l]\n或许我托付错了对象也说不定──」"],["「前言いませんでしたかね、[l]\nワタシも彼の事は──[l]ええ、[l]\nですからご心配は無用です。[l]\nというよりも……彼に確りして貰う事が、[l]\nひいてはあの方の為にもなるのですよ。[l]\nそう言う意味ではワタシはぶれてはいませんし、\nどちら側にだけつく、と言ったような、\n知狡が考えている修羅場を望んではいませんよ、\nワタシとしてもね。[l]\nまあ、どうとってもらっても構いませんが、」","「之前不是说过吗，[l]\n我也对他──[l]嗯，[l]\n所以请不用担心。[l]\n倒不如说……让他振作起来，[l]\n最终也会成为那位大人的助力哦。[l]\n从这个意义上来说我并没有动摇，\n也不会只偏袒某一方，\n更不会如知狡所想的那样期待修罗场，\n至少我是这么想的。[l]\n嘛，您怎么理解都无所谓，」"],["「……いや、いいんだ。[l]\n信頼している。[l]\nただ、もどかしいだけなんだ、\nそれだけだ……」","「……不，没事。[l]\n我相信你。[l]\n只是，有点焦躁而已，\n仅此罢了……」"],["「……まあ、[l]\nそうでなくても、\nまだチズルは万全の体調とは言い難く視えますよ。[l]\nどうしても力になりたいのなら、\nまずは休む事です」","「……嘛，[l]\n就算不是这样，\n小知现在的身体状况也说不上万全吧。[l]\n如果真想帮忙的话，\n首先该好好休息」"],["「……ああ。[l]\nわかった──」","「……啊。[l]\n明白了──」"],["「……汝の望む祝福あれ」","「……愿汝得偿所愿」"],["「ワタシが引きずり出すまでもなく、\n劇への登場を決意した、\n機械仕掛けの神……[l]\nそれが舞台に上がる事は即ち、[l]\n──時間[l]か」","「无需我强行拖拽，\n已决心登上戏剧舞台的，\n机械构造的神明……[l]\n其登台之时即是，[l]\n──时间[l]吗」"],["「フハイ全動を通告。[l]\n終幕の──」","「腐坏全开通告。[l]\n终幕的──」"],["開","开"],["宴。","宴。"]],"context":[["SC_E_063.ks/index/1/text"],["SC_E_063.ks/index/3/text"],["SC_E_063.ks/index/5/text"],["SC_E_063.ks/index/7/text"],["SC_E_063.ks/index/9/text"],["SC_E_063.ks/index/11/text"],["SC_E_063.ks/index/13/text"],["SC_E_063.ks/index/15/text"],["SC_E_063.ks/index/17/text"],["SC_E_063.ks/index/19/text"],["SC_E_063.ks/index/21/text"],["SC_E_063.ks/index/23/text"],["SC_E_063.ks/index/25/text"],["SC_E_063.ks/index/27/text"],["SC_E_063.ks/index/29/text"],["SC_E_063.ks/index/31/text"],["SC_E_063.ks/index/33/text","SC_E_063.ks/index/47/text"],["SC_E_063.ks/index/35/text"],["SC_E_063.ks/index/37/text"],["SC_E_063.ks/index/40/text"],["SC_E_063.ks/index/42/text"],["SC_E_063.ks/index/44/text"],["SC_E_063.ks/index/49/text"],["SC_E_063.ks/index/51/text"],["SC_E_063.ks/index/53/text"],["SC_E_063.ks/index/55/text"],["SC_E_063.ks/index/57/text"],["SC_E_063.ks/index/59/text"],["SC_E_063.ks/index/61/text"],["SC_E_063.ks/index/63/text"],["SC_E_063.ks/index/65/text"],["SC_E_063.ks/index/67/text"],["SC_E_063.ks/index/69/text"],["SC_E_063.ks/index/71/text"],["SC_E_063.ks/index/73/text"],["SC_E_063.ks/index/75/text"],["SC_E_063.ks/index/77/text"]],"tags":[],"parameters":[[{"start":177,"end":225}],[{"start":255,"end":265}],[{"start":316,"end":400}],[{"start":430,"end":468}],[{"start":497,"end":606}],[{"start":636,"end":727}],[{"start":756,"end":780}],[{"start":810,"end":825}],[{"start":854,"end":942}],[{"start":972,"end":982}],[{"start":1011,"end":1082}],[{"start":1112,"end":1129}],[{"start":1158,"end":1368}],[{"start":1398,"end":1403}],[{"start":1432,"end":1478}],[{"start":1508,"end":1511}],[{"start":1521,"end":1522},{"start":1924,"end":1925}],[{"start":1531,"end":1566}],[{"start":1595,"end":1730}],[{"start":1743,"end":1753}],[{"start":1783,"end":1787}],[{"start":1816,"end":1910}],[{"start":1935,"end":1974}],[{"start":2004,"end":2011}],[{"start":2040,"end":2115}],[{"start":2145,"end":2154}],[{"start":2183,"end":2258}],[{"start":2288,"end":2365}],[{"start":2394,"end":2628}],[{"start":2658,"end":2719}],[{"start":2748,"end":2835}],[{"start":2865,"end":2886}],[{"start":2938,"end":2950}],[{"start":3014,"end":3100}],[{"start":3183,"end":3207}],[{"start":3270,"end":3271}],[{"start":3281,"end":3283}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_063.ks","basename":"SC_E_063.ks","indexIds":{"「……陽が落ちたか。[l]\n下界夜の部も21:00には落ち着く、\nそうしたら、」":0,"「──フハイ全動か」":1,"「ああ、[l]チズル、もういいのですか？[l]\n倒れた原因、そして今まで何があったのかは──\n訊かない方が良いんでしょうね、\nその顔からすると」":2,"「……とうに察しているのだろう？[l]\nそういう、事だ──それより」":3,"「ワタシの不肖の部下の面倒もみてくれたようで、\nお礼申し上げますよ。[l]\nああ、……こちらも色々ありまして。[l]\n今の今まで只管待機していました。[l]\n待っていたのですよ、彼が、」":4,"「……真言は、[l]\n宮さんの所へ向かった。[l]\n具足も記憶も、十全でな。[l]\nそれより、私も現場に向かいたい、\n何かあったら後を頼みたいのだが」":5,"「アナタが？[l]\nＣＡＴも無いのに？」":6,"「いざとなればキリアケがある」":7,"「……アナタではキリアケとの親和が低く、[l]\n言いたくはないですが足手まといになりますよ。[l]\nいえ──[l]その前に、\n彼はキリアケも持たずに？」":8,"「……ああ、そうだ」":9,"「………………。[l]\nまあ、[l]\nどっちでもいいんですがね。[l]\nいずれにしても、\n矢張り勧めませんよ」":10,"「何もせずに、じっとしていろと？」":11,"「……気持ちはよく分かりますが、[l]\nアナタのそういう行動は、\n俗に言う死亡フラグという奴でしてね。[l]\n端から視ていると手に取るように判るのですよ、\n『この人物は死ぬ』んだと、\n愚挙をやらかすぞと、\n蔑まれ嘲笑われますよ。[l]\n岡目八目じゃありませんが、\n視界が狭くなってはいけません。[l]\n重ねて言いますが、気持ちは分かりますけれどね」":12,"「………」":13,"「それに、[l]\n甘やかすような弱い存在では最早無いでしょう。[l]\n彼は」":14,"「……":15,"現":16,"実のように、[l]\n信じて、[l]\n座して待てと……」":17,"「どうあれ、\n独りで乗り越えねばならぬ局面なのですよ。[l]\n我々が出来るのは水面下のフォローです。[l]\n表立った手助けは──そう、\nその為にわざわざ姿を晒してまで此の地に来た、\nイツワの魂の双子オウトも居るのでしょう。[l]\n":18,"彼の者の成すままに」":19,"「……」":20,"「我が身可愛さで言ってる訳じゃありませんよ。[l]\nただ、\n身の丈に合わぬ行為は、\n本人だけでなく周囲にも影響を及ぼす事がままある、\nという事です。[l]\n":21,"実との落差を把握し、\n適当な判断をなして貰う事が、\n肝要です」":22,"「……しかし」":23,"「彼が戻って来るときに、\n帰ってきてもいい場所、[l]\n居てもいい場所、それを守るのも、\n立派な助けであり救いですよ、チズル」":24,"「……そうか……」":25,"「駄目押しさせて貰えるならば、\n──そうですね、\n好意が仇なすこともあるのですよ。[l]\n殊、当人に何の了承も得ない場合はね」":26,"「……わかったよ、[l]\nだが、何かあったら、……どうか、[l]\nあの子を頼む。[l]\n頼む相手を間違えているかも知れないが──」":27,"「前言いませんでしたかね、[l]\nワタシも彼の事は──[l]ええ、[l]\nですからご心配は無用です。[l]\nというよりも……彼に確りして貰う事が、[l]\nひいてはあの方の為にもなるのですよ。[l]\nそう言う意味ではワタシはぶれてはいませんし、\nどちら側にだけつく、と言ったような、\n知狡が考えている修羅場を望んではいませんよ、\nワタシとしてもね。[l]\nまあ、どうとってもらっても構いませんが、」":28,"「……いや、いいんだ。[l]\n信頼している。[l]\nただ、もどかしいだけなんだ、\nそれだけだ……」":29,"「……まあ、[l]\nそうでなくても、\nまだチズルは万全の体調とは言い難く視えますよ。[l]\nどうしても力になりたいのなら、\nまずは休む事です」":30,"「……ああ。[l]\nわかった──」":31,"「……汝の望む祝福あれ」":32,"「ワタシが引きずり出すまでもなく、\n劇への登場を決意した、\n機械仕掛けの神……[l]\nそれが舞台に上がる事は即ち、[l]\n──時間[l]か」":33,"「フハイ全動を通告。[l]\n終幕の──」":34,"開":35,"宴。":36},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_063.ks","relPath":"/data/scenario/SC_E_063.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":34,"length":37,"percent":91.8918918918919},"cellInfo":[]},"/data/scenario/SC_E_064.ks":{"data":[["「……まあ、[l]\n家とかに確認するまで、\n放っておこう。[l]\n怖すぎる」","「……算了，[l]\n在向家里确认之前，\n先放着别管吧。[l]\n太吓人了」"],["「んー、まあ、\nそれが無難だよね」","「嗯——嘛，\n这样最稳妥呢」"],["後で電話してみるー、と言って、\n冬夏はお風呂の準備をしに行った。","说着「待会儿打个电话——」，\n冬夏去准备洗澡水了。"],["僕はその箱を、\n押し入れの奥へと仕舞い込む。[l]\n流石に捨ててしまうのには気が引けた。","我把那个盒子，\n塞进了壁橱深处。[l]\n终究还是没忍心扔掉。"],["が、","但，"],["──きっと、[l]\nこのまま、放置することになるだろう。[l]\nそんな気がする。","──想必，[l]\n就这样搁置下去吧。[l]\n我有这种预感。"],["真神の御陰で、\n前から書籍には通じてたとしても、[l]\n加えて僕もそっち系のＤＶＤやらフィギュアだの、\n買うようになった。[l]\n宅配の人と馴染みになったのも結局それも大きいのだが、\nそうしてると、たまに古い、\nオタ的視点では観てなかったアニメだの、\n今になってＢＯＸで出るのにも、\n手を出したりはする、","托真神的福，\n虽说以前就熟悉书籍类，[l]\n后来连DVD和手办之类的，\n我也开始买了。[l]\n和快递员混熟说到底也是这个缘故，\n这么一来，偶尔会碰到些，\n从宅系视角漏看的古老动画，\n或是如今推出BOX版的，\n也会忍不住入手，"],["するけど、","会买，"],["記憶の美化による修正、[l]\nそれが虚飾だったと気付くのが、幻滅するのが、[l]\n怖くて、[l]\n結局部屋の棚に並べるだけで満足するが多くなった。","但害怕记忆的美化修正，[l]\n害怕发现那只是虚饰后的幻灭，[l]\n所以，[l]\n最后往往只满足于摆在房间架子上。"],["箱は開けずとも、[l]\n所持してる事で僕の心は満たされると言うか、[l]\n蒐集者の業とでも言おうか、[l]\n中に何が入ってるか、[l]\nというよりは、[l]\n","即便不打开箱子，[l]\n光是拥有这件事就足以填满我的心，[l]\n或者说这是收藏家的宿命吧，[l]\n里面装着什么，[l]\n倒不如说，[l]\n"],["目","用目"],["録を埋めるという感覚こそが大事なのだ。","录填满的感觉才是最重要的。"],["閉じた箱をわざわざ開けて、[l]\n自分から辛い思いをするなんて、[l]\nそんな選択は怖くて出来ない。","特意打开封闭的箱子，[l]\n主动去承受痛苦这种事，[l]\n这么可怕的选择我可做不到。"],["箱の中の●が生きてるのか死んでるのか、","箱子里的●是死是活，"],["箱を開けようとするから問題になる。","正因为想打开箱子才会成为问题。"],["開けなければ、永遠に未確定のままだ。","若不打开，就永远保持不确定状态。"],["どっちつかずでいいじゃないか。","悬而未决不也挺好吗。"],["どっちだっていいじゃないか。","是哪种都无所谓吧。"],["卑怯で臆病なのかも知れないが、","或许这是懦弱又胆小的表现，"],["忘却とは優しさだ。","遗忘即是温柔。"],["真実とは、\nきっとそんなにいいものじゃない。","所谓真相，\n肯定不是什么美好的东西。"],["♂と♀が永遠に、[l]\n解り合える事無く、[l]\n勘違いしたままでも、[l]\n愛し合い、[l]\n寄り添っていけるのは、","♂与♀永远[l]\n无法相互理解，[l]\n即便持续误解着，[l]\n也能相爱，[l]\n相互依偎，"],["やはり先刻思った通り、[l]\n互いに互いの全てを知り得ないからだと思うから──","果然如方才所想，[l]\n正是因为彼此永远无法知晓对方的全部──"],["「なあ、冬夏」","「呐，冬夏」"],["戻って来た冬夏を真正面から見て、\n僕は言った。","我直视着回到身边的冬夏，\n开口说道。"],["「ん？」","「嗯？」"],["「あいしてる、[l]ずっと、[l]これからもきみを」","「我爱你，[l]永远，[l]今后也会一直爱着你」"],["「ぶっ、[l]\nあ、[l]あああっ？！[l]\nな、[l]な、[l]\n……えへへへへ」","「噗、[l]\n啊、[l]啊啊啊？！[l]\n你、[l]你、[l]\n……嘿嘿嘿嘿」"],["僕は、[l]\n或るひとには言えなかった、[l]\n届かなかった言葉を──","我，[l]\n没能对某个人说出口的，[l]\n未能传达的话语──"],["僕には確か、そんなひとがいて、[l]\nそのひとに僕は恋をして、","我确实曾有那样一个人，[l]\n我曾爱恋着那个人，"],["でもそれは終わったこと。","但都已成为过往。"],["「……ん、[l]\nま、色々言いたい事あるけど、\n今は素直に受け取っておきます。[l]\n私も愛してる。[l]\n大好き、まことさん」","「……嗯，[l]\n嘛、虽然有很多想说的话，\n现在先坦率地收下吧。[l]\n我也爱你。[l]\n最喜欢你了，真言先生」"],["「ありがとう。[l]\n……さーて、[l]\n一緒に風呂っすか」","「谢谢。[l]\n……那么，[l]\n一起洗澡呗」"],["「……えろめ！[l]\nまだ沸いてません！！」","「……色鬼！[l]\n水还没烧好呢！！」"],["「あーそらそうか。[l]\nあ、折角だからスク水でも着て貰おうかのう、\nげへへへへ」","「啊～这样啊。[l]\n啊、难得机会不如穿学校泳装吧，\n咯咯咯咯」"],["「……。[l]\n……いいよ、いいけど」","「……。[l]\n……可以啊，也不是不行」"],["「うむ。にゃんだね？」","「嗯。怎么啦？」"],["「わかってるでしょ、ばか！[l]\nえろめ！！[l]\nさ、さっきのほら、因ちゃんとかみてたらさ？[l]\nわっ、私も、その、は、早く、」","「你明明知道的吧笨蛋！[l]\n色鬼！！[l]\n刚、刚才你看因酱她们的时候？[l]\n我、我也、那个、想、早点、」"],["「……了解」","「……了解」"],["夜は始まり、そしてまた明けていく。","夜幕降临，而后再度破晓。"],["僕等はこうして、","我们就这样，"],["T",""],["h",""],["e",""],["y",""],["l",""],["i",""],["v",""],["d",""],["a",""],["ppily ever after.",""],["\n\n\n\n\n\n\n",""],["...",""],["Ha",""],["pp",""],["yE",""],["nd",""],["in",""],["g",""]],"context":[["SC_E_064.ks/index/1/text"],["SC_E_064.ks/index/3/text"],["SC_E_064.ks/index/5/text"],["SC_E_064.ks/index/7/text"],["SC_E_064.ks/index/9/text"],["SC_E_064.ks/index/11/text"],["SC_E_064.ks/index/13/text"],["SC_E_064.ks/index/15/text"],["SC_E