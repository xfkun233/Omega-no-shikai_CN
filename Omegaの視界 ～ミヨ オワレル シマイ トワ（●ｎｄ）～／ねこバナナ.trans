9480}],[{"start":9490,"end":9527}],[{"start":9535,"end":9602}],[{"start":9654,"end":9711}],[{"start":9719,"end":9744}],[{"start":9773,"end":9833}],[{"start":9889,"end":9936}],[{"start":10004,"end":10014}],[{"start":10043,"end":10072}],[{"start":10100,"end":10138}],[{"start":10167,"end":10215}],[{"start":10223,"end":10268}],[{"start":10276,"end":10372}],[{"start":10400,"end":10441}],[{"start":10449,"end":10518}],[{"start":10526,"end":10532}],[{"start":10558,"end":10604}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_023.ks","basename":"SC_S_023.ks","indexIds":{"@r気付いたらここに来るなんて、\n\n焼きが回ったのかねェ。":0,"@r最近……調子が悪かったからなァ。":1,"@rなにがどうって訳じゃねェけど、\n\nそういう時もあるぁ。":2,"@r現実にこんな時が来るとは思わなかったが、\n\n思い出したくない沢山の昔の中で、\n\nあの時のあれだけは、":3,"\nまあ、\n\n面白ぇ、良いとき、\n\n持ち続けたいと思える記憶──":4,"\n迷ってはいない。":5,"\n迷ってはいないが、\n\n怖さと、絶望と、諦めと、寂しさと、\n\n少しだけの期待、":6,"\nぜんぶおわることへの、\n\nらくに、":7,"\n………。":8,"@r………、":9,"@r………………、":10,"@r……、":11,"@r………？":12,"@r何だアレは。":13,"@rねこ……なのか？":14,"@r知ってるのとは少し違う……":15,"@rあ？":16,"@rまさかあれが『連中』なのか？":17,"「ｖ☆が場を展開しました」":18,"「ババはAnchor作成完了」":19,"「フロスの":20,"繋":21,"縛鎖ＯＫ」":22,"「テトのシガン開放、S→Pアイドリング完了」":23,"@r？":24,"@r何を言ってんのかわかん":25,"「じゃ撃ちます」":26,"@rねえぞ？！！！":27,"@rっんだ？！":28,"@rあれぁ、\n@r──彼奴のアレみたいなやつ、か！！":29,"@rだったら避けるしかねぇッ！[l]\nあんなもんまたぞろ刺されたら七面倒くせ──":30,"@r@rひぃぃぃぃよおぉおぉぉぉぉぉおうううぅぅぅぅ。":31,"「……おや」":32,"………。":33,"@rっぶねえな、\n@rんだ":34,"彼":35,"奴":36,"等？！[l]\n問答無用ってことかよッ。":37,"@r聞いてはいたがマジでクソ共だな。":38,"@r畜生、\n@rどうするっ、逃げるか？！":39,"@r返り討ちに……できるか？":40,"@rああもう、彼奴に連絡しても役に立たねェだろうし──":41,"「ｇｊ……ならずか」":42,"「だが回避したと言うことは、\n視えてるにせよ感じたにせよ、\nノーマルではない事が確定した。[l]\nGWかどうかはまだ別だが」":43,"@r独りでやるしかねェか、病み上がりだってのによぅ、\n仕方ね、極力逃げながら、":44,"@r──なんだ？":45,"@rなんなんだよ？":46,"@r糞ッ、何かあンのは分かるが、\nさっきのとは違ってカタチが視えねー、":47,"@rもじゃもじゃしやがって、\n@r俺が●●だからかよッ。":48,"@rこんな時にまで邪魔しやがって、\n@r恨むぞこのミ──":49,"「セオリーじゃないが、\n繋縛からアンカーの流れで」":50,"「了解」":51,"「はやくはやくはやく」":52,"「はいはいは」":53,"@rい？":54,"@r何か来る、今度は追っかけてきやが──":55,"@r@rあ゛？！":56,"@rわかんねー、わかんねーけど何かに巻かれてる、のか？！":57,"@r動けねーぞッ、この、\nがあああああああああああ！！！！！！":58,"「繋縛完了」":59,"「ｇｊ」":60,"「ｇｊ、\nふひひひひひ、\nテト、じゃあGWにarchiveが効くかどうか──\nやってみよーか」":61,"「効かなかったらどうする気だよ」":62,"「最悪チノのペイルホワイト招請して、\n改宗なりなんなりするしかないな、\nおっと取り敢えずAnchor再作成開始」":63,"@r俺をどうする気だ此奴等ッ、\n畜生、遠くから卑怯な真似しやがって、":64,"@rがぁああああああああああああ、":65,"@r糞が、糞が、糞が！！！！！！":66,"@r邪魔だ邪魔だ邪魔だ邪魔だ邪魔だ邪魔なんだよッ、":67,"@rキサマラみてぇなおたかくとまってえらぶってジコノユウイセイのために\n俺を虚仮にしてきたあの糞等みてーーーーーなカスぁァッ！！！":68,"@rが、あ、あ、あ、あああああ、":69,"@rあは、\n@rあはははははあははあはあははははは！！！！！！":70,"@rあはははははははははははははははははははははっ、\n@rもう、知らねぇぞ、":71,"@rもう知らねぇぞ！！！！！！":72,"@rもう知らねぇぞ全部だ貴様ら！！！！！！":73,"@r全部だ貴様ラぁああああああ、\n@r──喰ってやる、喰ってやる、喰ってやる、":74,"@r──喰い殺す、くいころす、クイコロス、\n@r──邪魔モノにはぁ、":75,"@r……報いあれ、ムクイあれ、":76,"@r六　玖　威　ああああああれえエエエエッ、\n@rミ・タサンコネミャルコネタサ・ワ！":77,"@rミ・カヤキャツタサ・ワ！！":78,"@rミ・アメタサナサキャキャラキャタサ・ワ！！！":79,"「………？」":80,"「Anchor作成完了……？[l]\nあ？」":81,"「おいおい、な、んだあれは」":82,"「Ｙの同…か？[l]\nこれが、Moon=Calfか！！[l]\n現物は久しく視てなかったが、\nあれは、よりにもよって、」":83,"@r@rかふぁっ。":84,"「なに、あの口、顔か？[l]\nふぇ、PHASE:6ぅっ？！[l]\nいあ、なになになに！？」":85,"@r@rおわああああああああ。":86,"「お嬢？[l]\nテトどうしたっ？！」":87,"「っによこれっ、ScanningErrorだっ！！[l]\nテトッどうしたよっ？！":88,"ああああああああ、\nあいつフォーマットが違い過ぎてマクロが使えないのかっ、\n駄目だ時間が掛かり過ぎるっ！！[l]\nアイッ！！！」":89,"「Ironは場の展開中で反応出来ない！[l]\nお嬢、落ち着け！！」":90,"@rかはぁっ。":91,"@rがぁぁぁぁぁあぁあぁ……るるるるるるるるる、\n@rぐぞう、ほんき出させやがってぇえ、\n@rはらがはらがへるだろぅが！！":92,"@rがる、がるるるうるるううう、\n@rなんだかぁじらねえがぁ、\n@rごれもアレなんだろうガァ。":93,"@rヅまり、":94,"@r喰えば、":95,"「":96,"拙いぞ、\nサクラ、\n拘束解け。[l]\nねこ引っ込めろ」":97,"「あ゛ァッ？！[l]\n──っあ、そういう事か」":98,"「テトっ！！[l]\nあああもう、\nアイーっ！！！」":99,"「そしたらすぐ口枷だ……否、駄目か、[l]\n再起動されたら同じだな。[l]\n出来るのかどうかは分からんが。[l]\n自制出来てはいないようにも視える……しかし」":100,"「………」":101,"「ここで賭けには出られねーわな、\nと、取り敢えず喰われるよりはマシだろっ。[l]\n解除す」":102,"@r@rむぁしゃ。":103,"@rぐしゃばすがしゅぎちゅくちゃかさかさかさかさ、\n@rんにゅる。":104,"「──ぁ、や、うあ」":105,"@rごふぁ。がふっ。":106,"@r……ミになっデグ感じヴァズるが、[l]\n旨ぐはねェな。":107,"「っちッ！[l]\n喰いやがった、":108,"縛鎖部だけだが、\nPHASE:6がまともに動いてるとしたら、」":109,"@rなるヴォど、\nゴれが、\nクイか、クウというゴとか。":110,"@rクってワガミにすることか。":111,"@rかふぁ。":112,"@rくふぇ。":113,"@rくふ。":114,"@rくふはっ。":115,"@rくはははははは、\n@rくはははははは、\n@rくはははははは。":116,"@r遣い手を喰ったところで意味は無いが、\nコウスレバ、":117,"@rあの時は失敗したがこういう事ダナ？":118,"@rただ、\n@rがふっ、\n@r消化と吸収には、\n@r良くナサソウダワなァ。":119,"@rアトナンマイモクワナイ\nトイケナイノニサキガオ\nモイヤラレルノダ───":120,"@rだから今回はここまでにしとくサァ、\n@r遣り方は分かったからナ──":121,"「あんな不完全なPHASE:6では恐らく\n完全に喰うまでの能力はない！[l]\nAnchorを撃ったら撤退するぞ！」":122,"「…っくしょう！[l]\nなんだ彼奴は！！[l]\n放置しろだ！？[l]\n今まで野放しだったのか？！":123,"よく今まで潜伏出来てたな、\n冗談じゃないぜ、\nPHASE:6のGWなんて危険極まりねぇ……」":124,"「だからそもそも手出し無用だったんだろ、\nお嬢を配した司書長の意図は不明だが、\n今そんな事を言ってる場合じゃない。":125,"あんな目立つ姿ではヤツも無茶は出来ない、\n我々が引けば追撃もないだろう。":126,"PHASE:2も無ければ4も無いんだ、\nフロシルクの繋縛鎖はまだ使えようもない、\nそのうちに」":127,"「…仕方ねぇ、[l]\nまずは、\n──Ironとお嬢を何とかしねぇと、\nお嬢！！」":128,"「あああああああのやろうううううううううううう！！！[l]\nなんなんだてめーーーーーーーーーーーーはぁっ！！！！！！！！！":129,"調子にのってんじゃねぇあ！！！！！！[l]\n大人しく狩られろド畜生が！！！！！！！！！」":130,"「馬鹿野郎！！[l]\n『Ig:Type･Eは四重奏団の布陣が完全でないと遣えない』\nんだろうが！！":131,"しかも相手は６のGWだ！！[l]\n喰われたら仕舞いだぞ！！！！[l]\n十全以上のGWなんて魔眼のさ──」":132,"「逃げた」":133,"「あ？」":134,"「すまん。[l]\nAnchorも撃てていない」":135,"「あっ！？[l]\nお嬢……あ、アイ」":136,"「ご迷惑を……お掛けしました。[l]\nお嬢も」":137,"「いや、いいんだけどよ……[l]\n寧ろお嬢大丈夫か？[l]\n今何したんだ？」":138,"「場は解除して……すぐ向かいましょう。[l]\nお嬢が気付く前に」":139,"「あ？[l]\nあ、ああ……フロスも損傷受けたしな……[l]\n兎に角、とっとと店長やチノと合流して、\n事の次第を話さにゃ」":140,"「今ｖ☆を箒にします」":141,"「バックアップ人員が真っ先に交戦して損害被るとぁ、\nどやされっかな……誰にって話だが……」":142,"「向こうに存在を知られたまま逃がしたのは、\n少々問題かもな。[l]\nミリアムと繋がっていない筈ではあるから、\nそこは救いだが──」":143,"「いずれ今回の劇を予定通り進めるには──」":144,"「店長がいる限り結果としての負けはないだろうが、\n":145,"脚":146,"本は修正……否、ネタバレの方向になるか、[l]\nそれこそ、」":147,"「deus ex machinaによる……あ？[l]\nんなぁ、」":148,"「準備出来ました。[l]\n急ぎましょう」":149,"「お嬢は任せろ。[l]\nフロシルクの修復も懸案事項だが今は後だ」":150,"「厄介な事になったぜ……[l]\n置いてきた連中にも合わす顔がねぇな……」":151,"「いきます」":152,"「畜生……」":153,"@r………。":154,"@r追ってはこねェか。":155,"@r畜生が、折角調子戻ったってのにげほっ、":156,"@rまあ、\n@r喰ったモノがミになれば、\n@r少しはヤクにたつか。":157,"@rしょうがねえ、まずは連絡して──\n@r──また……やすまねぇと……":158,"@r……の日までには……万全に……":159,"@rそして……":160,"「……気持ちが悪い」":161,"「……？」":162,"騒":163,"騒する、落ち着かない、\n『あの時』と同じ感じがする、\n全身が厭なものにまとわりつかれて、":164,"ささくれ立つような、":165,"苛":166,"苛するような、\n":167,"昂":168,"揚するような、\nああ、いやだ、白の連中のあの、\n感じ……？":169,"わからない……ああ、もうベロアの肉、[l]\nもう少しだけでいい、あああ、\nもどかしい、もどかしいよマスターミリアムっ」":170,"奴を気にしすぎて気が立っているのさね、\nもう少しの辛抱だよ、\n今はまだ──大人しくしてるが好いよ。":171,"可愛いベロア、あと少しだ、\n祭儀まで──」":172,"「マスターミリアム……[l]\n早く御力になりたい、\n御身を護るチカラを取り戻したい、\n早く──」":173,"「そう、だから、\n祭儀の日までには、万全にしておくんだよ。[l]\nそして──」":174,"「どうしましたぁ？」":175,"「……なんか気持ち悪い。[l]\n風邪ひぃたんかな」":176,"「夜も遅ぅまで起きてるからですよぅ。[l]\n今晩はもう早うお休み？」":177,"「何かな、やっぱそういうんちゃうねん。[l]\nざわざわするゆうか、\n落ち着かん。":178,"アノ日ともちゃうで、\nなんやろ、\nめっさ……居ても立っても居られん感じや。":179,"何かに喚ばれてる感じがすんねん。[l]\nあ、電波系やないで、虫の知らせってやつ？[l]\n落ち着こ思ても落ち着けへんねん、\nなんかざわざわする、めっさ首筋緊張するいうか」":180,"「……？[l]\nなんやろねぇ、\nやっぱり気のせいと違いますかねぃ。":181,"それより祭も決まったことですし、\n………せやね、[l]\nそう、だから、\n祭の日までには、万全にしておくんですよぅ。":182,"そして──」":183,"ミ・ミャルタサミャルキャタサナサカヤタサツォロ、\nキャオロタサメコネカヤタサツ・ワ。":184},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_023.ks","relPath":"/data/scenario/SC_S_023.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":172,"length":185,"percent":92.97297297297298},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[175,1]},"/data/scenario/SC_S_024.ks":{"data":[["\nやはりか","\n果然如此"],["\nではいつものとおり","\n那就按老规矩"],["\nそれが掟","\n此乃铁则"],["\nましてや此度はあのお方が","\n更何况这次有那位大人在"],["\n幸い既にツギメは居る","\n幸好继任者已在位"],["\nでは、あやめよ──","\n那么，开始吧──"],["\n\n\n\n\n\n\n",""],["斬","斩"],["\n\n\n美と窪のアワイの","\n\n\n美与洼的阿歪"],["歪にはシを","扭曲之处施以死"],["\n美歪死窪","\n美歪死洼"]],"context":[["SC_S_024.ks/index/1/text"],["SC_S_024.ks/index/3/text"],["SC_S_024.ks/index/5/text"],["SC_S_024.ks/index/7/text"],["SC_S_024.ks/index/9/text"],["SC_S_024.ks/index/11/text"],["SC_S_024.ks/index/13/text"],["SC_S_024.ks/index/16/text"],["SC_S_024.ks/index/19/text"],["SC_S_024.ks/index/21/text"],["SC_S_024.ks/index/23/text"]],"tags":[],"parameters":[[{"start":156,"end":165}],[{"start":171,"end":185}],[{"start":191,"end":200}],[{"start":206,"end":223}],[{"start":229,"end":244}],[{"start":250,"end":264}],[{"start":331,"end":362}],[{"start":400,"end":399}],[{"start":439,"end":462}],[{"start":468,"end":473}],[{"start":479,"end":488}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_024.ks","basename":"SC_S_024.ks","indexIds":{"\nやはりか":0,"\nではいつものとおり":1,"\nそれが掟":2,"\nましてや此度はあのお方が":3,"\n幸い既にツギメは居る":4,"\nでは、あやめよ──":5,"\n\n\n\n\n\n\n":6,"斬":7,"\n\n\n美と窪のアワイの":8,"歪にはシを":9,"\n美歪死窪":10},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_024.ks","relPath":"/data/scenario/SC_S_024.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":10,"length":11,"percent":90.9090909090909},"cellInfo":[]},"/data/scenario/SC_S_025.ks":{"data":[["@rもう、\n時間ない。","@r已经、\n没时间了。"],["@r母様自身は兎も角、\nあの娘達が動いたら、[l]@rどうしよう。","@r母亲大人姑且不论、\n要是那些女孩行动起来，[l]@r怎么办。"],["@rまだ確証ないけど、\n@r待っててもしょうがない……","@r虽然还没确凿证据、\n@r干等着也不是办法……"],["@rどうせ違ってたらもう、\n@rああ、やだ、","@r反正要是搞错了的话、\n@r啊，不要、"],["@rわかんない、わかんない、わかんない、\n@rわかんない！","@r不懂、不懂、不懂、\n@r不懂！"],["@rいうしかないよ、\n@rいうしかないよね、","@r只能说了、\n@r只能说了对吧、"],["@r私は覚悟決まると強いんだから、","@r我下定决心后可是很坚强的、"],["@rかくご、きめて、","@r下定决心、"],["@r全部はなす、ぜんぶいうから、","@r全说出来、全部都说出来、"],["@rおねがい、\n@rあなたであって。","@r求求你、\n@r必须是您。"],["もう、あなたじゃなきゃだめ、","已经、非您不可了、"],["@r@r@r@r@r@r真言さんじゃなきゃ、いやだよ……","@r@r@r@r@r@r不是真言先生的话、我不要……"]],"context":[["SC_S_025.ks/index/1/text"],["SC_S_025.ks/index/3/text"],["SC_S_025.ks/index/5/text"],["SC_S_025.ks/index/7/text"],["SC_S_025.ks/index/9/text"],["SC_S_025.ks/index/11/text"],["SC_S_025.ks/index/13/text"],["SC_S_025.ks/index/15/text"],["SC_S_025.ks/index/17/text"],["SC_S_025.ks/index/19/text"],["SC_S_025.ks/index/21/text"],["SC_S_025.ks/index/23/text"]],"tags":[],"parameters":[[{"start":155,"end":172}],[{"start":178,"end":221}],[{"start":229,"end":264}],[{"start":270,"end":300}],[{"start":306,"end":343}],[{"start":355,"end":385}],[{"start":391,"end":410}],[{"start":416,"end":428}],[{"start":434,"end":452}],[{"start":462,"end":488}],[{"start":500,"end":514}],[{"start":522,"end":562}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_025.ks","basename":"SC_S_025.ks","indexIds":{"@rもう、\n時間ない。":0,"@r母様自身は兎も角、\nあの娘達が動いたら、[l]@rどうしよう。":1,"@rまだ確証ないけど、\n@r待っててもしょうがない……":2,"@rどうせ違ってたらもう、\n@rああ、やだ、":3,"@rわかんない、わかんない、わかんない、\n@rわかんない！":4,"@rいうしかないよ、\n@rいうしかないよね、":5,"@r私は覚悟決まると強いんだから、":6,"@rかくご、きめて、":7,"@r全部はなす、ぜんぶいうから、":8,"@rおねがい、\n@rあなたであって。":9,"もう、あなたじゃなきゃだめ、":10,"@r@r@r@r@r@r真言さんじゃなきゃ、いやだよ……":11},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_025.ks","relPath":"/data/scenario/SC_S_025.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":12,"length":12,"percent":100},"cellInfo":[]},"/data/scenario/SC_S_026.ks":{"data":[["@rつまりは、\n@r彼のＸに対する淡泊さというか、\n@r必要以上に慎重なのは、\n@rＹの欲動を抑制されているからという事か。","@r也就是说、\n@r他对X表现出的淡漠态度、\n@r过度谨慎的原因、\n@r是因为被抑制了Y的冲动吧。"],["@r彼だけでなく、\n@r彼処に属する場合は去勢とまでは云わずとも、\nいうなれば半宦官状態とでも言おうか、\n@r程度の差はあろうがなあ。","@r不单是他，\n@r若隶属于彼处者虽不至言阉割，\n说是半宦官状态也不为过吧，\n@r程度差异罢了。"],["@rどこぞのように潜伏した劣勢継承素を","@r不像某些地方会暗中将劣质继承因子"],["胤にしつつも、\nいずるＹを片端から処理するまでに極端な事はしないにしても、","混入血脉，\n虽不至于极端到将蠕动的Y赶尽杀绝，"],["@rＹの欲動はオーバーキル気味なスキルの原動に使われるに留まっていて、\n前線の実働部隊には……あまり配置してないようだし。[l]\n……あーん、仮性がそういえばひとりいたようだが、[l]\n","@rY的欲动仅被用作技能超量杀伤的动力源，\n似乎很少配置在前线实战部队……[l]\n……啊嗯、说起来倒是有个伪性的家伙，[l]\n"],["所","的"],["詮仮性は仮性だな。","但伪性终究是伪性。"],["@rそう、Ｘの、\nツキのチカラをうける、\n理論なのか感情なのか、\n冷徹なのか慈愛なのか、\nその両方を並列処理し矛盾無く同時存在を許可している\nあの処理の仕方、\n故に計算高く視え非Ｘには理解し難い『あの』処理の仕方とは全く別の、","@r没错，X的、\n承受月之力的、\n是理论还是感情、\n是冷酷还是慈悲、\n能并行处理两者并容许其无矛盾共存\n的那种处理方式、\n与看似精于算计令非X者难以理解的『那种』处理方式截然不同的、"],["@rＹの欲動。","@rY的欲动。"],["@rそれに囚われると抜け出す事は容易じゃない。","@r一旦被其束缚就难以挣脱。"],["@rあれは途轍もない、途方もない、恐るべき執着、\n不純なるモチベーション、だのに瞬発力も持続力もある、\n幼稚なのか巧緻なのか、いつの世にもどの文化にも厳然と根を張り、\n便宜的に呼称されてはいたが形状までも偶さか似通ったＹ……なあ。","@r那是骇人听闻、超乎想象的可怕执念、\n不纯的动机、却兼具爆发力与持久力、\n不知该说幼稚还是精巧、在任何时代任何文化中都根深蒂固、\n虽曾被权宜命名却连形态都偶然相似的Y……啊。"],["@r恐らく『持ってない』者には永久にわからんだろう。","@r恐怕『未曾拥有』者永远无法理解吧。"],["@r俺ですらあれの","@r就连我有时都"],["蠢","难"],["動は時に無視し","以忽视其蠢"],["難い。","动。"],["@rそれを抑えていたというのだから、\n@rその枷が外されたなら、\n@r……あまり想像したくないな。","@r既然说那曾被抑制着、\n@r若其枷锁被解除、\n@r……实在不愿想象。"],["@r傾国の習いあるように、\n@rＹの欲動は基本的に制御し","@r正如倾国者惯常那般、\n@rY的欲动本质是难以"],["難い根源なる衝動であって、\n過去幾星霜、それが故に争いも過ちも起きているものよ。","控制的根源冲动、\n古往今来多少纷争过错皆因其而起。"],["@r種の増殖という目的の為には不可避なものとは言え、\n複雑化した意識及び社会性を持ったヒトにとっては、\n弊害もより大きい。","@r虽说是物种增殖不可避免的要素、\n但对拥有复杂意识与社会性的人类而言、\n弊端更为显著。"],["@rＸによって利用されたりもする、\n生物として視るならば問題のないその衝動も、\n寝、喰、増だけが活動ではなくなったこの種においては、\nその社会秩序の維持という観点においては、\n脆弱性になりかねないファクターとなってしまった。","@r甚至会被X利用、\n从生物学角度看本无问题的冲动、\n对于已超越睡食繁殖活动范畴的此物种、\n从维持社会秩序的角度而言、\n反倒成了可能引发脆弱性的因素。"],["@r勿論それは主体……欲動の持主からすればの話で、","@r当然这是从主体……即欲动持有者的角度、"],["@r操作したい側からすればこれほど分かり易く","@r对操控者而言没有比这更直观"],["且つ、\n制御──欲動を喚起するのが容易という意味で──\nが容易いものはない、のかも知れぬ。","且、\n易于调控──指唤起欲动方面──\n的要素了吧。"],["@rいずれそれ故に、\n@rあれはあれなのだろうし、\n@r未だ鎖で繋がれて──\n@rそれともそのまま飼い馴らすつもりか。","@r终究正因如此、\n@r那东西才是那副德性、\n@r仍被锁链禁锢──\n@r还是说打算就这样驯养下去？"],["@rまあ、\n@rねこにも王を視る権利はあるし、\n@rあの兄貴の優先順位次第では、……あー、","@r也罢、\n@r猫也有权仰望君王、\n@r全看那位大哥的优先级……啊、"],["@r彼には何とか、………\n@r仮にも俺のともがらなんだからな。","@r他总会有办法的，………\n@r好歹也算我的同族。"],["@r好奇心猫を殺すって結局どういう意味だったか、\n兎に角、俺もほんとなら首を突っ込みたくはない。","@r好奇害死猫到底什么意思来着、\n总之我本来也不想蹚浑水。"],["@rにしても目的が──","@r不过目的要是──"],["@r残党狩りにしては大仰というか、\nそれこそオーバーキルじゃんな。[l]\nあの白が動けばあっと言う間に片は付くだろうに、\n獲物をいたぶるのはまだしも、\n同族くらいには優しくしてやってほしいもんだが。","@r说是清剿残党也太夸张了点，\n简直就是过度杀戮嘛。[l]\n要是那位白大人出手的话眨眼间就能解决吧，\n玩弄猎物也就罢了，\n至少对同族温柔点啊。"],["@rいずれあの兄貴の美意識の問題か。","@r说到底还是那位老哥的审美问题吧。"],["@r厄介だわなー。","@r真麻烦啊——"],["@rああ、\n@r関わりたくねぇ～～～。","@r啊啊，\n@r完全不想扯上关系～～～"],["@rNKのABCまでしっかり配置されてる状況で、\n下手に動きたくねえなーーー。","@r连NK的ABC都严阵以待的阵仗，\n实在不敢轻举妄动啊——"],["@rでもしゃあないやな。","@r不过也没办法啦。"],["@rもう動いちまったし。","@r毕竟已经出手了。"],["@r俺もほんとにヒトが良いね。","@r我也真是老好人呢。"],["@r全く、彼もかれも放っておけないかんね。","@r真是的，一个两个都让人放不下心。"],["@rいずれにしろ、\n@r過去の習いに","@r总之，\n@r按照过往的惯例"],["違わず、\n@rＹが禍根となって今の状況がある訳だ。","如出一辙，\n@rY种下的祸根导致了现状。"],["@rあの生き残りはすっかりＹを拒絶するようになってしまった。","@r那个幸存者已经完全抗拒Y了。"],["@r激しく、且つ明確なる憎悪をもって、\n@r感情的なコトを事務的に処理し、…いやさせているのか。","@r用激烈而明确的憎恶，\n@r把感性的事用事务性方式处理…或者说被迫处理？"],["@rそれがまた因となってややこしい果が控えてるってか。[l]\nああイーくん、\nお前さん、\nあれかよ。","@r这又成为新的因，招致更复杂的果是吧。[l]\n啊啊小伊，\n你这家伙，\n原来是这么回事啊。"],["@r……あとで旨いもんでも奢ってもらわにゃなあ。[l]\nほんとに世話のかかる、\nたましいのふたご、\nなんて言ってみたりな。","@r……待会儿可得让你请吃顿好的。[l]\n真是让人操心的、\n灵魂的双生子，\n试着这么说说看。"]],"context":[["SC_S_026.ks/index/1/text"],["SC_S_026.ks/index/3/text"],["SC_S_026.ks/index/5/text"],["SC_S_026.ks/index/7/text"],["SC_S_026.ks/index/9/text"],["SC_S_026.ks/index/12/text"],["SC_S_026.ks/index/14/text"],["SC_S_026.ks/index/16/text"],["SC_S_026.ks/index/18/text"],["SC_S_026.ks/index/20/text"],["SC_S_026.ks/index/22/text"],["SC_S_026.ks/index/24/text"],["SC_S_026.ks/index/26/text"],["SC_S_026.ks/index/28/text"],["SC_S_026.ks/index/30/text"],["SC_S_026.ks/index/32/text"],["SC_S_026.ks/index/34/text"],["SC_S_026.ks/index/36/text"],["SC_S_026.ks/index/38/text"],["SC_S_026.ks/index/40/text"],["SC_S_026.ks/index/42/text"],["SC_S_026.ks/index/44/text"],["SC_S_026.ks/index/46/text"],["SC_S_026.ks/index/48/text"],["SC_S_026.ks/index/50/text"],["SC_S_026.ks/index/52/text"],["SC_S_026.ks/index/54/text"],["SC_S_026.ks/index/56/text"],["SC_S_026.ks/index/58/text"],["SC_S_026.ks/index/60/text"],["SC_S_026.ks/index/62/text"],["SC_S_026.ks/index/64/text"],["SC_S_026.ks/index/66/text"],["SC_S_026.ks/index/68/text"],["SC_S_026.ks/index/70/text"],["SC_S_026.ks/index/72/text"],["SC_S_026.ks/index/74/text"],["SC_S_026.ks/index/76/text"],["SC_S_026.ks/index/78/text"],["SC_S_026.ks/index/80/text"],["SC_S_026.ks/index/82/text"],["SC_S_026.ks/index/84/text"],["SC_S_026.ks/index/86/text"],["SC_S_026.ks/index/88/text"]],"tags":[],"parameters":[[{"start":155,"end":237}],[{"start":249,"end":334}],[{"start":346,"end":367}],[{"start":377,"end":418}],[{"start":424,"end":527}],[{"start":541,"end":542}],[{"start":552,"end":561}],[{"start":575,"end":714}],[{"start":720,"end":729}],[{"start":743,"end":768}],[{"start":774,"end":903}],[{"start":909,"end":937}],[{"start":951,"end":962}],[{"start":973,"end":974}],[{"start":984,"end":991}],[{"start":1001,"end":1004}],[{"start":1010,"end":1073}],[{"start":1087,"end":1123}],[{"start":1133,"end":1177}],[{"start":1183,"end":1254}],[{"start":1268,"end":1398}],[{"start":1404,"end":1431}],[{"start":1437,"end":1461}],[{"start":1470,"end":1523}],[{"start":1537,"end":1616}],[{"start":1628,"end":1687}],[{"start":1693,"end":1732}],[{"start":1748,"end":1802}],[{"start":1816,"end":1829}],[{"start":1835,"end":1952}],[{"start":1958,"end":1978}],[{"start":1992,"end":2003}],[{"start":2009,"end":2036}],[{"start":2042,"end":2087}],[{"start":2105,"end":2119}],[{"start":2125,"end":2139}],[{"start":2145,"end":2162}],[{"start":2168,"end":2191}],[{"start":2203,"end":2229}],[{"start":2239,"end":2270}],[{"start":2276,"end":2308}],[{"start":2314,"end":2370}],[{"start":2384,"end":2448}],[{"start":2460,"end":2535}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_026.ks","basename":"SC_S_026.ks","indexIds":{"@rつまりは、\n@r彼のＸに対する淡泊さというか、\n@r必要以上に慎重なのは、\n@rＹの欲動を抑制されているからという事か。":0,"@r彼だけでなく、\n@r彼処に属する場合は去勢とまでは云わずとも、\nいうなれば半宦官状態とでも言おうか、\n@r程度の差はあろうがなあ。":1,"@rどこぞのように潜伏した劣勢継承素を":2,"胤にしつつも、\nいずるＹを片端から処理するまでに極端な事はしないにしても、":3,"@rＹの欲動はオーバーキル気味なスキルの原動に使われるに留まっていて、\n前線の実働部隊には……あまり配置してないようだし。[l]\n……あーん、仮性がそういえばひとりいたようだが、[l]\n":4,"所":5,"詮仮性は仮性だな。":6,"@rそう、Ｘの、\nツキのチカラをうける、\n理論なのか感情なのか、\n冷徹なのか慈愛なのか、\nその両方を並列処理し矛盾無く同時存在を許可している\nあの処理の仕方、\n故に計算高く視え非Ｘには理解し難い『あの』処理の仕方とは全く別の、":7,"@rＹの欲動。":8,"@rそれに囚われると抜け出す事は容易じゃない。":9,"@rあれは途轍もない、途方もない、恐るべき執着、\n不純なるモチベーション、だのに瞬発力も持続力もある、\n幼稚なのか巧緻なのか、いつの世にもどの文化にも厳然と根を張り、\n便宜的に呼称されてはいたが形状までも偶さか似通ったＹ……なあ。":10,"@r恐らく『持ってない』者には永久にわからんだろう。":11,"@r俺ですらあれの":12,"蠢":13,"動は時に無視し":14,"難い。":15,"@rそれを抑えていたというのだから、\n@rその枷が外されたなら、\n@r……あまり想像したくないな。":16,"@r傾国の習いあるように、\n@rＹの欲動は基本的に制御し":17,"難い根源なる衝動であって、\n過去幾星霜、それが故に争いも過ちも起きているものよ。":18,"@r種の増殖という目的の為には不可避なものとは言え、\n複雑化した意識及び社会性を持ったヒトにとっては、\n弊害もより大きい。":19,"@rＸによって利用されたりもする、\n生物として視るならば問題のないその衝動も、\n寝、喰、増だけが活動ではなくなったこの種においては、\nその社会秩序の維持という観点においては、\n脆弱性になりかねないファクターとなってしまった。":20,"@r勿論それは主体……欲動の持主からすればの話で、":21,"@r操作したい側からすればこれほど分かり易く":22,"且つ、\n制御──欲動を喚起するのが容易という意味で──\nが容易いものはない、のかも知れぬ。":23,"@rいずれそれ故に、\n@rあれはあれなのだろうし、\n@r未だ鎖で繋がれて──\n@rそれともそのまま飼い馴らすつもりか。":24,"@rまあ、\n@rねこにも王を視る権利はあるし、\n@rあの兄貴の優先順位次第では、……あー、":25,"@r彼には何とか、………\n@r仮にも俺のともがらなんだからな。":26,"@r好奇心猫を殺すって結局どういう意味だったか、\n兎に角、俺もほんとなら首を突っ込みたくはない。":27,"@rにしても目的が──":28,"@r残党狩りにしては大仰というか、\nそれこそオーバーキルじゃんな。[l]\nあの白が動けばあっと言う間に片は付くだろうに、\n獲物をいたぶるのはまだしも、\n同族くらいには優しくしてやってほしいもんだが。":29,"@rいずれあの兄貴の美意識の問題か。":30,"@r厄介だわなー。":31,"@rああ、\n@r関わりたくねぇ～～～。":32,"@rNKのABCまでしっかり配置されてる状況で、\n下手に動きたくねえなーーー。":33,"@rでもしゃあないやな。":34,"@rもう動いちまったし。":35,"@r俺もほんとにヒトが良いね。":36,"@r全く、彼もかれも放っておけないかんね。":37,"@rいずれにしろ、\n@r過去の習いに":38,"違わず、\n@rＹが禍根となって今の状況がある訳だ。":39,"@rあの生き残りはすっかりＹを拒絶するようになってしまった。":40,"@r激しく、且つ明確なる憎悪をもって、\n@r感情的なコトを事務的に処理し、…いやさせているのか。":41,"@rそれがまた因となってややこしい果が控えてるってか。[l]\nああイーくん、\nお前さん、\nあれかよ。":42,"@r……あとで旨いもんでも奢ってもらわにゃなあ。[l]\nほんとに世話のかかる、\nたましいのふたご、\nなんて言ってみたりな。":43},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_026.ks","relPath":"/data/scenario/SC_S_026.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":44,"length":44,"percent":100},"cacheResetOnChange":{},"cellInfo":[]},"/data/scenario/SC_S_027.ks":{"data":[["彼にも『雫』の資質があったのか否か、\n他にそれたり得る誰かが居たのか、\n起こり難い事が起きた。[l]\n幸か不幸か、\n犯罪なのか奇跡なのか、\n彼の願いは届いた。[l]\nパラミアキス＝フィーメイルは彼のねことなった。[l]\nつまり、\n『猫の王』のねこ、\n『白のミルハ』がその時生まれた。[l]\nヒトに受肉した、最強の白として、\nその後の『Lu=Le』の最大の天敵として。","无论他是否具备『雫』的资质，\n或是存在其他可能的适格者，\n小概率事件发生了。[l]\n幸或不幸，\n是犯罪还是奇迹，\n他的愿望实现了。[l]\n帕拉米亚基斯＝菲梅尔成为了他的猫。[l]\n换言之，\n『猫之王』的猫，\n『白之米尔哈』于彼时诞生。[l]\n作为获得人类肉身的最强之白，\n成为日后『Lu=Le』最大的天敌。"],["その時の『八人姉妹』は長姉ミリアム・シュブを筆頭に、\nカルロサやミルハと同じくアリスの直系の……否、傍系だったか、[l]\n血統ではあるものの素質が薄かったドレミリア・リデルを含み、\n彼女のねこベール、\n長姉のねこケルベ＝ロア、\nエンドル・ファとそのねこガルガル、\nオズマ・イースとそのねこハスマリム、\nダーカ・イァンナ……これは先日会した魔女だが、[l]\nそのねこマラキタルシシム、\nヴィヴ・アヴァとそのねこデュナム、\nイサリーとそのねこプロン、\nヨルダ・モノとそのねこアルク＝ベー。","当时的『八姐妹』以长姐米莉安姆・舒布为首，\n包括与卡尔罗萨和米尔哈同为爱丽丝直系…不，或许是旁系，[l]\n虽属同血脉但资质薄弱的德蕾米莉娅・利德尔，\n她的猫贝尔，\n长姐的猫凯尔贝＝萝亚，\n恩朵露・法与其猫加尔加尔，\n奥兹玛・伊斯与其猫哈斯马利姆，\n达卡・伊安娜…这是前几日见过的魔女，[l]\n其猫马拉基塔尔希希姆，\n薇芙・艾娃与其猫迪尤纳姆，\n伊萨莉与其猫普洛恩，\n约尔达・莫诺与其猫阿尔克＝贝。"],["『猫の王』カルロサは、『Lu=Le』を崩壊させ──\n自分に味方するものとそうでないものに分裂させてしまった。[l]\n自ら等を『WCL』と名乗り、\nミリアム達を蹂躙していった。","『猫之王』卡尔罗萨使『Lu=Le』分崩离析——\n分裂为支持与反对她的两派。[l]\n将己方命名为『WCL』，\n对米莉安姆等人展开蹂躏。"],["が、そのイトは──","然而那条丝线——"],["ＣＡＴの最大の力は、\nこの星の生命の根源たる意味や行動の象徴とでも\n言おうか、\nつまりは『喰う』ことだ。[l]\nエネルギーの変換機構、\n対象を捕食し我が身とすること、\n即物的な意味ではなく、\nつまり『視て学習』することも含む。[l]\n単に吸収するのではなく、\n消化器官が食物をアミノ酸に分解し栄養素として体内で\n再合成するように、\n対象を物質的であれ概念的であれ『喰い』、\n己が力とする事に長けている。","CAT的最大力量是\n堪称这颗星球生命根源的意义与行动象征\n或者说\n简而言之就是『吞噬』。[l]\n能量的转换机制\n将对象捕食化为己身\n并非仅指物质层面\n也包括『观察学习』这种行为。[l]\n不是单纯吸收\n如同消化器官将食物分解为氨基酸并在体内\n重新合成营养素般\n无论对象是物质还是概念都能『吞噬』\n并擅长将其转化为自身力量。"],["感情や損害すらもツギへの","连情感与伤害都能成为"],["糧と為す、\n『成長する』能力、\n螺旋が如き、前進上昇の要、\n転んでもただでは起きない、いきることへの貪欲さ、\n超順応性。","成长的养分\n这种『进化』能力\n如同螺旋般前进上升的关键\n跌倒也要带着战利品爬起 对生存的贪婪\n超强适应性。"],["そういうチカラが相として特化しその十全の中に在る。","这类力量作为相位特性在其完整体中显现。"],["@rつまりPHASE:6。","@r也就是PHASE:6。"],["@rカルロサは妹をより完璧なものにしようと思い立ったのだ。[l]\n幸い餌となる他のＣＡＴは、\n彼の周囲にごまんと居たのだから。","@r卡尔罗萨决定将妹妹塑造得更完美。[l]\n所幸作为饵食的其他CAT\n在他周围要多少有多少。"],["カルロサは、\n何をしたのかというと、","卡尔罗萨，\n做了什么呢，"]],"context":[["SC_S_027.ks/index/1/text"],["SC_S_027.ks/index/3/text"],["SC_S_027.ks/index/5/text"],["SC_S_027.ks/index/7/text"],["SC_S_027.ks/index/9/text"],["SC_S_027.ks/index/11/text"],["SC_S_027.ks/index/13/text"],["SC_S_027.ks/index/15/text"],["SC_S_027.ks/index/17/text"],["SC_S_027.ks/index/19/text"],["SC_S_027.ks/index/21/text"]],"tags":[],"parameters":[[{"start":167,"end":394}],[{"start":402,"end":688}],[{"start":698,"end":797}],[{"start":807,"end":816}],[{"start":828,"end":1077}],[{"start":1089,"end":1101}],[{"start":1111,"end":1187}],[{"start":1201,"end":1226}],[{"start":1232,"end":1247}],[{"start":1253,"end":1326}],[{"start":1334,"end":1356}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_027.ks","basename":"SC_S_027.ks","indexIds":{"彼にも『雫』の資質があったのか否か、\n他にそれたり得る誰かが居たのか、\n起こり難い事が起きた。[l]\n幸か不幸か、\n犯罪なのか奇跡なのか、\n彼の願いは届いた。[l]\nパラミアキス＝フィーメイルは彼のねことなった。[l]\nつまり、\n『猫の王』のねこ、\n『白のミルハ』がその時生まれた。[l]\nヒトに受肉した、最強の白として、\nその後の『Lu=Le』の最大の天敵として。":0,"その時の『八人姉妹』は長姉ミリアム・シュブを筆頭に、\nカルロサやミルハと同じくアリスの直系の……否、傍系だったか、[l]\n血統ではあるものの素質が薄かったドレミリア・リデルを含み、\n彼女のねこベール、\n長姉のねこケルベ＝ロア、\nエンドル・ファとそのねこガルガル、\nオズマ・イースとそのねこハスマリム、\nダーカ・イァンナ……これは先日会した魔女だが、[l]\nそのねこマラキタルシシム、\nヴィヴ・アヴァとそのねこデュナム、\nイサリーとそのねこプロン、\nヨルダ・モノとそのねこアルク＝ベー。":1,"『猫の王』カルロサは、『Lu=Le』を崩壊させ──\n自分に味方するものとそうでないものに分裂させてしまった。[l]\n自ら等を『WCL』と名乗り、\nミリアム達を蹂躙していった。":2,"が、そのイトは──":3,"ＣＡＴの最大の力は、\nこの星の生命の根源たる意味や行動の象徴とでも\n言おうか、\nつまりは『喰う』ことだ。[l]\nエネルギーの変換機構、\n対象を捕食し我が身とすること、\n即物的な意味ではなく、\nつまり『視て学習』することも含む。[l]\n単に吸収するのではなく、\n消化器官が食物をアミノ酸に分解し栄養素として体内で\n再合成するように、\n対象を物質的であれ概念的であれ『喰い』、\n己が力とする事に長けている。":4,"感情や損害すらもツギへの":5,"糧と為す、\n『成長する』能力、\n螺旋が如き、前進上昇の要、\n転んでもただでは起きない、いきることへの貪欲さ、\n超順応性。":6,"そういうチカラが相として特化しその十全の中に在る。":7,"@rつまりPHASE:6。":8,"@rカルロサは妹をより完璧なものにしようと思い立ったのだ。[l]\n幸い餌となる他のＣＡＴは、\n彼の周囲にごまんと居たのだから。":9,"カルロサは、\n何をしたのかというと、":10},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_027.ks","relPath":"/data/scenario/SC_S_027.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":11,"length":11,"percent":100},"cellInfo":[]},"/data/scenario/SC_S_028.ks":{"data":[["@r「僕は視てたよ少年。","@r「我可是看着哦少年"],["@rうーん、十何年も残すにはあまりにも此処では心許ないな。","@r嗯 要在这里残留十几年实在太不安稳了"],["@rさて、そこでだ。","@r那么 话说回来"],["@rこの子。","@r这孩子"],["@r●っていうんだよ。","@r叫●哦"],["@rキミと遊びたくて先刻から視ていた。","@r因为想和你玩 刚才就一直看着呢"],["@rモノは相談……いや、","@r有件事商量……不"],["@r頼みたいんだけれどね、","@r是想拜托你"],["@rこの、●と、","@r让这个●和"],["@r別の、\n@r（不明瞭）場（不明瞭）すと言うのはどうだろうか。","@r另外的\n@r（模糊）场（模糊）你觉得如何？"],["@rその方が、\n@r冬夏君の為でもある。","@r这样\n@r对冬夏君也有好处"],["@r大丈夫、騙してはいないよ。","@r放心 没骗你"],["@rん？","@r嗯？"],["@r一応僕はこの子の母親代わりとでも言おうかな。","@r要说的话我算是这孩子的代理母亲吧"],["@r義理の母と言っても良いかもね。","@r说是养母也可以哦"],["@r僕は","@r我"],["屹","屹"],["度、生涯自分の子を持つことはないだろうから──","度 这辈子应该不会有自己的孩子——"],["@rそういう意味では、\n@rこの子の、そう、お母さんと言っても強ち間違いではないな。","@r从这个意义上说\n@r称我为这孩子 对 称为妈妈也未必算错"],["@r少なくとも後援者、養育者ではあるからね、\n","@r至少是后援者 养育者\n"],["禍を留……いや、そこから先はオトナの事情という奴でね。","祸留……不 再往下就是所谓大人的事情了"],["@rさて、と、\n@rそう、ここではこれは禁（不明瞭）」","@r好了\n@r对 在这里这是禁（模糊）」"],["@r\n\n（暫く不鮮明のまま）","@r\n\n（持续模糊不清）"],["\n\n\n（不鮮明部位）","\n\n\n（模糊部分）"],["\n\n\n（再可聴）","\n\n\n（恢复可听）"],["\n「少年に良い夢がありますように。","\n「愿少年有好梦"],["@rながきよのトオのねぶりの\n\nみなめざめ\n\nなみのりぶねのオトのよきかな。","@r长夜远渡的安眠中\n\n众人醒来\n\n乘浪之船的声响多美妙"],["@r何のことか分からないかい？","@r不明白什么意思吗？"],["@rま、少年ならそのうち知るだろう。","@r嘛 少年迟早会懂的"],["@rきっとそういう方面に進むだろうから……」","@r毕竟肯定会往那个方向发展吧……」"],["@r\n\n（数分のブランクの後記録されていたもの、\n幼児の声）","@r\n\n（数分钟空白后的记录\n幼童声音）"],["\n「こんにちわ。","\n「你好。"],["@r\n\nもうすぐ、\nぼくはここからとおいところにいくんだって。","@r\n\n很快，\n我就要离开这里去很远的地方了。"],["@rしんせきのみんなや、\nあのおねえちゃんともしばらくはあえない。","@r亲戚们、\n还有那位大姐姐都暂时见不到了。"],["@rおかあさん？[l]\nあのひと？","@r妈妈？[l]\n那个人吗？"],["@rうん、おかあさん。","@r嗯，妈妈。"],["@rまこちゃんとせっかくともだちになれたのに。","@r好不容易才和真酱成为朋友的。"],["@rまた、あえるかなあ？","@r还能再见面吗？"],["@rそうだね。","@r是啊。"],["@rじゃあ、やくそく。","@r那，约定好了。"],["@rぼくは――","@r我是――"],["\n\n\n\n西石音っていうの」","\n\n\n\n西石音」"],["@r\n\n（ファイル再生一時停止）","@r\n\n（文件播放暂停）"]],"context":[["SC_S_028.ks/index/1/text"],["SC_S_028.ks/index/3/text"],["SC_S_028.ks/index/5/text"],["SC_S_028.ks/index/7/text"],["SC_S_028.ks/index/9/text"],["SC_S_028.ks/index/11/text"],["SC_S_028.ks/index/13/text"],["SC_S_028.ks/index/15/text"],["SC_S_028.ks/index/17/text"],["SC_S_028.ks/index/19/text"],["SC_S_028.ks/index/21/text"],["SC_S_028.ks/index/23/text"],["SC_S_028.ks/index/25/text"],["SC_S_028.ks/index/27/text"],["SC_S_028.ks/index/29/text"],["SC_S_028.ks/index/31/text"],["SC_S_028.ks/index/33/text"],["SC_S_028.ks/index/35/text"],["SC_S_028.ks/index/37/text"],["SC_S_028.ks/index/39/text"],["SC_S_028.ks/index/42/text"],["SC_S_028.ks/index/44/text"],["SC_S_028.ks/index/46/text"],["SC_S_028.ks/index/48/text"],["SC_S_028.ks/index/50/text"],["SC_S_028.ks/index/52/text"],["SC_S_028.ks/index/54/text"],["SC_S_028.ks/index/56/text"],["SC_S_028.ks/index/58/text"],["SC_S_028.ks/index/60/text"],["SC_S_028.ks/index/62/text"],["SC_S_028.ks/index/64/text"],["SC_S_028.ks/index/66/text"],["SC_S_028.ks/index/68/text"],["SC_S_028.ks/index/70/text"],["SC_S_028.ks/index/72/text"],["SC_S_028.ks/index/74/text"],["SC_S_028.ks/index/76/text"],["SC_S_028.ks/index/78/text"],["SC_S_028.ks/index/80/text"],["SC_S_028.ks/index/82/text"],["SC_S_028.ks/index/84/text"],["SC_S_028.ks/index/86/text"]],"tags":[],"parameters":[[{"start":165,"end":179}],[{"start":185,"end":216}],[{"start":222,"end":234}],[{"start":240,"end":248}],[{"start":254,"end":267}],[{"start":279,"end":300}],[{"start":306,"end":320}],[{"start":326,"end":341}],[{"start":347,"end":357}],[{"start":363,"end":403}],[{"start":415,"end":443}],[{"start":449,"end":466}],[{"start":472,"end":478}],[{"start":484,"end":510}],[{"start":516,"end":535}],[{"start":541,"end":547}],[{"start":557,"end":558}],[{"start":567,"end":590}],[{"start":600,"end":650}],[{"start":656,"end":681}],[{"start":691,"end":718}],[{"start":724,"end":759}],[{"start":769,"end":793}],[{"start":799,"end":821}],[{"start":827,"end":847}],[{"start":857,"end":878}],[{"start":884,"end":940}],[{"start":946,"end":963}],[{"start":969,"end":989}],[{"start":995,"end":1019}],[{"start":1031,"end":1075}],[{"start":1115,"end":1127}],[{"start":1133,"end":1178}],[{"start":1184,"end":1223}],[{"start":1235,"end":1258}],[{"start":1264,"end":1277}],[{"start":1283,"end":1308}],[{"start":1314,"end":1328}],[{"start":1334,"end":1343}],[{"start":1349,"end":1362}],[{"start":1368,"end":1377}],[{"start":1387,"end":1416}],[{"start":1422,"end":1448}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_028.ks","basename":"SC_S_028.ks","indexIds":{"@r「僕は視てたよ少年。":0,"@rうーん、十何年も残すにはあまりにも此処では心許ないな。":1,"@rさて、そこでだ。":2,"@rこの子。":3,"@r●っていうんだよ。":4,"@rキミと遊びたくて先刻から視ていた。":5,"@rモノは相談……いや、":6,"@r頼みたいんだけれどね、":7,"@rこの、●と、":8,"@r別の、\n@r（不明瞭）場（不明瞭）すと言うのはどうだろうか。":9,"@rその方が、\n@r冬夏君の為でもある。":10,"@r大丈夫、騙してはいないよ。":11,"@rん？":12,"@r一応僕はこの子の母親代わりとでも言おうかな。":13,"@r義理の母と言っても良いかもね。":14,"@r僕は":15,"屹":16,"度、生涯自分の子を持つことはないだろうから──":17,"@rそういう意味では、\n@rこの子の、そう、お母さんと言っても強ち間違いではないな。":18,"@r少なくとも後援者、養育者ではあるからね、\n":19,"禍を留……いや、そこから先はオトナの事情という奴でね。":20,"@rさて、と、\n@rそう、ここではこれは禁（不明瞭）」":21,"@r\n\n（暫く不鮮明のまま）":22,"\n\n\n（不鮮明部位）":23,"\n\n\n（再可聴）":24,"\n「少年に良い夢がありますように。":25,"@rながきよのトオのねぶりの\n\nみなめざめ\n\nなみのりぶねのオトのよきかな。":26,"@r何のことか分からないかい？":27,"@rま、少年ならそのうち知るだろう。":28,"@rきっとそういう方面に進むだろうから……」":29,"@r\n\n（数分のブランクの後記録されていたもの、\n幼児の声）":30,"\n「こんにちわ。":31,"@r\n\nもうすぐ、\nぼくはここからとおいところにいくんだって。":32,"@rしんせきのみんなや、\nあのおねえちゃんともしばらくはあえない。":33,"@rおかあさん？[l]\nあのひと？":34,"@rうん、おかあさん。":35,"@rまこちゃんとせっかくともだちになれたのに。":36,"@rまた、あえるかなあ？":37,"@rそうだね。":38,"@rじゃあ、やくそく。":39,"@rぼくは――":40,"\n\n\n\n西石音っていうの」":41,"@r\n\n（ファイル再生一時停止）":42},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_028.ks","relPath":"/data/scenario/SC_S_028.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":43,"length":43,"percent":100},"cellInfo":[],"cacheResetOnChange":{},"lastSelectedCell":[20,0]},"/data/scenario/SC_S_029.ks":{"data":[["み、\nに、なってンだか、","变、\n变成啥样了、"],["……っえぐぁ。","……呕呃。"],["駄目だ、安定しねぇ。[l]\nざわざわする、気分が悪ぃ。[l]\n頭が","不行，根本稳定不下来。[l]\n脑袋嗡嗡响，难受死了。[l]\n这种"],["逆","就"],["上せたようなこの感じはなんだ。","像被吊起来的感觉是怎么回事。"],["悪いもンでも喰った後の、\nガスが溜まったようなあの感じが、","就像吃了变质食物后、\n肠胃胀气的那种感觉、"],["考えることを邪魔しやがって、\nそれが苛苛の原因になって、\n","不断干扰着思考、\n引发阵阵烦躁、\n"],["おえ゛っ。","呕呃。"],["……そんだけじゃねえし。","……还不止这样。"],["手か、腕か知らねェが、\n","不知道是手还是胳膊、\n"],["痒ぃつーか、\n手の届かない肉の中にその場所があるあの感じ、\n掻いても掻いても掻いてもカイてもカイてもかいても、","又痒又、\n像有块挠不到的肉在深处发痒、\n挠啊挠啊挠啊挠啊挠啊挠啊挠、"],["むずむずしたままおさまんねぇ、","刺痒感始终消停不下来、"],["苛苛が、そのままむかつきに、","烦躁直接转化成恶心、"],["暴発する、暴発する、\nあああああもうっっだらっっんなんだてめえ！！！","要爆发了要爆发了、\n啊啊啊烦死了烦死了你这混蛋！！！"],["………。",""],["鎮まれ。","给我冷静。"],["抑えろ。","压下去。"],["クダラナイ事で心動かすな。","别为无聊事动摇。"],["「短気は損気……というか、[l]\n　　　　真に相手をミクダしたいのなら、\n　　　　居丈高に構えるよりは、──」","「心急吃亏……不对、[l]\n　　　　若真想碾碎真那家伙、\n　　　　比起虚张声势——」"],["軽蔑だ。","是轻蔑。"],["「認める必要など毛程も無いよ。[l]\n　　　　ただ瑣事に煩わされる必要も無いから──」","「根本没必要承认。[l]\n　　　　但也没必要被琐事困扰——」"],["無視しろ。","无视就好。"],["受け流せ。","应付过去。"],["ああああああああああああ、\n","啊啊啊啊啊啊啊、\n"],["知ったことか！！！","关我屁事！！！"],["うぜぇものはうぜぇべや！！！","看不顺眼的都给我消失！！！"],["………………。",""],["沸点通ると一瞬気が遠くなる。","越过沸点时意识突然飘远。"],["軽いリセット喰らった感じで。","像被强制重置了似的。"],["そこから醒める方向に転換する事もあれば、\n","有时会转向清醒、\n"],["そのまま頭ん中真っ赤に、\n","有时整个脑子彻底通红、\n"],["眼の前がまっかに、\n","眼前一片血红、\n"],["今回は醒める方で落ち着いた。","这次倒是往清醒方向稳定了。"],["大きく息を吸う、\n","深深吸气、\n"],["そしてはく。","再呼出。"],["げふぅっ。","咳噗。"],["でけえ●●●が口から出て、\n","超大块的●●●从嘴里吐出来、\n"],["ようやく身体の方も、落ち着いた、らしい。","身体似乎终于也、平静下来了。"],["あの時のアレもミになって、るのか、\n","那时候的玩意儿也化成渣了吧、\n"],["ああ、毎度毎度毎度毎度思うのは、\n","啊，每次每次每次每次都在想、\n"],["喰う、のは、しあわせだが、\n","进食，是，幸福的，\n"],["ミになるという結果も良いことなんだろうが、\n","化为血肉的结果或许也是好事，\n"],["その過程が、喰った後のこのプロセスが、\n","但这个过程，吞食后的这个流程，\n"],["どうにもつらい時間だ、わ。[l]\nもう少しスムーズに動いて欲しい。[l]\nそういえば薬、まだだった。[l]\nそうか、その所為もあった……のかも。","实在是难熬的时间呢。[l]\n希望能运作得更顺畅些。[l]\n说起来药，还没吃。[l]\n是吗，也有那个缘故……吧。"],["水……","水……"],["で薬……","然后药……"],["億",""],["劫だけど、起き上がる。","虽痛苦，还是撑起身。"],["身体を起こして背筋を伸ばすと、\n何かが通った感じで、\n錯覚だろうけどお腹の具合も頭の方もすっきりと、\n……やっぱ姿勢も原因かなあ？","当支起身体伸展背脊时，\n有种什么通过的触感，\n虽说是错觉但腹部和头部都清爽起来，\n……果然姿势也是原因吗？"],["ふぁっ。","哈啊。"],["急に立ち上がったからか、め、","或许因为突然站起，眼、"],["目","用目"],["眩が……[l]\n血が下に、\nきがとおく、\n","发晕……[l]\n血液往下、\n意识远去、\n"],["「キミは、あれらがミドリノハヤシと──」","「你，那些东西与绿林——」"],["「Ｙがね、肝要だったのだ──」","「Y啊，才是关键所在——」"],["「通例なら──」","「通常来说——」"],["……もう少しで、[l]\nこんな状況も、\nほんとうにおわるのかな。[l]\n最近は特に前の出来事が、\nえーと、ソーマトー？みたいに？[l]\nやけに思い出して、\n","……再差一点、[l]\n这种状况、\n真的能结束吗。[l]\n最近尤其频繁回忆起、\n呃、像索玛托？那样？[l]\n过往的事、\n"],["「何しろＹの振舞は、あれの愚行のそもそもの原因……[l]\n　　　　たとえ一方的なものでもね。[l]\n　　　　まさにキミはその犠牲者になりかけて──」","「毕竟Y的举动正是那愚行的根源……[l]\n　　　　即便只是单方面也罢。[l]\n　　　　你险些就成为其牺牲品——」"],["ああ、\n難しい事は昔から、\nよく分からないけど、\n","啊啊、\n复杂的事从以前、\n就不太明白、\n"],["「特に僕等……八相の眷属の場合は、[l]\n　　　　各相が分かたれているから──」","「尤其我们……八相眷属的情况、[l]\n　　　　各相皆被分离故——」"],["一揃えのうちどれかが取り分け群を抜くということは、\n逆に言えば、比べて他が駄目というか、\nそれぞれが独立してればまだしも、\n","整套之中若有某部分特别突出、\n反过来说其他部分就相形见绌、\n若各自独立倒还好、\n"],["勉強はしたからそのくらいは、\n","因学习过所以这点程度、\n"],["だからつまりは何かが常に欠けていて、\n","故而总有什么常处于缺失、\n"],["「キミがみにもつのはその中でも──」","「你所持有的正是其中——」"],["「つまり根源的で、避けられない、いかなるものも──」","「即根源性且不可避免的，任何事物都——」"],["「僕がある程度は軽減に貢献できるだろう、しかし、\n　　　　根本的な解決には、──」","「我或可稍作缓解，然而、\n　　　　根本解决则需——」"],["一箇所が突出してるから不自然さが、\n違和感が浮き彫りになるとかどうとか、\nまあ、腫れ物だってそうだろうけど、\n","因某处过于突出导致不自然、\n违和感被凸显之类、\n嘛，肿块也是同理吧、\n"],["「と言う訳でだ、\n　　　　特に全体を統合するのに大事なのは、──」","「正因如此、\n　　　　尤其统合全体时重要的是——」"],["「キミのそれが●相、\n　　　　つまり●●に特化しているのと同様に、\n　　　　彼女のあれは●●●●に特化している。[l]\n　　　　故に、──」","「你那是●相、\n　　　　正如专精于●●那般、\n　　　　她那个则专精于●●●●。[l]\n　　　　故而——」"],["それが、今年もやってきて、しかも他に気を取られて","那件事今年又来临，还因其他事分心"],["漫ろだと、\n……でもどういう理由とかはもう、[l]\n正直どうでもよくて。[l]\nそれをどうにかすればいいなら、\n","心不在焉、\n……但具体缘由已经、[l]\n说实话无所谓了。[l]\n若能设法解决的话、\n"],["げほっ、\n……まだちょっと、つらいな。","咳呃、\n……还是有点，难受啊。"],["「ＸＸＸ？[l]\n　　　　ああ、──」","「XXX？[l]\n　　　　啊啊，——」"],["●●……には、[l]\n多分、\n憧れというか、崇拝みたいな、\nいや、渇望、やっかみ、羨望、嫉妬、\n要するに、羨ましさが、\nああ自分が●●だったらいいのに。[l]\n●●は完全だ。[l]\nずるい。[l]\nだから、\n","●●……对于，[l]\n大概，\n说是憧憬也好、崇拜也罢，\n不，是渴望、眼红、羡慕、嫉妒，\n总之就是，这种羡慕，\n啊啊要是自己能变成●●就好了。[l]\n●●是完美的。[l]\n太狡猾了。[l]\n所以，\n"],["「初めはすべて●●という話がある、\n　　　　発生の途中で、──」","「最初有关于一切都是●●的说法，\n　　　　在发生的过程中，──」"],["ずっとそうだった。[l]\n●●になりたかった……んだろうと思う。[l]\nひとに言われてこんな……してるけど、[l]\nほんとうは、\n","一直都是这样。[l]\n我大概……是想成为●●吧。[l]\n虽然被人这么说才……这样，[l]\n但其实，\n"],["自分だって、\n●●がよかった。","我自己，\n觉得●●更好。"],["●●がよかったのに。","明明●●更好。"],["●●なら、……ちゃんと。","如果是●●的话，……就能好好。"],["「確かに●●でない存在など、\n　　　　単に配偶子としてのヴァリエーションの為の\n　　　　ものでしかない、\n　　　　と極論することも出来なくはなかろうな。[l]\n　　　　実際は複雑な要素があるだろうし、\n　　　　それがもし是非の非ならば\n　　　　とうに淘汰されている構造だろうから、\n　　　　……まあ何にせよ、基本としてのユニットは──」","「确实若非●●的存在，\n　　　　单纯作为配子变异的\n　　　　用途罢了，\n　　　　极端点说也不是不行吧。[l]\n　　　　实际应该存在复杂因素，\n　　　　若那是否定之否\n　　　　恐怕早该被淘汰的结构，\n　　　　……总之基本单元姑且——」"],["また眠くなってきた……[l]\n寝るのは好き……[l]\n寝てしまえばその間は、\nなにも……","又犯困了……[l]\n最喜欢睡觉了……[l]\n只要睡着期间，\n就什么都不用…"],["「……巧くは、否、多くは言えないが、[l]\n　　　　キミはきっと大丈夫、なにしろ──」","「……虽不能巧妙，不，虽不能多言，[l]\n　　　　但你肯定没问题，毕竟——」"],["もう、\n独りでイキたいと思ったりもするけど、\n","虽然偶尔\n也会想独自高潮，\n"],["あの時に知ってしまったことがあるから、\n","但因那时知晓了某些事，\n"],["少ないけれど、だからこそ確実に、\n強く、鮮明で鮮烈な、\n","虽稀少，才更确实地，\n强烈、鲜明而灼热的，\n"],["『良き記憶』、『真っ当な想い出』が、\n","『美好记忆』、『正当回忆』，\n"],["だから、未練が、","所以，执念才，"],["渇","渇"],["望が、\n","望啊，\n"],["そんな仕合わせがあると知ってしまった、から、\n","因为已经知道了有那样的幸福，\n"],["「下手に欠片を口にしてしまえば、\n　　　　空腹感はより一層、\n　　　　何も口にせぬよりも増してしまう、\n","「要是贸然将碎片含进口中，\n　　　　空腹感反而会愈发，\n　　　　比什么都不吃时更加，\n"],["その先をソウゾウしてしまう。","让人忍不住去想象那之后的事。"],["あるモノゴトの一端を知る、というのは、\n　　　　知らぬ時には無かった筈の、\n　　　　埋めるべき、\n　　　　或いは埋まらぬ空白をも\n　　　　自覚してしまう──事でもあるのだ。","知晓某件事物的片段，\n　　　　就意味着要意识到，\n　　　　那些本不该在未知时存在的，\n　　　　需要填补的、\n　　　　或是永远无法填补的空白──"],["しかしね、\n","但是呢，\n"],["ああ好奇心猫を殺すとはどういう意味だったか──\n","啊所谓好奇心害死猫原来是这个意思──\n"],["まあいずれにしても、だ。[l]\n　　　　知らなければ良かったと思っても、\n　　　　それは最早、\n　　　　肉の方が。","嘛总之就是这样。[l]\n　　　　即便想着不知道就好了，\n　　　　那也已经\n　　　　是肉体这边。"],["欠けている、と懊悩することになるのだ、\n　　　　そう、●●に──」","会为缺失的部分而懊恼，\n　　　　没错，就像●●──」"],["……餓えてしまうの、だ、","……会饿得发狂的，"],["わ。","哦。"]],"context":[["SC_S_029.ks/index/1/text"],["SC_S_029.ks/index/3/text"],["SC_S_029.ks/index/5/text"],["SC_S_029.ks/index/7/text"],["SC_S_029.ks/index/9/text"],["SC_S_029.ks/index/11/text"],["SC_S_029.ks/index/13/text"],["SC_S_029.ks/index/16/text"],["SC_S_029.ks/index/18/text"],["SC_S_029.ks/index/20/text"],["SC_S_029.ks/index/23/text"],["SC_S_029.ks/index/25/text"],["SC_S_029.ks/index/27/text"],["SC_S_029.ks/index/29/text"],["SC_S_029.ks/index/31/text","SC_S_029.ks/index/33/text","SC_S_029.ks/index/35/text"],["SC_S_029.ks/index/37/text"],["SC_S_029.ks/index/39/text"],["SC_S_029.ks/index/41/text"],["SC_S_029.ks/index/43/text"],["SC_S_029.ks/index/45/text"],["SC_S_029.ks/index/47/text"],["SC_S_029.ks/index/49/text"],["SC_S_029.ks/index/51/text"],["SC_S_029.ks/index/53/text"],["SC_S_029.ks/index/56/text"],["SC_S_029.ks/index/58/text"],["SC_S_029.ks/index/60/text","SC_S_029.ks/index/75/text","SC_S_029.ks/index/82/text","SC_S_029.ks/index/86/text"],["SC_S_029.ks/index/62/text"],["SC_S_029.ks/index/64/text"],["SC_S_029.ks/index/66/text"],["SC_S_029.ks/index/69/text"],["SC_S_029.ks/index/72/text"],["SC_S_029.ks/index/77/text"],["SC_S_029.ks/index/79/text"],["SC_S_029.ks/index/84/text"],["SC_S_029.ks/index/88/text"],["SC_S_029.ks/index/90/text"],["SC_S_029.ks/index/93/text"],["SC_S_029.ks/index/95/text"],["SC_S_029.ks/index/98/text"],["SC_S_029.ks/index/101/text"],["SC_S_029.ks/index/104/text"],["SC_S_029.