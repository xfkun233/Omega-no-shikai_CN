"start":20889,"end":21079}],[{"start":21105,"end":21109}],[{"start":21142,"end":21152}],[{"start":21178,"end":21290}],[{"start":21300,"end":21340}],[{"start":21423,"end":21474}],[{"start":21500,"end":21505}],[{"start":21535,"end":21657}],[{"start":21688,"end":21695}],[{"start":21725,"end":21808}],[{"start":21839,"end":21840}],[{"start":21849,"end":21868}],[{"start":21898,"end":21975}],[{"start":22001,"end":22033}],[{"start":22043,"end":22189}],[{"start":22195,"end":22222}],[{"start":22282,"end":22354}],[{"start":22385,"end":22394}],[{"start":22454,"end":22489}],[{"start":22523,"end":22640}],[{"start":22718,"end":22780}],[{"start":22786,"end":22834}],[{"start":22865,"end":22901}],[{"start":22927,"end":22948}],[{"start":22958,"end":23028}],[{"start":23034,"end":23040}],[{"start":23050,"end":23058}],[{"start":23089,"end":23115}],[{"start":23141,"end":23161}],[{"start":23226,"end":23267}],[{"start":23293,"end":23319}],[{"start":23329,"end":23355}],[{"start":23363,"end":23382}],[{"start":23390,"end":23408}],[{"start":23416,"end":23434}],[{"start":23467,"end":23525}],[{"start":23573,"end":23634}],[{"start":23644,"end":23691}],[{"start":23707,"end":23722}],[{"start":23752,"end":23753}],[{"start":23763,"end":23780}],[{"start":23786,"end":23844}],[{"start":23854,"end":23860}],[{"start":23866,"end":23927}],[{"start":23933,"end":23939}],[{"start":23945,"end":23948}],[{"start":23958,"end":23968}],[{"start":23982,"end":23987}],[{"start":24006,"end":24018}],[{"start":24032,"end":24055}],[{"start":24074,"end":24094}],[{"start":24104,"end":24109}],[{"start":24123,"end":24141}],[{"start":24160,"end":24179}],[{"start":24193,"end":24235}],[{"start":24254,"end":24272}],[{"start":24286,"end":24313}],[{"start":24344,"end":24358}],[{"start":24364,"end":24419}],[{"start":24465,"end":24479}],[{"start":24507,"end":24528}],[{"start":24538,"end":24551}],[{"start":24565,"end":24575}],[{"start":24596,"end":24714}],[{"start":24720,"end":24767}],[{"start":24777,"end":24952}],[{"start":24965,"end":24966}],[{"start":24975,"end":25121}],[{"start":25131,"end":25145}],[{"start":25151,"end":25257}],[{"start":25271,"end":25282}],[{"start":25301,"end":25314}],[{"start":25320,"end":25338}],[{"start":25344,"end":25415}],[{"start":25429,"end":25430}],[{"start":25440,"end":25475}],[{"start":25485,"end":25492}],[{"start":25502,"end":25509}],[{"start":25527,"end":25571}],[{"start":25577,"end":25628}],[{"start":25638,"end":25639}],[{"start":25648,"end":25654}],[{"start":25660,"end":25677}],[{"start":25683,"end":25763}],[{"start":25769,"end":25808}],[{"start":25822,"end":25831}],[{"start":25850,"end":25873}],[{"start":25887,"end":25892}],[{"start":25911,"end":25929}],[{"start":25943,"end":25956}],[{"start":25975,"end":26000}],[{"start":26014,"end":26029}],[{"start":26048,"end":26102}],[{"start":26116,"end":26126}],[{"start":26145,"end":26210}],[{"start":26222,"end":26229}],[{"start":26248,"end":26260}],[{"start":26370,"end":26376}],[{"start":26455,"end":26463}],[{"start":26469,"end":26570}],[{"start":26576,"end":26595}],[{"start":26601,"end":26690}],[{"start":26725,"end":26745}],[{"start":26773,"end":26826}],[{"start":26832,"end":26835}],[{"start":26870,"end":26926}],[{"start":26954,"end":26974}],[{"start":27009,"end":27023}],[{"start":27075,"end":27087}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_060.ks","basename":"SC_M_060.ks","indexIds":{"「……おもい……重い……」":0,"……重いって。":1,"めがさめると、":2,"……連日の疲労の為だけではないだろう、[l]\n身体が物凄く重い……[l]\nかなり気怠い気分で、\n二度寝をしたい衝動に襲われながら、\nいや、そういうんじゃなくないか、なんだこの重いのは……[l]\nという疑問、\n布団にしては、いや、\nそもそも此処は何処で、\nああ、車で寝てたんだった、前の日も、":3,"……まだ眼が開けられない……":4,"全く頭が働かん……":5,"………。":6,"うーーん……身体はあったかいが、[l]\n足先や顔に当たる冷気、\nそして、何だかもしゃもしゃしたものが、\n":7,"擽ったいったらないなぁ……[l]\nこれって……":8,"「……カミのケ…………髪の毛？[l]\n":9,"っっ（っおあくぁぐ！！！）」":10,"大声を出しそうになるのを何とか抑え込みっ、\nって、あ？！なにこれ！！":11,"完全に正面向き合う形で抱き合う形で、\nいや、正確には此奴が一方的に抱き付いてる型であるが、\nうぇ？！[l]\n何で何がどうなってこの形？？！！！":12,"「！！？？」":13,"僕が、下で、奴が、上に、":14,"いや、うそ、あれ？[l]\nまさか夢……じゃないな、[l]\nなにこの状況？！":15,"「……えーーーーーーと……っ」":16,"はっ！":17,"声を殺したつもりだったが、\n此奴ももぞもぞ動き出す。":18,"僕は全く動けずに、息も止めて身体を硬くしているしかなかった。":19,"「………」":20,"「………！？」":21,"……幸い、まだ起きるには至らなかったらしく、[l]\n奴はまた寝息を立て始めた……[l]\n……え、幸いなのか？[l]\nど、どう転んでもこれは、\n一悶着、無いわけが、":22,"「（……こ、こいつ……おま、[l]\n……なんなんだよこれ……）」":23,"脚も腕も完全に絡んでいて、\n起こさずに、ほ、どけるかこれ……？[l]\nかと言ってこのまま此奴が起きたら、\nどう、なる？！[l]\nや、もちろんこのままでも困るけども、\nこんな、ご、誤解され──":24,"誤解？[l]\n誤解だよな。[l]\n誤解じゃないなんてことは、\nや、逃げようとしてる訳じゃない、\nただ少なくとも記憶は、\n……まあ、僕のそれがアテにならないのは重々承知してるけど、":25,"「（……なんだこれ？！なんだこの状況？！[l]\nもっとなにかこう、":26,"深":27,"刻な感じで僕等、\n……色々、あったんじゃ……いや、[l]\nいいやそれは、と、それよりこれ、\nどうしよう……）」":28,"冷静に考えて、今はど、どうしようもないな……[l]\nいっそ寝直して、\n此奴に先に起きて貰おうか、とも思ったけど、\nこっから二度寝は流石に無理が……[l]\nああああ、ね、寝たふりでいいのか、\n取り敢えず、眼、眼は瞑っとこう。":29,"や、まあ、此奴が上で或る意味良かった、\n逆だったらばそれはもう、その前段階がどうこうでなく、\nその時点で弁解の余地なしだったけども、\nと、取り敢えずこの状況は此奴が自発的にせんと成り立たんからな！":30,"……一旦落ち着こう。":31,"夕べ一緒に寝たのは確かだが……[l]\n寒かったし、\n此奴の寝相の問題だろし、\n恐らくずっとこの体勢だった訳じゃないだろうし、\nそもそも別に、変な事ぁ、":32,"「……んー……ぅにぃー……」":33,"──しっかと強めにしがみついて来る狩屋。":34,"そっと眼を開けてみる。":35,"……まだ起きはしないようだが、[l]\n呼吸の度に何となく覚醒の度合いが強まってる……か？[l]\nそれより、その吸ったり吐いたりの動きが伝わって、\nお前、どうしたらいいんだよ。[l]\n寝相というか、無意識的な行動として、\n此奴って普段抱き枕生活なのかしらん、と思いつつ、\n顔を覗き……いあ、視ないようにしよう……":36,"「……んっ……ん～～～、[l]\n………んーーー……」":37,"「………！！！[l]\n……………、[l]\n…………、[l]\n………？[l]\n……………ふは………」":38,"別に悪いことをしてる訳じゃないが、\nどうしたって身体は固くなる。[l]\n……呼吸すら止めていた事に気付き、[l]\n僕は静かに、\n顔を逸らせて息を吐いた。":39,"──お前ほんとに、\n起きた時、\n自分で色々処理せえよ。":40,"僕のせいじゃ無いかんな……たぶん……":41,"「（……今、何時だ？）」":42,"顔を逸らしついでに車の外を視る……が、[l]\n体勢的によくわからない。[l]\nただ、\n外からはどうやら蒼白い……灰色めいた薄明かりが、[l]\n車内に射し込んでいるようだった。[l]\n昼か夜かも判らない……いや、流石に夜ではないか……[l]\nただ、なんだろう、この感じは──":43,"そうか、雪が降って、\nもう止んではいるようだけれども……":44,"まだ、寒いな……":45,"「（ちくしょう……こいつ……あったけえなあもう……）」":46,"奴が重なってる所は、\nまるで、":47,"「（……":48,"涎垂らすなよ……）」":49,"いや、そうでなく、\nうーーーん……":50,"──冬夏もあのひとも、\n思えばここまでじゃなかったな……[l]\n……姫様ちゃんやきぃが抱き付いてきた事はあれど、[l]\nいや、だからどうだっていうわけではないが、":51,"まあ、でも此奴も、\n八相のひとり、ネコガミつかうもの……[l]\n僕の、\n本当のカラダがどうとか、その影響なのかな──\n冬夏は昔の事が何か気になってるようだったけど、":52,"……そもそもみんな、[l]\n僕ではなくて、":53,"……そういうことなのかな──":54,"そう思うと、急に、":55,"「……っ……」":56,"なみだが、":57,"「……にぃ……兄ぃ……[l]\nま……こと……さん……じゃなきゃ……[l]\nだめ………たしは……[l]\nずっと…………しょ……」":58,"………？":59,"「……ジシンを……ぁもて……」":60,"「……起きたか？起きてるのか？」":61,"──寝言だな。":62,"……と、ぎゅーーーっ……と此奴のしがみつく力が強まっていく。[l]\n身体の動きも激しくなり、\nいで、いででで、":63,"「……ぬーーーーん……[l]\n……っはふっ、[l]\nんーーーー？」":64,"今度こそ、お、起きたか？":65,"あ、慌てて眼を閉じて寝たふりを──":66,"「………にぃーん……にゃにこれ？[l]\nあー、あー、あー。[l]\nそか、そだった。[l]\nあぅ、兄ぃ、おはようございまふぁー……」":67,"……まだ眼は完全に開いてないようだが、[l]\nそれでも何だか状況は把握してる模様の狩屋。[l]\nえ、その上でのこのアクションすか？！[l]\nまあ、何もないが故だろうけど！！":68,"と言うわけで、\n寝たふりはし損ねたものの、\n取り敢えず騒ぎにはならないぽいので、":69,"「……お、おはようございます」":70,"と挨拶を返した。":71,"しかし体勢は変わらないままで。[l]\n僕の胸の上から顔をみあげる形で、":72,"「……ないてる？」":73,"まだ片眼しか開いてないのだけれど、\nその眼でじっと僕を視ながら言った。":74,"「えあ？[l]\nあ、あー。[l]\nいやあれよ、あ、欠伸の涙だっつの！！！！[l]\nというかお前、え？！」":75,"誤魔化しつつ話題を転換しようと、\n現状について色々苦言を呈そうと思い立つも、\n突っ込むべき所にしても一体、\nどう言えば良い物か、\n結局フリーズするしかない僕を余所に、":76,"「あーぁそう……[l]\nちっと頭動くまで待って……[l]\nさむい……うぉおーぬくいし……ねたい……」":77,"顔をぐりぐり擦り付けんな！[l]\n僕ぁ枕じゃないですにょって！！":78,"てかお前ほんとに状況把握してるか？[l]\n寝惚けてないか？[l]\n誰かと間違ってないか？":79,"と、\nまた半開きの眼でこっちを視る狩屋。[l]\n数秒そうしてたから、\n確実に、僕を確認してない訳はないのだけれど、\n狩屋はまた顔を埋めて寝りの体勢に入ったので、":80,"「や、まて、\n寝なさんなよ、\nもういま何時だと……何時だ？」":81,"と突っ込みつつ自問自答する。":82,"此奴も起きた事だし、二度寝させないという意味も込みで、\n遠慮無く身体を動かして──すっかり固くなってたな我が身体、\n携帯電話で時間を確認する。[l]\nそういやアラームもセットしないで寝たんだな。[l]\n莫迦みたいに寝過ごしてる可能性も無くはないな……":83,"「着信……もメールも無しで、[l]\nえー、\n……昼の零時半だってよお前さん」":84,"「んにぁー？[l]\nああもういい加減……ぇで呼べぁいいのに……[l]\nんっ、んんんんん～～～～～～、\n……トイレ行ってくる」":85,"よく判らん難癖をつけた後、\n漸く身体を起こし伸びをして、\n奴はそう言った。":86,"「おう、いてらー、\nその服は取り敢えず羽織ってって構わん……」":87,"「うんありあおう……[l]\nふわあぁ……うんしょ」":88,"立ち上が……と言っても天井低いので腰折だが……ると、[l]\n髪ほどいてたの忘れてた、\n一瞬別人かと思ったこいつ、脅かすなよ。":89,"数回眼を":90,"瞬かせて、\n狩屋は危なっかしく車から出て行った。":91,"ドアを開けた時に入り込んだ、\n外気が今は心地良い。":92,"それに急に身体が軽くなった所為か、\n何か変な感じだな……":93,"にしても──":94,"夕べは一体なんだったのか、\n奇妙な夢をみてたような気もするけど、\n覚醒と同時に殆ど飛んでしまった。":95,"「……独りになるとやっぱまだ眠いな眠くなるな……」":96,"しかし、\n何か忘れてるような気がする──のはいつものことだが、\nそれでも尚、どうも引っ掛かってることが、":97,"「……駄目だ、空腹時と眠い時は、[l]\nまともな思考が……いや、寧ろ……」":98,"──浅い階層は不活性になり、より本義的な回路が、":99,"つまり人情とか思いやりとか気を遣うとかそういった、":100,"──優先順位が通常と異なり、より本能的に、":101,"だから、そういう時に人と話すと、ずけずけと、":102,"──エゴが丸出しになるから、":103,"コミュニケーションするには最も不向きなコンディションであって、\nだから僕は、":104,"「……だからもう今脳が空転しっぱなしなんだって……」":105,"いかん、\n──外に出るか。[l]\n風に当たってシャッキリすべえ。[l]\nトイレは……別にしたくはないけど、[l]\n顔くらいは洗いたい。[l]\n彼奴が来るまでは戸締まりが気になるので、\n車を離れられないが。[l]\n締め出しとくとまた文句言われそうだし……":106,"「すっかり晴れたな……」":107,"正確に言うなら、\n雪は止んでいたけれど、\n空の半分程はまだ銀色のままだ。":108,"肌に感じる空気は、\n流石に未だ寒い──寒いと言っても相対的な話で、\n雪は既に、\n日陰には多少積もったまま溶け残ってはいたものの、\n殆どはその姿を消して、雨上がりのように、\n辺りに水溜まりとしてその残骸を残すのみ。":109,"どうやら僕等が寝てる間に、\n気温も一般的なこの時期の範疇まで、\n──この北の地ではそれでも肌寒かったけど、\n戻ったということか。[l]\nというか昨日が特別過ぎたんだけど……":110,"「さむい、ねむい、はらへった、\nだるい、つらい、きつい、えーーーーーと、\nなんだっけな、\nなにをしなくちゃいけないんだったか、\n………、[l]\n………？[l]\nああ、……しんどいな……」":111,"僕の頭の中は今何やら真っ二つになっているようで、\nまさにこの空の感じだな、と薄ぼんやりと思っていた。[l]\n恐らくは外気と体温の間に出来た急な温度差による、\n錯覚のようなものなんだろうが、\n──そう、だからすぐに、\n治まるだろう。":112,"なんだろう、何というかまるで、\n風邪薬でも飲んだ後のような、\n……あれだな、落ち着くまでは車の運転しない方がいいな。[l]\n……そんな余裕が──[l]\n──ここでじっとしてるだけという、\n選択の余地があればだが……":113,"「でも何故か……妙な安定を何処かで……[l]\n感じてるのはなんでだ……？」":114,"腹が据わったとか、\n自暴自棄……捨て鉢の境地に至った感じとも違う、[l]\n──絶対的な●●●。":115,"恐怖も不安も、生命活動を脅かすものへの感情ではあるが、\n僕等は要するに未知に恐怖するんだ。[l]\nワカラナイものが怖いんだ。[l]\nレスが無いのが厭なのも、\n待つのがつらいのも、\n或る意味でその一環なのかも知れないな。":116,"逆に言えば、":117,"「ただいもー……[l]\n完全に昼だよにぇー……[l]\nこんなに寝たの久しぶりにゃもおわっ」":118,"びゅおぅ、と強めの海風が吹いた。[l]\n……海風と断じて良いかはあれだけど、[l]\nそれはまだ結ってない奴の髪を":119,"靡かせて、\n同時に僕の、":120,"「うっわあんだこれ」":121,"僕の眼にゴミをいでででで。":122,"「あによ大丈夫？[l]\nあ、はいこれありーでした」":123,"「いっでで、ああ、どうも……」":124,"奴の差し出した上着を受け取った時点で、\n何の思考をしていたか……なんだっけな。":125,"それにしても、\n相変わらずというかそういうもんなのか、\nこっちが肩肘張りすぎてるだけなのか、\n例によって拍子抜けというか何というか、\n慌てたりなんだり、\n自意識過剰に思い悩んで対応に苦慮して右往左往、\n":126,"──するのはいつも♂なんだ。[l]\n":127,"ま、此奴とは事実何もありゃしない、し、\n別に良いんだけどさあ、\nどの距離感が『普通』なのか、僕には、":128,"「ごはんどうしよう？[l]\n視てきたけど、平日だしすっかすかだったよそこ」":129,"……奴の声で、僕の愚考はあっさりとシフトを許す。[l]\nコンディション云々以前に、\nまあ僕ぁそういう奴だわな、流され流され生きてるんだな……[l]\nいや、だからといってここでわざわざネガティヴに陥るのもきついから、\n慌てて眼の前の問題に集中する、ことにする。":130,"「──ん？[l]\nあ、あー、飯なぁ、どうすべえかなあ……[l]\n──すっかすか？[l]\n昼時にゃのにか？」":131,"「昼時にゃのによ」":132,"「空いてるなら好都合じゃないん……ああ、[l]\n":133,"人":134,"気がないかもか」":135,"「オフィス街でも学生街でもにゃいし、\n量も品数もその、\n殆どファストフード店レベルだったし、\n人気がどうとか言う前に食事処の選択肢としては」":136,"「あーん、そもそも比較にならんかつまり。[l]\n激烈に美味い何かがあれば別として、\nってそれは望むべくもないわな……[l]\n要するに客の多寡は判断材料にならない訳だろ、\nまあ、すぐ喰えるという意味では少ない方が──」":137,"「強いて言えば海産物絡みが多いのと、\n謎のおすすめすいーつがあっちのコーナーに……」":138,"此奴もまだ寝惚けてるのか、\nどの内容に対してのレスなんだかその発言、\n少々ズレてる気がするが。[l]\n取り敢えず此処で会話の精密さをどうこうしても詮無いので、\n整合性を失わない程度の返しで応じる。":139,"「あー、海産は魚以外はちっと駄目だなあ……[l]\nてかお前はどうしたいよ」":140,"「ういはにゃんでもおけーにぇす」":141,"「……どっか移動するか？」":142,"「にゃんでもー」":143,"「や、お前がいいんなら僕はそこで構わんのだよ、\n一応気を遣ってだな……」":144,"「……あんま今ものごと考えたくにゃいから」":145,"「……そら僕だって一緒だっつの。[l]\nじゃーそこにすんぜ」":146,"「らにゃー」":147,"準備やら、僕の用足しを済ませると、\n僕等は二人して其処に向かう──":148,"……ほんとに僕等、一体何してるんだろうか。":149,"という疑問というか、\nこれでいいのか？という、[l]\n反省……というか、焦りのようなものは常に頭にある。[l]\nそれは、例の妙な安定と、奇妙に両立して心にある、\nしかし、いや、だからか、":150,"それでも、":151,"今日はどうする？[l]\nこれからどうする？":152,"とは、何故か問えない。":153,"それこそ気を遣っての──\nいや、僕自身が、\n今独りにされるのを、":154,"恐れているのか……もしれないが……":155,"………。[l]\n独りは……、[l]\n………。":156,"──問題には直面しなければ、":157,"わかってはいるけれど、":158,"──今は未だ、":159,"いかんいかんいかん、\nだから腹減りは駄目だって、\n思考の制御がきかなくなって一旦転がり出すと、\nまるでボーリングのた──":160,"「兄ぃ、兄ぃてば、\nまた放心してますかー」":161,"「……すまん、[l]\nはらがへりすーぎたー」":162,"「……ふらふらふらふら危なっかしいつーか、[l]\n気が気でないったらにゃいよもう、\nほれいくよばかっ」":163,"「いっで、わ、わかったひとりで歩けっからっ」":164,"腕を引かれて道の駅の食堂エリア的なとこに入ると、\n狩屋の表現通り、\n田舎大型スーパーの中にあるファストフード店的な":165,"佇まい。[l]\nラーメンカレーたこ焼き鯛焼きソフトクリーム等々的な。":166,"みかねた狩屋が注文その他手続きをするというので、\n少しでも飯っぽいものと思って叉焼麺を、と伝える。":167,"そしてぼーっと外を視ていた。[l]\nおもい、だるい、つらいきついしんどいねむいさむい、\nそういったネガティヴな感情……というか感想が、[l]\n混淆としてぐるぐるぐるぐる止めどなく思考の中を回る。":168,"はらがへった、\nはらが、\nくい、くいものくいてえ。":169,"……やばい、そんなに喰ってないつもりじゃなかったけど、[l]\n連日の無理が祟ってるのか、\nどうも、あたまんなかがわやくちゃに……":170,"「ほい、水」":171,"「ああ、さんくす」":172,"奴はどうやら塩ラーメンらしかった。":173,"こっちに来た時食べに行った、\nあのラーメン屋に比べるのは酷というものだが、\n……まあ、[l]\n空腹も手伝ってか、\n数分後には特に不足不満もなく食し終える。":174,"無言というでもなく、\n他愛もない会話を交えつつ、\n……矢張り肝心なところには何も触れず、[l]\n──人前ということもあって、\nこうして僕等は遅い朝食を摂った。":175,"が、矢張り腹が相当空いてたのだか、\n安かったのもあってたこ焼きを２人で分ける前提で、\n追加で頼んでみる。[l]\n奴も夕べはああ言ってたが、\n昼過ぎたとは言え就寝前じゃなし、\nこれから活動帯だしそんなに問題じゃないだろう。":176,"鯛焼きも捨て":177,"難かったけど、\n":178,"件のお勧めスイーツ……要するに、[l]\nご当地果物入りソフトクリームだったが、\nそっちも喰おうぜと決めていたので今回はスルーした。[l]\n奴もこっちはすんなりＯＫだった。[l]\nまあ、甘いものは別腹……特に女子は本当に胃が拡張するとかしないとか、[l]\nだし、\n実際問題、\n甘いもの、糖分を脳に補給しておきたかったのだろう、\n僕等二人ともが。[l]\n思考するにも精神的に諸問題を乗り切るにも、\nまずは身体が大事、つまりは食が重要だった。[l]\n特に今はそう思う。[l]\n空腹自体が、何も無くとも鬱を呼び込むことだってある……":179,"再び負の思考に囚われそうになるのを振り切って、\n奴に爪楊枝を渡した。":180,"「ほれ」":181,"「ありー」":182,"爪楊枝はちっさいので指が触れあうが、\nもうそういうのはどうでもいい。[l]\n奴も格別なにも反応ないし。[l]\n僕も格別思うことはない。":183,"ド正面に向かい合い、\n紙皿１０個入りのたこ焼きをつつく。[l]\n揚げパン系駄目でもこれは良いんだな……[l]\nわからんでもないけど……って、":184,"……ド正面？[l]\nいや、それは最前からずっとそうなんだが、\nそういやお前、\n昨日の『視るな』っていうのはどうした？[l]\n割とずっと視合ってるんだが……":185,"「んー？」":186,"「……いや、……あ？」":187,"「なに」":188,"「……や、にゃんでも……」":189,"本人がどうもないなら敢えて突っ込む事もないか……":190,"「んー、……」":191,"「どうした」":192,"「なんか、ういも吹っ切れたというか、\nワかったっていうか、\nまーそのあれよ、\nいいじゃんべつに」":193,"「……僕は何も言ってないけどまー、[l]\nお前が良いと思うならそれはそれで、\n良いんじゃないか……[l]\nどっちにしてもその、\n良かった……な、[l]\nで、いいのか？」":194,"「うん、夕べでいろいろ、感じられたから……[l]\nありがと」":195,"「……まあ、[l]\nよくわからんけど……そりゃあ何より」":196,"……んっ？":197,"「……んあ？」":198,"「……いや、え？[l]\n……ってお前、もう自分の分喰い終わりかい」":199,"「兄ぃがぼーとして遅いんにゃってば、\n何かやたらと動き止めるし、\nや、いーけどさ、\nアイスまでの腹ごなし時間になるからういは。[l]\nゆっくりどうぞ」":200,"「……そんなに停止してたか、いかんいかん、[l]\nいかんなあ……」":201,"「いーからゆっくり喰いなって」":202,"「……ああ、まあ、[l]\n適当に喰うよ……」":203,"気のせいか、考え過ぎか、\nそれこそ自意識過剰なのか、\nどうも夕べ……否、起きてからか、":204,"……なんかいつもと違うくないか？[l]\n寝起きだからか？[l]\nいかにこんな感じの仲とは言え、\n出会って間もない奴の事をどうこう言うのもあれだし、\n諸事情というか状況を鑑みて、\n普段とは違っていたって当然と言えば当然なんだが、\nなんというか、\n修学旅行中の朝の、\n同級生の生活面を知った時のような気まずい違和感、\nいや、それともちょっと違うな……":205,"何か、\nどこがどうというか、\nほんとに印象というか、感じた事だが、":206,"──姫様ちゃんの感じが、":207,"「にぇ、……うい、ちゃんと慰められた？[l]\n兄ぃを」":208,"と、唐突に奴が言った。[l]\n視線はこちらを直視して、いる。":209,"「あ、ああ、そうだ……な……」":210,"──少なくとも、１日、遣り過ごさせて呉れたという意味で、\n慰めになったのは確かだ、と思う。[l]\nただ、はっきりうんそうです、と言うのも妙な具合だし、\nかといって否定するのもおかしいので、\n曖昧に頷いていると、":211,"「貸し、ぷらす」":212,"「……はっ？[l]\nおま、\nお互い様じゃないのか今回は」":213,"「あはーん」":214,"「誤魔化すな……まあ、いいや、[l]\n引っ張るネタでもないし。[l]\nあぐんぐ」":215,"矢張り様子が変というか、\nよくわからんテンションだったので、\nスルーして残りを平らげた。":216,"奴が言ったので、\n一旦海を視に砂浜に出て腹ごなししてから、\n車に帰りしなにソフトを買う事になった。":217,"砂浜は雪の名残など皆無で、[l]\nあのときと同じように、":218,"……否応無しに、[l]\n冬夏と来たときを想い出す。[l]\n別に悪い事をしてるわけでもないだろうに、\n何故か":219,"背":220,"徳い気持ちに包まれる。":221,"それが冬夏に対してのなのか、\n此奴に対してのなのか、\n──それとも、":222,"……否、気のせいだと思う。":223,"「……おーい」":224,"「まさか水に入ったりはしないよな？」":225,"「ぉあ゛っ？！[l]\n":226,"するわけにゃいじゃん？！[l]\nするわけにゃいじゃん！！[l]\n":227,"ばっかじゃにゃいの？！」":228,"にゃんで２度言うかはさておき、\nお前もそうやって":229,"然も当然のように言うが、\n前例を知ってるからさ……":230,"「まー、[l]\nお前さんはなんつーか、[l]\n常識人だよな……[l]\nいや、良い意味でよ」":231,"色んな意味でわかりやす……いや、[l]\n他が分かり難いだけで、\nあくまで相対的にという意味だが、\nそれでも、[l]\n他人を気に掛ける事が出来るのは、[l]\n……そういうとまるで他が自己中のようだけども、[l]\n":232,"──あながち否定出来ないのも確かだしなあ。":233,"……はっ？":234,"「っさいなぁ、[l]\nちっと元気になったと思ったら減らず口ばっか、[l]\n":235,"ばぁーか、ばか兄ぃ」":236,"「いや、褒めてんだよまじで、\n……普通が良いよ普通が、[l]\n可もなく不可もなし、\nああいやその、お前をばかにしてんじゃないぜ、\n僕はその、そうやって、普通に、波風なく、[l]\n静かに暮らしたい、[l]\nんだよ……」":237,"「……じじくさいのう」":238,"しかし、本心でもある。":239,"起伏のない毎日でもいい、[l]\n大きく昇る喜びがあっても、[l]\nそこから大きく沈むのは、[l]\nもう疲れる、[l]\nそれよりはいい……":240,"道具さんのような生き方は、[l]\n僕には向いてない。[l]\n起こる出来事をゲームのイベントよろしく愉しむなんて、[l]\n僕には":241,"瑣":242,"事ですら一個一個が重い現実で、":243,"──相手方にいちいち感情移入してしまう傾向もあり、":244,"受け流すのも下手なのに、":245,"──敵をしっかりと敵と認定する場面もあるから、":246,"とても、そんなことは、":247,"──そのために強くなること。":248,"それに、":249,"──解決にはときに、[l]\n\n\n──根源の消去が必要に、":250,"……こわい、[l]\nいや、ちがうのか、":251,"──気弱になってるのか、[l]\n\n\n──その逆か、":252,"いずれこの世界にいる以上、覚悟と、行動は、[l]\nしかしそれでも、":253,"……兎に角、静かにありたい、[l]\n今はこころからそう思う。":254,"「じじいで結構……[l]\n子供のままで全う出来る渡世ならまだしも、[l]\nいつまでも餓鬼で居られないなら、[l]\nとっとと隠居して暮らせればって、[l]\nそう思うことぁある、のは事実さ、[l]\nいーんだよ僕は、どうせアナクロじゃし」":255,"──実際あれらは、それ以外の期間を引き延ばす為の、":256,"……そんなのは、僕には、合わない……":257,"「ま、わっかるっけどおー。[l]\nその気持ちも。[l]\nういだってさ、\n別に、あに……っと、[l]\n":258,"あ、[l]ごめ、電話」":259,"「ん、あ、ああいいよ」":260,"着信は聞こえてたので頷き、通話を促す。":261,"相変わらず僕の言を聞いていたのかいないのか、\nレスポンス的に、\n殆どの部分をすっ飛ばされた感は否めないが、":262,"……僕は何となく奴から離れて、[l]\n会話が耳に入らないようにした。":263,"数分とかからず奴の通話は終わり、\n僕の近くまで寄ってきた奴が言う。":264,"「トモさんからだった。[l]\nきーちゃが、\n取り合えずその、\n落ち着いたみたい。[l]\n……うん」":265,"「そうか、良かったな……[l]\nあ、\nと──」":266,"……うか、冬夏の、":267,"いや、言わないってことは、\n今の電話では特に何も、言われなかったんだろう。":268,"そういえば姫様ちゃんの調子も、\n今までどうだったのかをあまり、\n具体的には聞かされてなかったけれど、\n何かやっぱりあったって事なんだろう、":269,"とは言え、取り敢えずは──落ち着いたって事なら、\n……そうか、つまり、此奴も此処に居る理由が、[l]\nなくなったって事だな、\nいや、\nいいこと、なんだけれど、\n──●●●●●ない。[l]\n………だめだ、だめだだめだ、[l]\nなんだその思考は……":270,"独り頭の中で仕切り直して、\n狩屋に訊いた。":271,"「ああ、まあ、\nで、\nどうすんだ。[l]\n帰るのか？」":272,"「トモさんは、\nまだ構わないって言ったけど、[l]\n":273,"……もう、戻るね、[l]\n流石に３日以上はその、着替えも無いし、その、[l]\n":274,"色々多方面で問題が、あはは……[l]\n":275,"あーまー、[l]\n":276,"きーちゃの様子、みときたいし」":277,"「そうか、や、止める気は無いし……[l]\n別に気にせんでいい……[l]\n……ああ、いろいろありがとうな。[l]\n結局こっちは何も出来なかった気がするけど……[l]\nあ、\nアイスどうする？」":278,"「あー………、[l]\nどしよう」":279,"何故かそこで、\n小首を傾げ僕を凝視した後、":280,"「それくらいはいけるよ。[l]\nてかここで拒否ったら、\n兄ぃへこみそうにゃし」":281,"……まあ、[l]\n予定というモノは、\n立てた以上中止されるとへこむのは確かだが、\nお前にまで憐れまれるとこう、\n相乗効果で余計にあれだぞ。":282,"「まあ、\nちょっとは心に余力が出来たし……[l]\n何より兄ぃにも元気になってもらわにゃー」":283,"「おめーに高々アイス食同伴されたってな……」":284,"「え、………。[l]\n":285,"ばっ、[l]\n兄ぃわばかか！！！」":286,"「は？[l]\nいや、お前、いだだだだ」":287,"それはそれ以上だったら元気になるって意味、":288,"[l]\n[l]\n……じゃねえよ！[l]\nえろい方向に深読んで俺を殴打すな！！":289,"「……我慢しろばか、[l]\n":290,"じゃーいこうにぇー」":291,"「我慢の意味がわかんねえけどな……[l]\nっとによう……」":292,"釈然としないまま、\nしかし、\nありふれたこの感じに安堵しながら、\n──そしてこの後来るであろう揺り戻しに、\nやはり何処かで":293,"戦きながら、\n僕等は砂浜を後にした。":294,"微妙に高いそのソフトを買って、\n二人して舐めながら車に戻った。":295,"こういう時に、甘いものは矢張りいい。[l]\nほんとに凹んだ時は味なんか分からなくなるけど、\n僕もまだ、味覚が鈍磨する程ではないらしい……否、[l]\n──此奴に慰められたが故だと思ってやるか。[l]\nとにかく、\nまだちゃんと甘い、旨いと感じる事が出来る。[l]\nそういう目的だったとは言え、\n脳の空転もおかげで大分ましになった気になれた。":296,"狩屋の話だと、\n姫様ちゃんは冬夏の……三春の家に居るらしかった。[l]\n一応車で送ろうかと言ってみたが、\n拒否された。[l]\n僕としても、矢張り今彼女等の……しかも本拠に、[l]\n近づくのは、まだ色々と気後れする部分が多すぎた。[l]\nだから、逢う時同様、僕にとっては助かったと言えるけど、":297,"そしたら、\nまた独りか。":298,"……ふと奴を視ると、[l]\n奴は現金なもので、\n──責めはしないが、\nソフトを喰い終わる頃には、\nもう気が":299,"漫ろになってた。[l]\nそれでもいよいよ別れしな、\n彼奴は":300,"饒舌に、喋り出した。":301,"「なんちゅーかさ、\nこっちも色々立て込んでくるから、\nしばらくこういうの難しいかもだけど、\n私はミカタだよ、兄ぃ、\nねこのことだけじゃなくて……[l]\nああもうにゃんか言葉浮かばにゃいな、\n……ん、そう、[l]\nきーちゃがね、\nこういうのは感得するものだって、\nだから、\nその、\n……えいっ」":302,"ばんっ。":303,"「いっ──でぇよ！」":304,"何故か突然奴は、\n僕の肩をがっしと掴んでこっちを向かせた。[l]\n車の席だから少々無理くりで、\n──そして誰かさんのように、\n流石に照れがあったのか、\n視線は合わせずにもう一度肩を強く":305,"叩いて、\nそのまま一瞬服の袖を握りしめ、\nそしてすぐ手を離した。":306,"「……っかってるはずだよ、[l]\n視えるんなら、\nだいじょぶだよ、\n兄ぃは、」":307,"──……。":308,"「おなじものを視てるなら、\nういらとも色々、うん、まあ、\nまあね、色々、\nなかま……友達……にゃ、[l]\nち、知人としてこれからもさ、\n付き合ってけるよ、\n少なくともうい個人は、\n………」":309,"「……あによ」":310,"「変な意味に取んにゃよ！[l]\n少なくとも、うい個人は、\n兄ぃのことすきっだから、\n……っ、げふげふ、ごほっ、[l]\nえほっ、えふぁ」":311,"「":312,"噎せなさんな、\nおちつい──」":313,"「こっ！[l]\nこれからもずっとさ！！[l]\nもっと、もっと話すことだってあるだろしさ、[l]\nせっ、[l]\nせっかく、」":314,"知り合って間もないのに、ここまで近く、\nそんなのはじ──":315,"と聞こえたような気がしたが、\nそわそわとしていて落ち着かないのは、\n端から視ても分かり易すぎるくらい分かった……[l]\nつまり、早く姫様ちゃんの所に行きたいのだろうと、\nそう思って、[l]\n僕は奴の話を止めて、\nさっさと行きなよと、そう言った。":316,"一呼吸置き、やや落ち着いた後、\n再び口を開く。":317,"「………ごめん、なさい。[l]\n………まっ、[l]\n……祭が終わったら、[l]\nまた会おうよみんなで、\nねっ？」":318,"「……まつり……」":319,"「にゃ、にゃによ、\nそんな寂しそうな顔しにゃいでよぅ！[l]\n":320,"じゃ、じゃあ、\nいいや、ま、電話でもメールでも、\nキンキュウならいつでもよこして、\n可能なら相手したげっから、\nわかった？いいよね？[l]\nじゃね、\nほんとに、ありがとうございました！」":321,"僕に車を降りる間を与えることなく、\n狩屋は、ばだむ、とドアを閉め振り返ることなく、\n足早に立ち去っていった。":322,"ぐだぐだ後引くのはヤだったんだろうが、\n……いや、いいんだ。[l]\nありがとう。":323,"「みんなで……祭が終わったら……[l]\n祭が終わったら、……か」":324,"……僕だって。[l]\nそうしたい、":325,"……此奴も、[l]\n姫様ちゃんとも、[l]\n在夜ちゃんとも、[l]\n道具さん……とも、[l]\n……冬夏とも、":326,"──きっと、":327,"……なれるのに。":328,"「………すぅーー……、[l]\nはぁーー……」":329,"深呼吸がまるで、\n溜息のようで、":330,"「……昼間だってのに、[l]\n耳鳴りがするくらいに閑かで、\n……」":331,"独りになると、矢張り落差が、\n膨らんだものが":332,"萎むような、\n絶頂からどん底へ墜ちるような、":333,"\n\n\n戻りが、":334,"\n\n\n急に、":335,"\n\n\nきた。":336,"「──さびしいかお…か、さびしい、[l]\nああ、さびしいな……さびしい……、[l]\nさびしい………」":337,"この耐えられない、祭りの後の感覚、[l]\n上気が一気に覚まされる、[l]\n冷や水を浴びせられたかのように、":338,"みせつけられる現実、[l]\n逃げられない事実、[l]\n向き合わねばならぬ問題、":339,"──忘れていたものとの再会は、":340,"途":341,"轍もなく、[l]\nつらい。":342,"これが、ヤだったんだ、これが、[l]\n……なまじ上げ幅が大きいと、[l]\n揺り戻しはより一層大きく、":343,"………痛い。":344,"……冬夏も、[l]\nすぐその場のノリでしでかした行為を後悔してたっけ、[l]\n……少し違う気もする、けど、":345,"とうか──？":346,"ああ、":347,"いたい、あいたい……":348,"──誰に、":349,"だれ、だれって、………。":350,"──逢いに行くと？直面する覚悟はまだ、それに、":351,"そんなものは向こう次第だ、僕が如何に腹を":352,"括ろうと、":353,"──焦らされるのはうんざりとはいえ、":354,"待つのはイヤだって僕が言ったところで、":355,"──自分と他の関係性である限り\n    ペースを強要するのは支配的に過ぎる、":356,"僕自身に出来る事と出来ない事がある、":357,"──他者が選択及び決定権を持つコトガラに於いては特に、":358,"……知ってるさ、知ってるよ。":359,"だけど、[l]\n僕は●●だから、[l]\nこんなときにどうすれば、[l]\nなにをしたら、":360,"「………なにしてるんだ僕は」":361,"今更だけど、[l]\n結局のところ、":362,"何も進展してない……のだ。":363,"──と、いうよりも、":364,"狩屋との逢瀬……おうせ？[l]\n違う、[l]\n会って話をした事は、[l]\n確かに気を紛らわせては呉れたが、[l]\n根本的な解決には、[l]\n……少なくとも僕にとっては、[l]\nなってない。":365,"とは言え、仮に、\n真面目に問題を語り合ったところで、[l]\nお互いどんどん気が":366,"鬱いで、[l]\n二人分が乗算されて無駄に滅入っていただろう。[l]\n前にもこう思ったような気がするが、[l]\n鬱屈した感情、負の話題は、[l]\n他人に話す事によって発散される場合と、[l]\n逆に相手を引きずり込んで両者が打ち沈む場合がある。[l]\n勿論相手に負の感情を、ケガレのように擦り付け、[l]\n":367,"伝":368,"染してしまった気になって、[l]\n自分だけはスッキリする場合もあろうが、[l]\n出歯亀根性や野次馬根性、[l]\n他者の不幸に浮き浮き出来る類の人種なら兎も角、[l]\n僕と、[l]\n道具さんから連絡が来るまでの狩屋では、[l]\nとてもじゃないが、":369,"耐えられるものではなかった。":370,"話してしまってすっとする類の内容でもないし、\n何よりも相争えと言われている当事者同士、[l]\n……それとも、[l]\n話し合えば、[l]\n何か、良い方法でもみいだせたの……だろうか。":371,"──カリヤとアヤメは、":372,"確か、\n…………。":373,"駄目だ。[l]\n分からない。":374,"思考の速度も、集中も、[l]\n緩急が激しくて、[l]\nとても十全とはいえ、ない、[l]\n熱くなっても冷めても、[l]\n":375,"制":376,"御がきかないから、[l]\nどちらであろうと一旦転ぼうものなら、":377,"暴走、どうあれ":378,"碌な事には……":379,"……ねむくなってきた……のもあるが、[l]\n張り詰めていた気が緩んだの、かな……":380,"そのまま、[l]\n僕は、[l]\n暗くなるまで、[l]\n何処へも行かず、車の中で":381,"微":382,"睡んでいた。":383,"眠かったのも気の緩みもそうだけど、":384,"疲れていたのと、[l]\n腹が満たされたのと、[l]\n……何より起きていると、[l]\n暗い思考に囚われてどうにかなりそうだったからだった。":385,"事態の進展、解決に向けての思索は、[l]\nどうしてもモードが入らない、":386,"──というよりも、":387,"相変わらずアタマのどこかを確実に占拠している、":388,"──●●●":389,"という安定感が、僕を繋ぎ止めている、":390,"──掴むことさえ出来れば、":391,"何とかなるのだと、[l]\n……あ、そうだ、":392,"──オオカミと話をしなければ、":393,"……大神？[l]\nああ、落ち着いたら、連絡しようと、[l]\nしてたような、してないような……":394,"──とにもかくにも、":395,"もう睡魔に勝てそうもない、[l]\n空腹時と眠い時は、他人と会話してはいけない……んだ……[l]\nだから……[l]\n":396,"──起きたら、":397,"大神に……連絡しよう……":398,"「………ん」":399,"急に、覚醒した。":400,"視るまでもなく、\nすっかり外は暗くなっていて、\n時間帯がそうなのか、交通量が増してるとみえて、\n家路に急いでいるのであろう沢山の車が通る音が、\n確かに大きく聞こえていた。":401,"が、それで起こされたという実感はない。":402,"アラームをセットしておいて、\n鳴る直前に起きた時のような、\nあの時間感覚の矛盾、\n虫の知らせ……というよりも、[l]\n神経過敏の所為なんだろうが、":403,"「……？[l]\nなんだろうな、」":404,"意味は無いとは思っていたけれど、\nざわざわした感覚に背中を押されて、\n急な動きで外に出た。":405,"瞬間、":406,"「あ？[l]\nあー、そこか。[l]\nいたぜかれおん、おったおった、\nよーう久し振りだな」":407,"後ろから、\nよく聞き知った声が、":408,"「……あ？なんで、お前が、」":409,"──大神雪鳴の声がした。":410},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_060.ks","relPath":"/data/scenario/SC_M_060.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":402,"length":411,"percent":97.8102189781022},"cellInfo":[]},"/data/scenario/SC_M_061.ks":{"data":[["「夕べはお楽しみでした……かどうかは、[l]\nまー触れないでおいてやるよ。[l]\nでもま、その娘の御陰で、思ったよりは元気になったようだな」","「昨晚过得愉快吗……倒也不一定，[l]\n嘛我就不多问啦。[l]\n不过托那姑娘的福，你看起比想象中精神嘛」"],["にこやかに現れた其奴──大神雪鳴は、\n","笑眯眯现身的家伙──大神雪鸣，\n"],["奴の彼女、雨山かれお嬢と共に、[l]\n呆然と立ち竦む僕の所まで歩み寄って来た。","带着他的女友雨山卡蕾欧小姐，[l]\n向呆立原地的我走来。"],["「お、まえ、\nなんで──いや、そうか」","「喂，你，\n为什么──不，原来如此」"],["大神も、『そう』だった、んだな。[l]\nでも、何故、今此処に……それに、","大神也，『那样』了啊。[l]\n但为何现在在这里……而且，"],["「……お楽しみって何の事だ？」","「……愉快是指什么？」"],["「あれ？違うのか？[l]\nまーいいじゃんよ、触れないでおくっつってんだから、\nその話はいいんだ」","「咦？不是吗？[l]\n嘛无所谓啦，都说了不多问，\n这事不提也罢」"],["奴の後ろからかれお嬢が済まなそうに会釈した。[l]\n……そう言えば、[l]\n物凄く永い間会って無かった気がする。[l]\nとは言っても初見はあの時で、それから、\nまだひと月程度……？","从她身后卡蕾欧小姐略显尴尬地点头致意。[l]\n……说起来，[l]\n感觉已经很久没见面了。[l]\n虽说初次见面是在那时，之后，\n才过了一个月左右……？"],["大神ともインターバルは同じ筈だが、\n随分永い間、掛かった気がするなあ……","和大神的间隔应该相同，\n但总觉得过了相当漫长的时光啊……"],["「ま、\nおかげさんでね。[l]\n","「嘛，\n托你的福。[l]\n"],["朋としてお前さんに、\n……まープライドが邪魔するんでなけりゃ、[l]\n手を差し伸べようと思ってな。[l]\n男の友情って奴」","作为朋友想帮你一把，\n……要不是自尊心作祟，[l]\n早就伸手相助了。[l]\n这就是男人的友情吧」"],["「……えー、とだな、[l]\n今、色々混乱してる、\nから、\n──ありがとう、\n意味分からないけど、\n取り敢えず、\nそれは言っとく……」","「……呃那个，[l]\n现在脑子有点混乱，\n所以，\n──谢谢，\n虽然不太明白意思，\n总之先，\n把这话说出口……」"],["「水臭い事ぁ言いっこ無しスよいーくん。[l]\n急に連絡無しで来ちまったのはすまんけどな、\n色々事情が込み入っててさ。[l]\nつーかよ、もう辺り真っ暗になるしよう、\nみつかるかどうか冷や冷やしたっつーの。[l]\n──んあ、よくよく視たら","「别跟老子客套啊饭小子。[l]\n突然不联系就跑来是我不对，\n但情况实在复杂得很。[l]\n话说回来天都他妈全黑了，\n提心吊胆怕找不着人。」[l]\n──仔细瞧瞧"],["窶れてんな。[l]\n身体の方は流石に女子と遊んだからといって、\nもりもり恢復はせんわな」","你憔悴得很啊。[l]\n虽说和妹子玩过，身体方面\n也不可能立刻生龙活虎嘛」"],["「……？」",""],["先刻から言ってるのって、\nもしや狩屋の事か？[l]\n何で知ってるのかは、\n恐らく此奴も『そう』である事が関係してるのかな、\nとも思うが、\nいやしかしそれはそれとして、\n肝心な部分で何か誤解されてる気がするけど……","刚才一直说的，\n莫非是指狩屋？[l]\n至于为何知道，\n可能和这家伙也是『同类』有关，\n虽然这么想，\n不过那是另一回事，\n总觉得关键部分似乎被误解了……"],["「飯、喰うか？[l]\nその様子じゃ風呂も入ってねーだろ」","「要吃饭吗？[l]\n看你这德行也没洗澡吧」"],["「え、あ、ああ、\n……臭いか？[l]\nここ数日寒かったし、汗はそんなにかいてないけど、\n流石にもう、あれかな……」","「诶，啊，啊啊，\n……很臭吗？[l]\n这几天挺冷的没怎么出汗，\n但果然还是该洗了……」"],["「そのつもりあんなら、\n途中にシャワー付カプセルホテルみたいなの、\nあるにはあったけどな。[l]\nあんだなーこんなとこにも。[l]\n需要あんのかな……」","「要是有这打算，\n路上倒是有带淋浴的胶囊旅馆，\n虽然确实有啦。[l]\n这种地方居然也有。[l]\n真有需求吗……」"],["へえ……気付かなかった……[l]\n知ってればその、\n狩屋も、\nもう少しマシに寝られただろうに……","嘿……没注意到……[l]\n早知道的话，\n狩屋也能，\n睡得稍微舒服点……」"],["「まー、\nそれはそれだ、\n飯喰いがてら、色々とだな──\n……いーくんもどれだけ自覚してるかどうか、[l]\n或いは言われたか……[l]\nまあ、\n慰めんのは女子っこがしてくれたようだしな、\n俺は別の方面じっくりとレクチャーしてやらぁ。[l]\nかれおん、\n少し待っててくれる？[l]\nん、言い方悪いけどその、ハっといて、ついでに。[l]\n目視でいいからさ」","「嘛，\n那事另说，\n边吃饭边聊吧──\n……也想看看饭小子你自觉到什么程度，[l]\n或者被告知了多少……[l]\n反正，\n安慰人的活儿有小妞们干了，\n老子就负责在其他方面好好教导你。[l]\n卡蕾欧，\n能稍等会儿吗？[l]\n嗯，说法有点难听但那个，先候着，顺便。[l]\n用肉眼确认就行」"],["「？」",""],["「一応かれおんの上司にナシつけて来たけど念の為な。[l]\nお前も知ってる筈だな、チノさんっての？」","「虽然姑且借用了卡蕾欧上司的名义过来但只是以防万一。[l]\n你应该也认识吧，那位叫千乃的？」"],["「……チノ……さんが？[l]\n何か、どうしたって、」","「……千乃……小姐？[l]\n她、她怎么了，」"],["「そんなに身構えんでもいいんだ、取り敢えず。[l]\n人情が通るヒトで良かったな」","「不用那么紧张，总之。[l]\n幸好是个通人情的主儿」"],["……？[l]\nいや、でも、\nしかし、","……？[l]\n不，但是，\n不过，"],["──そういうこともあるか。","──原来还有这种事。"],["「ああ、そんで、ついでに解ってると思うが、\n勿論あすこに居る俺の彼女も、」","「啊对，顺便你应该也明白，\n当然现在站在那边的我的女友也是，」"],["「ネコガミ……遣い……だったか？」","「猫神……使者……来着？」"],["「ネコガミ？[l]\nああ、こっちじゃそう呼ぶんだったか？[l]\nま、あれだ早い話がスタ……いや、[l]\n呼び名はどうでもいい。[l]\n要するに、」","「猫神？[l]\n啊，在你们这儿是这么称呼来着？[l]\n嘛，说白了就是星……不对，[l]\n称呼无所谓。[l]\n总之，」"],["「前から、お前が言ってた、\n何かが視えるとかの、\nそうなんだな？[l]\n本当は、このことだったんだな……？」","「你之前说过，\n能看见什么之类的，\n就是这么回事吧？[l]\n其实，指的就是这个吧……？」"],["「まーなあ、\n兎も角、だからっつって俺もかれおんも敵じゃない、\nそこは、わかるか？」","「嘛没错，\n总之我和卡蕾欧都不是你的敌人，\n这点能明白吧？」"],["「え？[l]\nあ、ああ、」","「诶？[l]\n啊、啊啊，」"],["「ああ、ついでに誤解があると思うが、\nいーくんをみっけたのは自力、生身でだぜ」","「啊对了顺便澄清个误会，\n发现饭君可是靠我自己这双肉眼哦」"],["「何つーか、その手の、タイミングとか良すぎる件も、\nどうこうもう言われてるのか？[l]\n雫──」","「该怎么说呢，关于那些时机好到可疑的事，\n是不是已经有人跟你说过了？[l]\n雫──」"],["──呼び水たる月の雫。","──引月之雫。"],["ああ、言われた、あのひとに、","啊没错，被那个人说了，"],["キミは大変に『雫』だった。[l]\n　　濁ったみどろをさざめかせ、停止した時間を動かす針だった。[l]\n　　キミは同時にマガンノサシテでもあるからね、\n　　それはそれは素晴らしかったよ？[l]\n　　次から次へと、\n　　ほら、自分でも分かってるだろ？[l]\n　　タイミング良くイベント起きたろ？","你可是非常『雫』的存在。[l]\n　　是搅动浑浊泥沼、推动停滞时光的指针。[l]\n　　因为你同时也是魔眼之探针啊，\n　　那可是相当了不起对吧？[l]\n　　接二连三地，\n　　看，你自己也察觉到了吧？[l]\n　　事件总是恰到好处地发生对吧？"],["あ？[l]\nまがんのさして……？","哈？[l]\n魔眼之探针……？"],["「──チノさんに逢ったのも偶然だしな。[l]\nまあ、色々と、\nラストに向けてのフラグは立ちまくってるんだろうが、\nそれがお前の所為かどうかは、」","「──遇到千乃小姐也是偶然啦。[l]\n嘛，各种意义上，\n通往终局的flag已经立得够多了，\n不过这是否是你的缘故，」"],["──後になってから言われること。[l]\n　　　　それが、呼び水たる月の雫、","──要等到日后才会被告知。[l]\n　　　　那便是，引月之雫，"],["「……聴いてるか？[l]\nまあいいや、\n兎に角だ、\n今、何故かは明瞭と俺に言える事じゃないが、\nいーくんは物語られている」","「……在听吗？[l]\n算了无所谓，\n总之，\n虽然现在说不清具体缘由，\n但饭君正被书写进故事里」"],["「……ものがたられ……」","「……被书写……」"],["「まー、それは誰かさんが意図したのかも知れないし、\nそうでないかも知れない、\nだけどな、\n巻き込まれようが何だろうが、\nイベント起こるから物語の主人公たり得るんだぜ、\n話の主人公に都合良く出来事が起こるんじゃねーな。[l]\n逆だ。[l]\n何かが起きる、何かを起こすから、\n其奴の話は物語られるんだ」","「嘛～可能是某人的刻意安排，\n也可能不是，\n不过啊，\n不管是被卷入还是怎样，\n正因为事件会发生才能成为故事主角啊，\n可不是因为主角需要才刚好发生事件。[l]\n正好相反。[l]\n因为有事发生，因为引发某事，\n那家伙的故事才被传颂」"],["──そこが、かたられるものの前提なのだ。","──那里正是被讲述之物的前提。"],["「分かったか？[l]\nみろよ探偵漫画とか、\n殺人事件どんだけ同じ街同じ学校で起きるかって話だよ、\nん、何か違うか？[l]\nまあいいや、\n……立ち話もしんどいか。[l]\n久々だったんでちと語っちまった。[l]\n悪ぃ悪ぃ、飯と風呂、行くか」","「明白了吗？[l]\n看看侦探漫画什么的，\n不都在说同一座城市同一所学校里会发生多少杀人事件嘛，\n嗯，哪里不对吗？[l]\n算了无所谓，\n……站着说话也挺累的。[l]\n好久没聊不小心说多了。[l]\n抱歉抱歉，吃饭洗澡，走吧」"],["その言葉で急に、\n僕も空腹を感じて、\nやもすればまた暴走しそうになる思考は焦点を得て、\n気をしっかりと持つことができた。","这句话让我突然\n也感到饥饿，\n险些再度暴走的思绪重新聚焦，\n总算稳住了心神。"],["「……あ、僕も車で来てるんだけど……[l]\n追走すればいいんかな……？」","「……啊，我也是开车来的……[l]\n要尾随你们吗……？」"],["「そうさな……そっちの車、[l]\n期限が大丈夫ならどっかちゃんとしたパーキングに一旦、\n預けるなりした方がいいかもな。[l]\n店に取りに来て貰っても良いが」","「这个嘛……你那辆车，[l]\n如果租期没问题的话最好先找个正规停车场\n暂时寄存比较好吧。[l]\n或者让店里派人来取也行」"],["「ああ……放置は、","「啊……随便停着"],["拙いだろうな……」","确实不太妙……」"],["レンタル期間の方はまだしも、\nこの駐車場にずっと置くわけにはいかないだろう。[l]\n人が少ないからか、\n今のところ","租期倒还好说，\n总不能一直停在这个停车场。[l]\n或许因为人少，\n目前"],["視","视"],["咎められたりはしてないが、\n連泊してるのは確かだし、\n本来ならば何か言われてもおかしくない状況ではある。","还没被追究，\n但连续过夜是事实，\n正常情况下被问责也不奇怪。"],["マイカーじゃないから乗り捨て覚悟ともいかないし、\n大神の案に乗ることにする。","又不是自家车没法说扔就扔，\n决定采纳大神的建议。"],["「最悪延滞だの何だのは俺がフォローしたらぁ。[l]\nこれでも貯蓄は唸る程あるからよ。[l]\nパーキングまでは案内するわさ、\nそしたらあとはこっちん車に乗ってけ。[l]\nかれおんの上司さんは兎も角──\n先刻はああは言ったが、\nお前さんのおもいびとはまた別だからさ。[l]\n武闘派連中も揃い踏みときてっから」","「最坏情况逾期什么的我来善后。[l]\n别看我这样存款可是多到能让人惊叫呢。[l]\n我会带你去停车场，\n之后就来坐我的车吧。[l]\n卡蕾欧的上司姑不论──\n虽然刚才那么说，\n但你小子的心上人可是另当别论。[l]\n武斗派那群人也集体出动了」"],["武闘派……？","武斗派……？"],["「まだ会って無いか？[l]\n四人組で、ちっこい奴が一人」","「还没见到吗？[l]\n四人组，有个小个子」"],["「四人……ああ、[l]\nフードで殆ど顔は視てないけど、\n宮さん……あのひとの側に何人か、居たような……」","「四人……啊，[l]\n虽然兜帽遮着脸看不太清，\n宫小姐……那个人身边好像有几个人……」"],["「あー、多分それだわな。[l]\n気ィつけろよ、\nそのちっこいのは、──ああ、それも後で言うわ、\n忘れなければ」","「啊─多半就是他们。[l]\n小心点，\n那个小个子是──啊这事也晚点再说，\n要是没忘记的话」"],["武闘派……たたかう……","武斗派……战斗……"],["「……やっぱり、[l]\nその、所謂、\nバトルっつーか、喧嘩というか……[l]\n戦闘するような、\n連中なのか？[l]\nその、\n………、[l]\nネコガミってのは、\nそういうものなのか？」","「……果然，[l]\n就是所谓的\nbattle或者说打架……[l]\n会进行战斗的\n那群人吗？[l]\n那个，\n………，[l]\n猫神这种东西，\n就是这样的存在吗？」"],["「……ん～～、[l]\nそもそもは、\n力無き者がそれを補う為に編み出された存在、\nつーかな、\nそういう始まりだもんでよ、\n戦闘用の能力も無いではない、が、\nどっちかっていえば暗殺とか操作とか、[l]\n──正面切って争うようなだな、\n物理的に叩き伏せるような、腕力暴力的なのもあるにはあるが、\n基本理念は如何にして自己の欲を満たすかというものだから、\n直接的な戦闘は寧ろ避ける傾向はある」","「……嗯～～、[l]\n说到底啊、\n是为了弥补无力者而诞生的存在、\n或者说、\n本来就是这样的起源啦、\n也不是没有战斗用的能力、不过、\n真要归类的话更偏向暗杀啊操控啊、[l]\n──正面硬刚的类型嘛、\n用物理手段揍趴对手的暴力型也确实存在、\n但基本理念终究是如何满足自身欲望、\n反而会尽量避免直接战斗」"],["一部を除き今の処はな、\nと大神は苦々しく付け加えた。","除了少数例外目前都是这样、\n大神苦笑着补充道。"],["……分かっていた事ではあるが、[l]\nこう淡々と非現実的な事を語られると、\n地に足が着いていない奇妙な感じに囚われる。[l]\nつい先刻までレンタカー云々の会話をしていた所為もあり、\nその落差は一層ある。","……虽然早就知道、[l]\n但听他这么平淡地讲述超现实的事、\n还是有种脚不着地的怪异感。[l]\n加上刚才还在聊租车之类的话题、\n这种落差就更明显了。"],["大神は続けた。","大神继续说着。"],["「まー、さっき言った武闘派云々にしても、\n奴等の場合は索敵拘束解析捕獲、\n遣り合うというよりは『狩る』と言った方が正しい。[l]\n所謂バトるのはミ──まあ、それは、あれだ」","「嘛、刚才说的武斗派之类的、\n那帮家伙本质是索敌拘束解析捕获、\n与其说是互殴不如用『狩猎』形容更准确。[l]\n所谓战斗不过是mi──呃、这个嘛、你懂的」"],["……？[l]\n何故かそこで奴は言い淀む。[l]\n──ミ……[l]\n……み……あの、あのひとのこと……か？","……？[l]\n不知为何他突然语塞。[l]\n──mi……[l]\n……mi……难道是说、那个人……？"],["「兎に角、\n遣い手が利を得る為の手段としての選択肢には、\n当然、生殺与奪権の取得が第一位に来るんだな。[l]\n『遊戯として","「总之、\n作为使用者谋利的手段、\n生杀予夺权当然是首选啦。[l]\n除非是『为了游戏而"],["甚","大肆"],["振る為のタタカイ』じゃない限り、\n一方的に相手を負かすのが基本、\nまさしく『狩り』だよ。[l]\nそれは残念乍ら遣い手同士の場合でもそうだったのさ」","进行的战斗』、\n否则单方面碾压才是常态、\n名副其实的『狩猎』。[l]\n遗憾的是使用者之间也是如此」"],["「矛と盾じゃあないが、\nさっきの話で言うなら、\n一方的に敵を害しうる能力を持った者同士が相争うと、\nどうなるかってことだ。[l]\nまあ、\n昔は全部、能力者、いーくんが言うところのネコガミ遣いは、\n一宇のもと、同一集団だった。[l]\nが、あるとき、あるものが、\n集団を真っ二つに分けて片方を一方的に攻撃した。[l]\nで、相手は実際、一方的にやられた。[l]\n前もって心構えがあれば、\n恐らくは対抗し得ただろうが、\nその先制攻撃は反撃を赦さない程に相手を負かしたんだよ」","「虽不是矛与盾的关系、\n但按刚才的说法、\n当两个都能单方面伤害对方的能力者争斗时、\n会变成什么样呢。[l]\n其实啊、\n古早时期所有能力者、就是饭君说的猫神使者、\n原本都属于同一个集团。[l]\n直到某天、某个存在、\n把集团劈成两半并单方面袭击了其中一方。[l]\n结果对方确实被单方面碾压了。[l]\n如果提前有所防备、\n或许还能抗衡、\n但那场奇袭彻底瓦解了反击的可能性」"],["ほぼ殲滅したんだ、","几乎全灭了、"],["と大神は言った。","大神说道。"],["「勿論、\n視えないヒトらにとっては知る由もない歴史だけどな。[l]\n全ては……いや、いいか。[l]\nで、これも既に知ってるかもだが、\n──八相って呼ぶんだっけか？[l]\n此処の連中は」","「当然、\n对看不见的人来说这只是无从知晓的历史。[l]\n一切都是……不、算了。[l]\n另外这事你可能也知道、\n──是叫八相来着？[l]\n这里的家伙们」"],["「……僕の、……本当のカラダの、」","「……我的、……真正的身体、」"],["「……まあそうやな。[l]\n同時に、その殲滅し損ねた残党の影響下にある、\n強制されてる部分があるから正確にはちと違うが、\nシンパみたいなもんかな？[l]\n視えるという能力、ネコガミとのリンクもさることながら、\nそのことで利権を貪ってきた、此の地で、永い間」","「……差不多吧。[l]\n不过他们同时受那些漏网之鱼的影响、\n存在被强迫的成分所以严格来说不太准确、\n算是同情者之类的？[l]\n不仅因为能看见的能力、与猫神的链接、\n更因长期在这片土地攫取利益」"],["「……それは、」","「……那是，」"],["……あのひと、たちが、[l]\n","……那些人，[l]\n"],["──分かって野放しにしていた、","──明知却放任不管，"],["狩","狩"],["る為に。[l]\n","为了。[l]\n"],["……最初から敵、否、獲物として、","……从一开始就是敌人，不，猎物，"],["ぼくの、だいじな、","我的，重要的，"],["「……まあ、十分割されたうちの８、[l]\nそれぞれは単離されたもんだから、\n十全に比べちゃ著しく使い勝手の狭い、\nあ、別にイーくんがアレな訳じゃないぜ？[l]\nただ、さっきの話で言う実質戦闘向き、つーか、\n武器たり得るのは一つだけ。[l]\n防具相当のとか補助回復その他の相もあるが、\n直接的な殺傷能力としての相はPHASE:1\n此処では確か、\nCAT_X/10:PHASE:1、アヤメとか言うのか──」","「……嘛，被分割成十份中的8，[l]\n每份都是独立的存在，\n比起完整状态实用性大打折扣，\n啊、倒不是说小伊本身有问题啦？[l]\n只是、按刚才说法实质战斗向的、或者说，\n能作为武器的只有一份。[l]\n虽然也有相当于防具或辅助回复等其他相位，\n但作为直接杀伤能力的相位是PHASE:1\n在这里应该是，\nCAT_X/10:PHASE:1、叫阿娅梅什么的──」"],["アヤメ……姫様……","阿娅梅……姫様……"],["姫様ちゃんのネコガミが、","姫様酱的猫神，"],["回復はコストが高すぎて──","回复成本太高──"],["だから攻撃を喰らわない前提──","所以要以不被攻击为前提──"],["まあ普通のヒトには対抗手段がないから──","嘛普通人类根本没有对抗手段──"],["今まではそれで構わなかったんだろうが──","至今为止这样也没问题吧──"],["僕は思索に入り込み、\n大神の言葉も切れ切れに耳に入ってくる、","我陷入沉思，\n大神的话语断断续续传入耳中，"],["そうなら、[l]\nつまりは、[l]\n狩屋や姫様ちゃんの役割が、","如果是那样，[l]\n也就是说，[l]\n狩屋和姫様酱的职责，"],["「ちなみに、\nCAT_X/10:PHASE:7カリヤってのが、\n補助魔法相当──メインは身体増強、攻防力の底上げだ。[l]\n伴って敏捷力も上がる。[l]\n……少し違うな、[l]\n底上げというよりは限界突破、オーバーワークってとこか。[l]\n限解（リミットはずし）、\n狂戦士化（berserk）って奴。[l]\nシステム的には言わば火事場の馬鹿力に近いから、\n反動もあればリスクもある」","「顺便一提，\nCAT_X/10:PHASE:7卡利亚那个，\n相当于辅助魔法──主要是身体强化，攻防力的提升。[l]\n连带敏捷性也会上升。[l]\n……有点不同，[l]\n与其说是提升不如说是极限突破、超负荷运作那种。[l]\n限解（解除限制），\n狂战士化（berserk）那玩意儿。[l]\n系统上来说类似火灾现场的蛮力，\n既有反作用也有风险」"],["普通は遣い手本人ががっつり負担を負うような戦闘はないから、\n八相という能力の個個分断されたが故の在り方だな、\nと大神は言った。","通常不会有使用者本人承担重大负担的战斗，\n这就是八相能力被分割后的存在形式吧，\n大神如此说道。"],["……そうか、そういう、ことか……","……原来如此，是这样啊……"],["「一般人相手には、\nそんな十分の一でも十分に有用だろうが、\nまともな──萌え店長以下ずらりと揃った十全の遣い手にぁ、\n到底、まあ、言わずもがなのやんぬるかなだぁな。[l]\n喩えるなら、\n武器防具装備一式、呪文も攻撃補助回復揃い、\nＰＴ組んだ廃相手に、\n武器だけ持って紙装備……否、ハダカで、[l]\nしかも初心者がどうできるよ？って話だかんな」","「对普通人来说，\n哪怕只有十分之一也足够有用，\n但面对正经的──从萌店长往下齐全的十全使用者，\n终究，嘛，不说也明白根本不够看啊。[l]\n打个比方，\n武器防具全套装备，攻击辅助回复咒文齐全，\n组队挑战的废柴对手，\n只拿着武器穿纸装备……不、裸体，[l]\n而且还是新手能干什么？就这意思」"],["……その喩えじゃよくわからなかったが、[l]\n要するに、\n圧倒的な力量差が、\nあのひと達と狩屋達の間にはあるんだな……","……那个比喻不太明白，[l]\n总之，\n存在着压倒性的实力差，\n在那些人和狩屋他们之间……"],["まさに、\nいたぶるため……なのか、[l]\nそんな者達から、","简直就像，\n为了虐待……吗，[l]\n从那种人手里，"],["僕に、そんなことを、","对我，做出那种事，"],["そう言えば、[l]\n冬夏は、ミハルとは一体、どういう──","这么说来，[l]\n冬夏和米哈尔，到底是──"],["「ミハル？[l]\nあー、\nCAT_X/10:PHASE:2は表皮外装……言わば防御担当か。[l]\n不可視化結界やら、あ、\nそうか受容器官相当、\nつまりレーダーやセンサー的な役割もあるな。[l]\nかれおんの……は、主にそこを強化してあるって事、[l]\n詳しくは乙女の秘密な」","「米哈尔？[l]\n啊ー、\nCAT_X/10:PHASE:2是表皮外装……说白了就是负责防御的吧。[l]\n什么不可视化结界啦、啊、\n对哦相当于接收器官、\n也就是说还兼具雷达和传感器的功能呢。[l]\n卡蕾欧的……主要是强化了那部分、[l]\n详情是少女的秘密哟」"],["「そう……なのか。[l]\nただ、話を聞く限り、\n……なんというか、当主だっていうからさ、[l]\nもっと、\n特別なもんかと思ってた」","「这样……啊。[l]\n不过听你这么说、\n……该怎么说呢、因为说是当家主、[l]\n我还以为、\n会更特别些呢」"],["あ、そういえば、オオクロとかいう、\nそう、御神体が、","啊、说起来那个叫大黑的、\n对、御神体、"],["「あー、\nまあ創始者の考え次第、\n集団内のヒエラルキー構成をどうしようと、\n其奴の勝手なんだろうけどな、\nん、まあ、\n普通の感覚で言うなら、\n","「啊ー、\n嘛看创始人的想法啦、\n集团内部的等级架构想怎么搞、\n都是那家伙的自由吧、\n嗯、嘛、\n按常理来说、\n"],["そ","那"],["れがトップを担うのは不自然ではあるな。[l]\nああ、\nオオクロは依代だ」","让那玩意儿担任顶层确实不太自然。[l]\n啊啊、\n大黑是依代啦」"],["依代？","依代？"],["「あぁーん、\n説明が面倒なんで訊かないでくれっか。[l]\n特に──ああ、まあ、\nそう言う意味では、\nそれを所蔵してる事が特別扱いたる所以かも、\n知んねーな」","「啊嗯ー、\n解释起来太麻烦别问行不行。[l]\n特别是──啊啊、算了、\n从这个意义上说、\n收藏着那玩意儿或许就是受到特殊对待的原因、\n谁知道呢」"],["……どういう意味かは分からないけれど、[l]\n訊くなと言われたら、\nこれ以上、追求する気も、無い。","……虽然不明白具体含义、[l]\n但既然被告知别问、\n我也没打算继续深究。"],["「彼女……冬夏は、[l]\n金髪で碧い眼をしてたんだ……」","「她……冬夏、[l]\n是金发碧眼来着……」"],["何故それを言おうとしたのかは解らないが、\n何とは無しに僕はそう言った。[l]\nでも、声が","不明白为何会突然说起这个、\n但我还是不经意地脱口而出。[l]\n不过或许是声音"],["掠れてたのか、\n大神は聞き流したようだった。","嘶哑了、\n大神似乎没当回事。"],["「──どっちにしろ、\n萌え店長達は、お前をゲームの駒として盤上に乗せ、\n遊ぼうとしてんだろうさ。[l]\nただ、最前から言ってるが、\n戦力差としては明白なんだよ。[l]\nこの一連の劇……三文芝居の仕込みにしろ、[l]\n端っから全部仕切ってるつもりでいるようだし、\n言いたくはないが、\n………[l]\nいーくんの去就は実はあまり関係ねーんだろうな」","「──总之、\n萌系店长们是想把你当棋子摆上棋盘、\n拿来玩游戏吧。[l]\n不过我从最开始就说、\n战力差距是明摆着的。[l]\n这整出闹剧……就算是为了三流戏剧做铺垫、[l]\n他们似乎也打算从头掌控全局、\n虽然不想这么说、\n………[l]\n饭君的立场其实无关紧要吧」"],["……ああ、それは、聞いたよ……","……啊啊、这个、我听说了……"],["だからこそ俺は──","正因如此我才──"],["大神は、そう言ったが、\n続けた言葉は脈絡がないものだった。","大神虽然这么说着、\n接下来的话却毫无关联。"],["「だから恐らく、\nよく判らんが、\n何か他の目的……別の『何か』を待ってるのかもだ」","「所以很可能、\n虽然不太清楚、\n是在等其他目的……别的『什么』吧」"],["「……？[l]\n他の……」","「……？[l]\n其他的……」"],["と言われても、\n主と目されるものすら、\n今の僕には想像することも覚束無いけれど……","就算你这么说、\n连所谓的主线、\n现在的我都完全无法想象……"],["「そうさな、\n八相達の上──残党のトップが狙いかも知れんし、\n或いはホントに──単なる暇潰しかも知れん、\nいずれにしても、\nいーくんが、\nその存在を賭けてまで、\n黙って従う価値のあるもんかどうかは、\n","「是啊，\n八相们的上层──残党的首领可能是目标，\n或者真的──可能只是单纯消磨时间，\n无论如何，\n饭君，\n是否值得赌上存在，\n默默服从的价值，\n"],["甚だ疑問だな。勿論、」","实在令人怀疑。当然，」"],["お前自身があの萌え店長に、\nそうする価値を視出してるなら、[l]\n別[l]だけどな？──","要是你自己觉得那个萌系店长，\n有值得这么做的价值，[l]\n就另[l]当别论了？──"],["「……あのよ」","「……那个啊」"],["「あん」","「嗯」"],["「……そこまで知っていて、[l]\n何で黙ってた？[l]\n今まで」","「……明明知道这么多，[l]\n为什么一直沉默？[l]\n直到现在」"],["「……お前が、[l]\n今まさに身に染みて感じてると思うが、\n──連中に関わってもろくなことがないからさ」","「……因为你，[l]\n现在应该切身感受到了，\n──和那群家伙扯上关系准没好事」"],["………。",""],["「………俺が、[l]\n連中と袂を分かったのもそういうこった、\n………。[l]\n……悪いとぁ思ってっけど。[l]\nんあー、黙ってた事にはな。[l]\nでもだな、\n向こうさんが絡んで来なきゃ、\nいーくんは何も知らないまんま、\n人として生きて行けたし、\nその方が、\nそれにあれだ、\nネコガミがどーしただの、\nんな事話した日にゃただの痛い──\nどうした？」","「………我，[l]\n会和那群人分道扬镳也是这个缘故，\n………。[l]\n……虽然觉得挺抱歉的。[l]\n唔啊─，关于保持沉默这事。[l]\n不过啊，\n只要那边不主动纠缠，\n饭君就能一无所知地，\n作为普通人活下去，\n那样更好，\n而且说起来，\n猫神怎么怎么了之类，\n说这种话的时候只会显得很蠢──\n怎么了？」"],["「……自分で了承したんだとさ」","「……说是自己同意的」"],["「あん？」","「嗯？」"],["「子供の頃……み……あのひとの話に乗るって、[l]\n自分から、\nその、……かれおさんが……９を……[l]\n告げることが……始まりだって……」","「小时候……就……答应那个人的提议，[l]\n主动，\n那个，……卡蕾欧小姐……把9……[l]\n告知这件事……就是开端……」"],["「……ああ、[l]\n………。[l]\n………、[l]\n……寒いな、まだ此処は。[l]\nすっかり暗くなったし、か」","「……啊啊，[l]\n………。[l]\n………、[l]\n……好冷，这里还是。[l]\n毕竟完全暗下来了，吧」"],["……僕もふと周りに気をやると、[l]\n暗く、寒い。[l]\n向こうにかれお嬢が寒そうにしているのが、視えた。","……我也不经意注意到周围，[l]\n黑暗又寒冷。[l]\n看见对面的卡蕾欧小姐冷得发抖。"],["「ま！[l]\nその話はちょっと待て。[l]\nちゅうかな、\n経緯より結果、『これから』が肝要な」","「喂！[l]\n那话题先等等。[l]\n或者说，\n比起经过结果，『今后』才重要」"],["……。",""],["「まあ俺も、\n連中は嫌いだけんどもな、がっつり","「虽然我也，\n讨厌那群家伙，但还不至于"],["力んで憎む程、\n余力はねーのよ。[l]\nだから余計な手出しさえ止めてくれりゃ、\n痛み分けで済ませるんだけどな。[l]\n報復どうこう程しんどいもんはない──」","咬牙切齿地憎恨，\n没那份余力啊。[l]\n所以只要别多管闲事，\n各退一步就能解决。[l]\n报复什么的实在太累人──」"],["「……ぁのさ、お前、」","「……我说你啊，」"],["「悪ぃが」","「抱歉」"],["長話はここまでだ。","长话就到此为止。"],["と、奴は深刻そうに言った。","他表情凝重地说道。"],["「彼女さんを寒い中待たす訳にもいかねーっての。[l]\n俺って良い奴だからよう」","「总不能让她在寒风中干等着。[l]\n我人可是很好的」"],["さんくすあーんど行くぜかれおん、\nと言って、大神は歩き出す。","「谢啦咱们走吧卡蕾欧、」\n说完，大神迈步前行。"],["──そして、僕は、","──然后，我，"],["また事態に流されるように、\n大神達について行く、何も、考えられずに……","就像再次被事态推着走般，\n跟随着大神他们，什么都，无法思考地……"],["すると、視透かしたかのように、\n奴は振り返り僕に向かって、","这时，仿佛看透心思般，\n那家伙回头对着我，"],["「主人公ってのはその視界をもって、\n","「所谓主人公啊就是凭着那视野，\n"],["劇の","成为向观众传达"],["脚","慢悠悠"],["本を観客に知らしめる司会者でもあんだよ、\nだからまー、[l]\n……気にすんな」","戏剧本质的主持人，\n所以嘛——[l]\n……别在意」"],["と言った。[l]\nよく判らなかったけれど、[l]\n……少しばかり、気が楽になった、[l]様な気がした。","他说道。[l]\n虽然不太明白，[l]\n……但总觉得，稍微轻松了些，[l]这样的感觉。"],["僕の借りてた車は、\n大神の案内で適当なパーキングに駐めて貰い、\n奴の運転する車に乗り換えた。","我借来的车，\n在大神指引下停进了路边停车场，\n换乘了他驾驶的车。"],["僕が助手席で、彼女は後ろ、\n何か気が引けたが、\n大神はまだ僕に話す事もあるようだったし、\n彼女も事情は知ってるようで、\n気を遣ってくれてるのはありありと感じられ、\n逆にそれがまた……と思う程にはこちらも余裕なく、[l]\nただただ車に揺られ、宿泊場所へと向かう。","我坐副驾，她坐后排，\n虽有些过意不去，\n但大神似乎还有话要对我说，\n而她好像也知情，\n能明显感觉到他们的体贴，\n反倒让我更加……不知所措，[l]\n只是随着车身摇晃，驶向住宿地点。"],["道中色々ネコガミ……他に呼び方があるようだけど、[l]\nそれに関しての話をざっくりと、\n飽く迄もざっくりと、された。[l]\n車に乗り込む前に話した事以外では──\n……恐らく詳しく知っても詮無いらしい部分は、[l]\n奴はかなり端折ったらしい。[l]\n気遣いのつもりもあるだろうが、\n実際具体的に識ったところでどうしようもない部分でもあろうし、\n言葉で説明するのは無為なのだ、と思う。","途中听了些猫神的事……似乎还有其他称呼，[l]\n关于这些的说明都很粗略，\n极其粗略地带过。[l]\n除了上车前谈到的内容——\n……那些恐怕知道详情也无济于事的部分，[l]\n他明显跳过了很多。[l]\n固然有体贴的考量，\n实际上即便了解细节也无能为力，\n用语言说明终究是徒劳，我想。"],["かなり言葉を選んでる様子に思えた。","能看出他在谨慎斟酌用词。"],["それに、\n僕の方もそういう話を一言一句理解するには、\n周辺状況や僕自身のコンディション含めて、\n厳しかったのは事実だ。[l]\n連日の色々が祟ったのか、\n知らずのうちに、\n僕の心身は、共に思っていた以上にダメージを受けていたらしく、\n気を張ろうと思っても、\n疲弊からくる眠気なのだか、\nそれも手伝ってるんだろうが、\n親しい他人と共に在ることで、逆に気が緩むのか、\nそれともこの助手席でこそ感じる、\n胎内の振動音の如き車の揺れが、\n僕の張り詰めた精神の","况且，\n以我现在的状态，\n包括周边状况和自身条件，\n要逐字理解这些确实勉强。[l]\n或许是连日变故的报应，\n不知不觉间，\n我的身心受到的伤害都比预想严重，\n即便想强打精神，\n不知是疲惫引发的困意，\n还是其他因素影响，\n与熟识者共处反而松懈，\n又或是唯独在这副驾驶座，\n感受到如母胎震动般的车身摇晃，\n令我紧绷的"],["箍を緩めるのか、","精神枷锁逐渐松动，"],["移動開始よりある段階に至り、\n──彼女さんには申し訳なかったけれど、","自启程某个阶段开始，\n——虽然对那位小姐很抱歉，"],["僕は堰を切ったように、","我却像决堤般，"],["言葉がどんどんと口をついて、","话语不断涌出嘴角，"],["その言葉が更に自分を刺激して、","那些话进一步刺激自己，"],["ひたすらに喋った、喋った、","只顾着说啊说，"],["時に激昂して、","时而情绪激动，"],["……その時はかれお嬢にも遠慮などする余裕もなく、","……那时甚至无暇顾及卡蕾欧小姐，"],["引っ掛かってる何かを引きずり出したいかのように、\n喋ることによって、言の葉にすることでそれを、\n昇華してしまえるかのように、","仿佛要把卡在心里的东西拽出来，\n通过诉说，通过语言化，\n就能将其升华似的，"],["──既に眠さも空腹もない交ぜで、","——此刻早已分不清是困倦还是饥饿，"],["つまりストッパーは完全に崩壊していて、","也就是说制动器完全崩溃了，"],["こんなのまるでチノ嬢のようだな、と、\nこんな状況にありながらどこかに確実にある、\n冷静で安堵している部分がそう思考しつつも、","这简直就像千乃小姐一样啊，\n虽然身处这般境地但某处确实存在着，\n冷静且安心的部分让我如此思考着，"],["僕は、浮かんだ考えを片っ端から言葉にしていた──と思う。","我想，自己正把浮现的念头逐个说出口──"],["友人というのは、要するに遠慮せずに言い合える、\n　　気が置けない間柄だろうよ。","所谓友人，说到底就是能毫无顾忌地互相吐槽，\n　　不必客套的关系吧。"],["損得抜きの、","无关得失，"],["だから、","所以，"],["恥ずかしがらずにくっちゃべって構わんぜ。","就算厚着脸皮瞎扯淡也没关系。"],["そう大神は言った。","大神曾这么说过。"],["……バックミラーを視ると、[l]\nかれお嬢は眠っていた──寝たふりかも知れなかったが。","……瞥向后视镜，[l]\n卡蕾欧小姐正在熟睡──也可能在装睡。"],["僕のこころにある、\nこの感情は、","在我心中的，\n这份感情，"],["……あのひとに対して抱くこの、[l]\n痛くて堪らない一つの、\nそしてそうでありながらも同時に沢山のモノが混在したこれが、","……对那个人怀有的这种，[l]\n痛彻心扉的，\n同时混杂着诸多情绪的体验，"],["好意というものなのか、","是否就是所谓的好意，"],["わからない。","我搞不懂。"],["切実であり、純粋であり、\n道徳の範疇には必ずしも収まらず、\n彼我という、\n自己だけではどうにも出来ない要素によって\n構成された関係性からくる、\n苦しさ。[l]\n身勝手な苛立ち。","既真切又纯粹，\n未必符合道德范畴，\n由彼此这种，\n仅靠自身无法掌控的要素\n所构筑的关系衍生出的，\n苦闷感。[l]\n自私的焦躁。"],["たまたまそこにいた、\nというだけなのか。[l]\n他にも接触があれば、\n僕はあなたとの『これ』を、\n特殊なものとして捉えずに済んだのか。","仅仅是因为，\n碰巧出现在那里吗？[l]\n如果还有其他接触对象，\n我是不是就不会把和你的『这种关系』，\n当作特殊的存在了？"],["そこにいたのはあなただけだったからなのか、","还是说只因当时在场的只有你，"],["選択の余地がなかったというだけなのか、","只是别无选择而已，"],["であれば、","倘若如此，"],["これはただそこに僕とあなたがいたから、","这就只是由于当时我和你在场，"],["物理的理由、\n因果としてはまるで、……滑稽というべきか……、","物理层面的原因，\n从因果论来看简直……该说是滑稽吧……"],["しかし世の、\nツガイが、\n遍くそういうものであるという視座で曲解すれば、\nそんな理由でも、別段おかしいことも、\nないのか。","但若用世间\n情侣\n普遍如此的视角来曲解的话，\n这种理由，倒也算不上\n特别奇怪吧。"],["「……背景は複雑かも知らんが、[l]\n反応としてのいーくんの感想──いあ、感情は、\n単純なこったろうよ」","「……背景或许很复杂，[l]\n但作为反应的饭君感想──不对，感情，\n其实很单纯啦」"],["「……ぁぁ」","「……啊啊」"],["単純なことだった。","是件单纯的事。"],["「……す、きだった。[l]\nあのひと……のことは」","「……喜、欢过。[l]\n那个人……的事」"],["「……んあぁ」","「……嗯啊」"],["暫く沈黙が続き、\nエンジンとエアコンと、タイヤが路面を蹴る音だけが、\n響く。","沉默持续了片刻，\n只有引擎、空调和轮胎碾过路面的声音，\n在回荡。"],["……僕はあのひとがすきだ……ったけれど、","……我曾经喜欢过那个人……但是，"],["あなたは僕が","你对我而言"],["それでも、","即便如此，"],["とうか──","冬夏──"],["「胸のあたりがさ、痛い」","「胸口这里啊，好痛」"],["「んー」","「嗯──」"],["「感情ってのは脳味噌で発生するもんでさ、\n所詮はただの電気信号のなれの果て、\n胸が締め付けられる想いとか、\n胸がからっぽになるとかさ、\n適当な慣用表現だと思ってたんだ」","「感情这东西明明是从脑浆里产生的，\n说到底不过是电信号的终极形态，\n像什么揪心般的感受啊，\n胸口空荡荡的感觉啊，\n我一直以为只是随便的惯用表达」"],["「そうな」","「这样啊」"],["「違うんだな。[l]\nほんとに、\nここんとこが、\nすげえ苦しいし痛いんだぁ。[l]\n悲しいとか悔しいとかいうより、\n切ないよ、\n切ないよ、\nつらい、\nつらい、\nつらいんだよ、\nもう、\nこのやりきれない想いは\nどうしたらいいんだよ？[l]\n………痛いなぁ……[l]\nどうにもできないただ只管に、……」","「不是这样的。[l]\n真的，\n这个地方，\n超级难受又疼痛啊。[l]\n比起说是悲伤或者懊悔，\n是揪心啊，\n是揪心啊，\n痛苦，\n痛苦，\n很痛苦啊，\n已经，\n这份无法排遣的心情\n到底该怎么办才好？[l]\n………好痛啊……[l]\n完全无能为力只能一味地，……」"],["「──ちゃんと事実に即した表現だったのな、\n知らなかったよ僕ぁ。[l]\nこんな、[l]\nせつない感情があるとは、\nこんな、[l]\nだれかを……[l]\n胸がこんなにも痛くなるなんて、[l]\n………っ、[l]\n会いたいのに会えないのは、[l]\n話したいのに話せないのは、[l]\n………………っ、[l]\nそしたらさ、そし、…………」","「──原来真的是符合事实的描述啊，\n我完全不知道呢。[l]\n这样的，[l]\n撕心裂肺的感情，\n这样的，[l]\n某个人……[l]\n胸口会痛到这种地步，[l]\n………呃，[l]\n想见却见不到，[l]\n想说却说不了，[l]\n………………呃，[l]\n然后啊，然、…………」"],["再び持ち上がっためまぐるしい感情の渦が、\nまるで激昂するかのような荒々しいモノとなって、","再次翻涌而上的激烈情感漩涡，\n仿佛暴怒般化作狂暴之物，"],["──攻撃性の源泉ともいうべき、","──堪称攻击性的源泉，"],["……だめ、だ、だめだ、だめだだめだ、","……不行，不、不行，不行不行不行，"],["少し落ち着くまでまってくれ──","等我稍微冷静下来──"],["………狩屋と会ってるときでもこんな風じゃなかった、[l]\n本音は、こんなだったか、僕は、[l]\n全然、立ち直っては居なかった、[l]\n悪い、狩屋、………、","………和狩屋在一起时也没这样过，[l]\n真实的我，原来是这样的吗，[l]\n根本，就没有振作起来，[l]\n抱歉，狩屋、………、"],["こんなにも、[l]\n……さいていな、","居然，[l]\n……最差劲地，"],["人前で、","在人前，"],["慟","恸"],["哭するなんて、\nこんなにも惨めだとは、\n思わなかった、\n僕は、","哭成这样，\n没想到会，\n这么狼狈，\n我，"],["……顔を覆って、[l]\nどうにもならない自分の、\n震え、呻き声を上げ、涙鼻水を垂れ流すこの、\n紛う事なき己の身体を必死に抑え付け、\nひたすら襲い来る嫌悪感に苛まれながら、\nこの激情が過ぎるのを、\nただ、待った。","……用手捂住脸，[l]\n对无能为力的自己，\n颤抖着发出呜咽，眼泪鼻涕横流的，\n拼命压制这具不容置疑的身体，\n一味忍受袭来的厌恶感，\n等待这阵激情\n过去。"],["大神……と彼女は、その間、[l]\n黙って、何も言わなかった。","大神……和她，在此期间，[l]\n沉默着，什么都没说。"],["まだ、目的地には、着かない。[l]\n僕にとって、地獄のような沈黙が暫く続いた。","距离目的地，还有段距离。[l]\n对我来说如同地狱般的沉默持续了好一阵。"],["……漸く落ち着いて、[l]\n僕は、自らその沈黙を破る。","……终于平静下来，[l]\n我，主动打破了沉默。"],["「……此処に来て、[l]\n一度に沢山のひとと会って、\n……僕に好意を伝えてきた","「……来到这里后，[l]\n一下子见到很多人，\n……也有向我表达好意的"],["娘も居た」","女孩子」"],["「……ん、[l]\n夕べのその娘か？」","「……嗯，[l]\n是昨晚那个姑娘吗？」"],["「……彼奴ぁ、違うよ、違うと思う……[l]\nスキとは言われたけど、\n彼奴もテンパってたんだ、\n……僕等は色々話したけど、多分、[l]\n傷の嘗め合いだったんだ、彼奴はその傷の原因が、\n何とかなったようだから、\n屹度今はもう元気になったろうけど、\n……兎に角、[l]\n狩屋は、」","「……那家伙、不对的、我觉得不对……[l]\n虽然被告白了喜欢，\n但那家伙也慌了神，\n……我们虽然聊了很多，但大概，[l]\n只是互相舔舐伤口罢了，那家伙的伤痛根源，\n似乎已经解决了，\n现在肯定已经振作起来了吧，\n……总之，[l]\n狩屋是，」"],["「ああ、まあ、成る程な」","「啊，嘛，原来如此」"],["「……。[l]\n色々あったけど、\n僕は言われた、冬夏……って娘に、[l]\nすきだって、やわいいみじゃないって」","「……。[l]\n虽然经历了很多，\n我被那个叫冬夏……的女孩，[l]\n告白了说喜欢，不是开玩笑的」"],["「三春……冬夏か」","「三春……冬夏吗」"],["「冬夏に……そう言われても、[l]\n正直どうしていいか分からなかった、\n嬉しく無くはないんだけど、\n何かが引っ掛かってた、\nキライじゃないのに、\n素直に受け止められない自分が、\n彼女の事をどこかで脇に置こうとしている自分が、\nいたんだ、","「被冬夏……这么说了之后，[l]\n说实话不知该如何是好，\n倒也不是不开心，\n但总觉得有什么卡着，\n明明不讨厌她，\n却无法坦率接受的自己，\n下意识想把她的事搁置一旁的自己，\n是存在的，"],["でも分かった、","但现在明白了，"],["僕はあのひとが、すきだったから、\nなんだな……","因为我喜欢那个人，\n所以才会这样吧……"],["み……あのひとのことが……っ」","好想……那个人的事情……呜」"],["実際にコトバにすると、\n生々しくいやらしい背徳い、現実と夢想の綯い交ぜの、\nぐるぐるまわるような感覚に襲われ、\n僕は一瞬気が遠くなる。","实际说出口时，\n涌上鲜活淫靡的背德感，现实与妄想纠缠的，\n天旋地转般的感受袭来，\n我瞬间意识远去。"],["……僕等は結局、コトバという呪に囚われて生きてるんだろうか。","……我们终究是被言语的咒语束缚着生存的吧。"],["──コトバで定義することがそのものの性質を固着させ、","──用语言定义事物就会固化其本质，"],["語り、騙ることで、","通过叙述与欺瞒，"],["──文字……抽象図像化することで、","──文字……抽象符号化的过程，"],["一個の意味というものを、","将某个意义，"],["──他者に伝えるための、","──传递给他人，"],["やりかた、","的方法，"],["──カミにホウじて、","──遵循神意，"],["そうやって僕等は、それが僕等の、","我们就这样，这就是我们的，"],["──伝達の仕方。","──传达方式。"],["……気付くと、[l]\n僕はまた盛大に、鼻水を垂らしていたようだ。[l]\n運転しながら大神が、\nティッシュを僕に寄越した。","……回过神来，[l]\n我又在哗哗地流鼻涕了。[l]\n开车的大神，\n把纸巾扔给我。"],["そして、","接着"],["たまにゃいいだろ、\nこういう青春まっしぐらも、\nと奴は言った。","偶尔这样也不错，\n这种横冲直撞的青春，\n那家伙说道。"],["「男子はいつだって餓鬼で青臭いしな。[l]\nそうやって女子に迷惑かける分、\nそうでないとき振り回されて泣きをみんのも、\n泣き言言う羽目になんのも、俺等男子だよ」","「男人永远都是幼稚又青涩啊。[l]\n虽然会给女生添麻烦，\n但反过来被耍得团团转哭鼻子的，\n抱怨诉苦的也都是我们男人」"],["勿論全部が全部じゃないぜ、\nと笑って付け加える。","当然不是所有人都这样啦，\n他笑着补充。"],["「まー格好つけたとこで、\n『","「嘛～就算装得再帅，\n『"],["Ｙ",""],["の","的"],["欲","欲"],["動』が俺等の判断を狂わすのは事実だな。[l]\nともあれ、\nそこに付け込む連中もいるからにぁー、\n自制なり発散なり、処理する","望』会扰乱判断也是事实。[l]\n总之，\n也有专钻这种空子的家伙，\n自制或发泄，处理的方法"],["術も必要だわさ。[l]\n今のままだと、」","也是必要的啊。[l]\n照现在这样下去，」"],["「……」",""],["「──そろそろ腹減ったな。[l]\nえーとなんだっけ？[l]\nああ、\n兎に角、だから俺は来たんだ。[l]\nドッキリじゃあるまいし、\n自覚のねえ演者を高所から──\n隠しカメラで別室のモニタから嘲り嗤うような企画は、\n俺の好みじゃねーの」","「──差不多该饿了吧。[l]\n呃—该怎么说来着？[l]\n啊啊、\n总之、所以我才来了。[l]\n又不是整人节目、\n让毫无自觉的演员从高处──\n用隐藏摄像机从隔壁监控室嘲笑的企划、\n可不是老子的菜」"],["自覚……か、","自觉……么、"],["──もうすぐわかる、掴むまではあとすこし、","──马上就能明白了、离抓住只差一点、"],["僕の、じか、","我的、时、"],["「つうわけでだ、\n少なくともいーくんが、\n玩具ではないって事を、\n意思持つ一個人であると言うことを、\n『仕切ってるつもりの連中』に教えてやんよってな。[l]\n選択権が与えられてんなら、\n足掻けるのなら、\n足掻こうぜ、\nあの萌え店長に、連中に、\n鼠でさえ噛み付くことだってあるのに、\n同族だったらどうなるか、\n況してや俺等は、」","「所以说啊、\n至少要让饭君、\n不是玩具这件事、\n作为有自我意志的个体这件事、\n告诉那些『自以为在掌控局面的家伙们』啊。[l]\n既然被赋予了选择权、\n如果能挣扎的话、\n就拼命挣扎吧、\n让那个萌系店长、让那群人、\n就连老鼠都会咬人、\n如果是同类会怎样、\n更何况是我们呢、」"],["──茶黒のオウト、黒のイツワは、\n","──茶黑色的欧托、纯黑的伊兹瓦、\n"],["…………。",""],["「あ、あ、……う、あ」","「啊、啊、……呜、啊」"],["「あ、\n悪ぃな、マジで腹減ったよな？[l]\n俺もかれおんも、一緒に飯しようと思って、\nそのつもりでいたからさ。[l]\nまずは飯にすっか、\nリクエストあるか？」","「啊、\n抱歉、真饿了吧？[l]\n我和卡蕾欧也想着一起吃饭、\n本来就是这么打算的。[l]\n先解决吃饭问题吧、\n有什么想吃的？」"],["「……いや、なんでも、いいさ……」","「……不、随便、都行……」"],["「そうか。[l]\nかれおんは？」","「这样啊。[l]\n卡蕾欧呢？」"],["「あ゛っ、はい゛、なんでもいいデス」","「啊゛、好゛的、什么都行desu」"],["「らじゃ、\nじゃ適当に入るぜ」","「那就、\n随便找家店进去咯」"],["……急に話を振られて声が出てないかれお嬢も、[l]\n少しだけ、","……突然被搭话发不出声的卡蕾欧小姐、[l]\n看起来也稍微、"],["窶れて視えた。[l]\nごめん……","憔悴了些。[l]\n对不起……"],["僕も空腹ではあったが、\n先の激情からは大分落ち着いて、\n三人して他愛の無い話をしながら店を探した。","虽然我也饿着肚子、\n但从先前的激动中平复不少、\n三人说着无关紧要的话寻找餐馆。"],["……今、","……现在、"],["ただひとつ、僕の頭を占めるのは、","唯一占据我脑海的是、"],["他人からの好意、善意というのは、[l]\nやさしさっていうものは、[l]\nとても、[l]\nありがたく、","来自他人的好意、善意这种东西、[l]\n所谓温柔啊、[l]\n真的、[l]\n令人感激、"],["そうか、[l]\n僕にとって友達を作るのは、[l]\n人との関わりを結ぶことで──[l]\nそれはいつ、その関係性が敵と転ずるかとの恐怖でもあったんだ、[l]\nこのステキなモノが、[l]\n永遠でないことを知っているから、[l]\nいつにか消えた時の落差が怖ろしくて、","原来如此、[l]\n对我来说交朋友这件事、[l]\n与人建立羁绊──[l]\n同时也伴随着这份关系何时会变成敌人的恐惧、[l]\n因为知道这份美好、[l]\n并非永恒存在、[l]\n害怕某天消失时的落差、"],["だからなるべく、\n落差、段差を少なくするために、[l]\n大きな悲しみを得ないように、[l]\n大きな喜びをも拒否して、いた。","所以尽可能、\n为了减少落差、台阶、[l]\n为了不承受巨大悲伤、[l]\n连巨大喜悦也一并拒绝了。"],["それは、[l]\n怖さでもあったし後ろ向きな自己防衛の表れでもある。[l]\nそれでも、[l]\n狭く深い交友関係でも、つくらざるを得ない程に、[l]\nアイや優しさに飢えていながら。","那是、[l]\n既是恐惧也是消极的自我防卫表现。[l]\n即便如此、[l]\n哪怕是狭隘又深厚的交友关系，也不得不建立起来、[l]\n明明渴求着爱和温柔。"],["たたかうのはいやなんだ。[l]\nあらそうのはいやなんだ。","我讨厌争斗。[l]\n我讨厌争执。"],["大きな喜びを拒否するのは、\n大きな悲しみを得ないようにする為だし、","拒绝巨大的喜悦、\n是为了避免承受巨大的悲伤、"],["悲しみ、[l]\n苦しみ、[l]とは争いからくるもの、[l]\nと、[l]\n思って、[l]いた。","悲伤、[l]\n痛苦、[l]皆因争斗而起、[l]\n这般、[l]\n思忖着、[l]度过时日。"],["ただでさえ敵を作るのがイヤなのに、[l]\n彼我共に自覚もないしそのつもりもない相手と、[l]\nたたかうなんて、[l]\nたたかえなんて、","本来就不愿树敌、[l]\n更何况是与彼此都无自觉也无此意的对象、[l]\n进行争斗、[l]\n被迫战斗、"],["\n\n\n──この最悪の箱庭では、\n　　そのような戯事は単なる駄駄に過ぎなくとも、","\n\n\n──在这最恶劣的箱庭中、\n　　即便这种闹剧不过是徒劳的任性、"],["「まーた深刻になってるか？」","「又钻牛角尖了？」"],["「……あ、ああ、いや、大丈夫だ……」","「……啊、啊啊、没、没事的……」"],["──よくあるパラドックスのようだが、\n『争いを止める為の争い』というもんは、\n残念ながらあるんだろう。[l]\n要素や名称に拘って矛盾を視出す者は、\n言の葉の呪に囚われた視方で、\n事実あるんだ、そういうのは。","──虽像是常见的悖论、\n但『为了停止争斗而争斗』这种事、\n遗憾地确实存在吧。[l]\n拘泥于要素名称而指摘矛盾之人、\n不过是被言语诅咒的视角、\n事实就是存在这种事。"],["「まー、どう考えようと、\n俺の知るところじゃないし、\nそれこそいーくんの自由だが」","「嘛、怎么想都、\n与我无关、\n那本来就是饭君的自由啦」"],["と、大神は言った。","大神如此说道。"],["「でもな、\nまあ色々視座というものはあるさ、\n世の中は──特にヒトにとっては、\n好きか嫌いかが、重要な、価値の判断基準でさ。[l]\n論理的な理屈じゃないときもある、\nだから、\nま、余計なお世話かも知れないが、\n好意というより善意、\n好きというより、\nそうさな、『アイ』を以てして、\nコトに当たれ、と俺はアドバイスしよう。[l]\n自己満足だろうと何だろうと、\nまー誰かが言ってたが、そうでない満足なんか無いんだとさ。[l]\nだから、やってみて、\n駄目なら駄目、それはどうしようもない。[l]\nそんときゃ俺も、\n──友人としてチカラになったらぁ」","「但是啊、\n视角这种东西本来就有很多种、\n这世道──尤其对人类来说、\n喜欢或讨厌才是重要的价值判断基准。[l]\n有时候无关逻辑道理、\n所以、\n虽可能是多管闲事、\n比起好意更该怀着善意、\n比起喜欢、\n不如说、要以『爱』为准则、\n去面对问题，我这么建议。」[l]\n就算是自我满足也罢、\n嘛有人说过，除此之外根本不存在真正的满足。」[l]\n所以先试试看、\n不行就是不行，那也没办法。[l]\n到时候我也会、\n──作为朋友助你一臂之力啦」"],["そうだよなかれおん？","对吧卡蕾欧？"],["振り向いて奴は言う。","转头那家伙说道。"],["「ハイっ、も、勿論デスよ？[l]\nワタシももう、決め、決めてマス、から、何も、[l]\n心配は、」","「好、好滴，当、当然的说？[l]\n人家也早就、下、下决心了，所以完全、[l]\n不需要、」"],["いりません。","担心。"],["「………」",""],["二人は、はっきりとそう言って呉れた。","两人清晰地如此回应了我。"],["「……ありがとう……」","「……谢谢……」"],["心から素直にそう言えた。","发自内心率直地道谢。"],["どんなに本を読み知識を蓄え、\nそれ故にか斜に構えて、\n全てを識ったように振る舞おうと、","无论阅读多少书籍积累知识、\n因而摆出疏离姿态、\n装作通晓一切的模样、"],["朋のこういったこころが、\n大きな力に、なるということ、","朋友的这份心意、\n终将成为、巨大力量这件事、"],["青臭くとも綺麗事であろうとも、\n僕をすくってくれるこのチカラは間違いなく、\n確実に、","无论显得幼稚还是冠冕堂皇、\n这份拯救我的力量毫无疑问、\n确确实实、"],["──存在するんだ。","──存在着。"],["「きにすんなっての、先刻も言ったが、\nこれからが肝要なんだかんな。[l]\nまずは腹ごしらえして英気を養いてぇのに、\n……みっからねえなあ良さげな店がよ」","「都说了别在意啦、刚才也说过、\n接下来才是关键嘛。[l]\n本来想先填饱肚子养精蓄锐的、\n……完全找不到像样的店啊」"],["「ワタシもさ、探してるんですケド、\nな、なかなか……」","「人家也在找啦、\n但、但是很难……」"],["「はは……なんでも、どこでも、いいよ僕は……」","「哈哈……随便哪里、吃什么、我都行……」"],["僕は、[l]\nそう言って笑った。","我、[l]\n这么说着笑了。"],["……怒り、憎み、そういう原動力というものがある事を、[l]\n残念ながら僕自身でも否むことは出来ないが、\nそれでも、\nたとえ己を通す為にたたかうことになっても、","……愤怒、憎恨，这些原动力的存在，[l]\n遗憾的是连我自己也无法否认，\n即便如此，\n哪怕是为了贯彻自我而战，"],["そこに敵意というものを、\n介在させてはならないのだ、[l]\nということを、強く思った。","也不该让敌意\n掺杂其中，[l]\n这一点，我深以为然。"],["けもののように、[l]\n悪心なく、","如野兽般，[l]\n不带恶意，"],["ひとのように、[l]\n相手を慮り、","又似人类，[l]\n体恤对手，"],["たたかう、","去战斗，"],["相手に自分の事を伝えることが、","向对方传达自己的意志，"],["僕のすべき、たたかい。","才是我应行的战斗之道。"],["──憎しみは、いらない。","──无需憎恨。"],["皮肉なことだが、それこそゲームだよな、\nと思い乍ら、\n僕も店を探す。","讽刺的是，那才称得上是游戏吧，\n一边这样想着，\n我也开始寻找店铺。"],["「あっ」","「啊」"],["「？[l]\nあったか？」","「？[l]\n找到了吗？」"],["一個だけ、今言わせてくれるか、\n奴はそう言った。","就一句、现在能让我说出来吗、\n那家伙这么说道。"],["「いーくんはあの、\n今日居たあの海岸、彼処さ」","「饭君他啊、\n今天待过的那个海岸、就是那儿」"],["「碁石松原？」","「碁石松原？」"],["「っていうのか？[l]\n名前は俺はよく知らんけど。[l]\nいーくんはよく知ってた訳だな？」","「是叫这个吗？[l]\n名字我倒是不太清楚。[l]\n饭君倒是很了解的样子？」"],["「……ああ、そう、だな……」","「……啊、对、是这样……」"],["そう言って、僕は彼処に関する過去の記憶を、\n奴にかいつまんで話した。","这么说着、我把关于那地方的过往记忆、\n向他简略地讲述了一遍。"],["「つまり、\n過去の記憶を他人から説明されるより先に、\n彼処をそうだと感じたんだな？」","「也就是说、\n比起从别人口中听到过去的记忆、\n你先自己感受到那就是那个地方了？」"],["「…………ああ、[l]\nそう、なるか？……多分」","「…………啊、[l]\n算是、这样吧？……大概」"],["最早どれがどうなってたかなんて、\n冷静には判断出来なかったが、\n確か、そうだった……気がする。","到底哪件事对应哪个部分、\n已经没法冷静判断了、\n不过确实、是那样……的感觉。"],["「まー、\nどこもかしこも同じ様な砂浜海岸でだ、\nそうそう『ココだ！』と断定出来ると思うか？[l]\nいーくんはそもそも旅行好きだったろう。[l]\n沢山色んな風景を視てる筈だな？[l]\nその中で、\nモニュメントやら有名地形があるなら兎も角も、\n彼処がそうだと決定的に思った理由は？」","「嘛—\n到处都差不多的沙滩海岸啦，\n你真觉得能轻易断定『就是这里！』吗？[l]\n饭君本来就很喜欢旅行吧。[l]\n应该见识过很多不同的风景吧？[l]\n在那些地方里，\n如果有纪念碑或者著名地形倒另当别论，\n你认定是那里的决定性理由是？」"],["それは、……なぜだ？","那是……为什么呢？"],["「彼処には多分、\nあるんだな、\nいーくんを呼ぶ……つーか、[l]\n何か、引くモノが。[l]\nあー、そうだ、\nかるろ──」","「那里大概有、\n某种东西吧、\n能召唤饭君的……或者说、[l]\n某种吸引人的东西。」[l]\n啊、对了、\n卡鲁罗──」"],["「あの海岸……に、海岸で……あ？[l]\n何だって？」","「那个海岸……在、海岸上……啊？[l]\n你说什么？」"],["「──サっていうやつの事、\nもう聞いてるか、あ？何？」","「──关于那个叫萨的家伙，\n你已经听说了吧，啊？什么？」"],["──シ[l]　ＷＯ[l]　ｗａｓ[l]　Ｕ[l]　Ｒｅ[l]　ルナ。[l]","──シ[l]　WO[l]　was[l]　U[l]　Re[l]　ルナ。[l]"],["ながきよの[l]トオのねぶりの","永世长眠之[l]远方的"],["みなめざめ","众人苏醒"],["なみのりぶねの[l]オトのよきかな","乘浪之舟的[l]音之良宵"],["──てがみを、","──把信，"],["……手紙？","……信？"],["まて、それ、は、","等等、那个、是、"],["「……どうした？」","「……怎么了？」"],["「──いや、\nまだ、もう少し……掴むまでは、[l]\nまだ……」","「──不、\n还差一点……在完全抓住之前、[l]\n还不行……」"],["「──悪い、\nやっぱ腹減り過ぎたぽい、\nあ、彼処にしようぜ、\n……二人もそれで良ければ」","「──抱歉、\n果然饿过头了、\n啊、就去那里吧、\n……如果你们两个也没意见的话」"],["ぐるるるるるるるるる。","咕噜噜噜噜噜噜噜。"],["……何かのオトが、","……某种声音、"],["僕の中で、","在我体内、"],["ナった、","响起了、"],["気がした。","的感觉。"],["腹か、頭かは、わからなかったけど──","不知是肚子还是脑袋──"]],"context":[["SC_M_061.ks/index/1/text"],["SC_M_061.ks/index/3/text"],["SC_M_061.ks/index/6/text"],["SC_M_061.ks/index/8/text"],["SC_M_061.ks/index/10/text"],["SC_M_061.ks/index/12/text"],["SC_M_061.ks/index/14/text"],["SC_M_061.ks/index/16/text"],["SC_M_061.ks/index/18/text"],["SC_M_061.ks/index/20/text"],["SC_M_061.ks/index/23/text"],["SC_M_061.ks/index/25/text"],["SC_M_061.ks/index/27/text"],["SC_M_061.ks/index/29/text"],["SC_M_061.ks/index/31/text","SC_M_061.ks/index/71/text","SC_M_061.ks/index/295/text","SC_M_061.ks/index/671/text","SC_M_061.ks/index/699/text"],["SC_M_061.ks/index/33/text"],["SC_M_061.ks/index/35/text"],["SC_M_061.ks/index/37/text"],["SC_M_061.ks/index/39/text"],["SC_M_061.ks/index/41/text"],["SC_M_061.ks/index/43/text"],["SC_M_061.ks/index/45/text","SC_M_061.ks/index/147/text"],["SC_M_061.ks/index/47/text"],["SC_M_061.ks/index/49/text"],["SC_M_061.ks/index/51/text"],["SC_M_061.ks/index/53/text"],["SC_M_061.ks/index/55/text"],["SC_M_061.ks/index/57/text"],["SC_M_061.ks/index/59/text"],["SC_M_061.ks/index/61/text"],["SC_M_061.ks/index/63/text"],["SC_M_061.ks/index/65/text"],["SC_M_061.ks/index/67/text"],["SC_M_061.ks/index/69/text"],["SC_M_061.ks/index/73/text"],["SC_M_061.ks/index/75/text"],["SC_M_061.ks/index/77/text"],["SC_M_061.ks/index/79/text"],["SC_M_061.ks/index/81/text"],["SC_M_061.ks/index/83/text"],["SC_M_061.ks/index/85/text"],["SC_M_061.ks/index/87/text"],["SC_M_061.ks/index/89/text"],["SC_M_061.ks/index/91/text"],["SC_M_061.ks/index/93/text"],["SC_M_061.ks/index/95/text"],["SC_M_061.ks/index/97/text"],["SC_M_061.ks/index/99/text"],["SC_M_061.ks/index/101/text"],["SC_M_061.ks/index/103/text"],["SC_M_061.ks/index/105/text"],["SC_M_061.ks/index/107/text"],["SC_M_061.ks/index/109/text"],["SC_M_061.ks/index/111/text"],["SC_M_061.ks/index/113/text"],["SC_M_061.ks/index/115/text"],["SC_M_061.ks/index/117/text"],["SC_M_061.ks/index/119/text"],["SC_M_061.ks/index/121/text"],["SC_M_061.ks/index/123/text"],["SC_M_061.ks/index/125/text"],["SC_M_061.ks/index/127/text"],["SC_M_061.ks/index/129/text"],["SC_M_061.ks/index/131/text"],["SC_M_061.ks/index/133/text"],["SC_M_061.ks/index/135/text"],["SC_M_061.ks/index/137/text"],["SC_M_061.ks/index/139/text"],["SC_M_061.ks/index/141/text"],["SC_M_061.ks/index/143/text"],["SC_M_061.ks/index/145/text"],["SC_M_061.ks/index/149/text"],["SC_M_061.ks/index/151/text"],["SC_M_061.ks/index/153/text"],["SC_M_061.ks/index/155/text"],["SC_M_061.ks/index/157/text"],["SC_M_061.ks/index/159/text"],["SC_M_061.ks/index/161/text"],["SC_M_061.ks/index/163/text"],["SC_M_061.ks/index/166/text"],["SC_M_061.ks/index/168/text"],["SC_M_061.ks/index/170/text"],["SC_M_061.ks/index/173/text"],["SC_M_061.ks/index/175/text"],["SC_M_061.ks/index/177/text"],["SC_M_061.ks/index/179/text"],["SC_M_061.ks/index/181/text"],["SC_M_061.ks/index/183/text"],["SC_M_061.ks/index/185/text"],["SC_M_061.ks/index/187/text"],["SC_M_061.ks/index/189/text"],["SC_M_061.ks/index/191/text"],["SC_M_061.ks/index/193/text"],["SC_M_061.ks/index/195/text"],["SC_M_061.ks/index/197/text"],["SC_M_061.ks/index/199/text"],["SC_M_061.ks/index/201/text"],["SC_M_061.ks/index/203/text"],["SC_M_061.ks/index/205/text"],["SC_M_061.ks/index/207/text"],["SC_M_061.ks/index/209/text"],["SC_M_061.ks/index/211/text"],["SC_M_061.ks/index/213/text"],["SC_M_061.ks/index/215/text"],["SC_M_061.ks/index/217/text"],["SC_M_061.ks/index/220/text"],["SC_M_061.ks/index/222/text"],["SC_M_061.ks/index/224/text"],["SC_M_061.ks/index/226/text"],["SC_M_061.ks/index/228/text"],["SC_M_061.ks/index/230/text"],["SC_M_061.ks/index/232/text"],["SC_M_061.ks/index/234/text"],["SC_M_061.ks/index/236/text"],["SC_M_061.ks/index/238/text"],["SC_M_061.ks/index/240/text"],["SC_M_061.ks/index/242/text"],["SC_M_061.ks/index/244/text"],["SC_M_061.ks/index/246/text"],["SC_M_061.ks/index/248/text"],["SC_M_061.ks/index/250/text"],["SC_M_061.ks/index/253/text"],["SC_M_061.ks/index/255/text"],["SC_M_061.ks/index/257/text"],["SC_M_061.ks/index/259/text"],["SC_M_061.ks/index/261/text"],["SC_M_061.ks/index/263/text"],["SC_M_061.ks/index/265/text","SC_M_061.ks/index/432/text","SC_M_061.ks/index/438/text"],["SC_M_061.ks/index/267/text"],["SC_M_061.ks/index/269/text"],["SC_M_061.ks/index/271/text"],["SC_M_061.ks/inde