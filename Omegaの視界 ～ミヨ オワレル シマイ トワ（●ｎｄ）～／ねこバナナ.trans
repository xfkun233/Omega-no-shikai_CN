,"end":3019}],[{"start":3037,"end":3041}],[{"start":3072,"end":3081}],[{"start":3112,"end":3119}],[{"start":3150,"end":3180}],[{"start":3242,"end":3249},{"start":3280,"end":3287},{"start":3318,"end":3325},{"start":3356,"end":3363}],[{"start":3394,"end":3409}],[{"start":3440,"end":3447}],[{"start":3506,"end":3518}],[{"start":3549,"end":3623}],[{"start":3633,"end":3634}],[{"start":3644,"end":3654}],[{"start":3685,"end":3703}],[{"start":3734,"end":3750}],[{"start":3781,"end":3854}],[{"start":3885,"end":3899}],[{"start":3930,"end":3953}],[{"start":3984,"end":4024}],[{"start":4055,"end":4114}],[{"start":4145,"end":4151}],[{"start":4182,"end":4216}],[{"start":4247,"end":4265}],[{"start":4296,"end":4299}],[{"start":4330,"end":4363}],[{"start":4394,"end":4410}],[{"start":4472,"end":4516}],[{"start":4547,"end":4586}],[{"start":4617,"end":4636}],[{"start":4667,"end":4674}],[{"start":4705,"end":4720}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_023.ks","basename":"SC_E_023.ks","indexIds":{"@r@r@r@r@r@r@r　　　　　　　　　　　 　一時間程前──":0,"「自衛戰解禁。[l]\n……カリヤは禁級":1,"読":2,"紙？」":3,"「うん、そうなる。[l]\n":4,"柔い発動になるけど……」":5,"「祭もあるからそれでいいよ。[l]\nもし交戦になってもアヤメでなんとかする」":6,"「……ごめん」":7,"「アヤメ、常駐特禁級だしもうすっかり馴じんでるから」":8,"「……無理しないでよ」":9,"「大丈夫」":10,"「双相爪出すの？」":11,"「うん」":12,"「大丈夫？」":13,"「うん。[l]\nもっと馴らしときたいし。[l]\n最近更に馴染んできたから」":14,"「まだあれと決まった訳じゃないし……[l]\n特禁級……あんまり使って欲しくないな……」":15,"「克杖」":16,"「ご、ごめん……[l]\nその為の私達だもんね」":17,"「兎に角今は単なる":18,"斥":19,"候。[l]\n真言さん達を放ってもおけないから」":20,"「……なんで……なのかなぁ……」":21,"「カリヤ、ヨんで」":22,"「……はい。[l]\nみゅう」":23,"「みゅう」":24,"「ミ・カヤタサタサキャラタサコネキャラキャラナサコネナサタソロ、タサキャラナメキャラタサンコメキャタソロミャルカヤメン・ワ」":25,"「ミ・ナサコネタサコネキャラコネタサミャルキャラタサメタサ\nタサメコネキャラミャルタサコネキャラコネタサコネナサナサ・ワ」":26,"おぁああああああああああああああああああん。":27,"「……":28,"限":29,"解マル、ミャ？」":30,"「ワゥ」":31,"「有効時間三分適宜重ねます、ミャ？」":32,"「……ミハルがいれば早いんだろうけど……」":33,"「………」":34,"「五感の限解は出来ないし……[l]\nもし探してる奴だったら、\n何とか錨だけでも打てれば」":35,"「そもそも本当に探してた奴なのかな？":36,"あの連中だとしたら……[l]\n実物は初めてだからなんとも言えないけど\nもしそうだとしたら、":37,"全一の猫を相手にしなきゃならないんだよね。":38,"でもその割にはなんか、\n逃げてるだけっぽいし、\nほら、\n若しかしてやっぱりただの動物か何か――」":39,"「アヤメはそう感じてない」":40,"「え？」":41,"「不思議だけど、\n似た匂いがしてるみたい……？」":42,"「な、何でそんな事が？[l]\n――ちょ、過剰同期してるんじゃ、\n危ないよっ」":43,"「いあ、だって……」":44,"「母様よりも運姉様よりも、\n私がアヤメをわかってる」":45,"「そう、かも知れないけど、\nあんまり近づくのは、\n『神蝕』を……」":46,"「何処に行ったかな……」":47,"「……せめて、[l]\nううん……信じてるけど……[l]\nあ、でも、もし全一の遣い手としたら、\n何もしてこないっておかしくない？":48,"わ、罠かな……":49,"それに、\nさっきの声、\nおと、こ？[l]\nいや、わかんないけど……」":50,"「しっ」":51,"「（……！）」":52,"「（襲ってくるつもりはないのか……[l]\nやっぱり逃げてる……のかな、[l]\n葉が邪魔で……視えない）」":53,"「（と、とにかくトウビョウの準備します）」":54,"ばしゅ！":55,"「（気付かれた）」":56,"「（うぇぁ）」":57,"「（大丈夫、おろせた。[l]\n静かに、じっとして）」":58,"「（………）」":59,"「（い、いなくなった……ね）」":60,"「（……うん）":61,"「な、何者だったんだろ」":62,"「取り敢えず錨さえ打てばあとは……[l]\nミハルを待つかキサムラ代替、\n最悪タマズサと連携……出来るのかな……[l]\n兎に角":63,"一":64,"月は何とかなるから」":65,"「少なくとも祭までは効果持続か……」":66,"「ヒトのようではあったけど……」":67,"「猫の匂いをアヤメが感じてるなら、\n只の変質者とかじゃない、よね……[l]\nでもあの連中だとしたらやっぱり追撃してこない意味が…」":68,"「寧子さんは何も視てない？」":69,"「母様は殆ど初撃で気を失ってたらしいから……」":70,"「……母様達を殺したのがあの連中かどうかも[l]\nまだはっきりしてない」":71,"「そか、\nネコガミ遣い以外には無理、という前提で探してたけど、\nそれが連中とイコールとは限らない……」":72,"「野良……」":73,"「資質者は兎も角、\nネコガミのほうは野良なんてそうそう──」":74,"「アヤメが感じてるのは少し違ってる」":75,"「？」":76,"「……まさか……絶対禁忌者なの？[l]\nだから……なの？」":77,"「？[l]\nな、なに？」":78,"「……なんでもない。[l]\n後は錨の解析に任せて、\n戻ろう、二人が心配」":79,"「もし今のがあれで……[l]\n再度襲撃されたら……兄ぃはどうしよう？」":80,"「真言さんには知られても、問題ないよ」":81,"「に゛っ！？」":82,"「あのひとこそが………だもの」":83},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_023.ks","relPath":"/data/scenario/SC_E_023.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":84,"length":84,"percent":100},"cellInfo":[null,[null,{"v":1}],null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"t":"HU","v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"t":"HU","v":1}],[null,{"v":1}],null,null,null,[null,{"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"t":"HU","v":1}],null,null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[63,0],"note":"完成"},"/data/scenario/SC_E_024.ks":{"data":[["僕がこれを継いでから結構な時が経つ。","自我继承这职位已过去不少时日。"],["彼女と逢ったのはそのほぼ同時期で、\n僕が子供の頃からの付き合いとなる。[l]\n僕は早熟だったからね。","与她的相遇几乎就在同时、\n算来是从我孩提时代就相识了。[l]\n毕竟我早熟得很呢。"],["魔女の魔女たる","魔女之所以为魔女"],["所","的"],["以、\nそうあらんとする依りとなる眼の質も肉の回路も、\nその結果の猫との親和、\n魔眼質とは生活環境や肉質等、\n他者の影響を喰い学ぶ経緯が\nありこそすれ、\n基本的には自発的なものだから、\nそういう意図で人から習うものではなかったけれど、","缘由、\n作为成就此名的眼之资质与血肉回路、\n由此产生的与猫的亲和、\n所谓魔眼资质虽会受生活环境或肉体特质、\n吸收学习的过程等\n所左右、\n但本质仍是自发之物、\n本不该刻意向他人学习、"],["『術中ナナ散文式』やら、[l]\n\n便宜的に十に割り振られる相のあれこれやら、[l]\n\n彼女から教授される学は僕にとって有意義な\n暇潰しであり、すぐにのめり込んだ。","诸如《术中七散文式》、[l]\n\n为方便而划分的十种相位诸如此类、[l]\n\n她传授的学问对我而言是极好的\n消遣、令我很快沉迷其中。"],["僕が長じてからも興味は尽きず、\nその思索に興じる為に、\n結局のらりくらりと躱し続けて今まで来た。","成年后兴趣也未消退、\n为钻研这些奥妙、\n结果就这样东躲西藏混到了现在。"],["僕が今属する集団とは別のarchiveより彼女に教授された心得、\n僕らが","她传授的心得来自与我现属组织不同的archive、\n我等"],["嗜むべき諸々。","应当修习的种种。"],["諳んずるならば、[l]\n\nだからお前達、猫と魔眼の同胞は、\n喰うこととは学ぶ事と知れ、\n普通に蝕す分には不要なものは排泄されるのだ、\n喰ってから取捨選択は為されるのだ、\n分解しマテリアルと化し再構成する、\n肉の成長、知の学習、\n丸呑みは愚かな行為だと知れ、\n噛み砕き己が解釈を再構成すること、\n考えろ、考えろ、考えろ。","若要我总结、[l]\n\n故尔等、猫与魔眼的同胞啊、\n当知进食即是学习、\n寻常消化时无用之物自会排泄、\n吞食后才进行取舍、\n分解为素材重新构筑、\n血肉成长、知识习得、\n须知囫囵吞枣是愚行、\n要咀嚼消化并重构自己的理解、\n思考吧、思考吧、思考吧。"],["感じるモノもコトも必要だ。[l]\n理論は発見スルモノではなく気付くだけだと自覚したまえ。[l]\n我は個の幸福の為にお前達に猫を遣わしめた。[l]\n生命の本質のように視えるものとは、\nエネルギーの変換機構、世界を視る眼としての存在、\n認識の為の構造物、観測者、\nそれらの役を続ける為に相争いながら誰かが此処に\n居続けなければならない\n最悪の箱庭へと放たれた我等全ての存在物の\n残酷な祝命を慰める友を贈り物としよう。","感受事物皆为必需。[l]\n要明白理论非被发现而是被察觉。[l]\n我为个体幸福才将猫赐予尔等。[l]\n看似生命本质之物、\n实为能量转换机制、观测世界的眼、\n为认知而设的结构、观测者、\n为延续这些职能才需相互争斗着让某人\n永驻于此\n向被投入这最恶劣箱庭的我们所有存在、\n献上慰藉残酷宿命的朋友作为礼物吧。"],["魔眼質、[l]\n\nOmegaの視界、[l]\n\nしかしながらその","魔眼质、[l]\n\nOmega的视界、[l]\n\n然而其"],["実sightのみが問題ではない。[l]\n\n言の葉は同時に罠でもあるし、愉悦のまやかしともなる。[l]\n\nワカル、という事が肝要だ。[l]\n\n視えていようと愚者には猫は見向きもしないし、[l]\n\n視えずとも賢者には猫は","实sight本身并非问题所在。[l]\n\n言语既是陷阱，亦是愉悦的欺瞒。[l]\n\n关键在于「理解」这件事。[l]\n\n纵使可见，愚者亦不会得到猫的垂青，[l]\n\n即便不可见，贤者亦会"],["自ずと友情を示す。","自然获得猫的友谊。"],["ワカらぬ者は猫の方から許容されない。[l]\n\nそんなこともわからないとはなんと●●●なのだろう。","不解之人会被猫主动排斥。[l]\n\n连这都不懂真是何等●●●啊。"],["資質者は少ないし、ワカル者はそもそも弁えているので\n捜し出すのは骨だと彼女は言っていた。[l]\nホンモノは主張せずともホンモノだからね。[l]\npromoteなど唾棄すべき行為だというのは僕にも理解できるし、\n『理屈』という、\nヒトの言語という意思伝達機構によって限界を設けられた\nくだらない物差しの","资质者本就稀少，而理解者天生就懂得分寸，\n她说寻找起来如同大海捞针。[l]\n真货无需自证亦是真货。[l]\npromote之类该被唾弃的行为连我都明白，\n所谓『道理』，\n不过是受限于人类语言这种\n粗劣的"],["宛がい","信息传递机制所框定了界限的"],["方の作法など、","无聊的尺度的运用规矩之类的东西，"],["魔眼質者のやる事ではない。[l]\n\n愉悦を獲得せんが為に、覚悟と責を以てして猫と戯るが魔。[l]\n\n僕は","绝非魔眼质者所为。[l]\n\n为获取愉悦而怀着觉悟与责任与猫嬉戏方为魔道。[l]\n\n我"],["偶さか今のポジションに生まれたが、\n僥倖だった。","虽偶然诞生于当下位置，\n实属侥幸。"],["さて、とは言え、[l]\n\n伝統は守るもの。[l]\n無為なしきたりであっても『それを遵守する行為自体』に\n意味を見出す場合がある。[l]\n技術のように常に上昇を目指す行為とではモチベーションから何から根本的に異なっているのに、伝統に効率やルールの矛盾を突くを求めた所で端からお門違いというものだ。","不过话说回来，[l]\n\n传统必须守护。[l]\n即便是无意义的陈规，『遵守行为本身』\n有时亦蕴含价值。[l]\n与追求技术进步这种动机根本相异的行为不同，向传统索要效率或规则合理性根本就是缘木求鱼。"],["我等が姫君のモチベーションはまた別にあるだろうが、[l]\n\n言わねば判らぬ輩には言っても判らぬのだから、[l]\n\n逆説的に、[l]\n\n言の葉のタマで言わずとも解る者には解るのだ。","我们对公主的动机或许另当别论，[l]\n\n但对说了也不懂的家伙说了也是白说，[l]\n\n反过来说，[l]\n\n真正的知音无需言语也能心领神会。"],["紅き燈灯すハコ持つ者。[l]\n\nGeniusもInsanityもカミヒトエか。[l]\n\nそして、[l]\n\n親和というよりは支配の機構を用いる彼等。","手持绯红箱庭之人。[l]\n\nGenius也好Insanity也罢皆为神谕么。[l]\n\n而[l]\n\n比起亲和更惯用支配机制的他们。"],["ぶれることは少ないが融通に欠ける面白味のない遣り方。[l]\n\n更に安定性に特化させようとしたのは確か失敗したとか。[l]\n\nそれはそうだろう。","虽少有偏差却缺乏变通的乏味作风。[l]\n\n据说追求极端稳定性的尝试确实失败了。[l]\n\n这是自然。"],["それにしてもあの●●の息子はどうにも自覚が足りない。[l]\n肉の側に振り回されるとは如何にもＹを持つ者の\nvulnerabilityとでも言うべきか。[l]\n暴走が過ぎる。[l]\n脳の空転は","但那个●●的儿子实在缺乏自觉。[l]\n被肉体的欲望所摆布正是Y持有者\n所谓的vulnerability吧。[l]\n暴走过甚了。[l]\n大脑空转"],["未だしも肉の欲動に","尚可容忍，"],["抗えないのは\n不可避なものなのだろうか。[l]\nＹを持たぬ我等には想像し難い。[l]\n彼等が『魔眼の刺し手』を創るにＹを用いたのも、\nそして零号で失敗し、初号以降の調律を永い間放棄していたのも\n頷ける。","但屈服于\n肉欲莫非是宿命？[l]\n我等无Y者难以想象。[l]\n他们用Y创造『魔眼杀手』，\n在零号失败后长期放弃初号及后续型号的调律，\n倒也合理。"],["いずれ僕に望まれている事は、[l]\n\n『TrojanHorse』[l]\n\nか、或いは、[l]\n\n『touchstone』[l]\n\nの配置。","终究我被期待的使命，[l]\n\n是作为『TrojanHorse』[l]\n\n或[l]\n\n『touchstone』[l]\n\n的布局。"],["その呼び水、尖兵としての[l]\n\n『Fixer』、[l]\n\n『deus ex machina』[l]\n\nとやら、というよりは、[l]\n\n『Trickster』[l]\n\nのhelper。","作为诱因与先锋的[l]\n\n『Fixer』、[l]\n\n说是『deus ex machina』[l]\n\n不如说是[l]\n\n『Trickster』[l]\n\n的helper。"],["今回の件で言うならば、[l]\n\n『initiation』[l]\n\nの[l]\n\n『tutorial』に関わる、[l]\n\n●●●●とは違う不正操作。","若就此次事件而言，[l]\n\n『initiation』[l]\n\n的[l]\n\n『tutorial』涉及的，[l]\n\n与●●●●性质不同的违规操作。"],["シフトした世界、新たに始まる夜の先触れ、[l]\n\n僕の愉しみを満たすには具合が良い。","偏移后的世界、崭新夜晚的前兆，[l]\n\n正合我意能满足我的愉悦。"],["覚悟は出来ている。[l]\n\n僕にとって最良の遊戯だ。[l]\n\n邪魔などさせない。[l]\n\n邪魔するモノにはムクイあれ、だ。","我已做好觉悟。[l]\n\n这对我而言是最棒的游戏。[l]\n\n绝不会让人妨碍。[l]\n\n敢碍事者唯有报应。"]],"context":[["SC_E_024.ks/index/1/text"],["SC_E_024.ks/index/3/text"],["SC_E_024.ks/index/5/text"],["SC_E_024.ks/index/7/text"],["SC_E_024.ks/index/9/text"],["SC_E_024.ks/index/11/text"],["SC_E_024.ks/index/13/text"],["SC_E_024.ks/index/15/text"],["SC_E_024.ks/index/17/text"],["SC_E_024.ks/index/19/text"],["SC_E_024.ks/index/21/text"],["SC_E_024.ks/index/23/text"],["SC_E_024.ks/index/25/text"],["SC_E_024.ks/index/27/text"],["SC_E_024.ks/index/29/text"],["SC_E_024.ks/index/31/text"],["SC_E_024.ks/index/33/text"],["SC_E_024.ks/index/35/text"],["SC_E_024.ks/index/37/text"],["SC_E_024.ks/index/39/text"],["SC_E_024.ks/index/41/text"],["SC_E_024.ks/index/43/text"],["SC_E_024.ks/index/45/text"],["SC_E_024.ks/index/47/text"],["SC_E_024.ks/index/49/text"],["SC_E_024.ks/index/51/text"],["SC_E_024.ks/index/53/text"],["SC_E_024.ks/index/55/text"],["SC_E_024.ks/index/57/text"],["SC_E_024.ks/index/59/text"],["SC_E_024.ks/index/61/text"],["SC_E_024.ks/index/63/text"]],"tags":[],"parameters":[[{"start":128,"end":146}],[{"start":154,"end":212}],[{"start":220,"end":227}],[{"start":236,"end":237}],[{"start":247,"end":391}],[{"start":399,"end":500}],[{"start":508,"end":564}],[{"start":572,"end":612}],[{"start":623,"end":630}],[{"start":656,"end":855}],[{"start":863,"end":1105}],[{"start":1119,"end":1166}],[{"start":1176,"end":1316}],[{"start":1326,"end":1335}],[{"start":1349,"end":1405}],[{"start":1415,"end":1589}],[{"start":1599,"end":1602}],[{"start":1612,"end":1619}],[{"start":1629,"end":1697}],[{"start":1707,"end":1735}],[{"start":1749,"end":1918}],[{"start":1926,"end":2033}],[{"start":2043,"end":2140}],[{"start":2152,"end":2239}],[{"start":2249,"end":2360}],[{"start":2369,"end":2378}],[{"start":2389,"end":2510}],[{"start":2524,"end":2625}],[{"start":2635,"end":2767}],[{"start":2779,"end":2883}],[{"start":2895,"end":2945}],[{"start":2953,"end":3038}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_024.ks","basename":"SC_E_024.ks","indexIds":{"僕がこれを継いでから結構な時が経つ。":0,"彼女と逢ったのはそのほぼ同時期で、\n僕が子供の頃からの付き合いとなる。[l]\n僕は早熟だったからね。":1,"魔女の魔女たる":2,"所":3,"以、\nそうあらんとする依りとなる眼の質も肉の回路も、\nその結果の猫との親和、\n魔眼質とは生活環境や肉質等、\n他者の影響を喰い学ぶ経緯が\nありこそすれ、\n基本的には自発的なものだから、\nそういう意図で人から習うものではなかったけれど、":4,"『術中ナナ散文式』やら、[l]\n\n便宜的に十に割り振られる相のあれこれやら、[l]\n\n彼女から教授される学は僕にとって有意義な\n暇潰しであり、すぐにのめり込んだ。":5,"僕が長じてからも興味は尽きず、\nその思索に興じる為に、\n結局のらりくらりと躱し続けて今まで来た。":6,"僕が今属する集団とは別のarchiveより彼女に教授された心得、\n僕らが":7,"嗜むべき諸々。":8,"諳んずるならば、[l]\n\nだからお前達、猫と魔眼の同胞は、\n喰うこととは学ぶ事と知れ、\n普通に蝕す分には不要なものは排泄されるのだ、\n喰ってから取捨選択は為されるのだ、\n分解しマテリアルと化し再構成する、\n肉の成長、知の学習、\n丸呑みは愚かな行為だと知れ、\n噛み砕き己が解釈を再構成すること、\n考えろ、考えろ、考えろ。":9,"感じるモノもコトも必要だ。[l]\n理論は発見スルモノではなく気付くだけだと自覚したまえ。[l]\n我は個の幸福の為にお前達に猫を遣わしめた。[l]\n生命の本質のように視えるものとは、\nエネルギーの変換機構、世界を視る眼としての存在、\n認識の為の構造物、観測者、\nそれらの役を続ける為に相争いながら誰かが此処に\n居続けなければならない\n最悪の箱庭へと放たれた我等全ての存在物の\n残酷な祝命を慰める友を贈り物としよう。":10,"魔眼質、[l]\n\nOmegaの視界、[l]\n\nしかしながらその":11,"実sightのみが問題ではない。[l]\n\n言の葉は同時に罠でもあるし、愉悦のまやかしともなる。[l]\n\nワカル、という事が肝要だ。[l]\n\n視えていようと愚者には猫は見向きもしないし、[l]\n\n視えずとも賢者には猫は":12,"自ずと友情を示す。":13,"ワカらぬ者は猫の方から許容されない。[l]\n\nそんなこともわからないとはなんと●●●なのだろう。":14,"資質者は少ないし、ワカル者はそもそも弁えているので\n捜し出すのは骨だと彼女は言っていた。[l]\nホンモノは主張せずともホンモノだからね。[l]\npromoteなど唾棄すべき行為だというのは僕にも理解できるし、\n『理屈』という、\nヒトの言語という意思伝達機構によって限界を設けられた\nくだらない物差しの":15,"宛がい":16,"方の作法など、":17,"魔眼質者のやる事ではない。[l]\n\n愉悦を獲得せんが為に、覚悟と責を以てして猫と戯るが魔。[l]\n\n僕は":18,"偶さか今のポジションに生まれたが、\n僥倖だった。":19,"さて、とは言え、[l]\n\n伝統は守るもの。[l]\n無為なしきたりであっても『それを遵守する行為自体』に\n意味を見出す場合がある。[l]\n技術のように常に上昇を目指す行為とではモチベーションから何から根本的に異なっているのに、伝統に効率やルールの矛盾を突くを求めた所で端からお門違いというものだ。":20,"我等が姫君のモチベーションはまた別にあるだろうが、[l]\n\n言わねば判らぬ輩には言っても判らぬのだから、[l]\n\n逆説的に、[l]\n\n言の葉のタマで言わずとも解る者には解るのだ。":21,"紅き燈灯すハコ持つ者。[l]\n\nGeniusもInsanityもカミヒトエか。[l]\n\nそして、[l]\n\n親和というよりは支配の機構を用いる彼等。":22,"ぶれることは少ないが融通に欠ける面白味のない遣り方。[l]\n\n更に安定性に特化させようとしたのは確か失敗したとか。[l]\n\nそれはそうだろう。":23,"それにしてもあの●●の息子はどうにも自覚が足りない。[l]\n肉の側に振り回されるとは如何にもＹを持つ者の\nvulnerabilityとでも言うべきか。[l]\n暴走が過ぎる。[l]\n脳の空転は":24,"未だしも肉の欲動に":25,"抗えないのは\n不可避なものなのだろうか。[l]\nＹを持たぬ我等には想像し難い。[l]\n彼等が『魔眼の刺し手』を創るにＹを用いたのも、\nそして零号で失敗し、初号以降の調律を永い間放棄していたのも\n頷ける。":26,"いずれ僕に望まれている事は、[l]\n\n『TrojanHorse』[l]\n\nか、或いは、[l]\n\n『touchstone』[l]\n\nの配置。":27,"その呼び水、尖兵としての[l]\n\n『Fixer』、[l]\n\n『deus ex machina』[l]\n\nとやら、というよりは、[l]\n\n『Trickster』[l]\n\nのhelper。":28,"今回の件で言うならば、[l]\n\n『initiation』[l]\n\nの[l]\n\n『tutorial』に関わる、[l]\n\n●●●●とは違う不正操作。":29,"シフトした世界、新たに始まる夜の先触れ、[l]\n\n僕の愉しみを満たすには具合が良い。":30,"覚悟は出来ている。[l]\n\n僕にとって最良の遊戯だ。[l]\n\n邪魔などさせない。[l]\n\n邪魔するモノにはムクイあれ、だ。":31},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_024.ks","relPath":"/data/scenario/SC_E_024.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":32,"length":32,"percent":100},"cellInfo":[null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[5,1],"note":"完成"},"/data/scenario/SC_E_025.ks":{"data":[["「ベロアー、どうしたん？[l]\nやっぱり気分わるい？[l]\n寒なってきたもんねー、雨もふりそうやし」","「贝萝娅、怎么了？[l]\n果然不舒服吗？[l]\n变冷了呢——而且好像要下雨了」"],["「……うん、いや、きにしないで」","「……嗯、没事、别在意」"],["「こっち、西部にくらべてめっさ寒いねんて。[l]\n選律さんとかよう言うてはった。[l]\nでもなー価無は子供やからよう知らんねん。","「这边比起西部可冷多了。[l]\n选律小姐他们常这么说。[l]\n但价无还是小孩子，不懂这些哦。"],["ちゅうかな、\n女子は可愛く視られるためなら薄着もミニも着んねんて、\nそらもう根性はいってんねん。[l]\nあ。選律さんも女子やねんな」","话说回来，\n女生为了被觉得可爱就算穿得少或穿超短裙也愿意，\n这股子劲头真够可以的。[l]\n啊。选律小姐也是女生呢」"],["「……」","「……」"],["「ベロアー無視せんといてよ。[l]\nあーもしかしてー、さっき向こうからきたにーちゃん？","「贝萝娅别无视我呀。[l]\n啊——莫非是因为刚才对面过来的哥哥？"],["さっきのにーちゃん、なんかえらい顔色わるかったよやけど、\n価無が猫あいてに独り言いうてるキショイ奴と思ったんちゃう。[l]\nそんなんいちいち気にしとったらあかんでー。","刚才那个哥哥脸色超级差来着，\n感觉他不是那种和价无一样会对着猫说话的恶心宅呢。[l]\n这种小事别在意啦——"],["ベロアくらいすごいと簡単にはバレたりせぇへんのやろ、\n忘れてもうたらええやんか。[l]\nあんなうざいわ。うざうざうざうざ……」","像贝萝娅这么厉害才不会轻易暴露呢，\n忘了就好嘛。[l]\n真是烦死了。烦死人了烦死人了……」"],["「カナはトウカに憧れてるって言ってる割には、\n乱暴だね言葉遣いが。[l]\nもっと","「明明价无说自己憧憬着冬夏，\n说话却这么粗鲁。[l]\n必须做出更更符合"],["淑","淑"],["女に","女"],["相","身份的"],["応しい立ち振る舞いを……[l]\n身につけなきゃいけないよ」","言行举止……[l]\n要多学着点才行啊」"],["「うざいもんはうざいねんもんー。[l]\nあでも学校では価無、優等生やで。","「烦人的东西就是烦人嘛——[l]\n不过在学校价无可是优等生哦。"],["選律さんのおかげもあるけどな、\n男子もめっちゃ寄って来よんねん困るわほんまに。[l]\nコドモばっかで話にならへんし」","虽然也有选律小姐的功劳啦，\n男生们超爱凑过来超困扰的真的。[l]\n净是些小屁孩根本没法聊」"],["「異性に気に入られるための行動は、\nヒト以外は結構な割合で雌よりも雄がするものだからさ。[l]\n生殖においてその相手を決定する権利は雌の側にあることが多いし」","「为了吸引异性注意的行为，\n在人类以外很多物种里雄性做得比雌性更积极呢。[l]\n毕竟生殖中选择权多在雌性手中」"],["「なんかベロアやらしい話してんちゃうん。[l]\nあかんで、価無まだ少女やで。[l]\nコドモの男子よりは大人やけどなー。","「贝萝娅是不是在讲下流话题啊。[l]\n不行啦价无还是少女耶。[l]\n虽然比那些小男孩成熟点——"],["ちゅうかな、ほんまのはなし、ようわかれへんかってんけど。[l]\nなんの話？」","话说回来其实根本搞不懂啦。[l]\n我们到底在说什么？」"],["「……いや、きにしないで」","「……没什么、别在意」"],["ベロアは気になっている、\n気になる、気になる、『あれ』はなんだ？","贝萝娅很在意，\n非常在意、在意得不行、『那东西』究竟是什么？"],["ベロアならわかるはずなんだ。[l]\n本当に『あれ』が『そう』なら、\nこんなに迷うことなどないのに……","若是贝萝娅的话本该能明白的啊。[l]\n若『那东西』真是『那个』的话，\n也就不会如此犹豫不决……"],["なんなんだ、あの人間は。","那个人类到底是什么来头啊。"],["そうだ人間だ。","没错，明明就是个人类而已。"],["『あれ』が『そう』とか、それ以前のもんだいだ。","『那东西』是否是『那个』根本无关紧要。"],["しかしPHASE10イーハは、いわば受肉する前のベロアたちの存在の\n核にひとしい存在、\n骸操る","但PHASE10伊哈堪称贝萝娅们受肉前存在的\n核心般的存在，\n操纵尸骸的"],["霊たる存在。[l]\n肉をえてイシキの構造はこのステージに準じているけれど――","灵体存在。[l]\n虽获得肉体后意识结构与此阶段相符――"],["１０に分割された後、\n喪われた９と１０、\n骸の消えた白の追っ手――","被分割为10份后，\n遗失的9与10，\n遗骸消失的白之追兵――"],["……まって、まってよ、[l]\nそうか、つまり、\nいやでもそうなると、","……等等、等一下，[l]\n原来如此，也就是说，\n不、但这样一来，"],["ま、さか。","嘛、说不定呢。"],["だとしても、なんでじゃあ、やつらは動かないんだ？[l]\nセンリのスキャンも欠かさず行われていたはず。","即便如此，为什么那些家伙毫无动静？[l]\n而且选律的扫描应该从未间断过。"],["どういうことだ。","这到底怎么回事。"],["すべてが気のせいであればいいのに。[l]\nそれとも、また、会いに行かねばならないか。","但愿一切都只是错觉。[l]\n还是说，又非得去见一面吗。"],["いや、だめだ。[l]\nマスターミリアムがセンリと共にいる以上、\n離れるわけにはいかない、[l]\nさっきはカナと一緒に息抜きを命じられたからそうしたけど、\nまさか、白の連中は『ぜんぶわかっている』かもしれないなんて、","不，不行。[l]\n只要主人米莉安姆和选律在一起，\n我就不能离开，[l]\n刚才是因为被命令和价无一起休息才那么做，\n难道说，白之众可能『全都知道』了，"],["「カナ、早くかえろう。[l]\nマスターミリアムを一人にしておけない」","「价无，快回去。[l]\n不能让主人米莉安姆独自待着」"],["「ひとりて、\nちゃんと選律さんもいてはるよー？[l]\n","「独自个鬼，\n选律小姐明明也在呀～？[l]\n"],["冬夏姉様のおやしきには他にも……」","冬夏姐姐的宅邸里还有其他人……」"],["「いいから、いそいで」","「别管了，赶紧的」"],["明確に『あれ』を『そう』と断定できる要素がないのに、\nなんでベロアはイーハの名を出した？[l]\n気になってしようがない。","明明没有能明确断定『那东西』就是『那个』的依据，\n为什么贝萝娅会说出伊哈的名字？[l]\n在意得不得了。"],["もし眷属を視たらわかるはずだ。[l]\n迷うことはない。","若是见到眷属应该就能明白。[l]\n无需犹豫。"],["なのに、","可是，"],["判らない。","不明白。"],["わからないのに、引っ掛かる。","明明不明白，却耿耿于怀。"],["『あれ』はなんだった？","『那东西』究竟是什么？"],["イツワの１０、イーハ、それが、","伊兹瓦的10，伊哈，就是"],["ベロアが連想したものだ、そうなんだけど……","贝萝娅联想到的存在，虽然确实如此……"],["ドレミリアの子等に与えられたイツワの","德蕾米莉娅的孩子们继承的伊兹瓦"],["残","残"],["滓は\n１から８だ。[l]\n９、１０はとうに亡くなっているとばかり思っていた。","渣是\n1到8。[l]\n我一直以为9和10早就消亡了。"],["あとは……","除非……"],["特別なprot-einを配備しているとでも……？","除非他们部署了特殊的prot-ein……？"],["「ほな、戻ろか－。[l]\nベロアーこっちおいで、\n","「那，回去吧。[l]\n贝萝娅过来这边，\n"],["だっこしたる」","抱你哦」"],["無視したほうがいいことも世の中にはある、[l]\n好奇心猫を殺す、ねこをころす……","世上有些事最好装作没看见，[l]\n好奇心害死猫，会把猫弄死的……"],["それとも、\nいよいよベロアの肉は限界なのかな……","又或者，\n终于连贝萝娅的肉体也到极限了吗……"],["まともに動けるのはたぶんあと少しだろう。","能正常活动的时间恐怕所剩无几了。"],["マスターミリアムが用意してくれるはずの\n新たな肉も、馴染むまでには時間がかかるだろうし、[l]\nそのあいだマスターミリアムをなんとしてもまもらなければ\nならない。","就算主人米莉安姆准备好\n新的肉体，适应也需要时间，[l]\n在那期间无论如何都必须保护好\n主人米莉安姆。"],["ツェロルはみつかっていないが、\nセンリはうそをついている。","虽然还没找到赛萝洛，\n但选律在说谎。"],["あいつに、PHASE:5を司るあいつに、\n永代の命を与えたのはまちがいだった。[l]\nあいつしかいなかったが、\n絶対に裏切るのはあいつだ。[l]\n肉が保つ間はベロアがfirewallを展開していられるけれど、","赋予那个家伙——掌管PHASE:5的那个家伙\n永恒的生命根本是个错误。[l]\n虽然当时只有她能行，\n但绝对会背叛的，也只有她。[l]\n只要肉体还能维持，贝萝娅就能展开firewall，"],["しかし、[l]\nマスターミリアム、ベロアの肉は限界だ。","然而，[l]\n主人米莉安姆，贝萝娅的肉体已经到极限了。"],["@r@r@r@r@r@r@r　　　　　　　　　　　でも、","@r@r@r@r@r@r@r　　　　　　　　　　　但是，"],["@r@r@r@r@r@r@r　　　　　マスターミリアムはなんとしても、","@r@r@r@r@r@r@r　　　　　无论如何主人米莉安姆，"],["@r@r@r@r@r@r@r　　　　　　　ベロアが護らなければならない。","@r@r@r@r@r@r@r　　　　　　　贝萝娅必须守护好你。"]],"context":[["SC_E_025.ks/index/1/text"],["SC_E_025.ks/index/3/text"],["SC_E_025.ks/index/5/text"],["SC_E_025.ks/index/7/text"],["SC_E_025.ks/index/9/text"],["SC_E_025.ks/index/11/text"],["SC_E_025.ks/index/13/text"],["SC_E_025.ks/index/15/text"],["SC_E_025.ks/index/17/text"],["SC_E_025.ks/index/19/text"],["SC_E_025.ks/index/21/text"],["SC_E_025.ks/index/23/text"],["SC_E_025.ks/index/25/text"],["SC_E_025.ks/index/27/text"],["SC_E_025.ks/index/29/text"],["SC_E_025.ks/index/31/text"],["SC_E_025.ks/index/33/text"],["SC_E_025.ks/index/35/text"],["SC_E_025.ks/index/37/text"],["SC_E_025.ks/index/39/text"],["SC_E_025.ks/index/41/text"],["SC_E_025.ks/index/43/text"],["SC_E_025.ks/index/45/text"],["SC_E_025.ks/index/47/text"],["SC_E_025.ks/index/49/text"],["SC_E_025.ks/index/51/text"],["SC_E_025.ks/index/53/text"],["SC_E_025.ks/index/55/text"],["SC_E_025.ks/index/57/text"],["SC_E_025.ks/index/59/text"],["SC_E_025.ks/index/61/text"],["SC_E_025.ks/index/63/text"],["SC_E_025.ks/index/65/text"],["SC_E_025.ks/index/67/text"],["SC_E_025.ks/index/69/text"],["SC_E_025.ks/index/72/text"],["SC_E_025.ks/index/74/text"],["SC_E_025.ks/index/76/text"],["SC_E_025.ks/index/78/text"],["SC_E_025.ks/index/80/text"],["SC_E_025.ks/index/82/text"],["SC_E_025.ks/index/84/text"],["SC_E_025.ks/index/86/text"],["SC_E_025.ks/index/88/text"],["SC_E_025.ks/index/90/text"],["SC_E_025.ks/index/92/text"],["SC_E_025.ks/index/94/text"],["SC_E_025.ks/index/96/text"],["SC_E_025.ks/index/98/text"],["SC_E_025.ks/index/100/text"],["SC_E_025.ks/index/102/text"],["SC_E_025.ks/index/105/text"],["SC_E_025.ks/index/107/text"],["SC_E_025.ks/index/109/text"],["SC_E_025.ks/index/111/text"],["SC_E_025.ks/index/113/text"],["SC_E_025.ks/index/115/text"],["SC_E_025.ks/index/117/text"],["SC_E_025.ks/index/119/text"],["SC_E_025.ks/index/121/text"],["SC_E_025.ks/index/123/text"],["SC_E_025.ks/index/125/text"]],"tags":[],"parameters":[[{"start":155,"end":213}],[{"start":242,"end":258}],[{"start":287,"end":359}],[{"start":367,"end":445}],[{"start":474,"end":478}],[{"start":507,"end":554}],[{"start":562,"end":653}],[{"start":661,"end":732}],[{"start":761,"end":809}],[{"start":818,"end":819}],[{"start":830,"end":832}],[{"start":842,"end":843}],[{"start":852,"end":885}],[{"start":914,"end":954}],[{"start":962,"end":1028}],[{"start":1057,"end":1144}],[{"start":1173,"end":1240}],[{"start":1248,"end":1290}],[{"start":1319,"end":1332}],[{"start":1427,"end":1463}],[{"start":1471,"end":1529}],[{"start":1537,"end":1549}],[{"start":1557,"end":1564}],[{"start":1572,"end":1595}],[{"start":1603,"end":1658}],[{"start":1668,"end":1710}],[{"start":1718,"end":1759}],[{"start":1767,"end":1809}],[{"start":1817,"end":1822}],[{"start":1830,"end":1884}],[{"start":1892,"end":1900}],[{"start":1908,"end":1954}],[{"start":1968,"end":2091}],[{"start":2133,"end":2171}],[{"start":2253,"end":2284}],[{"start":2313,"end":2330}],[{"start":2372,"end":2383}],[{"start":2421,"end":2489}],[{"start":2497,"end":2528}],[{"start":2536,"end":2540}],[{"start":2548,"end":2553}],[{"start":2561,"end":2575}],[{"start":2583,"end":2594}],[{"start":2602,"end":2617}],[{"start":2625,"end":2646}],[{"start":2654,"end":2672}],[{"start":2682,"end":2683}],[{"start":2692,"end":2738}],[{"start":2746,"end":2751}],[{"start":2759,"end":2783}],[{"start":2850,"end":2879}],[{"start":2908,"end":2915}],[{"start":2983,"end":3027}],[{"start":3035,"end":3063}],[{"start":3071,"end":3091}],[{"start":3099,"end":3192}],[{"start":3206,"end":3239}],[{"start":3247,"end":3367}],[{"start":3375,"end":3406}],[{"start":3434,"end":3476}],[{"start":3482,"end":3531}],[{"start":3537,"end":3587}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_025.ks","basename":"SC_E_025.ks","indexIds":{"「ベロアー、どうしたん？[l]\nやっぱり気分わるい？[l]\n寒なってきたもんねー、雨もふりそうやし」":0,"「……うん、いや、きにしないで」":1,"「こっち、西部にくらべてめっさ寒いねんて。[l]\n選律さんとかよう言うてはった。[l]\nでもなー価無は子供やからよう知らんねん。":2,"ちゅうかな、\n女子は可愛く視られるためなら薄着もミニも着んねんて、\nそらもう根性はいってんねん。[l]\nあ。選律さんも女子やねんな」":3,"「……」":4,"「ベロアー無視せんといてよ。[l]\nあーもしかしてー、さっき向こうからきたにーちゃん？":5,"さっきのにーちゃん、なんかえらい顔色わるかったよやけど、\n価無が猫あいてに独り言いうてるキショイ奴と思ったんちゃう。[l]\nそんなんいちいち気にしとったらあかんでー。":6,"ベロアくらいすごいと簡単にはバレたりせぇへんのやろ、\n忘れてもうたらええやんか。[l]\nあんなうざいわ。うざうざうざうざ……」":7,"「カナはトウカに憧れてるって言ってる割には、\n乱暴だね言葉遣いが。[l]\nもっと":8,"淑":9,"女に":10,"相":11,"応しい立ち振る舞いを……[l]\n身につけなきゃいけないよ」":12,"「うざいもんはうざいねんもんー。[l]\nあでも学校では価無、優等生やで。":13,"選律さんのおかげもあるけどな、\n男子もめっちゃ寄って来よんねん困るわほんまに。[l]\nコドモばっかで話にならへんし」":14,"「異性に気に入られるための行動は、\nヒト以外は結構な割合で雌よりも雄がするものだからさ。[l]\n生殖においてその相手を決定する権利は雌の側にあることが多いし」":15,"「なんかベロアやらしい話してんちゃうん。[l]\nあかんで、価無まだ少女やで。[l]\nコドモの男子よりは大人やけどなー。":16,"ちゅうかな、ほんまのはなし、ようわかれへんかってんけど。[l]\nなんの話？」":17,"「……いや、きにしないで」":18,"ベロアは気になっている、\n気になる、気になる、『あれ』はなんだ？":19,"ベロアならわかるはずなんだ。[l]\n本当に『あれ』が『そう』なら、\nこんなに迷うことなどないのに……":20,"なんなんだ、あの人間は。":21,"そうだ人間だ。":22,"『あれ』が『そう』とか、それ以前のもんだいだ。":23,"しかしPHASE10イーハは、いわば受肉する前のベロアたちの存在の\n核にひとしい存在、\n骸操る":24,"霊たる存在。[l]\n肉をえてイシキの構造はこのステージに準じているけれど――":25,"１０に分割された後、\n喪われた９と１０、\n骸の消えた白の追っ手――":26,"……まって、まってよ、[l]\nそうか、つまり、\nいやでもそうなると、":27,"ま、さか。":28,"だとしても、なんでじゃあ、やつらは動かないんだ？[l]\nセンリのスキャンも欠かさず行われていたはず。":29,"どういうことだ。":30,"すべてが気のせいであればいいのに。[l]\nそれとも、また、会いに行かねばならないか。":31,"いや、だめだ。[l]\nマスターミリアムがセンリと共にいる以上、\n離れるわけにはいかない、[l]\nさっきはカナと一緒に息抜きを命じられたからそうしたけど、\nまさか、白の連中は『ぜんぶわかっている』かもしれないなんて、":32,"「カナ、早くかえろう。[l]\nマスターミリアムを一人にしておけない」":33,"「ひとりて、\nちゃんと選律さんもいてはるよー？[l]\n":34,"冬夏姉様のおやしきには他にも……」":35,"「いいから、いそいで」":36,"明確に『あれ』を『そう』と断定できる要素がないのに、\nなんでベロアはイーハの名を出した？[l]\n気になってしようがない。":37,"もし眷属を視たらわかるはずだ。[l]\n迷うことはない。":38,"なのに、":39,"判らない。":40,"わからないのに、引っ掛かる。":41,"『あれ』はなんだった？":42,"イツワの１０、イーハ、それが、":43,"ベロアが連想したものだ、そうなんだけど……":44,"ドレミリアの子等に与えられたイツワの":45,"残":46,"滓は\n１から８だ。[l]\n９、１０はとうに亡くなっているとばかり思っていた。":47,"あとは……":48,"特別なprot-einを配備しているとでも……？":49,"「ほな、戻ろか－。[l]\nベロアーこっちおいで、\n":50,"だっこしたる」":51,"無視したほうがいいことも世の中にはある、[l]\n好奇心猫を殺す、ねこをころす……":52,"それとも、\nいよいよベロアの肉は限界なのかな……":53,"まともに動けるのはたぶんあと少しだろう。":54,"マスターミリアムが用意してくれるはずの\n新たな肉も、馴染むまでには時間がかかるだろうし、[l]\nそのあいだマスターミリアムをなんとしてもまもらなければ\nならない。":55,"ツェロルはみつかっていないが、\nセンリはうそをついている。":56,"あいつに、PHASE:5を司るあいつに、\n永代の命を与えたのはまちがいだった。[l]\nあいつしかいなかったが、\n絶対に裏切るのはあいつだ。[l]\n肉が保つ間はベロアがfirewallを展開していられるけれど、":57,"しかし、[l]\nマスターミリアム、ベロアの肉は限界だ。":58,"@r@r@r@r@r@r@r　　　　　　　　　　　でも、":59,"@r@r@r@r@r@r@r　　　　　マスターミリアムはなんとしても、":60,"@r@r@r@r@r@r@r　　　　　　　ベロアが護らなければならない。":61},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_025.ks","relPath":"/data/scenario/SC_E_025.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":62,"length":62,"percent":100},"cellInfo":[[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[58,1],"note":"完成"},"/data/scenario/SC_E_026.ks":{"data":[["「まあ今回も特に問題なく。[l]\n例年通り","「嘛这次也没什么特别问题。[l]\n和往年一样"],["恙なく式は完了ですぅ。[l]\nつまり、検出は無しですねぃ。[l]\n同時に、有用な方も見つかってませんけど」","仪式平安完成啦。[l]\n也就是说没有检测到异常呢。[l]\n不过同时也没发现有用的人选」"],["「……」","「……」"],["「（……きーちゃ？[l]\n──うぅん……）」","「（……小姬？[l]\n──嗯……）」"],["「（ああ、心配せんといてね、\nあの子の事は言うてないから）」","「（啊别担心啦\n我没提那孩子的事）」"],["「何？[l]\nどうかなさったの？」","「怎么？[l]\n出什么事了吗？」"],["「はい？[l]\n何も言うてませんよぅ」","「诶？[l]\n我什么都没说呀」"],["「じゃあちょっといいかな？[l]\n栖後奉仕、昼の部を今日手伝って来たんだけどね。[l]\nその時に少々事件があったので。[l]\n恐らく我等眷属を襲ったモノと──接触しましたよ」","「那能占用点时间吗？[l]\n我今天去帮忙做了栖后侍奉的日间部分。[l]\n当时发生了点小状况。[l]\n可能和袭击我等眷属的家伙──有过接触」"],["「！？[l]\nちょっと聞いてないわよ。[l]\n何で","「！？[l]\n完全没听说啊。[l]\n为什么"],["先","不"],["刻に言わないのよ、\n今まで話す時間あったでしょ」","早点说啊\n明明之前有时间讲的」"],["「何故って夜の部にこうして皆が集まるからだろう。[l]\nミコにだけ話しておいたってしょうがないし」","「当然是因为要等夜晚全员集合啊。[l]\n光告诉卑尊也没意义」"],["「だって重大事じゃないの！[l]\n母様達を●●した奴でしょ、信じられない、\nそんなことまで、\nおくびにも出さない方がどうかしてるわ」","「可这不是大事吗！[l]\n那家伙可是●●了母亲大人她们啊，难以置信\n连这种事，\n居然都只字不提，这才是不对劲吧」"],["「そこの二人、\nお静かになさい。[l]\n道具さんどういう事かしら？[l]\n襲われたの？今日？」","「那边的两位\n请安静。[l]\n道具小姐具体什么情况？[l]\n被袭击了？今天？」"],["「ご覧の通りピンピンしてますけれどもね。[l]\n正確に言うと単なる接触ですし、\n本当に『それ』かどうかは実のところ確証は現時点では\nないのですがね、","「如你所见我活蹦乱跳着呢。[l]\n准确说只是接触事件，\n是否真是『那个』目前还没有\n确凿证据，"],["今日は姫様君と克杖君と同行していましたので、\n──克杖君には禁級で読紙して貰いましたが、\n僕のprot-ein『anchor』を」","不过今天姫様和克杖与我同行\n──让克杖用了禁级读纸术，\n我的prot-ein『anchor』」"],["「トウビョウしました」","「投锚了」"],["「トウビョウを確認しました」","「已确认到投锚」"],["「と、\nいうことですので。[l]\nいずれ足取りは追跡できるでしょう。","「就\n是这样。[l]\n迟早能追踪到踪迹。"],["解析は僕がしましょうか？[l]\nそれとも──」","解析工作我来做？[l]\n还是说──」"],["「うちでもええけども……[l]\n","「我家也行啦……[l]\n"],["錨打った場合はあんさん自身でやったほうが\n確実ちゃいますかねぇ」","既然下了锚还是你自己处理\n更稳妥吧」"],["「了解です。[l]\nではキサムラ代替で」","「明白。[l]\n那就用奇萨姆拉替代」"],["「……トモ大丈夫なの？[l]\nあんただって禁級続きじゃ」","「……道具真的没问题？[l]\n连续使用禁级了吧」"],["「大丈夫だよ。[l]\n僕を誰だと思っているのかね」","「没关系。[l]\n你当我是谁啊」"],["「（ねね選律さん、\n今夜も","「（呐呐选律小姐\n今晚也要"],["長なるんかな？[l]\n価無、もうめっさねむいかも）」","熬到很晚吗？[l]\n价无已经困得不行了）」"],["「（ごめんねぇ、\nもうすこぅし我慢したってねぃ）」","「（对不起呀\n再稍微坚持一下下嘛）」"],["「（冬夏姉様もおらへんしなー……[l]\n価無なんかここおってもしゃーない\n気がすんねんけど。","「（冬夏姐姐大人也不在呢ー……[l]\n价无在这儿待着也没啥用\n虽然心里这么想。"],["あっちの二人はなんか苦手やし、\nノリがあわんゆうか）」","那边两个人总觉得有点合不来，\n该说是不在一个频道上吧）」"],["「そうよ、そういえば、\nミハルの継承はまだなのですか？[l]\nあれのほうが確実では……」","「是呀，说起来，\n米哈尔的继承仪式还没举行吗？[l]\n那样做会更稳妥些……」"],["「……まだなのよ。[l]\n今夜も──参加は見合わせましたし、\n冬夏を貴女のナガヒサで修復するまでは私が代理です。[l]\nあの","「……还没呢。[l]\n今晚也──暂不参加，\n在冬夏被您的纳伽希萨修复完成前都由我代理。[l]\n那个"],["娘も早く何とかしなければ」","丫头也必须尽快想办法」"],["「それで彼女、居ないのですか……[l]\nトモが応急処置してるのよね？」","「所以她不在场吗……[l]\n是道具在做应急处理对吧？」"],["「そうだよ。[l]\nミコもまだ本発動は無理なのだろ？[l]\n君のあれを禁級で動かす訳にはいかないしねえ。","「没错。[l]\n卑尊现在也还无法正式发动吧？[l]\n总不能让你用禁级来驱动那个啊。"],["まあ、祭までには、\nどうあれ解決していることでしょう。[l]\n心配には及びませんよ」","不过到祭典之前，\n总归会有解决办法的。[l]\n不必担心」"],["「そう。[l]\n懸案である使役場の解禁も、\n今回が無事に済めば夢ではない話の筈よ。[l]\nだからこそ今回は──」","「是啊。[l]\n包括悬而未决的使役场解禁问题，\n这次若能顺利解决就不再是空谈。[l]\n正因如此这次──」"],["「何があろうと完遂せねばなりませんねぃ」","「无论发生什么都必须完成呢」"],["「（ふぁ……）」","「（哈啊……）」"],["「特に魔女殿の件はね。[l]\nその為にはミコ、君には頑張って貰わねばねえ。[l]\n今回かなりの負担を強いることになるのは避けられない。","「特别是魔女大人那件事。[l]\n为此卑尊，你必须加把劲才行。[l]\n这次难免要让你承担相当大的负担。"],["彼女にパッチをあてるのか、お友達の方をリペアするのか……[l]\nどうあれ冬夏君の突発的事故が加わったのがきついね。[l]\n僕も勿論出来うる限りのサポートはするが」","是要给她打补丁，还是修复她朋友呢……[l]\n总之冬夏君的突发事故让情况更棘手了。[l]\n我当然也会尽力支援」"],["「……正直期待せざるを得ないわ。[l]\n彼女が素直に継承と復帰してくれる事を祈るけど。[l]\nそれで多少はましになる」","「……说实话只能指望你了。[l]\n但愿她能老实接受继承并回归。[l]\n这样多少能缓解些」"],["「それは……私も何とかするわよ。[l]\n最悪の場合は──」","「那个……我也会想办法的。[l]\n最坏的情况──」"],["「うちの出番ですかねぃ。[l]\nそん時は、姫様ちゃん達に協力して貰う事になる\nでしょうけど、\nなるべく手荒な真似はせんで済むよう頼みますぅ。","「该我们出场了对吧。[l]\n到时候就得请姫様她们帮忙\n了，\n但还请尽量避免粗暴手段。"],["あのお方に叱られてまいますからねぃ」","会被那位大人责骂的啦」"],["「ま、\n彼女に関してはしばらくそっとしておくのが得策と\n思いますがね。","「嘛，\n关于她的事暂时冷处理才是上策\n我觉得。"],["前言いましたが、僕の知人で彼女に近しい人が数人いますし、\n穏便に行きましょう」","如先前所说，我认识几个与她亲近的人，\n还是稳妥行事吧」"],["「私だってその方が良いに決まっています。[l]\n貴女に任せるのは色んな意味で気が重いけど、\nどうにか出来るならして頂戴。[l]\n例の西石とやらでも使ってね。","「我当然也希望能这样。[l]\n把事情交给你各方面都让人不放心，\n但能做到的话就拜托了。[l]\n那个叫西石的家伙也随便使唤。"],["──では、\n祭儀の開催に当たっては、\n言い訳その他は用意しましょう。","──那么，\n关于祭仪举办事宜，\n请准备好说辞和其他安排。"],["キサムラ代替での検証と平行して処理します。[l]\n姫様克杖両名は道具さんの報告を受けて行動すること。[l]\n価無さんと選律さんは引き続きあの方へ付添で待機して\nくださって。","与奇萨姆拉替代方案的验证同步进行。[l]\n姫様和克杖请根据道具的报告行动。[l]\n价无和选律继续陪同那位大人待命\n吧。"],["卑尊さんは業務をこなしながら本発動出来次第、\nまずは冬夏の修復」","卑尊请处理日常业务并在能正式发动时，\n优先修复冬夏」"],["「今回の\nあの方自身、或いはベロアちゃんの●●が最優先、\nまあ、その為には冬夏ちゃんの修復が先なりますがねぃ。","「这次\n那位大人自身或贝萝娅的●●最优先，\n不过为此得先修复冬夏呢。」"],["そして、\nいよいよ『八人姉妹』の復興」","然后，\n『八姐妹』的复兴终于要来了」"],["「それから、つぇろるの探索ですね？」","「还有就是，赛萝洛的搜索对吧？」"],["「はぁ、そうなりますかなぁ。[l]\nあの方はご執心であらせられますよぅ」","「哈啊，算是吧。[l]\n那位大人可是相当执着呢」"],["「──成る程ね。[l]\nうふふ」","「──原来如此。[l]\n呵呵」"],["「では、下界の方含めて祭開催への動きは進めます。[l]\n皆さん、くれぐれも失敗しないように。[l]\n","「那么包括下界在内，祭典举办的准备工作会推进。[l]\n各位，请务必不要失败。[l]\n"],["美","美"],["歪","歪"],["死","死"],["窪」","洼」"],["「……道具さん」","「……道具小姐」"],["「ふむ。[l]\n彼の事かい？","「嗯。[l]\n他的事吗？"],["まあ選律殿が調べても無反応だったのは、\n『これから』開花するからかも知れないし、\n勿論別の理由かも知れない。","不过选律大人调查后也没反应，\n可能是『即将』开花，\n当然也可能是其他原因。"],["今の姫様君は特禁級常駐で鋭敏にもなっているだろうから、\n若しかするとタマズサでもよめなかった何らかの兆候を\n見出したのかも知れないね。","现在的姫様大人因特禁级常驻而变得敏锐，\n说不定发现了连塔玛祖莎都无法预见的某些征兆\n呢。"],["流石は第一階位、\n運君を差し置いてつぎめとなっただけの事はある……禁句かい？」","不愧是第一阶位，\n能越过运大人成为继任者确实有道理……这话算禁句吗？」"],["「……姉様はどうでもいいです」","「……姐姐大人怎样都无所谓」"],["「彼が白き者達であれば、\nタマズサから逃れる防護策を持っているかも知れないが、\n今日の昼間の件があるからね。[l]\n少なくとも君の母上達を襲ったのとは無関係だよ」","「如果他是白之众的话，\n或许持有能避开塔玛祖莎的防护手段，\n但今天白天发生了那件事。[l]\n至少与你母亲她们遇袭无关」"],["「トウビョウの結果はまだなんじゃ……？」","「投锚的结果还没出来吗……？」"],["「まあね。[l]\n僕も君ほどじゃないが、\n使役場の解禁に関しては研究してるからね。","「是啊。[l]\n虽然没你那么深入，\n但关于使役场解禁我也在研究。"],["ミコに言わせれば禁忌を破る不遜な行為らしいが、\n彼女自身だって解禁自体は有用だと思ってるからね。[l]\n現金なものだよ。","按卑尊的说法是亵渎禁忌的傲慢行为，\n但她自己也认为解禁本身是有用的。[l]\n真是现实呢。"],["と、言うわけで、だ。[l]\n他の連中よりは多少僕もワカルのさ。[l]\n言わないけどね」","所以，就是这样。[l]\n比起其他人我多少更了解些。[l]\n不过不说罢了」"],["「じゃああのひとのことを……」","「那那个人的事……」"],["「うふふ、\n正直彼に関してはなにも感じてないよ。[l]\n残念だねというべきか、安心し給えというべきか。","「呵呵，\n老实说对他我毫无感觉。[l]\n该说遗憾呢，还是该说请您放心呢。"],["まあ、場合によっては、\nこの先君の連れ合いになる可能性を考えて、\n僕も多少の肩入れをしてるだけ。[l]\nそれより今日の襲撃だが」","不过考虑到今后\n他可能成为你的伴侣，\n我也稍微推了一把。[l]\n比起这个，今天的袭击」"],["「はい」","「是」"],["「恐らく、だがね。[l]\n僕等の身内をころした者、\nかつ絶対禁忌者だと思う。","「恐怕，[l]\n杀害我们同伴的，\n就是绝对禁忌者。"],["但し、白の者か野良かまではわからない。[l]\n只言えるのは、原則的に野良の絶対禁忌者は考え難い、\nという事だ。","但无法确定是白之众还是无主之辈。[l]\n只能说原则上无主之辈的绝对禁忌者难以想象，\n如此而已。"],["まあ、精査は追ってするけれども、\nもし戦闘行為に入る事になったら重々気をつけて呉れ給え。[l]\n其奴からは──●相の強化も感じるからね」","详细调查会后续进行，\n若进入战斗状态请务必万分小心。[l]\n从那家伙身上——还能感受到●相的强化」"],["「●……●●」","「●……●●」"],["「まあ、十相中で言うところの●相、ということだね。[l]\n分かってるとは思うが。","「嗯，也就是十相中的●相吧。[l]\n我想你应该明白。"],["ねこが希少価値である現状では、\nその能力を存分に発揮できない●●君の猫と同様の相さ。","在猫具有稀缺价值的现状下，\n与无法充分发挥能力的●●君的猫是同种相。"],["ころされた人達の死因から考えて、\n恐らく其奴は」","从遇害者死因推断，\n恐怕那家伙」"],["「●●●●した」","「●●●●了」"],["「と考えるのが自然だねえ。[l]\nだから、気をつけて欲しいと言ったのさ。[l]\n実戦闘担当ばかり狙われたのもそういう事かな、という\n想像もつく」","「这样想才自然吧。[l]\n所以我才说要你小心。[l]\n实战组总是被盯上大概也是这个缘故——\n很容易联想到」"],["「克杖君の事もしっかり守ってあげて呉れ給えよ。[l]\nまあ狩屋の二番目に関しては……」","「可要好好保护克杖君啊。[l]\n至于狩屋家的二小姐嘛……」"],["「私も克杖も覚悟の上です」","「我和克杖都早有觉悟了」"],["「それが我々八相の鉄の掟、か……[l]\n冬夏君もそれが厭なのだろうがねえ」","「这就是我们八相的铁律吗……[l]\n冬夏君也很抗拒这个吧」"],["「冬夏さん……」","「冬夏小姐……」"],["「ま、現当主サマが当てにならないのもみんな思ってる事だ。[l]\nそもそもご先祖様からしてポテンシャルが低かったそうだからね。[l]\n元来『お飾り』なのだよ。","「嘛，现任当主靠不住是大家心照不宣的事。[l]\n听说从先祖那代开始资质就不怎么样。[l]\n本来就是『摆设』罢了。"],["しかしあの方の意志である以上、\nそしてあの方が健在である以上、致し方ない、ね。[l]\n第一位の君が憤慨するのも解るが……」","但既然是那位大人的意思，\n只要那位大人还在世，就只能认命了。[l]\n作为第一位的你会愤慨也很正常……」"],["「ワカっています」","「我明白」"],["「おっと、僕がこんな事言ってたことは秘密だよ？[l]\n嫌われるのは結構だが面倒ごとは……面倒だからね。[l]\n愉快であれば構わないけれども」","「啊呀，我刚才说的话要保密哦？[l]\n被讨厌无所谓，麻烦事还是……太麻烦了。[l]\n只要有趣就无所谓啦」"],["「分かっています」","「我知道」"],["「そろそろ休もうか。[l]\n明日も学校なのだろう？」","「该休息了。[l]\n明天还要上学吧？」"],["「そしてすぐ二連休ですけど」","「接着就是双休日了」"],["「ふむ。[l]\nまあ、これから色々大変になるだろうから、\n休める時には休んでおいた方が好いだろう。","「嗯。[l]\n接下来会变得很忙吧，\n能休息的时候还是多休息为好。"],["なんと言ったって君は特禁級常駐なのだしね。[l]\nそれに、狩屋の二番目の如何によっては」","毕竟你可是特禁级常驻体质。[l]\n而且也要看狩屋二小姐的情况」"],["「冬夏君も早く戻ってくれれば良いがねえ。","「冬夏君能早点回来就好了。"],["ま、\n万事なんとかなるさ。[l]\nそういうものなのだからね。","不过，\n船到桥头自然直。[l]\n世间之事本就如此。"],["──では僕はお先に失礼するよ。[l]\n姫様君お休み」","——那我就先告辞了。[l]\n姫様君晚安」"],["「おやすみなさい」","「晚安」"],["「アヤメ……あやめ……」","「阿娅梅……阿娅梅……」"]],"context":[["SC_E_026.ks/index/1/text"],["SC_E_026.ks/index/3/text"],["SC_E_026.ks/index/5/text","SC_E_026.ks/index/15/text","SC_E_026.ks/index/80/text","SC_E_026.ks/index/82/text","SC_E_026.ks/index/179/text","SC_E_026.ks/index/207/text"],["SC_E_026.ks/index/7/text"],["SC_E_026.ks/index/9/text"],["SC_E_026.ks/index/11/text"],["SC_E_026.ks/index/13/text"],["SC_E_026.ks/index/17/text"],["SC_E_026.ks/index/19/text"],["SC_E_026.ks/index/21/text"],["SC_E_026.ks/index/23/text"],["SC_E_026.ks/index/25/text"],["SC_E_026.ks/index/27/text"],["SC_E_026.ks/index/29/text"],["SC_E_026.ks/index/31/text"],["SC_E_026.ks/index/33/text"],["SC_E_026.ks/index/35/text"],["SC_E_026.ks/index/37/text"],["SC