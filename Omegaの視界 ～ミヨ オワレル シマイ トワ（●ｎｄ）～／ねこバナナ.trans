}],[{"start":23132,"end":23137}],[{"start":23167,"end":23211}],[{"start":23217,"end":23285}],[{"start":23291,"end":23326}],[{"start":23352,"end":23410}],[{"start":23418,"end":23450}],[{"start":23458,"end":23507}],[{"start":23537,"end":23615}],[{"start":23621,"end":23671}],[{"start":23677,"end":23717}],[{"start":23743,"end":23793}],[{"start":23825,"end":23859}],[{"start":23889,"end":23943}],[{"start":23949,"end":24004}],[{"start":24036,"end":24042}],[{"start":24105,"end":24113}],[{"start":24139,"end":24151}],[{"start":24183,"end":24231}],[{"start":24237,"end":24282}],[{"start":24308,"end":24317}],[{"start":24325,"end":24330}],[{"start":24338,"end":24361}],[{"start":24369,"end":24378}],[{"start":24441,"end":24482}],[{"start":24488,"end":24518}],[{"start":24544,"end":24548}],[{"start":24580,"end":24585}],[{"start":24595,"end":24596}],[{"start":24605,"end":24621}],[{"start":24681,"end":24717}],[{"start":24723,"end":24776}],[{"start":24802,"end":24828}],[{"start":24836,"end":24873}],[{"start":24881,"end":24936}],[{"start":24944,"end":24998}],[{"start":25028,"end":25053}],[{"start":25079,"end":25119}],[{"start":25127,"end":25137}],[{"start":25145,"end":25208}],[{"start":25216,"end":25281}],[{"start":25344,"end":25380}],[{"start":25419,"end":25497}],[{"start":25548,"end":25551}],[{"start":25559,"end":25562}],[{"start":25570,"end":25577}],[{"start":25607,"end":25632}],[{"start":25638,"end":25692}],[{"start":25724,"end":25740}],[{"start":25766,"end":25775}],[{"start":25783,"end":25797}],[{"start":25805,"end":25815}],[{"start":25823,"end":25825}],[{"start":25849,"end":25866}],[{"start":25874,"end":25881}],[{"start":25889,"end":25906}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_029zan.ks","basename":"SC_M_029zan.ks","indexIds":{"「えっ、\nどしたの？[l]\nだいじょうぶ？」":0,"一瞬上の空になっていた僕は、\nそれで正気に返った。":1,"「おあ、\nだ、な、その、\nごめん、大丈夫……、って[l]\nご、め、」":2,"信号赤やがなーー！":3,"急ブレーキを踏み込む、\nしかし！":4,"「ん、あ、おっっっと！！」":5,"気を遣ったつもりだが、\n流石に二人とも、がっくんと前のめりになるのは不可避。":6,"「わぁお－、\n":7,"吃":8,"驚したよぉー、[l]\n":9,"ちょーっと、ねえ、怖かったんですけど？」":10,"マニュアル車みたいに速攻でエンストこそしなかったものの、\n一瞬テンパって操作が混乱する。":11,"「ご、ごめんなさいすみません、\nえーーーーっ、ギヤを一速、じゃなくて…」":12,"冬夏は──\nそんなこちらを視て、\n取り敢えずあははと笑ってる。":13,"……顔は引き":14,"攣ってないので、[l]\n所謂乾いた笑い、という訳ではないようだ。[l]\n肝が据わってるというか何というか…":15,"「落ち着こ落ち着こ、あはははっ。[l]\n私はシートベルトがちょっと食い込んだだけだし。":16,"にしても、\n":17,"他に車いなくて良かったね。[l]\n危うく大惨事に……」":18,"あれ、そう言えば、":19,"………。":20,"わたくしめ、\n午前中にも殆ど同じ事をしたような気がしますが……":21,"「やばいやばいやばい、\nどうもいかんなどうもいかんな……[l]\n集中集中運転に！」":22,"「そうだねぇ、\n幾らほら、ね、":23,"可憐な乙女とのドライブとは言っても？[l]\n":24,"事故っちゃったら元も子もないんだし？」":25,"「ほ、ほんっと済みません……[l]\n反省しとります──\nえ、えーと此処でいいんかな？」":26,"右折車線の先には、\n道の駅の建物と広い駐車場がある。":27,"「そそ、そこー」":28,"「了解、入りまっせぇー」":29,"「っははは……」":30,"心臓のドキドキはそのままテンションアップとなり、\nおかしなノリになる僕。":31,"完全に苦笑というか、冷笑されとるけど……":32,"「どこに停め……ても構わないか、な？」":33,"「？[l]\nん、いいよー」":34,"宮さんとかを乗せてる時は、\n店の入り口に近い方が好いとか、\n寧ろ遠い方が好いとか、":35,"体調（…体重？）を慮ってか色々注文がついたものだったので、[l]\n一応訊いてみたのだ。":36,"こっちとしては勿論、\n周囲の駐車状況とか、入れ易さ出易さを考慮する訳だが、\nまあ世の中の大半は基本歩く距離を少しでも短くさせたいらしく、":37,"おおよそ入り口近くは混雑してたものよ。[l]\n最悪、店の入り口横付けとか居たし……":38,"「いや、なんかプロポーションに気を遣ってるんじゃ\nなかったっけ？[l]\nとか思ってさ」":39,"「……それは母様が勝手に言ってる話ね」":40,"「ああ、そういやそんなんだっけ……」":41,"確執丸出しの口調になる冬夏。":42,"そっちの話題は、矢張り根が深いのかー。":43,"兎に角、一旦深く呼吸をし、\nこっちも何とか平静さを取り戻した。":44,"適当に空いてるところ……":45,"──ほぼカラなので、\n隣に後から車がこなさそうな位には\n外れの方に車を入れる。":46,"「にしてもさっきはどうしたの？[l]\nやっぱり疲れてたとこ無理させたのかな私？」":47,"「や、それは大丈夫、\nただその……」":48,"道の駅自体には、\n恐らく僕が玄ノ森を出てから作られたからなのか、\n全く見覚えが無いが、":49,"道すがら視えた海辺の景色は、\n完全に既知のものとして頭が認識している。":50,"「……昔、小さい頃僕この辺に──居たことがあるっぽいことは知ってるよね？」":51,"「あ、きぃがなんかそれっぽいコト言ってたかも」":52,"そう、\n結局最初に彼奴──きぃに会ったときも、\n僕が此処の出身かどうかは曖昧にしてたような、\n気がする。":53,"なし崩し的にというか、\nきぃが僕を幼少期に遊んだ二個上の知り合いだと\n半ば強引に断定した御陰で、":54,"少なくとも滞在した経験アリ、という\n感じには認識されたのだが、":55,"如何に僕が空転脳の持ち主とは言え、\nきぃの自己申告のみが論拠であるその\n『我々の過去』は、\nあまりに薄弱過ぎないか？":56,"今に始まった疑問では無い筈だが、\n無意識的に意識しないようにしてきたのか、":57,"たまさかあの時は、\n調査に都合が良かったのもあって状況を\n受け入れたのだが、":58,"未だ確証は、無い……のだ。":59,"無闇に疑うことは不安を生じさせる。[l]\nそれは防衛本能ではあるが、\n何でもかんでも疑心暗鬼的に疑うにしても\nそれはそれで根拠が弱い。":60,"午前中に道具さんから、\n彼女ときぃとの関係については聞いたのだけれど、\n……そもそもあの人が何処まで本当の事を語ってるのか[l]\n分からない以上、":61,"いや、それこそ疑心暗鬼というものなのか……[l]\nしかし、":62,"大体、きぃが僕を":63,"謀って何の得が。":64,"……あるのか？[l]\nだとしてもどういう、":65,"「よっ」":66,"「のわ！」":67,"急に眼前に冬夏の顔が割り込んだ。":68,"「話も途中でエンジンも切らないで、\nさっきのまだ気にしてる？[l]\n":69,"あんまり悩むと逆に危ないよ？」":70,"「あうあ、すみません…」":71,"しょうがない、今は忘れよう。[l]\n……そのまま忘れ去りそうだけど、[l]\n仮にも人命預かってる訳だし。":72,"「やっぱなんか上の空よね。[l]\n":73,"ほんとに大丈夫なのかな？[l]\n":74,"ちょっと休んですぐ帰っちゃう？」":75,"「いや、ごめん大丈夫。[l]\n朝がちょっとだけ早かっただけで、\nあとで腹に何か入れれば…あとは[l]\n少し歩いて風に当たれば何とか」":76,"「ほんと？[l]\n昼寝とかしなくて大丈夫ー？[l]\n":77,"また膝枕したげるよ？[l]\n":78,"ついでに耳掃除もしたげるよ？」":79,"「今回は丁重にお断りさせて頂きます……[l]\nというか何の話してたんだっけ」":80,"言ってる側から脳は空転してるみたいだなあ。":81,"「此処知ってるーとかの話しようとしてたんじゃない？[l]\n小さい頃来たとかなんとか」":82,"「ああ、そうだった。[l]\n僕ぁ記憶力には全く自信がないんだけど、\nどうも此処は──」":83,"みにおぼえが。":84,"「子供の頃にこの辺りに滞在してた事も考えると、\n可能性は高いかも。":85,"碁石松原って名前には聞き覚えないけど、\nまあ子供の頃に聞いてたとしてもそんな固有名詞まではね……[l]\n学校あがる前の話だし」":86,"「ほほー」":87,"と、顎に手を当て考え込む冬夏。":88,"「学校あがる前っていうと、\n６、７歳くらい」":89,"「え？[l]\nああ、そう……かな。[l]\nまあ、直前だとすればだけど」":90,"「今真言さん二個上だよね」":91,"「？[l]\nそのはずだけど」":92,"や、今も昔もこれからも、\n二個上という歳の差は変わらんのだけれども。":93,"「ふーん……」":94,"「なぞした？」":95,"「え？[l]\n":96,"なーんでも。[l]\n":97,"おっと」":98,"シートベルトを外す冬夏。":99,"「いい加減降りよっか」":100,"「うん、\nあっ、\n取り敢えずまずエンジン切らにゃー」":101,"どるるるん。":102,"──静かになった。":103,"「うーん」":104,"「あれ、行かないの？」":105,"「さっき私、\nある人との思い出の場所って言ったじゃない？」":106,"「？[l]\n言ってたねえ」":107,"「ある人って言っても、\nその、素敵な男子ーっ、ていうより、\nちっさな男の子なんだよね」":108,"……ほう。":109,"「真言さんじゃないけど、本当は私も小さい頃の事\nあんまり覚えてないのね。":110,"ただ、\nあんまり母様が連れ出してくれなかったからこういう所。[l]\n逆に行ったときのことはよっく覚えてるんだけど」":111,"「あの時も確かね、\n西國の──知り合いのね、ドウトモさんって人に\n連れられて……どうだっけな…他に何人かと、":112,"まあ、何か私が我が儘言ってた様な気も、\nそれにも理由があった気もするけどそこまではね」":113,"「うむ……」":114,"「でね、\nその子の事、\nいーちゃん……って呼んでたんだけど、[l]\n今にして思えば名前なのか名字なのか……":115,"お互いちっちゃかったし、こっちも気にしてなかったし」":116,"──いーちゃん？":117,"おい、まさか。":118,"……そんな偶然が。":119,"てっきり、屋上で浮かんだ海岸の情景、\nそれが過去の記憶だと……つまり、[l]\nきぃだと思っていたのに、":120,"あ、そう言えば、":121,"と冬夏が思い出したように言った。":122,"「今更なんだけど、\n真言さんの名字って何？[l]\n聞いてなかったよね」":123,"うっ。":124,"きぃにも伏せていた、\n飯窪の姓。":125,"今ここで隠すのも変だし、\n実際珍しい名字ではないから知狡さん達との関連を\n訊かれても偶然で済ませられるかも知れないが、":126,"「……うひひ、[l]\nヒ・ミ・ツ♪」":127,"謎多き男子としてノリで隠し通す事にしました。":128,"「へぁっ……」":129,"かなり珍妙な脱力声を出す彼女。[l]\n……そらそうよね。":130,"「いやまあ、ただですね。[l]\nいーくんとは呼ばれたりもするよ、\n友達には。":131,"──後はそこから適当に想像してくれ給え、\nあはははははは」":132,"色んな意味で気が引けたので、\n取り敢えずそこまでは言ってみる。[l]\n嘘もついてないし？":133,"「何それ？[l]\n":134,"でも、そう、そう呼ばれてる事もあるんだね──？」":135,"じゃあ可能性としてはある訳ね。":136,"と、つぶやいた──\nように聞こえた。":137,"「まあ、\n僕がその男子だとお話としてキレイだけどなぁ。[l]\n偶然再会した幼なじみの男女、\nキレイってかベタもいいとこだけんどもさぁ」":138,"「ん？[l]\n":139,"いいじゃんベタでも。[l]\n王道ってことはみんなが好きだからでしょ。":140,"あれ、それとも、\n……話合わせてるとか？[l]\nんっ、それってつまり、」":141,"何やらくねくねし出す冬夏。":142,"「つまりこれは運命とかって言って、\n口説いてる？[l]\nそうなら、\n":143,"──ノってあげてもいいけど」":144,"キラッ☆\nとでも擬音の付きそうな、\n変なウインク＆手振りで流し眼を送っております。":145,"「──。[l]\nえー、\nあー、\n毎度のことだけども、":146,"こういった場合どうレスしても、その、[l]\n何かしら問題ある気が……」":147,"大体、\nユーとアイしか居ない状況で言うおふざけではないよね、\nというか、第三者が居てこそ茶化しようもある訳で……":148,"宮さんとの付き合いの中でもこの辺りのスキルは\nアップしてないな……":149,"うーむ、単にあのひと個人の言動に馴れただけで、\n別の女子に応用を利かせられる訳じゃなかったか。":150,"冬夏はと言えば、\n素に戻って──半分照れ隠しなんだろうけど、":151,"「その辺はまー、\n社交辞令でもイエスって言うのが\n男子の甲斐性ってヤツじゃない？[l]\nそれともさっきの上司さんに遠慮してるのかなぁ？":152,"ん？どうなのですかのう、ほれほれ」":153,"と言う。":154,"「や、あのひとぁ関係ないですよ……[l]\nそれに社交辞令ったってな、\n僕あたりが言ったってマジキモイとか\n言われるのがオチだと思ってさ。":155,"遠慮したんだよこっちは」":156,"「えーなによそれ、\nキモイと思ってるひとに膝枕なんか\nするわけないでしょー？":157,"二人っきりのドライブにも、\nこうやって誘ってるんだから。[l]\n少しは自信持ちなさい」":158,"「ははは……[l]\nまあ、ね、\nそうだったらいいけど……」":159,"その辺は宮さんに釘を刺されたからねえ。":160,"どっちが正しいというでもなく、\nケースバイケース、\n個々の場合による事柄で、\n正解なんか無いんだろうけど……":161,"ま、でもその枯れっ振りが真言さんよね、":162,"と言って冬夏は腕を組んだ。":163,"あ、いやいや、僕とではなく、\n一人で腕組みをした、という事で。":164,"「でもたまには押しも強くなきゃねー。[l]\nその辺のバランスはやっぱ求められるかな。":165,"めんどいよぉー女子を相手にするのって。[l]\n女子同士だってめんどくさいのにさ、\n色恋沙汰と来た日にゃあ」":166,"女子の会話ってほんとに『被せ合い』で、\n全然咬み合ってない感じなのにお構いなしで\n進んでくもんな。":167,"それはちと違うんかな。":168,"「その辺はよっくわかってるつもりだけど……":169,"それにアナタだって、\nその少年にその、\n恋慕してた訳じゃないの？[l]\nその彼に対して遠慮はないのかね」":170,"「おや？[l]\n私は思い出の場所とは言ったけど、\n恋心を寄せていたとは一言も？」":171,"「え゛っ。[l]\nありゃ、そうだっけ？」":172,"思わず狼狽えてしまう僕。":173,"「や、だってそう思うさあの流れではよ。[l]\nな、なーんだ違うのか、」":174,"「あれ、言ってないだけで、\n実はそうかも知れないという可能性は\n捨てるんだ？":175,"それに、\nほんとに……さんだったかも知れないし──」":176,"「？」":177,"「──や、いいや。[l]\nなんでもない。[l]\n":178,"なぁんでもなぁいよぉ～」":179,"「あ、そう……」":180,"色々考慮の上、追求は止しておいた。":181,"……やっぱり、[l]\nどうもテンションが高いよな。[l]\n何というか、酔ってる感じに近いというか。":182,"少しの間会ってなかったからそう感じるだけで、\n元からこんなものだっけか？[l]\n最後に視たのがあの式だったし、\nちと荘厳さでイメージ補填されてたのかも。":183,"ともあれ、そんな会話し続けるのも不毛、\nというか初期の目的と違うんで。[l]\n僕は、しっぱなしだったシートベルトを外し、\n二人で車を降りた。":184,"施錠施錠……と。":185,"見渡すまでもなく、\n殆ど駐車中の車は無い。":186,"冬夏達の高校が休みとて、\n完全に平日の昼下がりである。":187,"ショッピングモールとかならいざ知らず、\n単なる東部北部の観光地──しかも海岸、オフシーズンもいい所、\nであるこの碁石松原、":188,"道の駅の売店には、たむろするお年寄り達が視えはするものの、\n基本的には閑散としている。":189,"そう言うと、":190,"「んー、ま、私もよく知らないけど、\n基本的に海水浴場って訳でもないし。":191,"純粋に景観っていうの？[l]\nそういうので有名みたい。[l]\nだから、」":192,"年中ヒトは":193,"疎らなんだと。":194,"まあ……そんなもんよね。":195,"「もしかしたらなんかお土産で良いのあるかもだけど。[l]\nあんまり期待出来ないかなぁ。[l]\n例の土産屋も家の関連だけど、\nなんか変なお菓子を最近新作作ってたくらいで」":196,"ああ、あれか……[l]\n旨いは旨いけどね。":197,"「僕もよく旅行するからその辺は承知してるけど、\n道の駅とかだと……地元産の野菜とかがメインていう印象が……[l]\nあ、この辺だと海産物とか？[l]\n余計に食指が動かんけど……」":198,"あとは地域限定なんたらと言いつつ、\nそのそもそもがとある地域の特産物ネタだったはずの、\n本末転倒になってるキャラものストラップとかあるんだぜ。":199,"「あれ、海産だめなんだっけ。[l]\n前聞いたっけ？」":200,"「言ったような言わないような、\nうーん、\n別の人に言ったんだったかもうそれすらも」":201,"「あっははは、\n惚け同志コンビやばいね」":202,"「…忘れるくらいだからたいした事じゃないとかね……[l]\nま、厭な事ずっと覚えてて夜思い出しては呻くよりはマシだよ。[l]\nあははは……」":203,"「あははは」":204,"寝れば大体リセットされるんだ、と言うと、\n冬夏もそうそうそうそうそうよねーーと、\nすごい勢いで同意してきた。[l]\nそうなんか。":205,"「でも……顔付き合わせる相手が原因だと[l]\n中々そうも行かないのがね……」":206,"「うーん……」":207,"としか言えない。":208,"「ほら、ゆえに旅館に来たので！[l]\nいいストレス解消相手も居ることだし？[l]\nだいじょぶだよ」":209,"「おほほほ……[l]\nぷちぷちでも買って帰ろうか」":210,"「ああ、あれ。[l]\nいやいや、もっといいのがありますからぁ、\nあっははははは」":211,"あうあ。[l]\n──ああ、もう、\n宮さん変な対抗意識燃やさなけりゃいいけど……":212,"「ほら、いきましょいきましょ」":213,"矢鱈と高い堤防の切れ目を抜けると、\n松原というだけあって、\n駐車場から海岸までは防砂林エリアが設けられている。[l]\nその中を走る遊歩道を、二人して海岸へと向かい歩いていく。":214,"「うちの辺りは山だけど、\nこの辺海岸がこう入り組んでるじゃない？[l]\nそうリアス式海岸ってやつね。[l]\nだから昔結構おっきな津波がきたことあるらしくて」":215,"「へえ」":216,"「学校でも避難訓練毎年きっちりやるよ。[l]\n地震のも津波のも。[l]\nなんかどっかに体験館とかみたいな施設あったはず」":217,"「そうなんだ？」":218,"学校に上がってからの暮らしは殆ど中央なので、\nあまりそういう感覚は無かったなあ。[l]\n……まあ、[l]\nそもそも記憶があやふやなのはあれとしてですよ。":219,"「あー、潮の香りがするぅー」":220,"言われると途端に嗅覚が鋭敏になった気がして──":221,"「確かに、波の音もする……おあっ」":222,"林を抜けた。":223,"眼前に広がる景色、":224,"確かにこれは、":225,"視たことがある風景だった。":226,"「……ってる、[l]\nやっぱり知ってるなぁ。[l]\nうーん」":227,"「どうしたの？[l]\n何か疑問でもある？」":228,"──考えてみれば、\n幼少期僕は玄ノ森に居たのだから、":229,"現在の僕の記憶力がアレなだけで、\n『此処』を知っていた事自体は格別不思議では\nないのだけれど、":230,"「いや、まあ、\n……不自然事じゃないんだよな別に。[l]\nでも」":231,"何故か先刻はそれが、\n重大な事に思えてしょうがなかったのであった。":232,"実際、\nもしかすると冬夏の知る少年が僕である可能性もある、":233,"しかし、それは、\nきぃとの記憶が怪しくなるという事でもある。":234,"一体どちらが、或いはどちらも、\nそれとも──":235,"すなのしろ──？":236,"しろのしろ──？":237,"「いきましょっ」":238,"何時までもぼーっとしてる僕に、\n呆れたのか気を遣ってくれたのか。":239,"突然冬夏が僕の手首を掴んで、":240,"「やーな事はっ！[l]\n":241,"全部水に流すの！！[l]\n":242,"このおっきなぁ、」":243,"「うわあ」":244,"引っ張られる。[l]\n二人して":245,"蹌":246,"踉けながら砂浜を走り、\nそのまま、\n波打ち際に向けて──":247,"「うぅーみぃーにぃーーーーーーっ！！！！！」":248,"僕を押し出した……っておい！！":249,"「でぇああーーーー？！」":250,"ざしゅ。":251,"「あぶなーーーー！！！！」":252,"間一髪、\nてほどのものでもなかったが、\n単純に":253,"驚しましたよ？！":254,"幾ら僕が非肉体系とは言え、\n流石に女子の力では水中に突き落とすまでは\n行かなかったようだ。":255,"が、\n水没こそしなかったけれど、":256,"「ごめん大丈夫？[l]\nころんじゃったねあはは」":257,"「謝るならしなさんな……よっと」":258,"手と足はすっかり砂……泥まみれに[l]\nなってしまった。":259,"「まま、それも含めて水に流そうか！」":260,"「どんな理屈じゃい」":261,"立ち上がりつつするツッコミも、\n眼前の景色に緩衝されて、\nなんかどうでもよくなる。":262,"二人して濡れない所まで移動して、\n改めて海を向く。":263,"うーん、":264,"判ってた事だが、":265,"「………」":266,"──だっっっっれも居らんがな。":267,"秋冬では無いから陽射しはぬるいし、\n色彩的にも彩度はあるんだけども、\nなんか寒々しい雰囲気ではある。[l]\n単に手足の泥の所為かも知れないが。":268,"「にしても、\nわぁお人居ないねぇこれ。[l]\n貸し切り？[l]\nプライベートビーチ的な？」":269,"……まあ、なんというか、[l]\n砂浜と言えばこれ！な感じの藻屑か何かが、[l]\n一昨日の嵐の所為か波打ち際にびっしり\n流れ着いてるので、":270,"そういうセレブリティな雰囲気には":271,"浸れないけど……":272,"ともあれ黙って潮風に身を委ねてみる。":273,"ざぁ……":274,"さぁ……":275,"道路からも離れてるので、\n波の音だけがやけに耳に響く。":276,"「うん、よし！！[l]\n":277,"海だよ！[l]\n":278,"海だ海だぁぁぁっ！！」":279,"突然、\n静寂を打ち破る雄叫びと共に、\n冬夏は靴と長靴下……ニーソとか言ったか、[l]\nをもどかしそうに脱ぐと、":280,"「いってくる！！」":281,"「へ！！？[l]\nどこに！！ってえ、ちょっと！！」":282,"先刻僕が突き飛ばされた地点を完全に越えて、":283,"ばしゃしゃしゃしゃ！":284,"「ひぁっ！？[l]\nつ、つめたいっ！！[l]\nあはっ、あはははははははっ！！[l]\nひーーーんひゃっこいってばこれはっ！！」":285,"波打ち際というの？[l]\nまあ、完全にあれは、\n水に入っちゃってますよね。":286,"や、裸足になった時点でよもやと思ったけども、\nまだ四月でしょう？[l]\nこの辺じゃまだ……ていうか、[l]\n冷たい自覚はあるのか。":287,"ああああ、ひゃっこいひゃっこい言いながら、\nえらい勢いで足踏みまで……":288,"「あんよー、タオルとか持ってきてないやんな……」":289,"思わず謎の方言の遣い手となる僕。[l]\n風邪とか引かないといいけど……":290,"「あーーーもうテンション上がったぁっ！！[l]\nあ、がっ、た、よっ──と！！」":291,"ばさ！":292,"何の躊躇もなく、\n彼女はワンピースの裾をたくし上げた。":293,"眼を逸らす間もあればこそ、":294,"「えっ！！あっっ？？[l]\nちょ！！」":295,"冬夏はあっと言う間に腰の部分で長い裾部分を結び、\nつまり":296,"御":297,"足をほぼ全露出と言いましょうか、\nいや、その。":298,"「ふぁあああ、さぶい！！[l]\nさぶいよこれ、すっごいさぶいぃーー！！」":299,"「お、ちょ、し、心臓に悪いことを……」":300,"……こっちのですがね。":301,"「さぶいならしなきゃよろしいでしょ……」":302,"それでも兎に角笑いながら、更に深い所に\nばっしゃばしゃ歩いていく。":303,"流石に、何の対策も無くそんな行為をする訳はなくて、\n彼女は下に、所謂ぶるまーを着用してたのでした。":304,"午前に狩屋のも視てるんですが……[l]\n今日ってそういう日？[l]\n何の日よ。[l]\nえ、昨今の女子て、デフォルトで穿いてるの？":305,"大神や宮さんから流れ来る情報によりますれば、\nその着こなし（？）にかえって通常の下着よりエロスを感じる御仁も結構居られるという噂。":306,"まあ、水着も下着も、文化的":307,"約":308,"款がなけりゃ一緒だもんね。[l]\nその約束事という背景込みでどうこうするのが、\nモエるんだとかなんとか……":309,"いやそんなことはどうでもいいが、\nそれ以前に、\n今日は会ったときからずっとテンション激高だと思います。":310,"それとも更に限界突破したのか。":311,"「誰も居ないとは言え大胆だなぁ……」":312,"と呟くと、耳聡く聞きつけたのか":313,"将":314,"又偶然か、\n身体ごとこっちに向き直り、":315,"「さっきのお詫びーーーっ、\nサービスでーーーーす」":316,"と言った。":317,"「あ、そうなんだ……」":318,"だからといって繁々と直視なんか出来ません。[l]\nなまじ上半身が隠されてる分、\n余計にこう露出してるあれがその、\n──ああ、これぞギャップ萌えというやつ？":319,"違う、チラリズム？[l]\n……それこそどーでもええねん。":320,"にしても、\n何というか、\n女子のストレスの発散法はよくわからんなあ。[l]\nストレスのかかり方がそもそも違うのか。":321,"それとも僕が勝手に思ってるだけで、\n性差とかは無関係な個人差なのか。":322,"「真言さぁーんっ」":323,"「うっ、にゃ、にゃんだね？」":324,"「ほれ。ほれほれ」":325,"にやりとしたまま手招きする冬夏。[l]\nや、やっぱりそうなるか。":326,"「まじかよ……いや、そんなに捲れないスよ[l]\nジーンズでは」":327,"脱ぐわけにもいかんし……":328,"冬夏を視ると、\n……こっちの意向を知ってか知らずか、[l]\nうんうんと、頷きながら手招き。":329,"仕方ないので、\n何とか膝上くらいに無理矢理まくり上げて、\n冬夏に近づきつつ水に入った。":330,"「！！！！！！[l]\nっここここここれはおいあなた！！！」":331,"冷てぇぇええええ！！！！！！":332,"「だいじょぶ、最初だけだよ、\n私もう馴れた！」":333,"いやいやいやいや、\nまあそうかも知れんけども！！！":334,"「かけていい？[l]\nねえかけちゃっていい？」":335,"いやいやいやいや！！":336,"「せぇのぉ……」":337,"両手を水面に差し入れる冬夏。[l]\nいやいやいやいや！！[l]\nいやいやいやいやいやいやいやいや！！":338,"「やんないよ。[l]\nあっははははは！！[l]\nすっごい顔してたよ！」":339,"「………あうあ」":340,"あのねえ……[l]\nよし、\n流石にここいらで、こちらも反撃させて貰うぜよ。":341,"「ひぁうっ！？」":342,"太ももめがけて水をかけてやりました奥さん！":343,"「つめた！！[l]\n変なとこ狙ってるし！」":344,"え゛っ。":345,"「いやいや、だって他は狙えんでしょうよ」":346,"「ん？[l]\nそうだね。[l]\nちょっと待って、\n髪まとめるから」":347,"う、本気モード？":348,"「さ、遠慮無くどーぞ、\nその代わり──覚悟してねっ」":349,"「え、あ、いや、それはない！！！」":350,"「そぉれっ！」":351,"今度は本気だ！！":352,"ごばしゃっ！！！！":353,"「──！！」":354,"思わず顔を背けた僕の、":355,"……すぐ隣に盛大に水飛沫が舞った。":356,"「ないよねそれは！！[l]\nうん、ないない！！」":357,"「──おぉーういぃー……」":358,"つ、疲れる。":359,"と、ばっしゃばっしゃとこっちに近づいてくる。":360,"「………えへへ」":361,"？":362,"すぐ眼の前に立ち止まり、\nこちらを視る冬夏。":363,"数秒そのままの姿勢でいたが、":364,"「いいや、やめとこ。[l]\n流石に二回は恥ずかしい」":365,"と陸へと歩いていった。":366,"何なんでしょう。":367,"てかもう水から上がるのね。[l]\nよかったよかった……[l]\n僕も引く潮の、あの妙な抵抗感を足に感じつつ、\n陸へ上がった。":368,"「はぁ～、\nだいぶすっきりしたっ。[l]\nおつかれでした～ありがとうございます～」":369,"深々と頭を下げられた。":370,"「まあ、僕は特に何もしてなかった気もするけど、\nなによりです」":371,"……本気の無茶されなくてほんとに良かったよ。":372,"来たいって言うから海に来たとはいえ、\n冬夏自身、\n水に入るようながっつり準備をしてなかったのは\nまあ、視れば判るので。":373,"タオルは勿論のこと、\n当然":374,"乍らレジャーシートみたいに上品な物はなく、\n防砂林の中の遊歩道にあった簡易ベンチみたいなものに\n二人して落ち着いていたのであった。":375,"「それより、お互い風邪引かなきゃいいけどね…」":376,"足を乾かしつつ砂を落としてたりしてると、":377,"「ねえ真言さん聞いてくれる？」":378,"「？[l]\nなんだべさ」":379,"また愚痴ですかしらん。":380,"「私の此処での思い出。[l]\n具体的に聞きたくない？」":381,"「別にいいですって言ったって喋るんじゃ……」":382,"「うん。[l]\nあははは」":383,"今更だが、\n今日はよく笑うなあ。":384,"当然と言えば当然だが、\n逆説的に、何か余程厭な事があったのだろうという\n推測も出来るのが痛々しい。":385,"あの式のことも一切触れないし……[l]\nそれに関してはこっちとしても幸いではあるが、\n何にせよ家出をしてくる程の何かがあったのは\n確かな訳で。":386,"しかし、\nだからといって憐れんでみせるのも違うと思ったので、\n一緒になって笑っていた。":387,"「ま、聞いてよ聞いてよ。[l]\n先刻言った通り子供の頃のこと、\nあんまり覚えてないんだけど、\n３っつか５つか、そんな感じだったと思う。":388,"学校行ってない頃なのは確か。[l]\nそれでね」":389,"ふぉう。":390,"木立を抜ける海風が彼女の髪を揺らす。":391,"「母様が珍しく外に連れ出してくれたからって事もあるけど…[l]\nあ、あの時は道具さんがだったかな……[l]\nまま、そういう":392,"細いとこは覚えてないの。":393,"ただね、\nあの日あの時の事は、\nすごい印象的なシチュエーションだったから、\nその『印象』だけは残ってる。":394,"何してたとか、具体的な事はやっぱりね、\nすっごい曖昧なんだけど」":395,"道具さんと私と、\n先刻言った少しだけ年上の男の子、\nあと……姫様も。":396,"「姫様ちゃんも？」":397,"……もし其処にいた少年が僕ならば、[l]\n姫様ちゃんとも会っていた事になるが……":398,"──うーん、姿形が変化してないならまだしも、\n子供の頃だろ……[l]\n会ってるとしても、":399,"──私の事わかりませんか。":400,"いや、わから、な、い……":401,"それにあれはそういう意味ではない、\n気がする……":402,"ああそういえば、今度会わなきゃいけないのだった、":403,"と、冬夏が若干不機嫌そうにしてるのが目に入りました。":404,"「や、うん、それで？」":405,"「……ん。[l]\nまあ、それはどうでもいいんだ。[l]\nそれよりも、」":406,"その場にはもうひとり、":407,"「なんだろ…[l]\nすっごい不思議なひとがいたんだよね、\nその時は何とも思わなかったけど、\n今にして思えば──":408,"かなり変、いや怪しさ大炸裂だったかも」":409,"「ほう？」":410,"「兎に角、まずこの國のヒトじゃなかったのね。[l]\n私のみため、こんなじゃない？":411,"だからこう、逆に私は親近感持ったっていうか、\n他の人達は知らないけど、\n道具さんもその時は止めに入ったりしてなかったな。":412,"相当変な人だから当てにならないけど。[l]\nあ、知らないよね」":413,"うーん、それは身を以て知ってるんだよねえ。[l]\nしかし云わずにおくざますよ。[l]\n色んな意味で！":414,"しかし、\n外つ國のヒトが？[l]\nこの玄ノ森に？":415,"観光地としては……まあ、例の祭に来た、のかな。[l]\n海岸にはたまたま足を伸ばしてたとか。":416,"「で、何が変って、\n言葉はばりばりこの國の言葉喋ってたんだぁ。[l]\n子供心にだから同類と思ったからかな、\n警戒心も緩んじゃってて。":417,"ほんとはそんなじゃ駄目なんだろうけど。[l]\nでも実際、別に変なことされた訳じゃないけどね。":418,"名前とか全然覚えてないけど、\n遊んで貰ったん……遊びかなあれは？うーん」":419,"首を傾げる冬夏。[l]\n個人的にはその流暢にこの國の言葉を喋る方に\n首を傾げたいが、":420,"「まあそんなに精密じゃなくても……[l]\nニュアンスで大体」":421,"「あそう、ごめんね。[l]\nでねでね、その時にね、\n例の男の子も一緒になって遊んだんだけど、":422,"その日だか次の日だか、\n引っ越しちゃうって言ってて。[l]\n別れ際に、ある約束をしたのでした」":423,"「……うん」":424,"「何だと思う？」":425,"……そういう質問いるー？":426,"「……。[l]\nさっきみたいななあ、\nあんまりベタい答えはしたくないんだけども、":427,"まあ、そうねえ、\nよくあるパターンとしては、\n──大きくなったらけっこ…」":428,"と、冬夏を視ると、":429,"にやけた、":430,"こっちを凝視するキラキラさせた瞳と眼があって、":431,"一呼吸の間の後──":432,"「っはははは！！[l]\nやっぱ秘密！！[l]\nヒ・ミ・ツぅっ！！！":433,"あとは想像してくれたまえ！[l]\nあっはははは！！」":434,"大爆笑。":435,"「……え、":436,"先":437,"刻の仕返しなんですかこれ……？」":438,"「てかなんだかんだいって、\n究極のベタしか思いつかないじゃない？":439,"可愛いなあーと思って。[l]\nあは、ははは、ごめ、\n笑い過ぎちゃった、お腹痛い、痛いよお」":440,"ひーん、\nと、とうとう涙まで流している冬夏。":441,"まあつられて笑ってはいるけれども、\n基本こちとら置いてけ堀ですよ。":442,"それに、\nベタい答えしたくはないけど、という前振りしたって事は\n逆説的に答えはベタなんだって。":443,"…というかどうだろう、厭な事あろうとなかろうと、[l]\n僕ぁこうやって弄られるってことなんですかね。":444,"「……くっ、くくっ、[l]\nくふふふふふ」":445,"耐えようとしては臨界突破を繰り返してるので、\nしばらく放置する事にする。":446,"そんなにツボかいー？":447,"いやそれより、\n今までの話を鑑みるに、\n冬夏の言う男の子が僕である可能性は、\n……まだ何とも言えない。":448,"僕の方の記憶がこういまいち、\n場所に対しての認識はあるのだが、\nこう、決め手になる情報というかとっかかりというか、":449,"「ま、約束のことは追い追いね。[l]\nそれよりその時の思い出ね、":450,"えーとね、\nそのひとがなんかへんな人形…縫いぐるみ？[l]\nみたいなのをもってて、\n砂でお城、お墓？だったかな、難しいコトバで──」":451,"すな？":452,"しろ？":453,"それはしろの、":454,"「──たし達で、\nシロノシロをつくったの、":455,"今思えば、\nあはは、\nもしも……なら、[l]\nそれが初めての共同作業になるのかなあ」":456,"「共同作業ってなんですのよ……」":457,"いや、それよりも、":458,"──しろのしろをつくろうか。":459,"──このねこのための":460,"あ、":461,"冬夏の声はずっと聞こえてたけれど、":462,"それとは別の、":463,"ああ、こういう時は決まって首が──":464},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_029zan.ks","relPath":"/data/scenario/SC_M_029zan.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":460,"length":465,"percent":98.9247311827957},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[149,1]},"/data/scenario/SC_M_030.ks":{"data":[["「……眼、覚めた？」","「……醒了吗？」"],["「んが？」","「嗯嘎？」"],["眼の前に冬夏の顔があって、\n後頭部には……","眼前是冬夏的脸，\n后脑勺则……"],["あれ、","哎呀、"],["また膝枕されとる。","又被膝枕了呢。"],["いやでもなんで？","不对为啥会这样？"],["──およ？","──哎哟？"],["はい？","喂？"],["ここはだれわたしはどこ？","这是哪儿我是谁？"],["ちがう。","不对。"],["がばりと半身を起こす。","猛地支起上半身。"],["「寝てた？ほんとに！？[l]\n僕が？！！[l]\nうっそ！！！」","「我睡着了？真的！？[l]\n我？！！[l]\n骗人的吧！！！」"],["「ごめんね、\nやっぱり疲れてたんだね。[l]\n無理させちゃったみたいで」","「对不起，\n果然还是太累了吧。[l]\n好像让你勉强自己了」"],["いや、ちがう、\nそんなじゃない、\nそういう問題じゃない、","不，不是的，\n不是那样，\n不是那种问题，"],["というか、","应该说，"],["「いつどのタイミングで落ちたの？[l]\n全く記憶にない……」","「具体什么时候睡着的？[l]\n完全没印象……」"],["「えっとね、\n私が思い出話してる途中かな。[l]\n砂の城と作ったりとかしたっていう」","「那个啊，\n大概是我在讲往事的时候吧。[l]\n说是一起堆过沙堡什么的」"],["あれ、\nそれはなんか覚えがあるな。","啊咧，\n那段好像有点印象。"],["「そうか、夢、みてたのか……」","「这样啊，原来是做梦了……」"],["夢みる程にマジ寝してしまうとは、\nそんなに疲弊してた自覚はないんだけどなあ。","居然能睡到做梦的程度，\n但我不记得自己有那么精疲力尽啊。"],["「あれでも、\nその内容かなり詳しく把握してる気がするんだけど。[l]\n耳から入った情報が夢と混線してたのかな……」","「不过，\n总觉得对梦的内容记得相当清楚。[l]\n可能是听到的信息和梦境混在一起了吧……」"],["「そうなの？[l]\n寝ちゃった後は私も何も喋ってないけど。[l]\n","「是吗？[l]\n你睡着后我就没再说话了。[l]\n"],["ああ、でね、もうわかってると思うけど、\nまた膝枕してあげたよ。","啊，对了，你应该已经发现了吧，\n我又给你膝枕了哦。"],["僭越ながら。[l]\n私のなんかであれだけど」","恕我冒昧。[l]\n虽然我的腿可能不太舒服」"],["「うっ、あっ、あ、ありが…いや、[l]\nすみません……度々申し訳ない……」","「呜、啊、谢、谢谢…不，[l]\n抱歉……每次都这么麻烦你……」"],["「いいって言ってるのになー。[l]\n","「都说了没关系啦ー。[l]\n"],["突然、\nすーっと前屈みになったと思ったら、\nこっちに倒れかかってくるんだもん。","突然之间，\n看你往前一栽，\n就倒在我身上了。"],["一瞬どきっとしたよ。","吓得我心跳都停了一拍。"],["あはは、\nなんかね、\nおっきい赤ちゃんみたいだったよ。[l]\n前の時よりすっごい脱力してて……」","啊哈哈，\n怎么说呢，\n就像个巨型婴儿似的。[l]\n比上次睡得还要沉呢……」"],["「いやいやいやいや……揶わないでよ……」","「别别别别……别取笑我啦……」"],["うーん、僕もいよいよナルコレプシーなのかな…","唔～我该不会真的得了发作性睡病吧…"],["「寝顔視てたら、\n私も我慢出来なくなっちゃいそうだったし」","「看着你的睡颜，\n连我都差点忍不住了」"],["いっちゃおうかと思ったくらい──","甚至想着要不要干脆──"],["え、何だって？[l]\nよく聞こえなかったけど。","哎、你说啥？[l]\n没太听清楚。"],["いや、取り敢えずそれよりも、","不、比起那个，"],["「ど、どのくらい寝てたのかな……」","「睡、睡了多久啊……」"],["「えーとね、時間みたら\n寝てたのは５分くらいだけど…[l]\n体感的には３０分くらいかと思ってたんだけどねー。","「呃——那个，看了下时间\n其实只睡了5分钟左右…[l]\n不过体感上还以为有30分钟呢——"],["案外短かったね。[l]\nあー。だいじょぶ、誰も通んなかったから。[l]\n恥ずかしいことはない」","意外地短呢。[l]\n啊——。没事，反正没人经过。[l]\n没什么好害羞的」"],["いや、視られなきゃいいという話でもないし。","不、不是说没人看见就无所谓。"],["「あうあ、と、兎に角その、\nご、ごめす」","「呜哇、总、总之那个，\n对、对不起」"],["「ん、気にしない。[l]\nそれより体調は大丈夫かな？」","「嗯，别在意。[l]\n倒是身体没问题吗？」"],["「あー、そうね、\nちょっと寝た御陰かな？[l]\n逆になんかすっきりした感じが。[l]\n超回復ってやつ？」","「啊——也是呢，\n可能因为稍微睡了会儿？[l]\n反而觉得神清气爽了。[l]\n这就是所谓的超恢复吧？」"],["何かが違う気がしたがニュアンスは伝わったようで、\n冬夏はにこりと笑った。","虽然感觉哪里不太对但似乎传达了意思，\n冬夏嫣然一笑。"],["「ま、元気になったようでなによりだっ。[l]\n私ばっかり良くなっても申し訳ないもんね」","「嘛，恢复精神比什么都好。[l]\n光我一个人好转也挺过意不去的」"],["「元気というか……[l]\nそこまでアグレッシヴな感じでもないけどね…」","「与其说是精神……[l]\n倒也没到那么亢奋的程度啦…」"],["で、\n寝てたのが５分くらいとして、","然后，\n假设睡了5分钟左右，"],["「お嬢様お嬢様、\nそろそろお時間であらせられるのでは……」","「大小姐大小姐，\n差不多到时间了哦……」"],["「あ、\nそだ、ねえねえ、\nカラオケ行かない？[l]\n","「啊，\n对了对了，\n去唱K吗？[l]\n"],["実は来る途中発見してたんだよねー」","其实来的路上发现了一家呢——」"],["え、そうなの？","诶，真的？"],["いやいやそうじゃなく。[l]\n聞いてないし。[l]\nというかまだ発散し足りないと？","不是不是不是这个。[l]\n而且我没听说过。[l]\n或者说还没发泄够？"],["「心配しなくってもちゃんと\nワリカンで払うし。[l]\n","「不用担心\n我会AA制的。[l]\n"],["あ、そっちのプライドが許すなら、\n私が奢ってあげてもいいけど」","啊，如果您的自尊心允许的话，\n我请客也行哦」"],["「いや、そういうことではなくて……[l]\n時間は？[l]\n車の返却時間もあるわさ」","「不、不是这个意思……[l]\n时间呢？[l]\n还要还车呢」"],["「だめ？[l]\n","「不行吗？[l]\n"],["んー、\nやならいいけど──」","嗯——，\n不愿意就算了──」"],["「うぅーん、ま、その、\n行くこと自体はヤっ、て事はない……けどねぇ」","「唔——嗯、那个、\n去本身倒不是不行……啦」"],["知ってる歌曲が少々偏ってるんだよなあ、\n僕の場合。","只是我会的歌有点冷门啊，\n我这种情况。"],["約二名、そういう方向性の知人が周りに\nおりまして……[l]\nつーかだから時間はいいのか。","大约有两名熟人\n是这种取向……[l]\n所以说时间真的没问题吗。"],["「前も言ったけど、\nこの辺遊ぶ所なんかないから……[l]\n同級生とかはボーリング行くみたいだけど」","「之前也说过，\n这附近没什么好玩的地方……[l]\n同学们好像都去打保龄球」"],["腕が太くなるからって母様に止められてる、","但母亲说会练粗手臂不让去，"],["と続けた。","她继续说道。"],["「そこを敢えてやるっていうのもいいけど、\n実際、\n腕力とか無いから。[l]\nこれ以上──怪我するのもアレだしね」","「非要反其道而行也不是不行，\n但实际上，\n我腕力很差的。[l]\n再这样下去──受伤也很麻烦」"],["と言って左眼を指差す。","说着指了指左眼。"],["怪我ってか、ものもらいじゃなかった？[l]\n単に言葉の綾ってやつ？かな？","说是受伤，其实是麦粒肿吧？[l]\n只是修辞手法？大概？"],["あとはだから、時間的にどうなの、という問題である。","还有就是，时间上怎么安排的问题。"],["「ん、一時間くらいでいいんだ。[l]\n延長は……その場のノリで」","「嗯，一小时左右就行。[l]\n延长要看……现场气氛」"],["「まあ、わかったけど。[l]\nじゃあ…行こうかね」","「好吧，我明白了。[l]\n那……走吧」"],["「歌うの苦手？」","「不擅长唱歌？」"],["「うーーーん、\n最近のメジャーシーンていうの？","「唔——\n最近主流乐坛那种？"],["あういう一時の売れ線系は興味ないけど、\n歌うこと自体は嫌いじゃないし、\nそこそこ……だと思うよ」","我对那种昙花一现的流行款没兴趣，\n但唱歌本身倒不讨厌，\n还算……可以吧」"],["学生時代に特設合唱部に組み込まれた過去を\n持つ僕としては、\nまあその所為かも知れないが、","学生时代曾被编入临时合唱部的我，\n或许正因为如此，\n才会异常执着于音准，"],["音程合わせる事に異常に拘ったり、\n変に発声法を齧ってたりするので、\n昨今のヒット曲とやら達には全く眉を顰めることが多いのだ。","还莫名其妙钻研发声技巧，\n所以对近年那些所谓的热门歌曲，\n大多都忍不住要皱眉头。"],["個人的な嗜好であることは承知だが、\n僕の中では全く評価に値しない物が……","虽然知道这只是个人偏好，\n但在我看来完全不值一提的东西……"],["──いや、まあいいか。[l]\nそれこそ好き","——算了，无所谓。[l]\n正因为喜欢"],["好きだし。[l]\n冬夏がそれ系ばっかり歌うひとだったら、\nそんな事を言うのはちと気まずい。","才喜欢啊。[l]\n要是冬夏是专唱那种类型的人，\n说这种话就有点尴尬了。"],["大体僕のレパートリーは……[l]\n環境的にアニソンばっかですよ。","我的曲库大体上……[l]\n受环境影响全是动漫歌。"],["勿論そうは言ってもアニソンなら聴けるという訳でもなくて、\n大神や宮さんのチョイスが偶さか、\nその辺のノルマをクリアしてたものばかりだっただけの事\nらしい。","当然即便如此也不是所有动漫歌都能听，\n只是碰巧大神和宫小姐选的曲子，\n刚好都符合最低标准\n而已。"],["サークルで他の面子が聞いてるようなヤツは\nかなり厳しいものが大半だったからなあ……","社团其他人常听的类型，\n大部分都相当难顶啊……"],["「へえ－、\nインディーズ系なんかこの辺のショップじゃ\n置いてないからなー、\n聴いても分かんないかも」","「嘿——\n这附近的店根本不卖\n独立音乐啊，\n听了可能也不懂」"],["「あ、いや、\nそっちって訳でもなくて…[l]\nなんというかその、\nアニソンだの？","「啊，不是，\n倒也不是那个意思…[l]\n该怎么说呢，\n动漫歌之类的？"],["ややや、番組の中身は知らないよ？[l]\n歌だけ知ってるんですよ？」","哇哇哇，节目内容我可不知道哦？[l]\n只听过歌而已啦？」"],["「アニソン」","「动漫歌」"],["「何故かそういう環境でね……」","「不知怎的就养成这种听歌习惯……」"],["うーん、でもこっちでは放送してないやつかもなあ。[l]\n深夜枠がどうとか中央ローカルがなんたら……[l]\nって聞いたような気が。","唔，不过这边可能没播过那些。[l]\n深夜档啦中央地方台啦什么的……[l]\n好像听说过。"],["「ま、なんでも大丈夫。[l]\n","「嘛，什么都行。[l]\n"],["演歌とかは……ちょっと厳しいけど」","演歌之类就……有点勉强」"],["「ああ、それは僕も無い……」","「啊，那个我也……」"],["「そーかアニソンかぁ……」","「这样啊是动漫歌～……」"],["「や、そこに引っ掛からないで……[l]\nそそそれに最近のは昔ほどどぎつくないのもあるよ？[l]\n寧ろ普通のより余程上手いのとかそらあもう、\n……ていうか冬夏がメインで歌えばいいし」","「别、别纠结这个……[l]\n而而且最近的不像以前那么露骨了哦？[l]\n有些甚至比普通歌曲水准高得多，\n……不如说冬夏主唱就好」"],["「えぇ～。[l]\nなんか歌おうよ。デュエットとか、知ってるやつ」","「诶～。[l]\n一起唱嘛。二重唱什么的，会唱的歌」"],["「知ってるのあればそれでもいいけど……[l]\nじゃ、基本貴女のリサイタルということで、\n僕は全然大丈夫だし。[l]\n上手い歌聴いてるだけでも愉しいしね」","「有共同会唱的也行……[l]\n那基本就当你的独唱会，\n我完全没关系。[l]\n光听好歌也很享受」"],["何しろ冬夏はあの舞台でもかなりの歌唱りょ……\nと言いかけて止めた。[l]\nあぶないあぶない……[l]\n藪蛇なるとこだったわい。","毕竟冬夏在那舞台上可是相当能唱……\n话到嘴边又咽了回去。[l]\n好险好险……[l]\n差点就画蛇添足了。"],["「上手いかどうかはあれだけどあははは……","「唱得好不好另说啊哈哈哈……"],["あー……[l]\n","啊——……[l]\n"],["私はあんまり知らないけど、\n克杖はすごい上手いらしいよ、歌。[l]\n知らないけど」","虽然我不太清楚，\n但听说克杖唱歌超级厉害哦。[l]\n虽然我不清楚啦」"],["「…へえ～」","「…嘿诶～」"],["あいつ人格と喋り以外は結構完璧なひと？","那家伙除了人格和说话方式外简直完美？"],["流れで突然思い出したが、\n大神は早熟という才能を信用してない奴で、\n早熟で持て","顺着话题突然想起来，\n大神是个不相信早熟才能的家伙，\n他认为早熟者受到追捧"],["囃されるのはただ限られた時間内に\nおけるその属する集団の平均値より高い相対的でしかない──","只不过是在有限时间内\n相对高于所属群体的平均值——"],["実社会と接続する時間が来た段階で集団は全体と\n同化しその時間属性は消滅するので全くの一時的な揮発性の───\n価値であるから、全く以て興味が沸かない、\nという事らしい。","当接触现实社会的时间到来时群体整体会\n同化而时间属性消失所以完全是暂时性的挥发——\n价值，因此完全提不起兴趣，\n就是这么回事。"],["結構な割合でその辺の人達も子供の頃は神童と呼ばれてるとか、\n歳を取ればいずれあの人は今的な扱いになるとか、\nゲームでは早熟型はステータスの天井低くて使えないと\n相場が決まってるとか、","相当比例的人小时候都被称作神童，\n说长大了迟早会变成现在这样，\n游戏里早熟型角色能力上限低不好用\n已经是公认常识，"],["小さい頃に持て囃されてると人格形成に微妙な場合がどうだとか、\nテレビでみせる方も使う方も若い事しかウリにしてないのは\n子供でも判るとか、","小时候被捧太高对人格形成有微妙影响之类的，\n电视上表演的和使用的都只拿年轻当卖点\n连小孩都懂，"],["そういう話題を特に歌関係の会話中に、\n怒ってるというよりは嘆いてる感じで延々語られた事が\nあるので思い出したのだと思う。","特别是在关于唱歌的对话中，\n与其说是愤怒不如说是叹息着滔滔不绝说过\n这些事所以想起来了。"],["ただ、そういう基準とは全く別に──つまり、\n歌唱力とかがそれなりでも──\nＣＤ買ってる曲はあるし、愉しく聴ける場合もあるようで、","不过，和那些标准完全无关——也就是说，\n就算唱功平平——\n也有会买的CD，有时候听着也很开心，"],["要するに上手い下手というよりは、\n好きか嫌いか。\nであると、至極もっともというか、単純というか当たり前というか。","总之比起好坏，\n更在于喜不喜欢。\n嘛，说是极其合理也好，单纯也罢，理所当然也行。"],["長広舌の後でしらっと言われたのだった。[l]\nなんじゃそれは。","长篇大论后被冷冷吐槽了。[l]\n这啥啊。"],["──promoteなどという●●で誤魔化した紛い物には興味ないだろ？[l]\n●●●を持つものとしてそのようなものに食指を動かしては\nならない。","──对promote这种●●糊弄人的冒牌货没兴趣吧？[l]\n作为持有●●●者不该对那种东西\n产生欲望。"],["ん？","嗯？"],["「え？[l]\nなに？」","「咦？[l]\n什么？」"],["「はぃ？[l]\n何も言ってませんが？」","「啊？[l]\n我什么都没说呀？」"],["「あれ？[l]\nおかしいな……」","「奇怪？[l]\n不对劲啊……」"],["「……なんか軽く食べてく？[l]\nやっぱり心配になってきた」","「……要不要稍微吃点东西？[l]\n果然开始担心了」"],["「え、ああ、\n食べるっていうか、そうだね、\nじゃあ、ビタミン飲料と甘い物を……」","「诶，啊，\n说是吃嘛，也是呢，\n那就要维生素饮料和甜食……」"],["今の幻聴みたいなのもあることだし、\nちょっと脳の回転をよく……いや空転ではなく、[l]\nギアの噛み合わせをよくしよう。[l]\n実際、午前からの色々で疲れてるんだろうしなあ……","毕竟刚才都出现幻听了，\n稍微让大脑转快点……啊不是空转，[l]\n调整好齿轮咬合吧。[l]\n实际上从上午忙到现在肯定累了吧……"],["「判った、買ってくる」","「知道了，我去买」"],["「え？[l]\nあ、いや自分で買う……」","「诶？[l]\n啊不用我自己买……」"],["あああああ。","啊啊啊啊。"],["行っちゃった。","已经跑走了。"],["恐らく道の駅の土産売り場だろうが、\n下手に場所移動するのもあれだったので、\n仕方なく荷物その他を見張りつつその場で待っていた。","估计是去公路驿站的土特产卖场，\n但随便移动位置也不太好，\n只好原地守着行李等待。"],["数分と待たずに、\n冬夏はビンのビタミン飲料とチョコ系お菓子を\nそれぞれの手に持ちながら戻ってきた。","没过几分钟，\n冬夏就拿着瓶装维生素饮料和巧克力系点心\n双手各抓一样回来了。"],["「自販機で両方あったー」","「自动贩卖机两样都有啦」"],["「あ、ありがとう。[l]\nおいくら……」","「啊、谢谢。[l]\n多少钱……」"],["「ん、いいってば。[l]\n","「嗯、都说不用啦。[l]\n"],["それより安全運転の方宜しくでっす」","比起那个请安全驾驶哦」"],["「うっ、\nりょ、了解でっす」","「呜、\n了、了解的说」"],["「んじゃ、\n軽いものはカラオケ屋で頼もうね。[l]\n","「那、\n轻食就去卡拉OK店点吧。[l]\n"],["私も久々にジャンクらしいジャンクフードいっとこうかなあ」","我也好久没吃正宗的垃圾食品了呢」"],["ああ、フライドポテトとか妙に食べたくなるよね。[l]\n…いや、冬夏のは別の理由がそういうことのあれであれか。","啊，突然超想吃薯条什么的呢。[l]\n…不对，冬夏的情况是另有原因所以才会那样吧。"],["「えーと、じゃあ取り敢えず車戻ろうか。[l]\nちっと寒くなってきたし。[l]\n僕も、中でこれいただくよ」","「呃，那总之先回车上吧。[l]\n稍微有点冷起来了。[l]\n我也在车里解决这个吧」"],["「りょうかーい」","「好——嘞」"],["身支度をし車に戻り、\n僕はビタミン補給をしつつ糖分も摂取して準備万端。","整理好行装回到车上，\n我边补充维生素边摄取糖分做好万全准备。"],["冬夏が視付けたというカラオケ屋目指して出発します。","朝着冬夏发现的卡拉OK店出发。"],["この辺りの道は、\n店と言うよりも家屋自体がそんなに立ち並んでないので、\n意識しさえすれば目的の場所はあっさり判明した。","这一带的路，\n与其说是店铺不如说连民宅都没几栋，\n只要稍加留意目标地点立刻就能找到。"],["そして、\nどうあれ平日ど昼間……いやもう夕方近いかもなので、[l]\n此処もまたガラ空きなのだった。","然后，\n反正工作日大白天…不对已经快到傍晚了吧，[l]\n这里果然也是空荡荡的。"],["降りて施錠してる間に、\n彼女はさっさと受付に行き、既に手続きを済ますところで、\n僕はぼんやり手持ち無沙汰で後ろに突っ立っているしか\nなかった。","在我下车锁门的空档，\n她已经麻利地跑到前台办手续，\n我只能呆呆地杵在后面闲得发慌，\n无事可做。"],["さっきの自販機の件といい、\nこういう時リード出来ない自分によく絶望します……","刚才的自动贩卖机事件也是，\n这种时候总对自己不能带头感到绝望……"],["まあ、冬夏はしきたりとか嫌いだと言うし、\nレディファーストとかいった男子の仕切りなんか\n期待してないのかも知れないが、\nアナクロな僕としてはどうしても、","不过冬夏说过讨厌规矩之类的，\n像女士优先这种男生安排的套路\n她可能根本没期待过，\n作为老古董的我无论如何"],["とは思うんだけども、","还是会这么想，"],["──思うだけ、なんだなあ。[l]\n行動が伴わんといけないね。","──光想不做，果然不行啊。[l]\n必须付诸行动才行呢。"],["と、自省の念に","正沉浸在"],["耽っていると、","自我反省中时，"],["こちらご案内しまぁす、\nという若い店員の声が聞こえ、\n冬夏もこちらに手招きしているのが視えた。","听到年轻店员招呼着\n「这边请」，\n看见冬夏也正朝这边招手。"],["その店員の眼は冬夏に微妙な感じに注がれていた…というか、[l]\n寧ろ逸らしてるといった方がいいのか、\n腫れ物に触るような空気が何となく出ている。","那位店员的目光微妙地投向冬夏…或者说，[l]\n不如说是刻意避开更贴切，\n空气中隐约弥漫着如履薄冰的氛围。"],["「じゃ、こっちだって」","「那、我们这边也是」"],["冬夏は気にするでもなく、\n店員について行く。[l]\n僕も慌てて後を追う。","冬夏毫不在意地，\n跟着店员走了。[l]\n我也慌忙追了上去。"],["部屋に入り、\n一","进入房间后，\n一"],["頻り使い方等の説明を終えると、\nごゆっくりどうぞぉ～と店員は去っていった。","通关于使用方法的说明结束后，\n店员说着请慢慢享受～就离开了。"],["僕は何も言わなかったのに、\n冬夏は話し出す。","明明我什么都没说，\n冬夏却主动开口。"],["「この辺だと有名だからね。[l]\n良い意味でも悪い意味でも。","「在这附近还挺有名的呢。[l]\n不管是好名声还是坏名声。"],["物珍しさで騒がれない代わり、\nすごい萎縮される、\n触らぬ神に祟りなしーって感じで。","虽然不会因为稀奇被围观，\n但大家都会超级拘谨，\n有种不碰神明就不会遭报应的感觉。」"],["母様や先祖代々、なんか植え付けた影響力が\nこう、ずっと引き継がれてるんだよね。[l]\n三春は只でさえそんななのに、\n私こんなだから。","母亲大人和历代祖先们种下的影响力\n就这样，一直延续至今呢。[l]\n三春家本来就已经够夸张了，\n更何况我又是这副德性。"],["そうだね……[l]\n有り難いときもあるし、\nウンザリするときもある」","确实呢……[l]\n有时候会觉得感激，\n有时候也会觉得烦人」"],["まあ、１７、８年此処で生きてれば\nもう馴れるどころの話じゃないけど、","嘛，毕竟在这里生活了十七八年\n早就不是习不习惯的问题了，"],["と冬夏は付け加えた。","冬夏又补充道。"],["「うーむ……」","「唔嗯……」"],["僕は、それしか言えなかった。","我只能挤出这样的回应。"],["「ま！[l]\n真言さんは気にしないでくれるから嬉しいよ。","「啊！[l]\n真言先生不会在意这些所以我超开心的。"],["じゃー早速曲入れてて。[l]\n時間１時間ね。[l]\n今食べ物頼むから」","那赶紧点歌吧。[l]\n时长一小时哦。[l]\n现在就去点餐」"],["今更だけど、\n案外行動派というか庶民派なんだよな－。","现在才意识到，\n意外地是个行动派或者说平民派呢－。"],["イメージだと、\n良家のオジョウサマって、\n全部取り巻きとかがやってくれるのを\n悠然と座って視てるって感じだけど。","按我的想象，\n大户人家的小姐应该\n都是让随从们打点好一切\n自己优雅地坐着旁观才对。"],["まあそういうのがイヤだっていうのが冬夏だしな。","不过冬夏就是讨厌这种做派啦。"],["「こういう段取り、あんまりやらせて貰えないから\n愉しくって。[l]\nあ、もしもし？\nあのですね……」","「像这种流程安排\n很少有机会亲自操办所以很开心。[l]\n啊，喂喂？\n那个……」"],["成る程ねえ……[l]\nたまにきぃと行くときくらいなのかな、\nそう言うのは。","原来如此呢……[l]\n大概只有和小贵一起来的时候\n才会这样吧。"],["でも彼奴も色々忙しいだろうし、\n金の掛かる娯楽には気が引けそうだから\nそんなには来られないんだろうしなあ。","但那家伙也挺忙的，\n而且烧钱的娱乐活动会让他有负担\n所以应该不会常来吧。"],["「お願いしまーす……と。[l]\nあれ、まだ入れてないの？」","「麻烦快点……咦？[l]\n还没开始点歌吗？」"],["「あ、ごめん。[l]\nでもいいよ先に入れて。[l]\nほい」","「啊、抱歉。[l]\n不过你先点也行。[l]\n给」"],["「後にするの？[l]\n歌ってる真っ最中に店員来ちゃう\nタイミングになったりして」","「要延后吗？[l]\n万一正唱到高潮店员突然进来\n就尴尬了」"],["そういうのはよう知ってるんだなあ。[l]\n子供の頃の話と言い、\n少ない機会はきっちり脳裏に刻み込んでるってこと\nかしら。","对这种细节倒是很懂嘛。[l]\n听她提起童年往事，\n看来稀少的体验都被牢牢刻在脑海里了\n呢。"],["「ああ、僕は店員来たら歌うの止めるタイプだから…」","「啊，我是那种店员进来就会停唱的类型…」"],["「ふーん、\nま、じゃあお言葉に甘えて」","「哼嗯，\n嘛，那就恭敬不如从命」"],["カラオケは僕もたまに来る程度だが、\n来る度に入力機器が進化してて、\nよっくわからないんだよね。[l]\n宮さんや大神は何時来ても普通に使いこなしてたけど……","虽然我也只是偶尔来唱K，\n但每次来点歌设备都升级，\n完全搞不懂呢。[l]\n宫小姐和大神不管什么时候来都能熟练操作……"],["冬夏はと言えば、\n割とすんなりペンタブレットでとととんと機械の画面を\nつつき、","至于冬夏，\n已经用数位笔在机器屏幕上哒哒哒地\n点好了，"],["部屋のモニターには早速タイトルが表示される。[l]\n……これが若さってやつかな……","包厢屏幕立刻显示出曲目。[l]\n……这就是所谓的年轻力量吧……"],["「んっ。んんーっ。あっ、あーーっ。[l]\nあ、あ、あ」","「嗯。嗯嗯ー。啊，啊ーー。[l]\n啊、啊、啊」"],["立ち上がってお立ち台みたいな所へ行き、\n発声練習しつつエコーの感じを確かめてる冬夏。","她站上小舞台般的区域，\n边开嗓边调试回声效果的冬夏。"],["この曲名は──知ってるような、知らないような。","这首歌──似曾相识又好像陌生。"],["……き、聴けば分かるさ！","……听、听完就知道了！"],["と、曲が流れ出すと同時に、\n何かに気付いた感じでまた手早く機械を操作する冬夏。","当、歌曲开始播放的同时，\n冬夏似乎察觉到什么又快速操作起机器。"],["どうやら、\nご親切にも機械の側で低めに設定されていたキーを、\nオリジナルに──つまり高いキーに戻したようだ。","看样子，\n她好心地把机器旁边设置得较低的调，\n调回了原版──也就是较高的调。"],["「私カラオケキー変更許せない人だからっ。[l]\nわかってるそこっ？[l]\n歌は魔法なの、音換えたらシキが変わっちゃうの！[l]\nオトの紡ぎ手のイトが！！」","「我可是绝对不能容忍别人改卡拉OK调的人哦。[l]\n明白了吗那边那位？[l]\n歌唱是魔法，换了音高就会改变仪式的！[l]\n声音编织者的丝线会断掉的！！」"],["腰に手をあてこっち指さす冬夏。[l]\nその声にはマイクエコーが掛かっており、\nうっ、まるで後光さすような神々しさまで──","冬夏叉着腰指向这边。[l]\n她的声音带着麦克风混响，\n呜哇、简直像背后散发圣光般神圣──"],["って、おい、\nどっかで聞いた台詞を今言わなかったか？","等等喂，\n刚才是不是说了某部作品的台词？"],["……流行ってるフレーズなの？","……这是流行语吗？"],["「よっし、\nしかと聴いてねまことさん！」","「好嘞，\n给我好好听着哦真言先生！」"],["私の唄をおきき！！と云わんばかりの、[l]\n謎の圧倒感を放ちながら。","仿佛在说「聆听我的歌声吧！！」，[l]\n散发着谜一般的压迫感。"],["歌い手用のモニタの前で\nくるりと回って、","在歌手用监视器前\n轻盈地转了个圈，"],["ぴたりと止まると、","突然定住，"],["集中──。","集中──。"],["イントロが終わりかけ、\n画面に歌詞が表示される。","前奏即将结束，\n画面上显示出歌词。"],["すぅっ、","嘶──"],["息を吸い込む。","深吸一口气。"],["次の瞬間、","下一秒，"],["「藍碧の──」","「蓝碧之──」"],["胸の深い所に響く、\n何とも言えない声が、","震撼胸腔的、\n难以言喻的歌声，"],["普通なら手拍子をしたりして盛り上げる所だけれど、","通常这时候该打拍子炒热气氛，"],["「………」",""],["完全に圧倒されて魅入って……否、聴き入ってしまった。","却完全被震慑住听得入迷……不，是听得出神了。"],["あの式の時とは別の迫力がある。","和那次仪式时是截然不同的冲击力。"],["そもそもあの時と此処では全く環境が違うし、\nどっちが音楽的に良い舞台環境なのかは解らないけれど、\nそういう要素を差っ引いたって、\nやはり眼の前でこれだけのモノ唄われたらば、","毕竟当时和现在的环境完全不同，\n也说不上哪边才是更适合音乐表演的舞台，\n但就算抛开这些因素，\n亲眼目睹这样的演唱果然还是令人"],["「（……っごいなぁ…）」","「（……太厉害了…）」"],["と素直に感じ入ってしまう。","不由得发自内心感叹。"],["あの時は──\n他に色んな事が起きすぎて、\n歌に集中出来なかった事もあるんだろうし。","那时候──\n因为发生了太多其他事情，\n可能也没法集中精力听歌吧。"],["舞踊しながらだったから、\n或いは録音で口パクだったかも知れないが、\n録りだとしても今の歌声聴く限りは多分冬夏自身の声だろうし、\n何かしらの心得あるのかもなー。","而且当时是边跳边唱，\n说不定还是录音对口型，\n但按现在听到的歌声水平来看就算是录音也应该是冬夏本人的声音，\n或许她确实有什么独门诀窍吧。"],["それか、\n勝手な予想だが、\nあの式は冬夏にとって本意では無かったらしいから、\nその辺のモチベーションの差が出たのかも知れない。","或者说，\n擅自猜测的话，\n那场仪式对冬夏来说似乎并非本意，\n可能是这方面的积极性差异造成的。"],["と、色々邪推してはみるものの、\nそういう理屈を凌駕して、\n上手さがどうこう以前に、","虽然试着做了各种揣测，\n但这些道理都被彻底碾压，\n在讨论唱功好坏之前，"],["何でこんなにも胸が締め付けられるのか。[l]\nコエが胸に響いて、\n痛い。","为什么胸口会如此绞痛。[l]\n声音在胸腔共振，\n好痛。"],["ウタは魔法──","歌声是魔法──"],["単純に眼の前か舞台の上かの距離感かも知れないけど──","或许单纯是眼前与舞台的距离感问题──"],["……僕は、[l]\n間奏の時も、ただただ呆然として彼女を視ていたらしい。[l]\n曲が終わるまで何も出来なかった。","……我，[l]\n就连间奏时也只是呆呆注视着她。[l]\n直到歌曲结束都动弹不得。"],["冬夏も集中していて、\n僕の様子には気付いてない。","冬夏也全神贯注，\n没注意到我的状态。"],["知ってる曲だったかどうかは、\n結局よく判らなかったというか、\nどうでもよくなってた。","是不是熟悉的曲子，\n结果还是不太清楚，\n已经无所谓了。"],["「──」",""],["知らぬ間にフルコーラス分の時間が過ぎて、","不知不觉间整首歌的时间过去了，"],["唄が終わった。","歌声停了。"],["余韻。","余韵。"],["「えへへ。[l]\nちょっと良い感じに……あ、[l]\n","「诶嘿嘿。[l]\n感觉有点棒……啊，[l]\n"],["──真言さん泣いてる？」","──真言你在哭？」"],["「あ、…かも、[l]\nいやいやいや、\n何て言うの、その、\nすごいなあ……」","「啊、…可能吧，[l]\n不不不，\n该怎么说、那个、\n太厉害了……」"],["大神も宮さんも上手かったんだろうけど、\n９割方アニソンだったから、\nその、よくわからんかったのよね。[l]\n寧ろそっち系の歌詞、フレーズが気になってねあういうのは……","虽然大神和宫小姐都很擅长，\n但九成都是动漫歌曲，\n那个、完全听不懂呢。[l]\n倒不如说那种歌词啊旋律更让人在意……"],["ウタは魔法なあ……","歌声真是魔法啊……"],["冬夏は一頻り照れたり謝辞を述べたあと、\nぐいっとマイクをこちらに差し出す。","冬夏红着脸道谢后，\n唰地把麦克风递过来。"],["「ではでは。[l]\n真言さんの番です。[l]\n","「那么那么。[l]\n轮到真言了。[l]\n"],["あれ、入れてないの？」","咦、没点歌吗？」"],["「あなた、今のその後で歌えってか……」","「你这是要我在她唱完后接着唱啊……」"],["別に競ってる訳ではないとは言え、\n気後れしてしまいますですよ。","虽说不是比赛，\n但也会怯场的好吗。"],["「んじゃーこれ知ってる？[l]\n二人で行けるやつあるよほら」","「那──这首会吗？[l]\n有能合唱的曲子哦你看」"],["僕から機械を受け取るとまた、とすとすと操作をし、\n画面をこっちに視せる。","她接过点歌机啪啪操作着，\n把屏幕转向我。"],["「どう？」","「怎样？」"],["「あー、知──ってると思うす」","「啊──应该会、会吧」"],["何処で知ったか全く自覚がないけども、\n多分フルコーラスいけそうな位は覚えてる曲だった。","完全不记得在哪听过，\n但大概能唱完整首。"],["「よっし、いこいこ」","「好嘞、来来」"],["僕もステージの方に連れてかれて、\n二人してのデュエットが始まった。","我也被拉到舞台上，\n开始了二人合唱。"],["……いや、[l]\nあらゆる意味で恥ずかしいですよ、これ。[l]\nまずオーディエンスがいねえし！","……不行，[l]\n这从各种意义上都太羞耻了。[l]\n首先根本没有观众！"],["て、そんな時に限って店員が喰い物持ってくるし！","而且偏偏这时候店员送餐进来！"],["がふっ。","噗哈。"],["更に言えばこれ、\nこの曲はですね、\n結構恥ずいラヴソングですがなにか！","更别提这首歌，\n根本是首\n超级羞耻的情歌好吗！"],["………。",""],["──そんなこんなで、\nその後は冬夏ソロステージ。","──就这样，\n之后是冬夏的个人舞台。"],["バラードやら激しいのやら、\nよく判らない民族系の発声法のやつやら、\nガチからネタ？系まで、[l]\nいや、堪能させて頂きました。","从抒情到劲歌，\n到听不懂的民族唱腔，\n从正经到搞怪？系，[l]\n真是让我大开眼界。"],["知ってる中で幾らか普通っぽいアニソンを一曲二曲、\n僕も歌ってはみたけどね……[l]\nまあ、咬ませ犬ですよね、そりゃ。[l]\nいいんすけどね、もう。","我也试着唱了一两首\n听过比较普通的动漫歌……[l]\n不过完全是陪衬啦。[l]\n但也没关系啦。"],["え、待て、\n狩屋てこれより歌上手いって？！[l]\n冬夏の主観とか謙遜、伝聞情報だって事もあるし\n一概には言えないが、","等等、\n狩屋唱得比她还厉害？！[l]\n虽然可能是冬夏的主观评价或谦辞\n不能一概而论，"],["……まあ、トントンってとこなのかな……[l]\nそれでもかなりのもんだけど……[l]\n彼奴とはカラオケ一緒に行きたくねぇなぁ。","……大概半斤八两吧……[l]\n但已经相当厉害了……[l]\n完全不想和那家伙去卡拉OK啊。"],["と、丁度曲終わりの区切りのところで、\n部屋のインターホンが鳴った。","正好歌曲间奏时，\n房间的对讲机响了。"],["もう時間との事だった。","说是已经到时间了。"],["五分前とかの知らせ無いんかい。[l]\n店によるのかなあ？","连个五分钟前的通知都没有吗。[l]\n可能要看店家吧？"],["「あー、もう時間だって」","「啊——说是到时间了」"],["曲はもう入ってなかったので、\nアド画面の静かな感じに落ち着いていた。","因为已经没有在播歌了，\n画面停留在广告的安静状态。"],["延長どうしよう？[l]\nと言ってから、すぐ自分で訂正する。","要延长吗？[l]\n刚说完就立刻自我纠正。"],["「あ、そか。[l]\nあんまり色々食べられなかったけど、\nレンタカーの返却時間もあるんだよね。[l]\n残念」","「啊，对哦。[l]\n虽然没怎么吃到东西，\n但租车还有归还时间呢。[l]\n可惜」"],["え、まだ歌い足りてない御様子？[l]\n複数人で一時間だったら足りないのも分かるけども、\n今回はほぼ冬夏が時間使ってるはずなんだけど。","咦，看样子还没唱够？[l]\n多人共用一小时确实不够啦，\n不过这次基本都是冬夏在用时间吧。"],["喉の方も勿論、体力あるっていうか、\nやはり唄に関してそれなりの訓練受けてるんじゃないのかな。","喉咙当然没问题，或者说体力充沛，\n果然在唱歌方面受过专业训练吧。"],["若い頃は大神のアニソン６耐とかに付き合わされた事も\nある──あれは特殊な例かも知らんが、\n……宮さんの時は８耐だったか、","年轻时还被大神拉着陪他熬过六小时动漫歌马拉松——\n那可能算特例，\n……宫小姐那次是八小时来着，"],["兎に角、僕はもう喉は","总之我现在喉咙"],["嗄れるわ、\nレパートリーは無くなるわで大変だったものだ。","会哑掉，\n歌单也会耗尽，当时可够呛。"],["──若い頃って、今も若いっちゅうねん。","——说年轻时，现在也还算年轻啦。"],["「ごめん、ワリカンにしてはちょっと不公平だったね」","「抱歉，AA制的话对你有点不公平呢」"],["「いや、最初からそういう話だったし、\n問題ないっす。[l]\n寧ろ耳の保養になったですよ、\nすごく愉しかった」","「不，本来就说好这样的，\n完全没关系。[l]\n不如说耳朵都被治愈了，\n超级开心」"],["耳の保養……[l]\nそんな慣用句あったっけか？[l]\nまあ、どっちでもいいですがね。","耳朵被治愈……[l]\n有这种惯用说法来着？[l]\n嘛，怎样都好啦。"],["「あ！！[l]\nね、戻ったらさ、\n旅館だからカラオケあるんじゃない？[l]\n宴会場っていうの？」","「啊！！[l]\n我说，回去之后，\n旅馆里应该有卡拉OK吧？[l]\n就是那种宴会厅？」"],["「へ？[l]\nや、僕も詳しくは知らないけども……」","「诶？[l]\n不，我也不太清楚啦……」"],["あったとしても個人客に使えるのかな？","就算有也不知道能不能给散客用？"],["「戻ったらきいてみよ。[l]\nじゃー会計行ってくるね」","「回去问问看吧。[l]\n那我去结账咯」"],["え、あら、","咦，哎呀，"],["相変わらず行動早いと言うか、\nらしからぬと言うか、","该说一如既往行动迅速呢，\n还是说意外地积极呢，"],["彼女は受付に行ってさっさと精算してしまった。[l]\nや、勿論その後自分の分は出しましたよ。","她已经跑去前台麻利地结完账了。[l]\n啊，当然之后我付了自己那份。"],["「あーっ、\n愉しかったぁーっ」","「啊——\n超——开心！」"],["「それはなにより。[l]\nんでは行きますよ。[l]\nお手洗いとか大丈夫？」","「那就好。[l]\n那出发吧。[l]\n要先去洗手间吗？」"],["「ん。[l]\nだぁいじょーうぶー」","「嗯。[l]\n完——全没问题！」"],["「あいあい……」","「好嘞好嘞……」"],["どうもテンションに違和感あるけどな……[l]\nまあいいか、愉しいなら。","总觉得这兴奋劲有点违和啊……[l]\n算了，开心就好。"],["車に乗り込み、\nエンジンをかける。","坐进车里，\n发动引擎。"],["と、携帯を弄り出す冬夏。[l]\n何かを確認して、すぐ仕舞う。[l]\nとりわけ気にする事でもないありふれた行為だったので、\nそのまま気にせずシートベルト待ちしていると、","这时冬夏开始摆弄手机。[l]\n确认了什么后立刻收起来。[l]\n只是司空见惯的寻常举动，\n所以没在意继续等着系安全带，"],["「ん？[l]\n気になる？[l]\nメールチェック、ごめんなさいね」","「嗯？[l]\n在意吗？[l]\n查看邮件，抱歉呢」"],["「いや、別に大丈夫」","「不，完全没关系」"],["「ちょっと前からきぃと連絡つかなくなっちゃって。[l]\nレス来てないかと思って」","「从前阵子就联系不上小贵了。[l]\n想着是不是没回消息」"],["「ああ、それは……」","「啊，那个……」"],["体調不良で診療所のバイトも休んでるって、","听说因为身体不适连诊所打工都请假了，"],["道具さんから聞いた……と言っていいのか？[l]\n──いや、伏せとこう。","从道具那儿听来的……这么说合适吗？[l]\n──不，还是保密吧。"],["「まあ、体調悪いんだったら返事打つのもしんどい\n事もあるだろうし、\nいよいよになったら家に行ってみるとか？[l]\n住所知ってるなら」","「嘛，要是身体不舒服的话回消息也会很吃力\n的情况也是有的，\n实在不行的话要不要去她家看看？[l]\n知道地址的话」"],["道具さんは家には行かないが礼儀、みたいな事を\n言っていたが、\nいよいよの時はいよいよの時だし、\nそんな事も言ってられないだろう。","道具小姐虽然说过不去别人家是礼节之类的话，\n但\n紧急时刻就是紧急时刻，\n也顾不上那些了吧。"],["ちなみに僕ぁ即レスの人だけど……","顺便说我是秒回党来着……"],["と言うと、","刚说完，"],["「だよね？！","「对吧？！"],["私もそう、\nあ、この前みたいに手元に無い時とかは無理だけど、\nプライベートでは着信したら速攻！[l]\nだってやきもきさせたくないもんねっ」","我也是，\n啊，像前几天那样手边没手机时就没办法，\n私下收到消息绝对秒回！[l]\n因为不想让人干着急嘛」"],["ああ、そう言えば冬夏と出会う前、\nきぃも言ってたな、\n冬夏は返事すぐの人だと。","啊，这么说来和冬夏相遇前，\n小贵也说过呢，\n说冬夏是回消息超快的人。"],["まあ、","不过，"],["先日克杖に電話するの遅れて、彼奴を怒らせたのは\n色んな意味で内緒だがね！","前几天给克杖打电话迟到了惹那家伙生气的事\n在各种意义上都要保密就是啦！"],["「兎に角きぃの事で何かあったら僕も\n一緒に……なんかするから、[l]\n言ってくれれば」","「总之小贵要是有什么事我也\n一起……做点什么，[l]\n随时告诉我」"],["「うん、\nありがと」","「嗯，\n谢谢」"],["「じゃ、出るよ。[l]\nシートベルト締めてくれぃ」","「那，出发啦。[l]\n系好安全带哟」"],["「はーい」","「好～」"],["帰りの車中は、\n幾分疲れたのか、\n冬夏も少し大人しくしていた。","返程的车厢里，\n或许是有些累了，\n冬夏也安静了几分。"],["レンタカー屋に到着する頃には、\nうとうとと船を漕いでた程だった。","快到租车行时，\n已经像划船似地开始点头打盹了。"],["まあ、そりゃあそうでしょうと思ったので\nこちらもそっとしておいたが、\n停車と同時に覚醒したらしい。","嘛，想想也是理所当然\n我便没打扰她，\n但停车瞬间她似乎就清醒了。"],["「ん……、[l]\nお疲れさまー」","「嗯……[l]\n辛苦啦～」"],["ふくぅん、と欠伸なのか溜息なのか、\n少量の吐息と共に背伸びをする冬夏。","呼嗯～，不知是哈欠还是叹息，\n冬夏伴着微弱吐息伸了个懒腰。"],["「お疲れぇー…っと。[l]\n大丈夫？」","「辛苦啦……话说。[l]\n没事吗？」"],["「ん？[l]\n何が？」","「嗯？[l]\n什么？」"],["「や、眠気とか」","「呀，比如睡意什么的」"],["「ん。[l]\n","「嗯。[l]\n"],["てか、歩いてれば覚めますわ」","不如说走走路就清醒啦」"],["「それはそうやね……」","「那倒确实……」"],["既にフロントから出て来ていた店員さんに、\n車内チェック等してもらい、\n恙なく返却手続きも終了した。","向早已候在柜台的店员\n办好车内检查等手续，\n顺利完成了还车。"],["「じゃあ、二人の愛の巣に帰ろうか」","「那么，回二位的爱巢吧」"],["「色んな意味で間違ってるよね、それは……」","「各种意义上都搞错了呢，那个……」"],["「あはははは！[l]\nほんっとに面白いね、真言さんは」","「啊哈哈哈！[l]\n真的超有趣呢，真言先生」"],["はいはい、さよですね……[l]\nいや、どこが面白いのでスか？","是是是，您说得对……[l]\n不，请问哪里有趣了？"],["「手、繋いで帰る？」","「要牵手回去吗？」"],["「……視られたら恥ずかしいみたいな事、[l]\n前言ってたよね？」","「……之前不是说过[l]\n被人看见会害羞之类的话吗？」"],["「言ったっけなー？」","「我说过吗ー？」"],["「言ってたよ。[l]\nきぃとご飯食べた後。","「说过的。[l]\n和小贵吃完饭之后。"],["しかもその時は二人きりのとこ視られたら、\nだったかな……[l]\n手繋ぎなんてグレード上がってるじゃないよ」","而且当时还说要是被看到两人独处\n之类的……[l]\n现在直接牵手不是难度升级了吗」"],["……あれ、[l]\n僕の記憶力にしては、上等過ぎるな。[l]\n合ってるとすれば、だけど。","……奇怪[l]\n以我的记忆力来说，记得太清楚了吧。[l]\n前提是如果没记错的话。"],["──知らぬ間に善行でも積んだか？","──难道不知不觉积了德？"],["「ちぇー、\n余計な事言わなきゃ良かったっ。[l]\nじゃ、行きましょ」","「切ー\n不多嘴就好了。[l]\n那，走吧」"],["「へいへい」","「好嘞好嘞」"],["って、スタスタと先に歩き出す冬夏。","说着，冬夏啪嗒啪嗒地走在了前面。"],["僕が後ろから付いてく形で、\n無言でそのまま数分歩いていると、","我跟在她身后\n默默走了几分钟后"],["ぎゃりっ、と振り向いて、","她突然「嘎」地转身"],["「どう？[l]\n隣、歩きたいでしょ？」","「怎样？[l]\n想并肩走吧？」"],["「はあ゛っ？」","「哈啊゛？」"],["「やっぱり逃げる獲物を狩りたい訳でしょ、\n男子ってのはっ」","「果然雄性生物就是会想追捕逃跑的猎物\n对吧ー」"],["何の話よ。","什么跟什么啊。"],["「や、いみわかんね……」","「不，完全不懂……」"],["「たまには突き放した方が良いのかなーって」","「偶尔保持距离比较好吗ー之类的」"],["「あはは！[l]\nすきってこと！！[l]\nそういうとこが！！」","「啊哈哈！[l]\n就是喜欢啦！！[l]\n就是这种地方！！」"],["「……や、いみわかんね……」","「……不，完全不懂……」"],["なんだろう、この感じは。[l]\n宮さんに弄られるのとは違う、\nよく判らない苦しい感じは──","这种莫名的心情是怎么回事。[l]\n和被宫小姐捉弄时不同\n这种难以名状的煎熬感──"],["「いいの！[l]\nじゃ、隣、いきます」","「没关系！[l]\n那就并肩走咯」"],["「おうあう」","「哦啊哦」"],["「手繋ぎはね、恥ずいからね、確かに」","「牵手确实会害羞呢」"],["冬夏は僕の隣まで駆け戻ってきて、","冬夏小跑回我身边"],["肩と肩がふれあうくらいの近さで、","近到肩膀相触的距离"],["「ほら」","「瞧」"],["同じ速度で、歩き始めた。","以相同步调走了起来。"]],"context":[["SC_M_030.ks/index/1/text"],["SC_M_030.ks/index/3/text"],["SC_M_030.ks/index/5/text"],["SC_M_030.ks/index/7/text"],["SC_M_030.ks/index/9/text"],["SC_M_030.ks/index/11/text"],["SC_M_030.ks/index/13/text"],["SC_M_030.ks/index/15/text"],["SC_M_030.ks/index/17/text"],["SC_M_030.ks/index/19/text"],["SC_M_030.ks/index/21/text"],["SC_M_030.ks/index/23/text"],["SC_M_030.ks/index/25/text"],["SC_M_030.ks/index/27/text"],["SC_M_030.ks/index/29/text"],["SC_M_030.ks/index/31/text"],["SC_M_030.ks/index/33/text"],["SC_M_030.ks/index/35/text"],["SC_M_030.ks/index/37/text"],["SC_M_030.ks/index/39/text"],["SC_M_030.ks/index/41/text"],["SC_M_030.ks/index/43/text"],["SC_M_030.ks/index/46/text"],["SC_M_030.ks/index/48/text"],["SC_M_030.ks/index/50/text"],["SC_M_030.ks/index/52/text"],["SC_M_030.ks/index/55/text"],["SC_M_030.ks/index/57/text"],["SC_M_030.ks/index/59/text"],["SC_M_030.ks/index/61/text"],["SC_M_030.ks/index/63/text"],["SC_M_030.ks/index/65/text"],["SC_M_030.ks/index/67/text"],["SC_M_030.ks/index/69/text"],["SC_M_030.ks/index/71/text"],["SC_M_030.ks/index/73/text"],["SC_M_030.ks/index/75/text"],["SC_M_030.ks/index/77/text"],["SC_M_030.ks/index/79/text"],["SC_M_030.ks/index/81/text"],["SC_M_030.ks/index/83/text"],["SC_M_030.ks/index/85/text"],["SC_M_030.ks/index/87/text"],["SC_M_030.ks/index/89/text"],["SC_M_030.ks/index/91/text"],["SC_M_030.ks/index/93/text"],["SC_M_030.ks/index/95/text"],["SC_M_030.ks/index/97/text"],["SC_M_030.ks/index/100/text"],["SC_M_030.ks/index/102/text"],["SC_M_030.ks/index/104/text"],["SC_M_030.ks/index/106/text"],["SC_M_030.ks/index/109/text"],["SC_M_030.ks/index/111/text"],["SC_M_030.ks/index/113/text"],["SC_M_030.ks/index/116/text"],["SC_M_030.ks/index/118/text"],["SC_M_030.ks/index/120/text"],["SC_M_030.ks/index/122/text"],["SC_M_030.ks/index/124/text"],["SC_M_030.ks/index/126/text"],["SC_M_030.ks/index/128/text"],["SC_M_030.ks/index/130/text"],["SC_M_030.ks/index/132/text"],["SC_M_030.ks/index/134/text"],["SC_M_030.ks/index/136/text"],["SC_M_030.ks/index/138/text"],["SC_M_030.ks/index/140/text"],["SC_M_030.ks/index/142/text"],["SC_M_030.ks/index/144/text"],["SC_M_030.ks/index/146/text"],["SC_M_030.ks/index/148/text"],["SC_M_030.ks/index/150/text"],["SC_M_030.ks/index/152/text"],["SC_M_030.ks/index/154/text"],["SC_M_030.ks/index/156/text"],["SC_M_030.ks/index/158/text"],["SC_M_030.ks/index/160/text"],["SC_M_030.ks/index/162/text"],["SC_M_030.ks/index/164/text"],["SC_M_030.ks/index/166/text"],["SC_M_030.ks/index/168/text"],["SC_M_030.ks/index/170/text"],["SC_M_030.ks/index/172/text"],["SC_M_030.ks/index/174/text"],["SC_M_030.ks/index/176/text"],["SC_M_030.ks/index/179/text"],["SC_M_030.ks/index/181/text"],["SC_M_030.ks/index/183/text"],["SC_M_030.ks/index/185/text"],["SC_M_030.ks/index/187/text"],["SC_M_030.ks/index/189/text"],["SC_M_030.ks/index/191/text"],["SC_M_030.ks/index/193/text"],["SC_M_030.ks/index/195/text"],["SC_M_030.ks/index/198/text"],["SC_M_030.ks/index/200/text"],["SC_M_030.ks/index/202/text"],["SC_M_030.ks/index/204/text"],["SC_M_030.ks/index/206/text"],["SC_M_030.ks/index/208/text"],["SC_M_030.ks/index/210/text"],["SC_M_030.ks/index/212/text"],["SC_M_030.ks/index/214/text"],["SC_M_030.ks/index/216/text"],["SC_M_030.ks/index/218/text"],["SC_M_030.ks/index/220/text"],["SC_M_030.ks/index/222/text"],["SC_M_030.ks/index/224/text"],["SC_M_030.ks/index/226/text"],["SC_M_030.ks/index/228/text"],["SC_M_030.ks/index/230/text"],["SC_M_030.ks/index/232/text"],["SC_M_030.ks/index/234/text"],["SC_M_030.ks/index/236/text"],["SC_M_030.ks/index/238/text"],["SC_M_030.ks/index/240/text"],["SC_M_030.ks/index/242/text"],["SC_M_030.ks/index/244/text"],["SC_M_030.ks/index/246/text"],["SC_M_030.ks/index/248/text"],["SC_M_030.ks/index/250/text"],["SC_M_030.ks/index/252/text"],["SC_M_030.ks/index/254/text"],["SC_M_030.ks/index/257/text"],["SC_M_030.ks/index/259/text"],["SC_M_030.ks/index/261/text"],["SC_M_030.ks/index/264/text"],["SC_M_030.ks/index/266/text"],["SC_M_030.ks/index/268/text"],["SC_M_030.ks/index/270/text"],["SC_M_030.ks/index/272/text"],["SC_M_030.ks/index/274/text"],["SC_M_030.ks/index/276/text"],["SC_M_030.ks/index/278/text"],["SC_M_030.ks/index/280/text"],["SC_M_030.ks/index/282/text"],["SC_M_030.ks/index/284/text"],["SC_M_030.ks/index/286/text"],["SC_M_030.ks/index/28