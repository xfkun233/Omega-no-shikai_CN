56,"end":16683}],[{"start":16697,"end":16759}],[{"start":16796,"end":16809}],[{"start":16821,"end":16891}],[{"start":16928,"end":16931}],[{"start":16943,"end":16968}],[{"start":16980,"end":16981}],[{"start":16992,"end":17005}],[{"start":17042,"end":17052}],[{"start":17084,"end":17106}],[{"start":17120,"end":17131}],[{"start":17145,"end":17231}],[{"start":17245,"end":17334}],[{"start":17348,"end":17437}],[{"start":17451,"end":17473}],[{"start":17487,"end":17580}],[{"start":17594,"end":17707}],[{"start":17721,"end":17761}],[{"start":17775,"end":17826}],[{"start":17863,"end":17868}],[{"start":17880,"end":17931}],[{"start":17992,"end":17999}],[{"start":18031,"end":18058}],[{"start":18070,"end":18113}],[{"start":18125,"end":18192}],[{"start":18229,"end":18257}],[{"start":18294,"end":18354}],[{"start":18391,"end":18416}],[{"start":18453,"end":18488}],[{"start":18525,"end":18568}],[{"start":18600,"end":18680}],[{"start":18717,"end":18748}],[{"start":18785,"end":18808}],[{"start":18840,"end":18906}],[{"start":18943,"end":18988}],[{"start":19020,"end":19065}],[{"start":19103,"end":19182}],[{"start":19219,"end":19281}],[{"start":19313,"end":19335}],[{"start":19396,"end":19464}],[{"start":19496,"end":19558}],[{"start":19572,"end":19609}],[{"start":19620,"end":19621}],[{"start":19632,"end":19642}],[{"start":19656,"end":19707}],[{"start":19721,"end":19736}],[{"start":19774,"end":19810}],[{"start":19822,"end":19888}],[{"start":19925,"end":19931}],[{"start":19968,"end":20027}],[{"start":20065,"end":20085}],[{"start":20122,"end":20152}],[{"start":20184,"end":20249}],[{"start":20287,"end":20346}],[{"start":20378,"end":20406}],[{"start":20443,"end":20466}],[{"start":20503,"end":20551}],[{"start":20583,"end":20611}],[{"start":20674,"end":20701}],[{"start":20765,"end":20830}],[{"start":20842,"end":20857}],[{"start":20891,"end":20911}],[{"start":20943,"end":21034}],[{"start":21046,"end":21136}],[{"start":21148,"end":21199}],[{"start":21237,"end":21265}],[{"start":21277,"end":21316}],[{"start":21348,"end":21552}],[{"start":21618,"end":21629}],[{"start":21693,"end":21703}],[{"start":21734,"end":21756}],[{"start":21787,"end":21805}],[{"start":21847,"end":21857}],[{"start":21888,"end":21899}],[{"start":21937,"end":21970}],[{"start":22034,"end":22055}],[{"start":22086,"end":22134}],[{"start":22200,"end":22213}],[{"start":22245,"end":22250}],[{"start":22288,"end":22308}],[{"start":22340,"end":22390}],[{"start":22427,"end":22485}],[{"start":22497,"end":22520}],[{"start":22552,"end":22635}],[{"start":22649,"end":22827}],[{"start":22865,"end":22900}],[{"start":22937,"end":22956}],[{"start":22993,"end":23027}],[{"start":23059,"end":23102}],[{"start":23114,"end":23167}],[{"start":23181,"end":23259}],[{"start":23273,"end":23368}],[{"start":23382,"end":23442}],[{"start":23456,"end":23523}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_015.ks","basename":"SC_M_015.ks","indexIds":{"「………」":0,"「ご、ごめん………[l]\n":1,"吃":2,"驚しちゃって……」":3,"「…いえ、だいじょうぶです。[l]\n嫌われたとは思ってません」":4,"「………にぁ」":5,"「あ、いや、その…[l]\nそれは…なにより……」":6,"うう。[l]\n頼む狩屋、何とかしてくれ。":7,"「き、きーちゃ、\nあのほら、\n兄ぃも困ってる…よ？にぇ？」":8,"「……え…」":9,"「あ、や、おま！[l]\nやややや、\nそんなことはないけども…」":10,"それに対して僕から『うん、困ってます』とはレスれないだろが！[l]\nもう少し巧いパス出せ狩屋！[l]\n姫様ちゃんもそんな眼で見上げないで下さい…[l]\nというか解釈がいちいち極端じゃない？":11,"「あの、ただそろそろお昼だから、\nお腹が減って、頭が空回り気味なんだよね。":12,"君達と会って間もないし、\n緊張してるんだよ緊張、あはは…」":13,"「……成る程…」":14,"「にぁ、にぁるほどにぇ！[l]\nじゃあ、ほら邪魔しちゃ悪いよきーちゃ！":15,"兄ぃは今から昼ごはんにゃって！[l]\n…だぁね兄ぃ？」":16,"「そう、そうなんです！[l]\n宿に帰ってご飯を食べます！[l]\n…外食かも知れないけどとにかくそう！」":17,"「ん？[l]\n兄ぃ、空きっ腹にお茶にゃんか飲んだんか。[l]\n色々身体に悪いぜー」":18,"「そんな……」":19,"「そんな…って、え、いや、[l]\nアルコールじゃあるまいし、\n若いから大丈夫だってば…」":20,"「…あ…残りは私がこの身を以って……」":21,"と、僕の持っていたペットボトルにそー…っと手を伸ばす[l]\n姫様ちゃん。":22,"え？[l]\nあ？[l]\nそういうこと？":23,"「ややややきーちゃ！[l]\n":24,"おい兄ぃ！":25,"飲んじまえそれくらい！！[l]\nおま…兄ぃは若いからだいじょぶだ！！！」":26,"「あ、え、う、というか持って帰って飯の時飲むから\n心配しないで！":27,"胃に優しい状態で摂取しますから！[l]\n心配自体はありがとう！あはは！！」":28,"「そ、そうにぇ！[l]\n":29,"（…おま、じゃにゃい兄ぃ、きーちゃにへんな刺激すんにゃよ…）」":30,"姫様ちゃんに視えない角度に位置取り、僕に文句をつける狩屋。[l]\nいや、そもそもお前が言った一言から起きてる騒動だけどな…":31,"「…無念です……」":32,"「はは、はははは……」":33,"「にぁうぅ…[l]\nきーちゃといるときは兄ぃを揶えにゃい…」":34,"それはそれで僕はアリだけども、\n同時に別件で疲れそうだよ…":35,"大体僕とお前はそんなに打ち解けた仲じゃないだろ。え。[l]\n姫様ちゃんとも別に仲良くなった記憶というか、\nそんなフラグイベントあった覚えは無いけども…":36,"だから気を遣ってこうやって疲弊してるんだけど。[l]\n距離感が掴めないという意味で宮さんとどっこいどっこい、\nや、反応が読めるだけ宮さんの方がまだ疲れないか。":37,"まあいいよ、\n帰ったらその宮さんとまた、\n色々やり合わないといけないんだった。":38,"「はは、はぁ～あ……」":39,"と、一通り騒動が治まりだいぶ落ち着いてきたところで、\nつと疑念が湧く。":40,"彼女達は僕等のした事に気付いてるのか？[l]\nそれとも偶然此処で出会っただけか？":41,"──冬夏が彼女等が動き出した、と言っていた事も\n気になる。":42,"タイミングとしてはドンピシャだけに、\n僕としては因果を感じざるを得ないが…":43,"チノ嬢のは眼前の人間に対する読心術で説明がつくとしても、\n冬夏の場合は、もし勘やマグレでなければもはや遠隔視の部類だ。":44,"…なーんて、無理に超常能力を持ち出さなくてもいいんだが、[l]\n説明がつくことだったら冬夏も説明してたろうし、\n状況が状況だったからスルーしたが、\nなんだろうなあ。":45,"自己申告を信ずるならば、\nまさに女の勘という奴で片付く問題なのだけど。[l]\n冬夏までびっくり人間の仲間入りか…":46,"「移動しないんですか？」":47,"「は？[l]\nあ、そうね、\nそうします…」":48,"考え事をしていた訳だが、\n実際空腹で脳空転が始まってることもある。":49,"事態は立て続けに起きるし、\n脳内メモリも処理機能もオーバーロード気味です。":50,"クールダウンかリセットしたい。[l]\nそれはさておき──":51,"盗んだわけではないとは言え、\n罪悪感と警戒心を顔に出さないようにするのは容易ではない。":52,"挙動不審にならないよう気を付けながら、\n自販機小屋から素知らぬ振りをして移動を開始する。":53,"で。":54,"歩いている僕の後ろというより横に、\n姫様ちゃん、と狩屋がくっついて何故か移動し出すのだった。":55,"いや、この場合それが自然かも知んないけどさ、\n邪険に扱うのもあれだしどうしたら。":56,"ううう、早いところ帰りたいよもう。[l]\nこんな時に限って懐に秘密抱えてるし…":57,"「にぇー、きーちゃ、\n…あたしら一体何をしてんのかにぇ？」":58,"いつの間にか僕と姫様ちゃんの間に割り込んで歩く狩屋が、\n半笑い…いやさ苦笑いしつつ言った。":59,"「そのぅ…[l]\nやることがあるじゃにゃい？[l]\nあたしら？":60,"こいつ……え、いやいや、真言兄ぃも？[l]\n気ぃ遣わさして迷惑してるって感じ？":61,"ちゃっちゃとお別れしたほーが良くにゃい？[l]\n…かにゃーーーーって？だめ？ですか？」":62,"迷惑って…結局そう言わざるを得ないよな、[l]\nこいつの立場からすれば。":63,"僕も悔しいかな困ってるのは確かなのだ。[l]\nでもその物言いは…":64,"「……克杖」":65,"「――ひぐぅ・\nあ、あう、\nごめんなさい」":66,"「克杖にも分かって貰えると思ったのに」":67,"ほらみろ、って、\nえ？[l]\nなにを？":68,"「わ、わかんにゃいって！…て、にゃにを？かにゃ？」":69,"──まさかやっぱり視られていたのか？[l]\n僕今追い詰められてる？":70,"「真言さんに逢おうと思ってずっと探し歩いていたのです」":71,"「はい？」":72,"「にゃいぃ？」":73,"「というのは…冗句……」":74,"……ああ。[l]\nどうあれこの娘もそういう系か………":75,"照れてるだけまし、というか、\nそんなに真っ赤になるなら云わなきゃ良いのに…":76,"「ごめん姫様ちゃん、その手の":77,"揶 いはもう、\n職場で散々されてて…[l]\nちょっとトラウマ気味なんだよね……」":78,"そう云うと、ちょっとばかりむっとした表情と間を見せる。[l]\nバカが、という口パク＆視線で僕を責める狩屋。":79,"だってさあ。[l]\n只でさえ後ろめたいこの状況で敏感なってんだよこっちも。":80,"「にゅうう、きーちゃ、いつもはこんにゃじゃにゃいのに…」":81,"「本当の目的は…[l]\n秘密です」":82,"というと、いきなり黙って両手を伸ばし、\n僕の身体を検査するように触ったり見回したりする。":83,"「おわ、な、なに」":84,"て、やばい！[l]\n安心させといてそう来るかよ！！":85,"「んお！？」":86,"しかし、何か首を傾げて、僕の顔を何度か凝視して身体を離した。":87,"……あれ、懐の紙を見つけたんじゃないのか？":88,"あ、あ、焦った…[l]\n──でもじゃあ、一体なんだったんだ今の。":89,"「………？[l]\n":90,"私のことわかりませんか」":91,"「え？え？？[l]\n姫様ちゃん…のこと？」":92,"「というか、あ…いえ、いいです」":93,"な、何だろう。[l]\n逢った記憶は無いけども…[l]\n僕の記憶力ではどうにも、逢ってないという確証すらないのだ。":94,"この娘等も玄ノ森の育ちだろうし、\n幼少期に逢ってるとしたらもう絶望的だが、\n今年高校二年という事は、およそ三つ下…":95,"僕が居たあの頃よりさらに幼少期だったんだろ…？[l]\nお互いわかんないと思うけど…":96,"「でも真言さんに逢えたのはとても嬉しい偶然でした」":97,"は、はぁ…[l]\nでも、そうか、偶然ね。":98,"それが本当ならば、冬夏の監視をしに来たとかではないのだろう。[l]\n本当ならば、だが。":99,"まあボディタッチまでしておいて懐の紙に気付かなかったのだから、\nそうだと思うけど。":100,"で、結局なんでいきなりお触りしてきたのかは説明無しなんだ。[l]\nもういいけど…疲れたというか……心臓に悪い………":101,"「あのぅきーちゃ、あたしらはさぁ、\n大事な用事がさぁ……」":102,"悲しそうな眼で視るだけの姫様ちゃんの、\nその視線に対してすら、\n完全に萎縮する狩屋であった。":103,"ともあれ少なくともこいつに関しては、\n僕に対して興味無いようだし、\n嫌疑は掛けられてないと見て良かろう。":104,"だからと言っていつまでも同行されてはリスクも上がる。[l]\n出来れば早く二人と別れて帰りたいとこだけど…[l]\nあんまり帰りたがりの素振り見せて不審がられても困る。":105,"「へ、へー大事な用事があるんだ。":106,"僕もあんまり邪魔したくないし、\nあ、まさか二人でデートかなぁ？[l]\nなーんて」":107,"「にゃに？[l]\nあは、あははは、そんにゃあ、ねえ？[l]\n真言兄ぃったらぁん」":108,"姫様ちゃんの言い付け通り、\n漸く僕ともマトモに対応してくれるようになったのは良いが、\n…これで文武両道成績優秀だっていうんだからなあ。":109,"或る意味天は二物を与えてない、と言えるけど。[l]\nこの場合そのギャップが余計にあれだが…":110,"まあ、チノ嬢のような、見た目通りを心掛けられるのも\nどうかと思う。":111,"てかやっぱ否定しないのか狩屋。[l]\n一応カマかけのつもりではあったんだけどさ。":112,"「あの、真言さん」":113,"そして姫様ちゃんにはあっさりスルーされとるがな。[l]\n哀れなり狩屋…":114,"「今日は何をしてたんですか？」":115,"う。[l]\n単刀直入にして最も返答に窮する質問。":116,"当然全ての真実を語る訳にはいかないが、\n事実と異なりすぎる虚言を吐く訳にもいかず、\n平たく云えば有耶無耶に誤魔化す事にします。":117,"「此処の隣町の古い知人に朝飯を恵んでやって…」":118,"「……成る程…[l]\n流石は真言さん……」":119,"「にゃう…」":120,"「そう言えば、\n明日から学校なのですが。[l]\nそう、そうでした。そうなんです」":121,"姫様ちゃん、狩屋への対応は基本スルーなんだな…[l]\nだんだんほんとに哀れになってきたよ。":122,"「あー、\nそうみたいね」":123,"「あるイヴェントがありまして。[l]\n是非それを視に来て欲しいのですが」":124,"「に？[l]\nまさかミツハチにゃか？":125,"ととと突然にゃにを…[l]\nきーちゃ、あれは部外者立入禁止だし、\n大体にゃんでそんなことを」":126,"「……克杖…」":127,"「ひぐぅ…":128,"だ、え、えとぅ、\nまー理由はどうあれ、\n入れにゃいよ中に。":129,"あれは…」":130,"「だから考えないといけないんです」":131,"困っています…[l]\nと考えるポーズをとりながら歩き続ける。":132,"そうな、\n昨今、部外者を学校敷地内に入れるのは問題あるだろう。":133,"って話はそこじゃない。[l]\nや、まてまて待って下さい。":134,"「な、何の話をしてるのか、\nえ、えーとまずその\nミツバチだかハチミツだかっていうのは…」":135,"「にぇ？！[l]\nそっから訊くかお。":136,"これ……説明いいのかにゃあ…」":137,"「…克…」":138,"「はいはいわかりましたぁっ！[l]\n──…あんまり口外すんにゃよ兄ぃ」":139,"「あ、ああわかったよ」":140,"まず現時点で何のことやらわからんしな。":141,"「うちらの学校で、毎年新年度の春にやるんにゃわ。[l]\n──演劇」":142,"「演劇？」":143,"「『神使八乃舞（みづはのめ）』ちゅーの。[l]\n読み方は他にも幾つかあるらしーけど、\nあたしらは『みつはちのめ』と教わってるにぇー」":144,"字面を一字一次説明する狩屋。[l]\nみづはのめ…なあ。[l]\nどこかで聞いたような…ないような。":145,"「四月月末の祭…とは別個のイベントなのか？」":146,"「祭？[l]\nあー知ってたん。[l]\n有名になったもんだにぇー。":147,"ま、\n……基本無関係にゃよ」":148,"「根っ子は一緒ですが…」":149,"「あ、そのにぇ、\n両方確かにここいらの言い伝えとか絡みだよ、\nという事にゃさ。":150,"イベントとしては別ったら別」":151,"「へえ…[l]\nところで、演劇という事は学校行事だよね？":152,"この時期珍しいというかそれ以前に、\n新年度早々じゃあ稽古とかしようがないんじゃ…[l]\nあ、部の勧誘イベントとか？」":153,"「ちっがーよ。[l]\n新入生用行事てのは合ってるけど。[l]\nまあ…詳しく説明しにゃいけど伝統行事…にゃさ」":154,"「へえ…伝統行事。[l]\n僕が高校の時は応援団の新入生しごきとか\nあったけどな…」":155,"校歌教わる、という名目でな。[l]\n今となっては良い思い出、あれも一種の通過儀礼だよ。":156,"「にゃに遠い眼してるんだ兄ぃ。":157,"とにかく、\n前年度末に志望者を募って、年度越しに稽古にゃよ。":158,"だからクラスとか関係なく、特設部活動扱い。":159,"合唱部、演劇部、吹奏楽部…まー文化系は[l]\n人員自体少ないから大体そのまま参加な」":160,"「ふーん。":161,"僕が高校の時は熱血音楽教師があらゆる学年クラスから\n素養あるやつかき集めて、":162,"本人の意向関係なしに特設合唱部作って\n必死こいてコンクール出てたけどな…」":163,"「だから遠い眼をするにゃよ兄ぃ。":164,"にゃんかわかんにぇーけどそんなもん。[l]\nまー教員も異動あるから基本的にぜーんぶ、\n生徒の自主性に任せられるんな。":165,"春休み潰れるの前提にゃけど、\nうちは進学校じゃにゃいし、\n内申上がるって噂もあるけどまー、\n大体問題なくやってきてるにぇ」":166,"思春期に集団で事を成すのは好い経験だと思う。[l]\n酒も無いのに無駄にハイテンションなれるしなー。":167,"実際がどうであれ意味無く感動したり、\n何よりこういう時期の経験は将来酒の肴になるのだよ、\n若人達。":168,"何にでも効率的実利を求めても、実際必要なのは潤いだという場面がいつか来るんだ…[l]\nウフフ……":169,"「…さっきから過去ばっか振り返って、兄ぃ幾つにゃよ。":170,"…そういや兄ぃ、冬夏ちゃと知り合いなったようだけど、[l]\n冬夏ちゃの家のご威光は心しときにゃよ。":171,"あんま目立った事すると地元居残り組に眼ぇ付けられるじぇ」":172,"「え、ああ。[l]\n真摯に聞いとくよ…[l]\nところで一向に本題に入ってない気がするんだけどさ…」":173,"「んあ？[l]\nまー今のもあながち無関係な話じゃないけどな…":174,"その劇を、\nえー、\nきーちゃ？」":175,"「それを是非御覧に入れたいのですが…[l]\n問題が」":176,"「どういう理由か詳しくは……知らにゃいけどな、[l]\n昔から父兄含めて客入れにゃいんだ。":177,"生徒と教師しか観られにゃい。[l]\n単に神秘具合をあっぷする演出だと思うけどにぇ。":178,"一子相伝？古今伝授？[l]\n自分達だけが知ってる、ていう仲間内の秘密意識共有の喜びぃ？":179,"ともかく祭りとは別個にゃのさ、そーゆー事情で観光資源になんにぇーから。":180,"ま、この辺の人間は親子でおんにゃじ学校通う事多いから、\n居残り組の家は親子共々知ってる事はあるにぇえ」":181,"はあ…[l]\n此奴はほんとに口調が突拍子無いだけで、\nそこそこに難しい事も知ってるんだねえ。":182,"学業も成績優秀てのは嘘ではないらしい。[l]\nまともな喋り方すればそれなりに視えそうだけどな…":183,"こいつ独自の処世術かしらん。[l]\nところで、":184,"「や、そのイベントがシークレットな理由は良いんだけどさ。[l]\n何でそれを僕が観なきゃいけないん…でしょうかね？」":185,"「真言さん、そういうのを視に来たのでは？[l]\n玄ノ森の伝……」":186,"そこで言い淀む姫様ちゃん。[l]\n否、声が小さくなっただけだ。[l]\nしかし、あれ？":187,"「え？[l]\n僕そう言ったっけか…」":188,"ど、どうだったっけ。[l]\nどうもこうも、\n何も説明してなかった記憶がするが…":189,"「……克…」":190,"「え、そ、そこであたしに振るかなっ？！[l]\nだ、でー、他に理由もにゃいだろー？":191,"旅行でこんなとこ来たってさー。[l]\n兄ぃぱっと見そっち系ぽいし…」":192,"どういう意味やねん。[l]\nともあれ、只の推測という事か。[l]\nで、何で自分で言わないの君は。":193,"「…それで、今年は特に三春家の娘、[l]\nつまり冬夏さんが主演になるんですけど」":194,"それは初耳だが、…あ、そうか。":195,"冬夏が言ってた春からユウウツってそれの事かもな。[l]\n隠してたのかな、わざわざ言わなかったという事は。":196,"じゃあ、観に行ったら嫌がられる気がするぞ。[l]\n只でさえ部外者タブーな上に…姫様ちゃんとの仲は芳しくないようだし、":197,"──て、\nえ、まさか姫様ちゃん、嫌がらせのつもりじゃないよなこれ。":198,"「今更ですが…[l]\n演劇というと語弊があります…":199,"歌劇、とでも言いましょうか。[l]\n歌や踊りがメインで」":200,"「素で台詞喋ったりはしにゃいからな、\nオペラみたいなもんだにぇ。[l]\nま、観ればワカル」":201,"「言うなればその…プリマ－ドンナとして謳うのが冬夏さん。":202,"是非聴いてあげて欲しいのです。[l]\n冬夏さんのためにも」":203,"「ええと理由がいまいち良く分かんないけど、\nまあこう、強行した処で特に問題にならない、\nていうんだったら、とも思うけどね…」":204,"基本的にまず不法侵入というか無断立入だよね。[l]\n今さっき冬夏の家の蔵に潜入してますがね。[l]\nどっちがやばいんだろ法的には？":205,"というか素直に正面から招待してくれる…とかは無理なのな。":206,"冬夏が言えば通りそうな気もするが、\nおっかさんとあんな感じな上に、\n本人がそもそも隠してたようだし、無しだろうなあ。":207,"にしても、\nこの状況もどうだろう。[l]\n立場が逆でないか。":208,"「それは…何とか考えます……[l]\n……私達で」":209,"「にぇ！！[l]\nあたしもぉ？！」":210,"ええと、宮さんというか、本家の仕事の為になるんであれば、\nここはゴーしても好い…のかなあ……":211,"僕は空腹と眠い時の空転脳での判断にひとっつも信頼を\n置いてないんだが…":212,"今の状況でした決断が是か非か、\n…判ってればそもそも空転脳じゃないんだけどな。":213,"蔵に入れた直後の所為か、\nちょっと気が大きくなってるというか、\n調子に乗ってるというか、\n多少のアレはアリなノリになってんのは確かなんだよ。":214,"いかんいかん、危険な兆候だ…":215,"「と、ところで具体的にはどういう中身…[l]\nかは説明出来ないか、そもそも…」":216,"「あれはなんつーかなー、\nどっちにしろ説明不可能にゃわ。[l]\n実際見聞きして当人が感得するしかにゃい」":217,"「それも実地で視て貰いたい理由…なんです」":218,"「へえ？[l]\n何でだろ？」":219,"「何語かわかんにゃい言葉を遣うからさ」":220,"「何語か判んない？[l]\n外語でもないのか？」":221,"「ミ・カヤミャルカヤミャルキャラタサ・ワ、\nミ・ミャルミャルキャキャラコネミャルカヤ・ワ、\nとか」":222,"姫様ちゃんは、謳うように抑揚をつけてその謎言語を発してみせてくれた。":223,"…あれ？[l]\nこれはどこかで聞きましたよ……？":224,"「『みゃんみゃんきゃらきゃらわ』じゃないか」":225,"チノ嬢が今朝言っていたあれに、\n非常によく似ている。":226,"「にゃんだかみゃんだか知らにゃいけどな、\nま、こんな調子だにぇ。[l]\n…そのリアクションは何よ。[l]\n知ってるんか？」":227,"「あ？[l]\nいやいや別にそういうわけじゃないけど」":228,"「ふーん、ま、そりゃそうにゃわ」":229,"演者側からすると、\n歌詞も台詞も意味不明な言葉だから、\n音の連なりに情景を想像して感情を乗せなければならず、\n結構大変なのだそうだ。":230,"しかも、それらの口語訳を知ってる人間は居ないらしい。":231,"卒業生や教員の誰某（だれそれ）が知ってるとかいう噂が\nあったり、":232,"生徒が趣味の範疇で解釈を試みたりは稀にあるらしいが、\n何故なのだか、誰が言い出したのか解読はタブーとされているらしい。":233,"解読すると発狂するとか呪われるとか、\n学校の怪談みたいな話になってるんだと。":234,"「うーん謎言語ねぇ。[l]\nナニャドラみたいなもんかなあ」":235,"「にゃんだって？」":236,"いや、いい。[l]\n多分君には分かって貰えない。":237,"「ナニャドラ…」":238,"「え、まさか知ってますか…」":239,"「……うちの御土産屋は土地の民話の語り部ショーも\nありますからそちら系の話は…それなりに」":240,"ああ、そういや嘉多里辺茶屋ってそういう土産屋だったね。":241,"って何で恥ずかしそうにする。[l]\nまるで僕が変な知識満載の人、\n克つそれは恥ずべきことみたいじゃないかよ。":242,"「にゃんだそっち系の話か…":243,"まままーそーいえばっ？[l]\nきーちゃの店員姿も久しく視てにゃいなーっ、\n家が落ち着いたらまたあたしも手伝い行くからさぁー」":244,"「今は":245,"運姉様が仕切ってるから…[l]\nそれにまた":246,"在":247,"夜に悪戯したら怒られるよ」":248,"「しにゃいってば…」":249,"運、在夜とは、例の姫様ちゃんの姉妹の事かな。":250,"狩屋お前見境なしかよ…":251,"ともあれ謎言語、\n解読も何も音節で切ると言語としては種類が少なすぎるらしい。[l]\n殆ど暗号並て事かしら。[l]\nあんまりそういう話わかんないけど…":252,"蛋白質合成時のコドンみたいな奴なら４種の塩基で２０のアミノ酸\n作れるのだから出来ない相談じゃないのかもだ、が、\n解析不能というか不可逆性の変換式になるような気が…":253,"セントラルドグマ？だっけ？まあいいや。[l]\nともあれその言語の具体的な音節数も聞いてないし、\nこれ以上は呪われるのも厭だし、\nもう考えないようにします。":254,"それ以前にそういう体調じゃないんだってもう。":255,"で、彼女等が言うに、\n基本的には八乙女…八人の少女の神楽舞という雰囲気だそうだが、[l]\n様式としては独自性に溢れているというか、\n要するに本来的では無いらしい。":256,"本来的なのがどうなのか、僕も知らないんだが、\n色々旅行して、そこそこ各地の祭は観たりした経験から言えば、\nそういう由来というか故事来歴、本来的非本来的があやふやなのは、\n結構存外に在るもんなんだよなー。":257,"──今更だけど、\nそこまでバラされてる時点でもう秘密もへったくれもない…":258,"て、ああ、実地で観る事に意味があるんだっけ。[l]\nとそこで、バツが悪そうに狩屋が切り出した。":259,"「あー……":260,"それ以前に、問題というか、\nそもそもあれ１２日にゃよきーちゃ…[l]\n明々後日だよぅ」":261,"「あ、そうか」":262,"しししし明々後日ぇ？！[l]\n早！早すぎるよ！":263,"それぁつまり今決断しないといけないのか？[l]\nちょちょ、ちょっと待ってくれ…":264,"こここここここのアタマで判断しろと？！[l]\nコンディション最悪なんですけど！！[l]\n思わず立ち止まってしまいます！":265,"「新入生に混じればわかん…生徒数が少なくて無理かにゃあ」":266,"「でも……[l]\n新入生は学校始まってすぐでしょう……[l]\n同級生の顔なんかわかんないと…思うな……」":267,"「中学少にゃいからみんな顔見知りかもだけどにぇ…」":268,"「始まって暗くなってからなら…[l]\n誤魔化せるよ…ね……？」":269,"「ね……？って、[l]\nどどどど、どうだろぅ…[l]\n兄ぃ大丈夫か？」":270,"知らんがな！[l]\nてか何の話をしてる？！[l]\n君等はすたすた歩きっぱなしだしさ！[l]\n当人を置いてけ堀にして何の話をしてるんです！":271,"「あ…はい。[l]\n真言さんにうちの制服着て貰って…」":272,"「あたしら用意できるの女子用しかにゃいから…」":273,"それはつまり冬夏がおんなじような案を先日提言してきた\nあの話ですか？[l]\n折角回避した筈のあの話になるんですか？！":274,"「ウィッグは何とか準備します…ので、[l]\n真言さん線が細いから似合うと思います」":275,"こっちを視たままようやく立ち止まった二人の元まで、\nなんとか駆け寄り弱弱しく抗議。":276,"「いやあの姫様ちゃん、\n貴女も結構変な押しの強さがある模様ですけども、\nまず僕はまだ行くと決めた訳でもないし、\n似合うとかの問題では」":277,"「ンモー、\nもうここまできたら覚悟決めにゃよ。[l]\nあたしにはもうきーちゃに協力するしか選択肢は無いしー」":278,"ンモーってお前は昔の四コマ漫画の登場人物か…":279,"「では、運姉様のお下がり持ち出してきますので…[l]\n明日の放課後で良いでしょうか。[l]\nメイク…は……どうしよぅ…」":280,"それは最悪宮さんに事情を説明して…[l]\nや、知狡さんに御願いしよう…[l]\nいやいやそういうことじゃない。":281,"君等を恨むべきか僕自身のこの巻き込まれ特性を恨むべきか、\nいったい":282,"何":283,"時から僕はこんなだ？":284,"幼少時の記憶があまりに曖昧で、\nもうこうなったら宮さんとの出逢いの瞬間を以って僕は……て、あ。":285,"携帯で宮さんに相談してみるか。":286,"「あの化粧なんかしなくても、\n暗がりだったらわかんないと思うよ…":287,"髭だけはしっかり剃って行きます…の前に、[l]\nちょっと良いかい？[l]\nその…僕、今電話で連れに相談したいんだけ」":288,"「駄目です」":289,"「ばか、兄ぃ、\n秘密の行事だって言ってんにゃろ。[l]\nきーちゃは………兄ぃだからこうその…にゃうぅ」":290,"「あ、ご、ごめん…ごめん？というかその」":291,"「誰かにばらしたら…[l]\n真言さんが困るのに……」":292,"えい？[l]\nなんで？[l]\n潜入に失敗すれば確かに困るけども…[l]\nというよりだから立場が逆だろうさ？":293,"「で、でも、仮に僕が独り潜入して、\nもし見つかったらどうするんだ？[l]\n君等何とかしてくれるのか？」":294,"見つかったら潜入犯だけでなく女装者の烙印まで付くんだぜ。":295,"「大丈夫…[l]\n選律さんも来るから」":296,"「センリツぅ？[l]\n──あ、そうにゃるか、\nいやきーちゃ、選の字をアテには…」":297,"誰だよその人は。[l]\nそして何で大丈夫なのよ。":298,"「とにかく、\n絶対に後の始末は保障しますので」":299,"「…しょうがにゃいな、[l]\n気乗りしなかったから黙ってたけど。[l]\nあたしは舞台の裏方で色々任されてるにゃさ。":300,"ブラバンとも付き合いあるし、\n":301,"何とか引き入れと退場は面倒みてあげらー」":302,"笑ってんのか嘆いてんのか判らん表情を浮かべ、\n僕の肩を叩く狩屋。[l]\nそんな大事なファクター黙ってんなよ。[l]\n裏方って、ああ、体力系でもあったなお前は。":303,"でもやっぱり女子制服着用は逃れられないんですか…[l]\nにしても狩屋、気乗りしてないとか言ったり、\n黙って隠してたり、\n姫様ちゃんに怒られるんじゃないのか。":304,"…ほれ、彼女恨めしそうに視とるぞ。[l]\nそして姫様ちゃん、君もそもそも気付かなかったんかい。":305,"「あーもうわかったわかった！[l]\n僕がしっかり":306,"熟せば良いんだろ？[l]\nその代わり狩屋、マジお前を頼りにするからな」":307,"強気なんだか弱気なんだか我ながらよく分からない言い草に。[l]\n今のを聞いた上でリスクとリターン検討し、\nこれはゴーだと判断しました。[l]\n空腹の空転脳でな！[l]\n好奇心というか宮さんへの奉仕心が勝ったのです。[l]\n…好奇心猫をも殺すという厭な諺もあるけどな。[l]\n何とかなるだろ、いやさ何とかします！！[l]\n──しないと大変だ………ううう。":308,"「あぅ…克杖ずるい…」":309,"「え？にゃ？[l]\n":310,"ば・なんもにゃいってこいつ…兄ぃも！[l]\n":311,"そんな意味では言ってにゃいよ・ね！？":312,"そうだな！？[l]\n":313,"そうだと言えばか！！」":314,"「そ、そうです、こいつのことは利用するだけ利用するって意味です！」":315,"「んだとこのやろ…いやそうにぇす。[l]\n":316,"それだけの関係にゃのあたしたちは！[l]\nきーちゃの手を煩わせるに及ばにゃいってだけ！」":317,"「……いいですもぅ………」":318,"いじけた…":319,"「──あ、もうそろそろほんとにお昼を…」":320,"お二人には悪いが、\nもうこれ以上面倒な思考は無理だ、もう無理。[l]\n喰わねばよぅ。":321,"「おうあ！[l]\nそうそうそうそうそうそう！！[l]\nあたしらこれから二人っきりでご飯だもんにぇー！":322,"邪魔すん…しにゃいでね♪[l]\n兄ぃ」":323,"…まあ、今の状況ではこっちもそれで助かるんだが……[l]\nこの懐の紙もあるしね。[l]\n狩屋、姫様ちゃんへのフォローは任せた。[l]\n頑張れ。":324,"ともあれ、携帯番号を交換し待ち合わせの時間場所を決め、\n明日放課後会う事となった。明後日の開演前夜は流石に忙しいのだと。[l]\nこっち来てからこんな事ばかりやってる気がするぜ…[l]\n携帯のメモリーに女子の番号がこんなに登録されるとは、\n不肖わたくし生涯初かも知れません。[l]\n…あんま嬉しくもないけどこんなでは。":325,"「えと…じゃあ、[l]\nよろしく＆さよなら…でいいよね…え？」":326,"「はい。[l]\n残念ですけど」":327,"「あとは任せにゃって、真言兄ぃ。[l]\nさよぉにゃらぁあ～」":328,"手を繋いで、というか克杖が一方的に姫様ちゃんの手を\n握って、歩み去って行った。":329,"ふーん……[l]\n結局この出会いは偶然だった様だ。[l]\n早いところ帰って宮さんに…報……":330,"──そう、申し訳ないが、\nこの件は宮さんには伝えねばならないだろう。[l]\n間諜のようで…ようでも何も、端から僕はそのものに近い役割なのだ。":331,"そもそも、飯窪本家も此処、玄ノ森に住まう者として、\n或る程度は既知の事実かも知れないし。[l]\n心は痛むが仕方ない。[l]\n何かあったら責任持って君等に弾劾されよう…":332,"にしても、\nいい加減、僕はもうそういう星廻りと思うべきなのか？[l]\n次から次へと事が起こるわ起こるわ…":333,"禍福は糾える縄の如し、塞翁が馬、\n今度の決断はどう転ぶのだか…[l]\n乞う御期待、何て言ってられるレベルであってくれ…":334},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_015.ks","relPath":"/data/scenario/SC_M_015.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":334,"length":335,"percent":99.70149253731343},"cellInfo":[null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"t":"HU"}],[null,{"t":"HU","v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[121,1],"note":"完成"},"/data/scenario/SC_M_016.ks":{"data":[["「………[l]\nおかえり」","「………[l]\n欢迎回来」"],["「…ただいま帰りました。[l]\n今日は居たんですねなんだか久しぶりですね、って、\n──なんすかそのテンション」","「…我回来了。[l]\n今天居然在啊感觉好久不见了，话说，\n──这莫名高涨的情绪是怎么回事」"],["「まこくんから他の女子の匂いがするっ」","「真身上有其他女生的味道呜」"],["「！？[l]\nえぇええ、\nそ、そうすか？[l]\nや、だって今日は…」","「！？[l]\n诶诶诶，\n真、真的吗？[l]\n不、因为今天…」"],["「うひひ、\n分かってます。[l]\nやぱーり揶い甲斐がありますねっ♪」","「呜嘻嘻、\n我明白的。[l]\n果然戏弄起来很有快感呢♪」"],["「ねっ♪\nじゃないすよ。[l]\nそんなに匂います？」","「对吧♪\n才不是啦。[l]\n有那么明显吗？」"],["「んむぅ、冗談ですってば。[l]\nまこくん結婚したら大変だね…」","「嗯嗯~都说是开玩笑啦。[l]\n小真要是结婚了可不得了呢…」"],["「しなくたって今現時点でまさに大変ですよ…[l]\nそんな事よりですね、」","「就算不结婚现在也已经够呛了…[l]\n比起这个啊，」"],["結局電話もせずに旅館に戻ると、\n入るなり宮さんと鉢合わせたので、\n飯も喰うのも忘れて、\n彼女に詳しい顛末を一通り話した。[l]\n昼間でも居るときは居るんだな。[l]\n全く、電話先にしとけば良かった。[l]\n姫様ちゃん達に止められてからすっかり忘れてたよ。[l]\n嗚呼、昼飯のタイミングが…[l]\nしかしそんな処に気が回るのであれば、\nそもそも空転脳ではないのです。ないのですよ。","结果没打电话就直接回旅馆，\n刚进门就撞见宫小姐，\n连饭都顾不上吃，\n把事情经过详细给她讲了一遍。[l]\n白天偶尔也会在嘛。[l]\n早知道该先打电话的。[l]\n被姫様她们拦下后就完全忘了这茬。[l]\n啊咧、午饭的时机…[l]\n不过既然能注意到这种细节，\n说明我本来就不是空转脑嘛。绝对不是啦。"],["「あと何か僕、本家の地下行ってから、\n何か眼の調子がおかしいんですけど、\n連日宮さん達に遊ばれてもう疲れてるんですかね…[l]\n病院行くか薬投入か、とにかく何か対処をしたいんですけど」","「还有啊我从本家地下室回来之后，\n总觉得眼睛不太对劲，\n该不会是被宫小姐她们连日折腾累垮了吧…[l]\n想去医院或吃药，总之得想点办法」"],["なんだかんだ言って実際倒れてしまった訳で…[l]\n厳密にはおかしくなったのはその後だが、\n卵が先か鶏が先かというやつでひとつ。[l]\n……喩えが違うか。","虽然嘴上这么说实际已经倒下了…[l]\n严格说来异常是之后才出现的，\n算是先有鸡还是先有蛋的问题吧。[l]\n……好像比喻不太对。"],["「え、憑かれてる？」","「咦，被附身了？」"],["まあ或る意味そんな気もしてますよ。[l]\n何に、かは言わずとも。","某种意义上确实有这种感觉。[l]\n至于是被什么附身就不明说了。"],["「で、例のきぃ…西石も居る、[l]\n心当たりはあるにはあるんですが…」","「对了，那个小贵…西石也在，[l]\n线索倒是有那么一点…」"],["長久診療所、\nと言うと、","长久诊所，\n刚说出口，"],["「んむ？[l]\n其処って」","「嗯唔？[l]\n那里是」"],["早速難色を示された。","对方立刻面露难色。"],["「ああ…そうなんです。[l]\n三春の関係ですねぇ……[l]\n今日そこの誰だかが帰ってくるとかで、\nその御蔭で今日の色々が出来たんですが。[l]\n──やっぱり","「啊…是的。[l]\n和三春家有关呢……[l]\n听说今天那边有人要回来，\n托这个福今天才能办成这些事。[l]\n──果然"],["拙そうですかね、\n確約した訳じゃないんでどうとでも出来ますけど、\nそん時は何かしら見繕ってくださいよ？」","不太妥当吧，\n虽然没明确约定过可以灵活处理，\n到时候请帮忙周旋下？」"],["「……無言」","「……无语」"],["口に出てますがな。","明明都说出口了啊。"],["「…んむーぅ。[l]\n迷います。[l]\nどっちが良いのか……」","「…嗯唔——[l]\n好纠结。[l]\n哪边更好呢……」"],["「え？[l]\nどっちとは？[l]\n僕の体調なんてどうでも、という意味ですか、\nそれとも」","「咦？[l]\n您说的哪边是指？[l]\n是说我的身体状况怎样都无所谓的意思吗，\n还是说」"],["「だってぇ、\n今の時点で、\nまこくんは三春関係者の娘達と","「因为啊，\n就现阶段来说，\n小真你已经和三春家相关人员的女儿们"],["悉く接触してるんで…」","全都接触过了呢…」"],["う。[l]\nま、まあ確かに、\nこっち来てからほぼ連日挙って次から次へと、\nまるで示し合わせたというか、競うかのように関係者が現れてる。","呃。[l]\n嘛、嘛确实，\n自从来到这边几乎每天都有接二连三，\n简直像约好了似的，又像在比赛般不断出现相关人员。"],["お膝元なんだから当然と言えば当然なんだけど。","毕竟是大本营，要说理所当然倒也是理所当然。"],["「でもそれぁ僕の所為じゃないでがしょ？！[l]\n不可抗力ですよ、僕が手招いた訳では決して！」","「但这又不是我的错吧？！[l]\n都是不可抗力啊，绝不是我把她们招来的！」"],["「それはどうかな…[l]\nへっへっへ」","「这可说不准呢…[l]\n嘿嘿嘿」"],["…何の意味の笑いですか。","…这笑声是什么意思。"],["しかし、\n実際向こうの方から何故か、\n僕に対し秘密の開示を積極的にして来てるという事実、\n二件目に突入という訳だ…","不过，\n实际上不知为何，\n对方确实在主动向我透露秘密，\n这已经是第二桩了…"],["「ま、『不可抗力』なのは認めます。","「嘛，『不可抗力』这点我承认。"],["でねでねでね、\n長久診療所の…亡くなった人間は三春の主治医でしたし、[l]\n今日の色々というのは、その代わりを連れてきたんでしょう。","然后呢然后呢，\n长久诊所的…死者生前是三春家的主治医师，[l]\n今天这些事，就是带替补过来的缘故吧。"],["恐らく実の娘ですね、あそこは中央に勉強に出してた…\nと聞いてます。[l]\n知狡から」","恐怕是亲生女儿，听说那家把女儿送去中央进修…\n这么听说的。[l]\n从知狡那儿」"],["「成る程、\nそう言えばきぃがヒミコさんとか呼んでたかな…」","「原来如此，\n这么说来小贵是不是称呼她为卑尊小姐来着…」"],["「知狡によれば","「据知狡所说"],["永","永"],["久","久"],["卑","卑"],["尊ですね。[l]\n今後は彼女が三春のお抱え先生という事になるんでしょうね」","尊没错。[l]\n今后她就是三春家的专属医生了吧」"],["「はあ、\nもう誰が誰やらですよ僕にとっては。[l]\n三春の系列って他にも居るんでしたっけ？」","「哈啊，\n对我来说已经搞不清谁是谁了。[l]\n三春家派系还有其他相关者来着？」"],["「えっと、丁度良いので整理しときましょうか。[l]\n此処、玄ノ森には有力者として三春の家が在りまして」","「呃，正好趁现在整理下吧。[l]\n此地玄之森作为权贵驻扎着三春家，"],["人死にの出た二家、\n綾目、つまり姫様ちゃんの家で土産屋、\n永久、つまりきぃのバイト先の診療所、\nそれと狩屋、あの生意気女の家。","出现死者的两家，\n绫目家即姫様家的土产店，\n永久家即小贵打工的诊所，\n还有狩屋家，那个嚣张女的家。"],["「でですねえ、\n西國の方に更に三家の縁者が居て、祭に集合、\nと此処までは知狡からの情報で判ってるわけですね。","「另外啊，\n西国那边还有三家姻亲，祭典时会聚集，\n这部分情报都是从知狡那儿得知的。"],["そちらはそれこそ祭にならないとこっちに来ないでしょうから、\n現状接触は無いと思いますけど…[l]\n昨日今日のまこくんを視てると怪しいものです」","那边的人不到祭典应该不会过来，\n现阶段应该不会接触…[l]\n但看小真这两天的情况实在可疑呢」"],["そんな事言われましても…[l]\n僕とて好き好んでこのような事態を望んでる訳じゃ\nないんですよぅ。","就算你这么说…[l]\n我也不是心甘情愿\n希望变成这样的啊。"],["もし、これで西のその人等が先入りとかして来て、\n早々に僕に接触してくるような事態になれば、\nそれこそもう僕ぁそういう能力者だと思う事にします。","要是连西国那些人都抢先，\n早早跑来接触我的话，\n那我真要怀疑自己是不是有这种吸引事件的体质了。"],["…店に入った途端、ガラガラだった店内に次々と来客し始める、[l]\nというよく聞く話みたいだな。[l]\nあんな、自分がさも客を招き寄せたんだぜ、\nと","…就像刚进店门，空荡荡的店里突然接二连三来客人，[l]\n那种常听到的故事。[l]\n那种一个劲儿吹嘘‘看吧，\n还"],["宣","是我把"],["巻く方々みたいなのは個人的にはヤだな…","客人给招来的哟’的人，我个人实在不太喜欢啊…」"],["まあ、そんな事態にそもそも今度ばかりはなんないだろう、\nという希望的、否、常識的観測があるから言えるんだけど。","嘛，这次应该不至于发展到那种地步吧，\n正因为有这种希望性的、不、常识性的预测才能这么说。"],["「でも今日の件のようにですね、\n実際はもう既に、思いっきり懐に入っちゃってる訳です。[l]\n零距離射撃ですよねぇ。","「但像今天这种情况啊，\n实际上对方已经彻底钻进我们怀里了呢。[l]\n根本就是零距离射击嘛。"],["でも今回の成果を考えると\nいっそ積極的に取り入る方向に修正した方が…[l]\nと思いまして。","不过考虑到这次成果\n干脆主动调整成积极接纳的方针比较...[l]\n我是这么想的。"],["何より、まこくん彼女らに気に入られてるようだし？[l]\n飯窪本家とも相談しないとですけど、\nこうなったら、\nまこくんの色仕掛けで懐柔してもらうのもアリかなーと」","最重要的是，小真好像很受她们欢迎？[l]\n虽然还得和饭洼本家商量，\n事已至此，\n靠小真的美男计来怀柔也未尝不可吧」"],["あの、僕は、\nそもそも顔が割れてないという理由で担ぎ出されたのだ。","那个，我啊，\n本来就是因为没暴露长相才被拉来的。"],["そうでしょ？[l]\n単なる荷物持ちとか言われてた気もするけど、\nそれ抜きにしてももう関係ないて？？","对吧？[l]\n虽然记得有人说过我就是个搬行李的，\n但就算抛开这个现在也无关了吧？？"],["「いやいやいやいや、\n冬夏とかはともかく、\n母親の方はもう、けんもほろろですし！","「不不不不，\n冬夏暂且不论，\n她母亲那边已经冷若冰霜了！"],["冬夏だって僕等の真意を知ったらどう反応するか…」","冬夏要是知道我们的真实意图会作何反应..."],["というかそうでもしないと僕がわざわざ色んな物を捨ててまで\n此処に来た意義が薄まっちゃうでしょう。","倒不如说不这么做的话，我特地抛弃各种东西\n跑到这里的意义不就淡了吗。"],["学校に関しては諦めたとはいえ、\n僕とて多少は心に折り合いつけて生きてるつもりなのに…","虽说关于学校的事已经放弃了，\n但我多少也打算在心理上妥协着活下去..."],["「でも話を聞く限り、冬夏ちゃん自身は情報流出を\n望んでるように思えますけど。","「但听下来，冬夏酱本人似乎\n希望信息泄露呢。"],["古い因習に嫌気がさした若者ってやつ？[l]\n普通はそういうのは雑魚キャラなので手懐けてもしょうがないんですが、何しろ冬夏ちゃんはヒロイン格ですからねー。","就是那种厌恶陈规陋习的年轻人？[l]\n通常这种杂鱼角色收服了也没用，但冬夏酱毕竟是女主角待遇啊—"],["姫様ちゃん達も何かまこくんに御執心のようですが、\n彼女達同士が険悪ではちょっと気を遣わないといけない\nかもですし。","姫様她们好像也对小真很有意思，\n不过她们之间关系紧张的话就需要小心应对\n了呢。"],["うーん、まこくん奪い合うのは良いですが、\n好い方に転ぶかどうかの見極め難しいです…」","唔~争夺小真是好事，\n但很难判断会往好的方向发展...」"],["…そういえば、","...说起来，"],["何のことだか判らないけども、\nヤソウのシュから逃れたいとか、\n今はまだ事を起こしたくないとか、\n冬夏には、何かしら穏やかでない雰囲気はあるかもだ。","虽然搞不清具体状况，\n但冬夏身上确实有种不安稳的气息，\n比如想逃离八相的诅咒啊，\n或是现在暂时不想惹事之类的。"],["僕の記憶力からすると奇跡的だな！","以我的记忆力来说简直是奇迹！"],["いや、それはそれだ。","啊，那是另一回事。"],["「あのね…[l]\n毎度毎度そんな巫山戯けた事言ってて、\n事を成せずに困るのはそっちでしょうに」","「我说啊...[l]\n每次都这样胡说八道，\n最后束手无策的可是你们哦」"],["「んむ？[l]\nまこくんだって、本家や宮達に何かあったら\n大弱りですよ？[l]\n人事じゃないですよ？」","「嗯哼？[l]\n要是本家或宫出了什么事，小真也会\n很困扰吧？[l]\n可不是别人的事哦？」"],["「じゃあ余計に真面目にやって下さい。[l]\n今んとこ実働部隊は僕独りなんですよ」","「那就请更认真点。[l]\n现在行动部队就我孤家寡人啊」"],["「ですから至って大真面目です。","「所以我是极其认真的。"],["自分の価値観で他人の行動の貴賤を断ずるのは、\nヒトの悲しいサガですねぇまこくん。[l]\nまあ誰もがやってる事っすよ、気にしないで下さい」","用自己的价值观评判他人行为高低，\n真是人类可悲的本性呢小真。[l]\n嘛反正大家都这样，别在意」"],["「は？[l]\nと、とにかく真剣にその…懐柔案を検討って[l]\n事ですか？」","「哈？[l]\n总、总之是要认真考虑那个...怀柔方案[l]\n的意思吗？」"],["「ま、最終的な目的遂行に関してだけみれば順調ではありますし、当初よりフレキシブルに考えましょうか…","「嘛~单看最终目标执行还算顺利，比起当初还是灵活点吧..."],["何か色々予想外のコトが起きてるようですし…[l]\nうひひゲームは障害が多いほど面白…」","似乎发生了各种预料之外的事...[l]\n嘻嘻游戏障碍越多越有趣...」"],["「…い場合と単にストレス溜まるだけの場合が[l]\nあります、ってゲーム扱いですか。[l]\nそれに予想外って？」","「...也有单纯积攒压力的[l]\n情况好吗，当这是游戏啊。[l]\n还有预料之外是指？」"],["「んむ？[l]\nあー、気にしないでください。[l]\n諸々含めて言葉の綾です」","「嗯呣？[l]\n啊—，请别在意。[l]\n这些都算是修辞手法啦」"],["「へええ言葉の綾ね…","「嘿诶~修辞手法啊…"],["まあ仮にその案採用としても、\n先刻から話題になってる通り、\n何か彼女達は彼女達で内部軋轢があるようですから…","就算采用那个方案，\n就像刚才讨论的那样，\n她们内部似乎也有矛盾呢…"],["あの、冬夏と姫様ちゃん以外にも。[l]\n面倒な事になりそうなんですが…」","那个，除了冬夏和姫様酱之外。[l]\n感觉会变得很麻烦呢…」"],["「んむ。[l]\nそこは巧く利用して、いい感じにやっちゃってください。[l]\nうひひひひひ」","「嗯呣。[l]\n那边就请巧妙利用，想办法搞定吧。[l]\n呜嘻嘻嘻嘻」"],["えええええーー！！[l]\n丸投げっすカーーー！！！","诶诶诶诶——！！[l]\n完全甩锅啊——！！！"],["「冗談ですってば。[l]\n逐一アドバイスしますよまこくんには」","「都说是开玩笑啦。[l]\n会逐条给你建议的小真」"],["「………」","「………」"],["「んむ？[l]\nあぁんまこくん、怒んないで下さいよぉ。[l]\n後でまた二人でお風呂入ろ？ね？」","「嗯呣？[l]\n啊~小真，别生气嘛~。[l]\n等会再两个人一起泡澡？好不好？」"],["「なんかもうね、……[l]\n…じゃあ入りましょうよ。[l]\nお互いフルヌードで行きましょうか？」","「怎么说呢，……[l]\n…那就去泡吧。[l]\n要全裸着去吗？」"],["「ん…っむぅぅ。[l]\nい、い、いいよぉ？","「嗯…呣呜~。[l]\n可、可以哟？"],["あ、やっぱだめっ。[l]\n混浴場は水着着用規則だしぃ、\n宮もまだ心の準備…","啊，果然不行。[l]\n混浴池要穿泳装的规则啦，\n宫也还没做好心理准备…"],["──て、まこくん、今日はどしたです？[l]\n溜まってる？んですか？」","——喂、小真，今天怎么了？[l]\n积压太多了？是吗？」"],["「ああ、そうですねえ…[l]\nいろんなものが溜まってるかもですねえ……」","「啊，是啊…[l]\n可能各种东西都积压着呢……」"],["え？[l]\nストレスとかですよ？","诶？[l]\n是说压力之类的？"],["「なうぅ、もう…まこくんてば！！」","「呜哇，真是的…小真！！」"],["や、\nストレスとかですからね？","压、\n是说压力之类的对吧？"],["「…まーそのうちガス抜きでも考えましょうね。[l]\nんむ？[l]\n個人に対して遣う言葉じゃないでしたか？[l]\nガス抜くって」","「…嘛~改天考虑排解下吧。[l]\n嗯呣？[l]\n这不是对个人使用的词汇吧？[l]\n说排解什么的」"],["「え、ああ。[l]\n普通は組織内の鬱積が噴出する前に晴らす事を言う、\nだった気がしますね…」","「诶，啊啊。[l]\n通常是指组织内部郁结爆发前化解，\n应该是这样吧…」"],["宮さんも抜くとか抜かないとか、\n貴女の方が余程何かが溜まってるんじゃ…","宫小姐说什么排解不排解的，\n你才更像是积压了什么吧…"],["「んむぅ、宮としたことが…[l]\n","「嗯呣~，身为宫居然…[l]\n"],["ま、それはそれっ。[l]\n","嘛，先不说这个。[l]\n"],["じゃーねぇ、お風呂、今度は競泳用でご一緒どうでしょ？","那~下次泡澡穿竞技泳装怎么样？"],["うひひっ。[l]\nワンピばっかじゃ飽きますか？[l]\nセパレートのが好いのかな？」","呜嘻嘻。[l]\n总是穿连体式会腻吧？[l]\n或许分体式更好？」"],["「いえ僕はワンピース派ですのでそちらで\n御願いします…","「不我是连体式派的所以\n请务必那样…"],["──あのね宮さん、\nもう話いいですか？[l]\nご飯を食べたいです…」","——那个宫小姐，\n可以结束话题了吗？[l]\n我想吃饭了…」"],["「あー、ご免なさい、もちょっと待って下さい。[l]\n月狂跳に関しても、もう少し具体的な事を\n教えた方が良いかもですね。","「啊—，抱歉，再稍等一下。[l]\n关于月狂跳的事，\n或许该告诉你更具体些。"],["前教えたように、月狂跳とは、\nマジモノとしての猫周りのネタ、\n特定の方向性を持った内容の資料の総称ですから、\n書籍の体裁をとってるとは限らないです。","就像之前说过的，月狂跳是\n围绕真实存在的猫的题材，\n具有特定方向性内容资料的总称，\n并不一定采用书籍形式。"],["で、此処にある『紙様』、三春の屋敷神とも言える\n御神体、\n恐らく書籍の形態ではなく紙、\n一枚二枚の紙片の体裁でもおかしくはないす。","呃、这里的『纸大人』，可以说是三春家的宅邸神明\n御神体、\n恐怕不是书籍形态而是纸张、\n就算是一两张纸片的形态也不奇怪啦。"],["で、ですよ。[l]\n聞いてますか？[l]\n聞こえてますか？[l]\nあのねあのね……」","那个、就是说啊。[l]\n在听吗？[l]\n能听见吗？[l]\n我说我说……」"],["向こうに居た時はあんまり電話とかしなかったから\n判んなかったけど、\n多分宮さん、電話はなかなか切ってくれないタイプだな。","在那边的时候不太常打电话所以\n没察觉到、\n但宫小姐你大概是那种很难挂电话的类型吧。"],["切り際になると話題を繋げようとする方々ね…[l]\nそして何でかそういうのに限って何度も同じ話題なの。","每到要挂断时就拼命找话题续命的人呢…[l]\n而且不知道为什么这种人总爱重复同一个话题。"],["今は電話じゃないし料金もないから良いけどね…[l]\n誰かとは真逆という事か…","现在不是电话也不用收费倒还好啦…[l]\n算是和某人完全相反吧…"],["「んむ？[l]\n何か言いたそうですけど」","「嗯唔？[l]\n你好像有话要说」"],["もう今の段階で何言われても右から左なんですよ…[l]\nて、あ。","现在不管你说什么我都左耳进右耳出啦…[l]\n啊、糟。"],["「あ、いえ、あそう、まだ言う事ありました。","「啊不是、呃对、还有话要说。"],["あのう…ですね。[l]\nまたぞろなんですけど、\n成り行きという奴で…","那个…就是。[l]\n又来了、\n因为事情发展…"],["何か新学期早々、学校行事があるとかで。[l]\n今回はまた別口の依頼人から秘密潜入を要請されました…[l]\nえーと何だっけ、はちみつぶんぶん…じゃないな」","好像新学期刚开始就有学校活动什么的。[l]\n这次又接到另一组委托人的秘密潜入请求…[l]\n呃叫啥来着、蜂蜜嗡嗡…不对」"],["「…蜂蜜？[l]\nひょっとして『神使八乃舞』ですか？[l]\nん、それ、確か部外者は」","「…蜂蜜？[l]\n难道是『神使八乃舞』？[l]\n嗯、那个我记得非相关人员」"],["「あれ、宮さん知ってたんですか？[l]\nそです、入れないらしいすね。だから秘密潜入」","「咦、宫小姐你知道？[l]\n对对、据说进不去呢。所以要秘密潜入」"],["「ですよ。[l]\nどうするんす？」","「就是说啊。[l]\n你打算怎么办？」"],["「………えーとですね、」","「………呃那个、」"],["…また弄られるのはもう諦めて簡潔に説明する。","…已经放弃抵抗被捉弄直接简短说明。"],["「まじー！？観に行きたいっ！でもなあー、宮行くのはヤバいなー。","「真假！？好想去看看！但宫去那边的话很危险啊。"],["もうまこくん全く肝心なことを忘れてるんだからぁ！[l]\nてかほら、だから向こうから寄って来るんだよまこくんにはぁ。[l]\n","真言君你完全把重点忘光光啦！[l]\n你看、所以对方才会主动靠近小真你啊。[l]\n"],["これでもう間違い無いすね、そっち方向にシフトは真剣に考えよ」","这下绝对没错了、必须认真考虑往那个方向转变」"],["いや、ヤバくはないでしょう宮さん、\n僕よりは全然通用するだろ…[l]\nてそういう事じゃないのか。","不、不至于危险吧宫小姐、\n你比我吃得开多了…[l]\n啊不是这个问题吗。"],["あと、女子が寄って来る特性というより、\n女子に弄られ易いオーラに矯正されたんだと思います。[l]\n宮さんに。","另外、与其说是吸引女生的特性、\n不如说是被矫正成容易被女生捉弄的气场了。[l]\n被宫小姐。"],["「で、結局連日女子との待ち合わせです…[l]\nモテてモテて困りますよあはは……」","「结果就是连日和女生约会…[l]\n受欢迎到困扰呢哈哈哈……」"],["「あのねまこくん。[l]\n女子はねぇ、厭な相手にも、\n表面上それなりに接する事くらい余裕で出来ますよ。","「我说真言君。[l]\n女生啊、就算是讨厌的对象、\n表面上装装样子应付还是游刃有余的。"],["あんまり女子と接し慣れてない人が勘違いしちゃう位には\n愛想良くね。[l]\nちょっと接近された位であまり浮かれるのはどうかなあ…」","对不太习惯和女生接触的人来说\n甚至会误以为对自己有好感呢。[l]\n稍微被接近就得意忘形不太好吧…」"],["「冗句に決まってるでしょう。[l]\n別に誤解してませんし、\n舞い上がってるつもりもないですけど」","「明显是玩笑话吧。[l]\n我又没误会、\n也没觉得自己很得意」"],["まあ…完全なフラットだったかと言われれば、[l]\nそりゃあ或る程度気にはなったけども、\nそりゃ通常生活の範囲内で起こる程度ですよ。","不过…要说完全心如止水、[l]\n那确实多少有点在意、\n但也就是日常生活的程度啦。"],["狩屋が僕に対して敵意剥き出しだったから、\n若干そういう感覚は忘れてたかもだが。[l]\nそれにしたって大体、あなたが言っても説得力に欠けませんか。[l]\nというかムキになってますか。","因为狩屋对我敌意太明显、\n可能让我有点忘记这种感觉了。[l]\n再说了、这话从你嘴里说出来也没什么说服力吧。[l]\n或者说你较真了？」"],["……まさか妬いてるって事は無いだろうが、[l]\n玩具取られて悔しがってる、くらいの感覚はあるかもな…[l]\n僕が自覚してどうするそれを。","……该不会是在嫉妒吧，虽然不太可能[l]\n但或许有种玩具被抢走的不甘心感…[l]\n我自己意识到又能怎样。"],["「分かりましたよ。[l]\nじゃあ宮さんからのセクハラもその程度だと思っておきます。[l]\n変に勘違いしないように心得ますよ」","「我明白啦。[l]\n那我会把宫小姐的性骚扰也当作这种程度的事。[l]\n我会注意不产生奇怪的误会哦」"],["「んむ？[l]\n","「嗯唔？[l]\n"],["や、あのね、もう、またそんなー。[l]\n","呀、那个啊、真是的、又来这套ー。[l]\n"],["分かってる癖に宮の気持ちはー♪」","明明知道还故意说宫的心情ー♪」"],["より一層分からなくなりました。","反而更加搞不懂了。"],["「そうそう、まこくんで遊ぶのに夢中で忘れてましたが、\nその行事、演劇？歌劇だったかな？でしたね。","「对对，光顾着和小真玩都忘了问\n那个活动，是演剧？还是歌剧来着？"],["玄ノ森の内輪の人間限定で有名ですね。[l]\nまこくんママはどうだったかな、知狡は確か参加してたかな」","在玄之森本地人中很有名呢。[l]\n小真妈妈当时怎么样来着，知狡好像参加过吧」"],["ああ、そうか。[l]\n飯窪も此処の人間だし、あの学舎に通った人間も居るだろう。[l]\nというか今そのものずばりで知狡さんの名が出たし。","啊，这么说来。[l]\n饭洼也是本地人，应该也有在那所学堂上过学的。[l]\n不如说刚才正好提到知狡阿姨的名字。"],["どんだけ古いか知らないが、宮さんも情報得られる環境では\nあった訳だ。","虽然不知道年代有多久远\n但宫小姐确实处在能获取情报的环境。"],["母さんからは何も聞いてないが、\n真面目に秘密厳守してたのか、\nずぼらで忘れてたのか。[l]\n恐らく単に、全く興味が無かったんだろう。","虽然从老妈那儿什么都没听说\n不知道是认真保守了秘密\n还是单纯嫌麻烦忘记了。[l]\n恐怕纯粹是根本没兴趣吧。"],["「多分に土地の伝承を謡ったものらしくて、\n内容的には祭とも多少リンクしてるですかね…[l]\n言葉は、普通使われない言語なんですよ」","「据说大量融入了当地传说\n内容上和祭祀也有些关联…[l]\n歌词用的是平时不使用的语言」"],["「あ、先刻ちょっとその、直で聞きました。[l]\nその謎言語。","「啊、刚才正好直接听到了[l]\n那种谜之语言。"],["みゃんみゃんなんとか…[l]\nで、今朝方にチノさんもおんなじような言語をですね、\n言ってた気がするんですけども──","喵喵什么的…[l]\n而且今天早上千乃小姐好像也\n说了类似的语言──"],["あれ？[l]\nそういえば何か解読はタブーだとか言ってましたけど…」","咦？[l]\n说起来好像提到解读是禁忌什么的…」"],["「あ、その辺、或る程度はもう聞いてるんですね。[l]\nまあ内容に関してはあくまで推測の域と言っておきましょう。[l]\n知狡たち、飯窪の者達が感得した印象がそうである、\nと言っても良いですけど。","「啊、这部分您已经听说过了啊。[l]\n不过内容终究只是推测范畴。[l]\n说是知狡她们饭洼族人感受到的印象\n这样表述也可以啦。"],["んー、歌は良いです。[l]\nリリンが生み出した文化の…[l]\nあれ、通じない？」","嗯ー，歌很不错。[l]\n莉莉姆创造的文化…[l]\n咦，听不懂吗？」"],["「えっともしかして大神系のネタ話ですか？[l]\nリリンがリリスの子孫という話…じゃないようですね」","「呃难道是大神系的梗？[l]\n莉莉姆是莉莉丝后裔的故事…看来不是呢」"],["「んむー、これくらい基本だと思ってましたが、\n時代ですかねえ…んむんむ。[l]\nまあそれはそれ、\n","「嗯唔ー，我还以为这是常识\n是时代差异吗…嗯唔嗯唔。[l]\n不过话说回来\n"],["歌は対人用実践魔術の究極、というのが宮達の持論です。[l]\n時間は尺度に過ぎませんから、実際には相の遷移ですね。","我们认为歌是对人实践魔法的终极形态。[l]\n时间不过是尺度，实质是相位迁移。"],["その媒質の相遷移、つまり振動、エネルギーの転換構造、\nそれがいわばマナに見立てられるとでも言いましょうか。","媒介的相位迁移即振动，能量转换结构\n可以说就像是拟态成玛那的存在。"],["振動は音となり媒質を伝播するのです。[l]\n歌詞は呪文、ヒトに対しては感情にすら定向性を持たせ得る\nマホウのコトノハ」","振动化作声音在媒介中传播。[l]\n歌词是咒文，甚至能对人类情感施加定向性的\n魔法言灵」"],["「…宮さんゲームのし過ぎじゃないすか。[l]\n何ですかいきなり魔法がどうとか…[l]\n僕の仕事に関係ある話ですかそれ？」","「…宫小姐游戏玩太多了吧。[l]\n突然说什么魔法不魔法的…[l]\n这和我工作有关系吗？」"],["「んむっ。[l]\n趣味じゃなかったですか？[l]\n妖怪ネタとかそっち系詳しいのに…」","「嗯唔。[l]\n不是你的兴趣吗？[l]\n明明对妖怪梗这类很熟悉的…」"],["「いやまあそうですが…[l]\n話の持ってき方が唐突だったので若干引いたんですよ。[l]\n大神じゃあるまいし…」","「不不虽然确实…[l]\n但话题切入太突然有点被吓到。[l]\n又不是大神…」"],["「あー。[l]\nかれおの彼氏さん。[l]\nまこくんの数少ない御友達ですね」","「啊ー。[l]\n卡蕾欧的男朋友。[l]\n是小真为数不多的好友呢」"],["「悪かったですね交友関係が少なくて。","「真是抱歉啊我交友圈这么狭窄。"],["これから増える可能性もあったのに\nたった一年で大学辞めさせられた身にもなって下さい。[l]\nあんまり彼奴の事、話した事も無いですねそう言えば」","本来今后还有可能增加的\n也请体谅一下才一年就被迫退学的我啊。[l]\n说起来 我都没怎么提过那家伙的事呢」"],["「こっち来る前にかれおにちょっと聞きましたけど。[l]\n彼もなかなかにそっちの才がありそうですって」","「来这边之前稍微问过卡蕾欧。[l]\n她说那家伙似乎还挺有那方面的才能」"],["あの娘はあれで視る眼は有りますからね、\nと宮さんは変に誇らしげに言った。","那丫头虽然那样但看人眼光还是有的，\n宫小姐莫名自豪地说道。"],["そっちの才てどっちの才だ。[l]\n怪しいネタとか中央の有名電気街方面のネタに精通とかそういうこと？","那方面才能是指哪方面啊。[l]\n是指精通怪谈梗或中央区著名电器街之类的八卦吗？"],["まあ彼奴はユーザーというか消費者寄りでもないし、\n何か自分でも色々作ったり描いたりしてたしな…","不过那家伙既不算用户也算不上消费者，\n好像自己也捣鼓过不少创作来着…"],["「うひひ。[l]\nところでですね。","「唔嘻嘻。[l]\n话说回来啊。"],["書にしたって書いて記す事によって説得力を持たしてあるけど、ノンフィクションかどうかは自己申告ですしね。","就算写成白纸黑字增加了说服力 但到底是不是纪实文学全凭作者自述。"],["メディアが『こうだ』と流す情報の真偽にしたって同じ、あらゆる受容器官が得る情報は、恣意的に入力元を細工されたら正否の判断は困難。","媒体宣称『如此这般』的信息真伪亦然 人类感官接收的所有信息 只要输入源被刻意篡改就难辨真假。"],["特に現代に於いて人間のコミュニケーション手段は基本的に言葉ありきですから、人間にとって言の葉は呪以外のなにものでもない、","尤其现代人类的交流手段基本都依赖语言 对人类而言言语根本就是咒术本身"],["と、誰かも言ってますねぇ」","这话好像也有谁说过呢」"],["いきなり話がシフトしたようだが取り敢えず相槌を打つ。","虽然话题突然跳转但还是先附和着。"],["「使用してるシステムがそれしかない以上、\nその仕組みを解明し悪意を込めて操作するも容易な訳ですか」","「既然使用的系统仅此一套\n那么解析其机制并恶意操作也就轻而易举了吧」"],["「水源が井戸一個しかないなら、その井戸に毒を放れば一発です。","「如果水源只有一口井 往井里投毒就能一网打尽。"],["生物が多様化を求めて有性生殖してるのも、\n単一体のコピーだと、それを殺すもの、\n例えばウィルスが現れれば全滅しかねないから、\nと考えられてますね。","生物追求多样性而进行有性生殖\n也是因为单一复制体遇到天敌\n比如病毒就可能导致全军覆没\n学界普遍这么认为。"],["そこまでして生物を永らえさせる意味までは分かりませんが。[l]\n意味なんてないかもですけど。[l]\nまあどっちでも――」","不过我不理解为何要如此大费周章延续生命。[l]\n可能本来就没有意义吧。[l]\n哎反正都――」"],["そこまで喋って、ふと宮さんは話を止め、\nこういう話題はチノの専売にしてるんでした。[l]\nと言ってうひひ、と苦笑した。","说到一半 宫小姐突然止住话头\n想起这类话题本是千乃的专利。[l]\n说着便唔嘻嘻地苦笑起来。"],["その話は赤の何とか仮説だっけ？と、[l]\nうろ覚えの記憶を辿ってると、\n皮肉めいてこう続けた。","那个叫红什么假说来着？（译注：此处指红皇后假说）[l]\n正搜寻模糊记忆时\n她语带讽刺地继续道："],["「ま、まこくんくらい本をそこそこ読んでる人には\nいちいち言うまでもない事でしょうけどね？[l]\nでも、言葉の呪に関しては、\n異言語間に於いて通じないものであるのも当然でして、\nそれを凌駕し得るものが歌、という事なんです」","「对、对小真这种读过不少书的人来说\n这些应该都是常识了吧？[l]\n不过关于言语的咒术\n在不同语言间无法互通也是理所当然\n而能超越这种隔阂的 正是歌谣」"],["祭にせよ儀式にせよ、\n確かに全世界的にみて、あらゆる文化圏で\n音楽というものが、神霊的な場に於いて重要な位相を占めている。","无论是祭祀还是仪式\n纵观全世界 所有文化圈中\n音乐都在通灵场合占据重要相位。"],["それこそ音だけでトランス状態入れる事例もある訳で、\nライヴな音楽というのは身体的にも影響があるのだろう。","甚至存在仅靠声音就能进入恍惚状态的案例\n现场音乐对肉体应该也有影响。"],["また、音楽や歌が記憶の引き出しの取っ手足り得る事もある。","有时音乐或歌曲还能成为记忆的钥匙。"],["「重低音とか高周波で苛々したり鼻血でたり、\nヒトには聞こえない領域ですら物理変化をもたらすのが音、\nつまりは媒質の振動なのですね。","「低频震动或高频声波会让人焦躁流鼻血\n连人耳听不见的频段都能引发物理变化\n说到底就是介质振动呢。"],["最近は振動を電力に変えたりとかいう技術があったんじゃ\nなかったですかね？」","最近不是有将振动转化为电力的\n技术来着？」"],["「その話は聞いたこと無いですけどそうなんですか？","「没听说过 真有这种技术吗？"],["まあそこまで言われりゃあ、\n僕とて歌を魔法と呼ぶに","不过既然说到这个份上\n就算要我承认歌谣是魔法"],["吝かではないですがね…[l]\n歌は万国共通の文化ですしね…」","倒也没什么不情愿…[l]\n毕竟歌谣是全世界共通的文化啊…」"],["「そういう観点で視ますとですね、\nよく言われるマナとは、\nつまり大気であり水であり、ひいては肉自体、\n振動し音を伝達可能なもの、と言えなくもないですね。","「从这种角度来看的话，\n通常所说的玛那，\n其实就是大气和水，甚至肉体本身，\n也可以说是能传递振动与声音的媒介吧。"],["──という思考遊戯をチノとよくやるんです。[l]\nというお話でした。[l]\nま、正にどうでもいいんですけど」","──我经常和千乃玩这种思维游戏。[l]\n刚才说的就是这些。[l]\n嘛、虽然完全无关紧要就是了」"],["宮さん、そう言いながらこの後も、\nなんだっけ、","宫小姐虽然这么说着，之后还是\n那个叫什么来着，"],["結局、歌という形で伝えるというのはある種理に適っていて、\n万国どころか万物共通足りえる記録媒体がどうのこうの、\nどこまで本気か判らない話をなされたので御座います。","总之用歌唱形式传递信息确实符合某种原理，\n不仅跨国界甚至可能成为万物通用的记录媒介云云，\n说了些不知有几分认真的话。"],["実際は言うまでも無く本気ではないだろうけど。","实际上不用说也知道不是认真的吧。"],["「であ、他に報告し忘れないですか？[l]\nじゃ、今度こそご飯行きましょうか？」","「对了，其他事情没忘记报告吧？[l]\n那、这次真的去吃饭吧？」"],["「――何か忘れてる気がするんですがね。[l]\n…………………[l]\n…………………[l]\n…………………あ！」","「――总觉得忘了什么。[l]\n…………………[l]\n…………………[l]\n…………………啊！」"],["「おうあ！？[l]\nな、なに」","「哇啊！？[l]\n怎、怎么了」"],["莫迦か僕は。[l]\n今日何のために朝から動いてきたんだ。","我真是个笨蛋。[l]\n今天一大早忙活是为了什么啊。"],["「今日の物理的成果ですよ！[l]\n冒頭から話が横滑りしまくったので忘れるとこだった」","「今天的实体成果啊！[l]\n因为话题从一开始就不断跑偏差点忘了」"],["「──まこくんそれを忘れますか。[l]\n健忘症？大丈夫？」","「──小真居然会忘记这个。[l]\n健忘症？不要紧吧？」"],["「ほっといてください。[l]\n昼飯喰ってないんですししょうがないでしょう。","「请别管我了。[l]\n没吃午饭我也没办法啊。"],["寝起きと空腹時には対応が人以上に雑になるんです僕ぁ。[l]\n先刻から飯を喰わせないでいたのは宮さんでしょうに。[l]\nそんな事よりこれですこれ」","我睡醒和空腹时的反应会比常人更迟钝啦。[l]\n刚才不让我吃饭的不就是宫小姐你嘛。[l]\n比起那个快看这个」"],["「言ってくれてたらすぐご飯にした…の……[l]\nんむ………？」","「要是早说我们马上去吃饭…的……[l]\n嗯唔………？」"],["「言いました言いましたよ。[l]\nそしたらちょっと待てと言われたんでしょ！[l]\nで、それですがね、\nこれがまたどうやら蔵の中に大量にあるかもで…」","「我说过了说过了啊。[l]\n然后你不是让我稍等一下嘛！[l]\n然后关于这个，\n搞不好仓库里还有大量存货…」"],["受け取るなり、予想通り反応してくれる宮さん。[l]\n良かった、やはり何かしら関係のあるものである可能性が高そうだ。[l]\n飯の件はもう言った言わないはどうでも良いです早く行きましょう。","刚接过手，宫小姐果然如预料般有了反应。[l]\n太好了，看来确实很可能是相关物品。[l]\n吃饭的事别争了快去啦。"],["って、宮さん。[l]\nちょっと見入ってしまってるな。","喂，宫小姐。[l]\n看得入神了啊。"],["眼の色が違う。[l]\nおお、ほんとに違う色にみえるぜ…[l]\n腹限界来たか僕。","眼睛颜色变了。[l]\n噢、真的变成不同颜色了…[l]\n我饿到极限了吧。"],["眼の前がちかちか、瞬きした瞼の裏の光の明滅、\n眼を開いてても視えるよおかあさーん！","眼前发黑，闭眼时眼皮内侧的光点闪烁，\n现在睁着眼都能看见了啊妈妈——！"],["「…ええと、もう限界なんですわ……[l]\n詳しい事は御昼の最中か後にしませんか……？[l]\n宮さん？」","「…那个、我真的到极限了……[l]\n详情午饭时或之后再说好吗……？[l]\n宫小姐？」"],["「まこくん……」","「小真……」"],["「へい？」","「在？」"],["「ありがとうございました。[l]\n大変役に立ちました。","「非常感谢。[l]\n帮大忙了。"],["明日でしたっけ？病院行きたいの。[l]\nそこ、長久、構いませんよそこで。[l]\n何かまた三春関係者と","是明天来着？想去医院。[l]\n那边，长久，在那里没关系。[l]\n如果又和三春家的"],["懇ろになったら\n報告して下さい。","相关人员\n熟络起来请报告。"],["…眼は多分気のせいでしょうし、最初から疲労で点滴御願いします、[l]\nが好いかもですけどね」","…眼睛大概是错觉，直接以疲劳为由挂点滴，[l]\n可能比较好呢」"],["「………。[l]\nは、はあ。[l]\nわかりました……」","「………。[l]\n哈、哈啊。[l]\n明白了……」"],["何か雰囲気変わったな、というか上の空？[l]\n別の事に集中しているもよう。[l]\n余程その紙に何かあるのだろう。[l]\nそれは何より。","总觉得气氛变了，或者说心不在焉？[l]\n似乎正专注于其他事情。[l]\n想必那张纸上有什么重要内容吧。[l]\n那再好不过。"],["「んむっ、神使八乃舞もしっかり堪能してきてくださいよ。[l]\nああ、出来ればまこくんのその艶姿、写真を撮っておきたい…」","「嗯唔，神使八乃舞也请好好享受哦。[l]\n啊，可能的话真想拍下小真那妖艳的姿态…」"],["そこはまだ現思考の範疇にあるんかい。","这种时候居然还在想这个吗。"],["「さ、飯行きましょう飯。[l]\nそしたら昼寝しますもう今日は」","「走、吃饭去吃饭。[l]\n吃完就睡午觉今天就这样」"],["「おー？[l]\n添い寝して欲しいの？[l]\n好いよ？」","「哦～？[l]\n想要陪睡吗？[l]\n可以哦？」"],["「ちげーーよ！」","「才不是啊——！」"],["「えぇー？[l]\n折角今日のご褒美に或る程度までは色々許そうと思ったのにー。[l]\nんむー、勿体無い事するなーまこくんはー」","「诶～？[l]\n明明今天作为奖励本来打算允许你做很多事的～[l]\n嗯唔～小真真是暴殄天物～」"],["「………冗談は顔だけにして頂いて、[l]\n喰いに行きますよほら！ほらほら！！」","「………玩笑请仅限于面部表情，[l]\n快去吃饭啦喂！赶紧赶紧！！」"],["「ホントなんだけどなぁ……」","「明明是真的说是……」"],["聞こえてたけど、\n敢えて黙殺。[l]\n貴女の事を考えるとほんとに色んな意味で切なくなるよ。[l]\n切なくね…","虽然听见了，\n但刻意无视。[l]\n想到你的事就各种意义上都让人揪心啊。[l]\n揪心死了…"],["「宮さん、僕はあなたが………です」","「宫小姐，我………你」"],["「んむ？[l]\nなにー？」","「嗯唔？[l]\n什么～？」"],["「……いえ、何でも──」","「……不，没什么——」"],["「んむー？[l]\n良いですけど。[l]\nうひひっ。[l]\n","「嗯唔～？[l]\n好吧。[l]\n嘻嘻。[l]\n"],["じゃっ、行きましょーか」","那～出发吧」"],["微妙に近い距離で連れ立って歩き出す僕等。","我们以微妙贴近的距离并肩而行。"],["姫様ちゃんが視たら一体どういう反応するんだか、\nと思う時点で彼女と宮さんに対して自意識過剰というものだ。","要是被姫様看到不知会作何反应，\n会产生这种想法本身就说明对她们过度在意了。"],["…まあ、健全男子としてそんくらいの妄想はいいでしょ、[l]\n虚しさは覚悟の上さ。","…嘛，健全男生做这种程度的妄想也无妨吧，[l]\n空虚感早就有心理准备了。"],["──冬夏の太腿が何故かそこで想起されてしまうのはどうだ…[l]\n妄想の連鎖が！！いやーーー！！","——但为何此刻会突然想起冬夏的大腿…[l]\n妄想连锁反应！！不要啊——！！"],["脳空転の弊害が此処にも！[l]\n思考回転にブレーキが効かなくなるのが脳空転ですから！","脑内空转的危害在此显现！[l]\n思考刹车失灵就是脑内空转的症状！"],["…もうええ、飯行く。[l]\nふらつきながら僕は、宮さんと何とか歩調を合わせて、\n飯へと向かった。","…够了，去吃饭。[l]\n摇摇晃晃地勉强跟上宫小姐的步伐，\n朝着餐厅前进。"],["食欲と性欲の、状況に","至于食欲与性欲"],["因る優劣の遷移は如何に、\nなどという無駄な思考は暴走しっぱなしだったけど。","会如何依据情况此消彼长、优劣互换，\n这类无谓思考始终在暴走着。"]],"context":[["SC_M_016.ks/index/1/text"],["SC_M_016.ks/index/3/text"],["SC_M_016.ks/index/5/text"],["SC_M_016.ks/index/7/text"],["SC_M_016.ks/index/9/text"],["SC_M_016.ks/index/11/text"],["SC_M_016.ks/index/13/text"],["SC_M_016.ks/index/15/text"],["SC_M_016.ks/index/17/text"],["SC_M_016.ks/index/19/text"],["SC_M_016.ks/index/21/text"],["SC_M_016.ks/index/23/text"],["SC_M_016.ks/index/25/text"],["SC_M_016.ks/index/27/text"],["SC_M_016.ks/index/29/text"],["SC_M_016.ks/index/31/text"],["SC_M_016.ks/index/33/text"],["SC_M_016.ks/index/35/text"],["SC_M_016.ks/index/37/text"],["SC_M_016.ks/index/39/text"],["SC_M_016.ks/index/41/text"],["SC_M_016.ks/index/43/text"],["SC_M_016.ks/index/45/text"],["SC_M_016.ks/index/47/text"],["SC_M_016.ks/index/49/text"],["SC_M_016.ks/index/51/text"],["SC_M_016.ks/index/53/text"],["SC_M_016.ks/index/55/text"],["SC_M_016.ks/index/57/text"],["SC_M_016.ks/index/59/text"],["SC_M_016.ks/index/61/text"],["SC_M_016.ks/index/63/text"],["SC_M_016.ks/index/65/text"],["SC_M_016.ks/index/67/text"],["SC_M_016.ks/index/69/text"],["SC_M_016.ks/index/71/text"],["SC_M_016.ks/index/73/text"],["SC_M_016.ks/index/75/text"],["SC_M_016.ks/index/77/text"],["SC_M_016