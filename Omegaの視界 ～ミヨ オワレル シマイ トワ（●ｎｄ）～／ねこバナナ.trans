],[{"start":7803,"end":7894}],[{"start":7961,"end":8003}],[{"start":8011,"end":8086}],[{"start":8116,"end":8144}],[{"start":8176,"end":8266}],[{"start":8274,"end":8317}],[{"start":8331,"end":8332}],[{"start":8342,"end":8389}],[{"start":8419,"end":8443}],[{"start":8475,"end":8497}],[{"start":8505,"end":8603}],[{"start":8633,"end":8662}],[{"start":8694,"end":8714}],[{"start":8744,"end":8779}],[{"start":8811,"end":8832}],[{"start":8840,"end":8902}],[{"start":8910,"end":8946}],[{"start":8976,"end":8985}],[{"start":9017,"end":9070}],[{"start":9100,"end":9118}],[{"start":9150,"end":9213}],[{"start":9221,"end":9293}],[{"start":9302,"end":9303}],[{"start":9312,"end":9328}],[{"start":9336,"end":9378}],[{"start":9408,"end":9423}],[{"start":9455,"end":9498}],[{"start":9506,"end":9615}],[{"start":9623,"end":9676}],[{"start":9684,"end":9744}],[{"start":9752,"end":9810}],[{"start":9840,"end":9845}],[{"start":9877,"end":9959}],[{"start":9967,"end":10060}],[{"start":10149,"end":10159}],[{"start":10191,"end":10277}],[{"start":10307,"end":10349}],[{"start":10409,"end":10420}],[{"start":10430,"end":10458}],[{"start":10488,"end":10529}],[{"start":10561,"end":10631}],[{"start":10639,"end":10686}],[{"start":10716,"end":10778}],[{"start":10810,"end":10869}],[{"start":10877,"end":10975}],[{"start":11022,"end":11051}],[{"start":11128,"end":11214}],[{"start":11246,"end":11285}],[{"start":11293,"end":11385}],[{"start":11393,"end":11439}],[{"start":11469,"end":11485}],[{"start":11514,"end":11542}],[{"start":11572,"end":11642}],[{"start":11650,"end":11707}],[{"start":11715,"end":11769}],[{"start":11798,"end":11838}],[{"start":11868,"end":11915}],[{"start":11923,"end":12000}],[{"start":12029,"end":12098}],[{"start":12106,"end":12163}],[{"start":12193,"end":12246}],[{"start":12275,"end":12345}],[{"start":12375,"end":12430}],[{"start":12438,"end":12472}],[{"start":12501,"end":12583}],[{"start":12613,"end":12635}],[{"start":12664,"end":12772}],[{"start":12802,"end":12844}],[{"start":12852,"end":12938}],[{"start":12967,"end":13002}],[{"start":13032,"end":13071}],[{"start":13100,"end":13161}],[{"start":13169,"end":13239}],[{"start":13269,"end":13313}],[{"start":13342,"end":13408}],[{"start":13420,"end":13426}],[{"start":13434,"end":13473}],[{"start":13503,"end":13550}],[{"start":13579,"end":13617}],[{"start":13647,"end":13716}],[{"start":13745,"end":13772}],[{"start":13780,"end":13847}],[{"start":13855,"end":13890}],[{"start":13920,"end":13926}],[{"start":13955,"end":13959}],[{"start":13989,"end":14022}],[{"start":14051,"end":14078}],[{"start":14108,"end":14183}],[{"start":14212,"end":14246}],[{"start":14276,"end":14330}],[{"start":14359,"end":14374}],[{"start":14406,"end":14481}],[{"start":14510,"end":14532}],[{"start":14562,"end":14580}],[{"start":14612,"end":14677}],[{"start":14685,"end":14703}],[{"start":14733,"end":14737}],[{"start":14766,"end":14837}],[{"start":14869,"end":14930}],[{"start":14960,"end":14998}],[{"start":15027,"end":15033}],[{"start":15065,"end":15134}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_019.ks","basename":"SC_S_019.ks","indexIds":{"「あ……その、」":0,"「ん？[l]\nああ、気にしないで呉れ給え。[l]\n昔のように仲良くいこうじゃないか。":1,"これでも僕は、\n今でも冬夏君の良き理解者のつもりでいるんだがね。[l]\n少なくとも他の連中よりは話せると思うよ？":2,"子供の頃だって、\nあの家から色々連れ出してあげたじゃないか、":3,"覚えてるかなあ、\nあの海岸、何と言ったか、御母堂の眼を盗んで、\n姫様君達と一緒に」":4,"「えと……それは、[l]\n道具さんが良くしてくれてるのは解ってます、\nそうじゃなくて、その」":5,"「ああ、僕が此方来てから今日まで会えなかった事かい？[l]\n挨拶も無かった事を詫びる気持ちでもあるのかな？[l]\nそれもノー・プロブレムだよ。":6,"冬夏君の気持ちは解らないでもないし、\n事情というのは誰にでもあるさ。[l]\n僕自身も諸事情で色々と出回ってたからね。":7,"ま、今回のような事で冬夏君との関係が、\n決定的に決裂するような事はないよ。[l]\n他のニンゲンに対する場合はまあ、\nその相手方の事情によりけりだな。":8,"兎に角、連絡くれて良かったよ。[l]\nさ、乗り給え。[l]\nボロ車だが」":9,"「……すみません」":10,"「だから、僕は愉しいのが好みなのだよ。[l]\nキミをバックアップするのもその一環だし、\n西石君にしても同様だ。[l]\n気に病むことは無いんだよ。":11,"勿論、\nあの家の中に居る時のような堅苦しい物言いも無しで頼むよ。":12,"ん？[l]\nああ、それとも家出の件か。[l]\nそれこそ気持ちはよゥく解るがね。":13,"ただ、\n例のお二人さんが、\n上から何か言われないうちにね、\n穏便に済ませた方が良いと思ったのだ。":14,"本意では無いだろうが、謝るならば御母堂にするのだね。[l]\n幸か不幸か、\nあのひとは特に今回は経緯なぞ気にする余裕もなかろうし、\n納まる所に納まりさえすれば叱責されることも無いだろう。":15,"さてそんな事はさておき、だ。[l]\n差し入れでも買っていくとしようか」":16,"「………」":17,"「ま、\n僕の御節介をどう活用するも君次第だ。[l]\n『僕は』強制しないよ。[l]\nしたいようにすれば好い。":18,"ほら、キミも差し入れ選び手伝って呉れないかな。[l]\n薬の類は僕が何とかしてるし、\n幸いにして食欲は相変わらずなのだよ、西石君は。":19,"あれは量さえあれば満足するかも知れないが、\n友人からの心の籠もったセレクションと銘打った方が、\n有り難みも増すと言うものだろう。":20,"悦ばせてあげたいじゃないか。[l]\n快復も早まるというものだ。[l]\nささ、降りた降りた」":21,"「……分かりました、今降ります──[l]\n……真言さん何て言ってたっけ、[l]\nアンパンと牛乳…だったかな」":22,"「ん、そうだ。[l]\nよっ、せいっ、と」":23,"「？」":24,"「ボロい車だものでね、\nドアの重さが堪えるのだなこれが。[l]\n":25,"齢は取りたくないね。":26,"ところで──その彼……真言君か。[l]\n僕ともちょっとした関わりが出来てね。":27,"件の諸事情で、\n色々出回ってる最中に出逢ったのだが、\n聞く所に拠れば西石君の古い知人だそうじゃないか。":28,"若し君に会うことがあれば、\n僕に連絡するよう頼んでおいたのだよ。[l]\n今回連絡を呉れたのもそういう流れじゃないのかな？":29,"それとも、\n冬夏くんの純然たる自発的行動なのだろうか。[l]\n":30,"それはそれで善きことだがね」":31,"「あ、……気付きませんでした。[l]\nそうだったんですか……[l]\nああ、そうか、そうですよね……":32,"あれ、じゃいつお会いになったんですか？[l]\n昨日の午後の時点で私、トモさんの事話してるのに……」":33,"「ん？[l]\n僕等が会ったのはいつだったかなァ。[l]\n彼がこの地に来てからなのは間違いないが。[l]\nもし僕の事を知らない素振りをしたのなら、\nあれじゃないか、その時、\n冬夏君の話の流れを途切れさせたくなかったんじゃないかね。":34,"ははは良い子じゃないか彼は。[l]\nそれとも頭の中でキミの言と一致しなかったかな？":35,"本当にど忘れしたかも知れないね、\n彼も少々、健忘のケがありそうだったからね。[l]\nまあ、これ以上の陰口は控えておこうか。":36,"さあ冬夏君、訊くが、\n彼はそうだと思っているかね？[l]\n否、設問が適切でないな。[l]\n彼と契りたいと思っているのかな？」":37,"「……私、[l]\n………」":38,"「ふむ。[l]\n興味がないとも言えないし、\nシキタリに迎合したくもないという二律背反から、\n結果返答に窮す、\nと言った所かな。":39,"ま、言えないのならそれでいい。[l]\n取り敢えず、\n僕が視たところでも何とも言えなかったよ。[l]\n愉快な少年ではあるようだがね。":40,"ただ、姫様君が……否、[l]\n矢張り何とも言えないな。[l]\n確実なのは西の御大の検さ──おっと忘れていた。":41,"先日は御苦労だったね。[l]\n八相の人間が直々に舞台演目までこなすのは何年振りだろうか。[l]\n視られなくて残念だったよ」":42,"「いえ、あんなの。[l]\nたいしたことないです。[l]\n稽古さえすれば誰でも出来ますわ」":43,"「ふむ、\nそうか、ま、プライドもあるか……":44,"ん？[l]\n何でもないよ。[l]\nさて、ケーキか何か、は、\nこういう店には無いのかな？」":45,"「えと……あちらに」":46,"「あー、成る程ね。[l]\n荷物になるし最後で良いな。":47,"では僕は食材メインで見繕うから、\n冬夏君は御菓子であるとか、\nアンパンと牛乳？だったかな？[l]\n諸々頼むよ。":48,"──大丈夫だね？こういう所で用を足すのは」":49,"「……ええ、とうに馴れましたわ」":50,"「結構。[l]\nま、何かあれば言って呉れ給え。":51,"それと、その物言いも止めてくれて良いのだよ。[l]\n僕とキミの間で過剰な緊張も御法度だ。[l]\nじゃ、支払いは僕がするから決まったら宜しく頼む。[l]\n行ってくるよ」":52,"「いやはや、大分買い込んだなあ。[l]\n西石君には早く元気になって貰わねば困るからねえ」":53,"「そうですね……[l]\nはやく……」":54,"「さあ、では向かうとしよう。[l]\nシートベルトは締めたかね？":55,"駐車場の出口まで走らせてからシートベルトをする、\nという世のオバサン方のような真似はしないしさせないよ。[l]\nあんな下らない行為は誰も得をしないからな。[l]\n──よし、結構」":56,"「……ぷっ」":57,"「ふふ、":58,"漸く":59,"解れてきたかな？[l]\nだが今のは本心だよ。":60,"実際はそういう輩は男女の両方に居るんだろうが、\n統計的概観としてそう捉えられてしまう現状が或る以上、\n便宜的にそう言ってしまうけれど」":61,"「あはは……[l]\n分かります。大丈夫です」":62,"「まあ、血液型でのタイプ分けみたいなものだな。[l]\n言うまでもないことだが、\nその手の本、全てのページ読めば、\nどれもこれも、誰にとってもどこかしら当てはまるのが分かると思うが。":63,"どの血液型の人間がどの血液型のページを読んでも、\nそうと説明しなければ恐らくは、":64,"まあ、余り言うまい。[l]\n遊びなんだろうからね。[l]\n事実ばかりを扱って行くことが好いとは限らない」":65,"「……ええ、そうですね……」":66,"「ヒトは自分を定義されるのが好きなようだしね。[l]\n言い訳、大義名分、何でもいいがね、\nつまり『～だから』『～なので』仕方がない、御容赦ください、\nと言いたいのだな。":67,"先の例で言えば、男だから女だから、\nＢ型だからＯ型だから、と言いたいのだろう。[l]\nそうでも思い込まねばやっていられない事もあろうがね、\n固執して振り回されるのも宜しくないね。":68,"方便はあくまでも方便なのだからね、\n普遍的なバックボーンとして用いようとすること自体がナンセンスだが、":69,"結局は体系化しようとする欲求の片鱗が歪に大衆論理と融合したり、要するにコミュニケーションを円滑にする以外には意味の薄いものなのだな。[l]\nそれを必要とするモノにはさぞや重宝され得るであろうツールだが──」":70,"「私にはどっちがいいのかは分かりません、けど……[l]\nあはは、話は大分脱線してる気がします」":71,"「はは、まァね。[l]\nともあれ当たるも八卦当たらぬも八卦、\n信じる者はスクわれる、":72,"効く人間には効くのだろうけれど、\n僕等のようなのにはあまり必要のないものだな。":73,"と言うわけで、\nそういう僕等、そういう資質者たる":74,"証":75,"左の、\nミハルも本当は既に継いでいるのではないのかな？」":76,"「冬夏君の御母堂は──\n（ここだけの話だが能無しだからね。）[l]\n送った途端に……どうだかな。":77,"資質とはそういうものではないのだが、\n彼女はどうにも俗っぽくていけないなあ。[l]\nいうなれば世のオバサン達に近しいアタマをしておられる。":78,"どうにも根本から解っていないようだから、\nそういった失効にも見舞われてるのかも知れないな。[l]\nおっと、言い過ぎか。[l]\n仮にもキミの」":79,"「良いんですあんな人。[l]\nそれに大丈夫ですよ、私言いませんから。誰にも。":80,"ご先祖さまも──あまり出来が良くなかったって、\nなのに、だから、\n……きらいです。":81,"世襲で祭り上げられてなにもできないくせにその気になって、\nこっちは、そんな家の、に、てだけで──\n道具さんでも遊女さんでも選律さんでも、なれば良かったんです。[l]\n八相のチョウシなんて」":82,"「ふむ。[l]\n誰が言ったのかなそんな不遜な発言？[l]\n僕だったかな？ベロアかな？":83,"あのお方の侍者としてそれはないか……否、[l]\nベロアにとっても懸念事項なのかな」":84,"「私、まだベロア……とか、[l]\nあのお方とも会ったことはないです」":85,"「ん？まだ接触したこともないか。":86,"そうか、あのお方とはまだ面識が無いのか」":87,"「……ありません。[l]\n今回が初めてです。[l]\n今回は特別だと」":88,"「そう。[l]\n今回は特別だ。":89,"色んな事象が一時に重なって起きていて全く愉快だね。[l]\nこういうとき、その渦中にはそれを引き起こす人物が居るそうだよ。[l]\n周囲を巻き込む。[l]\n居るだろう？そういう存在。":90,"だが当人はまるで奔流に流されるが如く、状況に流されるが如く、\n本人の意思とは無関係にコトを引き寄せ引き起こすまさに、\n一滴の雫。":91,"その波紋は濁ったみどろをさざめかせ、\n停止した時間を動かす針──\n僕はそういうのを待っていたんだ」":92,"「……？[l]\nあっ……、」":93,"「ま、それは置いておこう。[l]\n長々と済まなかったね。[l]\n先程のキミの発言、\n僕も誰にも言わないでおくから安心し給え。":94,"まあ、あのひとも血統の所為かあのお方が何かしたのかは知らないが、\n":95,"今":96,"日まで役には立っておられたよ。[l]\n束ねとしてね。[l]\n僕には出来ない真似だよ。":97,"ま、何とかと":98,"鋏は使いようと言うしなァ。[l]\n適材適所、餅は餅屋というのかな。[l]\n俗物に近しいからこそ居られる位置（ポジション）というのも\n一応あるという事さ。":99,"三春の家には何故か先々代以前からもそういうのが多いと聞くが。[l]\nそれでもあそこがあれたるのは、\n結局はあのお方の意志ありき、\nで存在を赦されている我々だからなんだな」":100,"「………んー」":101,"「而して、そんな自分の属する集団に懐疑的な僕が視ても、\n冬夏君個人は非常にイイと思うよ。":102,"だから、\nミハル自身にとってもキミに送られて幸いだったろうな。[l]\nワカってる者に使役された方が被使役側からしても好いに決まってる。[l]\nで、ミハルだが」":103,"「ふむ。[l]\nま、深くは聞かないよ。[l]\n持ってはいるのかな……":104,"そうだ、僕が言うのもなんだがね、\n禁級なんて厄介なものには、\nみだりに手を出さない方が好いよ。[l]\nちなみにオオクロは──」":105,"「……知りません。[l]\nきっと母様が何処かに」":106,"「ふむふむ。成る程ね。成る程。[l]\nそう言えば遅ればせながら眼の方は大丈夫かな？[l]\n完全な修復は出来るだろうが、\n祭儀まで待つことになるだろうから──":107,"僕のチカラが必要なら遠慮無く言って呉れ給えよ。[l]\nまだ日は保つだろうが、\n":108,"何":109,"分キサムラ代替では高が知れている。[l]\n今言ったように、禁級では少々無理も出るしね」":110,"「すみません……[l]\nでも大丈夫です」":111,"「抗議行動も結構だが他に幾らでも方法はある。":112,"説教をぶつつもりはないがね、\n雌伏雄飛という言葉もあるにはある事だし、\n命あっての物種、キミには愉しい劇を演じるシカクがあるのだろうからね、\n御身大切にして貰いたいのだよ」":113,"「え……？[l]\nトモさん、待って、私、何か──」":114,"「ん？[l]\nどうかしたかい？」":115,"「……いえ、あれ……？[l]\nすみません、何でもないです……」":116,"「そうか。[l]\nまあ、そうだな、":117,"結局キミの御母堂にしても、\nあのお方の言いなりでしかなし、\n彼女をどうしたところでどうにもならないだろうな。":118,"冬夏君の望みを果たしたいなら、\n抜本的改革が必要だろうねえ……」":119,"「……トモさん？」":120,"「いやいや、仮定の話だよ。[l]\n思考遊戯の範疇さ。[l]\n僕は愉快なのが信条だから──」":121,"「ええ……それは分かりますけど……」":122,"「ま、そのアソビの流れで考えてみても、\nあのお方──魔女殿が居る限り、\nキミや僕等はカゴのトリということだよ。":123,"とは言え、だ、猫がヒトを飼い馴らしている今の世の例あるように、\nあのお方の目的の１つがキミの血統の堅持である以上、\n黙っていれば":124,"加":125,"護は約束されてるんだけれどもね、":126,"その目的の為の手段に納得出来ないか。[l]\n難儀な事だが気持ちは良く分かる」":127,"「……私何も言ってませんけど」":128,"「ふむ、そうだね。[l]\n気にしないで呉れ給え。[l]\n遊戯だよ遊戯。":129,"ふむ、遊戯にしても駒か審判か、それが問題だ、\nいずれ完全独立の観測者が有り得ないように、\n括弧で括られた中での王か、それとも外側というのが在るのか──\nん、済まないね、独り遊びに耽ってしまった。":130,"まあ、そういう訳だから、\n冬夏君には申し訳ないけれども僕は僕で、\n勝手に愉しんでいるから。":131,"先刻言った通り、『僕』は、\nキミをキミの御母堂の言うがままに束縛する気は更更無いので\n安心して欲しいね。":132,"『彼』と同じく、\n僕は冬夏君の味方だよ、少なくとも他の連中よりはね。[l]\nそれは信じて呉れていい」":133,"「……？」":134,"「ふふふ、\nだから、何度も言わせないで呉れ給え。[l]\nん？そんな事も言ってないか。[l]\nただ、祭儀にだけは参加した方が良いとは思うがね。":135,"でないとお目付役に強制連行権が与えられ兼ねない。[l]\n自分から参加すればまだ加減も出来よう、\n祭儀さえ済めば──また機会もあるだろうしね。[l]\nおっと此処だ」":136,"「あ、きぃの家──」":137,"「駐車場がこの通り、少しばかり遠いのでね、\n例の差し入れ、手分けして持とうじゃないか。[l]\nキミもそうだろうが、僕も肉体労働は得手じゃないのだ……よっと」":138,"「あ、はいわかりました。[l]\n私も不本意ながらそんなにチカラないですけど」":139,"「いやいや、加えて僕は":140,"齢の分だけキミに劣るのさ。[l]\nでは行こうか」":141,"「トモさん若いですってば……[l]\nミコさんと同じくらいには視えますよぅ」":142,"「世辞にしろ社交辞令にしろ有り難く戴いておくよ。[l]\n僕だってこれでも女性だからね、\n年齢に関する話題には恥じらいもする。":143,"まあミコは物言いも殆ど同い年と言わんばかりだが、\n先刻も言ったようにそれくらいで良い」":144,"「結構歳の差あるんでしたっけ？[l]\nあれ、私と海に行った時はもう……[l]\nそのときミコさんは……あら？」":145,"「さ！[l]\n不穏で不毛な会話はこれくらいにしておこう。[l]\nただ、そうだなあ、\nあのカレ。":146,"彼を伴侶にしたいならそれなりに覚悟をしておいた方が\n良さそうだよ、ライヴァルが多いようだからね。[l]\nしかも強敵揃い……やあ、西石君？[l]\n冬夏君が来てくれた。入るよ」":147,"「──こんにちは、お邪魔します……[l]\nきぃ？」":148,"「……ふぇえ、[l]\nごめん汚いし、相変わらず狭くて恥ずかしいけどさ。[l]\nえっとその辺に……あぅ、[l]\nあとは道具さんに全部聞いて欲しいだわ」":149,"「はいはい分かってるよ。[l]\n世話人として僕がホスト代理を務めよう。":150,"さて冬夏君、早速だがそこのゴミ袋をこちらに。[l]\nそう、その空いたスペースにこの座布団を。[l]\n今見舞いの品を準備するから、\n存分に語らっていて呉れ給えよ。":151,"無理のない範囲でね。[l]\nでは暫し中座させて貰うが、\n二人ともごゆるりと」":152,"「すみません、お願いします……」":153,"「ああ、もう超汚い……[l]\n窓開けらんないし」":154,"「まあほら、\nでも男子より女子の部屋の方が汚いっていうか、\n男子校より女子校の方が超汚いって噂だから、\n気にしない！":155,"……ほんとは男女のどっちにも、[l]\n片付けられる人と片付けられない人、\n両方が居るんだろけどね。":156,"来る時トモさんとそんな話もしてきたけど。[l]\n慰めになるなら偏見でも何でも受け入れてみるもよし！」":157,"「あっははは……[l]\nそのうち機会あれば片付ける……機会あればね……」":158,"「ん、そのときは手伝うけど。[l]\nてか\n連絡つかなくなったから心配してたよ。":159,"滞納？[l]\n都合により掛かりませんって。[l]\n前はジャック抜けたまま放置してた事あったけど、\n確かその時は自動音声無かったし」":160,"「んー、そんなとこ。[l]\n丁度……あそこに入った後から体調崩して、[l]\n……ふぁあ、バイトも行けなくて困ってたんだわ。":161,"今まで体調崩す事は無かったんだけど、\n最近どうもね……[l]\n腹減りで動けないことはあったけどさ」":162,"「私の方も情報が錯綜してっていうか、\n色々あってさ、\nでもトモさんこっち来てて良かったね」":163,"「まね。[l]\nほんと、今までは何とかなってたんだけど……[l]\nん、色々あってって、\n家出、したってやつさ……？」":164,"「なに、トモさんから聞いたの？[l]\n家出って言うかさァ、\nうーん……まあ、外泊はしてるけど。":165,"あ、全然心配要らないよ？[l]\nちゃんとやっとりまス、はい」":166,"「あっはは……まあ、[l]\n家族はどうでもいいけど……[l]\n家庭は大事に……した方がいいさ……[l]\nあんなババァはどうでもいいけど……」":167,"「……ん。[l]\nたはは……まぁね」":168,"「まこちゃんどうしてる……？[l]\nその冬夏の望む家庭をつくるにフカケツなひとじゃないのかな？[l]\n悪い虫がついてるんじゃないかと心配さ……[l]\nちゃんと頑張って貰わないといけないのだわ」":169,"「はぇっ？！[l]\nけほっ、けほけほ、\nなななな、何言ってるかなぁ。":170,"真言さんってあ、そおいえば！[l]\nほらこれ、今日の、真言さんからの差し入れだから。[l]\n後で会ったら御礼言ってよ？[l]\nアンパンと牛乳だって」":171,"「ふええ……さっすがまこちゃん……[l]\nこころのともよ……」":172,"「まあ、今んとこ支払いはトモさんだけどね……[l]\n……きぃってさ、」":173,"「ふぇ…？[l]\nあ、その眼は何か誤解してるそれ。[l]\nまこちゃんは好きだけどそういう意味じゃないから。":174,"こころのとも、おにいちゃん、めしづる、\nんーまあそんなとこだからさ、\n冬夏は安心してまこちゃんにアタックかければいいのだわ」":175,"「だから、な、な、何も言ってないんですけど！[l]\n言ってないんですけど何も！」":176,"「よいよい、\n望みがあるならいけばいいのさ、\n黙って後悔するよりは当たって砕けろでいくのが、\n後がない人間の":177,"理なのだわ。":178,"冬夏に後がないかどうかは、よっと、\nカクゴがはむそれはんあがむぐむぐ」":179,"「……いいからゆっくり食べなよ。[l]\nてか結構元気なんじゃない、それは良かったけど」":180,"「むえぇ？[l]\nまあ半分ふはいのほぅおは食へて寝れふぁうぁんほは」":181,"「だから食べてから喋ってって。[l]\nトモさんまだかな？[l]\n……まあきぃは何食べたってどんどん追加もいけるだろうけど」":182,"「ほでふ。[l]\nまああれよ、……なんだっけ？":183,"ああ、まこちゃんモノにするにも、\n一旦家に帰ってしっかとケリつけてからにしたほうが、\n後腐れなくていいとおもうけどさ。":184,"何しろ今年？今年度？で学校最後？[l]\n進路どうするんだわ？」":185,"「家を出る」":186,"「ふぇ」":187,"「仕事……したいかな。[l]\nいい職場ありそうなんだよね」":188,"「ま、あたしにゃ無縁だけどさ、\n大学とかは？」":189,"「……なんか自活しながら通える気がしないっていうか。[l]\nモラトリアムに興味っていうか未練ないの私。[l]\nそれより一刻も早くね、」":190,"「家庭を持ちたいかぁ……[l]\nいいねえ～うまらやしのだわ」":191,"「なっ、何語よそれ？！[l]\nじゃなくて、\nあ、相手も居ないのにどうこうできないじゃん……」":192,"「だから……皆まで言わす気？」":193,"「さ、\nこちらは準備出来たのだが……[l]\nほう西石君も大分顔色が良いね。[l]\n冬夏君を連れて来た甲斐があったというものだ」":194,"「ふぇあ！[l]\n豪勢な香りが……」":195,"「うあ、トモさんて料理上手いひと？」":196,"「ん？[l]\nモノをつくったりいじったりするのは得意というか、\n趣味でもあるし、\n僕のライフワークかなあ。":197,"その辺の事は知ってるだろう冬夏君も」":198,"「あ、」":199,"「んなことよりも！！[l]\nぷりーず！！[l]\nぎぶみーふーず！！！[l]\nぎぶみーふーーーーーーーーず！！！！！！」":200,"「ちゃんと冬夏君のも残しておき給えよ。[l]\nじゃ、そう言うことだから。[l]\n僕等もご相伴にあずかろう」":201,"「はぁ……[l]\nじゃ、遠慮無くいただきま……ってもう食べてるし！」":202,"「ふんぐ？」":203,"「ははは、平和だねぇ……[l]\nこんな日々がずっと続いていけたらいいねえ。[l]\nそう思わないかね、\nお二人さん」":204},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_019.ks","relPath":"/data/scenario/SC_S_019.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":202,"length":205,"percent":98.53658536585365},"cellInfo":[]},"/data/scenario/SC_S_020.ks":{"data":[["そういえば、\nあの蔵に入ってからの事、\n聞いてなかったね。","说起来，\n进过那座仓库之后的事，\n还没听你们说过呢。"],["僕等が創ったネコガミ達はどうだった？","我们创造的猫神们怎么样了？"],["ああ、君は魔眼質が視覚として顕現してる訳じゃないのか。[l]\nいや、解釈が少々違うのか……","啊，你的魔眼质并没有作为视觉显现出来吗。[l]\n不，或许解释有些偏差……"],["でも彼が見付けてくれたのだね？","不过是他找到的吧？"],["にしても、\n西部ではなく、\nよもや此処の彼処に隠してたとはね。","即便如此，\n并非藏在西部，\n竟然分散藏在这种地方啊。"],["旅費だって馬鹿にならないだろうにねえ。[l]\nその辺りも含めてのモチベーションかな、\n彼女は。","光是旅费就不是小数目吧。[l]\n这部分也包含在她的动机里，\n大概。"],["それか、猫の萌芽の運び手さんか？[l]\nナナによれば何やらＷＥとかいうのは、\n八相には無い九番も当然具えている訳で、\nつまり、箒で空も飛べる訳だ。","或者说，是猫之萌芽的搬运者吗？[l]\n据名无所说那个叫WE的东西，\n八相没有的第九号自然也具备着，\n也就是说，用扫帚也能飞上天。"],["それにしても。","话说回来。"],["まあ、\n邪魔モノが誰かは固まりつつあるから、\n次のステージに進む為に、","嘛，\n碍事者是谁已经逐渐明朗了，\n为了进入下一阶段，"],["いろいろ動こうじゃないか。[l]\n遊ぼうじゃないか。","咱们行动起来吧。[l]\n来玩吧。"],["君と、僕の為にもね。","为了你，也为了我。"]],"context":[["SC_S_020.ks/index/1/text"],["SC_S_020.ks/index/3/text"],["SC_S_020.ks/index/5/text"],["SC_S_020.ks/index/7/text"],["SC_S_020.ks/index/9/text"],["SC_S_020.ks/index/11/text"],["SC_S_020.ks/index/13/text"],["SC_S_020.ks/index/15/text"],["SC_S_020.ks/index/17/text"],["SC_S_020.ks/index/19/text"],["SC_S_020.ks/index/21/text"]],"tags":[],"parameters":[[{"start":142,"end":179}],[{"start":187,"end":205}],[{"start":213,"end":262}],[{"start":270,"end":285}],[{"start":293,"end":332}],[{"start":340,"end":395}],[{"start":403,"end":488}],[{"start":496,"end":503}],[{"start":511,"end":554}],[{"start":562,"end":592}],[{"start":600,"end":610}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_020.ks","basename":"SC_S_020.ks","indexIds":{"そういえば、\nあの蔵に入ってからの事、\n聞いてなかったね。":0,"僕等が創ったネコガミ達はどうだった？":1,"ああ、君は魔眼質が視覚として顕現してる訳じゃないのか。[l]\nいや、解釈が少々違うのか……":2,"でも彼が見付けてくれたのだね？":3,"にしても、\n西部ではなく、\nよもや此処の彼処に隠してたとはね。":4,"旅費だって馬鹿にならないだろうにねえ。[l]\nその辺りも含めてのモチベーションかな、\n彼女は。":5,"それか、猫の萌芽の運び手さんか？[l]\nナナによれば何やらＷＥとかいうのは、\n八相には無い九番も当然具えている訳で、\nつまり、箒で空も飛べる訳だ。":6,"それにしても。":7,"まあ、\n邪魔モノが誰かは固まりつつあるから、\n次のステージに進む為に、":8,"いろいろ動こうじゃないか。[l]\n遊ぼうじゃないか。":9,"君と、僕の為にもね。":10},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_020.ks","relPath":"/data/scenario/SC_S_020.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":11,"length":11,"percent":100},"cellInfo":[]},"/data/scenario/SC_S_021.ks":{"data":[["@r真ハ偽ノ","@r真或伪之"],["臺、\n@r既解のかみ、\n@r隔世の覚醒による廓清、\n@r──といったところか。","台，\n@r既解之神，\n@r隔世觉醒带来的廓清，\n@r──大概如此吧。"],["@rざっと","@r粗略"],["視の概括にすぎないが……","只是视觉层面的概括……"],["@rかれおんが向こうに招集されるような事があれば、\n俺もひっついてこうかなあ。","@r要是卡蕾欧被那边召集的话，\n我也跟着去好了。"],["@r俺って良いヤツだからなあ。","@r毕竟我可是个好家伙啊。"],["@r察しも良ければ都合も良い、\n@r友人の中の友人、恋人の中の恋人ゆっきーさんは、\n@rいつでもアナタの慰めよりどころ。","@r善解人意又方便使唤，\n@r友人中的友人，恋人中的恋人阿雪先生，\n@r随时都是你的慰藉依靠。"],["@rヒトの朋友たる俺っちの、\n涙ぐましいまでの献身たるや我ながら──\n@rま、他が薄情杉つうか。","@r作为人类朋友的我，\n这献身精神连自己都感动到落泪──\n@r嘛，其他人都太薄情了。"],["@rもし向こうが気付いていて、\n俺を近づけさせないようにする動きをみせたらば、\nどうしたものかな。","@r如果对方察觉到了，\n做出不让我靠近的举动的话，\n该怎么办呢。"],["@r俺も武力介入する気はないし、\n連中には極力関わりたくはないんだが、\n@r友を放ってはおけない。","@r我也不想武力介入，\n实在不愿和那群人扯上关系，\n@r但不能对朋友见死不救。"],["@r俺って良いヤツだから。","@r毕竟我可是个好家伙。"],["@rこないだ会った四人は少々面倒そうだが、\n他にも武闘派いるのかね。","@r上次遇到的四人有点麻烦，\n还有其他武斗派吗。"],["@r……。",""],["@r今来てるらしい外来は──","@r现在正赶来的外来者是──"],["@rXⅢ/Leaders in the CrossW=LCrossW=LXX……[l]\nCovenか、","@rXⅢ/Leaders in the CrossW=LCrossW=LXX……[l]\nCoven吗，"],["@r重架空、……かなり変化したか？俺が知ってたのよりは随分…[l]\n蒼白穿、……向こうでもう接触してるな、[l]\n月吼狼、ああ、うん。ほう。[l]\n定義録器、あれらは斎串魔眼窪とよぶか、\n……ｖ☆？、まあいいかこれは面倒だし、で、","@r重架空，……变化挺大？比我印象中差很多…[l]\n苍白穿，……已经在那边接触过了，[l]\n月吼狼，啊，嗯。嚯。[l]\n定义录器，那些该叫斋串魔眼洼吧，\n……v☆？，算了这个太麻烦，然后，"],["@r酒露婆神、\n絞首様、\n五波羅蜜、\n誘裂圧、\n埋骸、\n全雑魚自動鏖殺…げ、厭なのがいるなーこれ、で、[l]\n未羽蛹、","@r酒露婆神，\n绞首大人，\n五波罗蜜，\n诱裂压，\n埋骸，\n全杂鱼自动鏖杀…噫，有个恶心的家伙啊这个，接着，[l]\n未羽蛹，"],["@r最後が……","@r最后是……"],["@rよくわからんが１３番目も──いるな。[l]\n@rん？[l]\n@r違う？[l]\n@rなにやらややこしいな。[l]\n@r三位一体にしても……[l]\n@rまだ未解封てことか。","@r搞不懂但第13号也──在呢。[l]\n@r嗯？[l]\n@r不对？[l]\n@r感觉有点复杂啊。[l]\n@r就算是三位一体也……[l]\n@r说明还没解封吗。"],["@r否、そもそも新規か？[l]\n@r連番とは別か？[l]\n在来……かどうかもよくわからんな。[l]\n@r少なくとも『それ』に関しては昔のじゃない……[l]\n@rうむ、とにかくよくわからん。[l]\n@rで、古い方も少々弄ってあるのな。","@r不，难道是新增的？[l]\n@r和编号无关吗？[l]\n本土……是不是也不好说。[l]\n@r至少关于『那个』不是旧时代的……[l]\n@r唔，总之搞不明白。[l]\n@r而且旧时代的也被动了些手脚。"],["@r──いぐ、[l]\n@rIg:TYPE･MEGA-D「P+」……？[l]\n@rMEGA-Dは俺のおぼろげな記憶にもあるあれだろ、\nシガンの、初回限定版豪華特典付きみたいな扱いの……[l]\nただ「+」の刻印は無かった気がするがなあ。","@r──唔、[l]\n@rIg:TYPE･MEGA-D「P+」……？[l]\n@rMEGA-D在我模糊记忆里确实是那个玩意儿吧、\n像是希甘附赠初回限定版豪华特典的那种……[l]\n不过印象中应该没有「+」的刻印来着。"],["@r知らないうちに書き換えたか？[l]\n今シるまで、少なくとも数年前までは休止状態だったが。[l]\n刻印の書き換えからして、\n「失敗したあの遣り方」にパッチあてたつーことかな。[l]\n@rいずれにしろ、MEGA-Dが今","@r难道趁我不注意时被改写了？[l]\n至少到几年前为止都处于休眠状态才对。[l]\n从刻印被改写来看、\n大概是给「那次失败操作」打了补丁的意思吧。[l]\n@r总之，MEGA-D现在"],["彼","那"],["処に\n在るコト自体は不思議ではないが、\n起動してるコトが意味することはただひとつ、","存在\n于此本身并不奇怪、\n但它正在运行这件事只意味着一件事、"],["\n\n\n当たり前だ。[l]\n@rIg:TYPE･MEGA-Dは、[l]\n@r……となれば、やはり行った方が良いのかねえ。","\n\n\n理所当然的。[l]\n@rIg:TYPE･MEGA-D是、[l]\n@r……这样的话，果然还是该去一趟吧。"],["@rが、そうにしたって武闘派は極力回避だろうな。[l]\n特に","@r不过就算要去也得尽量避免武斗派那群人。[l]\n特别是"],["全","完"],["雑","杂"],["魚","鱼"],["自","自"],["動","动"],["鏖","鏖"],["殺とは絶対に接触したくない。[l]\n今は多分待機側の面子だろうから、\n向こうに出張ってこない内になんとかしてえ。[l]\nだから基本的には補助しかするつもりはねーけど。[l]\nかれおんの事もあるし、\nこっちが無害とみせておかないと面倒くさい。[l]\nあすこの在来は殆ど無視出来るし──","杀绝对不想接触。[l]\n现在他们多半处于待机状态、\n得趁对方没主动找上门之前想办法解决。[l]\n所以我基本上只打算做辅助工作。[l]\n而且考虑到卡蕾欧的事、\n不装出无害的样子会很麻烦。[l]\n那边的在来种基本可以无视──"],["「あのぉー、\n起きてました？」","「那个～\n醒着吗？」"],["「んあ、\nおういえ」","「嗯啊、\n噢在呢」"],["「ただいま……です」","「我回来了……的说」"],["「おかいもん。[l]\n同僚達は？」","「欢迎回来。[l]\n同事们呢？」"],["「えーと、\n二手に分かれて、\n片方は玄ノ森に……[l]\n片方はそのまま……」","「呃～\n分成两批、\n一队去玄之森了……[l]\n另一队直接……」"],["「あれ、かれおんはついて行かんの？[l]\n或いは残り連中と」","「咦，卡蕾欧没跟着去吗？[l]\n还是说留在其他组里」"],["「あ゛ふ…[l]\nうえーっと、\n留守番を頼まれたデスよ。","「啊呜…[l]\n那个～\n被拜托看家DESU哟。"],["いあ、留守番というか、\n彼氏と一緒にいろって……」","不对，不算是看家、\n说是和男朋友一起待着……」"],["「マジ？[l]\nどういう同僚だよ。[l]\nてか玄ノ森行くなら俺もついてこうと思ってたのに。[l]\nいーくんも居るんだろうし」","「真假？[l]\n这什么同事啊。[l]\n话说要去玄之森的话我本来也想跟着去的。[l]\n饭君应该也在那边吧」"],["まあ、ごめん、いろいろフカシだ。[l]\nでも言わぬが花という事もあるんだわ。[l]\nほんとごめん。","嘛，抱歉，刚才都是瞎扯的。[l]\n不过有些事不说破比较美好啦。[l]\n真的对不起。"],["「んー、\n……ワタシ、あなたの彼女ですよね？」","「嗯～\n……我、是你的女朋友对吧？」"],["「んー？[l]\n俺が規定しちゃって良いんなら、\nそうだよ。[l]\nマイハニー」","「嗯～？[l]\n如果可以由我来定义的话、\n没错啊。[l]\n我的甜心」"],["「ホントウは、仕事の同僚の言うこと、\n聞かなきゃいけないんでしょうけど…","「其实呢、工作上同事说的话、\n本来是非听不可的…"],["もし、あなたが、\nむこうに、オトモダチの所に行きたいなら、\nワタシは」","但如果你、\n想去那边、朋友那里的话、\n我会」"],["「すべてをいうことはないかれおん」","「不必全盘托出哦卡蕾欧」"],["流石は俺が","不愧是我"],["視","视"],["初めた女子。[l]\nあの連中とは嗜好が完全には馴染まない──つまり、\n俺好みなヒトだったね。","初次交往的女孩。[l]\n和那群家伙的嗜好完全合不来──也就是说，\n正是我喜欢的类型呢。"],["それでいてＣＡＴ親和力の高い、\n素敵なヒト。","同时还具备超高CAT亲和力的，\n完美女孩。"],["愛してるよかれおん。","我爱你哦卡蕾欧。"],["何にしても、彼奴等の動きだな。","总之先看那群家伙的行动吧。"],["どうにも俺の趣味じゃないなあ。[l]\nもともと水が合わなくて彼処をおん出た俺だし。[l]\nちっとはイーくんフォローしてあげても罰はあたらんでしょ。[l]\n何よりあの兄妹にはいい薬になるだろ。","实在是不合我的口味啊。[l]\n本来就是因为水土不服才离开那里的我。[l]\n稍微帮帮小伊也不会遭报应吧。[l]\n对那对兄妹来说更是剂良药。"],["……妹は兎も角兄貴にとっては織り込み済み──否、[l]\n全部自分の側にひん曲げちまうかもだが、\nそれでもイーくんをこのまま見過ごすよりはマシだ。","……妹妹暂且不论，对哥哥来说早该料到──不，[l]\n说不定会把所有事都扭曲成对自己有利，\n但总比对小伊见死不救强。"],["「かれおん、\n……俺のこと、もう知ってんね？」","「卡蕾欧，\n……你已经知道我的事了吧？」"],["「はいっ？！」","「诶？！」"],["「ま、当たり。[l]\nさっすが","「嘛，答对。[l]\n真不愧是"],["月","月"],["吼","吼"],["狼、\nその鼻は欺けないねえ。[l]\nで、かれおんに監視は付いてる？」","狼，\n骗不过你的鼻子呢。[l]\n所以卡蕾欧你有被监视吗？」"],["「え？[l]\nは？[l]\nな、ナンノコトデショウ」","「啊？[l]\n啥？[l]\n这、这是什么意思呀」"],["「もうお互い隠し事無しで行こうぜ。[l]\n俺はかれおんが読んだ通り。[l]\nＤ（ド）のなれの果て。[l]\nPHASE:10主体となる茶黒の首。","「咱们别再互相隐瞒了。[l]\n我就是卡蕾欧读到的那个存在。[l]\nD（Do）的末路。[l]\nPHASE:10 作为主体的茶黑色首级。"],["ま、今後もゆっきーで構わないよ。[l]\nで、他のお仲間がいるんじゃん？[l]\n俺は網の目くぐれるけど、\nかれおんはどうなの、ってこと。","嘛，今后继续叫我阿雪就行。[l]\n话说你还有其他同伴对吧？[l]\n我是能逃过天罗地网啦，\n但卡蕾欧你怎么办。"],["監視ないなら──移動は自由なら、\nまあ、PHASE:9、イーくんの元の身体の翼があるし、\nそれなりに動き回れると思うんだけど」","如果没被监视──行动自由的话，\n毕竟还有PHASE:9时期小伊原本身体的翅膀，\n应该能自由活动才对」"],["「………ワカリました……[l]\nでも、通常交通機関のが良いと思うデスよ。","「………明白了……[l]\n不过建议使用常规交通工具。"],["いざという時まで。[l]\nワタシは異羽もフェンリロスも遣えますが、\n流石に連続や同時となると──」","直到万不得已时。[l]\n虽然我能同时操纵异羽和芬里洛斯，\n但连续或同时使用果然还是──」"],["「流石、覚悟決まると理解も対応も早いね。[l]\nそれでこそ俺の","「不愧是我看中的女人，觉悟后理解应对都很快。[l]\n这才配当我的"],["初めた女子。[l]\nほんとに大好き。[l]\nで、何か他に注意すべき点は？」","初恋女孩。[l]\n真的超喜欢你。[l]\n还有其他需要注意的吗？」"],["「先日会わせた四人が向こうに……[l]\nこっちに残る殆どは、\n能動的なチカラはあまり得手じゃありません、\nスロタラスモルト……知ってますよねその様子じゃ？","「前几天见过的四人去了那边……[l]\n留在这边的几乎都是，\n不擅长主动使用能力的类型，\n斯洛塔拉斯莫尔特……看反应您已经知道了？"],["それが起動待機してはいます、が、\n近寄らなければ、\nあと向こうには、直属の上が、」","它目前处于启动待机状态，\n只要不靠近的话，\n另外那边还有直属上级在，」"],["「んー、\nそのマスクのヒトは多分大丈夫、\n俺等が『そういう意図』で動く限りは同調してくれこそすれ、\n叱られることはない」","「嗯ー，\n那个戴面具的大概没问题，\n只要我们按『那种意图』行动，她非但不会阻挠，\n反而会配合我们」"],["多分。","大概。"],["「ぅぇ、そ、そうでしょうか……」","「呜诶，真、真的吗……」"],["スロタラスモルトは来ないなら、\n近づかなければ取り敢えずは何とかなるべ。","只要斯洛塔拉斯莫尔特不来，\n暂时保持距离总能有办法。"],["全自動は厄介なんだよ、\n紫靄じゃあるまいし、誰彼構わず射程距離内を自動でだ？[l]\nあれ怖ぇって。気持ち悪いし。","全自动真的很麻烦啊、\n又不是紫色雾霭、难道要无差别自动攻击射程范围内所有目标？[l]\n那玩意儿超可怕。还让人恶心。"],["「んだば準備しようか。[l]\n今回の色々が終わったら、\nかれおん、\n俺言うことがあるから」","「那就开始准备吧。[l]\n等这次各种事情结束后、\n卡蕾欧、\n我有话要对你说」"],["「……はい？」","「……啊？」"],["「だからま、無事に戻ってこようぜ」","「所以说啊、一定要平安回来」"],["さて、","话说，"],["こういうのは、\n少なくとも初回は『巧遅は拙速に如かず』でいかんと、\nこればっかりは言葉選びやら意図の整理が余計な心遣いになり兼ねん。","这种事儿啊，\n至少第一次得遵循『巧迟不如拙速』才行，\n唯独这种情况字斟句酌和梳理意图反而容易弄巧成拙。"],["ヒトにもよるが今のいーくんには、\n待つ行為自体が酷になるだろ。","虽因人而异但对现在的饭君来说，\n光是等待这个行为本身就很折磨吧。"],["だからこれから、\n何があっても、","所以接下来，\n无论发生什么，"],["心折れるなよ。","都别灰心啊。"]],"context":[["SC_S_021.ks/index/1/text"],["SC_S_021.ks/index/3/text"],["SC_S_021.ks/index/5/text"],["SC_S_021.ks/index/7/text"],["SC_S_021.ks/index/9/text"],["SC_S_021.ks/index/11/text"],["SC_S_021.ks/index/13/text"],["SC_S_021.ks/index/15/text"],["SC_S_021.ks/index/17/text"],["SC_S_021.ks/index/19/text"],["SC_S_021.ks/index/21/text"],["SC_S_021.ks/index/23/text"],["SC_S_021.ks/index/25/text"],["SC_S_021.ks/index/27/text"],["SC_S_021.ks/index/29/text"],["SC_S_021.ks/index/31/text"],["SC_S_021.ks/index/33/text"],["SC_S_021.ks/index/35/text"],["SC_S_021.ks/index/37/text"],["SC_S_021.ks/index/39/text"],["SC_S_021.ks/index/41/text"],["SC_S_021.ks/index/43/text"],["SC_S_021.ks/index/45/text"],["SC_S_021.ks/index/47/text"],["SC_S_021.ks/index/49/text"],["SC_S_021.ks/index/51/text"],["SC_S_021.ks/index/53/text"],["SC_S_021.ks/index/55/text"],["SC_S_021.ks/index/57/text"],["SC_S_021.ks/index/59/text"],["SC_S_021.ks/index/61/text"],["SC_S_021.ks/index/63/text"],["SC_S_021.ks/index/65/text"],["SC_S_021.ks/index/67/text"],["SC_S_021.ks/index/69/text"],["SC_S_021.ks/index/71/text"],["SC_S_021.ks/index/73/text"],["SC_S_021.ks/index/75/text"],["SC_S_021.ks/index/77/text"],["SC_S_021.ks/index/79/text"],["SC_S_021.ks/index/81/text"],["SC_S_021.ks/index/83/text"],["SC_S_021.ks/index/85/text"],["SC_S_021.ks/index/87/text"],["SC_S_021.ks/index/89/text"],["SC_S_021.ks/index/91/text"],["SC_S_021.ks/index/93/text"],["SC_S_021.ks/index/95/text"],["SC_S_021.ks/index/97/text"],["SC_S_021.ks/index/99/text","SC_S_021.ks/index/139/text"],["SC_S_021.ks/index/101/text"],["SC_S_021.ks/index/103/text"],["SC_S_021.ks/index/105/text"],["SC_S_021.ks/index/107/text"],["SC_S_021.ks/index/109/text"],["SC_S_021.ks/index/111/text"],["SC_S_021.ks/index/113/text"],["SC_S_021.ks/index/115/text"],["SC_S_021.ks/index/117/text"],["SC_S_021.ks/index/119/text"],["SC_S_021.ks/index/121/text"],["SC_S_021.ks/index/123/text"],["SC_S_021.ks/index/125/text"],["SC_S_021.ks/index/127/text"],["SC_S_021.ks/index/129/text"],["SC_S_021.ks/index/131/text"],["SC_S_021.ks/index/133/text"],["SC_S_021.ks/index/135/text"],["SC_S_021.ks/index/137/text"],["SC_S_021.ks/index/141/text"],["SC_S_021.ks/index/143/text"],["SC_S_021.ks/index/145/text"],["SC_S_021.ks/index/147/text"],["SC_S_021.ks/index/149/text","SC_S_021.ks/index/153/text"],["SC_S_021.ks/index/151/text"],["SC_S_021.ks/index/155/text"],["SC_S_021.ks/index/157/text"],["SC_S_021.ks/index/159/text"],["SC_S_021.ks/index/161/text"],["SC_S_021.ks/index/163/text"],["SC_S_021.ks/index/165/text"],["SC_S_021.ks/index/167/text"],["SC_S_021.ks/index/169/text"],["SC_S_021.ks/index/171/text"],["SC_S_021.ks/index/173/text"]],"tags":[],"parameters":[[{"start":193,"end":201}],[{"start":212,"end":269}],[{"start":275,"end":282}],[{"start":291,"end":303}],[{"start":315,"end":360}],[{"start":366,"end":383}],[{"start":389,"end":463}],[{"start":475,"end":535}],[{"start":543,"end":602}],[{"start":614,"end":675}],[{"start":681,"end":696}],[{"start":702,"end":742}],[{"start":754,"end":761}],[{"start":767,"end":783}],[{"start":795,"end":852}],[{"start":858,"end":991}],[{"start":1003,"end":1088}],[{"start":1094,"end":1103}],[{"start":1115,"end":1233}],[{"start":1245,"end":1391}],[{"start":1405,"end":1543}],[{"start":1555,"end":1684}],[{"start":1694,"end":1695}],[{"start":1704,"end":1753}],[{"start":1763,"end":1846}],[{"start":1862,"end":1898}],[{"start":1908,"end":1909}],[{"start":1918,"end":1919}],[{"start":1928,"end":1929}],[{"start":1938,"end":1939}],[{"start":1948,"end":1949}],[{"start":1958,"end":1959}],[{"start":1968,"end":2133}],[{"start":2235,"end":2254}],[{"start":2285,"end":2299}],[{"start":2330,"end":2340}],[{"start":2371,"end":2392}],[{"start":2423,"end":2473}],[{"start":2504,"end":2538}],[{"start":2569,"end":2605}],[{"start":2613,"end":2642}],[{"start":2673,"end":2747}],[{"start":2773,"end":2830}],[{"start":2861,"end":2888}],[{"start":2919,"end":2970}],[{"start":3001,"end":3041}],[{"start":3049,"end":3092}],[{"start":3123,"end":3140}],[{"start":3166,"end":3171}],[{"start":3180,"end":3181},{"start":4322,"end":4323}],[{"start":3190,"end":3244}],[{"start":3252,"end":3278}],[{"start":3286,"end":3296}],[{"start":3304,"end":3319}],[{"start":3327,"end":3434}],[{"start":3442,"end":3522}],[{"start":3553,"end":3580}],[{"start":3636,"end":3643}],[{"start":3674,"end":3693}],[{"start":3703,"end":3704}],[{"start":3714,"end":3715}],[{"start":3725,"end":3767}],[{"start":3798,"end":3831}],[{"start":3862,"end":3945}],[{"start":3953,"end":4032}],[{"start":4040,"end":4111}],[{"start":4142,"end":4182}],[{"start":4190,"end":4247}],[{"start":4278,"end":4313}],[{"start":4332,"end":4377}],[{"start":4408,"end":4497}],[{"start":4505,"end":4554}],[{"start":4585,"end":4657}],[{"start":4683,"end":4686},{"start":4759,"end":4762}],[{"start":4717,"end":4733}],[{"start":4770,"end":4810}],[{"start":4818,"end":4882}],[{"start":4913,"end":4970}],[{"start":5001,"end":5008}],[{"start":5039,"end":5056}],[{"start":5082,"end":5085}],[{"start":5093,"end":5167}],[{"start":5175,"end":5210}],[{"start":5218,"end":5238}],[{"start":5246,"end":5253}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_021.ks","basename":"SC_S_021.ks","indexIds":{"@r真ハ偽ノ":0,"臺、\n@r既解のかみ、\n@r隔世の覚醒による廓清、\n@r──といったところか。":1,"@rざっと":2,"視の概括にすぎないが……":3,"@rかれおんが向こうに招集されるような事があれば、\n俺もひっついてこうかなあ。":4,"@r俺って良いヤツだからなあ。":5,"@r察しも良ければ都合も良い、\n@r友人の中の友人、恋人の中の恋人ゆっきーさんは、\n@rいつでもアナタの慰めよりどころ。":6,"@rヒトの朋友たる俺っちの、\n涙ぐましいまでの献身たるや我ながら──\n@rま、他が薄情杉つうか。":7,"@rもし向こうが気付いていて、\n俺を近づけさせないようにする動きをみせたらば、\nどうしたものかな。":8,"@r俺も武力介入する気はないし、\n連中には極力関わりたくはないんだが、\n@r友を放ってはおけない。":9,"@r俺って良いヤツだから。":10,"@rこないだ会った四人は少々面倒そうだが、\n他にも武闘派いるのかね。":11,"@r……。":12,"@r今来てるらしい外来は──":13,"@rXⅢ/Leaders in the CrossW=LCrossW=LXX……[l]\nCovenか、":14,"@r重架空、……かなり変化したか？俺が知ってたのよりは随分…[l]\n蒼白穿、……向こうでもう接触してるな、[l]\n月吼狼、ああ、うん。ほう。[l]\n定義録器、あれらは斎串魔眼窪とよぶか、\n……ｖ☆？、まあいいかこれは面倒だし、で、":15,"@r酒露婆神、\n絞首様、\n五波羅蜜、\n誘裂圧、\n埋骸、\n全雑魚自動鏖殺…げ、厭なのがいるなーこれ、で、[l]\n未羽蛹、":16,"@r最後が……":17,"@rよくわからんが１３番目も──いるな。[l]\n@rん？[l]\n@r違う？[l]\n@rなにやらややこしいな。[l]\n@r三位一体にしても……[l]\n@rまだ未解封てことか。":18,"@r否、そもそも新規か？[l]\n@r連番とは別か？[l]\n在来……かどうかもよくわからんな。[l]\n@r少なくとも『それ』に関しては昔のじゃない……[l]\n@rうむ、とにかくよくわからん。[l]\n@rで、古い方も少々弄ってあるのな。":19,"@r──いぐ、[l]\n@rIg:TYPE･MEGA-D「P+」……？[l]\n@rMEGA-Dは俺のおぼろげな記憶にもあるあれだろ、\nシガンの、初回限定版豪華特典付きみたいな扱いの……[l]\nただ「+」の刻印は無かった気がするがなあ。":20,"@r知らないうちに書き換えたか？[l]\n今シるまで、少なくとも数年前までは休止状態だったが。[l]\n刻印の書き換えからして、\n「失敗したあの遣り方」にパッチあてたつーことかな。[l]\n@rいずれにしろ、MEGA-Dが今":21,"彼":22,"処に\n在るコト自体は不思議ではないが、\n起動してるコトが意味することはただひとつ、":23,"\n\n\n当たり前だ。[l]\n@rIg:TYPE･MEGA-Dは、[l]\n@r……となれば、やはり行った方が良いのかねえ。":24,"@rが、そうにしたって武闘派は極力回避だろうな。[l]\n特に":25,"全":26,"雑":27,"魚":28,"自":29,"動":30,"鏖":31,"殺とは絶対に接触したくない。[l]\n今は多分待機側の面子だろうから、\n向こうに出張ってこない内になんとかしてえ。[l]\nだから基本的には補助しかするつもりはねーけど。[l]\nかれおんの事もあるし、\nこっちが無害とみせておかないと面倒くさい。[l]\nあすこの在来は殆ど無視出来るし──":32,"「あのぉー、\n起きてました？」":33,"「んあ、\nおういえ」":34,"「ただいま……です」":35,"「おかいもん。[l]\n同僚達は？」":36,"「えーと、\n二手に分かれて、\n片方は玄ノ森に……[l]\n片方はそのまま……」":37,"「あれ、かれおんはついて行かんの？[l]\n或いは残り連中と」":38,"「あ゛ふ…[l]\nうえーっと、\n留守番を頼まれたデスよ。":39,"いあ、留守番というか、\n彼氏と一緒にいろって……」":40,"「マジ？[l]\nどういう同僚だよ。[l]\nてか玄ノ森行くなら俺もついてこうと思ってたのに。[l]\nいーくんも居るんだろうし」":41,"まあ、ごめん、いろいろフカシだ。[l]\nでも言わぬが花という事もあるんだわ。[l]\nほんとごめん。":42,"「んー、\n……ワタシ、あなたの彼女ですよね？」":43,"「んー？[l]\n俺が規定しちゃって良いんなら、\nそうだよ。[l]\nマイハニー」":44,"「ホントウは、仕事の同僚の言うこと、\n聞かなきゃいけないんでしょうけど…":45,"もし、あなたが、\nむこうに、オトモダチの所に行きたいなら、\nワタシは」":46,"「すべてをいうことはないかれおん」":47,"流石は俺が":48,"視":49,"初めた女子。[l]\nあの連中とは嗜好が完全には馴染まない──つまり、\n俺好みなヒトだったね。":50,"それでいてＣＡＴ親和力の高い、\n素敵なヒト。":51,"愛してるよかれおん。":52,"何にしても、彼奴等の動きだな。":53,"どうにも俺の趣味じゃないなあ。[l]\nもともと水が合わなくて彼処をおん出た俺だし。[l]\nちっとはイーくんフォローしてあげても罰はあたらんでしょ。[l]\n何よりあの兄妹にはいい薬になるだろ。":54,"……妹は兎も角兄貴にとっては織り込み済み──否、[l]\n全部自分の側にひん曲げちまうかもだが、\nそれでもイーくんをこのまま見過ごすよりはマシだ。":55,"「かれおん、\n……俺のこと、もう知ってんね？」":56,"「はいっ？！」":57,"「ま、当たり。[l]\nさっすが":58,"月":59,"吼":60,"狼、\nその鼻は欺けないねえ。[l]\nで、かれおんに監視は付いてる？」":61,"「え？[l]\nは？[l]\nな、ナンノコトデショウ」":62,"「もうお互い隠し事無しで行こうぜ。[l]\n俺はかれおんが読んだ通り。[l]\nＤ（ド）のなれの果て。[l]\nPHASE:10主体となる茶黒の首。":63,"ま、今後もゆっきーで構わないよ。[l]\nで、他のお仲間がいるんじゃん？[l]\n俺は網の目くぐれるけど、\nかれおんはどうなの、ってこと。":64,"監視ないなら──移動は自由なら、\nまあ、PHASE:9、イーくんの元の身体の翼があるし、\nそれなりに動き回れると思うんだけど」":65,"「………ワカリました……[l]\nでも、通常交通機関のが良いと思うデスよ。":66,"いざという時まで。[l]\nワタシは異羽もフェンリロスも遣えますが、\n流石に連続や同時となると──」":67,"「流石、覚悟決まると理解も対応も早いね。[l]\nそれでこそ俺の":68,"初めた女子。[l]\nほんとに大好き。[l]\nで、何か他に注意すべき点は？」":69,"「先日会わせた四人が向こうに……[l]\nこっちに残る殆どは、\n能動的なチカラはあまり得手じゃありません、\nスロタラスモルト……知ってますよねその様子じゃ？":70,"それが起動待機してはいます、が、\n近寄らなければ、\nあと向こうには、直属の上が、」":71,"「んー、\nそのマスクのヒトは多分大丈夫、\n俺等が『そういう意図』で動く限りは同調してくれこそすれ、\n叱られることはない」":72,"多分。":73,"「ぅぇ、そ、そうでしょうか……」":74,"スロタラスモルトは来ないなら、\n近づかなければ取り敢えずは何とかなるべ。":75,"全自動は厄介なんだよ、\n紫靄じゃあるまいし、誰彼構わず射程距離内を自動でだ？[l]\nあれ怖ぇって。気持ち悪いし。":76,"「んだば準備しようか。[l]\n今回の色々が終わったら、\nかれおん、\n俺言うことがあるから」":77,"「……はい？」":78,"「だからま、無事に戻ってこようぜ」":79,"さて、":80,"こういうのは、\n少なくとも初回は『巧遅は拙速に如かず』でいかんと、\nこればっかりは言葉選びやら意図の整理が余計な心遣いになり兼ねん。":81,"ヒトにもよるが今のいーくんには、\n待つ行為自体が酷になるだろ。":82,"だからこれから、\n何があっても、":83,"心折れるなよ。":84},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_021.ks","relPath":"/data/scenario/SC_S_021.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":84,"length":85,"percent":98.82352941176471},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[64,0]},"/data/scenario/SC_S_022.ks":{"data":[["「……寒いな」","「……好冷」"],["「北だからな、春とは言え夜陰に乗じようとすれば当然そうなるが。[l]\nそれに海岸だ此処は」","「毕竟是北方，虽说是春天但趁夜行动自然会这样。[l]\n况且这儿还是海岸」"],["「何で普通に行かないかねぇ……」","「为啥不堂堂正正过去啊……」"],["「ドレの子孫が宿泊してるからだろ。[l]\n雫が咬んでるなら鉢合わせの可能性があるから、\n少しでも回避しようという魂胆。魂胆？","「因为德雷子孙在那边投宿吧。[l]\n如果雫正在追查的话可能会撞上，\n这是尽可能规避风险的算计。算计？"],["まあいっか。[l]\nで、旅館の屋上ついたらThousand……チノに連絡してあとは任せる」","嘛算了。[l]\n等到了旅馆屋顶就联系Thousand……千乃之后交给她」"],["「そうなのか？」","「是这样吗？」"],["「その初めて聞いた風なリアクションどういう事？[l]\nだからカゲロウに心配されるんだ」","「这副初次听闻的反应是怎么回事？[l]\n所以才会被蜉蝣担心啊」"],["「サクラは他人と行動する時、\n同行者の脳を外部記憶装置及び作業領域として使う癖、傾向が」","「樱与他人同行时，\n有将同伴大脑当作外接存储设备和工作区使用的癖好、倾向」"],["「そそ、あたしぁ","「对呀对呀，人家"],["何","在"],["時だってちゃんと聞いてるし、\nソロん時は記憶もしてるって。[l]\nあんたらと動くときはあれだ、\n聞いてるけど書き込み保存まではしない事にしてんの。","该听的时候都有好好在听，\n单独行动时也都会记住啦。[l]\n和你们组队的时候嘛，\n虽然会听但默认不写入保存功能。"],["信頼の証だよだから。[l]\nそう思っておきなって」","这可是信赖的证明哦。[l]\n你就这么理解就行」"],["「",""],["御","御"],["上からしてメモないとtodo忘れる訳だからな、\nそんな集団の一員としてご立派な事だよ。[l]\n精精あたしらに感謝する。[l]\nいずれ眼に視える形での贈答を願うよ」","毕竟连上头那帮人不记备忘录都会忘事，\n作为这种团队的一员已经很了不起啦。[l]\n你们尽管感谢我们吧。[l]\n迟早会以肉眼可见的形式回礼的」"],["「あーん、飯かカラオケ奢るって。６耐でも８耐でもいいワヨ？[l]\nで？[l]\n此処は何処で、どういうルートで向かう」","「啊——请吃饭或者唱K都行。6小时耐力赛还是8小时都随便啦？[l]\n所以？[l]\n现在位置在哪，该走什么路线」"],["「まず此処は玄ノ森に近接する町の、御覧の通り海岸です。[l]\n土地柄時節柄、夜ともなればほぼ人は居ませんのでね。[l]\n広さやアクセス、発動の容易さに関して諸条件を広範囲で満たす場所です」","「首先这里是邻近玄之森的城镇，如您所见是海岸。[l]\n这地方这季节，入夜后基本就没人了。[l]\n从面积、交通便利性到发动术式的难易度，各方面条件都很理想的场所」"],["「山の中じゃ駄目なのか？」","「在山里不行吗？」"],["「貴女は記憶してないでしょうが、\n例の不確定要素らしき存在と山中で接触した可能性あり、\nとの追加情報があります。","「虽然你应该不记得了，\n可能与那个疑似不确定因素的存在在山中有过接触，\n这是追加的情报。」"],["短絡的ではありますが避けられる状況は避けるに越したことはないので。[l]\n距離で言うと──それなりですかね。[l]\n箒ならば１時間もあれば着くかと思います。[l]\nアシストはアルコさんからPE貰えれば問題ないかと。","虽然有点武断但能避开的情况还是避开为好。[l]\n要说距离嘛──还算可以吧。[l]\n骑扫帚的话1小时就能到。[l]\n辅助方面只要能从阿露子那里拿到PE就没问题。"],["なのでいつも通り、\n私のｖ☆で全員を運搬します。[l]\n此処から屋上までPHASE:2-CF展開しつつ警戒は怠らず。[l]\nそれはサクラさんか余力あればアルコさんにもお願いします」","所以和往常一样，\n用我的v☆把全员运送过去。[l]\n从这里到屋顶展开PHASE:2-CF的同时不要放松警惕。[l]\n那部分如果樱小姐有余力的话也拜托阿露子小姐帮忙」"],["「ボクのテトは特化してて役にたたぬから！」","「我的tet是特化型派不上用场啦！」"],["「わかってるから。[l]\nいつもの事だから。[l]\nじゃ皆の衆、準備出来次第──」","「我知道的。[l]\n反正都是老样子了。[l]\n那各位，准备就绪后──」"],["「まて、ちょっと止まれアイ！！」","「等等、给我站住爱！！」"],["「？」",""],["「いるおＣＡＴが」","「有猫CAT在」"],["「何？」","「什么？」"],["「了解」","「收到」"],["「のらねこか？」","「野猫吗？」"],["「いや、ちがう」","「不、不对」"],["「…GreenWoodか？例の不確定要素？[l]\n嘘だろ、ドンピシャか？[l]\n今此処で？」","「…GreenWood吗？那个不确定因素？[l]\n开玩笑吧、完全吻合？[l]\n现在在这里？」"],["「何もんかは知んないけどいる。[l]\nねこかユーザーかどっちかわからぬ」","「不知道是什么玩意儿但有东西在。[l]\n分不清是猫还是用户」"],["「益々GWの可能性が高いって事だなあ」","「越来越可能是GW那家伙了」"],["「折角の対処が裏目に出るなんて……」","「难得对策却适得其反……」"],["「恐るべしは雫の余波か、\nアイが気にする事はないよ。[l]\nいずれにしても──向こうはまだ気付いてないな？」","「可怕的雫的余波啊、\n爱不用在意啦。[l]\n总之──那边还没发现吧？」"],["「マジか……[l]\nどれだけ事を引き起こすよ、\ndeus ex machinaの登場も","「真的假的……[l]\n到底要引发多少事端、\n连机械降神的登场"],["強ち夢物語じゃないッて事か？[l]\nつーか何処だよ？何処にいる？」","都未必是痴人说梦吗？[l]\n话说在哪啊？到底在哪儿？」"],["「ふひひひひひひひひ、チャンスだこれ」","「嘿嘿嘿嘿嘿嘿嘿、这可是机会」"],["「司書長は放置しろと言っていただろう。[l]\n気付かれてないなら尚のこと、\n此方から手を出す必要はない」","「司书长说过要放着不管吧。[l]\n既然没被发现、\n我们更没必要主动出手」"],["「いあ、ヤる」","「才、才要干」"],["「お嬢、あの方の言を無視はできません。[l]\nそれだけはお控えに」","「大小姐、那位的话不能无视。[l]\n唯独这个请克制」"],["「いあ、ヤる。[l]\nヤるったらヤるったらヤるっ！[l]\nボクをこれ以上待たすとどうなるかオシエテヤル」","「才、才要干。[l]\n说要干就是要干就是要干！[l]\n再让本大爷等下去会怎样要教教你吗」"],["「ばか、やめ！」","「笨蛋、住手！」"],["「だめだ。[l]\nもう待たない。[l]\n赦さない。[l]\nボクの苦しみを思い知らスゾ」","「不行了。[l]\n已经不等了。[l]\n不可饶恕。[l]\n让你体会本大爷的痛苦」"],["「（……きちゃったか）」","「（……来了吗）」"],["「お嬢、ちゃんと喚ばれて此処まで来たんですから。[l]\nもう少しで」","「大小姐、既然被正式召唤来到这里。[l]\n就差一点了」"],["「っっっせえな！！！[l]\n聞かねぇぇぇぇぇぇぇぇぇぇぇぇえええよ！！！！！！[l]\n知ったことか！！！！！！！！！","「烦死了！！！[l]\n谁要听啊啊啊啊啊啊啊啊啊！！！！！！[l]\n关我屁事！！！！！！！！！"],["ボクを待たす邪魔する反応よこさねえ奴にぁな、\nこっちから行くんだ！！！！！！！！！！！！","敢让本大爷等还妨碍的家伙、\n主动出击啦！！！！！！！！！！！！"],["アぁぁぁぁぁぁイ、ウォール！[l]\nアルコはぁアンカー！[l]\nサクラはバインドぉ！","啊啊啊啊啊爱、Wall！[l]\n阿露子是Anchor！[l]\n樱用Bind！"],["よぉ～っしミせるぞテト、\nいーかーぁてめぇら！」","很好~能行哦Tet、\n饭~你们这群混蛋！」"],["「……",""],["本","本"],["気かよ……」","有在听吗……」"],["「これより四重奏団による、EnderのGameを開始する！！！」","「现在开始四重奏团、Ender的Game启动！！！」"],["「馬鹿が！[l]\nGWにIgなんか、\n宿したPHASEによっては面倒な事に……","「白痴！[l]\n对GW用Ig什么的、\n根据宿存的PHASE可能会很麻烦……"],["だっ、大体お嬢リアルのガチは初だろが──\nってIronもう動いてるし！！」","而、而且大小姐现实里动真格是第一次吧──\n话说Iron已经动起来了！！」"],["「どうしようもないな……」","「没救了……」"],["「あんたも準備してるじゃん！[l]\nおいおいおい、大丈夫かよ」","「你不也在准备吗！[l]\n喂喂喂、真的没问题吗」"],["「Coven招集にあの娘組み込んだのも司書長だからな、\nあの方自身この展開も覚悟の上だろ」","「把那个女孩编入Coven也是司书长的决定、\n那位大人早料到这种展开了吧」"],["「う、そらそうかも知んねーけどさ……[l]\nしょうがね……[l]\nあたしらもガチは久々だしな、\n精々勘を取り戻させて貰うか──」","「唔、话是这么说啦……[l]\n没办法了……[l]\n咱们也好久没动真格了、\n就当重新找回手感吧──」"],["「GWならば有視覚とは限らないが、\n視えるヤツだったらちと面倒か、まあセオリー通りに」","「GW的话未必有视觉能力，\n但能看见的家伙就有点麻烦，嘛按理论来」"],["「あいよ、\nアイ、お嬢、\n──開宴了解」","「好嘞，\n爱，大小姐，\n──宴会开始明白」"],["四重奏団（クァルテット）は終わらすものの遊戯を紡ぐ──","四重奏（Quartet）编织着终结者的游戏──"],["@r汝は剣、\n終わらせる者の手にある","@r汝为剑，\n持于终结者之手"],["撫","抚"],["器、\n更に強きモノたる","器，\n更兼为更强之"],["筆記","书写"],["具をも兼ねん。[l]\nテトルジャトートリス、\n我が名はEnder:333。","具。[l]\n泰托尔贾托托利斯，\n吾名Ender:333。"],["汝は杯、\n柔らかなる猫の手で触れるがごとき、\n決して解けない枷もつ","汝为杯，\n如被柔软猫掌触碰般，\n亦缚永不解脱之枷"],["遊","妓"],["弋","弋"],["裸","裸"],["貝。[l]\nフロシルク、\n我が名はShackle。","贝。[l]\n弗洛希尔克，\n吾名Shackle。"],["汝は杖、\n魔女の大釜用いて","汝为杖，\n借魔女大釜"],["奇しもの掻き回せ、\n媚酒の","搅动奇异之物，\n媚酒"],["盃。[l]\nババッカナーリャガー、\n我が名はCall=R=W。","盏。[l]\n巴巴卡纳里亚加，\n吾名Call=R=W。"],["汝は星、\n装甲板か拘束具か、\nそのカタキをもって姫を守る","汝为星，\n装甲板抑或拘束具，\n以此仇敌守护姬君"],["愧","愧"],["死の五芒星。[l]\nｖ☆、\n我が名はIron。","死之五芒星。[l]\nv☆，\n吾名Iron。"],["The die is cast, \nA man can only die once,",""],["@rbut,",""],["@rA CAT has nine lives.",""],["@r演目（PROGRAM）","@r剧目（PROGRAM）"],["開始（START）","开始（START）"]],"context":[["SC_S_022.ks/index/1/text"],["SC_S_022.ks/index/3/text"],["SC_S_022.ks/index/5/text"],["SC_S_022.ks/index/7/text"],["SC_S_022.ks/index/9/text"],["SC_S_022.ks/index/11/text"],["SC_S_022.ks/index/13/text"],["SC_S_022.ks/index/15/text"],["SC_S_022.ks/index/17/text"],["SC_S_022.ks/index/19/text"],["SC_S_022.ks/index/21/text"],["SC_S_022.ks/index/23/text"],["SC_S_022.ks/index/25/text"],["SC_S_022.ks/index/27/text"],["SC_S_022.ks/index/29/text"],["SC_S_022.ks/index/31/text"],["SC_S_022.ks/index/33/text"],["SC_S_022.ks/index/35/text"],["SC_S_022.ks/index/37/text"],["SC_S_022.ks/index/39/text"],["SC_S_022.ks/index/41/text"],["SC_S_022.ks/index/43/text"],["SC_S_022.ks/index/45/text"],["SC_S_022.ks/index/47/text"],["SC_S_022.ks/index/49/text"],["SC_S_022.ks/index/51/text"],["SC_S_022.ks/index/53/text"],["SC_S_022.ks/index/55/text"],["SC_S_022.ks/index/57/text"],["SC_S_022.ks/index/59/text"],["SC_S_022.ks/index/61/text"],["SC_S_022.ks/index/63/text"],["SC_S_022.ks/index/65/text"],["SC_S_022.ks/index/67/text"],["SC_S_022.ks/index/69/text"],["SC_S_022.ks/index/71/text"],["SC_S_022.ks/index/73/text"],["SC_S_022.ks/index/75/text"],["SC_S_022.ks/index/77/text"],["SC_S_022.ks/index/79/text"],["SC_S_022.ks/index/81/text"],["SC_S_022.ks/index/83/text"],["SC_S_022.ks/index/85/text"],["SC_S_022.ks/index/87/text"],["SC_S_022.ks/index/89/text"],["SC_S_022.ks/index/91/text"],["SC_S_022.ks/index/93/text"],["SC_S_022.ks/index/95/text"],["SC_S_022.ks/index/97/text"],["SC_S_022.ks/index/99/text"],["SC_S_022.ks/index/101/text"],["SC_S_022.ks/index/103/text"],["SC_S_022.ks/index/105/text"],["SC_S_022.ks/index/107/text"],["SC_S_022.ks/index/109/text"],["SC_S_022.ks/index/111/text"],["SC_S_022.ks/index/113/text"],["SC_S_022.ks/index/115/text"],["SC_S_022.ks/index/117/text"],["SC_S_022.ks/index/119/text"],["SC_S_022.ks/index/121/text"],["SC_S_022.ks/index/123/text"],["SC_S_022.ks/index/125/text"],["SC_S_022.ks/index/127/text"],["SC_S_022.ks/index/129/text"],["SC_S_022.ks/index/131/text"],["SC_S_022.ks/index/133/text"],["SC_S_022.ks/index/135/text"],["SC_S_022.ks/index/137/text"],["SC_S_022.ks/index/139/text"],["SC_S_022.ks/index/141/text"],["SC_S_022.ks/index/143/text"],["SC_S_022.ks/index/145/text"],["SC_S_022.ks/index/147/text"],["SC_S_022.ks/index/149/text"],["SC_S_022.ks/index/151/text"],["SC_S_022.ks/index/153/text"],["SC_S_022.ks/index/155/text"],["SC_S_022.ks/index/157/text"],["SC_S_022.ks/index/159/text"],["SC_S_022.ks/index/161/text"],["SC_S_022.ks/index/163/text"],["SC_S_022.ks/index/165/text"],["SC_S_022.ks/index/167/text"]],"tags":[],"parameters":[[{"start":193,"end":200}],[{"start":231,"end":280}],[{"start":312,"end":328}],[{"start":359,"end":429}],[{"start":437,"end":486}],[{"start":518,"end":526}],[{"start":557,"end":604}],[{"start":631,"end":679}],[{"start":711,"end":719}],[{"start":728,"end":729}],[{"start":738,"end":823}],[{"start":829,"end":858}],[{"start":889,"end":890}],[{"start":899,"end":900}],[{"start":910,"end":1003}],[{"start":1035,"end":1101}],[{"start":1128,"end":1230}],[{"start":1262,"end":1275}],[{"start":1302,"end":1366}],[{"start":1374,"end":1493}],[{"start":1501,"end":1603}],[{"start":1635,"end":1656}],[{"start":1713,"end":1762}],[{"start":1794,"end":1810}],[{"start":1837,"end":1840}],[{"start":1872,"end":1881}],[{"start":1913,"end":1917}],[{"start":1996,"end":2000}],[{"start":2032,"end":2040}],[{"start":2071,"end":2079}],[{"start":2111,"end":2165}],[{"start":2197,"end":2237}],[{"start":2268,"end":2287}],[{"start":2314,"end":2332}],[{"start":2363,"end":2425}],[{"start":2457,"end":2508}],[{"start":2519,"end":2556}],[{"start":2588,"end":2607}],[{"start":2638,"end":2698}],[{"start":2730,"end":2737}],[{"start":2764,"end":2801}],[{"start":2833,"end":2893}],[{"start":2925,"end":2933}],[{"start":2965,"end":3020}],[{"start":3051,"end":3063}],[{"start":3090,"end":3128}],[{"start":3160,"end":3226}],[{"start":3234,"end":3282}],[{"start":3290,"end":3340}],[{"start":3348,"end":3376}],[{"start":3408,"end":3411}],[{"start":3421,"end":3422}],[{"start":3431,"end":3437}],[{"start":3469,"end":3501}],[{"start":3533,"end":3580}],[{"start":3586,"end":3627}],[{"start":3658,"end":3671}],[{"start":3703,"end":3738}],[{"start":3769,"end":3818}],[{"start":3850,"end":3926}],[{"start":3957,"end":4004}],[{"start":4036,"end":4064}],[{"start":4100,"end":4127}],[{"start":4133,"end":4157}],[{"start":4166,"end":4167}],[{"start":4176,"end":4191}],[{"start":4200,"end":4202}],[{"start":4211,"end":4256}],[{"start":4264,"end":4305}],[{"start":4315,"end":4316}],[{"start":4326,"end":4327}],[{"start":4336,"end":4337}],[{"start":4347,"end":4380}],[{"start":4388,"end":4405}],[{"start":4415,"end":4432}],[{"start":4444,"end":4483}],[{"start":4491,"end":4527}],[{"start":4536,"end":4537}],[{"start":4546,"end":4577}],[{"start":4615,"end":4661}],[{"start":4667,"end":4675}],[{"start":4681,"end":4706}],[{"start":4712,"end":4727}],[{"start":4733,"end":4742}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_022.ks","basename":"SC_S_022.ks","indexIds":{"「……寒いな」":0,"「北だからな、春とは言え夜陰に乗じようとすれば当然そうなるが。[l]\nそれに海岸だ此処は」":1,"「何で普通に行かないかねぇ……」":2,"「ドレの子孫が宿泊してるからだろ。[l]\n雫が咬んでるなら鉢合わせの可能性があるから、\n少しでも回避しようという魂胆。魂胆？":3,"まあいっか。[l]\nで、旅館の屋上ついたらThousand……チノに連絡してあとは任せる」":4,"「そうなのか？」":5,"「その初めて聞いた風なリアクションどういう事？[l]\nだからカゲロウに心配されるんだ」":6,"「サクラは他人と行動する時、\n同行者の脳を外部記憶装置及び作業領域として使う癖、傾向が」":7,"「そそ、あたしぁ":8,"何":9,"時だってちゃんと聞いてるし、\nソロん時は記憶もしてるって。[l]\nあんたらと動くときはあれだ、\n聞いてるけど書き込み保存まではしない事にしてんの。":10,"信頼の証だよだから。[l]\nそう思っておきなって」":11,"「":12,"御":13,"上からしてメモないとtodo忘れる訳だからな、\nそんな集団の一員としてご立派な事だよ。[l]\n精精あたしらに感謝する。[l]\nいずれ眼に視える形での贈答を願うよ」":14,"「あーん、飯かカラオケ奢るって。６耐でも８耐でもいいワヨ？[l]\nで？[l]\n此処は何処で、どういうルートで向かう」":15,"「まず此処は玄ノ森に近接する町の、御覧の通り海岸です。[l]\n土地柄時節柄、夜ともなればほぼ人は居ませんのでね。[l]\n広さやアクセス、発動の容易さに関して諸条件を広範囲で満たす場所です」":16,"「山の中じゃ駄目なのか？」":17,"「貴女は記憶してないでしょうが、\n例の不確定要素らしき存在と山中で接触した可能性あり、\nとの追加情報があります。":18,"短絡的ではありますが避けられる状況は避けるに越したことはないので。[l]\n距離で言うと──それなりですかね。[l]\n箒ならば１時間もあれば着くかと思います。[l]\nアシストはアルコさんからPE貰えれば問題ないかと。":19,"なのでいつも通り、\n私のｖ☆で全員を運搬します。[l]\n此処から屋上までPHASE:2-CF展開しつつ警戒は怠らず。[l]\nそれはサクラさんか余力あればアルコさんにもお願いします」":20,"「ボクのテトは特化してて役にたたぬから！」":21,"「わかってるから。[l]\nいつもの事だから。[l]\nじゃ皆の衆、準備出来次第──」":22,"「まて、ちょっと止まれアイ！！」":23,"「？」":24,"「いるおＣＡＴが」":25,"「何？」":26,"「了解」":27,"「のらねこか？」":28,"「いや、ちがう」":29,"「…GreenWoodか？例の不確定要素？[l]\n嘘だろ、ドンピシャか？[l]\n今此処で？」":30,"「何もんかは知んないけどいる。[l]\nねこかユーザーかどっちかわからぬ」":31,"「益々GWの可能性が高いって事だなあ」":32,"「折角の対処が裏目に出るなんて……」":33,"「恐るべしは雫の余波か、\nアイが気にする事はないよ。[l]\nいずれにしても──向こうはまだ気付いてないな？」":34,"「マジか……[l]\nどれだけ事を引き起こすよ、\ndeus ex machinaの登場も":35,"強ち夢物語じゃないッて事か？[l]\nつーか何処だよ？何処にいる？」":36,"「ふひひひひひひひひ、チャンスだこれ」":37,"「司書長は放置しろと言っていただろう。[l]\n気付かれてないなら尚のこと、\n此方から手を出す必要はない」":38,"「いあ、ヤる」":39,"「お嬢、あの方の言を無視はできません。[l]\nそれだけはお控えに」":40,"「いあ、ヤる。[l]\nヤるったらヤるったらヤるっ！[l]\nボクをこれ以上待たすとどうなるかオシエテヤル」":41,"「ばか、やめ！」":42,"「だめだ。[l]\nもう待たない。[l]\n赦さない。[l]\nボクの苦しみを思い知らスゾ」":43,"「（……きちゃったか）」":44,"「お嬢、ちゃんと喚ばれて此処まで来たんですから。[l]\nもう少しで」":45,"「っっっせえな！！！[l]\n聞かねぇぇぇぇぇぇぇぇぇぇぇぇえええよ！！！！！！[l]\n知ったことか！！！！！！！！！":46,"ボクを待たす邪魔する反応よこさねえ奴にぁな、\nこっちから行くんだ！！！！！！！！！！！！":47,"アぁぁぁぁぁぁイ、ウォール！[l]\nアルコはぁアンカー！[l]\nサクラはバインドぉ！":48,"よぉ～っしミせるぞテト、\nいーかーぁてめぇら！」":49,"「……":50,"本":51,"気かよ……」":52,"「これより四重奏団による、EnderのGameを開始する！！！」":53,"「馬鹿が！[l]\nGWにIgなんか、\n宿したPHASEによっては面倒な事に……":54,"だっ、大体お嬢リアルのガチは初だろが──\nってIronもう動いてるし！！」":55,"「どうしようもないな……」":56,"「あんたも準備してるじゃん！[l]\nおいおいおい、大丈夫かよ」":57,"「Coven招集にあの娘組み込んだのも司書長だからな、\nあの方自身この展開も覚悟の上だろ」":58,"「う、そらそうかも知んねーけどさ……[l]\nしょうがね……[l]\nあたしらもガチは久々だしな、\n精々勘を取り戻させて貰うか──」":59,"「GWならば有視覚とは限らないが、\n視えるヤツだったらちと面倒か、まあセオリー通りに」":60,"「あいよ、\nアイ、お嬢、\n──開宴了解」":61,"四重奏団（クァルテット）は終わらすものの遊戯を紡ぐ──":62,"@r汝は剣、\n終わらせる者の手にある":63,"撫":64,"器、\n更に強きモノたる":65,"筆記":66,"具をも兼ねん。[l]\nテトルジャトートリス、\n我が名はEnder:333。":67,"汝は杯、\n柔らかなる猫の手で触れるがごとき、\n決して解けない枷もつ":68,"遊":69,"弋":70,"裸":71,"貝。[l]\nフロシルク、\n我が名はShackle。":72,"汝は杖、\n魔女の大釜用いて":73,"奇しもの掻き回せ、\n媚酒の":74,"盃。[l]\nババッカナーリャガー、\n我が名はCall=R=W。":75,"汝は星、\n装甲板か拘束具か、\nそのカタキをもって姫を守る":76,"愧":77,"死の五芒星。[l]\nｖ☆、\n我が名はIron。":78,"The die is cast, \nA man can only die once,":79,"@rbut,":80,"@rA CAT has nine lives.":81,"@r演目（PROGRAM）":82,"開始（START）":83},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_022.ks","relPath":"/data/scenario/SC_S_022.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":78,"length":84,"percent":92.85714285714286},"cellInfo":[],"cacheResetOnChange":{},"lastSelectedCell":[23,0]},"/data/scenario/SC_S_023.ks":{"data":[["@r気付いたらここに来るなんて、\n\n焼きが回ったのかねェ。","@r回过神来竟到了这里，\n\n是脑子锈掉了吗。"],["@r最近……調子が悪かったからなァ。","@r最近……状态不太好呐。"],["@rなにがどうって訳じゃねェけど、\n\nそういう時もあるぁ。","@r倒也说不上具体缘由，\n\n总会有这种时候啦。"],["@r現実にこんな時が来るとは思わなかったが、\n\n思い出したくない沢山の昔の中で、\n\nあの時のあれだけは、","@r没想到现实里真有这么一天，\n\n在众多不愿回忆的往昔中，\n\n唯独那时的情景，"],["\nまあ、\n\n面白ぇ、良いとき、\n\n持ち続けたいと思える記憶──","\n嘛，\n\n有趣，美好时光，\n\n想永远珍藏的记忆──"],["\n迷ってはいない。","\n不曾迷惘。"],["\n迷ってはいないが、\n\n怖さと、絶望と、諦めと、寂しさと、\n\n少しだけの期待、","\n虽未迷惘，\n\n恐惧与，绝望与，放弃与，寂寞与，\n\n仅存的一丝期待，"],["\nぜんぶおわることへの、\n\nらくに、","\n对全部终结的，\n\n解脱，"],["\n………。",""],["@r………、",""],["@r………………、",""],["@r……、",""],["@r………？",""],["@r何だアレは。","@r那是什么鬼。"],["@rねこ……なのか？","@r猫……吗？"],["@r知ってるのとは少し違う……","@r和认知的有点不同……"],["@rあ？","@r啊？"],["@rまさかあれが『連中』なのか？","@r难道那些家伙就是『他们』？"],["「ｖ☆が場を展開しました」","「v☆展开了场地」"],["「ババはAnchor作成完了」","「巴巴完成Anchor构筑」"],["「フロスの","「弗洛斯的"],["繋","链"],["縛鎖ＯＫ」","束缚完成」"],["「テトのシガン開放、S→Pアイドリング完了」","「解除缇托的封印，S→P待机完毕」"],["@r？",""],["@r何を言ってんのかわかん","@r完全听不懂在说啥"],["「じゃ撃ちます」","「要开枪了」"],["@rねえぞ？！！！","@r才不要啊？！！！"],["@rっんだ？！","@r搞毛啊？！"],["@rあれぁ、\n@r──彼奴のアレみたいなやつ、か！！","@r哎呀，\n@r──是那家伙的像那个一样的东西吗！！"],["@rだったら避けるしかねぇッ！[l]\nあんなもんまたぞろ刺されたら七面倒くせ──","@r那只能躲开了！[l]\n再被那种玩意儿扎到可就麻烦死了──"],["@r@rひぃぃぃぃよおぉおぉぉぉぉぉおうううぅぅぅぅ。","@r@r噫呜呜呜呜呜呜呜呜呜呜呜。"],["「……おや」","「……哎呀」"],["………。",""],["@rっぶねえな、\n@rんだ","@r真够呛，\n@r靠"],["彼","那"],["奴","那家伙"],["等？！[l]\n問答無用ってことかよッ。","等等？！[l]\n这是不讲道理啊。"],["@r聞いてはいたがマジでクソ共だな。","@r早有耳闻但你们真是群垃圾。"],["@r畜生、\n@rどうするっ、逃げるか？！","@r混蛋，\n@r怎么办、要逃吗？！"],["@r返り討ちに……できるか？","@r反杀……做得到吗？"],["@rああもう、彼奴に連絡しても役に立たねェだろうし──","@r啊啊烦死了，联系那家伙估计也没屁用──"],["「ｇｊ……ならずか」","「干得漂亮……可惜没成」"],["「だが回避したと言うことは、\n視えてるにせよ感じたにせよ、\nノーマルではない事が確定した。[l]\nGWかどうかはまだ別だが」","「但既然能躲开，\n不管是看见还是感知到，\n都证明你不是普通人。[l]\n是否GW另当别论」"],["@r独りでやるしかねェか、病み上がりだってのによぅ、\n仕方ね、極力逃げながら、","@r只能单干了吗，明明才刚病愈啊，\n没办法，尽量边逃边，"],["@r──なんだ？","@r──啥玩意？"],["@rなんなんだよ？","@r搞什么啊？"],["@r糞ッ、何かあンのは分かるが、\nさっきのとは違ってカタチが視えねー、","@r妈的、能感觉到有什么在，\n和刚才不同根本看不见形态，"],["@rもじゃもじゃしやがって、\n@r俺が●●だからかよッ。","@r黏黏糊糊的烦死了，\n@r就因为我是●●吗。"],["@rこんな時にまで邪魔しやがって、\n@r恨むぞこのミ──","@r这种时候还来碍事，\n@r给我记着这群混──"],["「セオリーじゃないが、\n繋縛からアンカーの流れで」","「虽然不合常规，\n从束缚到锚点的流程」"],["「了解」","「收到」"],["「はやくはやくはやく」","「快快快」"],["「はいはいは」","「好啦好啦」"],["@rい？","@r咦？"],["@r何か来る、今度は追っかけてきやが──","@r有东西过来了、这次是追着──"],["@r@rあ゛？！","@r@r啊゛？！"],["@rわかんねー、わかんねーけど何かに巻かれてる、のか？！","@r搞不懂、搞不懂但好像被什么缠住了、吗？！"],["@r動けねーぞッ、この、\nがあああああああああああ！！！！！！","@r动不了啊、这，\n嘎啊啊啊啊啊啊啊啊啊啊！！！！！！"],["「繋縛完了」","「束缚完成」"],["「ｇｊ」",""],["「ｇｊ、\nふひひひひひ、\nテト、じゃあGWにarchiveが効くかどうか──\nやってみよーか」","「漂亮，\n嘻嘻嘻嘻嘻，\n缇托、现在试试GW对archive有没有效──\n来试试看吧」"],["「効かなかったらどうする気だよ」","「要是没效你打算怎么办」"],["「最悪チノのペイルホワイト招請して、\n改宗なりなんなりするしかないな、\nおっと取り敢えずAnchor再作成開始」","「最坏情况只能召唤千乃的佩尔怀特，\n要么改宗要么硬扛，\n哦对先开始重建锚点」"],["@r俺をどうする気だ此奴等ッ、\n畜生、遠くから卑怯な真似しやがって、","@r这群混蛋打算把老子怎样，\n畜生、躲在远处耍阴招，"],["@rがぁああああああああああああ、","@r嘎啊啊啊啊啊啊啊啊啊啊，"],["@r糞が、糞が、糞が！！！！！！","@r垃圾、垃圾、垃圾！！！！！！"],["@r邪魔だ邪魔だ邪魔だ邪魔だ邪魔だ邪魔なんだよッ、","@r碍事碍事碍事碍事碍事碍事死了啊，"],["@rキサマラみてぇなおたかくとまってえらぶってジコノユウイセイのために\n俺を虚仮にしてきたあの糞等みてーーーーーなカスぁァッ！！！","@r你们这群高高在上挑三拣四自以为是的\n把老子当傻逼耍的狗屎玩意儿啊啊啊啊啊！！！"],["@rが、あ、あ、あ、あああああ、","@r嘎、啊、啊、啊啊啊啊，"],["@rあは、\n@rあはははははあははあはあははははは！！！！！！","@r啊哈，\n@r啊哈哈哈哈哈哈啊哈哈啊哈啊哈哈哈哈哈哈！！！！！！"],["@rあはははははははははははははははははははははっ、\n@rもう、知らねぇぞ、","@r啊哈哈哈哈哈哈哈哈哈哈哈哈哈哈、\n@r已经、不管了啊、"],["@rもう知らねぇぞ！！！！！！","@r已经不管了啊！！！！！！"],["@rもう知らねぇぞ全部だ貴様ら！！！！！！","@r已经不管了啊全都是你们这帮混蛋！！！！！！"],["@r全部だ貴様ラぁああああああ、\n@r──喰ってやる、喰ってやる、喰ってやる、","@r全都是你们这帮混账啊啊啊啊啊啊、\n@r──吃掉你、吃掉你、吃掉你、"],["@r──喰い殺す、くいころす、クイコロス、\n@r──邪魔モノにはぁ、","@r──吃掉你、吃掉你、奎伊可洛斯、\n@r──碍事的家伙啊、"],["@r……報いあれ、ムクイあれ、","@r……报应吧、无奎吧、"],["@r六　玖　威　ああああああれえエエエエッ、\n@rミ・タサンコネミャルコネタサ・ワ！","@r六　玖　威　啊啊啊啊啊啊呃呃呃呃呃、\n@r米・塔桑可涅喵尔可涅塔萨・哇！"],["@rミ・カヤキャツタサ・ワ！！","@r米・卡雅恰塔萨・哇！！"],["@rミ・アメタサナサキャキャラキャタサ・ワ！！！","@r米・阿梅塔萨纳萨恰恰拉恰塔萨・哇！！！"],["「………？」",""],["「Anchor作成完了……？[l]\nあ？」","「锚点创建完成……？[l]\n啊？」"],["「おいおい、な、んだあれは」","「喂喂，那、是什么啊」"],["「Ｙの同…か？[l]\nこれが、Moon=Calfか！！[l]\n現物は久しく視てなかったが、\nあれは、よりにもよって、」","「Y的同…类？[l]\n这就是、Moon=Calf吗！！[l]\n实物已经很久没见到了，\n那家伙、偏偏是、」"],["@r@rかふぁっ。","@r@r咔哈。"],["「なに、あの口、顔か？[l]\nふぇ、PHASE:6ぅっ？！[l]\nいあ、なになになに！？」","「什么、那张嘴、脸吗？[l]\n呃、PHASE:6吗？！[l]\n噫啊、什么什么什么！？」"],["@r@rおわああああああああ。","@r@r完蛋啊啊啊啊啊啊。"],["「お嬢？[l]\nテトどうしたっ？！」","「大小姐？[l]\n特特怎么了！？」"],["「っによこれっ、ScanningErrorだっ！！[l]\nテトッどうしたよっ？！","「这这这这、ScanningError啊！！[l]\n特特怎么了啊！？"],["ああああああああ、\nあいつフォーマットが違い過ぎてマクロが使えないのかっ、\n駄目だ時間が掛かり過ぎるっ！！[l]\nアイッ！！！」","啊啊啊啊啊啊、\n那家伙格式差异太大无法使用宏吗、\n不行太花时间了！！[l]\n爱！！！」"],["「Ironは場の展開中で反応出来ない！[l]\nお嬢、落ち着け！！」","「Iron正在展开领域无法反应！[l]\n大小姐、冷静点！！」"],["@rかはぁっ。","@r咔哈。"],["@rがぁぁぁぁぁあぁあぁ……るるるるるるるるる、\n@rぐぞう、ほんき出させやがってぇえ、\n@rはらがはらがへるだろぅが！！","@r嘎啊啊啊啊啊啊啊……噜噜噜噜噜噜噜、\n@r可恶、逼老子动真格是吧、\n@r肚子都要饿扁了啊！！"],["@rがる、がるるるうるるううう、\n@rなんだかぁじらねえがぁ、\n@rごれもアレなんだろうガァ。","@r嘎噜、嘎噜噜噜噜噜、\n@r真让人火大啊、\n@r这也是那个对吧嘎。"],["@rヅまり、","@r总之、"],["@r喰えば、","@r吃掉的话、"],["「",""],["拙いぞ、\nサクラ、\n拘束解け。[l]\nねこ引っ込めろ」","太拙劣了、\n樱、\n解除拘束。[l]\n把猫收回去」"],["「あ゛ァッ？！[l]\n──っあ、そういう事か」","「啊゛啊！？[l]\n──啊、原来是这么回事」"],["「テトっ！！[l]\nあああもう、\nアイーっ！！！」","「特特！！[l]\n啊啊啊真是的、\n爱ーー！！！」"],["「そしたらすぐ口枷だ……否、駄目か、[l]\n再起動されたら同じだな。[l]\n出来るのかどうかは分からんが。[l]\n自制出来てはいないようにも視える……しかし」","「那样的话立刻上口笼……不、不行吗、[l]\n重启后还是一样吧。[l]\n能不能做到也不知道。[l]\n看起来也没能保持自制……但是」"],["「………」",""],["「ここで賭けには出られねーわな、\nと、取り敢えず喰われるよりはマシだろっ。[l]\n解除す」","「这种赌注可下不了啊、\n总、总之比被吃掉强吧。[l]\n解除」"],["@r@rむぁしゃ。","@r@r唔啊。"],["@rぐしゃばすがしゅぎちゅくちゃかさかさかさかさ、\n@rんにゅる。","@r嘎吱吧唧咕叽咔嚓咔嚓咔嚓咔嚓、\n@r嗯扭噜。"],["「──ぁ、や、うあ」","「──啊、呀、呜啊」"],["@rごふぁ。がふっ。","@r咕哇。嘎噗。"],["@r……ミになっデグ感じヴァズるが、[l]\n旨ぐはねェな。","@r……渗入DEGU的感觉在蔓延，[l]\n味道可不咋样。"],["「っちッ！[l]\n喰いやがった、","「切！[l]\n居然敢啃食，"],["縛鎖部だけだが、\nPHASE:6がまともに動いてるとしたら、」","虽然只是缚锁部分，\n如果PHASE:6还能正常运作的话，」"],["@rなるヴォど、\nゴれが、\nクイか、クウというゴとか。","@r蠕动着，\n那些，\n是奎吗，还是叫库的玩意儿。"],["@rクってワガミにすることか。","@r奎这家伙想对吾神做什么。"],["@rかふぁ。","@r咔哇。"],["@rくふぇ。","@r咳噗。"],["@rくふ。","@r咕呼。"],["@rくふはっ。","@r咕哈。"],["@rくはははははは、\n@rくはははははは、\n@rくはははははは。","@r咕哈哈哈哈哈哈，\n@r咕哈哈哈哈哈哈，\n@r咕哈哈哈哈哈哈。"],["@r遣い手を喰ったところで意味は無いが、\nコウスレバ、","@r就算吃掉使役者也没意义，\n既然这样，"],["@rあの時は失敗したがこういう事ダナ？","@r上次虽然失败但这次能行吧？"],["@rただ、\n@rがふっ、\n@r消化と吸収には、\n@r良くナサソウダワなァ。","@r不过，\n@r嘎噗，\n@r消化吸收这事，\n@r看来不太顺利啊。"],["@rアトナンマイモクワナイ\nトイケナイノニサキガオ\nモイヤラレルノダ───","@r之后目的不明\n明明不该先发制人\n看来要被干掉了───"],["@rだから今回はここまでにしとくサァ、\n@r遣り方は分かったからナ──","@r所以这次就到此为止吧，\n@r反正方法已经懂了──"],["「あんな不完全なPHASE:6では恐らく\n完全に喰うまでの能力はない！[l]\nAnchorを撃ったら撤退するぞ！」","「那种不完全的PHASE:6恐怕\n根本不具备完全吞噬的能力！[l]\n发射Anchor后就撤退！」"],["「…っくしょう！[l]\nなんだ彼奴は！！[l]\n放置しろだ！？[l]\n今まで野放しだったのか？！","「…可恶！[l]\n那混蛋怎么回事！！[l]\n说要放任不管！？[l]\n难道一直没被管制吗？！"],["よく今まで潜伏出来てたな、\n冗談じゃないぜ、\nPHASE:6のGWなんて危険極まりねぇ……」","居然能潜伏到现在，\n开什么玩笑，\nPHASE:6的GW危险到极点……」"],["「だからそもそも手出し無用だったんだろ、\nお嬢を配した司書長の意図は不明だが、\n今そんな事を言ってる場合じゃない。","「所以从一开始就不该插手，\n虽然不清楚司书长派大小姐来的意图，\n现在不是说这个的时候。"],["あんな目立つ姿ではヤツも無茶は出来ない、\n我々が引けば追撃もないだろう。","那家伙显眼成那样也不敢乱来，\n我们撤退的话应该不会追击。"],["PHASE:2も無ければ4も無いんだ、\nフロシルクの繋縛鎖はまだ使えようもない、\nそのうちに」","既没有PHASE:2也没有4，\n弗洛希尔克的缚锁链现在还无法使用，\n趁现在」"],["「…仕方ねぇ、[l]\nまずは、\n──Ironとお嬢を何とかしねぇと、\nお嬢！！」","「…没办法，[l]\n首先得，\n──把Iron和大小姐处理掉，\n大小姐！！」"],["「あああああああのやろうううううううううううう！！！[l]\nなんなんだてめーーーーーーーーーーーーはぁっ！！！！！！！！！","「啊啊啊啊啊那个混账东西啊啊啊啊啊啊啊啊啊啊！！！[l]\n你他妈到底是什么玩意儿啊啊啊啊啊啊啊哈！！！！！！！！！"],["調子にのってんじゃねぇあ！！！！！！[l]\n大人しく狩られろド畜生が！！！！！！！！！」","别给我太得意忘形了啊！！！！！！[l]\n乖乖被猎杀吧畜生！！！！！！！！！」"],["「馬鹿野郎！！[l]\n『Ig:Type･Eは四重奏団の布陣が完全でないと遣えない』\nんだろうが！！","「蠢货！！[l]\n『Ig:Type･E需要四重奏团完整布阵才能使用』\n不是吗！！"],["しかも相手は６のGWだ！！[l]\n喰われたら仕舞いだぞ！！！！[l]\n十全以上のGWなんて魔眼のさ──」","更何况对方是6的GW！！[l]\n被吃掉就全完了！！！！[l]\n超越十全的GW简直是魔眼的──」"],["「逃げた」","「逃走了」"],["「あ？」","「啊？」"],["「すまん。[l]\nAnchorも撃てていない」","「抱歉。[l]\n连Anchor都没能击中」"],["「あっ！？[l]\nお嬢……あ、アイ」","「啊！？[l]\n大小姐……啊、爱」"],["「ご迷惑を……お掛けしました。[l]\nお嬢も」","「给您……添麻烦了。[l]\n大小姐也是」"],["「いや、いいんだけどよ……[l]\n寧ろお嬢大丈夫か？[l]\n今何したんだ？」","「不、倒也没关系……[l]\n不如说大小姐你没事吧？[l]\n刚才做了什么？」"],["「場は解除して……すぐ向かいましょう。[l]\nお嬢が気付く前に」","「先把领域解除……立刻赶过去吧。[l]\n趁大小姐还没察觉之前」"],["「あ？[l]\nあ、ああ……フロスも損傷受けたしな……[l]\n兎に角、とっとと店長やチノと合流して、\n事の次第を話さにゃ」","「啊？[l]\n啊、啊啊……弗洛斯也受损了……[l]\n总之先尽快和店长还有千乃汇合，\n把事情经过说明白喵」"],["「今ｖ☆を箒にします」","「现在把v☆变成扫帚」"],["「バックアップ人員が真っ先に交戦して損害被るとぁ、\nどやされっかな……誰にって話だが……」","「要是后备人员最先交战还遭受损失，\n可没法交代啊……虽然该向谁交代也……」"],["「向こうに存在を知られたまま逃がしたのは、\n少々問題かもな。[l]\nミリアムと繋がっていない筈ではあるから、\nそこは救いだが──」","「让对方知晓存在后还逃脱了，\n可能有点麻烦。[l]\n按理说应该没和米莉安姆产生关联，\n这点还算庆幸──」"],["「いずれ今回の劇を予定通り進めるには──」","「要想让这次戏剧按预定推进的话──」"],["「店長がいる限り結果としての負けはないだろうが、\n","「只要有店长在结果上就不会输吧，\n"],["脚","慢悠悠"],["本は修正……否、ネタバレの方向になるか、[l]\nそれこそ、」","但剧本需要修正……不、恐怕会变成剧透走向，[l]\n真要那样的话，」"],["「deus ex machinaによる……あ？[l]\nんなぁ、」","「就只能靠deus ex machina来……啊？[l]\n开什么玩笑，」"],["「準備出来ました。[l]\n急ぎましょう」","「准备完毕了。[l]\n赶快出发吧」"],["「お嬢は任せろ。[l]\nフロシルクの修復も懸案事項だが今は後だ」","「大小姐交给我。[l]\n弗洛希尔克的修复虽是悬案但现在不急」"],["「厄介な事になったぜ……[l]\n置いてきた連中にも合わす顔がねぇな……」","「这下可棘手了……[l]\n都没脸见留守的同伴们了……」"],["「いきます」","「出发了」"],["「畜生……」","「畜生……」"],["@r………。",""],["@r追ってはこねェか。","@r追不上啊。"],["@r畜生が、折角調子戻ったってのにげほっ、","@r该死的，好不容易找回状态咳咳，"],["@rまあ、\n@r喰ったモノがミになれば、\n@r少しはヤクにたつか。","@r不过，\n@r只要吃掉的东西能化为养分，\n@r多少能派上点用场吧。"],["@rしょうがねえ、まずは連絡して──\n@r──また……やすまねぇと……","@r没办法，先联络──\n@r──还得……继续休养……"],["@r……の日までには……万全に……","@r……在那天到来前……必须万全……"],["@rそして……","@r然后……"],["「……気持ちが悪い」","「……真恶心」"],["「……？」",""],["騒","躁"],["騒する、落ち着かない、\n『あの時』と同じ感じがする、\n全身が厭なものにまとわりつかれて、","躁动不安，\n和『那时候』的感觉一样，\n全身被令人作呕的东西缠绕着，"],["ささくれ立つような、","像要炸毛般的，"],["苛","焦"],["苛するような、\n","焦灼般的，\n"],["昂","亢"],["揚するような、\nああ、いやだ、白の連中のあの、\n感じ……？","高涨般的，\n啊啊，讨厌，就像白之众的那种，\n感觉……？"],["わからない……ああ、もうベロアの肉、[l]\nもう少しだけでいい、あああ、\nもどかしい、もどかしいよマスターミリアムっ」","不明白……啊啊，好想要贝萝娅的肉，[l]\n再一点点就好，啊啊啊，\n好煎熬，好煎熬啊主人米莉安姆」"],["奴を気にしすぎて気が立っているのさね、\nもう少しの辛抱だよ、\n今はまだ──大人しくしてるが好いよ。","你太过在意那家伙导致神经紧绷了呢，\n再忍耐一会儿就好，\n现在还是──乖乖待着为妙。"],["可愛いベロア、あと少しだ、\n祭儀まで──」","可爱的贝萝娅，就差一点了，\n待到祭仪之时──」"],["「マスターミリアム……[l]\n早く御力になりたい、\n御身を護るチカラを取り戻したい、\n早く──」","「米莉安姆大人……[l]\n想快点成为您的力量、\n想取回守护您的力量、\n快点──」"],["「そう、だから、\n祭儀の日までには、万全にしておくんだよ。[l]\nそして──」","「是啊，所以、\n在祭典之日到来前，要做好万全准备哦。[l]\n然后──」"],["「どうしましたぁ？」","「怎么啦呀？」"],["「……なんか気持ち悪い。[l]\n風邪ひぃたんかな」","「……总觉得好恶心。[l]\n该不会感冒了吧」"],["「夜も遅ぅまで起きてるからですよぅ。[l]\n今晩はもう早うお休み？」","「因为熬夜到太晚啦呀。[l]\n今晚要早点休息不？」"],["「何かな、やっぱそういうんちゃうねん。[l]\nざわざわするゆうか、\n落ち着かん。","「不对劲，肯定不是这个原因。[l]\n该说是心神不宁还是啥、\n静不下来。"],["アノ日ともちゃうで、\nなんやろ、\nめっさ……居ても立っても居られん感じや。","和那天感觉也不一样、\n怎么回事、\n超级……坐立难安的感觉啊。"],["何かに喚ばれてる感じがすんねん。[l]\nあ、電波系やないで、虫の知らせってやつ？[l]\n落ち着こ思ても落ち着けへんねん、\nなんかざわざわする、めっさ首筋緊張するいうか」","总觉得被什么东西召唤着。[l]\n啊、不是电磁波那种，该说是虫子的预感？[l]\n想冷静也冷静不下来、\n莫名烦躁，脖子后面超级紧绷的感觉」"],["「……？[l]\nなんやろねぇ、\nやっぱり気のせいと違いますかねぃ。","「……？[l]\n咋回事捏、\n果然还是错觉吧呐。"],["それより祭も決まったことですし、\n………せやね、[l]\nそう、だから、\n祭の日までには、万全にしておくんですよぅ。","再说祭典也都定下来了、\n………是呀、[l]\n没错，所以、\n在祭典那天之前，要做好万全准备啦呀。"],["そして──」","然后──」"],["ミ・ミャルタサミャルキャタサナサカヤタサツォロ、\nキャオロタサメコネカヤタサツ・ワ。","咪・缪尔塔萨缪尔基亚塔萨纳萨卡亚塔萨佐罗、\n基亚奥罗塔萨梅科内卡亚塔萨茨・哇。"]],"context":[["SC_S_023.ks/index/1/text"],["SC_S_023.ks/index/3/text"],["SC_S_023.ks/index/5/text"],["SC_S_023.ks/index/7/text"],["SC_S_023.ks/index/9/text"],["SC_S_023.ks/index/11/text"],["SC_S_023.ks/index/13/text"],["SC_S_023.ks/index/15/text"],["SC_S_023.ks/index/17/text"],["SC_S_023.ks/index/19/text"],["SC_S_023.ks/index/21/text"],["SC_S_023.ks/index/23/text","SC_S_023.ks/index/25/text"],["SC_S_023.ks/index/27/text"],["SC_S_023.ks/index/29/text"],["SC_S_023.ks/index/31/text"],["SC_S_023.ks/index/33/text"],["SC_S_023.ks/index/35/text"],["SC_S_023.ks/index/37/text"],["SC_S_023.ks/index/39/text"],["SC_S_023.ks/index/41/text"],["SC_S_023.ks/index/43/text"],["SC_S_023.ks/index/45/text","SC_S_023.ks/index/221/text"],["SC_S_023.ks/index/47/text"],["SC_S_023.ks/index/49/text"],[