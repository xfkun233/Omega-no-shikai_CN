6,"end":1411}],[{"start":1425,"end":1479}],[{"start":1616,"end":1617}],[{"start":1627,"end":1628},{"start":1799,"end":1800}],[{"start":1637,"end":1638},{"start":1809,"end":1810}],[{"start":1648,"end":1757}],[{"start":1820,"end":1835}],[{"start":1848,"end":1849},{"start":3299,"end":3300}],[{"start":1859,"end":1995}],[{"start":2033,"end":2114}],[{"start":2151,"end":2348}],[{"start":2380,"end":2553}],[{"start":2591,"end":2617}],[{"start":2654,"end":2848}],[{"start":2880,"end":2986}],[{"start":3059,"end":3284}],[{"start":3312,"end":3413}],[{"start":3451,"end":3529}],[{"start":3602,"end":3671}],[{"start":3711,"end":3836}],[{"start":3909,"end":3950}],[{"start":3962,"end":4036}],[{"start":4048,"end":4108}],[{"start":4120,"end":4123}],[{"start":4134,"end":4135},{"start":4401,"end":4402}],[{"start":4147,"end":4194}],[{"start":4226,"end":4241}],[{"start":4255,"end":4351}],[{"start":4365,"end":4386}],[{"start":4414,"end":4444}],[{"start":4517,"end":4563}],[{"start":4575,"end":4616}],[{"start":4656,"end":4693}],[{"start":4792,"end":4798}],[{"start":4830,"end":4842}],[{"start":4881,"end":4925}],[{"start":4965,"end":5005}],[{"start":5078,"end":5130}],[{"start":5142,"end":5184}],[{"start":5196,"end":5251}],[{"start":5291,"end":5369}],[{"start":5442,"end":5554}],[{"start":5594,"end":5658}],[{"start":5731,"end":5842}],[{"start":5917,"end":5929}],[{"start":5969,"end":5972}],[{"start":6069,"end":6074}],[{"start":6106,"end":6176}],[{"start":6188,"end":6224}],[{"start":6261,"end":6337}],[{"start":6377,"end":6434}],[{"start":6507,"end":6570}],[{"start":6634,"end":6644}],[{"start":6676,"end":6723}],[{"start":6761,"end":6791}],[{"start":6823,"end":6841}],[{"start":6914,"end":7058}],[{"start":7114,"end":7334}],[{"start":7407,"end":7472}],[{"start":7484,"end":7561}],[{"start":7601,"end":7611}],[{"start":7643,"end":7694}],[{"start":7767,"end":7776}],[{"start":7788,"end":7865}],[{"start":7915,"end":7987}],[{"start":8086,"end":8132}],[{"start":8164,"end":8263}],[{"start":8301,"end":8345}],[{"start":8418,"end":8565}],[{"start":8605,"end":8670}],[{"start":8682,"end":8718}],[{"start":8791,"end":8914}],[{"start":8962,"end":9014}],[{"start":9028,"end":9104}],[{"start":9172,"end":9242}],[{"start":9282,"end":9335}],[{"start":9349,"end":9392}],[{"start":9497,"end":9535}],[{"start":9571,"end":9593}],[{"start":9625,"end":9630}],[{"start":9670,"end":9766}],[{"start":9782,"end":9844}],[{"start":9946,"end":10061}],[{"start":10093,"end":10144}],[{"start":10184,"end":10216}],[{"start":10321,"end":10331}],[{"start":10363,"end":10409}],[{"start":10488,"end":10496}],[{"start":10524,"end":10525}],[{"start":10537,"end":10538},{"start":10598,"end":10599}],[{"start":10550,"end":10551}],[{"start":10563,"end":10569}],[{"start":10585,"end":10586}],[{"start":10611,"end":10612}],[{"start":10624,"end":10626}],[{"start":10640,"end":10650}],[{"start":10666,"end":10784}],[{"start":10951,"end":10960}],[{"start":10992,"end":11044}],[{"start":11058,"end":11120}],[{"start":11134,"end":11179}],[{"start":11219,"end":11241}],[{"start":11273,"end":11326}],[{"start":11340,"end":11418}],[{"start":11432,"end":11505}],[{"start":11521,"end":11572}],[{"start":11586,"end":11629}],[{"start":11643,"end":11700}],[{"start":11714,"end":11797}],[{"start":11837,"end":11882}],[{"start":11914,"end":11962}],[{"start":12067,"end":12329}],[{"start":12343,"end":12424}],[{"start":12438,"end":12540}],[{"start":12554,"end":12592}],[{"start":12628,"end":12647}],[{"start":12790,"end":12850}],[{"start":12864,"end":12906}],[{"start":12920,"end":13003}],[{"start":13080,"end":13160}],[{"start":13174,"end":13268}],[{"start":13282,"end":13347}],[{"start":13361,"end":13414}],[{"start":13428,"end":13469}],[{"start":13485,"end":13502}],[{"start":13518,"end":13563}],[{"start":13577,"end":13612}],[{"start":13626,"end":13686}],[{"start":13706,"end":13773}],[{"start":13819,"end":13865}],[{"start":13879,"end":13925}],[{"start":13939,"end":14010}],[{"start":14024,"end":14039}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_002.ks","basename":"SC_M_002.ks","indexIds":{"数分後。":0,"「あのですね、宮と飯窪の本家が長年探していた本があるんです。[l]\n…本というか、ちょっと微妙なモノで、書籍というか何というか、[l]宮達は通称『":1,"月 ":2,"狂 ":3,"跳 』と呼んでるんですけど。":4,"それが一部分にしろ、一冊の本にしろ、本家が求めている、[l]ある特定の資料に相当する一群をそう呼んでるんですけどね。":5,"今までも色々調べて貰ったんですが、\n今回断片、一枚の紙片がですね、ようやく入手できたんですね。[l]\nかれおが今回来たのはそういう訳です。[l]\n日が今日とは聞いてませんでしたけど」":6,"そこでぎろりとかれお嬢を見る宮さん。":7,"「そうですっ。[l]\n先ほど車内で話したのですが、実は見つけたのはこの近辺でしてっ。[l]\nまさに灯台もと暗しっ！」":8,"誤魔化し気味にハイテンションなかれお嬢。":9,"「ん。昔から飯窪が書を集めていたのも元はと言えば『":10,"跳 』の為なんすけどね。[l]\nま、そういう訳でそれなりに調査はしてあるんですけど、\nえっと、これ見てください」":11,"宮さんはそこで、奥から持ってきたらしい分厚いバインダーを開いて見せた。":12,"「分かります？見えますか？」":13,"「おおっ、私も初見ですっ！…おや？」":14,"カラーコピーなのかプリントアウトされた写真かは\n分からないが、よく分からない古文書とでも言うべきか、":15,"所謂昔の日本の妖怪絵巻の一部分のような、\n僕にはとうてい読めない文字（らしきもの）と、\n何を描いたものやらおかしな化け物のような絵が描いてあるものだった。":16,"しかし明らかに鉛筆で描かれていて、\n確実に近代のものだろう。[l]\n案の定、宮さんが言った。":17,"「":18,"玄":19,"ノ":20,"森にある神社のご神体、『紙様』を模写したモノです。[l]\n飯窪本家から入手したメモなんですが、\nこれを描いた人間は故人でこれ以上の情報は分かりません。[l]\n他に何も残さずに逝ってしまったので」":21,"森には三春家が神官を務める、\n":22,"九":23,"抱山玄森神社というのがあって、\nそこのご神体、ということらしい。[l]\n山の事は覚えていたが、神社の名前に聞き覚えはなかった。[l]\n僕が居たのは幼少期でもあり、そういったことに興味はなかったし、\nほとんど記憶に無かったのは仕方ないだろう。":24,"「カミサマ？[l]\n神様がご神体ってそのままじゃないすか。[l]\nそれにイントネーションが変ですよ宮さん。[l]\n神様はカミサマでしょう」":25,"「あのねまこくん。[l]\nカミはカミでも、ペーパーの紙と書くのです。[l]\nあそこのご神体は紙なんです。[l]\n玄ノ森が書蔵で有名なのも伊達じゃないってことですかね。[l]\nそしてこれがかれおが見つけた『月狂跳』です。[l]\n描いてある文字や絵こそ違いますが、―――所謂デザイン、レイアウトですね。[l]\nそれがほぼ同じ、ほらこことこことかです」":26,"先ほどのメモと同じような、よく分からない妖怪の様な絵と、\n読めない文字が記されていたが、[l]\n描かれている要素が異なるだけで、確かに構成はほとんど一緒と言ってよかった。[l]\n図鑑とかの別々の２ページ分とでも言えばいいのか。[l]\n宮さんが特に教えてくれなかったので、何が『月狂跳』たるものかは分からなかったが。":27,"「ああ、ほんとすね。うん…[l]\nつまり？」":28,"「今までは単なるご神体だと思っていたこの『紙様』、\nこれも『月狂跳』の要素を持ってる可能性があるということですね。[l]\nこのメモに描かれてあること自体にはその要素は無いようなので、\n放置していたんでしょうけど、\n今回かれおが持ってきたものと比較する限り、\n両者が共に、ある『月狂跳』足り得る書物の断片と推測はできますし、調べる価値はあるでしょ？」":29,"まあ、それはそうだ。[l]\nそもそも『紙様』とやらがこのメモに描かれた…[l]\nつまり一ページ（？）分で全て、とは限らない訳で。[l]\nと、宮さんが表情を変えて、やや困った風に話を続けた。":30,"「ところがちょっとした障害があるですよ。[l]\nこのご神体、祭の時に神事で使われるらしいんですが、\nそれまでは場所から何から一切が秘されてるんです。[l]\n単純に神社に奉られてるんではないようですね。[l]\nそして、一般には決して開陳しないのです。[l]\nその祭は、神事そのものは三春とその系列の家、\n詳しくは後で教えますが、[l]\n彼らのみで行われて、他者が見ることはできないんです。[l]\n":31,"抱山って山があるですけど、そこの山頂でですね。[l]\nそこにある時、偶然居合わせた人間が、\nさっきのメモを描いたのです。[l]\nだから秘密ですよ？見つかったら多分…怒られますね」":32,"「偶然ねぇ…[l]\nまさか宮さん、飯窪の誰かがわざとそんなことしたんじゃないでしょうね？[l]\n…描いた人はもう亡くなってるって…まさか？」":33,"「んむ？[l]\nいやいやそんなじゃないですよ？[l]\nというかあのメモに関して、\n詳しい経緯は宮は知らないのです」":34,"「じゃあそんなじゃないと断言できないんじゃないすか…[l]\nま、まあいいや。[l]\nそうそうそういった事は起こらないと信じましょう。[l]\nでも、何にしても三春の人達に聞くとか、\n普通に頼めば済む話じゃないんですか？」":35,"「ま、それも試しますけど。[l]\n信仰に関わるものですし望みは薄いですね。":36,"祭や神社の事にしたって、\nここまで知ることが出来たのも、飯窪が古くから\n三春と書の蒐集を通じて、多少ですが深い交流があったからです。":37,"その頃も当然ご神体の実物は見せて貰ってないでしょうけどね。[l]\n玄ノ森の住人ですら、この話知らないはずですよ。":38,"いずれ":39,"知":40,"狡は嫌がるでしょうねー。[l]\n飯窪としては三春と変な摩擦を起こしたくないでしょうし」":41,"はあ、面倒くさいことですなあ。":42,"日本人…とも限らないが気質というか、[l]\n人間のある側面では美点でもあるのだろうが、\n信仰心が実務にもブレーキをかける、というのも\nなかなか考え物の場合もあるわけだ。":43,"田舎だと特にはっきりと影響ありそうだし、\n":44,"狡さん真面目だから、\nその辺りは慎重にもなるだろう。":45,"「さてですね。というわけで宮は今度の件で、[l]\n玄ノ森に行って来なきゃなのですが。":46,"ただ、さっきから言ってる通り、三春が素直に見せてくれるとは\n思えないんで」":47,"「あ、行くんですか。[l]\nで、はい、でも見せてくれないだろうと」":48,"「…うひひ」":49,"な、なんすかその笑みは。":50,"「…その神事に忍び込んででも確認せよ、[l]\nという本家の要請も実はあるんです」":51,"「うえ？！[l]\nまじすか！！[l]\nだ、だめでしょそんなの！」":52,"「でもですね実際、モノを盗ろうというんではないですから。[l]\n要は中身が分かれば良いんですし。":53,"そのあと、知り得たことを世に開陳する訳でもないし、\n黙ってれば分からないす。":54,"本家長年の悲願とはいえ、単なる知的好奇心の充足、それだけっ。[l]\n全く書痴とは罪作りな人種ですね～」":55,"「ですね～ってまたそんな簡単に！[l]\nそもそも宮さんそんなスパイじみた事出来るんですか？[l]\nいや、それ以前に、するつもりなんですか？」":56,"「だって単にご神体覗き見るだけですよ。[l]\n安置場所がわからないので神事の最中になりますけどね。[l]\nどういう風に扱われるかにもよりますが―――\nまあその辺に隠れて望遠鏡とか暗視カメラでさくっと」":57,"「そんな機材あるんかい！[l]\n…言うからにはあるんでしょうね、本家のバックアップも[l]\nお有りのようだし…」":58,"「で、祭は四月末日、丁度一ヶ月後くらいですか。[l]\nそのころに知狡のとこにでも滞在して調査するですよ。[l]\nその時は連休も近いですしまこくんも連れて、\n帰省がてら祭見物でもしてもらおうかなーっ」":59,"「と、思ってたんですが」":60,"「？」":61,"「んお？」":62,"かれお嬢と一緒になって身構える僕。[l]\nなんだ。これ以上さらに何か予期せぬ事態があるというんだな。[l]\n面倒そうだなあ…":63,"まて、そもそも最初から、\n僕に関係する話だって言ってなかったか？":64,"「さっきご飯の途中、知狡から電話が来てたんです。[l]\nそしたら、つい最近、先日ですね、玄ノ森で割と大きな事件が\nあったらしくて―――」":65,"「事件？なんすか？[l]\n崖崩れでも起きて通行がままならないとか？[l]\nそれとも熊が出たとか…」":66,"「―――あまり大きな声では言えません。[l]\n…人為的に行われたと思しき、[l]\n人死にが数件あったそうです」":67,"「ひっ！人死に！！」":68,"なんだって？[l]\n人為的に為された、つまり殺人事件か？[l]\nしかも数件だ？":69,"「よっ…予想の範囲外…でスね…？[l]\nミぃ店長…」":70,"何を予想してたというのだ、かれお嬢。":71,"「三春に連なる家の者だったので、\n圧力が掛かって表に情報は出ないのですよ。[l]\n…あそこはそういう土地、そういう家、[l]\n罷り通る状況があるです。[l]\n覚えて置いてください。[l]\n知狡は飯窪本家の者なので有る程度事情を知り得たようですけど」":72,"とある田舎、謎の祭の伝わる土地（そう、しかも玄ノ森は\n温泉郷でもあるのだ）で、連続殺人発生かよ。[l]\n長いサブタイトルが付くような二時間ドラマか。[l]\nちょっと移動すればあの辺の海岸は断崖だらけだし。[l]\nはたまた大神がよくやるようなゲームかなにかか。[l]\nあいつからよくそういうの聞くぞ。[l]\nいやいや、笑い事ではない。[l]\nというより僕がどう関わらされるのかが問題だ。":73,"「詳しくは分からないし、\n聞こえる部分の真偽も疑って掛かる必要はありますが、\n死因はあまり普通ではないようでした。":74,"益々表沙汰にはならないですね。三春家とその眷属はその辺徹底してますから。[l]\nただ祭がスケジュール通り行われるかどうか微妙な感じになったので…」":75,"「え？ええ、それで」":76,"もうあまり頭がついていってないので、\n生返事になってしまう。[l]\nそれでなんなんだ？":77,"「つまりはですね、":78,"調査はおそらく祭の日に限られる、[l]\nでも祭の日程が怪しくなってきたので、\n延期や早まった場合に備えて、前後長期的に滞在しておきたくて…":79,"その間中まこくんにもしっかり側に居て欲しいわけです。[l]\n状況が状況ですし、ボディガード兼スパイ助手も兼ねてもらえれば最高だにゃっ♪」":80,"「ソーリーです真言さんっ。[l]\n私は所用がありましてご一緒できないのでありますっ」":81,"突然よそ行きの声で小首を傾げる宮さん。[l]\nそして顔の前で手を合わせ僕に謝るかれお嬢。[l]\n数秒後、段々話が脳に浸透し、\nようやく反応。[l]\n…ちょっとまて！！":82,"「ばっ、みっ、あ、雨山さん、誤解しないでくださいよ！[l]\n宮さんも何を突然！」":83,"「んむ、今回は別にミステリやドラマみたいに、\nその事件を解決しに行くわけじゃないですし。[l]\n『月狂跳』が示す要素さえ蒐集できれば、飯窪は満足なんです。[l]\nそれが宮達の目的。[l]\n警察絡むような事は…[l]\n極力しませんし是非協力して欲しいです」":84,"「いやそれはそれとしてちょ、ちょっと待った！[l]\n僕大学あるんスけど！[l]\n春休みもう終わるし駄目ですって！！":85,"そのそういう事なら祭の日程決まったらその時呼んでくれればいいでしょうよ！":86,"「ま。[l]\n一部は冗談として、\n宮、夜目は利くんですが、\n暗いのは苦手なんですぅ。[l]\nあとやっぱり一人じゃなかなか難しい作業もありまして。[l]\nさっき言った機材とかも、運搬係してくれると嬉しいっす。":87,"あ、先に言っておきますが、\n本家の人間はあそこでは顔が割れてるし、祭で忙しくて使えないのですよ。":88,"書き入れ時ですからね、知狡達にとっては。[l]\nだからお願いですってばぁ。[l]\nあ、臨時ボーナス、＋いろいろ宮がサービスしますよぉ♪」":89,"くねくねする宮さんだったが、\nいろんな意味でこれは僕とて籠絡される状況ではない。[l]\n拳をぶんぶん振り上げて反論を続ける。":90,"「駄目だってー！！[l]\n今日はまだ２年目始まる直前、祭当日にしたってほとんど五月ドアタマですよ？":91,"前後一ヶ月って、中間試験と被ってる！[l]\n一年のスタートからそんな無茶な！」":92,"「あ、前から思ってたんですけど、もう学校辞めたらどうですかまこくん。[l]\n":93,"そうですねそれで行きましょう、良い機会です」":94,"はいー！？":95,"「あっははは、な、なにを突然！[l]\n前からって何ですか！[l]\nというか飛躍しすぎですって宮さん！[l]\nきょ、協力したいのはやまやまですが何もそこまでしなくても！」":96,"思わず笑ってしまいました。[l]\nかれお嬢、気の毒そうというより羨ましそうな目で何故\n僕を見るんですかしら。":97,"「まあ、まこくんもどうせ就職の為のあれでしょ？[l]\nどうせもう先は（うちに）決まってるんですから、\n今更モラトリアム堪能しなくてもいいですよね。[l]\n早めに社会に貢献して世のみんなに褒めて貰いましょー」":98,"考えようによっては説得力があるが、\nいやいや待て！[l]\nいくら何でも突飛に過ぎる！！":99,"「だからそれは誤解をあれ、あれです、かっ、母さんが何と言うか！」":100,"「電話してみます？」":101,"そうだ、ここで母さんからも話してもらおう。[l]\n携帯のメモリーから家を検索、電話。":102,"しばしのあいだ。":103,"喧":104,"々":105,"囂":106,"々。[l]\n":107,"侃":108,"諤":109,"々。":110,"会話終了。回線切断。":111,"おいおいおいおい、学費が浮く方を優先されたぞ…[l]\n母さんまで「あたしも前から思ってた」ってどういうことだ。[l]\nえ、ていうか退学すれば戻ってくるんだったか？　学費って？[l]\nこないよな？逆に損だろ？あれ？":112,"「どうでしたぁ？」":113,"……。[l]\n悠然と微笑みながら宮さんが訊いてきた。[l]\n…まさか申し合わせてたのか？":114,"いや、母さんは人から頼まれたって\nそんな計算行動できる人じゃない。[l]\nということは天然でだ。あの返答は。":115,"なんたることだ。[l]\n……。[l]\n…仕方なく僕は宮さんに力無く応えた。":116,"「宮さん及び本家への協力が最優先事項だと…」":117,"そう、未来の嫁への投資がどうとか意味不明な事までしゃべくったが、そこはスルーしたし宮さんにも告げなかった。":118,"どういう意味だ。[l]\n商売しない本屋を趣味で作る飯窪の、分家とはいえ飯窪は飯窪。[l]\n流石に世間一般でいうまともな理屈を持たないらしい。":119,"僕とか知狡さんが真面目なのは特例なのか？[l]\nそれとも僕らも実はそうなのか？[l]\nう、それはいやだ。[l]\nいやだが…":120,"いいや、もう。[l]\n世知辛い時代だ。[l]\n大学出た所で何が保証されているでもない。":121,"母や宮さんの思惑に乗るのは癪ではあるが、\nこれが僕の将来の為の布石だと思おう。":122,"一年だけでも大学生と言うモノを体験できただけでも良しとするか。[l]\n元々面倒なことは嫌いな質なんだ、僕。":123,"この場合どっちが面倒なのかは、もうそれこそ考えるのも面倒だ。[l]\nああ、これもまた飯窪の血の一端なのか。[l]\n逃れ得ぬ血の呪縛、嫌なモノだ、全く…":124,"「その代わり、\n本当に責任取って貰いますよ。[l]\n僕の将来に。うぅ～…」":125,"女子二人の前で半泣きになる僕。[l]\nだからかれお嬢、何故僕を羨ましそうに見るんですカ。":126,"「おーるおっけーでっす。[l]\nまこくんの将来は宮達が完全ふぉろー！ばっくあっぷ！[l]\nじゃ、学校の諸手続はしておくように禅とまこくんママに\n言っておきますから。[l]\n出発は五日後で。準備よろしくです。[l]\n荷物はそうですね、\n滞在中の色々は知狡のとこで大体は足りると思うので、\nそれは留意してください。[l]\nただ、まこくんがいた頃と状況はほとんど変わってませんから、\n何か街でないと買えないようなものはこちらで用意した\n方がいいです。":127,"あとテレビ、キー局の系列はほとんど入りはしますが、\nこっちで予約録画はしておいたほうが。宮はしていきますよ。[l]\n携帯電話はどこの使ってますか？":128,"あ、電波入らないですね。仕方ない、急用の時は宮のを。[l]\n免許はちゃんと持参してください、車がないときついでしょうね。[l]\n車自体は本家ので。マニュアル車しかないですが問題ないでした？":129,"なら良いです。[l]\n当たり前ですがバイトも当分休止ですね。[l]\n":130,"ま、今後は正従業員ですしねっ。うひひ」":131,"こうして僕は、\n全く無茶な展開によってではあるが、\n縁故の地でもある、玄ノ森に行くことになったのだった。":132,"漫画や小説ではよくある巻き込まれ型主人公を、\n地で行ってしまってる気がする…":133,"現実にも、いや現実だからこそ、義理や人情故に断り切れないという場面があるのだなあ。あはは…[l]\nまさに不条理な決断。[l]\n今回は違う気がするけど…":134,"結局、帰りは真っ暗の中自転車をこいでアパートまで帰った。[l]\nビタミンＡが足りてないのか、心の有り様なのか、\nいつも以上に視界は真っ暗だった。":135,"田舎で良いもん食えればいいな…そして明るい視界が取り戻せますように…[l]\nああ、明日からは、もう旅の準備をしなければならない。[l]\nさて、友達にはなんて説明したものか。":136,"…そうか、友達なんて呼べるのは結局一年在学してたった一人、[l]\n大神だけだったか。そう思うとちょっと悲しいものがあるな。":137,"いいや、奴にはあとでメールか電話しとこう。[l]\n今日はもう寝る。[l]\n寝るったら寝る！":138,"就寝して数分後、携帯の着メロで起こされた。[l]\n着信は、ああ、大神雪鳴。":139,"…しょうがない。この際説明するか…":140,"奴の用件は他愛のないものだったので、\n会話の大半は僕の置かれた状況の説明となった。":141,"驚かれたり呆れられたりした後、\n結局奴にも納得していただいた。":142,"戻ってきたら飲もうぜ、と話を締め電話を切り時計を見ると、\n既に相当深夜を回っている。結構な時間喋っていたらしい。":143,"…ふて寝も満足に出来そうにない。[l]\n全く今日は―――いや、とっくに日も変わってしまった―――\n昨日は酷い日だった。":144,"何とか眠ると、宮さんが夢に出て、\n何故か僕はすごく彼女に愛おしさを感じていたけども。":145,"今までも夢に異性が出ると、そういう感じになったこともあったので、特に後を引くことはなかった。":146,"ただ、少しやさぐれていた心が、\nやや安寧を取り戻したような気がして、\n明日からは、多少は前向きに彼女に協力しようと思いながら。":147,"再び無へと意識は落ちていった。":148},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_002.ks","relPath":"/data/scenario/SC_M_002.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":149,"length":149,"percent":100},"cellInfo":[null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"t":"HU"}],[null,{"v":1}],null,[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"t":"HU","v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"t":"HU","v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"t":"HU"}],[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[138,4],"note":"完成"},"/data/scenario/SC_M_003.ks":{"data":[["寒い。","好冷。"],["ホームに降りた時点で相当の冷気を感じる。[l]\n明らかに空気が違う。[l]\n澄んでいる。","刚下月台就感到刺骨寒意。[l]\n空气明显不同。[l]\n很清澈。"],["天候こそ今日は曇っていて、いいロケーションとは言い難いが、\nそれでも関東とは比較にならない。[l]\n遠方の景色が異常にクリアに見える。視線が抜ける。","虽然今天天气阴沉、称不上好光景、\n但仍远非关东可比。[l]\n远方景色异常清晰。视线能穿透般。"],["一際特徴的な山が","特别显眼的山是"],["九","九"],["抱","抱"],["山で、\nあの麓が","山、\n而那山脚下就是"],["玄","玄"],["ノ","之"],["森だ。","森。"],["呼吸してみても、空気が美味い。[l]\n都会の大通りでは深呼吸もままならないのに。[l]\nそうだ、記憶では水もさぞ美味かったはずだ。[l]\n飯以前に水が相当違ってた。[l]\n昼飯も抜いたことだし、さぞかし食事は堪能できることだろう。[l]\n都会の利便性とこれら、僕ならこっちを取るんだがなあ。[l]\n状況さえ許してくれればだが。","试着呼吸了一下，空气真甜美。[l]\n在都市主干道连深呼吸都困难。[l]\n对了、记忆中水也应该很美味。[l]\n比起这里的饭菜、还是水质更令人印象深刻啊。[l]\n既然连午饭都没吃、想必能好好享受美食吧。[l]\n要选的话、我宁愿放弃都市的便利选这边。[l]\n只要情况允许的话。"],["にしても、","不过、"],["「寒っ！[l]\n宮さんの脚見てると余計に！」","「冷死了！[l]\n看到宫小姐的腿更冷了！」"],["上半身こそ上着を羽織ってるが、\n下はいつものミニのプリーツなうえに\n宮さん生足なんだもんな。","虽然上半身披着外套、\n下身还是平常的迷你百褶裙、\n宫小姐可是光着腿啊。"],["女子はファッションの為ならば恐ろしき忍耐力を発揮するものだが、\n喜ぶ御仁もおられようが、\nこういう状況では端から見てると鳥肌立つな。","女性为了时尚可是能发挥出惊人的忍耐力，\n虽说或许也有乐在其中的人，\n但这种情况下旁观者看着都会起鸡皮疙瘩。"],["まったくさすが北の地、４月上旬ではまだまだ寒い。[l]\n関東から来た所為で余計に温度差を感じてる部分もあるだろうが、\n上着を持ってこなかったのは失敗だったかもだ。[l]\nある程度想定はしていたんだが、ちょっと想像以上だった。","不愧是北方地区啊，四月初还是冷得要命。[l]\n可能因为从关东过来所以对温差特别敏感，\n没带外套来真是失策了。[l]\n虽然早有心理准备，但实际比想象中还夸张。"],["「スケベですね。[l]\n見ないでください。","「真下流呢。[l]\n请不要看。"],["それよりここ、乗り換え猶予はタイトなんです。[l]\n本数少なくて乗り損ねたら何時間も待つんですから、\n早く移動しましょう」","比起这个，换乘时间很紧张啊。[l]\n班次很少要是错过就得等好几个小时，\n我们快走吧」"],["持ってきた時刻表のメモを確認すると、\n確かに殆ど数分しか間がない。[l]\n宮さんの分の荷物も持って、\n別のホームへとダッシュする。[l]\n吐く息もまだ白いもんだ。","看了眼带来的时刻表备忘录，\n确实间隔只有短短几分钟。[l]\n拎着宫小姐的行李，\n冲向另一个站台。[l]\n呼出的白气还没消散。"],["前もって言われていたことではあるが、\n僕の携帯では、電波が入らなくなるらしい。[l]\n大手の旧普及型のがぎりぎり入るくらい。\n一応確認してみたが、\n…ああ、思いっきり圏外になってる。[l]\n結局緊急時には宮さんのを借りるということになっている。[l]\nいいんだ、どうせ掛けて来る相手も居ないことだし。[l]\n大神にも伝えてあるしな。","虽然事先被告知过，\n但我的手机好像会收不到信号。[l]\n只有那种大公司出的旧款普及型手机才能勉强收到一点\n试着确认了下，\n...啊，完全没信号了。[l]\n紧急情况就借用宫小姐的手机得了。[l]\n无所谓啦，反正也没人会打给我。[l]\n也和大神说过了。"],["１３年ぶりとなる玄ノ森はまだここからローカル線＋バスで一時間、\nまだここから全然遠いし、\n今の時点で懐かしさがこみ上げてくる、ということもない。[l]\n水の美味いのは覚えてるというのも、我が身ながら現金なことだ。[l]\n速読も得意だし、視覚記憶にはそれなりだと思ってたのだが、\n実際はそうでもないのかな。[l]\n単に成長につれ身につけたのか。","阔别十三年的玄之森还要从这里坐地方线+巴士一小时，\n离这里还远得很，\n现在倒也没涌上什么怀念之情。[l]\n只记得水质很好这点，连自己都觉得够现实的。[l]\n本来觉得速读很拿手，视觉记忆也不差，\n实际上似乎并非如此？[l]\n或许只是随着成长自然掌握的技能。"],["乗り換えのローカル線のホームに着き、\nすでに停車中の列車に急ぎ乗り込む。[l]\nもはや列車もパンタグラフのある『電車』ではなく、\nディーゼルでしかも３車両しかないものになっている。[l]\nドアは押しボタンで降りる時は自分で開けねばならない。","到达要换乘的地方线站台，\n匆忙登上早已停靠的列车。[l]\n这甚至不是有受电弓的『电车』，\n而是柴油动力且仅有三节车厢。[l]\n下车时还得自己按按钮开门。"],["バスの方が余程近代的乗り物に見えるようなこの車両、\n平日昼間ということで、その閑散さたるや一際感じられる。","这车厢破旧得连巴士都显得更现代，\n因为是平日白天，空旷感格外明显。"],["ただ宮さんが言うには、サラリーマンこそ居ないが、\n登下校の時間帯は中高生の足としてそれなりに混雑するそうだ。[l]\nそもそも学校が、どう考えたってどこの家からも遠いのだ。[l]\n人口密度、家屋の建ってる密度が低いんだから当たり前なんだが。","不过宫小姐说虽然没上班族，\n但上下学时段因为初高中学生的往来，车厢里也会相当拥挤。[l]\n说到底那所学校，怎么看都离所有住家很远。[l]\n毕竟这里人口密度低，房屋分布也稀疏，这也是理所当然的事。"],["列車が走っている最中、窓の外をなんとなしに見ていた。[l]\n田圃の日陰の所には、いつ降ったものなのか、\nまだ雪が溶け残っている所もある。[l]\nふと思いついて、今一度九抱山を見ると、\n山頂や山肌にはやはり雪が相当残っているのだった。","列车行进时我漫无目的望着窗外。[l]\n田埂背阴处还残留着积雪，\n不知是何时降下的。[l]\n突然想起什么似的望向九抱山，\n山顶和山脊果然还积着不少雪。"],["何かしら記憶の中の景色と照合しないかどうかと思っていたのだが、\nどうやら僕の脳には全く残存していないようだ。[l]\n失礼な言い方になるが、\nまさかこんな山中で、景色の側が変化したということは考えにくい。[l]\n第一、見える風景は、すべからく時の刻みをその場にたたえたままとしか思えない状態だ。[l]\n地形変化とて多少はあろうが、僕の視るモノ、その範囲全てにおいて、記憶との差違は起こすほどのことはないだろう。","本想着能否与记忆中的景色对照，\n但我的大脑里似乎完全没留存相关画面。[l]\n这么说可能有点失礼，\n但很难想象在这样的深山里，景色本身会发生什么变化。[l]\n首先映入眼帘的风景，全都像是凝固在时光里的模样。[l]\n地形变化或许多少有点，但在我视野范围内的所有事物，应该都不至于和记忆产生偏差。"],["と思って、\n一応本家とも以前から交流のあるらしい、\n宮さんに訊いてみる。","想着，\n貌似和本家以前就有来往，\n试着问问宫小姐。"],["「宮さん、ここって、\n昔からこんなでした？」","「宫小姐，这里\n以前就是这样吗？」"],["「んむ？[l]\nそうですね。[l]\n宮が知ってる間では、\nずいぶん変わりもしましたねー」","「嗯？[l]\n是啊。[l]\n在宫知道的范围内，\n已经有了相当大的变化呢—」"],["おや。[l]\n色々思ってみたのに実際はそんなものか。","哎呀。[l]\n虽然想了各种可能但实际不过如此嘛。"],["とはいえ宮さんの『知ってる間』が、\n一体どのくらいの期間かは知れたものではないが、\nいくらなんでも…","不过宫小姐所谓的『知道的范围』\n究竟涵盖多长时期也无从得知，\n但再怎么说也…"],["「まこくんは知狡のとこからあまり\n出歩かなかったと聞いてますよ。[l]\n変わっても変わって無くても、\nこの辺はわからないんじゃないですかねー？」","「听说小真很少从知狡那里\n出门走动呢。[l]\n所以不管变没变，\n这附近的情况您应该都不清楚吧—？」"],["「あ？[l]\nあー、そうでしたっけ？[l]\nあ、ああ、そうかも。[l]\nそうだ、うん旅館の建物とかは覚えてますね…[l]\nそうか、なんかずっと知狡さんとあそこで\n遊んでた覚えはあります」","「啊？[l]\n啊—，是这样来着？[l]\n啊，啊啊，或许吧。[l]\n对了，嗯旅馆的建筑什么的倒是记得…[l]\n说起来，总觉得一直和知狡阿姨在那里\n玩耍的记忆还是有的」"],["理由は覚えてないけど、\n確かに殆どあの敷地から出た記憶はない。","虽然不记得缘由，\n但确实几乎没有从那个旅馆出去过的记忆。"],["と、『玄ノ森』と書かれたプレートが見えた。[l]\n次の駅で降りるのだ。僕の思考は中断された。","这时，写着『玄之森』的站牌映入眼帘。[l]\n下一站就要下车了。我的思绪被打断。"],["無人駅かと思ったが、\nホームに車両が入ってくると奥から\n駅員さんが現れて、ようやく改札として機能しだした。","本以为是无人的车站，\n当列车驶入月台时，从深处\n走来站务员，总算开始履行检票职能。"],["壁からなにから、木造やトタンであって、\nそれが半朽し錆び付き、ヒト、自然、いろいろなモノの混じり合った匂いが。[l]\nまるで映画かドラマのロケーションでしか見たことが無いような景色。","从墙壁到各种设施都是木造或铁皮搭建，\n那些半腐朽生锈的物件散发着人、自然与各种事物混杂的气息。[l]\n宛如只在电影或电视剧取景中见过的景色。"],["子供の頃は確かに此処にいたはずなんだが、\nとてもそうは思えない程の異国感がある。[l]\n埃で殆ど透過性の無くなったうえに、ひび割れてガムテープで補修してある硝子戸を開け、駅を出た。","孩童时代确实应该在这里生活过，\n却弥漫着令人难以置信的异国感。[l]\n推开因积尘几乎不透明、又用胶带修补裂缝的玻璃门，走出车站。"],["植物の、緑色。[l]\n花の花弁、様々な色。","植物的，绿色。[l]\n花瓣的，各种颜色。"],["人工物が煤けて色褪せて見えるのとは対照的に。[l]\n自然物の色彩の、彩度が違う。[l]\n街とはまるで。","与人造物蒙尘褪色的模样形成鲜明对比。[l]\n自然物的色彩，饱和度截然不同。[l]\n和城市简直（完全不一样）。"],["そして音だ、\nもはや鳥の声と虫などの声、\n近くを流れている川の音しかしない。[l]\nここが―――玄ノ森だ。","还有声音，\n如今只剩下鸟鸣虫吟\n与附近流淌的河川之声。[l]\n这里就是——玄之森。"],["昔はどうだったか知らないが、\n駅前は寂れていて、\n今は本家や六母屋旅館のあるあたりに繁華の中枢がある。[l]\nそれは覚えてる。","虽不知往昔如何，\n站前冷清寂寥，\n如今繁华中心都在本家及六母屋旅馆一带。[l]\n这点我还记得。"],["知狡さんや旅館辺りの事は、\nもはや僕に残された欠片のような唯一の記憶、\nただし食に関することを除く、だ。","关于知狡阿姨和旅馆周边的事，\n几乎是我仅存的记忆碎片，\n不过，这并不包括与饮食相关的内容。"],["いや、それすらも知狡さんところの旅館に由来してる可能性はある。[l]\nま、行けば分かるさ。[l]\nやっと僕も懐かしがれるというものだ。[l]\n今までは謂われのない薄情感（なんだそれ）に苛まれていたからな。","不，就连那些也可能源自知狡阿姨家的旅馆。[l]\n嘛，去了就知道。[l]\n总算我也能怀旧了。[l]\n之前一直被莫名的虚无感（什么鬼）折磨着啊。"],["駅を出る。[l]\nするとびしっと、\nこの田舎の風景からは完全に浮いているスーツ姿の凛とした女性が僕らを見つけ、","走出车站。[l]\n这时啪地——\n与乡下风景格格不入的西装笔挺的凛然女性发现了我们，"],["かつかつと（そう思えただけで、実際には草の生えた砂利道をじゃりじゃりと）歩いて来た。","咔咔地（只是感觉如此，实际是踩着长草碎石路沙沙作响）走来。"],["「お疲れ、久しぶりだな。[l]\nすこし痩せたか？[l]\n宮さん、ご苦労様です」","「辛苦了，好久不见。[l]\n好像瘦了点？[l]\n宫小姐，辛苦您了」"],["飯","饭"],["窪","洼"],["知","知"],["狡さん。[l]\n僕の母の姉、つまり伯母であり、\n玄ノ森の飯窪本家の現当主である。","狡小姐。[l]\n她是我母亲的姐姐，也就是伯母，\n同时也是玄之森饭洼本家的现任当家。"],["そんな知狡さんでも、なぜかかれお嬢のように、\n宮さんに敬語で接してるというのはどういう事情なんだ。[l]\nそれ以前に、この二人が直接話してるのは初めてみるかも知れない。[l]\nが、とにかく今は伯母との再会を喜べと僕の身体は言っている。","但就连这样的知狡阿姨，不知为何也像卡蕾欧小姐那样，\n对宫小姐使用敬语交谈，这其中有什么缘由吗。[l]\n话说回来，这俩人直接对话的场景我可能还是第一次见到。[l]\n不过现在我的身体正催促着我要为与伯母重逢而高兴。"],["「うわー、お久しぶりですただいまです、\nわざわざお出迎え済みません。[l]\nおひとりですか？[l]\n本家の人たちは他は？」","「哇——好久不见我回来了，\n劳您专程来接实在不好意思。[l]\n您是一个人吗？[l]\n本家的其他人呢？」"],["懐かしさに自然と僕の顔も綻んでしまう。[l]\n若いなー相変わらず。[l]\n若いというか童顔なのか。","怀念之情让我的脸庞不自觉地舒展开来。[l]\n真年轻啊——和以前一样。[l]\n与其说是年轻不如说是娃娃脸吧。"],["母さんは年相応で、事あるごとに「姉さんのお陰で損してる」と愚痴るほどである。","母亲倒是符合年龄，还总抱怨「都怪姐姐让我吃了大亏」。"],["だいたいこの姉妹、外見も中身も似てないのだ。[l]\n特に中身は真逆に等しい。","这对姐妹从外表到内在都毫无相似之处。[l]\n尤其是内在简直截然相反。"],["「今日は私が出ると言って、\n旅館任せてきたからな。[l]\n今はオフシーズンだが祭前の準備でそれなりに人手が居るんだ。","「今天是我主动要求出来，\n把旅馆交给别人打理了。[l]\n现在虽是淡季但祭典前的准备也需要不少人手。"],["まあ祭といっても…事情は聞いてるな？[l]\n何にしても良く来た、歓迎するよ」","虽说祭典嘛…你应该知道情况吧？[l]\n总之来得正好，欢迎你们」"],["「そんな、それこそトップの人間がこんなことしてて\n良いんですか？[l]\n僕らのが怒られるんじゃないですか」","「这怎么行，当家的亲自做这种事\n真的没问题吗？[l]\n我们会挨骂的吧」"],["「馬鹿言え、折角可愛い甥が久しぶりに戻ってくるというから、\n無理を言って来たんだぞ。[l]\n心配無用だ、みんな待ち侘びてるよ。","「胡说什么，听说可爱的外甥难得回来，\n我可是硬推掉工作过来的。[l]\n不用担心，大家都盼着呢。"],["そうだ、昼食はもう摂ったのか？[l]\n旅館まで待てないなら、近場の良い店に連れて行ってやるが」","对了，吃过午饭没？[l]\n要是等不及去旅馆，我带你们去附近不错的店」"],["そういえば昼食と言われて、急に空腹感が出てきたな。[l]\n時計を確認したところ、\n…もう二時近いのか。","被这么一说突然觉得饿了。[l]\n看了眼手表，\n…都快两点了。"],["それは腹も減る。というか喰ってないんだから当然だ。","难怪饿。毕竟根本没吃嘛。"],["「わざわざお弁当我慢してきましたから。[l]\nこっちで食べますよ。[l]\nやぱり水が違いますからねー。","「我特意留着肚子没吃便当。[l]\n就在这儿吃吧。[l]\n毕竟水质不一样嘛——"],["旅館のごはんは夜の楽しみにとっておいて、\nとりあえずは店に行きましょう。[l]\nまこくんいい？」","旅馆的饭菜留到晚上享用，\n咱们先去店里吧。[l]\n小真觉得呢？」"],["僕と同じような感想を述べて、宮さんは僕に確認してきた。[l]\nそうだよな、やっぱり水が違うんだよなー。","宫小姐说着和我相似的感想，向我确认道。[l]\n没错啊，果然水质不同就是不一样——"],["「そうすね、全く異議なしです。[l]\n知狡さんのおすすめだったらどこでも美味いでしょう。[l]\n一人暮らし始めてからは特にろくなもの食べてないし。","「是啊，完全没有异议。[l]\n知狡阿姨推荐的店肯定都好吃。[l]\n自从独居后就没吃过像样的饭菜。"],["母親の有難味も今になって身に染みてますよ。[l]\n宮さん連れてってくれるのは安いチェーン店とかばっかだし」","现在才深切体会到母亲做饭的珍贵。[l]\n宫小姐带我去的基本都是廉价连锁店」"],["素直な気持ちを言えば、\n腹が減っていれば何を食べたって美味いと感じるだろうし、\nとにかく空転するこの脳味噌に糖分を補給したい、","说真心话，\n饿的时候吃什么都香，\n现在只想给空转的大脑补充糖分，"],["というのが正直な話であるが、\nさすがに口にはしない。[l]\n空転する我が脳髄でも、そのくらいの配慮をする程度には動いてくれてるようだ。","这才是真实想法，\n但当然不会说出口。[l]\n看来我这空转的脑髓至少还能维持这种程度的体面。"],["多少の皮肉や冗句も交える余裕も何とか残っている。[l]\nんむ、と睨む宮さんをやり過ごし、\n知狡さんに笑いかけた。","甚至有余力穿插些讽刺和俏皮话。[l]\n嗯哼，我避开宫小姐瞪视的目光，\n对知狡阿姨露出笑容。"],["「あんな妹の料理でも恋しくなるものかな。あれの料理たるや…[l]\n…はは、まあいい。[l]\nさ、本家の者には説明してある。","「居然会怀念那个妹妹做的饭。她那手艺…[l]\n…哈哈，算了。[l]\n好了，已经和本家打过招呼。"],["ひとまず本家に着いたら皆に挨拶だけでもしておいてくれ。[l]\n親父殿は懐かしがっているからな。","到了之后至少和大家问个好吧。[l]\n老爷子可是很想你呢。」"],["真言が気にしないなら、そのまま本家で寝泊まりしても問題ないが、\n旅館に部屋はとってあるから、\nそっちで寝泊まりして貰って構わない。","真言要是不介意的话，直接在本家留宿也没问题，\n不过旅馆房间已经订好了，\n你们住那边也行。"],["好きな方を選んでくれ。その場合勿論二人は別々の部屋だ。[l]\nま、宮さんは残念かも知れませんが」","选喜欢的方案吧。当然那种情况下两人要分房睡。[l]\n嘛～宫小姐可能会觉得遗憾呢」"],["「いいです。[l]\n毎晩遊びに行きますもんね。[l]\n温泉て混浴？」","「没关系。[l]\n反正每晚都会去玩的。[l]\n温泉是混浴的吗？」"],["「混浴風呂は露天に。水着着用ですが」","「混浴池在露天区。需要穿泳衣」"],["「よしゃ、うひひ、\nスク水持ってきた甲斐がありますね。[l]\nどうせ祭まで客も少ないんでしょうから、\n当分まこくんと二人で楽しみまーす」","「太好啦～嘿嘿嘿，\n带死库水来果然派上用场了。[l]\n反正祭典前客人也不多，\n暂时就和小真两个人独占啦～」"],["いやな感じに仕返しか、宮さん。[l]\nスク水って大神語録で聞いた記憶があるが、\n…スクール水着？[l]\n……何持ってきてんだ。というか持ってたんだ宮さん。[l]\n真実見た目通りの女子学生なら変じゃないけどさあ…[l]\nいやまずそんなことより早く飯に行きましょうよ。[l]\nて、つい数日前もなんか似たようなことがあった気がするし…[l]\n何かと僕は食事に行くのを邪魔されてるな。[l]\n僕だけが食えない状況にされてる訳ではないだけマシだが。","这是在报复我吗，宫小姐。[l]\n死库水这个词好像在大神语录里听过，\n…School swimsuit？[l]\n……你带的什么啊。话说你居然有这种东西啊宫小姐。[l]\n虽然真要是女学生打扮倒也不奇怪啦…[l]\n不对比起这个还是快去吃饭吧。[l]\n而且总觉得前几天也发生过类似的事…[l]\n我老是被各种事情耽误吃饭呢。[l]\n好歹不是只有我吃不上饭的情况。"],["「あ、あのね…[l]\nほら、だって僕海パンなんか持ってきてないし…」","「那、那个…[l]\n你看，我又没带什么泳裤之类的…」"],["もう抵抗も弱々しいものだ。[l]\nだから僕は、とにかく空腹になると脳も空転し出すんだってばさ。","连抵抗都变得有气无力了。[l]\n所以我都说了，肚子饿的时候脑子会当机的啦。"],["「案ずるな、\nロビーの売店にある」","「别担心，\n大厅商店就有卖」"],["は？[l]\nいや、知狡さん、そこはまじめに反応戴かなくて結構なんですが…","哈？[l]\n不是，知狡阿姨，这种时候不用认真接话的…"],["「んむぅ、まこくん乗り気じゃないなー。[l]\n宮の脚あんなに見てた癖にぃ」","「嗯唔～小真好像不太情愿呢～[l]\n明明刚才盯着宫的腿看得那么起劲的说～」"],["「み、宮さんこそ、\n僕に見て欲しいんですか欲しくないんですかはっきりして下さい。[l]\nスケベ呼ばわりしといて何を今更」","「宫、宫小姐你才是，\n到底想不想让我看请说清楚啊。[l]\n明明都骂我色狼了现在又这样」"],["「さあどうでしょうね？[l]\nいつの時代も男子はその辺判ってくれないですねぇ。[l]\n","「谁知道呢～[l]\n男人从古至今都不懂这种微妙之处呢～[l]\n"],["んむ、知狡、戯言はここまで。[l]\nさっさとご飯行きましょう」","嗯唔，知狡，玩笑到此为止。[l]\n赶紧去吃饭吧」"],["…いつの時代も女子はその辺教えてくれないからねぇ。[l]\n特に宮さんのテンションの遷移の読めなさっぷりたるや、\nまさに猫の目のようというやつだし。[l]\nそこいらの男子たる僕あたりでは到底判るわけもない。[l]\nともあれさっさとご飯に行くのにはまるで異論はないから、\n黙って付いていく僕。","…女人从古至今也不肯明说这种地方呢。[l]\n特别是宫小姐的情绪变化莫测程度，\n简直就像猫眼石说变就变。[l]\n像我这种普通男生怎么可能搞得懂。[l]\n总之对赶快吃饭这事完全没有异议，\n于是默默跟上去的我。"],["「真言が海産物苦手というのも覚えている。案ずるな。[l]\nこの辺りは…見れば判るがどちらかといえば山の幸だ。[l]\nさ、あのハイヤーに乗ってくれ」","「我记得真言不擅长海鲜。别担心。[l]\n这一带…如你所见算是山珍居多。[l]\n来，上那辆包车吧」"],["ハイヤーというか、\nま、田舎だからタクシーとほぼイコールの黒い車が、\n駅前ロータリー（と呼ぶのも気が引けるが）に待機していた。[l]\nしかし、ハイヤー…[l]\nたまたま僕が半端にアナクロだから知っていた単語だけれど、\nふつう僕らあたりの年代だと、既にハッカ並に通じない言葉ですよ？","说是包车，\n嘛～乡下地方其实就是辆黑色出租车，\n停在站前环岛（这么称呼都有点勉强）等着。[l]\n不过包车…[l]\n也就是我这种半吊子怀旧派才知道的词，\n一般像我这个年纪的人，这词怕是已经和“薄荷糖”一样听不懂了吧？"],["近くに来てみると、確かにタクシーとは違う、\n艶加減、黒さ。[l]\nちょっとだけだがブルジョアぽい気分になる。[l]\n知狡さんも、僕の食の嗜好よく覚えてるな…[l]\nと一瞬思ったが、\n最近、何かの時に母さんが電話でそういう会話をしていたのを思い出した。[l]\nそれでか。[l]\n詳細に言えば、僕は魚や海老、蟹は食べられるが、\n海草と貝類、ウニ等が大の苦手なのだ。[l]\n主に匂いと食感が原因。","靠近一看，确实和出租车不一样，\n光泽度、黑漆漆的。[l]\n虽然只有一点点，但确实有种资产阶级的感觉。[l]\n知狡阿姨也清楚记得我的饮食喜好啊…[l]\n虽然这么想了一瞬间，\n但马上想起最近母亲打电话时好像有聊过这事儿。[l]\n原来如此。[l]\n具体来说，我能吃鱼虾蟹，\n但海藻贝类和海胆等完全不行。[l]\n主要是气味和口感的原因。"],["当然だが世間が下す高級度合いの評価などまるで無関係であって、寿司屋では割と安上がりに済ませられる訳である。[l]\n前、北海道の海鮮丼屋に入ったとき、\n僕は何も食べられるものがなくて大変だった。[l]\nという話をしてたんだったか母さんは、確か。","当然这和世俗所谓的高级程度完全无关，所以在寿司店反而能省不少钱。[l]\n之前在北海道的海鲜盖饭店里，\n我几乎找不到能吃的食物可惨了。[l]\n母亲当时说的应该就是这个话题吧。"],["ちなみに山菜は大好物なので、\nこれから行くところも、旅館の食事も期待できるだろう。[l]\nそしてようやく僕ら三人はハイヤーに乗り込んだ。","顺便一提我很爱吃山珍，\n所以接下来要去的地方和旅馆的餐食都值得期待。[l]\n终于我们三人坐上了豪华轿车。"],["「かれおったらまた連絡なしでうちにきて、\n大変でしたよっ。[l]\n知狡もちゃんとあの娘再教育しといて下さい」","「卡蕾欧那孩子又没打招呼突然跑来，\n可折腾人了啦。[l]\n知狡你也得好好重新教育那姑娘才行」"],["知狡さんは運転手さんに行き先を告げ、助手席へと収まる。[l]\n運転席の真後ろに宮さん、助手席の後ろに僕という席順である。[l]\n車が走り出すなり、宮さんはかれお嬢に対する苦言を呈していた。","知狡阿姨向司机告知目的地后坐进了副驾驶。[l]\n座位顺序是宫小姐坐在驾驶座正后方，我坐在副驾驶后方。[l]\n车刚开动，宫小姐就开始数落卡蕾欧小姐。"],["「すみません。[l]\n彼女の歪みもなかなか強固な部類でしてね。[l]\n有用な特質的能力の由来にも関わるだけに矯正もし難い。","「抱歉。[l]\n她那方面的偏执确实属于相当顽固的类型。[l]\n毕竟关系到特殊能力的来源，矫正起来也很困难。"],["私らとしてはそこを買った訳で、\n…なかなか難しい問題です」","我们也是看中这点才任用她，\n…确实是个棘手的问题」"],["「んむぅ、いちいち真面目に返さなくていいですっ。[l]\n愚痴です愚痴。[l]\nまー、かれおは今回よくやってくれましたけどぉ」","「唔嗯～不用每句都这么认真回答啦。[l]\n只是发发牢骚。[l]\n不过～这次卡蕾欧确实帮大忙了就是」"],["特質的能力って、何かの漫画みたいな言い方だな知狡さん。[l]\n例の目的の本を探し出すってやつなんだろうけど。","特殊能力这种说法真像漫画台词呢知狡阿姨。[l]\n虽然应该就是指找那本目标书籍的事。"],["ま、人間得手不得手なんて、有限の力をどのスキルに振り分けるか次第、みたいな所もあるしな。","说到底人类擅长不擅长的，无非是把有限精力分配到哪项技能的问题吧。"],["最近よくテレビに出てる作家の本に、\n他人より優れた能力を発揮してる人間は、およそ何かしら欠落や不足している部分を持つものだと書いてあったが、","最近常上电视的作家书里写道，\n拥有超常能力的人大多都存在某些缺陷或不足，"],["サヴァンを例に出すまでもなく、\nヒトは足りない部分を補完すべくチカラを働かせるものなのだろう。[l]\n小難しい理屈を出さずとも、当然といえば当然の事ではある。","且不说学者症候群的例子，\n人类本就会为弥补缺陷而激发潜能。[l]\n就算不讲这些晦涩理论，这也是理所当然的事。"],["先日のわずかな邂逅でも、かれお嬢にはスキルの偏りがあろうことは容易に想像できる。[l]\nま、だから『あの』大神とも合ったのかも知れない。","仅凭前几日短暂接触，也能轻易想象卡蕾欧小姐能力不均衡。[l]\n说不定正因如此才能和『那个』大神合得来。"],["それいうとそんな奴が大学唯一の友人だった僕自身は\nいったいどうなのかと自問しかけたが、\n自分のことなんて判らないし、判ったところで、\nその瞬間から僕が別物に変わるわけもないもんね。","这么说来作为大学里唯一和那种家伙交朋友的我，\n差点要自问究竟算什么存在，\n但自己这种事本来就不明白，就算明白了，\n从那一刻起我也不可能变成别的什么啊。"],["と心中で勝手適当に居直りつつ、\n僕は車窓を眺めていた。","在心底随意地自我开解着，\n我望向车窗外。"],["それにしても相変わらずこの人達の関係性が判らない。[l]\n使われてる立場のはずの宮さんの方が、どうみても上位に振る舞ってるように見えるよなあ。","话说回来还是搞不懂这群人的关系。[l]\n明明该是被使唤的立场，宫小姐举手投足怎么看都更像上位者啊。"],["かれお嬢はまだしも、本家当主の知狡さんとのやりとりもこんなだし…[l]\nそれとも単に、\n我が侭娘と人間のできている女性、という見方でいいのか？","卡蕾欧小姐暂且不说，和本家当主知狡阿姨的交流也是这般模样…[l]\n又或者单纯只是，\n可以理解为任性大小姐与成熟女性之间的差异吗？"],["………。[l]\nうーん。[l]\n大学入ってからは、乗用車には専ら運転手として乗っていたので、\n視点がいつもと違い落ち着かない。[l]\nさらに、中心地に近づいてきたのか、段々町並みの様相が変化してきた。[l]\n建物が増えてくる。","………。[l]\n唔嗯。[l]\n自从上大学后，我基本都是作为司机乘坐轿车，\n视角与往常不同让人静不下心。[l]\n再加上可能接近中心地带了，街景逐渐开始变化。[l]\n建筑物增多起来。"],["今住んでいるところも関東圏とはいえ田舎の部類だが、\n玄ノ森のあたりまでくると、\nやはり空気や自然の感じは言うまでもなく、\n建物の高さが決定的に違う。低い。","虽说现在住的地方也算关东圈但属于乡下，\n到了玄之森一带，\n空气和自然氛围自不必说，\n建筑物高度更是天差地别。这里要低矮得多。"],["だから今の僕には、\n大気の透明度も相まって、距離感が狂った感じにみえる。[l]\nう、そんなことを考えてると酔い…そうだ…","所以现在在我看来，\n叠加大气透明度的影响，距离感显得错乱不堪。[l]\n呜、想着这些事就有点晕车…果然…"],["「あれ、まこくん顔色悪っ。[l]\n酔ったですか？","「哎呀，小真脸色好差。[l]\n晕车了吗？"],["いつもはドライバーですもんねー、\n久しぶりに後部座席乗ったからかなー。[l]\n…だいじょぶ？」","毕竟平时都是当司机嘛，\n可能是久违地坐后排的关系吧。[l]\n…不要紧吗？」"],["さすさす。","唰啦唰啦。"],["宮さんが背中をさすってくれる。[l]\n非常に有難くはあるのだが、\n知狡さんの手前もあるしこの状況は非常に恥ずかしいものがある。[l]\nいかんいかん。[l]\n僕は宮さんに礼を言ってさすりを辞退して深呼吸をする。[l]\n宮さんは心配そうに、首を傾げながら「ん？」と僕の顔を覗き込んだので、","宫小姐轻拍着我的后背。[l]\n虽然非常感激，\n但在知狡阿姨面前这种状况实在令人羞耻。[l]\n不行不行。[l]\n我向宫小姐道谢婉拒拍背，做了个深呼吸。[l]\n宫小姐歪着头担心地「嗯？」凑近看我，"],["大丈夫です、と親指をグッと立てて彼女に示した。","我便竖起大拇指对她表示没问题。"],["その後、酔いに対抗すべく車内で僕はテンションを上げ、\n普段より相当喋りまくった。[l]\nそろそろ旅館も近づき、記憶にあるものも出てきた事もあり、\nそういったものを見るたびに大はしゃぎしていた。[l]\nしかし、空腹も重なって脳の空転も最高潮だ。[l]\nちょっとやばいかも…と思い始める。","之后为了对抗晕车，我在车里刻意提高兴致，\n说得比平时多得多。[l]\n随着旅馆渐渐接近，熟悉的景物也多了起来，\n每次看到这些都会让我兴奋大叫。[l]\n但空腹感加上大脑过度运转已达极限。[l]\n开始觉得有点不妙…"],["そのとき、\n視界に黒衣の集団が映り込んだ。","就在这时，\n视野里映入一群黑衣人的身影。"],["ああ、\n喪服なのだ。","啊，\n是丧服。"],["道路の、向かって左側の歩道を歩く彼ら。[l]\n進行方向が同じなので後ろ姿しか見えない。[l]\nあっという間に横を通り過ぎようとする僕らの車。[l]\nその刹那、その集団の中に一際目立つ存在を視た。","他们走在道路左侧的人行道上。[l]\n由于同向前行只能看见背影。[l]\n我们的车即将从他们身旁飞驰而过。[l]\n刹那之间，我在人群中瞥见格外醒目的存在。"],["少女なのか御婦人なのか、\n漆黒のドレスに包まれた女性が居たのだ。[l]\nその流れるように風に靡く、長い髪が。","不知是少女还是贵妇人，\n有位裹着漆黑礼裙的女性。[l]\n她那随风流动的，"],["金色。","金色长发。"],["光線の具合とか、光の反射ではなかった。[l]\n茶髪とかいうレベルでもない。[l]\n染めているのででもない限り、\n所謂あれはブロンドである。","不是光线角度或反光造成的错觉。[l]\n也不是什么茶色程度。[l]\n若非染发的话，\n那便是所谓的金发了。"],["ここが田舎の山中だからといって、\n髪を染めてはいけないことはないし、\n外国人がいていけないということもないのだが。","虽说这里是乡下山区，\n倒也不是不能染发，\n有外国人也不奇怪。"],["周囲の人々が極普通であるが故にか、\n先入観のせいか、僕の空転脳がそう思わせたのか、\n激しい違和感を感じ、\n思わずすれ違いざまに横を向く僕。","但正因为周围人们都太过普通，\n不知是成见使然，还是我眩晕的大脑作祟，\n强烈违和感袭来，\n我不由自主在擦肩时转头望去。"],["目が合う―――","视线交汇―――"],["顔立ちは日本人だが、髪色はやはりブロンド、\n怪我なのか病気なのか、左目には眼帯をしていた。","面容是日本人，但发色确实是金色，\n不知是受伤还是生病，左眼戴着医用眼罩。"],["そして僕を視る右目は、青。[l]\n深き青だ。[l]\nあれは、\n…？[l]\n","然后注视我的右眼，是蓝色的。[l]\n深邃的蓝。[l]\n那是，\n…？[l]\n"],["っ痛ぅ！","好痛！"],["一瞬頭痛が走り、激しく眩暈がする。[l]\n酔った状態で急激に脳が稼働したせいか。","瞬间头痛袭来，剧烈眩晕。[l]\n或许是因为醉酒状态下大脑突然急速运转。"],["が、それも瞬時の事で、僕らと黒衣の人々の距離はたちまち離れていく。[l]\n振り向いてまで確認するのは憚られたので、\n僕はしばし呆然とするしかなかった。[l]\n酔いは治まったようだが、何かを喋る気分ではなくなっていた。[l]\n悪い気分という訳ではないが、酷く冷めた感触がする。","但这也不过是转瞬即逝的事，我们与黑衣人群的距离迅速拉远。[l]\n实在不敢回头确认，\n我只能呆立良久。[l]\n醉意似乎消退了，但已没了开口的心情。[l]\n倒不是心情糟糕，只是感到异常清醒。"],["知狡さんが、何かを察してくれたのか、無言の僕に話しかける。","知狡阿姨像是察觉到了什么，对沉默的我搭话。"],["「ああ、今。見たか？[l]\n彼女が三春家のご息女、\n","「啊，刚才。看到了吗？[l]\n她是三春家的千金，\n"],["三","三"],["春","春"],["冬","冬"],["夏さんだ。[l]\nあの御容姿は生まれつきだそうだよ。[l]\nここでは有名だが…ま、あまり触れないのが礼儀だな」","夏小姐。[l]\n听说那容貌是天生的。[l]\n在这儿很有名…不过嘛，不深究才是礼节」"],["言いたくはないが有力者の娘でもあるしな、と\n知狡さんは付け加えた。","虽然不想提但她毕竟是有权有势人家的女儿\n知狡补充道。"],["まさに、触らぬカミに何とやら、という奴か。","正所谓，不可触怒神明云云。"],["酔いは引いても、空腹自体は当然まだ続いているわけで、\n僕の空転脳はお寒い駄洒落を紡ぎだした。","即便酒醒了，空腹感当然还在持续，\n我空转的脑子挤出了个蹩脚双关。"],["喋る元気が無くなっていたのは、この場合幸いと言わざるを得まい。[l]\n口をついて顕現することは避けられた。","这种时候说不出话倒该说是幸运。[l]\n避免了脱口而出的尴尬。"],["いずれにしろ、彼女が、今回の目的たる三春家の人間ということらしい。[l]\n今後接触する可能性は高いのだろう。","总之，她似乎就是本次目标——三春家的人。[l]\n今后接触的机会应该不少。"],["その時は――\n…その時だ。[l]\n今はとにかく腹を満たしたい。","到那时――\n…到时候再说。[l]\n现在只想填饱肚子。"],["難しい事を思考できる状況ではもはやないんだって。","已经没力气思考复杂的事了。"],["「状況が状況だったから今日まで出来なかったようだが、\n密葬？　とでもいうのかな。[l]\n三春と系列の家の者だけが参加する。","「因为情况特殊才拖到今天，\n算是秘密葬礼？[l]\n只有三春家和相关家族的人参加。"],["宿に到着して落ち着いてから詳細は説明するよ…っと、[l]\n着いたぞ、待たせたな」","到旅馆安顿后再详细说明…好了，[l]\n到了，久等」"],["またややこしい話題になりかけるかと思ったが、\nやっと食事処に着いたようだった。","本以为又要陷入复杂话题，\n总算抵达了用餐地点。"],["車が入っていったのは、\nいかにも長距離運転手さん御用達といった感じの、\n広い駐車場とそれに似つかわしくない、小さな店構え。[l]\n………。[l]\nラーメン屋じゃんよ。[l]\nや、いいけどさあ。それでも。[l]\nでもあの言いぶりだと、\nもう少し違うものを期待してしまうでしょう、知狡さん。","车子驶入的，\n是典型长途司机爱用的那种，\n宽敞停车场配着不相称的小店面。[l]\n………。[l]\n这不拉面店嘛。[l]\n倒也不是不行啦。只是。[l]\n但听您刚才的口气，\n难免会期待更特别的场所啊，知狡阿姨。"],["「何か言いたそうだな？[l]\nお前、ラーメンを見くびってはいかん。[l]\n美味いんだぞ、ここは。[l]\n特に山菜の入った――」","「有话想说？[l]\n你可别小看拉面。[l]\n这家很美味的。[l]\n尤其山菜口味――」"],["店に入りながら熱弁を振るう知狡さん。[l]\nいや、僕もラーメン馬鹿にしてるつもりはないですし。[l]\nただ遠出先で紹介されるとは予想外だっただけです。[l]\n宮さんは…特に疑問を抱いてる風ではなかった。[l]\nもう既知の事だったのかも知れないが。[l]\n僕は席につき、知狡さんの勧めるがままのものを頼んでからは\nぐったりしていた。","知狡阿姨边进店边热情介绍。[l]\n不，我并没有看不起拉面的意思。[l]\n只是没想到远道而来会推荐这个。[l]\n宫小姐…似乎并不觉得意外。[l]\n或许早就知道了。[l]\n我瘫坐在座位上，按知狡阿姨推荐点单后，\n彻底蔫了。"],["『空腹は最高の調味料』とは、\n料理人さんに対しては非常に失礼な言葉だと思うので、\n出来れば万全の状態にての評価を下したかったが、\n今日は仕方ない。[l]\nうん。美味かった。[l]\nしばらく滞在するのだから、また機会はあるだろう。","『空腹是最高级的调味料』这句话，\n对厨师来说可是非常失礼的，\n虽然我更想在状态万全时评价美食，\n但今天只能将就了。[l]\n嗯。真好吃。[l]\n反正要住一阵子，总有机会再来的。"],["ん、そうか、長期滞在者にとっては、\n下手にちゃんとしてる高い店よりは、\nこういった店を知っていた方が有用だ。","唔，也对，对长期滞留的人来说，\n比起那些正儿八经的高档店，\n知道这种实惠小店反而更实用。"],["そこまでの深慮があったとは、さすが知狡さん。[l]\nずっと旅館でご馳走になるわけにもいかないし。[l]\n宮さんはどうするつもりか知らないが、\n僕だけでも遠慮というものをしておこう。","连这层都考虑到了，不愧是知狡阿姨。[l]\n总不能一直蹭旅馆的饭。[l]\n虽然不知道宫小姐怎么打算，\n至少我自己得懂点分寸。"],["ああ、空腹による脳の空転が収まったと思ったら、\n血が胃に行って、これまた思考能力が低下中だ。[l]\n本家にまず挨拶に行くそうだが、\n旅館に着いたら速攻寝させて貰おう。","啊，刚觉得空腹导致的脑雾消散了，\n血液又全流到胃里，脑子又开始迷糊了。[l]\n听说要先回本家打招呼，\n等到了旅馆我得立刻倒头就睡。"],["…今後の事はとりあえず、今日は宮さんの目を盗んで。[l]\n","…至于以后的事暂且不论，今天先躲着宫小姐吧。[l]\n"]],"context":[["SC_M_003.ks/index/1/text"],["SC_M_003.ks/index/3/text"],["SC_M_003.ks/index/5/text"],["SC_M_003.ks/index/7/text"],["SC_M_003.ks/index/9/text"],["SC_M_003.ks/index/11/text"],["SC_M_003.ks/index/13/text"],["SC_M_003.ks/index/15/text"],["SC_M_003.ks/index/17/text"],["SC_M_003.ks/index/19/text"],["SC_M_003.ks/index/21/text"],["SC_M_003.ks/index/23/text"],["SC_M_003.ks/index/25/text"],["SC_M_003.ks/index/27/text"],["SC_M_003.ks/index/29/text"],["SC_M_003.ks/index/31/text"],["SC_M_003.ks/index/33/text"],["SC_M_003.ks/index/35/text"],["SC_M_003.ks/index/37/text"],["SC_M_003.ks/index/39/text"],["SC_M_003.ks/index/41/text"],["SC_M_003.ks/index/43/text"],["SC_M_003.ks/index/45/text"],["SC_M_003.ks/index/47/text"],["SC_M_003.ks/index/49/text"],["SC_M_003.ks/index/51/text"],["SC_M_003.ks/index/53/text"],["SC_M_003.ks/index/55/text"],["SC_M_003.ks/index/57/text"],["SC_M_003.ks/index/59/text"],["SC_M_003.ks/index/61/text"],["SC_M_003.ks/index/63/text"],["SC_M_003.ks/index/65/text"],["SC_M_003.ks/index/67/text"],["SC_M_003.ks/index/69/text"],["SC_M_003.ks/index/71/text"],["SC_M_003.ks/index/73/text"],["SC_M_003.ks/index/75/text"],["SC_M_003.ks/index/77/text"],["SC_M_003.ks/index/79/text"],["SC_M_003.ks/index/81/text"],["SC_M_003.ks/index/83/text"],["SC_M_003.ks/index/85/text"],["SC_M_003.ks/index