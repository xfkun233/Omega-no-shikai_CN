5,"end":9358}],[{"start":9386,"end":9433}],[{"start":9466,"end":9504}],[{"start":9512,"end":9582}],[{"start":9610,"end":9650}],[{"start":9682,"end":9694}],[{"start":9725,"end":9746}],[{"start":9754,"end":9806}],[{"start":9834,"end":9837}],[{"start":9845,"end":9849}],[{"start":9857,"end":9876}],[{"start":9884,"end":9951}],[{"start":9959,"end":9977}],[{"start":9985,"end":10002}],[{"start":10033,"end":10069}],[{"start":10101,"end":10149}],[{"start":10180,"end":10228}],[{"start":10260,"end":10299}],[{"start":10307,"end":10357}],[{"start":10388,"end":10427}],[{"start":10435,"end":10466}],[{"start":10474,"end":10488}],[{"start":10494,"end":10508}],[{"start":10514,"end":10528}],[{"start":10566,"end":10570}],[{"start":10578,"end":10592}],[{"start":10610,"end":10798}],[{"start":10810,"end":10900}],[{"start":10912,"end":10972}],[{"start":10978,"end":11008}],[{"start":11020,"end":11028}],[{"start":11034,"end":11046}],[{"start":11052,"end":11075}],[{"start":11081,"end":11086}],[{"start":11092,"end":11098}],[{"start":11104,"end":11110}],[{"start":11116,"end":11127}],[{"start":11133,"end":11140}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_051.ks","basename":"SC_M_051.ks","indexIds":{"「……あれ？」":0,"ものすごく気分が悪くて、\nそれでめがさめたようだ。":1,"気分が悪い……というより、[l]\n寝覚めが悪い……否、":2,"むかつき焦り、":3,"そんな黒の、負の感情が渾然と渦巻いて、\nそう、\n":4,"苛ついてる。":5,"物凄く苛苛している。":6,"神経が高ぶって、それでめがさめたのだろう。":7,"時間を確認すると、":8,"「……午前５時かよ……」":9,"夕べ、\n泥のように眠り込んだとは言え、\nこの":10,"荒みささくれだったような気分が、\nこの早起きに影響してるのは間違いなかろう。":11,"いつでも、寝れば何とかなる僕でも、\nこのように寝ること自体を封じられる時もある。":12,"一体何だ、何か厭な事でもあったっけか？":13,"何だっけな、\n何か忘れてる事はあったが、\nそれじゃない、":14,"なんだ？[l]\n何かに腹を立ててたんだったか？":15,"「……ああーーーーっ、もうっ！！！」":16,"ばふっ！":17,"半身を起こしたまま、\n布団を両手でぶっ叩く。":18,"「なんだよ、んで苛苛すんなぁもう！！！」":19,"頭を思いっきり掻き毟る。":20,"「ちくしょう……[l]\nくそが、くそが、くそがっ！！！」":21,"………。":22,"だめだ。":23,"いかん、こんなのは。":24,"しかしもう寝直すにはあまりにも、\n":25,"昂ぶってる。":26,"「……あっ」":27,"今日はもう、４月２３日だ。[l]\n冬夏の、冬夏との約束の日だ。":28,"「……連絡は……」":29,"携帯には着信は一個もなかった。":30,"でも、行かなきゃ、\nというか、":31,"「もう、じっとしてらんない、\nどうせ寝られやしないし、\n……行こう」":32,"本当は電話をしたかったが、\n朝の５時じゃ、\nどんな状況だろうと返答は期待出来ないだろう。":33,"ともあれ向こうに着いてから考える事にする。[l]\n出歩くな……とは言われてるけども、":34,"「いいや、\nもう、どうせ僕の事なんか──」":35,"僕がどう動こうがあなたは無関心なんだよね？[l]\nきっと。":36,"そもそもここ数日外出を止められてる事が、\nこのストレスの要因でもあるんじゃねえの？":37,"ま、知狡さんの事もあるし、\nフロントには言っていきますがね。":38,"準備をして、まだ暗く寒い外へと出た。":39,"……実際、どういう返事をするかとか、[l]\nそういう事は頭に無かったけれど、\nまずは会って話をしよう。[l]\nそこから始めよう。[l]\n会えなければ、\n話さなければ、\n":40,"仮":41,"令それが嘘だったとしても、全て錯覚だとしても、\nコミュニケーション自体を封じられるよりは、\n大体にして、\n全てはお互いの思い込みで成り立ってるんだからな。":42,"かといって僕等にはそれ以外に方法はないし、\n十割通じない事を論拠に端から通じ合う事を諦めては、\nどうにもならんのだよな？[l]\nヒトは前に進もうとするところにその意義がある、\nそうだな、大神。":43,"「僕だってヒト……だからな」":44,"車に乗り込んだ。[l]\nハンドルが冷たい。[l]\n車が暖まるまで、震えながら待つ。[l]\n震えながら待つ。[l]\n震えながら──":45,"恐怖にしろ憤怒にしろ、\n生命危機に対する反応であるから、\nその側面として身体が戦闘的になることはあるだろう。":46,"身体がそうなるってことは、\n器官である脳髄もそれに準拠する訳で。[l]\n難しく言うまでもなく、\n腹が立ったり苛苛してるときは、\n思考がそれはもうばりっばりに回る。[l]\n所謂、脳空転の時はふらふらしていて、\n単にとりとめがない、\n制御の効かない混乱といった感じだが、":47,"だが、\nこういう時は違う。[l]\n感情の方向は凝り固まってるから、\n冷静沈着理路整然でこそないが、\nそれでも空転ではない。[l]\n極めて細かく理屈を捏ねて、\n怒る、苛立つ、腹を立てる、憎悪を募らす、":48,"そして湧き出す破壊衝動、悪意、\n対象を殲滅したいという欲動、\n怒りの思考が、\nその理由が、\n自分の中での想像でしかないにも\n関わらず、\n思考が次の思考を刺激誘発して、\n自分の想像でしかないその思考によって次々に、\n触発されていく。":49,"自分の言葉で自分を追い詰め苛立たせ、激昂する。[l]\nコトバで明文化することで、\nより一層その意識は強くなる、\n故に相手がニクイ、だからおまえがキライだ、\nおまえなんかあんたなんか──":50,"負のスパイラル……":51,"いちいち立派な外的理由によるストレスが無くたって、\n空腹や睡眠不足で容易に起こる。[l]\n少なくとも僕はそうだった。[l]\n最近は、\n色々在りすぎて自覚する間が無かっただけ……だ。[l]\nと思う。[l]\nだから、\nこんな黒い意識になってても、\n別段不思議でも珍しい事でもない。":52,"だが、\n今の僕が一体何に対してそんなに苛立ってるのか、\nそれが分からない。[l]\n単に気のせい、\n体調が悪かった、\nずっと外出しないでいたのでストレスが溜まってる、\n脳内物質のバランスが崩れただけ、\nそんな程度の事かも知れないが、":53,"「なんなんだよ、\nこの苛立ちの元は……」":54,"ストレスだけとは思えない、\nそして引っかかり続けている、\n何かを忘れているという":55,"蟠り、\n何にしても、兎に角事実として現状、\n今、\n僕の頭に渦巻くのは、\n黒の偽りなきこころ。[l]\n安らかでない、":56,"荒ん──":57,"そうだ、":58,"「これは、\n不安か」":59,"不安だ。[l]\n不安だ。[l]\n不安でしょうがないんだ。":60,"分からない茫洋とした不安への、\n攻撃的防衛対処能として、":61,"苛立っている。":62,"現状を打破したくてしょうがないのに、\nどうしていいのかわからない。[l]\n或いは、\nどうしようも、ない。":63,"だから不安、しかも自力じゃもう解消されないのなら、\n苛立つしか、ないんだ。":64,"だが、何に不安を抱いてる？":65,"まあそれが分かればそもそも、":66,"「……あれ、もう着いたのか」":67,"元より混むこともない道路、\n早朝ともなれば如何に日曜日でも、\n信号は兎も角ほぼノーブレーキで走れる。[l]\nまだ１０時にもなっていない。":68,"「こんな時間に居るわけないとは思うけど……[l]\nああ、そろそろ電話も大丈夫かなあ」":69,"電話をしてみる。":70,"やっぱり出ないか……？":71,"……あ、":72,"@r──この電話は、電源が入っていないか、電波のと":73,"「……マジかよ。[l]\nマジかよ、マジかよっ」":74,"繋がれば、実際に会話出来れば、\n多少はこの不安も払拭されるんじゃないだろうか。[l]\nそういう淡い期待を知らず抱いていたんだろう。":75,"僕は、\n自分で勝手に抱いた期待を裏切られた事に、":76,"「……っ、[l]\nいや、冬夏は、別に何も、してない……」":77,"激昂しそうになって、\n何とか自分を諫める。[l]\n収めようとする。":78,"取り敢えず、\n砂浜まで移動してみた。":79,"当たり前だが、":80,"冬夏は居ない。":81,"誰１人として居なかった。":82,"「……まあ、そうだろうな」":83,"時間がそもそも早すぎる。":84,"陽が大分高く昇るまで、只管に砂浜で待っていた。[l]\n人は１人も居ない。":85,"腹も空いてきたので、近くの店でパンなどを買い、\nまた砂浜で待っていた。[l]\n電話は１時間おきに掛けたが、常にあのアナウンスが流れ、\n繋がることは無かった。":86,"午後になり、\n誰も居ない海で１人僕は、":87,"転た寝をしてみたり、\n砂を弄んだり、\nしかし、誰も、何も、":88,"陽は落ちた。[l]\n夜になった。":89,"それでも、\n冬夏は来ない。[l]\n連絡もつかない。":90,"「あはははは……あはははは……[l]\nなにをしてるんだろうか、ぼくは、\nなにをしてるんだろうか」":91,"もうだいぶ捨て鉢になって、\n":92,"半ばやけくそ気味に、\n日が変わるまで待ってやる心積もりになってた。":93,"海辺だからすごく寒いのだが、\nもう、そういったものが\n僕を打ちのめすすべてのものが、":94,"「……あはは……[l]\n僕は、\nばかか。[l]\n最低だな。":95,"あわれだな。[l]\nなさけないな。[l]\nあはははははは」":96,"嗤うと涙が出た。":97,"失意で雨の中傘もささずに、\nという風な心境が、\n今なんとなく理解出来る気がしないでもないな。":98,"どうにも野暮つうか無粋だけども、\n悲劇の主人公に浸るのも、\nアリな時もあるよな……":99,"カタルシス、瀉血、液体の排出、快感……":100,"それはつまり、\n迂遠な相手への攻撃だ、\n卑怯な自己弁護だ、\nああ、なんて可哀想な僕、そう言いたいのか？":101,"●●●だ、●●だ、サイテイだ──":102,"僕は……":103,"──そんなものに":104,"@rざしゅ。":105,"「……？」":106,"跫":107,"音……か？":108,"それとも波の音か？[l]\n否、そんな、今日一日聴き続けてるんだ、\n間違えることはない。":109,"今、明らかに異質な、\nイレギュラーな音が。":110,"「──とうか？[l]\n冬夏か？」":111,"しー…………ん。":112,"波の音しか、しない。":113,"「気のせい、だったのかな……」":114,"街明かりなんてモノは遙か彼方だし、\n眼が慣れてるからまだマシだが基本的には真っ暗だ。[l]\nだから、\nナニモノも居ないとは言い切れないが、":115,"「……ぁ──」":116,"「………」":117,"誰か居る。":118,"ヒトだ。":119,"距離は遠いし、それに、\n暗いからというだけではなく、\n恐らく全身黒ずくめ、頭にも何か被ってるのか、\n兎に角、黒くて闇に紛れる。":120,"でも少なくとも多分、冬夏ではない、だろう。":121,"その人影は先客である僕を視付けて明らかに驚いた風で、\n立ち止まったまま動かない。":122,"時間と場所柄的に、\n現れる人種もある程度限られるだろう。":123,"僕もあまり繁々と視ない方が良いとは思った、\n思ったのだが、\n眼が逸らせない。[l]\n向こうがこっちを視たまま止まってるというのもあるが、":124,"いや……まて？":125,"なにか、":126,"──あれは":127,"「ま…………」":128,"……知ってるひとか？":129,"──あれはあの":130,"「……とっ、」":131,"あまりに人と喋らずにいた所為か、\n声のボリュームの出し方に手間取る、\n思わず言い淀んだその時に、":132,"\nざっ。":133,"「！！」":134,"その人影は、\n急に来た方向へと戻っていった。":135,"足早に……というには少し全力っぽい勢いだったが、[l]\n何しろあっと言う間に視えなく──暗いからかもだが、\n気配は無くなった。":136,"「……まあ、[l]\nはは……[l]\n僕の方が怪しいか……":137,"こんな時間にこんな所で１人でいりゃあ、\nきっと怖がられたんだろうな、それで──」":138,"──あれはあのときの":139,"──すでに":140,"──わすれているのはあれの":141,"「そんなばかな」":142,"……そんなばかな？":143,"そんな馬鹿な？[l]\nって何の事だ？":144,"完全に独り言だ。[l]\nしかも無意識に。":145,"意味不明でも何でも口に出したいくらい、\nそんなに口寂しいのか僕ぁ。":146,"あ、あれ、コトバ的に間違ってるか？[l]\nまあいいや、兎に角、":147,"「０時を回った──」":148,"昨日は、誕生日、おめでとう。":149,"冬夏……何があった？":150,"電話は一度たりとも繋がらなかった。[l]\n勿論この場所にも現れなかった。":151,"真逆、\nほんとに姫様ちゃん達が、":152,"「あの":153,"娘":154,"等に電話した方が分かったかもなあ……":155,"でも、\nあの時のあの……[l]\nあの立ち位置では、素直に教えてくれるとは到底」":156,"思えない。":157,"狩屋ならまだし、も、":158,"「！！！[l]\nで、電話だ」":159,"携帯電話が僕の手の中で激しく鳴動する。":160,"一瞬取り落としてしまい、\n急ぎ慌てて砂から拾い上げる。[l]\n着信相手を確認するのももどかしく通話ボタンを押す。":161,"「もしもしっ！？」":162,"「あ、兄ぃ？[l]\nわたし、克杖……」":163,"狩屋？":164,"……狩屋？":165,"「あ、ああ、よう。[l]\nど、どうした……？」":166,"「わたしどうしていいかわかんない……[l]\nきーちゃが、冬夏ちゃが、きーちゃが、」":167,"「な、何かあったのか？！[l]\n詳しく、教えてくれ、僕も一体何があったのか、」":168,"「……ああ、もう、どこから話せばいいのかな……[l]\nあう～」":169,"「あ、あのな、\n姫様ちゃん……と、冬夏が、ネコガミか？":170,"それを遣うのも知ってる、\nもしかしたらお前もそうかも知れない……んだな？":171,"兎に角、\n僕にそれが視えるのも知ってる、\n冬夏は今日僕と会う筈だったのに連絡が一切取れない、":172,"こないだ……神社で２人と会った時に、\nすごい険悪だったのは、\n何か関係が──」":173,"そこまで一気に言うと、":174,"「えあ？！[l]\nあ、兄ぃ、\nえ？」":175,"あからさまに動揺しているが、\n一体何に対してなのかは分からない、\nだからこっちで一方的に捲し立てた。":176,"「お前がもしかしてほんとに、\nその、ネコガミ遣える人間だとしても僕は驚かないし、\n何とも思わない、":177,"だから教えてくれ、\nそれに関係してるのか？[l]\n２人は無事なのか？[l]\n何事も無く家に居るのか？」":178,"そんな筈ない、\nそんなだったらこいつはこうやって僕に連絡なんか、\nしてない……":179,"「わ、\n……わかった、兄ぃ、[l]\n私達はそういうモノなの。":180,"何処まで聞いたかしらないけど、\nきーちゃの、アヤメのチカラは……[l]\n特禁………触……で、[l]\n何か様子が……」":181,"ああっ、糞っ！！！[l]\n電波が！！！[l]\nこんなときに！！！":182,"「悪い、聞こえない！！」":183,"「え？[l]\n……の、………で……":184,"…れで……冬夏……[l]\n大怪我………でも、[l]\n………ぶなんだ……けど、とにか……」":185,"冬夏？":186,"大怪我？":187,"やめてくれ、やめてくれ、そういうのは、":188,"手が、脚が震えて……[l]\n脈拍が上がる、なのに身体は寒い、気が遠くなりそうだ、\n気をしっかりもて、気をしっかりもて、":189,"──ワレハジュウゼンヲノゾムモノユエ":190,"よし、だいじょうぶだっ……てえの！":191,"「……たしも……なに……[l]\nだから……兎に角会ってほし……」":192,"「わ、わかった！会うんだな？[l]\n兎に角、\n一端戻る、\n何処にいる？」":193,"「待って、今は駄目、もう時間ない、\nえと、火曜、２５日でお願い、\nだいじょぶ？」":194,"「火曜？あ、ああ、こっちは大丈夫だ、[l]\nけどそんな悠長で良いのか？":195,"冬夏は、姫様ちゃんは大丈夫なんだな？[l]\n問題は無いんだな？[l]\nそれだけ──」":196,"「命に別状は無いって意味ではうん、\n大丈夫、説明すると長いの、ごめん、":197,"だからね、\nうん、分かった、火曜にあの公園で待ってる、":198,"お願いね、わたし、こんなの、":199,"じゃあね、兄ぃ、気をつけて、":200,"また電話するね、切るよ──」":201,"………、":202,"なんだ、何が、起きてるんだ、":203,"き、きっと命に別状云々というのは、\n冬夏が確か言っていた、\n道具さんのネコガミのチカラだと、\nいや、本当は卑尊さん……だったか？[l]\n急を要してないのは多分そういう理由だと思う、\nだが、狩屋がああいった連絡をしてきた事自体には、\nそういう意味が、\nつまりあまり良くない何かがあった、\nという事は間違いが無い──":204,"否、考えても仕方がない、兎に角戻ろう、\n急いで戻るんだ、\n火曜……は日が変わってるからもう明日だ、[l]\nそれまでに、\n宮さんに何としても会うんだ、":205,"三春の家達──八相の人間達に何かが起こってる、\n祭にしろ御神体にしろ、\nあのひとに話さなきゃ始まらない、":206,"@r何としても、\n会って話をしなければならない。":207,"冬夏達の為にも、":208,"@r──ワレの為にも":209,"@r嗤っちゃうくらいに巻き込まれ型だけど、":210,"それでも、":211,"進まなきゃ、":212,"動かなきゃ、":213,"@rでないと僕は、":214,"@r──。":215},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_051.ks","relPath":"/data/scenario/SC_M_051.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":210,"length":216,"percent":97.22222222222221},"cellInfo":[],"cacheResetOnChange":{}},"/data/scenario/SC_M_052.ks":{"data":[["宿に戻るととうに深夜を回っていたが、\nもう関係無かった。","回到旅馆时早已过了深夜，\n但已无关紧要。"],["すぐにでも宮さんの部屋に行って──と思ったら、\nロビーで知狡さんと会って呼び止められた。","正想着要立刻去宫小姐的房间──\n却在大厅遇见知狡阿姨被叫住了。"],["「……今日……否、昨日は一日何処に行っていた？[l]\n出歩くなと言った筈だろう」","「……今天……不，昨天一整天去哪儿了？[l]\n不是说过不要外出吗」"],["「それは、いや、謝ります、\nそれよりも、宮さんのところに、」","「那个，抱歉，我道歉，\n比起这个，宫小姐那边，」"],["「……その、宮さんがお呼びだ」","「……那个，宫小姐在叫你」"],["……え？","……诶？"],["僕が一瞬混乱した間に、\n知狡さんは大きく深呼吸……否、溜息か……？[l]\nをして、","在我短暂混乱期间，\n知狡阿姨深深吸气……不，是在叹气……？[l]\n然后，"],["「私はお前を愛している。[l]\nだから決して、──」","「我是爱着你的。[l]\n所以绝对不要，──」"],["そのまま知狡さんは黙ってしまった。","说到这儿知狡阿姨突然沉默了。"],["「私も行く。[l]\nこっちだ」","「我也去。[l]\n这边」"],["「あ、あはい？[l]\n部屋じゃないんですか？」","「啊、啊好的？[l]\n不是去房间吗？」"],["知狡さんは淡々と歩みを進め、\n僕の方を視ようとしない。","知狡阿姨面无表情地向前走，\n不愿看向我。"],["……これは、[l]\nやっぱり怒られる？叱られる？","……这是，[l]\n果然要挨骂？要挨训？"],["いや、しかし、\n連絡寄越さないにも程があるでしょうが……","不，但是，\n不联系也太过分了吧……"],["こっちにはこっちの事情というものが、\nとか、\n我ながらぐだぐだとした言い訳を考えてると、","我这边也有我这边的情况，\n之类的，\n正想着这些乱七八糟的借口时，"],["「………」",""],["場の……というか、内装の雰囲気が、[l]\n何気に変わっていた。[l]\n考え無しについて行ってたが、\n知らない間に地下に降りていたらし……","场所……或者说内部装潢的氛围，[l]\n微妙地改变了。[l]\n没多想就跟了上去，\n不知不觉似乎已来到地下……"],["ああ、これは地下の、\nこないだのあの風呂場のあったフロア？","啊，这是地下的，\n上次那个有浴池的楼层？"],["他にも古いまま残した箇所があったのか。[l]\nそれくらい上階と雰囲気が違う。[l]\n棟自体移動したのかも知れないけど……","还有其他保持原样的区域吗。[l]\n和上层氛围相差甚远。[l]\n说不定整栋建筑都移动过……"],["というよりも、\nこれは本家の地下や、\n三春の蔵の、","不如说，\n这像是本家的地下室，\n或是三春家的，"],["「……入ります」","「……我进来了」"],["どうやら目的地に着いた。","似乎到达了目的地。"],["重い音を立てて扉が開く。","门扉伴随着沉重声响打开。"],["「ひさしぶりです。[l]\n待たせてごめんね。[l]\n何日ぶり？」","「好久不见。[l]\n让你久等了。[l]\n有几天了？」"],["すると其処には、\n宮さん、チノ嬢、","只见那里站着，\n宫小姐、千乃小姐、"],["そして、僕の知らない人間が、\n１、２……４人ほど、[l]\n知狡さんは、","以及我不认识的人，\n1、2……大约4人，[l]\n知狡阿姨，"],["「何があっても私を……現実を、母さんの事を思え。[l]\nお前は１人じゃない」","「无论发生什么都要记得我……记得现实，记得妈妈。[l]\n你不是一个人」"],["そう言って僕を中に引き入れ、\n扉を閉めた。","说着将我推进屋内，\n关上了门。"],["「どうしたんです？[l]\nぼーっとしちゃって。[l]\n眠いのかな？[l]\nよるはみかた、私達の時間でしょお？」","「怎么了？[l]\n在发呆呢。[l]\n困了吗？[l]\n夜晚是属于我们的时间对吧？」"],["「……あなた、宮さん……[l]\n……ですか？」","「……你、宫小姐……[l]\n……是吗？」"],["宮さん……は、[l]\nその広い空間の、\n一番奥、\n宴会場で言うとステージに相当するところに、","宫小姐……正坐在[l]\n那个宽敞空间的\n最深处、\n相当于宴会厅舞台的位置上、"],["仰々しい──古めかしく大きい、\nしかし装飾気の無い椅子に座って、\n僕を視下ろすようにして、\n居た。","夸张地──坐在一张古老而宽大、\n却毫无装饰的椅子里、\n居高临下地\n注视着我。"],["反響の所為か、\n距離はあっても声が聞こえにくい事は無い。[l]\nだけど……","或许是回声的缘故、\n虽有些距离但声音并不难听清。[l]\n可是……"],["「んむ？[l]\nなーんか深淵な質問？[l]\n禅問答？公案？[l]\nうひひ、宮は、視ての通りの美少女古書肆、\n","「嗯唔？[l]\n怎么问得这么深奥呀？[l]\n禅问答？公案？[l]\n嘻嘻，宫就是如你所见的美少女古书店主、\n"],["紛う事なき宮岡門王水ですよ」","如假包换的宫冈门王水哟」"],["……なんだ？[l]\n温度差のある人と話してるようなこの、","……搞什么？[l]\n这种像在和温差极大的人对话、"],["ばつが悪いような、\n罪悪感に苛まれるような、\n圧倒的な距離感、隔絶感、違和感は……","令人尴尬的、\n被罪恶感折磨的、\n压倒性的距离感、隔绝感、违和感……"],["「怒られると思った？[l]\nうひひ、\nまあ、その『自主性の芽生え』もね、","「以为会被训斥吗？[l]\n嘿嘿、\n不过嘛，那个『自主性的萌芽』呢、"],["気になる所ではあるんですが、\nまあ、別にお小言を言う場を設けたわけではありません。[l]\nそこは心配しなくていいですよ」","确实也让人在意、\n但今天倒不是专门来说教的。[l]\n这点不必担心哟」"],["「……はあ、[l]\nええと、その、すみません……」","「……哈啊、[l]\n那个、就是、对不起……」"],["会いたいのじゃなかったのか？[l]\n話したいことがあったんじゃなかったのか？","不是你想见我的吗？[l]\n不是有话要对我说吗？"],["しかし、\nそういったものは雲散霧消してた。","然而、\n这些念头都已烟消云散。"],["只","只"],["管、不安が、動悸が、\n震えが、寒気が、","血管、不安、心悸、\n颤抖、寒意、"],["とりかえしのつかないことをしたかのように、\n僕の身体はうごかない。","仿佛做了不可挽回的事般、\n我的身体动弹不得。"],["──きをつよくもて","──保持警惕"],["「えーと、\n重要なお知らせの前に、\n報告聞いときましょうか。[l]\n宮と会ってない内に何がありました？」","「那个、\n在重要通知之前、\n先听听汇报吧。[l]\n和宫分开期间发生什么了？」"],["そ、そうだ。[l]\nまずは全部、\nそれから、──。","对、对了。[l]\n首先把全部、\n然后，──。"],["まるで混乱していて、\n要領を得なかったが、\n兎に角思うままに","虽然混乱不堪、\n完全不得要领、\n总之想到什么"],["管喋った。","就一股脑说了出来。"],["部屋に同席している知らない人達の事が気にはなったが、\n一端昂揚してしまうともう気にならなかった。[l]\nがむしゃらに、喋った。","虽然在意房间里那些陌生的同席者、\n但一旦亢奋起来就顾不上了。[l]\n不管不顾地、说着。"],["「ネコガミ。ヤソウ。ふむふむ」","「猫神。野草。嗯哼嗯哼」"],["……あれ？","……咦？"],["重要なお知らせの前に？","刚才是不是说了"],["って言ったよなさっき？","『在重要通知之前』？"],["「……あ、[l]\nもう聞いてるかもですが、\n貰ったお守り、」","「……啊、[l]\n可能你已经知道了、\n收到的护身符、」"],["「んむ、チョーカー切られたんだ、ったね。[l]\nまあ、外出を禁じたそもそもは、\n実はそれに起因しては、いるんですけど──","「嗯唔，项圈被切断了呢。[l]\n其实当初禁止外出、\n根本原因就是那个来着──"],["さて、どこから話したものかな。[l]\nんーむ、\nよし。[l]\nえとですね、\n………今回のそもそもはだね、」","那么，该从哪儿说起呢。[l]\n嗯——\n好。[l]\n那个啊，\n………这次事件的起因呢，」"],["……口調が変わった…？","……语气变了…？"],["揶ってる……のか？","在模仿……吗？"],["否、……誰だ？","不对，……是谁？"],["今度こそ、何かが違うと感じる。[l]\nこのひとは、宮さん？[l]\n──宮さん？","这次确实感觉到有些不同。[l]\n这个人，是宫小姐？[l]\n──宫小姐？"],["──ミ、ル、","──米、尔、"],["眼の前の少女……？が、すぅ──と立ち上がった。","眼前的少女……？轻轻──地站了起来。"],["「兄様が準備してくれた箱庭で、","「在兄长大人准备的微缩庭院里，"],["妹の私が愉しく劇を観覧しながら、\n八相に奪われた封紙の奪還、\n即ち黒のイツワの再統合をなして、\nLu=Leの残党狩りその他諸々を愉快にこなす、\n兄様に色々献上すべきものも確保出来て、\n私も大満足、","身为妹妹的我愉快观赏戏剧的同时，\n从八相手中夺回被抢走的封纸，\n也就是让黑色伊兹瓦重新统合，\n顺带开心地解决Lu=Le残党和其他杂事，\n还能确保给兄长大人进贡的各类物品，\n我也非常满足，"],["という、趣向の、遊戯。","就是这样的，趣味的，游戏。"],["だったのだけどね。[l]\n色々と面倒な予定外の事が次から次へと起きてね。[l]\nさすが雫だねぇ。[l]\nんむ？何のことかわからない？[l]\nそれを今からお伝えの時間なんだよ。[l]\nと、言うわけで。[l]\nイーハ。[l]\nごめん、まこくん。","本来是这么打算的啦。[l]\n结果各种麻烦的意外接二连三发生呢。[l]\n真不愧是雫啊。[l]\n嗯？不明白在说什么？[l]\n现在就是要讲这些的时间哦。[l]\n就，是这样。[l]\n伊哈。[l]\n抱歉，小真。"],["説明するとね、\nその壊されたチョーカーはね、prot-einって言って……[l]\nちなみにprot-einは別名『魔女の乳酪』とも言ってですね、\nまこくんに分かるように言うと、\nもう会ってますね？[l]\n奇士道具、の家のねこのちからです。[l]\nPHASE:4に相当します。[l]\n色々便利なのですよ？[l]\n他のPHASEを限定条件付きとは言え代替出来ますしね……","说明一下呢，\n那个被破坏的项圈啊，叫做prot-ein……[l]\n顺便prot-ein别名也叫『魔女奶酪』，\n为了让小真能理解，\n已经见过了吧？[l]\n是奇士道具，她家猫咪的力量。[l]\n相当于PHASE:4。[l]\n很方便的哦？[l]\n虽说有条件限制但能替代其他PHASE呢……"],["と、\n話が逸れました。[l]\nそのチョーカー、\nprot-ein:Choker（息ふさぎしもの）はね。","啊，\n跑题了。[l]\n那个项圈，\nprot-ein:Choker（窒息之物）啊。"],["Ig:TYPE･MEGA-D「P+」、[l]\nそう、Ｅ凹……飯窪本家のあの仮面ですね。[l]\nで起こしたイーハを、\n八相の連中に気取られない様にすることをメインとしつつ、\nその他諸々の役割をもった、\nPHASE:2、\nそうまこくん、\nキミのいい仲のあの三春の司相を発現型として強化されてる、\nまあ補助的（サブ）防衛機構（プロテクトシステム）なんだね。","Ig:TYPE･MEGA-D「P+」，[l]\n对，就是E凹……饭洼本家的那个面具。[l]\n用来让觉醒的伊哈，\n在不被八相那帮人察觉的前提下，\n同时兼顾其他各种功能的，\nPHASE:2，\n没错小真，\n就是以你那位好友三春的司相形态强化的，\n算是辅助性（SUB）防卫机制（PROTECT SYSTEM）啦。"],["三春と言えば、\n冬夏さんはまあ、筋が良い方だけども、\nあの三春の先祖ってのがさあ、\nまた能無しでね……如何にあの娘が多少はマシな方としても、[l]\nあれだけ接近してたのに、\nまこくんがナニモノかなんてぜんっぜん、","说到三春，\n冬夏小姐嘛，资质算好的了，\n但那个三春的祖先啊，\n又是个废物……就算那姑娘稍微强点，[l]\n都接近到那种程度了，\n小真是什么人居然完全完全，"],["@r……まだ耐えられる？","@r……还能撑住吗？"],["まだ半分も話してないんだけど。[l]\nＣＡＴの事はもう識ってるんだろう？[l]\n全部視えてる筈だもんね。[l]\nあの娘がちゃんと引導渡してくれたんでしょぉ？[l]\n黒のイツワから単離された、\nCAT_X/10:PHASE:2、ミハル。[l]\nもう視せて貰った訳でしょ、先刻の報告聞く限りじゃ？","明明连一半都还没说完呢。[l]\nCAT的事你应该已经知道了吧？[l]\n毕竟你全都看得见嘛。[l]\n那孩子好好给你做过引导了对吧～？[l]\n从黑色伊兹瓦分离出来的，\nCAT_X/10:PHASE:2，米哈尔。[l]\n刚才的报告听起来，你应该已经看过了吧？"],["兎に角、\nまあ、\nぎりぎりまでどうしようか考えていたんだけど、\nまこくんをそろそろ戦闘参加可能な駒として組み込んだほうが、\nよさげな方向へとね、\n事態がシフトしちゃって。[l]\n多少形式は変わっちゃったけども、\n最終目的の遂行はゲームの不文律に関わらず続行出来るから、\nんむ、そういうこと。[l]\n今までお待たせしてごめんなさいでした。[l]\n何しろ向こうさんはこんな事情知らないからさ」","总之，\n那个，\n我本来想拖到最后一刻再做决定的，\n但让小真作为可战斗棋子加入战局的话，\n事情似乎会往更好的方向，\n发展呢。[l]\n虽然形式上有些变化，\n但最终目标的达成可以不受游戏潜规则影响继续推进，\n嗯，就是这么回事。[l]\n让你久等到现在真是抱歉。[l]\n毕竟那边完全不了解这些内情嘛」"],["そこで、眼の前の少女は話すのを止めた。[l]\n僕があまりにも","说到这里，眼前的少女突然止住了话语。[l]\n大概是因为我"],["悚","悚"],["然と、\nしていた、から……だと思う。[l]\nそして、口に指を当て小首を傾げ、\nこちらを覗き込むように視る。","然\n的反应……太明显了。[l]\n随后她将手指抵在唇边微微歪头，\n用窥探般的眼神望过来。"],["ワカル？とでも言いたげに。","仿佛在问「明白了吗？」"],["そんなことをいわれたって、","就算你这么说，"],["何を言ってるのか全く理解出来ないよ？[l]\nいや、りかい、え？","我完全听不懂你在讲什么啊？[l]\n啊、理解、呃？"],["──そうだったのか","──原来如此"],["そうだったのか……？","原来是这样……？"],["え？","咦？"],["「……？[l]\nなに？[l]\nなんのはなしですか？","「……？[l]\n什么？[l]\n在说什么话题？"],["え？[l]\nドッキリですか？[l]\nねえ？あはは……","诶？[l]\n整人游戏吗？[l]\n喂？啊哈哈……"],["みんな揃ってまた、僕なんかに大がかりですなあ、\n僕の知らないヒトまで、知狡さんまで巻き込んで、\n………。","大家又这样兴师动众地对付我，\n连我不认识的人、连知狡阿姨都被牵扯进来，\n………。"],["その、\n何を言ってるのかさっぱり、\nわからんのですけど……」","那个，\n我完全搞不明白\n你在说什么……」"],["笑ってみても、\n駄目だ、脚が、身体が、\nこ、わいのか？","即使强颜欢笑，\n也不行、双腿、身体、\n在、发抖？"],["恐怖だ？[l]\n畏れ？恐れ？","这是恐惧？[l]\n畏怖？惧怕？"],["だって僕は、\nフツウじゃない何かが、\n視えるしこのセカイに居るのを、\n知ってるじゃ、ないかよ。","毕竟我可是\n能看见非寻常之物\n也知道这个世界存在着\n那些东西啊。"],["視たじゃないかよ。","不是早就看见过了吗。"],["──だから、真心（＝本心）をきみに、","──所以，要把真心话告诉你，"],["ほんとうの、ことを言ってる？","现在说的、都是真的？"],["「んむー。[l]\nじゃあ私の御真音（ほんとうのなまえ）を教えます。[l]\nそれで少しは理解が及ぶかな？","「嗯哼～[l]\n那就告诉你我的真名吧。[l]\n这样或许能稍微理解些？"],["イーハの方を少ぉし刺激しましょうか。[l]\nわたしのなまえは」","要不要稍微刺激下伊哈那边呢。[l]\n我的名字是」"],["@r@r@r@rクララ・ミルハ・リデル","@r@r@r@r拉拉・米尔娅・利德尔"],["@r最強の白、白透女、司書長の妹。","@r纯白之巅，白透女，司书长的妹妹。"],["@r白のミルハと人はよぶ。","@r人们称我为白之米尔娅。"],["「………は？」","「………啊？」"],["──白のミルハ、最凶の","──白之米尔哈，最凶的"],["宮さんが白のミルハ？","宫小姐是白之米尔哈？"],["みるは？くらら？[l]\n外つ國みたいな、なまえだ、なあ、\nそんな、え？なに？","米尔哈？库啦啦？[l]\n像外国一样的，名字呢，呐，\n怎么会，诶？什么？"],["「私はね、\n……キミの事は何て呼ぼうかな？[l]\nまあ、今はまだ便宜的にまこくんと呼んでおこう。","「我呢，\n……该怎么称呼你呢？[l]\n嘛，暂时先按惯例叫你小真吧。"],["まこくん、\n私はね、」","小真，\n我呢，」"],["おわぁぁぁぁあああああああああああああん。","呜哇啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊。"],["耳鳴りが鳴ってる、気が遠くなって、\nなんていった？[l]\nなんていったの？","耳鸣在响，意识渐渐远去，\n说了什么？[l]\n说了什么啊？"],["……なんて言った？","……说了什么？"],["意識が","意识"],["明","明"],["瞭すると、\n宮さ……、[l]\n宮さんは、僕の変調に気付かない風で、\n話を続けていた。","清醒时，\n宫小……、[l]\n宫小姐似乎没注意到我的异常，\n继续说着话。"],["「んむ？[l]\nああ、まだ勘違いしてるね？","「嗯唔？[l]\n啊，还在误会呢？"],["ドレの──冬夏サン達の能力を視たのだろう、\n彼女達もまだ分かってなかったのか、\n或いはアヤメの","看到了冬夏小姐她们的能力吧，\n她们也还没明白吗，\n或者阿娅梅的"],["娘は知ってたのかな？","女儿知道吗？"],["兎に角ね、\nまこくん、\nキミは、\n彼女等と同様に、","总之呢，\n小真，\n你啊，\n和她们一样，"],["ＣＡＴが視えるニンゲン、\nねこを遣えるニンゲン魔眼質者──ではあるのだけれど、\nそれ以前に、」","是能看见CAT的人类，\n能驱使猫咪的人类魔眼持有者──虽然是这样的，\n但更重要的是，」"],["キミ自身がさ。","你本身就是。"],["「",""],["ＣＡ",""],["Ｔなんだよ」","T啊」"],["「………！？」",""],["で、宮はね、","然后，宫她啊，"],["「ぁあああああああああああ！！！！！！！！！！！！？」","「啊啊啊啊啊啊啊啊啊啊啊啊啊啊！！！！！！！！！！！！？」"],["ねこが、ね、こがっ、","猫咪，猫，猫啊，"],["あれは、あれだっ、アレだッ！！！","那个，就是那个，就是那个啊！！！"],["ネコガミ──っ、と同じようなモノ、","和猫神──类似的东西，"],["やっぱり、知ってて、知ってたのか、\n飯窪本家も、\n知ってて、しってて、僕を──","果然，知道，早就知道了吗，\n饭洼本家也是，\n知道，早就知道，把我──"],["違うそうじゃない、\n宮さんが、みやさんが！！！[l]\nみやさんがあ！！！！！！","不对不是这样的，\n宫小姐，宫小姐！！！[l]\n宫小姐她啊！！！！！！"],["「んむ、そんなに驚かれるとちょっと傷付きますね。[l]\nというかだから、\nまこくんだって同類な訳だけど？」","「嗯唔，这么惊讶让我有点受伤呢。[l]\n所以说啊，\n小真你不也是同类吗？」"],["ねこに視える、","能看见猫，"],["\nねこに視える、","\n能看见猫，"],["\nねこ、","\n猫咪，"],["\nこれが僕の、ほんとうの？","\n这就是我的，真正的？"],["う、そ、だ、ちがう、","不，不对，不是的，"],["\n──それは誤なり","\n──那是错误的"],["\nえ？[l]\nなんだって？[l]\nいや、そんな場合じゃ、","\n诶？[l]\n你说什么？[l]\n不，现在不是，"],["「う、あ、え……？[l]\nち、知狡さんっ、これは何の──」","「呜，啊，诶……？[l]\n知、知狡阿姨，这是什么──」"],["振り向いて知狡さんを視ても、","回头看向知狡阿姨，"],["な、どうして黙ってるんです、\nそんな、やっぱり、知狡さんまでし、しってた──のか？","为、为什么沉默着，\n难道，连知狡阿姨也，也早就──知道了吗？"],["「知狡、キリアケ」","「知狡，切明」"],["「え……っ？[l]\nきりあ」","「诶……？[l]\n切明」"],["知狡さんは無言で、","知狡阿姨沉默着，"],["何かを懐から取り出し──","从怀中取出某物──"],["……っ？","……？"],["ねこの、カミ、","猫的、神，"],["冬夏達と同じ、あの、\nネコガミ、カミサマ、紙の……","和冬夏她们一样的，那个，\n猫神、神明大人、纸的……"],["「きりあけ……霧明……切開……」","「雾明……雾明……切开……」"],["「そう、視えてるじゃないか。[l]\nそれが麒麟緋（キリアケ）。[l]\nの、封紙ね。","「看，不是能看见嘛。[l]\n那就是麒麟绯（KIRIAKE）。[l]\n的、封纸啦。"],["詳しくは後程説明するとして、\nまあ、\nこういう展開もねえ。","详情待会儿再说明，\n不过，\n这种展开也是有的呢。"],["ドッキリのネタばらしとしてはお粗末だけど、\nどうする？[l]\nワカって貰えた所でまた一から説明……いるかい？","作为整蛊的揭秘环节来说虽然很拙劣，\n怎么办？[l]\n就算拿到「理解」又要从头解释……有必要吗？"],["最初に言ったけど、\nこの劇はね、\n兄様が私の為に用意したもの。[l]\n私の無聊の慰めの為に","一开始就说过了，\n这场戏啊，\n是兄长大人为我准备的。[l]\n为了排解我的无聊"],["拵えてくれた","特意准备的"],["遊","妓"],["戯、","戯、"],["ま、\n要するに『暇潰し』だね。[l]\nきっちり台本通りに進めていこうかと思ったんだけど、\n今言ったようにちょっとしたイレギュラーな事態が起きてさ。[l]\nシナリオ変更を余儀なくされちゃったんだよ」","嘛，\n说白了就是『打发时间』啦。[l]\n本来打算严格按照剧本来推进的，\n但就像刚才说的发生了点意外状况。[l]\n不得不临时改剧本啦」"],["………。[l]\n一体、どういう、こと？","………。[l]\n到底、怎么回事、啊？"],["瞬時にして高まった筈の動悸が、","本该瞬间加速的心跳，"],["もう、\n落ち着こうとして、\n僕はどんどん、\n感覚が摩耗して摩滅して鈍磨して、","已经、\n试图平静下来，\n我逐渐、\n感觉被磨损消耗钝化，"],["結果、\n冷静に、\nこんなのは、\nヒトとして、","结果，\n冷静地，\n这种事情，\n作为人类，"],["いや、","不、"],["ああ……","啊啊……"],["「ただね、\n基本的には『暇潰し』だし、\n再三言うけどその目的自体は変更しなくて済む構造になってるから、\nだからやるべき事は変わってない訳。","「只不过呢，\n基本上就是『打发时间』罢了，\n虽然再三强调但那个目的本身的结构就是无需改变的，\n所以该做的事其实没变啦。"],["つまり、\nまず１つは、\nキミのほんとうの身体をとっとと回収して、\nキミに返すことね。","也就是说，\n首先第一点，\n得赶紧把你真正的身体回收回来，\n然后还给你才行。"],["キミの身体っていうのは、」","至于你的身体呢，」"],["宮さんが、いや、このひとが何か言ってる。","宫小姐在说话，不对，是这个人正说着什么。"],["けどもうわからない。","但已经听不懂了。"],["なにをいってるのかもう、わからない……","到底在说什么已经完全、听不懂了……"],["──それはトウヒなり","──那是冷杉般"],["無茶言うなよ……","别胡说八道啊……"],["「八相の連中の持ってる封紙」","「八相那帮人持有的封纸」"],["わからない、","不明白，"],["──いや、ワカル","──不，我懂了"],["「私と同じく、\nキミはヒトの骸操る","「和我一样，\n你是操纵人类尸骸的"],["霊たる存在。[l]\nま、今のその身体は正真正銘、ヒトだよ。","灵体存在。[l]\n嘛，现在这个身体可是如假包换的人类哦。"],["私のこの身体だってそう。[l]\nただ、ＣＡＴというのはね──」","我这具身体也是。[l]\n只不过，CAT这玩意儿啊──」"],["なんのことだ、","你在说什么、"],["──そんなのは","──那种事"],["「──というね。[l]\nキミ自身……というにはあれだけど、[l]\nそういう話はイーハとも納得ずくで既に交渉は済んでるんだよ」","「──这么说来。[l]\n你自身……虽然这么说有点那个、[l]\n这类话题早就和伊哈达成共识完成协商了」"],["トーノイーハ……","十之伊哈……"],["十の飯食……","十碗饭……"],["僕が十番目の……ネコガミ……？[l]\nそう言ってるのか？[l]\nそんな、はなし、","我是第十柱……猫神……？[l]\n是在说这个吗？[l]\n这种、事情、"],["──とおの昔に","──早在"],["姫様ちゃん……？","姫様……？"],["──PHASE:1　殺","──PHASE:1　杀"],["「──で、","「──所以、"],["雫っていうのは、\n至極簡単に言えば、\n渦中の存在、\nそれが存在することでフラグがばんばん立つ、\n望む望まないに関わらず事態を引き起こし差異を増幅させ、\nまさに鏡の如き水面にイッテキを投じ波紋を生むもの、\n呼び水たる月の雫、\nゲームや劇に於いて、\nイベントを起こすに十分な素質を持った存在……","所谓雫、\n极简而言之、\n就是漩涡中的存在、\n因其存在会不断触发flag、\n无论意愿如何都会引发事态并放大差异、\n恰如向镜面般的水面投入一颗石子激起涟漪、\n引月之雫、\n在游戏或戏剧中、\n拥有足以引发事件资质的存在……"],["んむー、説明が難しいな。[l]\n我々の始祖、古巣、母体たるLu=Leの発足にも関係してる、\nそんなだから、普通は後世になってから、\n『あいつは雫だ』って呼ばれる訳だけども、\n兎に角そういう特異点としての存在が居るのだ、\nというのが我々の見解。","嗯唔ー，真难解释啊。[l]\n与我们始祖古巢母体Lu=Le的创立也有关联、\n正因如此通常要到后世、\n才会被称作『那家伙是雫』、\n总之就是作为这类特异点的存在、\n这便是我们的见解。"],["で、\nまこくん、\nキミは大変に『雫』だった。[l]\n濁ったみどろをさざめかせ、停止した時間を動かす針だった。[l]\nキミは同時にマガンノサシテでもあるからね、\nそれはそれは素晴らしかったよ？[l]\n次から次へと、\nほら、自分でも分かってるだろ？[l]\nタイミング良くイベント起きたろ？[l]\nただ効き過ぎたというかな──」","然后、\n小真、\n你曾是极其突出的『雫』。[l]\n是搅动浑浊泥沼、推动停滞时针的存在。[l]\n因为你同时还是祸兆之器、\n那可真是精彩绝伦啊？[l]\n接二连三地、\n看，你自己也察觉到了吧？[l]\n事件总是恰到好处地发生对吧？[l]\n只是效果有点过猛了──」"],["僕はもう、\n泣きたいくらいに、\nだって、いまや、\n冷静に耳に入ってくる情報を処理してる自分がいる、","我已经、\n快要哭出来了、\n因为现在、\n有个正在冷静处理灌入耳中信息的自己、"],["宮さん……宮さんの言ってることは、","宫小姐……宫小姐说的话、"],["つまり、","也就是说、"],["僕が、","我、"],["あなたに、","被你、"],["今まで、","一直以来、"],["うそだ……","骗了……"],["やめてくれ……やめてくれよぉ……","别说了……快住手啊……"],["「──とうとうこちらの勢力にも損傷を受けるイベントがね、\n起きてしまった。","「──终于连我方势力也遭遇损伤事件、\n发生了。"],["キミとはまた違った、\n不確定要素の存在があってね、\nそいつが縛鎖を喰ってしまったのと、\n敵さんにどうやら封紙出来る奴がいるらしくてね、","与你类型不同、\n存在着不确定因素、\n那家伙啃食了缚锁、\n敌人那边似乎有擅长封纸的家伙、"],["ああそう、まこくんに持ってきて貰ったあのカミだよ。[l]\nありがとう。あれで分かったんだよ？[l]\n感謝してるよ。","啊对了，就是小真帮忙带来的那位神明。[l]\n多谢。多亏那个才搞明白呢？[l]\n我很感激哦。"],["それで、\nま、言いたくはないが内通者もいるくさい。[l]\n悠長に","所以、\n嘛，虽然不想说但恐怕有内鬼。[l]\n已经没空"],["脚","慢悠悠"],["本通りに演じてる場合じゃ無い訳さ。","按剧本演戏了啊。"],["ともあれこうやってキミに全てを話してる理由はね、\n要するにキミの完成を済ませて、\nとっとと戦力になって貰おうということ。","总之像这样把一切告诉你的理由是呢，\n说白了就是要完成你的调试，\n让你赶紧成为战力这回事。"],["私が出張ると、あっと言う間に終わっちゃって、\n面白くもなんともないから」","要是我亲自出马的话，转眼间就会结束，\n既没意思又很无聊啦」"],["ゲームとしてね。","作为游戏来说的话。"],["そう言った宮……宮さんの","这么说着的宫……宫小姐的"],["貌は、[l]\n今までのあのひとと、\nなんら変わりない、\nあの笑顔なのに、","那张脸，[l]\n和迄今为止的那个人，\n没有丝毫改变，\n依然是那副笑容，"],["「その気があるなら、\nそのコと認証式すませて？","「要是有意向的话，\n就和那孩子完成认证仪式吧？"],["そのコ──麒麟緋は装備品として支給してあげるから。[l]\nうひひ、まこくんママのお下がりだからね？","那孩子──麒麟绯会作为装备配发给你的。[l]\n嘻嘻，这可是小真妈妈传下来的旧物哦？"],["後はあの、Ig:TYPE･MEGA-D「P+」をもってして、[l]\nアナタは晴れて『魔眼の刺し手』、\n我等の最終兵器、\nしかも今回は──」","另外再配上那个Ig:TYPE･MEGA-D「P+」的话，[l]\n你就能正式成为『魔眼杀手』，\n我们的最终兵器，\n而且这次──」"],["「戦力って……いわれ……ても……」","「成为战力……这种事……就算你这么说……」"],["「んむ？[l]\n大分冷静になったかな？[l]\nうひひ、流石だね。","「嗯唔？[l]\n看来冷静不少了呢？[l]\n嘻嘻，真不愧是呢。"],["だって、まこくんは小学校にあがるまえに、\n既に此処で、\n玄ノ森という箱庭で、","毕竟小真在上小学之前，\n就已经在这里，\n在这个叫玄之森的盆景世界里，"],["すっかり調律済み、","被彻底调试完毕了，"],["なんだからね」","就是这么回事啦」"],["魔眼の刺し手として。","作为魔眼杀手。"],["「９の発見を契機に劇は幕を開ける事になってた。[l]\nそう、Kaleido……かれおが来たあの日からさ。[l]\nちなみにそうしろって言ったのはイーハだよ？","「以9号的发现为契机，戏剧就此拉开帷幕。[l]\n没错，从Kaleido……卡蕾欧到来的那天起。[l]\n顺带一提下达指令的是伊哈哦？"],["あ、あとね、かれおと言えば。[l]\n喜んでよ、\nまこくんのお友達のあの、大神氏？","啊、还有啊，说到卡蕾欧。[l]\n该高兴才对，\n小真的朋友那位，大神先生？"],["彼もね、\nまだ完全に決まった訳じゃないけども、\nまこくんの雫のチカラも鑑みて、\nその確率は高そうだね。","他呀，\n虽然还没完全确定，\n但考虑到小真的水滴之力，\n这个可能性相当高呢。"],["ま、そうだとしても今回は舞台に上がらないで貰う予定だけど。[l]\n彼も、」","嘛，即便如此这次也没打算让他登台就是了。[l]\n他也是，」"],["私やキミと同じだ。","和我及你相同的存在。"],["「好かったじゃん、\nともだちも同類でさ。[l]\nこれが原因で縁切る可能性も少ないだろうし。","「这不是挺好的嘛，\n朋友也是同类。[l]\n这样就不太可能因此绝交了吧。"],["少なくとも生理的嫌悪感で受け付けないとか、\n気持ち悪がられて関係解消、にはならないんじゃない？[l]\n彼に自覚があればだけどね」","至少不会因为生理性厌恶而无法接受，\n或是被觉得恶心而断绝关系，[l]\n当然前提是他要有自觉呢」"],["大神が……？！","大神也……？！"],["彼奴まで、","连那家伙都，"],["うそ、だ、","骗人的吧，"],["え、『何かが視える』っていうのは、","诶，『能看见某些东西』的意思是，"],["──魔眼質者","──魔眼质者"],["「遅くなったけど、軽ぅく紹介がてら。[l]\nこの通りこちらのサクラは損傷を受けたから四重奏団──\nああ、この娘等ね。[l]\n狩猟専門のチーム。","「虽然迟了些，就简单介绍下吧。[l]\n如你所见这边的樱因为受损所以四重奏团──\n啊，就是这群姑娘啦。[l]\n专门负责狩猎的团队。"],["バックアップにはちょっと心許なくなったけど、\nキリアケあれば大丈夫でしょお。","虽然作为后备军有点靠不住，\n但有麒麟绯在就没问题啦。"],["あっちの娘はEnder……みみみって言ってね、[l]\nアナタとは別の、雌雄問わずなれる『魔眼の刺し手』。","那边那个是Ender……叫咪咪咪的，[l]\n和你不同，是雌雄皆可的『魔眼杀手』。"],["Igもタイプが違っててね……って、[l]\nまあそれは後で良いでしょ。[l]\nささっと去就を決めてくれれば、\n残りのメンバーの紹介込みで色々説明したげる」","Ig的类型也不一样呢……不过，[l]\n嘛那个待会再说也行。[l]\n只要快点决定去留，\n我会连同剩余成员的介绍给你详细说明的」"],["「ま、まって、さっきその、\nそう、か、かあ、さんも」","「等、等等，刚才那个，\n对，妈、妈妈也是」"],["「そりゃそう。[l]\nキリアケとは凄い相性が良かったよ。[l]\n祖母様は苦手とか言ってたけど私とはいいオトモダチ。[l]\nそういやその祖母様は？」","「那是当然。[l]\n和雾明配合得超默契呢。[l]\n虽然她说不太擅长和祖母相处但和我可是好搭档。[l]\n话说那位祖母大人呢？」"],["「……親父殿と待機してます」","「……正在和父亲大人待命」"],["「ふうん」","「哼嗯」"],["だれも、みんな、","没有人，大家，"],["「んむ？[l]\nああ、まこくん。取り敢えず、[l]\n今はまだ逃げてもいいけど疲れるだけだよ。[l]\nこのハコニワは、」","「嗯唔？[l]\n啊，小真。总之，[l]\n现在逃跑也行但只会白费力气哦。[l]\n这个箱庭啊，」"],["まこくんが生まれるずっと前からその為に仕込まれた舞台なんだし。","早在小真出生前就为此刻精心布置好了舞台。"],["「調整維持の連中はちゃんと動いてるね？[l]\nじゃ、\n何処にいたってつかまえてあげる。","「调整维护的那些人确实在运作吧？[l]\n那就，\n无论躲到哪里都会抓住你。"],["今度は待たせたりしないよ、\n絶対に放っておかないから。[l]\n嬉しいでしょお？","这次不会再让你等待，\n绝对不会放着你不管。[l]\n很开心对吧～？"],["──実際の所、\n私はアナタが結構気に入ってるから、\nイーハが表に出てこなくても構わないんだ、け、ど。[l]\nそのためには──」","──其实呢，\n我挺中意你的，\n就算伊哈不现身也无所谓，但、是。[l]\n为此必须──」"],["「……え？[l]\nイーハ……？[l]\nぼくとは……」","「……诶？[l]\n伊哈……？[l]\n和我……」"],["ぼくのなかにべつの？","我体内有别的？"],["そんなはず、","不可能，"],["──ない","──没有"],["ちがう、ごかいだ、ぼくはぼくだ──","不对、搞错了、我就是我──"],["「実際のところ、\nアナタが私達と手を斬ろうが斬るまいが、\n否、アナタの主観でそう思おうが思うまいが、\nあんまり関係ないんだよねぇ。","「实际上，\n无论你是否选择与我们断绝关系，\n不，无论你主观上是否这么认为，\n都没太大关系呢。"],["内的な意味しか無いとは言え、\n選択権を与えられてるだけ、\nまだ好かれてると思って欲しいんだけどさ」","虽说只有内在意义，\n不过是给你选择权，\n还是希望你觉得被偏爱着呢」"],["敬意を払ってる、と言ってもいいよ。","说是表达敬意也可以哦。"],["と口元に指をあてて彼女は言った──","她将手指抵在唇边说道──"],["「アナタの事はキライじゃないよ。[l]\nだけど、\n全部を認めてあげたり、\nキミの我を通させようと思う程には、","「我并不讨厌你哦。[l]\n只不过，\n还没到全盘接纳，\n或者纵容你任性妄为的程度，"],["んー、\n……ま、その先はあんまり聞きたくないでしょ？","嗯～，\n……嘛，后面的大概不想听了吧？"],["でもま、そうだな、\nアナタのそういう自我（Ego）が邪魔になるようなら、\nばっさり引導渡してあげるけどね。[l]\n実際もうね、そろそろ飽きちゃった部分もあるんだ」","不过嘛，这样吧，\n要是你这种自我（Ego）碍事的话，\n我会干脆利落地超度你哦。[l]\n说实话已经啊，有些部分开始腻了呢」"],["はい……？","哎……？"],["………、[l]\nあきた……ってなに？","………，[l]\n腻了……什么意思？"],["──なにいってる？[l]\n何言ってる？[l]\n何を言った？[l]\n何て言ったよ？","──在说什么？[l]\n说什么？[l]\n说了什么？[l]\n说了什么啊？"],["「……、……」",""],["「……」",""],["「全部じゃないけどね。[l]\nそんなにショック受けなくても。","「虽然不是全部啦。[l]\n不用那么受打击。"],["飽きたったって、あんまり額面通り受け取らないで。[l]\nそういうのは察するのが●だよ？[l]\nま、それはいい。","别说‘腻了’这种话，别太当真啦。[l]\n这种事要靠●来体会的懂吗？[l]\n嘛，这倒无所谓。"],["さあ、\nまこくん、\nアナタには採り得る２つの選択肢があります」","好了，\n小真，\n你现在有两个可选方案」"],["は……？","哈……？"],["なんの、","什么、"],["「基本的に私達が必要としてるのは、\nキミの中のイーハだ。[l]\nキミじゃない」","「基本上我们需要的是，\n你体内的伊哈。[l]\n不是你本人」"],["「………ちょ、っとまって、」","「………等、等一下，」"],["ぼくはぼくだよ、みやさん、\nぼくいがいのなにかとぼくじゃない──","我就是我啊，宫小姐，\n除了我之外的东西都不是我──"],["──ミルハは●●されている","──米尔哈正在●●"],["はなしをきいてくれ、でも、コエが。","听我说完啊，可是，声音。"],["こえがでないよ──","发不出声音啊──"],["「でも、\n私個人は、今言った通り、\nアナタが結構気に入ってるから、","「不过，\n就我个人而言，正如刚才所说，\n我还挺中意你的，"],["イーハが表に出てこなくても、\nまこくん自身が動いてくれるならそれで構わない。","就算伊哈不现身，\n只要小真本人愿意行动也行。"],["但し、その場合は、勿論だけども、\nキミに劇を遂行して貰う。[l]\nつまり、」","当然这种情况下，\n需要你来完成戏剧。[l]\n也就是说，」"],["\n\n\n\n\n\n\nまこくんが八相を殲滅して、\nキミでキミ自身の身体を取り戻せ。","\n\n\n\n\n\n\n由小真歼灭八相，\n用你这具身体找回你自己。"],["「それが厭なら、\nペイルホワイトの──ああ、チノのＣＡＴだよ、\nそれによる強制改宗を発動する。","「若不愿意，\n就启动佩尔怀特──啊对，是千乃的CAT，\n进行强制改宗。"],["そして強制的にイーハを単独起動してゲームを続行して貰う。[l]\n恐らくだけれども、その場合、キミ……まこくんという、[l]\n飯窪真言という自我（Ego）は消えるだろう。","然后强制单独启动伊哈继续游戏。[l]\n恐怕到那时，你……小真这个，[l]\n饭洼真言的自我（Ego）就会消失。"],["イーハ自身にしか分からない事だが、\n恐らくキミはイーハの仮想記憶領域だろうからね。","虽然只有伊哈本人才清楚，\n但你大概只是伊哈的虚拟记忆领域吧。"],["キミというかイーハは特殊過ぎて、実のところ、\nちゃんと仕込みが利いてるかどうかは私達にも分からないんだ。","该说是你还是伊哈呢，特殊性超标了，实际上\n我们也不确定预设程序是否生效。"],["でもま、表層的には少なくともこちらの意図通りに走ってるから、\n８割９割方そうだろうな。","不过表面看来至少是按我们意图运作的，\n八九不离十吧。"],["さて、\nどっちがいい？[l]\nどっちを選んでも、\n劇は続行されるという点に於いては不動だけどね」","那么，\n选哪个？[l]\n无论选哪边，\n戏剧都会继续推进这点不会改变」"],["「……っ、[l]\n……ぁっ、[l]\n…………っ、」","「……呃，[l]\n……啊，[l]\n…………呃，」"],["あたまがまっしろで、\nなにもことばにならない、\nただただくろいこころが、\nくろい、こころが、","大脑一片空白，\n什么话都说不出来，\n只有漆黑的心，\n漆黑的，心，"],["「ま、冬夏さん達と面と向かって敵対したくないなら、\nイーハの単独起動を選ぶもありだよ。","「嘛，要是不想和冬夏她们正面为敌，\n选择单独启动伊哈也行。"],["もしそっちを選んだとしたら、\n私にとっても、んむー、残念だけどね？","如果选那条路，\n对我来说，嗯──虽然有点遗憾？"],["その代わり、仲良くなった彼女等と闘うというコトに対しての、\n責任回避はできるよ。[l]\nただし恐らく永久に、だ」","但能回避掉\n和那些交好姑娘们战斗的责任。[l]\n不过恐怕是永久性的」"],["「………、」",""],["なにもいえないまま、","发不出任何声音，"],["ぼくはふるえてふらつくからだをひきずるようにして、","我拖着颤抖踉跄的身体，"],["へやから、","从房间，"],["\nにげた","\n逃走了"],["\nでていった","\n离开了"],["\nうしろからおうものはいなかったけど","\n虽然背后没有追兵"],["\nこえが","\n声音"],["「まあ、今はそうするしかないか。[l]\nキミは。[l]\n祭までには帰って来なよ？[l]\n出来れば自主的に、でないと──」","「嘛、现在也只能这样了。[l]\n你呢。[l]\n祭典前要回来哦？[l]\n最好主动回来，不然──」"],["それはまえにきいたよ","这话之前听过啦"],["\nそれはだれかといっしょだ、","\n是和某人一起说的，"],["\nそれは、まえにきいた……","\n这话、之前听过……"],["\nだれかといっしょだ……","\n是和某人一起说的……"],["「説明はまだ足りないけど、\n戻って来たら続きをしよう、\n待ってますよ？[l]\nまこくん」","「虽然解释还不够充分，\n等回来再继续说吧，\n我会等着哦？[l]\n小真」"],["\nもどるって、","\n说什么回来，"],["まってるって、","说什么等着，"],["\nせっかくあえたのに、","\n明明好不容易才见到，"],["せっかく話せたのに、","明明好不容易能说上话，"],["\nいや、ぼくのおもいこみ──","\n不、是我的错觉──"],["\nいったいどこにつっこんでいいのか、","\n完全不知道该从何吐槽，"],["わからないこの状況、","搞不懂这状况，"],["\n──気をしっかりもて","\n──给我振作点"],["\nでもひとつわかるのは、","\n但有一点很清楚，"],["\nぼくは、","\n我现在，"],["いま、","又懊恼，"],["くやしくておこっていてつらくてなさけなくて、","又生气又难受又窝囊，"],["\nはやくそらがみたい、","\n好想快点见到空，"],["\nこんなのってあるか、","\n哪有这样的，"],["\nだってこれは、","\n因为这可是，"],["\nぼくはみてるんだもの、","\n我亲眼所见啊，"],["\nうたがいようもないほどのきっと、","\n毋庸置疑的，"],["\nじじつなんだ、","\n这就是事实，"],["\nほんとうのことなんだ、","\n是真实发生的，"],["\n──そう、だから、だからこそ。","\n──没错，所以、正因如此。"],["\nぼくらはきっとおなじもの──","\n我们肯定是同类──"]],"context":[["SC_M_052.ks/index/1/text"],["SC_M_052.ks/index/3/text"],["SC_M_052.ks/index/5/text"],["SC_M_052.ks/index/7/text"],["SC_M_052.ks/index/9/text"],["SC_M_052.ks/index/11/text"],["SC_M_052.ks/index/13/text"],["SC_M_052.ks/index/15/text"],["SC_M_052.ks/index/17/text"],["SC_M_052.ks/index/19/text"],["SC_M_052.ks/index/21/text"],["SC_M_052.ks/index/23/text"],["SC_M_052.ks/index/25/text"],["SC_M_052.ks/index/27/text"],["SC_M_052.ks/index/29/text"],["SC_M_052.ks/index/31/text","SC_M_052.ks/index/476/text"],["SC_M_052.ks/index/33/text"],["SC_M_052.ks/index/35/text"],["SC_M_052.ks/index/37/text"],["SC_M_052.ks/index/39/text"],["SC_M_052.ks/index/41/text"],["SC_M_052.ks/index/43/text"],["SC_M_052.ks/index/45/text"],["SC_M_052.ks/index/47/text"],["SC_M_052.ks/index/49/text"],["SC_M_052.ks/index/51/text"],["SC_M_052.ks/index/53/text"],["SC_M_052.ks/index/55/text"],["SC_M_052.ks/index/57/text"],["SC_M_052.ks/index/59/text"],["SC_M_052.ks/index/61/text"],["SC_M_052.ks/index/63/text"],["SC_M_052.ks/index/65/text"],["SC_M_052.ks/index/67/text"],["SC_M_052.ks/index/70/text"],["SC_M_052.ks/index/72/text"],["SC_M_052.ks/index/74/text"],["SC_M_052.ks/index/76/text"],["SC_M_052.ks/index/78/text"],["SC_M_052.ks/index/80/text"],["SC_M_052.ks/index/82/text"],["SC_M_052.ks/index/84/text"],["SC_M_052.ks/index/86/text","SC_M_052.ks/index/100/text"],["SC_M_052.ks/index/88/text"],["SC_M_052.ks/index/90/text"],["SC_M_052.ks/index/92/text"],["SC_M_052.ks/index/94/text"],["SC_M_052.ks/index/96/text"],["SC_M_052.ks/index/98/text"],["SC_M_052.ks/index/102/text"],["SC_M_052.ks/index/104/text"],["SC_M_052.ks/index/106/text"],["SC_M_052.ks/index/108/text"],["SC_M_052.ks/index/110/text"],["SC_M_052.ks/index/112/text"],["SC_M_052.ks/index/114/text"],["SC_M_052.ks/index/116/text"],["SC_M_052.ks/index/118/text"],["SC_M_052.ks/index/120/text"],["SC_M_052.ks/index/122/text"],["SC_M_052.ks/index/124/text"],["SC_M_052.ks/index/126/text"],["SC_M_052.ks/index/128/text"],["SC_M_052.ks/index/130/text"],["SC_M_052.ks/index/132/text"],["SC_M_052.ks/index/134/text"],["SC_M_052.ks/index/136/text"],["SC_M_052.ks/index/138/text"],["SC_M_052.ks/index/140/text"],["SC_M_052.ks/index/142/text"],["SC_M_052.ks/index/144/text"],["SC_M_052.ks/index/146/text"],["SC_M_052.ks/index/148/text"],["SC_M_052.ks/index/150/text"],["SC_M_052.ks/index/152/text"],["SC_M_052.ks/index/154/text"],["SC_M_052.ks/index/156/text"],["SC_M_052.ks/index/158/text"],["SC_M_052.ks/index/160/text"],["SC_M_052.ks/index/162/text"],["SC_M_052.ks/index/164/text"],["SC_M_052.ks/index/166/text"],["SC_M_052.ks/index/168/text"],["SC_M_052.ks/index/170/text"],["SC_M_052.ks/index/172/text"],["SC_M_052.ks/index/174/text"],["SC_M_052.ks/index/176/text"],["SC_M_052.ks/index/178/text"],["SC_M_052.ks/index/180/text"],["SC_M_052.ks/index/182/text"],["SC_M_052.ks/index/184/text"],["SC_M_052.ks/index/186/text"],["SC_M_052.ks/index/188/text"],["SC_M_052.ks/index/190/text"],["SC_M_052.ks/index/192/text"],["SC_M_052.ks/index/194/text"],["SC_M_052.ks/index/196/text"],["SC_M_052.ks/index/198/text"],["SC_M_052.ks/index/200/text"],["SC_M_052.ks/index/202/text"],["SC_M_052.ks/index/204/text"],["SC_M_052.ks/index/206/text"],["SC_M_052.ks/index/208/text"],["SC_M_052.ks/index/210/text"],["SC_M_052.ks/index/212/text"],["SC_M_052.ks/index/214/text"],["SC_M_052