[{"start":12743,"end":12753}],[{"start":12783,"end":12858}],[{"start":12887,"end":12926}],[{"start":12956,"end":12993}],[{"start":13050,"end":13113}],[{"start":13143,"end":13150}],[{"start":13207,"end":13349}],[{"start":13381,"end":13395}],[{"start":13425,"end":13453}],[{"start":13482,"end":13595}],[{"start":13625,"end":13643}],[{"start":13672,"end":13825}],[{"start":13855,"end":13864}],[{"start":13893,"end":13939}],[{"start":13969,"end":13976}],[{"start":14005,"end":14094}],[{"start":14126,"end":14134}],[{"start":14164,"end":14191}],[{"start":14248,"end":14274}],[{"start":14304,"end":14377}],[{"start":14406,"end":14484}],[{"start":14514,"end":14601}],[{"start":14630,"end":14671}],[{"start":14701,"end":14736}],[{"start":14793,"end":14873}],[{"start":14903,"end":14910}],[{"start":14939,"end":15088}],[{"start":15120,"end":15137}],[{"start":15167,"end":15176}],[{"start":15205,"end":15215}],[{"start":15245,"end":15293}],[{"start":15322,"end":15339}],[{"start":15369,"end":15403}],[{"start":15466,"end":15471}],[{"start":15545,"end":15578}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_070.ks","basename":"SC_M_070.ks","indexIds":{"「……はっ、[l]はっ、[l]はっ、[l]\n兄ぃ、[l]どこよ、[l]\nすっごい感じてるの私、[l]\nいる、[l]ぜったいいる、[l]\n近くにきてる、[l]\nきてる、[l]すぐそこまできてるのに、」":0,"どくん。":1,"「どこっ、[l]\nどこよぅ、[l]\nばか兄ぃ……っ、[l]\nさ、叫んじゃ、まずいし……」":2,"「もう……っ、[l]\n居るなら居るではやく──」":3,"どがさっ、":4,"「っ？！」":5,"「……貴女、カリヤの者ね？」":6,"「……？[l]\nはっ、あ、あの、みりあ──」":7,"「丁度……良かったわ。[l]\nこの子、トウカを安全な所に……[l]\n地下に独り置いて行くのは憚られて……ね……」":8,"「え？[l]\nと、[l]冬夏ちゃ……、[l]冬夏ちゃっ？！」":9,"「……センリ……タマズサの者が裏切ったわ。[l]\nこの期に及んで何のつもりかは知りませんが……[l]\nこの子は不正操作されていたの」":10,"「た、[l]たま……えっ？？！！[l]\nな、[l]どうして、[l]\nまさかさっきのアレも──」":11,"「詳しくは分かりません。[l]\nただ、クイの者も、\nこの子……トウカと同様の有様と聞きました。[l]\nキサムラドウトモは……ミカタですが、[l]\n残りの者は──どうしているのか」":12,"「え、[l]え、[l]あの、[l]私は──」":13,"「……分かっています。[l]\n貴女は私と同じですもの。[l]\nだからこそこの子を預けられるのよ」":14,"「あ、[l]え、[l]あのっ」":15,"「ベロアが今、センリを追っています。[l]\nただ、先程の襲撃者も居る中、\nベロアだけを行かせるわけには行かない、\nマスターたる私が共にあらねばなりません。[l]\n沢山の大事なもの、\nひとつだけ選ぶことなど出来ません、\n特に私はそうあってはならない、\nですから──」":16,"「あ、[l]あう……」":17,"「この子を頼みます」":18,"「……は、[l]はいっ」":19,"「良い子ね……」":20,"「あ、[l]あのっ」":21,"「……何かしら？」":22,"「お、[l]お気をつけてっ、\n──の祝福のっ、」":23,"「？」":24,"「あらんことを……あ、[l]あれ？[l]\nいえ、[l]にゃ、[l]な、[l]なんでもないですっ」":25,"「……ふふ、ありがとう。[l]\n２人とも息災にね」":26,"「……行っちゃった……[l]\nはっ」":27,"「ど、[l]どうしよう──」":28,"「………」":29,"「…と、[l]冬夏ちゃ……？」":30,"「…………」":31,"「冬夏ちゃ！？[l]\n冬夏ちゃっ、大丈夫っ？！！」":32,"「──ぁ、[l]……ぁ[l]ぁ[l]ぁ[l]……」":33,"「えっ、えっ？！[l]\n大丈夫っ？！[l]\n冬夏ちゃっしっ、確りしてっ、\nどど、どうしよう、どうしたら──」":34,"どく。":35,"みゅーーーーーーーーーーーーん":36,"「──」":37,"「……」":38,"「──狩屋？[l]\nそれに、冬夏、か？[l]\n会えて良かった、\nどうした、なにかあったの──」":39,"「──あ、兄ぃ？[l]\n兄ぃなの？[l]\nその声、兄ぃね？！」":40,"「あ、ああ、\nそうか、\n──そう、\n僕だ」":41,"「ほ、ほんとにみ、みつけたっ！！！[l]\n兄ぃ、いたんだやっぱりっ、[l]\nきーちゃの言った通りだしっ、[l]\nばかっ、馬鹿兄ぃったらもう、[l]\n何してたのよーーーっ、[l]\nってあれ、」":42,"「……ま……さ……」":43,"「それ以前になっ、なにそのかっこ……[l]\nって、あっ？！[l]\nとっ、冬夏ちゃ、あっ、えあっ、\nそ、そうだ、きーちゃも、\nえええええと、あっ兄ぃっ」":44,"「お、落ち着けって、\n今降りるから……状況を聞かせてくれ、[l]\nこっちも説明したい事がある」":45,"「……克杖、やっと真言さんと、[l]\n会えた、みたい……[l]\nでも……」":46,"ざわざわざわざわ………":47,"「アレは何処に……行った？[l]\n":48,"私":49,"達が……":50,"的じゃない……[l]の？」":51,"ざわざわ……":52,"「……。[l]\n早く始末しなきゃ……[l]\n気持ち……悪い……し……」":53,"ざわ──":54,"「………っ、げほぅ、がはぁっ、[l]\nき、[l]気持ち悪、[l]おぐっ、\n………。[l]\n……え……？[l]\nあら、[l]\n……な、[l]何が……[l]あったん、[l]やろか……[l]\n全然……[l]覚えとらんわ……」":55,"……全体を統合するのに大事なのは、":56,"「っ？[l]\nだ、…………」":57,"俺のそれが六相、つまり食すに特化しているのと同様に、[l]\n　　オマエのあれは神経系統に特化している。[l]\n　　故に、":58,"「──まずはてめェのをクえば、\nいいってこったな？[l]\n西部五相の玉梓選律、[l]で、[l]\n合ってるよな？」":59,"かふぁ。":60,"「……ひっ！！！[l]\nあ、あっ？！！[l]\nだ、[l]あ、[l]ひ、[l]えっ、[l]\n──な、[l]\nな、無いっ、\nカミさんがっ」":61,"「──？[l]\n抵抗しねえッてカ、\n縛る必要も……無ェならそン方がいいサ、[l]\n他の連中は近くにゃいねェしぃ、ダ」":62,"ざ、":63,"「あ、あかん……っ、[l]\nな、なんでなん……、[l]\nどこ、どこにっ」":64,"「腰が抜けたか、\n覚悟決めたか、\nどっちでもいいけどヨゥ、」":65,"ざ。":66,"「ああああああ、ううああ──」":67,"「前ン時みてェに肝心のカミィ喰い残さねェように、\n丸ごといくにゃぁ大人しくされてた方が、\n具合いいかンな、\n……多分コイツも不味ィだろがしょーがねェ」":68,"あーーーーーーーーーん。":69,"「ひ、ひ、ひくっ、」":70,"ばく。":71,"「冬夏の事もあるし、\nかなり":72,"端":73,"折ったけど、\n大体はそんなとこ……ああ、[l]\nそっちの状況は何となく解ったけど」":74,"「……ご、ごめん、[l]\n焦ってる所為か全然頭に入ってこにゃいけど、\nその、あの、\nなんていったらいいのか、\nと、とにかく、えー、」":75,"「……うん、[l]\n今は分かんなくていい、\n後で必ず、ゆっくり説明する、\nお前にも、冬夏にも、\n……みんなにさ。[l]\nそれに」":76,"「…？」":77,"「ほれ、お前には借りがあるし、\n冬夏にはまだ、してない":78,"返":79,"事があるから」":80,"「あ、兄ぃ……」":81,"「あのな、\n……必ずまた会おうって言ってるんだよ、[l]\nこういう事を言うとだな、\n死亡フラグに聞こえっかも知んないけど」":82,"「し、しぼうふらぐ？」":83,"「……ふふ……っ、……」":84,"「と、冬夏ちゃ、笑っ…？[l]\nえっ？」":85,"「あはは……[l]\nそう言えば、そういう話もしたっけ……[l]\n知らないなら狩屋にも、後で教えるよ」":86,"「……そ、そんな事より……[l]\nと、」":87,"「……そうだ、冬夏、[l]\n遅くなったけどこれ、覚えてる？」":88,"「……るおぉ……」":89,"「うん、シロだよ。[l]\n冬夏と……きぃの御陰で、[l]\nぼくらのともだちはめざめた」":90,"「……き……ぃ……」":91,"「──彼奴も、多分、[l]……いや、[l]\nきぃのことはきっと僕が何とかする」":92,"「……？」":93,"「それと──言えなかった返事は、\n先刻言った通りだ。[l]\n帰ってから必ずする」":94,"「………兄ぃ……」":95,"「……うぅ、あぁ」":96,"「まだ、無理するな。[l]\nゆっくり休んで回復させてくれ、\n狩屋、悪いが頼む。[l]\n……この分の借りも加算してくれて構わない、[l]\nそれもまとめて、\n必ず返す、から」":97,"「…なっ、[l]\nそんなことっ……」":98,"「……冬夏と一緒に、[l]\n下で、２人とも、\n無事に在ってくれ」":99,"「はっ？！」":100,"「この場所はよくない場所になる。[l]\n此処での祭儀は──[l]もう、[l]\nまともには執行されないだろう。[l]\nCATastrophe（破局）は招かれた。[l]\nだから……[l]\nあのひとに遭う前に、\nこの場から去れ」":101,"「あ、あのひと？[l]\nって誰よ、ねえ、\n誰に会っちゃいけないって、」":102,"「知る必要はないよ、\n知らない方が……良い事もある……[l]\n知ると、知った途端に、[l]──破局する、[l]\n………そういうモノは、[l]ある」":103,"「……ど、どうしたの？[l]\n２人とも……[l]\nてかそんな事言われても」":104,"「あ、もし大神……って名乗る男と会ったら、[l]\n其奴は味方だから。[l]\n其奴には頼ってもいい」":105,"「え、ど、どのひとにしても、\n顔も知らないのにどうしろって」":106,"「……まあ、要するに誰にも会わなきゃ問題ない、[l]\n何とかして此処から離れてくれさえすればいい。[l]\n出来るなら玄ノ森からも、出た方が良いかな……[l]\n一応、\nなるべく、そこまで事態が":107,"拗れる前に、[l]\n──僕が何とかする、[l]つもりだけど」":108,"「……う、あうう、[l]\nあううううううう」":109,"「何にも出来なくてすまん、[l]\n":110,"……じゃ、何とかしに行ってくるから」":111,"「わ、わっかんないよぅ！[l]\nわっかんないってばぁっ」":112,"「──。[l]\n雫は滴り落ちて波紋を呼ぶ、\n僕は……、[l]\n何かを巻き起こすその中心だが、[l]\n起きる事象の禍か福か、[l]\nそれも誰にとってのそれなのか、[l]\n……そういうのは意思の外、[l]\n僕は単なる──[l]触媒だ」":113,"「な、なにいってるんだか……ほんとに……」":114,"「僕が僕で在る事で、\n事は動いてるのかも知れないけど、\nフラグはばんばん立ててるのかも知れないけど、[l]\n僕は僕として、[l]\n生きてくだけだよ。[l]\nなるようにしかならないのなら、\nせめて後悔のないように──[l]\nまあ、なんでもいいや。[l]\n冬夏の事、\nほんとに頼んだぞ。[l]\nお前自身も気をつけて」":115,"「……何よ、きーちゃといい兄ぃといい……」":116,"「勝手に分かったような事独りで言って、\n自分だけで納得してないでよばか！[l]\nういは、[l]\n……なんでいっつも、[l]\n……蚊帳の外なのさ？！[l]\n冬夏ちゃとも２人で通じる世界があって、[l]\nう、[l]わ、」":117,"「……馬鹿たれ」":118,"「な、[l]なにょ──」":119,"「あのな、──」":120,"「──、──」":121,"「……満足したか」":122,"「……はっ？！[l]\n":123,"なっ？！[l]\nばっ！！」":124,"「わかったらさっさと動けばか！[l]\nお前の台詞じゃないけどな！[l]\nほら行けっ」":125,"「あっ、\nま、まこ、兄ぃ！！！」":126,"「ういは、[l]\nきーちゃから、[l]\n助けになれって、[l]\n言われて来たんだから！[l]\nう、[l]ういが限解したげるっ！[l]\nな、なんかしにいくんでしょーが！！！[l]\nういが強くしたげるっての！」":127,"「ああ……それくらいは自分でも──」":128,"「お、温存しとけっての！[l]\nきーちゃの為にも兄ぃには万全で行ってもらわにゃ、\nこ、こっちが困るっ！！」":129,"「で、でも、\nお前だってそうそう何度も──」":130,"「馬鹿にすんな！[l]\nういだって──なひとのためにしたいことだってあるっ！！」":131,"「ふーっ、[l]ふーっ、[l]……ひくっ、[l]ふーっ……」":132,"「こっちは何とかするからっ！[l]\nきーちゃ、きーちゃのことっ、\nお願いっ！！！」":133,"「………つぇ……」":134,"おぁああああああああああああああああああん。":135,"「げっ、限解マル、ミャ？」":136,"「……おう」":137,"「有効時間……其方の任意、ミャ？」":138,"「……ごほ、[l]\nじゃ、行ってこいっ！[l]\n冬夏ちゃのことは心配すんな！！」":139,"「……２人とも、[l]\nほんとうに、ありがとう。[l]\nあのひとに会う前に……会えて良かった。[l]\n狩屋、色々悪かったな。[l]\nお前はほんとに良いやつだと思う。[l]\nだから──[l]\n冬夏、妬かなくていいから、\nコイツとも仲良くしてやって」":140,"「……とさん……」":141,"「僕等はきっと仲良くやれるよ、\n末永く、３人とも、お互いに」":142,"「……とう、かちゃ……とも？」":143,"「時間がもう無い。[l]\n行くよ。[l]\nそして、\n必ずこの劇は終わらせる。[l]\nじゃあ、」":144,"後でまた。":145,"「……な、[l]なんか……兄ぃって……」":146,"「…………つえ……」":147,"「……ぇっ、いや、[l]\nお、[l]怒らな──じゃない、\nだ、[l]だいぶ良くなった？！[l]\n意識はっきりしてきたんじゃ？」":148,"「もう……そろ…ろ……自分……で……[l]\n立て……るわ……でも……」":149,"「あ、ああああ、無理しにゃいで、\nういがちゃんとおぶってくからっ」":150,"「……ふふ…[l]…んか……[l]あ…た…[l]なら……[l]\nいい…[l]…ンケイ…[l]…なれ…[l]…もね……」":151,"「え、えっ？」":152,"「おも…ぇば……[l]い…まで……[l]\nちゃんと…[l]…なしたこと……[l]な……ったし……[l]\nあんがい…[l]…わずぎ…いだ……[l]のかな……[l]\n……りで…[l]…もい……こんで…[l]…ただけ……[l]\nなの……[l]かな……[l]\n":153,"ごめん……[l]なさい……」":154,"「ば、な、なんで謝るのっ、\nういはにゃんにもっ」":155,"「……れもが……[l]自分の意思……通り…とは……[l]\nかぎらな……くっ、[l]て、……[l]\nのぞまないの……に……[l]シュに囚われて……[l]\n……たしだけが…[l]…と…[l]…もってた……」":156,"「……う、[l]あ、[l]あの……」":157,"「……れなのに……[l]報いを……[l]受けるな……んて……[l]\nあま……[l]りにも……[l]だったね……[l]\nあのこ……[l]も……………[l]…うだったの……かな、[l]\n……し……[l]きら……[l]たのも……[l]\n……るして…[l]…げよ…[l]…かな……」":158,"「……あうう……」":159,"「遅く…[l]…いなら……[l]かつえ…[l]…なたと……[l]\nいまからでも……」":160,"「……うん？」":161,"「おなじ……[l]まことさん……を……として……[l]\n…も…ちに……[l]なって……[l]くれる……？[l]\nいえ……[l]なって……[l]ください……[l]\n":162,"……だめ……？」":163,"「……と、冬夏ちゃ、[l]\nういはその、あの」":164,"「……ふふ…[l]…イバル……のが……[l]いい？」":165,"「……えぁっ、[l]\nえ、ええっ？[l]\nはいっ？！[l]\nライバルってなんですかっ？！[l]\nええ、ええええと」":166,"「……くさなく……っても……[l]\nワか……し……[l]怒ら……[l]ない……[l]し……[l]\n素直に…[l]…っていいの……[l]よ？」":167,"「うっ、うううう～～～、\n………、[l]\n………、[l]\n………、[l]\nや、その件は置いといて！[l]\nま、まずはお友達からっ……」":168,"「……ふ……ふふ……[l]\nありがと……[l]\nよか……った……」":169,"「……な、なんかあっつくなってきた……[l]\nふ、ふぅうう～」":170,"「……ょうふやくるし……を忘れる……には……[l]\nわら……うか……[l]おこ……るか……[l]\nせ……いよく……[l]が……[l]やくに……」":171,"「……はぃ？」":172,"「……ども……つくって……[l]のこす……っていう、[l]\n…いじな……こと……[l]が、[l]\n…んとしても…きのびる…って……[l]いう意思への……[l]\nだから……たしたちも…[l]…こしは……そういう……[l]\n……いことを支えに……[l]しても……[l]\n":173,"罰はあたら……[l]ないよね……」":174,"「え、ええええ、」":175,"「……………………」":176,"「……？[l]\n冬夏ちゃ？[l]\n冬夏ちゃ？！[l]\n冬夏ちゃっ！！！」":177,"「……すーー………[l]すー……」":178,"「……つ、疲れたのかな……[l]\nは、早く何とかしなきゃっ」":179,"とくん……":180,"「兄ぃ……[l]\nきーちゃ……絶対、……無事でいてよ……」":181},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_070.ks","relPath":"/data/scenario/SC_M_070.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":173,"length":182,"percent":95.05494505494505},"cellInfo":[],"cacheResetOnChange":{},"lastSelectedCell":[7,0]},"/data/scenario/SC_M_071.ks":{"data":[["「……」",""],["ざぁ…………っ………","哗…………………"],["びゅお………おぅ……","咻………呜……"],["ひぃーーーー………","噫————………"],["「……ふっ」","「……哼」"],["じゃじゃじゃじゃじゃりっ！","嚓嚓嚓嚓嚓嚓！"],["「……やっと来た」","「……终于来了」"],["しゅるるるるるるるっ","咻噜噜噜噜噜噜"],["「……何してたの」","「……在干嘛」"],["「ああン？[l]\nてめェに教える義理ァねェだろ。[l]\nそれにまるでこっちを待ってたみてェな物言いじゃねェかよ」","「哈啊？[l]\n老子可没义务告诉你。[l]\n而且你这口气听着像在等老子似的」"],["「……待ってたし、探してた」","「……在等，也在找你」"],["「んだと？」","「啥？」"],["「邪魔者は早急に、排除しなきゃいけないから」","「碍事的家伙必须尽快清除」"],["「はァん」","「哈啊」"],["じゃっ。","嚓。"],["「……おまえが、[l]\n母様達を●●たんでしょ」","「……就是你、[l]\n把妈妈她们●●了吧」"],["「………。[l]\nだから？[l]\nてめェの口からそういう事が言えンのかよ。[l]\n俺を責められンのかよ？」","「………。[l]\n所以？[l]\n从你嘴里说出这种话合适吗。[l]\n你有资格指责老子？」"],["「……おまえは……あのひとと同じ感じがするくせに……[l]\n私達と同じ感じがするくせに……[l]\nどこかが全然違う……[l]\nなんなんだおまえ、\nそれが、そこが●●●●い──」","「……你这家伙……明明和那个人感觉很像……[l]\n明明和我们感觉很像……[l]\n却有哪里完全不同……[l]\n你到底是什么东西，\n那个、那里●●●●──」"],["「あ？[l]\n何つった？[l]\nまーいいやさ。[l]\nこちとら動くたんびに腹ァ減るからよぅ、\nとっととおッぱじめるか、\n","「啊？[l]\n说啥呢？[l]\n嘛~无所谓啦。[l]\n咱家每次活动都会饿肚子啊，\n赶紧开始干活吧，\n"],["お","哦"],["食","进"],["事","餐"],["会をさ」","会咯」"],["「……今まで他のみんなの所に居たんじゃないの……？」","「……之前不是待在其他人那里吗……？」"],["「そのつもりだったけどな。[l]\nまずは独り、ピンポイントで狙った奴が居たが、\nそしたらそいつァ、手ぶらでいやがった。[l]\nこの祭ァ人もカミも揃うってェから来たのによ、\n何で持ってネェんだッ！[l]\nま、俺だってな、\n不味いもんは好き好んでクイたくはねェ、\nがたがた震えて使いモンになんなくなってたから、\n放ってきたが──」","「本来是这么打算的。[l]\n最初想单独锁定某个目标下手，\n结果那家伙居然空着手就来了。[l]\n明明听说这次祭典人和神都会齐聚才来的，\n为啥没带贡品啊！」[l]\n嘛，就算是老子，\n也不会乐意吃难以下咽的奎食，\n那家伙吓得直哆嗦根本没法用，\n就放生了──」"],["「……誰のこと……？」","「……说的是谁……？」"],["「ミにもならねェモノ喰ってももたれるだけだかンな。[l]\n危うくあン時と同じ、無駄骨折るとこだったぜ」","「吃了没营养的东西只会闹肚子。\"[l]\n差点又像那次一样白费力气了」"],["「……あの時と、同じ……？[l]\n無駄骨……？」","「……和那时候、一样……？[l]\n白费力气……？」"],["「つーわけでだ、\nそいつのカミ、\n誰が持ってったか、知ってたら言いな」","「所以说啊，\n那家伙的神器，\n要是知道被谁拿走了就老实交代」"],["「……おまえが知る意味、ない」","「……你没有知道的必要」"],["「あァ？[l]\n調子乗ンじゃねェぞ。[l]\n面倒手間さえ気にしなけりゃ、\n自力で必ず探し出すだけの話だぞこら。[l]\n腹減ると頭空転すっからな、\n最強苛ついたテンションでてめェなぶるってんだこっちは。[l]\nそれが厭ならとっとと言えってのさ。[l]\nま、\n……知らねェなら御愁傷様だわ。[l]\nてめェは──持ってるな？」","「哈？[l]\n别给脸不要脸。[l]\n只要不怕费事，\n老子自己迟早能找出来。[l]\n饿着肚子脑子转不动，\n现在可是暴躁到极点的状态来收拾你。[l]\n不想遭罪就赶紧吐出来。[l]\n嘛，\n……不知道的话就节哀顺变吧。[l]\n你──带着对吧？」"],["「………」",""],["「まァその","「嘛~看你这"],["態視りゃ聞くまでもねェわな。[l]\n知ってるのとは大分違ってるが、\nもし強くなってンなら俺にとっては好都合だわ。[l]\n大人しく、\n喰われ──」","德行也不用问了。[l]\n虽然和我知道的有点出入，\n要是变强了对老子倒是正好。[l]\n乖乖，\n被吃掉──」"],["「……るぃ……厭だ……」","「……不……不要……」"],["「？[l]\n震えてンのか」","「？[l]\n在发抖吗」"],["「おまえは……気持ち悪い……[l]\n気持ち悪いぞおまえ……[l]\n何でだ……？[l]\n何でこんなに……おまえが……[l]\n厭だ……おまえは厭だ……私はおまえが厭だ……[l]\nあのひとに……[l]\nまことさんに……まとわりつくな……！！！！」","「你……好恶心……[l]\n你好恶心啊……[l]\n为什么……？[l]\n为什么这么……你……[l]\n不要……我不要你……我不要你……[l]\n别靠近……[l]\n真言大人……别缠着他……！！！！」"],["「あ？」","「啊？」"],["ざっ！！","嚓！！"],["「…ッ！[l]\nはや、」","「…呃！[l]\n好快，」"],["ひぃーーーーーー……よぉーーーーー……","咿呀呀呀呀呀……呜哇哇哇哇……"],["「……●●してやる、●●して、●●して、──」","「……●●了你、●●你、●●你、──」"],["「……イヤな音立てやがる、[l]\nクソが、\nこの鎖つかうのも腹減るっつのに、\n余計な──おわっ！！！」","「……发出恶心的声音，[l]\n混蛋，\n用这锁链还会饿肚子，\n多此一举──哇啊！！！」"],["じゃっ！！","唰！！"],["「ひゅっ」","「咻」"],["「ってあっくっ」","「疼疼」"],["ざん！！","锵！！"],["「っんだコイツ、\n普通じゃねぇッ──って、あ？」","「这混蛋，\n不正常──咦？」"],["「ほぅっ」","「嚯」"],["じゃぐり、じゃばっ、","咔嚓，啪嗒，"],["「っ、っ、ッぶねぇっ」","「靠、靠、太扯了」"],["「ち、こないだのコイツがあってっ、\n良かったぜ、っ、ぐ、おおおおらああああ、\nあぁっ！！！！！！」","「妈、上次那家伙也在，\n太好了，呃、喔喔喔喔，\n啊啊啊啊！！！！！！」"],["ぶぅん！！！","嗡！！！"],["ざさっ、ばきばきばきばき……","沙沙、噼里啪啦噼里啪啦……"],["「くそが……[l]\nあの","「该死的……[l]\n那把"],["刃に触るのは避けてぇし、\n面倒くせェなぁもう！！[l]\nさァて、\nどこいきやがっ」","刀最好别碰，\n烦死了真是的！！[l]\n好了，\n往哪儿逃」"],["ぎぃぃいっぃぃいぃいぃいいいいいいん。","吱吱吱吱吱吱吱吱吱。"],["「？[l]\n？[l]\nあっ、\n上か！！」","「？[l]\n？[l]\n啊，\n上面！！」"],["「………あぁヤァメぇ……っ[l]\nい………ってぇ………っ」","「………啊啊住手……呃[l]\n疼………死了………呃」"],["「……に、にぎぎぎぎぎぎぎっぎぎぎ！！！！！！」","「……握、握握握握握握握握！！！！！！」"],["かふぁ。","哈呼。"],["「！[l]\nふっくっ」","「！[l]\n噗咳」"],["ひゅっ、","咻，"],["ざっ。","嚓。"],["「……ちっ、[l]\nいくらか削られたかっ」","「……切，[l]\n被削掉一点吗」"],["「……気持ち悪い、気持ち悪い、[l]\n気持ち悪い気持ち悪い気持ち悪いきもちわるい……っ」","「……恶心，恶心，[l]\n恶心恶心恶心恶心死了……呃」"],["「ああもう、こんなじゃどんどん腹減るわ……[l]\nてめェさえ、\nてめェさえ攻略すりゃ、\n他の連中なんざただの」","「啊啊烦死了，这样下去只会越来越饿……[l]\n只要干掉，\n只要干掉你，\n其他人根本不足为惧」"],["びゅ！！！","咻！！！"],["「っっっ！！！！？？？[l]\nきゃぁあああっ」","「呃呃呃！！！！？？？[l]\n呀啊啊啊」"],["どぉーーーーーーーーん………","咚———————………"],["「畜生……刺さらなかった……っ」","「畜生……刺不进去……呃」"],["「……ってェな……[l]\nいってええなああ、\n痛ってえええええええええだろおおおが\n！！！！！！！！！！！！」","「……说什么……[l]\n疼死了啊啊，\n疼死了啊啊啊啊啊\n！！！！！！！！！！！！」"],["ぶわ！","噗！"],["「…」",""],["「人が話してる時になんてことしやが」","「别人说话时搞什么鬼」"],["「関係ないし」","「关我屁事」"],["「……また──刺さらないし……」","「……又──刺不进去……」"],["しーーーーーーーーん………","嘶———————………"],["ざわざわざわ……","沙沙沙……"],["「………あ……[l]\nタマズサ……無くなってたら……[l]\n後処理どうするんだろう……」","「………啊……[l]\n塔玛祖莎……要是没了……[l]\n善后怎么办……」"],["「まあ……いいか……跡形もなく……[l]\nいえ……あのひととひとつになればそんなことすら」","「算了……无所谓……灰飞烟灭……[l]\n不……和那个人融为一体的话连这种事都」"],["ざわ……","沙沙……"],["「……はやく終わらせよう……[l]\nこんな茶番……面倒なだ……け……？」","「……快点结束吧……[l]\n这种闹剧……麻烦死了……吗……？」"],["ざわ、","嘈杂、"],["「……？[l]\n………、[l]\n……？[l]\nおまえ、おん──」","「……？[l]\n………、[l]\n……？[l]\n你这家伙，混──」"],["「……なにさ？[l]\n私、なにかおかしい？[l]\nそんなに、\nじっと視やがって、」","「……怎么啦？[l]\n我、哪里奇怪吗？[l]\n居然这么、\n死死盯着看，」"],["\n\n\n\n\n　　失礼なやつなのだわ。","\n\n\n\n\n　　真是个没礼貌的家伙呢。"],["「？！、[l]\n？！」",""],["しゅるるるるる、","咻噜噜噜噜、"],["ぎりりりりりりりりりりり……","咯吱吱吱吱吱吱吱吱吱……"],["「──こういうの、なんつったけな？[l]\n詰み？[l]\nチェックメイト？[l]\nいいかげん腹減りも度が過ぎてさ、\nよくわからないんだわ」","「──这种情况，该怎么说来着？[l]\n将死？[l]\nCheckmate？[l]\n饿过头反而、\n搞不清楚状况了呢」"],["「ぎ、ぎぎぎぐぐぐぐ」","「咯、咯咯咯咕咕咕」"],["「……まあどっちでもいいわさ。[l]\nこれで、もう、シマイだわなァ。[l]\nあん時の奴らのコレも、役に立つじゃんよ。[l]\nやられた時ゃムカっとしたが」","「……反正都无所谓啦。[l]\n这样就算是、完蛋了吧。[l]\n那时候那群家伙的这东西，不也挺管用嘛。[l]\n虽然被暗算时超火大的」"],["「ふんっ！！[l]\nふぅあっ、ぐうううううううううう、\nああああああああああ！！！！！！！！！！」","「哼！！[l]\n呼啊啊、咕呜呜呜呜呜呜呜呜、\n啊啊啊啊啊啊啊啊啊啊！！！！！！！！！！」"],["「さぁ、さっき喰い損ねてこちとら、\n相当オツムにキてンだよッ、\n覚悟はいいか、てめぇのその腕ごと、\nカミぁ貰うぜ。[l]\n運がよけりゃぁ、\n死なずに済むだろ、\n事が済む前でも後でも──抵抗しねえ","「喂，刚才没吃到的那份、\n现在可是让老子超级火大啊、\n做好觉悟吧，连你那胳膊一起、\n老子要全部收下了。[l]\n运气好的话、\n说不定能捡条命、\n事情结束前还是结束后──只要不反抗"],["場","的"],["合わぁ、\nだけどナ」","话、\n不过呢」"],["「ぎぎぎぎぎっぎぎぎ、あぐう、ああああぐうううううう！！[l]\nた、た、あああ、」","「咯咯咯咯咯吱咯吱，啊咕、啊啊啊咕呜呜呜呜呜！！[l]\n救、救、啊啊啊、」"],["「……もうこっちもつかれてっから……[l]\n余計な手間取らすナヨ。[l]\nにしたって、\n残りの連中も薄情なこった、ナア？」","「……咱也累了……[l]\n别给老子多添麻烦啊。[l]\n再说了、\n剩下那些家伙也够薄情的，对吧？」"],["かふ、","哈呼、"],["「ぁあアーーー」","「啊啊啊──」"],["「AAAhiiioooooppppprsssstt（はこたちきりすかしのくちなわ）！！！[l]\nミをすててこそうかぶせもあれそはいまぞ、\nじラドばくラドのとうやのに、[l]\nしき！！！！！！！！！！」","「AAAhiiioooooppppprsssstt（箱蛇切雾之口绳）！！！[l]\n弃身而覆者今在、\n虽为自爆同焚之祷、[l]\n式！！！！！！！！！！」"],["「──ァ？」","「──啊？」"],["ばぎん、","锵、"],["「ひぎっ！！！！！！！！！！」","「噫叽！！！！！！！！！！」"],["ばしゅあああああ………","啪唰啊啊啊………"],["「ナ…ンだと？[l]\nバ──、\nばかかてめェは、\nそんなに、」","「什…么鬼？[l]\n混──、\n开什么玩笑你这混蛋、\n居然这么、」"],["「！！！！、[l]\nっ！！！！、[l]\n………っっっ！！！！！！」","「！！！！、[l]\n呜！！！！、[l]\n………呃呃呃！！！！！！」"],["「……んなにイヤだってかよ」","「……就那么讨厌吗」"],["「……ぐうう………[l]う[l]う[l]う[l]う[l]う[l]う……」","「……咕呜呜………[l]呜[l]呜[l]呜[l]呜[l]呜[l]呜……」"],["「当て付けか？[l]\nどうせ今から、すぐ探してみっけるだけだぞ。[l]\nそんなことに、\nそこまでする意味ァ──」","「在挖苦我吗？[l]\n反正现在开始，马上就能找到的。[l]\n这种事情，\n做到这种地步的意义──」"],["「……まえは……ヤだ……[l]\n…ことさんの……っ！[l]\nぐううううううぎぎぎぎっ、\n……になんか……させっ、させっ、[l]\nるかぁっ！[l]\nさせないっ、\nあぐ、あぎ、いぎぎぎぎぎいぃぃーーーーっっ、\nひふ、ひ、ぃ、はっ、かはっ」","「……之前就……不要……[l]\n…真言君的……呜！[l]\n咕呜呜呜呜呜呃呃呃呃、\n……怎么能……让你、让你、[l]\n得逞啊！[l]\n不会让你得逞、\n呃咕、呃呃、咿呃呃呃呃呃咿咿咿咿──、\n嘻呼、嘻、咿、哈、咔哈」"],["「……関係ねェし」","「……关我屁事」"],["どしゃっ！","咚嚓！"],["「がっ──は」","「嘎──哈」"],["「……いいザマだわ」","「……活该」"],["「はーっ、はーっ、はーっ、\nいっ、ぐぅううううーーー」","「哈──、哈──、哈──、\n咿、咕呜呜呜呜──」"],["「てめェはもう用無しだ。[l]\nムかつくが嬲るヒマもねェし──\n運が良かったなァ、\n放置だてめェは。[l]\nじゃァな。[l]\n独り寂しくそこでクタバレ」","「你已经没用了。[l]\n虽然火大但也没空玩弄你──\n算你运气好、\n就丢着不管了。[l]\n再见。[l]\n一个人寂寞地在那儿烂掉吧」"],["「ふ、ひ、ぎぃっ──」","「呼、嘻、呃咿──」"],["じゃりっ。","沙啦。"],["「余計な悪足掻きしやがって……[l]\n飛んでったモノぉ探さにゃぁ……」","「净做些多余的挣扎……[l]\n得把飞走的东西找回来……」"],["「はっ、はっ、はっ、はっ、はっ、\n………ぐぐぐぐっ、ふー、ふー、[l]\nぎっ、ぎぎぎいいいい」","「哈、哈、哈、哈、哈、\n………咕咕咕咕、呼──、呼──、[l]\n呃、呃呃呃咿咿咿」"],["ざわざわざわ………","沙沙沙………"],["「……まっ、……と、さん、[l]\n……？」","「……真、……言、君、[l]\n……？」"],["ざわざわざわざわ………","嘈杂嘈杂嘈杂………"],["「まこと、さん？[l]\n……ぐううっ、[l]\nま、ことさんの……か……んじ……、[l]\nま、ことさん、まことさぁ、ん、」","「真言、君？[l]\n……咕呜呜、[l]\n真、言君的……感……觉……、[l]\n真、言君、真言君、嗯、」"],["ざわっ…","沙沙…"],["じゃりっ、","沙啦、"],["「…………ぐぅっ、」","「…………咕呜、」"],["「……これは──」","「……这是──」"],["「……まことさん………………？」","「……真言君………………？」"]],"context":[["SC_M_071.ks/index/1/text","SC_M_071.ks/index/5/text","SC_M_071.ks/index/9/text"],["SC_M_071.ks/index/3/text","SC_M_071.ks/index/256/text"],["SC_M_071.ks/index/7/text"],["SC_M_071.ks/index/11/text"],["SC_M_071.ks/index/13/text"],["SC_M_071.ks/index/15/text"],["SC_M_071.ks/index/17/text"],["SC_M_071.ks/index/19/text"],["SC_M_071.ks/index/21/text"],["SC_M_071.ks/index/23/text"],["SC_M_071.ks/index/25/text"],["SC_M_071.ks/index/27/text"],["SC_M_071.ks/index/29/text"],["SC_M_071.ks/index/31/text"],["SC_M_071.ks/index/33/text"],["SC_M_071.ks/index/35/text"],["SC_M_071.ks/index/37/text"],["SC_M_071.ks/index/39/text"],["SC_M_071.ks/index/41/text"],["SC_M_071.ks/index/44/text"],["SC_M_071.ks/index/46/text"],["SC_M_071.ks/index/48/text"],["SC_M_071.ks/index/50/text"],["SC_M_071.ks/index/52/text"],["SC_M_071.ks/index/54/text"],["SC_M_071.ks/index/56/text"],["SC_M_071.ks/index/58/text"],["SC_M_071.ks/index/60/text"],["SC_M_071.ks/index/62/text"],["SC_M_071.ks/index/64/text"],["SC_M_071.ks/index/66/text"],["SC_M_071.ks/index/68/text"],["SC_M_071.ks/index/70/text"],["SC_M_071.ks/index/72/text"],["SC_M_071.ks/index/74/text"],["SC_M_071.ks/index/76/text"],["SC_M_071.ks/index/78/text"],["SC_M_071.ks/index/80/text"],["SC_M_071.ks/index/82/text"],["SC_M_071.ks/index/84/text"],["SC_M_071.ks/index/86/text","SC_M_071.ks/index/100/text","SC_M_071.ks/index/120/text"],["SC_M_071.ks/index/88/text"],["SC_M_071.ks/index/90/text"],["SC_M_071.ks/index/92/text"],["SC_M_071.ks/index/94/text"],["SC_M_071.ks/index/96/text"],["SC_M_071.ks/index/98/text"],["SC_M_071.ks/index/102/text"],["SC_M_071.ks/index/104/text"],["SC_M_071.ks/index/106/text"],["SC_M