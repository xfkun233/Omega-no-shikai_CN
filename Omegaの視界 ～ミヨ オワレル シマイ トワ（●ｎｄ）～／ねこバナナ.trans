":13144}],[{"start":13175,"end":13210}],[{"start":13242,"end":13309}],[{"start":13340,"end":13349}],[{"start":13375,"end":13415}],[{"start":13447,"end":13508}],[{"start":13539,"end":13580}],[{"start":13612,"end":13628}],[{"start":13636,"end":13700}],[{"start":13731,"end":13774}],[{"start":13800,"end":13821}],[{"start":13830,"end":13863}],[{"start":13894,"end":13914}],[{"start":13946,"end":13974}],[{"start":14000,"end":14033}],[{"start":14041,"end":14044}],[{"start":14053,"end":14054}],[{"start":14063,"end":14069}],[{"start":14100,"end":14158}],[{"start":14184,"end":14193}],[{"start":14201,"end":14239}],[{"start":14271,"end":14315}],[{"start":14341,"end":14382}],[{"start":14413,"end":14441}],[{"start":14450,"end":14470}],[{"start":14496,"end":14506}],[{"start":14538,"end":14617}],[{"start":14648,"end":14652}],[{"start":14678,"end":14712}],[{"start":14720,"end":14754}],[{"start":14786,"end":14791}],[{"start":14822,"end":14835}],[{"start":14867,"end":14899}],[{"start":14930,"end":14936}],[{"start":14968,"end":14973}],[{"start":15004,"end":15034}],[{"start":15042,"end":15094}],[{"start":15120,"end":15126}],[{"start":15134,"end":15144}],[{"start":15176,"end":15189}],[{"start":15215,"end":15221}],[{"start":15229,"end":15242}],[{"start":15250,"end":15283}],[{"start":15291,"end":15306}],[{"start":15314,"end":15347}],[{"start":15355,"end":15424}],[{"start":15432,"end":15477}],[{"start":15485,"end":15516}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_037.ks","basename":"SC_M_037.ks","indexIds":{"冬夏が着替えてきて、\n朝食を":0,"摂りに一緒に食堂に向かった。":1,"流石の僕でも、あの、\n夕べの事を忘れた訳じゃないので、\n何というか変な空気になるかと危惧もしたけれど、\n女子ってのはそういうモノなのか、":2,"やけにあっけらかんとしてるというか、\nあんまり気にもしてない感じで振る舞うので、\nちょっとばかり拍子抜けした。":3,"返事は誕生日にくれっていう事で、\n気持ち的にケジメというか、\n切り替えしやすかったのかしら。":4,"或いは想像だけど、\n昨日はノリとかテンションで突っ走った部分も多分にあるだろうし、\n実際、無かった事にしたいのかも知れないね！":5,"と思ったので、\n取り敢えず僕からはあの話題には触れない事とする。":6,"「これってヴァイキング方式っていうんでしょ？[l]\nビュッフェ？だっけ？どっちでもいいけど。[l]\n何か楽しいね」":7,"「んー、そうだね。[l]\n此処は結構早い時間に開くからありがたいよ。":8,"まあ食事に関しては外食含めて、\n色々選択肢があるようだから……[l]\nお好きな方法で」":9,"「ん、これいい。[l]\nこれ楽しい。美味しいし」":10,"自分で何かする、\nというのに妙に愉しみを感じるらしいのは昨日の色々で分かったけど、\n流石にここでは僕の後をついて回りながらの手探り状態だった。":11,"選んだ物も結局、僕と同じだったし。[l]\nクロワッサン、牛乳、スクランブルエッグ、ウィンナー、サラダ等々、\n軽め洋食系で選択。":12,"僕も此処に宿泊してからあまり利用する機会が無かったので、\n楽しいと言えば楽しい。[l]\n旅行でそこそこ馴れてるので新鮮味は":13,"然":14,"程ないけど。":15,"「そうねえ、この牛乳とか確かにおいしいねえ。":16,"中央の方はモノは高いし、\n種類だけはいっぱいあるけどさ、\n実際おいしいと思えるのって実はそうそう\nないんだなあ」":17,"「ん。[l]\nそだよね。[l]\n母様はその辺解ってないけどね。[l]\nステータスとしてしか判断してない。":18,"だからきぃとかと食べに行くと、\nすごい楽しいんだ。[l]\n食べるってこう、根源的ていうの？[l]\n生きるのに基本的なものじゃない？」":19,"「うん」":20,"言いながら、\nそうだ、道具さんからの言伝が……と思い出す。[l]\nでも取り敢えずは食べつつ、\n冬夏の話題の途切れるのを窺う。":21,"「動物だろうと植物だろうと、\n相手の生命を取り込むって事だからさ。[l]\n虚飾にかまけて":22,"疎かにしちゃいけないと\n思うの私。":23,"んー、\n余裕があるって事なのかも知れないけど、\n生きるのに必要なコト以外を食事に見出すのって、\n私、きらい」":24,"ま、勿論局所的な場面での個人的意見ね、\nと苦笑しながらまとめた。":25,"重くなりかけた空気をどうにかしようとしたのだろうが、\n共感する部分もあったので僕はただ感心していただけで、\nうーん、と頷くだけの":26,"為":27,"体。":28,"というか、話す事がある、\nというのを憶えていようと集中してた所為もある。":29,"「あはは……ヴァイキング楽しいって言ったばっかで[l]\n言えた台詞かって話」":30,"「うーん、うー、そうねえ……」":31,"リアクション薄すぎたか、と自省して、":32,"「まあ、僕等は基本屍体食べてる訳だしね、\nテレビとかで肉とか食材を視て美味しそうって言ったりさ、\n看板とかで食材の動物自身に「おいしいよ！」とか言わせてるの視ると、[l]\n違和感を感じることはあるよ僕も。":33,"ま、近代になってからかもだけど、\nヒトは生き物を殺して食べるんだという事実をさ、\nそういうのをタブー視というか、\n穢れとして日常から意識的に排除してしまったから、":34,"うん、それで、\n":35,"有":36,"難":37,"味も薄れてしまったという副作用も──」":38,"突如饒舌気味にレスする僕。[l]\nと、":39,"「良くある番組でさ、\nライオンの親子にスポット当てるか、\nインパラの親子にスポット当てるかだよね。":40,"お腹すかせたライオンの子供に注目させてるときはさ、\n獲物狩れないのが悲劇みたいに演出するけど」":41,"「インパラクローズアップしてる時は、\n狩られる事が悲劇になるわなあ」":42,"「で、毎度毎度、\n大自然の厳しい掟、とか言うんだナレーションが。[l]\nどっちにしてもちょっとえっ？！とかツッコミたくなるんだけど。":43,"両方フラットに映してくれないとさ、\nどっちにもどっちの事情ってのがあるわけじゃない結局。[l]\n食べるほうも食べられるほうも、絶対何かしら食べてるんだし」":44,"「あはは……[l]\n植物をどう位置付けるかだよねえ。":45,"この手の話題は、\n":46,"敷":47,"衍すると家畜は種の存続形式としてどうかとか、\nその辺は色々あるん……だそうだけど。":48,"まあ結局、\n食材として動物を捉えるのも、或る意味では自然なわけだし、\nそういう場合、美味しそうって感想も変だとは言えず、\nなんだろう……":49,"って、朝飯食べながらどんな会話してるんだ僕等は」":50,"「あっはははは！[l]\nごめんなさーい。":51,"昨日のドライブの時もそうだけど、\nあんまりいないのねこういう話についてきてくれる人。[l]\n……克杖とかは話せば通じるだろうけど、[l]\n機会無いし、友好度そんなに高くないから。":52,"というかあの":53,"娘は──ん、いいや。[l]\nきぃとはね、その、違う方向の話ばっかりするし」":54,"ん、つい今し方まで、\n僕は何かを言おうとしてたんではなかったか。":55,"……あれ？":56,"拙い、忘れました……[l]\n毎度の事ながらこう自分の脳が恨めしい……":57,"何だっけ？[l]\n結構大事な内容だったよな。[l]\nレスに集中しすぎて飛んでしもうたよ……":58,"「普通はこんな事考えて生活してないんだよね。[l]\n考えずに済むならそれはそれで羨ましいけど、\n私、変かな？変なのかな」":59,"「まあ、年頃的に考えて、\n他の人だって実はそんなもんじゃない？":60,"自分以外がそう視えるのも多分、あれだ、\n皆も他人と会ってるときくらい軽薄に発散したいんだよきっと。[l]\nみんな内には色々秘めてるんじゃないかねえ……」":61,"冬夏へのフォローに徹することで、\nほぼ言おうとしてた事は思考の":62,"埒":63,"外に置かれました。":64,"メモリも不足してりゃー演算能力、\n果ては記憶装置までもアレなスペックの僕としましては、\n事項の複数同時処理などオーバーワークも好い所でね……":65,"「あはははっ、なーんかお年寄りみたいだよー。[l]\nやっぱ枯れてるよねー。":66,"ん、\nそこが、\nいいの。[l]\nたははははは……けほっ、けほけほ」":67,"「あわわわだいじょぶかいな。[l]\nさす……ったほうがいい？」":68,"「だっ……けふっ、んっ、[l]\nだいじょぶ。[l]\nけほけほ。":69,"ん、んんっ。[l]\nだいじょぶ。だいじょぶです。[l]\n……あっ、やっぱりさすって貰えば良かったー。[l]\nちっ」":70,"「変なとこで人のこと笑うからだよ……[l]\n人のこと笑うからだよ変なとこで」":71,"「あはは何で順番変えて繰り返すのー。[l]\n………」":72,"……？":73,"何故かそこで黙る冬夏。":74,"「……ん、ごめん。[l]\nなんかごめん」":75,"「え？[l]\n何に？[l]\n年寄り臭いのは認めてるし別に問題はないす」":76,"「いい。[l]\nそういうとこ含めてさ、\nなんかね。まだちょっと混乱してるね私。[l]\n抑えが効かない感じ」":77,"「あ、ああそうすか。[l]\nまあゆっくりお食べなさい。[l]\n遅刻しない程度に」":78,"やっぱ意識してない訳では……ないんだな。[l]\nただ僕も、\n──こういう反応しかできないけど……":79,"「うん……[l]\n真言さん、\n今社会人なんだよね？」":80,"「え、ああ、そう……だよ。[l]\n大学は辞めましたので！」":81,"「私も一緒に仕事したい。[l]\n……此処には居たくないよ。":82,"卒業したら、………[l]\n──まことさんと一緒がいい。[l]\n何でもするから。":83,"宮さまが上司なら私も大丈夫そうだし。[l]\n必要なら勉強もする、資格も取る」":84,"う、":85,"夕べの件が無ければ、\n単なるいつもの":86,"揶いの類と思えるのだが、\n今やどこまで本気なのか、":87,"「まじです。この上なく本気」":88,"……言い方のノリに何かギャップを感じるが、[l]\n照れ隠しだろうかなあ。":89,"「……な、なるほど。[l]\nそうは言っても、\nそもそも僕等の仕事ってのは……":90,"ややや、\nそれよりも、ほらこの家出だっていつまでも──」":91,"思い出した。[l]\nそうだ。":92,"これ幸いにと話題転換を試みる。":93,"「ああ、そう言えば、\n道具さんって人、知ってる……んだよね？[l]\nその人から、":94,"言":95,"伝が」":96,"「道具さん？トモさんから？」":97,"実際は『独り言を聞いてました』、と言う建前だが、\nここでそれを言っても詮無いというかややこしいだけなので、\n素直に伝える事にした。":98,"何で僕と彼女が知り合いになってるのかという点については、\n幸いにも冬夏はスルーしてくれたので、\n嘘吐いたりとか面倒な事はせずに済んだ。":99,"それとも知らない内に説明してたんだったか？[l]\n……それこそ思い出せないが、[l]\n思い出した所で詮無い事なので早々にその道は放棄します。":100,"「ええと、\n早く帰って安心させなさいって、\n事が大きくなると狩屋と姫様ちゃんが──」":101,"と言った所で、":102,"冬夏の表情が一気に険悪になった。[l]\n場の空気が一瞬凍り付く──":103,"「ん。[l]\nまあ、その件は、まあ。[l]\nこちらの問題」":104,"ま、まあ、前にキライって明言してたし、\nあの二人がそういう役割というのも既知の事実なんだろうから、\n別段不思議ではないか……[l]\nそれとも単に、この家出を咎められたからかも。":105,"しかし、\n":106,"白":107,"地に機嫌は悪くなったのは確かだ。[l]\n眼は据わってしまいこちらを向いてもくれない。":108,"と言うより、\nそんな顔を視られたくない、\nといった風情だけど、あくまで僕の主観であるから……":109,"おっと、まだ道具さんの言葉があったのだった。":110,"「あ、ああそれともう一つ、\nきぃが体調崩してるから、\nお見舞いに是非来てくれれば同道するとか……":111,"ちなみに僕は駄目だってさ。[l]\n理由は深く追求しなかったけど、\nまあ色んな事情があると察して遠慮する事にしたので、\nもし行くんだったら僕の分も──」":112,"そこで何かを振り切るようにというか、":113,"宮さんが僕を嬲る時と同じ眼でこちらを視詰めると、":114,"「あはは。[l]\nそっか、きぃのお見舞いね。[l]\nそっちはまあ……考えても良いかな。":115,"連絡しづらいっていうか、\n実はもう繋がらなくなってたから心配だったんだ。[l]\nあのこの場合、止められてる場合があるからさ。[l]\n真言さんの分も宜しく伝えとくー」":116,"「ああ、たのんます。[l]\nあれだ、差し入れ、\n代金渡すから適当に買って持ってってくれる？」":117,"体調不良とは言え、\nいや、だからこそ大量に喰うかも知れんしな……":118,"「ん。わかったー。[l]\nでも帰ってから実費請求しまーす」":119,"「そう？[l]\nまあ今日の内に行くのかどうかは知らんけど、\nそだな、アンパンと牛乳でも買ってってやってよ。[l]\nんでは気をつけて──」":120,"道具さんに宜しく、と言おうとして一応止めておく。[l]\n折角の詳細追求スルー状態、\n藪蛇になってもしょうがないし……":121,"「じゃトモさんに電話しとこ。[l]\nん？[l]\nうん、今日中に行ければと思って。[l]\nだから帰りちょっと遅くなるかもねー」":122,"「何かあったら連絡くれれば、\n可能な範囲で対応するからそうしてよ。[l]\nじゃあそろそろ学……」":123,"校へ、と言おうとすると、\n冬夏が視る間にニヤけ出し、":124,"「ん、ありがとー。[l]\nあははっ」":125,"なに？[l]\n何の笑いですか？":126,"「ごちそうさまでした。[l]\nあっ、もう時間やば！」":127,"「え？[l]\nそんな焦る程？[l]\nああ、準備が」":128,"「そ、色々あるのです。[l]\nほんとは見送りまでして欲しいけど、\n我慢するからね。[l]\nと言うわけでここで」":129,"「あいあい分かりました。[l]\n月並みな挨拶で申し訳ないけど、\n気をつけていってらっさい」":130,"「はーい」":131,"席を立つも、\n何故か考え込むように止まる冬夏。[l]\nなぞした？":132,"「………んー、[l]\nやっぱりフェアに行かないとね、\n宮さまに宜しくっ！[l]\nじゃ、行ってきまーす」":133,"「は？[l]\nあ、ああ冬夏」":134,"「えぁっ、な、なに？」":135,"「食器はセルフで片すシステムだから、\n僕がやっとくよ、学校遅れないようになさい！」":136,"「あっあっ、\nあうー、\nありがとー。[l]\nじゃまたね」":137,"そして彼女は学校へ行き、\n昨日からのドタバタに":138,"漸く、\n一段落がついたのだった。":139,"念のため":140,"視":141,"回したが、\n宮さんもチノ嬢も、今朝は現れなかった。":142,"……ふーん、あ、そうですか……":143,"今日も好い天気だ。":144,"冬夏を視送った後で部屋に戻ると、\n食後も食後、血が胃に行きまくりですっかり眠くなってしまった。[l]\n夕べは寝床が変わったしなあ。":145,"如何に旅行慣れしてようと、\n今の部屋が２週間そこらしか滞在してなかろうと、\n……否、そうじゃないか。[l]\nあの状態では眠りも浅くなろうものだっての。":146,"そう、":147,"昨夜のコクハクは、":148,"何というか、":149,"あまりに突飛ではあったけど、\n出逢ってからの距離感が、既に変に近すぎてたというか、\nいや、太腿との密着から始まったからという訳でも……":150,"た、多少はあるかもだが、\nその、兎に角、\nああ、うん、と妙に納得してる部分とか、\n変に冷静に対処してる部分とか、":151,"それもあるんだけど、\n……なんかブレーキが掛かる。":152,"そこは、まあ、宮さんの所為だと思うけど……[l]\n変に警戒心強くなってるというか？[l]\nべ、別にあのひとに遠慮してる訳ではない筈だ！":153,"大体あのひとぁ、":154,"………。":155,"「そこで何で思い淀む？[l]\n……おもいよどむ？[l]\nそんな言葉あったっけかな……」":156,"えー、":157,"……何考えてたっけ？":158,"「まあいいや、\n取り敢えず……今日は休めって話だし、[l]\n寝直そうかなあ。[l]\n脳も盛大に空転してるし……」":159,"うーん、でも掃除の人とか来ちゃうかな。":160,"とか考えながら、\n座布団を枕に、目を":161,"瞑りつつ思索に":162,"耽る。":163,"そうだなあ……":164,"冬夏との記憶がもし想像通り……、[l]\nそうだ、\nどうにも最近、夢やら何やら、\n白昼夢的に漏れ出てくるかのようなあの情景、":165,"あの場に居た……のは誰だ？":166,"あと宮さん……実年齢がもし……だとすれば、[l]\nあながち無い話でもないけれど、\n希望的観測、というより願望としては、\nそれはなしであって欲しいけどなあ。":167,"「いかん、何か気になる、が、同時にわけわからん」":168,"仕事も折良く休みを言い渡されてるし、\nちょっと出かけて色々視回ってみるか。":169,"わけわからんは訳分からんなりに、\nついでに何かその、\n訳が分かればそれはそれで宮さんへの手土産になるもの、\nかも知れないし、":170,"がたがたがたがたがたがたがたがた！":171,"「おわ！！」":172,"テーブルに置いてた携帯電話が派手に振動して大変驚いた。":173,"電話？[l]\n誰？":174,"また道具さん……じゃないな。[l]\nこれは──":175,"「狩屋じゃんよ。[l]\n何で？」":176,"祭の件に関して伝言でも頼まれたか？":177,"「あい」":178,"「あの」":179,"「あああ、あれ？[l]\n姫様ちゃん？[l]\nどどどどどうなさった？」":180,"「おはようございます」":181,"「お、はようございぁす……[l]\nな、なんでございましょうか」":182,"狩屋と勘違いした反動か、無意味に敬語で":183,"畏まる僕。":184,"「夕べは話し中でしたので。[l]\n御陰でまんじりともせず朝を迎えてしまいました」":185,"「え？[l]\nあ。[l]\nああ、道具さんから電話来てた時かな……[l]\nご、ごめん、結構かけ直したのかな……？[l]\nあれ？[l]\nそんなに長話してたっけかなあ……」":186,"「ごめんなさい、冗句です。[l]\n一度話し中を確認してからは昨日は疲れもありましたので、\nやることやってからしっかりと寝ました」":187,"……冗句……[l]\nいや、それもだが、\nやることやってって、なんですか。":188,"宿題？[l]\n歯磨き？[l]\nまさか……、[l]\n丑時参とか？":189,"んなこたないか……":190,"「え……秘密……です」":191,"な、何も言ってないよ僕は？！[l]\n若干間があいただけですよ？！":192,"「ああそう……あははは……[l]\nと言うか、これ狩屋の電話だよね？[l]\n最初驚いちゃってさ。[l]\n借りてるってこと？」":193,"「そうです。[l]\n横にいますよ」":194,"「なるほど、よ、よろしくお伝えください」":195,"て、あれ？[l]\n今はだから、もう学校行く時間でしょう。[l]\n先刻冬夏が登校したばかり……":196,"「今登校途中です」":197,"……もしかして、[l]\n冬夏に関する事だろうか。[l]\n道具さんの言葉が頭をよぎる。":198,"実力行使て……？":199,"「夕べのうちに連絡が取れていれば今日放課後にでも、\nお話の約束をと思ったのですが、\nそういう事情だったので……":200,"仕方なくこのような時間に連絡してしまいました。[l]\nすみません。[l]\nでもどうしても……会えるのなら早くが良くて」":201,"ああー……、[l]\nあの話か。":202,"あの時は違うと思ったけども、\n昨夜の冬夏の事を考えると、どうにもその、\nまさかそっち方面のじゃないだろうな？[l]\nという疑念が再燃……":203,"道具さんが昨日、\n":204,"矢":205,"鱈と彼女達と契るのがどうとかいう話題振ってきてたし、よもや本気で──":206,"いやいや、それこそそんな……":207,"……うーん。":208,"冬夏と姫様ちゃん、と……まあ狩屋が、[l]\nどんな対立構造になるかなぞ、恐ろしくて想像したくない。":209,"万が一の時は狩屋にヘルプ頼むか……[l]\nそれもどうだろうなあ、\nうん、単なる僕の自意識過剰である事を祈ろう。[l]\nそれで済むならなんぼでも妄想したる！":210,"ともあれ情報収集に重きを置いて、\nまずは実際話してみないことにはどうにもならない。":211,"幸か不幸か、\n今日の放課後は冬夏もきぃの見舞いに行くかも知れないし、\n会うならこのタイミング、という気はするが……":212,"冬夏とバッティングすると色んな意味でややこしくなりそうだしなあ。[l]\n……なんかそういう事ばっかり考えてると、[l]\nほんとに二股企んでる気分になってくるけど断じて違います。":213,"ただ昨日の今日なので、\n若干思考がそっち方向に流されやすくなってるだけですよ？":214,"あー、まあ、\n実際はそれどころじゃない企みをしてる訳だが、\nそれもこれも宮さんが、あのひとさえ──":215,"「…さん。[l]\n真言さん。[l]\n電話切れました？」":216,"「──っといや、ごめん大丈夫。[l]\nええとじゃあこちらは今日の放課後でも大丈夫だけど……[l]\n半ドンだよね今日？」":217,"「はんどん……？」":218,"あれ、姫様ちゃんは知らないか。[l]\nやっぱ冬夏がアナクロ気味なんだな。":219,"「あ、ごめん、学校が午前で終わるって事。[l]\n昼過ぎくらいからなら、そんなに遅くならずに用事も済むだろうし……」":220,"「……早めに終わらせたいですか。[l]\nあんまり一緒には居られないと──」":221,"「え？[l]\nあ、いや、":222,"そんな深刻に受け取られてもその、\n単に一般論と言いますか、\n女子と男子が遅くまでうろうろしてますと色々と問題が」":223,"「……半分冗句ですから気に病まないでください。[l]\nでは場所なんですけれど」":224,"………。[l]\n姫様ちゃんてこんな":225,"娘だっけ？[l]\nうぅ、そ、そう言えばそうだったような……":226,"「あの、先日の場所覚えてますでしょうか」":227,"「昨日の……あの山の中？[l]\n斎場みたいな？」":228,"それって車ないと行けないだろうし、\n何より危険じゃないか？":229,"しかし":230,"其":231,"処だと言う。":232,"「大丈夫です。[l]\n車は克杖の家から借りられますし……[l]\n私達が揃っていれば危険はありません」":233,"き、きーちゃぁ！？":234,"という声が電話先から聞こえた。[l]\n聞いてなかった話のようだな……":235,"「そ、そうは言われても……[l]\nあれ、そういえば二人きりでって話だったような」":236,"待てよ、だったらわざわざ狩屋の居る横で話す事はないよな。[l]\nつまり……":237,"「あ……[l]\nすみません、\nあの、この":238,"娘も同道させて頂けません……でしょうか」":239,"そうなる……よねえ。":240,"「えーとそれはまあ、姫様ちゃんからのお誘いだった訳だし、\n姫様ちゃんさえ良ければ……あとはその狩屋本人が構わなければ[l]\nこっちは多分……」":241,"「克杖」":242,"うにっ！？[l]\nにゃんというかその……はい……いきます……":243,"というまあ、\nいつもの感じで彼奴の声がうっすら聞こえてきた。":244,"「………」":245,"「こちらは問題ありません」":246,"「だ、だいじょうぶ？[l]\n無理せず都合の良い時に──」":247,"「………あ」":248,"「……？」":249,"「すみません、\n確定までもう少しだけお待ちください。":250,"また連絡します。[l]\n今日中に電話します。[l]\nごめんなさい。[l]\nでは」":251,"は？きーち、":252,"まで聞こえていたが、":253,"「へ？[l]\nあ」":254,"……切れた。":255,"なんじゃったんじゃい？？？":256,"ふと待ち受け画面になった携帯電話を視ると、\n今の時刻が……":257,"ああ、遅刻しそうだったのかな。":258,"僕の記憶が確かなら、\nそろそろ学校始まる時間だったと思う。":259,"確か授業中は携帯電話、先生に預けてて繋がらないとか、\nきぃも言ってたような気がするし、\nいずれ暫くの間は繋がらないだろう。":260,"向こうから連絡寄越すって言ってたし、\n予定通り今日は海岸うろついてみようかねえ……":261,"きぃも何でもなきゃいいが。[l]\n……色んな意味で──":262},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_037.ks","relPath":"/data/scenario/SC_M_037.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":259,"length":263,"percent":98.47908745247148},"cellInfo":[null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[7,1]},"/data/scenario/SC_M_038.ks":{"data":[["結局、今朝は宮さんともチノ嬢とも出会えなかった。[l]\n……いや、出会わなかった。[l]\n何か前者だと期待してたふうじゃん、まったくもう、\n僕も焼きが回ったのう。","结果今早既没遇到宫小姐也没见到千乃小姐。[l]\n……不、是故意没去见。[l]\n怎么说得像在期待前者似的、真是的，\n我也老糊涂了啊。"],["ただ実際、話あるって言ってた癖に、\nそれは後回しにされて一向にお呼びが掛からないのは\n何かなあ。","不过实际上、明明说了有事要谈，\n却一直拖延着完全不联系我\n到底怎么回事啊。"],["一向にってだから、\nそんなに待たされたという程の時間も経ってないし、\nそれって何かすっかり待ち侘びてるふうじゃん、まったくもう、","压根儿就没动静所以说、\n其实也没等那么长时间、\n那副样子完全就是等得不耐烦了吧，真是的、"],["……ほんとどうかしてるのか僕は。[l]\nなんだなんだなんだ、\n──なんだこの感じ。","……我脑子绝对有问题。[l]\n搞啥搞啥搞啥，\n──这莫名感觉是咋回事。"],["一晩寝ればどうにかなると思ったのに、","明明以为睡一觉就能好的，"],["何か後引いてるな。","怎么反而更纠结了。"],["「やめやめ、\nなんだって僕が──」","「打住打住，\n凭啥要我——」"],["………。",""],["「とっとと出掛けようっと……」","「赶紧出门算了……」"],["冬夏は放課後きぃんとこに行くかも知れないので、\n朝言ったように仮に連絡来るとしても夜とかだろうが、\n姫様ちゃんからの連絡が午後一だったりしてもあれだし。[l]\nちっと早めに動いてみよう。","冬夏放学后可能会去小贵那儿，\n就算按早上说的有联络估计也得等到晚上，\n但要是姫様下午一上班就发消息也挺那啥的。[l]\n还是提前行动吧。"],["何かおかしな思考傾向になってるし、\nどうも落ち着かない。[l]\n独りで黙ってると……なんかどうも、……なんだろうな。","总觉得思考模式变得好奇怪，\n完全静不下心。[l]\n一个人闷着就会……莫名觉得……该怎么说呢。"],["「んーーーーーーーーー、\nしったことかっつーーーの！！[l]\nなんつって！！[l]\nうら！！！」","「嗯——————，\n关我屁事啦————！！[l]\n开玩笑的！！[l]\n呜哇！！！」"],["一気に立ち上がると、\n準備をすることにした。","猛地站起身，\n决定开始准备。"],["まずは知狡さんに言って車借りよう。[l]\n昨日と違ってレンタカー使うべき事情は無いし。","先找知狡阿姨借车吧。[l]\n今天又没昨天那种必须租车的特殊情况。"],["「あ、知狡さん、おはようございます」","「啊，知狡阿姨早上好」"],["「……あ、ああ、おはよう。[l]\n昨日は御苦労だったな。[l]\nん、今日は休みとか、宮さんも言っていたと思ったが……」","「……啊、啊啊，早。[l]\n昨天辛苦你了。[l]\n嗯，今天应该是休息日吧，宫小姐也这么说过……」"],["「あー、そうですそうです。[l]\nなのでちょっと個人的な用事で出回ってこようと思いまして、\n車を少々ですね……」","「啊对的对的。[l]\n所以想办点私事出门转转，\n能借下车吗……」"],["「そうか、\n気をつけろよ？","「这样啊，\n小心点？"],["午後からは連休前で高校生が沢山居るだろうし、\nああ、そうだ、ついでに言っておくが、\n……火曜日か。","下午开始连休前高中生会很多，\n啊对了顺带一提，\n……周二来着。"],["１８日も高校は休みなんだ。開校記念日でな。[l]\n今年は３連休にならなかったようだが、\nそれでも年度初めで浮かれた連中も出る頃だし、","18号高中也放假。是建校纪念日。[l]\n今年虽然没凑成三连休，\n但毕竟是开学季会有很多兴奋的家伙，"],["運転にしろ何にしろ、\nこちらが気をつけるんだぞ。[l]\nそれから……」","开车也好干啥也好，\n都要多留神。[l]\n还有……」"],["「わ、わかりました、気をつけます」","「明、明白了，会注意的」"],["「あ、ああそうだな、すまん。[l]\nもう子供ではないのだからな……[l]\n自分で確りと出来る……な？」","「啊、啊啊也是，抱歉。[l]\n毕竟不是小孩子了……[l]\n自己能处理好……对吧？」"],["「？[l]\nま、まあ或るヒトに言わせればまだまだ少年らしいですが……[l]\n精一杯の節度を以て物事に接したいと思います。[l]\n母さんを反面教師にその辺はしっかと」","「？[l]\n嘛，按某人的说法我还是少年气十足啦……[l]\n但会尽量用最妥帖的方式处理事情。[l]\n把老妈当反面教材这方面我可稳了」"],["「真言、","「真言，"],["現","现"],["実を──\n母さんを悪く言うな。[l]\nあれはあれでお前を」","说实——\n别这么说你妈。[l]\n她那样也是为你」"],["「わ、わかってますよ。[l]\nちょっとした戯れですってば。","「知、知道啦。[l]\n就开个小玩笑嘛。"],["やだなあ知狡さん、\n相変わらずの生真面目ぶり、健在でらっしゃいますなあ。[l]\n大丈夫です、二人とも僕の大事なかぞ──」","知狡阿姨真讨厌，\n这古板劲儿一点没变呢。[l]\n放心啦，两位都是我重要的家——」"],["「………」",""],["「……？」",""],["何故か苦渋に満ちた表情とでも言うべきか、\n眼をきつく閉じたまま何かを噛み締めるように下を向き、\n上を向き、","突然露出近乎痛苦的表情，\n紧闭双眼像在强忍什么似的低下头，\n又抬起头，"],["そして僕を真正面から視据えた。","然后他从正前方直视着我。"],["「何かあったらすぐ言うんだぞ。[l]\n三春の……あの娘の事でも、何でもだ」","「有什么事要立刻说出来。[l]\n三春家的……那姑娘的事也好，什么都行」"],["なんだろう。[l]\n家族愛的な台詞を必要以上に重く受け止めたんだろうか。[l]\n知狡さんらしいと言えばらしいけども、","怎么回事。[l]\n是把关于家人爱的台词过分当真了吗。[l]\n说是很有知狡的风格也确实如此，"],["「あー……、[l]\nまあ冬夏に関してはその、\nいえ、何でもないです」","「啊——……[l]\n关于冬夏的事情那个，\n不，没什么」"],["知狡さん相手じゃなくても、\nそうそう相談出来る内容じゃないよなあ……[l]\nそれこそこのひとに迂闊に相談しようものなら、\nどう受け取られるか。","即使对方不是知狡阿姨，\n这种事也不是随随便便就能商量的啊……[l]\n要是贸然跟这个人商量的话，\n会被怎么理解呢。"],["うーん、知狡さんも、\n僕の過去記憶に関しては、\n保証出来る何かを知ってるかも知れないが、","嗯——知狡阿姨她，\n关于我过去的记忆，\n或许知道些什么能保证的东西，"],["冬夏の件でまた前みたく、\nガチで結婚がどうのレベルの話に持ってきそうだしなあ……","但要是提到冬夏的事又会像之前那样，\n搞不好会认真扯到结婚之类的话题上啊……"],["「あ」","「啊」"],["「どうした？」","「怎么了？」"],["「やっぱレンタカーのが良いかも……[l]\nその、冬夏迎えに行くかも知れないし、\n一応念のため……」","「果然还是租车比较好吧……[l]\n那个，说不定要去接冬夏，\n以防万一先准备着……」"],["「あ、ああそうだな。[l]\nもうかなり彼女等と接触している事だしな……[l]\nならもう、期間で借りた方が良いだろう。[l]\n経費は出るから一週間ほど借りてしまうのも手だが」","「啊，啊啊说得对。[l]\n毕竟已经和她们有相当多接触了……[l]\n那干脆按周期租赁比较合适吧。[l]\n经费可以报销，租一周左右也是可行的」"],["「そうですね、\n祭までと考えても最長であと２週間として……[l]\nまずはそれで頼んでみます」","「是啊，\n考虑到祭典前最长也就两周时间……[l]\n先按这个周期预约吧」"],["「領収書とっておいてくれ、\n手持ち足りるか？[l]\nなんなら……」","「记得留好收据，\n手头钱够吗？[l]\n不够的话……」"],["「あーっとえー、\n済みません足らないです……」","「啊——那个——\n不好意思确实不够……」"],["「ちょっと待て、\n今用意する」","「稍等，\n现在准备」"],["何処かに行った知狡さんは５分と経たずに戻って来て、\n僕に経費を手渡すと、","离开片刻的知狡不到五分钟就回来，\n把经费交到我手里后，"],["「では気をつけてな。[l]\nくれぐれも……気をつけるんだぞ」","「路上小心。[l]\n千万……要当心啊」"],["と言って視送ってくれた。","这样目送着我离开。"],["疲弊感は多少ましになってたようだけど、\n何か様子はおかしいかなあ……[l]\n同じ事２度言ってるし。","虽然疲惫感似乎减轻了些，\n但总觉得哪里不太对劲……[l]\n同样的话说了两遍。"],["こんなひとと言えばこんなひとだけど、\n忘れてはいけない、\n外見に惑わされがちだが知狡さんは、\n僕の母さんの姉なのだ。","说是她一贯作风也确实如此，\n但绝不能忘记，\n虽然容易被外表迷惑，但知狡阿姨是\n我母亲的姐姐。"],["宮さんの無茶には僕でも振り回されるのに、\n知狡さんとかじゃ結構しんどいんじゃなかろうか……[l]\n年齢的な事情を抜いても、知狡さんの性質では……[l]\n母さんなら一緒になって騒ぎそうだけどなあ。","连宫小姐的胡来都会让我招架不住，\n换成知狡阿姨这种类型应该更吃力吧……[l]\n就算不考虑年龄因素，以知狡阿姨的性格……[l]\n要是母亲的话肯定会跟着一起闹腾吧。"],["「うーん、\n取り敢えずは僕自身気をつけて、\n知狡さんに負担をかけないように心懸けるくらいしか、\n出来ないかなあ……」","「唔——\n总之我自己先注意点，\n尽量不给知狡阿姨添负担，\n只能做到这样了吧……」"],["あの真面目さは、\n下手に気遣いしてることをみせると余計にプレッシャーに感じそうだし。","她那股认真劲儿，\n要是察觉到被过度关照反而会更有压力吧。"],["などと、つらつらと考えながら昨日のレンタカー屋に向かった。","就这样胡思乱想着，走向昨天那家租车行。"],["昨日の今日なので","因为是隔日续租"],["恙なく手続きを済ませる。","手续顺利办完了。"],["さて。","那么。"],["流石に道すがら運転しながらではあまりに恐怖──なのは、\n昨日の一連で身に染みたので、\n車に乗り込みシートベルト締めてから、\n発信させずに一旦考えてみる。","毕竟要一边开车一边思考实在太恐怖——\n昨天那一连串事情让我深有体会，\n所以坐进车里系好安全带后，\n我决定先不打电话，好好想想。"],["まず夢なのか記憶が戻って来てるのか、\nこの所よくある情景が浮かぶ。","首先这究竟是梦境还是恢复的记忆，\n最近经常浮现的光景。"],["玄ノ森に来てから、\nそこかしこで視える『何か』の事もあるが、\n差し当たってそちらは大神の意見を容れつつ一時棚上げするとして、","来到玄之森后，\n虽然也常在各处看见『某些东西』，\n但那些暂且按大神的意见搁置不论，"],["あの砂浜──碁石松原での事だ。","关键是那片沙滩——围棋石松原的事。"],["砂のお城なんか今も残ってるはずはないので、\n冬夏が言おうとしていた証拠めいたモノでも無い限りは、\n闇雲にあそこに行っても何かあるとは思えないが、","沙堡之类的东西现在肯定不复存在，\n除非冬夏能拿出什么像样的证据，\n否则贸然跑去那里估计也找不到线索，"],["この","不过"],["曖","在"],["昧","我"],["模","暧"],["糊とした僕の記憶において、\nあの海岸の情景その他は、\nやけに強烈な印象として残ってる。[l]\n屋上で浮かんだあのシーンとイコールとするならば、","昧模糊的记忆里，\n那片海岸的光景与其他细节，\n倒是留下了异常鲜明的印象。[l]\n如果和天台浮现的场景划等号，"],["僕は確かに彼処で、\n２個下の少女達＋αと遊んだ事があると考えても、\n不自然ではなかろう。[l]\n多分。","那我确实应该\n和两个学妹＋α在那里玩过，\n这么想并不突兀。[l]\n大概。"],["うん、そういう記憶はぼんやりとある。","嗯，这种记忆确实朦朦胧胧存在。"],["昨日何度も、確かに此処を知ってる、と感じたのもあるし、\n多分それはそうなんだ。[l]\nそれすらも疑うとなると前提がどうしようもなくなるし\nきりがないので、もう、そうだと固定してみる。","昨天也多次强烈感觉到熟悉这里，\n多半就是这么回事。[l]\n要是连这个都怀疑就彻底没基准了\n所以干脆先当作既定事实。"],["一緒に居たのが冬夏だったかどうかは別だが、\n……冬夏の昨日の自己申告を聞く限り、[l]\n確率としては結構高めである気がするけれど──","虽然不确定当时冬夏是否在场，\n……但根据冬夏昨天的自述，[l]\n概率应该挺高的——"],["ただ、容姿は時間の経過の影響を無視出来ない為、\nあまり参考にはならない、","只不过外貌会随时间改变，\n参考价值有限，"],["だから、彼処にいた少女が、\n冬夏なのか、きぃなのか、\n冬夏の話じゃ姫様ちゃんも居たらしいけども、\n複数居たかどうかは、","因此沙滩上的少女\n究竟是冬夏还是小贵，\n按冬夏说法姫様好像也在场，\n是否真是多人同行，"],["そしてあの宮さん……のようなひとは、[l]\n単に僕の記憶を侵蝕してきた、\n『今の』あのひとの幻影なのか、\nそれとも──","还有那位宫小姐……般的人物，[l]\n究竟是单纯侵蚀我记忆的\n『现今』那个人的幻影，\n亦或是——"],["ま、まあ別人とか、\nそれこそ親戚縁者という可能性も無きにしも非ず。[l]\nあまりあのひとに関しては突っ込んで考えたくない。[l]\nお互いの為にもそう思うのです、ええ、はい。","呃、呃或许是别人，\n甚至可能是亲戚之类的关系。[l]\n不太想深入思考那个人的事。[l]\n为了双方着想还是就此打住，嗯嗯。"],["そこは触れないようにするというのが前からの意向だったしな！[l]\nかれお嬢が確かそう……[l]\nああ、今頃大神と愉しく過ごしておられるのだろうか。","本来就不该触碰这个话题才对！[l]\n记得卡蕾欧小姐确实说过……[l]\n啊，现在她正和大神愉快相处吧。"],["あれ？[l]\nそう言えば『ねこざんまい』にどうとか言ってたっけ？[l]\n同僚とお泊まりだとか何とか……","咦？[l]\n说起来是不是提过『猫三昧』什么的？[l]\n说是要和同事外宿之类的……"],["──はっ、また横滑りしてる。","——啊、又跑题了。"],["いかんいかん。","不行不行。"],["うーん、あの情景が夕暮れじゃなければ、\n髪と眼の色で少なくとも冬夏はそうと解ると思うんだけれど、\nそもそもあやふやな記憶に証拠を見出そうとしても、\nなかなかなあ……","唔，如果那场景不是黄昏时分，\n凭发色瞳色至少能确认冬夏身份，\n但想在模糊记忆里找证据\n实在困难……"],["例の鳥居の記憶だの、\n経験則として記憶は置換もあれば刷り込みも行われるから、\n何か明確な、\nそれこそ記録、記念碑的な何かが必要で──","无论是那个鸟居的记忆，\n经验上记忆既会被替换也会被植入，\n除非有明确的\n类似记录或纪念碑的东西——"],["むぅ、結局はそこか。","呣，果然还是得去那里。"],["それが冬夏の言おうとした、\n砂の城に何を埋めたのか、てことだろうか。","那就是冬夏想说的、\n在沙堡里埋了什么，这件事吧。"],["何か書いて埋めたんだろうかなあ、\nタイムカプセル的に。[l]\nそこにその、約束の","大概是写了什么埋进去的吧、\n像时间胶囊那样。[l]\n那里有那个、约定的"],["証的なものがあるとか……","类似证物的东西……"],["その辺の具体的な記憶は、\n……今のところ残念ながら出てこないが、[l]\n全く有り得ない、と言うよりも、空白状態とでも言うべきか、","关于那部分的具体记忆、\n……目前很遗憾还没浮现出来、[l]\n与其说是完全不可能存在、不如说是处于空白状态、"],["あってもおかしくないが、\n肯定にも否定にも決定的な要素が無いという状態。","就算存在也不奇怪、\n但既没有决定性要素能肯定也无法否定的状态。"],["いずれ湧き出てくるのを期待、という消極的な方法しか浮かばないけど、\nそもそも冬夏との事は、\n仕事とは別件の話、ではあるから……","只能消极地期待哪天会自然涌现、\n毕竟和冬夏的事、\n本来就是与工作无关的话题……"],["あとは、\n先入観をなるべく排除していくべきかどうか……","还有就是、\n该不该尽量排除先入为主的观念……"],["冬夏の話は、記憶を取り戻す『よすが』や、\n呼び水にはなってるかも知れないが、\n誘導尋問というか、恣意的にしろ無意識的にしろ、\n事実をねじ曲げていってる可能性もある。","关于冬夏的谈话、\n或许能成为恢复记忆的『线索』或契机、\n但无论是诱导性提问还是有意无意、\n都有可能扭曲事实。"],["しかし──","但是──"],["「──はっ。[l]\nこのままじゃ車内で１日が終わるぜよ」","「──哈。[l]\n这样下去整天都要耗在车里了喂」"],["てかレンタカー屋の駐車場で何してるんだ僕は。[l]\n幸いにも店の従業員にはまだ怪しまれてないようなので、\nそろそろエンジンをかけ出発","话说我在租车行的停车场搞毛啊。[l]\n幸好还没被店员怀疑、\n差不多该发动引擎出发"],["致そう。[l]\nいざやいざ！","了吧。[l]\n说走就走！"],["耳鳴りがする程の静寂から、\n一気にエンジンの唸る音に取り囲まれて、\n一瞬くらくらするが、すぐに慣れる。[l]\nフロントガラス越しに射し込む日光が眩しいのう。","从令人耳鸣的寂静中、\n突然被引擎轰鸣声包围、\n虽然瞬间头晕目眩但马上适应了。[l]\n挡风玻璃透进来的阳光好刺眼啊。"],["清清しさと、\n何故か知らねど、妙な寂しさを感じながらアクセルを踏んだ。","带着清爽感、\n不知为何又夹杂着莫名寂寞踩下油门。"],["きっと、\n昨日の喧噪との落差なのだろうな。[l]\n騒ぎの後は必ず反動で必要以上にクールダウンする傾向があるのだ。","肯定是因为\n与昨日喧嚣的反差吧。[l]\n每次闹腾过后总会过度冷却的毛病又犯了。"],["それは正直、\nかなり苦手で、\nだから友人も少なくして、\nこういう感情の揺り戻しで凹んだりしないようにしてきたのだけど。","说实话、\n我特别不擅长应付这个、\n所以故意少交朋友、\n就是怕被这种情绪反弹搞到抑郁。"],["……いや、友人はそうでなくても少ないです。","……不对，就算没这毛病我朋友也不多。"],["「ららら～はるはひとこいしくにゃるにゃ～」","「啦啦啦～春心寂寞喵喵喵～」"],["なんだこれ。[l]\nあまりの虚しさに思わず自動作詞作曲機能が働いたもよう。[l]\nにゃ～とか言うなっての。[l]\nどこぞの誰かじゃあるまいし。","什么鬼。[l]\n空虚到自动触发作词作曲功能的样子。[l]\n别给我喵来喵去的。[l]\n又不是哪来的某某人。"],["むーん、宮さんだけならいざ知らず、\nきゃつにまで意識下で影響受けてるとしたらちょっとあれだな……","唔～要是只有宫小姐还好说、\n连那家伙都在潜意识里影响我就有点那个了……"],["閑話休題。","闲话休提。"],["道行きは先日と全く同じだったが、\n一人だと妙に長く感じるものだ。[l]\nまあ昨日は喋りまくりだったし、\nその反動でちょっとばかりおセンチになってる所為もあるのかも。","路线和前天完全一致、\n但独自开起来总觉得特别漫长。[l]\n毕竟昨天全程话痨模式、\n现在多愁善感可能也是反弹效应。"],["とは言え今日は、\n信号無視しかけたりといったこともなく、\n車は昨日の道の駅へと到着する。[l]\n","不过今天、\n既没差点闯红灯、\n车子也顺利到达昨日的公路驿站。[l]\n"],["午前中だと、業者的な何か用事があるのか、\n前回より若干車が多い気がした。[l]\nそれでも閑古鳥には変わらないけど……","上午时段可能有商家办事、\n感觉车辆比上次稍多。[l]\n但依然冷清得能听见蝉鸣……"],["ま、今から思索及び探索に耽ろうという身にとっては、\n好都合である訳で、\n","嘛，对于正要沉迷思考与探索的我来说、\n倒是正好、\n"],["精","精"],["精職質とかかけられないようにしようかね。","尽量别被当成可疑分子吧。"],["実際職質かけられたら何て返答したものか……[l]\n会社員……","实际上要是被警察盘问该怎么回答呢……[l]\n公司职员……"],["……なにかがちがう。","……总觉得哪里不对劲。"],["どっちにしも、\n２０そこらの成人男子が昼間から海辺を","不管怎么说，\n20岁出头的成年男性大白天在海边"],["彷","彷"],["徨いていて、\n何を言っても違う気がする……","徨，\n感觉说什么都很可疑……"],["ただ今までの経験上、\n中央の都市とかじゃないと、\n職質とかそんな話は滅多に聞かないけども。","不过根据以往经验，\n只要不是在中心都市之类的地方，\n很少会听到被警察盘问这种事啦。"],["「まあいいや。[l]\nそんな事考えててもしょうがない」","「啊算了。[l]\n想这些也没用」"],["基本的には旅行者だしな－。","反正基本算是旅行者嘛－。"],["さて、\nまずは砂浜まで出ようか。","那么，\n先走到沙滩去吧。"],["……昨日、あの時、[l]\n冬夏の言葉があろうとなかろうと、\n此処は知っていた場所だ、と気付いた……","……昨天那个时候，[l]\n无论冬夏有没有说过那句话，\n我都意识到这里是曾经知道的地方……"],["正確にはそうと思わしき場所と感じた訳だが、\n先刻その件は仮ではあるが確定させたし、","准确说是感觉很像记忆中的场所，\n虽然刚才那件事还只是假设但基本可以确定，"],["実際僕は、幼少期にこの地に居たのだから、\nその点に関して──本当にそうであった場合も──不思議は無いのだ。","毕竟我小时候确实在这地方住过，\n关于这点──就算真是那样──也没什么好奇怪的。"],["問題は、\n冬夏やその、其処に居たという謎の人物、\n姫様ちゃん達と既に会っていたとしたら、","问题在于，\n如果冬夏和那个神秘人物当时就在那里，\n而且已经和姫様她们见过面的话，"],["──きぃとの過去は一体どうなる？","──那我和小贵的过去会变成怎样？"],["という事だ。","这件事。"],["昨日も考えたけれど、\n実際僕をだまくらかしてまで接近するような利点がきぃにあるとは思えない……あくまで僕の主観で、実は──[l]\n思いも寄らぬ何らかの利点、理由があるかもしれないが、","昨天也想过，\n实在不觉得小贵有必要骗着接近我……虽然只是我的主观想法，说不定──[l]\n存在某些完全意想不到的好处或理由，"],["何か引っ掛かる。[l]\n宮さんも西石姓に聞き覚えがあったようだし、\n……そうだ、浮かぶ情景＝記憶だとするならば、","但总觉得有蹊跷。[l]\n宫小姐好像也对西石这个姓氏有印象，\n……对了，如果浮现的情景＝记忆的话，"],["宮さんの実年齢とか、\n恐ろしい事まで浮き彫りになり兼ねないけど、\nもし、もしも驚愕の事実が待っていようと、\n僕の心の中だけに留めておこう。","宫小姐的真实年龄之类，\n说不定会牵扯出可怕的事情，\n但就算、就算真有令人震惊的事实等着，\n我也要把它埋藏在心底。"],["えーと、最低でも僕の年齢にプラス……","呃，最少也得在我的年龄上加……"],["「はっ、\nやめやめ、そんな思考禁止！！！！！！！！」","「哈，\n停停停，禁止这种思考！！！！！！！！」"],["知らない事が良い事が世の中には沢山ある！[l]\n開けてはならない箱がこの世にはある！[l]\n中身はどうあれ箱には箱としての存在価値があると、\nどなたかも仰っておられたしな！！","世上有很多事还是不知道为妙！[l]\n这世上存在着不能打开的盒子！[l]\n不管内容如何盒子都有其存在价值，\n某位不是也这么说过嘛！！"],["ふう……","呼……"],["そして、\n冬夏との約束……","另外，\n和冬夏的约定……"],["「返事……と言われてもなあ……[l]\n……言われてもなあ……」","「要我给答复……就算你这么说……[l]\n……就算你这么说……」"],["他","不"],["人に好かれるっていう事が、\nこんなにも奇妙で意味不明なものだとは思ってもみなかった。","被人喜欢这件事，\n没想到竟是如此奇妙又难以理解。"],["好きか嫌いの２種類に、\n人間関係って完全に割り振れるような幻想を無意識に抱いていたのかな、\n僕は。","我是不是潜意识里总以为人际关系\n能简单二分成品行喜欢或讨厌呢，\n这样。"],["友人が少ないのも彼女がいないのも、\n結局中間層というのを想定出来なかったからかも知れない。[l]\n……いや、単純に絶対数が少なかっただけだろう。[l]\n接触しうる人間の。","朋友少也没女朋友，\n或许就是因为想象不出中间状态的存在。[l]\n……不，单纯是接触的人[l]\n绝对数量太少了吧。"],["大神はそういう意味で、\n大変にこう、\n向こうから来てくれる分、僕には合ってたのだろうが、","大神在这方面，\n该说是非常\n能主动靠近我，所以比较合得来，"],["今にして思えばそこに甘えて、\n自分から他の誰かと親しくしようと積極的に動こうとは、\nしてなかったかも知れない。","现在回想起来或许正是仗着这点\n我从未主动试图和其他人拉近距离\n说不定根本就没努力过"],["何か駄目人間だな僕ぁ。","真是个废柴啊我"],["いずれにしても、\n冬夏は今そのどういう、……うーん。","总之\n冬夏现在那个怎么说……嗯——"],["だって僕は、\nそれに僕は、","毕竟我\n而且我"],["……がすきなのか？","……是喜欢这个吗？"],["……きぃの愛してるは完全に飯を奢る僕、の事として、[l]\n姫様ちゃんが一体どういう用件で僕と話したがってるのか、が、\nそういう意味ではちょっと身構えますけれど、\nやっぱどう考えてもそれは幾ら何でも自意識過剰よね。","……小贵的\"我爱你\"完全就是针对请客吃饭的我[l]\n姫様到底想和我谈什么\n从这个角度来说确实会有点紧张\n但怎么想都觉得这也太自我意识过剩了吧"],["今までいっこもモテなかった僕が、\n何でまた此処で一気にそんな……ねえ。","至今为止毫无女人缘的我\n怎么可能突然在这里就变得这么……对吧"],["そこまでナルシーにはなりきれないと言うか、\nもう卑屈に育っちゃったからな！[l]\nそこに来て宮さんと出会って、\nとどめを……さされて……………","或者说还没自恋到那种程度\n毕竟早就养成自卑的性格了！[l]\n就在那时遇见了宫小姐\n被补了最后一刀…………"],["「宮さん……？[l]\n早く、あぃ──」","「宫小姐……？[l]\n快、啊——」"],["んぁっ？","嗯啊？"],["何言ってる？","在说什么啊"],["「あかん、早くも空転してるぜよ、\nまずは身体動かさねぁにゃらん」","「不妙，已经开始空转了\n得先让身体动起来才行」"],["首を回し腕を振り回し、\nそれこそ職質かけられそうな独り言をぶつぶつ言いながら、\n僕は気をしっかり持とうと試みた。","转动脖子甩动手臂\n边嘟囔着可疑到会被警察盘问的自言自语\n我试图让自己冷静下来"],["……と色々思い悩んではみても、[l]\nあんま仕事に関係ないといえばない話なんだよな。[l]\n今のところ過去の記憶がハッキリしてようとしてなかろうと、\n格別問題なく生活してきた訳だし、","……虽然烦恼了很多[l]\n但说实话都和工作没啥关系[l]\n不管过去的记忆是否清晰\n至今为止生活也没出现大问题"],["そう、あとは蔵の中での事だの、\n色々仕事本編に絡んだ話もあるだろに、","对，剩下的就是仓库里的事\n还有各种与工作主线相关的内容"],["何か視えたりする件も棚上げというよりは、\n","关于能看见某些东西的现象与其说是搁置\n"],["癪だけれども大神の言う通り、寝たらもうスルー……","虽然不爽但正如大神所说，睡一觉就过去了……"],["いや、そこまで簡単に受け入れられた訳じゃなくてですね、\n立て続けに色んな事がおきるので一個一個に構ってらんないつーかその、\n実害も今のところないしね。","不，倒也不是这么简单就能接受\n只是接二连三发生太多事没法逐个纠结\n反正目前也没实际危害"],["大神という","大概是因为"],["先","不"],["達が身近に居たからかも知れない。[l]\nいずれ自分の意志や力じゃどうしようも無い要素に関しては、\n悩んでも仕方のない事だ。[l]\n恋愛と一緒だね。","有大神这样的人物在身边[l]\n对于凭自己意志或力量无法改变的因素\n烦恼也没用[l]\n和恋爱一样呢"],["どうした、僕ぁ。[l]\n何かそっち方向に流れてくぞ？！[l]\nあんな事があったからって、\n色惚けしとる場合か！！","怎么了这是[l]\n思维怎么往那个方向跑了？！[l]\n明明发生了那种事\n哪有空想这些！！"],["じ、自分じゃそんなつもりぁ無いんだけどなぁ……[l]\n宮さんですっかり抵抗力ついたと思ってたのに……[l]\nあのひと専用スキルだったのか、それとも──","虽、虽然我自己没那个意思啦……[l]\n还以为对宫小姐已经产生抵抗力了……[l]\n难道那是只对她专用的技能吗，还是说——"],["「あ・づでぁっとぅ！！」","「啊・呜哒！！」"],["き、木の根っこに","被、被树根"],["躓いた……[l]\nうう、水溜まりにはまったり運転危うくなったり、\n僕は『ながら』で思考すると危険かもなあ……","绊倒了……[l]\n呜…又是踩水坑又是差点摔倒\n我可能不适合边走路边思考……"],["来がけにそう留意した筈なのに、\n流石僕の脳スペック、\nすこーんと忘れてしまったもよう。","明明来的时候还提醒过自己\n不愧是我的脑容量\n转眼就忘得一干二净"],["取り敢えずこの防砂林を早く抜けよう。","总之先快点穿过这片防沙林"],["再び砂浜へと出る。","重新回到沙滩上"],["今日も抜けるような青空でとても気持ち良い。[l]\n波の音が静かに、そして終わり無く続く。[l]\nつまり、やっぱり人は全然居ないのであった。","今天也是万里无云的晴空令人心旷神怡[l]\n海浪声静静延续永无止境[l]\n也就是说，果然还是一个人都没有"],["午前中の青はまた午後の青とは違うようで、\n昨日の風景とは微妙に受ける印象が変わってるなあ。","上午的蓝与午后的蓝似乎又有所不同，\n与昨日的风景相比感受到的印象微妙地变化了呢。"],["独りという事もあるのかな……[l]\n昨日あまりにも人との接触が多すぎたからか、\n何か妙に寂しい。[l]\nなんだかのう。","或许也有独自一人的缘故吧……[l]\n可能是因为昨天与人接触实在太多了，\n总觉得莫名寂寞。[l]\n怎么回事呢。"],["「自分が小さく視えるから、かあ……」","「是因为觉得自己显得渺小吗……」"],["確かにひととひとの間に居るときは意識することが少ないが、","确实身处人群之中时很少会意识到，"],["僕等はそれぞれたった独りで、\nそれぞれが他人のことなどまるで背景のように視ているのだろう。[l]\nそして、それはお互い様という事だ。","但我们每个人都只是孤身一人，\n大概彼此都把对方当作背景般看待吧。[l]\n而且，这是相互的。"],["全員がセカイの構成要素のひとつひとつで、\nただ、それぞれは自分の事しか解らないから、\n考えた所で無駄で、分かったつもりでもそれは、\n絶対に独り善がり、思い込み、錯覚なんだけども、","所有人都是世界构成的每个要素，\n只不过，每个人都只能理解自己的事，\n就算思考也是徒劳，自以为明白的事，\n绝对只是自我满足、臆测和错觉罢了，"],["どうあれ全て錯覚ならばそれが僕等にとっての真実、\nそれをよすがにして関わり合っていくしか、僕等にはできない。","但若一切都是错觉，那对我们而言就是真实，\n我们只能以此为依托相互关联。"],["だから、\n例え夢を視てるのだとしても、","所以，\n即便是在看着梦，"],["互いに錯覚し合いながら、\n寄り添っていくのか、拒絶し合うのか、\nそうやっていくしか。","也要在互相错觉中，\n选择相互依偎，还是彼此拒绝，\n只能这样走下去。"],["僕はだから、\nせめて側にいたい、すきなひとの、","所以我，\n至少想待在喜欢的人身边，"],["……はっ。","……啊。"],["波の音の単調さにトリップしてたのか、\n何か、おセンチな思考に囚われていたような気がする！","是被单调的海浪声带着走神了吗，\n总觉得陷入了某种感伤的思绪！"],["いかんいかん、\n昔のことの方を必死で思い出そうとしてみようか……","不行不行，\n还是拼命回忆过去的事吧……"],["砂の城、とは言っていたものの、\nお墓で城がついてたというのは恐らく、\n","虽然说是沙之城堡，\n但坟墓旁有城堡的恐怕是，\n"],["奥","奥"],["津","津"],["城の事だろうか。","城的事吧。"],["確かそんな言葉があったような気が。[l]\n……奥の院と関係あるのかな？[l]\nまあどっちも祖霊とか御霊を祀ったりするんだったような、","隐约记得有这样的词。[l]\n……和内院有关系吗？[l]\n反正两者都是祭祀祖灵或御灵之类的，"],["いずれあんまり子供が──昨今じゃ大人も怪しいけど──使うような、言葉じゃないよなあ。","总之不是小孩子——虽然现在连大人都未必——会用的词呢。"],["その一緒に居たという外つ國の人とやらも、\n流暢にこの國の言語喋ってたから\nかなり精通してた","那个据说同行的外国人，\n能流利地说这个国家的语言\n应该相当精通"],["もし僕がその場に居たのなら、\nそんな人物に覚えはあるか……？","如果当时我在场，\n会对那样的人有印象吗……？"],["──み、やさ、ん？","──宫、宫、宫？"],["いやいや、あのひとは確かに年齢の事を除外すれば、\n一応古書肆だし\nただそんなにこの國のニンゲンに視えないってことは──","不不，那个人虽然不考虑年龄的话，\n姑且算是古籍商\n但看起来不太像这个国家的人类——"],["そう、僕の記憶では夕暮れで、\n色が解らないけれど、","没错，记忆中是在黄昏，\n虽然看不清颜色，"],["冬夏。","冬夏。"],["カミの色。","头发的颜色。"],["眼の色。","眼睛的颜色。"],["それが違っているから、べつの國のにん──に視えるわ──で──","因为不同，看起来像是别国的人——"],["いかん、力みすぎたか、首が熱くなってきた。","糟了，太用力了，脖子都发热了。"],["まてよそうだたしか──","等等确实——"],["「──ぁうあ」","「──啊呜啊」"],["@rた、立ちくらみが！[l]\n@rあうあうあうあうあうあう、[l]\n@rちょ、ちょっと座らねば、[l]\n@r倒れそう……","@r站、站不稳了！[l]\n@r啊呜啊呜啊呜啊呜啊呜啊呜，[l]\n@r得、得坐下，[l]\n@r要倒了……"],["@rざすっ。[l]\n@rな、何とか尻餅で済んだけど、[l]\n@r眼の前がまだぐるんぐるんに、[l]\n@rうーむ、\n何の事考えてたんだっけか……","@r啪嗒。[l]\n@r总、总算只是摔了个屁股蹲儿，[l]\n@r眼前还在天旋地转，[l]\n@r嗯——\n刚才在想什么来着……"],["@r墓碑銘[l]\n@rMeMentoMori[l]\n@r3E…？[l]\n@rめめんともり？[l]\n@rなんだっけな？","@r墓碑铭[l]\n@rMeMentoMori[l]\n@r3E…？[l]\n@r梅门托莫里？[l]\n@r叫啥来着？"],["@rあっ、[l]\n@rうーん……[l]\n@rお、もいだ──し、[l]\n@rた。[l]\n@rやっぱり力んだせいか首が汗ばんでるけども、","@r啊、[l]\n@r嗯……[l]\n@r哦、想──起、[l]\n@r了。[l]\n@r果然是因为太用力脖子都冒汗了、"],["@rそうだ。[l]\n@rイシだ。","@r对了。[l]\n@r是石头。"],["@rお城……というかお墓を、[l]\n@r……なんのだっけな？","@r城堡……或者说坟墓、[l]\n@r……叫啥来着？"],["@rそのうえに、\n@rそれをわ、\n@rす、\n@rれ、\n@rる、\n@rな、\n@rと、\n","@r而且、\n@r把那、\n@r碎、\n@r裂、\n@r开、\n@r的、\n@r时、\n"],["@rうあああああああああああああああ！！！！！！！！！","@r呜啊啊啊啊啊啊啊啊啊啊啊啊啊啊！！！！！！！！！"],["@r思い出した！！！！！！！！","@r想起来了！！！！！！！！"],["@r僕は子供の頃、\n此処、玄ノ森を発つ直前に、\nこの砂浜に来た、","@r我小时候、\n此处、离开玄之森之前、\n来过这片沙滩、"],["そして、\n@r砂遊びをした、\n@r誰かと。","然后，\n@r玩过沙子，\n@r和某个人。"],["@r砂の城、つくった、何かを埋めた。[l]\n@rそれは確かにそうだ、間違いは（多分）ない！[l]\n@r何かが欠けてる気がするのは否めないが、\n@r………ん？","@r堆过沙堡，埋过什么东西。[l]\n@r这确实是真的，肯定（大概）没错！[l]\n@r虽然总觉得缺了点什么这点无法否认，\n@r………嗯？"],["@rあれ、あまり進展してないような……","@r啊咧，好像没什么进展的样子……"],["@rそれが誰かってところが問題なんだろうよぅ……","@r问题在于那个人到底是谁吧……"],["@rま、まあ、具体的な行為のいくつかを思い出しただけでも\nよしとしよう。","@r嘛、嘛，至少能想起几个具体的行为\n就算不错了。"],["そもそも本来の目的は、\n玄ノ森ですべき仕事は──","说到底原本的目的是，\n在玄之森该做的工作是──"],["……うーん、","……唔——"],["冬夏の告白、返事どうしたらいいんだろうか。[l]\n彼女の誕生日まであと一週間ちょっと、\n祭までのリミットも近づいてくる。","冬夏的告白，该怎么回复才好呢。[l]\n距离她的生日只剩一周多，\n祭典的截止期限也快到了。"],["あっちの開催の如何もまだ連絡待ちではあるが、\n基本的にはほぼ確定だそうだし。","虽然那边是否举办还在等通知，\n不过听说基本上已经确定了。"],["と、兎も角、\nあまり変なテンションで独り言したりすると、\nそれこそ見咎められそうなので気をつけるとして、","总、总之，\n要是用奇怪的亢奋状态自言自语的话，\n反而会被盯上吧得注意点，"],["ええと……","呃……"],["そう、","没错，"],["エピタフは石だった。[l]\n子供の頃だったからスケールがちょっと曖昧だが、\n結構大きめだったと思う、","墓志铭是石头做的。[l]\n因为是小孩子所以尺寸记不太清了，\n印象中还挺大的，"],["何しろ、墓碑銘というくらいだから文面を刻んだ──","毕竟都叫墓碑铭了肯定刻着字——"],["白","白"],["墨か\n何かだったのかな？[l]\n位だから、その辺に転がってた石とかではないだろう。[l]\n書いたのは其処に居た──","墨迹\n还是什么的来着？[l]\n总之不可能是路边随便捡的石头。[l]\n写字的是当时在场的——"],["あ。","啊。"],["そうだ。","对了。"],["また思い出した。","又想起来了。"],["其処に、居た。","当时，还有人在。"],["僕と女子……つまり二個下の子供の他に、\n@r誰かが居た。","除了我和女孩……也就是低两届的孩子之外，\n@r还有别人在。"],["『しらないようなしってるような』ふしぎなひとがいて、","有个『似曾相识又素未谋面』的怪人，"],["……駄目だ、風貌は全く出てこないが、","……不行，完全想不起长相，"],["矢鱈滅鱈難しい言葉を使うから、\n@r難しい言葉？","因为净用些乱七八糟的难懂词汇，\n@r难懂词汇？"],["を使うひと？","用这种词的人？"],["……引っ掛かる。","……很在意。"],["ひとりじゃなかったんじゃなかったか？","该不会不是独自一人吧？"],["それだけじゃない、なにかが欠けている……","不仅如此，总觉得缺了点什么……"],["……駄目だ、こっち関係の記憶もまだモヤってる。","……不行，和这边相关的记忆也还很模糊。"],["ただ、冬夏が言っていた外つ國のひとっぽい……[l]\nていうのがそのひとの可能性は？","不过，冬夏提到过像是外邦人的人……[l]\n说不定就是那个人？"],["それに、\n何かチノ嬢とか道具さんが、\n宮さんみたく記憶を侵蝕してるような気もする。[l]\nそう丁度人種としてはあんな感じの喋りで……","而且，\n总觉得千乃小姐和道具小姐，\n也像宫小姐那样被侵蚀了记忆。[l]\n对正好作为人种来说就是那种说话方式……"],["──まさかなあ。","──不会吧。"],["チノ嬢も道具さんも、\n年齢わかんないから万が一という事もあり得るが……","千乃小姐和道具小姐，\n因为年龄不详所以也存在万一的可能性……"],["でもまあ、これは多少の進展かな……","不过嘛，这算是稍有进展吧……"],["いずれ確たる証拠が無い限り──そんなものあればだが──、\nどんだけ考えようと、それに整合性があろうと、\n机上の空論と言われればそれでお仕舞いだ。","总之在没有确凿证据之前──虽然也不可能有──\n不管怎么思考，即使逻辑能自洽，\n被说是纸上谈兵的话那就全完了。"],["それを言い出すとあらゆる事象の確実性が揺らぐかも知れないけれど、\nまあ今回のこれに関しては、","要是这么说的话所有现象的确定性都可能被动摇，\n不过关于这次这件事，"],["──の遊戯だ。","──的游戏罢了。"],["そう、ようするに手慰み、げ、ぇ、む……？","对，说白了就是消遣，呃、恶、唔……？"],["なんだ？","怎么了？"],["「………？」",""],["──誰も居ないな。そらそうだ。","──根本没人嘛。也是。"],["幻聴？","幻听？"],["単に、関連する日常の知識記憶が、\n連鎖的に再生されたのかな……[l]\n疲れてる時は、\n経験的音声が、耳鳴りみたいに聞こえる感じになる事があるにはある。","或许只是相关的日常知识记忆，\n被连锁性地重现了吧……[l]\n疲劳的时候，\n确实会出现经验性声音像耳鸣般回响的情况。"],["さても、\nそうして此処に来て、こうやって思考はしてみたものの、だ。[l]\nこんな砂浜で当然、昔つくったコドモの、\nしかも砂の造形物がみつかるわけもなく……","话说回来，\n虽然像这样来到这里尝试思考了。[l]\n这种沙滩上当然不可能找到当年和小孩子，\n而且还是用沙子堆的造物……"],["──そこでふと思った。","──这时突然想到。"],["この海岸で砂の城をつくったのがきぃでなくとも、\n別の機会に会っている可能性だってあるのだ。","就算在这个海岸堆沙城的不是小贵，\n也可能在其他场合见过面。"],["何故かすっかり、\nこの海岸で遊んでいたのがきぃという刷り込みがあったので、\nそれは冬夏ではないかという今の状況が、\n彼奴に対する疑念を生んだけども、","不知为何完全被，\n小贵曾在这片海岸玩耍的印象所束缚，\n导致现在冬夏可能是那个人的状况，\n引发了对那家伙的怀疑，"],["無理矢理ミステリーめいたものを想定しなくても、\n多分、事象として競合してはいないんではないか？","但就算不强行假设成悬疑事件，\n大概作为现象来说并不冲突吧？"],["あと、\n二個下の女子という条件までも被ったが故、\n事柄を余計に混同しちゃったのだろうかな。","还有，\n因为连「低两届的女生」这个条件都吻合，\n反而让事情更容易混淆了吧。"],["まあ基本的には、\n思い出した風景が此処、\nこの砂浜であったことから生じた誤解だと思う……[l]\n屋上で浮かんだ情景もそうだったから、","基本上觉得，\n是因为回忆起的风景在这里，\n这片沙滩而产生的误会……[l]\n之前在屋顶浮现的情景也是这样，"],["兎に角、","总之，"],["此処で確かに僕は少女達と出逢ってる……筈だ。[l]\n海岸なんてどこも一緒かも知れないし思い込みもあるだろうが、\n過去にこの土地に居て、","我确实在这里遇见过少女们……应该是。[l]\n可能所有海岸都差不多也有先入为主的因素，\n但过去曾在这片土地生活，"],["もっと早くに気付けよなあ、\n無駄に不安を煽りやがってさあ、僕の脳め！！","明明该更早察觉到的，\n害我白白焦虑了半天啊，我这蠢脑子！！"],["……何てアナクロかつ虚しいセルフツッコミだろう。","……多么老套又空虚的自嘲啊。"],["此処で僕と遊んでいた女子、\nそれが冬夏……と姫様ちゃん達だと確定したとしても、[l]\nきぃとは別の場所、別の機会に会ってる可能性は零じゃない。","在这里和我玩耍的女孩，\n即使确定是冬夏……和姫様她们，[l]\n和小贵在其他地方其他场合相遇的可能性也不是零。"],["そうだろう、そうだよな。[l]\n問題はない……","对吧，肯定是这样。[l]\n没有问题……"],["……何か釈然としない……","……总觉得不太痛快……"],["漠然と、\n不安だ。[l]\n何かに引っ掛かってる。","漠然地，\n感到不安。[l]\n像是被什么卡住了。"],["その漠として言い様のない感覚は、\n原因が視えないだけに余計に、\n焦燥感と共に、","这种模糊得难以名状的感觉，\n正因为看不清缘由，\n与焦躁感一同，"],["何かが欠けている、忘れている、という自覚が、\nアタマの奥の方にあって、\n物凄く居心地が悪い。","某种缺失了、遗忘了的自觉，\n在脑海深处存在着，\n令人极其不适。"],["此処まで関連してるならば、\nそっちも芋蔓式に思い出しそうなものなのに、\n何故か、\n……ま、まあ僕の記憶力の……所為か……","既然关联到这种程度，\n按理说应该能顺藤摸瓜想起来才对，\n可为什么，\n……嘛、大概是我记忆力……的问题吧……"],["脳内物質のバランスが崩れたのか、\n悪い方向へと思考が転がって、ころがって……？","是脑内物质平衡失调了吗，\n思绪朝着糟糕的方向滚动、翻滚……？"],["……ああ、腹減ったのか。[l]\n低血糖状態で、物理的理由で空転してたようだ。[l]\nそんなに時間経ってないと思ったが、\n時間を確認すると、","……啊，原来是饿了。[l]\n低血糖状态下，因为物理原因空转了啊。[l]\n本以为没过去多久，\n确认时间后，"],["「うあ、もう昼どきじゃん」","「呜哇，都到中午了」"],["そんなに時間経ってたとは……[l]\nよもや立ち眩んだ時に記憶が飛んだとか？[l]\nいや、","居然过了这么久……[l]\n该不会晕眩时记忆断片了吧？[l]\n不，"],["どうしたものか、\n行くなら早めに飯屋に行かないと、\n流石にこの辺でも時間帯では混むだろうし──","该怎么办呢，\n要去吃饭的话得趁早去餐馆，\n毕竟这地方到饭点肯定会很挤——"],["「ん」","「嗯」"],["携帯電話が振動してる。","手机在震动。"],["狩屋……の番号ではあるけれど、これは……","是狩屋……的号码没错，但这是……"],["「はい？」","「啊？」"],["「もしもし」","「喂喂」"],["「ああ、やっぱり姫様ちゃんね……」","「啊，果然是姫様啊……」"],["「やっぱり……？」","「果然……？」"],["「あいや、何でもにゃいですえっとその」","「啊呀没什么喵那个」"],["「にゃい……？」","「喵……？」"],["「いやいやいやその、なんでもないっす。[l]\n連想です連想。[l]\nな、何の御用ですかしら」","「不不不那个，真的没什么。[l]\n是联想啦联想。[l]\n请、请问有何贵干呢」"],["「遅れてごめんなさいあの、\n今学校終わったので、\n……今どちらですか……？」","「迟到了非常抱歉那个，\n现在刚放学，\n……您现在在哪里……？」"],["「え？[l]\nえーと今、\nあれ、なんてったっけな、海、砂浜に」","「诶？[l]\n呃现在，\n啊咧，叫什么来着，海，沙滩上」"],["「……碁石松原？」","「……碁石松原？」"],["「ああ、ああそれ。そこ。[l]\n車で来てるけど、戻るのにそこそこかかるかなあ……」","「啊，对对就是那儿。[l]\n开车过来的，回去可能要花点时间……」"],["「……分かりました、お待ちしてます」","「……明白了，我等您」"],["ぶつ。","咚。"],["切れた。","挂断了。"],["あれ？","嗯？"],["若干話途中で電波状態悪くて切れたような感じだったけど、\n普通に切れてもおかしくはない会話の区切りではあったから、\n多分いいのかなあれで……","虽然感觉像是通话中途信号不好断掉的，\n但那个对话节点正常挂断也不奇怪，\n应该没问题吧那样……"],["話途中だったら掛け直して来るだろうし、\nお互いリダイヤルし合って話し中になると切ねえ事になるで。","要是没说完会再打过来的，\n互相重拨导致占线就永远接不通了喂。"],["……あとなんか妙に小声だったような、[l]\nでも、姫様ちゃんてそんなもんか。","……还有总觉得她声音特别小，[l]\n不过，姫様本来就这样吧。"],["「……は、[l]\nじゃあ移動しなきゃあ」","「……哈，[l]\n得动身了啊」"],["にしても立て続けにイベント起きるなあ。[l]\n大神が言う所の何フラグが立ったとか立たないとかってやつ？[l]\n電話きっかけばっかですが。","话说回来事件接二连三呢。[l]\n就是大神常说的什么flag立没立之类的？[l]\n不过全是电话引发的。"],["「いやあ、フラグというか……[l]\n物事が起きるタイミングが絶妙というか……」","「哎呀，与其说是flag……[l]\n不如说事情发生的时机太过微妙……」"],["良くも悪くも、なのが問題ではあるけども……","问题在于好坏参半这点啊……"],["何とかの法則みたいにこう、\n風呂に入った途端に宅配が届くとか、\nお手洗いに入った途端に宅配が届くとか、\n発売日に届くと思ってた宅配がその日来なかったりとか、","就像某种法则一样，\n刚泡进浴缸快递就送到啦、\n刚进洗手间快递就按门铃啦、\n以为发售日必到的快递偏偏当天没来啦、"],["……最後は違うしこれ、\n宮さんのとこでバイトしてたときの話ばっかやがな。","……最后这条不算啦、\n全是在宫小姐那儿打工时的破事儿。"],["あのひとの頼んだ通販の受け取り、よくやったものよ……[l]\n客も来ないから、或る意味それがメイン仕事と言っても過言では、\nげふげふ。","那个人订购的邮购商品，我可没少帮忙签收呢……[l]\n反正也没客人来，说那是主要工作都不夸张、\n咳咳咳。"],["まあ、あとは誰も居ないと思って鼻歌歌ったら、\n後ろから自転車来てて超恥ずいとか、\nそういう下らないレベルまでいったら結構な勢いで起こるけど。","还有就是以为没人在就哼歌、\n结果后面突然冒出自行车超尴尬啦、\n这种鸡毛蒜皮的小事倒是接二连三发生呢。"],["だから最近事が起きすぎてると言うのは、\nたまたまというか気の所為ではあるのだろうが、\nそこを敢えて電話きっかけ多し！と感じるのは、","所以最近总觉得事情发生得太密集、\n虽然应该只是巧合或者心理作用、\n但硬要说是电话引发的就太多啦！"],["い、いや、\nそれにはまあ理由がありまして、\n友人が少なかった僕は、\n殆ど電話が掛かってくる事が無かったのですよ。","不、不是、\n这个嘛其实有原因的、\n因为朋友很少的我、\n平时根本不会接到什么电话啊。"],["大神とは直に会えるしいちいち電話する事も特に無かった。[l]\n彼奴や宮さんとかを","和大神直接就能见面也不用特地打电话。[l]\n看那家伙和宫小姐他们"],["端から視てる限り、\n実際比較しても僕の電話掛かって","整天煲电话粥的样子、\n相比之下我的来电频率"],["来率は異常に低く、","简直低得异常、"],["まあ、だからこういう感じの頻度で電話来るのは、\n普通なのかも知れないけどね……","所以现在这种电话频率、\n对普通人来说可能很正常吧……"],["僕にとってはフラグとやらが立ったも同然の大イベントでもあるわけですよ！[l]\n電話が来ること自体が！","但对我来说可是相当于立了flag的大事件啊！[l]\n光是接到电话这件事本身！"],["「……なんかどんどん切なくなるな……」","「……越说越心酸了呢……」"],["そんな事考えてる間に、\nとっとと向かおう。[l]\n姫様ちゃんの機嫌を損ねると……","就在胡思乱想的时候、\n赶紧出发吧。[l]\n要是惹姫様不高兴……"],["……よく判らないが何か後々大変そうだし……[l]\nそうなると狩屋が可哀想だしな……","……虽然不清楚具体会怎样但总觉得后患无穷……[l]\n那样的话狩屋就太可怜了……"],["冬夏との記憶の事は、\nまた後で考えよう。[l]\n恐らくこれ以上は物的証拠を探すしか検証方法無い気がします。","关于和冬夏的记忆、\n还是之后再想吧。[l]\n现阶段恐怕只能寻找物证来验证了。"],["それは、冬夏と誕生日の時にでも、\n色々聞いてみるか……[l]\n返事はまあ、それもどうにかしないといけないけど……","等冬夏生日的时候、\n再好好问问看吧……[l]\n回复的事嘛……那个也得想办法才行……"]],"context":[["SC_M_038.ks/index/1/text"],["SC_M_038.ks/index/3/text"],["SC_M_038.ks/index/5/text"],["SC_M_038.ks/index/7/text"],["SC_M_038.ks/index/9/text"],["SC_M_038.ks/index/11/text"],["SC_M_038.ks/index/13/text"],["SC_M_038.ks/index/15/text","SC_M_038.ks/index/17/text","SC_M_038.ks/index/155/text","SC_M_038.ks/index/330/text","SC_M_038.ks/index/332/text","SC_M_038.ks/index/409/text","SC_M_038.ks/index/494/text","SC_M_038.ks/index/496/text"],["SC_M_038.ks/index/19/text"],["SC_M_038.ks/index/21/text"],["SC_M_038.ks/index/23/tex