":525,"end":559}],[{"start":571,"end":624}],[{"start":660,"end":693}],[{"start":723,"end":735}],[{"start":745,"end":757}],[{"start":789,"end":820}],[{"start":850,"end":862}],[{"start":874,"end":883}],[{"start":919,"end":949}],[{"start":961,"end":973}],[{"start":1007,"end":1085}],[{"start":1094,"end":1095}],[{"start":1104,"end":1105}],[{"start":1114,"end":1142}],[{"start":1176,"end":1213}],[{"start":1221,"end":1244}],[{"start":1252,"end":1339}],[{"start":1345,"end":1365}],[{"start":1375,"end":1394}],[{"start":1404,"end":1420}],[{"start":1426,"end":1513}],[{"start":1519,"end":1527}],[{"start":1539,"end":1556}],[{"start":1562,"end":1574}],[{"start":1580,"end":1597}],[{"start":1603,"end":1611}],[{"start":1617,"end":1625}],[{"start":1631,"end":1631}],[{"start":1660,"end":1669}],[{"start":1746,"end":1766}],[{"start":1794,"end":1801}],[{"start":1811,"end":1826}],[{"start":1841,"end":1849}],[{"start":1857,"end":1870}],[{"start":1902,"end":1918}],[{"start":1926,"end":1955}],[{"start":1981,"end":2035}],[{"start":2067,"end":2109}],[{"start":2141,"end":2199}],[{"start":2260,"end":2336}],[{"start":2344,"end":2387}],[{"start":2421,"end":2467}],[{"start":2499,"end":2531}],[{"start":2565,"end":2573}],[{"start":2601,"end":2635}],[{"start":2667,"end":2674}],[{"start":2700,"end":2716}],[{"start":2724,"end":2781}],[{"start":2813,"end":2835}],[{"start":2843,"end":2881}],[{"start":2907,"end":2922}],[{"start":2978,"end":2987}],[{"start":3013,"end":3029}],[{"start":3063,"end":3076}],[{"start":3102,"end":3105}],[{"start":3111,"end":3114}],[{"start":3120,"end":3127}],[{"start":3135,"end":3145}],[{"start":3153,"end":3157},{"start":3165,"end":3169},{"start":3177,"end":3181}],[{"start":3189,"end":3198}],[{"start":3206,"end":3234}],[{"start":3266,"end":3271},{"start":3406,"end":3411},{"start":3510,"end":3515}],[{"start":3297,"end":3340}],[{"start":3348,"end":3374}],[{"start":3437,"end":3445}],[{"start":3453,"end":3478}],[{"start":3541,"end":3554}],[{"start":3562,"end":3634}],[{"start":3666,"end":3674}],[{"start":3700,"end":3734}],[{"start":3742,"end":3808}],[{"start":3844,"end":3862}],[{"start":3890,"end":3898},{"start":4013,"end":4021}],[{"start":3934,"end":3952}],[{"start":3978,"end":3981}],[{"start":3989,"end":4005}],[{"start":4029,"end":4037}],[{"start":4045,"end":4059}],[{"start":4067,"end":4083}],[{"start":4091,"end":4098}],[{"start":4106,"end":4121}],[{"start":4129,"end":4137}],[{"start":4145,"end":4154}],[{"start":4162,"end":4177}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_049.ks","basename":"SC_M_049.ks","indexIds":{"@r冬夏は言った。":0,"@rこれ、\n\n道具さんのねこのチカラ。":1,"\n\n\n\n\n──四ツトヤ、\n　　よにかまかきまず、\n　　ＣＡＴＧ、ＧＵＡＣ、ＣＭＹＫ、\n　　赤黒白青、明暗顕漠、\n　　つくれまじょのくすり──":2,"\nほんとうは卑尊さんの、":3,"\n\n\n\n\n──三ツトヤ、\n　　みすばるよみがえれ、\n　　（ＴＴＡＧＧＧ）×∞？\n　　ＥＳ、\n　　つくれさいせいのめ──":4,"\nあの２人は、\n七つの中でもそういった方面を司るの。":5,"\nでも、\n\nあの２人は、\n\nこわしたり、●●したりする方面を司る。":6,"\n\n\n\n\n──一ツトヤ、\n":7,"\n──七ツトヤ、":8,"\n大黒や玖威は、":9,"\n\n\n\n\n──八ツトヤ、\n":10,"\n──六ツトヤ、":11,"\n玉梓は、":12,"\n\n\n\n\n──五ツトヤ、":13,"\n\n三春は、":14,"\n\n\n\n\n　　ふこのみにしてけっかいもるけっかい、\n　　カミシデグルリトマク、\n　　Ｅ＆Ｅ、ヒとメ、":15,"自":16,"他":17,"分かつちから、\n　　たもてぜったいりょういき──":18,"\nわたしね、\n\nわたしたちのいえには鉄の掟がある。":19,"@rそれ、……いえない、いえっ、ないよぅ、":20,"\n冬夏は嗚咽する。\n\nわたしは自分の眼を●ったの。[l]\nそれでも、こうやって、……それが、わたしたちの、[l]\nネコガミの、":21,"だから、だけど、こんなチカラ、のために、":22,"\n\n\nごめん。":23,"@rいいよ、説明しなくても。":24,"@r眼前にあるものを拒絶するには及ばない。[l]\n恣意的な欺瞞を信用はしないけれど、\n僕等は同じものを視てるじゃないか。[l]\n大神だってきっと、":25,"\n……？":26,"@rそれは、これら視えるもの、":27,"ＣＡＴのちからのはなし、":28,"\nｃｏＭＭａｎｄＭｅｎｔ？":29,"@r鉄の掟？":30,"@rトーカ？":31,"@r":32,"なぜ、ないてるの？":33,"「冬夏？[l]\nなにがあった？」":34,"長い軟禁状態で":35,"半ば麻痺していた僕の思考が、\n":36,"漸く動き出した。":37,"いや、ま、まだ空転してる。":38,"「冬夏、\n冬夏、大丈夫？":39,"こ、こっちにきて、\n落ち着こう、\nまずは」":40,"冬夏の声がやっと現実のものとして聞こえる、\n僕は今まで一体何してた？[l]\n何を考えていた？":41,"「……ごめん、ごめんなさい、[l]\nぃえない……いまは……ごめんなさい……」":42,"「う、ああ、それならそれでいい、\nその、眼のことも僕は気にしてない、\nだからまずこっちで座って──」":43,"「どうしたら……いいのか……わかんない……[l]\nごめん、こんな……とこ……みせたく……ないから……[l]\nきょうは……ごめんなさい……":44,"だから、\nぜったい……誕生日に……あそこで……[l]\nあの砂浜で……」":45,"「わかった、約束する、\n何かあったらすぐ呼んでくれればいいから、\nだから、」":46,"「……ありが……と、[l]\nまことさん……ア……イ……」":47,"「……あっ……」":48,"──冬夏は落ちた眼帯を拾って、\n足早にこの場から立ち去った。":49,"「……とうか」":50,"僕は数分、其処に立ち尽くしてた。":51,"そして、\n僕の鈍磨した精神が、ようよう空転（アイドリング）を終え、\n混乱と激しい後悔が押し寄せる。":52,"「何があった……？[l]\n学校……？":53,"アヤメ、カリヤ……[l]\nテツノオキテ……[l]\n僕は……」":54,"僕は、\nなにをしてる？":55,"「宮さんっ！！！」":56,"こんな、ときに、\nなぜ、":57,"「会えないんだよっ！！！」":58,"声が、":59,"話が、":60,"僕はもう！！！":61,"どうしたらっ、──、":62,"………。":63,"少し冷静になろう。":64,"駄目元で、知狡さんを介さずに宮さんの番号に電話してみる。":65,"「………」":66,"数回呼び出し音が鳴った後、\n留守番電話サービスへの切り替えアナウンスが流れた。":67,"一旦切って数秒間を置いて、\nリダイヤルする。":68,"同じ声が流れる。":69,"──もう一度だけ、\n間を置いて掛け直した。":70,"……僕は無言で通話を切る。":71,"冬夏……は今は声を掛けられないだろう。[l]\nそっとしておくことしか、できない……[l]\n僕なんかじゃ……なにも……できない……":72,"「みやさん……」":73,"貴女が僕を此処に連れてきた、\n貴女がいたから僕はここにいる、":74,"そして彼女達に会った、\nいろんなことがおきて、\nいろんなことをあなたに、\nあなたにはなさなきゃいけないのに、":75,"「なんで……はなせないんだよぉ……」":76,"──ＹＥｒｅｃｔ":77,"「ぼくはもうおかしくなりそうだ──」":78,"ああ。":79,"今日も過ぎていく、あえないまま。":80,"──ＹＥｌｅｃｔ":81,"──ＹＥｌｅｃｔｒｉｃｉｔｙ":82,"なぜ、僕のアイてをしてくれない、":83,"猥が歪がＹが、":84,"僕の中でこんなにも荒ぶるのに、":85,"だから僕を視て、":86,"お願いだから僕を、":87,"──Ｅ　Ｙ　Ｅ　Ｅ　Ｘ　Ｅ──":88},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_049.ks","relPath":"/data/scenario/SC_M_049.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":80,"length":89,"percent":89.8876404494382},"cellInfo":[]},"/data/scenario/SC_M_050.ks":{"data":[["@r食べる気がしない。","@r没胃口吃东西。"],["@rそれでも腹は空く。","@r可肚子还是会饿。"],["@rでも、頭は動くことを拒否する。","@r但大脑拒绝思考。"],["@rだから身体が動かない。","@r所以身体动不了。"],["@rでも腹は空く。","@r可肚子还是会饿。"],["@r今日はもう、２１日だ。","@r今天已经是21号了。"],["@rすっかり時間感覚はおかしくなっている。","@r时间感彻底混乱了。"],["@r幾ら知狡さんだって毎度毎度来てくれる訳じゃない。[l]\nどうしても我慢できない時は水を飲んだりしていた。[l]\n僕は、\nなにしてる。[l]\n今は、横臥してる。[l]\n何かを忘れてる気がする。[l]\nでもあたまをうめるのは、","@r就算是知狡也不可能每次都来。[l]\n实在忍不住时就喝点水。[l]\n我，\n在干什么。[l]\n现在，正躺着。[l]\n总觉得忘了什么。[l]\n但填满脑袋的，"],["「……待つのはイヤだ、[l]\n待つのはイヤだ、待つのはイヤだ、待つのは……いやだ……」","「……不想等待，[l]\n不想等待，不想等待，不想……等待……」"],["@rあのひとはなにを考えてるのだろう。","@r那个人在想什么呢。"],["@r僕の事を少しでも考えてくれてるだろうか。","@r有没有稍微想过我的事呢。"],["@rそれとも、\n@r他の何かを考えてるのだろうか。","@r还是说，\n@r在想其他事情呢。"],["@r僕も、本来ならば、色々と考えなければならない事項が、\n山程ある筈なのに、\nここ数日に起きた沢山の色んなこと、\nそれを考えるのが普通だろうに、\n浮かぶのはあのことだけ、\nあたまのなかはそればかり、\nまるで、","@r我本来也有，\n堆积如山要考虑的事，\n这几天发生的种种，\n本该好好思考才对，\n浮现的却只有那件事，\n满脑子都是那个，\n简直就像，"],["@r──●●わずらい、それは望みなければ、\nしにいたるやまいと同じだ。","@r──●●烦恼，若不怀抱希望，\n便是与致死的疾病无异。"],["@r……なんだそれ？","@r……这是什么？"],["@r僕が？","@r说我？"],["@r●●わずらい？","@r●●烦恼？"],["@rそんな、こと、あるか。","@r怎么可能。"],["「待たされてるから気が気でないだけだ」","「因为被迫等待才心神不宁罢了」"],["@r口に出すと独り言になって自分でも気持ち悪い。","@r说出口就成了自言自语，连自己都觉得恶心。"],["でも、","但是，"],["@r",""],["久々に声を出した気がする。[l]\nそして、\n自分の身体を、現実を実感すると、\n急にチカラが入った。[l]\nつまり自覚するチカラ、\nセカイと向き合う意思だ。[l]\nしっかりと前を向き、\n@r──それが我等の理だからな。","感觉好久没发出声音了。[l]\n然后，\n当切实感受到自己的身体，现实时，\n突然涌出了力气。[l]\n就是自觉的力量，\n直面世界的意志。[l]\n稳稳地向前看，\n@r──此乃我等之理。"],["@r逃げたところで解決はしない、\n自分から取り組むしかない、\n自力で……","@r逃避解决不了问题，\n只能主动面对，\n靠自己……"],["@rむっくりと、ゆっくりと起き上がる。","@r慢吞吞地，缓缓起身。"],["「要するに、\n背に腹は代えられないって事だよな……」","「说到底，\n就是不能因小失大对吧……」"],["格好付けて厭世観に浸って鬱々としても、\n何も変わらない、\nいや、赤ん坊と一緒だ。[l]\n泣き叫ぶ事で、興味を自分に向けたいのだ。","就算装模作样沉浸在厌世观里郁郁寡欢，\n什么都不会改变，\n不，简直和婴儿没两样。[l]\n通过哭喊来吸引别人对自己的关注。"],["僕を視てと、\n僕に構ってと、\n僕を愛してくれと、\nそう言いたかったのだろう。","看着我对我说，\n来关心我对我说，\n来爱我对我说，\n是想这么说吧。"],["でも僕は赤ん坊じゃない。","但我可不是婴儿。"],["だから、","所以，"],["「まずは、ちゃんと何か食べよう……[l]\n腹が減っては","「总之先好好吃点东西……[l]\n饿着肚子"],["軍はできぬ」","打不了仗」"],["冬夏も気になる。[l]\nあれから何の連絡もない。","冬夏也让人在意。[l]\n从那之后就没联系过。"],["携帯電話の電源は……勿論入れっぱなしで、[l]\n鬱々とはしながらもチェックは","手机电源……当然是开着的，[l]\n虽然消沉但还是"],["忠","忠"],["実にしてたから、\n着信にしろ何にしろ、\n来てないってことは来てないのだろう。","实地检查着，\n不管是来电还是什么，\n没来就是没来吧。"],["今何時だ？[l]\nもう、学校行ったか？[l]\n帰ってきた頃か？","现在几点了？[l]\n已经，去学校了吗？[l]\n还是快回来了？"],["……今、何時だ？","……现在，几点了？"],["携帯電話で確認すれば良いものを、\n本能的に窓の外の、空の明るさを確認しに向かう。","明明用手机确认就好，\n却本能地望向窗外确认天色。"],["「……曇っててわからん」","「……阴天看不出来」"],["夜でないのが分かるだけだ。","只能确定不是夜晚。"],["「まあいいか……腹減ってそれどころじゃにゃいにゃー」","「算了……饿得没空管这些喵喵——」"],["にゃー……[l]\n狩屋……も何してるんだろ。[l]\n彼奴も、姫様ちゃんも、\nアワネバナラナイ──よな。","喵——……[l]\n狩屋……在干什么呢。[l]\n那家伙也好，姫様也好，\n都永远不会消失——对吧。"],["「……う」","「……呜」"],["狩屋の……感触から冬夏の画像やら、[l]\n連鎖的におかしな方向へ思考が。[l]\nそういうのは別腹とか言いたくないが、\n食欲睡眠欲と共に、抗い難き本能のひとつと言うか、\n……でも冬夏にさんざ枯れてるって言われるくらいでは[l]\nあるんだけどなあ……[l]\n自分でも多少そう言う傾向があるとは思ってたのに、\nどうも最近、\n以前より割と露骨に、否、何かが違うな……[l]\nそいういうんじゃない……[l]\nスキとかキライとか、なんかそういうのがストレートに、\n……まあいいや。[l]\n健全な証として、それはそれ、今はスルーしときます……","从狩屋的……触感联想到冬夏的画面，[l]\n思绪开始往奇怪的方向连锁。[l]\n虽然不想说什么这是另一个胃，\n但和食欲睡欲一样，算是难以抗拒的本能之一吧，\n……不过被冬夏说已经枯竭到那种程度[l]\n倒也是事实……[l]\n虽然自己也觉得有点这种倾向，\n但最近总觉得，\n比以前更露骨了，不，是有什么不一样了……[l]\n不是那种感觉……[l]\n喜欢啊讨厌啊，这类感情变得特别直白，\n……算了不管了。[l]\n作为健全的证明，这事就先放一边吧……"],["閑話休題。","闲话休提。"],["取り敢えず、\n知狡さんと会えたら色々聞こう。","总之，\n见到知狡阿姨再打听吧。"],["ということで、\nふらつく身体に活を入れつつ、準備をして食堂に向かった。","这么想着，\n给摇摇晃晃的身体打气，收拾好去了食堂。"],["するべきことが沢山ある筈なんだが、\nすべてが混淆としていて只管に煩雑した頭の中身では、\nもう下手の考え休むに似たりという奴で。","明明应该有很多该做的事，\n但所有事都混在一起让脑子乱成一团，\n简直像笨蛋思考过度反而停摆。"],["──まずはクウことだ。","——首先是空腹这件事。"],["それが基本だもんね。","这是基本呢。"],["──他を取り込みワガミとすることだ。","——将其他事物纳入我身这件事。"],["──無喰阿礼（ムクイアレ）……","——无喰阿礼（MUQUIARE）……"],["そう、喰って、","没错，吃了，"],["は？","哈？"],["「早く何か喰わなきゃ……[l]\nどうも今までの脳空転とは」","「得赶紧吃点东西……[l]\n感觉和之前的大脑空转"],["レベルが違う気がする。","完全不是一个级别」"],["でも、\n違和感はあるが、今までと違う、という違和感であって、\nこういう『印象の流入』自体は別段気にならない。[l]\n寧ろ自然だ。","可是、\n虽然有种违和感，但那是与以往不同的违和感、\n这种『印象的流入』本身倒并不特别在意。[l]\n不如说很自然。"],["あるべき感覚、あるべき存在、あって当然、\nと思ってみたりもするが、\n単なる自問自答でないのか、とも思ったり、","应有的感觉、应有的存在、理所当然、\n虽然也会这么想、\n但也会怀疑这不过是在自问自答、"],["いずれ、\n混乱、混沌としつつも、\n何かしら懐かしい、\n安堵感というか、落ち着くというか、","总之、\n混乱着、混沌着、\n却又莫名怀念、\n有种安心感或者说平静感、"],["でもやっぱりそれとは別に\n湧き上がる、ワイが──\nあのひとにはやくアイたいという重い想いが、\n無駄に神経を苛むので、","但果然除此之外\n涌上来的、俺对──\n那个人急切想见爱的沉重心情、\n徒然折磨着神经、"],["「……いい加減、[l]\n早くしてくれねぇかなぁ。[l]\n電話もメールも駄目ってどんな状態だよ。[l]\nここには居るんだろうに、会えないだけならまだしも、」","「……差不多、[l]\n能不能快点啊。[l]\n电话短信都不行这算什么状态。[l]\n明明就在这儿，光是见不到也就算了、」"],["勘違いしそうだよもう。[l]\nこの気持ちはいったいなんなん……","都快让人误会了好吗。[l]\n这份心情到底是什么……"],["──吊り橋の出会いか或いは、刷り込みか限定選択肢か……いずれ、","──是吊桥效应的相遇还是印随反应或限定选项……总之、"],["勘違いというかなるべくしてなったというか、\nでも●●ってそういうもんでしょ？","说是误会也好说是必然也罢、\n但●●不就是这么回事吗？"],["感情だの論理だのどっちかじゃなくて、インタラクティブなもんだし、相補的なんだよ、だから、","既非感情也非逻辑而是互动性的、互补性的啊、所以、"],["──●●なのかな、あれを。","──那算是●●吗。"],["知らないよ。[l]\nただ今は兎に角辛いだけだ。[l]\nつらいってことは、………","不知道啦。[l]\n总之现在就是难受得要命。[l]\n难受就是说、………"],["「宮さんにあいてえ……」","「好想见宫小姐……」"],["はっ。","啊。"],["なになになになになにをいった？！","刚刚说了什么什么什么什么？！"],["だっ、","应、"],["誰も聞いてないよな？！","没人听见吧？！"],["「いかん、いよいよ病んできたぞ！[l]\nはやく何か喰おう、でないともう思考が暴走して」","「不行、真的开始不对劲了！[l]\n得赶紧吃点东西，不然思维要暴走了」"],["──",""],["一",""],["頻り頭を掻き","拼命抓挠着头"],["毟って、\n僕はものを喰いに向かった。","撕扯着、\n我走向了吃东西的地方。"],["「……あ、知狡さん」","「……啊、知狡阿姨」"],["ロビーを経由中、知狡さんと会った。","经过大厅时遇见了知狡阿姨。"],["「……ああ、真言か、[l]\nひさし……ぶりか？[l]\nこのところ慌ただしくてな……時間感覚が」","「……啊啊、真言啊、[l]\n好久……不见？[l]\n最近忙得……时间感都」"],["「ああ、まだ、お忙しいんですね……[l]\nやっぱり、あのひとも……？」","「啊、还在、忙着呢……[l]\n果然、那个人也……？」"],["「ああ、そう、なる。[l]\n……すまん」","「啊、嗯、是啊。[l]\n……抱歉」"],["「いえ、謝られても、ええ」","「不、被您道歉也、那个」"],["知狡さんに謝られても。[l]\n何も解決しない──\nたったひとつの解決法がなされない限りは、","被知狡阿姨道歉。[l]\n什么都解决不了──\n除非那唯一的解决方法实现、"],["「……顔色が悪いな。[l]\nちゃんと食べてるか？」","「……脸色很差啊。[l]\n有好好吃饭吗？」"],["「え？[l]\nあ、いえ、\nなので今からちゃんとした食事を……」","「诶？[l]\n啊、不是、\n所以现在正要去正经吃顿饭……」"],["「そうか……[l]\n体力つけておけ。[l]\n精神にも影響するからな。","「这样啊……[l]\n保持体力。[l]\n对精神也有影响。"],["逆もまた然りだが、\n物理的に","反过来也一样、\n物理上"],["梃","撬"],["子入れ出来るだけ身体の方がまだマシだ。[l]\nちゃんと良いもの食べるんだぞ」","能往身体里塞东西还算好的。[l]\n要好好吃有营养的东西啊」"],["そう、\n精神的には、\n解決法は、","是啊、\n精神上、\n解决方法、"],["「……真言？[l]\n真言？[l]\n大丈夫か？」","「……真言？[l]\n真言？[l]\n没事吧？」"],["「えあっ、\nあ。[l]\nす、すみません、大丈夫です」","「诶啊、\n啊。[l]\n对、对不起，我没事」"],["「……もう少しの辛抱だ」","「……再忍耐一下就好」"],["「は、あ、そうです、ね……[l]\nあと１週間ほど、\nそうか、此処も色々忙しくなるんですね……","「哈、啊、是这样、呢……[l]\n还有一周左右、\n这样啊，这里也要开始忙起来了呢……"],["部屋からあまり出なかったんで気付きませんでしたが、\n客も──」","因为一直没出房间所以没注意到、\n客人也──」"],["と視回すと、ロビーの時計が視界に入った。","环视四周时，大厅的时钟映入眼帘。"],["「……どうした？」","「……怎么了？」"],["「今、６時……ですか？[l]\n午後、ですよね？」","「现在、6点……吗？[l]\n是下午、对吧？」"],["「？[l]\nあ、ああ。[l]\nそうだ」","「？[l]\n啊、啊啊。[l]\n是啊」"],["午前の訳はない。","不可能是上午。"],["「冬夏って学校行きましたか？」","「冬夏去学校了吗？」"],["「私は確認してないが……[l]\n行ったんじゃないのか？[l]\n部屋には居ない……だろう」","「我没确认过……[l]\n应该去了吧？[l]\n她不在房间里……大概」"],["「今日は……２１日の、金曜日か……」","「今天是……21号、星期五吗……」"],["帰り、遅いのかな……","回来、好晚啊……"],["「……どうかしたのか？」","「……出什么事了吗？」"],["「いえ、\nまあ、なんでもないです。[l]\n僕以上に、大変そうだったんで……」","「没有、\n嘛，没什么。[l]\n看起来比我还要辛苦的样子……」"],["「──そうか」","「──这样啊」"],["「じゃ、ご飯食べてきます。[l]\nもう夕飯ですねこの時間じゃ。[l]\n知狡さんも無理しないでくださいよ。","「那、我去吃饭了。[l]\n这个点已经是晚饭时间了呢。[l]\n知狡阿姨也别太勉强自己。"],["そっちも結構な顔色なんですから。[l]\nでは」","你脸色也相当不好看啊。[l]\n先走了」"],["知狡さんはまだ何か言いたそうだったが、","知狡阿姨似乎还想说什么、"],["……これ以上このコンディションで喋り続けるのは、\nこのひとにも失礼だ。","……但以这种状态继续交谈、\n对她也太失礼了。"],["かなり復調してきたとは言え脳は空転しっぱなしで、\n相手を気遣いながら話すという器用な真似は出来そうにない。","虽说恢复了不少，但脑子还是空转着、\n实在没法边顾虑对方边说话。"],["という訳で、\nそのまま僕は食堂に向かった。[l]\nすみません知狡さん。","所以、\n我就这样走向了食堂。[l]\n对不起啊知狡阿姨。"],["久々にちゃんとした食事をすると、\nとんでもなく幸せな気分になった気がした。[l]\nなんつーの、塩味が異常に味覚を刺激するっつーか、\n思わずいつもの１．５倍くらいは食してしまった。[l]\n頭にずっと何かしら引っ掛かるものがあって、\nきぃみたいな……否、彼奴の域にはどうやったって行かないだろうけど、[l]\n無茶食いはしなかった。","久违地吃了顿正经饭、\n感觉幸福到不可思议。[l]\n该怎么说呢，咸味异常刺激味觉之类的、\n不知不觉吃了平时1.5倍的量。[l]\n脑子里一直卡着什么东西、\n像小贵那样……不，虽然肯定达不到那家伙的境界、[l]\n倒也没暴饮暴食。"],["と言うよりも、\n自制心がそういう風に働いた分、\nやはり空元気的な無理も同時に浮き彫りになって、\nなんか切ないので、\nだから『なった気がした』なんだけれど……","或者说、\n正因为自制心这样运作着、\n强撑出来的勉强也同时暴露无遗、\n莫名觉得心酸、\n所以才说是『感觉幸福』啦……"],["風呂も済ませてあとは寝るだけ、\nという時間になっても、\n誰からも何もなかった。","洗完澡就只剩睡觉、\n即使到了这种时候、\n也没有任何人联系我。"],["無意味に冬夏の部屋の前まで行ってみたりしたけれど、","虽然毫无意义地走到冬夏房门前看了看、"],["「………」",""],["気配やら何やらで、\n部屋には居る……と思うが……","从气息啊什么的来看，\n应该是在房间里……不过……"],["帰ってきたのに何も連絡ないと言うことは、\nまあ、\n用事も無いんだろう。","回来了却没有任何联系就是说，\n嘛，\n大概也没什么事吧。"],["まだ立ち直ってないかも知れないし、\nわざわざこっちから行くのも何か気が引けた……というか、[l]\n僕には何もできやしないし、\nそう冬夏も思ってるから何も言って来ないんだ、ろうし……","可能还没振作起来，\n特意主动过去也总觉得有点顾虑……或者说，[l]\n我什么都做不到，\n冬夏肯定也是这么想所以才没联系我的吧……"],["「……僕はなにも、[l]\nだれにもなにも、\nだれからも、」","「……我什么都，[l]\n对谁都什么都，\n从谁那里都，」"],["……悲劇の主人公にひたりそうになる","……差点就要陷入悲剧主人公的情绪"],["弱","脆"],["弱精神状態を、[l]\n何とか奮い起こして、\n努めて冷静に、部屋に戻ろうとすると、","脆弱的精神状态，[l]\n勉强打起精神，\n努力保持冷静正要回房时，"],["「……おや」","「……哎呀」"],["「あ、どうも……」","「啊，你好……」"],["いつも以上にクマが酷そうに視える……気のせいだろうけど、[l]\nそんなチノ嬢が通り掛かった。","黑眼圈看起来比平时更严重了……虽然可能是错觉，[l]\n千乃小姐这么说着擦肩而过。"],["「お元気……ではない？[l]\nいや、中々に前向き……ん？[l]\nまあどっちでもいいんですが、\n食事をきちんとするのは好いことですよ。","「精神不错……其实没有？[l]\n不对，倒是挺积极……咦？[l]\n啊算了无所谓，\n好好吃饭是好事哦。"],["そうやって循環させないと活性しないんですかねモノは。[l]\nその所為かこのセカイは喰う喰われるのが前提の最悪の──」","不这样循环运转的话物体就无法活化吧。[l]\n所以这个世界才建立在吃与被吃的基础上真是最恶的──」"],["「ハコニワですね、ワカリます。[l]\nところで──」","「箱庭呢，我懂的。[l]\n话说──」"],["そこでチノ嬢は一瞬、\n不思議なモノを視るような感じで僕を注視した──ように視えた。[l]\nしかしすぐにいつもの調子で続ける。","这时千乃小姐突然，\n用看着什么不可思议之物的眼神凝视着我──至少看起来是这样。[l]\n但立刻又恢复常态继续道。"],["「──ああ、店長でしたらね、\n今のアナタには精神衛生上言いたくありませんが、\nまだご多忙です。","「──啊，店长的话呢，\n现在的你听了会影响心理健康所以不想说，\n依然很忙。"],["ですが決して","但请务必"],["荒むこと無きようお願い致します。[l]\nそういうのは……厭がられますよ。","不要自暴自弃。[l]\n那种样子……会让人讨厌的。"],["いえ、お気持ちは十分ワカリます。[l]\nが、荒れるアナタの周囲も困りますしそういうのは誰も得をしませんので」","不，我非常理解你的心情。[l]\n但暴走的你会让周围困扰，这样对谁都没好处」"],["「……あはは……[l]\nいや、その」","「……啊哈哈……[l]\n不是，那个」"],["「決めるのはアナタです。[l]\nそれがスクイです。[l]\nですから──」","「决定权在你。[l]\n这就是挤压。[l]\n所以──」"],["くれぐれもコウカイのない決断を願います。","请务必做出没有后悔的决定。"],["「チズルもワタシも、\nアナタのこと、\n結構アイしてますから。","「小知也好我也好，\n对你的事，\n都是相当爱护的。"],["決してデスペレートにミを委ねる事無きよう、\n視野を狭くなさらぬよう。[l]\n","请不要在绝望中交出自己，\n不要窄化视野。[l]\n"],["過つこと無きよう。貴方に──」","愿你永不犯错。对你──」"],["Omegaの瞳の祝福あれ。","献上Omega之瞳的祝福。"],["「お、めがの……なにがあれ？」","「眼、眼睛的……什么来着？」"],["そこでチノ嬢は一瞬、\nやっぱり不思議なモノを視るような感じで僕を注視した──ように視えた。","这时千乃小姐突然，\n果然又用看着什么不可思议之物的眼神凝视着我──至少看起来是这样。"],["「……こころやすらかなるをみのすこやかなるを」","「……愿心灵安宁身体康健」"],["「え？[l]\nあ、りがとう、ございます……」","「诶？[l]\n啊，谢谢，您……」"],["チノ嬢は","千乃小姐"],["恭しく一礼すると、\n廊下の向こうに去っていった。","恭敬地行礼后，\n消失在走廊尽头。"],["……僕はそのまま部屋に戻った。","……我就这样回到了房间。"],["何度も何度も、何度も何度も、\n携帯電話を確認したけど、\n誰からも何も、なかった。","一次又一次，一次又一次，\n虽然确认了手机，\n但谁都没有、任何消息。"],["──幾歳も経てど待つ事ばかりは耐え難きこと、\n　　ワレも","──历经岁月仍难耐等待之事，\n　　吾亦"],["寝","睡"],["子なれば寝て待つがただヒトつかしこき水牙、\n　　","子故卧待唯此一狡智水牙，\n　　"],["睡","眠"],["臥するのみと知る、","仅知卧伏，"],["……寝よう。","……睡吧。"],["寝れば、\n@r……何か忘れてる気が、","睡着的话，\n@r……总觉得忘了什么，"],["今度の日曜の事ではなくて、なんだったか、\n@r……もう、寝ようよ。","不是这周日的事，到底是什么，\n@r……已经、睡吧。"],["つかれた。","累了。"],["いやあれか、\n急にたくさん食べたから……","啊难道是，\n突然吃太多所以……"],["血が胃に行って……","血液都流向胃……"],["もう、だめだ、待ってなんか居らんないや……","已经、不行了、才不要继续等下去啊……"],["もういいよな……？","已经够了吧……？"],["どうせもう誰からも連絡は……ない……よ……","反正已经不会有人再联系我了……没有……了……"],["…………いくらまったって……","…………无论等多久……"],["………もういい……もういいよ………","………够了……已经够了………"],["……あいたい……","……好想见……"],["屹度勘\n違いだ\nな思い\n入れか\nどうせ\n視ては\n呉れな\nい入れ\n込んで\nも相容\nれぬミ\nカタだ\n辛いだ\nけだ理","绝对是错觉\n搞错了\n的痛苦\n替换掉\n反正\n看着就\n不肯给\n硬塞进\n去\n也无法相容\n的错位\n模板\n太难受\n的道理"],["をとろ\nうが情\nをとろ\nうがア\nイなぞ\n騙るに\n死する\nもの、\nカナシ\nキカナ\nムナシ\nキカナ","をとろ\nう的情\nをとろ\nう的ア\nイ谜\n骗人的\n死去的\n东西、\n卡娜西\n奇卡娜\n姆纳西\n奇卡娜"],["めがさめた。","眼睛睁开了。"],["「……いで、いでででででで」","「……疼、疼疼疼疼疼疼」"],["身体中がばっきばきに痛ぇ──","全身骨头嘎嘣嘎嘣疼──"],["──あれ？","──咦？"],["布団に入ってない……","没躺在被窝里……"],["電気が付けっぱなし……","电灯一直亮着……"],["「うあ、\n変な寝落ちした？！」","「呜啊，\n难道我睡昏头了？！」"],["ま、全く記憶ない、どうやって寝たのか。[l]\nこれは在学中、\n徹夜でテスト勉強しすぎて本番寝坊した時以来の衝撃……","嘛、完全没记忆、怎么睡着的。[l]\n这是在校期间、\n继通宵复习考试结果正式考试睡过头以来最冲击的事件……"],["これはやばい、\nてか今何時だよ？","这可糟了、\n话说现在几点啊？"],["部屋の明かりの所為で時間がさっぱりわからない、\n急いで携帯電話を探し、\n確認、","房间的灯光害我完全搞不清时间，\n慌忙寻找手机，\n确认，"],["\n\n──着信あり　　　２件","\n\n──未接来电　　　2通"],["「だ、れだ？[l]\n誰から？」","「谁、是谁？[l]\n谁打来的？」"],["やめてくれ、\n漫画みたいなドラマみたいな展開はやめてくれ、\nそういうのは要らないんだよ、\n激しい喜びも悲しみも、","饶了我吧，\n别搞这种漫画般的戏剧展开，\n我可不需要这种东西，\n无论是狂喜还是悲痛，"],["そんなのは、\n何で起きなかった？[l]\n何で、め、覚めなかったんだよ僕は。","这些事，\n为什么没发生？[l]\n为什么，我，没醒过来啊。"],["「冬夏、から──」","「冬夏，的──」"],["留守番電話センターに伝言が、","语音信箱里有留言，"],["「何だ、何を──」","「什么，说什么──」"],["何故か、手が、震えるが、","不知为何，手在，发抖，"],["何とか再生操作を、","勉强操作着，"],["する、","按下，"],["耳をあてて、それを、聴く──","把听筒贴到耳边，听着──"],["『もしもし？[l]\nいない？[l]\n冬夏です。[l]\n……ほんとにいない？[l]\nそっか、ごめん。[l]\nえと、こないだはごめんね。","『喂喂？[l]\n不在吗？[l]\n我是冬夏。[l]\n……真的不在？[l]\n这样啊，抱歉。[l]\n那个，之前的事对不起啦。"],["あのね、……いいや。[l]\n会って話す、そう、会おうね、\n絶対、会おうね、\n私、あの海岸で、日曜日、誕生日、\n待ってる、絶対絶対行くからね。[l]\n遅れたらごめん、もしかすると遅れる、\nでも、絶対行くから、\nお願い、来てね、今日は帰れないかもしれないから、\n明日までにどうしても声きいときたかったけど、\nあ、ごめん、また掛けなおす。じゃ』","其实啊，……算了。[l]\n见面聊吧，对，见面吧，\n一定要，见面啊，\n我，在那个海岸，周日，生日，\n等你，绝对绝对会去的。[l]\n迟到的话对不起，可能会迟到，\n但是，绝对会去的，\n求你了，要来哦，今天可能回不去了，\n想在明天之前无论如何都让你听到声音，\n啊，抱歉，我再打一次。拜』"],["……次のを再生する。[l]\nこれも冬夏からで、\n１件目よりも、声の調子がやや切羽詰まってる気がする。[l]\nそして、電波状況が悪いのか、\nいまいち聞こえが……良くない……","……播放下一条。[l]\n这也是冬夏的，\n比起第一条，语气似乎更急促了些。[l]\n而且，可能是信号不好，\n听得……不太清楚……"],["『ごめん、冬夏です。[l]\n…っぱりいないの？[l]\nもう、参ったな、なんで？[l]\nほ…とに？[l]\nえとごめんじゃあのね、\n……の海岸であっ……の子とね、[l]\n…のしろ、もう無いと思うけど、[l]\nきっと……に…と貴方のネコガミが、[l]\n…達の証、まこ…さんが……と…………ね、[l]\nほんとはそっちの現物視て貰って……","『抱歉，我是冬夏。[l]\n…还是不在吗？[l]\n真是的，搞什么啊，为什么？[l]\n真…的？[l]\n那个对不起啊其实，\n……的海岸和那…孩子一起，[l]\n…的白，可能已经没有了，[l]\n一定……和…你的猫神，[l]\n…们的证明，真…先生……和…………呢，[l]\n其实想让你亲眼看看那边的实物……"],["………で、[l]\n真言さんに……けてほし……[l]\n私をヤソウの……から……[l]\n断ち切って……[l]\n他のネコガミを全て、\n…………………い、[l]\n祭に全員が、全てのネ……ミが揃うの、[l]\n………………て、[l]\nまことさん、わ──』","………然后，[l]\n希望真言先生……能……[l]\n把我从夜葬的……中……[l]\n切断……[l]\n其他的猫神全部，\n…………………喂，[l]\n祭典时所有人，所有的猫…神都会聚集，[l]\n………………了，[l]\n真言先生，明──』"],["………",""],["@r………終わり？終わりか？","@r………完了？就这样完了？"],["@r２件もあるのに、結局、途中で、おわってるじゃ、ないかよ。","@r明明有两通，结果却都在中途，断掉了啊，搞什么。"],["でも、確認してももう着信も留守電もない、","但是，确认后发现既没有新来电也没有新留言，"],["やめてくれ、やめてくれ、やめてくれ、\n頼むから、\nそんな、何が言いたかったんだよ、","住手啊、住手啊、住手啊、\n求你了、\n开什么玩笑、你到底想说什么啊、"],["何で、\n畜生、ざわざわする、脚が、震える、","为什么、\n可恶、吵死了、腿、在发抖、"],["\n\n\n──しぃぅるぉお","\n\n\n──嘶噜噜噜"],["きぃの所かと思ってきぃに電話してみたが、\n矢張り繋がらない。[l]\n彼奴の場合理由が何か分からないけれど、\nなんだよ、なんなんだよ、","以为是小贵那边就给小贵打了电话、\n果然还是打不通。[l]\n虽然不清楚那家伙是什么情况、\n搞什么啊、到底怎么回事啊、"],["今、何日の何時で、\n電話はいつ──","现在、是几号几点、\n电话什么时候──"],["\n\n──蠢動が顕在するか","\n\n──蠢动即将显现"],["\n──首が","\n──脖子"],["\n\n\n２２日、","\n\n\n22日、"],["\nそうか、そうだ、","\n是吗、对了、"],["\n２２日というのは、","\n说到22日、"],["\n祭１週間前で、\n姫様ちゃんの最後通牒期限、\nちからづくでつれもどす……？","\n就是祭典前一周、\n姫様最后通牒的期限、\n要用暴力强行带回来……？"],["まさか、\n\n引っ掛かってたのはそれか？","难道、\n\n被卡住的是这个吗？"],["\n\n\n──それは誤なり","\n\n\n──此乃误判"],["なんで、起きなかったんだ、\n僕は、こんなときに、馬鹿か、ああもうっ、","为什么、没有醒来、\n我、在这种时候、是白痴吗、啊啊够了、"],["\nなんでだっ！！[l]\nなんでだ、なんでだ！！なんでだばかっ！！！","\n为什么啊！！[l]\n为什么啊、为什么啊！！为什么啊混蛋！！！"],["……いや、[l]\nまずはチェックアウトしたかどうかを確かめよう。[l]\n自発的に戻った上での、あの留守電であれば、\n","……不对、[l]\n先确认是否已经退房吧。[l]\n如果是自愿回来时的那条留言、\n"],["平","平"],["和","和"],["裡に事は納まったという事だろうが、\nそうでないなら、\nあの２人が、姫様ちゃん達が、","就意味着事情已经妥善解决了、\n如果不是的话、\n那两个人、姫様她们、"],["\n\n\n──武器を手に……弓の蟇……音……","\n\n\n──手持武器……弓蟾……声……"],["そのチカラが何かしら暴力的なものだとしたら、","如果那种力量是某种暴力手段的话、"],["\n\n\n──PHASE:1＝メ木ル又　PHASE:7＝弓ム虫イヒ","\n\n\n──PHASE:1＝枯木再萌　PHASE:7＝弓虫侵蚀"],["……強制的に連れ戻すだ？[l]\nてあ、らな手段で──\n\nいや、そんな馬鹿な。[l]\nしかし、シキタリが、鉄の掟が……","……是要强行带回来吗？[l]\n用那、那种手段──\n\n不、怎么可能。[l]\n但是、规矩是、铁则啊……"],["どう、したらいいんだ。[l]\nいや、判断は早急にすぎる、\nまずはだから、知狡さんに聞かなきゃ、\nだーーーっ、今何時だって、","该、怎么办才好。[l]\n不、现在判断还为时过早、\n总之得先、问知狡阿姨才行、\n靠──现在几点来着、"],["\n……２２日の……１９：３２？","\n……22日的……19：32？"],["着信は？[l]\n１件目が今日の７：０２、","未接来电呢？[l]\n第一通是今天7：02、"],["２件目が、","第二通、"],["１８：２４、",""],["１時間ほど前だ──","是一小时前──"],["「とっ……兎に角、知狡さん──」","「总……总之、知狡阿姨──」"],["幸いにも服は寝る前の着の身着のままだったから、\n速攻で部屋を出て知狡さんを探しに行く。","幸好衣服还是睡前那套没换、\n立刻冲出房间去找知狡阿姨。"],["「知狡さんっ」","「知狡阿姨！」"],["幸いにもすぐ捕まえることが出来たので、\nすぐに冬夏の事を訊く。","幸运的是马上找到了、\n立即询问冬夏的情况。"],["「ど、どうした？[l]\nずっと部屋に籠もっていたようだし、\n……寝癖もすごいぞ」","「怎、怎么了？[l]\n看你一直闷在房间里、\n……头发也乱得夸张呢」"],["「や、その、僕の事はいいんですっ、\n冬夏は？[l]\n普通に、チェックアウトしましたか？[l]\nそれとも」","「我、我的事不重要、\n冬夏呢？[l]\n是正常、办理退房了吗？[l]\n还是说」"],["「……？[l]\n──待て、確認してこよう」","「……？[l]\n──等等，我去确认一下」"],["「お、お願いします……」","「拜、拜托了……」"],["その場で数分立ち尽くしていると、\n戻って来た知狡さんが言った。","在原地呆站了几分钟后，\n返回的知狡阿姨说道。"],["「今確認したが、\nまだチェックアウトはしていない。[l]\n確かに部屋には誰も居ないようだが──」","「刚才确认过了，\n还没有办理退房手续。[l]\n房间里确实空无一人──」"],["「きょ、今日は学校無い日ですよね？[l]\n朝から出掛けたってことですか？」","「今、今天学校放假对吧？[l]\n难道是早上就出门了？」"],["「……の、ようだな。[l]\n休日であれば出掛けても不思議ではないんじゃないか？」","「……看、看来是这样。[l]\n既然是休息日，出门也不奇怪吧？」"],["「あの……三春関係のですね、お土産屋ありますよね？[l]\nかた、かたりべ……」","「那个……三春家相关的土特产店，[l]\n叫、叫语部……」"],["「ああ、知っている」","「啊，我知道」"],["「あそこの娘、来ませんでしたか？[l]\nその、」","「那边的姑娘，没来过吗？[l]\n就是，」"],["姫様ちゃんの特徴を伝える前に知狡さんが言った。","在说明姫様特征之前知狡阿姨说道。"],["「いや、来ていない……と思うが確認してこよう。[l]\n何度も済まんが待っていてくれ」","「不，应该没来过……不过我再确认下。[l]\n让你久等实在抱歉」"],["し……ってるのだろう姫様ちゃんのことは。[l]\n任せることにした。","应……该知道的吧关于姫様的事。[l]\n决定交给她们处理。"],["もし、\n姫様ちゃん達が連れ戻しに来たのなら、\n学校が休みである以上此処に来たと考えるのが普通だが、\n……そうなら、此処に冬夏が居ることを知ってたのか？","如果、\n姫様她们是来抓我回去的话、\n既然学校放假会来这里也是理所当然、\n……若是如此、她们知道冬夏在这里吗？"],["冬夏がそれを察して此処から出て行ったと考えることも\n出来ようが、","也可以认为冬夏察觉到这点才离开，\n但是，"],["まてよ、\n全く何も知らない状態で冬夏の行き先なんか、\nいや、そもそも本当に連れ戻しに来たのか、\n連れ戻されたのかも判らないのにそんな思考は無意味か、","等等，\n在完全不知情的状态下怎么可能知道冬夏去向，\n不，说到底连她们是否真是来抓人的，\n或是被带走的都无从证实，这种思考毫无意义，"],["ああ、脳が空転して、\n何が何だかさっぱり、","啊，脑子空转着，\n完全理不清头绪，"],["起き抜けっていうのもあるだろうが、\n","刚睡醒也有关系吧，\n"],["唯","只"],["唯焦って、あせって、もう、","只是着急，焦躁，已经，"],["何処だ？[l]\n何処にいる？[l]\n無事なのか？[l]\nその思考すら、姫様ちゃん達に暴力的要素があるという前提であり、\nそんな馬鹿なと思う、しかし、ねこが、ネコガミが、\nアヤメが──","在哪里？[l]\n人在哪里？[l]\n平安无事吗？[l]\n这种想法本身、就是以姫様她们具有暴力倾向为前提、\n觉得这太荒唐、但是、猫咪、猫神、\n阿娅梅──"],["「真言、\n済まん待たせたな。","「真言，\n抱歉让你久等了。"],["ロビーの人間、\n綾目の娘を知ってる人間にも確認したが、\n来ていない。","大厅的人，\n我也问过认识绫目家女儿的人，\n都说没来过。"],["ただ、三春の娘は、\n今朝早くに此処を出ていた、らしい」","不过三春家的女儿，\n今早很早就离开这里了，据说」"],["「で、伝言とかは……」","「那、留言之类的……」"],["「いや、ロビーには鍵を預けただけだ。[l]\nチェックアウトしていないし、\n荷物も通常の範疇だったようだが……」","「没有，只是把钥匙寄存在前台。[l]\n既没退房，\n行李量也在正常范围……」"],["「そう、ですか、\nありがとうございます……」","「这、这样啊，\n谢谢您……」"],["「真言」","「真言」"],["「は、はい？」","「啊，啊咧？」"],["「私はお前自身が心配だ。[l]\n昨日の夜から今まで、部屋にずっと居ただろう」","「我倒是担心你本人。[l]\n从昨晚到现在，你一直待在房间里吧」"],["「えっ……と、そうです、[l]\n寝過ごしたんです、最悪です……」","「呃……是、是的，[l]\n睡过头了，糟透了……」"],["「……体調が良くないんじゃないのか？[l]\n精神的にもその、」","「……身体不舒服吗？[l]\n精神方面也，那个」"],["「あ、いえ、それは、まあ、\n多分、いや、どうかな……」","「啊，不，这个，怎么说呢，\n大概，不，或许吧……」"],["「……私にもっと力があれば……」","「……要是我更有力量的话……」"],["「いえ、あ？[l]\nその、知狡さんには良くして貰ってます、\nそんな事言わないでくださいよ、\n母さんよりもずっと、」","「不、啊？[l]\n那个、知狡阿姨对我很好、\n请不要说这种话、\n比妈妈要好得多、」"],["「現実……あらみ、あのこが……」","「现实……阿拉米、那孩子……」"],["「知狡さん……？」","「知狡阿姨……？」"],["「いや、何でもない、\n兎に角、その件も宮さんには伝えよう、\nお前もどうか、\n……自愛を祈る」","「不、没什么、\n总之、那件事也会传达给宫小姐、\n你也请、\n……多加保重」"],["ではまだ忙しいから、\nと言って知狡さんは去った。","那么我还有事要忙、\n说完知狡阿姨便离开了。"],["……何で宮さんに、冬夏達のこと伝えるんだ？","……为什么要告诉宫小姐、冬夏她们的事？"],["祭に関係しそうだからか？[l]\n単に知狡さんが超真面目だからか？[l]\nそれとも、","是和祭典有关吗？[l]\n单纯因为知狡阿姨过于认真吗？[l]\n还是说、"],["「あああもうわからない、\nどうしよう、\nいや、焦るべき事が起きてるのかどうか、\nそれすらも」","「啊啊啊完全搞不懂、\n怎么办、\n不、到底有没有发生值得着急的事、\n甚至连这点」"],["わからないのに……","都搞不清楚……"],["携帯電話を視る。","盯着手机屏幕。"],["履歴。","通话记录。"],["電話が１時間ほど前にあったということは──","显示一小时前有过通话──"],["……で、電話だ。[l]\nさっさと冬夏に電話すれば良かった。[l]\nなんで思い至らなかったんだ。","……对了、打电话。[l]\n早点给冬夏打电话就好了。[l]\n为什么没想到呢。"],["くそっ、\n腹が減った時と眠いときは、\nツかれたときは脳が空転して、\nちゃんとうごいてくれな──","可恶、\n肚子饿和犯困的时候、\n累到极限时脑子就会空转、\n根本没法好好运──"],["「──兎に角電話しよう」","「──总之先打电话」"],["何度も、何度も掛けたけど、\n駄目だった。[l]\n出ない。","反复拨了好多次、\n都不行。[l]\n没人接。"],["それでも、\n家に戻って……仮に僕みたいに軟禁されてるだけなら、[l]\nまあ、……心配はない、のだろう。[l]\nまさか取って喰われる事はあるまい。","即便如此、\n如果只是回家……或者像我一样被软禁的话、[l]\n大概、……不用担心吧。[l]\n总不至于被捉去吃掉。"],["なんだ、そういう程度の事しか、たぶん、\n起きてない、かもしれないじゃないか、\nなんだ、しんぱいして、おおげさに、\n僕は、阿呆か、","看吧、发生的恐怕、\n只是这种程度的事吧、\n什么嘛、大惊小怪地担心、\n我真是、笨蛋啊、"],["\nはは、","\n哈哈、"],["\n急激に冷め……","\n突然冷静下……"],["\n\nないな。","\n\n来呢。"],["\nなんだ、\n\nなんなんだ、","\n怎么回事、\n\n到底怎么回事、"],["分からないってのは困る、\n分からないから不安なんだ、\n不安だから厭なんだ、\n待つのはイヤだ、\nこちらから動かないと、","搞不清楚最难受了、\n因为不清楚才会不安、\n因为不安才会烦躁、\n最讨厌等待了、\n不主动行动的话、"],["──何故","──为什么"],["斯","此"],["様に気を回すのかと","要对她们的事如此上心"],["\nだって彼女達とはもう、","\n毕竟和她们已经、"],["\n──感情移入","\n──产生共情"],["\nここまで関わってしまったら、","\n既然牵扯到这种地步、"],["\n──わがみのことでもあるからな","\n──也关乎自身了"],["\nそれがヒトってもんだろうに、","\n这才是人类该有的样子吧、"],["\n──ヒト？[l]\n　　きらわれたくないのだな？","\n──人类？[l]\n　　其实是不想被讨厌吧？"],["それがふつうだろう？","这很正常不是吗？"],["@r──フツウ？[l]\n　　まちがいたくないのだな？","@r──普通？[l]\n　　不想搞错对吧？"],["@rふつうじゃないと？","@r不普通吗？"],["@r──真言さんからはトーノニオイがする","@r──真言先生身上有股塔诺尼奥的气味"],["しつぼうされたくないのだ。","不想被质问。"],["僕は確かにアナクロで、","我确实是个老古董，"],["\n──あなたがねこのようにみえます","\n──你看起来像猫一样"],["ひていされたくないのだ。","不想被否定。"],["@r友人も少ないが、","@r朋友也不多，"],["\n──首、茶黒の、犬の王、良き犬、真の示し申すものに因みし\n　　わがはらから","\n──颈、茶黑色的、犬之王、良犬、因真之示范者而得名\n　　吾之同胞"],["きたいにこたえたいのだ。","想要回应期待。"],["それでもヒトの情というものを、","即便如此人类的感情这种东西，"],["\n──キミたちには、ワカルはず","\n──你们应该、能明白"],["確固たる自我（エゴ）があれば視誤ることないのに、","若有坚定的自我（EGO）就不会看错，"],["\n僕等はきっと同じものを、──あ？","\n我们肯定在追寻同样的东西、──啊？"],["「もう思考がめっちゃくちゃだ……[l]\nめちゃくちゃだ、\n……寒いしなんか、脚の震えがまた、","「思考已经乱七八糟了……[l]\n乱七八糟，\n……又冷又莫名地、腿又开始发抖，"],["血の気が、引いてるのか？[l]\nさ、寒い、寒いって、なんだこれ、\n……ああ」","血色、褪去了吗？[l]\n好、好冷、冷死了、怎么回事，\n……啊啊」"],["立つのも辛い程に息も苦しい、\n今まであった首が熱いのとは違う、\n不安、不安、不安に押しつぶされそうなこの、\n身体の異常に、\n僕は、\n何とか、\n気をしっかりもて、\n気をしっかりもて、","连站立都痛苦的窒息感，\n和之前颈部发热的感觉不同，\n不安、不安、快要被不安压垮的这副，\n异常的身体，\n我，\n必须设法，\n保持清醒，\n保持清醒，"],["──仮令（たとえ）他人の言葉に飲まれようと、\n　　受け流せ、揺るぐな、柔軟にあれ、\n　　ＡＬＴＥＲ　ＥＧＯ、ＳＴＡＮＤ－ＡＬＯＮＥ、\n　　その言ノハを喰え、ミとしろ、\n　　届かぬモノに執着するな、アイは終着なれども、\n　　堅くあれ柔くあれ、\n　　泣け叫べ、十全尽くせ、\n　　それでも夢喰われぬときも、\n　　言の帝のスクイあるやもしれぬ、\n　　ケレド過つことあらば、\n　　喰い新（あらた）めよ、\n　　只管に螺旋をのぼれ、らせんをのぼれ、\n　　コウカイさせろ、\n　　われらはひとりだから──","──纵使（即便）被他人的言语吞噬\n　　也要化解，不可动摇，保持灵活，\n　　ALTER　EGO、STAND－ALONE、\n　　将那言灵吞食，化为己有，\n　　莫执着于无法触及之物，爱虽为终点，\n　　刚柔并济，\n　　尽情哭喊，穷尽十全之力，\n　　即便如此仍无法吞噬梦境时，\n　　言灵之帝或许正暗中窥伺，\n　　然若犯错，\n　　便重新吞噬，\n　　只管攀登螺旋，攀登螺旋，\n　　让其共鸣吧，\n　　因为我们孑然一身──"],["つらい、僕は。[l]\nなんでこんなに、","好痛苦、我。[l]\n为何如此，"],["僕は、\nさいあくだ、","我，\n太悲惨了，"],["──サイコウのために強くなれ、\n　　いばらのみちだが、\n　　只管に螺旋をのぼれ、らせんをのぼれ、\n　　悲しき辛き切なき不条理無情のミチなれども、\n　　ひとりだ、われらは、\n　　たたかえ、泣き叫びながら、\n　　絶望は己が中だ、失望は他者が内だ、\n　　それは自由イシの外だ、シュウセイとどかぬものなのだ、\n　　笑え、こぼれたミズハ戻らない、戻らぬ水たる涙ながせ、\n　　八刀ソウオウもこころおきつ、\n　　コウカイさせろ、\n　　それがたむけ、セイ一杯のつよがれ──","──为了最棒的你变强吧，\n　　虽是荆棘之路，\n　　只管攀登螺旋吧，攀登螺旋吧，\n　　纵使是悲伤痛苦心酸荒谬无情的道路，\n　　孤身一人啊，我们，\n　　战斗吧，边哭边喊着，\n　　绝望存于己身，失望源于他人，\n　　那在自由意志之外，是终将无法触及之物，\n　　笑吧，洒落的水不会回来，就让这永不回返的水化作泪流下，\n　　八刀葬送亦无须介怀，\n　　尽情崩溃吧，\n　　那便是祭奠，逞强到极限吧──"],["痛い、痛い、なんて痛いんだ、\n胸が痛い、\nこころがいたい……","好痛、好痛、太痛了，\n胸口好痛，\n心好痛……"],["──どんなに喜多無くともすすむしかないのだ、\n　　このセカイは最悪の箱庭、走り続けなければ、","──无论多么不情愿都只能前进，\n　　这个世界是最糟糕的箱庭、若不停下脚步，"],["「ココに","「在这里"],["存在られない……」","无法存在……」"],["……泣いてる。","……在哭。"],["鼻水が出て止まらない。","鼻涕流个不停。"],["しょっぱい味が、\n広がる、","咸涩的滋味，\n蔓延开来，"],["なんでやねん。[l]\nなんでや、","搞什么啊。[l]\n搞什么，"],["でも、\nすっきりした、気がする。","但是，\n感觉、畅快了些。"],["……涙はそのためにあるんだろうが、[l]\nまあ、\n少し落ち着いた。","……眼泪就是为此而存在的吧，[l]\n嘛，\n稍微冷静点了。"],["根本的には何ら事態は進展解決してないけど、\nちょっとだけ、\nましに、なった。","虽然根本事态没有任何进展解决，\n但总算，\n好转了、一点。"],["改めて携帯電話を確認するが、\nやっぱり何も来てない。","重新确认手机，\n果然什么消息都没有。"],["……また、部屋に戻った。","……又、回到房间。"],["だめだ。","不行了。"],["身体の震えが止まらない。[l]\n足の先が痺れる、\n寒い、\n気温じゃないと思う、\n寒い、\n鏡を視ると顔が真っ青だった、\n寒い、\nこわい、ふあんだ、たすけて、\nだめだ、じりきで、なんとか、\nするんだ、それが、","身体止不住发抖。[l]\n脚尖发麻，\n好冷，\n不是气温的问题，\n好冷，\n照镜子发现脸色惨白，\n好冷，\n好可怕、好不安、救救我，\n不行、要靠自己、想办法，\n做到啊、这就是，"],["@r──我等の","@r──此乃"],["理だからな。","我等之理。"],["そうだ、くそ、\n僕は、僕は、意地でも、","没错、可恶，\n我啊、我啊、拼上这口气也要，"],["@r──螺旋のぼれ。","@r──攀登螺旋吧。"],["すすむ、まえに、うえに、","前进、向前、向上，"],["「宮さん、\n……みやさんみやさんみやさん、」","「宫小姐，\n……宫小姐宫小姐宫小姐，」"],["連絡がない、宮さん。","没有联络、宫小姐。"],["●●する宮さん、","●●着的宫小姐，"],["「●●するもののためにいのる、\n僕は、シを忘れない、\n……しを？」","「为●●之人祈祷，\n我、不会忘记死，\n……死？」"],["急に落ち着いた。","突然冷静下来。"],["「か、る、くなった……？[l]\nよくわからない……」","「变、变轻了……？[l]\n不太明白……」"],["どっちにしても、情緒不安定である事には変わりない。[l]\nいつまた発作的におかしくなるか分からない。","无论如何，情绪不稳定这点不会改变。[l]\n不知道什么时候又会突然发作。"],["何かがおかしい、\n何かを忘れてる、\n何か……","有什么不对劲，\n忘记了什么，\n有什么……"],["何時間もその後無為に過ごした。[l]\n幸い発作は起きなかった。[l]\nけど……","之后好几个小时都浑浑噩噩度过。[l]\n幸好没有发作。[l]\n可是……"],["誰とも連絡がつかない以上、\nどうしようもなくて、\nその日も、\n──寝るしかなかった。","既然联系不上任何人，\n束手无策之下，\n那天也，\n──只能睡觉了。"],["なにも、出来ない、なんて、僕は、僕は……","什么都、做不到、这样的、我啊、我啊……"],["「明日！[l]\nあしたは冬夏の、誕生日だ、\n絶対来るって、そう、そうだ」","「明天！[l]\n明天是冬夏的、生日，\n绝对会来的、对、就是这样」"],["とにかく、明日はあの海岸に行く、\n朝一で出掛けよう、\nほんとは今すぐにでも行きたいけど、\nもう、時間もそうだが、","总之，明天要去那个海岸，\n一大早就出发吧，\n其实现在就想立刻过去，\n不过，时间也已经是这样了，"],["ここ数日、\n頭が働きっぱなしで、\nものすごく疲労する……んだよ、","这几天，\n脑子一直转个不停，\n超级疲劳……啊，"],["からだも……震えて……さむいし……[l]\n宮さんの……お守りが、[l]\nなくなった……から……かな……","身体也……在发抖……还冷……[l]\n宫小姐的……护身符，[l]\n不见了……所以……吧……"],["だめだ、……ごめん……とう、か……","不行了，……对不起……冬、夏……"],["みんな……すこし、ねさせて……くれ……","大家……让我……稍微……睡会儿……"],["だって……","因为……"],["──十全の復調には今少し刻が要るのだ──","──要完全恢复还需要一点时间──"]],"context":[["SC_M_050.ks/index/1/text"],["SC_M_050.ks/index/3/text"],["SC_M_050.ks/index/5/text"],["SC_M_050.ks/index/7/text"],["SC_M_050.ks/index/9/text"],["SC_M_050.ks/index/11/text"],["SC_M_050.