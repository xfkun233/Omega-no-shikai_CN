,[{"start":9395,"end":9396}],[{"start":9406,"end":9420}],[{"start":9428,"end":9431}],[{"start":9439,"end":9518}],[{"start":9526,"end":9560}],[{"start":9568,"end":9622}],[{"start":9654,"end":9688}],[{"start":9718,"end":9737}],[{"start":9769,"end":9773},{"start":11894,"end":11898}],[{"start":9803,"end":9811}],[{"start":9843,"end":9850}],[{"start":9880,"end":9933}],[{"start":9965,"end":9982}],[{"start":10006,"end":10019}],[{"start":10027,"end":10031}],[{"start":10039,"end":10108}],[{"start":10116,"end":10180}],[{"start":10212,"end":10272}],[{"start":10302,"end":10334}],[{"start":10366,"end":10416}],[{"start":10446,"end":10491}],[{"start":10523,"end":10552}],[{"start":10582,"end":10658}],[{"start":10690,"end":10725}],[{"start":10749,"end":10814}],[{"start":10906,"end":11027}],[{"start":11035,"end":11168}],[{"start":11260,"end":11291}],[{"start":11299,"end":11320}],[{"start":11501,"end":11525}],[{"start":11557,"end":11569}],[{"start":11599,"end":11602}],[{"start":11634,"end":11687}],[{"start":11717,"end":11744}],[{"start":11776,"end":11819}],[{"start":11849,"end":11862}],[{"start":11928,"end":12008}],[{"start":12040,"end":12046},{"start":13708,"end":13714}],[{"start":12076,"end":12156}],[{"start":12164,"end":12199}],[{"start":12231,"end":12327}],[{"start":12357,"end":12361}],[{"start":12393,"end":12425}],[{"start":12455,"end":12470}],[{"start":12502,"end":12511}],[{"start":12583,"end":12654}],[{"start":12662,"end":12699}],[{"start":12731,"end":12787}],[{"start":12817,"end":12825}],[{"start":12857,"end":12871}],[{"start":12889,"end":12902}],[{"start":12932,"end":12974}],[{"start":12992,"end":13007}],[{"start":13015,"end":13071}],[{"start":13079,"end":13096}],[{"start":13106,"end":13113}],[{"start":13143,"end":13184}],[{"start":13202,"end":13285}],[{"start":13317,"end":13398}],[{"start":13428,"end":13472}],[{"start":13480,"end":13522}],[{"start":13554,"end":13588}],[{"start":13618,"end":13676}],[{"start":13732,"end":13768}],[{"start":13776,"end":13794}],[{"start":13824,"end":13886}],[{"start":13951,"end":14044}],[{"start":14052,"end":14170}],[{"start":14183,"end":14195}],[{"start":14203,"end":14286}],[{"start":14294,"end":14430}],[{"start":14438,"end":14512}],[{"start":14520,"end":14546}],[{"start":14589,"end":14676}],[{"start":14708,"end":14716}],[{"start":14746,"end":14799}],[{"start":14807,"end":14824}],[{"start":14832,"end":14913}],[{"start":14921,"end":14990}],[{"start":14998,"end":15067}],[{"start":15091,"end":15150}],[{"start":15182,"end":15234}],[{"start":15264,"end":15271}],[{"start":15303,"end":15392}],[{"start":15422,"end":15478}],[{"start":15510,"end":15515}],[{"start":15545,"end":15581}],[{"start":15641,"end":15810}],[{"start":15818,"end":15878}],[{"start":15951,"end":16015}],[{"start":16023,"end":16079}],[{"start":16087,"end":16157}],[{"start":16189,"end":16204}],[{"start":16234,"end":16324}],[{"start":16332,"end":16429}],[{"start":16461,"end":16568}],[{"start":16598,"end":16645}],[{"start":16653,"end":16687}],[{"start":16705,"end":16730}],[{"start":16768,"end":16772}],[{"start":16839,"end":16901}],[{"start":16947,"end":16998}],[{"start":17006,"end":17046}],[{"start":17106,"end":17109}],[{"start":17117,"end":17158}],[{"start":17190,"end":17213}],[{"start":17281,"end":17282}],[{"start":17291,"end":17292}],[{"start":17302,"end":17303}],[{"start":17313,"end":17314}],[{"start":17324,"end":17331}],[{"start":17363,"end":17376}],[{"start":17406,"end":17425}],[{"start":17462,"end":17549}],[{"start":17555,"end":17601}],[{"start":17607,"end":17660}],[{"start":17666,"end":17707}],[{"start":17713,"end":17725}],[{"start":17747,"end":17766}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_029.ks","basename":"SC_M_029.ks","indexIds":{"「……久しぶり。えへへ」":0,"「ああ、久しぶり……[l]\nって、なん、何で此処に、いやその、あれ？」":1,"僕の眼の前に立ち、下から僕を見上げる冬夏。[l]\n小首をかしげ、僕の眼をじっと直視する。":2,"数秒後、":3,"「あぁ～～～～～～～っ、もう！！！[l]\nがーーーーーー！！！！！[l]\nうんっ！！」":4,"溜めを入れたと思ったら、\n突然ハイテンションで捲し立て始めた。":5,"「寂しかったよぉ～ここんとこずっと！！[l]\n聞いてよもおっ、\n前言ったけどさ、気が重い出来事が\n次から次へと満載だったの！！":6,"きら……苦手な親戚がわんさか来たりさ、[l]\nあーもうやだやだやだやだやだ！[l]\nストレスの塊！[l]\n今の私！！":7,"きぃも具合悪くて電話しづらくて話し相手も\nいなかったのっ！！":8,"やることいっぱいあったし誰と話しても\n愚痴になりそうだから気は遣うしもう\nおかしくなるのもうねえあたたたた頭痛くなっちゃった、":9,"急に人と喋ったからかなあ、\nねえ真言さん聞いてる？[l]\nだっっっっっっれも話す相手いなかったんだから！":10,"あ、こ、こういうとまるで私が友達いないみたいだけど、\nいいんだよ殆どの女子は会話がなりたたないし\n心配してくれるポーズばっかで興味本位なだけの\n態度なんてもううんざりだよーー！":11,"折角此処まで来たのに真言さんは居ないし\n何処に行ってたの？[l]\n愚痴聞いてそして同情してよもぅー！」":12,"「えっとーーーーーーー……[l]\nご、ご愁傷様……です」":13,"完全にのけぞって話を聞いてた僕が、\n頼りなさげに何とかそう口にすると、":14,"「じゃあさ、\n取り敢えず？」":15,"両手をノーガード気味にだらんと垂らした。[l]\n眼、眼が据わってるのは何故なのでしょう。[l]\nすると、":16,"「ねえ、\n──慰めてっ」":17,"突然がばり、と、":18,"「な、さ、あうあ？！[l]\nおわああっと！！！」":19,"抱き付かれた。[l]\n奇跡的に土産を落とさずに済んだものの、\n反動に対抗するためにこちらも思い切り抱き返す形になり、":20,"結果、[l]\nう、こ、これって……[l]\nな、なんたるけしからん状況に……！":21,"「……」":22,"「……うな゛っっっ！！！」":23,"「！？！？」":24,"と、三秒もしないうちに、\n顔を真っ赤にしながら突き飛ばす様に身体を離し、":25,"「さ、さすがにちょっとはしゃぎすぎたっ。[l]\nはぅあーもうやばいやばい。":26,"あ、ごめんね、\nちょっとテンションおかしいの。[l]\nあははっ」":27,"自分の顔をぱたぱたと手で":28,"扇ぐ冬夏。[l]\n表情は既に、いつものさばさば顔になっていて、\n涙目に視えた右眼も、\n今視ると普通だった。":29,"……流石に顔はまだ赤いけど……":30,"「じ、自分が照れるくらいならやりなさんな、\n年頃のお嬢さんなんだから……[l]\nこういった事はだな……[l]\nその、なんというかちゃんとした相手にですね、」":31,"「ぷっ」":32,"「な、なんすか」":33,"「真言さん変わんないなーと思って。[l]\n癒し系？[l]\nなんかこう、好き、その感じ。うん」":34,"「はあ、そりゃあよござんした……[l]\nよくわからんけども……」":35,"「そそそ、そういうねぇ、\n":36,"がっついてないとこ？[l]\n枯れてる感じ？[l]\n好き」":37,"きぃも前に馬鹿力で抱き付いてきたし、\n三春の蔵から帰るときに姫様ちゃんも抱き付いてきたし、\n僕は何かしらそういう事を促す要素でも？":38,"それとも玄ノ森では、\n外つ國のコミュニケーション文化が流行ってるとでも？":39,"知らぬ間に色々弄られた事はあっても、\n宮さんにすら抱き付かれた事はないのに──\n……や、引き合いに出すことでもないんだけど。":40,"「だからそう、簡単に好きとか言うなって事なんだけども……[l]\n男子の側で誤解を招くでよ……」":41,"「え、何？[l]\n聞こえなかった。":42,"それに私が照れたのは変なテンション\nみせちゃったからで、\n抱き付き自体はノープロだよ？[l]\n膝枕してあげた仲でしょ。":43,"もっと色々しても良いって言ったしさー。[l]\nしてくれないけど真言さん」":44,"「……。[l]\nどうやら、あなたも変わってないようで……[l]\nまあ、元気が出たなら何より、\nよかったよかったウフフアハハ」":45,"「あ、でも今思いっきり抱きしめてくれたから\nいいや。[l]\n人肌恋しかったんだー」":46,"ああそう……[l]\nというか、\nだからにゃんでここにいるんだ、":47,"いや、此処に宿泊してるって話は暗にとは言え\n確かにしたけれど……":48,"「え、わたし？[l]\n泊まることにしたから。[l]\nしばらく此処に。[l]\nお部屋、ご近所さんになるかもって事でよろしく」":49,"「は？[l]\nえ？ほんとに？[l]\nいや、その前に、なんでまた？？」":50,"「おっかえり～まこくん、":51,"お！」":52,"「あっ！[l]\nた、ただいま戻りまして……」":53,"なんつータイミングで！":54,"「あ？[l]\nだれ？[l]\nどちらさま？」":55,"ど、どうしたらよいのでしょう！？[l]\n完全に知人だとはバレたのは間違いないけど……":56,"「まこくんの職場の上司でぇす♪」":57,"はや！[l]\n何の":58,"躊":59,"躇いもなく僕等のそばまで来ると、\nこれまた何の躊躇いもなくそう言い放つ宮さん。":60,"ていうか反応がちょっと冷静というか、\n戸惑い無さ過ぎじゃないすか。[l]\n突発事象に馴れすぎというか？[l]\nそれともこれが女子の精神構造というやつかしらん。":61,"「えーとその、前言ってた、\n……そういうこと、あはははは……[l]\nあれ、今日何かすることあったとか……」":62,"「え？？[l]\nえっ？！[l]\nで、でもっ！？":63,"……。[l]\n……。[l]\n":64,"どう視ても……ええ？！」":65,"僕と宮さんの顔を交互に見返し、\n混乱する冬夏。[l]\n──分かる分かるぞ。":66,"「うひひっ☆」":67,"舌をぺろりと出しウインクしてみせるけれども、\n有無を言わさぬオーラを発しているのも\n分かります。":68,"「は、はあ……[l]\nあの、その、初めまして……」":69,"「『みため』に関しては詮索不要がお互いベストでしょ？":70,"さ、\n改めまして自己紹介、\n宮はまこくんの職場の上司で宮岡門王水といいます、\n玄ノ森には月末の祭を視に長期滞在旅行で来ましたぁ。":71,"宮達二人でね」":72,"そうか、冬夏も……[l]\nだからなのか、\n妙に納得したように視える。[l]\nそれ以上深く考えるのは止したようだ。":73,"宮さんも一応飯窪との関連は伏せる方向で\n話をしていくつもりらしい。[l]\nにしても、状況への順応が早いよなあ……":74,"「わ、私は、み、……三春、冬夏です。[l]\n真言さんとは先日知り合って、\n色々聞いてます」":75,"「こっちも色々と聞いてますよぉ。[l]\n":76,"六":77,"母屋にお泊まりに来たですか？[l]\n":78,"でも、失礼ですけど、三春と言えば……」":79,"「えー……っと、":80,"その、\n私は確かに──地元、の人間ですけど、\n個人的な事情がありまして、\n確かに、泊まるつもりで来ました」":81,"「んむ。[l]\n深い詮索はしませんよ。[l]\nぎぶあんどていくです！":82,"まー、\nご近所さんになったら宜しくですよ。[l]\nまこくんのことも色々と」":83,"「こ、こちらこそ宜しくお願いします……」":84,"「じゃ、まこくん、\nまだ宮は色々することあるので。[l]\n今は其方様とごゆっくり～。[l]\n":85,"また後でねー」":86,"宮さんはひらひらと手を振ってまた中に入っていった。":87,"静かになり、\n数秒惚けていた僕等二人だったが、\n我に返った冬夏が開口一番、":88,"「……まこ、くん？[l]\nって呼ばれてる、ん、だ？」":89,"と突っ込んできた。":90,"「え、あ、その、まあそうね……」":91,"そして更に、\nぐっと顔を寄せて小声で、":92,"「（前聞いたとき確か、\nセクハラ受けてるって話、聞いた覚えがあるんだけど。":93,"ねえ。[l]\n記憶違い？[l]\n真言さん）」":94,"「えあ、そのですね、セクハラと言いましても、\nプラトニックなと言いますか、あのその、\nあくまで言葉責め？の範疇で？」":95,"「ふぅん……[l]\nまあ、面白そうなひとではあったけど……[l]\n":96,"にしても可愛らしい上司さんですのねぇー。[l]\n":97,"そーか、あういうのが……ほほう……」":98,"ジト眼になったりニヤリ眼になったり忙しそうだが、\nそろそろ僕弄りも停めて頂きたい頃合いです。":99,"「まぁた君等女子はそうやっておかしな方向に\n話を持ってこうとする……":100,"はやく宿泊手続きした方がいいんじゃないの？[l]\n事情は僕も深く詮索はしないよ。[l]\n愚痴はまあ、聞くだけでいいなら聞くけどさ」":101,"道具さんから何となく事情、というか、\n冬夏がこういう行動をとる背景を今日聞いてるので、\n取り敢えず差し障りのない話題にすり替えてみる。":102,"「あ、そだね。[l]\nちょっと行ってくる」":103,"「あーい」":104,"──待てとも部屋に戻れとも、\n付いてきてとも言われなかったけども、\n何となく勝手に移動してはいけない気がして、\n僕はそこに立ち尽くしていた。[l]\n一応、ずっと僕を待ってたようだしなあ……":105,"にしても、\n女学生が一人、という状況で、旅館側はどう対応するのだろう。[l]\nましてや冬夏のことは地元民として知らない訳はない。[l]\n僕や宮さんなら兎も角、知らぬで誤魔化せるものではないだろう。[l]\n先刻の宮さんの態度を視る限り、\n泊める気は満々のようだったが、\n……知狡さんを説き伏せるつもりかなあ。":106,"彼女が手の内に在るという状況は、\n考えようによってはかなりのチャンスではあるのだろうが、\n遣り方次第によっては深刻な亀裂を産みかねない。[l]\n例えば、\n三春の者をそれと知って宿泊させるのは、\n後々冬夏のおっかさんが探しに来たときに面倒そうとか、\n只でさえ未成年の彼女を果たして……":107,"……後は宮さんが変な弄り方をして怒らせるとか？":108,"ふと視界の端で何かが激しく動いた。":109,"視るとロビーの受付から、\n冬夏がこちらに向かって手を振ってる。":110,"「まあ、一応有力者の娘だから？[l]\nちょっと手間取ったけど説得出来たよ。[l]\n母様が探しに来るまでは視て見ぬふりしてくれるってさ。":111,"ほんとはこんな、\n母様みたいな真似したくはないんだけどねー、\nこっちもなりふり構ってらんないの。":112,"勿論此処に居ること秘密だよ？[l]\n……あの":113,"娘達にもね」":114,"さっすが、腐ってもお嬢様ですなあ。[l]\nと、言おうとして止めた。[l]\n色んな意味で禁句というか地雷な感じがする。":115,"今考えていた事を考え併せると、\nまあ飯窪側も諸々の事情を込みで、\n従順に受け入れるポーズを取ってみせたんだろうなあ……":116,"今のタイムラグの隙に、\n宮さんが受付にでも仕込んだのかな。":117,"「……へえ、[l]\nまあ取り敢えず良かったね。[l]\nどれくらいになるかは兎も角、\nよろしく……」":118,"「で、それ、何持ってんの？」":119,"「はっ！」":120,"土産物！！":121,"さっき宮さんに渡せばよかたよ！":122,"「ああ、そのさっきの上司にね、\n好きそうな土産物があったから。[l]\n買ってきたのデス」":123,"「ふーん。[l]\nさっき渡せば良かったのにね」":124,"全く以てその通り……":125,"あの娘達にも秘密、ていうのは勿論、\n姫様ちゃんと狩屋だろうから、\n今し方まで和気":126,"藹":127,"々と過ごしてたと知られたら、":128,"……。":129,"悪いことをしてる訳ではないんだけど、\n無駄に詳細を伝えて機嫌が悪くなられても互いにとって\n良いことないし、\nここは敢えてぼやかします。":130,"下手をすれば女装の件にまで\n言及しなければならなくなるしな！":131,"今後の冬夏との接触機会の増加に当たって、\n宮さん、くれぐれも僕にとっての地雷を踏まないよう頼みます。":132,"「ま、後でどうせ飯とか喰うだろうし、\n一旦僕も部屋に戻るよ」":133,"「そっか、帰ってきたとこだったもんね」":134,"「うん」":135,"「ね、真言さん」":136,"「な、なに？」":137,"「今からすることある？[l]\nドライブいきたい。[l]\nだめ？[l]\n疲れてる？」":138,"「え？[l]\nえーと……」":139,"携帯電話で時間を確認する。":140,"二時半。":141,"しかし、飯窪の関係者だと告白していない……\nというか隠してる現状では、[l]\n旅館の車を借りていく訳にもいかない…だろう。":142,"多少疲れてはいるけれど、\nまあ運転するくらいなら特に支障はないかな……[l]\n拒否する程の強固な理由もないし……":143,"「免許はあるし、──上司との打ち合わせは夜だろうから、\nまあ構わないけど、\nレンタカー屋って近いっけ？」":144,"「ちょっとだけあるけど。[l]\n歩きで１０分くらいかな」":145,"「じゃあちょっと部屋に戻って、\n上司に一声かけてくるよ、\n冬夏も荷物置いてきたら？」":146,"「あ、行ってくれるんだ。[l]\nさんく！[l]\nじゃ、ロビーで待ってるね」":147,"「荷物大丈夫？[l]\nなんか結構重そうだけど……」":148,"「学校ふけると家に連絡いったりとか面倒だから、\n教科書とか持ってきたからっ。[l]\nだいじょぶ気にしないで、それより早く準備してきてぇ」":149,"「わ、わかった。[l]\n旅館の人が持ってくれるだろうしね……」":150,"くれないのかな……[l]\n高級ホテルでもなきゃ駄目か。[l]\n自分の時は完全に身内扱いだったから参考になりません。":151,"ともあれ、\n部屋に戻り宮さんに事情を説明すると、\n格別何もなく許可はおりた。[l]\nチノ嬢も宮さんの部屋に居たので、\n今朝から言われてた用事をこなしてたのだろう。[l]\nまだすることあるって言ってたし。":152,"まあ、その所為なのか若干リアクションが薄いというか、\n心ここにあらずというか、\nちょっと浅めの対応だったけど──[l]\nいや、そんな、寂しい訳じゃないんだけども、\nいつもがいつもだとちょっとだけ、\nちょっとだけ気になったのだ。":153,"手洗いに行きロビーへ向かうと、\n冬夏が既に待っていた。":154,"冬夏の案内でレンタカー屋に向かう、徒歩で。":155,"「あのさ、もうこっち来て何回かの夜過ごしたよね」":156,"「よ、よるを過ごす！？」":157,"「？」":158,"「ん？あ、ああ、そう、そうね。[l]\n半月くらい経つのかな……[l]\nうわ、はええな……」":159,"「こっちの夜ってさ、\n音が全くしないでしょ？」":160,"「ああ、川沿いだけど部屋はそこそこ高い位置にあるしね、\n毎晩すんごい静かだよ」":161,"「天の川も視えるでしょ？」":162,"「まー、静かさの方は、\nもうすぐ蛙の鳴き声ですっごいうるさく\nなると思うけどね……[l]\nで、私も何回か西國とか行ったことあるんだけど」":163,"「……うん」":164,"「山間部の方は行かなかったからわかんないけど。[l]\n夜になってもさ、\n空がぼんやり明るいんだね。[l]\n街の明かりを反射してるのかな？":165,"星なんか全然視えなかった。[l]\n音が無くなる事もなかったし」":166,"「中央も、最中央はそんなもんだよ、\n僕の居た……居るとこは中央圏でも田舎の方だし、[l]\n此処と大差なかったかも……[l]\nあ、だけど水は段違いに此処のが美味いけどね」":167,"「水？」":168,"「うん、別物だなあ。[l]\n向こうの水飲んだことある？」":169,"「西國のは母様達に止められた」":170,"「ははははは……」":171,"と、レンタカー屋に着いた。[l]\n飛び込みだったが、\n平日の昼間に借りる人間は殆どいないようで、\nあっさりＯＫですよ。":172,"手続きを済ませ、\n店の外、結構離れた場所で待っていた冬夏を乗せる。":173,"「一応七時くらいまでで取ったけど、\nま、そんなにかかんないよね？[l]\nあんまり遅いとあれだし」":174,"「んーーたぶん」":175,"「で、どこいきましょうかね」":176,"お嬢様、とは継がずにおく。":177,"「海。[l]\nちょっとだけ遠いかな。[l]\n道の駅でいうとね、……」":178,"と、カーナビを設定し出す冬夏。":179,"昨日風呂場で宮さんに訊いたけど、\n海岸、\n確かに結構遠いとか、僕が昔行ったことがあるかもとか──":180,"そうだ、僕の小さい頃の記憶にあると":181,"覚しき海岸……":182,"「はい、設定できたよ。[l]\nこれでもこういう事は遣り方知ってるんだから」":183,"はっ、と気を取り直す僕。[l]\nそうか、印象としてはおつきの運転手とか居そうだもんな。[l]\n冬夏自身がこんな装置の操作なんてどうやって覚えるんだろ。":184,"「おあ、了解。[l]\nへえ、到着予定時刻一時間弱ね……[l]\n海水浴場というよりは松原なのか。[l]\nまさか泳ぎに行く訳じゃないよねえ？」":185,"「そりゃーそうだよー。[l]\n四月だよ？[l]\n視てるのが好きなの、海。":186,"あっ、水着姿が視たかったとか？[l]\nやらしー。[l]\n残念でした」":187,"「はいはい僕ぁドエロですよ。[l]\nなんとも残念じゃのうー」":188,"「ごめんなさい拗ねないでください。[l]\nあのね、海が好きなのはね、\n自分がすごく小さく視えること」":189,"箱庭の広さを認識すること、\nつまり違う価値観の視点を得ること──":190,"それは母さんが僕に言っていたことだ。":191,"「山も好き。[l]\n山が好きなのは、\nあらゆるものが生きていて、\nその中に居ることが実感できること」":192,"山は常にあらゆる音、\nそれもイキモノの立てる音がするし、\n匂いも磯のように潮の香りだけではなく、\n果てしなく何かが混在している気配がする、\nとは僕も思う。":193,"本能が目覚めるような感覚が、勿論錯覚だろうけど、ある。[l]\nヒトの文化を離れれば、\nそこはあっさりと生き死にが混在したセカイというものが\n厳然として在って、\n植物ですら動くそこ、\n喰う喰われるの":194,"場、生命のセカイがある。":195,"ヒトは、\nそこから何としても逃げたかったのだろう、\n遙か過去にも水中から逃避し陸上にあがり、\n食物連鎖から逃避して、現在のポジションに至った。":196,"バランスを崩す事によって自滅する事自体が、\nバランスを取る事になる状況、\n完全なるが故に不完全さをも完璧に内包している、\nそれがセカイ、\nつまり最悪の箱庭。[l]\nこういう話は大神もよく言っていたし、\n僕も解らないでもない。":197,"それに、旅行好きでアナクロ趣味な僕としては、\n情報のみが氾濫するあちらの世界よりも、\n眼の前の現実を体感する行為の方が魅力的である。":198,"冬夏の言から僕は、何となくそういった事を考えていた。":199,"「都会はキライだけど。[l]\nヒトがいっぱいいるの苦手なんだ。[l]\n虫とか動物は何考えてるかわかんないから、\n沢山いてもその量に驚くだけだけど……」":200,"「まあねえ……」":201,"「うちはね、\n──まあ、\nあんなだから、親戚というか、\n関係者がごっそり居るわけ。":202,"なんて言うのかなあ、気持ち悪いよ。":203,"表向き仲良く付き合ってるけど、\nほんとのところ打算まみれの繋がり、\nそれぞれがそれぞれの利権を考えて、\nなのに顔付き合わせればお互いに……":204,"あーあ、\n家族とか一族とか、\n血のつながりほどやっかいな事はないよ。[l]\n……お尻の青いコドモみたいと思ってる？":205,"いいけど。それでも。[l]\n真言さんとかきぃは好きだよ。[l]\n友達はさ、血縁でもないのに泣いたり笑ったりしてくれるから」":206,"今日、道具さんが言っていた通り……というわけか。[l]\n感情的になってきたのか、少々支離滅裂になってきてるし。":207,"「血縁というだけで、\n泣いたり笑ったりしてくれるのが家族、\nという考えもあるけどね……」":208,"「──そっか」":209,"「関係性のカテゴライズじゃなくてさ、\n個々人の問題だと思うよ。[l]\n友達恋人だと思ってても打算満載の奴もいるだろうし、\n家族だろうと他人だろうと、その」":210,"「うん。[l]\n解るんだけどね。[l]\nでもま、\n私のところはそういうんじゃないんだぁ」":211,"「うーん」":212,"「やめやめ、この話。[l]\nあはは、言い出しっぺは私か、ごめん」":213,"その後、\n暫くは他愛のない話をしたり、\nカーナビの音声を気にしつつラジオを聞いたり、\nそれこそ景色を視たりして、\nドライブを堪能していた。[l]\n宮さんと車に乗るときはアニソンばっかだったし、\n昼間の道具さん達とのドライビングはある種の労働だったし、\nこういうのは結構新鮮かもなー。":214,"もうそろそろ到着地が近いか、という辺りで、\n冬夏が先刻の話題──家族が云々の直前まで──に\n再び触れた。":215,"「でね、私。[l]\n海でも山でも、一人でこう、\nたまにだけど。[l]\n暗くなるまでずーっと座ってるんだ。":216,"自分がもし、\n言葉もなくて、\n思考の回路というものがなくて、\n生きてるものの存在をこう、":217,"言葉や理屈じゃなく『感得』するだけのモノだと思って、\nつまり『自分がヒトじゃなかった』らどんな感じなんだろうと\n考えるのね」":218,"「なーんか哲学的ですなあ……」":219,"「ま、ヒト以外のいきものが、\n生きてるって感じるのはどういう感じなのか、\n言葉のない存在が思考するってどんな感じなのか、\nそーいう事を考えちゃうわけ私って。":220,"ほら、普通はさ、何でも擬人化しちゃうじゃない？[l]\nニンゲンの論理や思考経路に即した理由付けとかしちゃってる\nよね、よく。[l]\n動物の行動に対して可愛いとか何とかさ」":221,"「本来は威嚇行動の筈の身振り手振りが、\n愛らしいニンゲンぽい行為として和やかに紹介されたりね。[l]\nまあ、実際違ってるかどうかすらも、\n本当は当人……当動物？にしかわかんないんだろうけど」":222,"「まっねー。[l]\n兎に角ね、\n他人とは違う視点、視界が必要なんだ私にとって。":223,"でも、それが……私の心の別な部分とね、[l]\n……しづらい」":224,"ん？[l]\nそれは、\nかあさんの、":225,"「え？」":226,"「んっ？[l]\nあ、別にたいしたことじゃないよ。[l]\nで、今から行くところはね、\n私が昔から──」":227,"と、\n急に視界が開けた。[l]\n今までは断崖や木々で道路横の風景が分からなかったのだ。":228,"冬夏の話に聞き入ってた事もあるが、\nそのすら声も耳鳴りと共に遠ざかる……":229,"あ──":230,"この海岸、[l]\n堤防、[l]\n砂浜、[l]\nしろのしろ、":231,"「あ、れ？[l]\nここはもし、かして」":232,"「":233,"碁":234,"石":235,"松":236,"原、視えたよ」":237,"「ごいし、まつばら……？」":238,"「私と、ある人との思い出の場所なんだ」":239,"@r@r@r@r砂浜の両端は磯になっていて、\n波しぶきが立つ音が聞こえる。[l]\n冬夏が走る車の窓を開けると、\n潮風が吹き込んでくる。":240,"@r@r@r@r記憶の鍵を刺激するのは、\n音と匂いだと何かで読んだ。":241,"@r@r@r@r脳が、空転じゃなく、\n何かが咬み合って猛烈に回転してるのがわかる。":242,"@r@r@r@rまちがいない、[l]\n僕は此処を知ってる。":243,"@r@r@r@r":244,"首が、[l]\n熱くなっていく。":245},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_029.ks","relPath":"/data/scenario/SC_M_029.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":246,"length":246,"percent":100},"cellInfo":[null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"t":"HU"}],null,[null,{"t":"HU","v":1}],null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"t":"HU"}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,[null,{"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"t":"HU"}],null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"t":"HU","v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],null,[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[242,1],"note":"完成"},"/data/scenario/SC_M_029zan.ks":{"data":[["「えっ、\nどしたの？[l]\nだいじょうぶ？」","「诶\n怎么了？[l]\n没事吧？」"],["一瞬上の空になっていた僕は、\nそれで正気に返った。","短暂失神的我\n因此回过神来。"],["「おあ、\nだ、な、その、\nごめん、大丈夫……、って[l]\nご、め、」","「呜啊\n没、那个\n抱歉、不要紧……话说[l]\n对、不、起」"],["信号赤やがなーー！","红灯啊喂──！"],["急ブレーキを踏み込む、\nしかし！","猛踩急刹\n然而！"],["「ん、あ、おっっっと！！」","「嗯、啊、哇啊啊！！」"],["気を遣ったつもりだが、\n流石に二人とも、がっくんと前のめりになるのは不可避。","虽然已经很注意了\n但两人还是不可避免地重重往前栽去。"],["「わぁお－、\n","「哇哦－\n"],["吃","吃"],["驚したよぉー、[l]\n","吓死人了啦－[l]\n"],["ちょーっと、ねえ、怖かったんですけど？」","超～级可怕的诶？」"],["マニュアル車みたいに速攻でエンストこそしなかったものの、\n一瞬テンパって操作が混乱する。","虽然没像手动挡那样立刻熄火\n但手忙脚乱中还是搞错了操作。"],["「ご、ごめんなさいすみません、\nえーーーーっ、ギヤを一速、じゃなくて…」","「对、对不起非常抱歉\n诶───、挂一档、不对…」"],["冬夏は──\nそんなこちらを視て、\n取り敢えずあははと笑ってる。","冬夏──\n看着这样的我\n总之先哈哈笑了起来。"],["……顔は引き","……表情却是僵的"],["攣ってないので、[l]\n所謂乾いた笑い、という訳ではないようだ。[l]\n肝が据わってるというか何というか…","因为没抽筋，[l]\n似乎并非所谓的干笑。[l]\n该说是胆识过人还是什么呢…"],["「落ち着こ落ち着こ、あはははっ。[l]\n私はシートベルトがちょっと食い込んだだけだし。","「冷静点冷静点，啊哈哈。[l]\n我只是安全带稍微勒得有点紧而已。"],["にしても、\n","不过话说回来，\n"],["他に車いなくて良かったね。[l]\n危うく大惨事に……」","幸好没有其他车辆呢。[l]\n差点就酿成大事故了……」"],["あれ、そう言えば、","啊咧，这么说来，"],["………。",""],["わたくしめ、\n午前中にも殆ど同じ事をしたような気がしますが……","小女子我，\n上午好像也干了几乎同样的事呢……"],["「やばいやばいやばい、\nどうもいかんなどうもいかんな……[l]\n集中集中運転に！」","「糟了糟了糟了，\n感觉不太妙感觉不太妙……[l]\n集中精神开车集中精神！」"],["「そうだねぇ、\n幾らほら、ね、","「就是说啊，\n你看嘛不管怎么说，"],["可憐な乙女とのドライブとは言っても？[l]\n","就算是和可爱少女的兜风？[l]\n"],["事故っちゃったら元も子もないんだし？」","要是出车祸就全完蛋了对吧？」"],["「ほ、ほんっと済みません……[l]\n反省しとります──\nえ、えーと此処でいいんかな？」","「真、真的很对不起……[l]\n我在深刻反省了──\n呃、那个这里停可以吗？」"],["右折車線の先には、\n道の駅の建物と広い駐車場がある。","右转车道的前方，\n矗立着公路驿站的建筑与宽阔的停车场。"],["「そそ、そこー」","「对对，就是那里ー」"],["「了解、入りまっせぇー」","「明白，这就开进去咯ー」"],["「っははは……」","「噗哈哈哈……」"],["心臓のドキドキはそのままテンションアップとなり、\nおかしなノリになる僕。","心脏怦怦直跳直接转化为高涨的情绪，\n让我变得有点high过头。"],["完全に苦笑というか、冷笑されとるけど……","完全算是苦笑吧，虽然感觉被嘲讽了……"],["「どこに停め……ても構わないか、な？」","「停哪儿……都无所谓吧，嗯？」"],["「？[l]\nん、いいよー」","「？[l]\n嗯，随便啦ー」"],["宮さんとかを乗せてる時は、\n店の入り口に近い方が好いとか、\n寧ろ遠い方が好いとか、","载着宫小姐她们的时候，\n会要求尽量靠近店铺入口，\n或者反而要停远点，"],["体調（…体重？）を慮ってか色々注文がついたものだったので、[l]\n一応訊いてみたのだ。","大概是为了照顾身体情况（…体重？）会有各种要求，[l]\n所以才姑且问一下。"],["こっちとしては勿論、\n周囲の駐車状況とか、入れ易さ出易さを考慮する訳だが、\nまあ世の中の大半は基本歩く距離を少しでも短くさせたいらしく、","我这边当然会\n考虑周围停车状况和进出方便程度，\n不过世上大多数人似乎都想尽量少走几步路，"],["おおよそ入り口近くは混雑してたものよ。[l]\n最悪、店の入り口横付けとか居たし……","所以入口附近通常都很拥挤呢。[l]\n最夸张的时候还有人直接堵在店铺门口……」"],["「いや、なんかプロポーションに気を遣ってるんじゃ\nなかったっけ？[l]\nとか思ってさ」","「不是，我以为是你在意身材比例\n才这么要求的？[l]\n刚这么想来着」"],["「……それは母様が勝手に言ってる話ね」","「……那是母亲大人擅自说的闲话」"],["「ああ、そういやそんなんだっけ……」","「啊对，说起来是有这回事来着……」"],["確執丸出しの口調になる冬夏。","冬夏的语调明显带着嫌恶。"],["そっちの話題は、矢張り根が深いのかー。","这个话题果然水深得很啊ー。"],["兎に角、一旦深く呼吸をし、\nこっちも何とか平静さを取り戻した。","总之先深呼吸，\n我也总算恢复了平静。"],["適当に空いてるところ……","随便找个空位……"],["──ほぼカラなので、\n隣に後から車がこなさそうな位には\n外れの方に車を入れる。","──几乎全空的状态，\n特意选了边缘位置停车，\n确保后来车辆不会停到旁边。"],["「にしてもさっきはどうしたの？[l]\nやっぱり疲れてたとこ無理させたのかな私？」","「不过刚才怎么回事？[l]\n果然是我让疲劳驾驶的你勉强开车了吗？」"],["「や、それは大丈夫、\nただその……」","「不、那倒不是，\n只是那个……」"],["道の駅自体には、\n恐らく僕が玄ノ森を出てから作られたからなのか、\n全く見覚えが無いが、","这座公路驿站本身，\n大概是我离开玄之森后才建成的，\n完全没有印象，"],["道すがら視えた海辺の景色は、\n完全に既知のものとして頭が認識している。","但沿途看见的海滨风景，\n大脑却完全当作熟悉的事物来认知。"],["「……昔、小さい頃僕この辺に──居たことがあるっぽいことは知ってるよね？」","「……以前小时候我好像──在这附近住过的事你知道吧？」"],["「あ、きぃがなんかそれっぽいコト言ってたかも」","「啊，小贵好像说过类似的话」"],["そう、\n結局最初に彼奴──きぃに会ったときも、\n僕が此処の出身かどうかは曖昧にしてたような、\n気がする。","说起来，\n最初遇见那家伙──小贵的时候，\n关于我是否出身于此地这件事，\n总觉得她故意含糊其辞。"],["なし崩し的にというか、\nきぃが僕を幼少期に遊んだ二個上の知り合いだと\n半ば強引に断定した御陰で、","不知该说是顺水推舟，\n还是因为小贵单方面咬定我是她童年玩伴\n（还比我大两岁），"],["少なくとも滞在した経験アリ、という\n感じには認識されたのだが、","结果就被当成至少在此地\n生活过的人，"],["如何に僕が空転脳の持ち主とは言え、\nきぃの自己申告のみが論拠であるその\n『我々の過去』は、\nあまりに薄弱過ぎないか？","但就算我再怎么健忘，\n仅凭小贵的片面之词就认定的\n『我们的过去』，\n未免太缺乏说服力了吧？"],["今に始まった疑問では無い筈だが、\n無意識的に意識しないようにしてきたのか、","这疑问并非现在才有，\n或许是我潜意识里一直回避思考，"],["たまさかあの時は、\n調査に都合が良かったのもあって状況を\n受け入れたのだが、","加上当时正好\n便于调查才顺势\n接受了这个设定，"],["未だ確証は、無い……のだ。","可至今仍没有确凿证据……"],["無闇に疑うことは不安を生じさせる。[l]\nそれは防衛本能ではあるが、\n何でもかんでも疑心暗鬼的に疑うにしても\nそれはそれで根拠が弱い。","胡乱猜疑只会徒增不安。[l]\n这虽是防卫本能，\n但若对凡事都疑神疑鬼\n同样缺乏依据。"],["午前中に道具さんから、\n彼女ときぃとの関係については聞いたのだけれど、\n……そもそもあの人が何処まで本当の事を語ってるのか[l]\n分からない以上、","上午虽然从道具小姐那里\n打听了她和小贵的关系，\n……可说到底那人说的话有几分真实[l]\n根本无从判断，"],["いや、それこそ疑心暗鬼というものなのか……[l]\nしかし、","不，这反倒成了疑神疑鬼的典型……[l]\n不过，"],["大体、きぃが僕を","话说回来，小贵算计我"],["謀って何の得が。","能有什么好处。"],["……あるのか？[l]\nだとしてもどういう、","……真有吗？[l]\n就算有又会是哪种——"],["「よっ」","「哟」"],["「のわ！」","「哇啊！」"],["急に眼前に冬夏の顔が割り込んだ。","冬夏的脸突然插到眼前。"],["「話も途中でエンジンも切らないで、\nさっきのまだ気にしてる？[l]\n","「别聊到一半就熄火啊，\n还在在意刚才的事？[l]\n"],["あんまり悩むと逆に危ないよ？」","想太多反而危险哦？」"],["「あうあ、すみません…」","「啊呜啊，对不起…」"],["しょうがない、今は忘れよう。[l]\n……そのまま忘れ去りそうだけど、[l]\n仮にも人命預かってる訳だし。","算了，先忘掉吧。[l]\n……虽然可能会彻底忘记，[l]\n但毕竟事关人命。"],["「やっぱなんか上の空よね。[l]\n","「果然心不在焉呢。[l]\n"],["ほんとに大丈夫なのかな？[l]\n","真的没问题吗？[l]\n"],["ちょっと休んですぐ帰っちゃう？」","要不要休息下直接回去？」"],["「いや、ごめん大丈夫。[l]\n朝がちょっとだけ早かっただけで、\nあとで腹に何か入れれば…あとは[l]\n少し歩いて風に当たれば何とか」","「不，抱歉我没事。[l]\n只是今早起得稍早，\n待会儿吃点东西…再[l]\n吹吹风走走就能缓过来」"],["「ほんと？[l]\n昼寝とかしなくて大丈夫ー？[l]\n","「真的？[l]\n不用睡午觉吗ー？[l]\n"],["また膝枕したげるよ？[l]\n","可以再给你膝枕哦？[l]\n"],["ついでに耳掃除もしたげるよ？」","顺便掏耳朵服务也有哦？」"],["「今回は丁重にお断りさせて頂きます……[l]\nというか何の話してたんだっけ」","「这次请允许我郑重拒绝……[l]\n话说刚才聊到哪了」"],["言ってる側から脳は空転してるみたいだなあ。","说着说着脑子又开始放空了。"],["「此処知ってるーとかの話しようとしてたんじゃない？[l]\n小さい頃来たとかなんとか」","「不是要说『知道这里ー』之类的事吗？[l]\n小时候来过什么的」"],["「ああ、そうだった。[l]\n僕ぁ記憶力には全く自信がないんだけど、\nどうも此処は──」","「啊，对。[l]\n虽然我对记忆力完全没自信，\n但总觉得这里──」"],["みにおぼえが。","完全没有印象。"],["「子供の頃にこの辺りに滞在してた事も考えると、\n可能性は高いかも。","「考虑到小时候曾在这附近住过的事，\n可能性或许挺高的。"],["碁石松原って名前には聞き覚えないけど、\nまあ子供の頃に聞いてたとしてもそんな固有名詞まではね……[l]\n学校あがる前の話だし」","虽然碁石松原这名字没啥印象，\n不过就算小时候听过也不太会记得这种专有名词吧……[l]\n毕竟都是上学前的事了」"],["「ほほー」","「嚯嚯——」"],["と、顎に手を当て考え込む冬夏。","冬夏托着下巴陷入沉思。"],["「学校あがる前っていうと、\n６、７歳くらい」","「说到上学前的话，\n大概六七岁左右？」"],["「え？[l]\nああ、そう……かな。[l]\nまあ、直前だとすればだけど」","「咦？[l]\n啊，是……吧。[l]\n呃，至少最近那次应该是」"],["「今真言さん二個上だよね」","「现在真言先生比你大两岁对吧」"],["「？[l]\nそのはずだけど」","「？[l]\n应该是这样没错」"],["や、今も昔もこれからも、\n二個上という歳の差は変わらんのだけれども。","不过现在过去将来，\n大两岁的年龄差都不会变的啦。"],["「ふーん……」","「嗯哼……」"],["「なぞした？」","「猜到了？」"],["「え？[l]\n","「诶？[l]\n"],["なーんでも。[l]\n","没——啥。[l]\n"],["おっと」","哎呀」"],["シートベルトを外す冬夏。","冬夏解开安全带。"],["「いい加減降りよっか」","「差不多该下车了吧」"],["「うん、\nあっ、\n取り敢えずまずエンジン切らにゃー」","「嗯，\n啊，\n总之得先熄火才行」"],["どるるるん。","嘟噜噜噜——"],["──静かになった。","——安静下来了。"],["「うーん」","「唔—嗯」"],["「あれ、行かないの？」","「咦，不出发吗？」"],["「さっき私、\nある人との思い出の場所って言ったじゃない？」","「刚才我不是说了，\n这是和某个人的回忆之地吗？」"],["「？[l]\n言ってたねえ」","「？[l]\n是说过呢」"],["「ある人って言っても、\nその、素敵な男子ーっ、ていうより、\nちっさな男の子なんだよね」","「虽说是某个人，\n不过与其说是帅气男生——\n其实是个小男孩啦」"],["……ほう。","……哦？"],["「真言さんじゃないけど、本当は私も小さい頃の事\nあんまり覚えてないのね。","「虽然不是真言先生，但其实我小时候的事\n也记不太清了。"],["ただ、\nあんまり母様が連れ出してくれなかったからこういう所。[l]\n逆に行ったときのことはよっく覚えてるんだけど」","只是，\n因为母亲很少带我出门，所以这种地方。[l]\n反而对去过的事记得特别清楚」"],["「あの時も確かね、\n西國の──知り合いのね、ドウトモさんって人に\n連れられて……どうだっけな…他に何人かと、","「那时候好像也是，\n被西国的——熟人啦，姓堂友的那位\n带着……来着？还有其他人，"],["まあ、何か私が我が儘言ってた様な気も、\nそれにも理由があった気もするけどそこまではね」","呃，可能我当时有点任性，\n虽然感觉那也是有原因的不过记不清了」"],["「うむ……」","「嗯……」"],["「でね、\nその子の事、\nいーちゃん……って呼んでたんだけど、[l]\n今にして思えば名前なのか名字なのか……","「然后啊，\n那个孩子，\n我管他叫饭饭……不过现在想想，[l]\n不知道那是名字还是姓氏……"],["お互いちっちゃかったし、こっちも気にしてなかったし」","毕竟都还小，我也没在意」"],["──いーちゃん？","——饭饭？"],["おい、まさか。","喂，难道。"],["……そんな偶然が。","……会有这种巧合吗。"],["てっきり、屋上で浮かんだ海岸の情景、\nそれが過去の記憶だと……つまり、[l]\nきぃだと思っていたのに、","还以为屋顶上浮现的海岸情景，\n是过去的记忆……也就是说，[l]\n原以为是和小贵有关的，"],["あ、そう言えば、","啊，说起来，"],["と冬夏が思い出したように言った。","冬夏突然想起什么似的说道。"],["「今更なんだけど、\n真言さんの名字って何？[l]\n聞いてなかったよね」","「虽然现在才问有点晚，\n真言先生的姓氏是什么？[l]\n之前没听说过呢」"],["うっ。","呜。"],["きぃにも伏せていた、\n飯窪の姓。","连小贵也瞒着的，\n饭洼这个姓氏。"],["今ここで隠すのも変だし、\n実際珍しい名字ではないから知狡さん達との関連を\n訊かれても偶然で済ませられるかも知れないが、","现在在这里隐瞒也很奇怪，\n实际上也不是什么罕见的姓氏或许被问到和知狡阿姨她们的关系时\n可以用巧合搪塞过去，"],["「……うひひ、[l]\nヒ・ミ・ツ♪」","「……唔嘻嘻，[l]\n秘·密♪」"],["謎多き男子としてノリで隠し通す事にしました。","决定以神秘男子的人设顺势隐瞒到底。"],["「へぁっ……」","「诶诶……」"],["かなり珍妙な脱力声を出す彼女。[l]\n……そらそうよね。","她发出相当古怪的泄气声。[l]\n……确实会这样呢。"],["「いやまあ、ただですね。[l]\nいーくんとは呼ばれたりもするよ、\n友達には。","「不不，只是呢。[l]\n也有人会叫我饭君，\n朋友之间。"],["──後はそこから適当に想像してくれ給え、\nあはははははは」","──剩下的就请自行想象吧，\n啊哈哈哈」"],["色んな意味で気が引けたので、\n取り敢えずそこまでは言ってみる。[l]\n嘘もついてないし？","出于各种意义上的心虚，\n暂且说到这个程度。[l]\n也不算说谎吧？"],["「何それ？[l]\n","「什么啊那是？[l]\n"],["でも、そう、そう呼ばれてる事もあるんだね──？」","不过，也就是说确实有人这么称呼你──？」"],["じゃあ可能性としてはある訳ね。","那么这种可能性是存在的呢。"],["と、つぶやいた──\nように聞こえた。","这样，喃喃自语──\n般的声音传来。"],["「まあ、\n僕がその男子だとお話としてキレイだけどなぁ。[l]\n偶然再会した幼なじみの男女、\nキレイってかベタもいいとこだけんどもさぁ」","「嘛，\n虽然要说我就是那个男子故事会很浪漫呢。[l]\n偶然重逢的青梅竹马男女，\n说浪漫都算老套到极点就是了」"],["「ん？[l]\n","「嗯？[l]\n"],["いいじゃんベタでも。[l]\n王道ってことはみんなが好きだからでしょ。","老套也不错啊。[l]\n王道正是因为大家都喜欢吧。"],["あれ、それとも、\n……話合わせてるとか？[l]\nんっ、それってつまり、」","啊咧，还是说，\n……你在配合我说话？[l]\n嗯，那也就是说，」"],["何やらくねくねし出す冬夏。","冬夏突然扭扭捏捏起来。"],["「つまりこれは運命とかって言って、\n口説いてる？[l]\nそうなら、\n","「也就是说这是在说命运之类的话，\n算是在搭讪吗？[l]\n如果是的话，\n"],["──ノってあげてもいいけど」","──配合你一下也不是不行哦」"],["キラッ☆\nとでも擬音の付きそうな、\n変なウインク＆手振りで流し眼を送っております。","闪亮☆\n仿佛自带这种拟声词的，\n用古怪的眨眼加手势抛了个媚眼。"],["「──。[l]\nえー、\nあー、\n毎度のことだけども、","「──。[l]\n呃，\n啊，\n虽然每次都是这样，"],["こういった場合どうレスしても、その、[l]\n何かしら問題ある気が……」","但这种情况下怎么回应总觉得，[l]\n好像都会出问题……」"],["大体、\nユーとアイしか居ない状況で言うおふざけではないよね、\nというか、第三者が居てこそ茶化しようもある訳で……","说到底，\n在只有你和爱两个人的情况下开的玩笑不一样吧，\n或者说，有第三者在才好打圆场……"],["宮さんとの付き合いの中でもこの辺りのスキルは\nアップしてないな……","和宫小姐交往时这方面的技能\n也没提升呢……"],["うーむ、単にあのひと個人の言動に馴れただけで、\n別の女子に応用を利かせられる訳じゃなかったか。","唔，单纯只是习惯了那个人的言行，\n没法应用到其他女生身上吗。"],["冬夏はと言えば、\n素に戻って──半分照れ隠しなんだろうけど、","至于冬夏，\n恢复常态──虽然一半是为了掩饰害羞，"],["「その辺はまー、\n社交辞令でもイエスって言うのが\n男子の甲斐性ってヤツじゃない？[l]\nそれともさっきの上司さんに遠慮してるのかなぁ？","「这方面嘛─\n就算是客套话也该说YES\n才是男子汉的器量吧？[l]\n还是说在顾忌刚才那位上司呢？」"],["ん？どうなのですかのう、ほれほれ」","嗯？怎么搞的啊，来来」"],["と言う。","说道。"],["「や、あのひとぁ関係ないですよ……[l]\nそれに社交辞令ったってな、\n僕あたりが言ったってマジキモイとか\n言われるのがオチだと思ってさ。","「呀、那个人和我没关系啦……[l]\n再说了就算是客套话，\n像我这种人说出来也只会被骂恶心\n结局肯定是这样的啦。"],["遠慮したんだよこっちは」","我这边才是在顾虑啊」"],["「えーなによそれ、\nキモイと思ってるひとに膝枕なんか\nするわけないでしょー？","「诶～什么意思嘛，\n觉得恶心的人怎么可能\n会给膝枕啊～？"],["二人っきりのドライブにも、\nこうやって誘ってるんだから。[l]\n少しは自信持ちなさい」","就连两人独处的兜风，\n不也像这样邀请你了嘛。[l]\n稍微有点自信啦」"],["「ははは……[l]\nまあ、ね、\nそうだったらいいけど……」","「哈哈哈……[l]\n嘛，也是，\n要是真那样就好咯……」"],["その辺は宮さんに釘を刺されたからねえ。","毕竟那方面被宫小姐警告过了啊。"],["どっちが正しいというでもなく、\nケースバイケース、\n個々の場合による事柄で、\n正解なんか無いんだろうけど……","倒不是说哪边才是正确的，\n具体情况具体分析，\n每件事都有个体差异，\n本来就不存在标准答案吧……"],["ま、でもその枯れっ振りが真言さんよね、","不过嘛，这种老气横秋的地方才像真言，"],["と言って冬夏は腕を組んだ。","说着冬夏抱起了胳膊。"],["あ、いやいや、僕とではなく、\n一人で腕組みをした、という事で。","啊不不，不是和我，\n是她自己抱胳膊的意思。"],["「でもたまには押しも強くなきゃねー。[l]\nその辺のバランスはやっぱ求められるかな。","「但偶尔也得强势点才行呢～[l]\n这种平衡果然还是需要的吧。"],["めんどいよぉー女子を相手にするのって。[l]\n女子同士だってめんどくさいのにさ、\n色恋沙汰と来た日にゃあ」","应付女生超麻烦的啦～[l]\n女生之间都够麻烦了，\n更何况牵扯到男女感情」"],["女子の会話ってほんとに『被せ合い』で、\n全然咬み合ってない感じなのにお構いなしで\n進んでくもんな。","女生的对话根本就是『抢话大赛』，\n明明完全接不上茬还能自顾自\n推进话题呢。"],["それはちと違うんかな。","这或许有点不同吧。"],["「その辺はよっくわかってるつもりだけど……","「这方面我自认为很懂啦……"],["それにアナタだって、\nその少年にその、\n恋慕してた訳じゃないの？[l]\nその彼に対して遠慮はないのかね」","再说你不也，\n对那个少年，\n有过那个、爱慕之情吗？[l]\n对他就不需要顾虑了吗」"],["「おや？[l]\n私は思い出の場所とは言ったけど、\n恋心を寄せていたとは一言も？」","「哎呀？[l]\n我只说过是充满回忆的地方，\n可没提过半句有过恋心哦？」"],["「え゛っ。[l]\nありゃ、そうだっけ？」","「呃诶。[l]\n啊咧，是这样吗？」"],["思わず狼狽えてしまう僕。","我不由得狼狈起来。"],["「や、だってそう思うさあの流れではよ。[l]\nな、なーんだ違うのか、」","「呀、因为那个发展任谁都会那么想吧。[l]\n什、什么嘛原来不是啊，」"],["「あれ、言ってないだけで、\n実はそうかも知れないという可能性は\n捨てるんだ？","「啊啦，没明说就代表\n要排除这种可能性吗？\n说不定其实有呢。"],["それに、\nほんとに……さんだったかも知れないし──」","而且，\n搞不好真的是……先生也说不定──」"],["「？」",""],["「──や、いいや。[l]\nなんでもない。[l]\n","「──啊，算了。[l]\n当我没说。[l]\n"],["なぁんでもなぁいよぉ～」","什～么都～没有啦～」"],["「あ、そう……」","「啊，这样啊……」"],["色々考慮の上、追求は止しておいた。","经过多方考虑，我决定不再追问。"],["……やっぱり、[l]\nどうもテンションが高いよな。[l]\n何というか、酔ってる感じに近いというか。","……果然，[l]\n总觉得她情绪异常高涨啊。[l]\n该怎么说，接近于喝醉的感觉。"],["少しの間会ってなかったからそう感じるだけで、\n元からこんなものだっけか？[l]\n最後に視たのがあの式だったし、\nちと荘厳さでイメージ補填されてたのかも。","或许只是因为太久没见才这么觉得，\n原本就是这么嗨的吗？[l]\n毕竟上次见面是在那场仪式，\n可能被庄严感美化印象了吧。"],["ともあれ、そんな会話し続けるのも不毛、\nというか初期の目的と違うんで。[l]\n僕は、しっぱなしだったシートベルトを外し、\n二人で車を降りた。","总之，继续这样的对话也没意义，\n或者说和最初的目的不一样了。[l]\n我解开一直没松的安全带，\n两人下了车。"],["施錠施錠……と。","锁车锁车……这样。"],["見渡すまでもなく、\n殆ど駐車中の車は無い。","根本不用环顾四周，\n几乎没什么停着的车辆。"],["冬夏達の高校が休みとて、\n完全に平日の昼下がりである。","毕竟冬夏他们的学校放假，\n现在完全是工作日的午后时分。"],["ショッピングモールとかならいざ知らず、\n単なる東部北部の観光地──しかも海岸、オフシーズンもいい所、\nであるこの碁石松原、","如果是购物中心倒还另当别论，\n但这里只是东部北部的观光地——而且还是海岸，淡季时节，\n这个碁石松原，"],["道の駅の売店には、たむろするお年寄り達が視えはするものの、\n基本的には閑散としている。","虽然能看到公路驿站小卖部前聚集着些老人家，\n但基本上很冷清。"],["そう言うと、","听我这么说，"],["「んー、ま、私もよく知らないけど、\n基本的に海水浴場って訳でもないし。","「嗯——嘛，虽然我也不太清楚，\n基本上也不是什么海水浴场啦。"],["純粋に景観っていうの？[l]\nそういうので有名みたい。[l]\nだから、」","纯粹就是景观之类的？[l]\n好像是以这个闻名的。[l]\n所以，」"],["年中ヒトは","全年人流"],["疎らなんだと。","都很稀疏啦。"],["まあ……そんなもんよね。","嗯……确实如此呢。"],["「もしかしたらなんかお土産で良いのあるかもだけど。[l]\nあんまり期待出来ないかなぁ。[l]\n例の土産屋も家の関連だけど、\nなんか変なお菓子を最近新作作ってたくらいで」","「说不定会有什么不错的特产哦。[l]\n不过可能别抱太大期待啦～[l]\n那家特产店虽然和我家有关联，\n但最近也就新出了些奇怪点心什么的」"],["ああ、あれか……[l]\n旨いは旨いけどね。","啊，那个啊……[l]\n好吃是好吃啦。"],["「僕もよく旅行するからその辺は承知してるけど、\n道の駅とかだと……地元産の野菜とかがメインていう印象が……[l]\nあ、この辺だと海産物とか？[l]\n余計に食指が動かんけど……」","「我经常旅行所以知道这些，\n公路驿站的话……印象中主要是卖本地蔬菜之类的……[l]\n啊，这附近的话是海产吗？[l]\n反而更提不起兴趣了……」"],["あとは地域限定なんたらと言いつつ、\nそのそもそもがとある地域の特産物ネタだったはずの、\n本末転倒になってるキャラものストラップとかあるんだぜ。","还有些号称地区限定款，\n其实原型根本就是某地特产的、\n本末倒置的角色挂件之类的东西呢。"],["「あれ、海産だめなんだっけ。[l]\n前聞いたっけ？」","「咦，你不吃海产的吗。[l]\n之前听你说过？」"],["「言ったような言わないような、\nうーん、\n別の人に言ったんだったかもうそれすらも」","「好像说过又好像没说，\n唔——\n可能是对别人说的或者连这个都记混了」"],["「あっははは、\n惚け同志コンビやばいね」","「啊哈哈哈，\n健忘二人组真是绝了」"],["「…忘れるくらいだからたいした事じゃないとかね……[l]\nま、厭な事ずっと覚えてて夜思い出しては呻くよりはマシだよ。[l]\nあははは……」","「…能忘记说明也不是什么大事吧……[l]\n嘛，总比一直记着讨厌的事半夜想起来呻吟要强。[l]\n啊哈哈哈……」"],["「あははは」","「啊哈哈哈」"],["寝れば大体リセットされるんだ、と言うと、\n冬夏もそうそうそうそうそうよねーーと、\nすごい勢いで同意してきた。[l]\nそうなんか。","我说睡一觉基本就能重置记忆，\n冬夏也连连说是啊是啊对对对——\n超用力地点头赞同。[l]\n这样啊。"],["「でも……顔付き合わせる相手が原因だと[l]\n中々そうも行かないのがね……」","「不过……如果导致压力的是要见面的对象[l]\n就没这么简单了呢……」"],["「うーん……」","「唔……」"],["としか言えない。","只能这么应和。"],["「ほら、ゆえに旅館に来たので！[l]\nいいストレス解消相手も居ることだし？[l]\nだいじょぶだよ」","「你看，所以才会来旅馆呀！[l]\n不是还有超棒的减压对象在嘛？[l]\n没问题的啦」"],["「おほほほ……[l]\nぷちぷちでも買って帰ろうか」","「哦呵呵呵……[l]\n要不买点噗叽噗叽回去？」"],["「ああ、あれ。[l]\nいやいや、もっといいのがありますからぁ、\nあっははははは」","「啊，那个。[l]\n不不，我们有更好的东西哦，\n啊哈哈哈哈」"],["あうあ。[l]\n──ああ、もう、\n宮さん変な対抗意識燃やさなけりゃいいけど……","啊呜啊。[l]\n──啊啊，真是的，\n宫小姐要是别燃起奇怪的对抗意识就好了……"],["「ほら、いきましょいきましょ」","「来啦，走咯走咯」"],["矢鱈と高い堤防の切れ目を抜けると、\n松原というだけあって、\n駐車場から海岸までは防砂林エリアが設けられている。[l]\nその中を走る遊歩道を、二人して海岸へと向かい歩いていく。","穿过胡乱堆砌的高高堤坝缺口后，\n不愧是叫做松原，\n从停车场到海岸间设有防砂林区域。[l]\n两人沿着林中步道，并肩朝海岸方向走去。"],["「うちの辺りは山だけど、\nこの辺海岸がこう入り組んでるじゃない？[l]\nそうリアス式海岸ってやつね。[l]\nだから昔結構おっきな津波がきたことあるらしくて」","「我家那边都是山，\n但这边的海岸线特别曲折对吧？[l]\n就是所谓的里亚斯式海岸啦。[l]\n所以听说以前遭遇过挺大的海啸」"],["「へえ」","「嘿欸」"],["「学校でも避難訓練毎年きっちりやるよ。[l]\n地震のも津波のも。[l]\nなんかどっかに体験館とかみたいな施設あったはず」","「学校每年都会认真进行避难训练哦。[l]\n地震和海啸的都有。[l]\n好像还在哪建了体验馆之类的设施」"],["「そうなんだ？」","「这样啊？」"],["学校に上がってからの暮らしは殆ど中央なので、\nあまりそういう感覚は無かったなあ。[l]\n……まあ、[l]\nそもそも記憶があやふやなのはあれとしてですよ。","因为上学后基本都住在中央区，\n对这类事情没什么实感呢。[l]\n……不过，[l]\n说到底记忆模糊这件事本身就很可疑啊。"],["「あー、潮の香りがするぅー」","「啊──能闻到潮水的味道欸─」"],["言われると途端に嗅覚が鋭敏になった気がして──","被她这么一说突然觉得嗅觉敏锐起来──"],["「確かに、波の音もする……おあっ」","「确实，还能听见浪声……哇啊」"],["林を抜けた。","穿出了树林。"],["眼前に広がる景色、","在眼前展开的景色，"],["確かにこれは、","确实，"],["視たことがある風景だった。","是曾经见过的风景。"],["「……ってる、[l]\nやっぱり知ってるなぁ。[l]\nうーん」","「……果然，[l]\n还是记得的吧。[l]\n唔─」"],["「どうしたの？[l]\n何か疑問でもある？」","「怎么了？[l]\n有什么疑问吗？」"],["──考えてみれば、\n幼少期僕は玄ノ森に居たのだから、","──仔细想想，\n幼年的我确实住在玄之森，"],["現在の僕の記憶力がアレなだけで、\n『此処』を知っていた事自体は格別不思議では\nないのだけれど、","虽然现在的我记忆力很糟糕，\n但『知道这里』这件事本身并\n不算特别奇怪，"],["「いや、まあ、\n……不自然事じゃないんだよな別に。[l]\nでも」","「不，那个，\n……倒也不是什么不自然的事。[l]\n只是」"],["何故か先刻はそれが、\n重大な事に思えてしょうがなかったのであった。","不知为何方才，\n总觉得这事重要得不得了。"],["実際、\nもしかすると冬夏の知る少年が僕である可能性もある、","实际上，\n说不定冬夏认识的那个少年就是我，"],["しかし、それは、\nきぃとの記憶が怪しくなるという事でもある。","但那样的话，\n和小贵的记忆就会变得可疑。"],["一体どちらが、或いはどちらも、\nそれとも──","到底哪边才是，或者两边都是，\n又或者──"],["すなのしろ──？","沙之白──？"],["しろのしろ──？","白之白──？"],["「いきましょっ」","「走啦」"],["何時までもぼーっとしてる僕に、\n呆れたのか気を遣ってくれたのか。","对着始终发呆的我，\n不知是无奈还是体贴。"],["突然冬夏が僕の手首を掴んで、","冬夏突然抓住我的手腕，"],["「やーな事はっ！[l]\n","「把烦心事！[l]\n"],["全部水に流すの！！[l]\n","全都冲进大海吧！！[l]\n"],["このおっきなぁ、」","用这片巨大的──」"],["「うわあ」","「哇啊」"],["引っ張られる。[l]\n二人して","被拽着跑。[l]\n两人"],["蹌","踉"],["踉けながら砂浜を走り、\nそのまま、\n波打ち際に向けて──","踉跄着穿过沙滩，\n就这样，\n朝着浪花边缘──"],["「うぅーみぃーにぃーーーーーーっ！！！！！」","「呜哇～米～妮～～～～～～～！！！！！」"],["僕を押し出した……っておい！！","把我推出去……喂喂！！"],["「でぇああーーーー？！」","「诶诶诶诶～～～？！」"],["ざしゅ。","沙沙。"],["「あぶなーーーー！！！！」","「危～～～～～～！！！！」"],["間一髪、\nてほどのものでもなかったが、\n単純に","千钧一发，\n倒也算不上，\n单纯是"],["驚しましたよ？！","被吓到了啦？！"],["幾ら僕が非肉体系とは言え、\n流石に女子の力では水中に突き落とすまでは\n行かなかったようだ。","虽说我是非肉体派，\n但女孩子的力气终究还是\n不足以把我推落水中。"],["が、\n水没こそしなかったけれど、","不过，\n虽然没彻底落水，"],["「ごめん大丈夫？[l]\nころんじゃったねあはは」","「抱歉没事吧？[l]\n摔了个屁股蹲呢哈哈」"],["「謝るならしなさんな……よっと」","「要道歉就别推人啊……嘿咻」"],["手と足はすっかり砂……泥まみれに[l]\nなってしまった。","手脚都沾满了沙……还有泥巴[l]\n变得脏兮兮的。"],["「まま、それも含めて水に流そうか！」","「嘛嘛，连这些也一起冲进海里吧！」"],["「どんな理屈じゃい」","「这算什么歪理啊」"],["立ち上がりつつするツッコミも、\n眼前の景色に緩衝されて、\nなんかどうでもよくなる。","边起身边吐槽的举动，\n也被眼前的景色缓冲，\n莫名觉得无所谓了。"],["二人して濡れない所まで移動して、\n改めて海を向く。","两人移动到不会被浪打湿的地方，\n重新面向大海。"],["うーん、","嗯——"],["判ってた事だが、","虽然早就知道，"],["「………」",""],["──だっっっっれも居らんがな。","──但根本没人嘛。"],["秋冬では無いから陽射しはぬるいし、\n色彩的にも彩度はあるんだけども、\nなんか寒々しい雰囲気ではある。[l]\n単に手足の泥の所為かも知れないが。","因为不是秋冬季节所以阳光温吞，\n色彩饱和度明明很高，\n却莫名透着股寂寥感。[l]\n也可能单纯是手脚沾泥的缘故。"],["「にしても、\nわぁお人居ないねぇこれ。[l]\n貸し切り？[l]\nプライベートビーチ的な？」","「话又说回来，\n哇哦真的没人诶。[l]\n包场了？[l]\n私人海滩那种？」"],["……まあ、なんというか、[l]\n砂浜と言えばこれ！な感じの藻屑か何かが、[l]\n一昨日の嵐の所為か波打ち際にびっしり\n流れ着いてるので、","……不过该怎么说呢，[l]\n沙滩必备的那种海藻还是什么的，[l]\n因为前天暴风雨的缘故密密麻麻\n堆积在浪边，"],["そういうセレブリティな雰囲気には","所以完全感受不到"],["浸れないけど……","那种高端氛围啦……"],["ともあれ黙って潮風に身を委ねてみる。","总之先默默沉浸在海风中。"],["ざぁ……","哗啦……"],["さぁ……","唰啦……"],["道路からも離れてるので、\n波の音だけがやけに耳に響く。","因为远离公路，\n浪花声格外清晰地回荡在耳边。"],["「うん、よし！！[l]\n","「嗯，好！！[l]\n"],["海だよ！[l]\n","是大海耶！[l]\n"],["海だ海だぁぁぁっ！！」","大海大海啊啊啊！！」"],["突然、\n静寂を打ち破る雄叫びと共に、\n冬夏は靴と長靴下……ニーソとか言ったか、[l]\nをもどかしそうに脱ぐと、","突然，\n伴随着打破寂静的呐喊，\n冬夏急不可耐地脱下鞋子和长筒袜……是叫膝上袜来着，[l]\n三两下甩掉之后，"],["「いってくる！！」","「我出发啦！！」"],["「へ！！？[l]\nどこに！！ってえ、ちょっと！！」","「哈！！？[l]\n去哪！！喂等等！！」"],["先刻僕が突き飛ばされた地点を完全に越えて、","她完全越过刚才推我的位置，"],["ばしゃしゃしゃしゃ！","啪嚓哗啦哗啦！"],["「ひぁっ！？[l]\nつ、つめたいっ！！[l]\nあはっ、あはははははははっ！！[l]\nひーーーんひゃっこいってばこれはっ！！」","「呀啊！？[l]\n好、好冰！！[l]\n啊哈，啊哈哈哈哈哈哈哈！！[l]\n呜～～～哇超冰的啦这个！！」"],["波打ち際というの？[l]\nまあ、完全にあれは、\n水に入っちゃってますよね。","是叫浪花边缘来着？[l]\n嘛，那完全就是\n已经泡在水里了吧。"],["や、裸足になった時点でよもやと思ったけども、\nまだ四月でしょう？[l]\nこの辺じゃまだ……ていうか、[l]\n冷たい自覚はあるのか。","虽、虽然光脚的时候就有不祥预感了，\n现在才四月份吧？[l]\n这附近应该还……不对，[l]\n你倒是有点自觉啊很冷的。"],["ああああ、ひゃっこいひゃっこい言いながら、\nえらい勢いで足踏みまで……","啊啊啊，一边喊着好冰好冰，\n一边拼命跺脚……"],["「あんよー、タオルとか持ってきてないやんな……」","「脚脚——根本没带毛巾之类的吧……」"],["思わず謎の方言の遣い手となる僕。[l]\n風邪とか引かないといいけど……","我不自觉飙出了谜之方言。[l]\n可别感冒了啊……"],["「あーーーもうテンション上がったぁっ！！[l]\nあ、がっ、た、よっ──と！！」","「啊————已经嗨到不行啦！！[l]\n啊，看，我，跳——哟！！」"],["ばさ！","啪沙！"],["何の躊躇もなく、\n彼女はワンピースの裾をたくし上げた。","没有丝毫犹豫，\n她将连衣裙下摆高高撩起。"],["眼を逸らす間もあればこそ、","连移开视线的空隙都没有，"],["「えっ！！あっっ？？[l]\nちょ！！」","「诶！！啊？？[l]\n等！！」"],["冬夏はあっと言う間に腰の部分で長い裾部分を結び、\nつまり","冬夏瞬间用腰部系住长长的裙摆，\n换句话说"],["御","御"],["足をほぼ全露出と言いましょうか、\nいや、その。","几乎把腿全露出来了，\n不，那个。"],["「ふぁあああ、さぶい！！[l]\nさぶいよこれ、すっごいさぶいぃーー！！」","「哇啊啊，超冷！！[l]\n这个超冷的，冷死啦————！！」"],["「お、ちょ、し、心臓に悪いことを……」","「喂、等、这、这对心脏不好……」"],["……こっちのですがね。","……我说的是我自己啦。"],["「さぶいならしなきゃよろしいでしょ……」","「觉得冷就别这么做啊……」"],["それでも兎に角笑いながら、更に深い所に\nばっしゃばしゃ歩いていく。","即便如此她还是边笑边往更深的地方\n哗啦哗啦走去。"],["流石に、何の対策も無くそんな行為をする訳はなくて、\n彼女は下に、所謂ぶるまーを着用してたのでした。","当然不可能毫无防备就做这种事，\n她下面穿着所谓的打底裤。"],["午前に狩屋のも視てるんですが……[l]\n今日ってそういう日？[l]\n何の日よ。[l]\nえ、昨今の女子て、デフォルトで穿いてるの？","早上还看到狩屋也……[l]\n今天是特殊日子？[l]\n什么日子啊。[l]\n难道现在女生默认都会穿这个？"],["大神や宮さんから流れ来る情報によりますれば、\nその着こなし（？）にかえって通常の下着よりエロスを感じる御仁も結構居られるという噂。","根据大神和宫小姐那边流传的情报，\n据说这种穿法（？）反而比普通内衣更让某些人觉得情色。"],["まあ、水着も下着も、文化的","嘛，泳装和内衣在文化"],["約","约"],["款がなけりゃ一緒だもんね。[l]\nその約束事という背景込みでどうこうするのが、\nモエるんだとかなんとか……","束之外本来就没区别。[l]\n正是基于这种约定俗成才会产生\n萌点之类的说法……"],["いやそんなことはどうでもいいが、\nそれ以前に、\n今日は会ったときからずっとテンション激高だと思います。","不这种事怎样都好，\n关键在于，\n今天从见面开始她就一直异常亢奋。"],["それとも更に限界突破したのか。","或者说又突破极限了？"],["「誰も居ないとは言え大胆だなぁ……」","「虽说没人但也太大胆了吧……」"],["と呟くと、耳聡く聞きつけたのか","刚嘀咕完，就被她敏锐听到"],["将","将"],["又偶然か、\n身体ごとこっちに向き直り、","又或是巧合，\n她整个人转向这边，"],["「さっきのお詫びーーーっ、\nサービスでーーーーす」","「作为刚才的赔罪————\n特别服务哦————」"],["と言った。","如此宣布道。"],["「あ、そうなんだ……」","「啊，这样啊……」"],["だからといって繁々と直視なんか出来ません。[l]\nなまじ上半身が隠されてる分、\n余計にこう露出してるあれがその、\n──ああ、これぞギャップ萌えというやつ？","但也不可能直勾勾盯着看啊。[l]\n正因为上半身遮得严实，\n反而让下半身那个更加显眼，\n——啊这就是所谓的反差萌？"],["違う、チラリズム？[l]\n……それこそどーでもええねん。","不对，若隐若现效应？[l]\n……这种事真的怎样都好啦。"],["にしても、\n何というか、\n女子のストレスの発散法はよくわからんなあ。[l]\nストレスのかかり方がそもそも違うのか。","即便如此，\n该怎么说呢，\n女生的减压方式真是搞不懂啊。[l]\n难道是压力来源本身就不一样吗。"],["それとも僕が勝手に思ってるだけで、\n性差とかは無関係な個人差なのか。","还是说这只是我自以为是的想法，\n其实和性别无关纯粹是个人差异？"],["「真言さぁーんっ」","「真言哥——」"],["「うっ、にゃ、にゃんだね？」","「呜喵、喵喵喵？」"],["「ほれ。ほれほれ」","「来嘛。来来来」"],["にやりとしたまま手招きする冬夏。[l]\nや、やっぱりそうなるか。","冬夏保持着坏笑招手。[l]\n果、果然会变成这样吗。"],["「まじかよ……いや、そんなに捲れないスよ[l]\nジーンズでは」","「不会吧……等等牛仔裤[l]\n可卷不到那么高啊」"],["脱ぐわけにもいかんし……","又不能全脱掉……"],["冬夏を視ると、\n……こっちの意向を知ってか知らずか、[l]\nうんうんと、頷きながら手招き。","看向冬夏，\n……不知她是否察觉我的意图，[l]\n正嗯嗯点着头继续招手。"],["仕方ないので、\n何とか膝上くらいに無理矢理まくり上げて、\n冬夏に近づきつつ水に入った。","实在没办法，\n勉强把裤管硬卷到膝盖上方，\n边靠近冬夏边踏入水中。"],["「！！！！！！[l]\nっここここここれはおいあなた！！！」","「！！！！！！[l]\n这这这这这这这您这是闹哪样！！！」"],["冷てぇぇええええ！！！！！！","冰冰冰冰冰死啦！！！！！！"],["「だいじょぶ、最初だけだよ、\n私もう馴れた！」","「没事的，刚开始都这样，\n我现在已经习惯啦！」"],["いやいやいやいや、\nまあそうかも知れんけども！！！","不不不不，\n话是这么说但这也！！！"],["「かけていい？[l]\nねえかけちゃっていい？」","「可以泼你吗？[l]\n呐呐可以泼你吗？」"],["いやいやいやいや！！","别别别别！！"],["「せぇのぉ……」","「预备——……」"],["両手を水面に差し入れる冬夏。[l]\nいやいやいやいや！！[l]\nいやいやいやいやいやいやいやいや！！","冬夏将双手浸入水面。[l]\n不要不要不要！！[l]\n不行不行绝对不行！！"],["「やんないよ。[l]\nあっははははは！！[l]\nすっごい顔してたよ！」","「骗你的啦。[l]\n啊哈哈哈！！[l]\n表情超夸张的！」"],["「………あうあ」","「………啊呜啊」"],["あのねえ……[l]\nよし、\n流石にここいらで、こちらも反撃させて貰うぜよ。","我说啊……[l]\n好，\n事到如今也该轮到我反击了。"],["「ひぁうっ！？」","「呀啊！？」"],["太ももめがけて水をかけてやりました奥さん！","瞄准大腿泼水的就是我啦夫人！"],["「つめた！！[l]\n変なとこ狙ってるし！」","「好冰！！[l]\n还专挑奇怪的地方！」"],["え゛っ。","呃。"],["「いやいや、だって他は狙えんでしょうよ」","「哎呀呀，其他部位也泼不到嘛」"],["「ん？[l]\nそうだね。[l]\nちょっと待って、\n髪まとめるから」","「嗯？[l]\n也是呢。[l]\n稍等，\n我扎个头发」"],["う、本気モード？","呜哇，认真模式？"],["「さ、遠慮無くどーぞ、\nその代わり──覚悟してねっ」","「来，尽管放马过来，\n不过──可要做好觉悟哦」"],["「え、あ、いや、それはない！！！」","「等、啊、别、这可使不得！！！」"],["「そぉれっ！」","「看招——！」"],["今度は本気だ！！","这次是动真格的！！"],["ごばしゃっ！！！！","哗啦！！！！"],["「──！！」",""],["思わず顔を背けた僕の、","我下意识别过脸，"],["……すぐ隣に盛大に水飛沫が舞った。","……身旁炸开巨大的水花。"],["「ないよねそれは！！[l]\nうん、ないない！！」","「这太过分了吧！！[l]\n嗯，太过分了！！」"],["「──おぉーういぃー……」","「──呜哎哎哎……」"],["つ、疲れる。","累、累死了。"],["と、ばっしゃばっしゃとこっちに近づいてくる。","哗啦哗啦地朝这边靠近。"],["「………えへへ」","「………嘿嘿」"],["？",""],["すぐ眼の前に立ち止まり、\nこちらを視る冬夏。","在眼前突然停下脚步，\n冬夏凝视着我。"],["数秒そのままの姿勢でいたが、","保持这个姿势数秒后，"],["「いいや、やめとこ。[l]\n流石に二回は恥ずかしい」","「算了，还是作罢吧。[l]\n果然重复第二次太羞耻了」"],["と陸へと歩いていった。","说着便朝岸边走去。"],["何なんでしょう。","真是莫名其妙。"],["てかもう水から上がるのね。[l]\nよかったよかった……[l]\n僕も引く潮の、あの妙な抵抗感を足に感じつつ、\n陸へ上がった。","话说这就准备上岸了吗。[l]\n太好了太好了……[l]\n我也感受着退潮时脚底那股奇妙的阻力，\n走上了沙滩。"],["「はぁ～、\nだいぶすっきりしたっ。[l]\nおつかれでした～ありがとうございます～」","「哈啊～，\n清爽多了。[l]\n辛苦啦～非常感谢～」"],["深々と頭を下げられた。","她向我深深鞠躬。"],["「まあ、僕は特に何もしてなかった気もするけど、\nなによりです」","「虽然我觉得自己也没帮上什么忙，\n不过你开心就好」"],["……本気の無茶されなくてほんとに良かったよ。","……没被她硬拉着胡闹真是万幸。"],["来たいって言うから海に来たとはいえ、\n冬夏自身、\n水に入るようながっつり準備をしてなかったのは\nまあ、視れば判るので。","虽说是因为她想来海边才陪着的，\n但冬夏本人\n压根没做正经下水的准备，\n这点看打扮就明白。"],["タオルは勿論のこと、\n当然","毛巾自然不用说，\n当然"],["乍らレジャーシートみたいに上品な物はなく、\n防砂林の中の遊歩道にあった簡易ベンチみたいなものに\n二人して落ち着いていたのであった。","也不可能带着野餐垫之类讲究的东西，\n最后两人就坐在防风林里\n那种简易长椅上歇脚。"],["「それより、お互い風邪引かなきゃいいけどね…」","「比起这个，但愿我们别感冒就好…」"],["足を乾かしつつ砂を落としてたりしてると、","正抖着腿上的沙子晾干时，"],["「ねえ真言さん聞いてくれる？」","「呐真言先生愿意听我说吗？」"],["「？[l]\nなんだべさ」","「？[l]\n啥事啊」"],["また愚痴ですかしらん。","该不会又要发牢骚吧。"],["「私の此処での思い出。[l]\n具体的に聞きたくない？」","「关于我在这里的回忆。[l]\n不想具体听听看？」"],["「別にいいですって言ったって喋るんじゃ……」","「就算我说不用你也会讲吧……」"],["「うん。[l]\nあははは」","「嗯。[l]\n啊哈哈哈」"],["今更だが、\n今日はよく笑うなあ。","现在才注意到，\n今天她笑得真频繁啊。"],["当然と言えば当然だが、\n逆説的に、何か余程厭な事があったのだろうという\n推測も出来るのが痛々しい。","虽说也是理所当然，\n但反过来说，恐怕是遇到了\n什么特别糟心的事吧，这么想着就有点心疼。"],["あの式のことも一切触れないし……[l]\nそれに関してはこっちとしても幸いではあるが、\n何にせよ家出をしてくる程の何かがあったのは\n確かな訳で。","而且她对那场仪式只字不提……[l]\n这方面我倒乐得轻松，\n不过能让她离家出走，\n肯定是发生了些什么。"],["しかし、\nだからといって憐れんでみせるのも違うと思ったので、\n一緒になって笑っていた。","可是，\n我觉得刻意表现出同情也不合适，\n就跟着笑了起来。"],["「ま、聞いてよ聞いてよ。[l]\n先刻言った通り子供の頃のこと、\nあんまり覚えてないんだけど、\n３っつか５つか、そんな感じだったと思う。","「哎呀快听我说嘛。[l]\n就像刚才说的，是小时候的事，\n虽然记不太清了，\n大概是三岁还是五岁的样子。"],["学校行ってない頃なのは確か。[l]\nそれでね」","肯定还没到上学的年纪。[l]\n然后呀」"],["ふぉう。","呼——"],["木立を抜ける海風が彼女の髪を揺らす。","穿过树丛的海风拂动她的发丝。"],["「母様が珍しく外に連れ出してくれたからって事もあるけど…[l]\nあ、あの時は道具さんがだったかな……[l]\nまま、そういう","「虽然也有母亲难得带我出门的缘故…[l]\n啊，那时候好像是道具小姐陪着……[l]\n嘛，这种"],["細いとこは覚えてないの。","细节已经记不清啦。"],["ただね、\nあの日あの時の事は、\nすごい印象的なシチュエーションだったから、\nその『印象』だけは残ってる。","不过呢、\n那天那时的事、\n因为是超级印象深刻的场景、\n只有那个『印象』残留着。"],["何してたとか、具体的な事はやっぱりね、\nすっごい曖昧なんだけど」","具体做了什么之类的、果然还是、\n超级模糊的呢」"],["道具さんと私と、\n先刻言った少しだけ年上の男の子、\nあと……姫様も。","道具小姐和我、\n刚才提到的稍微年长些的男孩、\n还有……姫様也在。"],["「姫様ちゃんも？」","「姫様酱也在？」"],["……もし其処にいた少年が僕ならば、[l]\n姫様ちゃんとも会っていた事になるが……","……如果当时在场的少年是我的话、[l]\n就意味着也和姫様酱见过面了……"],["──うーん、姿形が変化してないならまだしも、\n子供の頃だろ……[l]\n会ってるとしても、","──唔嗯，要是外貌没变化倒还好说、\n那可是小时候的事啊……[l]\n就算见过面、"],["──私の事わかりませんか。","──您应该不记得我吧。"],["いや、わから、な、い……","不、记、不、得……"],["それにあれはそういう意味ではない、\n気がする……","而且那句话不是那个意思、\n我觉得……"],["ああそういえば、今度会わなきゃいけないのだった、","啊对了说起来、下次必须得见面才行、"],["と、冬夏が若干不機嫌そうにしてるのが目に入りました。","这时、我注意到冬夏似乎有点不高兴。"],["「や、うん、それで？」","「啊、嗯、然后呢？」"],["「……ん。[l]\nまあ、それはどうでもいいんだ。[l]\nそれよりも、」","「……嗯。[l]\n嘛、那个怎样都无所谓啦。[l]\n比起那个、」"],["その場にはもうひとり、","当时在场还有一个人、"],["「なんだろ…[l]\nすっごい不思議なひとがいたんだよね、\nその時は何とも思わなかったけど、\n今にして思えば──","「该怎么说呢…[l]\n有个超级不可思议的人哦、\n虽然当时没觉得有什么、\n现在回想起来──"],["かなり変、いや怪しさ大炸裂だったかも」","可能相当异常、不、是可疑度大爆发吧」"],["「ほう？」","「哦？」"],["「兎に角、まずこの國のヒトじゃなかったのね。[l]\n私のみため、こんなじゃない？","「总之、首先肯定不是这个国家的人呢。[l]\n我的外表、不是这样的吗？"],["だからこう、逆に私は親近感持ったっていうか、\n他の人達は知らないけど、\n道具さんもその時は止めに入ったりしてなかったな。","所以反倒让我产生亲近感了、\n其他人怎么想我不知道、\n道具小姐当时也没来阻止呢。"],["相当変な人だから当てにならないけど。[l]\nあ、知らないよね」","虽然因为那人太古怪根本靠不住啦。[l]\n啊、你不知道吧」"],["うーん、それは身を以て知ってるんだよねえ。[l]\nしかし云わずにおくざますよ。[l]\n色んな意味で！","唔嗯、那可是亲身经历过的呢。[l]\n不过妾身不会说出来的撒。[l]\n各种意义上都是！"],["しかし、\n外つ國のヒトが？[l]\nこの玄ノ森に？","但是、\n外国的人？[l]\n在这个玄之森？"],["観光地としては……まあ、例の祭に来た、のかな。[l]\n海岸にはたまたま足を伸ばしてたとか。","作为观光地……嘛、可能是来参加那个祭典的吧。[l]\n或者碰巧散步到海边之类的。"],["「で、何が変って、\n言葉はばりばりこの國の言葉喋ってたんだぁ。[l]\n子供心にだから同類と思ったからかな、\n警戒心も緩んじゃってて。","「然后、哪里奇怪呢、\n那人噼里啪啦说着这个国家的语言哦。[l]\n可能小孩子心态觉得是同类吧、\n警戒心就松懈了。"],["ほんとはそんなじゃ駄目なんだろうけど。[l]\nでも実際、別に変なことされた訳じゃないけどね。","虽然这样其实很不好。[l]\n但实际上也没对我做什么奇怪的事啦。"],["名前とか全然覚えてないけど、\n遊んで貰ったん……遊びかなあれは？うーん」","名字什么的完全记不得了、\n陪我玩了……算是玩吗？唔嗯」"],["首を傾げる冬夏。[l]\n個人的にはその流暢にこの國の言葉を喋る方に\n首を傾げたいが、","冬夏歪着头。[l]\n我个人更想对那个流畅说本国语言的人\n表示疑惑、"],["「まあそんなに精密じゃなくても……[l]\nニュアンスで大体」","「嘛不用那么精确也没关系……[l]\n大概意思明白就行」"],["「あそう、ごめんね。[l]\nでねでね、その時にね、\n例の男の子も一緒になって遊んだんだけど、","「啊对了、抱歉。[l]\n然后呢然后呢、当时啊、\n那个男孩也一起玩了、"],["その日だか次の日だか、\n引っ越しちゃうって言ってて。[l]\n別れ際に、ある約束をしたのでした」","那天还是隔天来着，\n说是要搬走了。[l]\n临别时做了个约定」"],["「……うん」","「……嗯」"],["「何だと思う？」","「猜猜是什么？」"],["……そういう質問いるー？","……这种问题有必要问ー？"],["「……。[l]\nさっきみたいななあ、\nあんまりベタい答えはしたくないんだけども、","「……。[l]\n就像刚才说的啊，\n虽然不太想给老套的答案，"],["まあ、そうねえ、\nよくあるパターンとしては、\n──大きくなったらけっこ…」","不过嘛，嗯——\n常见套路的话，\n──长大后要结…」"],["と、冬夏を視ると、","正说着看向冬夏，"],["にやけた、","她正咧嘴笑着，"],["こっちを凝視するキラキラさせた瞳と眼があって、","用闪闪发亮的眼睛直勾勾盯着这边，"],["一呼吸の間の後──","短暂沉默后——"],["「っはははは！！[l]\nやっぱ秘密！！[l]\nヒ・ミ・ツぅっ！！！","「噗哈哈哈！！[l]\n果然是秘密！！[l]\n秘・密・哦！！！"],["あとは想像してくれたまえ！[l]\nあっはははは！！」","剩下的自行想象吧！[l]\n啊哈哈哈！！」"],["大爆笑。","爆笑如雷。"],["「……え、","「……呃，"],["先","不"],["刻の仕返しなんですかこれ……？」","这是刻在报复我吗……？」"],["「てかなんだかんだいって、\n究極のベタしか思いつかないじゃない？","「话说回来，\n想来想去不还是终极老套答案吗？"],["可愛いなあーと思って。[l]\nあは、ははは、ごめ、\n笑い過ぎちゃった、お腹痛い、痛いよお」","觉得真可爱啊ー。[l]\n啊哈，哈哈，抱歉，\n笑过头了肚子好痛，痛死啦」"],["ひーん、\nと、とうとう涙まで流している冬夏。","呜咿——\n冬夏甚至笑出了眼泪。"],["まあつられて笑ってはいるけれども、\n基本こちとら置いてけ堀ですよ。","虽然我也被带着笑了，\n但本质上是被晾在一边啦。"],["それに、\nベタい答えしたくはないけど、という前振りしたって事は\n逆説的に答えはベタなんだって。","而且，\n嘴上说不给老套答案，反而说明\n答案就是老套的嘛。"],["…というかどうだろう、厭な事あろうとなかろうと、[l]\n僕ぁこうやって弄られるってことなんですかね。","…或者说不管乐不乐意，[l]\n我就是要被这样捉弄对吧。"],["「……くっ、くくっ、[l]\nくふふふふふ」","「……噗、噗噗，[l]\n库呼呼呼呼」"],["耐えようとしては臨界突破を繰り返してるので、\nしばらく放置する事にする。","拼命忍耐却不断突破临界点，\n决定暂时不管她了。"],["そんなにツボかいー？","有这么好笑吗饭？"],["いやそれより、\n今までの話を鑑みるに、\n冬夏の言う男の子が僕である可能性は、\n……まだ何とも言えない。","比起这个，\n根据目前信息，\n冬夏说的那个男孩是我的可能性，\n……还不好说。"],["僕の方の記憶がこういまいち、\n場所に対しての認識はあるのだが、\nこう、決め手になる情報というかとっかかりというか、","我这边记忆有点模糊，\n虽然记得地点，\n但缺少决定性线索或者说突破口，"],["「ま、約束のことは追い追いね。[l]\nそれよりその時の思い出ね、","「嘛，约定的事慢慢来吧。[l]\n不如说说当时的回忆，"],["えーとね、\nそのひとがなんかへんな人形…縫いぐるみ？[l]\nみたいなのをもってて、\n砂でお城、お墓？だったかな、難しいコトバで──」","那个——\n那个人拿着奇怪的人偶…布娃娃？[l]\n之类的东西，\n用沙子堆城堡、坟墓？来着，专业术语叫——」"],["すな？","沙？"],["しろ？","城？"],["それはしろの、","那是城的，"],["「──たし達で、\nシロノシロをつくったの、","「──我们\n一起造了城中之城，"],["今思えば、\nあはは、\nもしも……なら、[l]\nそれが初めての共同作業になるのかなあ」","现在想想，\n啊哈哈，\n如果……的话，[l]\n那就是第一次合作了吧」"],["「共同作業ってなんですのよ……」","「共同作业是什么意思啊……」"],["いや、それよりも、","不，比起那个，"],["──しろのしろをつくろうか。","──要堆个纯白的雪人吗。"],["──このねこのための","──为了这只猫"],["あ、","啊，"],["冬夏の声はずっと聞こえてたけれど、","虽然一直能听见冬夏的声音，"],["それとは別の、","但除此之外，"],["ああ、こういう時は決まって首が──","啊啊，这种时候脖子总会──"]],"context":[["SC_M_029zan.ks/index/1/text"],["SC_M_029zan.ks/index/3/text"],["SC_M_0