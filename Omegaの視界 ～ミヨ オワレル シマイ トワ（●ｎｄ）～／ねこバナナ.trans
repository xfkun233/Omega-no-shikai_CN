t":18111,"end":18159}],[{"start":18189,"end":18212}],[{"start":18238,"end":18274}],[{"start":18282,"end":18328}],[{"start":18360,"end":18403}],[{"start":18429,"end":18445}],[{"start":18453,"end":18470}],[{"start":18500,"end":18555}],[{"start":18581,"end":18616}],[{"start":18647,"end":18665}],[{"start":18733,"end":18766}],[{"start":18792,"end":18828}],[{"start":18858,"end":18890}],[{"start":18922,"end":18943}],[{"start":18969,"end":18977}],[{"start":18985,"end":19040}],[{"start":19048,"end":19083}],[{"start":19091,"end":19103}],[{"start":19111,"end":19125}],[{"start":19133,"end":19170}],[{"start":19178,"end":19183}],[{"start":19215,"end":19241}],[{"start":19301,"end":19333}],[{"start":19359,"end":19391}],[{"start":19399,"end":19455}],[{"start":19463,"end":19506}],[{"start":19514,"end":19576}],[{"start":19584,"end":19619}],[{"start":19627,"end":19664}],[{"start":19694,"end":19734}],[{"start":19765,"end":19849}],[{"start":19881,"end":19900}],[{"start":19931,"end":20001}],[{"start":20027,"end":20077}],[{"start":20107,"end":20154}],[{"start":20180,"end":20218}],[{"start":20226,"end":20311}],[{"start":20319,"end":20350}],[{"start":20358,"end":20360}],[{"start":20391,"end":20451}],[{"start":20489,"end":20495}],[{"start":20525,"end":20560}],[{"start":20586,"end":20602}],[{"start":20633,"end":20676}],[{"start":20702,"end":20740}],[{"start":20771,"end":20816}],[{"start":20842,"end":20902}],[{"start":20910,"end":20998}],[{"start":21006,"end":21031}],[{"start":21039,"end":21091}],[{"start":21155,"end":21184}],[{"start":21210,"end":21233}],[{"start":21296,"end":21301}],[{"start":21365,"end":21429}],[{"start":21492,"end":21517}],[{"start":21543,"end":21547}],[{"start":21555,"end":21623}],[{"start":21631,"end":21672}],[{"start":21704,"end":21710}],[{"start":21761,"end":21777}],[{"start":21809,"end":21832}],[{"start":21858,"end":21871}],[{"start":21903,"end":21931}],[{"start":21957,"end":21990}],[{"start":21998,"end":22007}],[{"start":22015,"end":22031}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_032.ks","basename":"SC_M_032.ks","indexIds":{"「あはははは！[l]\nすっごい美味しいっ！":0,"あっ、これとかもうたまんない、\nああもう、\n":1,"これは味覚を直撃する何とも染み渡る……[l]\n":2,"んーーーーっ、お刺身超おいし！！":3,"はふぅ……さっきあんま食べないでおいて良かったっ。[l]\n":4,"あのですねぇ、」":5,"だんっ！":6,"と拳で卓を叩く勢いで──つまり実際にはしてないけども、\nそこで一呼吸おくと、\nきっと見得を切るようにこちらを視、":7,"「地元民だからって、\n":8,"新鮮な良い食材食べられる訳じゃないんですよぅーっ！」":9,"と":10,"慟":11,"哭した。[l]\nや、慟哭は大袈裟だけど。":12,"一応食べ方はまだ行儀良いんだけど、\nなんだろうな、":13,"やっぱり擬音で現すならばがつがつって感じに、\n……まあ、当然貴奴程ではないけども、[l]\n料理を食していく冬夏。":14,"とは言え流石というか、それとも他の状態の彼女を視てないからか、\n眼前の光景に対して、宮さんが動じてる様子はない。":15,"「喜んで貰えて何よりですよぉ。[l]\nお誘いした甲斐があるというものですっ。[l]\n":16,"（彼女、良いとこの娘ですよね？[l]\nこういうの食べ慣れてそうですが）」":17,"……いや、やっぱりそれなりの違和感を感じてたらしく、[l]\n小声でこちらに訊いてくる宮さん。":18,"「（なんか体型維持がどうとかで、\n食事は結構制限されてるらしいですよ……":19,"まあ、単純に旨いし、テンションありきの発言\nじゃないすかね。[l]\n社交辞令…じゃないと思いますが）」":20,"にしたって、\nきぃと３人で食事行った時は、\nこんなじゃ無かった気がするけどなあ。":21,"幾ら今日はずっとおかしなノリだったとは言え、\n何かしら背景というか理由がありそうとは言え、\n腹括って覚悟決めると強い人なそうだとは言え、\nちっと不自然すぎやしないか。":22,"……まさか、":23,"「（あの宮さん、\nまさかアルコホォルを飲ませた訳じゃ、\n…ないですよね？）」":24,"「（いあいあ、\nこれは多分、\nいわゆるー、\n雰囲気酔い？":25,"なんか最近プレイしたゲームにも\n同じようなキャラが）」":26,"「そこぉっ！！[l]\nコソコソといちゃつかない！！[l]\nするときは私も混ぜること！！[l]\n":27,"ん、それならゆるす！！」":28,"「（……居ましたし、[l]\nまあ別段不思議な現象じゃないんでしょうけど。[l]\n雰囲気酔い。プラシーボ的に。":29,"浮き世の憂さは酒で晴らすも、\n飲めぬ若人は笑って晴らすと）」":30,"「（それ何かの慣用表現ですっけ？）」":31,"「（さあ？[l]\n今適当に言ってみたですよ）」":32,"……あんだえ、聞いたような言葉だと思ったのに。":33,"まあいいか。":34,"酒に関しては、\n冬夏の同席を知ってる訳だし、\n流石に知狡さんが配慮したようだった。":35,"つまり、\n料理的にオレンジジュースとかもどうよと思ったのか、\n烏龍茶が配されたのだけれど。":36,"ただ、\nコース的に想定外だったのか烏龍茶はペットボトル。[l]\n虚より実を取れれば良いので別に構わないけども、\n……まあいいか。":37,"変に融通利きすぎるのもバックのコネクションが\n視えそうでこわいし。[l]\n──あれ、変更出来てる時点で既にコネのチカラ丸出し？":38,"「……」":39,"ま、まあ、\n冬夏を視る限り、そこに引っ掛かってる様子もなし。[l]\n恐らく問題はないであろう。":40,"と、宮さんがその烏龍をちびりと飲んで":41,"囁いた。":42,"「（んむ、\n只の烏龍茶ですねぇ……[l]\nまこくんこそ何か仕込んだのデハ？[l]\nよからぬ事でも企んだ？）」":43,"「（するわけ無いでしょうが……[l]\n仕込むモノもそうですけど、\n宮さんを２人に増やすような真似をなんで）」":44,"「（んむ？[l]\nなにかおっしゃいました？）」":45,"「（いえなんにも……）」":46,"まあ、今日は会ったときから超のつくような\nハイテンションだったしなぁ……":47,"余程溜まってた、にしても、\n半日ずっと発散に付き合ってるにも関わらず、\n未だ尚、こんなにもはじけるかよ。":48,"「たぅ！」":49,"「おわ！！」":50,"冬夏が、\n隣り合って座っていた僕と宮さんの間に入り込んできた。":51,"「こんばんわ！」":52,"「こんばんわ？！[l]\nこ、こんばんわ。[l]\nあは、あははは……」":53,"「いいですねー。[l]\nなかなかイイですよ。[l]\n冬夏さんには見込みがあります！」":54,"「やった♪\nて、何のですかー？」":55,"「うひひ、\nえーとですね、\nごにょにょ……」":56,"「……何すか。[l]\n何でひそひそ話なんスか」":57,"「んむ？[l]\nえーと、\nまこくんは聞かない方が良いと思うですねぇ…」":58,"「え゛っ。[l]\n……あ、いや、じゃあ聞きません」":59,"どうせロクな事ではないのだろうて。":60,"取り敢えず烏龍茶をあおる僕。":61,"疲れたとはいえ、\n僕は昼に姫様ちゃん達とそれなりの食事してたので、\n思ったよりそんなにそんなになんだよね。[l]\n喰えばちゃんと腹には入るけど。":62,"「あー、手酌っていけないんだー」":63,"「はい？」":64,"密談を終えたらしい冬夏が、\nこっちを指差してぶーたれた。":65,"「手酌は駄目なんじゃないの？[l]\nマナー的に」":66,"「手酌？[l]\nってああ、\nいやぁ……[l]\nそんなことぁないと思うけど……」":67,"大神とかは他人が":68,"注ごうとすると、\n寧ろ全力で拒否るけどなあ。[l]\nちゃんと他人には":69,"注ぐ奴ではあるから\n変な謙遜なのかも知れないけど。":70,"「いいからいいから、\n貸して貸して」":71,"「いや、別にいいし。[l]\n酒でもないしさ……」":72,"「先刻も言ったでしょ、\n私、こういうのしたい」":73,"「してもらえばいいのに。[l]\n宮に遠慮は要らないですよ？」":74,"こちらの喧噪など何処吹く風、\nとっとと料理をつついていた\n宮さんがそう言ったんですが、":75,"「や、貴女には遠慮してませんから……」":76,"そもそも何の遠慮だ。":77,"と、\n業を煮やしたらしい冬夏が僕をせっついた。":78,"「ほら、グラス」":79,"「グラス？[l]\nああ、コップでいいじゃないの……」":80,"間違っちゃいないんだろうけど、\n空気的にというか、\n何かが違う。":81,"ともあれコッ……グラスを冬夏に向けて差し出すと、":82,"「………よよよよよよ」":83,"えらい真剣にペットボトルを掲げ、\nよくわからない擬音と共に烏龍を注いでくれたのだった。":84,"注ぎ終えると、額の汗を":85,"拭わんばかりに\nふぅー、と息を吐き出し、\n今度は宮さんの方に向き直る。":86,"「じゃあ、こちらにも」":87,"「おおう？[l]\nありがとうございますっ。":88,"いやいや、冬夏さんてば。[l]\n":89,"良いお嫁さんになれそうですねえ、ねえ？[l]\nまこくん」":90,"「え？[l]\nはあ、そーうですねえー」":91,"今時そういう価値観も揺らいでる感があるけど、\n宮さんもわざわざ皮肉発言した訳じゃないだろうので、\n素直に褒め言葉として同意しておく。":92,"「あはははは……[l]\nだといいけど……」":93,"おや？[l]\n若干トーンダウンした？":94,"傷付いたというよりは、\n何だろう、痛い所突かれた的な感じだが……[l]\n気のせいかしらん。":95,"「まま、じゃあ宮はちっと中座しますね。[l]\nすぐ戻って来ますからご心配なく～」":96,"「ん、はいわかりましたー」":97,"「いってらっさい」":98,"宮さんは広間から廊下に出て行った。":99,"「どうぞいちゃついててぇ～」":100,"……わざわざ廊下から言って寄越す宮さん。":101,"「了解～」":102,"……わざわざ返事する冬夏さん。":103,"僕は勿論スルーです。":104,"「手洗いかな……」":105,"「ん」":106,"呟いたつもりだったが、\n冬夏は耳聡く反応してきた。[l]\n食事の席だし一応気を遣ったつもりだったんだけど……":107,"「私？[l]\n気にしないよそんなことで。":108,"しきたりとか男だから女だからとか、\nそういうのに囚われるのってキライなの。[l]\n家では……まだしょうがないけど」":109,"「なるへそ……」":110,"「だから、\n真言さんが多少気の利かない感じに鈍感な男子だとしても\n気にしないよ？[l]\n私がリードしちゃうし」":111,"「それは悪うござんしたね……」":112,"「ん？[l]\nあっはははは、\nそこそこ、そこが鈍感なんだってば！[l]\nあれぇ、それともわざとなのかな？」":113,"「……よくわかんねけど、[l]\nまあ自分でも朴念仁の類だとは思うよ……」":114,"そう言うと、\n何が可笑しかったのか、\nあはは、とまた笑う冬夏。[l]\nぼくねんじん、の語感で？":115,"「ただいもんー」":116,"「あ、おかいもんです」":117,"「おかいもんー」":118,"今更ながら、\n何か『お買い物』って言ってるみたいでややこしいな。[l]\nそもそもただいもんて。":119,"ともあれ、\nいちゃつく間もなく戻って来て頂けて、\n大変にありがたい事です。":120,"「ふーやれやれ……」":121,"と、\n年寄りみたいな声を出して座る宮さん。[l]\nそうだなあ、やっぱり厠…にしては早いな、[l]\n何だったんだろ？":122,"「んむ？」":123,"「あいえ、何でもないです…」":124,"僕等の遣り取りを視ていた冬夏が、\nそこで突然ぶわさと立ち上がった。":125,"「んじゃー宮さまっ。[l]\nお歌お歌。[l]\n御一緒しましょ！」":126,"「んむ？[l]\nおーおー、そう来なすった？":127,"うひひ、\n宮もカラオケにゃー":128,"一":129,"家":130,"言ありますよ。[l]\n冬夏さんのお手並み拝見と行くですかね、\nうひひひひひひ」":131,"「えへへ、今日はたまたま喉ならし出来たのでー。[l]\n少しは聴かせられるかな？っと。[l]\n身近に凄いのが居るんで自信はないですけど。[l]\nお耳汚しですが、そこは平にご容赦くださいませっ」":132,"「いあいあ、\nあなたはワカルひとと視ましたですよ。":133,"少なくとも……よりは、んむ。[l]\nままままままま、\n":134,"んじゃー、\n何唄いましょうか？":135,"例えばこれ知ってます？[l]\nええとですね……」":136,"「えーーっこれを御存知？！[l]\nすっごいところ突いてきますねー、\nでもっ、ぜんっっっぜん行けますよっ」":137,"宮さんの中座の理由を気にしてもしょうがなし、\nというか何かえらく盛り上がってるなあ。":138,"つーか今、\n宮さん『少なくとも』って、\n誰よりはマシって言おうとしたのやら。[l]\nどうせ僕なんでしょうがね！":139,"ああそうですか！[l]\nで、冬夏の言った身近の凄いのってのは、\nやっぱ狩屋なんだろうなあ。":140,"「じゃ、これでー、\n私が上パートとコーラスやりますね。[l]\n宮さまは主メロで」":141,"「はーい了解です♪\nま、でも主メロは交代交代でしょ。[l]\n２コーラス目は入れ替えでごー。[l]\nじゃ、行きましょう」":142,"「いってらっさーい……[l]\n……宮さまって何？いつからそう呼んでたっけ？」":143,"えらい勢いで親交が深まってる？":144,"でもなあ……":145,"冬夏の、\nこういうのを視ると、\nやっぱり平素どれだけしんどいんだろうか、\nと裏事情を想像せずには居られない。":146,"心の痛みを知って尚、\nそれを糧として他人を慮れる人間というのは、\n全ての場合においてとは限らないが、\n基本的には尊敬に値すると思う。":147,"僕はそれはもう、\nうかうかと過ごしてるのであれだけども、\nそれでも精神的に傷付くことはままある。":148,"そういう時に、\nそれを怒りに転換する事の方が多いわけで、\n愚痴ったりもするし、毒づいたりもする。":149,"それなのに、\n──なんかセンチな思考になってるな。[l]\n何でだろ？":150,"ようよう考えれば、\n眼前で起きてる『これ』、\n別にそういう話じゃ、ないよなあ。[l]\n……寧ろ、今日の半日は冬夏の愚痴から始まってたような……":151,"ま、まあ！[l]\n笑っていられるというのは良い事だ！[l]\n大神もよく言ってたし僕もそう思う！":152,"にしても、":153,"周りを視回して改めて思うけど、\n経営者権限とは言え、\nたった三人の為によく押さえてくれたなあこんな部屋。[l]\n祭がもっと近づいてたら、多分無理だったのかもなあ。":154,"そう思っていると、\n二人は既にステージの方へと向かっていた。":155,"「いぇ～～～いぱちぱちぱちぱちぱちぱちぱち……」":156,"知狡さんやチノ嬢とか居れば多少は賑やかしになるんだろうけど、\nあくまで僕と旅館との関係は秘している以上、\nそういう訳にもいかず、":157,"独りで":158,"幇":159,"間みたいな事をしつつ、\n二人のステージに視入る事になった。":160,"先刻の冬夏の歌唱力を知ってるので、\n宮さんとのコラボレーションが果たしてどうなるのか、\n実際愉しみではある。":161,"とは言え、曲目次第のとこもあるかな……[l]\nそれより宮さん、アニソン以外行けんのかな？":162,"つーか、疲れた身体で食事すると、\n血が胃に行って大変眠くなるん……":163,"「んではー、\n行きますねぇー」":164,"「よろしくおねがいしまーす！」":165,"もわもわーんとエコーの掛かった声で二人が言う。":166,"曲がはじまった。":167,"何か変拍子って言ったっけ？[l]\n何分の何だこれ。[l]\n難易度高そうな唄だな……[l]\n集中してアタマ使ったせいか眠気も少しは飛んだようだ。":168,"「今宵、巡れる──」":169,"打ち合わせてた通り、\n確かに宮さんが主旋律を担当してるようだ。[l]\nまずはあの方から歌い出す。":170,"「不知夜月揺れる──」":171,"「──誘いの──」":172,"ハモるというより、まずは追っかけかぁ。[l]\nいや、追っかけつつハモりも被さるのか。":173,"そして、二人の声が重なる、":174,"──零れ──……":175,"「深い夜に──」":176,"──。":177,"ハモりが完璧すぎて鳥肌立つんですけど……[l]\nで、やっぱり追っかけもするんだ。[l]\nよく初回で合わせられるなあ……[l]\nまあ、お互いよく知ってる唄なんだろうけど。":178,"ワンコーラスていうのか、\n所謂１番が終わったあたりで、\n僕はすっかりやられた感じで惚けて聴き入っていた。":179,"と、唄が終わったらしい。":180,"二人は何故かハグし合い、\nそのなんかのはずみでハウリングが起きてしまったようで、\n丁度惚けてた僕の脳をシャッキリさせてくれた。":181,"照れ笑いしながら…や、照れてるのは冬夏だけだけど…[l]\n二人は深々とお辞儀をし、\n座敷に降りてきた。":182,"最後のバックコーラスみたいなのなんて言ってたんだろ、\n月がどうとか……しか解らんかった。":183,"「いやはや、\nおっそろしいですなあ……[l]\nなんというか、\nうたってすごいですね」":184,"何となくオール平仮名っぽい喋りになる僕。":185,"つーかさあ、\nいよいよ狩屋の実力が大変気になるんスけど。":186,"彼奴、ほんとに喋りがあんなじゃなきゃ、\nルックスとて別段変ではないし、\nそれこそ完ぺ──\n……いや、だからか？":187,"わざとなのか？[l]\n敢えて２位狙いの誰かさんみたいな？[l]\nそれはちと違うな……":188,"「んー、\n宮さま素敵過ぎですたっ！」":189,"「んむ？[l]\nいえいえこの程度、\n一般教養の範疇、\n":190,"当然の":191,"嗜みですのよおほほほほ」":192,"「ああもう、尊敬致しますー」":193,"何かあすこで、\nまたぞろというか、\n繋がりが確固たるものになりつつあるな……":194,"「なんと言っても、\nうたはまほうですから、ね？」":195,"「！！[l]\nんーっ、ですよね！ですよね！！[l]\n同意見ーーーっ」":196,"そうか、それ、宮さんから聞いた言葉だった。[l]\nうたはまほう……[l]\n冬夏、同意見っていうか、そんなに一般的なフレーズかこれ？":197,"ぱっと言ってぱっと合致する言葉としては、\nちょっとばかり特殊な気がするんだけど……":198,"やっぱり僕の":199,"与り知らぬところで流行ってる\nのかなあ……":200,"「さて、\n次はまこくん？かな？」":201,"「おっ。[l]\nほらほらー」":202,"うぇえーまーじかよー。":203,"「や、僕は先刻散々歌ったから……」":204,"「えー？[l]\n全然歌ってなかったでしょー？」":205,"てかだからね、あんたらの今のその後でなにをしさらせと。":206,"「レパートリーもあれだしさ……[l]\n多分おんなじの聴く羽目になるよ？[l]\n…あとはアニソンばっかだし」":207,"「いいよぅそれで。[l]\nあにそんでも」":208,"「んむ、じゃーまこくん宮と一緒にイっとく？[l]\n":209,"ふたりでぇいつもの、ア・レ」":210,"厭なイントネーションでその台詞言わないで。":211,"「いつものアレ？ってどれですか？」":212,"「いやーん言わせる気？[l]\nあれよぅアレぇ。[l]\n":213,"年明けに散々、二人で特訓したでしょぉ？」":214,"ああ、あの、何とかいうアニソンね。[l]\nいつものって言う程のあれか？[l]\nて言うよりあれって……て、":215,"…ほれ、[l]\n冬夏が変な眼でこっちを視てるし。[l]\nつーか冬夏も、宮さんの方に突っ込みなさいよー。":216,"「……ほら、どうぞ！」":217,"つかつか僕に歩み寄ったかと思うと、\nマイクをぐいと押しつけて、\nがっしと手を掴み握らされた上から\n更にぎゅむと手を握り固めて来る。":218,"で、僕をステージの方へと、文字通り突き放す冬夏。":219,"何で不機嫌。":220,"……え、フケツとでも言いたい？":221,"いやいや、大きな誤解ですしそもそも振ったのは宮さんなんですが？！":222,"一瞬頬を膨らませて僕を睨み付けたと思うと、\n次の瞬間には破顔して僕等に拍手を寄越す冬夏。":223,"何の意思表示なのやら、\n冬夏も感情の振り幅激しいなあ……[l]\n今日が特別なのかも知んないけど。":224,"「じゃー、冬夏さん、\nこれが宮たちの":225,"絆し……じゃない、[l]\n":226,"絆のかたちです！」":227,"「なにそれ……」":228,"またエコー掛かった声でおかしなことを…[l]\n":229,"絆し、自由を束縛するモノね。[l]\n僕にとっちゃあそっちのが正解やがな。":230,"「わーーーーぱちぱちぱちぱち」":231,"すげえ微妙な拍手をして寄越す冬夏。[l]\nうっ、やりづらい……":232,"「おっと入力まだでした。[l]\nどれどれ……」":233,"手早い操作で曲入れる宮さん。[l]\n相変わらず僕はぼーっと視てるだけです。[l]\nほらワカルひとがやった方が早いからね！":234,"さて前の曲とは打って変わって、\nちっと激しめの曲。":235,"まあアニソン的というか、\n所謂主題歌っぽい曲調であるのだが、\n一番の特徴は、":236,"歌詞が創作言語で、\n基本的には何言ってるのか判らないという点である。":237,"それこそあの謎言語と比肩するくらいの、\n……まさか一緒ってことはないよなあ……[l]\n兎に角、そういう何か妙にトランス出来る曲である、\n個人的には。":238,"ちなみにアニメの内容は他と同様、\n全く知らないんだよね……[l]\nというか、":239,"事実アニソンかどうかも実は定かではないけど、\n宮さんが何かそういう流れで僕に説明したから\nそういう認識でいるだけ。[l]\nや、だって大神も何か知ってるふうだったし。":240,"「てか結構マイナー曲も入ってるんすねえ……[l]\nや、何がメジャーかも知らないですけど……」":241,"旅行してると結構ＬＤのカラオケとかまだあるので、\nこういった所できっちり曲数あるような設備と出逢うとは\n割と驚きだった。":242,"「いきますよ？」":243,"「はいさぁ」":244,"今の二人の後でソロ唄うよりは、\n多少は楽な部分もあるけど、\nやっぱりアンサンブルというかデュエットではあるので\n失敗出来ないというプレッシャーはある。":245,"唾を飲んだり唇を舐めたりしてると、":246,"「だいじょぶです、\nさんざ仕込んだでしょ？」":247,"にっこり":248,"微":249,"笑いかける宮さん。":250,"まあ仕込まれたっていうか、\n先刻も言ってた通り、\nそれこそ今年の始めに、\n対新年会兵器としてがっつり練習させられたのだ。":251,"……新歓コンパで使う機会は無かったけど。":252,"「……あいさぁ」":253,"曲が始まる。":254,"歌詞とリズム合わせがややっこしいけども、\nそこが逆に上手く唄えた時のトランス感というかグルーヴ感を\n与えてくれる要素にもなってるんだよね。":255,"──宮さんは何か踊ってますけど。[l]\nその振り付けまでは流石に僕も憶えられなかったので、\n棒立ちです。否、単純に恥ずいからです。":256,"取り敢えずワンコーラス分は無難に終了。":257,"……間奏のギターソロとか、[l]\nきっちり再現してるなあ。[l]\n耳コピ相当腕良いですよ。言える程僕もよく知らないけど。":258,"冬夏をちらと視ると、":259,"何か顔を覆って下を向いてたり、\nと思うとアタマぶんぶん振ってこっち向けて笑いながら\n手拍子したり、\n……親指立ててきたり。":260,"で、親指立て返す宮さん。":261,"僕も仕方なくおずおず仕返そうとした所で、\nツーコーラス目が開始。":262,"慌てて歌唱に集中する僕と、\n相変わらず完璧に振り付けをこなす宮さん。":263,"踊りの一環なのか、\nたまに僕に纏わり付いてきたりしますけれども、\n当然リアクション不能です。":264,"そうこうしてるうちに曲は終わり、\nまた深々とお辞儀する宮さんと、\n拍手で迎える冬夏。":265,"僕は心なしかほっとしながら、席に戻った。":266,"「すっごいね、\n真言さん":267,"先":268,"刻のカラオケボックスでの\nソロとは全然違う」":269,"「まあ、そもそも二人だし、\nだからつまりはあのひとのチカラだよね……[l]\n僕自身ぁ全然たいしたことないんだぁ……」":270,"「え？[l]\nいあ、そんなことないよ。[l]\n真言さんの、歌い方から声の出し方からが全然違ってたよ」":271,"「まあ、それはもう、」":272,"「しっぽり二人っきりで特訓しましたからっ！[l]\n":273,"それはもう仕込みまくってあげたのデスモノ」":274,"エコー掛かったマイク持ったまま宮さんが会話に参加してきた。[l]\nあの、まだそっち方向で責める気ですか。":275,"「あはははは……」":276,"そして何故かまたトーンダウンの冬夏。[l]\n頬をポリポリと掻いて、\n何か切なげに斜め下に俯くのであった。":277,"「んむ？[l]\nあーあー、大丈夫大丈夫、\nだいじょうぶですよぉ～」":278,"何がどう大丈夫なのか分かんないが、\nそう言いながら冬夏を抱きしめて頭を撫でる。":279,"で、冬夏も力なく……否、[l]\n何か安心したように微笑み返す。":280,"「ありがとうございます。[l]\nだいじょぶです」":281,"「んむ、それはなにより♪\nあだだだだだ」":282,"身長体格差の所為か、\n冬夏の抱き締め返しに悶絶しとる宮さん。":283,"……よくわからないけども、[l]\n兎に角何かは解決したようだ。":284,"それを傍目に僕は喉を潤す為に烏龍を飲みますよ。":285,"ぐびびびびびび……":286,"「ん、じゃあ次は私と真言さんだね。[l]\n何唄おうか？」":287,"「ごふっ、げふげふげふ、\nんん゛ぇっ？！[l]\nあんでまた？？……うぇっふえふ」":288,"う、烏龍が気管に……":289,"「んむー、まあそうなるのが順当というか、\n道理ですよねぇ。[l]\nがんばって♪」":290,"「あははは、まあ、無理にとは言わないけど……」":291,"……？[l]\n何か、\nちょこちょこトーンダウンするなぁ。":292,"うーん、冬夏は今日半日近く一緒だから、\n真面目に気遣いから出た言葉かも知れないが……":293,"「や、だいじょ……大丈夫です。はい。[l]\n行きましょう、行きましょうとも！」":294,"そんな顔されてるのに断るなんて、":295,"──後で宮さんに怒られますから……":296,"「そう？[l]\nよかったっ。[l]\nじゃあ、さっきとは別の……[l]\nどれが良いかな」":297,"ああ、すぐにテンション戻るのね。[l]\n別にいいですけどね……":298,"「まあまあ、まこくんの宿命ですよね」":299,"「なぁんでも。[l]\nんじゃ、みせつけておくんなましぃ～」":300,"ひらひら自分の席に戻る宮さん。[l]\nこのひとぁ相変わらずか……":301,"「ねね、\nこれどう？[l]\n知ってる真言さん？」":302,"「んえ？[l]\nああ、ええと……」":303,"そうして僕等は、":304,"しばしの宴に酔い痴れて……たのは僕以外だけかもだが、[l]\nそれなりに愉快な時間を過ごしたのであった。":305,"こういう時は時間が経つのも忘れるもので、\n一体今何時なのやら。":306,"携帯で時間を確認すると、":307,"……そんなにも経ってないな。":308,"ま、まあそういう時もある。[l]\n兎に角時間感覚が狂うという事で！":309,"とは言え。":310,"「冬夏さ、水をさすようであれだけど明日学校だよね？」":311,"「ん？[l]\nうん。[l]\n大丈夫、半ドンだし」":312,"は、半ドン？[l]\nややや、それ多分、今の人知らないぜ。":313,"尚説明させて頂きますと、\n異國語でいう日曜日、zondag、\nドンタクっていったかな？そこから、":314,"昔の土曜日授業みたいに午後から休みとか、\n半休日の事を半ドンというそうですよ。":315,"僕ぁアナクロ人だから知ってたけども、\n冬夏、なかなかやるな……[l]\nそれともこれも知らない所で流行ってる？":316,"はたまた僕が思い込んでただけで、\nこれくらいは一般常識なのか？":317,"明日は金曜の筈だが、\nまあ新学期初日という事でそうなってるのかな。":318,"「でも、ん、\nそろそろお開きな感じ？[l]\nお風呂も入りたいし」":319,"「んむ、ならば宮もご一緒しますか？[l]\nここまでお付き合いして貰ったですし、\nほら、毒を食らわば皿まで……いあいあ、[l]\n乗りかかった船？」":320,"「あれ、露天てもう大丈夫なんですか？」":321,"「の、筈ですよ。[l]\nちず……げふげふ。[l]\nち・らっと視たら、\n張り紙がしてあったような？気がしましたけど？」":322,"へえ……[l]\nてか今危なかったな宮さん。[l]\n幸い冬夏は気にしてないようだけど。":323,"「そか、露天風呂あるんですね？[l]\nでも流石に恥ずかしいかなあ……というかその……」":324,"──ああ、まあ、大衆浴場に行くには、\n冬夏としては色々ある、よなあ。":325,"旅館だから地元民は少ないとは言え、否、\nだからこそ逆に好奇の眼で視られる可能性が、\nん、更に逆で、余所者同士異境の宿泊地では\n関係なくなるのかな。":326,"ともあれ、\n本人が躊躇してるならば無理強いは出来まい。":327,"が、":328,"「あーだいじょぶです。[l]\n人の居ない時間帯知ってますから。[l]\n伊達に長逗留してないですようひひ」":329,"宣う宮さん。":330,"「はあ、じゃあ……折角だし、[l]\nご一緒して頂けます……？」":331,"……本人が良いなら何も言うまい。":332,"「らじゃーです。[l]\nただ露天は水着着用なので、\n宮のを貸しま……」":333,"そこで冬夏の肢体を繁々と視て止まる宮さん。[l]\nまあ、そりゃあ……":334,"「いあ、ストレッチきくし着られるとみた！[l]\nタイト気味ならそれはそれでこう、」":335,"いや、無理でしょう……[l]\nセパレートならまだしもあなたの持参してるのは、\nワンピでスク水でしょうが。":336,"結局、宮さんが売店で買ってあげることになった。[l]\n冬夏は最初固辞したけども、\nまあそんな値段でもなかったし、\n何やらデザインとかも気に入ったようで。":337,"宮さんが有無を言わさなかったというのもあるけど……":338,"という訳で、\n広間からロビーに移動してた我々も、\nここで一端解散する事になったところで、":339,"「あ、まこくん……は流石に、お風呂今日は別々ですねぇ……」":340,"いや、だから『今日は』とか言わんでいいのに……":341,"「………」":342,"「ささ、行きましょうか冬夏さん。[l]\n時間的にもばっちりですし、\n質問があればみっちり受け付けますですので☆」":343,"「……真言さん、[l]\n──マタアトデネ」":344,"うっ……":345,"ていうか何で冬夏不機嫌になる？[l]\nフケツとかいう理由だったら、\nどっちかというと貴女こそこう、\n何て言うの？":346,"不潔とは言わぬまでもほれ、\nフランクに過ぎるというか、オープンというか……":347,"「……あれ」":348,"二人は知らぬ間に居なくなってた。":349,"「まあいいや……[l]\n僕も風呂入ろ」":350,"例の従業員用の室内風呂に。":351,"「はあ、なんか、\nよくわからん１日だったな……」":352,"と、言うかさあ、\n何か大事な事を忘れてる気がするんだあ……":353,"何だったかまでは、":354,"そりゃぁ、憶えてないんだけども。":355},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_032.ks","relPath":"/data/scenario/SC_M_032.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":352,"length":356,"percent":98.87640449438202},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[301,1]},"/data/scenario/SC_M_033.ks":{"data":[["「ああ……[l]\n滅っ茶苦茶疲れた今日はぁ～あ～あ～～～…っと」","「啊啊……[l]\n今天累得乱七八糟的啦～啊～啊～～…呃」"],["部屋に戻るなり身体を伸ばし、\n全身の骨をならす。","刚回房间就伸展四肢，\n把全身骨头弄得嘎嘣响。"],["うっ、結構ばっきぼっきいってるな。","呜哇、关节响得挺厉害嘛。"],["主に精神的に……という印象が強かったけど、[l]\n単純に午前中に肉体労働して、\n午後も引き続いて車の運転しっぱなしに加え、","虽然主要是精神层面的……这种感觉比较强烈，[l]\n但毕竟上午干了体力活，\n下午又连续开车，"],["海で戯れて、\nカラオケ二回分してるんだもんな。","还在海边疯玩，\n外加唱了两轮卡拉OK。"],["昼も晩も豪勢めの食事だったとは言え、\nそら心身疲弊もしますわなぁ。[l]\nいやだから、寧ろ疲れた身体に食物入れたら、\n血が胃に行くんだって。","虽说午晚两餐都吃得挺丰盛，\n那身心俱疲也是理所当然啦。[l]\n不对、应该说疲惫时进食的话，\n血液会流向胃部对吧。"],["眠いんだって。[l]\nこっちきてからほぼ２週間、\nそろそろ疲れがどっと出る頃なのかも知れないけど。","会犯困对吧。[l]\n来这边差不多两周了，\n可能快到疲劳集中爆发的时期了。"],["何にせよ、今日はその、\n朝から晩まで色んな意味で格別だった訳で、\n実際冬夏のノリも非常にこう、\n視てて疲れるというか、","总之、今天这个，\n从早到晚在各种意义上都非同寻常，\n实际上冬夏的嗨点也特别那个，\n看着都觉得累人，"],["宮さんとは似てるようで違うオーラだし、\n先刻の晩飯の時はふっとトーンダウンが混じったり、\nそれこそ午前中のあれやらこれやら……[l]\nああもう、僕はなにかの特異点なのですかしら？","和宫小姐相似却不同的气场，\n刚才晚饭时还突然蔫巴了一下，\n更别提上午那些七七八八……[l]\n啊啊够了、我该不会是什么特异点吧？"],["事が起こりすぎて起こりすぎて、\nこのままじゃ僕ぁもう怒りすぎちゃうよ！！","事情接二连三接二连三，\n再这样下去我就要气炸了啦！！"],["……ほれ、疲れてるでしょう。[l]\n語感的にも無理があるしようー。","……你看、果然累了吧。[l]\n连说话都语无伦次了嘛—。"],["その疲れの所為か、\nどうも","或许是疲劳的缘故，\n总觉得"],["先","不"],["刻から、\n何か忘れてる気がしてならないんだよなあ……","从刚才开始，\n就强烈感觉自己忘了什么啊……"],["ずっと引っ掛かってる事があるんだけど……","有件事一直耿耿于怀来着……"],["「出ないものは出ないか……[l]\n致し方なし、\n今日はもう寝るすかねえ」","「不出来的东西终究出不来……[l]\n无可奈何，\n今天还是睡觉吧」"],["ほんとに大事な事ならば、\n体力戻った時にでも思い出すだろう。[l]\n……僕の脳では如何にも心許ないが、[l]\n最近何気に変な活性化をみせてるしな！","如果真的是重要的事，\n等体力恢复的时候总会想起来的吧。[l]\n……虽然以我的脑容量实在靠不住，[l]\n不过最近莫名变得异常活跃呢！"],["って、\nそもそも","话说，\n说到底"],["端から思い出せない時点でアウトなんだが。[l]\n寝ると忘れる体質でもあるしなあ……","从一开始就想不起来的时候就已经完蛋了。[l]\n而且我还有睡醒就忘事的体质啊……"],["とは言え、こればっかりはどうすることも出来ぬ。","不过唯独这点实在无可奈何。"],["「食事の前後と眠いときは、\n思考したり他人と会話してはいけないんだぜ……[l]\nふぁ～あ……」","「饭前饭后和犯困的时候，\n禁止思考或与他人交谈哦……[l]\n哈啊～……」"],["──ツかれてるときは、制御のステージが、","──疲惫状态下，控制层级会，"],["──つまり肉が楽な方を選択するから、理性に拠った配慮の余地が、","──也就是肉体倾向于选择轻松模式，基于理性的考量空间，"],["なんだっけ、それは、\nああ、大神が……言ってたような……","什么来着，那个，\n啊，大神……好像说过……"],["「いかん、思考の振れ幅がすごくなってきた、\nってこう独り言が増えるのも特徴なんだよね、\nうひひひひひ」","「不妙，思维波动越来越剧烈了，\n像这样自言自语变多也是特征呢，\n呜嘻嘻嘻嘻」"],["独り虚しく","独自空虚地"],["嗤ってみる。","嗤笑起来。"],["まあ、独り暮らしの時は、\nしなけりゃならない家事──自炊だの掃除だの洗濯だの──が\nあったから、\n多少はしゃっきりせざるを得ない瞬間が必ずあった訳だが、","哎，独居的时候，\n不得不做的家务──做饭啦打扫啦洗衣啦──\n总归是有的，\n所以总会有必须打起精神的时刻，"],["「……滞在してるうちは、その気になれば、[l]\nこのまま何も考えずに寝てしまえるんだよな」","「……暂住期间只要想的话，[l]\n就能像这样什么都不想直接睡过去吧」"],["結構な長逗留になって、\nこう色々人任せな生活してると、\n後で日常に戻った時が心配だなあ。","因为停留得实在太久，\n过着这种凡事都依赖别人的生活，\n很担心回归日常生活之后啊。"],["風呂も此処じゃ自分で沸かしたりしないし……","在这里连洗澡水都不用自己烧……"],["ああ、風呂と言えば、\nあのお二方は今連れ風呂真っ最中だけれど──\nどうなってるのかねえ。","啊，说到洗澡，\n那两位现在正在共浴来着──\n不知情况如何了。"],["変に仲良くはなってたようだけども、\n冬夏が何かしら宮さんの発言にトーンダウンさせられたり\nしてたし、\n変な問題起こしてなきゃいいけど……","虽然看起来莫名地变亲近了，\n但冬夏似乎被宫小姐的某些发言压制着\n，\n只要别闹出什么幺蛾子就好……"],["何と言っても、\nこの接触が果たして吉と出るか凶と出るかは、\n僕にはとんと見当も付かない。","说到底，\n这次接触究竟会带来吉还是凶，\n我完全摸不着头脑。"],["いかな懐柔策を採るにしたって、\n誤魔化し誤魔化しの事象下において、\nあんまり当事者に直截的に絡む人数増やすのは、\n得策じゃないだろうに。","无论采取何种怀柔策略，\n在充满欺瞒与掩饰的事态下，\n过分增加直接牵扯当事人的参与人数，\n终究算不上明智之举吧。"],["口裏合わせも面倒だし、\n既に宮さん自身ちょっと危うかったしな。","统一口径也很麻烦，\n况且宫小姐本人处境已经有点危险了。"],["それに──","再加上──"],["そう、脳が変に活性化というか、\n僕の過去記憶が何気に戻りつつある……っぽいのも、[l]\n気にはなるけども、\n実際仕事にはあまり関係ないだろうし、","没错，大脑莫名亢奋或者说，\n我的过往记忆似乎正不经意地复苏……[l]\n虽然在意这件事，\n但实际上和工作没太大关联吧，"],["ん？","嗯？"],["きぃの件があるか……","不过小贵那边的情况……"],["冬夏も心配してたし、\nそれにかこつけてちょっと繋ぎ取ってみるか？[l]\nでもそれでもし、","冬夏也很担心，\n要不借这个机会稍微试探下？[l]\n但万一这样做之后，"],["何か黒い、きな臭い方向へと話が進展してしまったら──","事态朝着可疑的、充满阴谋的方向发展的话──"],["とそこまで考えて、\n僕の脳の論理的思考を司る部分は限界を迎えた。","思考至此，\n我大脑中掌管逻辑思维的部分终于到达极限。"],["嗚呼、脳が空転しまくって、\n思考が","啊啊，脑子空转个不停，\n思考"],["只","只"],["管拡散していく～……。","管扩散开去～……。"],["「果たして今日は実のある１日だったのかどうなのか、\nもう憶えてないや……」","「今天到底算不算是有收获的一天，\n我已经记不清了……」"],["独りごちて明かりを消そうとすると、","正自言自语着要关灯时，"],["ここここん。","咚咚咚。"],["扉が叩かれた。","门被敲响了。"],["え、誰よ？[l]\n宮さんかなあ。","咦、谁啊？[l]\n该不会是宫小姐吧。"],["あ、そう言えば仕事の話がなんたらかんたら──","啊、说起来工作的事好像怎么怎么来着——"],["否応なく僕の脳は、ある程度まで覚醒する。[l]\nまあ脳を動かすには相手が居た方がいいのは自明の理、\nひとりでするのとは全然……","我的大脑被迫清醒了几分。[l]\n毕竟要动脑子的话有人在旁边总归更好，\n和独自思考完全不一样……"],["「（もしもぉし、寝ちゃってますかぁー？）」","「（喂喂～睡着了吗～？）」"],["あれ？","嗯？"],["声の調子としては潜めてるんだろうが、\n扉越しでもしっかり聞こえるそれは、","虽然刻意压低了声音，\n但隔着门依然清晰可闻的动静，"],["「……冬夏？[l]\nなんで？」","「……冬夏？[l]\n为什么？」"],["兎に角扉を開けてみる。","总之先试着开门。"],["「あは。[l]\n起きてた。[l]\n宮さまに場所聞いたのー。","「啊哈。[l]\n醒着呢。[l]\n我向宫大人打听了地址哦～"],["だいじょぶ？[l]\n入れて入れて」","方便吗？[l]\n让我进来嘛」"],["明らかに風呂上がりの浴衣、といった","明显是刚洗完澡的浴衣打扮，"],["体で、\n何というか、艶めかしいっていうの？[l]\n金髪碧眼にも馴れてきたけども、\nこう、妙なギャップで……ねえ？","这样的身姿，\n该怎么说呢，散发着妩媚感？[l]\n虽说已经习惯了金发碧眼的模样，\n但这种奇妙的反差……对吧？"],["流石に眼帯は新しいのになってて、\n濡れ髪からはその、","眼罩倒是换上了新的，\n湿发间飘来那种，"],["「………」",""],["シャンプーなのか何なのか、\n女子の場合色々つけてそうでよく判らないけども、\n所謂そういう匂いが、","不知是洗发水还是什么，\n女孩子总会用各种东西所以搞不太清楚，\n总之就是那种气息，"],["僕の脇をすり抜けて部屋に入ろうとするものだから\nくん、と香るのです。","当她从我身侧溜进房间时\n噗地钻入鼻腔。"],["近い近い、近いって！","太近太近、靠太近啦！"],["「ん？」","「嗯？」"],["あの、そしてそこで立ち止まらないでください。","那个、请别停在那种位置。"],["「や、え？[l]\nじゃない、そのですね……[l]\n宮さんじゃあるまいし早く、って、はッ！[l]\nよもや一緒に……」","「诶、啊？[l]\n不是、这个怎么说呢……[l]\n又不是宫小姐你别突然、哇！[l]\n该不会要一起……」"],["さっと冬夏から離れて、\n入り口の外に身を乗り出し視回す僕。","猛地从冬夏身边退开，\n我把身子探出门外环视四周。"],["……少なくともぱっと視は居る気配無いな。","……至少没发现可疑人影。"],["「……居ないのか」","「……不在吗」"],["と、","这时、"],["じと眼でこちらを視る冬夏と眼が合った。","和用湿润目光盯着这边的冬夏对上了视线。"],["「んだかなー……[l]\n……えーーーーーーと、[l]\nん。[l]\nや、負けません私」","「大概吧～……[l]\n……呃——————，[l]\n嗯。[l]\n才、才不会认输呢」"],["「その反応もよく判らないんですけど、\n……つーか、[l]\nなんか二人似て来てね？」","「这反应我也看不太懂，\n……话说，[l]\n你们俩是不是越来越像了？」"],["それってなんかやばくね？","这状况是不是有点不妙？"],["「うひひ？ってかんじ？[l]\nんー、なーんか、\n深ぁいところで同じニオイを感じたのは\nあるかも。","「唔嘻嘻？这种感觉？[l]\n嗯～怎么说呢，\n可能在内心深处嗅到了相同的气味\n也说不定。"],["なんかね、\n母様とは全然違うんだけど。[l]\nどっちかっていうと道具さんと……[l]\nん？あ、何でもない。","怎么说好呢，\n和母亲大人完全不一样呢。[l]\n硬要说的话倒是和道具小姐……[l]\n啊？没事没事。"],["宮さま、\n最初会ったときは","宫大人，\n刚见面的时候"],["吃","吃"],["驚したけど、\n話してるうちにね、\nどんどん好きになって。","确实吓了一跳，\n但在交谈过程中啊，\n就越来越喜欢上了。"],["お風呂でも盛り上がったよ？[l]\nいっっろんな事教えて貰ったしっ。","连洗澡时都很兴奋哦？[l]\n教了我超——多事情呢。"],["ん。[l]\n確かに、\n今後もいいお友達でいれそう」","嗯。[l]\n确实，\n感觉今后也能做好朋友」"],["「そらぁ良かことで……[l]\n個人的には色々と恐ろしいですだが……」","「那真是再好不过了……[l]\n个人觉得各方面都很可怕就是了……」"],["先刻の想像じゃないが、\n宮さんが二人になるような状況は……","虽然不像刚才想象的那样，\n但宫大人变成两个人的状况……"],["うっ、胃の辺りが……","呜、胃附近有点……"],["「それより、早く入れてほしいんですけど？」","「比起那个，能快点让我进去吗？」"],["「え？[l]\nあ、ああごめんなさい、どうぞどうぞ」","「诶？[l]\n啊、啊啊抱歉请进请进」"],["……つーかさ、何で断らないの僕？","……话说啊，为什么我不拒绝呢？"],["そうは言ってももう入り口からは中に入ってるからさぁ……[l]\n風邪引かれても困るし……","虽这么说但已经从门口进到里面了呀……[l]\n要是害你感冒就麻烦了……"],["「ほー、やっぱおんなじだねー」","「嚯～果然一样呢～」"],["冬夏は先刻の僕と同じ感想を漏らす。","冬夏说出了和刚才的我相同的感想。"],["「う～んちょっと長逗留でね、\n既に若干生活臭が出てるかもだけど…」","「唔～稍微住得久了点，\n可能已经有点生活气息了…」"],["「んー、綺麗だよー。[l]\n真言さんもお風呂入ったの？」","「嗯～很干净呀～[l]\n真言君也洗过澡了吗？」"],["繋げて言うので一瞬戸惑ったが、\n別に体臭がどうとかいう話ではなく、\n単純に風呂にはもう入ったのか、という質問だったらしい。","因为连着说让我一时困惑，\n倒不是在讨论体味什么的，\n似乎只是单纯问是否已经洗过澡了。"],["「うん、あとは寝ようとしてた……」","「嗯，正准备睡觉……」"],["「次は一緒に入ろね。[l]\nあんまりカラダに自信ないけど。","「下次一起洗吧。[l]\n虽然对身体没啥自信。"],["少しはその……愉しませれれればって[l]\nしだがんじゃった、\nあははは、","多少那个……希望能让你愉快[l]\n开始较劲了，\n啊哈哈，"],["ん、ま、兎に角スタイルはしょうがないからね、\n補って余りある、何かしらのサーヴィスする」","嗯嘛，总之身材是没法改变的啦，\n会用其他各种服务来弥补的」"],["「え？[l]\nそ、それはどうなんでしょうカ……[l]\nう、うーん断るのも失礼……ですか？[l]\nこの場合」","「诶？[l]\n那、那个不太好吧……[l]\n呜、唔嗯拒绝又不太礼貌……是吗？[l]\n这种情况下」"],["「約束ね。[l]\n私も愉しみにしてます」","「约好了哦。[l]\n我也很期待呢」"],["「ひえー………」","「咿呀———……」"],["ま、まあ、\n女子の……に限らずこういう約束て、[l]\n大体は社交辞令であるのが常だしな！[l]\n冬夏も多分忘れるであろう。","嘛、嘛啊，\n女生的……不限于这种约定，[l]\n多半都是社交辞令啦！[l]\n冬夏大概也会忘记吧。"],["大神はがっつり有言実行タイプというか、\n冗談だと思ってたのが本気だったりするので\n大変ややこしい。","大神属于说到做到的类型，\n以为是玩笑却会当真\n所以特别麻烦。"],["「取り敢えず布団敷く。[l]\n真言さんの、もちょっとそっちに寄せといて」","「总之先铺被褥。[l]\n真言君的，再往那边挪一点」"],["は？","哈？"],["何故？","为什么？"],["いあ、寄せるのじゃなく、敷くって、え？","不、不是挪开，是说铺被子，咦？"],["「ん、\n脱力して話ししようよってトコかな。[l]\n本音も出やすいでしょ？[l]\n暗いしぃ、普段よりプライベートな気分になれるしぃ」","「嗯，\n就是想放松着聊天啦。[l]\n也容易说出真心话吧？[l]\n又很暗，比平时更容易进入私人状态嘛」"],["「ちょちょちょっと待った、」","「等等等等一下，」"],["「お泊まりした夜って言えば、\nそういうのがお決まりのコースでしょぉ？」","「说到留宿的夜晚，\n那种事不都是固定流程嘛？」"],["「修学旅行の夜かよ！[l]\n定番過ぎ！[l]\nその語尾の感じも何かちょっと怖いです！」","「修学旅行的夜晚啊！[l]\n太老套了！[l]\n而且那个语尾的感觉总觉得有点可怕！」"],["……まあ、実際冬夏にしてみればそんなとこか。[l]\nいやいやいやいやいやいや、","……嘛，实际上对冬夏来说大概就是这种感觉吧。[l]\n不不不不不不，"],["「それにあのね定番ったって普通そういうの、\n同性同士でスルモノデス！！[l]\n男女七歳にして席を同じうせずって言ってだね、\nそんな僕とアナタで」","「再说了所谓的定番啊，\n通常都是同性之间才会做的事！！[l]\n男女七岁不同席这话听说过吧，\n像这样和我你两个人」"],["いや、僕が今更言っても説得力が無いですかそうですか、\nじゃなくて、","啊、现在我说这种话确实没啥说服力是吧，\n不对，"],["「終わったら帰るから。[l]\nそんな警戒しなくっても、\nえへへ、取って喰ったりしないってば」","「结束后就会回去的。[l]\n不用这么警戒，\n嘿嘿，不会把你吃掉的啦」"],["「ほんとかいな……[l]\nって、\n取って喰うってその表現もちっとどうかと思う、\n色んな意味で」","「真的假的……[l]\n话说，\n吃掉这种说法我觉得也有点问题，\n从各种意义上来说」"],["昨今の若人が使う感じじゃなくね？とか、[l]\nそういう意味ですよ。","不像是最近年轻人会用的说法啊之类的，[l]\n就是这个意思。"],["別に残って欲しいとか期待してる訳じゃないけども、\n例えばマジ寝しちゃったらどないすんねん。","虽然也不是说希望你留下来或者有什么期待，\n但万一真的睡着了要怎么办啊。"],["「心配ご無用です。[l]\nじゃ、電気消すねー」","「无需担心。[l]\n那、关灯咯ー」"],["「はっ？！[l]\n何で！！」","「啊？！[l]\n为什么！！」"],["「ん？[l]\nだって本心ぶつけ合うにはそれなりの\nロケーションじゃないと。[l]\nそれとも何かしちゃうつもりかな？","「嗯？[l]\n因为要交心的话\n需要合适的环境嘛。[l]\n还是说你打算做点什么？"],["あはは、出来るなら……してもいいけどね。[l]\n真言さんてば、\n据え膳を視て視ぬ振りするひとだからなー。[l]\nそういうとこがいいんだけど」","啊哈哈，如果可以的话……做也行哦。[l]\n真言先生这个人啊，\n可是会对着现成的饭菜假装没看见的类型呢ー。[l]\n这种地方我很中意哦」"],["「……この短期間であなた、[l]\n相当宮さんに感化されたな？[l]\nや、それはどにがぐ、\nそそそそそれは幾ら何でも」","「……这才短短几天，[l]\n你就被宫小姐影响得相当深了啊？[l]\n不、那个怎么说、\n再再再怎么说这也太」"],["「じゃー消しまーす」","「那ー关灯咯ー」"],["完全に無視ですね？","完全被无视了呢？"],["よくよく考えれば感化されるまでもなく、\n冬夏はそういうキャラだった気もする……[l]\n出会いからして膝枕だったもんな……","仔细想想就算不被影响，\n冬夏原本就是这种角色也说不定……[l]\n毕竟初次见面就让我膝枕来着……"],["据え膳もまた言い回し的にこう、アレでしょうに、\n妙齢の娘さんなのによう知ってるな……[l]\nたまにそういう所あるよなあ冬夏。","现成的饭菜这种说法也是、那个对吧，\n明明是个妙龄少女懂得还真多……[l]\n冬夏偶尔会有这种地方呢。"],["……書庫の町のトップの娘たる面目躍如とでも[l]\n言うべきか。","……该说是书库镇首席之女的风范[l]\n淋漓尽致吗。"],["ぱちん。","啪嗒。"],["うあ！[l]\nほんとに電気消した！！","呜哇！[l]\n真的关灯了！！"],["真っ暗闇ではないけれど、\n寝るには十分の暗さのつまり、\nええ？！","虽然不至于一片漆黑，\n但作为睡觉的亮度已经足够也就是说，\n诶诶？！"],["「あーあ、","「啊ー啊，"],["何しても宮さま宮さま、ね。[l]\n結局は跡追いかぁ……[l]\nなんだかなー。悔しいなー。切ないなー」","不管做什么都宫小姐宫小姐的。[l]\n结果还是在追随她的背影啊……[l]\n真是的ー。好不甘心ー。好难受ー」"],["「何言ってるのかよく判らないですが、\nってもう布団入ってるし！」","「虽然不太明白你在说什么，\n但已经钻进被窝了喂！」"],["「んー、だから真言さんも早く寝て寝て。[l]\n私明日早いんだから」","「嗯ー、所以真言先生也快点睡啦。[l]\n我明天还要早起呢」"],["「うぇぇええーー………」","「呜诶诶诶诶ーー………」"],["……。[l]\nこうなったらもう、\n横になるしかないです……","……。[l]\n事到如今，\n只能躺下了……"],["「ん。[l]\nあははっ。[l]\n何か、あは、笑っちゃうね、あははは」","「嗯。[l]\n啊哈哈。[l]\n总觉得，啊哈，好好笑，啊哈哈哈」"],["「照れ笑いするくらいならお止しなさいよ……[l]\nあはははは……」","「要傻笑的话不如给我停下……[l]\n啊哈哈哈哈……」"],["宮さんで多少免疫あるけれど、\nやっぱりこのシチュエーションでは、\n……笑うしかないよ、実際。","虽然对宫小姐还算有点免疫力，\n但果然在这种情境下，\n……除了笑也没别的办法了，真的。"],["なんだこの感じ。[l]\nなんだこの状況。","这什么感觉啊。[l]\n这什么状况啊。"],["同じ布団でないだけマシだが、\n──いや、あんまかわらん。[l]\nなにこれ？！[l]\nなにがしたいのさ？！","幸好没睡同条被子，\n──不，其实也没差多少。[l]\n搞什么啊？！[l]\n你到底想怎样啦？！"],["「はふぅ～～にしても今日は疲れたねー。[l]\nお疲れさまでした。[l]\nありがとうございまーす」","「哈呼～～不过今天真是累坏了—。[l]\n辛苦您了。[l]\n谢谢啦—」"],["「……ああ、まあ、[l]\n──お疲れさまでした」","「……啊，那个，[l]\n──辛苦您了」"],["「……んははっ」","「……嗯哈哈」"],["「……あによ」","「……讨厌啦」"],["「何でもないですー。[l]\n……っぷふふ。[l]\nあはははは！[l]\n……はぁあ～～ーーーーーーー～～～～～！！！」","「没什么事—。[l]\n……噗呼呼。[l]\n啊哈哈哈！[l]\n……哈啊～～～～～～～～～～～～～～～！！！」"],["「？？！！？？！！」",""],["突然彼女は頭を抱えて枕に突っ伏したよ？！","突然她就抱着脑袋栽进枕头里了耶？！"],["「まずい……[l]\nやりすぎたぁ……[l]\nいただだだだだだだだだだだだだ\nひぃーーーーーん」","「糟了……[l]\n玩过头了啦……[l]\n痛痛痛痛痛痛痛痛痛痛痛痛\n咿————呜」"],["「ど、ど、どうしたのよ」","「你、你、你怎么啦」"],["「はしゃいだ……反動が……[l]\nいま……超恥ずい……っす」","「闹太嗨……后劲……[l]\n现在……超级羞耻……的说」"],["「あ、ああ、それは、まあ、\nそうだろうねえ……」","「啊、啊，那个，怎么说，\n确实会这样呢……」"],["宮さんの域にはまだ達してないか……[l]\n半日分の反動とすればそれはかなりのもんだろうしなあ。","还没达到宫小姐的境界呢……[l]\n半天的反作用力来说已经相当够呛了吧。"],["てかまさに今の今まで、\nアナタ一体どれほどの言動……[l]\n昼会ったときも同じような後悔してたでしょうに……","话说直到刚才那一刻为止，\n你究竟有多少言行……[l]\n白天见面时明明也这样后悔过吧……"],["「やばいやばいやばいやばい、\n死にそう……恥ずくて死にそう……[l]\nだめだめだめだめだめだめだめだめ、\n私ほんとに馬鹿ほんと馬鹿何やってんのもう～～」","「糟了糟了糟了糟了，\n要死了……羞耻得要死了……[l]\n不行不行不行不行不行不行，\n我真是笨蛋真是笨蛋在搞什么啊真是的～～」"],["「あははははは……[l]\nまあまあ冬夏さんよ、\n落ち着きなさいって……」","「啊哈哈哈哈哈……[l]\n好啦好啦冬夏小姐啊，\n冷静点啦……」"],["枕に顔を擦り付けながら、なんかばむばむ叩きまくってますが。","把脸在枕头上蹭来蹭去，还砰砰地拼命捶打着。"],["「手…かして……」","「手…借我……」"],["「？」",""],["顔を伏せたまま冬夏がそろそろとこちらに手を伸ばしてきた。","冬夏低着头慢慢朝这边伸出手来。"],["「…か、貸せ、とは？」","「…啊、借、是说这个？」"],["「……ん……」","「……嗯……」"],["黙って手を伸ばしたまま、\nより一層ぎゅむーと顔を枕に押しつける冬夏。","沉默着继续伸手，\n冬夏把脸更加用力地闷进枕头里发出咕噜声。"],["「…え、こういうことかいぇ？」","「…呃，是要这样吗？」"],["なんかわからないけども、\n取り敢えずその手と握手。","虽然搞不太懂状况，\n总之先握个手吧。"],["「……うーん」","「……嗯——」"],["これもその恥ずかし行動の一環に思えて仕方のない\n僕なんですけれど、","虽然我自己也觉得这属于羞耻行为的一环\n就是了，"],["……あれ、動かないな。","……咦，动不了啊。"],["「冬夏さん？」","「冬夏小姐？」"],["「………ふすー……」","「………呼嘶……」"],["寝たんかい！！","居然睡着了！！"],["「んはは。[l]\nごめんなさい起きてます。[l]\nうっいたたたたたた、胸がぁ痛いっすぅ～、\nもう死んじゃうぅ～～」","「嗯哈哈。[l]\n抱歉我醒着呢。[l]\n呜痛痛痛痛痛、胸口好痛啊啊～、\n快要死掉啦～～」"],["ああああ、だからそうやって恥の上塗り？してるからだろうに、[l]\nって、手は放してくれんのですかね。","啊啊啊、所以就是因为总这样反复社死、[l]\n话说、能先把手松开吗。"],["「まあそうやって夜呻く事は良くあることよ……[l]\n気にする事はない」","「嘛晚上这样呻吟也是常有的事……[l]\n不用在意」"],["「そう？」","「是吗？」"],["がばっとこちらを向く。","猛地转头看过来。"],["「え、まあ、僕だけかも知れないけど……[l]\n過去の失敗ってのは不意に思い出されてこう、\n声に出る程恥ずかしくなる事はままあるよ。[l]\nあれはね、厳しいね……」","「呃、虽然可能只有我这样……[l]\n过去的失败总会突然浮现、\n经常羞耻到忍不住出声呢。[l]\n那种感觉真是够呛……」"],["あんまり記憶力のアレな僕でもそんな感じな訳で、\n人並みのスペックだったらそりゃあ……","就连我这种记忆力不太灵光的人都这样、\n普通人肯定更……"],["「兎に角、済んだことはしょうがないし、\n何事も受け止めて前に進む事が大事だよね。[l]\n……呻くくらいで済むなら、呻けばいいし」","「总之、过去的事无法改变、\n重要的是接受现实继续前进。[l]\n……能靠呻吟解决的话就尽情呻吟吧」"],["あとは時間が解決することもあるし、\n幸か不幸か、\n僕ぁ２日も寝たら大体リセットされるしなあ。","有些事时间自会冲淡、\n幸或不幸、\n我睡两天基本就能重置状态啦。"],["「ん……[l]\nそうだよね。[l]\nあのね、まことさん、\nもう恥ずかしついでに言っちゃうけど」","「嗯……[l]\n说得对呢。[l]\n那个啊、真言先生、\n趁现在羞耻感上头我直说了哦」"],["「はいさ、なんでしょう」","「请讲、什么事呢」"],["「私ねぇ、\nまことさんのこと好きだよ」","「我呢、\n喜欢真言先生哦」"],["………。",""],["………？",""],["「はい？」","「啊？」"],["「………ん～、」","「………嗯～、」"],["冬夏はずっと眼を離さない。[l]\nその、握った手も放さない。[l]\nみるみる困り顔になっていく冬夏。","冬夏始终没有移开视线。[l]\n那只、紧握的手也没松开。[l]\n眼见着她表情逐渐困扰起来。"],["いや、まあ、そのですね、","不是、那个怎么说、"],["はい？","喂？"],["混乱してますが、ああ、そういえば、","虽然很混乱、啊对了、"],["「……んぁ。[l]\n","「……嗯啊。[l]\n"],["刻…というか昼に言ってたねぇそんなことも」","刻…不对中午好像也说过类似的话」"],["「違うよ」","「不一样」"],["「あんなやわい意味じゃないよ」","「不是那种轻飘飘的意思」"],["「………ん～～～～」","「………嗯～～～～」"],["「あなたがすき。[l]\nすきです。[l]\nまことさんがすき」","「我喜欢你。[l]\n好喜欢你。[l]\n最喜欢真言先生了」"],["……ロケーションが大事とはよく言ったもので、[l]\n暗さと、","……所以说场景氛围很重要、[l]\n黑暗环境、"],["横","横"],["臥体勢っていうのは、\nそういう会話も自然に思える。","躺姿势这种东西、\n会让这种对话都显得自然。"],["宮さんの添い寝とか、──冬夏の膝枕もそうだけど、\n寝てる状態というのは、\n実はかなり容易に、非日常を演出出来るものなのでは\nなかろうか。","宫小姐的陪睡啦、──冬夏的膝枕也是、\n躺卧状态、\n其实很容易营造出\n非日常感吧。"],["と混乱しつつ僕はどこか冷静に考えていた。[l]\n寧ろ現状を現実として認識してない、\n一種の逃避感覚なのかも、うふふ。","混乱之余我竟冷静地思考着这些。[l]\n不如说根本没能把现状当作现实、\n或许是某种逃避机制呢、呵呵。"],["が、それは兎も角ですね、","不过那些都先放一边、"],["「……なんというか、その、[l]\n大変ありがたいお言葉ではある、んだけども、\nその僕等、知り合って間もない……よね？","「……该怎么说、就是、[l]\n虽然非常感激你能这么说、\n但我们才认识不久……对吧？」"],["それにその、すきにもいろいろあるし、\nやわい意味でないというのもはたしていったいどういう\nことなのやらそのね」","而且那个，喜欢也分很多种，\n说不是那种轻浮的意思到底又是\n怎么回事呢那个」"],["「こういうのって感得するものだと思うのね。[l]\n言葉とか理屈とか基準がどうとかじゃない所で\nワカルものだと思ってるよ私は」","「我觉得这种东西是要靠感觉来领会的呢。[l]\n不是用言语啊道理啊标准啊这些能说清的\n地方就能明白的东西哦」"],["感得……[l]\n最近","领会……[l]\n最近"],["頓に聞く言葉だけども、\nこの場合は","突然经常听到的词，\n这种情况"],["所","的"],["謂、\nびびっと来たという奴かなぁ……","大概，\n就是所谓的心头一震吧……"],["と、\nどうにもまるで他人事のように思考してる自分が居る。","这样\n思考着的自己简直就像在说别人的事一样。"],["なんだろう、\nこの感じは、","怎么回事，\n这种感觉，"],["……まあ今まで単に経験してないシチュエーションだから、[l]\n喜怒哀楽云々よりまず混乱しているだけだと思うけど、","……嘛毕竟至今为止从没经历过这种状况，[l]\n比起喜怒哀乐什么的首先整个人都混乱了，"],["何だろう。","但究竟。"],["変に冷静な部分が頭の何処かに間違いなく存在して。","异常冷静的部分确实存在于脑海某处。"],["心臓の鼓動は普通なら──あくまで想像だけども──\nこういうときは","心脏的跳动若是平常──虽然只是想象──\n这种时候"],["早","应该会像"],["鐘を打つが如く、\nドキドキしたりするんだろうが、","敲钟般剧烈，\n咚咚直跳才对，"],["何故か、\n脈拍は鎮静、というか、無意識的に抑えようとしてるというか、\n要するに、","但不知为何，\n脉搏却很平静，或者说下意识地压抑着，\n总之，"],["何だろう？","怎么回事？"],["「……まあ、[l]\n──そうかもねぇ……ただその人にもよるというか…、」","「……嘛，[l]\n──或许吧……不过也分人就是了…，」"],["「きらい？[l]\nだめ？私じゃあなたのになれない？[l]\n他にすきなひと居るの？[l]\nあっ、宮さま？」","「讨厌？[l]\n不行？我不能成为你的吗？[l]\n还有其他喜欢的人吗？[l]\n啊，宫大人？」"],["やっ……","啊……"],["と言って黙る冬夏。","说到一半沉默的冬夏。"],["やっぱり、と言おうとしたのかな……","该不会是想说果然吧……"],["や、やっぱりって思われてもそれもあのその、\n宮さんとは確かにここんとこあんまり接触がないから、\n妙に気もそぞろな部分があるのかも知れず、","被、被这么认为的话那个其实也是，\n和宫小姐最近确实没什么接触，\n可能因此显得有点心神不宁，"],["それを敏感に察知されたのかも知れないけども、\nだからといって、","或许被敏锐地察觉到了，\n但即便如此，"],["……ん？[l]\nそんなに離れてた訳でもないのか、\n何か随分、\n一緒に居てないつもりだった──","……嗯？[l]\n倒也没那么疏远，\n总觉得\n好像很久没在一起──"],["はっ。","啊。"],["「いあいあいあいあ、\n彼女なんかずっと居ないし今好きって言えるような人も……[l]\nあははは……宮さんはさぁ、その……あれ？」","「啊啊啊啊啊，\n她根本不在身边现在也没有能说喜欢的人……[l]\n哈哈哈……宫小姐那个……咦？」"],["……冬夏は再び枕に突っ伏した。","……冬夏再次把脸埋进枕头。"],["──泣いてる？","──在哭吗？"],["「わたし無茶言ってる？","「我是不是太乱来了？"],["ほんとならね、\nここできっぱり諦める為にもさ、\n駄目ならばっさり斬り捨てて。[l]\nて言うのが格好いいよね。","按理说，\n为了干脆地放弃，\n不行的话就该快刀斩乱麻。[l]\n这样说才帅气吧。"],["でも、\nそんな","但是，\n这种"],["台","要"],["詞なんて、言えないよ……","话……说不出口啊……"],["私、ほんとにあなたがすきなんだよ。[l]\nわかるんだよ、あなたなんだ、って。[l]\nカラダが求めてる、アタマじゃないの。","我，真的最喜欢你了。[l]\n身体明白的，就是你啊。[l]\n是身体在渴求，不是脑子。"],["迷惑かも知れないけど……[l]\n突然過ぎてごめんとしか言えないけど……[l]\n即答貰えない時点でアウトなのかもだけど……[l]\nわたし、あなたがひつよう、なの、です、あうぅ～」","可能给你添麻烦了……[l]\n突然到只能说抱歉……[l]\n不能立刻得到答复的话可能就没戏了……[l]\n我、需要你、的说、呜嗯～」"],["話ながら僕とは反対方向を向く。[l]\nう、うーん。","说话时朝着与我相反的方向。[l]\n呜、呜嗯。"],["「な、何にしてもその、仰る通り、\n話が急すぎるし、\n僕も今混乱してるし、\n出逢ってから実際何日だっけ？","「不、不管怎样那个、您说得对、\n事情太突然了、\n我现在也很混乱、\n实际相遇才几天来着？"],["お互い殆ど何も知らない訳じゃない？」","我们几乎对彼此一无所知不是吗？」"],["と言うと、がばっとこっちに向き直る。","话音刚落，就猛地转向这边。"],["「えぇ～結構話したよ。っていうか、[l]\nだから、\n関係ないの期間とかそういうの。","「诶～明明聊了很多呀。应该说、[l]\n所以、\n和交往时长那些都没关系。"],["貴方なの。[l]\nまことさんがすき。","是你。[l]\n喜欢真言先生。"],["何でって言われても、\n言葉になんか出来ない、\n素直な私の本心」","就算问我为什么、\n也没法用语言表达、\n这就是我坦率的心意」"],["「あー、う、うーーん。[l]\nええとさ、\nじゃあ端的に言うとさ、\n──キライでは……ないよそりゃあ。","「啊—、呜、呜嗯——。[l]\n那个啊、\n那就直截了当地说、\n──倒也不是……讨厌啦。"],["だからその、\n好いてくれるコトに関してはありがとう、というか、\nうーん、えー、","所以那个、\n谢谢你喜欢我、应该说、\n呜嗯、呃、"],["ただ、いきなりその、\n言われてもですな、\n心の準備と言いましょうか、","只是、突然被这么、\n告白我也、\n该说是心理准备不足、"],["ああもう、何て言ったら良いんだろな、\nここでうん、とも駄目、とも言うには判断材料が\nなさ過ぎるというか、","啊真是的、该怎么表达才好、\n现在要立刻答应或拒绝都缺乏\n判断依据、"],["即答はそれぁ無理だべさというか、\nね、それは冬夏から言われたんじゃなくたって、\n他のひとから言われたってきっとそうだから、\nそこは気にしないでいいよ、うん、","当场答复实在做不到、\n你看、就算不是冬夏来告白、\n换作其他人肯定也是同样反应、\n这点不必在意、嗯、"],["キライとかイヤだからじゃないんだ、\nごめん、ほんとに、その、","不是因为讨厌或反感、\n抱歉、真的、那个、"],["………。[l]\n………。[l]\n………あの、","………。[l]\n………。[l]\n………那个、"],["例えばお友達からというのはどうだろうか。[l]\n何か中間すっ飛ばしてるから驚いてるん、かなあ僕も、\nはは……」","先从朋友做起怎么样？[l]\n可能跳过太多步骤让我也吓到了、\n哈哈……」"],["自分でも、\nこういう女子からの告白に対して、\n煮え切らないこの態度はどうかと思う、\n思うけども、","连我自己都觉得、\n面对女生这样的告白、\n这种含糊态度很不像样、\n虽然这么想、"],["嬉しくない訳じゃない、\nただ今は驚きが大きすぎて……[l]\n妙な冷静さは相変わらず思考の中に居座っているし、\nそれに──僕は、なんだ、えー、み、","但也不是不开心、\n只是现在震惊盖过了一切……[l]\n异常的冷静仍盘踞在思绪中、\n而且——我啊、该怎么说、呃、"],["み？","呃？"],["「ん。[l]\n分かってます。[l]\nごめんね。[l]\nごめん。","「嗯。[l]\n我明白的。[l]\n对不起哦。[l]\n对不起。"],["でもね、\nすき。[l]\n………。","但是呢、\n喜欢你。[l]\n………。"],["すき、\nすき……[l]\nはふう……","喜欢、\n喜欢……[l]\n哈呼……"],["トモダチって、\n例えば宮さまやきぃと同列なのかな。","所谓朋友，\n是和宫大人还有小贵同等级的存在吗。"],["真言さんにとって、\n他の色んな人達と一緒なのかな、\nそりゃそうか、ともだちだもんね、\n恋人じゃ、ないもんね」","对真言先生来说，\n我和其他各种各样的人都是一样的吧，\n啊不过也是呢毕竟是朋友嘛，\n又不是恋人什么的」"],["「うん……と、[l]\nは？」","「嗯……那、[l]\n诶？」"],["何と答えたら良いのか迷ってる内に、\n冬夏は独り語り出した。","正在犹豫该怎么回答时，\n冬夏已经开始了自言自语。"],["「告白なんかしないで、","「要是不告白的话，"],["黙ってこのままの関係で、\nこのままの距離で、\n居続けるのも楽な選択だったんだろうなーって、\n迷ったりもしたけど、","保持现在这样的关系，\n维持现在这样的距离，\n就这样持续下去应该会更轻松吧——\n虽然也犹豫过，"],["お互い、\n………、[l]\n………、[l]\n……祭が終わったらどうなってるかわかんないから。","但彼此都、\n………，[l]\n………，[l]\n……祭典结束后会变成怎样谁都不知道。"],["後悔したってそれこそ後の祭りだ。あはは」","等到后悔的时候就真的成了马后炮啦。啊哈哈」"],["祭が終わったら……","祭典结束后……"],["確かに僕は、どうなってるか──、","确实我，会变成怎样——"],["……でも、","……但是，"],["お互いって？","彼此都？"],["冬夏──？","冬夏——？"],["「あの──」","「那个——」"],["「私ね、今すごい無理してる」","「我现在啊，正在超级勉强自己」"],["今日言ったじゃない？","今天不是说过了吗？"],["海とか山が好きって。","喜欢大海啊高山什么的。"],["自分の小ささを自覚することってね、","意识到自己的渺小这件事啊，"],["自分がセカイの中で単なる一要素でしかないんだ、って、","明白自己不过是世界里微不足道的元素，"],["どんなに深刻に悩んでてもセカイは、","不管多么烦恼世界都、"],["全く関係なく進んでくって事を思い知らされるのは、","会毫不在意地继续运转这件事，"],["考えようによっては救いでもある、でしょ？","换个角度想也算是种救赎对吧？"],["でもね、やっぱり、","但是呢，果然还是、"],["私、今、","我现在、"],["……に側にいて欲しいんだよ。","……想要有人陪在身边啊。"],["独りはイヤ。ほんとはすごく怖いよ。","不要独自一人。其实超级害怕的。"],["独りはイヤ。逃げたい。何もかもホウキして、","不要独自一人。想要逃跑。把一切都扫除干净，"],["……多分彼女はそう言った。[l]\nが、大半は枕に突っ伏していてちっとも明瞭じゃなくって、\nきっと泣いていたから、","……她大概是这么说的。[l]\n但因为大半张脸都埋在枕头里完全听不清晰，\n肯定是在哭吧，"],["──よくわからない。","——听不太清楚。"],["「そんな理由で男にすがる女ってキライ？[l]\nでも決して道具というか、\n便利な逃げ場として視てる訳じゃない……と思う。","「会因为这种理由依赖男人的女生很讨厌吧？[l]\n但绝对不是说把你当道具、\n或者方便的避风港之类的……我是这么想的。"],["そうとられても仕方ないけど、でも、でもね、\nアナタだから、\n真言さんだから、\n他の誰でもないまことさんだから、","虽然被这么认为也没办法，但是，但是啊，\n因为是你的缘故，\n因为是真言先生，\n因为是独一无二的真言先生，"],["……ああもう死にそうだよぉ、[l]\n貴方の特別になりたい、","……啊啊真是羞死人了，[l]\n想要成为你的特别，"],["こんなこと、ひとのおもいを強制なんて出来ないけど、[l]\nじゃあ、せめて、\n少なくともキライじゃないなら、」","这种事，虽然不能强求别人的心意，[l]\n那至少、\n只要不是讨厌的话，」"],["昼間してくれたように、","就像白天做的那样，"],["一回だけぎゅってしてください。","用力抱我一次就好。"],["「今晩はそれで我慢するから。[l]\nそれで帰るから。","「今晚这样就满足了。[l]\n这样就会回去了。"],["迷惑かけたくないし、\nその……宮さまとのことも……[l]\n冷静に考えてみる。[l]\n勝てる相手かどうかとかさっ、あはは……」","不想造成困扰，\n那个……和宫大人的事也……[l]\n会冷静下来思考。[l]\n看看是不是能赢过的对手之类的啦，啊哈哈……」"],["と言うと、僕の返事や今の発言に対する異論を待たず、\n布団を出て、","话音刚落，不等我对答复和刚才的发言提出异议，\n她就钻出被窝，"],["僕の掛け布団越しに、上に被さってくる。","隔着我的被子压了上来。"],["視えるその蒼い片眼はやっぱり涙眼で、\n僕と視線を合わせないまま、\n金色の髪が僕の頬にしだれて、\nこそばゆいというか──","能看见的那只蓝眼睛果然噙着泪水，\n始终不与我对视，\n金色发丝垂落在我脸颊上，\n痒痒的──"],["………",""],["「……重っ」","「……好重」"],["「うぞ、ほんと？！[l]\n……布団の所為よね、ん。[l]\nそうだそうだ布団のせい」","「呜哇真的假的？！[l]\n……是被子的缘故啦，嗯。[l]\n对对对都怪被子」"],["「結構背高いからなぁ冬夏は……[l]\nなんて、僕がよわよわなだけだったり」","「毕竟冬夏个子挺高的……[l]\n或者说单纯是我太弱鸡了」"],["「……重さは否定してくんないんだ。[l]\nいいよーだ。[l]\nこの重みがひとと重なってる実感だもんっ」","「……都不否认重呢。[l]\n不过没关系。[l]\n这份重量正是与人相拥的实感呀」"],["一瞬だけ、強い視線で僕を直視する。[l]\nだんだんと近づき、","有那么一瞬间，她用炽热的目光直视我。[l]\n渐渐靠近，"],["僕の右肩の辺りに顔を埋めた。","把脸埋在我右肩附近。"],["「……じゃ、[l]\nしてあげたらお戻りよ？」","「……那，[l]\n抱完我就回去咯？」"],["「……ん」","「……嗯」"],["何処か冷静なままなのに、\n同時に何処かでは確実に掻き乱されている、\n奇妙な感覚を覚えながら、\n僕は布団越しに冬夏を、","明明某处还保持着冷静，\n同时某处又确实被搅得乱七八糟，\n怀着这种奇妙的感受，\n我隔着被子"],["……抱き締めた。","……抱紧了冬夏。"],["だだだって、そうしないと、\n収拾がつかなそうだった、から……","因、因为不这么做的话，\n局面似乎就要失控了……"],["「……どうすか。[l]\nついでに尻でも触ったろうか」","「……要不再过分点。[l]\n顺便摸摸屁股如何」"],["──つい、宮さんの責めをいなす時のような、\n『攻撃は最大の防御』的な台詞を口にしてしまった。[l]\nしもた状況が違うか、と思ったけれども、","──不小心说出了像应付宫小姐时那种，\n『进攻就是最好的防守』式的台词。[l]\n虽然立刻意识到场合不对，"],["「ん、今はだめ……[l]\nありがと……[l]\nなんか……なつかしいな……なんでかな……[l]\nんふぅ……はぅ……」","「嗯、现在不行……[l]\n谢谢……[l]\n总觉得……好怀念啊……为什么呢……[l]\n唔呣……哈啊……」"],["あああああぶなかった。[l]\nにしてもここまでしといて今更何か違うんだろか。[l]\n境界線がどこかさっぱりわからんけど、\n実際肯定されててもこまっ──","啊啊啊差点完蛋。[l]\n不过都做到这份上了现在才矜持是不是有点怪。[l]\n虽然完全搞不清界限在哪，\n但就算被默许也很困──"],["ヤッパリアナタダ。","果然是你啊。"],["ヤッパリコノコカ。","果然是这种感觉啊。"],["……なに？[l]\nなんて言った？","……什么？[l]\n你刚说什么？"],["いや、僕も今何かを口走った──","不，好像我自己也脱口而出了──"],["しかし、\n体勢的に互いの顔は視えてないからか、\n冬夏は何事もなかったように、","然而，\n或许因为体位关系看不见彼此的脸，\n冬夏装作无事发生般，"],["「ほんとは……もっとしたいけど……[l]\nやめとくね、恥ずいから、流石に──」","「其实……还想继续的……[l]\n还是算了，太羞人了，再怎么说也──」"],["と言った。","如此宣布道。"],["………だから、[l]\nこれ以上恥ずい状況てどんなだ。[l]\nえー……、げふげふ。[l]\n境界が全然分かりません。","………所以说，[l]\n比这更羞人的情形还能怎样啊。[l]\n呃……咳咳。[l]\n完全搞不懂分寸。"],["頭の中は混乱と冷静さが同居したままで、\n冬夏の息遣いだけが","脑海里混乱与冷静同时并存，\n唯有冬夏的呼吸声"],["明","明"],["瞭聞こえるなか、\n１分ほど経ったろうか、","清晰可闻，\n大约过了一分钟，"],["……この状態での体感時間は極めて信頼が置けないので、[l]\nもっと長かったのかも知れないし短かったのかも知れないが、","……这种状态下的体感时间极不可靠，[l]\n也许实际更长或更短，"],["兎に角あの、\nこのまま眠られても大変に困るので、\nゆっくりと冬夏の方へ顔を傾けて言う。","总之那个啊，\n要是你就这么睡着了我可会很困扰的，\n缓缓将脸转向冬夏那边说道。"],["「……さ、[l]\nお戻りなさい、自分の布団に。[l]\nじゃない、お部屋に？」","「……好、[l]\n快回去吧，回你自己的被窝。[l]\n不对，回你房间？」"],["「……意地悪だなぁ真言さんわぁ」","「……真言先生好过分呀～」"],["僕が回していた手をゆっくり離すと、\n枯れてるにも程があるのだわ、\nと言いながら渋々彼女は起き上がって、\n……部屋には戻らず、自分の布団に入った。","当我慢慢松开一直揉着的手，\n这也枯萎得太夸张了吧，\n她边抱怨边不情不愿地爬起来，\n……却没回房间，钻进了自己的被窝。"],["矢張り相当恥ずかったのだろう、\nすっぽり布団を頭から被って──\n……穴があったら入りたいのは僕の方だけど、","果然还是相当害羞吧，\n把被子从头到脚裹得严严实实——\n……虽然真想找个地洞钻进去的是我，"],["一",""],["頻り呻いた後、\n話し始める。[l]\nだから、","她哼哼唧唧了好一阵，\n终于开口。[l]\n所以说，"],["呻","哼"],["吟する位ならしなきゃいいのになあ……","既然要呻吟还不如别做啊……"],["「昼間に海で話した、\n男の子との約束ね、","「白天在海边说的、\n和那个男孩子的约定呢，"],["………[l]\nもしね、\n子供の頃に出逢ったあの男の子、","………[l]\n如果说啊，\n小时候遇见的那个男孩，"],["それが、\n本当に真言さんだったら、\n教えたげる。どんな約束か」","其实、\n就是真言先生的话，\n我就告诉你。是什么样的约定哦」"],["「……本当にって、[l]\nどうやって確かめるんでせうか。[l]\nなにか証拠とかがあったり……？」","「……说是真的，[l]\n要怎么确认呢。[l]\n有什么证据之类的吗……？」"],["「ん……まあ、[l]\n昼もちょっと言いかけたけど、\nほら、真言さん寝ちゃったから言いそびれてたんだよ？","「嗯……其实、[l]\n白天也稍微提过一点，\n你看，因为真言先生睡着了就没说完嘛？"],["二人で砂の城をつくったの、\nあは、流石にそれはもう無いだろうけど。","我们俩一起堆了沙堡的，\n啊哈，不过现在肯定早就没了吧。"],["その下にね？[l]\nというか、これも先刻言ったけどお墓なのかな、\nオクツキだったかな？[l]\n城の字は入ってたはず。","在那下面呢？[l]\n或者说，刚才也提过的像是坟墓的东西，\n是叫御厨城来着？[l]\n肯定带个城字的。"],["その時会った不思議なひとに言われて、\n……まあ、[l]\n真言さんが思い出してくれれば話は超早いんだけど、\nそうもいかなそうだから」","那时候遇见的神秘人说的，\n……嘛，[l]\n要是真言先生能想起来就省事多了，\n但看来不太可能呢」"],["あはは、と笑う。","她咯咯笑起来。"],["悪うござんしたね……[l]\nそれにそれは、その男子が確実に僕であった時の話だべさ。","真是抱歉呐……[l]\n而且那前提得是那男孩百分百就是我呢。"],["「実際今日、探そうかとも思ったんだけど、\n……たはは、その時はまだ告白迷ってたってゆーか、[l]\nそしたら真言さん寝ちゃうし、\n結局忘れちゃったの。","「其实今天本来想去找找看的，\n……啊哈哈，那会儿还在纠结要不要告白来着，[l]\n结果真言先生又睡着了，\n最后就忘啦。"],["目印とかもあやふやで、\n現地で思い出しながら探そうとしてたから、\nまあ、だからね、\n一緒に……みにいこうよ……今度さ……","连标记物都记不清了，\n打算到现场边回忆边找的，\n所以啊，\n下次……一起去找吧……好不好……」"],["………[l]\n………」",""],["「………？[l]\nおい、寝なさんなよ？」","「………？[l]\n喂，别睡啊？」"],["「……あはは…起きてます。[l]\n落ちかけたけど。","「……啊哈哈…醒着呢。[l]\n差点睡着而已。"],["ん、\nそれみても思い出せなかったら真言さん、\nやっぱり違うのかもだけど。[l]\nその時は、さっきの話はヒミツのままだね、あはは」","嗯，\n要是看了也想不起来的话真言先生，\n可能真的不是我呢。[l]\n那样的话，刚才说的就继续当秘密咯，啊哈哈」"],["別にいいけどさそれは……落ちかけたってのはよくないが……","倒也无所谓啦这个……不过差点睡着可不行……"],["ただ、あの時あの場所でのことが、\nここのところフラッシュバックのように顕れる情景と\n同じだとすれば、","只是，如果那时在那个地方发生的事情，\n与最近像闪回般浮现的情景\n相同的话，"],["それはきぃや宮さんや、","那就是小贵或宫小姐、"],["──冬夏達や飯窪家の何らかの確執？が、","──冬夏她们和饭洼家的某些纠纷？"],["子供の頃から、","从孩提时代起，"],["そんな因果律なんて、\n前から仕組まれてたようで、","那种因果律什么的，\n似乎早就被设计好了，"],["……冬夏が、そんな僕の思考を見透かしたように言った。","……冬夏像是看透了我这样的想法般说道。"],["「運命がどうとか言うつもりはないよ……[l]\nそこまで乙女じゃないす……[l]\nただね………」","「我并不是要说什么命运之类的……[l]\n还没那么少女心啦……[l]\n只是呢………」"],["「……もしもし？！[l]\n寝なさんなよ！？」","「……喂喂？！[l]\n别睡着啊！？」"],["「………ふひっ。[l]\nくふふ。[l]\nはぁ～あ、\nイケズなおかただなぁ真言さんて。","「………噗嗤。[l]\n呵呵。[l]\n哈啊～啊，\n真言先生真是坏心眼呢。"],["こんなにも……すきなのに……ぐす。[l]\nやっぱり……」","明明都这么……喜欢你了……呜咽。[l]\n果然还是……」"],["「……やっぱりてなんですか。[l]\nまた変な誤解をしてそうだけど……」","「……什么叫果然啊。[l]\n你好像又产生了奇怪的误解……」"],["聞こえてないのか、\n噛み合わない返事が来た──いや、そもそも独り言なのか。","是没听见吗，\n传来牛头不对马嘴的回答──不，或许根本就是自言自语。"],["「……あなたと一緒なら、私、[l]\n私で居られるんだ、きっと。[l]\nだから、待つ。[l]\nん、諦めない」","「……只要和你在一起，我，[l]\n我就能做我自己，一定。[l]\n所以，我会等。[l]\n嗯，不会放弃」"],["がばっと身体を起こす冬夏。","冬夏猛地撑起身体。"],["「私の誕生日ね、\n４月２３日」","「是我的生日哦，\n4月23日」"],["「……え？[l]\nああ、そうなんだ……」","「……诶？[l]\n啊，这样啊……」"],["あと１０日後、\n祭が予定通りならその一週間ほど前か……","再过十天，\n如果祭典如期举行那就是那之前一周左右吧……"],["「返事、その時でいいよ」","「答复，等到那时候就行」"],["「……んむ」","「……嗯唔」"],["「ほんとは少しも待てないけど。[l]\nエゴだもんねそれは。[l]\n…ほんとはぜんっぜん待てないよ？私。","「其实一刻都等不了啦。[l]\n因为很自私嘛。[l]\n…其实根本～完全等不了哦？我。"],["辛いよほんとは。[l]\n待てる自信全然ないよ。[l]\nでも、……待つ。[l]\n待ってます。","其实很痛苦的。[l]\n完全没有能等下去的信心。[l]\n但是，……我会等。[l]\n我会等着。"],["ただ、\n絶対、\n返事ください。","只是，\n绝对，\n请给我答复。"],["それだけ約束してくれたら、\n私……待てるよ。[l]\nどっちの答えでも……いいから。[l]\n駄目な方だとしても、」","只要答应我这一点，\n我……就能等下去。[l]\n无论哪个答案……都可以。[l]\n就算是不好的那个，」"],["もしもの時に、\n私のセカイへの未練を断ち切る後押しにはなってくれるから──","在万一的时候，\n也能成为斩断我对这个世界留恋的助力──"],["すっかり鼻声になってて良く聞こえなかったけど、\n何か覚悟めいた強い意志を感じて僕は、\n戸惑うだけで。","虽然因为完全带着鼻音听不太清，\n但我感受到某种近乎觉悟的强烈意志，\n只能不知所措。"],["「返事……」","「答复……」"],["「誕生日プレゼントだと思って、\nお話いっぱいしてくれるだけでも、いい、\nまた、会う約束を、\n待つのが楽しい未来を規定してください、","「就当是生日礼物，\n只要能和我说很多话，就够了，\n还有，约定再会，\n请规定一个等待时充满快乐的未来，"],["そうすれば私、\n私──」","这样的话我，\n我──」"],["幾分声の調子は戻ったと思ったのに、\nそこで冬夏は言葉が詰まって、\n顔を覆う。","明明觉得声音恢复了几分，\n冬夏却突然语塞，\n用手捂住脸。"],["「……うん。[l]\n分かった……」","「……嗯。[l]\n明白了……」"],["どういう返事になるかは……正直わからないけど……","会得到怎样的回应……老实说完全没底……"],["僕にはすべきこともあるし……","但我也有必须做的事……"],["それがきみとぼくにとってどういうことになるのか……","这对你和我究竟意味着什么……"],["それすらもわからないが──","甚至连这点都还不清楚——"],["と、再び枕に倒れ込む冬夏。","说着，冬夏又倒回枕头上。"],["「ありがと……[l]\n一方的でごめん、でもすき……だよまことさん……","「谢谢你……[l]\n这么任性对不起，但是喜欢……真言先生……"],["すぅー……[l]\n…………[l]\nすぅーー……」","呼——……[l]\n…………[l]\n呼————……」"],["「んあ？[l]\nもしもし？[l]\nおいっ、寝なさんなよ？！」","「嗯啊？[l]\n喂喂？[l]\n喂、别睡啦？！」"],["「え、……[l]\n──。","「诶、……[l]\n──。"],["寝、たの？[l]\n……本気で？[l]\n冬夏…？","睡、着了？[l]\n……认真的？[l]\n冬夏…？"],["うそん、\nおい、ちょっと待て、\n……嘘だよな？","骗人的、\n喂、等一下、\n……是假的吧？"],["ドッキリでしょ？[l]\n………。[l]\n──本気で寝ちゃった、のか？」","整人节目对吧？[l]\n………。[l]\n──真就睡着了、啊？」"],["……そ、それはどうなの。","……这、这算啥啊。"],["やっぱそうなるんですカ？[l]\nちょっとそれはいっくらなんでも、","果然会变成这样吗？[l]\n再怎么说这也太、"],["「冬夏？[l]\nとうかさん？[l]\n………」","「冬夏？[l]\n冬夏小姐？[l]\n………」"],["お、起きないっすよまじで。","完、完全叫不醒啊真的。"],["と、とにかくだ、\n言うだけ言って一人だけそれはどうだ！？[l]\nと、幾ら僕でも思いますよ？[l]\nそれにアナタ、","总、总之先，\n光放完狠话就自己一个人开溜这算哪样！？[l]\n这、这种事连我也会在意的好吗？[l]\n而且你啊，"],["「……終わったら帰るって言ったよねえ？[l]\n明日学校だったよねえ？」","「……不是说好结束就回家的吗？[l]\n明天还要上学对吧？」"],["……マジ起きねえ！！","……完全醒不过来了！！"],["不安的中にゃーーー！！！","不祥预感成真喵————！！！"],["にしても、はうあ、どうすべえか、\n宮さんに相談……したら藪蛇？[l]\n否、しない方が、より大きな問題になる気がする！","话虽如此，哈呜啊，该怎么办呢，\n找宫小姐商量……会不会弄巧成拙？[l]\n不、不这么做的话感觉会引发更严重的问题！"],["冬夏には申し訳ないけども、\nコクハクより……いやそれは言い過ぎですね、[l]\n同じくらい僕にとって深刻な問題だ。","虽然对冬夏很过意不去，\n但比起告白……啊这么说可能有点过分，[l]\n对我来说是同等严重的问题。"],["ええとええと、と、\n冬夏が起きてたときより遙かに混乱し慌てふためいて、\n取り敢えず布団から這い出て、\nそ～っと部屋を出ようとした瞬間、","那个那个、呃，\n比冬夏醒着时还要混乱手足无措，\n总之先慌慌张张爬出被窝，\n蹑～手蹑脚正要溜出房间的瞬间，"],["「！！！！！！！！！！」",""],["電話が掛かってきた。","电话突然响了起来。"]],"context":[["SC_M_033.ks/index/1/text"],["SC_M_033.ks/index/3/text"],["SC_M_033.ks/index/5/text"],["SC_M_033.ks/index/7/text"],["SC_M_033.ks/index/9/text"],["SC_M_033.ks/index/11/text"],["SC_M_033.ks/index/13/text"],["SC_M_033.ks/index/15/text"],["SC_M_033.ks/index/17/text"],["SC_M_033.ks/index/19/text"],["SC_M_033.ks/index/21/text"],["SC_M_033.ks/index/23/text"],["SC_M_033.ks/index/25/t