0,"end":2347}],[{"start":2356,"end":2357}],[{"start":2367,"end":2435}],[{"start":2443,"end":2478}],[{"start":2488,"end":2517}],[{"start":2526,"end":2529}],[{"start":2561,"end":2586}],[{"start":2612,"end":2670}],[{"start":2678,"end":2764}],[{"start":2772,"end":2813}],[{"start":2845,"end":2856}],[{"start":2882,"end":2905}],[{"start":2937,"end":2942},{"start":6469,"end":6474}],[{"start":2968,"end":2974}],[{"start":2992,"end":3275}],[{"start":3283,"end":3404}],[{"start":3449,"end":3458}],[{"start":3484,"end":3528}],[{"start":3536,"end":3556}],[{"start":3564,"end":3613}],[{"start":3621,"end":3686}],[{"start":3718,"end":3767}],[{"start":3793,"end":3817}],[{"start":3849,"end":3894}],[{"start":3920,"end":3961}],[{"start":3969,"end":3981}],[{"start":3989,"end":4008}],[{"start":4016,"end":4031}],[{"start":4039,"end":4051}],[{"start":4083,"end":4128}],[{"start":4154,"end":4209}],[{"start":4217,"end":4290}],[{"start":4298,"end":4363}],[{"start":4371,"end":4431}],[{"start":4439,"end":4502}],[{"start":4510,"end":4567}],[{"start":4575,"end":4618}],[{"start":4626,"end":4629}],[{"start":4637,"end":4756}],[{"start":4764,"end":4813}],[{"start":4845,"end":4860}],[{"start":4892,"end":4954}],[{"start":4980,"end":5022}],[{"start":5054,"end":5059}],[{"start":5085,"end":5110}],[{"start":5142,"end":5189}],[{"start":5215,"end":5236}],[{"start":5244,"end":5277}],[{"start":5285,"end":5295}],[{"start":5327,"end":5348}],[{"start":5374,"end":5396}],[{"start":5404,"end":5492}],[{"start":5500,"end":5552}],[{"start":5560,"end":5568}],[{"start":5574,"end":5609}],[{"start":5621,"end":5706}],[{"start":5714,"end":5802}],[{"start":5810,"end":5877}],[{"start":5885,"end":5890}],[{"start":5898,"end":5902}],[{"start":5910,"end":5985}],[{"start":5993,"end":6006}],[{"start":6014,"end":6030}],[{"start":6040,"end":6041}],[{"start":6050,"end":6051}],[{"start":6061,"end":6062}],[{"start":6071,"end":6114}],[{"start":6122,"end":6134}],[{"start":6142,"end":6154}],[{"start":6162,"end":6174}],[{"start":6206,"end":6221}],[{"start":6247,"end":6311}],[{"start":6343,"end":6357}],[{"start":6383,"end":6437}],[{"start":6500,"end":6547}],[{"start":6555,"end":6621}],[{"start":6629,"end":6675}],[{"start":6707,"end":6726}],[{"start":6752,"end":6812}],[{"start":6820,"end":6863}],[{"start":6871,"end":6879}],[{"start":6911,"end":6932}],[{"start":6958,"end":6968}],[{"start":6976,"end":7037}],[{"start":7045,"end":7061}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_041.ks","basename":"SC_M_041.ks","indexIds":{"めざめると僕は布団の中であった。":0,"「……おや？」":1,"一瞬混乱し、直後急激に覚醒する。":2,"「あ！！」":3,"半身起こすと、\n頭の方は割合大丈夫そうなものの、\n口の中がカラッカラで、\n若干の":4,"怠さと空腹に見舞われた。":5,"「ええとそうか、\nあのまま……」":6,"物凄くあやふやな記憶だが、\nあくまでスタッフとしての対応、と言った風の知狡さんと、\nそして冬夏に部屋まで連れて行かれた僕は、\n薬を貰い、早々に布団に入った、らしい。":7,"知狡さんも冬夏もえらく周章してたような、\nいや気丈だったような、":8,"ただ、宮さんの姿を視た覚えがないのが、":9,"何というか、\n前例があるだけにこう、予想外されるとあれっ？と思う訳で、[l]\n冬夏にも、倒れる寸前に、\n宮さんに伝えて欲しいと言ってしまってた事もあり、":10,"何で居ない？":11,"という理不尽な──宮さんに、というよりそんな思考をする自分自身に──\n怒りめいた負の感情を抱いてしまい。":12,"ああもう困惑するばかりだ。":13,"困惑するばかりだ……":14,"何で居ないん──ですか。":15,"「……何考えてるんだ僕は」":16,"無性に、……いや、そんな筈は、無い。":17,"え、ええとそして、\nあとはもう、\n薬の所為もあるだろうけれど速攻寝入ったらしく、\nその後の記憶はごっそり抜けてる。":18,"その間、若しかしたら、\n宮さん……とか、冬夏も見舞いに来てたのかも知れないが、[l]\n当然の如く全く記憶にない。":19,"夢は──視てたような気もするけど……[l]\n今回はその":20,"夢":21,"現の混濁具合がいつにも増して顕著で、\n混淆としたそれが果たして夢なのか、過去の記憶が染み出してきてるのか、\n良い具合に混ざってしまったものなのか、\nどうにも──":22,"「あれっ。[l]\n何時？何時だ今？[l]\n帰ったのが夕方で……」":23,"今は──夜？朝？昼？":24,"「外は……暗い……[l]\n少なくとも真昼じゃない……」":25,"が、雨天か夜明け前という事もあり得る。":26,"携帯電話は枕元にあったので慌てて手に取り確認、すると……":27,"「１７時３２分、４月１５日、土よ……土曜日！？」":28,"土曜の午後５時半過ぎ？！？":29,"え、およそ１日跳んでる計算！？？":30,"そう思った瞬間、急激に空腹を自覚！":31,"やばい、すげえはらへってる！！":32,"「こ、これはなにか、どうしよう、\nフロント……に何て言えば？[l]\nいや、その前に目覚めた事を伝えねば！":33,"……誰に？[l]\n宮さん、知狡さん、……冬夏、[l]\nあ、あと着信とかチェックしにゃ、\nえーと何から手を付けたらいいのやら！！」":34,"体調の方は幸いにも復調してるぽいのだが、\nなにぶんこの有様、盛大に脳が空転しています。":35,"あわあわしてると、":36,"「おや」":37,"部屋の卓の上に、\n置き手紙と、バナナ、コップ、\n炊飯ジャーを始めとする茶漬けセット一式が。":38,"布団を出て立ち上がると、流石に":39,"怠くてクラクラしたが、\n何とかそこまで歩み寄る。":40,"置き手紙を手に取ると、":41,"「知狡さん……？[l]\nじゃないな」":42,"下の方に冬夏の署名がある。":43,"起きたら無理せず胃に良いものをゆっくり食す事、\n必要なら冷蔵庫に牛乳が入ってるので適度にぬるくしてから飲む事、\nそしてすぐに連絡する事、\n等々が書いてあった。":44,"事実これが胃に良いラインナップなのかは、\n僕も":45,"寡":46,"聞にして知らないが、\n少なくともオニギリとかよりは喰える気がする。[l]\nまあ、駄目なら駄目で、今は兎に角何か喰いたい。":47,"早速冷蔵庫から紙パックの牛乳を取り出し、\nコップに注いで適温に":48,"温まるのを待ってから、\n床に座り込んでバナナの皮を":49,"剥く。":50,"「……ぅあ～～～、[l]\n超美味ぇ～～～」":51,"空腹は最高の調味料とは言うけれど、\nあれも時と場合によっては大変失礼な言葉になるので\n注意が必要だ。":52,"実体験から言わせて貰えば、\n真に不味いモノはどんなに腹減ってても不味いんだけどね！[l]\n美味いモノを満腹時に食すると、そんなにでもない、という事はあるが。":53,"ともあれあまり急に食さぬよう気をつけながら、\nもう１本、房からもいでると、":54,"「あれ、もう１枚ある」":55,"冬夏の置き手紙の下に別のがある事に今気付いた。":56,"「………」":57,"宮さんから。":58,"@r@rここんとこ色々相手出来なくてごめんね。[l]\n今回のことは吃驚したけど、まこくんならきっとだいじょぶです！[l]\n無事復活すると信じてます。[l]\n冬夏さんから話は少し聞いたけど、\nちょっとつかれてたのかな。[l]\n上司として健康管理、監督不行届でしたね。[l]\n前回の時とは違ってるみたいだから、\nしっかり休養してください。[l]\n元気になったらまた一緒にアソビましょう！[l]\nあと２週間、がんばってくださいな。[l]\nうひひ、アノ話も聞かなきゃですしね（☆ω☆）♪":59,"@r@r取り敢えず、起きた時の事は、冬夏さんの別紙を参照の事。[l]\n旅館の女将さんにも御礼言っといてください。[l]\n@rではでは。[l]\n（＝ω＝）ﾉｼ[l]\n@r追伸：携帯のメールをみよ！":60,"「……なんだこれ」":61,"携帯のメール……は、[l]\n恐らく前もあったアレな写メか何かだろうので後回しだ。":62,"えーと？[l]\n何だアノ話って。":63,"まさか冬夏の一件……じゃないか、[l]\nあれだ、多分仕事で聞きたい事あるって言ってた奴か。":64,"全然話す機会が無かったし、\nちゃんと喚んでくれるって話だったもんな。[l]\n良かった良かった覚えててくれたようだ。":65,"「はいはい、\n行きますよ、行きますってばさ。[l]\n何をおいても僕は貴女の為に、」":66,"僕は、貴女の為なら、あなたのためなら、みやさん。":67,"「あれ？[l]\n涙が出てくるな。[l]\nあれ？[l]\nなんでだ？」":68,"悲しいわけじゃない、\n寧ろ、\n激しく狂おしい程の、\n歓喜？":69,"久々に物食べたからかな。":70,"こういうのって遅れて来るって言うしな。":71,"うん、\nたぶんそうだ。":72,"それ以外に考えられへん。":73,"「まずは──宮さんに連絡するか。で、冬夏に。[l]\n……うん、茶漬け喰ってからで」":74,"そうだ、\n文面視る限り、知狡さんにも心配かけたようだし、\nタイミング視計らって挨拶しに行こう。":75,"メールにしろ電話にしろ、\nまだまともな文面を構築出来る頭の状態じゃないので、\n食事後数分をみて、落ち着いてから行動することにする。":76,"ロジカル思考を走らせるのは兎も角、\n気分的には物凄くすっきりしてるから、\n風邪だったとしてもほぼ完治したと思うが、":77,"無理しない程度に活動再開する為、\n一応マスクでも着用しようかね……[l]\nチノ嬢とかぶるのは致し方ない。":78,"別にかぶるかぶらないでするものでもなし。[l]\n何しろ予定通りに祭が行われるならば、\nあと２週間ほどしかない。":79,"本当なら、\n座して待つ、というのが当初の目的には沿ってる気がするけど、\n宮さんの方針転換もあるし、":80,"どうにもこうにも、\nその、\n向こうからのアプローチが立て続けにあるし、":81,"ああ、":82,"冬夏の誕生日、成り行きとは言え返事もすると約束してしまった以上、\nその件も考えねばならない、だろうなあ……[l]\nもし僕が此処での仕事を終えたら、２度と彼女等とかかずらう事がなくなるとしても、\n無視して放置なんて、":83,"少しでも感情移入してしまったら、\nヒトとして生きるならそういうのは大事にしていきたいし──":84,"───トガネ─ノヨウニミ───":85,"「そんな煩悶も何処吹く風に、\nああ、とにかくうんまいなー飯が。[l]\n食事ってこんなにも幸せなのだなあ……」":86,"──食べるってこう、根源的ていうの？[l]\n生きるのに基本的なものじゃない？":87,"「あぃ？」":88,"ああ、冬夏が言ってたな今朝……じゃない、昨日の朝。":89,"「こうして食の有り難みを実感すると、\nきぃの気持ちが何となく解るような気がするのう…」":90,"喰う為に生きてるのか生きるために喰うのか、":91,"──ヒトの考えた理屈に、セカイの全てが当て嵌まる訳じゃないから──":92,"考えるだけ無意味か。":93,"「……どうも、脳が空転してるというか……」":94,"思考が複数同時に平行処理されてる気がする……":95,"今までの僕の脳スペックからすると奇跡の様な所業だな。[l]\n気のせい、或いは、復調した事による一時的なオーバークロック？[l]\n否、この感じはもう少し前から──":96,"うーん、\n確かにこれ以前に、\n過去記憶らしい映像の頻出やらヘンなものが視えだしたりとか、":97,"日が経つにつれ、":98,"@r──Ig──飯窪の─子にのみ──promptとし──\n@r":99,"何か、何か事態が起こるというか、\nえ、ええと、三春の女子達との接触率の高さもそうだが、\n玄ノ森という土地に何かそういうのを誘起させるモノがあるのだろうか。":100,"昔滞在していた土地への帰還が、\n意識下で影響を及ぼしてるのかも知れぬ。[l]\nああ、本家の家宝？[l]\nあれに接触してからと言えば、そうな気もするなあ。":101,"うええ、祟りとかじゃないだろうな。[l]\n或いは眠っていた大昔のウィルスとの接触とか……[l]\n──いやいやいやいや。":102,"ミ…さん。":103,"宮さん。":104,"宮さんが単に僕の人生引っ掻き回してるんだと思うよ。[l]\nその疲弊が回り回ってこう、\n体と精神の変調として顕れてきたんでしょうきっと。":105,"あのひとに出逢ってから……":106,"最近浮かぶ、過去記憶らしき情景の":107,"真":108,"偽":109,"如":110,"何では、\n果たしてあのひととの初対面て一体いつなのよ、という問題があるけれど、":111,"──しの──になる？──":112,"──の為に──て欲し──":113,"──わすれるな。シを──":114,"「牛乳でもおかわりするか……」":115,"パックを出しっぱなしにしてたので、\nもう格別冷えてる事も無いだろと、\nコップに注ぐとそのままぐびっと行きますよ。":116,"「なんとかしないとなあ……」":117,"具体的に何に対してとか、\nそういう事は考えてないのだけれど、\n何となく口に出して言ってみる。":118,"何となく落ち着いた。[l]\nカルシウム効果？[l]\nあれってほんとなのかな……":119,"そうしてようよう安定してくると、\n改めて今日の事が悔やまれるというか、\n丸１日無為に過ごしてしまった感に襲われるが、":120,"どうせ昨日も休養日の筈だったので、\n１日遅れでそうなったと思えば多少慰めにもなろう。":121,"「さて、じゃあそろそろ連絡を……あ？」":122,"日時確認の時に気付かなかったとは余程テンパってたのか、\nよくよく視ると携帯にはメール、通話、両方の着信があった。":123,"メール……は、矢張り宮さんからだが、[l]\n何か件名に冬夏の名前も書いてる＜？":124,"で、通話の方は、":125,"「奇士……[l]\n道具さんか、あ」":126,"もしかして祭の件か？":127,"まずもって宮さんに連絡したいのはやまやまだったが、\nもし祭決定の連絡であれば先に知っておいた方が都合が良いだろう。":128,"道具さんの電話にリダイアルした。":129},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_041.ks","relPath":"/data/scenario/SC_M_041.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":129,"length":130,"percent":99.23076923076923},"cellInfo":[null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[33,1]},"/data/scenario/SC_M_042.ks":{"data":[["呼び出し音が数回鳴った後、\n道具さんが電話に出た。","呼叫音响了几声后\n道具小姐接起了电话"],["「もしもし、あの、」","「喂、那个」"],["「ああ、少年？[l]\n冬夏君から色々聞いてるよ。[l]\nキミに電話した時はまだ事情を伺って無くてね。[l]\nもう復調したのかな？」","「啊、少年？[l]\n我从冬夏君那里听说了不少哦[l]\n之前给你打电话时还不了解情况[l]\n已经恢复了吗？」"],["「御陰様で、何とか大丈夫なようです。[l]\n済みません」","「托您的福，总算没什么大碍了。[l]\n实在抱歉」"],["「ははは、\n謝ることはない。[l]\n寧ろ先日手伝って貰った事が遠因かも知れないし、\nならばこちらこそ謝らねばならないな」","「哈哈哈，\n不必道歉。[l]\n倒不如说前些日子让你帮忙的事可能是远因，\n这样的话反倒该我道歉才是」"],["いえいえ別に、多分原因はそれと違いますし、と大袈裟に否定して、\n僕は電話の意を問うた。","不不没关系的，大概原因不是那个啦，我夸张地否定着，\n转而询问电话的来意。"],["「ふむ。[l]\nさて、どこから説明したものか……[l]\nそうだな、まず結論から言おう。","「嗯。[l]\n该从哪儿说起呢……[l]\n对了，先说结论吧。"],["件の祭だがね、\n──シキの執行が決定した。[l]\n無駄足にならずにすんだね。[l]\n御目出度う」","关于那个祭典啊，\n──决定执行'式'了。[l]\n总算没白跑一趟呢。[l]\n恭喜」"],["「シキ…？あ、[l]\n祭ですか、\nはあ、やることに。[l]\n成る程成る程」","「式…？啊，[l]\n是祭典对吧，\n哈，要办了啊。[l]\n原来如此原来如此」"],["矢張りその件だったか。","果然是为了那件事。"],["「それで、\nその理由の方を説明しよう。[l]\n先日の謎の生物の襲来、\n憶えているかね？」","「那么，\n我来解释下原因吧。[l]\n前些天神秘生物的袭击，\n还记得吗？」"],["「あの、\nスナトノホウシの手伝いの時、\n車に落っこちてきたあれですか？[l]\n姫様ちゃんと狩屋が追っかけてった」","「那个，\n在帮忙处理垃圾的时候，\n从车上掉下来的那个吗？[l]\n姫様和狩屋追过去了」"],["「そう、よく憶えていたね。[l]\nあれが解決したからなのだが","「对，记得很清楚嘛。[l]\n因为那件事已经解决了"],["巨大な熊だったようだよ","似乎是头巨大的熊"],["先日のも其奴による事故","前些天的也是那家伙引发的事故"],["つまり、人為的な理由である『事件』ではなく、\nあくまで『事故』による、\nそう、死亡事故だった、という事に落ち着いた。[l]\nその原因たる害獣もシガイという証拠によって","也就是说，并非人为原因的『事件』，\n纯粹是『事故』导致的，\n最后定性为死亡事故。[l]\n作为元凶的害兽也有目击证据"],["祭を執行するに障害はない、という結論にまとまった。","结论是执行祭典没有障碍。"],["そうだ、死骸も上がってるが視に来るかい？」","对了，尸体也找到了要来看看吗？」"],["「え、いえ、いいです……[l]\nそういうのには興味無いですし、その──」","「诶、不、不用了……[l]\n我对那种东西没兴趣，而且那个──」"],["て、熊って木から落ちるもの？","话说熊会从树上掉下来吗？"],["それにその、\nヒトをあれする程の熊が車の屋根に落ちて、\nそれで……即座に消えたり……？[l]\nそんなばかな……","还有那个，\n能把人弄成那样的熊掉到车顶上，\n然后……立刻就消失了……？[l]\n太荒唐了……"],["欺瞞、嘘……なのか？[l]\nいや、しかしそんなことをする意味が──\n祭を執行する為にしても、\n……あ、","是欺骗、谎言……吗？[l]\n不，但这样做有什么意义──\n就算是为了执行祭典，\n……啊，"],["そうか、\nあの場に居なければ、\n当然それは知られる所ではない、\nつまり、","原来如此，\n如果不在现场的话，\n自然不会有人知道，\n也就是说，"],["まて。","等等。"],["だとしても、\n寧ろ逆に、\n何故『現場に立ち会った僕』にそれを言うんだ。","即便如此，\n倒不如说反过来，\n为什么要把这事告诉『当时在场的我』。"],["それとも、\nほんとうにほんとうのことだというのか？","还是说，\n这真的是千真万确的事？"],["しかし僕のそんな疑惑の念は、\n電話先には別の意味の沈黙として受け取られたようだった。","但我这番疑虑，\n似乎被电话那头当成了另一种意味的沉默。"],["「ふふふ、\nそういう出歯亀根性の欠如は大変に好ましい。[l]\n好奇心猫を殺すと言うしね、\n自発的能動的に独立独歩で愉悦を求める事が肝要なのだよ。","「呼呼呼，\n这种缺乏偷窥癖的性格实在令人欣赏。[l]\n俗话说好奇心害死猫，\n关键在于能自发主动地独立寻求愉悦啊。"],["単に秘されたモノを覗きたいだけでは、\n外部刺激に対してしか反応出来ない不能、\n言われたことしかできない能無しと一緒だからね。[l]\n他者に興味を持つのも節度が必要だ。","若仅仅想窥探被隐藏之物，\n那与只能对外界刺激产生反应的废物、\n只会听令行事的无能之辈毫无区别。[l]\n对他人的兴趣也需要节制。"],["須く過去は消せないし、\nそういった、自他を相対化して、相対的でしかない優越感を\n得る他諸々といった低俗な事はま…僕や少年のすることではないのだ。","毕竟过去无法抹消，\n像那种通过主客对比来获取\n相对优越感之类的低俗行径…可不是我和少年该做的事。"],["だから、そうだね、\n他人とあそぶのも節度を持ったコミュニケーションとしては良いが、\n自己処理（スタンドアローン）でも閉じて完結していないと、\n蒐集を旨とする遊戯としては手落ちも好い所だよ。","所以呢，\n与他人游戏时保持克制的交流固然不错，\n但若不能自我处理（单机模式）并闭环完成，\n作为以收集为宗旨的游戏终究是有缺陷的。"],["他者を","那种从设计阶段就"],["端から組み込んだ設計思想なんぞ話にならない、\nそれこそ蔑むべきＰの思想、くだらないね。","把他人纳入考量的理念根本不值一提，\n正是该唾弃的P思想，无聊透顶。"],["や、まあそれは言い過ぎかな。[l]\n遊戯の種類にもよるか。[l]\nプラットフォームの事情もあるしなあ。","啊呀，或许我说得过火了。[l]\n也要看游戏类型嘛。[l]\n平台特性也得考虑呢。"],["いやまて、遊戯の定義から……[l]\nああ、悪い、ともあれ僕が言いたい事は。[l]\n自分で考えろ。考えろ。考えろ。[l]\nそれが成長の鍵だな」","等等不对，从游戏定义来说……[l]\n啊抱歉，总之我想说的是：[l]\n自己思考。思考。思考。[l]\n这才是成长的关键」"],["……色々ツッコミどころは満載なんですけど、[l]\nまずその、ピーの思想って何でしょう？","……槽点多得简直要溢出来了，[l]\n首先那个P思想到底是什么？」"],["「ええとご高説賜れるのは大変有り難いのですが、\n何の話でしたっけ……」","「呃虽然聆听高见十分荣幸，\n但刚才说到哪儿来着……」"],["「ああ、すまないね。[l]\n少年と話すのは愉しくてね。[l]\nついカタってしまうのだよ。","「啊，抱歉抱歉。[l]\n和少年聊天太愉快了。[l]\n不小心就滔滔不绝啦。"],["まあ、少年、君は非常にイイという事だ。[l]\nあとは祭の施行が決定されて君の道程は徒労に終わらずに済んだ、\nという事かな。[l]\nうん、そうだね」","总之少年，你非常不错。[l]\n再加上祭典确定举办，你的努力总算没有白费，\n就是这么回事吧。[l]\n嗯，没错」"],["前半は何か違う気がするけども、\n要するに、祭は強行されるという、\n前情報通りになった訳だ。","虽然前半段感觉不太对劲，\n但简而言之，祭典将强行举办，\n和之前的情报一致了。"],["道具さんの物言いからして、\nどうも『裏があるけども語らないよ』という空気がすごいするんだが。[l]\n会話の脇道に逸れたのも、恣意的な誤魔化しかも知れず、","从道具小姐的措辞来看，\n总觉得散发着『另有隐情但我不说』的气息。[l]\n那些偏离主题的对话也可能是刻意糊弄，"],["ただ、\n道具さんだからなあ……","不过，\n毕竟是道具小姐啊……"],["冬夏の言もあるし何とも判断つきかねる所ではあるが、\n祭の施行の決定自体は、僕等にとって突飛な結果ではないし、\n本当と思って良いだろう。","加上冬夏的说辞，实在难以判断，\n但祭典确定举办这件事，对我们来说并非意外结果，\n应该可以当真。"],["「兎に角、良かったですね。[l]\nああ、あの、亡くなった方々にはその、あれですけど……」","「总之太好了呢。[l]\n啊，那个，对于逝者们虽然有点那个……」"],["「ん？[l]\nああ、そうだな。[l]\n少年は気にする事は無いよ。[l]\n決定した以上、存分に祭を愉しんで呉れ給え。","「嗯？[l]\n啊，说得对。[l]\n少年不必在意。[l]\n既然已决定，就尽情享受祭典吧。"],["ふむ、\n僕等は執行側の人間なんでね、\n本来ならば少年を是非案内して回りたい所だが。","唔，\n我们毕竟是执行方的人，\n本来很想带少年好好参观的。"],["──西石君も、体調やら仕事の事情でね、\n期間中は自由時間を作るのは難儀なようだし」","──但西石君因身体和工作缘故，\n期间恐怕很难腾出自由时间」"],["「ああ、前に本人がそんな事言ってた様な言ってない様な……[l]\nいや、彼奴にも道具さん達にも無理はさせられないし、\nお心遣いだけありあがたく頂いておきます」","「啊，之前他本人好像说过又好像没说过……[l]\n不过也不能勉强那家伙和道具小姐你们，\n这份心意我就心怀感激地收下了」"],["というか、\n色々やらねばならないことが、\nまさに後ろめたいことだけど……","话说回来，\n还有不少必须处理的事情，\n虽然都是些见不得光的事……"],["「そうかい？[l]\nまあ少年はこの祭が終わったらどうするのか──\nそれは聞かないでおこう。","「这样啊？[l]\n嘛少年你祭典结束后要怎么办──\n这个还是别问了。"],["その先に待つのが、\n──」","在那前方等待着的，\n──」"],["──。",""],["あれ？","嗯？"],["聞こえない。","听不见了。"],["電波途切れた？","信号中断了？"],["「もしもし？[l]\nあれ？[l]\n切れました？」","「喂喂？[l]\n咦？[l]\n断线了？」"],["「願わくばこれからも互いに愉しい関係でありたいものだよ。[l]\n折角こうやってこの場所この時代で邂逅出来たのだからね。","「但愿今后我们也能保持愉快的关系。[l]\n难得能在这个地方这个时代相遇啊。"],["袖振り合うも多生の縁、縁は異なもの味なもの……[l]\nでは、お身体","萍水相逢也是前世之缘，缘分真是奇妙的东西……[l]\n那么，请保重"],["呉","吴"],["呉も自重自愛を祈るよ。","吴某也愿你珍重自爱。"],["じゃ。[l]\n冬夏君に宜しく」","再见。[l]\n代我向冬夏君问好」"],["「え？[l]\nあ、あの」","「诶？[l]\n啊、那个」"],["聞こえなかったんですが、と言う間もなく、\nまた一方的に通話は終了された。","还没说完\"听不清楚\"，\n通话又被单方面切断了。"],["道具さんも姫様ちゃんも、\n何気にこっちの話聞かずに電話切るよなあ。","道具小姐和姫様酱，\n都会若无其事地不听人说完就挂电话呢。"],["それともそれが普通？","或者说这才是常态？"],["知人が少ない僕にとっては比較対象が居ないので\n判断つきかねるが、\nもう少しひとの話聞いてくれてもいいんでないの……？[l]\nと思い独り呻いた。","对于交际圈狭窄的我来说缺乏比较对象\n实在难以判断，\n再多听人说几句话会怎样啊……？[l]\n如此自言自语地嘟囔着。"],["おっと、忘れてた。","啊糟，忘了。"],["新たな情報も得た事だし、\n宮さんに連絡しないと。","既然获得了新情报，\n得联系宫小姐才行。"],["覚醒してから既に結構な時間が経ってしまった。[l]\nいつもなら夕飯時になるし、\nタイミングあえば一緒にご飯でも食べられるかな。","觉醒后已经过了相当长时间。[l]\n平常这个点都该吃晚饭了，\n时机合适说不定还能一起用餐。"],["部屋に移動するのも難儀だったので、\n電話をしようとして、\n再び思い出す。","回房间太麻烦，\n正想打电话时，\n突然想起来。"],["「メール……チェックせねばか……」","「邮件……必须查看才行……」"],["なんだろうなあ今回は。","这次又会是什么啊。"],["「うあ」","「呜哇」"],["まず眼に入ったものが予想とあまりに違っていたので、","首先映入眼帘的内容与预期相差太远，"],["と、と、と、","这、这、这、"],["「冬夏？！と一緒て！！[l]\n何してんの！！[l]\nてか何でこんな衣装まで？？！！[l]\n……げほっ、げほげほ」","「冬夏？！为什么和你在一起！！[l]\n在搞什么啊！！[l]\n话说为什么连这种服装都？？！！[l]\n……咳咳、咳咳咳」"],["あああこんなものは教育的指導ですよ、\n宮さんたら何してるのよ……[l]\nけしからん！！[l]\nしかもこれ撮影者が他に居るよな？","啊啊这绝对是教育指导事故，\n宫小姐你究竟在干嘛……[l]\n太不像话了！！[l]\n而且拍摄者另有其人吧？"],["チノ嬢か知狡さん……？[l]\n知狡さんは真面目さがどっちに転ぶかでやり兼ねないが、\n順当に考えてチノ嬢だろうな……","千乃小姐还是知狡阿姨……？[l]\n知狡阿姨那种严肃性格可能做出任何事，\n但按常理推断应该是千乃小姐……"],["ややや、何にしてもだ、","等等等等，不管怎么说，"],["「これは……消去……いや、[l]\n待ち受けにしてなきゃ別に構わないか、\n下手に消すと宮さんだけじゃなくて冬夏にまでその」","「这个……删除……不对，[l]\n只要不设成待机画面就没事吧，\n贸然删除的话不仅宫小姐连冬夏也会」"],["……部屋で独り大慌てしてる事に気付き、冷静になる。","……察觉到自己正在房间里手忙脚乱，强迫自己冷静下来。"],["「取り敢えず２度と開かないと言うことで、\nあとは触れない事にします……凍結凍結」","「总之发誓再也不打开看，\n之后绝对不碰了……冻结冻结」"],["一体、消去された前回のやつってどんな……[l]\nいや、そんなことはどうでもいい。","话说上次被删除的内容到底是……[l]\n不，这种事怎样都无所谓。"],["「兎も角電話だ」","「当务之急是打电话」"],["気を落ち着けると、\n部屋で独り姿勢を正し、宮さんに電話をかけた。","定了定神，\n在房间里独自端正姿势，给宫小姐打了电话。"]],"context":[["SC_M_042.ks/index/1/text"],["SC_M_042.ks/index/3/text"],["SC_M_042.ks/index/5/text"],["SC_M_042.ks/index/7/text"],["SC_M_042.ks/index/9/text"],["SC_M_042.ks/index/11/text"],["SC_M_042.ks/index/13/text"],["SC_M_042.ks/index/15/text"],["SC_M_042.ks/index/17/text"],["SC_M_042.ks/index/19/text"],["SC_M_042.ks/index/21/text"],["SC_M_042.ks/index/23/text"],["SC_M_042.ks/index/25/text"],["SC_M_042.ks/index/27/text"],["SC_M_042.ks/index/29/text"],["SC_M_042.ks/index/31/text"],["SC_M_042.ks/index/33/text"],["SC_M_042.ks/index/35/text"],["SC_M_042.ks/index/37/text"],["SC_M_042.ks/index/39/text"],["SC_M_042.ks/index/41/text"],["SC_M_042.ks/index/43/text"],["SC_M_042.ks/index/45/text"],["SC_M_042.ks/index/47/text"],["SC_M_042.ks/index/49/text"],["SC_M_042.ks/index/51/text"],["SC_M_042.ks/index/53/text"],["SC_M_042.ks/index/55/text"],["SC_M_042.ks/index/57/text"],["SC_M_042.ks/index/59/text"],["SC_M_042.ks/index/61/text"],["SC_M_042.ks/index/63/text"],["SC_M_042.ks/index/65/text"],["SC_M_042.ks/index/67/text"],["SC_M_042.ks/index/69/text"],["SC_M_042.ks/index/71/text"],["SC_M_042.ks/index/73/text"],["SC_M_042.ks/index/75/text"],["SC_M_042.ks/index/77/text"],["SC_M_042.ks/index/79/text"],["SC_M_042.ks/index/81/text"],["SC_M_042.ks/index/83/text"],["SC_M_042.ks/index/85/text"],["SC_M_042.ks/index/87/text"],["SC_M_042.ks/index/89/text"],["SC_M_042.ks/index/91/text"],["SC_M_042.ks/index/93/text"],["SC_M_042.ks/index/95/text"],["SC_M_042.ks/index/97/text"],["SC_M_042.ks/index/99/text"],["SC_M_042.ks/index/101/text"],["SC_M_042.ks/index/103/text"],["SC_M_042.ks/index/105/text"],["SC_M_042.ks/index/107/text"],["SC_M_042.ks/index/109/text"],["SC_M_042.ks/index/111/text"],["SC_M_042.ks/index/113/text"],["SC_M_042.ks/index/115/text"],["SC_M_042.ks/index/117/text"],["SC_M_042.ks/index/119/text"],["SC_M_042.ks/index/121/text"],["SC_M_042.ks/index/123/text"],["SC_M_042.ks/index/125/text"],["SC_M_042.ks/index/127/text"],["SC_M_042.ks/index/129/text"],["SC_M_042.ks/index/131/text"],["SC_M_042.ks/index/133/text"],["SC_M_042.ks/index/135/text"],["SC_M_042.ks/index/137/text"],["SC_M_042.ks/index/139/text"],["SC_M_042.ks/index/141/text"],["SC_M_042.ks/index/143/text"],["SC_M_042.ks/index/145/text"],["SC_M_042.ks/index/147/text"],["SC_M_042.ks/index/149/text"],["SC_M_042.ks/index/151/text"],["SC_M_042.ks/index/153/text"],["SC_M_042.ks/index/155/text"],["SC_M_042.ks/index/157/text"],["SC_M_042.ks/index/159/text"],["SC_M_042.ks/index/161/text"],["SC_M_042.ks/index/163/text"],["SC_M_042.ks/index/165/text"],["SC_M_042.ks/index/167/text"],["SC_M_042.ks/index/169/text"]],"tags":[],"parameters":[[{"start":153,"end":182}],[{"start":214,"end":224}],[{"start":256,"end":333}],[{"start":365,"end":397}],[{"start":429,"end":501}],[{"start":527,"end":574}],[{"start":606,"end":657}],[{"start":665,"end":725}],[{"start":757,"end":806}],[{"start":832,"end":843}],[{"start":875,"end":931}],[{"start":963,"end":1031}],[{"start":1063,"end":1097}],[{"start":1105,"end":1116}],[{"start":1124,"end":1135}],[{"start":1143,"end":1240}],[{"start":1248,"end":1273}],[{"start":1281,"end":1302}],[{"start":1334,"end":1374}],[{"start":1400,"end":1414}],[{"start":1422,"end":1489}],[{"start":1497,"end":1560}],[{"start":1568,"end":1616}],[{"start":1624,"end":1627}],[{"start":1635,"end":1678}],[{"start":1686,"end":1715}],[{"start":1723,"end":1769}],[{"start":1801,"end":1885}],[{"start":1893,"end":1988}],[{"start":2008,"end":2088}],[{"start":2096,"end":2202}],[{"start":2210,"end":2213}],[{"start":2223,"end":2270}],[{"start":2278,"end":2337}],[{"start":2345,"end":2427}],[{"start":2453,"end":2500}],[{"start":2532,"end":2571}],[{"start":2603,"end":2655}],[{"start":2663,"end":2748}],[{"start":2774,"end":2827}],[{"start":2835,"end":2919}],[{"start":2927,"end":2946}],[{"start":2954,"end":3029}],[{"start":3061,"end":3109}],[{"start":3141,"end":3210}],[{"start":3218,"end":3267}],[{"start":3275,"end":3320}],[{"start":3352,"end":3438}],[{"start":3464,"end":3508}],[{"start":3540,"end":3593}],[{"start":3601,"end":3618}],[{"start":3644,"end":3647}],[{"start":3655,"end":3658}],[{"start":3666,"end":3672}],[{"start":3680,"end":3687}],[{"start":3719,"end":3751}],[{"start":3783,"end":3846}],[{"start":3854,"end":3891}],[{"start":3901,"end":3902}],[{"start":3912,"end":3923}],[{"start":3931,"end":3950}],[{"start":3982,"end":3998}],[{"start":4024,"end":4064}],[{"start":4072,"end":4109}],[{"start":4117,"end":4127}],[{"start":4135,"end":4218}],[{"start":4226,"end":4235}],[{"start":4243,"end":4271}],[{"start":4279,"end":4350}],[{"start":4358,"end":4402}],[{"start":4434,"end":4451}],[{"start":4477,"end":4488}],[{"start":4545,"end":4549}],[{"start":4575,"end":4600}],[{"start":4636,"end":4642}],[{"start":4674,"end":4742}],[{"start":4792,"end":4867}],[{"start":4875,"end":4940}],[{"start":4948,"end":4959}],[{"start":4991,"end":5059}],[{"start":5085,"end":5110}],[{"start":5142,"end":5186}],[{"start":5263,"end":5307}],[{"start":5339,"end":5347}],[{"start":5373,"end":5409}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_042.ks","basename":"SC_M_042.ks","indexIds":{"呼び出し音が数回鳴った後、\n道具さんが電話に出た。":0,"「もしもし、あの、」":1,"「ああ、少年？[l]\n冬夏君から色々聞いてるよ。[l]\nキミに電話した時はまだ事情を伺って無くてね。[l]\nもう復調したのかな？」":2,"「御陰様で、何とか大丈夫なようです。[l]\n済みません」":3,"「ははは、\n謝ることはない。[l]\n寧ろ先日手伝って貰った事が遠因かも知れないし、\nならばこちらこそ謝らねばならないな」":4,"いえいえ別に、多分原因はそれと違いますし、と大袈裟に否定して、\n僕は電話の意を問うた。":5,"「ふむ。[l]\nさて、どこから説明したものか……[l]\nそうだな、まず結論から言おう。":6,"件の祭だがね、\n──シキの執行が決定した。[l]\n無駄足にならずにすんだね。[l]\n御目出度う」":7,"「シキ…？あ、[l]\n祭ですか、\nはあ、やることに。[l]\n成る程成る程」":8,"矢張りその件だったか。":9,"「それで、\nその理由の方を説明しよう。[l]\n先日の謎の生物の襲来、\n憶えているかね？」":10,"「あの、\nスナトノホウシの手伝いの時、\n車に落っこちてきたあれですか？[l]\n姫様ちゃんと狩屋が追っかけてった」":11,"「そう、よく憶えていたね。[l]\nあれが解決したからなのだが":12,"巨大な熊だったようだよ":13,"先日のも其奴による事故":14,"つまり、人為的な理由である『事件』ではなく、\nあくまで『事故』による、\nそう、死亡事故だった、という事に落ち着いた。[l]\nその原因たる害獣もシガイという証拠によって":15,"祭を執行するに障害はない、という結論にまとまった。":16,"そうだ、死骸も上がってるが視に来るかい？」":17,"「え、いえ、いいです……[l]\nそういうのには興味無いですし、その──」":18,"て、熊って木から落ちるもの？":19,"それにその、\nヒトをあれする程の熊が車の屋根に落ちて、\nそれで……即座に消えたり……？[l]\nそんなばかな……":20,"欺瞞、嘘……なのか？[l]\nいや、しかしそんなことをする意味が──\n祭を執行する為にしても、\n……あ、":21,"そうか、\nあの場に居なければ、\n当然それは知られる所ではない、\nつまり、":22,"まて。":23,"だとしても、\n寧ろ逆に、\n何故『現場に立ち会った僕』にそれを言うんだ。":24,"それとも、\nほんとうにほんとうのことだというのか？":25,"しかし僕のそんな疑惑の念は、\n電話先には別の意味の沈黙として受け取られたようだった。":26,"「ふふふ、\nそういう出歯亀根性の欠如は大変に好ましい。[l]\n好奇心猫を殺すと言うしね、\n自発的能動的に独立独歩で愉悦を求める事が肝要なのだよ。":27,"単に秘されたモノを覗きたいだけでは、\n外部刺激に対してしか反応出来ない不能、\n言われたことしかできない能無しと一緒だからね。[l]\n他者に興味を持つのも節度が必要だ。":28,"須く過去は消せないし、\nそういった、自他を相対化して、相対的でしかない優越感を\n得る他諸々といった低俗な事はま…僕や少年のすることではないのだ。":29,"だから、そうだね、\n他人とあそぶのも節度を持ったコミュニケーションとしては良いが、\n自己処理（スタンドアローン）でも閉じて完結していないと、\n蒐集を旨とする遊戯としては手落ちも好い所だよ。":30,"他者を":31,"端から組み込んだ設計思想なんぞ話にならない、\nそれこそ蔑むべきＰの思想、くだらないね。":32,"や、まあそれは言い過ぎかな。[l]\n遊戯の種類にもよるか。[l]\nプラットフォームの事情もあるしなあ。":33,"いやまて、遊戯の定義から……[l]\nああ、悪い、ともあれ僕が言いたい事は。[l]\n自分で考えろ。考えろ。考えろ。[l]\nそれが成長の鍵だな」":34,"……色々ツッコミどころは満載なんですけど、[l]\nまずその、ピーの思想って何でしょう？":35,"「ええとご高説賜れるのは大変有り難いのですが、\n何の話でしたっけ……」":36,"「ああ、すまないね。[l]\n少年と話すのは愉しくてね。[l]\nついカタってしまうのだよ。":37,"まあ、少年、君は非常にイイという事だ。[l]\nあとは祭の施行が決定されて君の道程は徒労に終わらずに済んだ、\nという事かな。[l]\nうん、そうだね」":38,"前半は何か違う気がするけども、\n要するに、祭は強行されるという、\n前情報通りになった訳だ。":39,"道具さんの物言いからして、\nどうも『裏があるけども語らないよ』という空気がすごいするんだが。[l]\n会話の脇道に逸れたのも、恣意的な誤魔化しかも知れず、":40,"ただ、\n道具さんだからなあ……":41,"冬夏の言もあるし何とも判断つきかねる所ではあるが、\n祭の施行の決定自体は、僕等にとって突飛な結果ではないし、\n本当と思って良いだろう。":42,"「兎に角、良かったですね。[l]\nああ、あの、亡くなった方々にはその、あれですけど……」":43,"「ん？[l]\nああ、そうだな。[l]\n少年は気にする事は無いよ。[l]\n決定した以上、存分に祭を愉しんで呉れ給え。":44,"ふむ、\n僕等は執行側の人間なんでね、\n本来ならば少年を是非案内して回りたい所だが。":45,"──西石君も、体調やら仕事の事情でね、\n期間中は自由時間を作るのは難儀なようだし」":46,"「ああ、前に本人がそんな事言ってた様な言ってない様な……[l]\nいや、彼奴にも道具さん達にも無理はさせられないし、\nお心遣いだけありあがたく頂いておきます」":47,"というか、\n色々やらねばならないことが、\nまさに後ろめたいことだけど……":48,"「そうかい？[l]\nまあ少年はこの祭が終わったらどうするのか──\nそれは聞かないでおこう。":49,"その先に待つのが、\n──」":50,"──。":51,"あれ？":52,"聞こえない。":53,"電波途切れた？":54,"「もしもし？[l]\nあれ？[l]\n切れました？」":55,"「願わくばこれからも互いに愉しい関係でありたいものだよ。[l]\n折角こうやってこの場所この時代で邂逅出来たのだからね。":56,"袖振り合うも多生の縁、縁は異なもの味なもの……[l]\nでは、お身体":57,"呉":58,"呉も自重自愛を祈るよ。":59,"じゃ。[l]\n冬夏君に宜しく」":60,"「え？[l]\nあ、あの」":61,"聞こえなかったんですが、と言う間もなく、\nまた一方的に通話は終了された。":62,"道具さんも姫様ちゃんも、\n何気にこっちの話聞かずに電話切るよなあ。":63,"それともそれが普通？":64,"知人が少ない僕にとっては比較対象が居ないので\n判断つきかねるが、\nもう少しひとの話聞いてくれてもいいんでないの……？[l]\nと思い独り呻いた。":65,"おっと、忘れてた。":66,"新たな情報も得た事だし、\n宮さんに連絡しないと。":67,"覚醒してから既に結構な時間が経ってしまった。[l]\nいつもなら夕飯時になるし、\nタイミングあえば一緒にご飯でも食べられるかな。":68,"部屋に移動するのも難儀だったので、\n電話をしようとして、\n再び思い出す。":69,"「メール……チェックせねばか……」":70,"なんだろうなあ今回は。":71,"「うあ」":72,"まず眼に入ったものが予想とあまりに違っていたので、":73,"と、と、と、":74,"「冬夏？！と一緒て！！[l]\n何してんの！！[l]\nてか何でこんな衣装まで？？！！[l]\n……げほっ、げほげほ」":75,"あああこんなものは教育的指導ですよ、\n宮さんたら何してるのよ……[l]\nけしからん！！[l]\nしかもこれ撮影者が他に居るよな？":76,"チノ嬢か知狡さん……？[l]\n知狡さんは真面目さがどっちに転ぶかでやり兼ねないが、\n順当に考えてチノ嬢だろうな……":77,"ややや、何にしてもだ、":78,"「これは……消去……いや、[l]\n待ち受けにしてなきゃ別に構わないか、\n下手に消すと宮さんだけじゃなくて冬夏にまでその」":79,"……部屋で独り大慌てしてる事に気付き、冷静になる。":80,"「取り敢えず２度と開かないと言うことで、\nあとは触れない事にします……凍結凍結」":81,"一体、消去された前回のやつってどんな……[l]\nいや、そんなことはどうでもいい。":82,"「兎も角電話だ」":83,"気を落ち着けると、\n部屋で独り姿勢を正し、宮さんに電話をかけた。":84},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_042.ks","relPath":"/data/scenario/SC_M_042.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":84,"length":85,"percent":98.82352941176471},"cellInfo":[]},"/data/scenario/SC_M_043.ks":{"data":[["「あーいもしもし？」","「啊——喂喂？」"],["「あ、もしもし、僕ですが」","「啊、喂喂、是我」"],["「んむっ、まこくん？[l]\nやっとおきたですか？[l]\nだいじょぶ？」","「嗯唔、小真？[l]\n终于醒了吗？[l]\n不要紧吧？」"],["「御陰様で何とか大丈夫そうです。[l]\nあの、どうしましょうそっち向かいましょうか？」","「托您的福总算没事了。[l]\n那个、要我现在过去您那边吗？」"],["「んむ、ちょっと待ってください。[l]\n本人にかわります」","「嗯唔、请稍等。[l]\n让本人来接」"],["は？","哈？"],["本人？","本人？"],["「はーいまこくんおひさし！[l]\nだいじょぶ？[l]\nもう動けますか？」","「好——的小真好久不见！[l]\n没事吧？[l]\n已经能活动了吗？」"],["あれ？","嗯？"],["「え？[l]\nは？」","「诶？[l]\n哈？」"],["「うひひ、\n混乱してます混乱してます。[l]\nさすがはチノの声帯模写ですなあ。[l]\n電話越しとは言え完全に……","「呜嘻嘻，\n混乱了呢混乱了呢。[l]\n不愧是千乃的声带模仿呢。[l]\n虽说隔着电话完全……"],["まこくん？[l]\n状況把握してるかな？」","小真？[l]\n搞清楚状况了吗？」"],["あ、","啊，"],["ああ。","啊啊。"],["最初のはチノ嬢の声真似ですか。[l]\nそういや達者だったねあのひとは……","最开始是千乃小姐的声优模仿啊。[l]\n说起来她确实擅长这个呢……"],["「やっと分かりましたよ。[l]\n何してるんですか病み上がりの人間に対して。[l]\nチノさんまで巻き込んで……」","「终于明白了。[l]\n对刚病愈的人做什么呢。[l]\n连千乃小姐都牵扯进来……」"],["「んむー、\n大丈夫だって信じてるって書いたでしょお？[l]\nこれくらいのかぁいい悪戯には耐えられる体力あるでしょお？」","「嗯唔——，\n不是写了相信你没问题嘛？[l]\n这点可爱的恶作剧总该有体力承受吧？」"],["「……まあ、貴女には馴らされましたからね。[l]\nいいですよもう。[l]\n取り敢えずすぐ連絡寄越せって書いてあったので連絡したんですが。[l]\nバナナと茶漬けは食べましたけど」","「……嘛、毕竟早就被您调教惯了。[l]\n已经可以了。[l]\n总之看到写着『立刻联系』就打电话了。[l]\n香蕉和茶泡饭倒是吃过了」"],["「ふぅん。[l]\nそっちの件は冬夏さんじゃなかったかな？[l]\n向こうさんには連絡したですか？」","「哼嗯。[l]\n那件事应该是冬夏小姐负责的吧？[l]\n联系过那位了吗？」"],["「え？[l]\nこの後するつもりですが……」","「诶？[l]\n正准备之后联系……」"],["そういえば『すぐに連絡寄越せ』って書いてあったのは、\n冬夏の書き置きの方だっけ。[l]\nいやその、起きた後の事は冬夏の紙参照ってあったし、\nてっきり両者の意思が通じてるのかと……","说起来『立刻联系』的字条，\n是冬夏留的那张吧。[l]\n不对那个、写着醒来后事项参照冬夏的纸条，\n还以为你们双方通过气……」"],["「なるほど。[l]\nあ、あと知狡にも御礼言ってください。","「原来如此。[l]\n啊、另外要向知狡道谢哦。"],["で、メールは？[l]\n今回はちゃんと視たですか？[l]\n何しろ今回はぁ、」","那、邮件呢？[l]\n这次好好看了吗？[l]\n毕竟这次啊——」"],["「……ええ。[l]\nつーかだからあなたに先に電話したってのもありますがね。[l]\n冬夏にまであんな事さして、\n怒られなかったですかほんと」","「……嗯。[l]\n倒不如说正因为这个才先给你打电话。[l]\n连冬夏都被那样指使，\n真没挨骂吗」"],["「んむっ。[l]\n冬夏さんは寧ろノリノリでやってくれましたよ？[l]\nまこくんの為なら、ってそれぁもう、\n文字通り一肌脱いでくれちゃったりなんかしちゃったりして！","「嗯唔。[l]\n冬夏小姐可是兴致勃勃帮忙的哦？[l]\n说是为了小真的话、那个啊，\n字面意义上连肌肤之亲都做到啦！"],["愛されてますなぁーまこくん。[l]\n宮なんか入り込む","真是被深爱着呢——小真。[l]\n宫都插不进"],["隙","足"],["間も無いくらい、」","的程度呢，」"],["「いやーそんなことぁ、」","「哎呀哪有那种事——」"],["……ん？","……嗯？"],["「んむ？」","「嗯唔？」"],["「は？あれ？[l]\nいや、\n違います。","「啊？咦？[l]\n不、\n不是的。"],["冬夏にそんなまで愛されてるかどうかについての疑問符、\nなのであって、\n別にその、あなた──","关于冬夏是否爱我到那种程度的问号、\n是这个意思、\n并不是说你──"],["や、いいんですよそんな話は。[l]\nとっとと本題入りましょう」","啊、这种事无所谓啦。[l]\n赶紧进入正题吧」"],["「………」",""],["「……あれ？[l]\nもしもし？」","「……咦？[l]\n喂喂？」"],["「まこくん、\n最近溜まってる？」","「小真、\n最近积压很多吗？」"],["「あぁ、繋がってたっ……って、え？」","「啊、接通了……啊咧？」"],["「なぁんか、\n様子がヘンですなぁ。","「总觉得、\n样子有点怪呢。"],["ご褒美ほしがってます？[l]\nさっきそのメールしたじゃんー。[l]\n……足りない？のかな？」","是想要奖励吗？[l]\n刚才不是发过那封邮件嘛ー。[l]\n……不够？是吗？」"],["「……いったいなんのおはなしでしょうカ。[l]\nそっちこそ何か最近、調子が狂うというか、」","「……这到底在说什么啊。[l]\n你才是最近是不是有点，该说状态失常吗、」"],["「（…かし…な。[l]\n…イの抑えが……？）」","「（…搞不…懂。[l]\n…欲求的抑制……？）」"],["「すみません、聞こえないんですがー。[l]\nあれそれとも電話自体の調子が悪いのかな」","「抱歉，我听不见啊ー。[l]\n还是说电话本身信号不好呢」"],["「んむ？[l]\nいあ、だいじょぶですよ。","「嗯？[l]\n没、没事的。"],["えっと、あ、ごめんです、\nじゃあ……もうこんな時間なので、[l]\n晩御飯食べてお風呂──お風呂おっけーかなまこくん？」","那个、啊、对不起、\n那……已经这个点了、[l]\n吃完晚饭洗澡──洗澡没问题吧小真？」"],["「は？[l]\n風呂？！」","「哈？[l]\n洗澡？！」"],["「……体調的にって事ですけど」","「……是指身体状况方面啦」"],["「あっ！？[l]\nああ、ああはい大丈夫です。","「啊！？[l]\n啊、啊啊是的没问题。"],["寧ろ１日入ってない分、今にも入りたくてしょうがないくらいで、\nすみませんちょっと","不如说一整天没洗，现在恨不得马上冲进去、\n抱歉稍微"],["吃","吃"],["驚してしまいまして、\nえらい勘違いを」","被吓到了、\n闹了个大误会」"],["「ふむ。[l]\nではお風呂上がったら部屋に来てください。","「嗯。[l]\n那洗完澡来我房间吧。"],["冬夏さんは連れて来ないように。[l]\n晩御飯の時点でちゃんとお相手して満足させといてくださいよ。[l]\n大分心配してたようですから。","别带冬夏过来。[l]\n晚饭时要好好陪她让她满足哦。[l]\n她似乎相当担心呢。"],["うひひ、宮にはどうぞお構いなく。[l]\n遠慮せずに宜しくやっちゃってください」","嘻嘻，宫那边就不用管啦。[l]\n不用客气尽管来吧」"],["「え、あ、あの」","「诶、啊、那个」"],["なんだ。","什么啊。"],["「んむ？[l]\nなに？」","「嗯？[l]\n什么？」"],["「晩御飯はご、……ご一緒に…ですか？[l]\n僕等２人、という意味ですが」","「晚饭要一、……一起吃…吗？[l]\n就我们俩的意思、」"],["なんなんだ。[l]\n僕は。[l]\n何を訊いてる。","搞什么。[l]\n我。[l]\n在问些什么。"],["「え？[l]\nそれは構いませんよ？","「诶？[l]\n那倒没关系？"],["今からそっち行きますから、\nそれまでに冬夏さんに連絡してあげといてください。[l]\n勿論ご飯中だけなら、彼女の同席も可です」","我现在就过去、\n在那之前先联系下冬夏小姐吧。[l]\n当然如果只是吃饭期间，她也可以在场」"],["「わっ──かりましたー。[l]\nじゃこれ切ったら電話しときます。[l]\n部屋で待ってますんで」","「知──道了ー。[l]\n那挂掉就打给她。[l]\n在房间等你哦」"],["何でだ。","为什么。"],["何だこの焦燥感は。[l]\n何でこんなに、","这焦躁感是怎么回事。[l]\n为什么这么、"],["「まこくん、」","「小真，」"],["「は、はい」","「啊、是」"],["「今晩一緒に寝とく？」","「今晚要一起睡吗？」"],["「…………は？」","「…………啥？」"],["一瞬何のことか分からなかったが、","一瞬间没明白她在说什么，"],["………。",""],["いやいや、\n数秒経っても何のことか分からない。","不不，\n过了几秒还是没明白。"],["ただ、\n何だか神妙な雰囲気であったのは確かなので、\n","只是，\n总觉得气氛莫名严肃，\n"],["揶いやなんやでないのだろうとは思う、けれど……","应该不是在开玩笑吧，不过……"],["「何か心配になってきた。[l]\n冬夏さんに任せるには──ちょっと事情が込み入ってますしね。","「有点担心起来了。[l]\n交给冬夏小姐的话──情况有点复杂呢。"],["彼女にはいずれ色々遊んで貰うとしても……[l]\nチノも一緒に作業してますけどそれでも良ければ、ですけど。[l]\nまあ寝るのに邪魔ならないようにしますけどね勿論。","虽然迟早会和她玩各种花样……[l]\n千乃也一起参与工作的话倒是没关系，如果您不介意。[l]\n当然睡觉时不会打扰你们的。"],["ね、どうする？」","呐，怎么说？」"],["あ、ああ。[l]\n僕の最近の不調に対して、\n純粋に心配してくれていたようだ。","啊、啊啊。[l]\n看来她是真心实意地\n担心我最近状态不佳。"],["保護者視点ね。[l]\nチノ嬢も同席というのは……","监护人视角呢。[l]\n千乃小姐也在场的话……"],["いやいや、その方が間違いが無いと言うか、\n安全弁？[l]\n当然よね。[l]\n当然……","不不、这样反而更稳妥吧，\n安全阀？[l]\n理所当然嘛。[l]\n理所当然……"],["「あの……まあ断る理由は無い……ですよ？[l]\n今のところこちらにも」","「那个……倒也没理由拒绝……吧？[l]\n目前我这边也」"],["「んむ。[l]\nわかった。[l]\nじゃ今日は仕事の話をしたらそのまま宮の部屋にお泊まりです。[l]\nでは後程～」","「嗯唔。[l]\n明白了。[l]\n那今天谈完工作就直接住我房间吧。[l]\n待会儿见～」"],["ヘンなことしたら殺すわよ的な或いは、\nいつでもどうぞ的な茶化しがないのが若干気になるけども、","虽然有点在意她既没说「敢乱来就杀了你」之类的威胁，\n也没用「随时欢迎」之类的玩笑搪塞，"],["ともあれ会話は打ち切られた。","总之对话就此中断。"],["「やっぱり何かこう……[l]\nあ、冬夏の事を聞いたのかいな」","「果然还是觉得哪里……[l]\n啊、是听说冬夏的事了吗」"],["や、それであんな変節するような宮さんじゃないと思う。[l]\n寧ろもっと押せ押せで弄ってくる。","不、那样的话就不像会突然转变态度的宫小姐了。[l]\n她应该会更咄咄逼人地捉弄我才对。"],["無意識にでも、\n僕の方が変節したのだろうか。[l]\nそれこそ冬夏への意識が何かしら……","莫非不知不觉间，\n改变的人是我吗。[l]\n特别是对冬夏的某种在意……"],["「……何にしても話しないと分からん。[l]\n想像は何処まで行っても想像だし、」","「……想再多也没用。[l]\n想象终究只是想象，」"],["いや、だから何でそんなに気にするんだ、\nあのひとの事を。[l]\n冬夏の事を考えるならまだしも──","不对、说到底我为什么这么在意，\n那个人的事。[l]\n如果是考虑冬夏的事还说得过去──"],["「は…く……たいのに……べて…さ……う」","「哈…快……的时……候……样」"],["ん？","嗯？"],["はやく？","快点？"],["はっ。","啊。"],["「そうだ、早く飯──否、\nその前に何かするべき事が」","「对了、赶紧吃饭──不对、\n在这之前还有该做的事」"],["ああ、どんどん混乱していく～～～。","啊啊越来越混乱了～～～。"],["一体、僕は何に煩悶してるんだろう。[l]\nこうなると、\n大神とかれお嬢のあっさりいった感は何だったんだろうな、\nと思わざるを得ない。","我到底在烦恼什么啊。[l]\n事到如今，\n不禁想起大神和卡蕾欧小姐那种水到渠成的感觉，\n实在是令人羡慕。"],["勿論、こういう事情に限らずとも人それぞれだし、\n普遍的なマニュアルなんかありはしないんだが、\nなんだか大神が、\n酷く羨ましくなってしまった。","当然、不单是这种情况、人与人本就不同，\n根本不存在什么通用手册，\n但突然觉得\n特别羡慕大神。"],["あの２人はこう、なるべくしてなった、と言った感じで、","那两个人就像是顺理成章走到一起，"],["冬夏のが『ど』ストレートなだけに──","相比之下冬夏就『超』直球──"],["待て、","等等，"],["これじゃあ、\n僕が","这样说来，\n我"],["恋","恋"],["煩いに","吵闹地"],["罹った前提の思考じゃないかよ。","这不是基于已经陷入恋爱的前提思考吗？"],["そんなことぁ、","这种事情啊、"],["「あ、冬夏にも連絡だ」","「啊，冬夏也来联络了」"],["やばい、\n妄想暴走で無為に時を過ごすところであった。","糟糕、\n差点因为妄想暴走白白浪费时间。"],["「えーと、三春三春……」","「呃、三春三春……」"],["ここここん。","咚咚咚。"],["「……入りまーす。[l]\nどんな感じかなーと……[l]\nあ！！！」","「……打扰啦ー。[l]\n在想会是什么感觉呢ー……[l]\n啊！！！」"],["はれ？[l]\n宮さんが先に着いちゃった、と思いきや、\nえ、えらいタイミングでまたこれ……[l]\n悪くはないけど……","咦？[l]\n正以为宫小姐先到了，\n呃、这 timing 也太巧了吧又来……[l]\n倒也不坏……"],["「おあっびっくらしたよ……[l]\nお、おはようございます……[l]\nこの度は色々とご迷惑をおかけして……」","「吓吓吓一跳……[l]\n早、早安……[l]\n这次给您添了各种麻烦……」"],["「わわわわわわーーーおおおおお、\n驚いた！！！[l]\n","「哇哇哇哇哇ーーー啊啊啊啊啊，\n吓死了！！！[l]\n"],["ごっ！[l]\n","咕！[l]\n"],["ごめんなさいまだ寝てると思ってあぁあわわわわ」","对不起以为妳还在睡啊啊啊哇哇哇哇」"],["「やややそんなにびびらなくても」","「别别别这么惊慌嘛」"],["狩屋と言い、\n血縁関係無いにしては何か通じるものがあるなあ……[l]\nギョっとすると、リアクションなんて皆同じなのかも知れないけど……","说到狩屋，\n明明没有血缘关系却莫名有共鸣呢……[l]\n虽然受惊时的反应大概谁都一样……"],["あ、ひょっとしてあの画像に関してかぇ。","啊、难道是因为那张图片吗。"],["「ええーと、今丁度そっちに連絡しようとしてたんだ。[l]\n御陰様でこの通り、\n何とか復調したから」","「那个、我正准备联络妳呢。[l]\n托您的福如您所见，\n总算恢复正常了」"],["「え？[l]\n","「诶？[l]\n"],["あ、いえこちらこそ何にも出来なくて……」","啊、没没没我什么忙都没帮上……」"],["「ほんとにありがとう、\nなんかその宮さんが何か無茶振りしたみたいで──」","「真的很感谢，\n好像宫小姐又提了什么无理要求似的──」"],["「おぇぁっ！？[l]\n","「呜欸！？[l]\n"],["いえ、その、私なんかで良ければいつだっていくらでも、\nだ、だだだだめ！！[l]\n感想は聞かないから！！","不是、那个、只要我帮得上忙随时都、\n不不不不不行！！[l]\n不准问感想！！"],["言わないで！！[l]\nお願い！！！[l]\n後生だから！！！」","不准说出来！！[l]\n求求妳！！！[l]\n这辈子就这一次！！！」"],["「は、はあ……[l]\nじゃ、じゃあ、うん、言わずにおきます……」","「哈、哈啊……[l]\n那、那就、嗯、我不说……」"],["別に悪い事言うつもりもなかったけれど、\n気持ちは良く分かる。[l]\nでも年頃の娘さんが『後生だから！！』って言う？[l]\nうーむ、流石は冬夏さんですなあ……","虽然本来也没打算说什么过分的话，\n但这心情我很理解。[l]\n不过妙龄少女会喊『这辈子就这一次！！』吗？[l]\n唔嗯、不愧是冬夏小姐啊……"],["「良かったよそれにしても。[l]\n良かったぁ……」","「不过太好了。[l]\n太好啦……」"],["と言うと入り口付近に突っ立ってたままだった冬夏は、\nこちらに近寄ってきて、","闻言一直杵在门口的冬夏，\n朝这边走近，"],["「私何か待つのってすごい苦手だから……[l]\nこのまま誕生日過ぎても寝てたらどうしようとか、\nあはは、\nエゴ丸出しの事ばっか頭に浮かぶんだよね。","「我超不擅长等待的……[l]\n要是妳就这样睡过生日怎么办之类的，\n啊哈哈，\n脑子里全塞满这种自私的想法。"],["理性じゃ、なんて不謹慎！って思うんだけど、[l]\n感情は全然そんな事情お構いなしにさ、\n苦しいの、\nそんな自分自身を視せつけられてさ、","理性会觉得这也太不像话！[l]\n但感情根本不管这些，\n好痛苦啊，\n被迫直视这样的自己，"],["こんな私が貴方を好きだとか、\n痛々しくてちゃんちゃらおかしくなったり、\n自分がほんっと厭になって、そういった感情の振り幅って、\n他人とね、話さないと、自分ループに","像我这样的人居然喜欢妳什么的，\n又难堪又荒唐可笑，\n厌恶透了自己，这种情绪的剧烈起伏，\n不找人倾诉的话，"],["嵌っちゃって、","就会陷入自我循环、"],["良くないよね、\nだからね、\nああもうね、\nいっぱい喋りたくってしょうがなかった！！！！！","这样不好吧、\n所以说啊、\n啊啊真是的、\n我憋了超——多话想说啊！！！！！"],["真言さんといっぱいね、いーーーっぱい話したかったよぉ。[l]\nああもう、ほんとごめんね？[l]\n私こんなで。[l]\nほんとごめん……","想和真言さん聊好多好多呢，饭————超级想聊个够的哟。[l]\n啊啊真是的，真的对不起啦？[l]\n我这副德行。[l]\n真的对不起……"],["ああもうわかんない何言ってるか。[l]\nとにかくね、\n良かった！！[l]\n今はね、とにかく、すっごい嬉しい」","啊啊完全听不懂在说什么。[l]\n总之呢、\n太好了！！[l]\n现在啊、总之、超级开心」"],["前の時もそうだったけども、\n言葉……というか、[l]\n彼女の感情の奔流に圧倒されるばかりで、\n僕もどう反応（リアクション）して良いのか判らないままに、","上次也是这样，\n言语……或者说，[l]\n完全被她感情的洪流所压倒，\n我也不知道该怎么反应（reaction）才好，"],["「う、うん。[l]\nそれはその、そう思って頂けると僕も、\n嬉しく思います……」","「呃、嗯。[l]\n那个、您能这么想我也、\n感到很高兴……」"],["と言うだけだった。[l]\nするとやっぱり少々残念そうな顔をされまして、","只能这样回答。[l]\n于是她果然露出有点失望的表情、"],["「……いいですそんな反応でも。[l]\n無いよりましだっ。[l]\nああもう、\n──」","「……算了这种反应也行。[l]\n总比没有强。[l]\n啊啊真是的、\n──」"],["冬夏は何かを呑み込むかのようにぐっと眼を瞑り、","冬夏像是咽下什么似地紧紧闭眼、"],["「良かったよぅ……[l]\nほんとに、\n良かったよぅ……」","「太好了呀……[l]\n真的、\n太好了呀……」"],["と、小さく繰り返した。","小声重复着。"],["ぼくはなにかすごくわるいきがして、","我感觉自己做了很过分的事、"],["戯れ、という訳でも無いけど、","虽说不算戏弄、"],["無意識に、何となしに頭を撫でた。","却无意识地随手摸了摸她的头。"],["「……！？」",""],["「……よしよし」","「……乖哦乖哦」"],["「えっ。[l]\nやっ。[l]\nえっ？」","「诶。[l]\n呀。[l]\n诶？」"],["「や、なんとなく」","「就、下意识」"],["「ごごごごめんなさいこんなとき、\nどういうりあくそんをしたらいいか」","「对对对不起这种时候、\n该怎么反哎哟应才好」"],["先刻の僕の立場と同じような感想を述べる冬夏。","冬夏说出了方才与我立场相同的感想。"],["「……いや、ごめん、[l]\n戯れが過ぎたようで」","「……不、抱歉、[l]\n似乎玩笑开过头了」"],["押しの強いひとは押されると弱いという例がまたここに……","强势的人被反攻就会弱势的案例又添一桩……"],["「いっつもそっちからばっかだから、\nこっちからやるとどうなるのか、\n少しばかり気になって……[l]\nごめん、気にしないで」","「因为你总是主动那边、\n就想试试我主动会怎样、\n稍微有点在意……[l]\n抱歉、别在意」"],["ほんとに、自分でもよく解らない行動だと思う……","真的、连我自己都不明白这行为……"],["「気にするなって言われてもぉさぁあ、\nそれは……","「嘴上说别在意也太过分啦、\n那个……"],["酷ってものだよ……」","太残忍了吧……」"],["「うーん──」","「唔嗯──」"],["そうか……[l]\nそういうことか……","这样啊……[l]\n原来是这么回事……"],["発する側にその気が無くとも、\n受ける側次第で──","即使表达方没有那个意思、\n取决于接收方──"],["此方がどんなに入れ込んでも、彼方側は──","不管我这头多么投入、对方那边──"],["「ん、ごめん、\nちょっと","「嗯、抱歉、\n稍微"],["昂ぶっちゃってた。[l]\nそだね。[l]\nいっつも私が真言さんにしてるような事よね。","兴奋过头了。[l]\n是呢。[l]\n就像我平时对真言先生做的那样呢。"],["ん。[l]\n………。[l]\nまままままままま、ご！[l]\nそう、ご飯！！","嗯。[l]\n………。[l]\n妈妈妈妈妈妈妈、饭！[l]\n对了，吃饭！！"],["ご飯どうするの？[l]\n晩御飯だいじょうぶ？！[l]\n食べれる？食べられる？」","晚饭怎么办？[l]\n晚餐没问题吧？！[l]\n能吃吗？能吃得下？」"],["「ごめん、こっちも病み上がりで、\n頭が未だ……[l]\nそれよりええとご飯？[l]\nあの、宮さんと一緒で良ければ──」","「抱歉，我这边也是刚病愈，\n脑子还不太……[l]\n比起这个，呃、吃饭？[l]\n那个，如果不介意和宫小姐一起的话──」"],["「え？[l]\n……あぁーあ、[l]\nん、行く。","「诶？[l]\n……啊──啊，[l]\n嗯，我去。"],["今から？[l]\n部屋の片付けとか一応しに来たんだけど──」","现在就去？[l]\n本来是想来收拾下房间的──」"],["「あ、そうか、ありがとう。[l]\n多分大丈夫じゃないかな……[l]\n今行くときに宿の人に言っておくよ」","「啊，这样啊，谢谢。[l]\n大概没问题的……[l]\n现在过去时会和旅馆的人说一声的」"],["「ん。[l]\nじゃ準備して来るー。[l]\nまた此処来ればいい？」","「嗯。[l]\n那我去准备下ー。[l]\n待会儿再来这里集合？」"],["「うん、\n宮さんとも此処で待ち合わせだから……」","「嗯，\n和宫小姐也约好在这里碰面……」"],["僕等は、","我们啊，"],["悪意が無くても、知らないうちに、\n互いに残酷なことをしている、んだな。","即使没有恶意，也会在不知不觉中，\n对彼此做出残酷的事呢。"],["そんな単純なことに、\n今更気付いた。","如此简单的事情，\n到现在才察觉。"],["じゃあどうすれば、という問いに、","至于该怎么办这个问题，"],["答えがあるとは到底思えなかった。","根本不可能有答案。"],["僕等はきっとおなじものを──","我们一定都──"]],"context":[["SC_M_043.ks/index/1/text"],["SC_M_043.ks/index/3/text"],["SC_M_043.ks/index/5/text"],["SC_M_043.ks/index/7/text"],["SC_M_043.ks/index/9/text"],["SC_M_043.ks/index/11/text"],["SC_M_043.ks/index/13/text"],["SC_M_043.ks/index/15/text"],["SC_M_043.ks/index/17/text"],["SC_M_043.ks/index/19/text"],["SC_M_043.ks/index/21/text"],["SC_M_043.ks/index/23/text"],["SC_M_043.ks/index/25/text"],["SC_M_043.ks/index/27/text"],["SC_M_043.ks/index/29/text"],["SC_M_043.ks/index/31/text"],["SC_M_043.ks/index/33/text"],["SC_M_043.ks/index/35/text"],["SC_M_043.ks/index/37/text"],["SC_M_043.ks/index/39/text"],["SC_M_043.ks/index/41/text"],["SC_M_043.ks/index/43/text"],["SC_M_043.ks/index/45/text"],["SC_M_043.ks/index/47/text"],["SC_M_043.ks/index/49/text"],["SC_M_043.ks/index/51/text"],["SC_M_043.ks/index/53/text"],["SC_M_043.ks/index/55/text"],["SC_M_043.ks/index/57/text"],["SC_M_043.ks/index/59/text"],["SC_M_043.ks/index/61/text"],["SC_M_043.ks/index/63/text"],["SC_M_043.ks/index/65/text"],["SC_M_043.ks/index/67/text"],["SC_M_043.ks/index/69/text","SC_M_043.ks/index/71/text","SC_M_043.ks/index/73/text"],["SC_M_043.ks/index/75/text"],["SC_M_043.ks/index/77/text"],["SC_M_043.ks/index/79/text"],["SC_M_043.ks/index/81/text"],["SC_M_043.ks/index/83/text"],["SC_M_043.ks/index/85/text"],["SC_M_043.ks/index/87/text"],["SC_M_043.ks/index/89/text"],["SC_M_043.ks/index/91/text"],["SC_M_043.ks/index/93/text"],["SC_M_043.ks/index/95/text"],["SC_M_043.ks/index/97/text"],["SC_M_043.ks/index/99/text"],["SC_M_043.ks/index/101/text"],["SC_M_043.ks/inde