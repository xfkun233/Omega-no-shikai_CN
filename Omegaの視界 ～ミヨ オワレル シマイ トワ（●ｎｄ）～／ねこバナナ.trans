016.ks/index/474/text"]],"tags":[],"parameters":[[{"start":221,"end":238}],[{"start":276,"end":339}],[{"start":406,"end":425}],[{"start":463,"end":509}],[{"start":576,"end":618}],[{"start":656,"end":690}],[{"start":727,"end":763}],[{"start":801,"end":841}],[{"start":873,"end":1098}],[{"start":1136,"end":1240}],[{"start":1272,"end":1360}],[{"start":1397,"end":1407}],[{"start":1439,"end":1475}],[{"start":1513,"end":1552}],[{"start":1584,"end":1600}],[{"start":1667,"end":1684}],[{"start":1718,"end":1728}],[{"start":1766,"end":1860}],[{"start":1872,"end":1932}],[{"start":1969,"end":1975}],[{"start":2007,"end":2016}],[{"start":2086,"end":2125}],[{"start":2163,"end":2219}],[{"start":2289,"end":2325}],[{"start":2339,"end":2350}],[{"start":2382,"end":2461}],[{"start":2473,"end":2495}],[{"start":2533,"end":2583}],[{"start":2650,"end":2673}],[{"start":2705,"end":2717}],[{"start":2729,"end":2798}],[{"start":2835,"end":2852}],[{"start":2864,"end":2938}],[{"start":2950,"end":3000}],[{"start":3038,"end":3071}],[{"start":3108,"end":3115}],[{"start":3127,"end":3128}],[{"start":3140,"end":3141}],[{"start":3152,"end":3153}],[{"start":3165,"end":3206}],[{"start":3244,"end":3298}],[{"start":3335,"end":3390}],[{"start":3422,"end":3497}],[{"start":3534,"end":3596}],[{"start":3608,"end":3687}],[{"start":3719,"end":3775}],[{"start":3789,"end":3868}],[{"start":3882,"end":3967}],[{"start":3979,"end":3980}],[{"start":3991,"end":4010}],[{"start":4024,"end":4083}],[{"start":4120,"end":4185}],[{"start":4197,"end":4250}],[{"start":4262,"end":4354}],[{"start":4386,"end":4423}],[{"start":4437,"end":4494}],[{"start":4532,"end":4580}],[{"start":4592,"end":4616}],[{"start":4648,"end":4700}],[{"start":4714,"end":4760}],[{"start":4830,"end":4872}],[{"start":4884,"end":4964}],[{"start":4976,"end":5041}],[{"start":5053,"end":5099}],[{"start":5131,"end":5138}],[{"start":5150,"end":5235}],[{"start":5247,"end":5263}],[{"start":5277,"end":5287}],[{"start":5325,"end":5380}],[{"start":5417,"end":5480}],[{"start":5518,"end":5562}],[{"start":5599,"end":5614}],[{"start":5626,"end":5702}],[{"start":5740,"end":5785}],[{"start":5855,"end":5904}],[{"start":5916,"end":5963}],[{"start":6001,"end":6064}],[{"start":6134,"end":6180}],[{"start":6218,"end":6228}],[{"start":6240,"end":6302}],[{"start":6314,"end":6354}],[{"start":6421,"end":6474}],[{"start":6506,"end":6535}],[{"start":6605,"end":6640}],[{"start":6678,"end":6683}],[{"start":6753,"end":6808}],[{"start":6846,"end":6902}],[{"start":6969,"end":6994}],[{"start":7039,"end":7084}],[{"start":7129,"end":7167}],[{"start":7205,"end":7245}],[{"start":7277,"end":7297}],[{"start":7364,"end":7381}],[{"start":7413,"end":7432}],[{"start":7502,"end":7577}],[{"start":7615,"end":7669}],[{"start":7701,"end":7740}],[{"start":7807,"end":7824}],[{"start":7861,"end":7874}],[{"start":7911,"end":7937}],[{"start":7949,"end":7998}],[{"start":8036,"end":8067}],[{"start":8079,"end":8121}],[{"start":8158,"end":8225}],[{"start":8237,"end":8323}],[{"start":8335,"end":8412}],[{"start":8424,"end":8478}],[{"start":8510,"end":8578}],[{"start":8590,"end":8644}],[{"start":8656,"end":8698}],[{"start":8735,"end":8759}],[{"start":8791,"end":8826}],[{"start":8864,"end":8885}],[{"start":8897,"end":8939}],[{"start":8951,"end":9035}],[{"start":9096,"end":9146}],[{"start":9184,"end":9230}],[{"start":9267,"end":9288}],[{"start":9326,"end":9338}],[{"start":9370,"end":9392}],[{"start":9483,"end":9514}],[{"start":9559,"end":9624}],[{"start":9661,"end":9691}],[{"start":9723,"end":9779}],[{"start":9791,"end":9853}],[{"start":9891,"end":9935}],[{"start":10002,"end":10061}],[{"start":10073,"end":10145}],[{"start":10183,"end":10239}],[{"start":10271,"end":10344}],[{"start":10356,"end":10458}],[{"start":10470,"end":10546}],[{"start":10584,"end":10654}],[{"start":10724,"end":10732}],[{"start":10766,"end":10786}],[{"start":10823,"end":10839}],[{"start":10871,"end":10886}],[{"start":10923,"end":10975}],[{"start":10987,"end":11041}],[{"start":11073,"end":11148}],[{"start":11160,"end":11198}],[{"start":11210,"end":11288}],[{"start":11325,"end":11398}],[{"start":11436,"end":11470}],[{"start":11482,"end":11547}],[{"start":11559,"end":11596}],[{"start":11633,"end":11741}],[{"start":11753,"end":11801}],[{"start":11839,"end":11892}],[{"start":11929,"end":11986}],[{"start":12059,"end":12119}],[{"start":12131,"end":12188}],[{"start":12200,"end":12267}],[{"start":12305,"end":12373}],[{"start":12472,"end":12522}],[{"start":12560,"end":12623}],[{"start":12660,"end":12705}],[{"start":12743,"end":12761}],[{"start":12773,"end":12852}],[{"start":12889,"end":12943}],[{"start":12975,"end":13015}],[{"start":13027,"end":13080}],[{"start":13092,"end":13143}],[{"start":13180,"end":13201}],[{"start":13213,"end":13264}],[{"start":13276,"end":13340}],[{"start":13352,"end":13412}],[{"start":13424,"end":13437}],[{"start":13469,"end":13495}],[{"start":13533,"end":13586}],[{"start":13623,"end":13653}],[{"start":13665,"end":13750}],[{"start":13762,"end":13830}],[{"start":13862,"end":13929}],[{"start":13941,"end":13996}],[{"start":14033,"end":14159}],[{"start":14191,"end":14260}],[{"start":14272,"end":14328}],[{"start":14342,"end":14370}],[{"start":14407,"end":14480}],[{"start":14492,"end":14533}],[{"start":14571,"end":14595}],[{"start":14607,"end":14636}],[{"start":14649,"end":14683}],[{"start":14720,"end":14808}],[{"start":14842,"end":14904}],[{"start":14936,"end":14963}],[{"start":14975,"end":15064}],[{"start":15076,"end":15098}],[{"start":15135,"end":15178}],[{"start":15216,"end":15283}],[{"start":15320,"end":15339}],[{"start":15371,"end":15403}],[{"start":15441,"end":15487}],[{"start":15524,"end":15557}],[{"start":15595,"end":15636}],[{"start":15648,"end":15728}],[{"start":15765,"end":15800}],[{"start":15838,"end":15924}],[{"start":16001,"end":16101}],[{"start":16113,"end":16143}],[{"start":16181,"end":16228}],[{"start":16240,"end":16285}],[{"start":16385,"end":16444}],[{"start":16481,"end":16489}],[{"start":16527,"end":16532}],[{"start":16569,"end":16600}],[{"start":16612,"end":16670}],[{"start":16683,"end":16703}],[{"start":16715,"end":16765}],[{"start":16803,"end":16838}],[{"start":16870,"end":16949}],[{"start":17043,"end":17107}],[{"start":17139,"end":17157}],[{"start":17195,"end":17230}],[{"start":17300,"end":17335}],[{"start":17373,"end":17381}],[{"start":17448,"end":17518}],[{"start":17556,"end":17599}],[{"start":17669,"end":17683}],[{"start":17715,"end":17781}],[{"start":17849,"end":17866}],[{"start":17903,"end":17920}],[{"start":17958,"end":17970}],[{"start":18040,"end":18077}],[{"start":18114,"end":18126}],[{"start":18206,"end":18226}],[{"start":18238,"end":18294}],[{"start":18306,"end":18350}],[{"start":18362,"end":18413}],[{"start":18425,"end":18471}],[{"start":18485,"end":18541}],[{"start":18555,"end":18565}],[{"start":18576,"end":18617}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_016.ks","basename":"SC_M_016.ks","indexIds":{"「………[l]\nおかえり」":0,"「…ただいま帰りました。[l]\n今日は居たんですねなんだか久しぶりですね、って、\n──なんすかそのテンション」":1,"「まこくんから他の女子の匂いがするっ」":2,"「！？[l]\nえぇええ、\nそ、そうすか？[l]\nや、だって今日は…」":3,"「うひひ、\n分かってます。[l]\nやぱーり揶い甲斐がありますねっ♪」":4,"「ねっ♪\nじゃないすよ。[l]\nそんなに匂います？」":5,"「んむぅ、冗談ですってば。[l]\nまこくん結婚したら大変だね…」":6,"「しなくたって今現時点でまさに大変ですよ…[l]\nそんな事よりですね、」":7,"結局電話もせずに旅館に戻ると、\n入るなり宮さんと鉢合わせたので、\n飯も喰うのも忘れて、\n彼女に詳しい顛末を一通り話した。[l]\n昼間でも居るときは居るんだな。[l]\n全く、電話先にしとけば良かった。[l]\n姫様ちゃん達に止められてからすっかり忘れてたよ。[l]\n嗚呼、昼飯のタイミングが…[l]\nしかしそんな処に気が回るのであれば、\nそもそも空転脳ではないのです。ないのですよ。":8,"「あと何か僕、本家の地下行ってから、\n何か眼の調子がおかしいんですけど、\n連日宮さん達に遊ばれてもう疲れてるんですかね…[l]\n病院行くか薬投入か、とにかく何か対処をしたいんですけど」":9,"なんだかんだ言って実際倒れてしまった訳で…[l]\n厳密にはおかしくなったのはその後だが、\n卵が先か鶏が先かというやつでひとつ。[l]\n……喩えが違うか。":10,"「え、憑かれてる？」":11,"まあ或る意味そんな気もしてますよ。[l]\n何に、かは言わずとも。":12,"「で、例のきぃ…西石も居る、[l]\n心当たりはあるにはあるんですが…」":13,"長久診療所、\nと言うと、":14,"「んむ？[l]\n其処って」":15,"早速難色を示された。":16,"「ああ…そうなんです。[l]\n三春の関係ですねぇ……[l]\n今日そこの誰だかが帰ってくるとかで、\nその御蔭で今日の色々が出来たんですが。[l]\n──やっぱり":17,"拙そうですかね、\n確約した訳じゃないんでどうとでも出来ますけど、\nそん時は何かしら見繕ってくださいよ？」":18,"「……無言」":19,"口に出てますがな。":20,"「…んむーぅ。[l]\n迷います。[l]\nどっちが良いのか……」":21,"「え？[l]\nどっちとは？[l]\n僕の体調なんてどうでも、という意味ですか、\nそれとも」":22,"「だってぇ、\n今の時点で、\nまこくんは三春関係者の娘達と":23,"悉く接触してるんで…」":24,"う。[l]\nま、まあ確かに、\nこっち来てからほぼ連日挙って次から次へと、\nまるで示し合わせたというか、競うかのように関係者が現れてる。":25,"お膝元なんだから当然と言えば当然なんだけど。":26,"「でもそれぁ僕の所為じゃないでがしょ？！[l]\n不可抗力ですよ、僕が手招いた訳では決して！」":27,"「それはどうかな…[l]\nへっへっへ」":28,"…何の意味の笑いですか。":29,"しかし、\n実際向こうの方から何故か、\n僕に対し秘密の開示を積極的にして来てるという事実、\n二件目に突入という訳だ…":30,"「ま、『不可抗力』なのは認めます。":31,"でねでねでね、\n長久診療所の…亡くなった人間は三春の主治医でしたし、[l]\n今日の色々というのは、その代わりを連れてきたんでしょう。":32,"恐らく実の娘ですね、あそこは中央に勉強に出してた…\nと聞いてます。[l]\n知狡から」":33,"「成る程、\nそう言えばきぃがヒミコさんとか呼んでたかな…」":34,"「知狡によれば":35,"永":36,"久":37,"卑":38,"尊ですね。[l]\n今後は彼女が三春のお抱え先生という事になるんでしょうね」":39,"「はあ、\nもう誰が誰やらですよ僕にとっては。[l]\n三春の系列って他にも居るんでしたっけ？」":40,"「えっと、丁度良いので整理しときましょうか。[l]\n此処、玄ノ森には有力者として三春の家が在りまして」":41,"人死にの出た二家、\n綾目、つまり姫様ちゃんの家で土産屋、\n永久、つまりきぃのバイト先の診療所、\nそれと狩屋、あの生意気女の家。":42,"「でですねえ、\n西國の方に更に三家の縁者が居て、祭に集合、\nと此処までは知狡からの情報で判ってるわけですね。":43,"そちらはそれこそ祭にならないとこっちに来ないでしょうから、\n現状接触は無いと思いますけど…[l]\n昨日今日のまこくんを視てると怪しいものです」":44,"そんな事言われましても…[l]\n僕とて好き好んでこのような事態を望んでる訳じゃ\nないんですよぅ。":45,"もし、これで西のその人等が先入りとかして来て、\n早々に僕に接触してくるような事態になれば、\nそれこそもう僕ぁそういう能力者だと思う事にします。":46,"…店に入った途端、ガラガラだった店内に次々と来客し始める、[l]\nというよく聞く話みたいだな。[l]\nあんな、自分がさも客を招き寄せたんだぜ、\nと":47,"宣":48,"巻く方々みたいなのは個人的にはヤだな…":49,"まあ、そんな事態にそもそも今度ばかりはなんないだろう、\nという希望的、否、常識的観測があるから言えるんだけど。":50,"「でも今日の件のようにですね、\n実際はもう既に、思いっきり懐に入っちゃってる訳です。[l]\n零距離射撃ですよねぇ。":51,"でも今回の成果を考えると\nいっそ積極的に取り入る方向に修正した方が…[l]\nと思いまして。":52,"何より、まこくん彼女らに気に入られてるようだし？[l]\n飯窪本家とも相談しないとですけど、\nこうなったら、\nまこくんの色仕掛けで懐柔してもらうのもアリかなーと」":53,"あの、僕は、\nそもそも顔が割れてないという理由で担ぎ出されたのだ。":54,"そうでしょ？[l]\n単なる荷物持ちとか言われてた気もするけど、\nそれ抜きにしてももう関係ないて？？":55,"「いやいやいやいや、\n冬夏とかはともかく、\n母親の方はもう、けんもほろろですし！":56,"冬夏だって僕等の真意を知ったらどう反応するか…」":57,"というかそうでもしないと僕がわざわざ色んな物を捨ててまで\n此処に来た意義が薄まっちゃうでしょう。":58,"学校に関しては諦めたとはいえ、\n僕とて多少は心に折り合いつけて生きてるつもりなのに…":59,"「でも話を聞く限り、冬夏ちゃん自身は情報流出を\n望んでるように思えますけど。":60,"古い因習に嫌気がさした若者ってやつ？[l]\n普通はそういうのは雑魚キャラなので手懐けてもしょうがないんですが、何しろ冬夏ちゃんはヒロイン格ですからねー。":61,"姫様ちゃん達も何かまこくんに御執心のようですが、\n彼女達同士が険悪ではちょっと気を遣わないといけない\nかもですし。":62,"うーん、まこくん奪い合うのは良いですが、\n好い方に転ぶかどうかの見極め難しいです…」":63,"…そういえば、":64,"何のことだか判らないけども、\nヤソウのシュから逃れたいとか、\n今はまだ事を起こしたくないとか、\n冬夏には、何かしら穏やかでない雰囲気はあるかもだ。":65,"僕の記憶力からすると奇跡的だな！":66,"いや、それはそれだ。":67,"「あのね…[l]\n毎度毎度そんな巫山戯けた事言ってて、\n事を成せずに困るのはそっちでしょうに」":68,"「んむ？[l]\nまこくんだって、本家や宮達に何かあったら\n大弱りですよ？[l]\n人事じゃないですよ？」":69,"「じゃあ余計に真面目にやって下さい。[l]\n今んとこ実働部隊は僕独りなんですよ」":70,"「ですから至って大真面目です。":71,"自分の価値観で他人の行動の貴賤を断ずるのは、\nヒトの悲しいサガですねぇまこくん。[l]\nまあ誰もがやってる事っすよ、気にしないで下さい」":72,"「は？[l]\nと、とにかく真剣にその…懐柔案を検討って[l]\n事ですか？」":73,"「ま、最終的な目的遂行に関してだけみれば順調ではありますし、当初よりフレキシブルに考えましょうか…":74,"何か色々予想外のコトが起きてるようですし…[l]\nうひひゲームは障害が多いほど面白…」":75,"「…い場合と単にストレス溜まるだけの場合が[l]\nあります、ってゲーム扱いですか。[l]\nそれに予想外って？」":76,"「んむ？[l]\nあー、気にしないでください。[l]\n諸々含めて言葉の綾です」":77,"「へええ言葉の綾ね…":78,"まあ仮にその案採用としても、\n先刻から話題になってる通り、\n何か彼女達は彼女達で内部軋轢があるようですから…":79,"あの、冬夏と姫様ちゃん以外にも。[l]\n面倒な事になりそうなんですが…」":80,"「んむ。[l]\nそこは巧く利用して、いい感じにやっちゃってください。[l]\nうひひひひひ」":81,"えええええーー！！[l]\n丸投げっすカーーー！！！":82,"「冗談ですってば。[l]\n逐一アドバイスしますよまこくんには」":83,"「………」":84,"「んむ？[l]\nあぁんまこくん、怒んないで下さいよぉ。[l]\n後でまた二人でお風呂入ろ？ね？」":85,"「なんかもうね、……[l]\n…じゃあ入りましょうよ。[l]\nお互いフルヌードで行きましょうか？」":86,"「ん…っむぅぅ。[l]\nい、い、いいよぉ？":87,"あ、やっぱだめっ。[l]\n混浴場は水着着用規則だしぃ、\n宮もまだ心の準備…":88,"──て、まこくん、今日はどしたです？[l]\n溜まってる？んですか？」":89,"「ああ、そうですねえ…[l]\nいろんなものが溜まってるかもですねえ……」":90,"え？[l]\nストレスとかですよ？":91,"「なうぅ、もう…まこくんてば！！」":92,"や、\nストレスとかですからね？":93,"「…まーそのうちガス抜きでも考えましょうね。[l]\nんむ？[l]\n個人に対して遣う言葉じゃないでしたか？[l]\nガス抜くって」":94,"「え、ああ。[l]\n普通は組織内の鬱積が噴出する前に晴らす事を言う、\nだった気がしますね…」":95,"宮さんも抜くとか抜かないとか、\n貴女の方が余程何かが溜まってるんじゃ…":96,"「んむぅ、宮としたことが…[l]\n":97,"ま、それはそれっ。[l]\n":98,"じゃーねぇ、お風呂、今度は競泳用でご一緒どうでしょ？":99,"うひひっ。[l]\nワンピばっかじゃ飽きますか？[l]\nセパレートのが好いのかな？」":100,"「いえ僕はワンピース派ですのでそちらで\n御願いします…":101,"──あのね宮さん、\nもう話いいですか？[l]\nご飯を食べたいです…」":102,"「あー、ご免なさい、もちょっと待って下さい。[l]\n月狂跳に関しても、もう少し具体的な事を\n教えた方が良いかもですね。":103,"前教えたように、月狂跳とは、\nマジモノとしての猫周りのネタ、\n特定の方向性を持った内容の資料の総称ですから、\n書籍の体裁をとってるとは限らないです。":104,"で、此処にある『紙様』、三春の屋敷神とも言える\n御神体、\n恐らく書籍の形態ではなく紙、\n一枚二枚の紙片の体裁でもおかしくはないす。":105,"で、ですよ。[l]\n聞いてますか？[l]\n聞こえてますか？[l]\nあのねあのね……」":106,"向こうに居た時はあんまり電話とかしなかったから\n判んなかったけど、\n多分宮さん、電話はなかなか切ってくれないタイプだな。":107,"切り際になると話題を繋げようとする方々ね…[l]\nそして何でかそういうのに限って何度も同じ話題なの。":108,"今は電話じゃないし料金もないから良いけどね…[l]\n誰かとは真逆という事か…":109,"「んむ？[l]\n何か言いたそうですけど」":110,"もう今の段階で何言われても右から左なんですよ…[l]\nて、あ。":111,"「あ、いえ、あそう、まだ言う事ありました。":112,"あのう…ですね。[l]\nまたぞろなんですけど、\n成り行きという奴で…":113,"何か新学期早々、学校行事があるとかで。[l]\n今回はまた別口の依頼人から秘密潜入を要請されました…[l]\nえーと何だっけ、はちみつぶんぶん…じゃないな」":114,"「…蜂蜜？[l]\nひょっとして『神使八乃舞』ですか？[l]\nん、それ、確か部外者は」":115,"「あれ、宮さん知ってたんですか？[l]\nそです、入れないらしいすね。だから秘密潜入」":116,"「ですよ。[l]\nどうするんす？」":117,"「………えーとですね、」":118,"…また弄られるのはもう諦めて簡潔に説明する。":119,"「まじー！？観に行きたいっ！でもなあー、宮行くのはヤバいなー。":120,"もうまこくん全く肝心なことを忘れてるんだからぁ！[l]\nてかほら、だから向こうから寄って来るんだよまこくんにはぁ。[l]\n":121,"これでもう間違い無いすね、そっち方向にシフトは真剣に考えよ」":122,"いや、ヤバくはないでしょう宮さん、\n僕よりは全然通用するだろ…[l]\nてそういう事じゃないのか。":123,"あと、女子が寄って来る特性というより、\n女子に弄られ易いオーラに矯正されたんだと思います。[l]\n宮さんに。":124,"「で、結局連日女子との待ち合わせです…[l]\nモテてモテて困りますよあはは……」":125,"「あのねまこくん。[l]\n女子はねぇ、厭な相手にも、\n表面上それなりに接する事くらい余裕で出来ますよ。":126,"あんまり女子と接し慣れてない人が勘違いしちゃう位には\n愛想良くね。[l]\nちょっと接近された位であまり浮かれるのはどうかなあ…」":127,"「冗句に決まってるでしょう。[l]\n別に誤解してませんし、\n舞い上がってるつもりもないですけど」":128,"まあ…完全なフラットだったかと言われれば、[l]\nそりゃあ或る程度気にはなったけども、\nそりゃ通常生活の範囲内で起こる程度ですよ。":129,"狩屋が僕に対して敵意剥き出しだったから、\n若干そういう感覚は忘れてたかもだが。[l]\nそれにしたって大体、あなたが言っても説得力に欠けませんか。[l]\nというかムキになってますか。":130,"……まさか妬いてるって事は無いだろうが、[l]\n玩具取られて悔しがってる、くらいの感覚はあるかもな…[l]\n僕が自覚してどうするそれを。":131,"「分かりましたよ。[l]\nじゃあ宮さんからのセクハラもその程度だと思っておきます。[l]\n変に勘違いしないように心得ますよ」":132,"「んむ？[l]\n":133,"や、あのね、もう、またそんなー。[l]\n":134,"分かってる癖に宮の気持ちはー♪」":135,"より一層分からなくなりました。":136,"「そうそう、まこくんで遊ぶのに夢中で忘れてましたが、\nその行事、演劇？歌劇だったかな？でしたね。":137,"玄ノ森の内輪の人間限定で有名ですね。[l]\nまこくんママはどうだったかな、知狡は確か参加してたかな」":138,"ああ、そうか。[l]\n飯窪も此処の人間だし、あの学舎に通った人間も居るだろう。[l]\nというか今そのものずばりで知狡さんの名が出たし。":139,"どんだけ古いか知らないが、宮さんも情報得られる環境では\nあった訳だ。":140,"母さんからは何も聞いてないが、\n真面目に秘密厳守してたのか、\nずぼらで忘れてたのか。[l]\n恐らく単に、全く興味が無かったんだろう。":141,"「多分に土地の伝承を謡ったものらしくて、\n内容的には祭とも多少リンクしてるですかね…[l]\n言葉は、普通使われない言語なんですよ」":142,"「あ、先刻ちょっとその、直で聞きました。[l]\nその謎言語。":143,"みゃんみゃんなんとか…[l]\nで、今朝方にチノさんもおんなじような言語をですね、\n言ってた気がするんですけども──":144,"あれ？[l]\nそういえば何か解読はタブーだとか言ってましたけど…」":145,"「あ、その辺、或る程度はもう聞いてるんですね。[l]\nまあ内容に関してはあくまで推測の域と言っておきましょう。[l]\n知狡たち、飯窪の者達が感得した印象がそうである、\nと言っても良いですけど。":146,"んー、歌は良いです。[l]\nリリンが生み出した文化の…[l]\nあれ、通じない？」":147,"「えっともしかして大神系のネタ話ですか？[l]\nリリンがリリスの子孫という話…じゃないようですね」":148,"「んむー、これくらい基本だと思ってましたが、\n時代ですかねえ…んむんむ。[l]\nまあそれはそれ、\n":149,"歌は対人用実践魔術の究極、というのが宮達の持論です。[l]\n時間は尺度に過ぎませんから、実際には相の遷移ですね。":150,"その媒質の相遷移、つまり振動、エネルギーの転換構造、\nそれがいわばマナに見立てられるとでも言いましょうか。":151,"振動は音となり媒質を伝播するのです。[l]\n歌詞は呪文、ヒトに対しては感情にすら定向性を持たせ得る\nマホウのコトノハ」":152,"「…宮さんゲームのし過ぎじゃないすか。[l]\n何ですかいきなり魔法がどうとか…[l]\n僕の仕事に関係ある話ですかそれ？」":153,"「んむっ。[l]\n趣味じゃなかったですか？[l]\n妖怪ネタとかそっち系詳しいのに…」":154,"「いやまあそうですが…[l]\n話の持ってき方が唐突だったので若干引いたんですよ。[l]\n大神じゃあるまいし…」":155,"「あー。[l]\nかれおの彼氏さん。[l]\nまこくんの数少ない御友達ですね」":156,"「悪かったですね交友関係が少なくて。":157,"これから増える可能性もあったのに\nたった一年で大学辞めさせられた身にもなって下さい。[l]\nあんまり彼奴の事、話した事も無いですねそう言えば」":158,"「こっち来る前にかれおにちょっと聞きましたけど。[l]\n彼もなかなかにそっちの才がありそうですって」":159,"あの娘はあれで視る眼は有りますからね、\nと宮さんは変に誇らしげに言った。":160,"そっちの才てどっちの才だ。[l]\n怪しいネタとか中央の有名電気街方面のネタに精通とかそういうこと？":161,"まあ彼奴はユーザーというか消費者寄りでもないし、\n何か自分でも色々作ったり描いたりしてたしな…":162,"「うひひ。[l]\nところでですね。":163,"書にしたって書いて記す事によって説得力を持たしてあるけど、ノンフィクションかどうかは自己申告ですしね。":164,"メディアが『こうだ』と流す情報の真偽にしたって同じ、あらゆる受容器官が得る情報は、恣意的に入力元を細工されたら正否の判断は困難。":165,"特に現代に於いて人間のコミュニケーション手段は基本的に言葉ありきですから、人間にとって言の葉は呪以外のなにものでもない、":166,"と、誰かも言ってますねぇ」":167,"いきなり話がシフトしたようだが取り敢えず相槌を打つ。":168,"「使用してるシステムがそれしかない以上、\nその仕組みを解明し悪意を込めて操作するも容易な訳ですか」":169,"「水源が井戸一個しかないなら、その井戸に毒を放れば一発です。":170,"生物が多様化を求めて有性生殖してるのも、\n単一体のコピーだと、それを殺すもの、\n例えばウィルスが現れれば全滅しかねないから、\nと考えられてますね。":171,"そこまでして生物を永らえさせる意味までは分かりませんが。[l]\n意味なんてないかもですけど。[l]\nまあどっちでも――」":172,"そこまで喋って、ふと宮さんは話を止め、\nこういう話題はチノの専売にしてるんでした。[l]\nと言ってうひひ、と苦笑した。":173,"その話は赤の何とか仮説だっけ？と、[l]\nうろ覚えの記憶を辿ってると、\n皮肉めいてこう続けた。":174,"「ま、まこくんくらい本をそこそこ読んでる人には\nいちいち言うまでもない事でしょうけどね？[l]\nでも、言葉の呪に関しては、\n異言語間に於いて通じないものであるのも当然でして、\nそれを凌駕し得るものが歌、という事なんです」":175,"祭にせよ儀式にせよ、\n確かに全世界的にみて、あらゆる文化圏で\n音楽というものが、神霊的な場に於いて重要な位相を占めている。":176,"それこそ音だけでトランス状態入れる事例もある訳で、\nライヴな音楽というのは身体的にも影響があるのだろう。":177,"また、音楽や歌が記憶の引き出しの取っ手足り得る事もある。":178,"「重低音とか高周波で苛々したり鼻血でたり、\nヒトには聞こえない領域ですら物理変化をもたらすのが音、\nつまりは媒質の振動なのですね。":179,"最近は振動を電力に変えたりとかいう技術があったんじゃ\nなかったですかね？」":180,"「その話は聞いたこと無いですけどそうなんですか？":181,"まあそこまで言われりゃあ、\n僕とて歌を魔法と呼ぶに":182,"吝かではないですがね…[l]\n歌は万国共通の文化ですしね…」":183,"「そういう観点で視ますとですね、\nよく言われるマナとは、\nつまり大気であり水であり、ひいては肉自体、\n振動し音を伝達可能なもの、と言えなくもないですね。":184,"──という思考遊戯をチノとよくやるんです。[l]\nというお話でした。[l]\nま、正にどうでもいいんですけど」":185,"宮さん、そう言いながらこの後も、\nなんだっけ、":186,"結局、歌という形で伝えるというのはある種理に適っていて、\n万国どころか万物共通足りえる記録媒体がどうのこうの、\nどこまで本気か判らない話をなされたので御座います。":187,"実際は言うまでも無く本気ではないだろうけど。":188,"「であ、他に報告し忘れないですか？[l]\nじゃ、今度こそご飯行きましょうか？」":189,"「――何か忘れてる気がするんですがね。[l]\n…………………[l]\n…………………[l]\n…………………あ！」":190,"「おうあ！？[l]\nな、なに」":191,"莫迦か僕は。[l]\n今日何のために朝から動いてきたんだ。":192,"「今日の物理的成果ですよ！[l]\n冒頭から話が横滑りしまくったので忘れるとこだった」":193,"「──まこくんそれを忘れますか。[l]\n健忘症？大丈夫？」":194,"「ほっといてください。[l]\n昼飯喰ってないんですししょうがないでしょう。":195,"寝起きと空腹時には対応が人以上に雑になるんです僕ぁ。[l]\n先刻から飯を喰わせないでいたのは宮さんでしょうに。[l]\nそんな事よりこれですこれ」":196,"「言ってくれてたらすぐご飯にした…の……[l]\nんむ………？」":197,"「言いました言いましたよ。[l]\nそしたらちょっと待てと言われたんでしょ！[l]\nで、それですがね、\nこれがまたどうやら蔵の中に大量にあるかもで…」":198,"受け取るなり、予想通り反応してくれる宮さん。[l]\n良かった、やはり何かしら関係のあるものである可能性が高そうだ。[l]\n飯の件はもう言った言わないはどうでも良いです早く行きましょう。":199,"って、宮さん。[l]\nちょっと見入ってしまってるな。":200,"眼の色が違う。[l]\nおお、ほんとに違う色にみえるぜ…[l]\n腹限界来たか僕。":201,"眼の前がちかちか、瞬きした瞼の裏の光の明滅、\n眼を開いてても視えるよおかあさーん！":202,"「…ええと、もう限界なんですわ……[l]\n詳しい事は御昼の最中か後にしませんか……？[l]\n宮さん？」":203,"「まこくん……」":204,"「へい？」":205,"「ありがとうございました。[l]\n大変役に立ちました。":206,"明日でしたっけ？病院行きたいの。[l]\nそこ、長久、構いませんよそこで。[l]\n何かまた三春関係者と":207,"懇ろになったら\n報告して下さい。":208,"…眼は多分気のせいでしょうし、最初から疲労で点滴御願いします、[l]\nが好いかもですけどね」":209,"「………。[l]\nは、はあ。[l]\nわかりました……」":210,"何か雰囲気変わったな、というか上の空？[l]\n別の事に集中しているもよう。[l]\n余程その紙に何かあるのだろう。[l]\nそれは何より。":211,"「んむっ、神使八乃舞もしっかり堪能してきてくださいよ。[l]\nああ、出来ればまこくんのその艶姿、写真を撮っておきたい…」":212,"そこはまだ現思考の範疇にあるんかい。":213,"「さ、飯行きましょう飯。[l]\nそしたら昼寝しますもう今日は」":214,"「おー？[l]\n添い寝して欲しいの？[l]\n好いよ？」":215,"「ちげーーよ！」":216,"「えぇー？[l]\n折角今日のご褒美に或る程度までは色々許そうと思ったのにー。[l]\nんむー、勿体無い事するなーまこくんはー」":217,"「………冗談は顔だけにして頂いて、[l]\n喰いに行きますよほら！ほらほら！！」":218,"「ホントなんだけどなぁ……」":219,"聞こえてたけど、\n敢えて黙殺。[l]\n貴女の事を考えるとほんとに色んな意味で切なくなるよ。[l]\n切なくね…":220,"「宮さん、僕はあなたが………です」":221,"「んむ？[l]\nなにー？」":222,"「……いえ、何でも──」":223,"「んむー？[l]\n良いですけど。[l]\nうひひっ。[l]\n":224,"じゃっ、行きましょーか」":225,"微妙に近い距離で連れ立って歩き出す僕等。":226,"姫様ちゃんが視たら一体どういう反応するんだか、\nと思う時点で彼女と宮さんに対して自意識過剰というものだ。":227,"…まあ、健全男子としてそんくらいの妄想はいいでしょ、[l]\n虚しさは覚悟の上さ。":228,"──冬夏の太腿が何故かそこで想起されてしまうのはどうだ…[l]\n妄想の連鎖が！！いやーーー！！":229,"脳空転の弊害が此処にも！[l]\n思考回転にブレーキが効かなくなるのが脳空転ですから！":230,"…もうええ、飯行く。[l]\nふらつきながら僕は、宮さんと何とか歩調を合わせて、\n飯へと向かった。":231,"食欲と性欲の、状況に":232,"因る優劣の遷移は如何に、\nなどという無駄な思考は暴走しっぱなしだったけど。":233},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_016.ks","relPath":"/data/scenario/SC_M_016.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":234,"length":234,"percent":100},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[176,1],"note":"完成"},"/data/scenario/SC_M_017.ks":{"data":[["現状に於いて当然の事象だが、今日も今日が始まる。[l]\n４月１０日月曜日、\n冬夏達の学校はいよいよ本格的に新学期が始まる訳だ。[l]\n…大学ももう始まってるか。[l]\n新入生としてしか大学の年度始めを知らないから、\n一体どんな感じなのかさっぱりだが、\nもう多分経験する事は無い。[l]\n大神、彼奴何してるんだかなあ。[l]\n例のそっち系サークルの勧誘でもしてんのかな。[l]\nかれお嬢と上手くやってるんだかな。[l]\n良いねえ青春謳歌。","虽是现状使然，但今天也如期开始了。[l]\n4月10日星期一，\n冬夏她们的学校终于要正式迎来新学期。[l]\n…大学应该也开学了吧。[l]\n我只经历过作为新生的开学季，\n完全不知道其他情形，\n而且大概再没机会体验了。[l]\n大神那家伙在干嘛呢。[l]\n该不会在搞那个同好会的招新吧。[l]\n和卡蕾欧小姐处得还好吗。[l]\n真好啊挥洒青春。"],["此方はと言えば昨日は昼寝だの風呂だので、\n宮さんと色々ドタバタがあったがそれはまたの講釈で。[l]\nてか実際どうでもいいんですそれは。[l]\n","至于我这边，昨天又是午睡又是泡澡，\n和宫小姐闹出不少动静不过暂且按下不表。[l]\n其实那些根本无关紧要啦。[l]\n"],["爛れた情愛の","若是糜烂的"],["情","情"],["景だったらまだ\n描写のし甲斐もあろうものだが、\n例によって例による訳ですからね。[l]\n否、仮に宮さんとの淫靡な","爱场景的话\n或许还值得描写一番，\n但这次照例又是老套路啦。[l]\n不、即便假设和宫小姐有过"],["目","淫靡"],["合があったとしてもだ、\n語るに値するとはとても…[l]\nや、改めてそんな独り思考はどうでもいいや。[l]\n妄想家か僕は。","的对视，\n也根本不值得讲述…[l]\n啊、重新想想这种独白根本无所谓啦。[l]\n我真是个妄想家。"],["さて、\n夕べはきぃに電話し、\n明日つまり今日に診療所行く旨伝えたので、\n今朝は軽めの飯、クロワッサンと牛乳。[l]\nそれにしても美味い牛乳って、ほんとに美味いよなあ…[l]\n宮さんは…昨夜の色々が響いてまだ寝てるかな多分。","话说，\n昨晚给小贵打了电话，\n告知了明天也就是今天要去诊所的事，\n今早就简单吃了可颂面包配牛奶。[l]\n不过好喝的牛奶啊，真的是超级美味呢…[l]\n宫小姐…大概还因为昨晚的激烈运动在补觉吧。"],["その宮さんからは夕べ既に今後の方策転換について\n諸々話をされていて、\n今日の通院に関してもまあ凡そ前日の話通り、\nブドウ糖液注射というか、点滴でいんじゃね？という[l]\n","那位宫小姐昨晚就已经跟我谈了今后方针转变的事\n讲了很多内容，\n今天的复诊嘛基本也按照前一天说好的，\n说是要打葡萄糖注射液或者说挂点滴来着？[l]\n"],["等","采纳了"],["閑な宮さんの言い分を入れて、\n且つそこで何か情報を得られるような感触があれば、\n積極的に取り入ってみるも良しという、\n相も変わらず行当たりばったりな…いやいや、[l]\n臨機応変の方向で行く、という事になっている。","采纳了漫不经心的宫小姐的意见，\n而且如果感觉在那里能获取什么情报的话，\n积极尝试吸收也未尝不可，\n依旧是走一步看一步的...啊不不、[l]\n应该说是按照随机应变的方向来推进。"],["「事態は流動的、フレキシブルな選択肢があった方が\n元来的に不如意な外的脅威に対処出来る可能性が広がるでしょう。","「事态是流动的，保持灵活多样的选择\n本质上能更有效应对难以预料的外部威胁吧。」"],["生物の多様性は結局のところその表出、\n『どれであろうと生き残らせる事が最優先の命題』であるが故という仮説を想起させるに足るものと思っていますけどね。","生物多样性归根结底正是其表现，\n足以让人想起『无论如何生存下去才是首要命题』这个假说呢。"],["世界を認識し得る『観測者の眼』さえあればこの世は在ると。[l]\n","只要存在能认知世界的『观测者之眼』，这世界就存在。[l]\n"],["ある種最悪の事ですがね、それが前提で許可されているセカイというのは。","虽然某种程度上是最糟糕的状况呢，这个被默许存在的世界。"],["有限の素材とフィールドを与えられて、互いに牽制のし合い、\n遷移し続ける世界を存在させ続けながら同時に、","被赋予有限的素材与场地，彼此互相牵制，\n在不断变迁的世界中持续存在的同时，"],["不慮の消滅に対しての保険が常に用意させられる事を行動原理的に埋め込まれたが故に相争うべき存在でありながら同じ場に押し込まれ詰め込まれるのを余儀なくされる、もはや悲哀というよりこれは……ですよ。","由于行动原理上被植入必须常备应对意外消亡的保险，虽是应当相互争斗的存在却被硬塞进同一处空间，与其说是悲哀不如说是……"],["逆に言えば観測者が居なければこの世界は無いのと同じですね。[l]\n","反过来说若没有观测者，这世界便等同于不存在呢。[l]\n"],["主観からすればですがね。[l]\nいずれ結局、認識外の事を意識するもしないも、\n","虽说是从主观角度来看就是了。[l]\n终究无论是否意识到认知外的事物，\n"],["残念ながら大勢にとってどっちでもいいようですが」","可惜对大多数人而言都无所谓吧」"],["「ま、毎度ご苦労様です……が、[l]\nあの…それと今回の話て繋がります…？」","「嘛、每次都辛苦你了……不过，[l]\n那个…这和本次事件有关联…？」"],["チノ嬢とはまた朝食時に逢った。[l]\n今日も今日とて、マスクは外さないらしい。","与千乃小姐又在早餐时分相遇了。[l]\n今天也依旧不肯摘下面罩。"],["出逢いの語りから鑑みるに、\n風邪だの花粉だのでマスクを着用してる訳ではないようなんだが、\nなんだろう。","从初遇时的谈话来推断，\n似乎并非因感冒或花粉症才戴着口罩，\n真是搞不懂。"],["顔に自信無い？[l]\nいあ、そういうキャラじゃないよなあ。[l]\nんなことよりも、出逢い頭に語る内容ですかそれは。","是对自己的脸没自信吗？[l]\n哎呀，不是这种设定啦。[l]\n比起这个，初次见面就聊这种内容合适吗？"],["「ん？[l]\nあいえ、\n宮店長の言い訳を小難しく代弁してるんですけどね。","「嗯？[l]\n那个，\n我只是在拐弯抹角替宫店长辩解而已。"],["ん？[l]\n小賢しく？[l]\nまあ、」","嗯？[l]\n拐弯抹角？[l]\n嘛，」"],["「どっちでもいいですね…[l]\nそこ以前の時点で…[l]\nそれにその、突然その話題から入られたというのは、\nまた察して頂いたという事ですか」","「怎样都无所谓啦…[l]\n在那之前的问题…[l]\n而且那个，突然切入这种话题，\n又是在考验我的洞察力吗」"],["「そうですね。[l]\nですので宮店長の事は暖かい眼で視て差し上げて頂ければと思います。","「是啊。[l]\n所以希望各位能用温暖的目光看待宫店长。"],["ん？[l]\n使い方間違ってるか？[l]\nどっちでもいいですが。[l]\n──意図は伝わってるようですし。","嗯？[l]\n用错词了？[l]\n怎样都行啦。[l]\n──反正您明白我的意思。"],["いつもは宮店長が仕切る訳では無いので。[l]\n","平时也不是由宫店长负责安排的。[l]\n"],["まだ","还"],["熟れてないのですよ、あの」","没成熟呢，那个」"],["「えあ、本家の仕事とやらですか？[l]\nまあ、はあ…ところで」","「呃啊，是本家的工作之类的吗？[l]\n嘛，哈…话说」"],["話がまた長引きそうだったので、\n無理矢理話を別件に移行。","眼看话题又要拖长，\n强行将话题转到别的事情上。"],["「知狡さん知りませんか？[l]\nちょっと道を訊きたいんですが…」","「请问知狡阿姨在吗？[l]\n想打听下路…」"],["「ああ、今日行く処ですか。[l]\n別に私が教示しても構わ──、\n","「啊，是今天要去的地方吗。[l]\n其实我来指路也没关系──，\n"],["おはようチズル」","早上好小知」"],["後ろを振り向きもせずに、\nチノ嬢が突然そう言った矢先、\n確かに其処に知狡さんが立っていたのだった。","连头都没回，\n就在千乃小姐突然这么说的瞬间，\n确实看到知狡阿姨就站在那里。"],["「お早う。[l]\n真言も。[l]\n大変だそうだな」","「早啊。[l]\n真言也是。[l]\n听说挺辛苦的」"],["「おはようございます。","「早上好。"],["大変で言ったら宮さんと会ってからこっち\nずっとそうなんですけどね…[l]\nというか、知狡さんこそ何か顔色が…」","要说辛苦的话自从见到宫小姐之后\n就一直是这样呢…[l]\n话说回来，知狡阿姨的脸色好像有点…」"],["「…そうかな、そう視えるかな。[l]\nいや、いつもの事だ、心配してくれなくても大丈夫だよ」","「…是吗，看起来是这样吗。[l]\n不，老样子了，不用担心我啦」"],["「そうですか？[l]\nにしても只でさえ今仕事忙しいんでしょう、\n僕等が邪魔になってるんじゃないかと気になりますよ…」","「这样吗？[l]\n不过您现在工作本来就很忙吧，\n我总担心我们会不会碍事…」"],["本人は否定してるが、\n知狡さんはどうにも日に日に憔悴してるように視え、\n僕なんかよりもずっと病院行ったほうが良いんじゃ…[l]\nと思う。[l]\nまさか宮さんと僕が何かしらの負担になってんじゃないか、\nと心配というか自責の念に駆られるよ、\n夕べのような事もあると。","虽然本人否认，\n但知狡阿姨看起来确实日渐憔悴，\n比起我这种人是不是更应该去医院…[l]\n这么想着。[l]\n该不会我和宫小姐成了什么负担吧，\n这种担忧或者说自责感涌上心头，\n特别是昨晚那件事之后。"],["彼女自身が大丈夫って言ってるし、僕も日ごろの知狡さんを\n視てる訳ではない為強くは言えないが、\nもう少し宮さん、大人しくしたらと思うわい…","她本人说没事，而且我平时也\n没怎么见到知狡阿姨所以不好多说，\n但宫小姐要是能再安分点就好了啊…"],["「大丈夫、私達はそんなにヤワじゃないので。[l]\n色々と仕込まれてますし。[l]\n宮店長と一緒の仕事は特にブーストかけますから」","「没事的，我们没那么脆弱。[l]\n受过各种训练呢。[l]\n尤其是和宫店长共事时会特别打起精神」"],["「そういう事だ。[l]\nで、何か用があったんじゃないのか？[l]\n私に」","「就是这么回事。[l]\n所以，是找我有事吧？[l]\n我」"],["「あ、えーとそうです。[l]\nあの…」","「啊，呃是的。[l]\n那个…」"],["心苦しくも知狡さんに場所を教えて貰い、\n残ってたクロワッサンを食し尽くして、牛乳をもう半杯だけ\nお代わりし出発する。","虽然过意不去还是请知狡阿姨指了路，\n吃完剩下的牛角面包，又续了半杯牛奶\n便出发了。"],["「ほんとに済みません、\nじゃあ早く僕も元気になって、知狡さんに迷惑かけないように\nします…じゃあ」","「实在抱歉，\n我会尽快恢复精神不给知狡阿姨添麻烦\n的…那么」"],["ロビーから玄関を抜け、出発する僕を見送る知狡さんが、","知狡阿姨目送我穿过大堂正门离开，"],["「……今日もお前に幸あれと願う──」","「……愿你今日仍得福佑──」"],["何か言ったように聞こえたが、\n閉まる自動ドアで幽かな声は聞き取ることは出来ず、\n振り向くともう彼女もチノ嬢も、\n背を向けて歩み去るところだった。","似乎听到她说了什么，\n但自动门关闭时的微弱声响让人听不真切，\n回头时她和千乃小姐都已\n转身离去了。"],["昨夜の一件と朝の微妙な空気を経て、\n幸か不幸か気持ち低めのテンションになった僕は、\n今ようやくその診療所に着いた、のだが。","经历昨晚的事和今早微妙的氛围后，\n不知幸运与否，情绪低落的我\n现在终于抵达了那家诊所，然而。"],["「これは、…病院規模じゃないのは分かってたけども…」","「这个…虽然早知道规模比不上医院…」"],["ほんとに町の診療所なんだな。[l]\n三春のお抱えだっていうから、\nそれなりに立派な建物というか、\n中央並の施設を想像してたんだが、\n実際に眼の前に在るのは、\n周囲の景色に全く違和感なく溶け込む、\n寂れた一軒家だった。","还真是镇上的诊所啊。[l]\n虽说听说是三春家专属的，\n想着至少该是栋像样的建筑、\n或者有中央级别设施的，\n实际出现在眼前的却是\n与周围景色毫无违和感融为一体的、\n一栋破旧独栋房屋。"],["塀には枯れた蔦が絡まり、\n何というか、埋もれている感じがする。","围墙上爬满枯藤、\n该怎么说呢，有种被埋没的感觉。"],["そして、\n玄ノ森の駅のような錆びれた鉄板の看板が、\n門扉の横に打ち付けてあった。[l]\n『長久診療所』──","而且、\n就像玄之森车站那样的生锈铁板招牌、\n被钉在门扉旁边。[l]\n『长久诊所』──"],["「ふおおーい、\nおっはよう。[l]\nこちらでございますよぉ」","「喂——嗨、\n早上好。[l]\n就是这里哦——」"],["少し離れた道路を箒で掃いていた、","在稍远处道路上用扫帚打扫的、"],["「あ、居たのかきぃ。[l]\nおう…、て、あ…れ？[l]\n何かあれだな、\nそのなんというか、…卑猥な感じだなそれ」","「啊、小贵你在啊。[l]\n哟…呃、啊…咧？[l]\n总觉得那个、\n该怎么说呢…有种下流的感觉啊那个」"],["きぃは何故かえらいミニ丈で無駄にタイトな、\nまるで…なＤＶＤのような看護婦の──[l]\nいやもうナースと呼称した方が良いなこれ。","小贵不知为何穿着超级迷你又紧得要命的、\n简直就是…那种DVD里的护士装──[l]\n不这已经该直接叫情趣护士了吧。"],["その制服に身を包み、しかしそれとは対照的に地味で無骨、\n手に握られた昔ながらのリアル竹箒が物凄く不釣合いであり、\n…何というか色んな意味で直視しづらい。","虽然裹着这身制服，手里却违和感爆表地握着、\n与装扮截然相反的朴实老旧真竹扫帚、\n…该说各方面都让人难以直视。"],["「ヒワイ？[l]\n…なんなのさ、ひわいって？」","「下流？[l]\n…啥意思啊，下流是啥？」"],["「えろぃ…っていやその、[l]\nなんでもないよ。[l]\nお前、バイトって看護婦とか？","「色情…啊不是那个、[l]\n当我没说。[l]\n你打工当护士之类的？"],["…そんなバイトあるかな、医療関係て資格とか\n色々ありそうだけど」","…有这种兼职吗，医疗行业不是需要\n各种资格证的样子」"],["「まあ、資格っていうか…[l]\n家事手伝いみたいな？[l]\n小間使いっていうの？","「嘛，与其说资格…[l]\n算家务帮手那种？[l]\n打杂小妹？"],["マスコット？コンパニオン？番組アシスタント？[l]\nチラシおあティッシュ配り？[l]\nそういうレベルでのお手伝い…で済む感じで？","吉祥物？陪护员？节目助理？[l]\n发传单递纸巾？[l]\n就这种程度帮忙…差不多啦。"],["卑尊さんのお友達に縁があって、使ってもらってるのさ。[l]\nこないだ言った通り、\nその…私は三春の親戚じゃないけど」","托卑尊小姐朋友的关系才有机会做的。[l]\n就像之前说的、\n那个…我虽然不算三春家亲戚」"],["「何だお前えらい歯切れ悪いな…[l]\nまあ、問題ない事情なら良いけど、\n危ない事はすんなよ？[l]\nて、じゃその格好は何よ」","「你这家伙说话怎么支支吾吾的…[l]\n算了，只要不是有问题的情况就好、\n别干危险的事啊？[l]\n话说这身打扮又是闹哪样」"],["「これ？[l]\n趣味さ。[l]\n似合うでしょ？[l]\nいっつも着たきりナントカだからさ、\nたまにこういうの着たいと思うんだわ。[l]\nやっすいの売ってるしさ、こういう職業制服系のって」","「这个？[l]\n兴趣啦。[l]\n很配我吧？[l]\n平时总穿得破破烂烂的、\n偶尔也想穿穿这种嘛。[l]\n反正便宜货到处有卖啦，这种职业制服系的」"],["「ほんとかよ…[l]\n変な店と間違われないか？それは。[l]\n中央の方で同じ事やったら完全に風…いやその」","「真假啊…[l]\n不会被误认成奇怪店铺吗？这样。[l]\n在中央区穿这样绝对会被当成风…呃那个」"],["「なぁに？[l]\nま、いいのだわ。[l]\nホントはその私を仲介してくれた人の趣味なのさ。[l]\n色々してくれる一環でこういう服もたまに呉れるよ。[l]\n本心でも私こういうのキライじゃないし。[l]\n患者さんも喜んでるよ。誉めてくれるヨ」","「啥呀？[l]\n嘛，无所谓啦。[l]\n其实这是介绍我打工那位的兴趣啦。[l]\n作为各种关照的一环偶尔会给我这种衣服。[l]\n而且我自己也不讨厌这种。[l]\n病人们也很开心哦。都会夸我呢」"],["宮さんじゃあるまいし、きぃまでコスプレ好きっ子かよ。","又不是宫小姐，连小贵都成cosplay爱好者了吗。"],["「ふえ？[l]\nなにさ。[l]\nまこちゃんまでそんなに見惚れるほど？[l]\n止めてよぉー冬夏に怒られるのだわぁ」","「呜诶？[l]\n干嘛啦。[l]\n连小真都看入迷到这种程度？[l]\n快住手啦——会被冬夏骂的哟」"],["「クネクネすんな。[l]\n言ってる意味もようわからんぞ」","「别扭来扭去。[l]\n根本听不懂你在说啥」"],["と、下らない応酬でそうこうしてる内に、\nさっきまでのモヤモヤはまたどこかへ飛んでしまい、\nきぃに誘われるまま診療所の中へと向かう。","就这样进行着无聊的拌嘴时，\n方才的烦闷早已不知飞往何处，\n被小贵带着往诊所里走去。"],["て、あれ？[l]\nこっちは入り口では…","啊咧？[l]\n这边不是入口来着…"],["「あー、あのね、\nやっぱ今日は混んでるのさ。[l]\nで、まあ事情を説明したらこっちの方に案内を…[l]\nと言われたのだわ」","「啊——那个啊，\n今天果然人很多呢。[l]\n所以说明情况后就被带到这边…[l]\n是这么说的哟」"],["ああ、老人達が大挙してるのね。","啊，老人们扎堆的地方呢。"],["「さっき言ったとおり私はお飾りみたいなもんだから、\n現場に居てもすることないしね、まこちゃんのお相手を\n仰せつかりました。","「刚才也说过我就是个摆设啦，\n在现场也没事可做，就被吩咐\n来陪小真啦。"],["点滴だっけ？[l]\nそれ打って部屋で寝てたらいいってさ」","是要打点滴吧？[l]\n说是打完针在房间休息就好啦」"],["「え、それはまさかお前が注射する訳じゃないよな…？」","「喂、该不会是你来打针吧…？」"],["「あは？してほしい？[l]\nうそうそ、そん時くらいは卑尊さん来るさ。[l]\n安心するのだわ。","「啊哈？想让我打？[l]\n骗你的骗你的，那种时候卑尊医生会来的。[l]\n请放心哟。"],["ちなみに、その私の知り合いね、今日来てるのね。[l]\n西國の人なんだけど」","顺便一提，我那个熟人今天也在呢。[l]\n是西国的人哦」"],["言いながらきぃは歩き出し、僕はやはり、\n完全に居住空間の方へと案内されているようだった。[l]\n飯屋の時はこういうのも良いって思ってたけど、\nそれは風情とか佇まいの話であって、\n実際に居住エリア内に通されるのは、\nプライベート空間への侵犯のようでどうにも緊張するなー。[l]\n『ねこざんまい』でバイトしてた時も慣れるまで結構掛かった\nのに…","小贵边说边往前走，我这才发现\n完全是被带往居住区的样子。[l]\n在饭馆时还觉得这种设计不错，\n但那只是风情氛围的问题，\n实际被带进生活区域，\n总有种侵犯私人空间的紧张感啊。[l]\n在『猫三昧』打工时也花了好久才习惯\n的说…"],["カーテンの張ってある、\n下半分が","穿过挂着窗帘、\n下半截是"],["磨","磨"],["硝","砂"],["子の引き戸式玄関を抜けると、そこは一種の土間で、長椅子と、冬場には使用されるのであろう古いストーブが置いてあった。","玻璃的拉门玄关，眼前是类似土间的空间，摆着长椅和冬天才会用的旧火炉。"],["雰囲気的に、\nこっちはこっちで接客用のスペースのようである。","看氛围，\n这边应该也是接待区。"],["そして、その長椅子には既に二人の女性が座っていた。","而那张长椅上已经坐着两位女性。"],["「西石く～ん？[l]\nあ、そちらが例の患者さんかい？」","「西石君～？[l]\n啊，那位就是你说的患者吗？」"],["「あら、見かけない若い子じゃない、\n彼氏？」","「哎呀，是没见过的年轻人呢，\n男朋友？」"],["「そうです、この人ですよ奇士（きさむら）さん。[l]\nって、やですねー狩屋さん、違いますってぇ。","「没错，就是这位奇士小姐。[l]\n才不是啦——狩屋小姐，您搞错了啦。」"],["知り合いですってば。[l]\n昔此処に住んでたんですよぉ。[l]\n旅行で来たんですって」","都说是熟人啦。[l]\n以前在这边住过的。[l]\n说是来旅游的啦」"],["片方は、\n頭や腕、足に包帯を巻いた、\nお腹が大きい女性、\n……どうやら妊婦らしい。[l]\nだが妊婦さんの割りに","其中一位，\n头上、手臂和腿都缠着绷带、\n挺着大肚子的女性，\n……似乎是孕妇。[l]\n但作为孕妇来说"],["豪い物々しい風体……","打扮得未免太过夸张……"],["…あ。[l]\nか、狩屋？[l]\n狩屋ってあの狩屋か？","…啊。[l]\n狩、狩屋？[l]\n难道是那个狩屋家的人？"],["「西石君には、まあ、\n彼氏は難しいだろうねえ。[l]\nややや、どうも。僕は","「西石君的话，这个嘛，\n交男朋友确实很难吧。[l]\n哎呀呀，幸会。我是名叫"],["奇","奇"],["士","士"],["道","道"],["具と言う者です。[l]\n","具的人。[l]\n"],["初めましてどうぞ宜しく。光栄です。」","初次见面请多关照。很荣幸。」"],["もう独り、深々と長椅子に座り込み新聞を読んでいた人物が、\nばさりと新聞を脇に置いてにこやかに言った。","另一个独自深深陷在长椅里读报纸的人，\n哗啦一声把报纸搁到旁边，笑眯眯地说道。"],["歳は…若くは無いがおばさんという程でもない。[l]\n狩屋さんに比べて年齢が判り難い…が、[l]\n頭髪が脱色したのか染めたのか銀色のような白髪で、\nその前髪は顔右半分を隠している。","年龄…不算年轻但也没到阿姨的程度。[l]\n比起狩屋女士更难判断年纪…不过，[l]\n不知是褪色还是染发，头发呈现出银白色的状态，\n额前刘海遮住了右半边脸。"],["咥え煙草のようなモノを口にしているが、\n火も煙も出てないので、\n…チョコか禁煙用フィルターか、[l]\nまさか流石に医療現場で煙草は吸わんでしょうし。","嘴里叼着像是香烟的东西，\n但既没有火也没有烟，\n…是巧克力还是戒烟滤嘴，[l]\n总不至于真的在医疗场所抽烟吧。"],["「ああ、どうも、い、えーと真言と言います。[l]\n宜しく初めまして…」","「啊、您好，我、呃叫真言。[l]\n初次见面请多指教…」"],["「あらら大人しいねー。[l]\nあたしの娘なんかもうそりゃ\nやかましいったらないよ、ねえ？」","「哎呀呀好文静呢～[l]\n我家女儿那可是吵得\n不得了呢，对吧？」"],["「ははは…[l]\n──あの、つかぬ事をお伺いしますが…[l]\nもしかして克杖…ちゃんの？」","「哈哈哈…[l]\n──那个，冒昧问个事…[l]\n莫非是克杖…小妹妹的？」"],["「ん？そうよ？[l]\n何もう知り合いなのあんた達？[l]\n聞いてないわあの娘ったらいつの間に」","「嗯？是呀？[l]\n怎么你们早就认识吗？[l]\n那孩子都没跟我提过什么时候结交的」"],["ああ、やっぱりそうなのか。","啊，果然是这样吗。"],["「あたしは狩屋","「我是狩屋"],["寧","宁"],["子、克杖の母です。[l]\n宜しくね」","子，克杖的母亲。[l]\n请多关照」"],["「さささ、お二人お二人、この男子は患者さんですよぉー。[l]\nそっとしといてあげてねー。[l]\nまこちゃんこっち来て」","「好啦好啦两位两位，这位男生可是患者哦～[l]\n让人家安静休息吧～[l]\n小真过来这边」"],["「んふふ、了解了解。お大事にね」","「嗯呼呼，明白明白。请保重呀」"],["このドウトモさん、冬夏とは別の意味でサバサバ感のある人だな。[l]\nもっと直截的に言えば、単純に男っぽい。[l]\nそもそも一人称が『僕』って…","这位道具小姐，和冬夏是不同类型的爽快人呢。[l]\n更直白地说，就是单纯像个男人。[l]\n本来第一人称就用『僕』…"],["スタイルも長身のようだし、スカートではなく細身のパンツで、\n化粧っ気もないようだ。[l]\n西國の方から来たっていうし…あ？[l]\nそうか忘れてた。","身材也像是高挑型，穿的不是裙子而是修身长裤，\n看起来也没化妆。[l]\n说是从西国来的…啊？[l]\n对了差点忘了。"],["西にも三春関係者が居るって話じゃなかったか？[l]\n卑尊さんの友達、って、そのまま西國の三春系列の人って事で\nあってもおかしくない。","不是说西边也有三春家的相关人士吗？[l]\n既然是卑尊女士的朋友，那直接就是西国三春系的人\n也没什么奇怪的。"],["…あんまり突っ込んで確認したくはないので取り敢えずは[l]\n大人しく点滴して貰おう。","…不太想深入确认就先[l]\n乖乖打点滴吧。"],["「ああ、ありがときぃ。[l]\n此処まで歩いて来られた時点でそんなに重い症状じゃないから…」","「啊，谢啦小贵。[l]\n能自己走到这儿说明症状不严重…」"],["「ふえ。[l]\nそういやそうなのだわ。[l]\nほんとは眼だっけ？調子悪いのは」","「咦。[l]\n说起来是这样呢。[l]\n其实不舒服的是眼睛来着？」"],["「…疲れだろうけどきっと。[l]\nホントに歩けない程なら\n…言っちゃ悪いけどもっと大きな病院行くし、[l]\nまあ、プラシーボ的な意味合いも込みだよ。今日来たのは」","「…大概是疲劳吧。[l]\n真要走不动路的话\n…说难听点就该去大医院了，[l]\n嘛，今天来也有点安慰剂效应的意思啦」"],["「プラシーボ、知ってるさ。[l]\nでも直に現場言っちゃいけないって言われてるのだわ。[l]\nあ、この長椅子に寝てて」","「安慰剂，我懂啦。[l]\n但现场直说这个可是违规的哦。[l]\n来，躺这张长椅上」"],["「はいよ…っと。[l]\nまあ、僕だって自覚の上じゃ意味無い筈だけどな。[l]\n思いの外に自己暗示ってのは理屈抜きでかかるもんなんだよ…[l]\nふー……」","「好嘞…嘿咻。[l]\n不过俺自己也清楚这样没意义就是了。[l]\n没想到自我暗示这东西还真能超越理论起作用啊…[l]\n呼──…」"],["土間から応接間らしき部屋に誘われると、\n酒瓶やら置物だのが飾られたガラス戸の棚があり、\nその前の一番長い","被从土间引到像是会客室的房间后，\n可见玻璃拉门橱柜里摆着酒瓶之类装饰品，\n被安置在前面那张最长的"],["長","长"],["椅子に寝かされた。[l]\nビニールの匂いがする昔の代物で、というかビニール張り。[l]\n冷たい感触が逆に気持ち好い。","椅上躺下了。[l]\n这是散发着塑料气味的旧式椅子，或者说塑料包面的。[l]\n冰凉的触感反而让人舒服。"],["「まあさっきから何度も言ってるとおりね、\n私は基本的にお飾りだから、\n点滴終わるまで出来るのは話し相手になる事くらいさ。[l]\n別に寝てても構わないし、\n好きにしてていいのだわ。[l]\n寝るなら私はどっかいってるし」","「嘛就像我刚才反复说的\n我基本上就是个摆设\n在输液结束前能做的也就是陪聊而已。[l]\n你要睡觉也没关系\n随你喜欢就好。[l]\n要睡的话我会回避的」"],["「ああ…いいよ……[l]\n多分寝ると思うから……」","「啊…好的……[l]\n我大概会睡会儿……」"],["「はーい。[l]\nじゃも少ししたら卑尊さん来るからさ。[l]\nここ閉めとくのだわ」","「好——[l]\n那过会儿卑尊小姐会来[l]\n我先关上门咯」"],["「わかった……[l]\nさんくす」","「知道了……[l]\n谢啦」"],["病室とかなら仕切りカーテンみたいなのをシャーっと\n閉めるのだろうが、此処は普通の部屋なので普通に戸を閉められた。[l]\nきぃはそのまま出て行き、仄暗い中に一人僕は眼を閉じる。","如果是病房应该会唰啦一声拉上隔帘\n但这里是普通房间，所以只是普通地关上了门。[l]\n小贵就这样离开，我在昏暗中独自闭上眼睛。"],["──しかし、\nきぃ、\n何だって西國の、しかも","──可是\n小贵\n为什么你会和西国"],["若しかすれば三春の系列の人間と\n親交があるんだ？[l]\nきぃなあ…[l]\n色々不可解な奴ではあるな……[l]\nきぃ…きーちゃ……は違うって…[l]\nにしてもねみぃ…[l]\n……………","甚至可能是三春派系的人\n有交情？[l]\n小贵啊…[l]\n你真是个充满谜团的家伙……[l]\n小贵…小姬……不是那样的…[l]\n不过好困…[l]\n……………"],["「ばかもの、トモ！[l]\n妊婦の前で何をしてる！表に出てろ阿呆！！[l]\n大体あんた」","「蠢货道具！[l]\n在孕妇面前干什么！滚到外面去白痴！！[l]\n你这人真是」"],["大声が戸の外から聞こえ、\n瞬時に覚醒する僕。[l]\nててて、急過ぎて流石に心臓に来た…[l]\n何事だよ。","门外传来怒吼声\n我瞬间清醒。[l]\n疼疼疼，突然惊醒心脏有点受不了…[l]\n搞什么啊。"],["「これ…煙草じゃないよミコ君。[l]\n僕がそんな非常識な事すると思うかね。[l]\n臭いだってしてないだろうに何で気付かないかな。","「这…不是烟啊卑尊。[l]\n你觉得我会做这么没常识的事吗[l]\n明明连烟味都没有，你怎么会误会呢"],["見た目で思い込み、早とちり、\nお客さんの前で恥ずかしくないか君は」","以貌取人，贸然断定\n在客人面前不觉得丢脸吗」"],["「──トモ、あんた、ほんとに、\nいい加減にしなさいよ」","「──道具，你真是\n该适可而止了」"],["「なんだミコ、昂ってもお国訛り出なくなっちゃったか。[l]\nごめんごめん、久し振りに揶いたくなっただけだよ。[l]\n流石中央に行ってただけの事はあるね、見直した」","「哎呀卑尊，激动得连乡音都没了呢[l]\n抱歉抱歉，只是好久没逗你了[l]\n不愧是去过中央的人，刮目相看了」"],["「…いいから出て行くか奥に入るかしてなさい、[l]\nもうこっちは戻ってきたばっかりで色々大変なのに、\n邪魔しないでくれる」","「…少废话，要么出去要么进里屋[l]\n我们刚回来正忙得不可开交\n别在这儿碍事」"],["「年長者に対する言葉遣いは直ってないんだから困るよねえ。[l]\nそれにねミコ、………」","「对年长者的措辞还是没改过来呢真让人头疼啊[l]\n而且啊卑尊，………」"],["「………ふん」","「………哼」"],["「まあ西も東も大変て事だよ。[l]\nさあほら、そっちに例の西石君の御友人がいらしてるよ。[l]\n早いところ処置しておあげよ。[l]\n忙しいんだろう君は」","「看来东西两边都不太平啊[l]\n快看，那边不是西石君的朋友在等着吗[l]\n赶紧给人处理下吧[l]\n你不是忙得很吗」"],["「あんたが黙ってれば済む話なのよ阿呆。[l]\n貴奴、こいつ連れてどっか行ってて頂戴」","「你闭嘴就没事了白痴[l]\n贵奴，把这家伙带出去」"],["聞き耳を立てていると突如戸が開いた。","正竖耳听着，门突然开了。"],["「あら、聞こえてました？[l]\n御免なさいね、全くお恥ずかしい処を…」","「哎呀，都听见啦？[l]\n真抱歉，让你见笑了…」"],["「あ、いえ…大丈夫です…[l]\nよ、宜しく御願いします」","「啊，没…没关系…[l]\n请、请多关照」"],["先程からの声の主、\nこの女性が","先前声音的主人，\n这位女性就是"],["永","永"],["久","久"],["卑","卑"],["尊──だろう。[l]\n白衣を羽織り、きりっとした印象、まさに女医の風である。","尊吧。[l]\n披着白大褂，给人干练的印象，正是女医生的风范。"],["先日まで中央に居たからかも知れないが、\n此処の人達に比べオーラが違う…気がする。","或许是因为直到前些日子还在中央的缘故，\n总觉得和这里的人们气场不同…"],["「あんなのでも一応身内…いえ長い付き合いですのでね、[l]\n──貴奴のお知り合いですってね？[l]\nまことさんでしたよね？」","「虽然那家伙也算自家人…不、因为交往甚密，[l]\n——听说你是贵奴的熟人？[l]\n是真言先生对吧？」"],["卑尊女医は終始にこやかな口調で話しかけてくるが、\n先程の遣り取りを聞くだに多分怒らすと怖いのだろう。","卑尊女医生始终用亲切的语调搭话，\n但光是听到先前的对话，就明白惹怒她大概会很可怕。"],["それに、初対面の女性の容姿をとやかく言うつもりは無いが、\n目付きが少々…据わってます、笑ってません。","而且，虽不打算对初次见面的女性容貌评头论足，\n但眼神稍微有点…太严肃了，没有笑意。"],["「そういえばこれって裏口から入りましたけど\n正当な医療ですよね…[l]\nあの、診察代とかは…」","「说起来我们是从后门进来的\n这算是正当医疗吧…[l]\n那个，诊疗费之类的…」"],["宮さんからも言われてたが、\n念のため保険証は無い振りで通すという策なのだった。","虽然宫小姐也提醒过，\n但为保险起见还是决定假装没有医保卡。"],["その分そこそこの予算渡されたが、\nいずれ虚偽には違いなく幾分緊張する。","为此拿到了不少预算，\n但终究属于作假行为难免紧张。"],["「あら…それは」","「哎呀…这个」"],["「ああ、気にしない気にしない。[l]\n幾らだろうと僕が出すから。[l]\nミコ、そういう処理で」","「啊，别在意别在意。[l]\n多少钱都由我来付。[l]\n卑尊，就这么处理吧」"],["「は？」","「哈？」"],["「…あんたまたそういう事を」","「…你又来这套」"],["突然外から声だけがした。[l]\nどっか行ってたんじゃなく其処に居たんですかい。","突然从外面传来声音。[l]\n原来你没走远一直在这儿啊。"],["盗み聞き…という程密閉性はないから、[l]\n単に洩れ聞こえてたんだろうが、\n何でまたそんな発言を？","算不上偷听…毕竟隔音不好，[l]\n只是声音自然传出来了，\n但为什么要说那种话？"],["「や、手持ちはそこそこ持ってきてますから…[l]\n大丈夫です…というか初対面の方に」","「不、我手头还算宽裕…[l]\n不必了…何况让初次见面的人」"],["診察代出してもらうなんぞ常識的に有り得ないだろう。","代付诊疗费常识上说不通吧。"],["「そう、巫山戯た事言ってないで早くどっかに行ってて頂戴」","「就是，别开玩笑了快点去别处呆着吧」"],["「僕の事は良く識ってるだろうミコ。[l]\n問題無いって」","「你很了解我的吧卑尊。[l]\n说了没问题的」"],["「あんたが決める事じゃないでしょ？！」","「这不该由你决定吧？！」"],["「この男子も、そう…身内みたいなものだろう。[l]\n僕にとっては知り合いの知り合いなのだしね。[l]\n兎に角僕が負担するって言ってるんだから。","「这位少年也算…半个自家人。[l]\n对我而言是熟人的熟人嘛。[l]\n总之既然我说了由我承担。"],["ミコはさっさと彼を元気にして老人達の御相手を\nするがいいのだ。[l]\nそれで万事解決なのだよ」","卑尊你赶快治好他让他去陪老人们\n不就好了。[l]\n这样所有问题都解决了」"],["「あんたのそういうの意味判んないわ…[l]\n知り合いの知り合いなんて他人じゃないの。","「你这种思维我真不懂…[l]\n熟人的熟人不还是外人吗。"],["全く毎度毎度施しのつもり？[l]\n人の上に立って優越…あ、[l]\n","难道每次都要施舍不成？[l]\n站在高处彰显优越…啊，[l]\n"],["あら、御免なさい、別に貴方を」","抱歉，不是在说你」"],["「あいえ、大丈夫です…[l]\n気にしてませんというか、事態がよく飲み込めてませんし…」","「没、没关系…[l]\n不如说还没搞清状况所以没放在心上…」"],["「それでは彼さえ良ければ、という事にしようか。[l]\n確かに僕も押し付けがましい、差し出がましい提案だったね。[l]\nさ、少年、どうするかね」","「那么只要他同意就行了对吧。[l]\n确实我的提议也有些强加于人、自作主张了。[l]\n来，少年，你怎么说」"],["「や、お心遣いは大変嬉しいんですが、\n自分で出します…」","「您的好意我很感激，\n但还是我自己来付…」"],["「でしょうね、それが良いわ。[l]\nごめんなさいね吃驚させて」","「果然呢，这样最好。[l]\n抱歉吓到你了」"],["「いえいえ…[l]\nここのところ突拍子も無い言動には慣れてきてるんで…あ」","「没事没事…[l]\n最近对这种突发奇想的言行已经习惯了…啊」"],["すみません、と謝った。[l]\n突拍子も無い言動だなんて、それこそ初対面の人に対して\n失礼だったか。[l]\nでもね、しょうがないよね今回は。一連だからな僕にとって。","连忙道歉。[l]\n说人家言行唐突，对初次见面的人\n这样讲或许更失礼。[l]\n不过嘛，这次也没办法。毕竟对我而言是连贯事件。"],["「んふふ、他ならぬ西石君の紹介の君だ、気にしないで呉れ給え。[l]\nまあ、僕も人生ユカイである事が信条なのでね。","「嗯呵呵，既然是西石君介绍的你，就别放在心上。[l]\n嘛，我的人生信条就是活得轻松自在。"],["こういった突発性のイヴェントは歓迎しているのだよ。[l]\nそこの堅物さんにはよく憤慨されるのだが」","这种突发性事件反而让我很欢迎呢。[l]\n经常被那边那个死板家伙训斥就是了」"],["「煩いわね。[l]\nあんたのが特殊なの。[l]\n","「吵死了。[l]\n是你太特殊了。[l]\n"],["あ、ごめんなさい。[l]\nまあ、そんな極端な金額じゃないから…」","啊，抱歉。[l]\n反正也不是什么夸张的金额…」"],["「卑尊さん、\nそろそろこっち…」","「卑尊医生，\n该过来这边了…」"],["「ああ今行くから。[l]\nトモが首突っ込むからややこしくなるのよ、\n","「啊啊这就来。[l]\n都是道具非要插嘴才搞得这么复杂，\n"],["貴奴、ほらさっさと連れ出して」","贵奴，快把人带出去啦」"],["「まあ、僕もこんな喋りだが西國の出だからね。[l]\nこの辺り東國の人間とはよく感覚的にズレる。[l]\n気に障ったなら申し訳ないね。","「嘛，虽然我说话是这种风格，但毕竟是西部出身。[l]\n和东部人经常会有认知偏差。[l]\n要是冒犯到你了我道歉。"],["では失礼。後は西石君がお相手するかな？[l]\nじゃあ」","先告辞了。接下来就交给西石君？[l]\n回见」"],["卑尊さんが慌しく準備を始め、\n僕に処置をするのを眺めながら、\n奇士さんは、","卑尊医生匆忙开始准备，\n一边看着我接受治疗，\n奇士小姐"],["「冬夏君に宜しく」","「代我向冬夏问好」"],["と言い残し何処かに立ち去った。","留下这句话就不知去向。"],["何故此処でその名前が…？[l]\nまあきぃから聞いててもおかしくはないし、\nそもそも三春の関係者ならば当然だ。","为什么这里会出现那个名字…？[l]\n不过从小贵那里听说也不奇怪，\n说到底如果是三春家相关人士就很正常。"],["で、何で、此処で、今、僕に対して？[l]\n…先刻の物言いといい、きぃが変な伝え方をしたのかなあ…[l]\nそういえば、冬夏には明後日の事何も伝えてないな…","但为何，在此刻，对我提起？[l]\n…结合刚才的说法，可能是小贵传达的方式有问题吧…[l]\n说起来还没告诉冬夏后天的事…"],["……いや、このまま黙っておこう…[l]\n色々弊害がありそうだし、\n…誤解されてもあれだしな……","……还是继续保持沉默吧…[l]\n感觉会引起各种麻烦，\n…被误会也很糟糕……"],["そうこうしてる間に、僕に処置を終えて忙しく部屋を出る\n卑尊さんと入れ替わりに、再びきぃが入って来た。","正这么想着时，结束治疗的我目送\n匆忙离开房间的卑尊医生，小贵又走了进来。"],["「えーとね、じゃ終わりそうになったら来るさ。[l]\nま、私も卑尊さん呼ぶだけだけどね。","「那个～等快结束的时候我会再来。[l]\n虽然也就是帮忙叫下卑尊医生啦。"],["寝るんだっけ？[l]\n私もういいかな？」","是要睡觉来着？[l]\n我可以先走了吗？」"],["「ああ、そうな。[l]\nきぃも色々する事あんだろうし…[l]\nいいよ付き添わなくても」","「啊，也是。[l]\n小贵也有自己的事要忙吧…[l]\n不用陪着我也行」"],["「ん、分かったのだわ。[l]\n道具さんも見張んなきゃいけないしね」","「嗯，知道啦。[l]\n还得看着道具小姐呢」"],["「お前あと、冬夏と僕が変な関係みたいに誤解してるだろ…[l]\nあんまり…余計な…ことを…ひとにいいふらすなよ……」","「你该不会误会我和冬夏有什么奇怪关系吧…[l]\n别到处…乱传…多余的事啊……」"],["気が抜けたのか……眠気が…[l]\n宮さんだけが疲れた訳じゃないしな…昨日は……","可能是放松下来了……困意…[l]\n毕竟不止宫小姐累…昨晚也……"],["「ふええ。[l]\n誤解してないよぉ。[l]\n言いふらしたわけでもないしぃ。","「呜诶。[l]\n才没误会啦。[l]\n也没有到处说哦。"],["見てるとさ、\nまこちゃんは好かれる性質なのだわ」","不过看起来呢，\n小真你很招人喜欢呢」"],["──の娘達にね、","──特别是她们家的女儿们"],["何を言ったか分からないが、\nもういいや……","虽然听不懂在说什么，\n算了……"],["「──だと…いいけど…な……[l]\nモテモテだぁ……[l]\nじゃあ寝るわ……ぉやすみ…」","「──最好…是这样…啦……[l]\n万人迷啊……[l]\n那我睡啦……晚安…」"],["この日は結局、この後恙無く点滴は午前中で終了し、\n実際問題高いか安いか分からない会計を済ませて、\nきぃと遊んだりするでもなく宿に戻ったのだった。","这天最终平安无事地在上午结束输液，\n结清了不知算贵还是便宜的账单，\n也没和小贵玩就直接回了旅馆。"],["宮さんと昨日は色々、身構えるような事を想定したりもしたが、\n肩透かしというべきか、西國の三春関係者や狩屋の母親達に\n揃って出くわしはしたものの、","虽然和宫小姐预想过昨天可能发生的各种戒备状况，\n但该说是扑空吗，虽然确实遇到了\n西部三春家有关系的狩屋的母亲她们…"],["格別緊張状態になった訳でも無く、寧ろ弛緩しまくりの寝まくりになってしまった。","并非处于特别紧张的状态，反倒彻底放松睡了个昏天黑地。"],["まあ…道具さんに関しては三春系の確証は無いが、[l]\n卑尊さんとのやりとりを視る限りは恐らく…[l]\nまあ、帰ったら知狡さんに確認してみよう。","嘛…关于道具小姐虽没有确凿证据表明她属于三春系，[l]\n但从与卑尊医生的互动来看恐怕…[l]\n算了，回去后找知狡阿姨确认下吧。"],["となると、\nきぃが何で其処と繋がってるのかが分かんないという疑問が\n再発するなあ…","这样一来，\n小贵为什么会和那边有联系这个疑问\n又冒出来了啊…"],["卑尊さんの言を丸呑みするなら、『毎度毎度』施しのつもり──\n他人に金銭援助をするのも常習ともとれるので、\nきぃと偶発的に知り合い、そういう関係になったのかも知れないが。","如果全盘接受卑尊医生的说法，『每次每次』都打算施舍──\n经常给别人金钱援助也能算是一种习惯，\n或许小贵是偶然认识对方才变成这种关系的吧。"],["あのナース衣装を調達したのも道具さんのようだし。[l]\n仮にきぃまでが三春の関係者なら、冬夏のおっかさんの反応は\nあまりに他人行儀だし、\nきぃの過去が僕のあやふやな記憶通りなら、………","那套护士服的采购者好像也是道具小姐。[l]\n假如连小贵都是三春相关人员，冬夏老妈的反应\n未免太见外了，\n如果小贵的过去和我模糊记忆一致的话，………"],["どうなんだ？[l]\nあいつ、冬夏と何時から友人同士なんだ？[l]\n…何か点滴の痕と、首が熱くなる。","到底怎么回事？[l]\n那家伙是从什么时候开始和冬夏成为朋友的？[l]\n…点滴的痕迹和发烫的脖颈让我有些在意。"],["宮さんの呉れたチョーカー、ちゃんと今日も着けてきたが、\n慣れない所為かどうも時折、違和感として認識されるなあ。[l]\n大体首って急所だから基本的に敏感なんだよ。","虽然今天也好好戴着宫小姐给的项圈，\n可能因为不习惯，总会时不时产生违和感。[l]\n毕竟脖子是要害本来就比较敏感嘛。"],["うーんそれはそれとして、\nきぃ…二個下…それは冬夏もだ……[l]\n貴奴……西石貴奴…きーちゃ…姫様ちゃ……","唔不过这个先放一边，\n小贵…小两岁…冬夏也是……[l]\n贵奴……西石贵奴…小姬…姫様……"],["「まあ…偶然やって来た僕を謀る理由も普通は無いよな…」","「反正…正常人也没理由算计偶然路过的我啊…」"],["馬鹿みたいに世の中信用してる訳じゃないが、\n何も信じられない程に悲観もしてない僕は、\n何とか悪念を振り払い家路…宿路？を急いだ。","倒不是蠢到完全相信这个世界，\n但也没悲观到什么都不信的我，\n总算甩开恶念加快脚步…回宿舍？"],["ほら精神を明るく保てば、\n心なしか視界もはっきりして視えるね。","你看只要保持开朗的心态，\n连视野都会莫名变得清晰呢。"],["まあ診療帰りだし、\nそれこそ偽薬効果かも知れないけど、\nやっぱり疲労から来る眼の障害だったのかなあ。","毕竟刚看完诊，\n说不定纯粹是安慰剂效应，\n不过果然还是疲劳引起的视力问题吧。"],["大神はちなみに極度に疲労すると、何かが視える人らしい。[l]\nそれはどうやら片側の眼らしいのだが、視えている時間が短い為に\n事実左右のどちらかを検証出来たことはないそうだ。","顺便说下大神极度疲劳时好像会看见某些东西。[l]\n虽然似乎只有单侧眼睛能看见，但由于持续时间太短\n据说从未能验证具体是哪边。"],["霊がどうのこうの言うと奴は怒るし、\nそもそも視える『何か』は人型とは限らないらしいので、","提什么幽灵之类那家伙会生气，\n况且能看到的『东西』未必是人形，"],["シャルルなんとか症候群の類かも知れないが、\nあれは、当人の過去記憶に","可能是类似邦纳综合征的症状，\n但那更多与本人"],["因るところが大きいようだし。","过去的记忆有关。"],["いずれ覚醒状態にも関わらず視界内に妙なモノが視えるというのは、\n実際そうなのかどうかはともかくつい最近経験したあの感じは、\n何とも不可思議な感覚だ。","明明清醒着却看见视野里有古怪玩意，\n先不论真假，最近体验的那种感觉\n实在难以言喻。"],["奴もこんな感じだったのだろうか。[l]\n眼の中のゴミがふよふよしてるのとは明確に違うもんな。","那家伙当时也是这种感觉吗。[l]\n和眼球里飘浮的杂质完全不是一回事。"],["そういや先日のあの時、\nチノ嬢が話してた眼の魔力、\n過去この國では神職に就く者と、片眼或いは両眼の視力障害には、\n割と関係があったようだし、","话说前阵子那会儿，\n听千乃小姐提过眼睛的魔力，\n过去这个国家担任神职的人，与单眼或双眼视力障碍\n似乎颇有渊源，"],["ヒトが世界を認識するのに多大な情報源となる視界、\n光の受容器官たる眼球の機能を遮断する事には\n何かしら世界のありようを捉え直す意味があるのかも知れない。","作为人类认知世界的重要信息来源，\n阻断作为光感受器的眼球功能\n或许具有重新认识世界本质的意义。"],["その一方で、猫はよく空中を凝視するような話、聞くなあ。[l]\nこの場合はつまり、逆にモロに眼で視てるんだろうが、\n実際に何かを視てるかどうかは分かんないんだよな。","反观猫咪常盯着空中看的说法倒是听过不少。[l]\n这种情况应该反而是直接用眼睛注视，\n但到底有没有真看见什么就不知道了。"],["それこそ霊だ何だと言った日には大神が…","要是敢说什么幽灵之类大神肯定…"],["まあそれはいい。","嘛那倒无所谓。"],["いずれ他生物の殆どは、ヒトと同じ視力や視界じゃない訳で、\nまあつらつらと考えるに、世界なんてものは受容器官とその処理中枢次第で如何様な相をもとるのだろう。","毕竟其他生物大多都拥有与人类不同的视力或视野，\n仔细想想的话，世界的样貌本就取决于感知器官与其处理中枢如何呈现吧。"],["という事で、\nある種の昆虫は赤外線視覚が世界の捉え様であり、\n近しい哺乳類にしても蝙蝠犬猫すべて外部の認識の仕方が違う。","所以说，\n某些昆虫通过红外视觉捕捉世界，\n就连相近的哺乳类如蝙蝠狗猫也各有不同的外界认知方式。"],["植物に至っては想像もつかない。[l]\n光か、温度か、湿度か、振動か、触覚か。","植物更是超乎想象。[l]\n是靠光、温度、湿度、振动还是触觉呢。"],["同じ人間同士も視力というか、解像度が違えば視える世界にも差異はある、挙句の果てには認識裁定をするのは個々人の脳それぞれだ。","即便同为人类，视力或说分辨率不同所见世界就有差异，最终做出认知判断的终究是每个人的大脑。"],["にも関わらずみんな自分基準で物を考える、\n生命の","可大家还是以自我为基准思考问题，\n生命的"],["容がこの惑星の生物と同じとは限らない、","形态未必与这个星球的生物相同，"],["機械のような複雑系には意識がある可能性がある、\n兎にも角にもヒトが世界を判ずる基準は、\n好きか嫌いかだけ。","机械般的复杂系统也可能存在意识，\n归根结底人类评判世界的标准，\n仅凭喜欢或讨厌。"],["とどんどん主旨と外れ…たのかどうかも解らない方向に、[l]\nあのときチノ嬢は延々語っていたっけ…","话题逐渐偏离主旨…或者说连是否偏离都搞不清的方向，[l]\n那时候千乃小姐倒是滔滔不绝说过…"],["「チノさんの話な…[l]\n","「千乃小姐的话呢…[l]\n"],["強ち解んない話でもないっていうのは\nどうなんだろうなあ僕は…[l]\n宮さんの仕込みが効いてるのかなあ…」","倒也不是完全听不懂\n但对我来说…[l]\n大概是宫小姐平时灌输的结果吧…」"],["まあ元からそっち系の資質というか、\n道楽でも何でも、多少なりとも人より本を読んでれば\nそうもなろうというものだ。","不过本来就有那方面的潜质吧，\n就算只是消遣，只要比别人多读些书\n自然会变成这样。"],["ところで帰りしな、きぃと少しだけ話した内容によると、\n狩屋の母親は確かに妊娠中で、\n三春のお抱えのあそこに通院しているという事だった。","顺便说回来时和小贵聊到的内容，\n狩屋的母亲确实正在怀孕，\n据说在三春家专属的那家医院就诊。"],["その辺りは前に宮さんから聞いていた事だったのでまあ良いのだが、\n怪我に関しては特に語られる事はなかった。","这部分之前听宫小姐提过所以还好，\n但关于受伤的事她只字未提。"],["きぃが言うには、彼女も娘──克杖な。に、負けず劣らずの体育系らしいので、何か運動中の怪我ではないかという事だが。","按小贵的说法，她女儿──克杖也是不输给母亲的运动系，可能是运动中受的伤。"],["言外に例の人死にに関係している可能性を勘繰る事も出来るかもだが、今の僕にとってはそれより深刻な問題なのは、明日明後日だよ。","虽然也能暗自揣测是否与那起命案有关，但对我来说更严重的问题是明后天啊。"],["姫様ちゃんも何を思うてかなあ…","姫様酱到底在想什么呢…"],["「…カな、イー…なのか？」","「…货、你是白…吗？」"],["ふと人の声に呼ばれた気がして、\n視線を横に向けた。[l]\n猫が喋ってるのが視え…た……え？","突然感觉被人声呼唤，\n将视线转向侧面。[l]\n看见猫在说…话……咦？"],["「？[l]\n誰か何か言いましたか？[l]\n僕を呼びました？[l]\nえ、お、き、猫が？」","「？[l]\n刚有人说话吗？[l]\n是在叫我吗？[l]\n诶、哦、刚、猫在说话？」"],["そんな馬鹿な。[l]\n……そんな馬鹿な、なあ。","太荒谬了。[l]\n……太荒谬了，真的。"],["「……なのか？」","「……是吗？」"],["「………ぅあ！？」","「………呜哇！？」"],["眼が合ったまま硬直する僕と猫──\nここまではよくある話だ、よな？[l]\n聞き間違いだよな？[l]\n気のせいだよね？[l]\n青味がかった灰色の、綺麗な毛並みの猫だ。[l]\n片眼は失明してるのか、白濁していてちょっと怖い印象だけど…[l]\nニャーと言ったんだよな？[l]\nニャーと言ってくれ。[l]\n言ってくれよ。","我与猫四目相对僵在原地──\n到这种程度还算常见对吧？[l]\n是听错了吧？[l]\n是幻觉对吧？[l]\n这是只毛色漂亮、蓝灰色调的猫。[l]\n有一只眼像是失明了，浑浊发白有点吓人…[l]\n刚才是喵了一声吧？[l]\n快喵一声啊。[l]\n快叫啊。"],["「ミナサツカヤキャメナサワ？」","「mi na sa tsu ka ya kya me na sa wa？」"],["「……………！！」","「……………！！」"],["あああ。[l]\n治ってない全然治ってない。[l]\n僕の体調も眼の調子も全然だ。[l]\nより一層具体的な幻覚が視えるようになってる。[l]\nいあ、幻聴も加わったようだ。","啊啊啊。[l]\n完全没好根本没好。[l]\n我的身体状况和眼睛状态都糟透了。[l]\n现在能看见更具体的幻觉了。[l]\n不对，连幻听都出现了。"],["猫が僕に、あの謎言語で話し掛けてる。","猫正用那种谜之语言对我说话。"],["「あは、はははは、ちょっと、\n宮さん、僕、どうやらアタマの何処かが深刻に悪──」","「啊哈，哈哈哈，等等，\n宫小姐，我脑子某处恐怕严重坏──」"],["「…ロア、どうし──」","「…萝亚，怎么了──」"],["「みやーーーーおぅ」","「宫————呜」"],["猫の居る路の方から、幼い少女の声がして、急速に現実に──\n否、今までだって現実だった筈だが、第三者の登場によって、\n冷静なステージまで戻れた気がした。[l]\n思わず眼を","从猫所在的小路方向传来幼女的声音，迅速将我拉回现实——\n不，原本就该是现实才对，但随着第三者的出现，\n感觉终于回到了能够冷静思考的状态。[l]\n不由得"],["瞬いて、周囲を見回す。","眨了眨眼，环视四周。"],["「んなーお」","「喵嗷——」"],["猫も、僕の方に身体を向け警戒心丸出しのまま、\n声の主の方に移動しようとしていたが、\n鳴き声は至極真っ当な猫の鳴き声だった。","那只猫也保持着高度戒备的姿态转向我，\n似乎正要往声音源头移动，\n此刻发出的却是再正常不过的猫叫声。"],["しかし先刻の幻聴は…少女の声とは聞き間違いようのないコエだったが…","但刚才的幻听…那绝对是少女的声音不可能听错…"],["「…が心配して……[l]\n…る…す…」","「…在担心……[l]\n…走…了…」"],["その声に反応して猫は、走り去った。[l]\n少女…らしき声の主は、姿を見せないまま猫と共に行ったようで、[l]\n事の実際は分からないまま、僕は一人その場に立ち尽くしていた。","听到这声音，猫突然跑走了。[l]\n疑似少女的声音主人始终没有现身，似乎跟着猫一起离开了，[l]\n在不明就里的状况下，我独自呆立在原地。"],["何だ？[l]\n白昼夢だというのか？","怎么回事？[l]\n要说这是白日梦吗？"],["た、確かに、あの謎言語が逆に、\n過去の記憶が夢をみる時のように無意識に浮かんできたという証拠かも知れないが、","确、确实，那种谜之语言反而像是\n做梦时潜意识浮现的过往记忆证据，"],["「………早く帰ろ…」","「………赶紧回去吧…」"],["まだ春先だというのに、\n夏の夕暮れのような怖ろしげな雰囲気を感じ、\n僕は宿へと急いだ。","明明还是初春时节，\n却感受到夏日黄昏般令人发怵的氛围，\n我加快脚步赶回宿舍。"],["独りで居るのは嫌だ。[l]\n宮さんでも誰でもいいから、知っている人間に逢いたかった。","讨厌独处。[l]\n不管是宫小姐还是谁都好，现在只想见到认识的人。"],["卑尊さん達を中央に足止めしてた嵐が北上してるのか、\n黒い雨雲も遠くに立ち籠めている。","或许是把卑尊小姐她们困在中央的那场暴风雨正在北上，\n远处还笼罩着黑压压的雨云。"],["厭だ。[l]\nこの感じは。[l]\n天井が低くなったかのような閉塞感、\n嵐の前のこの予感めいた焦燥感。","好难受。[l]\n这种感觉。[l]\n仿佛天花板压下来的闭塞感，\n暴风雨前这种近乎预感的焦躁。"],["焦っていたのか、\n宿までがいやに遠く、\nいつまでもいつまでも辿り着けない錯覚に陥る帰り途だった。","可能是太着急了，\n回宿舍的路显得异常遥远，\n陷入永远都走不到头的错觉中。"],["首のチョーカーだけがほのかに熱を帯びていた。","只有颈间的项圈微微发烫。"]],"context":[["SC_M_017.ks/index/1/text"],["SC_M_017.ks/index/3/text"],["SC_M_017.ks/index/6/text"],["SC_M_017.ks/index/8/text"],["SC_M_017.ks/index/10/text"],["SC_M_017.ks/index/12/text"],["SC_M_017.ks/index/14/text"],["SC_M_017.ks/index/16/text"],["SC_M_017.ks/index/18/text"],["SC_M_017.ks/index/21/text"],["SC_M_017.ks/index/23/text"],["SC_M_017.ks/index/25/text"],["SC_M_017.ks/index/27/text"],["SC_M_017.ks/index/29/text"],["SC_M_017.ks/index/32/text"],["SC_M_017.ks/index/34/text"],["SC_M_017.ks/index/36/text"],["SC_M_017.ks/index/38/text"],["SC_M_017.ks/index/41/text"],["SC_M_017.ks/index/44/text"],["SC_M_017.ks/index/46/text"],["SC_M_017.ks/index/48/text"],["SC_M_017.ks/index/50/text"],["SC_M_017.ks/index/52/text"],["SC_M_017.ks/index/54/text"],["SC_M_017.ks/index/56/text"],["SC_M_017.ks/index/58/text"],["SC_M_017.ks/index/60/text"],["SC_M_017.ks/index/62/text"],["SC_M_017.ks/index/64/text"],["SC_M_017.ks/index/67/text"],["SC_M_017.ks/index/69/text"],["SC_M_017.ks/index/71/text"],["SC_