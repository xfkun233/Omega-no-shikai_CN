"end":7123}],[{"start":7137,"end":7195}],[{"start":7209,"end":7270}],[{"start":7284,"end":7350}],[{"start":7364,"end":7389}],[{"start":7435,"end":7498}],[{"start":7512,"end":7529}],[{"start":7543,"end":7578}],[{"start":7616,"end":7627}],[{"start":7662,"end":7716}],[{"start":7748,"end":7760}],[{"start":7772,"end":7773}],[{"start":7785,"end":7839}],[{"start":7877,"end":7917}],[{"start":7931,"end":7976}],[{"start":8011,"end":8053}],[{"start":8085,"end":8131}],[{"start":8166,"end":8219}],[{"start":8251,"end":8319}],[{"start":8357,"end":8373}],[{"start":8408,"end":8462}],[{"start":8474,"end":8514}],[{"start":8552,"end":8590}],[{"start":8625,"end":8632}],[{"start":8643,"end":8690}],[{"start":8722,"end":8761}],[{"start":8799,"end":8824}],[{"start":8859,"end":8907}],[{"start":8945,"end":8975}],[{"start":9010,"end":9064}],[{"start":9096,"end":9114}],[{"start":9152,"end":9194}],[{"start":9226,"end":9237}],[{"start":9272,"end":9306}],[{"start":9338,"end":9341}],[{"start":9355,"end":9419}],[{"start":9433,"end":9537}],[{"start":9633,"end":9658}],[{"start":9690,"end":9788}],[{"start":9826,"end":9844}],[{"start":9908,"end":9939}],[{"start":10002,"end":10034}],[{"start":10066,"end":10293}],[{"start":10307,"end":10338}],[{"start":10352,"end":10362}],[{"start":10376,"end":10420}],[{"start":10462,"end":10490}],[{"start":10610,"end":10614}],[{"start":10718,"end":10833}],[{"start":10899,"end":10974}],[{"start":11006,"end":11059}],[{"start":11071,"end":11104}],[{"start":11118,"end":11198}],[{"start":11212,"end":11257}],[{"start":11269,"end":11287}],[{"start":11356,"end":11407}],[{"start":11419,"end":11471}],[{"start":11503,"end":11519}],[{"start":11555,"end":11622}],[{"start":11654,"end":11701}],[{"start":11713,"end":11780}],[{"start":11849,"end":11910}],[{"start":11922,"end":11938}],[{"start":11970,"end":12006}],[{"start":12018,"end":12100}],[{"start":12169,"end":12225}],[{"start":12237,"end":12286}],[{"start":12318,"end":12342}],[{"start":12380,"end":12388}],[{"start":12400,"end":12471}],[{"start":12503,"end":12536}],[{"start":12548,"end":12549}],[{"start":12561,"end":12576}],[{"start":12639,"end":12644}],[{"start":12711,"end":12764}],[{"start":12825,"end":12863}],[{"start":12895,"end":12948}],[{"start":12960,"end":12985}],[{"start":12997,"end":13074}],[{"start":13143,"end":13164}],[{"start":13196,"end":13241}],[{"start":13253,"end":13274}],[{"start":13312,"end":13327}],[{"start":13361,"end":13374}],[{"start":13434,"end":13505}],[{"start":13537,"end":13682}],[{"start":13718,"end":13756}],[{"start":13794,"end":13888}],[{"start":13923,"end":13973}],[{"start":14005,"end":14107}],[{"start":14143,"end":14231}],[{"start":14263,"end":14283}],[{"start":14318,"end":14344}],[{"start":14376,"end":14420}],[{"start":14432,"end":14468}],[{"start":14506,"end":14536}],[{"start":14568,"end":14604}],[{"start":14642,"end":14679}],[{"start":14715,"end":14768}],[{"start":14800,"end":14841}],[{"start":14877,"end":14979}],[{"start":15017,"end":15060}],[{"start":15092,"end":15099}],[{"start":15134,"end":15166}],[{"start":15198,"end":15207}],[{"start":15219,"end":15221}],[{"start":15232,"end":15272}],[{"start":15283,"end":15284}],[{"start":15296,"end":15343}],[{"start":15381,"end":15452}],[{"start":15484,"end":15780}],[{"start":15818,"end":15857}],[{"start":15892,"end":15897}],[{"start":15939,"end":15987}],[{"start":16019,"end":16035}],[{"start":16324,"end":16365}],[{"start":16377,"end":16406}],[{"start":16420,"end":16437}],[{"start":16449,"end":16484}],[{"start":16522,"end":16544}],[{"start":16578,"end":16609}],[{"start":16621,"end":16636}],[{"start":16650,"end":16664}],[{"start":16678,"end":16740}],[{"start":16778,"end":16784}],[{"start":16818,"end":16913}],[{"start":16948,"end":16995}],[{"start":17064,"end":17116}],[{"start":17148,"end":17185}],[{"start":17199,"end":17274}],[{"start":17288,"end":17361}],[{"start":17375,"end":17415}],[{"start":17429,"end":17498}],[{"start":17512,"end":17572}],[{"start":17586,"end":17613}],[{"start":17682,"end":17700}],[{"start":17732,"end":17855}],[{"start":17893,"end":17914}],[{"start":17950,"end":17977}],[{"start":18009,"end":18055}],[{"start":18093,"end":18117}],[{"start":18153,"end":18211}],[{"start":18243,"end":18318}],[{"start":18353,"end":18376}],[{"start":18414,"end":18445}],[{"start":18514,"end":18530}],[{"start":18562,"end":18581}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_013.ks","basename":"SC_M_013.ks","indexIds":{"宮さんのお守りが利いた訳でもないんだろうが、\n昨日の変調は跡形もなく失せて、\nどうやら我が身体、復調を為したようである。":0,"それもそうだ、時間が跳んだ錯覚に陥る程に熟睡したようだし。[l]\nただまあ、脳の回転に於いてはいつも通りかな。":1,"格別すっきりしてる訳でも無し、\n空腹になれば空転し出すだろうけども。":2,"今日が三春の家に行く日だというのもあったが、\n実際本当に昨日のあれで本家の用事は済んだ事になったらしい。":3,"あれからは何も言われてない。":4,"今朝方、知狡さんが改めて僕の見舞いに来てくれたが、\n首に巻かれた宮さんのチョーカーを視るなり、\nまた微妙な顔をして変な納得をしたようだった。":5,"で、当の宮さんはもう居らず、\n挨拶も何も出来ずに今日も僕は出かけます。":6,"それは別にいいんだが、\n実際あの人は何をしてるんだかなあ。":7,"さて、きぃは流石に今日は携帯稼働させているはずなので、\n連絡つけて早めに合流しとこう。[l]\n具体的な決行時間が分からない以上仕方ない。":8,"さあ、どこまで心して掛かるか。[l]\n基本的に使命の本命は祭儀の時になるはずだが、\n早めにケリがついてくれるならそれに越したことはない――\nんだが…":9,"それ以前に祭が行われるかは、まだ未確定なのだ。[l]\nその所為で僕は学校まで辞めさせられて此処に居るのだ。":10,"三春の母上様は何とかするつもりと仰せだったが、\nどうするんだか。[l]\n身内の不審死、警察沙汰にしないつもりか。[l]\nそれともそもそも不審な点など無いのか。":11,"宮さんやかれお嬢が、\nあれは人為的な人死にと言ってはいたんだが、":12,"そうであろうと事故だろうと、\nどっちだとしても隠すべき醜聞だと、三春家は判断している、\nという事になるのか？":13,"地元有力者とて、現実問題としてどこまで仕切れるもんなのだか。":14,"ああ、それにしてもどうにもなあ。[l]\n言い出せばそもそもの始まりからしてだが、\n突然多数の女子達との出会いやら、昨日の仮面の事やら、\n僕を取り巻く環境の激変はどうだろう。":15,"不穏…とまでは言わないにせよ、[l]\n目まぐるしいなあ事象の起こりが。":16,"昔の記憶が曖昧だから何とも言えないが、\n人生でこんなに高密度で事が起こるのって珍しい気が。":17,"人間生きてりゃ、そういう波はあるんだろうけど。[l]\n平々凡々な人生と波瀾万丈な人生、一体どちらがレアなのか。":18,"確率グラフ？で言えば山の両端、珍しさでは同等かねえ。[l]\nま、物事は縦ですっぱり割り切れるもんでもないし、\nん？横割りか？[l]\nどっちでもいいですけどね。":19,"いずれ理系文系とか、ＡＢＯ型だとか男とか女とか、\nそういうカテゴリに綺麗に収まることなんかほとんどないって事さな。":20,"全てが理路整然と分類できたほうが分かり易いし\n自分が世の中の法則を分かった気になれるからあれだが、\n実際そんな小難しい理屈でなくとも、僕とて本棚整理するときは\nカテゴライズには毎度頭を悩まされるのだ。":21,"判型で分けるべきか、作家で分けるべきか、\nジャンルなのか出版元なのか。[l]\n読む頻度による利便性なのか収納見た目の美しさなのか。":22,"そんな事をしてる間にあっ夕方だ！[l]\n…という事が何度あったことか。":23,"――まあ全く以てどうでもいいことだった。":24,"そうか、朝飯前だもんな。[l]\n早速空転もしようというものだ。[l]\nとっとと食事して今日に備えよう。":25,"「きぃは…別にいいか、誘わんでも」":26,"喚んだら大喜びで速攻飛んで来そうだけど。[l]\nまあ、僕も今のところ貯金暮らしだし、\nこないだみたいな量を喰われても賄い切れるか心配だので。":27,"って喚んだ時点で僕奢りみたいに想定せんでもいいんだが、\nなにせ自称ビンボー少女を飯に喚んでおいて、\n割り勘なんて言った日にぁ…[l]\nくわばらくわばら…":28,"……これって忌避け落雷避けの呪文だっけか。[l]\nってまた変な方向に思考が横滑りしてるわ。[l]\n朝飯喰うんだ朝飯。朝飯を！":29,"ここは旅館だが、ホテルのようにロビーにバイキング形式の食堂もあるゆえ、適当にチョイスし席に着き、食事開始。":30,"あんまり人も居ない。[l]\nあー、牛乳美味いなあ…":31,"「Good Morning。[l]\nん？[l]\nGuten Morgen？[l]\nいや、お早う御座いますか」":32,"「おわ！？[l]\nい、居たんですか。[l]\nおは、お早うございます…」":33,"振り向くとチノ嬢が昨日と同じ姿で立っていた。[l]\n無駄な考え事をしていた所為もあるが、\n全く気付かなかった。[l]\nてか真後ろから近づかれてたし！[l]\nあぶな、牛乳噴くとこだった。":34,"「所用があった私は昨日見舞いに行けなかったので今来ました。[l]\nご機嫌は如何です？[l]\n":35,"ああ…鈴が付けられてますね」":36,"「鈴…[l]\nあ、これですか」":37,"宮さんから貰ったチョーカーを指した。[l]\n確かに柄は鈴だけども。[l]\n鼠が猫に付けようとして云々って話があったなあ。[l]\nあれ結局付けたんだっけ？付けられなかたんだっけ？[l]\n目的とその条件の順序が逆で基本的に無理問答なパターンだっけ？[l]\n炎の魔剣を得るには…それはまた別の話か、って。[l]\n今日は何かというと横滑るなあ。いかんなあ。":38,"「ふむ。[l]\n好くお似合いです。[l]\n良かったですね宮店長からの下賜ですね」":39,"下賜…[l]\n高貴な人物から下の者に物を与えることですね。[l]\n下（くだ）し賜（たまわ）る事ね。":40,"「まあ、或る意味まさしく下賜された物ですけどね。[l]\nどうせ宮さんと僕はそういう間柄です。[l]\nえ、て何で分かるんですか、\nこれが宮さんから貰った物だって」":41,"「察してしまうのですよ私は」":42,"「そ、そうすか。[l]\nそういやそうでしたねあはは…」":43,"昨日から察しまくりでおられます事で。[l]\n本当にテレパスか何かじゃないのか。":44,"「ま、今日の事に関しましては、\nどうかお気楽に。[l]\n月末まで待てば祭はあるんですし」":45,"「えー、まだわかんないって話じゃなかったでしたっけ。[l]\nさっきもそれ考えてましたけど、\n殺…ええと、事件がまだ未解決のままで、[l]\nやれてしまうもんですかね？」":46,"「どうあれやりますね彼女等は」":47,"な、何故断言できるんでしょうカ。":48,"「延期とか多少規模が縮小されるとか…」":49,"「まだ公に事件と謂われた訳でもなく、\n事故…そうですね、この辺だと肉食野生動物もいますから[l]\nいくらでも無難な方向に持っていけますかね。[l]\n色んな事情がこの土地にはありますしね。[l]\nヒトは思考道筋が選択可能な条件の場合は、\n都合の良い方を採るように出来てますから、\nいくらでも有耶無耶に出来ます」":50,"少なくとも土地の者に対してはね、と彼女は言った。":51,"「動物ですか……[l]\n熊とかですか。[l]\n狼ですか」":52,"「ん？どっちでもいいですけど」":53,"や、狼はこの國にはもう居ません…":54,"「ともあれ先刻申しました通り、\nそもそも事件性を見出してるのは当事者達と我々だけで、\n対外的にはまだ不穏なアナウンスはしていないんです。[l]\n下々の者にしたって、\nあ、私が彼らを下にみてるんではないですよ。[l]\n三春にスキャンダルがあっては困りますしね、\n祭は貴重な外貨稼ぎ…ん？外貨ではないな。":55,"観光資源としてのイヴェントですから\n敢えて中止を望む者は居ませんよ。[l]\nそうでなくても祭事や神事というものは、\n古くから人の死に優先する事はままあるでしょう。":56,"祭自体で死人が出たりすることは勿論、贄を捧げるものすらあった訳ですから」":57,"「まあ、そういう事もあったかも知れませんが、\nそれを良しと享受しても構わないかどうかは別でしょう…」":58,"しかしそうなるといよいよもって僕が\n早入りした意味がないんでは…[l]\nもう諦めてるから良いけどさあ……":59,"「良いじゃないですか。[l]\n女子達との楽しい交わりもあったようですし。[l]\nいずれ今回の事は突発事故であることに違いは有りません。":60,"備えあれば憂い無し、\n備わらんことを一人に求むるなかれ、\n":61,"ん？違うか？[l]\nどっちでもいいですが」":62,"また僕は何も言ってませんが…[l]\nそして後者は全く意味が違うって。[l]\nこの人もズレ幅激しくなってきたな。":63,"飯窪関係者は本当にびっくり人間である事を基準に\n集められてるんじゃ…[l]\n筆頭の知狡さんからして何か様子が変…あれが常態だったかどうかは定かじゃないけど、":64,"少なくとも度が過ぎる真面目さは変と評されても仕方ない部分はある。":65,"「実際どういう形で彼等が誤魔化すかは、\nその時が来れば分かる事ですが。":66,"仰々しく報じられたり深読みしなければ、\n誰も気にもしないレヴェルの話なのですよ、おそらくは。":67,"じゃあ私もこれで。[l]\n宮店長の祝福あれ。[l]\nGood Luck。":68,"ミ・キャミャルキャラモロコネコナメタサキャラ\nタサコネタサメミャラメンカヤコネキャ・ワ」":69,"はい？[l]\n最後なんて言った？":70,"「みゃんみゃんきゃらきゃらわ？」":71,"彼女は恭しく会釈をし、立ち去ってしまった。":72,"……かれお嬢の使う言葉は只のエセ外國人だったけど、[l]\nチノ嬢のはよく分からんなあ。[l]\nサンスクリット…とも違う感じだし……":73,"なうまくさんまんだぼだなんあびらうんけんそわか…[l]\nおんまかきゃらやそわか…":74,"──んー、わからん。やっぱり違うという事しか。":75,"どっちにしても疲れる事には変わりなし、\nどうしたもんかなあ。":76,"この件が終わったら実際どうなるんだろ。[l]\n『ねこざんまい』は向こうにあるし、\n最後にゃまたあっちに戻るのかな。":77,"でも本家は僕に、\n何かしらの役なり職なりを ":78,"宛 いたいのかも知れないしなあ。":79,"あの家宝とやらの面の関係上、\n男子は何かしら特殊な立ち位置みたいな事も言っていたし、\nそうならこっちに住む事になるんだろうか。":80,"未だ向こう在住の母さんの件もあれば旅館の今後の事もあるわで、\nなーんかややこしくなりそうな気配はするなー…[l]\n知狡さん、早く結婚して子供つくればいいのに。":81,"…余計ややこしくなるか？[l]\nま、跡目争いなんかするつもりはないし、\n生活保障さえしてくれれば僕ぁどんなポジションだろうと\n構わないんだが。":82,"周りが、かれお嬢とかチノ嬢とかみたいな人だらけになるというのはあれだけども…":83,"ま、いいや。[l]\n獲らぬ狸の何とやら。":84,"中断していた朝食を摂り終え、\nなるべく黒め地味めの服を選んで着用したのを、\nお手洗いの姿見で確認し、":85,"首のチョーカーに触れて\nま、少しは祈ってみたりだ。[l]\nと同時に、…昨夜の額のあれを思い出しそうになる。":86,"あぶねえあぶねえ、これからって時に動揺してどうする。[l]\nここは幸いにも手洗い場、\n水でばっしゃばっしゃ顔を洗う。":87,"ふいー、\nさて。[l]\n行こうか。":88,"外に出て電話する。[l]\nこないだの時に大体の時間として決めた九時はもう廻ってるし、\nもう準備もしとるだろう。":89,"………。[l]\n出ないな。":90,"………。[l]\n遅いな。[l]\n……お、ようやく出た。":91,"「もしもし僕ですけど」":92,"「んあー…誰？[l]\nふぉ？[l]\nあ、ああ！[l]\nふええ、おはよぉ、まこちゃん」":93,"何かすっげえがっさがさの":94,"濁":95,"声だったな。[l]\n寝起きかよ。[l]\n時は金なりがどうのって言ってなかったか？言ってない？":96,"「…ああおはよう。[l]\n寝てるとこ悪いけどもな、\n大丈夫か今？":97,"そろそろ時間なんだけど。[l]\nこっちはもう待ち合わせ場行こうと思うんだけども…」":98,"「ふああ…[l]\nあぁーいいよぉー。[l]\nダッシュで行くっすよぉ」":99,"大丈夫かほんとに。[l]\nてか朝飯どうする気だ。[l]\n起き抜けだったろう。":100,"「ふえ？[l]\n朝ご飯は基本的に抜いてるのさ。[l]\n…ま、事情は訊かないで欲しいのだわ」":101,"普通はダイエットとかなんだろうけど、\nお前の場合は明らかにまあ、節約ぽいのが悲しいなあ。[l]\n訊かないでおいてやるよ…":102,"「じゃこないだの公園で良いか？」":103,"「あ、駄目だね。[l]\n何か知り合いがすぐ近くに住んでるから見つかるって\n冬夏言ってたのさ。":104,"あのね、あの自販機小屋が良いのだわ。[l]\n冬夏ん家にそれなりに近いし」":105,"「あ、成る程ね。[l]\nそういや姫様ちゃんお目付役だって言ってたな」":106,"「あーそうその":107,"娘。[l]\n昨日まこちゃん電話が繋がらなかったからさ、\n言うの忘れてたのだわ」":108,"そうか、地下に居た時かなあ。[l]\n寝込んでた間は着信も無かったしな。":109,"「ああ、悪かった。[l]\nじゃそこ行くわ」":110,"「おっけ。[l]\n多分まこちゃんが先に着くでしょ。[l]\n待ってて欲しいのだわ」":111,"「はいよ。[l]\n……パンと牛乳でも買ってこうか？」":112,"「………！！[l]\nふ、ふええ、\nそ、それはどうにも…いや、そこまでしてもらっては…っ！！」":113,"……まあ、いいけどなそれくらいなら。":114,"「腹の虫に鳴かれでもしたらこっちも困るしさ…[l]\nまあ遠慮するな。今回は」":115,"今回も、というべきか。":116,"「えっへへへへへ。[l]\nじゃマジ速攻行くからよろしこ！！」":117,"ぶつ。":118,"…わっかりやすい奴だなあ……[l]\n電話、あっさり切られる事に耐えられない人、\n結構いる筈だから気を付けろきぃ。":119,"まあそれはさておきだ。[l]\n途中コンビニもないのにうっかりそのつもりで出てしまい、\n幸いにも見つけたちっさい米屋みたいな処で、\nきぃの為にアンパンと牛乳を買い例の自販機小屋に着くと、":120,"「えっへへへへへぇー。[l]\nおっはよう」":121,"きぃが来ていた。[l]\nお前どんだけ…[l]\nいくら僕が買い物してた時間があるとはいえ、\nどういう脚力…というか食欲してるんだ、[l]\nいやさ、食に対する執念か……":122,"「…おう。[l]\nほらこれ」":123,"袋ごと放ると、ボールを投げられた犬の如く大喜びでキャッチする。":124,"「さんくすまこちゃん、\nありがたくいただきますのだわっ」":125,"そう言って速攻パンを食し出すきぃ。[l]\n…まあ、この勢いなら、[l]\n食事時間が今後の動きに支障をきたすことはないだろう。[l]\nものの数分だなこれは……[l]\n自販機小屋が待ち合わせ場所なのに、\nなんで僕もわざわざ牛乳買ってしまったかなあ。[l]\nなんか、アンパンと牛乳っていう組み合わせに変な普遍性を\n思い込んでるというか。[l]\n瓶のがそれぽいんだけど、さすがに紙パックではあるが。":126,"ずぎゅるるる…とストローから音がし、その丁度飲み終えと同時に。":127,"トゥルルルルルルル。":128,"振動と共に僕の携帯が鳴った。[l]\nこの黒電話の着信音――冬夏からの電話だった。":129,"「おはようお二人さん。[l]\n覚悟はいいかな？」":130,"数分後。":131,"冬夏は、朝の散歩と偽って僕らの居た自販機小屋に来たらしい。[l]\n日曜という事もあってラフな…ラフかこれは。[l]\n僕は服飾に全く明るくないのであれだが、\nまあ要するに私服でいらっしゃったのです冬夏さんは。":132,"「母様は私に留守番押し付けて行ったから、\nま、ある意味好都合だね。[l]\n派手なことしなければ私が黙ってるだけでも大丈夫そうってこと」":133,"とは言え、全くの一人という訳ではなく、\n他の家人も居るらしいので、極力見つからないようにしないと、":134,"バレたときに犯人が唯一の妖しい部外者である我々に確定されてしまう。":135,"堂々とは行けない、という事らしい。[l]\nホントかよ。スニーキングかよ。[l]\n派手なことしなくても見つかったらミスじゃ難易度高いじゃないかよ。":136,"…なんか冬夏、少しばかり状況を愉しもうとしてないか。[l]\nこないだ何か変に深刻な":137,"貌してたと思ったのは気の所為かなあ…":138,"「ただ、ちょっとここんとこ、\nおいたが過ぎててさ。[l]\nあんまり信用されてないかも？":139,"というかいきなり真面目に言うこと聞くのも気持ち悪がられるかも？[l]\n的なね、不安はあるかなあ」":140,"あの、ちょっと、どんどん難度が…":141,"「綾目だの狩屋だの、母様が私に黙って仕込んでそうだし、\n早めに事は済まそ。[l]\n今の処は――うごいてないようだから」":142,"仕込むって…罠か何かか彼女達は。[l]\nそれに彼女らの去就はどうやって把握してるのか。":143,"単に視認しただけか、\n……まさかチノ嬢並の察しスキルですか。[l]\nあのひとの場合はテレパスと言っても過言では無いが。":144,"「…で、まあ、早めに動いた方が良いのには[l]\nもう一つ理由があってね、\nお昼を挟むのは正直怖いんだよね。":145,"食事には出ないといけないんだ私」":146,"前にも聞いたが、\n例のおっかさんが栄養管理うるさいからだそうだ。":147,"本来は外食禁止というか、きっちり家での献立があるらしい。[l]\nしかし、先日のきぃ御用達の店を知ってた通り、\n何度もその言い付けは破ってるようだが。":148,"「ほら、こないだなんか帰るなりそれで怒られたんだよ。[l]\n…姫様か克杖が言い付けたのかもしれないけど。":149,"と言うわけで先刻のきぃの話じゃないけど、\n時間は無いんだ。午前中でどうにかして欲しいのね」":150,"午後か夜には、母上殿が帰ってくるんだろうしなあ。":151,"「ま、まあねえ。":152,"明確な目的があるなら、時間なくてもすぐ終わる筈だし、\n単なる好奇心なら短時間でも構わない訳だし\n大丈夫でしょう、かね？きぃ？」":153,"少々きぃに対しての牽制というか、\nあいつの目的が曖昧だから":154,"明":155,"瞭とは僕も断じる事が出来ない。":156,"「ふえ？」":157,"「ま、いずれその条件で問題があっても\n修正のしようがないんだけど。[l]\n御免ね二人とも」":158,"「あー気にしないさ。[l]\nそれより冬夏の顔色の方が気になるのだわ」":159,"え？[l]\nそんなに悪そうか？[l]\n僕にはいつも通りに視えたが、流石、女子は気付くのか。":160,"まがりなりにも診療所バイトしてるだけのことはある。":161,"当然医療行為自体はやってないだろうけど、\n門前の小僧習わぬ経を読むという奴か、偉いもんだ…[l]\nと思ったが、当の冬夏自身は完全にスルー。":162,"「本当は積極的な目的があるんだろうにね？」":163,"う。[l]\nギャグ的流れで出て来得る台詞とは言え、\n今の僕には心臓に悪い。":164,"取り敢えず自分の態度はまた誤魔化し気味に、":165,"「え、いやそのそんなことは…」":166,"と、きぃに視線を向けると、":167,"「ふえ？[l]\nあー、どうなのさ？[l]\nえへへ、わたしは…好奇心だけだけどぉ、[l]\n出来れば…視ておきたいのだわ」":168,"と、こいつも視線定まらずといった風であった。[l]\n冬夏の体調不良を押してまで決行する程の具体的な理由は無いが、\n好奇心のが強いのだろう。[l]\nさすがに自分でも我が侭と知っているが故のその態度か。[l]\nそれとも、言えないけれども何か強い理由でもあるのか。":169,"「ま、あまり多くは訊かないでおこう。[l]\nふふ、私も人が良いねえ」":170,"「あ、そう…[l]\nまあ本当にそんな深刻な話でもないから…[l]\n何事に関しても察してくれる人は系として嫌いじゃない系だし、\n取り敢えずそういう事にしておこうか…」":171,"「そそ、\nほら、時は金なりっていうさ。[l]\n何とかの考え休むに似たりというのだわ」":172,"僕が電話するまで寝ていた人間がそれを言うか。[l]\n結局冬夏がああ言ったので、\nきぃの微妙な立ち振る舞いも放置して話を進める。[l]\n僕自身の方を突っ込まれる事になっても困るしー。":173,"「きぃ、あんまり浮かれない。[l]\nいくら私と母様が仲悪くても、\n――今はまだ事を荒立てたくないんだ。[l]\n二人には悪いけどあんまり派手なことは…ね」":174,"…『今は』？[l]\nそれって……":175,"「ふええ、\nそのうちやらかすってことだね？」":176,"お前…[l]\nお前は察しない奴だな。[l]\n少しはスルーしてあげなさい。":177,"あっさりデリケートそうな部分拾いやがって…[l]\nしょうがない。":178,"「そういえばさ冬夏、\n気になってる事が一個あって…」":179,"一応フォローで話題転換のつもりだったのだが、\nやや身構える冬夏。":180,"「例の此処のあの、祭？[l]\nどうなるかまだ決まって…ないよね？」":181,"「…ああ、その話ね。[l]\nうーーーーん、とね、\nまだ聞いてないね。[l]\nでも」":182,"きっとやるよ、予定通りに。[l]\nと、チノ嬢が今朝言ったような事を言った。":183,"「私達は祭儀の主催だし、\n私個人も儀礼に参加しなくちゃいけないんだよ。[l]\n下の方の祭、一緒に行ければ好かったんだけどね…[l]\nあ、それ以前にまことさん、祭まで此処に居るの？」":184,"「そうだね、日がずれ込みそうなら諦める感じかなあ…[l]\n結構先だもんねえ…」":185,"と言っておく。":186,"「わたしはどうしてるかなあ。[l]\n――仕事…だろうな」":187,"遠い眼をしてきぃが":188,"独り":189,"言ちた。[l]\nチノ嬢が言うように当日は稼ぎ時だろうし、\nきぃも":190,"出":191,"店とかで臨時バイトのしどころだろう。[l]\n診療所がどんだけ忙しいかによるだろうけど。":192,"「まま、二人とも、気にしないで。[l]\n僕も人混み苦手だし、祭の日まで居るとしても、\n夜は旅館で部屋から雰囲気だけ愉しむ予定」":193,"基本的に祭の日は任務決行の日であるので、\n同行の約束は当然ながら問題外だ。[l]\n…そもそも三春の人間とこうも接触してるという状況で、[l]\nどこまで誤魔化すべきなのか少々自信が無いんだけども。[l]\nこの流れだと、冬夏や姫様ちゃん…狩屋は別として、[l]\nに、直接協力仰げそうな感触もあるし……[l]\nともあれ今のところは、我ながら稚拙ではあるけれど、\nあらゆる事柄を極力グレーにしておく他に良策が思いつかない。[l]\n全く以て、流され巻き込まれキャラであるなあ…[l]\nいずれ巻き込み張本人の宮さんに相談しなければ。":194,"「取り敢えずそれはそれ、\n無駄話が長引いちゃったしじゃあ――行こうか」":195,"「おけー」":196,"「まあまあ、そんな深刻な貌しないでよ。[l]\nこないだ言った通り、ま、大丈夫、でしょう」":197,"ふう、と眼を瞑り深呼吸する冬夏。":198,"その時、\n僕ら三人の周りの視界が…[l]\n……歪んだようにみえた。":199,"空間が、映画やＴＶのＣＧ効果のように、\n一瞬透明な":200,"漣が帯状に走ったようにみえたのだ。":201,"トランジションエフェクトというか、\n走査線が走ったというか――":202,"「………？[l]\n何だ？どうした？」":203,"そしてその歪みの消えしなに、\n何か白いモノが今、視界を":204,"過って、\n――消えた。":205,"ああ。[l]\n猫が、":206,"…猫だ？[l]\n何で猫という認識が引き出されるんだ？[l]\nあの時のように──\nや、それもそうだが、":207,"「お、おい」":208,"思わずきぃを視るが、\n何にも反応した様子はない。[l]\n冬夏は僕の呟きを、彼女自身に向けた心配の語として\n受け取ったらしく、\n眼を開けこちらに微笑みを返した。":209,"「ふええ？[l]\nだいじょぶ冬夏？[l]\n緊張したさ？っれとも貧血なのだわ？」":210,"「………っん、おーけ。[l]\n大丈夫、なんでもない。[l]\nまだこの…眼が、ね。疼くの」":211,"気のせいか。[l]\n昨日の本家から、何か視界に変なモノが映るなあ。":212,"何かの残像か、眼ん中のゴミか何かか…[l]\nそういえば大神も『視える』人らしいが、\n奴が言うには、疲労困憊した時によくそうなるそうだ。":213,"確かにここんとこ、身も心も疲れてきてるぽいし、\nあれかな、一応医者行こうかなあ…[l]\nでもここいらの…ああ、例の診療所があるか。":214,"今日先生を迎えに行ったということは、\n明日すぐではごたごたしてそうだな。":215,"――というかそれ以前に、あんまり三春の関係筋とは\n接触しない方が良いんだろうけど…[l]\nきぃにお願いすれば大丈夫かなあ。":216,"取り敢えず、この件終わったら宮さんに報告がてら\nお伺いを立てるか。[l]\n旅館に薬くらいあるかもだしー。":217,"にしても、\nねこがなんなんだよ、僕のあたまよ。":218,"「…あとちょっとね、あれが重くてさ」":219,"………ああ。[l]\n冬夏のほうはそれですか。[l]\n成る程ねえ。[l]\n先刻の貴奴の診たても間違ってなかったのか。[l]\nにしても、相変わらず男子にとってリアクションに困る話題を\nあっさり言ってくれるなあ。":220,"「大丈夫？[l]\n無理しないでよ」":221,"「良いんだって。…あ、後でまた何か奢ってもらおうかな」":222,"なんてねそれってまた母様に怒られるよ、と小声で笑いつつ、\n冬夏は僕らに移動を促した。":223,"「あ、ええと、一応別々に行ったほうが良くない？」":224,"「ん？[l]\nそんなことない。[l]\nだいじょぶ。[l]\n寧ろみんな固まって動いてくれる？」":225,"あ、そう。[l]\nまあこの場合は下手な時間差作っても、\n全員揃うまでは入り口外で立ち往生だもんな。[l]\n素直に従いましょう。":226,"「さあさあ、へびがでるかじゃがでるか…あれ？」":227,"「どっちも蛇だそれ。[l]\n正確には…鬼？あれ、仏？」":228,"「君等はほんと…お気楽だね……」":229,"はは、と力なく笑って冬夏は歩き出した。":230},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_013.ks","relPath":"/data/scenario/SC_M_013.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":231,"length":231,"percent":100},"cellInfo":[null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[95,0],"note":"完成"},"/data/scenario/SC_M_014.ks":{"data":[["そこは僕ときぃが逢った時に居た、\n正面入り口門とは違うところにある裏口であった。[l]\n勝手口…と言って良いと思うが、よくわからない。","那里是与我和小贵初次相遇时所在的正门入口，\n不同的后门位置。[l]\n说是厨房后门…应该没错？不太确定。"],["「ちょっとだけ、良いって言うまで黙っててね」","「稍微安静下，在我说可以之前别出声哦」"],["冬夏は僕等二人を視ずに、\n自然な所作で目前の戸を開けた。[l]\n一見古い建築構造物なのに、開錠の時すらも、\nまるで油でも","冬夏没有看我们两人，\n以自然的动作打开了眼前的门。[l]\n明明是看似古老的建筑结构，却在开锁时，\n就像抹了油"],["注してあるかの様に音も無く開く。[l]\n視た目から類推される状況と実際のそれが違うと、\n文字通り違和感あるというか、据わりが悪くて気持ち悪いなあ…","一般无声地开启。[l]\n视觉推测的情况与实际状况不符时，\n字面意义上会产生违和感，或者说难以适应令人不适啊…"],["先行する冬夏を追うべく、\nきぃを先に入れて僕が後ろ手に戸を閉めた時も、\n鬼魅悪い程スムースだった。","为追赶走在前面的冬夏，\n当我让小贵先进去并反手关门时，\n顺畅得简直令人毛骨悚然。"],["冬夏が改めて施錠をし、再び黙したまま歩き出す。[l]\nともかく着いて行く僕等。","冬夏重新上锁后，再次沉默地迈步前行。[l]\n总之我们跟了上去。"],["と、前方に、以前外から視た、\nいやに高い朱い鳥居があるのが判った。","这时发现前方出现了\n那座曾从外面望见过的异常高大的红色鸟居。"],["茂みなのか植え込みなのか、\nこの國の古い庭園風ではない、\nかと言って防風林でもないような、\n自然の林のような領域が、","不知是灌木丛还是树篱，\n既非这个国家传统庭园的风格，\n却也说不上是防风林，\n这片宛如自然森林的区域，"],["裏戸から鳥居、というかその下の小さな","似乎从后门一直延伸到鸟居——"],["社まで続いているようだった。","或者说其下方的小祠堂处。"],["あれかな、結局何かの塚とか小さい神社、祠か何かが、\n丸ごと三春家の敷地内にあるという事かな。[l]\nこういうのは土地そのものに","是不是那个啊，说到底就是某种坟墓啊、小神社啊、祠堂之类的，\n整个都在三春家的地盘里这么回事吧。[l]\n这类东西本来就是"],["鎮","镇"],["座","守"],["坐すものだからなあ。","在土地本身之上的呀。"],["少々場違いに呑気な事を思索しながら、しかし沈黙のまま\n歩いていくと、","虽然思考着有些不合时宜的悠闲事，但仍保持着沉默\n继续走着，"],["「………」","「………」"],["冬夏が","冬夏在"],["社…","神社…"],["祠、","或者说是祠堂、"],["神","神"],["庫というべきか、[l]\nの裏手で立ち止まり、僕等の方を向きつつ何かを指差した。","库那边，[l]\n在后侧停下脚步，转向我们这边指了指什么。"],["何かというよりも、祠そのものを指し示しているらしい。","与其说是某物，似乎指的是祠堂本身。"],["裏手に来てるので、当然背面の壁が視えてるのだが、\n古びた御札とかが割とびっしり貼り付けられている以外は、\n特筆すべきことが…というより蔵に入る事に関係あるのか？","因为来到背面，自然能看到后墙，\n除了贴满陈旧符咒之类的东西外，\n没什么特别值得注意的……话说回来，这和进仓库有什么关系吗？"],["……えーと、これが何なんでしょう？","……呃，这是什么来着？"],["「………？」","「………？」"],["きぃが黙ったまま祠の背面壁に触れて冬夏を窺う。[l]\nお前、よく神仏関係のモノに躊躇無く触れられるなあ。","小贵沉默着触碰祠堂后墙，观察冬夏的反应。[l]\n你还真敢随便碰神佛相关的东西啊。"],["僕も格別信仰心篤い人間な訳じゃない──どっちかというと\n罰当りな部類──けど、多少の抵抗はあるぞ。","我也不是特别虔诚的人──硬要说的话\n属于遭天谴的类型──不过多少还是会犹豫的。"],["「（……ふぇ）」","「（……诶）」"],["などと考えていると、きぃが札の一枚を捲った。","正这么想着，小贵掀开了其中一张符纸。"],["その札は、上辺のみが貼り付けてあるらしく、\n下辺は別の札に挟み込むように固定してあったのだ。","那张符似乎只固定了上边缘，\n下边缘像是被夹在另一张符纸里固定着。"],["そして捲られたその下に、","而在被掀开的符纸下方，"],["「………！」","「………！」"],["……静かに驚いてはみたものの、[l]\n具体的に何かは不明だ。","……虽然暗自吃惊，[l]\n但具体是什么仍不清楚。"],["強いて言うなら、\nレバー式のドア取っ手みたいなのが、\n一段凹んだ構造の中にあったのだ。","非要形容的话，\n像是杠杆式的门把手，\n嵌在一段凹陷结构里。"],["冬夏は、やや笑みを浮かべつつ歩み寄り、\nきぃを横に除けてそれを弄る。[l]\n背面の一部が、奥へ向けて開いた。","冬夏带着些许笑意走近，\n把小贵推到旁边摆弄起那个机关。[l]\n随后部分后墙朝着内侧打开了。"],["ぎぃぃぃいぃぃ……","吱呀呀呀呀……"],["と音が、しない。","并没有发出这样的声响。"],["先刻の裏戸のように、\nまめに手入れがされているのか、\n開閉が異常な程にスムーズで、木材金属の軋む音は無かった。","和刚才的后门一样，\n或许因为精心维护过，\n开闭异常顺滑，没有木材金属的摩擦声。"],["というか、こういったこの國古来の建造物に、\n引き戸ではない所謂ドアが付いているというのは\n少々違和感があるな。","话说回来，这种本国古建筑上\n装着非拉门式的所谓正规门\n总觉得有点违和。"],["偏見かも知れないけど、お手洗いとかでしか見ない感じというか。[l]\nまあ、ドアにしたって普通は外側に開くしなあ。","可能是偏见吧，感觉只在厕所之类地方见过这种门。[l]\n不过普通门一般都是向外开的啊。"],["秘密裡に入りたい者にとっては、\n端から視て、シルエット的に大きな動きが無いとか、\n両手に荷物を持ったまま入り易いという利点はあるかもだけど。","对于想秘密进入的人来说，\n从侧面看没有明显轮廓动作，\n或是双手拿行李时容易进入倒算是优点。"],["冬夏は手招きをし、中へ入って行く。[l]\nどうやらすぐ下方へ向かう階段になっているらしく、\n……て、つい最近似たような経験をしたよ僕ぁ。","冬夏招手示意，走进里面。[l]\n看来里面是通往地下的阶梯，\n……喂，我最近刚有过类似体验啊。"],["と、とにかく、僕ときぃは冬夏を追って中へ入る。[l]\n構造としては、シークレットブーツの上げ底部分が\nこの隠し入り口空間になってるというか、","总、总之我和小贵跟着冬夏进入内部。[l]\n结构上来说，就像是秘密宝箱的夹层部分\n形成了这个隐藏入口空间，"],["うーん説明が難しいが、表側からよーく観察すれば、\n恐らくは外観と奥行きが合ってない事になってるという感じ？","嗯很难解释，但从外侧仔细观察的话，\n大概能发现外观和进深对不上？"],["まあでも表側は所謂格子戸になってるようだったし、\n仮にその中まで注視しても、奥行きが必ず外壁に沿ってるとは限らないし…と、まあスルーされ、いや、されてきたんだろう。","不过外侧是那种格子拉门，\n就算盯着看也未必能注意到进深与外墙不符…所以就被，不，是被忽略了吧。"],["やはり扉は閉まる時も音無しだった。[l]\n飯窪本家の地下とは違い灯りが無い為、昼間とは言え暗闇に閉ざされる。","果然关门时也没有声音。[l]\n与饭洼本家的地下室不同，这里没有照明，虽说是白天仍陷入黑暗。"],["僕の手を冷たい何かが触れ、た。","某个冰冷的东西碰到了我的手。"],["「（まだ黙っててね。[l]\n通路は灯り無いから手、引いてくから）」","「（先别出声。[l]\n通道没灯，我牵着你的手走）」"],["おうあ。[l]\n冬夏の手か。[l]\n小声の彼女の言に頷いてみせる。[l]\n……視えてんのかな。","哦好。[l]\n是冬夏的手啊。[l]\n我对着她轻声的嘱咐点点头。[l]\n……她看得见吗。"],["「（一列になりたいから、きぃはまことさんと手繋いで。[l]\nあ、すぐ降り階段なるから足元気をつけてね）」","「（要排成一列，小贵和真言先生牵手。[l]\n啊，马上是下坡台阶注意脚下）」"],["「（わかった）」","「（明白）」"],["「（のだわ）」","「（知道啦）」"],["今更というかこの状況下で、\n女子とのタッチングに心ときめかせる事も無く、\n黙して冬夏に手を引かれていく僕等二人。[l]\nつーかまた地下なのな…[l]\nデジャ・ヴュかよ。[l]\nあ、いや、実際過去経験してるから既視感じゃないやな。[l]\nリフレインかよ。天丼かよ。[l]\n…うう、合ってるかどうかも判らなくなってきた……","事到如今或者说在这种状况下，\n与女生的肢体接触也没让我心跳加速，\n我们俩沉默着被冬夏牵着手前行。[l]\n话说又是地下啊…[l]\n既视感吗这是。[l]\n啊不，实际上过去经历过所以不该叫既视感。[l]\n该说是复现吗。天妇罗盖饭吗这是。[l]\n…呜呜，连对不对都搞不清楚了……"],["くだらない雑念に溺れるうちに、階段が終わった。","沉浸在无聊杂念中时，楼梯已走到尽头。"],["「…ふぅっ。[l]\nお疲れ、お二人さん。[l]\n取り敢えずはクリア出来たかな。[l]\n大声じゃなきゃ喋っても良いよ」","「…呼～[l]\n辛苦啦二位。[l]\n暂时算是通关了吧。[l]\n只要不大声说话就可以哦」"],["相変わらず灯りは無いが、\n眼が慣れて来ていた御蔭で、\n","依旧没有照明，\n但多亏眼睛已逐渐适应，\n"],["薄らとお互いを視認出来る。","能隐约辨认出彼此的身影。"],["「ふひぃぃぃ、\n緊張したぁ…[l]\nか、肩が………」","「呜咿咿咿，\n紧张死了…[l]\n肩、肩膀都………」"],["「おっさんみたいな事言ってるさ…」","「说得跟大叔似的…」"],["悪かったな。[l]\n両手塞がってたの僕だけなんだぞ。","抱歉啊。[l]\n只有我双手都被占着呢。"],["「うちの蔵、二重？二層？構造っていうのかな？[l]\n正規の入り口からは入れない領域があって、\n変わり種の書物は多分そっちだと思う」","「我家仓库是双重？双层？该这么形容吗？[l]\n从正规入口进不去的区域，\n特殊书籍大概都在那边」"],["わたしも先日出入りを許されたばっかりなんだけど、\nと冬夏は云う。[l]\nその割には暗闇で僕等を先導出来てたじゃん。","我也是前几天才被允许进出，\n冬夏如此说道。[l]\n但你在黑暗中不是能给我们带路嘛。"],["…ともあれ、だから逆に結局ここまでをクリアすればあとは他人は\nほぼ入れないはずの区域、つまり見つかる確率はかなり下がる訳ね。","…总之，反过来说只要突破到这里，后面基本就是\n外人进不去的区域了，被发现概率会大幅降低呢。"],["成る程…って、それでいいのか。","原来如此…不过这样真的好吗。"],["とにかく、今までの経緯を顧みる限り、\n大量の書物を搬入する事に関しては全く度外視されたが如く\n小さな入り口、且つ通路だった。","无论如何，回顾刚刚走过的路，\n对于大量书籍的搬运问题简直像被完全忽视般\n只设置了狭小入口和通道。"],["この場合は或る意味では当然かもだが。[l]\n通常のモノに関しては、\n恐らくは正規の入り口から搬入して、正規のスペースに所蔵するんだろうし。","这种情况某种意义上或许也是理所当然。[l]\n普通物品的话，\n应该都是从正规入口搬运并存放在正规空间吧。"],["ごく一部のレア物を扱う分にはこれで十分だろう。[l]\n内蔵された全てのモノが、\nある一時期に一斉搬入されたはずもないだろうしな。","处理极少数珍品的话这样也足够了。[l]\n毕竟所有藏品\n不可能都在同一时期被批量运入。"],["にしてもここまで無駄とも言える程に凝った仕掛けとか要るか？","但至于搞这么夸张到堪称浪费的机关吗？"],["という単純な疑問が…[l]\n──それで言ったら飯窪本家もおかしなもんだが……","这样单纯的疑问…[l]\n──这么说来饭洼本家也挺古怪的……"],["それ相応の理由、それこそ家宝、御神体が有る故なのか、\n書蔵という共通項もあるし…","或许因为有相应理由，比如家传秘宝或神体存在，\n再加上都有书库这个共同点…"],["それとも……[l]\n単なる忍者屋敷趣味か？二家揃って？[l]\nいやいやいや……それはちょっとばかり痛々しいなあ…","又或者……[l]\n单纯是忍者宅邸爱好？两家都是？[l]\n不不不…那也太惨不忍睹了…"],["「まことさんが視たい物があるかどうかはわかんないけど、\nごめん、今回はこっち側で許して欲しいんだよね。","「虽然不知道真言先生有没有想看的东西，\n抱歉，这次希望你能迁就我这边。"],["構造的な問題と見つかる可能性を考えると、正規の方は\n止めといた方が無難。[l]\nどうしても…っていうなら……頑張るけど」","考虑到结构问题和被发现的可能性，正规区域\n还是别去为妙。[l]\n实在非要…的话……我会努力」"],["「いや、全然オッケーだって。[l]\n寧ろレアな方が視られる訳でしょ。","「没，完全没问题。[l]\n不如说稀有品更值得看吧。"],["もしかしたら家宝的な書か何かとか、\n屋敷神みたいなのもあったりして！[l]\nなんつって」","说不定会有传家宝级别的书或者\n宅邸守护神之类的东西呢！[l]\n开玩笑的」"],["「","「"],["大","大"],["黒…あ、御神体の事。[l]\nそれは私もまだ詳しく教えて貰ってないんだけど。[l]\n様付けで呼んだりしてたかな？確か」","黑…啊，是指神体。[l]\n那个我也还没详细了解。[l]\n好像是用尊称称呼的？记得是」"],["「オオ、クロ？」","「大、黑？」"],["「オオクロサマ、かー。[l]\nこの辺ではオシラサマとかオシロサマとかいう蚕神が有名の筈だけど、その亜流か、関係する何かなのかなあ…」","「大黑大人，吗——[l]\n这带本应以蚕神\"奥西拉大人\"或\"奥西罗大人\"闻名，或许是它的分支或相关存在吧…」"],["まさか","不会吧"],["黒、じゃないよなあ。[l]\nオオクロ、オグロ、オグル、オルガー…","黑，应该不是吧。[l]\n大黑、奥古罗、奥古尔、奥尔加……"],["うーん。[l]\nこれも宮さんに後で訊いてみよう。","嗯——[l]\n这个也等会儿问问宫小姐吧。"],["──そして養蚕といえば猫絡み、だったか。[l]\nもやもやしてあんまり具体的に覚えてないけど、\n初日に確か知狡さんがそんな話を。","──说到养蚕似乎和猫有关联来着？[l]\n模模糊糊的不太记得具体内容了，\n第一天确实听知狡阿姨说过这类话题。"],["猫、ねこか……[l]\nねこ………ねこねこ…………","猫、猫咪啊……[l]\n猫………喵喵…………"],["いや、それより、\n御神体は紙で、紙様だっていう話だったよな。[l]\n玄ノ森の住人も知らないそうだから黙っておくが。","不对比起这个，\n听说御神体是纸做的，被称为纸大人来着。[l]\n不过玄之森的居民似乎也不知道这事就先保密吧。"],["紙、でオオクロ…？[l]\n蚕と紙も何か関係あったような気もしたけど、\nどうだったかな…。","纸、和大黑…？[l]\n隐约记得蚕和纸也有什么关联，\n具体是怎样的来着…。"],["「ま、個人の家の祀り神だしね。まつりがみ、祭り……","「嘛毕竟是私人家里供奉的神明嘛。供奉之神、祭典……"],["ん？あ、ごめん。なんでも。[l]\nどこにあるかも聞いてないけど、\n此処の可能性はあるかもね。","嗯？啊抱歉。当我没说。[l]\n虽然也没问过具体位置，\n说不定就在这儿哦。"],["それ以外の話、詳しく聞きたいなら追い追い。[l]\n今はそれどころじゃない筈だよね皆さん？」","其他详情等之后有机会再聊吧。[l]\n现在大家应该都没空深究这个对吧？」"],["「おおう、そ、そうでした。","「噢、是、是这样。"],["？[l]\nどうしたきぃ。[l]\nぼーっとして」","？[l]\n怎么了小贵。[l]\n在发呆呢」"],["「――ふえ？[l]\n","「――诶？[l]\n"],["あいや、なんでもないのさ。[l]\nお腹減ってきただけかもなのだわ」","啊呀，没什么啦。[l]\n可能就是肚子饿了吧」"],["僕以上に脳空転してるのか、やけに茫洋としてるきぃ。","她脑子放空得比我还厉害，整个人飘飘忽忽的。"],["いつも朝食抜いてるって言うから、\nパンの一個くらいでも足しになるかと思って今朝ああしたのだが、\n下手に消化器系が稼働しちゃって逆に空腹感が増したかな。[l]\n悪いことした。すまん。","听说她总是不吃早饭，\n今早特意给了个面包想着能垫垫肚子，\n结果反而让消化系统运作起来更饿了吧。[l]\n是我多事了。抱歉。"],["「ふふ、いつも通りって事ね。[l]\nじゃ、とにかく歩こうか」","「呵呵，还是老样子呢。[l]\n总之先继续走吧」"],["あそう。[l]\n僕はとにかく、君等の通常時がどんなだか判んないからさ……[l]\nキリキリ歩きますかー。","这样啊。[l]\n毕竟我完全不清楚你们平时的状态嘛……[l]\n那就快步前进咯——"],["「ああ、ここまで来ると灯りあるのな」","「啊，走到这儿就有照明了呢」"],["少し歩くと、\n冬夏が壁のスイッチを弄り、\n飯窪の地下のようなオレンジの電燈を点けたのだ。","没走几步，\n冬夏摆弄墙上的开关，\n点亮了和饭洼家地下室一样的橙色电灯。"],["「うん。[l]\nここまで入り口から離れれば光が外に洩れないから、\nだと思う」","「嗯。[l]\n这里离入口够远灯光不会外泄，\n我是这么认为的」"],["ちなみに、\n外部のセキュリティ業者の警備とかはこっちの入り口及び通路には\n無いらしい。[l]\n対外的に秘密ならばそれはそうなんだろうが…","顺带一提，\n外部安保公司的警备范围\n似乎不包含这个入口和通道。[l]\n既然是对外保密的场所倒也合理…"],["歩きながら冬夏は語る。","冬夏边走边说着。"],["「人は余程の事がないと、\n言われた事は鵜呑みにするもので、\n積極的物理的害意がないと感じられた場合は、\nあ、この場合実際の害意の有無は別ね。[l]\nそれがどんなに荒唐無稽であっても、\n良き方に解釈して結果騙されるんだって。[l]\n西の方に住んでる知り合いが言ってた事だけどね」","「人只要没遇到特别状况，\n就会全盘接受被告知的事情，\n只要感觉不到主动的物理性恶意——\n啊、这里实际有无恶意另当别论。[l]\n不管内容多么荒诞无稽，\n都会往好的方面解读结果上当受骗。[l]\n这是住在西边的熟人告诉我的」"],["何かこれまたチノ嬢が今朝言ってた様な事だな。[l]\nあのひと、テレパスなだけでなく未来予知者かよ。","这话和千乃小姐今早说的如出一辙啊。[l]\n那家伙不仅是心灵感应者还是未来预知者吗？"],["「だから、\nこんな、普通は考え難い構造物があっても、\nそれがそうとはなかなか気付かれないみたい。[l]\nま、そもそも個人宅の敷地内だしね。[l]\n積極的な意思というか前知識が無い限りは、\nどうこうしようとは思わないよね。[l]\n私も言われるまでは全く気にしてなかったし」","「所以、\n就算有这种、通常难以想象的构造物存在、\n人们似乎也很难意识到这点。[l]\n嘛、毕竟原本就是私人宅邸的领地范围内嘛。[l]\n只要没有积极的意愿或者说先验知识、\n一般都不会想着要做什么吧。[l]\n我在被告知之前也完全没注意到呢」"],["まあ、そりゃあそうだ。","嘛、那倒确实。"],["「更に、祠や、御札、ね。[l]\n対象の文化圏に於いて禁忌とされる聖域、神域というのは、\nなかなか大きな心理的抵抗を生じさせるようだね」","「再加上、祠堂啦、符咒啦。[l]\n在目标文化圈中被视为禁忌的圣域、神域这类场所、\n似乎会产生相当大的心理抗拒呢」"],["そう。[l]\n信じる信じないというより、\nまさに心理的な問題だ。","没错。[l]\n与其说是信不信的问题、\n不如说纯粹是心理层面的影响。"],["「鳥居を置いたら不法投棄が減少したって奴か」","「就像放个鸟居就能减少非法丢弃垃圾那种案例吧」"],["「鏡を置いたりとかね。[l]\n第三者の眼というのは割と有効な手らしいけど」","「或者摆面镜子什么的。[l]\n第三者视线的存在似乎是相当有效的手段」"],["「ふええ、\n","「呜诶诶、\n"],["田","田"],["圃にある鳥除けの目玉風船みたいな？」","里驱鸟用的眼球气球那种？」"],["「……え…っと、[l]\nどうだろ。[l]\n合ってる？まことさん」","「……呃…那个、[l]\n怎么说呢。[l]\n对吗？真言先生」"],["「微妙に、いや全然違う…かなあ……」","「微妙地、不完全是…可能完全不对吧……」"],["大体、こいつは平気で祠にも御札にも触ったしな…","说到底、这家伙可是若无其事地碰过祠堂和符咒啊…"],["「と、冬夏の説明が抽象的過ぎるのさ。[l]\nそんなことより早くするのだわっ！」","「所以说冬夏的解释太抽象啦。[l]\n比起这个快点行动啦！」"],["はいはい。","好啦好啦。"],["まあ、文化圏…いや、同じ社会内部であっても、[l]\n価値観が根底から違ってる人や、\n現実に即した事象にしか想像力を行使しない人には効かない訳だが、\n人は適度に敬虔で在りたいね…","不过嘛、文化圈…不对、就算在同一个社会内部、[l]\n对于价值观根本不同的人、\n或者只对现实存在的事物发挥想象力的人是不管用的、\n人类还是适度保持敬畏比较好呢…"],["たとえ理論的でなくても、生物の一種には違いないヒトの自然な反応の一つでしょう、神の眼を感じるのは。","即便不理性、感受到神之眼终究是作为生物的人类自然反应之一吧。"],["とにかく一番驚いたのは、\n塀の入り口はともかく、\nこの秘密の裏口には錠が無いという事だった。","总之最令人惊讶的是、\n围墙入口姑且不论、\n这个秘密后门居然没有上锁这件事。"],["敢えて厳重さを排する事で、一見した機密レベルを下げ、\nそれによって注意を逸らすという、\n裏目に出れば単なる無防備方策のようだが、\n実際それで長年通じてきたという訳だ。","刻意不设严密防备来降低表面上的机密等级、\n借此转移注意力、\n搞砸的话就只是单纯的毫无防备策略、\n但实际上这套方法多年来都很奏效。"],["路傍に家宝の甕を放置して、本来的な道具として通常使用してたら\n誰も値打ち物だと気付かなかったという話は本で読んだけど…[l]\nまあ、錠がある時点でそこは『隠し』扉じゃない訳だが。","古籍记载有人把传家宝瓮放在路边当普通器具日常使用、\n结果谁都没发现那是贵重品来着…[l]\n不过嘛、既然有锁就说明那算不上『隐藏』门啦。"],["あとは実利的な問題として、\n重々しい錠前か何かを付けてしまうと、\n開錠時に音が鳴ってしまう事を危惧したというのも\n理由の一つらしい。","另外从实用角度考虑、\n如果装上笨重锁具之类的东西、\n开锁时发出声响也是个顾虑、\n据说这也是原因之一。"],["扉の開閉はあんだけ音消せるんだから、\n何かしら方策はある気がするけど。","明明门轴消音做得那么到位、\n总觉得应该还有其他对策才对。"],["「にしても、\n結構長いなあ…この地下道は……」","「话说回来、\n相当长啊…这条地下道……」"],["所謂――と言っても僕も実物を見たことはないが、\n防空壕、はたまた坑道のような感じである。[l]\n土を掘った穴を木枠で補強、という程お粗末ではないが、\nセメント打ってあるでもなく、恐らく壁面は木材である。[l]\n飯窪本家の地下室は博物館のようだったが、\nこっちはもっと泥臭いというか、\n向こうはそもそも屋内だからそりゃあ違うんだろうけどさ。","说是所谓的――虽然我也没见过实物、\n但感觉像是防空洞、或者矿坑通道那种构造。[l]\n倒不至于简陋到只是用木框加固土洞、\n但也没浇筑水泥、墙面恐怕是木材。[l]\n饭洼本家的地下室像博物馆似的、\n这边就更土腥味十足、\n不过那边本来就是室内建筑所以当然不同啦。"],["しかして、暗くて断言は出来ないが、\n放置されて誰も人が踏み込まなくなって久しい、という感じではなく、現役使用されてる感はある。","虽然太暗不敢断言、\n但不像长期闲置无人踏足的样子、反而有种仍在使用中的感觉。"],["そりゃあそうか。","那倒也是。"],["実際の防空壕を流用したのかとも思ったが、\n言っちゃ悪いがこんな田舎に壕を掘る理由も無さそうだしなあ。[l]\n寧ろ疎開先だろこの辺は。","我原以为是改造了实际存在的防空洞、\n但说真的这种乡下地方根本没理由挖防空洞吧。[l]\n不如说这一带当年是疏散地才对。"],["となればこの秘密通路としての在り方が本来的な意義という事になる。","那么这条密道的存在意义就是原本设计的用途了。"],["…まあ過去に","…嘛，毕竟过去曾"],["書","被称作"],["蔵 ","书"],["守 と言われていただけあって、[l]\nその","藏守，[l]\n既然"],["所","如此"],["以たる飯窪と三春にこのような大仰な仕掛けがあっても、\nおかしくはないのかも知れないが…","饭洼和三春家存在如此大费周章的机关装置，\n或许也不足为奇吧…"],["にしたってなあ。[l]\nまあいいや。[l]\n歴史は専門外です。","即便如此还是觉得夸张啊。[l]\n嘛算了。[l]\n历史并非我的专长。"],["「何が専門外さ？[l]\nさっきから何ぶつぶつぶつ呟いてるのだわ」","「什么叫非专长？[l]\n从刚才就一直在嘀嘀咕咕些什么呀」"],["「へ？[l]\n何も言ってないっすよ？[l]\nねえ冬夏？」","「诶？[l]\n我什么都没说啊？[l]\n对吧冬夏？」"],["「…二人ともほんとにお気楽だねぇ……」","「…你们两个真是心大呢……」"],["すると、","这时，"],["「ちょっとまって」","「稍等一下」"],["と言って、通路の途中で立ち止まった。","说着，在通道中途停下了脚步。"],["「もしかして壁に隠し扉があったり？」","「莫非墙上有暗门？」"],["「あれ？[l]\nばれた。[l]\n良く判ったねまことさん」","「哎呀？[l]\n暴露了。[l]\n真亏你能发现呢真言先生」"],["「いやその…ほんとに？[l]\nや、偶然なんすよ…へええ……」","「不是…真的假的？[l]\n只、只是偶然啦…哎呀呀……」"],["そう、偶然にも殆ど同じ経験を昨日してますからー。","没错，毕竟昨天刚经历过几乎相同的巧合嘛——"],["「この先には昔のお手洗いみたいな小部屋が\nダミーとして造ってあるみたいだね。","「前面好像建了个像旧式厕所的小房间\n作为伪装用的假空间。"],["――基本的に此処まで侵入されるのは考え難いし、\nあくまで保険、念の為って言ってたけど。[l]\n聞いただけで私も行ったことない」","――基本上很难想象会有人入侵到这种地方，\n不过据说是作为保险措施，以防万一用的。[l]\n我也是只听过描述没实际去过」"],["うーん、先刻からの疑惑だけども、\n飯窪本家と此処、同じ人間が設計したんじゃないだろうな……","唔，从刚才就有的疑惑，\n饭洼本家和这里，该不会是同一人设计的吧……"],["色んな要素を加味すると、全く可能性が無いわけじゃないだろうが、\nいずれにせよ何というか、\n物が古いからかどうなのか微妙にぬるい設計思想だなあ……","综合各种因素考虑，倒也不是完全没可能，\n但无论如何该怎么说呢，\n不知是因为年代久远，总觉得设计理念微妙地松懈啊……"],["それでよくぞ今まで。","这样居然能维持到现在。"],["先刻の冬夏の講釈があるとはいえ、\n人間は騙そうと思えば騙せるんだねえ……[l]\nそれとも何かマジに結界とか張ってあるとか。","虽说有冬夏先前的解说，\n人类只要想骗还是能骗过去的呢……[l]\n又或者真的设置了什么结界之类。"],["そんな馬鹿な。","哪有这种荒唐事。"],["「じゃ、こっからはまた静かに。[l]\n──行くよ」","「那么，从这里开始继续保持安静。[l]\n──要前进了」"],["隠し扉を抜けると、上昇階段となっていて、\nどうやら蔵の、正面からは入れない空間にいよいよ\n接続すると思われた。","穿过暗门后是上行阶梯，\n看样子终于要连接到\n仓库里从正面无法进入的空间了。"],["昇り切った先にはまた扉があり、\nここでもまた音も立てず、\n冬夏がそれを開いた。","阶梯尽头又是一扇门，\n这次冬夏同样无声无息地\n将其打开了。"],["これは――","这是――"],["全て、紙だ。","全部，都是纸。"],["紙だが、","说是纸，"],["積んであるだけだ――\n只ひたすらに紙、かみ、カミが。","却只是堆积着――\n纯粹到极致的纸、纸、纸。"],["一応、農機具収納庫の様に、\n木製の大きな棚が沢山置かれてあり、","姑且像农机具储藏室般，\n摆放着许多木质大架子，"],["きっちり整然と収蔵してあるスペースもあるが、\n大半は無造作にひたすら積み重ねられただけである。","也有整理得井井有条的收纳区域，\n但大部分都只是随意堆叠成山。"],["壁面には窓が無い為に、余計に閉塞感がある。","墙面没有窗户，更添闭塞感。"],["灯りはあるが、やはりオレンジで、\n視界全てにノイズが掛かってるような気がする。","虽有照明，但依然是橙黄色，\n仿佛整个视野都蒙上了噪点。"],["とにかく空間の把握が困難だ。[l]\n広さが全く認識出来ない。","总之很难把握空间全貌。[l]\n完全无法感知实际大小。"],["そしてつまり、これは。","也就是说，这些。"],["本というよりは――\n紙片。","与其说是书本――\n不如说是纸片。"],["一枚一枚のバラであるものが殆どで、\n書物――巻物ですらない――の体裁をとっていない。[l]\n今の大きさで言うならＢ５かＡ４位の単体の紙片の山。","几乎全是一片片散落的纸张，\n根本不成书籍――连卷轴都算不上――的形状。[l]\n按现在的大小来说，就是堆B5或A4尺寸的单独纸片。"],["しかし絶対的なその量が、\n一種異様な迫力を発しており、こっちは圧倒されるのみだ。","但绝对的数量，\n散发出某种异常的压迫感，我只能被震慑住。"],["製紙とか、製本工場だと近い感覚なのかも知れないが、\n違う、そうじゃない、違和感がある。[l]\n何だ？ 何が違う？","或许更接近造纸厂或装订工厂的感觉，\n不对，不是那样，有种违和感。[l]\n什么？哪里不对？"],["とにかく、\n通例、紙や書籍を保管とか保存しようと施すであろう処置にしろ、\nそういった努力は皆無のようだった。","总之，\n通常对纸张或书籍进行的保管或保存处理，\n这类努力似乎完全不存在。"],["留意して収められているとは到底考えられない、\n粗雑な扱いだと思う。","根本谈不上是精心收纳，\n我觉得太粗劣了。"],["「（これは、ぱっと見もはや書庫じゃないよな……）」","「（这乍看根本已经不是书库了吧……）」"],["まず第一に本が無い。","首先根本没有书。"],["「（あ、れ…[l]\n間違えたかな……[l]\n前と…違う気が…）」","「（啊，咦…[l]\n难道搞错了……[l]\n和之前…感觉不一样…）」"],["「（え！）」","「（诶！）」"],["「（私も初回のときは緊張してたから…[l]\n記憶は定かじゃないけど…[l]\nどうしよう…）」","「（我初次来的时候也很紧张…[l]\n记忆不太清晰了…[l]\n怎么办…）」"],["う、うーん。","唔，嗯——"],["今回のミッションが本星じゃない以上、\nあまり想定以上の時間を割きたくは無いし、\n第一冬夏も知らなかった空間の方がレア中のレアがあるかも知れない。","既然这次任务不是本星，\n不太想耗费超出预期的时间，\n况且冬夏都不知道的空间里说不定有稀有中的稀有物。"],["そう、御神体にしろ月狂跳にしろ、\n事実書籍の形をとっているかは定かでないのだ。","没错，无论是御神体还是月狂跳，\n事实上未必都呈书籍形态。"],["宮さん達が探す資料足り得るのなら単なる紙片でも月狂跳であるのだろうから。","只要符合宫他们寻找的资料条件，就算是纸片也能算月狂跳吧。"],["取り敢えずはこのままこの空間を視てみるのも有りと判断する。[l]\nきぃに異論が無ければだが。","我判断暂时先继续观察这个空间也行。[l]\n只要小贵没异议的话。"],["「（ふえ？[l]\nあーいいさ。[l]\nこのままみるのだわ）」","「（呼诶？[l]\n啊——好啊。[l]\n就这么继续看吧）」"],["腹が減って来てるのか、\n","可能是肚子饿了，\n"],["等","得到了"],["閑なリアクションを返された。","一个漫不经心的反应。"],["「（じゃあおーけーという事で…）」","「（那就这么定了…）」"],["「（うん、ごめんね。[l]\n前も言ったけど、出来るのは手引きくらいで、\n私も最低限の事しかわかんないんだよ）」","「（嗯，抱歉。[l]\n之前也说过，我只能做向导这类事，\n我也只知道最低限度的信息）」"],["そう言えばそう言ってたよな。","说起来确实这么说过。"],["しかし、何だかんだで此処まで連れて来てくれた時点で、\nもはや手引き云々の域を超えてる気がするが。","但事到如今都带我们到这里了，\n感觉已经超出向导的范畴了。"],["まあこういった特殊な入り方の場合は、\n此処までのプロセスが一緒くたに入る為のワンステップとも言えるし、何を以って最低限かはもはや冬夏の尺度である。","不过这种特殊进入方式的情况下，\n到达此处的过程本身也可视为一个步骤，所谓最低限度全凭冬夏的标准了。"],["いずれ僕等にとっては有益だった。","总之对我们是有益的。"],["「（…んー、暗いし、積んである紙は最上段しか視えないし、[l]\nどこかに確認出来そうなの無いかみてみよう）」","「（…嗯——太暗了，堆积的纸只能看到最上层，[l]\n找找看有没有能确认的东西吧）」"],["実際これは手近なとこから引っ張り出すにしたって骨だ。","实际上就近抽取查看也很费劲。"],["視認出来るのは冬夏が言ったとおり紙山の頂上部だけで、\n高いし暗いしで、現場に手を触れずに確認するのは恐らく\n不可能だろう。","如冬夏所说，可视范围只有纸堆顶端，\n又高又暗，想不触碰现场就确认，\n恐怕不可能吧。"],["やや途方に暮れる。[l]\n臭いだけが、田舎の農機小屋のような","有点束手无策。[l]\n只有气味，像乡下农机小屋般"],["饐えた、\n木、藁、土、","发馊的，\n木头、稻草、泥土、"],["黴、湿気、そしてケモノの――\n猫の？","霉味、湿气、还有野兽的――\n猫的？"],["いや。まて。[l]\nああ。[l]\nそうか。","不。等等。[l]\n啊。[l]\n原来如此。"],["墨もインクの匂いも無いのだ。[l]\nそれが違和感だ。","既没有墨香也没有墨水味。[l]\n这就是违和感。"],["宮さんの『ねこざんまい』では、\n古書も扱っていたので墨の匂いも結構したし、","在宫小姐的『猫三昧』里，\n因为也经营古书所以墨香相当浓郁，"],["僕自身が趣味で購入する最近の本にしても、\n紙のそれとは別に、インクの独特の匂いがしたものだ。","就连我出于兴趣购买的近期出版物，\n除了纸张本身外也带着油墨特有的气味。"],["が、\nここにはない。","但，\n这里没有。"],["もしこれだけの紙片に何かが記されているならば、\nそして換気性も恐らく通常よりも低いであろうこの空間ならば、\n間違いなくするはずの匂いが──","倘若这么多纸片上记载着什么内容的话，\n而且这个空间通风性恐怕比平常更差的话，\n理应存在的味道却——"],["どうなんだろう。[l]\n単に僕の浅薄な知識と経験がそう思い込んでいるだけか？","怎么回事呢。[l]\n莫非只是我浅薄的知识和经验导致的错觉？"],["この空間自体、無臭な訳ではないので、\n何らかの防臭処理なのかも知れないけど。","这个空间本身也并非完全无味，\n说不定做过某种防臭处理。"],["いずれにしろこの有様では、\nそれとなく何かを探す、という行為は不可能に近い。","总之这种状况下，\n想不动声色地搜寻东西几乎不可能。"],["明確に目的意識を持って対象物を探索する事になってしまう。[l]\nそうやったとしても、このカオス…というか単純に物量の前では、\n容易ではないだろう。","只能带着明确目的去锁定目标物了。[l]\n即便如此面对这片混沌…或者说单纯的数量压制，\n恐怕也不容易吧。"],["リスクはあるが","虽说这任务原本"],["中ればめっけもん、程度のミッションだったとは言え、今回は無駄骨も已む無しだ。[l]\nむしろそのリスクを如何に零のまま帰還出来るかを考えなければ…","不过是 “虽有风险，但只要深入就能有所收获” 的程度，但这次恐怕要白跑一趟了。[l]\n不如考虑如何零风险撤退更实际…"],["「（本の状態、のものは無い、ねえ…）」","「（没有长得像书的东西呢…）」"],["「（…これは…、[l]\n私も………てな…ったな…）」","「（…这是…，[l]\n我也………变成…这样了啊…）」"],["「（え？何？）」","「（咦？什么？）」"],["「（あ、何でもない…）」","「（啊，没什么…）」"],["と、僕の後ろから、\n動物が匂いを嗅ぐように、\n鼻をくんくん鳴らしながらその辺を忍び足で歩くきぃ。","这时从我身后，\n像动物嗅气味般，\n小贵边吸着鼻子边蹑手蹑脚在周围走动。"],["「（ふえええー、\nふえええー、\nこぉれはぁー…なによぉ……これじゃあ……何も…）」","「（呜诶诶——\n呜诶诶——\n这~是~什~么呀……这样根本……什么都…）」"],["空腹が脳空転を通り越して怒りを召致したのか、\nがっかりした風に顔を","不知是空腹导致脑回路短路引发怒火，\n她摆出失望的表情"],["顰め、\nハトのように首を","皱着脸，\n像鸽子般"],["忙しなく動かして紙の山を視る。","频繁转动脑袋扫视纸堆。"],["背表紙も何もあったもんじゃないしなあ。","连书脊之类的特征都没有嘛。"],["「（気持ちは分かるけど、もう少し落ち着け、きぃ。[l]\nあんまり大きな動きすんな）」","「（我懂你的心情，但冷静点小贵。[l]\n动作别太大）」"],["大体お前先刻は適当なリアクション返してたじゃないかよ。","话说你刚才不是随便应付了几句吗。"],["…まあ、きぃの目的が真実只の好奇心であれば、[l]\nこの状況は甚だつまらない事だろう。","…不过如果小贵的目的纯粹出于好奇心，[l]\n这状况确实够无聊的。"],["好奇心を満たす＝事実認識であれば別だけど。[l]\n見た感じ落胆の色は隠してないようだし。","除非满足好奇心＝能获得事实认知。[l]\n看她样子完全没掩饰沮丧呢。"],["勿論、別目的があるとか、正面からの方なら望みのものが\n見られたかも知れないのだが。僕も。","当然，要是有其他目的，或许正面突破\n就能找到想要的东西。我也是。"],["「（…にしてもすごいなあ）」","「（…不过真厉害啊）」"],["うろつくきぃと静かに周囲を見回す冬夏を尻目に、\n取り敢えずうず高く積まれた紙々を見上げる。","余光瞥见徘徊的小贵和静观四周的冬夏，\n我暂且仰视堆积如山的纸堆。"],["仮にここが冬夏の思い違いでないとしたって、\nやはり、今回はいくらなんでも、","即便这里真是冬夏所想的地方，\n但这次果然无论如何，"],["たった一度、たった一枚の模写を見せられただけのサンプルから類推してこの中から月狂跳を探すのは無理だろう。","仅凭看过一次的临摹样本就想从这里面找出《月狂跳》也太勉强了。"],["少しでも特殊な扱い或いは収納のされ方してればまだしも、\nざっと視た限りではどうも此処は、これでは単なる紙置き場だ…","要是有什么特殊处理或收纳方式还好说，\n粗略看来这里就是个普通堆纸场…"],["……あんな面倒なアクセスの行き着く先であるからには、\n何かしら人目に触れさせたくない何かがあるとは思うのだが。","……既然要经过那么麻烦的通道才能抵达，\n应该存在不想被人发现的东西才对。"],["木の葉は森に隠せ…の理論で、この中に隠されてた場合は、\n時間的にも労力や状況的にもやはりお手上げだ。","但若是藏在树海战术里，\n无论时间精力还是现状都只能放弃了。"],["うーん、やはり冬夏が間違って別の部屋に来たとみるべきだろう。[l]\n秘密の別空間は他にもあるのだきっと。","嗯，还是该认为冬夏搞错房间了吧。[l]\n肯定还有其他秘密空间。"],["てか、そうだと話として楽なんだが。[l]\nゲームじゃあるまいしなあ…","话说回来，要真是那样的话事情就简单多了。[l]\n这又不是在玩游戏啊…"],["ともあれ、\nまずは手近のものを手に取ろうと視線を下ろし──","总之，\n先就近拿起手边的东西低头查看──"],["──総毛立った。","──顿时毛骨悚然。"],["首筋から後頭部にかけての皮膚と筋肉が収縮し、[l]\n血が下がり、冷や汗が\nまるであのときの、紅い視界が、","从脖颈到后脑勺的皮肤与肌肉骤然收缩，[l]\n血液倒流，冷汗\n简直就像那时候的，鲜红视野，"],["「………ふはっ」","「………呼哈」"],["過呼吸になりかけた時に、\n首のチョーカーを触れる、\nああ、なん、とか…おち、つける……","在快要陷入过度呼吸时，\n触碰脖子上的项圈，\n啊，怎、么…冷静…下来……"],["──あぶないところだった。[l]\n思い込みでも刷り込みでも、\n御守という存在はこういう場合に拠り所になるらしい。","──差点就危险了。[l]\n不管是心理作用还是条件反射，\n护身符这种东西在这种时候似乎总能成为依靠。"],["有り難う御座います宮さん。","多谢了宫小姐。"],["幸い、というか薄情にも、というか、\n二人は気付かなかったらしい。","幸运的是，或者说薄情的是，\n两人似乎都没有察觉。"],["「（…いいけどな、別に……あ）」","「（…不过也无所谓啦，反正……啊）」"],["眼に入ったものがあった。[l]\n違和感が今あったのだ。","有东西映入眼帘。[l]\n刚才产生了违和感。"],["「（？[l]\n何だ？[l]\n今何か…）」","「（？[l]\n什么？[l]\n刚才有什么…）」"],["何か、視界に引っ掛かったものに意識下で勝手に反応した。","潜意识里对视野中某个引起注意的东西自动产生了反应。"],["全方位視界…つまりどこにも焦点を合わせず広範囲を同時に\n視たのだろう。","全景视野…也就是没有聚焦任何一点同时扫视广阔范围\n的方式吧。"],["よく本屋で、趣向に引っかかる本を探す時にやる遣り方だ。","就像在书店找合口味的书时常用的方法。"],["何か脳で検索すべきもの、として認識している何かが視界を\n","肯定是大脑识别到某个需要检索的对象，\n"],["過ぎったのに違い無い。","从视野中掠过了。"],["暗さにどんどん眼が慣れてきていた所為もあるのだろうが、\nどこだ。[l]\nどこにあった。[l]\nそして、そもそも何を視た。","也可能是因为眼睛逐渐适应了黑暗，\n在哪里。[l]\n刚才在哪里。[l]\n而且，到底看到了什么。"],["「な…んだこれは」","「这…是什么啊」"],["ある乱雑に積まれた紙の山の、\n数多にはみ出た紙片のうちの一枚を、再視認出来た。","在一堆杂乱堆积的纸山中，\n重新辨认出了众多散落纸片中的一张。"],["これだ。[l]\nこれに反応したんだ。","就是它。[l]\n是对这个产生了反应。"],["慎重にその一枚を引っ張り出し、確認する。[l]\n何故かも解った。","小心地抽出那张纸确认。[l]\n也明白了原因。"],["あの日見せられた、『月狂跳』の一種。[l]\nあれの図柄に印象が似ている。[l]\n国籍不明な感じやら何やらが。","那天被展示过的，『月狂跳』的其中一种。[l]\n和那幅图的风格很相似。[l]\n那种国籍不明的感觉之类的。"],["全く一緒ではないが、\nそもそも『月狂跳』はある資料の総称らしいから、","虽然不完全相同，\n但据说『月狂跳』本来就是某类资料的总称，"],["前に宮さんが言っていた通り、\n別件の奴が此処にもあった、ということか。","正如宫小姐之前所说，\n其他相关的东西也在这里出现了吧。"],["いや、まだこれが『月狂跳』かどうかは分からないが。[l]\n一応挟まっていた部位の前後を確認してみると、\n何枚か置きに似たような図像の描かれた紙片が現れたのだった。","不，还不能确定这就是『月狂跳』。[l]\n试着查看夹着它的前后位置，\n每隔几张就会出现类似图案的纸片。"],["その紙山凡てがそうではなかったものの、\nもしこの空間の全体が同じようなら、\nかなりの量が恐らくは含まれている事になる。","虽然整堆纸并非全都如此，\n但如果整个空间都是这样的话，\n恐怕包含的数量会相当惊人。"],["もしこれらが月狂跳だとして、\n仮に御神体オオクロがイコールそうだとすると、\nこの中に…あるのか？","假设这些都是月狂跳，\n若御神体大黑等同于这类东西的话，\n就在这里面…吗？"],["それともこの一群全体が御神体なのか？[l]\n冬夏は知ってるのだろうか。","还是说这一整批都是御神体？[l]\n冬夏会知道吗。"],["「（ん？[l]\nなに？）」","「（嗯？[l]\n什么？）」"],["「（あの、さあ、今見つけたこれ、\nに、ちょっと興味があるんだけど）」","「（那个，我说，刚才发现的这个，\n稍微有点在意来着）」"],["「（……へえ。[l]\n？[l]\nあれ、これは…）」","「（……诶。[l]\n？[l]\n哎呀，这是…）」"],["「（？）」","「（？）」"],["「（ただの紙切れ…じゃないの？）」","「（不就是张碎纸片…吗？）」"],["「（え？[l]\nまあ、本じゃなくても問題は無いんだけど…）」","「（啊？[l]\n嘛，不是书也没关系啦…）」"],["「（あ、いや、ううん…ええと……[l]\nまことさんこれ、何が描いてあるか理解出来てる？）」","「（啊、不、那个…呃……[l]\n真言先生看得懂这上面画了什么吗？）」"],["「（何？[l]\nどうしたのさ。[l]\nふえ、何か描いてあるけど、やっぱ只の紙切れなのだわ）」","「（啥？[l]\n怎么了嘛。[l]\n呼诶，虽然画了点什么，果然还是普通的纸片啦）」"],["「（お前はいいっての。[l]\nえーと理解ね…まあぼんやりと何かすごく惹かれる……というか、[l]\n理解の方はこれから何とか、）」","「（你倒是无所谓。[l]\n呃理解嘛…隐约觉得特别吸引人……或者说，[l]\n理解方面还得再想办法，）」"],["「（そうなんだ…まことさんそうなんだ……）」","「（这样啊…真言先生原来如此……）」"],["な、何だよ。[l]\nそんな人を憐れむ様な眼で視ないでください…[l]\n電波じゃない、電波じゃないよ！","干、干嘛啊。[l]\n别用那种怜悯的眼神看我…[l]\n不是妄想，不是妄想啦！"],["と、とにかく、この一枚だけでも宮さんに視て貰いたい。[l]\nこれをどうにか出来れば無駄足にならずに済むかもしれない。[l]\nという事で、","总、总之，至少想让宫小姐看看这一张。[l]\n要是能搞定这个说不定就不算白跑一趟。[l]\n所以，"],["「（という訳で、とにかくこれに惹かれるものがあるんだよ。[l]\nあのさ冬夏、\nこれ、この一枚だけで良いんだ。[l]\n……借りちゃまずい？）」","「（就是说啊，总之我被这东西吸引住了。[l]\n那个冬夏，\n就这一张就好。[l]\n……借走不太好吧？）」"],["駄目なら、宮さんには口頭で報告するか、\n──最悪、隠匿して持ち出すか。[l]\nそんなスキル無いしあんまりやりたくないけど。","不行的话，要么口头向宫小姐汇报，\n──最坏情况，偷偷带出去。[l]\n虽然没这本事也不太想干。"],["「（………あ、ええと……………）」","「（………啊、呃……………）」"],["何故か半笑い気味で視線を泳がせ、\n僕と紙を交互に見比べる。[l]\nうう、僕の言動そんなに危ない人っぽかったか？[l]\nきぃなんかもうまたどっか行っちゃったし。","不知为何似笑非笑地游移视线，\n在我和纸片之间来回打量。[l]\n呜哇，我的言行看起来这么像危险分子吗？[l]\n小贵又不知道跑哪儿去了。"],["「（…良いと思うよ。[l]\n何なら無期限で貸しにしとくけど。[l]\n滞在期間もわかんないんでしょ？[l]\n大体、紙切れ一枚こぉんな中から無くなっても、ねえ…）」","「（…我觉得可以哦。[l]\n要不干脆无限期借给你？[l]\n反正你也不知道会待多久吧？[l]\n说到底，少这么一张纸片在这种地方根本不会有人发现啦…）」"],["本当に予想外だったのか、周囲の紙の山を見渡しながら、\nやや呆れ気味、自暴自棄気味に許諾してくれる冬夏。","冬夏环顾四周堆积如山的纸张，\n带着几分无奈和自暴自弃的态度意外爽快地答应了。"],["「（黙ってれば分かんなかったでしょうに、\nまことさん真面目ー）」","「（要是不说根本不会有人发现，\n真言先生太较真ー）」"],["「（あう…[l]\nあ、あのねえ）」","「（呜…[l]\n啊、那个啦）」"],["無期限でって、逆に無期限に貴女に借りが出来る事でしょうが。[l]\n結構です遠慮します返します。[l]\nでもそれも本家…というか宮さん次第か。","无限期什么的，反而会变成我欠你无限期人情吧。[l]\n不用了谢绝好意会还的。[l]\n不过这也得看本家…或者说宫小姐的意思。"],["滞在期間は勿論、\n持って帰るって事はあの人らに視て貰うって事だからなー。","逗留的时间就不用说了，\n带回去就意味着要让那群人过目啊ー"],["まさかそのまま着服って事は無いだろうが…[l]\n書に関してはある程度の無茶を許容する、というのが今回の\nそもそもだからな…","虽然不至于直接私吞…[l]\n关于书籍这次本来就允许一定程度上的乱来\n毕竟原委如此…"],["いや、僕が責任持って返却しよう…[l]\n冬夏に借り作るのは僕だし……","不，我会负责归还的…[l]\n毕竟，是我向冬夏借来的……"],["だが、僕はいつまで、\n冬夏達とこんな関り方が出来るのだろう。","但是，我还能和冬夏她们\n保持这种关系多久呢。"],["偽りの──\nごめん、この状況ではセンチメンタルに浸れないわ。","虚假的──\n抱歉，现在没空多愁善感。"],["それにしても。","话说回来。"],["やはりインクの匂いはせず、そして、\n保存状態が好い…というより、[l]\n単純に新しいもののように視える。","依然没有墨水的气味，而且\n保存状态良好…不如说[l]\n看起来根本就是新东西。"],["レプリカという事か、或いは、\n宮さんに見せて貰ったもののように、\n最近誰かが模写したものか。","是复制品吗，又或者\n像宫小姐给我看过的那些一样\n最近有人临摹的？"],["それでも匂いの件は疑問が残るが、\n気にしすぎかなあ。[l]\n気のせいかなあ。","即便如此气味的事仍留有疑问，\n是我想太多了吧。[l]\n是错觉吧。"],["「（実際良かったんだよ別に。[l]\n今更良い子ぶったって、\n蔵の中に引き入れる手引きした時点で…ね）」","「（其实没关系的啦。[l]\n事到如今装乖孩子，\n从帮忙带进仓库那刻起就…对吧）」"],["そうか、冬夏、表立ってかどうかはともかく、\n家と反目してるんだよな。","这样啊冬夏，不论表面如何，\n确实是在和家族对立着呢。"],["「（とにかくありがとう、助かるよ。[l]\n取り敢えずじゃあ…出ようか、長居も何だし……）」","「（总之谢谢啦帮大忙了。[l]\n那先…出去吧，久留也不太合适……）」"],["そう、後は極力何事も無く帰還したい。[l]\n紙を筒状に丸め、文字通り懐にしまう。","没错，之后要尽可能无事发生地回去。[l]\n将纸张卷成筒状，名副其实地揣进怀里。"],["「（………そうだね、あの","「（………是啊，那些"],["娘達、やっぱり動き出したみたいだし）」","姑娘们，好像果然开始行动了）」"],["え？[l]\n綾目と狩屋――の事か？","诶？[l]\n是说绫目和狩屋――吗？"],["「（なななんでそんな事が？）」","「（为为为什么你会知道？）」"],["「（ふふ、\n……まあ女の勘って奴かな。[l]\n当たるよ私の）」","「（呵呵，\n……大概就是女人的直觉吧。[l]\n我的直觉很准哦）」"],["「（また誰かさんが云いそうな事を…[l]\nや、どっちにしろさっさと動くに越したことはないな。[l]\n…て、おい、きぃ）」","「（又来了个爱说这种话的家伙…[l]\n嘛，总之赶紧行动总没错。[l]\n…喂，小贵）」"],["さっきから何黙ってるんだ。[l]\nほんとに腹減りすぎたか？","从刚才起怎么不说话。[l]\n真饿过头了？"],["「（ふえ。[l]\nおー、聞いてるさ。[l]\n動くのがいいのだわ）」","「（呼诶。[l]\n噢，在听呢。[l]\n还是行动比较好哦）」"],["ぉぉぉぉぉぉぉん。[l]\nぉぁぁぁぁぁぁぁぁぁぁぁぁん。[l]\nおわああああああああ。","噢噢噢噢噢噢噢。[l]\n噢啊啊啊啊啊啊啊啊啊。[l]\n呜哇啊啊啊啊啊。"],["何。[l]\n今のは。","什么。[l]\n刚才的。"],["音か、声か、判然としないが、\nこの場の３人全員が、\n黙り、動きを止めた。","是声音还是叫声难以分辨，\n但在场三人全都\n沉默并停止了动作。"],["再び聞こえないかどうか耳を澄ます。","再次竖起耳朵确认是否还有声响。"],["──何も聞こえてこない。[l]\nただ、緊張の所為かチョーカーを巻いた首が苦しい。","──什么也没听见。[l]\n只是因紧张感，戴着项圈的脖子发疼。"],["先刻紙を発見した時の悪寒は無いが、\n変な汗が噴出してくるのが判る。","虽没有早前发现纸张时那股恶寒，\n但能感觉到诡异的汗正往外冒。"],["三人で数秒待ったが、\nそれから音が聞こえてくることは無かった。","三人静候数秒，\n之后便再未听见任何声响。"],["「（ふ？ええ？[l]\n何今の？[l]\n声？）」","「（诶？啥？[l]\n刚才啥动静？[l]\n叫声？）」"],["「（な、なんだったんだ？[l]\n声だとしてもヒトの声か？","「（那、那是什么鬼？[l]\n就算是叫声也不像人声吧？"],["き、きぃの腹の虫じゃ…ないよな……[l]\n冬夏、家の人かな？）」","该、该不会是小贵的肚子在叫…不对吧……[l]\n冬夏，是你家的人吗？）」"],["「（………ちょっと静かに）」","「（………先安静）」"],["「（発情期の猫かも知れないさ、\nあんな鳴き声よく聞いたことあるのだわ。[l]\n…今の時期がそうかどうかわかんないけど）」","「（可能是发情期的猫，\n那种叫声经常能听到呢。[l]\n…虽然不确定现在是不是发情期）」"],["「（猫ぅ？[l]\n確か発情期はもっと前じゃなかったか？[l]\nこっち北だから遅い可能性もあるのかな…）」","「（猫叫？[l]\n记得发情期应该更早前吧？[l]\n难道因为北方所以比较迟…）」"],["確かに、発情期の猫の声は人間の子供みたいな声で、\n知らずに聞くと気持ち悪いけど、\nそれにしてもまた秘密蔵の中で猫か？","确实，发情期猫叫像人类小孩哭声，\n初次听见会毛骨悚然，\n但秘密仓库里又有猫？"],["本当にどっちの時のも猫ならばだけど。","前提是两次真的都是猫叫的话。"],["「（しっ……[l]\n君等は全くホントにどんな時でもお気楽だね……）」","「（嘘……[l]\n你们真是无论何时都这么心大啊……）」"],["呆れられちゃった。[l]\n脳空転してると思考がすぐシフトしちゃうんだよ。","被嫌弃了。[l]\n脑子放空时思考就会立刻切换掉呢。"],["で、冬夏は、また顔を顰めるように目を閉じて、\n物音がしないか集中したようだった。","接着，冬夏又像皱起脸似地闭上眼睛，\n似乎集中精神在听有没有声响。"],["――また視界が揺れた。","――视野再次摇晃。"],["暗いので先刻程そう感じないが、\nどうも調子がおかしいな。[l]\nやっぱ診て貰った方が良いかなあ…","因为太暗所以不像刚才那样明显，\n但总觉得状态不太对劲。[l]\n果然还是该去看看医生吧…"],["「（…よく、わかんないな……[l]\nまあ、もう聞こえないみたいだし、\n取り敢えず無視して出ても問題無いと思う）」","「（…搞不太懂呢……[l]\n嘛，反正好像已经听不到了，\n暂时无视掉直接出去应该也没问题）」"],["「（猫だよ猫。[l]\n玄ノ森は猫だらけだもんさ。[l]\nどっかから迷い込んだのだわ）」","「（是猫啦猫。[l]\n玄之森到处都是猫。[l]\n大概是从哪里迷路进来的吧）」"],["「（うちじゃ飼ってないよ…[l]\n鼠狩り用に蔵の中に飼ってたのかな？","「（我家没养哦…[l]\n难道是为了抓老鼠在仓库里养的？"],["そんな話聞いてない…[l]\n何だろう…","没听说过这种事…[l]\n到底是什么…"],["更に…更に別の空間があるのかな……[l]\nそんな話も知らない…けど……まさか……）」","该不会…还有别的空间存在吧……[l]\n这种事也没听说过…但是……不会吧……）」"],["「（まじ？[l]\nそれは…気になるさ…[l]\nでも、ううん……[l]\n迷うのだわ）」","「（真的？[l]\n那个…确实会在意啦…[l]\n不过，唔……[l]\n好纠结）」"],["…しかしもう今は危険だろう。","…但现在继续待着恐怕很危险。"],["時間もそろそろ昼飯時になるし、\n取り敢えず、このサンプルを入手しただけでも\n当初の予定からすれば収穫だ。","时间也快到午饭点了，\n总之光是能拿到这个样本，\n比起原计划已经算有收获了。"],["ここで事を急いで、下手を打つことはない。","没必要在这里贸然行动导致失手。"],["「（いい、いい。[l]\nもう戻ろう。[l]\n冬夏に迷惑掛けても拙いし）」","「（好了好了。[l]\n该回去了。[l]\n给冬夏添麻烦也不合适）」"],["「（……私も気になるけど、[l]\nそうだね、もう色々限界かも…）」","「（……虽然我也很在意，[l]\n不过确实，差不多到极限了…）」"],["「（ふええ、\n…うう、分ったさ。[l]\nお腹も空いたし戻るのだわ）」","「（呜诶诶，\n…唔，知道啦。[l]\n肚子也饿了这就回去）」"],["来る時以上の緊張の中、\n僕等は例の紙の持ち出しそのものは仕方ないとしても、\n極力痕跡を残さないようにしつつ、途を戻る。","在比来时更紧张的氛围中，\n我们虽然不得已带走了那些纸张，\n但仍尽量不留下痕迹地原路返回。"],["暗さに慣れていた御陰で、手を繋いでいても往路よりは楽だった。","多亏已经适应了黑暗，牵着手走比来时轻松不少。"],["とはいえ皆不安で誰とも無く足早だったが、\n幸い、途中であの声が聞こえてくる事は無かった。","不过大家都因不安而不知不觉加快了脚步，\n幸运的是中途再没听到那个声音。"],["「じゃ、私も散歩から帰るっていう『てい』で行くから、\n自販機のとこまでは行くよ」","「那我也假装散步回来，\n陪你们走到自动贩卖机那儿吧」"],["何とか問題無く脱出（？）には成功し、[l]\n地下や閉塞空間からの開放で、\n僕等も心地よい疲労感に包まれていた。","总算有惊无险地成功脱出（？），[l]\n从地下和密闭空间获得解放后，\n我们都沉浸在舒适的疲惫感中。"],["……そうかなあ。[l]\n複数人でいけない事をした後の奇妙な連帯感とでも\n言った方が合ってるかな。","……真是这样吗。[l]\n或许说成是多人共犯后产生的奇妙连带感\n更贴切些吧。"],["先刻の謎の声に関しては、本気で怖かったのか、\n誰も話題にしなかった。","关于刚才的神秘声音，不知是否因为真的害怕，\n谁都没有提起。"],["マジに恐怖体験した時は必死でそれを否定しようとする心理。[l]\n逆現実逃避とでも言おうか。[l]\n実際の処、多分猫か何かなんだと思う…けど……","真正经历恐怖时人会拼命想要否认它的心理。[l]\n或许该称之为逆向现实逃避。[l]\n实际上，大概只是猫之类的吧…不过……"],["いずれにしろそういった状況だったので、\n反動でそれぞれの声が妙に明るい。","总之当时就是那样的状况，\n导致反作用下每个人的声音都异常开朗。"],["そして、努めて無関係な話題に耽るぼくら。[l]\nだって今視て来た体験をこんなとこで熱く語るわけにもいかないし。[l]\n多分三人とも、不安なのだろう。","于是我们刻意沉溺于无关的话题。[l]\n毕竟不能在这种地方热烈讨论刚才的见闻。[l]\n恐怕三个人都心怀不安吧。"],["少なくとも、この心臓の動悸が収まるまでは、無駄話に興じたいのは本心だ。","至少在心悸平复之前，想聊些闲话才是真心。"],["「明日から学校なんだよねー。[l]\n春はユウウツだよ。[l]\n特に今年はちょっと色々あって」","「明天开始就要上学了呢—[l]\n春天真是忧郁啊。[l]\n特别是今年还发生了些事情」"],["「へえ、\n五月病…はまだ先だわなあ。[l]\nそか、高三て言えば色々あるよね…」","「诶，\n五月病…还早着呢。[l]\n也是，高三的话确实会有各种事情呢…」"],["「んー…[l]\nまあ多分まことさんが想像してるのとは違うと思う…[l]\n別に相談乗って貰う様な話でも無いけどね」","「嗯—…[l]\n不过大概和真言先生想象的不太一样…[l]\n倒也不是需要找人商量的程度啦」"],["「ま、学生のうちはしっかり悩んどくのが好いよ。[l]\n若いときにしっかり苦悩して、将来他人の痛みが\n分かる人間に成ってくれ給え。","「嘛，学生时代就该好好烦恼。[l]\n年轻时多经历些痛苦，将来才能\n成长为懂得他人伤痛的人。"],["さて、僕も明日はどうしようか…[l]\n眼の調子が何か変だからどっか病院行っとこうかなあ。[l]\n場所調べなきゃ」","话说我明天该怎么办呢…[l]\n眼睛状态有点怪，要不要去医院看看。[l]\n得查查地点」"],["「なにそれは。[l]\nうちのバイト先は厭ってことさ？[l]\nはなから想定外？」","「这算什么。[l]\n意思是嫌弃我打工的地方？[l]\n压根不在考虑范围内？」"],["「いやいや、\nツテとかコネとかモロに当てにするのもどうかと\n思って…","「没有没有，\n全指望熟人关系总觉得不太合适\n所以…"],["あとほら、例の何とかさんが戻ってくるとかで\nごたごたしてそうだしさ…[l]\n冬夏も眼、診て貰う訳だろそこで」","而且你看，听说那个某某要回来了\n那边估计会乱成一团…[l]\n冬夏也要在那里看眼睛吧」"],["実際はあんまりこれ以上三春関係者と逢わない方が\n良い気がしてるからですが…","实际上我是觉得最好别再和\n三春家相关的人有太多接触…"],["「ああ、","「啊，"],["卑","卑"],["尊さんね。[l]\n今日その御蔭で蔵にも入れたし！","尊小姐啊。[l]\n今天多亏她才能进仓库呢！"],["まあ、多分だけどさ、\n診療所はじいちゃんばあちゃん達の需要あるし、\n明日には稼働せざるを得ない気がするのだわ。","不过诊所那边，\n老爷爷老奶奶们的需求摆在那儿，\n明天估计不得不开诊了吧。"],["あーその、色々でしばらく休業だったし。[l]\nただ、やっぱり冬夏の眼は最優先で診察になるよね\nこの場合」","之前因为各种原因停业了好久。[l]\n不过，这种情况下，\n果然还是得优先给冬夏检查眼睛吧」"],["「私はあの人あまり…苦手だから……[l]\n積極的には勧められないな…」","「我有点…不太擅长应付那个人……[l]\n实在没法主动推荐呢…」"],["ふーん。","哼—嗯。"],["三春家のお抱えという事は、\nまあ母殿の息も多分に掛かってるんだろうし、\n家との確執のある冬夏にはあまり良い印象じゃないのか。","既然是三春家的专属医生，\n想必也深受主母大人影响吧，\n对和本家有矛盾的冬夏自然印象不佳。"],["でもきぃの言う通り、冬夏の母上殿はお抱えに診させる事に御執心のようだし。","不过小贵说得对，冬夏的母亲大人似乎执意要让专属医生诊治。"],["「う～ん……[l]\nやっぱちょっと考えてからにするわ。","「唔～嗯……[l]\n还是再考虑考虑吧。"],["聞くだに明日なんかピンポイントで混みそうだし…[l]\nま、もし世話になる時は宜しく、という事で」","光听说明天就可能人满为患…[l]\n嘛，真要麻烦你的时候还请多关照啦」"],["結局当初通り、宮さんに相談してからの方が好かろう、\nと判断しました。","最终决定按原计划先找宫小姐商量，\n这样判断。"],["ああ、どんどん自主性が無くなってく僕…[l]\n最初から無いって話もあるけどな！","啊，我越来越没主见了…[l]\n虽然本来就没有就是了！"],["まあいいんだそんなことは。","不过这种事怎样都好啦。"],["さて、帰ったらその宮さんに早速これ、視て貰おう。[l]\nバッグでも持って来れば良かったなあ。","等回去就立刻让宫小姐看看这个。[l]\n该带个包来的。"],["これではまさに肌身離さず状態だ。[l]\n極力傷まないように持ってかねば…","现在简直是寸步不离的状态。[l]\n必须小心拿着不能弄坏…"],["「じゃあ解散か。[l]\n冬夏、色々ありがとう。[l]\n何か問題発生したら…ごめん」","「那就解散吧。[l]\n冬夏，多谢你帮忙。[l]\n要是再出什么问题…抱歉」"],["「良いって気にしないで。[l]\nまだ長いこといるようだったら、\n母様の眼を盗んでまた何か奢って貰うから」","「没事别在意。[l]\n要是还要待很久的话，\n我会瞒着母亲大人再让你请客的」"],["「ふえ、\n食べ物の話聞いたらもうだめだぁ。","「呜诶、\n听到食物的话题就完蛋啦～"],["今日はさっさと戻る私。[l]\n用事が立て込んでてぇ…」","今天我要赶紧回去。[l]\n事情堆成山了…」"],["まあ、卑尊さんとやらが冬夏の母殿と帰って来るまで、\n色々する事もあるだろうな。","嘛，在卑尊和冬夏的母亲大人回来之前，\n应该还有不少事要处理吧。"],["「そうなんだ。[l]\nこれ以上一緒にいるのもなんだし、\nじゃ、ほんとにこれで」","「这样啊。[l]\n再继续待在一起也挺尴尬的，\n那，真的就此别过啦」"],["「うん。[l]\nまた何かあったら声掛けて。[l]\n都合あえば遊んであげるよ」","「嗯。[l]\n有事随时叫我。[l]\n有空的话陪你玩哦」"],["じゃ、ごきげんよう、\nとお嬢様会釈をし、日曜の昼下がり…にはまだ早いが、[l]\nその陽光の中を優雅に立ち去る冬夏。","那么祝您愉快，\n大小姐优雅地欠身行礼，虽然离周日下午还早，[l]\n冬夏就这样沐浴着阳光款款离去。"],["遊んであげる、ってのはさあ…","说什么陪我玩啊…"],["「もう限界だから、\n行くさ。","「已经到极限了，\n走啦。"],["それ、なにか面白い事判ったら教えてねっ！[l]\nんでわ、さらばなのだわ」","要是发现什么有趣的事记得告诉我！[l]\n那就再见啦」"],["「お、おう。[l]\n気ぃ付けて帰れ」","「哦、哦。[l]\n路上小心」"],["きぃも去ったが、先刻の話じゃないが、\nなんとなく時間差作ったほうがいい気がして、[l]\n自販機で小さめのお茶を買い、\n半分程飲んで心を鎮める。","小贵也走了，不过就像刚才说的，\n总觉得应该错开时间比较好，[l]\n在自动贩卖机买了小瓶装茶，\n喝了半瓶平复心情。"],["それを手に持ちぶらぶらさせながら歩き出した。[l]\n懐の紙を確認し、不自然にならないように注力しながら、\n自販機小屋から道路に出て左に曲が──","拎着瓶子晃晃悠悠地迈开步子。[l]\n确认怀里的纸张，同时注意不显得刻意，\n从贩卖机亭子拐到马路上往左转──"],["「──っぉあ！[l]\nき、」","「──哇啊！[l]\n姬、」"],["「真言さん」","「真言先生」"],["姫様ちゃんと狩屋が、\nそこに居た。","姫様和狩屋，\n就站在那里。"]],"context":[["SC_M_014.ks/index/1/text"],["SC_M_014.ks/index/3/text"],["SC_M_014.ks/index/5/text"],["SC_M_014.ks/index/7/text"],["SC_M_014.ks/index/9/text"],["SC_M_014.ks/index/11/text"],["SC_M_014.ks/index/13/text"],["SC_M_014.ks/index/15/text"],["SC_M_014.ks/index/17/text"],["SC_M_014.ks/index/19/text"],["SC_M_014.ks/index/21/text"],["SC_M_014.ks/index/23/text"],["SC_M_014.ks/index/25/text"],["SC_M_014.ks/index/27/text"],["SC_M_014.ks/index/29/text"],["SC_M_014.ks/index/31/text","SC_M_014.ks/index/626/text","SC_M_014.ks/index/628/text","SC_M_014.ks/index/630/text","SC_M_014.ks/index/636/text","SC_M_014.ks/index/638/text","SC_M_014.ks/index/640/text","SC_M_014.ks/index/644/text","SC_M_014.ks/index/646/text","SC_M_014.ks/index/648/text"],["SC_M_014.ks/index/33/text"],["SC_M_014.ks/index/35/text"],["SC_M_014.ks/index/37/text"],["SC_M_014.ks/index/39/text"],["SC_M_014.ks/index/41/text"],["SC_M_014.ks/index/43/text"],["SC_M_014.ks/index/45/text"],["SC_M_014.ks/index/47/text"],["SC_M_014.ks/index/49/text","SC_M_014.ks/index/93/text"],["SC_M_014.ks/index/51/text"],["SC_M_014.ks/index/53/text"],["SC_M_014.ks/index/55/text"],["SC_M_014.ks/index/57/text"],["SC_M_014.ks/index/59/text"],["SC_M_014.ks/index/61/text"],["SC_M_014.ks/index/63/text"],["SC_M_014.ks/index/65/text"],["SC_M_014.ks/index/67/text"],["SC_M_014.ks/index/69/text"],["SC_M_014.ks/index/71/text"],["SC_M_014.ks/index/73/text"],["SC_M_014.ks/index/75/text"],["SC_M_014.ks/index/77/text"],["SC_M_014.ks/index/79/text"],["SC_M_014.ks/index/81/text"],["SC_M_014.ks/index/83/text"],["SC_M_014.ks/index/85/text"],["SC_M_014.ks/index/87/text"],["SC_M_014.ks/index/89/text"],["SC_M_014.ks/index/91/text"],["SC_M_014.ks/index/95/text"],["SC_M_014.ks/index/97/text"],["SC_M_014.ks/index/99/text"],["SC_M_014.ks/index/101/text"],["SC_M_014.ks/index/103/text"],["SC_M_014.ks/index/105/text"],["SC_M_014.ks/index/107/text"],["SC_M_014.ks/index/109/text"],["SC_M_014.ks/index/111/text"],["SC_M_014.ks/index/113/text"],["SC_M_014.ks/index/116/text"],["SC_M_014.ks/index/118/text"],["SC_M_014.ks/index/120/text"],["SC_M_014.ks/index/122/text"],["SC_M_014.ks/index/124/text"],["SC_M_014.ks/index/126/text"],["SC_M_014.ks/index/128/text"],["SC_M_014.ks/index/130/text"],["SC_M_014.ks/index/132/