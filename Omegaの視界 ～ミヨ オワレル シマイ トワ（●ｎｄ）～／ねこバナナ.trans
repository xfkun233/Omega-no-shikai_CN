text"]],"tags":[],"parameters":[[{"start":142,"end":160},{"start":168,"end":186},{"start":194,"end":212}],[{"start":279,"end":444}],[{"start":502,"end":528}],[{"start":558,"end":667}],[{"start":725,"end":748}],[{"start":778,"end":927}],[{"start":957,"end":984}],[{"start":1014,"end":1084}],[{"start":1114,"end":1129}],[{"start":1159,"end":1246}],[{"start":1276,"end":1287}],[{"start":1317,"end":1427}],[{"start":1457,"end":1463}],[{"start":1493,"end":1591}],[{"start":1621,"end":1648}],[{"start":1678,"end":1794}],[{"start":1824,"end":1830}],[{"start":1860,"end":1950}],[{"start":1980,"end":2019}],[{"start":2049,"end":2172}],[{"start":2202,"end":2219}],[{"start":2249,"end":2321}],[{"start":2351,"end":2356},{"start":2511,"end":2516}],[{"start":2386,"end":2454}],[{"start":2569,"end":2639}],[{"start":2750,"end":2810}],[{"start":2844,"end":2848}],[{"start":2893,"end":2897},{"start":2994,"end":2998},{"start":3026,"end":3030},{"start":3061,"end":3065},{"start":3093,"end":3097},{"start":3287,"end":3291}],[{"start":2933,"end":2946},{"start":4259,"end":4272}],[{"start":3131,"end":3136}],[{"start":3208,"end":3259}],[{"start":3350,"end":3374}],[{"start":3402,"end":3408}],[{"start":3468,"end":3473}],[{"start":3546,"end":3575}],[{"start":3637,"end":3648}],[{"start":3680,"end":3692}],[{"start":3763,"end":3809}],[{"start":3863,"end":3870}],[{"start":3929,"end":3977}],[{"start":4040,"end":4043},{"start":4221,"end":4224}],[{"start":4118,"end":4185}],[{"start":4282,"end":4292}],[{"start":4300,"end":4306},{"start":4845,"end":4851}],[{"start":4314,"end":4319}],[{"start":4394,"end":4480}],[{"start":4542,"end":4547}],[{"start":4620,"end":4784}],[{"start":4898,"end":4933}],[{"start":5062,"end":5160}],[{"start":5190,"end":5202}],[{"start":5258,"end":5322}],[{"start":5352,"end":5428}],[{"start":5456,"end":5492}],[{"start":5502,"end":5509}],[{"start":5539,"end":5574}],[{"start":5602,"end":5646}],[{"start":5676,"end":5766}],[{"start":5794,"end":5798}],[{"start":5828,"end":5973}],[{"start":6001,"end":6025}],[{"start":6084,"end":6131}],[{"start":6214,"end":6217}],[{"start":6369,"end":6416}],[{"start":6447,"end":6456}],[{"start":6538,"end":6606}],[{"start":6666,"end":6704}],[{"start":6735,"end":6744}],[{"start":6775,"end":6846}],[{"start":6877,"end":6924}],[{"start":6955,"end":7004}],[{"start":7035,"end":7054}],[{"start":7085,"end":7147}],[{"start":7178,"end":7231}],[{"start":7288,"end":7401}],[{"start":7432,"end":7477}],[{"start":7508,"end":7573}],[{"start":7587,"end":7588}],[{"start":7598,"end":7601}],[{"start":7632,"end":7687}],[{"start":7718,"end":7803}],[{"start":7834,"end":7878}],[{"start":7909,"end":7962}],[{"start":8021,"end":8087}],[{"start":8144,"end":8148}],[{"start":8207,"end":8283}],[{"start":8349,"end":8355}],[{"start":8427,"end":8435}],[{"start":8494,"end":8511}],[{"start":8574,"end":8579}],[{"start":8706,"end":8826}],[{"start":8967,"end":9109}],[{"start":9141,"end":9168}],[{"start":9177,"end":9202}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_073.ks","basename":"SC_M_073.ks","indexIds":{"どくん、[l]どくん、[l]どくん、":0,"「……これぁまた……えらい有様だな……[l]\n血の臭いがすげぇったらねーやな、\n修羅場った直後か、\nかれおん置いてきて正解だな、\nもう少し早かったら巻き込ま──[l]あっ。[l]\nおい、[l]\nお嬢さん、[l]\n生きてるな？[l]\n大丈夫か？[l]\nおいっ」":1,"「……あ……[l]れ？……まこ…[l]…さん……？」":2,"「ああ、生きてはいる……が、[l]\nこれぁ酷いな、[l]\n取り敢えずは、[l]\n止血、それから、[l]\nおいっ、お嬢さん、[l]腕ぁ何処いった？[l]\nそれとも消失しちったか？」":3,"「……だ……れ？[l]……ま……じゃない……」":4,"「しっかりしろ。[l]\n──しょうがねー、まず応急処置、\nそれから探すか、\n最悪、PHASE:3ばりばりで……おい、[l]\n死ぬなよ、今、助けたる。[l]\nああもう、いーくんってば相変わらず、\nすげぇタイミングで俺んとこにまでイベント起こしやがって」":5,"「……だ……れ……[l]がはっ、[l]ごぼっ、ごふぅ」":6,"「俺はいー……飯窪真言のダチの大神雪鳴っていう、[l]\nいい人ね。[l]\n味方です。[l]\n奴の事は知ってますな？」":7,"「……まこ……とさん……の？」":8,"「いーくんにあんたらの事は頼まれてっから、\n安心してくれていい──って、\n……お前さん、アヤメんちのだろ？[l]\n念のため訊くが、\n綾目……」":9,"「……き……さま……」":10,"「貴様？[l]\nあー、姫様ちゃん。[l]\n知ってる装束じゃなかったから一瞬焦ったが、\nまあ、\n此処にいるって事は少なくとも関係者ではあるわな。[l]\nほれ、取り敢えず傷口は塞いだ」":11,"「……ぅあ」":12,"「もし腕がその辺転がってるんなら、\nうまいこと治しようもあるんでね。[l]\nまだ仮留めだ。[l]\n無茶は……まあ出来ねーと思うけど、[l]\n何しろ血が流れすぎてる」":13,"「ぜは、……っ、[l]ぜぇ、ぜぇ、[l]……ぜぇ……」":14,"「無かった場合でもまあ……ちっとこちらに負担が、[l]\nあるけどなんとかしまさあ。[l]\nただ、いーくんへの手助け介入は、\n本気でしづらくなるかな……[l]\n余力残しとかねーとイザって時が怖いが……」":15,"「………？」":16,"「ま、でも、\nあんた等を助けられなかった方が、\nいーくんにとってはダメージでかかろうさ。[l]\nまずは現状でベストを尽くすのみってね、\nで、腕は？」":17,"「……わから[l]……ない……[l]\n遠くに……[l]放ったから……」":18,"「放った？[l]\nどんな状況だよ……[l]\nまあ、でも探しゃみつかるかもか、\n時間無いからちっと急ぐぜ、\nじゃあ……お嬢さんは此処で、[l]\n何かあったら──難しいかも知れんが、\n大声で呼んでくれ」":19,"「……ぜっ、[l]……ぜっ、……」":20,"「無かったらすぐ戻るからな。[l]\n気を確り持てよ。[l]\n──さーて、\nいーくん、こういう時こそイベント起こし頼むぜ」":21,"「……？」":22,"「こうなりゃ今更出し惜しみもナシかな……[l]\n……ん？[l]\n………すまん、[l]\n少しだけ、待ってくれるか」":23,"「多分、腕は大丈夫なんだが、\n厄介そうなのがちーっと、\n集まってるくさいんでさ。[l]\nすぐばらけるとは思うが──」":24,"「ぜっ、はっ、\nこっちから……っ、[l]\n気配がっ、\nそれにっ、この臭い、\n血……っ？」":25,"がさっ。":26,"「……」":27,"しーーーーーーーーーん……":28,"ざわっ……":29,"「……狐か？狸か？[l]\nなンかケモノが居ンな。[l]\n血の臭いにでも惹かれて来たか」":30,"「喰われちまわねェ内に、\nとっとと──」":31,"「──っ、」":32,"ざざざっ！":33,"「っ？！[l]\nび、びびらすんじゃね──あァっ？」":34,"がし、べりっ、[l]\n":35,"ずるずるずるずるずる……":36,"「んだこいつッ？！[l]\nってくんじゃねェよ！！[l]\nくっそ、暗ェのに、」":37,"「……ニぃッ」":38,"「黒くて小っせェ、ケダモンがっ、\nみえ辛ぇんだよったく、\n待てこら！！！！！！」":39,"ざっ！":40,"「腕なら呉れてやっても構わねェが、\nそっちは俺んだ！！！[l]\nなんだってケダモノがアレをっ──\n……ちッ、」":41,"ざわざわざわざわ……":42,"ざわざわ……":43,"……ざっ。":44,"「……こっちに気回す余裕も無い程に、[l]\nそれぞれが切羽詰まってるみたいだが……[l]\nま、ともあれ助かった。[l]\nこれで再生の手間ぁ省けるわ」":45,"どろり……":46,"「……単に自死（アポトーシス）した割にゃ、[l]\n……ふむ……[l]\nハードウェアにしろソフトウェアにしろ、\n流れは次世代へと移行しつつあるってのか？[l]\n誰が仕組んでるかはともあれ、\n俺も少しは勉強しにゃならんな、\n元より傍流だからといって、\nこのままでは本流が──」":47,"「っと、\n考えてる場合ちゃうな、\nあの少女を救わねば」":48,"「ぜっ、はっ、[l]\nく、あいつもカミを狙ってるのかっ、[l]\nミ、ミルハが近くに居る、[l]\nあまり悠長な事はしてられないのにっ、[l]\nめん、どうな、ことにっ」":49,"「──ロア、ベロアっ！」":50,"「？！[l]\nマ、マスターミリアム！[l]\n何故来たの、\n駄目だよ、いけないよ、ミルハが、奴等が近くに」":51,"「！[l]\n……ならば尚のこと、[l]\n私自身が姿をみせねば。[l]\nあの妹に、知らしめねばなりません、\n我等の復活を」":52,"「無茶だよ、\nベロアもこんな有様で、\n今のままじゃ奴等に":53,"敵う訳が──」":54,"「ナナが居るはず、\nあれがすっかり準備をしていることでしょう」":55,"「それでも、\nそんなのは駄目だよ、\nわざわざ危ない橋を渡る事はない──」":56,"「……一時の感情に身を任すも、[l]\n固き意志、誇りを貫くも、\nいずれ愚かな独り善がり、\n行き着くは同じ場所……[l]\nではどちらが●●なのか──」":57,"「…？」":58,"「それを知る意味でも、\n私はあれの前に姿をみせねばならない、\nしかとこの眼で、\nあれと相対した時に、\n……忘れ得ぬどれだけの想いが、[l]\n燻り続けた炎が消えていないかどうか、\n確かめることが、\n今の私にとってはこよなき糧と、なる筈」":59,"「でも、そうは言っても──\n……はっ、」":60,"「……思い出す、この、[l]\n身の毛立つと同時に湧き上がる、\n腹立つ思い──」":61,"ぞぞ。":62,"「──ッの野郎、\n何処に消えやがった、\nただのケダモノじゃねえのかッ、一体、」":63,"「──っ、音っ！」":64,"「？！[l]\nあぁっ、どうしたのさ。[l]\n今、綾目のカミを咥えたケダモノ追っかけて……ん、[l]\n誰だそれは」":65,"「これは価無君、\n玖威、価無だ。[l]\n君の──妹になるな」":66,"「……あぁーん？」":67,"「君が追ってるのは恐らくベロアだろう。[l]\n魔女ミリアムの猫だ。[l]\n今彼は八相の紙を回収している、\n君と同様に」":68,"「んだと？[l]\nじゃあ……そいつの、[l]\nクイのカミも、もうねェンだな？」":69,"「そういうことだ。[l]\n僕のは無事だが、どうするか、\n君に今渡してしまうべきか」":70,"「……らねぇなぁ、今のタイミングじゃ」":71,"「……まあそうだろうな。[l]\nprot－ein自体は有用だろうが、\n作成に時間が掛かりすぎるだろうし──」":72,"「……あんた、どうしたのさ。[l]\nどうにも精彩を欠いてンな──って、\n言葉合ってるか？」":73,"「ああ、合ってる……よく勉強したな。[l]\nそれに、精彩を欠いてるのも事実……だろうな。[l]\n少々、自信喪失してるのかも知れないね。[l]\n僕としたことが、\n自分でも考えてもみなかった事だが」":74,"「あんたらしくねェなあ。[l]\nそれより、\n何の用だよ、呼び止めてまでよ」":75,"「──近くに、\n強力な存在……敵となり得るモノが来ている。[l]\n八相連中とは別の──先日君を襲った例の連中の、\n":76,"元":77,"締だ」":78,"「ぁあ？[l]\nああ。[l]\nその手の邪魔が入るなァ、\n判ってた事じゃなかったのか？」":79,"「……何とも言えん。[l]\n僕のこの不調と関係あるかも知れないが……[l]\n何か想定以上の『悪い感じ』がするのだよ。[l]\n畏れるべき何かが……」":80,"「……ほんとにらしくねえぞ。[l]\nそンで、俺におうちに帰れとでも言うのかよ？」":81,"「……いや、[l]\n……だが、重々気をつけろ。[l]\nお前まで失うのは、僕の本意じゃない」":82,"「……付き合いも長ェからな、[l]\n今は突っ込まねェよ。[l]\nあんたこそ、帰って寝るなりした方が良いんじゃねェか」":83,"「音、」":84,"「ま、それは冗談としても、\nその、カナか？[l]\nそいつはちゃんと世話っつーか、\n介抱してやってくれよ。[l]\n俺の、」":85,"妹なんだろ。":86,"「……わかった」":87,"「じゃな、また後で、──かあさん」":88,"びょうっ。":89,"「──どうにも、[l]\n調子が狂うな。[l]\n『彼』による何らかの影響かな……[l]\nいずれにしても、\n早い所吹っ切らねばならない。[l]\n僕のヤクは、\n僕の出る幕は、まだまだ先だからな──」":90,"「おいっ、あったぜ、\nこれで万事解決──あ？[l]\n──おい、おいっ！[l]\n………、[l]\n………、[l]\n………。[l]\n……焦った、[l]\n気失ってるだけか。[l]\n……んや？[l]\n違う……のか？[l]\n":91,"やべぇ、はやいとこ治療開始だ、[l]\n頼むぞ、":92,"保ってくれ、[l]\nあんたも、俺もっ──」":93},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_073.ks","relPath":"/data/scenario/SC_M_073.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":90,"length":94,"percent":95.74468085106383},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[68,1]},"/data/scenario/SC_M_074.ks":{"data":[["びょおおう………","呜哇哇………"],["「……」",""],["ぞぞ。","「……啊。」"],["「……まちがいなく、これは──」","「……毫无疑问、这是──」"],["ミ・オロキャラ","米・奥罗卡拉"],["タサナサコネ・ワ。[l]\n　　ミ・ナサコネカヤコノロキ","塔萨纳萨科内・哇。[l]\n　　米・纳萨科内卡亚科诺罗基"],["ャタサツコネキャラタサ・ワ。","亚塔萨茨科内卡拉塔萨・哇。"],["「……っ、……」","「……呜、……」"],["ミ・キャキャラキャ","米・恰恰拉恰"],["タサキャキャラ・ワ？[l]\n　　ミ・カヤツォロコネ","塔萨恰恰拉・哇？[l]\n　　米・卡亚佐罗科内"],["タサナサメカヤ・ワ。","塔萨纳萨梅卡亚・哇。"],["「……この、感じ、忘れるものか、」","「……这种、感觉、怎么可能忘记，」"],["「……あいつの声──」","「……那家伙的声音──」"],["んむ？[l]\n　　おお、[l]すっかりあの頃の様に、[l]\n　　元通り可憐で高貴な風情じゃないか。[l]\n　　戻り","嗯？[l]\n　　哦、[l]完全就像那时候一样，[l]\n　　恢复成原本可爱又高贵的模样了呢。[l]\n　　回来了"],["序でに、[l]\n　　あの時の恥辱もはっきりと甦ったんじゃないか、[l]\n　　私のこの姿を視て──","顺便，[l]\n　　那时的耻辱也清晰地复苏了吧，[l]\n　　看到我的这副模样──"],["「……クララ……、[l]ミルハ……！」","「……克拉拉……、[l]米尔哈……！」"],["「声が出ない訳でも無いだろうに、[l]\n返事してくれてもいいだろ。[l]\nま、[l]そんな怖い顔されれば、[l]\n今の君がどんな心情かは聞くまでもなし、[l]\nあの時のように、[l]\nビビって即逃げする気は無さそうで安心だ──\nんむ？[l]\nケルベ＝ロア、[l]随分やつれたな？[l]\nそんな有様で、[l]\nどうこうできるとでも、」","「又不是说不出话，[l]\n回应我一下也无妨吧。[l]\n嘛、[l]摆出这么可怕的表情，[l]\n现在的你是什么心情不用问也知道，[l]\n看来不会像那时一样，[l]\n吓得立刻逃跑我就放心了──\n嗯？[l]\n凯尔贝＝萝亚、[l]憔悴了不少啊？[l]\n就凭这副德行，[l]\n还想做什么吗，」"],["「……ひっ」","「……噫」"],["「──思ってる？[l]\nＡＡが出来るのならば、\nそこの女より先にお前を修繕すべきだったろうに。[l]\n相変わらず優先順位の付け方がなってないな」","「──这么想的？[l]\n如果AA能做到的话，\n比起那边的女人，应该先修理你才对。[l]\n还是一如既往搞不清优先顺序啊」"],["「よりにもよって、」","「偏偏是，」"],["「っ！」","「呜！」"],["「お前などに優先順位の事を責められたくはないですね、\nミルハ。[l]\n憐れな●●の分際で」","「可不想被你这家伙指责优先顺序的问题，\n米尔哈。[l]\n区区可悲的●●」"],["「随分とこの國の言葉も巧くなったね、\n女王様。[l]\n八相程度の連中に","「这个国家的语言也熟练了不少嘛，\n女王大人。[l]\n依附八相之流"],["縋った甲斐もあったじゃないか。[l]\nいやいや感服の至り、\n感嘆に値するよ。[l]\n拍手を贈らせて貰おう」","也算没白费功夫呢。[l]\n不不实在令人钦佩，\n值得赞叹啊。[l]\n请允许我献上掌声」"],["ぱちぱちぱち。","啪啪啪。"],["「……くだらない挑発、[l]\n有り触れたお定まりの文句ね。[l]\nお前こそ相変わらずの上辺","「……无聊的挑衅，[l]\n老掉牙的套路说辞呢。[l]\n你才是一如既往地粉饰表面"],["繕い、\n真心を語る術持たぬ、[l]\n……本当に憐れな●●」","伪装，\n根本不懂何为真心，[l]\n……真是可悲的●●」"],["「再度お定まりの文句で恐縮だが、\n褒め言葉として受け取らせて貰うよ。[l]\nともあれ、[l]\nその永き過程は、\nさぞや辛かったろうな、[l]だが」","「虽然老套的说辞再次抱歉，\n但请允许我当作赞美收下吧。[l]\n总之，[l]\n那段漫长历程，\n想必很辛苦吧、[l]不过」"],["「ぐっ…………」","「咕…………」"],["ぞぞぞぞ。","瑟瑟瑟瑟。"],["「ここで終わりだ。[l]\nどう強がったところで女王様、[l]\n貴女に抗う術は無いのが現実だ。[l]\nさて、ただの無力な少女は放っておいて──[l]\nケルベ＝ロア、\n","「到此为止了。[l]\n再怎么虚张声势也是徒劳女王大人，[l]\n无力反抗您就是现实。[l]\n好了，把那个无力的少女搁在一边──[l]\n凯尔贝＝萝亚，\n"],["その封紙、返して貰うよ。[l]\n私の大事な、」","那张封纸，该还给我了。[l]\n那可是我重要的，」"],["びょおおおおおおおううううううう………","呜哦哦哦哦哦哦哦哦哦…………"],["「……？！[l]\nんだあれァ」","「……？！[l]\n那啥玩意儿」"],["「──んむ、[l]\nそこにいるのは……[l]\nＧＷかな？」","「──嗯，[l]\n在那里的……[l]\n是GW吗？」"],["「あれが元締とかいう奴か？[l]\n","「那就是所谓的幕后黑手？[l]\n"],["ぼやけて……[l]よくわかンねェけど……」","模糊不清……[l]看不太清啊……」"],["「……？[l]\nあいつ、","「……？[l]\n那家伙，"],["余","余"],["所","的"],["視してるよ、\nマスター、\n今の内にに、[l]逃げ、隠れようっ」","在看着，\n主人，\n趁现在、[l]快逃、躲起来」"],["「やっぱり、[l]あいつには勝てないよっ、\nこ、[l]こわいよ、[l]こわいけど、[l]\nそれは冷静ってことなんだ、[l]\n確かに怒りで恐怖を忘れる事は出来るけど、\nそれは無謀と紙一重なんだ、[l]\n生き残る者は……[l]勝とうが負けようが、[l]\n争いをするよりも、\n争い自体を避けた者の子孫。[l]\n勝てないのなら負けなければ良い、\nつまり──[l]\n怖いと感じた時に逃亡を選択した──[l]生き延びた者の、\n末裔でもあるんだよっ、\nだから、恥じる必要もないし、[l]\nと、[l]とにかく生き残らなければ何の意味もないっ」","「果然、[l]赢不了那家伙的，\n好、[l]好可怕、[l]虽然害怕，[l]\n但这才是冷静的判断，[l]\n确实愤怒能让人忘记恐惧，\n但那与鲁莽只有一线之隔，[l]\n能存活下来的……[l]无论胜负，[l]\n比起参与争斗，\n更多是那些避开争斗本身的人的子嗣。[l]\n赢不了的话不输就好了，\n也就是说──[l]\n感到害怕时选择逃跑的──[l]幸存者们，\n也是他们的后代啊，\n所以不必感到羞耻，[l]\n总、[l]总之不活下去就毫无意义」"],["「生き残る事だけが、ただ在る事だけが、[l]\n全てに優先するか否か、[l]\nそれをこの永い間私はずっと考えてきた、[l]\n今、[l]あの、[l]全ての元凶を眼前にして、[l]\n私はっ──[l]\n","「仅仅活下去这件事，仅仅存在这件事，[l]\n是否优先于一切，[l]\n在这漫长的岁月里我一直在思考，[l]\n现在，[l]那个，[l]面对所有元凶的此刻，[l]\n我──[l]\n"],["……くっ……[l]\nナナめ……何処で何をしてるのっ」","……呜……[l]\n名无……你现在人在哪里做什么啊」"],["「幾らアテがあるって言ったって、\nナナも白の連中の、[l]\n中枢中の中枢に居た人間だよっ？[l]\n本当に信用できるか知れた物じゃない、\nましてやこんな正念場に、\n全てを賭けるだけの価値があるとは思えないっ！[l]\n三十六計逃げるに如かずとも言うでしょう、\n死んだらシマイだっ！」","「就算你说有把握，\n但名无可是白之众的，[l]\n身处核心中的核心人物啊？[l]\n根本没法确定是否值得信任，\n更何况在这种紧要关头，\n我不认为值得押上全部筹码！[l]\n三十六计走为上策不是常说吗，\n死了就全完了！」"],["「……るせないの、[l]赦せないのよ、[l]\nどうしても、[l]\nあの、[l]女っ──！！！！」","「……无法原谅，[l]绝对不能原谅，[l]\n无论如何都，[l]\n那个，[l]女人──！！！！」"],["「大丈夫だよマスター、\nベロア達はただ在るだけじゃない、[l]\n円環ではなく螺旋を描く。[l]\nぐるぐる自分の尻尾を追って回り続ける訳じゃない、\n自分の尻尾を咬んで永遠を表す訳でもない、[l]\n永遠回帰（ewige Wiederkunft）からの脱却それこそが、[l]\nベロア達を喚び降ろした始祖アリスの意思だ！[l]\nヒトにとってよきものとは不自然なものなんだよ、[l]\n努力なしには前に進むも、[l]\n否、[l]その場に留まる事さえ赦されないのがこのセカイ、[l]\nベロア達はその為の、[l]助けであり友だ！[l]\nベロアは、必ず、[l]\n必ず次のステージへと進む、マスターを助ける！！！！[l]\nそしてマスターにも新しき世界を、","「没问题的主人，\n贝萝娅她们并非徒然存在，[l]\n描绘的是螺旋而非圆环。[l]\n并非永远追逐自己的尾巴打转，\n也不是咬住尾巴象征永恒，[l]\n从永恒回归（ewige Wiederkunft）中挣脱才是，[l]\n召唤贝萝娅她们的始祖爱丽丝的意志！[l]\n对人类而言美好的事物本就不自然，[l]\n在这个世界里若不努力，[l]\n不，[l]就连停留在原地都不被允许，[l]\n贝萝娅她们正是为此存在的，[l]是助力也是伙伴！[l]\n贝萝娅必定，[l]\n必定会帮助主人进入下一阶段！！！！[l]\n也希望主人能迈向，"],["人","人"],["生を、\n歩んで欲しいんだよ、[l]\nそのためにも今はっ」","崭新的世界，\n崭新的人生，[l]\n为此现在必须──」"],["「──おなじ、ことを繰り返さないこと……？[l]\n","「──不再重复相同的事……？[l]\n"],["わたしは、………、[l]\nわたしはただ──」","我，………，[l]\n我只是──」"],["「……なンかこっちの方視てねェかあいつ、[l]\nん、向こうに居ンのは先刻の──」","「……那家伙是不是在往这边看啊，[l]\n嗯，对面那个是刚才的──」"],["「……んむー、[l]\n何の抵抗も出来そうにない彼奴等より、\nＧＷと遊んだ方が愉しそうかな……[l]\nあっちはチノ達に任せるか。[l]\nあの女達もまだ姿を現さないし、\n少し派手に暴れた方が、」","「……嗯唔─，[l]\n比起那些毫无反抗之力的家伙们，\n和GW玩耍好像更有趣呢……[l]\n那边就交给千乃她们吧。[l]\n那些女人也还没现身，\n不如闹得再热闹些──」"],["びゅっ、","咻，"],["「あれ？[l]\nげっ、眼が合──」","「咦？[l]\n糟、眼神对──」"],["ぴたり。","啪嗒。"],["「ぶっわ、がっ！！」","「砰哗，嘎！！」"],["「いいかも。[l]\n","「好像不错。[l]\n"],["やあ、[l]\nご一緒しても宜しいですか？[l]\n──あれ、[l]\n……名前、何て言うのかな？」","呀，[l]\n可以加入你们吗？[l]\n──啊咧，[l]\n……你的名字是？」"],["「おっ、おまえ、\nだっ、」","「喂、喂你，\n别──」"],["「まあいいか名前は。[l]\nオンゲじゃあるまいし、\nこの場合名乗り合うのもヘンだよね。[l]\nマナーは大事だけど、\n","「名字无所谓啦。[l]\n又不是在演歌剧，\n这种场合互报姓名也太奇怪了。[l]\n礼仪确实重要，\n"],["礼","但"],["儀","形式"],["作","作"],["法は場を弁えないと、\nただ滑稽で意味不明な愚挙だもんねえ。[l]\nシキタリやマツリとは往々にして、[l]\n","法律若是不分场合、\n就只是滑稽又莫名其妙的蠢行罢了。[l]\n规矩和仪式往往、[l]\n"],["お馬鹿映像として扱われるきらいがあるでしょぉ？[l]\n取り扱う側の意図次第でさ？」","经常会被当成愚蠢影像对待对吧？[l]\n全看操作者的意图如何啦？"],["「──っ？[l]\n～～っ？？！」","「──咦？[l]\n～～咦？？！」"],["「げに恐ろしきは他人の視線、第三者の眼。[l]\n当事者以外の冷静な視界、\n主観に逃げ込む事を赦さぬ客観視点が、\n固き意思を","「真正可怕的是他人的视线、第三者的眼睛。[l]\n当事人之外的冷静视野，\n不容许躲进主观里的客观视角，\n会将坚定的意志"],["挫き","挫败"],["穿つ","洞穿"],["鏨となる。[l]\n鏡を視詰めよ、おきよゲシュ","化作凿痕。[l]\n凝视镜子吧 奥义·解"],["タルト崩壊──[l]\nそれが魔眼の刺し手の原理の一部……[l]\nそういえば、[l]\n","塔尔特崩坏──[l]\n这就是魔眼杀手原理的一部分……[l]\n话说回来，[l]\n"],["……もうっ、まだ来ないのかなっ？」","……真是的，还没来吗？」"],["「な、何言ってんだこいつあ……？」","「这、这家伙在胡说什么啊……？」"],["「早くしないとこのコが無駄に甚振られるのにっ。[l]\n……んむー、[l]\nミリアムベロアのセットよりはいいけど……[l]\nそれでも大したレベルじゃないなあ。[l]\n限解もされてない様だし……[l]\nこないだ喰った、\nフロシルクの縛鎖を使える程度ってとこか。[l]\nあ、[l]あーあー、[l]ごめごめ、[l]\n心配要らないよ？[l]\nこっちも攻撃方面の出力下げるし、[l]\n","「再不快点这孩子就要白白挨揍了。[l]\n……嗯唔ー，[l]\n虽然比米莉安姆和贝萝娅的组合好些……[l]\n但也就这种程度啦。[l]\n看起来连限解都没完成……[l]\n上次吃掉的那个，\n大概也就弗洛希尔克锁链的使用水平吧。[l]\n啊，[l]啊ー啊ー，[l]抱歉抱歉，[l]\n不用担心哦？[l]\n我这边也会降低攻击输出，[l]\n"],["愉しく遊ぼうじゃないの。[l]\n","愉快地玩耍吧。[l]\n"],["本命が来るまでウォームアップ、\nあっとその前に」","在正主到来前热身，\n啊不过在之前」"],["しゅうううううう………","咻呜呜呜呜呜………"],["「…っ、やばいっ！！！」","「…糟、糟了！！！」"],["「っ？！」","「？！〉"],["びゅ、","咻、"],["どす。","咚。"],["「ぎぁ！！！」","「呀！！！」"],["「アンカーだけ打たして貰ったよ。[l]\n視失った挙げ句エリア移動されると、\n再発見が超面倒だからね。[l]\n逆に言えば、もう逃げても構わないんだけど。[l]\nまあ……節度を守ってくれさえすればだけど」","「只是给你打个锚点而已。[l]\n要是跟丢后又移动区域的话，\n重新定位会超级麻烦的。[l]\n反过来说，现在逃跑也没关系啦。[l]\n不过……前提是你要遵守节制哦」"],["「ぎっ、ぎぎぎぎぎ……」","「呜、呜呜呜呜……」"],["「わ、私のっ、[l]\n私の所為で、[l]\nご、[l]ごめんなさい、[l]\n","「我、我的错、[l]\n都是我的错，[l]\n对、[l]对不起，[l]\n"],["あ、あの女……っ！！！！」","那、那个女人……呜！！！！」"],["「い、いいから、\nとにかくここからにげようっ、\nナナと合流すれば何とか抜く手立てもある筈、\nそうでしょ？」","「别、别说了，\n总之先从这里逃出去，\n和名无汇合的话总会有办法脱身，\n对吧？」"],["「ああ……ベロア……[l]\nごめんなさいごめんなさいごめんなさいごめんなさい……」","「啊啊……贝萝娅……[l]\n对不起对不起对不起对不起……」"],["「……マスターがちゃんとした判断が出来る人なら、[l]\nあのときだって──そして今のこの状況もなかったよね。[l]\nいひひ……[l]\nだから、いいんだ、\nでも、これからは、\n失敗をも糧に、前へ、上へ、進んで欲しい、\nお願い、マスター」","「……如果御主是能做出正确判断的人，[l]\n那时候也好──现在这种状况都不会发生吧。[l]\n嘻嘻……[l]\n所以没关系，\n但是今后，\n希望你能以失败为食粮继续向前向上迈进，\n拜托了御主」"],["「……わかったわ──[l]枷になる過去は……[l]\nどんなに暖かくても、[l]懐かしくても、[l]\n捨てがたくても、大切でも、[l]\n何よりも大事な筈の今を護れないのなら、──」","「……我明白了──[l]成为枷锁的过去……[l]\n无论多么温暖[l]多么令人怀念，[l]\n多么难以割舍多么重要，[l]\n如果无法守护比什么都重要的当下的话──」"],["「んむ、やっぱアンカー外しも出来ない有様か。[l]\n取り敢えずはおｋだな。[l]\nどっちにしてもフハイ全動してるからには、\nどうなったって、\n面倒なだけで逃げ場自体は無いに等しいし？[l]\n──あ、[l]ごめ、[l]\n","「嗯唔、果然连锚链都解不开吗。[l]\n暂时这样就行了吧。[l]\n反正既然全帆都张开了、\n无论变成怎样、\n顶多就是麻烦点 根本无处可逃对吧？[l]\n──啊、[l]抱歉、[l]\n"],["お待たせ」","久等了」"],["ごっ。","咕。"],["「うが──」","「呜啊──」"],["ばきばきばきばきっ！！！！！！","噼里啪啦噼里啪啦！！！！！！"],["「あーうー、[l]\nまだ強いか。[l]\nでもガードはきちんとされたから……[l]\nこっちが不意さえ打たなきゃあ、\n少しは遣り合えるかな？かな？」","「啊呜、[l]\n还这么猛啊。[l]\n不过既然完美防住了……[l]\n只要这边不被偷袭的话，\n应该能稍微过两招吧？对吧？」"],["「い、いっでぇえあっッ、\nぎ、ぐ、ぐっ、げほっ、が、はッ」","「啊、啊啊啊呃呃呃呃呃、\n噫、咕、咕呃、咳嗬、嘎、哈——」"],["「回復手段が無さそうだからその辺りは手心加えなきゃか、\nんむ？」","「看来没有恢复手段所以得手下留情才行，\n嗯唔？」"],["ざわ……","沙沙……"],["さぁあぁぁぁぁぁぁ………","撒啊啊啊啊啊啊啊………"],["「──ミリアム達は逃げたと。[l]\nんじゃ後は、チノにアンカー情報あげてぇ、\nこいついびりながらまこくんを……[l]\nんむ？[l]\nチノが連れてくるのかな？[l]\nまあ順番はどうでもいいや、[l]\n","「──米莉安姆她们逃掉了呢。[l]\n那接下来就把锚点情报传给千乃、\n一边调教这家伙一边等小真……[l]\n嗯唔？[l]\n会是千乃带他过来吗？[l]\n哎呀顺序无所谓啦，[l]\n"],["だんだん愉しくなって」","越来越有意思了」"],["ぴぃーーーーん、","咿咿咿咿咿──"],["「？！！？、[l]\nちっ、」","「？！！？、[l]\n啧、」"],["ぶぅん！","嗡！"],["ごづっ、ぐしゃ！！","咚嚓、嘎吱！！"],["「きたしっ。[l]\nおー、そうそう。[l]\nｇｊｇｊ＞＜ｂ、\nガードってのはそうやってするのさ」","「来啦。[l]\n哦对对。[l]\ngjgj＞＜b、\n所谓防御就该那么做嘛」"],["「いっ、[l]ぎ、[l]て、[l]めっぇえ[l]え[l]え[l]え[l]え[l]え[l]え[l]え、」","「呜、[l]噫、[l]眼、[l]要瞎了[l]啊[l]啊[l]啊[l]啊[l]啊[l]啊[l]啊、」"],["ごん！！","哐！！"],["「まあガードに対しては、\n削りも無効技も、[l]\nガード硬直解けるより速いモーションキャンセルからの追撃も、[l]\nこっちは出来るんだけど、」","「虽说对于防御，\n削韧无效技也好，[l]\n比防御硬直解除更快的动作取消追击也好，[l]\n这边都能做到啦，」"],["「でぁやっ！！！」","「看招！！！」"],["すかっ！","唰！"],["「ちっ、[l]……ぐっ」","「啧、[l]……呃」"],["「ヒトが戯れで行う狩りってのはね、\nハンターが絶対的に優位な事が前提でしょ。[l]\nタマの取り合いをするような、\n野生動物が食料を得る為の、\n所謂肉食獣のする狩りじゃなし、[l]\n『自分がやられるかも知れない』状況じゃ、\n普通はしないわさ。[l]\n自身は死のリスクを負わず、[l]\n相手を負かし","「人类嬉戏般的狩猎啊，\n前提是猎人必须占据绝对优势对吧。[l]\n既不是争夺猎物的、\n野生动物获取食物般的、\n所谓肉食动物的狩猎，[l]\n『自己可能会被杀』的状况下、\n通常不会干啦。[l]\n自身无需承担死亡风险、[l]\n将对手打倒"],["仆す事を愉しむ、[l]\n残酷な遊戯、[l]\nま、釣りみたいなもんなのかな？[l]\nちがうかな？[l]\nどっちにしても、\n鬼ごっこにしろかくれんぼにしろ、[l]\n追う者追われる者、[l]\nその２者の関係性のゲームだろ？」","并以此为乐、[l]\n残酷的游戏、[l]\n嘛、大概类似钓鱼的感觉？[l]\n不对吗？[l]\n无论如何、\n不管是捉鬼游戏还是躲猫猫、[l]\n追逐者与被追者、[l]\n都是围绕两者关系的游戏对吧？」"],["ぼご。","啵咕。"],["「げほっ、げほ、\n……がっは、べっ」","「咳哈、咳、\n……咳哈、呸」"],["「相手と合意の上な訳じゃないしね、\n喰う為の行為でも無し、[l]\nアソビにしちゃ相手のリスクが高過ぎて、\n単なる●●●と思われても仕様がない部分があるな」","「毕竟不是和对方达成共识的行为，\n也不是为了进食的举动，[l]\n作为游戏而言对方承担的风险过高，\n被当成单纯的●●●也无可厚非」"],["「て、[l]めェが、いう……[l]ことかッ、[l]\nそんくれェは……[l]ごぼっ、[l]\nわかんぞこら……[l]ッ……[l]！」","「你、[l]你这混账……[l]说的什么鬼话、[l]\n这种歪理……[l]咕呕、[l]\n老子听不懂啊混蛋……[l]……[l]！」"],["「でもま、[l]鬼ごっこ等は、\n鬼を『感染す』事で、つまり、[l]\n立場の入れ替えを行う事で平等性を保ち、\n且つ優位性を保とうとする側とそれを奪う側、[l]\nその攻守の駆け引きを生じさせる事で、\n遊戯として成り立ってるんだろうけどね。[l]\nまあ相手の意思を汲むなんて事は、\nヒトくらいしかしてない事だしね、[l]\n植物から細菌、ウィルスにしたって、\n争いをしない有機存在なぞ無い訳でさ。[l]\n草食動物だって♀を巡って♂同士の戦いも在る事だし、\nニンゲンのイメージなんて得手勝手で、[l]\nその時々で都合の良いモノが選択されているだけ、\nプロパガンダもいいとこだ……[l]が、[l]\nヒト同士に於いて通用してる分には、\n種レベルでの文化の問題もあるし、[l]\nま、[l]何しろヒト以外のモノは、\n真にはどう感じていようとも、[l]\n『文句を言えない』から」","「不过嘛、[l]捉鬼游戏这类玩法，\n通过让鬼『传染』，也就是、[l]\n通过立场互换来维持公平性，\n让试图保持优势的一方与夺取优势的一方、[l]\n在攻防博弈中形成动态平衡、\n这才使得游戏得以成立吧。[l]\n但要说体察对方心意这种事、\n大概只有人类会做呢、[l]\n从植物到细菌病毒、\n根本不存在不争斗的有机生命啊。[l]\n草食动物也会为争夺♀而♂相残、\n人类所谓的形象不过是任性妄为、[l]\n只是在不同场合选择对自己有利的说辞、\n根本就是 propaganda……[l]不过、[l]\n只要在人类内部行得通、\n就涉及物种层面的文化问题了、[l]\n总之、[l]除人类以外的生物、\n无论真实感受如何、[l]\n都『无法提出抗议』罢了」"],["「てめェの……っ、」","「你这混账……呃、」"],["べき。","咔。"],["「ええと、キミは知らないかもだけど、\n今言ったような、[l]\nプレイヤーと","「那个，你可能不知道、\n刚才提到的、[l]\n只有玩家和"],["敵しかいないゲーム、\nそれとは別に、[l]\nプレイヤー同士が対戦するゲーム、[l]\nいずれにしても、[l]\n昔はゲームをしようにも、[l]\nプレイヤーを集めるのが大変でね、[l]\n多人数の時間も場所も確保した上で、\nすべき処理も煩雑なので技量も必要な、[l]\nそう言う有能なＧＭ（ゲームマスター）も居ないと、[l]\n中々愉しい……[l]特に","敌人存在的游戏、\n与之相对的、[l]\n玩家之间对战的游戏、[l]\n无论哪种情况、[l]\n以前就算想玩游戏、[l]\n召集玩家都很困难、[l]\n既要协调多人时间场地、\n复杂流程还需要专业技能、[l]\n没有称职的GM（游戏主持人）的话、[l]\n很难享受……[l]特别是"],["劇は出来なかった訳。[l]\nそこに現れたコンピューターゲームは、[l]\n汎用性は欠くものの、\n今言ってきた負担や、\n多人数のスケジューリングを不要に出来る……[l]\n要するに、\nゲームを","戏剧性场面根本无法实现。[l]\n这时出现的电脑游戏、[l]\n虽然缺乏通用性、\n却能免除前述负担、\n无需协调多人日程……[l]\n简而言之、\n让游戏"],["ス","既"],["タ","朝"],["ン","着"],["ド","单"],["ア","阿"],["ロ","者"],["ー",""],["ンへと、[l]\n進化──[l]そう言って良いのかはアレだけど、\nそういう流れへと動かせた。[l]\n……言っても分かんないだろうから端折ってるし、[l]\n多分に恣意的な話だけどね。[l]\nまあそれはそれとして……[l]うひひ。[l]\nえーとなんだっけ？」","机化、[l]\n进化──[l]这么说可能不太准确、\n但确实推动了这种趋势。[l]\n……说了你也不懂就长话短说吧、[l]\n虽然这说法相当主观呢。[l]\n不过那是另一回事了……[l]嘻嘻。[l]\n呃刚才说到哪来着？」"],["「──っく、[l]\nちっくし」","「──靠、[l]\n该死的」"],["「あー、思い出した。[l]\n","「啊，想起来了。[l]\n"],["──ところが、\n昨今になって、[l]\nまたぞろ積極的に他人と関わり合おうとする、\nそれ前提のコンピュータ制御ゲームの台頭、[l]\n場合によってはソロ不可ＰＴ強制とか、\n愉快な方向に動いてるようだね。[l]\n","──然而，\n最近，[l]\n又开始积极尝试与他人互动、\n基于这种前提的电脑控制游戏兴起，[l]\n有些情况甚至强制要求组队禁止单人，\n似乎正朝着有趣的方向发展呢。[l]\n"],["面白いねぇ」","真有意思啊」"],["「……[l]～～～～～[l]！[l]！[l]！[l]！[l]！[l]！」",""],["「ただ、先刻も言ったけどね、[l]\n多人数と遊ぼうっていうなら、\nどうあっても環境次第、左右されるんだよ、[l]\nヒトが大好きな平等性とはまるで懸け離れてるな。[l]\n例えばネットインフラだって、[l]\n……この辺じゃ全然じゃん？[l]\n携帯電話の電波も入らないしっ。[l]\nま、[l]\n遣り方の一つではあるだろうが、\n私はキライ。[l]\n","「不过，刚才也说过，[l]\n如果要和多人一起游玩，\n无论如何都会受环境制约，[l]\n这和人类最爱的平等性简直背道而驰。[l]\n就说网络基础设施吧，[l]\n……这破地方根本不行吧？[l]\n连手机信号都收不到啊。」[l]\n嘛，[l]\n虽然也算是一种方式，\n但我讨厌这样。[l]\n"],["たかが余暇活動に、他人の力が必須ってどういう事さ。[l]\nソロでも攻略可能、他人の手借りたら楽になる、\n程度が好きだね私は」","区区休闲活动居然必须依赖他人力量算什么。[l]\n单人可通关、借他人之力更轻松，\n这种程度才合我胃口」"],["「ぐっ！[l]……っは、[l]はぁッ、[l]はぁッ、[l]ぎぎ……」","「咕！[l]……哈、[l]哈啊、[l]哈啊、[l]咯吱……」"],["「で、結局の所私の場合、ゲームとは、[l]\n只の暇潰し、憂さ晴らし。[l]\nだから、[l]\n","「所以说到底对我来说，游戏只是[l]\n纯粹的消遣、发泄压力。[l]\n因此，[l]\n"],["強大で理不尽な敵を苦労してやっつける喜びとか、[l]\n面倒な手順を解き明かすとか、[l]\n他者とプレイしないとリストが埋まらないとか、[l]\nそういったね、[l]\n自分だけの力じゃどうしようもないやつとか、[l]\nゴールの喜びを底上げするための、[l]\n前準備としての強制ストレスを与えられるようなのは、[l]\n私にとって、」","辛苦击败强大而不讲理的敌人获得的喜悦也好，[l]\n解开繁琐步骤也罢，[l]\n不与他人游玩就无法填满清单之类的，[l]\n这些啊，[l]\n单凭自己力量无能为力的玩意儿，[l]\n或是为了提升通关快感而[l]\n强行施加的前置压力，[l]\n对我来说，」"],["「ひ、[l]ぐっ……」","「呃、[l]咕……」"],["「",""],["暇","根本"],["活動としては成り立ってない訳。[l]\n勿論、そういうゲームを否定してる訳じゃないよ？[l]\nソロ以外で先刻みたいな事いってたらだめなひとだし、\nプレイしててハマるのは案外、\nそういうのだったりするしね……[l]\nま、[l]\n結局は好みの問題、\nそれこそゲームなんてスキかキライで選ぶものだろ？[l]\nああ、そうだ、[l]\n兄様はどっちかというとそちら側に傾倒してるし、\nだから──[l]\nごめんごめん、本気に受け取んないでね？[l]\n","算不上休闲活动。[l]\n当然，我并非否定这类游戏哦？[l]\n要是对非单人玩家说刚才那种话就太差劲了，\n而且实际玩起来沉迷的，\n反而往往是这类呢……[l]\n嘛，[l]\n终究是喜好问题，\n游戏不就是该凭喜欢讨厌来选择吗？[l]\n啊对了，[l]\n兄长大人倒是更倾向那边，\n所以──[l]\n抱歉抱歉，别当真哦？[l]\n"],["……ってほら、[l]こうやってさぁ、[l]\n無意味な内容の長広舌をふるってる間に、\n何とか少しでも回復しなよ、[l]\nっていう情けな訳よね。[l]\n優しいでしょぉ？」","……你看嘛，[l]像这样[l]\n滔滔不绝说着没营养的话的期间，\n好歹能恢复一点是一点，[l]\n多可怜啊。[l]\n很温柔吧？」"],["「勝……[l]手抜かしやがッてッ[l]……！[l]\nこの……[l]カス………[l]め……！！！！！！」","「少……[l]擅自得意忘形[l]……！[l]\n这个……[l]渣滓………[l]混账……！！！！！！」"],["「んむー、だってキミが、[l]\n無理に立ち上がろうとするからさ、[l]\n親切で寝かしてあげてたのに。[l]\nそれに──[l]\n猫は獲物をいたぶっちゃうの、\n視たことない？[l]\nもぐらとか鼠とか、[l]\n生かさず殺さず、[l]\n玩具みたいに、」","「嗯哼~因为你这家伙[l]\n非要勉强站起来嘛，[l]\n人家好心让你躺着休息的。[l]\n况且──[l]\n猫咪会玩弄猎物，\n没见过吗？[l]\n比如鼹鼠啊老鼠啊，[l]\n不让死也不让活，[l]\n就像玩具一样，」"],["ざっ！","唰！"],["「……！！[l]\nぎっぃぃいいいい……[l]\nてめぇはぁッ……！！！！！！」","「……！！[l]\n嘎啊啊啊啊啊……[l]\n你这混账……！！！！！！」"],["「ひゅーぅ、ナイス避け」","「咻——躲得漂亮」"],["「……窮鼠……[l]猫を噛む……[l]って言葉……[l]\n知らねェのか……？[l]\n勉強……[l]足りてねェな……[l]\n俺ァ……[l]逃げる気なんざ……[l]ねぇからな……[l]\n先刻から聞いてりゃ、[l]\n……よくわかんねェが、[l]\nムカつく事いってんだろッ……！[l]\nせいぜい──」","「……困兽犹斗……[l]狗急跳墙……[l]这话……[l]\n没听说过吗……？[l]\n功课……[l]没做足啊……[l]\n老子……[l]压根没想……[l]逃命啊……[l]\n从刚才就听着你[l]\n……虽然听不太懂，[l]\n净说些让人火大的话吧……！[l]\n尽管放马——」"],["ぐずっ。","咕呃。"],["「っぎ、いがあああああ！！！！！！」","「呃啊、去死啊啊啊啊！！！！！！」"],["「ほう、今のも良いな。[l]\nだいぶ良い動きに、限解も無いのに大したモンだ。[l]\nそれとも遅効か劣化prot－einでも使ってたか？[l]\nどっちにしろ、」","「嚯，刚才那下不错。[l]\n动作相当漂亮，明明没开极限解放还挺有两下子。[l]\n还是说用了延迟或劣化prot－ein之类？[l]\n无论如何，」"],["「でらっ！！！」","「看招！！！」"],["ぶん！","砰！"],["「焼け石に水だけどね。[l]\nそれは『お互いにとって』残念だけど。[l]\nんむ、[l]\nキミにとっちゃまさに、[l]\n猫の手も借りたい状況ってとこ、かな？」","「不过是杯水车薪罢了。[l]\n这对『双方来说』都很遗憾呢。[l]\n嗯哼，[l]\n对你来说简直就是，[l]\n病急乱投医的处境吧？」"],["うひひひひ。","嘻嘻嘻嘻。"],["「怒り、而して冷静であること、\nエンジンは暖めないといけないけども、[l]\nオーバーヒートしては本末転倒。[l]\n回路や機構はあくまで冷静に。[l]\nそれでいて、[l]\n燃料自体は熱く、激しく燃えるものが望ましい。[l]\n血は頭に上らすのではなく、\n総身に行き渡らせねばね」","「愤怒，同时保持冷静，\n引擎需要预热，[l]\n但过热可就本末倒置了。[l]\n电路和机构必须绝对冷静。[l]\n与此同时，[l]\n燃料本身要炽热激烈地燃烧才好。[l]\n别让血涌上脑袋，\n要让它在全身循环才行」"],["「だらっ！！！！！！」","「接招！！！！！！」"],["すかっ。","唰。"],["「だから、[l]\nキミのようなのは、」","「所以说，[l]\n像你这样的家伙，」"],["「ぎらあッ！！！！！！」","「嘎啊啊！！！！！！」"],["「こうやって、[l]\n爽快な筈のアクションゲームですら、\n苛苛する羽目になるんだよ。[l]\nアクションてのはボタン連打するもん、[l]\nみたいな認識で、\nガードしないでひたすら飛び込み迎撃される系？[l]\n超反応設定ＮＰＣ相手じゃなくても、\nそんなプレイで勝つのは難しいよ。[l]\n先刻のは戯言だから矛盾した事言うけどね、\nアクションゲームほどに、\n操作には反射神経や精密さ、\n戦術には先読みやら心理作戦、\nそういう繊細さが要求されんの。[l]\n視た眼の印象通りただ乱暴に感情ぶちまけるのとは、\n真反対の嗜み方だわさ。[l]\nシューティングだってそう、[l]\n弾幕避けるも照準合わせも、\n雑なプレイじゃ出来やしない、\n寧ろロープレのがボタン連打ゲーだよ」","「就这样，[l]\n本该爽快的动作游戏，\n也会变得烦躁不堪。[l]\n以为动作游戏就是连按按钮，[l]\n抱着这种认知，\n不防御只顾冲上来对拼的类型？[l]\n就算对手不是超反应设定的NPC，\n这种玩法也很难赢哦。[l]\n刚才说的玩笑话可能自相矛盾，\n越是动作游戏，\n操作越需要反射神经和精准度，\n战术则需要预判和心理博弈，\n要求这种纤细的把控。[l]\n和表面看起来只管粗暴宣泄情绪的做法，\n完全是相反的玩法呢。[l]\n射击游戏也是如此，[l]\n躲弹幕也好瞄准也罢，\n粗糙的玩法根本行不通，\n反而RPG才是连按按钮的游戏」"],["「っっっっせえええええええ！！！！！！」","「去死死死死死死死！！！！！！」"],["……すかっ。","……唰。"],["「ぜは、[l]ぜは、[l]ぜあ、[l]げあ、[l]……っ、[l]がふ、[l]\nげほげほっ」","「呃啊，[l]呃啊，[l]呃啊，[l]嘎啊，[l]……咳，[l]咕噗，[l]\n咳咳咳」"],["「ま、[l]\n今私が、\nとある理由でイラっとキてるのは認めるよ。[l]\nホントはこういうの趣味じゃないんだけど」","「嘛、[l]\n现在我确实、\n因为某些原因火冒三丈这点我承认。[l]\n虽然我本来对这种事没兴趣的」"],["「……はぁ、[l]……はぁ、[l]……は……[l]っ、」","「……哈、[l]……哈、[l]……哈……[l]呃、」"],["「ストレスは発散するに限るからね……[l]\nそうそう、而して、\nこれもまた燃料になり得るモノだ。[l]\n反作用って知ってる？」","「压力就是要发泄出来才好……[l]\n对对，所以说、\n这也能成为燃料呢。[l]\n知道反作用力吗？」"],["「……っかにしてンのかてめェは……っ、[l]\nさっきからべらべらしゃべくって、」","「……你他妈从刚才开始就、[l]\n叽里呱啦说个不停……」"],["「幾ら歩こうとしても、\n地面に跳ね返す力がなきゃ、\n一歩も前に進めないってことさ。[l]\nストレス無く乳母日傘でのんべんだらりと暮らしてる奴に、\n行動力や推進力なんかあると思うかい？[l]\n一部の植物は踏まれ、刺激される事で成長物質が出て、\n強く伸びるっていうしね。[l]\n重力があればこそ骨の強度も筋力もつく……[l]\nキミもどうやらそういった反抗心みたいなモノが、\n何らかの『逆向きの要素』が、\nその行動の源泉にあるようだけど」","「要是没有、\n地面反弹的力道、\n人连一步都迈不出去啊。[l]\n你觉得那些在温室里无忧无虑长大的家伙、\n能有什么行动力和冲劲吗？[l]\n有些植物被踩踏刺激后反而会分泌生长物质、\n长得更加强壮呢。[l]\n正因为有重力骨骼和肌肉才会变强……[l]\n看来你心里也藏着那种反抗意识、\n某种『逆向要素』、\n似乎就是你行动的源泉吧」"],["「………ハッ」","「………哈」"],["「素質はある。[l]\n曲がりなりにも●●くんの身体の一部を","「资质是有的。[l]\n好歹是窃取了●●君部分身体的"],["身","身"],["盗った存在、[l]\n遣り方が拙いだけでフロスの縛鎖も遣えてる、\nだから、」","存在、[l]\n虽然手法拙劣但能使用弗洛斯的锁链、\n所以啊、」"],["「……なに？[l]\nなにくんだと──」","「……什么？[l]\n你他妈说什──」"],["「まあ──\nあとは車や自転車の運転と同じく、\n","「哎呀──\n就像开车骑自行车一样、\n"],["骨を掴めば何てことはない。[l]\nある点を乗り越えさえすれば、\nきっとよきプレイヤーになれるだろう。[l]\nよき師に巡り会って、\n早々にボタン連打プレイから脱却する事だな」","掌握要领就简单了。[l]\n只要突破某个临界点、\n你一定能成为优秀玩家的。[l]\n找个好师傅、\n早点摆脱无脑连按的操作方式吧」"],["「…………んなんだ…………めェは………」","「…………什么啊…………你这家伙………」"],["「んむ、\nそう、その調子。[l]\n負けたくないとか、\nあいつむかつくとか、\n実はそういう燃料は事欠かないのが、\nこの最悪の箱庭たるセカイ。[l]\n例えばスロタラスモルトはまさに先の構造理念、\n対象が●●であればあるほど威力……威力？[l]\nまあいいや、返す力は高まるからね、\n逆に言えば平穏な環境下ではアレの力は無いに等しい、\nでも……[l]\nそんな絶対安定状況は、\nヒトの世で生きてれば有り得ないと分かるだろ？[l]\n兄様もやらしい設計にしたものだよ。[l]\nまあ、私はその点、\n繰り返すようだけど、\n他人が攻略……リスト埋めも含めてだけど、[l]\nそのフラグ担ってるのは耐えられないからさ、\nソロで全てストレス無く遊べるように、\nして貰ってるの」","「嗯哼、\n对，就是这股劲头。[l]\n不想输啦、\n看那家伙不爽啦、\n在这种最糟糕的箱庭世界里、\n最不缺的就是这类燃料。[l]\n比如斯洛塔拉斯莫尔特正是基于这种理念设计、\n对象越是●●威力就……威力？[l]\n算了总之反弹力会更强、\n反过来说在太平环境里那玩意基本没用、\n不过……[l]\n这种绝对安稳的状态、\n活在人类世界就知道不可能存在吧？[l]\n兄长大人设计得可真恶趣味呢。[l]\n不过我嘛、\n虽然反复说过、\n要替别人攻略……包括填满清单这种事、[l]\n实在扛不住这种flag、\n所以让我能独自轻松享受、\n全部内容呢」"],["「……ぅだ………」","「……呜啊………」"],["「んむ？」","「嗯唔？」"],["「……そうだ、[l]\n足りねェもンがあるからこそ、[l]\n人は渇望し、[l]その穴ァ埋めようと、[l]強く、[l]\n強くッ……」","「……没错、[l]\n正因为有缺失、[l]\n人才会渴望、[l]想要填补、[l]变得更强、[l]\n更强……」"],["「んむ」","「嗯唔」"],["「──なるんだッ！！！！！！」","「──给我变成那样啊！！！！！！」"],["「ごっは……」","「呕啊……」"],["「プレイヤーが──」","「玩家可是──」"],["どしゃっ。","哗啦。"],["「腕を上げたり工夫したりすれば、\n何とか勝てるような、\nわざと解法や隙を設けてあるような、[l]\n──今まで説明してあげたような、[l]\n御行儀の良いゲームを私達はしてる訳じゃ、[l]\n残念ながら無いからね。[l]\n範囲攻撃も無茶な当たり判定も自動回復も、\nその気になればこっちはそうカスタム出来るよ。[l]\nまあ、[l]\n","「只要提升实力或者动点脑筋、\n就勉强能打赢的那种、\n故意设置解法或破绽的那种、[l]\n──就像我之前给你解释过的那种、[l]\n我们进行的可不是什么循规蹈矩的游戏、[l]\n很遗憾并不存在呢。」[l]\n范围攻击也好离谱的判定框也好自动回血也好、\n只要我想随时都能这样自定义哦。」[l]\n嘛、[l]\n"],["単に調整不足でマゾくなってる訳じゃな──[l]\n","虽然单纯是因为平衡没做好才变得这么虐——[l]\n"],["てか私は別にラスボスじゃないっつーの！」","话说我根本就不是最终BOSS好不好！」"],["「がはっ、[l]お、[l]げぇぇぇぇ……、[l]\nごぼっ、[l]ごふっ」","「嘎哈、[l]呕、[l]呃呃呃呃呃……、[l]\n咳噗、[l]呕噗」"],["「だからこっち主観で視れば、\n単にレベルが違うだけの話でね。[l]\n普通、[l]\n下位クエの敵が上位装備のプレイヤーに、\nまともに抗しうるバランス調整はないからさ」","「所以从我的主观视角来看，\n单纯只是等级差距的问题罢了。[l]\n一般来说，[l]\n低级任务的敌人不可能设计成\n能正面对抗高级装备玩家的平衡性啊」"],["「あ゛[l]あ゛[l]あああああッ！！！」","「啊゛[l]啊゛[l]啊啊啊啊啊！！！」"],["ばぐん、","咔嚓，"],["がちん、","哐当，"],["「無論こちらの攻撃の出力は下げてあるけど、\n例えば──キミの攻撃が２０として、\n防御１００にはダメージ通らない、\n単純にそれだけの事だね。[l]\n今みたいにPHASE:6、\n咬もうったって、\n歯が通らないんだよこの場合。[l]\n6しかないキミでは丸呑み出来る訳も無し、\n寧ろそんな事したら死活問題の筈だったかな？」","「当然我这边已经调低了攻击输出，\n比如说──假设你的攻击力是20，\n面对防御力100就完全破不了防，\n就是这么简单的道理。[l]\n像现在这样PHASE:6的状态，\n就算你咬上来，\n这种情况下牙齿也根本咬不穿啊。[l]\n只有6级的你连生吞都做不到，\n倒不如说真那么做反而会要命吧？」"],["「あぐぁうあッ、[l]ああがああがあああがが！！！！！！」","「啊呜哇啊、[l]啊啊啊啊啊啊啊啊啊！！！！！！」"],["「……にしてもおっそい！[l]\nチノも手こずってる？[l]\n話すネタもごちゃごちゃになってきて、\nしかもほとんど独り言みたいじゃんっ、\nいい加減早く来てくれないと、\n●●しちゃうよ、\nまこくん」","「……就算这样也太慢了！[l]\n千乃也搞不定吗？[l]\n能聊的话题都乱七八糟堆在一起，\n而且几乎变成自言自语了吧，\n再不快点过来的话，\n●●就要开始了哦，\n小真」"],["「──な……ンだと？[l]\nま、」","「──什……么？[l]\n等、」"],["「宮はもうアキちゃいますよ、\nこんな雑魚じゃやっぱ手応えもないし、[l]\nんむ、[l]\nアキた、[l]もう飽きた。[l]\n","「宫已经玩腻了啦，\n这种杂鱼果然连手感都没有，[l]\n嗯唔，[l]\n腻了，[l]已经腻了。[l]\n"],["あーきたー。[l]\nゲームだったら、[l]\nセーブしないで電源落としたいくらい？[l]的な？[l]\nなんて」","啊——腻了——。[l]\n如果是游戏的话，[l]\n大概想不存档就直接关机？[l]这种感觉？[l]\n呢」"],["「まててめェ、\n今なんて言った、誰のなま──」","「给老子等等，\n刚才说什么，谁的名——」"],["「ま、いいや。[l]\n最後に教えたげようか。[l]\n知ってる？[l]\nゲームにはね、[l]まま、","「嘛，算了。[l]\n最后教你一件事吧。[l]\n知道吗？[l]\n游戏里啊，[l]有那种"],["絶対勝てないイベント戦というのがあるのよぉ」","绝对赢不了的剧情战的哟」"],["ぼぅ……","咚……"],["「えと、\nお相手ありがとうございました、\nじゃあ、おつです（＾ヮ＾）ノシ」","「呃、\n感谢您今天的陪伴、\n那就、到此为止啦（＾ヮ＾）ノシ」"],["「の、のし？」","「开、开心？」"],["「──」",""],["……んだ？","……啥？"],["耳鳴り……？[l]\n　　何にも、[l]\n　　聞こえねぇ……","耳鸣……？[l]\n　　什么都，[l]\n　　听不见……"],["……そんで……[l]\n　　熱い、[l]\n　　眼の前が真っ赤で……","……然后……[l]\n　　好烫，[l]\n　　眼前一片通红……"],["……あ？[l]\n　　飛んでる？[l]\n　　周りがすげぇゆっくりに……","……啊？[l]\n　　在飞？[l]\n　　周围变得超级缓慢……"],["やばい、[l]トびそう……[l]\n　　わんわん頭ん中が……[l]\n　　鳴りまくって……","不妙，[l]要晕了……[l]\n　　脑子里嗡嗡……[l]\n　　响个不停……"],["「……ああーぁあぁあぁ、[l]\nそうか、\n成る程ね、[l]\nキミは──」","「……啊啊——啊啊啊，[l]\n原来如此，\n我懂了，[l]\n你是──」"],["ぱきん、ぐしゃっ。","咔嚓，哗啦。"],["……んて言った？[l]\n　　って、[l]\n　　あれ何かあんまり痛くないな、[l]\n　　まだ何かゆっくりだし、","……刚说了啥？[l]\n　　话说，[l]\n　　奇怪怎么不太疼啊，[l]\n　　周围还是慢动作似的，"],["あれ……勉強した気がする……[l]\n　　痛みは通常、危機的状況回避の為の警告の意味合いで……[l]\n　　回避どころじゃない、[l]\n　　そんなコトをしても遅いような、[l]\n　　致命的なダメージを受けた時は……[l]\n　　脳内物質がばーっと出て、[l]\n　　そんで……それとは別に、[l]\n　　何とか対処しようと頭の回転が……[l]\n　　処理がすごい速くなって相対的に周囲は遅く、[l]\n　　……マンガの中の話と思ってたけど……","咦……好像学过这个……[l]\n　　疼痛通常是作为规避危险状况的警告信号……[l]\n　　根本来不及规避，[l]\n　　做啥都太迟了，[l]\n　　受到致命伤害时……[l]\n　　脑内物质会唰地涌出，[l]\n　　然后……除此之外，[l]\n　　大脑会拼命加速运转试图应对……[l]\n　　处理速度暴增导致周围相对变慢，[l]\n　　……还以为只是漫画里的桥段……"],["そうか……あとは、[l]\n　　痛過ぎて……[l]\n　　気を失うか……","这样啊……接下来，[l]\n　　要么痛到……[l]\n　　昏过去……"],["しぬか……","要么死掉……"],["「誰の入れ知恵か知らないが、\n多分キミがイツワの断片をクイ合わせたところで、[l]\nそれとこれとは──[l]\nキミが完全な●になるかどうかは関係ないぞ」","「不知道是谁教唆的，\n就算你把伊兹瓦的碎片和奎拼合，[l]\n那和这事也──[l]\n与你能否成为完全的●毫无关系」"],["……？[l]\n　　わたしにはなしかけてる？","……？[l]\n　　是在对我说？"],["「だから、[l]\n幾らキミが、[l]\n●であるキミが、[l]\nまこくんを●●でも──」","「所以说，[l]\n无论你这个，[l]\n身为●的你，[l]\n就算把小真●●也──」"],["まこ……ちゃん、[l]\n　　やっぱりまこちゃんの名前を、","真……酱，[l]\n　　果然真酱的名字，"],["……ああ、わたしさ、[l]\n　　あのときからずっと●●だったのだわ。[l]\n　　でも、","……啊啊，我啊，[l]\n　　从那时候起就一直是●●了呢。[l]\n　　但是，"],["「……ま、[l]\n選ぶかどうかはまこくん次第だけど。[l]\n分が悪いのは否めないな。[l]\nというより、\n手段と目的を取り違えてるんじゃね、[l]\n──んむ、全く悪いヤツも居たもんだ」","「……嘛，[l]\n选不选择取决于小真啦。[l]\n形势不利是事实。[l]\n不如说，\n根本搞错手段和目的了吧，[l]\n──嗯，世上真有够恶劣的家伙呢」"],["……わるくない、[l]\n　　わるいのはわたし、[l]\n　　むくい、[l]むくい、","……不坏，[l]\n　　坏的是我，[l]\n　　报应，[l]报应，"],["──そうなの？","──是这样吗？"],["「─────」",""],["あ、もうなにもきこえない。","啊，已经什么都听不见了。"],["なんか、","感觉，"],["ねるときみたいだわ、","像要睡着了一样，"],["それとは別の本心がね最近ま\nこちゃんと再会してから抑え\nらんないのだわ何かムジュン\nしてる？気にしないでね頭悪[l]\nいから私とにかくね私なんか\nじゃだからねあーあーもうね\n頭悪いからさ何書きたいのか\nもわかんないけどさ話せば早\nいんだろうけど祭忙しくてで\nも祭終わったらきっとああさ\nっきも書いたねこれ頭悪いか\nらさ私こんななのだわだから\n何か間違ったことしようとし\nてたらバカって叱って止めて\nほしいよそうでないと私バカ\nだからさいけないことをしそ\nうでイヤなのだわ早くちゃん\nとしたひとになりたいそれか\nねまこちゃんが冬夏ともしい\nややっぱ言わないわえへへ。","除此之外还有真心话呢最近\n和真酱重逢后就压抑\n不住了呢 是不是很矛\n盾？别在意啦 我脑子笨[l]\n所以总之呢 像我这种人\n就是啦 啊——啊 真是的\n因为脑子笨嘛 连想写什么\n都不知道 但说出来应该更\n快吧 不过祭典太忙了等\n祭典结束了一定能 啊对\n之前也写过呢这个 因为脑子笨\n嘛 我就是这样的人啦 所以\n要是想做什么错事\n的话 希望骂我笨蛋阻止我\n哦 不然我会变笨蛋\n的啦 差点要做\n坏事好讨厌 想快点变成\n靠谱的大人 要不\n然真酱和冬夏般配\n果然还是不说了 嘿嘿。"],["あー、","啊——"],["あいたいよーまこちゃん。","好想见你啊——真酱。"],["私はそんな二人をみられれば\nまこちゃんたちふたりならば\nさそれなら許せると思うのだ\nわ。","要是能看到那样的两个人\n如果是真酱你们俩的话\n那我觉得就能原谅了\n呢。"],["あいたいよう。","好想见你啊。"],["まあでもそこは最後の意地だ\nからさ冬夏にはひみつ。","不过这点最后的倔强\n啦 要对冬夏保密。"],["なんでこうなったんだろ？","怎么会变成这样呢？"],["いっぱい、いけないことを、","是因为做了很多，坏事，"],["しちゃったからかな？","的缘故吗？"],["あとはあれだわ他にも色々言\nいたいこともあったけどさ、","还有就是那个啦 虽然还有\n其他很多想说的话，"],["だからあやまったり──\n　　いいたいこと──がいっぱい──\n　　あるの──に──","所以想道歉——\n　　想说的话——还有很多——\n　　但是——"],["やっぱ、墓場まで持っていくのだわ。","果然，要带进坟墓里呢。"],["そのほうがかっこいいし？","这样比较帅吧？"],["ひみつは大事よね。","秘密是很重要的呢。"],["ミステリアスってやつ？","就是所谓神秘感？"],["──────",""],["「………んむ──」","「………嗯咕——」"],["────",""],["──",""]],"context":[["SC_M_074.ks/index/1/text"],["SC_M_074.ks/index/3/text","SC_M_074.ks/index/15/text","SC_M_074.ks/index/35/text","SC_M_074.ks/index/89/text"],["SC_M_074.ks/index/5/text"],["SC_M_074.ks/index/7/text"],["SC_M_074.ks/index/9/text"],["SC_M_074.ks/index/11/text"],["SC_M_074.ks/index/13/text"],["SC_M_074.ks/index/17/text"],["SC_M_074.ks/index/19/text"],["SC_M_074.ks/index/21/text"],["SC_M_074.ks/index/23/text"],["SC_M_074.ks/index/25/text"],["SC_M_074.ks/index/27/text"],["SC_M_074.ks/index/29/text"],["SC_M_074.ks/index/31/text"],["SC_M_074.ks/index/33/text"],["SC_M_074.ks/index/37/text"],["SC_M_074.ks/index/39/text"],["SC_M_074.ks/index/41/text"],["SC_M_074.ks/index/43/text"],["SC_M_074.ks/index/45/text"],["SC_M_074.ks/index/47/text"],["SC_M_074.ks/index/49/text"],["SC_M_074.ks/index/51/text"],["SC_M_074.ks/index/53/text"],["SC_M_074.ks/index/55/text"],["SC_M_074.ks/index/57/text"],["SC_M_074.ks/index/59/text"],["SC_M_074.ks/index/61/text"],["SC_M_074.ks/index/63/text"],["SC_M_074.ks/index/65/text"],["SC_M_074.ks/index/68/text"],["SC_M_074.ks/index/70/text"],["SC_M_074.ks/index/72/text"],["SC_M_074.ks/index/74/text"],["SC_M_074.ks/index/76/text"],["