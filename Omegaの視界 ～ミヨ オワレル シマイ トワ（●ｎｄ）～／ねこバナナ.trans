,[{"start":4997,"end":5045}],[{"start":5059,"end":5080}],[{"start":5086,"end":5098}],[{"start":5104,"end":5124}],[{"start":5130,"end":5145}],[{"start":5184,"end":5191}],[{"start":5197,"end":5242}],[{"start":5314,"end":5319}],[{"start":5325,"end":5331}],[{"start":5337,"end":5349}],[{"start":5388,"end":5392}],[{"start":5398,"end":5406}],[{"start":5412,"end":5435}],[{"start":5441,"end":5459}],[{"start":5495,"end":5555}],[{"start":5569,"end":5630}],[{"start":5636,"end":5647}],[{"start":5661,"end":5722}],[{"start":5736,"end":5794}],[{"start":5808,"end":5819}],[{"start":5825,"end":5846}],[{"start":5864,"end":5870}],[{"start":5894,"end":5906}],[{"start":5912,"end":5955}],[{"start":5969,"end":5984}],[{"start":5990,"end":6019}],[{"start":6025,"end":6048}],[{"start":6087,"end":6094}],[{"start":6133,"end":6172}],[{"start":6184,"end":6194}],[{"start":6200,"end":6216}],[{"start":6252,"end":6304}],[{"start":6343,"end":6347}],[{"start":6353,"end":6357}],[{"start":6363,"end":6374}],[{"start":6413,"end":6416}],[{"start":6422,"end":6428}],[{"start":6467,"end":6512}],[{"start":6518,"end":6542}],[{"start":6578,"end":6587}],[{"start":6593,"end":6635}],[{"start":6653,"end":6680}],[{"start":6686,"end":6696}],[{"start":6735,"end":6759}],[{"start":6765,"end":6782}],[{"start":6821,"end":6830}],[{"start":6836,"end":6860}],[{"start":6872,"end":6899}],[{"start":6938,"end":6944}],[{"start":6983,"end":6993}],[{"start":6999,"end":7033}],[{"start":7039,"end":7044}],[{"start":7116,"end":7121}],[{"start":7160,"end":7169}],[{"start":7208,"end":7261}],[{"start":7267,"end":7273}],[{"start":7328,"end":7362}],[{"start":7380,"end":7396}],[{"start":7402,"end":7423}],[{"start":7565,"end":7642}],[{"start":7648,"end":7687}],[{"start":7693,"end":7714}],[{"start":7720,"end":7783}],[{"start":7789,"end":7804}],[{"start":7810,"end":7826}],[{"start":7832,"end":7873}],[{"start":7879,"end":7965}],[{"start":7971,"end":7976}],[{"start":7982,"end":7988}],[{"start":7994,"end":8010}],[{"start":8016,"end":8023}],[{"start":8041,"end":8086}],[{"start":8092,"end":8121}],[{"start":8127,"end":8137}],[{"start":8151,"end":8190}],[{"start":8196,"end":8241}],[{"start":8255,"end":8290}],[{"start":8304,"end":8368}],[{"start":8382,"end":8448}],[{"start":8462,"end":8470}],[{"start":8476,"end":8486}],[{"start":8492,"end":8504}],[{"start":8518,"end":8522},{"start":8538,"end":8542}],[{"start":8560,"end":8604}],[{"start":8610,"end":8625}],[{"start":8639,"end":8689}],[{"start":8695,"end":8716}],[{"start":8730,"end":8753}],[{"start":8759,"end":8787}],[{"start":8801,"end":8825}],[{"start":8831,"end":8878}],[{"start":8892,"end":8909}],[{"start":8915,"end":8925}],[{"start":8931,"end":8937}],[{"start":8951,"end":8970}],[{"start":8976,"end":9006}],[{"start":9020,"end":9049}],[{"start":9055,"end":9074}],[{"start":9158,"end":9217}],[{"start":9263,"end":9310}],[{"start":9383,"end":9414}],[{"start":9420,"end":9483}],[{"start":9497,"end":9534}],[{"start":9552,"end":9629}],[{"start":9643,"end":9673}],[{"start":9715,"end":9761}],[{"start":9775,"end":9786}],[{"start":9792,"end":9807}],[{"start":9821,"end":9886}],[{"start":9900,"end":9953}],[{"start":9965,"end":9986}],[{"start":10000,"end":10030}],[{"start":10036,"end":10047}],[{"start":10084,"end":10102}],[{"start":10138,"end":10215}],[{"start":10229,"end":10237}],[{"start":10243,"end":10256}],[{"start":10270,"end":10307}],[{"start":10354,"end":10368}],[{"start":10374,"end":10423}],[{"start":10429,"end":10456}],[{"start":10470,"end":10521}],[{"start":10535,"end":10586}],[{"start":10592,"end":10601}],[{"start":10615,"end":10632}],[{"start":10638,"end":10653}],[{"start":10667,"end":10680}],[{"start":10686,"end":10712}],[{"start":10726,"end":10745}],[{"start":10751,"end":10754}],[{"start":10768,"end":10828}],[{"start":10842,"end":10848}],[{"start":10854,"end":10869}],[{"start":10875,"end":10887}],[{"start":10893,"end":10909}],[{"start":10923,"end":10954}],[{"start":10970,"end":10987}],[{"start":10993,"end":11008}],[{"start":11022,"end":11030}],[{"start":11036,"end":11059}],[{"start":11075,"end":11104}],[{"start":11110,"end":11129}],[{"start":11135,"end":11143}],[{"start":11157,"end":11173}],[{"start":11179,"end":11197}],[{"start":11203,"end":11208}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_010.ks","basename":"SC_M_010.ks","indexIds":{"帰りは店を出た時点でバラバラになった。":0,"一人帰り途、血が下に降りてしまった空転脳味噌で\n思索が走る。":1,"よくよく考えると、\n御神体の事を知ってる人間は、\n地元民ですらそうそういないという話じゃなかったか。":2,"こないだは深読みしたが、\n三春の蔵を見たがる人間は、御神体が目当てではない\nという事になるので、":3,"冬夏の母親の、僕に対するあしらいが手慣れてたのも、\n常にそういう連中に晒されていたというよりも、\n単に本人の性格があんなだというだけかも知れない。":4,"手慣れていたというよりも、過敏な反応というべきかも知れない。":5,"もし後者ならば、\nまさにあの蔵がビンゴか或いは、":6,"…単に僕の先入観からそうみえたか。":7,"あとは宮さんの情報が本当でない場合かなあ。":8,"まさかわざわざ嘘を言ってるってことは…無いとは言い切れないが、\n可能性は低いだろう。":9,"――まあ何を考えたところで、想像の域を出ることはないのだ。":10,"僕の主観しかそこにはない。":11,"誰かの意見を聞いたわけでも勿論当人に聞いたわけでもない。":12,"推論めいたことはしているが、根拠は薄弱すぎる。":13,"考えることは大事だが、\n自分の脳内だけで結論出そうったって無理があるし切りがない。":14,"結局、実際に動かないとどうにもならないのだ。":15,"自分で管理掌握できる行動以外に関しては、\n何をしたって何を考えたって想像にすぎないんだし、\nなにがどうってもう腹もふくれてあたまがうごかないんです。":16,"北の地とはいえ今日は小春日和、\n集合したときは多少まだ肌寒かったが今はもうそれなりの陽気。":17,"帰ったら昼寝したい程である。":18,"旅館が見えてきた。":19,"――結局、誰にもまだ僕の名字を伝えてはいない。":20,"大学からこっち、対人関係に於いてはむしろ\n名字しか知らない事の方が多くあるのだが、\n幸いその辺は特に気にされていないのだろうか、\n今のところ曖昧なままでも話は進んでいる。":21,"まあ、きぃがもし真に昔馴染みで、\n子供だった当時に僕の名字を知っており、かつ、\nその記憶を正確に保持している場合、\nこの予防線は全く無駄になるのだが。":22,"しかして何故かきぃは、知狡さんの旅館『六母屋』を\n知っているにも関わらず、\n僕との関連性には気付いていないようだった。":23,"敢えて言うこともないと黙っているのかも知れないが。":24,"それとも記憶の変容か、欠落か。":25,"とは言っても下手にほじくり返すと藪蛇だし、\n冬夏の前で変なこと言い出さない事を祈ろう…":26,"さても今日はたまたま冬夏、\n狩屋達に紹介する際に僕の名字を知らない状況に関しては\nスルーしてくれた――いくらなんでも\n恣意的ではないだろう――が、":27,"部分的にでも本当の事を言うか、\n徹底的に嘘で塗り固めるかは検討しなければならないだろう。":28,"今晩会えれば宮さんにでも相談しとくか。忘れなければ。":29,"今日は初対面が多くて疲れた…":30,"しかも女子ばっかり何人も…":31,"だが、どうにも単純に喜べないのが、\n偶然なのか蓋然なのか、\nすべからく三春家に関わる者達だったということだ。":32,"調査を進めるにあたり、これが吉と出るか凶と出るか。":33,"ああ、面倒なことは厭なんだけどなー。":34,"嘘もあまり巧くないし僕は…":35,"旅館に着いた。":36,"「――そうか」":37,"丁度知狡さんが居たので、\n早速事の成り行きを話した。":38,"「では明日にでも迎えを寄越させよう。":39,"ついさっき…母殿の知人が本家の家に来たから、\n私と、そのもう一人で案内する。":40,"母殿、ああお前の祖母だな。":41,"都合で立ち会えないから」":42,"「わかりました」":43,"「あと、\nその三春の…人達、\nお前に何か妙な反応したりはなかったか？」":44,"「へ？」":45,"初っ端から冬夏に、宮さんばりに逆セクハラされたとか、\nそういうくだりは秘しておいたので焦る。":46,"姫様ちゃんの態度にしてもまあ自意識過剰を覚悟で言えば、":47,"何かしら好意は感じたけども…":48,"本人がはっきり口にしたわけでもないし、\n第一知狡さんにわざわざ報告する事柄ではない。":49,"と、思ったんだが。":50,"ピンポイントで質問されてしもうた。":51,"「漫画かこれは、ってくらいモテモテ状態でした、":52,"とかそういう事ですか」":53,"「ほう。":54,"そんな風だったか」":55,"や、また真面目に取られても…":56,"「成る程…」":57,"あの、納得しないでくださーい。":58,"「ん？":59,"いや、\n彼女達も視る眼があると思ってな。":60,"そうかそうか…」":61,"顔が笑ってないよ知狡さん。":62,"なんで『やっぱり』みたいな表情なんです。":63,"そもそも質問の意図は何だったのか。":64,"「そろそろお前も年頃だしな…":65,"一応訊いてみただけだ」":66,"「そういうのは女子にして下さいよ…":67,"男子は３０からが勝負だって母さんも言ってます。":68,"第一、母さん曰く、み…」":69,"…いや、やめとこう。":70,"色んな意味で今ここでこの人相手に言うことではない。":71,"「まさかお前、\n宮さんを狙ってるのか！？":72,"それはまた危険な…」":73,"折角途中で止めたのに、\n知狡さん空気読まずに超反応。":74,"「や、や、ちょっとちが！」":75,"「":76,"現":77,"実、己が子に恐ろしい事を吹き込んだな…":78,"真言、お前」":79,"「や、だから戯れ言ですって！！":80,"とにかく相手が誰だろうと、\n今積極的に女子とそういう関係性をどうこうという気は\nないです！！」":81,"大神とかれお嬢の話が此処に来る直前あったが、\n別に羨ましくなどない！":82,"誤解されても困るので述べておくが、\n勿論男子好きだからでもないし！":83,"宮さんの逆セクハラの御陰で、\n残念ながらと言おうか、\nあまり女子との関係性に有難味が薄いというか？":84,"不自由してないっつーか？":85,"もう受け身体質に仕込まれちゃってる？":86,"そうでなきゃ、冬夏にも姫様ちゃんにも、健全男子として\nもっと大反応…というと語弊があるな、\nえーとそう、貪欲に対応してただろう。":87,"狩屋はねえな。きぃは…微妙。":88,"………なんてな。":89,"あーもう、":90,"考えてたら虚しくなってきたわ…":91,"Ｍか僕は。":92,"「宮さんの事はとにかくまあ、\n三春の面々に関しては、嫌われるよりは好いだろうな。":93,"とは言え程々にな。深入りはするなよ」":94,"だからいちいち深刻にならんで下さい。":95,"ただ実際、どうも最近、\n『積極接触大好き女子』との遭遇率が高すぎな感はあるんだ。":96,"最近というかこっち来てから、というべきか。":97,"モテ期到来？":98,"宮さんはあんなですからカウントしませんよ。":99,"もう宮さんと逢ってから約一年、\nあの人は一次的接触こそしてこないが、\n言葉責めだの、妙なお預けだの、":100,"只でさえ年齢その他正体が曖昧なのに\n間接的に迂遠な方法でメンタルから責めてくるからなあ。":101,"…そういう言葉遣うからＭな気分になるのか。":102,"んなことはどうでもいい。":103,"さっきから変な思考ループに入ってるなあ。":104,"空腹な訳でもないのに脳空転か。":105,"「勿論ですよ。":106,"でも向こうから深入りしてきたらその限りじゃ\nないですけどね、なあんてアハハハハハ」":107,"「…ああ、":108,"その場合は、":109,"――どうしたものか……」":110,"「あう…":111,"冗談ですから……":112,"ご心配なさらなくてもそんな甲斐性ないですから…":113,"『彼女いない歴＝年齢』ですよ僕は…」":114,"成るときは成る、という\n結局のところ面倒なのが嫌いな性格が災いしてか、\n告白したこともされたことも無い。":115,"だからそういう意味では今の宮さんとの、\n精神的にせよ肉体的にせよ、この距離感は\n心地好いものではあるんだ。":116,"一方的な感情だけれど。":117,"それはともあれ、\nまあ彼女達の過剰なタッチングも、\n今時の女子の風潮なんじゃないの、と思ってるくらいだし、":118,"或いは、僕に危険性を感じてないからしているんだろうし、ま、そういう所見で言えば深入りされようも無いというものだ。":119,"…ちと悲しい推論だが。":120,"それとも宮さんを見てるからそう見えるのか。":121,"ちなみに飯窪":122,"実とは母さんの名である。":123,"本家を出たとはいえ、我が家も婿を迎える形を採っており、\n姓は本家と同じく飯窪。":124,"父さんの旧姓は聞いたことない。":125,"子供に何にもパーソナルデータ教えてくれなかったんだうちは。":126,"両親共に誕生日、未だにはっきり知らないもんな。":127,"「――そうか。":128,"それ故にフラストレーションが…という場合も\nあるがそうでは無いんだな？":129,"それは、なによりだ…":130,"それにしてもいや、だが…現実が」":131,"そうこうしてる間に知狡さん、\n何とか納得してくれたようだが、\n母さんがどうかしましたか。":132,"「真言。":133,"私は――":134,"君の母さんが羨ましい」":135,"「は？":136,"母さんが？」":137,"「私は自分の価値観が信じられずに、\n他人が作った大きな流れにその責任を委ねた女だ。":138,"常に揺らぎ、自分以外の視線を気にして生きてきた」":139,"妹はまるで違った。":140,"お前を生んだのがあれというのも、\n今にして思えば当然だったのかも知れないな。":141,"そう言った知狡さんの顔が、\n僕からは見えない。":142,"一体どうしたのか――":143,"「ま、また何か変なモードに入ってますよ知狡さん。":144,"僕、置いてけぼり状態なんですが…」":145,"「真言。お前には…":146,"いや、それこそ他人がどうこう言う問題じゃないな。":147,"すまない。初日の時といい、\n――私の悪い癖だ。":148,"許してくれ」":149,"「ほ、ほんとですよ。":150,"話振るだけ振っといて放置なんて、\n知狡さんも女子ですなあー。":151,"あははは」":152,"「初日の」":153,"「はは…は、はい」":154,"「あの橋の上での話を、\nもし思い出すことがあったら、\n必要なその時によく考えてみてほしい。":155,"それだけだ」":156,"じゃあ明日は宜しく頼む、\nと言って知狡さんはその場を去った。":157,"…前からこういう人だったかなあ…":158,"どこまで真面目に受け取ったらいいのやら……":159,"宿から車を借りて、\nといっても例のハイヤーではなく、\n知狡さん（もしかして宮さん？）が\n用意させていたらしいやや古色ばんだ軽だが、":160,"道の確認も兼ねて、初日に行ったラーメン屋へ\n一人向かい、夕食を摂った。":161,"アニソンの流れない車を運転するのも久々だ。":162,"昼飯があんな量だったので少々逡巡したのだが、\n今日は色々あったし、ちとエネルギー補充の要を\n感じたのです僕ぁ。":163,"食が細るとメンタルにくるしな！":164,"夜、宮さんに逢うかも知れないし。":165,"さて杉屋での僕の通例に準じて、\nまずメニューの中でも？な物を優先して注文。":166,"初回は知狡さんのオススメを、\n言っちゃ悪いけど選ばざるを得なかったので、\nその時から気になってたこの\n『黒胡麻味噌チーズトマトラーメン』で行きます！":167,"赤黒白い！":168,"なんだこれ。":169,"ネーミングもそのままじゃねえか。":170,"素材羅列って。":171,"僕はソロで外食は殆どしないが、\nその際も、待ち時間に店の暇本読んだりはしないのだ。":172,"端から視ると頭抱えて悩んで見える様な姿勢で軽く寝てますよ。":173,"まあ瞑想？違うけど。":174,"自分の部屋だと飯時に本は必ず読みながらだが、\n余所ではしないのが信条。":175,"漫画など、途中から読んだり、食事終わったら中断して帰らねばならないのが耐えられないからだ。":176,"大抵は外食なんて大神と行くので、\n奴とのだべりで時間は過ぎる。":177,"という訳で今此処でも、\nメニューや、謎のチラシみたいな定期発行小冊子を熟読したり、\n半寝りしたりして待っていた。":178,"入店した時はまだ疎らだった客が、\nその後時間帯もあって混んできたようで、\nやや待ち時間が掛かったがいよいよ品が来た。":179,"おおう赤黒白い！":180,"臭いが微妙過ぎだ！！":181,"じゃーいただきます！！！":182,"………。":183,"…まあ杉屋でもそうだけど、\n一見イロモノ風だけど、普通に食べられちゃうんだよな。":184,"不味くもないが旨くも無い感じ？":185,"単に素材が個々に味を主張しているが、即ち、\nハーモニーになってない替わりに不協和音でもない、":186,"各々を順番に口に入れればこうなるかな、と。":187,"ある程度ネタのつもりでこっちも挑んでるんだが。":188,"勝手な言い分で申し訳ないけども、やや肩透かしの感否めず。":189,"金取る以上は店側も無茶できないんだろうけどなー。":190,"かといって昼間のあの店みたく、\n単純に量があるだけの方がネタになるっていうのもどうだ。":191,"ま、うーんなるほど、ということで。":192,"ごちそうさまでした。":193,"また来ます。":194,"次は普通にメジャー所の品目で戴きたい。":195,"そっちは美味いんだから半端なメニューつくんなきゃいいのにな。":196,"いや、試行錯誤し精進しようという意志や良しと視るべきかな。":197,"それとも、僕の味覚が変なのか。うーん。":198,"帰り道、案の定というか、\n少々いや結構な時間、道に迷ってしまい、\n帰ってきたときは午後九時過ぎだった。":199,"知狡さんも不在だったので、\n車のキーだけフロントに言って返却し、自販機で烏龍茶を買う。":200,"一応自分の部屋に戻る前に、宮さんの部屋の前まで行くことにする。":201,"わざわざ携帯で連絡するのもあれだし、\nそうした時点で逢う確約を取り付ける行為になってしまってる気がして気が引けたのだ。":202,"寝てたら起こす事にもなるし、\n居たら居たで、という程度のつもりで。":203,"とは言え自分の部屋と違う方向に向かったということは、\n僕にとっては道すがらの行為では無くなってしまっている訳で、\n何だか無駄に緊張するな。":204,"――着いてみると、\n今夜は宮さんはもう寝ていたのか、":205,"入り口には\n『就寝中』のプレートが下げてあり、\n中からも動く気配は無かった。":206,"このプレート手製だな…":207,"わざわざ何してるんだあの人は。":208,"どっちにしても先刻も考えた通り、\nこう意思表示されてる処を押してまで\n逢おうと思う程の理由も無ければ間柄でもなし、":209,"宮さんといえども歴とした女子、\n本人はああ言ってたが、そうそう夜に足繁く部屋に通う訳にもいかない。":210,"先刻考えてた相談事は後にしよ。覚えてたら。":211,"まあどっちにしろ今夜は僕の独り相撲、肩透かしで済んだようだ。":212,"部屋に戻ることにする。":213,"「………（おやすみ、なさい、っと）」":214,"この所、目の前にずっと居たせいで、\nちょっと会えないだけでなんというかこう、\n変な喪失感…いやいや、そんな大げさなもんじゃない、ちょっと、":215,"ちょっとだけだ、":216,"寂しい気がしたものだから。":217,"入り口の前で、小さくおやすみの挨拶だけして、\n自分の部屋に戻った。":218,"…なんだろうな、この感じは。":219,"先刻の知狡さんとの会話で変に意識したり、\n昼間テンション上がってた反動もあるんだろうけど。":220,"いかんいかん、ちょっと気を抜くと切ねえ気分に襲われる。":221,"いわば『吊り橋の出会い』とでも言おうか、\n身体状況と精神状態のリンクのすり替えとでも言おうか、":222,"要するに勘違いだとしても、\n今から寝ようってときにこういう気分は非常に、\nなんかなあ。":223,"落ち着かないなあ。":224,"と、部屋に戻って電気をつけた瞬間、":225,"携帯が着信振動し死ぬほど焦る。":226,"メールきた。…宮さんから。":227,"タイミング良すぎだろ、\nと思って件名見ると、":228,"『おやすみ、先に寝ちゃってごめんね♪』":229,"だと。":230,"メールしてきてる時点で寝てねーんじゃねえか、\nというツッコミも忘れ、\nあーもう嬉しがってんじゃないよ僕。":231,"く、くそう。":232,"なんか見透かされた感じが嫌だ。":233,"てか気付いてたな宮さん？":234,"それともどっかからか見てるのか？":235,"こええな、僕の居ない間にカメラとか仕掛けたんじゃないだろうな…":236,"しかもなんか画像も付けてきよった…":237,"ぐ、それは見ないでおいてやる！":238,"ともあれ寝ます！":239,"幸か不幸か変なモヤモヤ感は吹っ飛びましたので！":240,"あー今日はもう一日中、最後まで女子に振り回されて終了だよ。":241,"なんだって女子てのはこうなんだろうな。":242,"男子は弱いねえ…":243,"己を顧みて一頻り嘆いたところで。":244,"明日も用事出来たことだし、いざ就寝！":245,"お疲れ！！":246},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_010.ks","relPath":"/data/scenario/SC_M_010.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":247,"length":247,"percent":100},"cellInfo":[[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"t":"HU","v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"t":"HU"}],null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,[null,{"t":"HU","v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[60,1],"note":"完成"},"/data/scenario/SC_M_011.ks":{"data":[["ＰＰＰＰ。","ＰＰＰＰ。"],["Ｐ。","Ｐ。"],["…んあ。","…嗯啊。"],["あー、朝、か。","啊—、早上、吗。"],["昨日夜まで気疲れしたせいで、\n今朝はちょっとだるい。","大概是昨晚一直精神紧绷累着了，\n今早有点乏力。"],["セットしておいた携帯のアラームを、\n眼を瞑ったまま操作し止める。","把事先设好的手机闹钟，\n闭着眼睛摸索着关掉了。"],["若干肌寒いし、惰眠への誘惑が襲ってくるが、\n今日は本家に行かなければならない。","稍微有点凉飕飕的，赖床的诱惑不断袭来，\n但今天必须去本家。"],["とっとと起きよう…","赶紧起床吧…"],["それにしても、\nこっち来てから、連日健康的な時間に起床してるなあ。","话说回来，\n来这边之后，每天都健康作息早起了呢。"],["遊びに来てるわけではないし別に良いんだが。","反正不是来玩的倒也无所谓。"],["大学行ってた頃より余程、規則正しい日々を過ごしております。","比上大学那会儿过得规律多了。"],["というより、夜も遅いわけじゃないし。","或者说，晚上其实也不算太晚。"],["なーんにも愉快な番組無い上に、\n思ったよりもやることが連日あったので、\n結果そうならざるを得ないだけだけど。","既没什么有趣的节目可看，\n每天要处理的事情又比预想中多，\n结果只能这样罢了。"],["ま、それとは別に、只でさえ番組構成が向こうと違う所為か、\n曜日感覚が無くなったりと、順調に浮世離れは進んでいる。","不过除此之外，可能因为节目编排本来就不同，\n渐渐连星期几都搞不清了，真是越来越脱离世俗。"],["それは別にいいけど。","这倒也没什么不好。"],["とにかくまだ着いてから３日しか経ってない。","总之才刚来三天而已。"],["気張ってるうちだけかも知れないし、\nま、体調及び精神状態の自己管理はしっかとせんとなあ。","可能只是暂时绷着劲儿，\n嘛，身体和精神状态都得好好管理才行啊。"],["大神と毎日電話するのも気持ち悪いし、金も掛かる。","每天和大神通电话也怪恶心的，还费钱。"],["奴も今頃何してるんだか。","那家伙现在在干嘛呢。"],["かれお嬢と逢えないながらも進展してるのかしらん。","虽然见不到卡蕾欧小姐但有没有进展呢。"],["彼等、もし一緒になったら、大神まで飯窪本家の縁の者に\nなるのか。","要是他俩真成了，大神岂不是要变成饭洼本家的姻亲\n了？"],["それともかれお嬢、寿退社的扱いに家庭に入るのか。","还是说卡蕾欧小姐会像退休结婚那样回归家庭？"],["前者だったら…とにかく気持ち悪いなあ。","要是前者…总之就是很恶心啦。"],["しかし彼女、特殊な技能で遣われてたようだし、\n本家が辞めさせないかもしれないな。","不过她好像有特殊技能被重用，\n本家说不定不会放人。"],["大神、ＳＥとしてなら使えるかも知れないが、\nやっぱり直接親戚筋になる訳では無いとはいえ、\n友人以上に近しい処に世間的な位相を占められると\n何度も言うが気持ち悪いよ。","大神作为SE或许还有点用，\n虽说不会直接变成亲戚，\n但想到社会关系上要比朋友更亲近\n重复多少遍都觉得恶心啊。"],["と、一頻り暇つぶしの思考遊戯を揺蕩わせ、\n頭に血が巡るのを待っていた。","就这样放任消磨时间的胡思乱想飘荡着，\n等待血液涌上头顶。"],["「………ああ、そういやあ…」","「………啊，说起来…」"],["握りっぱなしにしていた携帯に、\nふと気付いて思い出した。","突然注意到一直攥着的手机，\n这才想起来。"],["夕べの宮さんからのメール。","昨晚宫小姐发来的邮件。"],["画像は見てなかったのよな。","还没看图片呢。"],["さてどうしたものか。","现在该怎么办呢。"],["視てあげっか折角だし。","既然特意发了就看看吧。"],["…変な意図は無いよ？","…可没有奇怪的想法哦？"],["また結構な労力割いたんだろうし、\n視てあげないと宮さんの苦労に申し訳ないからですよ？","毕竟她也费了不少功夫，\n不看的话对宫小姐的苦心过意不去对吧？"],["おかしな期待はシテナイヨ？","别抱奇怪的期待好吗？"],["………さ、自己弁解はそこそこにして、","………好了，自我辩解到此为止，"],["えーと…","呃…"],["がた。","嘎嗒。"],["そこで突然部屋の入り口が開く気配がし、","这时突然感到房间门口有动静，"],["驚いている間に、寝室の襖が開いて、","还没反应过来，卧室纸门就被拉开，"],["また別の私服になってる宮さんが現れた。","换了另一套便服的宫小姐出现了。"],["「おっはようございます。","「早~安~。"],["何か久しぶりなかんじですね？","总觉得好久不见了呢？"],["みましたか？メール。","看了吗？邮件。"],["メール。","邮件。"],["どうでした？","怎么样？"],["どうでした？」","怎么样？」"],["夕べ返信しなかったせいか、\nまずそこから訊いてきますか宮さん。","是因为昨晚没回信吧，\n居然先从这个问题切入啊宫小姐。"],["なんか余程………な仕込みでもしてたのか。","该不会特地………准备了什么吧。"],["タイミング的に幸か不幸か、\n今まさに視ようとしてた処で。","时机上不知是幸运还是不幸，\n正好在我要看的时候。"],["つまりはまだ視てないんです。","也就是说还没看到呢。"],["それよりまず最初に、\n僕の入室許諾の可否を聞いてくれないでしょうか。","比起那个首先，\n能先确认下是否允许我进房间吗。"],["「…おはようございます。","「…早上好。"],["朝から心臓に悪い登場の仕方ですね宮さん。","一大早就用这么刺激心脏的方式登场呢宫小姐。"],["大変申し訳在りませんが、\n昨日は疲れてあっという間に寝てしまいまして。","非常抱歉，\n昨天太累转眼就睡着了。"],["件名は確認しましたけども」","虽然邮件标题确认过了」"],["添付画像は見てません、\nというなり激しく落胆する宮さん。","附件图片还没看，\n话音刚落宫小姐就剧烈沮丧起来。"],["「んむーっ？","「唔嗯——？"],["折角宮が頑張って一肌脱いだのにっ！","难得宫好不容易鼓起勇气脱给你看的！"],["あーんなことまでしたのにっ！","连那种事都做了！"],["恥ずかしかったけどまこくんの事を思って","虽然很害羞但想着小真"],["一生懸命っ！」","超级努力的！」"],["「あ、それは申し訳ないです…","「啊、那真是对不起…"],["丁度今確認しようとしてたんで……」","刚好正打算现在确认……」"],["と持っていた携帯を操作しようとすると、","正要操作拿着的手机时，"],["「はうあ！","「哈呜啊！"],["ば、ばかーっ！","笨、笨蛋——！"],["今見ちゃ駄目です！","现在不准看！"],["寄越すです！！」","交出来！！」"],["えらい剣幕で焦りだし、まだ寝ぼけ気味でスローリー動作だった\n僕の手から携帯を奪い、\n何やら恐ろしい形相で操作しだした。","她气势汹汹地扑来，从还带着睡意动作迟缓的\n我手中抢过手机，\n摆出可怕表情操作起来。"],["「ふんだ！","「哼！"],["もう消しましたもんね！","已经删掉了哦！"],["あーあ勿体ないです！","啊——啊太浪费了！"],["悔しがるがいいです！」","你就尽情后悔吧！」"],["涙目…。","泪眼汪汪…。"],["時事ネタはタイミング命なんだからっ！","时事梗最重要的就是时机啦！"],["と説教されている僕。","被这样训斥的我。"],["話のスケールがやや違うが、\n言いたいことは解ります。","虽然话题规模有点不同，\n但想表达的意思我懂。"],["まあその時その場所その面子でないと受けない笑いとか、\nあるよねあははー。","嘛有些笑点就是要特定时间地点人物才成立，\n确实有呢啊哈哈——。"],["ちゅうか宮さん、自身が居る前で視られるのが恥ずい、\nというのが理由の大半なんじゃ。","或者说宫小姐，其实大半原因是当着本人面看会羞耻，\n对吧。"],["いずれ後悔するくらいならやらんで欲しいんですけど。","与其事后后悔不如当初别做啊。"],["「もう二度とあんなの出来ないよぉ…","「再也做不到那种程度了啦…"],["ぐす」","呜」"],["………。","………。"],["う、正直気にはなるが、\nここで喰い付く素振りを見せようものなら\n今後何かと弄られるのは目に見えている。","呃、说实话很在意，\n但要是此刻表现出好奇的样子\n今后绝对会被各种捉弄。"],["「あーそうですね。","「啊——这样啊。"],["悔しいったらないです。","真是遗憾到极点呢。"],["なのでこっちで勝手に色々と\n想像させて戴きます。","所以这边就擅自\n展开各种想象啦。"],["ああ、一体どんな…","啊啊，到底会是怎样的…"],["マサカアンナ事ヤコンナ事ヲ宮サンガ…」","总不会宫居然做了这样那样的事吧…」"],["「心がこもってないっ！","「根本不够真心！"],["変態さんってツッコミもできないですっ！」","连吐槽你是变态都做不到啦！」"],["そのツッコミをさせないためにそうしたので","正是为了不让她吐槽才这么说的"],["当然です。","理所当然。"],["「最近冷たいよまこくん。","「最近好冷淡哦小真。"],["宮のこときらいなんだぁ…」","讨厌宫了对吧…」"],["「あのね…","「那个啊…"],["きらいとかそういう事じゃないでしょ。","不是讨厌不讨厌的问题吧。"],["それに今始まった事でもない気が…」","而且感觉也不是现在才开始的…」"],["「前まではもっと愉快な反応してくれたですよぉ」","「以前明明会给更有趣的反应的啦」"],["結局だからそうでしょ…","所以果然是这样吧…"],["弄りたいだけなんだからこの人は…","这人只是想玩弄我罢了…"],["第一嫌いじゃないですよ、好きですよ！","首先我并不讨厌你，我喜欢你啊！"],["とかいうレスも変…というか別の意味になり兼ねないし。","这种回复也很怪…或者说可能有别的含义。"],["それともそう言わせたいのか。","还是说你想让我这么讲。"],["そして弄りたいか。そうなのか。","然后想玩弄我是吗。是这样吗。"],["「周囲の状況がここ最近、誰かさんの御陰で\n激変してて疲れてるんですよたぶん。","「最近周边状况因为某人的缘故\n剧烈变化搞得我很累啦大概。"],["きらいになんかなってないので\n安心してください」","并没有变得讨厌你\n请放心」"],["誰かさんとは目の前のこの人なのでちと矛盾してまぁす。","所谓的某人就是眼前这位所以有点矛盾呢。"],["「（じゃ、\n好きなのかな？）」","「（那、\n是喜欢我吗？）」"],["「ハイ？」","「啊？」"],["と、宮さんの手にした携帯が鳴った。","这时宫小姐手里的手机响了。"],["「んむっ。","「嗯唔。"],["こんな早くに誰でせう？","这么早会是谁呢？"],["…おおう知狡ですね。","…哦哦是知狡啊。"],["はいまこくん」","给小真」"],["「あおう、はいはい」","「哦哦，好的好的」"],["なんと言ったか聞き取れなかったが、\n例によってあっさりモードが替わる宮さん。","虽然没听清说了什么，\n但宫小姐照例瞬间切换了模式。"],["まあ丁度好い。","嘛正好。"],["変な話題になりかけた気配だったし。","感觉刚才话题要往奇怪方向发展了。"],["ありがとう知狡さん。","谢谢知狡阿姨。"],["『ああ、真言か？","『啊，是真言吗？"],["私だ。","是我。"],["今から迎えがそちらに行くから、\n支度してロビーで待機してくれるか。","现在派接你的人过去那边，\n你准备好在大厅等着。"],["センノチノという女性だ。","是个叫千野千乃的女性。"],["多分、マスクをしていくだろうから、\nそれを目印にしてくれ。","她大概会戴着口罩，\n你就以这个为标记。"],["あ、マスクといっても被る方じゃないぞ。","啊，说是口罩但不是戴的那种哦。"],["では、本家で待っている』","那么，本家见』"],["生返事をしてるうちに、知狡さんはさっさと通話を切ってしまった。","就在我敷衍应答时，知狡阿姨利落地挂断了电话。"],["結構ドライだな。電話切るのに抵抗無いタイプな。","挺干脆啊。挂电话毫不拖泥带水的类型。"],["あと、マスクったら普通、風邪用マスクをちゃんと想像しますから。","还有说到口罩正常人都会想象是防感冒口罩吧。"],["心配性だなあ。","真是爱操心呢。"],["「なんです？」","「怎么了？」"],["「あ、何か今日、本家のお宝見せられるんですと。","「啊，说是今天能让我看本家的传家宝。"],["で、迎えが来るそうです今」","现在接我的人要来了」"],["「んむ？","「嗯唔？"],["あー、今日なんですか。","啊ー，是今天啊。"],["日程までは聞いてませんでした」","我都没听说具体日期」"],["「あ、そうですか…","「啊，这样啊…"],["てかそもそも昨日夕方決まったんで、\n伝える間も無かったんですけどね。","其实昨天傍晚才决定的，\n根本没时间通知你。"],["ん？","嗯？"],["本家にまた行くって話もしてなかった気が…」","连要去本家这事都没说过吧…」"],["「んむ？？","「嗯唔？？"],["いやですねまこくん。","不行哦小真。"],["宮は確かに車降りませんでしたけど、\nちゃんと知狡から聞いてます。","宫虽然确实没下车，\n但我可是从知狡那里听说了。"],["というより、\n前から決まってた事ですから」","不如说\n这是早就定好的事」"],["へえー。","嘿诶ー。"],["そうなんですか。","这样啊。"],["それはつまり、","也就是说"],["「なんか今回の調査と関係あるんすか？」","「和这次调查有关系吗？」"],["「んむー、ま、遠からずですかね。","「嗯唔ー，嘛，差不多吧。"],["取り敢えずは気にしないでだいじょぶでっす。","总之不用担心没问题的。"],["うちで正式に働くんなら、飯窪の血統の者として、\n特にまこくんは直系男子ですからね、\nこの機会に家宝についても教わるべきということです」","既然要正式在家族里工作，作为饭洼血统的人\n特别是小真你是直系男子\n趁这机会也该学习下家传宝物的事」"],["はあ。","哈啊。"],["そういや、もしこのまま僕が宮さんや本家の方に\n世話になるとなると、\nその場合うちの母さんどうなるんだろう。","说起来，要是我就这样去宫小姐或本家那边\n受照顾的话，\n到时候我家老妈会怎样呢。"],["向こうの家から離れる気はなさそうだし…","看她完全没打算离开那边的家…"],["「ま、\n早めに戻れそうなら今日は一緒に食事でも\nしましょうか。","「嘛，\n要是能早点回来的话今天一起吃个饭\n怎么样。"],["それとも今日も若い女子達と楽しく過ごすんですか。","还是说今天也要和年轻女孩们愉快玩耍呢。"],["それならそれでいいですけど宮は。","那样的话倒也无所谓啦。"],["一人で寂しくごはんします。","但是宫会一个人寂寞地吃饭。"],["冷たいなぁ…まこくんが冷たいなぁ………","好冷漠啊…小真好冷漠啊………"],["冷たすぎて風邪引きそうです…」","冷到都要感冒了…」"],["そのギャグが寒くてこっちが風邪引きそうです。","你这冷笑话才让人冷到要感冒了。"],["しかし言えない。言えやしない。","但说不出口。根本没法说。"],["つーかまだそっちの話題引きずるか。","话说还揪着那个话题不放啊。"],["自分の世界に入っとるし。","完全沉浸在自己的世界里。"],["「むつけ…いや、むくれないで下さい。","「闹别扭吗…不对，请不要背过身去。"],["きらいじゃないって言ってるでしょう。","不是说过不讨厌你嘛。"],["明日が蔵に入る本番だので今日は逢わないんですよ。","明天要正式进仓库所以今天不见面啦。"],["宮さん昼間忙しいんじゃないんですか」","宫小姐白天不是很忙吗」"],["不用意な接触をギリまで避けるのと、\nギリまで打ち合わせるのと、","是尽量避免贸然接触，\n还是尽量提前商量，"],["どっちが良いか考えたが、すべからく行き当たりばったりな\nこの状況で何を打ち合わせるものか困惑した僕は、\n前者を採択したのだった。","虽然权衡过哪个更好，但在这种完全走一步看一步的\n状况下根本不知该商量什么的我，\n最终选择了前者。"],["大体今日の本家の用件もどんだけ掛かるか分からないし。","再说今天本家的事要耗多久也不知道。"],["「ま、実際どれだけ時間かかるか分かんないですし。","「嘛，其实也不知道要花多少时间。"],["まこくんが少しでも長く宮と一緒に居たそうだったから\n気を遣って言ってみました。","因为看小真似乎想多和宫待一会儿\n才体贴地这么提议。"],["別にタイミング合えばで結構ですよ宮は？","时机合适的话宫随时都可以啦？"],["どうしてもとは言いませんよ。","不会硬要你说非今天不可啦。"],["どうせ宮はメモでもしないと忘れちゃいますもんね。","反正宫不做备忘录就会忘掉嘛。"],["でもぉ、まこくん次第でどうとでも都合してあげます。","不过呢～只要小真愿意人家随时都能配合哦。"],["うひひ」","嘿嘿」"],["「………」","「………」"],["寝起きでこっちも脳が空転気味なので、\nこれ以上の論理的なレスは厳しい。","刚睡醒脑子也不太转得动，\n要做出更理性的回应实在困难。"],["ジト眼で見返す位が関の山だった。","最多只能回以死鱼眼。"],["「さ、早く行かないと来ますよ迎えが。","「差、差不多该走了接的人快来了。"],["終わったらメール下さい。","结束后给我发邮件。"],["状況次第ではぁ…」","视情况的话…」"],["「はいはい。一緒にご飯ね。","「知道啦知道啦。一起吃饭是吧。"],["じゃ、今後はメール来たらすぐ視るようにしますよ」","那之后收到邮件会立刻看的啦」"],["「あーい。","「好～的。"],["今日はメールのネタ仕込みする時間は無いから、\n今別の方法で直接元気を注入してあげまー」","今天没时间准备邮件素材了，\n现在用其他方式直接给你补充元气吧～」"],["「ちゅーなら結構」","「亲亲就免了」"],["「んむー！","「嗯唔～！"],["やっぱり冷たいっ！！","果然好冷淡！！"],["ハグでもしたげなきゃかなっ！？」","是不是该给你个拥抱才行！？」"],["もうええちゅうねん。","都说了不用啦。"],["………って、オチてもいないというか、","………话说连收尾都算不上，"],["「それよりそろそろ出てってくれませんか。","「比起这个能不能请你先出去。"],["早く行けも何も着替えすら出来ないんですけども」","别说赶时间了我连衣服都还没换呢」"],["「ん？","「嗯？"],["おおう！","噢对！"],["そでしたね。","是这样呢。"],["今出まーす」","现在出去～」"],["ここはあっさり引くんだな。","倒是意外地干脆撤退了。"],["てっきり『宮には構わずどうぞ着替えてくださいうひひ』とか\n言うのかと思った。","还以为肯定会说『不用管宫请尽管换衣服吧嘿嘿』之类\n的话。"],["まあ、僕が遅れると他の人にも影響する状況だからな。","不过毕竟我迟到会影响其他人的状况啊。"],["「じゃ宮も戻りますね。","「那宫也回去啦。"],["頑張ってー。","加油～。"],["いってらっしゃい。","路上小心。"],["チノによろしく」","代我向千乃问好」"],["「何かをどうにか頑張る事柄なのかどうかも解りませんが了解です」","「虽然不清楚具体要努力做什么事情，但我明白了」"],["宮さんが完全に部屋から出たのを確認し、\n僕は急いで支度を始め――","确认宫小姐已经完全离开房间后，\n我慌忙开始准备――"],["――の前に、入り口に立ち小声で","――在此之前，站在门口小声地"],["「………愛してます」","「………我爱你」"],["と呟いた。","如此低语道。"],["途端に扉が開き、","突然门被打开，"],["「うひひ。","「呜嘿嘿。"],["何ですかもぅっ。","真是的干什么啦。"],["照れますなあ♪","好害羞呀♪"],["宮困ってしまいますぅ」","宫会很困扰的啦」"],["やっぱり其処に居たのか。","果然还在那里吗。"],["いや、\n何処にまず突っ込もうかも分かんなくなって来ましたよ…","不，\n我都不知道该从哪里开始吐槽了…"],["もうどうでもいいんで、とにかく早く部屋に戻って下さい」","算了无所谓了，总之请快点回自己房间」"],["「はぁーい」","「好～的」"],["「僕の部屋でなく貴女のお部屋にっ」","「不是我的房间是回你的房间啦」"],["「ちぇっ。","「切。"],["んむー残念。","嗯唔～好遗憾。"],["わっかりましたぁー。","知道啦～。"],["知狡達に怒られないうちに退散しまーす。","趁还没被知狡她们骂赶紧溜啦～。"],["うひひっ」","呜嘿嘿」"],["ようやく本当に立ち去る宮さん。","宫小姐终于真正离开了。"],["朝からどっと疲れさせられたわもう…","大清早就让人精疲力尽啊真是…"],["――てもう時間結構経ったじゃねえかよ。","――话说时间不是已经过去超多了吗。"],["やばいやばい急いで支度だ。","糟了糟了得赶紧准备。"],["遅れたらしっかと宮さんの所為にするかんね…","要是迟到就全怪宫小姐好了…"],["さて、初日の本家からの車移動時間から考えて、\nそろそろと思った時間には何とか支度も整い、\nロビーで待機していたのだが、\nまだそれらしき人物は到着していなかった。","那么，根据第一天从本家出发的车程来推算，\n在预估的时间点总算准备完毕，\n正在大厅等候时，\n目标人物仍未现身。"],["まあそもそも、本家から来るかどうかも定かじゃないし。","说到底连她会不会从本家过来都不确定。"],["来た気がするな。勘だけど。","不过感觉已经来了。虽然只是直觉。"],["何でそう思ったか自分でも解らないが、\n車の音がしたでも無いのに、とにかくそう思った。","连自己都不明白为何这么想，\n明明没听到车声，却莫名产生了这种预感。"],["で、ホントにどうやらそうだった。","结果还真猜对了。"],["一瞬子供かと思ったくらい背が低く、\n知狡さんが言ったように、\nマスクをした女性がロビーから入ってきた。","个子矮得让人误以为是小孩，\n正如知狡阿姨所说，\n戴着口罩的女性走进了大厅。"],["三白眼で目つきが悪い…というか、\n眼の下に隈があり、\nマスクと相まって非常に不健康そうに見える。","三白眼显得眼神凶恶…或者说，\n眼睑下方挂着黑眼圈，\n配合口罩看起来极度病态。"],["実際にそうなのかも知れないが。","说不定实际情况就是如此。"],["宮さんとは別の意味で年齢がよく分からない。","和宫小姐是不同类型的难以判断年龄。"],["祖母の知り合いで、今日僕に色々説明してくれる人というのが、\nこの人なのだろうか。","祖母的熟人，今天要给我做各种说明的，\n就是这位吗。"],["動作が何というか変に違和感あるというか、\n頭の高さが変わらずに歩いてるというか、\n一個一個の所作はスムースなんだが、\n逆にそれが全体的に視ると人間として不自然というか、","动作该怎么说呢有种诡异的违和感，\n像是维持固定头部高度在走路，\n每个单独动作都很流畅，\n但整体看来反而像非人类般不自然，"],["……また初対面の人間に対して失礼な印象を持ってしまう。","……又对初次见面的人产生了失礼的印象。"],["と思ってみれば、確かにどこかしらかれお嬢に通じる系の\nような気配もするな。","仔细想想，确实能感受到某种与卡蕾欧小姐\n相似的气息。"],["飯窪本家そんなのばっかり集めてんのかしらん。","饭洼本家专收这种怪人吗。"],["向こうがこっちを見知ってるかどうかまでは定かでないので、\nこちらから声を掛けることにする。","由于不确定对方是否认识我，\n决定主动打招呼。"],["知狡さんが寄越してる以上は大丈夫だろうけど念の為。","既然是知狡阿姨安排的应该没问题，但为防万一——"],["「あ、あのすみません。","「那、那个您好。"],["センノ…さん？ですか？」","是千野…小姐？对吗？」"],["声を掛けると、その女性は眉を","刚出声搭话，那位女性就皱起"],["顰め、ゆっくりと、\nしかも目線ではなく、\nまるで機械のように顔ごとこちらに向けて、一度眼をしばたいた。","眉头，缓慢地，\n并非转动眼球，\n而是像机械般将整个面部转过来，眨了眨眼。"],["「…ドウモ、こんにちわ。","「…多谢问候，你好。"],["ん、お早う？","嗯、早啊？"],["どっちでもいいか。","都无所谓啦。"],["チズルに言われて迎えに来ました貴方を。","是小知让我来接你的。"],["私の名前は…チノ、","我的名字是…千乃、"],["千","千"],["野チノです。","野千乃说是。"],["宜しくどうぞ」","请多指教」"],["「あ、やっぱりそうですか。","「啊、果然是这样呢。"],["おはよう…ございます。","早上…好。"],["えーと、飯窪真言です。","呃、我是饭洼真言。"],["こちらこそ宜しくです」","我这边才是请多指教」"],["動作から受けるイメージとは裏腹に、\nといっても僕個人の主観の話だが、\nやけに耳障りの良い声である。","与动作给人的印象相反、\n虽说这只是我个人的主观感受、\n她的声音异常悦耳。"],["マスクで籠もってはいるのだが、\n幼いとも大人の女性とも取れる、\nこちらの保護欲と母性への甘えの両方を刺激する微妙なる声。","虽然戴着口罩、\n既像孩童又似成年女性、\n这种微妙声线同时激发出保护欲与对母性的依恋。"],["いわばカリスマ性というか、\n声質だけ聴くと人心掴めそうな声なのだ。個人主観だけど。","或者说充满领袖魅力、\n单听音色就让人觉得能笼络人心。虽然只是个人主观。"],["惜しむらくは、文章自体に違和感あるとこか。","可惜的是措辞本身有点违和感吧。"],["あとゆっくりではあるのだが、\n途切れなく喋るのでやっぱり機械的な印象になるところとか。","再加上虽然语速缓慢、\n但说话毫无停顿反而显得机械感十足。"],["うーん僕がいちいち人の声中に、惹かれる部分を自動検索しすぎかねえ。","唔…我是不是太爱自动检索别人声音里的吸引要素了啊。"],["大神あたりの、声優がどうとかいうのとは違うと思ってるんだが、\n何か自信無くなって来たな。","和大神他们讨论声优什么的性质不同、\n突然有点没自信了。"],["「乗ってください車に早速。","「请快上车。"],["聞いてますよ時間がないと。","听说您赶时间。"],["ん？聞いてないかな？","嗯？没听说吗？"],["どっちでもいいですが。","都无所谓啦。"],["無いですしねゆっくりする理由も」","反正也没有慢慢来的理由」"],["ゲホゲホ、と見た目通り不健康そうな咳をする彼女。","她「咳咳」地发出与外表相符的不健康咳嗽声。"],["「あの、大丈夫ですか？","「那个、不要紧吗？"],["とても体調宜しく無さそうなんですが…」","看起来身体状况很差的样子…」"],["「…大丈夫です心配は。無用。","「…不用担心。没必要。"],["演技ですから相手の期待に応える為の。","这是演技，为了回应对方期待。"],["期待は裏切らないようにしたいんで」","不想辜负期待罢了」"],["「はい？」","「啊？」"],["「風邪ですかと問われますよねマスクをしていたら。","「戴口罩就会被问是不是感冒了对吧。"],["ん？花粉症か？","嗯？花粉症吗？"],["どっちでもいいんですが。","都无所谓啦。"],["人って少なくともfirst impressionは見た目十割ですが、\nその第一印象とはかけ離れた実状を個々人は持ってるでしょう。","人类至少第一印象全靠外表、\n但每个人实际都与第一印象相去甚远吧。"],["それを知って落胆される事は私にとってはとても悲しい事です。","知道真相后失望对我来说是件很悲伤的事。"],["私これでも尽くすタイプなのですよ、はい。","我啊可是奉献型人格呢，真的。"],["ギャップによって発生する価値もありますがね。","虽然反差也能产生价值啦。"],["私は感じませんがね。","我是感受不到啦。"],["居ますけどね世の中には。","不过这世上确实存在呢。"],["とみに最近は対立項を並列させたり、\n逆ベクトル項を少々加味した存在をなんとか…なんだっけな？","特别是最近总爱把对立项并列、\n或是加入些逆向要素的存在…叫什么来着？"],["まあいいか。","算了无所谓。"],["そういったモノに浅い大衆的価値を付加し見出してるでしょう。","大众就爱给这种肤浅东西附加价值。"],["若年の浅い脳髄機構で走る思考電気などで、\nしかし消費システム界においては供給側はその流れに乗ってしまう傾向が大という悲しい現状…","用年轻人大脑皮层里流动的脑电波、\n但消费系统界供给方总爱迎合潮流的可悲现状…"],["という現状に対するアンティテーゼのつもりで、","本想说这是对现状的反命题、"],["しかし、それすらも私個人の嗜好にしか過ぎず、\n他人に強要すべきことでもないですしね、\n簡単に言いますと、\n眼鏡をかけた人間はインテリゲンチア、\nデブは大食い、","但其实也不过是我个人偏好、\n不该强加于人呢、\n简单来说、\n戴眼镜就是知识分子、\n胖子等于大胃王、"],["と言ったコミック的なsterotype、\n理解できます？","这种漫画式的刻板印象、\n明白吗？"],["マスクをした人間は咳き込む人間。","戴口罩的人必定会咳嗽。"],["メディアを毛嫌いしながらメディアによって作られた虚像たらんと\nする…ヒトとは謎ですね。","一边厌恶媒体一边又想成为媒体塑造的虚像\n…人类真是谜啊。"],["私これでも古いタイプの女なのですよ、はい」","别看我这样可是老派女人哦，真的」"],["これはスタイルなだけですつまり、\nという、よく分からない返答をされた。","这只是风格问题也就是说，\n得到了这样一个莫名其妙的回答。"],["長かったなおい…","好漫长啊喂…"],["何か途中で熱こもってたし。","中途还突然发热来着。"],["……えー、…要するに、風邪だのアレルギーだので\n咳き込んだ訳ではない？","……呃、…简而言之，并不是因为感冒或过敏\n才咳嗽的？"],["もの凄くかみ砕いて解釈すると、\n『お約束はなるべくお約束通りに』","如果用最通俗的方式解释，\n『约定俗成就该按约定俗成来』"],["という事かなあ…違うかなあ…","大概是这个意思吧…或许不是…"],["遣ってる言葉も多分造語っぽかったな。","用的词估计也是自创的那种。"],["僕が寡聞にして知らないだけかもだが、\n単語を、遣いたい意味のまま並べただけな気がするんですが。","可能只是我孤陋寡闻不知道，\n感觉就是把单词按自己想要的意思胡乱堆砌。"],["それで更に意味不明の度合いが増してました。","结果导致更加意义不明了。"],["あれ、ところでつまり、\nこの人がマスク着用の理由は他にあるって事か？","啊咧，那也就是说，\n这人戴口罩是另有原因咯？"],["その肝心な処を説明してくれないと、長々喋られる意義もへったくれも…","不把这个关键点说明白的话，长篇大论根本毫无意义…"],["と、がっと僕の手を握り、じゃない、\n手首を掴んで半ば引きずるような勢いで、\nチノ嬢が外に向かって歩き出した。","说着突然抓住我的手——不对，\n是拽着手腕几乎拖行的力道，\n千乃小姐朝外面走了出去。"],["「え、あ、はい？","「咦、啊、啥？"],["ななななんですかってちょっと！」","干干干干什么突然这样！」"],["「急がされていたんでした私達、チズルに」","「我们被小知催得很急啦」"],["おいおいおいおい。","喂喂喂喂。"],["いくら急ぐったって、\nまず基本的に貴女の喋りが長かったのが問題ではないのか。","再着急也好，\n根本问题在于你刚才废话太多才对吧。"],["そしてまたスキンシップ女子ってか…","又来肢体接触系女子吗…"],["宮さんや冬夏達のような、","虽然不像宫小姐或冬夏她们那样"],["好意めいた行為（自分で言うと馬鹿みたいだな）でなく、\nあくまで効率的だからという理由のようだが。","带着好感意味的行为（自己说出来感觉好蠢），\n纯粹是出于效率考虑的样子。"],["いずれにしても異性の身体に易々と接触できる感覚というのは\n僕的にはあれだなあ…","但无论如何能轻易触碰异性身体的这种感觉\n对我来说该说是…"],["僕もこれで古い頭の男子なのですよ、はい。","我也是个思想老派的男生啦，是的。"],["というか貴女、古いタイプってどの辺がですか。","话说你自称老派到底老在哪里啊。"],["「思わず長話で時間が経ってしまいましたのでご容赦下さい。","「不小心长篇大论耽误时间了还请见谅。"],["お願いします急ぐ事を。","现在请优先赶路。"],["で、迎え遅れたのは私の所為でして。","所以迎接迟到是我的责任。"],["ちょと忘れてました道路。","稍微忘记这条路了。"],["何故なら私此処来ること久々なので」","毕竟我很久没来过这里了」"],["おお長話の自覚はあったんな、と思う間に、\n彼女は助手席のドアを開け僕に乗車を促してから、\n運転席にまわり、ぬるりと乗り込んだ。","正想着原来有自知之明啊，\n她就拉开副驾驶门示意我上车，\n自己绕到驾驶座流畅地钻了进去。"],["彼女が乗ってきたのはマニュアル車で、\n乗ると同時にクラッチを踏んでエンジン掛けるチノさん。","她开的是辆手动挡车，\n千乃小姐上车同时踩离合打火的架势。"],["僕のシートベルトの装着を確認するや否や、","刚确认我系好安全带，"],["「っういー！？」","「呜诶——！？」"],["急発進。","突然起步。"],["バックで止めてたので前進スタートが可能だったのだった。","因为是倒车停放所以可以直接前冲出发。"],["そしてまさに機械の如き手つきでギアを入れ、\n速攻５速に入る。","接着以机械般精准的动作换挡，\n瞬间切到五档。"],["しかし、道中の運転そのものは、\n法定速度の許容範囲ギリギリをキープしてたり、\n車や人が全く無かろうが信号が赤ならばしっかと止まるなど、\n極めて模範的なものであった。","不过实际行驶过程中，\n她始终将车速压在限速临界值，\n哪怕完全没车没人也会严格遵守红灯停车的规矩，\n堪称模范驾驶。"],["まあそれは、そうあるべきであって何の問題も無いんだけども。","嘛这本就是应有的驾驶态度无可厚非。"],["ただ、とにかく発進が急気味なので、\nこれは、ちょっと酔うかもなあ…","只是起步实在太猛，\n搞得我有点晕车了…"],["で、横からの車も歩行者も居ないのに何故か赤くなった押しボタン信号、それ待ちのややバツの悪い間が訪れた時、唐突に彼女が口を開いた。","当遇到横竖都没车却莫名变红的行人按钮信号灯，正尴尬等待时，她突然开口："],["「ルール、ロウというのは同族生物が恙無く生活をする為のものですから、杓子定規に遵守すれば良いというモノではないですが。","「规则、所谓律法本是同族生物平安生活的保障，并非要人死板遵守的东西。"],["かといって他者に対して説得力を得るためには、\n独りの時も遵法者たらねばなりませんよ。","但若要让他人信服，\n独处时也须恪守法规才行。"],["精神論を語る気も無いですが。","倒不是想说教。"],["言語はこのヒトという種が属する文化の呪ですから。","语言本就是人类这种生物所属文化的诅咒。"],["解釈の差違も面倒なものです。","解读差异也是麻烦事呢。"],["まあ現実現象としてNatureから生まれたヒトが、\n他生物同様生命本能に則って行動するのが真か、\nヒトとしての文化に準ずるのが真か、\n事実そこに在るモノが真か、\nヒトとその他を分かつという思考そのものが既に反自然ですし、","嘛 作为现实现象从Nature诞生的人类，\n和其他生物一样遵循生命本能行动才是真实，\n还是遵从人类文化才是真实，\n亦或是实际存在之物才是真实，\n区分人类与其他生物的思考本身就已经违背自然了，"],["思考主体の判断基準次第です。","这取决于思考主体的判断标准。"],["しかし、何にでも擬人化思考を以てして、\nヒトの価値観を他種に当て嵌めるのはどうにも。","但是，对任何事物都套用拟人化思维，\n硬把人类的价值观强加给其他物种总归有点..."],["だからと言ってどう扱っても良い訳ではないのですよ。","不过这也并不意味着可以随便对待它们啊。"],["愛玩と友愛は違うということなんですがね。","宠物和朋友的关爱方式终究是不同的。"],["ま、向こうは向こうで被愛玩存在としての地位を確立することによる種の存続をかもしれませんから。","嘛，说不定对方作为被宠爱的存在确立地位后，反而能延续种族呢。"],["それこそこちらの理屈を押しつける訳にもね。","那样的话也没法强行让对方接受我们的道理呢。"],["擬人化と言えば、\n容貌が可愛いか醜悪かで、もてはやしたり殲滅したりとかしますでしょう。","说到拟人化，\n根据外貌是可爱还是丑陋，就会有人追捧或是想要消灭掉吧。"],["勿論実利を採ってる場合もありますがね。","当然也有出于实际利益考虑的情况啦。"],["その辺りを言い出すと、先刻言ったギャップの件と矛盾し出すのでこの辺で。","要是继续深究这点，就会和刚才说的反差感产生矛盾，就到此为止吧。"],["で、結局の処、\n好嫌のみがこの世を動かしていると言えますかね、今のところ。","那、说到底、\n现在的话、能说这世界就是靠好恶在推动的吗？"],["どっちでもいいですが。私たちには」","「怎样都无所谓啦。对我们来说」"],["「申し訳ないですが何を仰って居られるのか","「很抱歉您到底在说什么"],["僕にはさっぱり…」","我完全听不懂…」"],["この人、途切れなく喋るから長く感じるのだろうが、\n何より相づちを打つ間が無いんだよ。","这人因为喋喋不休才会让人觉得漫长吧，\n最重要的是根本找不到插话的空隙。"],["そして自己完結的に終わるからレスのしようが無い。","而且还会自我完结式地结束对话，让人没法接话。"],["あと恐らくだが、自分の脳内での思考を進行するがままに\n声に出してる所為か、主語述語がくしゃくしゃな気がするし、\n尚かつ整合性が有るような無いような微妙な感じに。","另外我猜，她大概是放任自己脑内思考\n直接脱口而出的缘故，主谓结构乱糟糟的，\n还带着若有似无的逻辑性那种微妙感。"],["なので、衒学的にも聞こえそうで聞こえない。","所以听起来似懂非懂故弄玄虚。"],["うーん…突拍子の無さと言語周りの違和感、\n平身低頭と慇懃無礼の違いはあるが、\nかれお嬢とやっぱり同類なんだなきっと…","嗯…这种突如其来的违和语言感，\n虽然和卑躬屈膝与虚情假意有所不同，\n但肯定和卡蕾欧小姐是同类人吧…"],["最近は知狡さんもこっちの部類になりつつある気配がするし、\n飯窪本家、びっくり人間集めて何かしらしたいのか。","最近感觉知狡阿姨也快变成这类人了，\n饭洼本家是在收集奇葩人类搞什么名堂吗。"],["びっくり人間てなんやねん。","奇葩人类到底是什么鬼啦。"],["「ああ、問題無いですよ。","「啊，没关系的。"],["どっちでもいいことです」","怎样都无所谓啦」"],["出会ってからの感じから判断して、\n怒ってる訳ではないと思うけども…","从见面时的氛围来判断，\n应该不是在生气…"],["この場合わかった振りして生返事の対応なんかしたら\n泥沼になりそうだし、どうしたものか。","这种情况下要是装作明白然后敷衍应付的话\n感觉会陷入泥潭，该怎么办才好。"],["それとも無言の道中よりかはマシなのかな。","还是说总比一路无言要强些呢。"],["と思っていると、","正这么想着，"],["「構いませんよ寝ていても」","「没关系的就算睡着也行」"],["「え？","「诶？"],["あいえ、大丈夫です…","啊不、不用了…"],["もう着きますよね確か」","应该快到了吧我记得」"],["「すみませんね。","「真是抱歉。"],["必要以上に人心、察してしまうのですよ」","我总会过度揣测他人心思呢」"],["「はあ…」","「哈啊…」"],["察しが良すぎるって事？","意思是太会察言观色了？"],["別に眠かった訳ではないのだが、\n間が保たないなら狸寝入りもおｋだよ、\nというのを気を遣った迂遠な言い回しで\n言ったという事？","倒也不是因为犯困，\n如果冷场的话装睡也ok啦，\n是用拐弯抹角的体贴说法\n来表达这个意思？"],["ああ、僕も言語回路おかしくなってきた。","啊，我的语言模块也出问题了。"],["自分でも何考えてるかわからん…","连自己都不知道在想什么…"],["――人の意を察すと言えば『 ","――说到揣度人心『 "],["覚 』、\n旅館の部屋名にもあったな。","觉 』，\n旅馆房间名也有这个呢。"],["思わず、変な想像しないように構えてしまう僕。","我不由自主地绷紧神经防止产生奇怪联想。"],["「言われて欲しくない事を口にしないという\n察し方を出来る人なので私。","「不会把别人不想听的话说出口\n我可是很会察言观色的人。"],["安心してください」","请放心吧」"],["「はあ、そうですか…」","「哈啊，这样啊…」"],["別に恥ずい思考を巡らせた訳ではないが、\nそれ以前にまさかこの人、本物じゃないよな。","倒也不是在转什么羞耻的念头，\n但更关键的是这人该不会真是冒牌货吧。"],["あははーそんなばかなー。","啊哈哈——怎么可能嘛——"],["「想像力とはその所持者にとって諸刃の剣ですよ」","「想象力对持有者而言可是双刃剑哦」"],["「は？","「哈？"],["はあ、そう、ですか…」","哈、这、样啊…」"],["な、何に対しての、その御言葉なんでしょうカ。","请、请问这句话是针对什么说的呢。"],["「己の敵対する対象の行動原理を知るに当たり、\nprofiling的な想像力は助けにはなりますが、\n同時に嫌悪する対象と同調する事でもありますからね。","「要理解敌对对象的行为逻辑，\nprofiling式的想象力固然能提供帮助，\n但同时也是在与厌恶对象产生共情呢。"],["潔癖性には辛いですよ」","对洁癖人士来说很折磨哦」"],["「…何かの小説で読んだ気がします…","「……好像在什么小说里读到过…"],["まあ、そうでなくても、恐怖症って要するに極端な想像力の\n発露の仕方ですしね、あはは…","不过就算没看过，恐惧症本质上也是极端想象力的\n一种表现形式嘛，啊哈哈…"],["……違ってたら済みません」","……说错的话还请见谅」"],["ああ私もよくわかりませんね。","啊其实我也不是很懂呢。"],["まあどっちでもいいんじゃないですかね」","反正怎样都无所谓吧」"],["「そうですね…","「说的也是…"],["まあ…どっちでもいいです…」","反正…怎样都行…」"],["結局、前後の関連性は相変わらずわからないまま、\nそして車は例の入り組んだ町並みに入り込み、\n本家に近づいて来ていた。","最终前后关联性依然毫无头绪，\n而车辆已驶入那片熟悉的错综街巷，\n逐渐逼近本家宅邸。"],["「おお、着きますね。","「噢，快到了呢。"],["チズルが出迎えています」","小知出来迎接了」"],["「あ、ほんとですね。","「啊，真的耶。"],["えーと、ありがとうございました」","那个，非常感谢您」"],["「問題無いです」","「不必客气」"],["知狡さんはえらい神妙な顔の直立不動体勢で僕らを迎えた。","知狡阿姨以肃穆神情如标兵般直立等候着我们。"],["車はぬるりと駐車スペースへと入り、\n僕らは降りて知狡さんの元へ向かう。","车辆缓缓滑入停车位，\n我们下车走向知狡阿姨。"],["急発進はするけど急停止はしないチノ嬢であった。","千乃小姐的车总是急启动却从不急刹车。"],["「おはよう二人とも。","「早啊两位。"],["チノお疲れ、ありがとう」","千乃辛苦啦，多谢」"],["「どういたしまして。","「不客气。"],["これからだけどね本当のお疲れは。","真正辛苦的还在后头呢。"],["ゲンシは立ち会わないんだね？」","老源不参与吗？」"],["「親父殿は勿論、母殿もだ。他も今余所にいる。","「家父自然不在，家母亦然。其余人等此刻皆另有要务。"],["私と君だけでいく」","就由我与你单独处理」"],["呼ばれ、連れてこられただけの僕は\nとまれ今のところは立ち尽くすしかない。","作为被传唤带来的我\n眼下只能呆立原地。"],["話が振られるまで待ちますよ。","静候被点名再发言吧。"],["「真言、朝食は摂ったのか？」","「真言，用过早餐了吗？」"],["「あー、ちゃんとしたのはまだですね…","「啊—正经的还没吃…"],["軽くお菓子的なものを食しただけで。","就随便吃了点零食。"],["ああそう、早めに終わったら宮さんに\n食事誘われてますけど」","对了，要是结束得早\n宫小姐约了饭局来着」"],["「宮さんと？","「和宫小姐？"],["ああそうか。","啊这样啊。"],["正直時間に関しては確約出来ないが、\nすまないが我慢してくれ。","时间方面实在无法保证，\n抱歉先忍忍吧。"],["宮さんと食事……か、わかった、まあ善処はしよう」","和宫小姐吃饭……行，我会妥善安排」"],["や、そこ深刻に検討しないでいいんですが。","不，倒不必这么郑重其事。"],["こないだの話、変なかたちで引きずってるな。","上次的事看来留下奇怪的后遗症了。"],["「私もまだ別件で用事あるので。","「我另外还有事要处理。"],["早速始めよう」","这就开始吧」"],["「わかった。","「明白。"],["いいか真言？","听好了真言？"],["きちんとした食事はすまないが後で頼む。","正式餐点容我稍后补请。"],["ではこちらだ」","现在请往这边」"],["前に知狡さんとチノ嬢、\n僕一人がそれに後続する形で歩き出す。","前方是知狡阿姨与千乃小姐，\n我独自跟随其后迈步前行。"],["前の二人は僕より付き合いの長い知り合いであろうから、\n並んで歩いてるんだと思ったのだが、\nさして会話をするでもなく、\n黙々と屋敷の中へと入っていく。","本以为走在前头的两位交情比我深厚，\n理应并肩而行才对，\n却未见她们有何交谈，\n只是沉默地向宅邸深处走去。"],["僕の所為？この空気。","是我的缘故？这气氛。"],["まあでも、仮にそうだとしてもどうしようもないわな。","不过就算真是这样也没办法啊。"],["屋敷内を只ひたすら付いていく。","在宅邸内只是默默跟着走。"],["前来た時の祖父の部屋とは、\n当然ながら違う場所を目指しているのだろう、\nもう道順から何からわかりません。","和上次来时的祖父房间方向\n当然不同吧，\n现在连路线都完全搞不清了。"],["まがりなりにも家宝、盗難予防に敢えて複雑な道程を設定\nしてるのだろうか。","好歹算是传家宝，防盗措施故意弄成复杂路线\n大概是这么回事吧。"],["…朝飯がちゃんとしてなかった所為か、\nそろそろ脳が空転し出す予感…","…或许是因为没吃正经早饭，\n感觉脑子快要开始空转了…"],["帰り道ぜってぇ分かんねえな…","回去的路绝对记不住啊…"],["「真言」","「真言」"],["「はっ、","「啊、"],["ふぁい？」","啥事？」"],["「ここから地下だ」","「从这里开始是地下」"],["「気を付けて足下は」","「注意脚下」"],["地下？","地下？"],["書じゃないというから、\n件の（飯窪の方の）蔵じゃないのは予想できたが、\n地下室なんてあるんだ。","既然说了不是书库，\n就猜到不会是（饭洼家那边的）藏书馆，\n没想到还有地下室啊。"],["ほえー…","哇哦…"],["いくつか並んだ洋風のドアの一つ、\n鍵穴に古びた鍵を挿す知狡さん。","知狡阿姨将生锈的钥匙插入\n众多西式门扉之一的锁孔。"],["あーと、どのドアか覚える集中力ももう無いです。","啊——连记住是哪扇门的精力都没了。"],["まあ今後一人で此処に来る用も無いだろうから\nいいでしょう、スルーしても。","反正以后应该不会独自来这儿\n无所谓吧，跳过也行。"],["と先行する二人はドアを開け、入ったすぐ横の壁を\n探りスイッチを押したらしかった。","先行两人推开门后，\n似乎摸索着按了入口墙上的开关。"],["地下への通路からオレンジ色の光が視え、どうやらすぐに下り階段なのだとわかる。","橙色灯光从地下通道透出，看来楼梯就在正下方。"],["知狡さん、チノ嬢、僕の順で降りて行く。","按知狡阿姨、千乃小姐、我的顺序下楼。"],["「おおう、\nドアは閉めるでお願いします」","「喂喂、\n麻烦关下门」"],["「あ、はい」","「啊好的」"],["「鍵も頼む」","「钥匙也拜托了」"],["「わかりましたぁ…と、\n暗いなあ……」","「知道啦…话说、\n好暗啊……」"],["湿気はさほどないが、\n独特の臭気と、肌寒さ。","虽然不算潮湿，\n但充斥着异味与阴冷。"],["音も静かで、","寂静无声的环境"],["洋風なのか和風なのかよくわからないこの空間と相まって、\nあれだ、\n地方の空いてる民俗資料館みたいだ。","配上这难以分辨西式和风的诡异空间，\n简直像\n地方上冷清的民俗资料馆。"],["喩えはあれだが。","虽然比喻不太恰当。"],["そもそも暗くてよくわからない。","主要还是太暗看不清。"],["「ったた、おうあ、ごめんなさいすみません」","「疼疼、哇啊对不起对不起」"],["「問題無いです、お気になさらず」","「没关系，请别在意」"],["まだ先があるらしいのに突然立ち止まった二人。","明明前方还有路，两人却突然停步。"],["思わずぶつかってしまった。","我不小心撞了上去。"],["階段でこんな暗いのに危ないな、\nちょっと間違えたら大惨事になるとこだった。","楼梯这么暗太危险了，\n差点就酿成大事故。"],["僕の腰が引けてた御陰か何とか軽い接触で済んだが。","多亏我下意识后仰才只是轻微碰撞。"],["――で、何で立ち止まったの？","――所以为什么停下？"],["「ああ、説明不足で悪かった。","「啊，没提前说明是我的错。"],["念のためとはいえ妄りに口に出したくはなかったんだ」","虽说是以防万一，但本不想轻易说出口」"],["「下はフェイク。","「下面是假的。"],["典型的過ぎてあまり効果は期待してませんが。","套路太老所以没指望有多大效果。"],["気休めですこの仕掛け自体は」","权当心理安慰的机关罢了」"],["と言って二人は左手の壁を探った。","说着两人开始摸索左侧墙壁。"],["「おお、おお何すかこれは。","「哇、哇这是在干嘛。"],["忍者屋敷じゃないすかまるで」","简直像忍者宅邸嘛」"],["漫画や映画のそれのように、隠し扉があったのだった。","如同漫画电影里的情节，出现了暗门。"],["大仰な仕掛けではないが、壁にとけ込んでおり、\nその気になって探さなければ見つからないだろう。","虽不算精巧机关，但完美融入墙壁，\n不刻意寻找根本发现不了。"],["下に階段は続いてるのだし。","何况下方楼梯还在延续。"],["吃驚はしてるんだが何気に大声を出しづらく、\n小声でリアクションする僕。","虽然很吃惊但不知为何难以大声喊出来，\n小声反应着的我。"],["「と言いますかですね、\n典型的と言われても普通の家屋には隠し扉自体が\n無いですよ…」","「或者说啊，\n就算说是典型 普通房屋里根本不会有\n暗门这种东西吧…」"],["二人は無言のまま扉を開け――こっちを外とすると中開の――、\n中に入った。","两人沉默着打开门――假设这边是外侧就是向里开的――\n走了进去。"],["やむなく従う。","我不得已跟了上去。"],["心なしか息苦しい感覚が僕を襲う。","莫名有种窒息感向我袭来。"],["閉所恐怖症のケでもあったのかな。","或许是幽闭恐惧症发作了吧。"],["「うあ、こっちは完全に真っ暗ですね…」","「呜啊、这边完全漆黑一片呢…」"],["「今明かり点くよ」","「现在开灯哦」"],["「そんなに明るくはならないからそのつもりで\nいてくれ」","「不会亮到那种程度 你做好心理准备\n」"],["まあこの状況でいきなり強照度のライティングされたら\n眼に悪いだろうし…","不过这种状况下突然强光照射\n对眼睛也不好…"],["徐々に赤黄色い光が部屋を照らし出す。","逐渐泛红的黄色光线照亮了房间。"],["まさに博物館のような柔い照明が、\n暗所に馴れた僕の眼に視界を見せ始める。","宛如博物馆般的柔和照明，\n让适应了黑暗的双眼开始恢复视觉。"],["「………おおう？」","「………呜哇？」"],["――筺のような、\n何の飾り気もない、只の立方体のような部屋だった。","――如同棺椁般的、\n毫无装饰的 纯粹立方体状房间。"],["セメント打ちっ放しのようにみえるが、\nそちら方面に明るくないので具体的な素材は知らない。","看起来像是水泥毛坯墙，\n但我不擅长这方面所以不清楚具体材质。"],["ただ黒く四角い部屋。","只是个漆黑的方形房间。"],["天井の四隅に明かり。","天花板四角装着照明。"],["入り口正面の、つまり最奥の壁際に、\n神棚なのか祭壇なのか、\n化粧台なのかサイドボードなのか、\n柩なのかショーケースなのか。","入口正对面 也就是最里侧的墙边，\n不知是神龛还是祭坛，\n是梳妆台或是餐具柜，\n是棺材亦或是展示柜。"],["とにかく、\n何かを供すべく配されたオブジェがあり。","总之，\n摆放着用于供奉某物的装置。"],["「奥まで入ってくれ。","「请走到最里面。"],["あれが――そうだ。","那个就是――没错。"],["私の父…と、母が見せたかったものだ」","我父亲…和母亲想给你们看的东西」"],["飯窪家に伝わるという家宝――\n今回の件とどう絡むのか、或いは絡まないのかは\n未だ定かではないが、\n三春家の蔵調査の前にこれをみせたかったという。","据传是饭洼家代代相传的传家宝――\n与本次事件是否有关联 或者说\n至今尚未明确，\n但据说在调查三春家仓库前必须先看这个。"],["「えーと、取り敢えず見るだけでいいんですかね？","「呃、总之只要看看就行了吗？"],["おー…","哦…"],["なんですかこれは」","这是什么」"],["年代物のようにはみえるが無國籍な意匠の施されたその台の上、\n四つの支柱が――といっても棒程度のものだが――に囲まれて、\nしかし天蓋はないその中央に。","虽然看似年代久远 但在那个具有无国籍风格设计的台座上，\n四根支柱――其实也就是棍子般的东西――环绕着，\n却没有顶盖的正中央。"],["また同様の奇妙な意匠、印が蓋に捺された筺が、\n紐で封されていた。","同样盖着印有怪异纹样印章的箱子，\n被绳子封存着。"],["色紙よりやや大きいくらいの、所謂桐箱のようにみえるんだが…","比色纸略大的 看起来像是所谓的桐木箱…"],["全く確証は無い。","完全无法确定。"],["古いのかも新しいのかもわからない。","不知是古物还是新品。"],["「これ解いて良いんですか？僕が？」","「这个可以解开吗？由我来？」"],["互い違いに頷く知狡さんとチノ嬢。","知狡阿姨和千乃小姐交替着点头。"],["ところで何で貴女方お二人は入り口横からこっちに\n来ないんでしょう。","话说为什么你们两位不从入口旁边\n过来这边呢。"],["狭いから？ドッキリだから？","因为太窄？还是说这是整蛊环节？"],["まあいいや。","算了不管了。"],["空転脳てある種の低血糖状態だもので、\n指先手元が狂わないようこめかみの辺りに力を入れ集中する。","由于大脑空转导致类似低血糖的状态，\n我在太阳穴附近用力保持专注以免手指打颤。"],["紐自体に関しては、やや湿り気とべたつきを感じた位で、\n扱いに慎重を期す程に劣化した物ではなかった。","绳子本身只是略显潮湿黏腻，\n倒没有老化到需要特别谨慎处理的程度。"],["では、蓋開けますよ。","那么 我要打开盖子了。"],["「………な…","「………这…"],["んでしょうかこれは？","是什么东西？"],["オーパーツ的な何か…ですか？","欧帕兹之类的…吗？"],["視た感じあまり覚えのある…モノでは無いですなあ…」","看起来不太像是…我认识的东西啊…」"],["およそＹの字といっていいであろう、\n芽を出した双葉のような形状、\n子葉の部分が更に二股に分かれ、\n平行した四枚の葉のようになっていて、\nそれぞれが、","大致可称之为Y字形的，\n如同萌芽的双叶般的形状，\n子叶部分又分叉成两股，\n形成四片平行排列的叶片状，\n每一片都，"],["ヒトの眼のようにみえる。","宛如人眼般栩栩如生。"],["色は暗さと照明の色味の所為で、今のところ褐色めいてしか\n視えない。","因光线昏暗与照明色调影响，目前看来只呈现\n褐色调。"],["材質…はなんだろう。","材质…究竟是何物。"],["木か、骨か。","是木头，抑或骨头。"],["よくＵＭＡモノの本やテレビで視る河童の木乃伊とか、\nあんな感じではあるが、\nもっと工業的な意匠を感じるが。","就像UMA题材书籍或电视里常见的河童木乃伊，\n虽给人这般印象，\n却更具工业设计感。"],["だからオーパーツ的な印象を受けたのだけど、\n知狡さんにその単語、意味が通じたかどうかは不明だ。","正因如此才联想到古代遗物，\n但知狡阿姨是否理解这个术语尚不可知。"],["「仮面だよ」","「是面具哦」"],["――仮面。","――面具。"],["四つの眼をした仮面か。","生有四只眼睛的面具么。"],["仮面といっても顔面全覆ではなく、漫画でよくある、\n仮装パーティーの眼だけ隠すあれみたいだけど。","虽称面具却非全脸覆盖，更似漫画中常见的\n化装舞会专用半脸款式。"],["しかし葉に喩えると茎の部分というか、柄の部分が口に半端に被って据わり悪そうだな。","若比作叶片，茎干部分——或者说握柄处半吊子地抵着口腔，佩戴感想必极差。"],["耳紐もないし、まあ実用というよりは祭儀用か何かかな…","既无耳挂，想必非实用品而是祭祀用具吧…"],["にしても何時何処産のモノなんだ。","话说这究竟是何时何地的产物。"],["少なくともこの國の感じでは無い。","至少不似本国造物。"],["例えばその柄の下端部分、あれだ、前に大神が使ってるの視た事あるが、付けペンのペン先みたいな形だし。","譬如握柄末端造型——就像大神以前用过的蘸水笔尖。"],["勿論スケールは違うし、あくまで概容、印象がだが。","当然尺寸迥异，仅是轮廓相似罢了。"],["「…Ｉｇ」","「…Ｉｇ」"],["イグ？","i gu？"],["チノ嬢が呟いた、ように聞こえたが、こちらを見ていないし、\nどうやら独り言だろう。","似是千乃小姐的呓语，但她并未看向这边，\n想必是自言自语。"],["異具？そんな言葉は無いか。","异具？似乎并无此词。"],["独り言以前に単に呻っただけかもな。","或许连自言自语都算不上，仅是呻吟声。"],["うぐぅ。","呜咕。"],["「飯窪が伝えてきたのはこれだ。","「饭洼家传承之物正是此物。"],["…残念ながら正確な名称は長い間に――忘れられて、\nある時点から我々は仮に、","…可惜确切名称早已湮灭――\n某时起我们便暂称其为"],["『いぐしまめ』と呼ぶ」","『异具豆』」"],["「イグシ、…マメ？」","「异具…豆？」"],["「ま、近しい単語があるからといって\nそこに喰い付かないが佳いよ」","「不过就算联想到谐音词\n也最好别深究哦」"],["「そういうことだ。","「仅是如此。"],["便宜上の仮称に過ぎない。","不过是个临时称呼。"],["とにかくこれは――」","总之这是――」"],["「『","「『"],["方","方"],["相","相"],["氏』、知ってるかな？」","氏』，可曾听闻？」"],["一瞬言葉に詰まる知狡さんに、被せ気味で言うチノ嬢。","千乃抢在语塞的知狡前说道。"],["それより、さっきの呟きは『いぐしまめ』の『いぐ』だったか。","方才那声低语，莫非是『异具豆』的『异具』？"],["「え、まあ、知ってますよ名前と概要くらいは。","「呃、至少知晓名称与大概。"],["旅館の部屋名にもあったし…」","旅馆房间也曾以此为名…」"],["極々簡単に言えば、\n節分の豆撒きの元になった、邪を祓い駆逐する者の事、\nとでも言えば良いのか。","简而言之，\n可谓节分撒豆驱邪习俗的起源，\n如此形容最为贴切。"],["追儺、鬼遣い、方相氏。","追傩，驱鬼，方相氏。"],["死体を狙うモノを廃す者。","诛灭觊觎尸骸之物者。"],["宮さんの言っていた、蠱物としての猫の、\n在る側面では、敵対者に位置されるとも言えるのか。","宫小姐所言蛊物之猫的\n某些特质，或许正与之敌对。"],["猫は過去に於いて、死臭に誘われ死骸に近寄る性質の故、\n妖怪的なモノとして見られたらしいと、諸々の本を読む限りでは推測出来るが。","古籍记载，猫因昔时嗜近尸骸的特性，\n多被视作妖异之物。"],["猫魂だの、猫又が死体を踊らせるだの、\n火車が死骸を攫うだの、\nいずれ人類にとって普遍的と言える禁忌、\n『死』や『死骸』にかかずらるその振る舞いが、\n東西問わず太古より猫を魔性のものとして位置づける\n要因となったのか、という気はする。","诸如猫魂作祟、猫妖驱尸、\n火猫掠尸等传说，\n凡此种种触犯人类普遍禁忌——\n与『死亡』及『尸骸』纠缠的行径，\n正是东西方自古将猫视为魔物的\n根源所在吧。"],["瞳孔の変化から来る月との関連、月と言えば女子との関連、\n女子と猫、ある時期に於いては魔女と使い魔という――","瞳孔变化与月亮的关联，说到月亮又和女性相关——\n女性与猫，某个时期还被看作魔女与使魔的关系――"],["またその一方、発生の地の関係か、\n古代の埃では愛玩または鼠駆除の為に飼われていたり、\n有名な猫の女神もおわすわけだが。","不过另一方面，或许因为发源地的关系，\n在古埃及既作为宠物饲养又用来驱鼠，\n还有著名的猫之女神存在呢。"],["まあ、その手の話は単純一筋縄では行かないのが常だけど…","嘛，这类传说通常都不能简单定论就是了…"],["――思考が逸れた。私真言、只今脳空転遺憾なく発揮しております。","――思绪跑偏了。我真言此刻正完美发挥脑内空转的特长。"],["いずれ方相氏は、…まあ猫に限った事ではないんだろうが、\n主に墓を害する魔物に対抗する存在であると、\nそう要約出来る…かな。","总之方相氏…虽说不限于针对猫类，\n主要是对抗侵害坟墓的魔物存在，\n这样概括应该…可以吧？"],["僕ぁ本好きではあるが、あくまで娯楽、嗜好、\n読書によって、読まない人よりは知ってる事も貯えられはするが、\n真面目に勉強しようという意志を以てして、毎回読む訳でもないので、まあざっくりですよ、その辺は。へっへっへ。","我虽然喜欢看书，终究只是娱乐消遣，\n通过阅读确实比不读书的人多积累些知识，\n但并非抱着认真学习的心态每次研读，所以都是囫囵吞枣啦。嘿嘿嘿。"],["勉強に楽しみ見出したり、能動的に学びたいと思うのはもう少し\n年齢いってからだと聞くしな。","听说要等年纪再大些，\n才会主动从学习中找到乐趣呢。"],["うーん、\n死体を害すモノ、屍食鬼、屍鬼…\nそれを矛もて追い祓う…","唔——\n侵害尸体的存在、食尸鬼、尸鬼…\n用长矛驱逐它们…"],["あ、方相氏も四つ目の仮面がどうとかいう描写だな。","啊，方相氏也有四目面具之类的描述呢。"],["そういう事？","是这个意思吗？"],["「そう、そういう事です」","「对，就是这个意思」"],["視線を移しはしたものの口に出しては何も言ってないのに、\n丁度思考の区切れでチノ嬢が、合いの手的に言った。","虽然移开了视线但明明没出声，\n恰在我思考断片时，千乃小姐像唱和般接话。"],["察するなあ…","真是善解人意啊…"],["「あれに極めて性質の、ん？存在の？","「请把它当作和那个性质极其…嗯？存在形式？"],["近しいモノと思ってください。","相似的东西。"],["色んな意味で符号はしてますがね」","从各种意义上都很吻合呢」"],["「とはいえ飯窪では、\n実際にこれを節分に被って追い回したり、\n豆撒きしてきた訳でもない」","「不过饭洼家\n实际上既没在节分时戴着它驱鬼，\n也没用来撒过豆子」"],["「まあ、そんな風習知ってる人間のが今や少ないでしょうし。","「嘛，现在知道这种习俗的人也很少了吧。"],["何を以て正式とするかで更に…て、\n知狡さんには言うまでもないでしょうけど」","以什么标准判定正统性就更…咳，\n对知狡阿姨说这些倒是多余了」"],["「さて。","「好了。"],["ここで説話を少々するよ。","现在要讲个小典故。"],["ん、説話？違う？","咦，说典故？不对？"],["まあどっちでもいいか。","哎呀无所谓啦。"],["人の眼についてかたられる魔力だね」","是关于人类眼睛蕴含的魔力哦」"],["――例によって彼女の解析に時間と労力を要する長広舌が\n始まってしまったが、\n脳空転も甚だしく成りつつある僕にはもう限界でした。","――她例常需要耗费时间精力的长篇大论\n又开始了，\n但对我这个脑内空转严重的人来说已达极限。"],["そちら方面はそれなりに趣味で資料を読み漁ってたので、\nごめんなさい生返事で。","虽然那方面资料我也凭兴趣涉猎过，\n抱歉只能敷衍应答。"],["大体知ってた事にゃったので此処では略しますにゃ。","因为内容大抵都知道这里就省略啦。"],["というかチノ嬢の話、噛み砕いて再構成するのは今厳し過ぎ…","或者说千乃小姐的话，现在要我消化重组实在太困难…"],["またの講釈にて。何だそれは。","下次再讲解吧。这算什么啊。"],["ごほん、とチノ嬢が咳払いした。","千乃小姐假咳了一声。"],["心読まれた上でのツッコミなのか、例の演技咳なのかは分かんないけど。","不知是看穿心思的吐槽还是惯用的表演性咳嗽。"],["そして話し出した。","然后她开口道："],["「飯窪の家にこれが渡って以来、\nこれは飯窪の女当主及び直系の男子のみが接触を許可されているんですが。","「自从这件东西传入饭洼家后，\n按规定只有女性当家和直系男子能接触。"],["実質、男子はご存じの通りほとんど生まれていませんので、\n貴男は何年…ん？","但实际上如您所知几乎没出生过男性，\n您算是多年来…嗯？"],["何十年？何百年？","几十年来？几百年来？"],["まあどれでもいいんですが。","哎呀无所谓啦。"],["久方振りの接触者です。男子としての。","作为男性是久违的接触者。"],["当主であろうと女性はこれの管理保全を任せられているに過ぎず、\n使用権限は男子にあるというシキタリなんですが。","女性当家充其量只是负责保管维护，\n使用权在男性，这便是历来的规矩。"],["試しに被ってみたらどうです？それ以外に用途ありますか？","要不要试戴看看？反正也没其他用途。"],["その眼から何かが視える、かも知れないね。","说不定那双眼睛能看见什么呢。"],["興味あります私達も」","我们也很感兴趣」"],["「え、良いんですか？","「咦、可以吗？"],["とと、唐突ですね…」","突、太突然了…」"],["知狡さんを視ると、","看向知狡阿姨时，"],["「………それが今日の目的だからな」","「………这就是今天的目的」"],["と、何か不機嫌そうに…と言うと語弊があるが、\nとにかく何かしら負の感情のこもった口調で頷いていた。","带着某种不悦的神情…这么说可能不太准确，\n总之是用掺杂负面情绪的语调点了点头。"],["まあ『達』と言うからには飯窪…最低でも目前の二人の\n意志なんだろう、興味あるのは。","既然说是『们』那就是饭洼家…至少眼前这两人的\n意愿吧，我感兴趣的是。"],["「じゃ、じゃあ…」","「那、那…」"],["触れる。","触碰。"],["外気というか部屋の気温は低めなのに、\n…人肌の様な温さで――","虽说外界或者说室温偏低，\n…却带着人体肌肤般的温度――"],["というＢ級的な事は無く、\nだが相変わらず素材がわかんないので幾分気持ち悪い。","倒没有出现那种B级片式的展开，\n但依然因为搞不清材质而有些恶心。"],["乾燥した肉っぽいというか、変な弾力がある気が…","像是风干的肉块，又带着诡异的弹性…"],["被るったって、構造的にどう…と、実際持ち上げて裏面を\n視ると、かつて耳紐通した穴らしきものはある。","虽说要戴上去，但结构上究竟…实际拿起翻看背面，\n能看到曾经穿耳绳的孔洞痕迹。"],["が、だからといって…","可即便如此…"],["「顔にあてて眼の覗き穴から視るだけで結構」","「贴在脸上从眼洞往外看就行」"],["相変わらず察しまくりですなあ、\nしかし言語使用法の怪しさも相変わらずですわよ。","您还是一如既往地洞察力超群呢，\n不过用语诡异这点也丝毫未改哦。"],["脳は今や空転しまくってまして何もかんも言われるが侭です。","现在脑子完全空转只能任人摆布了。"],["四つ目全てに穴が開いているが、顔との比率バランスと\n形状の構造からして下段の一対が眼に当たるのだろう、\n虫眼鏡の如く柄の部分を持ち、\n顔に近づけた。","四个孔洞全开着，但从与脸部比例平衡和\n形状结构来看，下面那对应该是对应眼睛，\n像拿放大镜般握住柄部，\n凑近脸庞。"],["「……わ」","「……wa」"],["「わ？」","「wa？」"],["また何か呟きが聞こえたが、\nこの御方のアクションにいちいちリアクションしてる程\nもう気を回せない。","又听见什么嘀咕声，\n但已没余力对这位大人的每个动作\n都作出反应了。"],["恙無く事態を進行させて、早くちゃんとした飯を喰いに…","平安推进事态，早点吃顿正经饭…"],["…別に宮さんとどうこうという訳じゃないが、\nまあ一応連絡は入れますけどね…","…倒也不是要和宫小姐怎样，\n不过姑且会联系下啦…"],["さて、拙速は巧遅に勝る…ん？逆だっけ？","话说欲速则不达…咦？反了？"],["視覚に意識を集中させる。","将意识集中在视觉上。"],["レンズが有る訳でも無いこの仮面の眼窩越しに、\n何が視えるかって…","透过这副没有镜片的面具眼窝，\n能看见什么呢…"],["「…いっち！」","「…好疼！」"],["一瞬あの、\n冬夏を初めて視た時の眼の奥の痛みが走った。","瞬间感受到那种，\n初次见到冬夏时眼底窜过的剧痛。"],["「………！","「………！"],["――？」","――？」"],["と、背筋が総毛立った。","随即整个脊背寒毛倒竖。"],["視界、","视野、"],["臭い、","气味、"],["聞こえ出す音、","渐闻的声音、"],["が、特定の記憶の取っ手を刺激する、","刺激着特定记忆的开关，"],["つまり当時の状況との関連付けがある故に起きる、","即因与当时情境产生关联而引发的、"],["五感による記憶の想起、記憶？何の？","五感唤起的记忆回溯，记忆？什么的？"],["記憶を喚起するものが、ちくちくと空転している脳を刺す、","记忆的引信刺痛着空转的大脑，"],["知っている筈の事を思い出せないときのもどかしい感触、","那种明知却想不起来的焦躁感，"],["知っている、知っているんだ、知っているのに、","知道的，明明知道的，明明知道，"],["なんだこれは、いや、","什么啊这是，不对，"],["そんなことは今かんがえることじゃない、","现在不该想这些，"],["そして、ああああ。","然后，啊啊啊。"],["目の前が真っ赤になり、","眼前变得血红，"],["音が遠のいていく――","声音逐渐远去――"],["身体が熱く燃えるように、","身体如灼烧般滚烫，"],["意識が肉体に充満し圧迫されてルカノヨウダハレツスル","意识充斥肉体压迫得仿佛要破裂"],["再び遠くより音がさんざめくざわわわわわ","遥远的声音再度喧嚣哗哗哗哗"],["ヒキズリダサレテコノママアカキホノオノナカニヤカレ","被拖拽着沉入这片赤红火焰中燃烧"],["ざざざああざざざざおあおあああ","沙沙沙啊啊沙沙沙啊嗷嗷嗷"],["ナニカガヤケキレルオアアアオワアアアアアオギヤアア","有什么在燃烧啊啊啊呜哇啊啊啊啊啊哦呀啊"],["ごろろろろろろろろざざざざざざざざ","咕隆隆隆隆沙沙沙沙沙沙"],["ナキゴエガキコエルキョウチョウヲツゲルオトダロウカ","听见哭声是加剧紧张的声响吗"],["ととつぜんめがさめるようなかんかくとともにぼくは","伴随着突然清醒般的感官我"],["気付くと座り込んでいた。","回过神来已瘫坐在地。"],["立ちくらみというよりは、","与其说是晕眩，"],["金縛りにあったときに近く、","倒更像是遭遇了鬼压床，"],["全身が冷や汗でびっしょりと濡れていた。","全身被冷汗浸得湿透。"],["突然の覚醒、変性意識からの帰還、この感覚、","突然的清醒、从错乱的意识中回归、这种感觉，"],["あ。","啊。"],["あ？","啊？"],["なんだ？","怎么了？"],["肩口に気配がするが振り向いてもなにもない――","肩头似有动静但回头却空无一物――"],["当たり前だ。","理所当然。"],["いつもの脳空転…に近いが違う…","和往常的脑内空转…相似却不同…"],["金縛りに近い、おかしな声や騒音が耳の奥から鳴っていたような\nねこ？くろ？","像是处于近似鬼压床的状态中，耳朵深处似乎传来诡异的声响和噪音\n猫？黑？"],["いつ？わ？","什么时候？我？"],["「だいじょうぶですか？","「没事吧？"],["しっかり気を持って。","打起精神来。"],["見えますかこれ？","看得见这个吗？"],["指何本に？」","这是几根手指？」"],["「肩の力を抜け、真言。","「肩膀放松，真言。"],["どうした？」","怎么了？」"],["「…視界がじんわり赤くなって……","「…视野渐渐泛红……"],["神経が焼き切れたかと思うくらい身体が…","身体像神经被烧断般…"],["熱くなった…死ぬんじゃないかと……","发烫…还以为要死了……"],["焦った……驚いた………」","慌了……吓到了………」"],["二人は顔を見合わせて、それから僕を覗き込んだ。","两人对视一眼，然后盯着我瞧。"],["ああ、ほんとに吃驚した、今のは何。","啊、真是吓一跳，刚才那是什么。"],["「なんだったんだか…","「搞不清状况…"],["ああ、済みません、\nまさかこれの所為じゃないですよねえ…」","啊啊、对不起，\n该不会是这个的缘故吧…」"],["緊張からか、空腹からか、\nまさか即効性の変な病原菌付着してたとか、\nはたまた、","不知是紧张还是空腹，\n总不会是沾上了什么速效的古怪病菌，\n又或者是，"],["「呪いだと？」","「诅咒吗？」"],["「え」","「诶」"],["「ヒトは概してヒトガタのモノには妖しき気を見出すものなので。","「人类总会对人形之物产生妖异之感。"],["恥ずかしがることはありません」","不必觉得羞耻」"],["そのような推測を抱いてもね、と続けるチノ嬢の足下、","就算抱有这种推测也…，千乃小姐说着时，"],["視界を何かが動いた。","视野里有什么东西掠过。"],["「ねこが」","「猫」"],["「？」","「？」"],["「あ、いえ、なにかがいまそこを…","「啊、不、好像有什么刚刚在那里…"],["動いた気がしたので…","动了一下…"],["でもなんで猫だと思ったんだろうな、\n思わずに口に出たんですけど。","但为什么会觉得是猫呢，\n不自觉就说出口了。"],["鼠か何か…かも知れません…","或许是老鼠什么的…"],["猫なんて、こんな、ところにいるわけが…","猫怎么可能、在这种、地方…"],["ははは…","哈哈哈…"],["腹減ってるんですか…ね…","是饿昏头了吧…呢…"],["自分でも何言ってるのか……が」","连自己都不知道在胡说什么……了」"],["眠気とも目眩ともつかない、\n混沌が僕の思考を、包み出し、\n空転する脳髄、\nまともにものを考えるのが――","分不清是困倦还是眩晕，\n混沌将我的思考、逐渐包裹，\n空转的脑髓，\n根本无法正常思考――"],["視界が揺らぎ斜めに、そして水平に、","视野倾斜摇晃着、继而水平翻转，"],["衝撃が","冲击"],["「真言！」","「真言！」"],["「おおう」","「噢」"],["「すまない。","「抱歉。"],["真言、すまない」","真言，对不起」"],["知狡さんが僕を抱き留めている","知狡阿姨正紧紧抱着我"],["「宮店長に伝えてくるよ」","「我去通知宫店长」"],["「ああ頼む、大丈夫か真言、","「啊拜托了，没事吧真言，"],["今背負ってやる…っく」","现在背你…呃」"],["「ああ…ああ…ごめんなさい……","「啊…啊…对不起……"],["すみません…だ、だいじょう…ぶと言いたいところ…","抱歉…虽、虽然想说没…问题…"],["なんですが…」","但实在…」"],["「解ってる、喋らなくていい、\n目的は達したから心配は要らない、\n宮さんとゆっくり休んでくれ」","「我明白的，不用说话、\n目的已经达成所以不必担心、\n和宫小姐好好休息吧」"],["目的は達した？","目的达成了？"],["あ、いやいや宮さんと逢うことにそんなに執着してないってば…","啊、不不不都说了我没那么执着要见宫小姐啦…"],["「はは…まだ…そんなへんなことを…」","「哈哈…还在…说这种怪话…」"],["そのあたりでもう限界が訪れた。","到这时已经抵达极限了。"],["僕の少なくとも肉体的なスイッチが切れ、\n夢も現も判然としなくなり、\n眼は開けられない。\n瞼の裏の光の像のみが蠢き揺らぐのが視え…","最终我肉体上的开关被切断、\n梦境与现实变得无法区分、\n眼睛也无法睁开。\n只能看见眼皮内侧的光影蠕动摇晃…"],["車に乗せられているのが判る、\n過去に救急車に乗った時のような感覚が甦る…","能感觉到被抬上车、\n过去乘坐救护车时的感觉复苏了…"],["その時、精神のスイッチも切れゆく中で、","那时，在精神开关也逐渐关闭的过程中、"],["聴覚が捉えた最後の声が――","听觉捕捉到的最后声音是――"],["「予定通りの旗は立てられたねチズル。","「按计划立好旗帜了呢小知。"],["次の舞台へ昇段移行の過程が動く。","向下一舞台晋级过渡的进程开始运转。"],["よく分からないなこの國の言葉。","这个国家的语言真是难以理解。"],["何を彼は視るかなミハルの蔵で」","他在米哈尔的仓库里会看见什么呢」"],["「…願わくば、","「…但愿、"],["――私もあれの顕現に賭けたい」","――我也想赌在那东西的显现上」"],["それがお前の、ほんとうの――","那才是你的，真正的――"],["「全てはカリ、全てはゲェム。","「一切皆戏，一切皆局。"],["劇の幕は既に開き、","剧幕早已拉开、"],["語られる事は騙られる事さ。","被讲述之事即是被欺骗之事。"],["好嫌で位相は移相して、\nそれを決定するのはあの方か、\n雫の波紋のみ。","好恶使位相迁移、\n决定权在那位手中、\n或是雫之波纹。"],["じゃ、入ろうか次の準備に。","那么，开始准备下一幕吧。"],["●の●の………らん…とを」","●之●的………祝…临」"],["もう、聞こえない。","已经，听不见了。"]],"context":[["SC_M_011.ks/index/1/text","SC_M_011.ks/index/3/text","SC_M_011.ks/index/5/text","SC_M_011.ks/index/7/text"],["SC_M_011.ks/index/9/text"],["SC_M_011.ks/index/11/text"],["SC_M_011.ks/index/13/text"],["SC_M_011.ks/index/15/text"],["SC_M_011.ks/index/17/text"],["SC_M_011.ks/index/19/text"],["SC_M_011.ks/index/21/text"],["SC_M_011.ks/index/23/text"],["SC_M_011.ks/index/25/text"],["SC_M_011.ks/index/27/text"],["SC_M_011.ks/index/29/text"],["SC_M_011.ks/index/31/text"],["SC_M_011.ks/index/33/text"],["SC_M_011.ks/index/35/text"],["SC_M_011.ks/index/37/text"],["SC_M_011.ks/index/39/text"],["SC_M_011.ks/index/41/text"],["SC_M_011.ks/index/43/text"],["SC_M_011.ks/index/45/text"],["SC_M_011.ks/index/47/text"],["SC_M_011.ks/index/49/text"],["SC_M_011.ks/index/51/text"],["SC_M_011.ks/index/53/text"],["SC_M_011.ks/index/55/text"],["SC_M_011.ks/index/57/text"],["SC_M_011.ks/index/59/text"],["SC_M_011.ks/index/61/text"],["SC_M_011.ks/index/63/text"],["SC_M_011.ks/index/65/text"],["SC_M_011.ks/index/67/text"],["SC_M_011.ks/index/69/text"],["SC_M_011.ks/index/71/text"],["SC_M_011.ks/index/73/text"],["SC_M_011.ks/index/75/text"],["SC_M_011.ks/index/77/text"],["SC_M_011.ks/index/79/text"],["SC_M_011.ks/index/81/text"],["SC_M_011.ks/index/83/text"],["SC_M_011.ks/index/85/text"],["SC_M_011.ks/index/87/text"],["SC_M_011.ks/index/89/text"],["SC_M_011.ks/index/91/text"],["SC_M_011.ks/index/93/text"],["SC_M_011.ks/index/95/text","SC_M_011.ks/index/99/text"],["SC_M_011.ks/index/97/text"],["SC_M_011.ks/index/101/text"],["SC_M_011.ks/index/103/text"],["SC_M_011.ks/index/105/text"],["SC_M_011.ks/index/107/text"],["SC_M_011.ks/index/109/text"],["SC_M_011.ks/index/111/text"],["SC_M_011.ks/index/113/text"],["SC_M_011.ks/index/115/text"],["SC_M_011.ks/index/117/text"],["SC_M_011.ks/index/119/text"],["SC_M_011.ks/index/121/text"],["SC_M_011.ks/index/123/text"],["SC_M_011.ks/index/125/text"],["SC_M_011.ks/index/127/text"],["SC_M_011.ks/index/129/text"],["SC_M_011.ks/index/131/text"],["SC_M_011.ks/index/133/text"],["SC_M_011.ks/index/135/text"],["SC_M_011.ks/index/137/text"],["SC_M_011.ks/index/139/text"],["SC_M_011.ks/index/141/text"],["SC_M_011.ks/index/143/text"],["SC_M_011.ks/index/145/text"],["SC_M_011.ks/index/147/text"],["SC_M_011.ks/index/149/text"],["SC_M_011.ks/index/151/text"],["SC_M_011.ks/index/153/text"],["SC_M_011.ks/index/155/text"],["SC_M_011.ks/index/157/text"],["SC_M_011.ks/index/159/text"],["SC_M_011.ks/index/161/text"],["SC_M_011.ks/index/163/text"],["SC_M_011.ks/index/165/text"],["SC_M_011.ks/index/167/text"],["SC_M_011.ks/index/169/text"],["SC_M_011.ks/index/171/tex