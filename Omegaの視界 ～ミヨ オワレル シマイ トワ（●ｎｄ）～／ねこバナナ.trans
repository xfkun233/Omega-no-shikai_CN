C_M_043.ks/index/236/text"],["SC_M_043.ks/index/238/text"],["SC_M_043.ks/index/240/text"],["SC_M_043.ks/index/242/text"],["SC_M_043.ks/index/244/text"],["SC_M_043.ks/index/247/text"],["SC_M_043.ks/index/249/text"],["SC_M_043.ks/index/251/text"],["SC_M_043.ks/index/254/text"],["SC_M_043.ks/index/256/text"],["SC_M_043.ks/index/258/text"],["SC_M_043.ks/index/260/text"],["SC_M_043.ks/index/262/text"],["SC_M_043.ks/index/264/text"],["SC_M_043.ks/index/266/text"],["SC_M_043.ks/index/268/text"],["SC_M_043.ks/index/270/text"],["SC_M_043.ks/index/272/text"],["SC_M_043.ks/index/274/text"],["SC_M_043.ks/index/276/text"],["SC_M_043.ks/index/278/text"],["SC_M_043.ks/index/280/text"],["SC_M_043.ks/index/282/text"],["SC_M_043.ks/index/284/text"],["SC_M_043.ks/index/286/text"],["SC_M_043.ks/index/288/text"],["SC_M_043.ks/index/290/text"],["SC_M_043.ks/index/292/text"],["SC_M_043.ks/index/294/text"],["SC_M_043.ks/index/296/text"],["SC_M_043.ks/index/298/text"],["SC_M_043.ks/index/300/text"],["SC_M_043.ks/index/302/text"],["SC_M_043.ks/index/304/text"],["SC_M_043.ks/index/306/text"],["SC_M_043.ks/index/308/text"],["SC_M_043.ks/index/310/text"],["SC_M_043.ks/index/312/text"],["SC_M_043.ks/index/314/text"],["SC_M_043.ks/index/316/text"],["SC_M_043.ks/index/318/text"],["SC_M_043.ks/index/320/text"],["SC_M_043.ks/index/322/text"],["SC_M_043.ks/index/324/text"],["SC_M_043.ks/index/326/text"],["SC_M_043.ks/index/328/text"],["SC_M_043.ks/index/330/text"],["SC_M_043.ks/index/332/text"],["SC_M_043.ks/index/334/text"],["SC_M_043.ks/index/336/text"],["SC_M_043.ks/index/338/text"],["SC_M_043.ks/index/340/text"],["SC_M_043.ks/index/342/text"],["SC_M_043.ks/index/344/text"],["SC_M_043.ks/index/346/text"],["SC_M_043.ks/index/348/text"],["SC_M_043.ks/index/350/text"],["SC_M_043.ks/index/352/text"],["SC_M_043.ks/index/354/text"],["SC_M_043.ks/index/356/text"],["SC_M_043.ks/index/358/text"],["SC_M_043.ks/index/360/text"],["SC_M_043.ks/index/362/text"]],"tags":[],"parameters":[[{"start":154,"end":164}],[{"start":196,"end":209}],[{"start":241,"end":284}],[{"start":316,"end":363}],[{"start":395,"end":428}],[{"start":454,"end":456}],[{"start":464,"end":467}],[{"start":522,"end":566}],[{"start":592,"end":595}],[{"start":627,"end":641}],[{"start":672,"end":740}],[{"start":748,"end":772}],[{"start":798,"end":800}],[{"start":808,"end":811}],[{"start":819,"end":859}],[{"start":891,"end":954}],[{"start":985,"end":1052}],[{"start":1084,"end":1184}],[{"start":1215,"end":1271}],[{"start":1303,"end":1328}],[{"start":1354,"end":1455}],[{"start":1486,"end":1518}],[{"start":1526,"end":1571}],[{"start":1603,"end":1684}],[{"start":1715,"end":1808}],[{"start":1816,"end":1846}],[{"start":1856,"end":1857}],[{"start":1866,"end":1875}],[{"start":1907,"end":1919}],[{"start":1945,"end":1949}],[{"start":1980,"end":1985}],[{"start":2017,"end":2044}],[{"start":2052,"end":2105}],[{"start":2113,"end":2148}],[{"start":2179,"end":2184},{"start":2216,"end":2221},{"start":2252,"end":2257}],[{"start":2289,"end":2309}],[{"start":2340,"end":2360}],[{"start":2392,"end":2410}],[{"start":2441,"end":2462}],[{"start":2470,"end":2524}],[{"start":2556,"end":2605}],[{"start":2636,"end":2663}],[{"start":2695,"end":2741}],[{"start":2772,"end":2796}],[{"start":2804,"end":2871}],[{"start":2903,"end":2919}],[{"start":2950,"end":2965}],[{"start":2997,"end":3023}],[{"start":3031,"end":3075}],[{"start":3085,"end":3086}],[{"start":3096,"end":3119}],[{"start":3150,"end":3182}],[{"start":3190,"end":3264}],[{"start":3272,"end":3315}],[{"start":3347,"end":3355}],[{"start":3381,"end":3385}],[{"start":3416,"end":3432}],[{"start":3464,"end":3504}],[{"start":3530,"end":3562}],[{"start":3593,"end":3614}],[{"start":3622,"end":3692}],[{"start":3724,"end":3779}],[{"start":3805,"end":3809}],[{"start":3817,"end":3841}],[{"start":3872,"end":3879}],[{"start":3911,"end":3917}],[{"start":3948,"end":3959}],[{"start":3991,"end":3999}],[{"start":4025,"end":4041}],[{"start":4049,"end":4053}],[{"start":4061,"end":4088}],[{"start":4096,"end":4126}],[{"start":4141,"end":4164}],[{"start":4195,"end":4244}],[{"start":4252,"end":4340}],[{"start":4348,"end":4356}],[{"start":4382,"end":4428}],[{"start":4436,"end":4464}],[{"start":4472,"end":4526}],[{"start":4558,"end":4597}],[{"start":4628,"end":4696}],[{"start":4722,"end":4772}],[{"start":4780,"end":4794}],[{"start":4851,"end":4885}],[{"start":4911,"end":4961}],[{"start":4969,"end":5020}],[{"start":5052,"end":5095}],[{"start":5121,"end":5177}],[{"start":5209,"end":5229}],[{"start":5255,"end":5257}],[{"start":5265,"end":5269}],[{"start":5277,"end":5280}],[{"start":5312,"end":5342}],[{"start":5368,"end":5385}],[{"start":5393,"end":5471}],[{"start":5479,"end":5561}],[{"start":5569,"end":5595}],[{"start":5603,"end":5621}],[{"start":5629,"end":5632}],[{"start":5640,"end":5653}],[{"start":5663,"end":5664}],[{"start":5675,"end":5678}],[{"start":5688,"end":5703}],[{"start":5711,"end":5718}],[{"start":5750,"end":5761}],[{"start":5787,"end":5817}],[{"start":5849,"end":5861}],[{"start":5887,"end":5893}],[{"start":5923,"end":5964}],[{"start":6079,"end":6148}],[{"start":6180,"end":6241}],[{"start":6304,"end":6335}],[{"start":6372,"end":6379}],[{"start":6416,"end":6439}],[{"start":6471,"end":6487}],[{"start":6513,"end":6588}],[{"start":6596,"end":6615}],[{"start":6647,"end":6704}],[{"start":6767,"end":6774}],[{"start":6811,"end":6831}],[{"start":6863,"end":6903}],[{"start":6966,"end":6977}],[{"start":7014,"end":7073}],[{"start":7112,"end":7150}],[{"start":7182,"end":7218}],[{"start":7244,"end":7334}],[{"start":7397,"end":7426}],[{"start":7452,"end":7493}],[{"start":7523,"end":7607}],[{"start":7615,"end":7694}],[{"start":7702,"end":7795}],[{"start":7805,"end":7812}],[{"start":7820,"end":7876}],[{"start":7884,"end":7962}],[{"start":7970,"end":8036}],[{"start":8062,"end":8149}],[{"start":8181,"end":8228}],[{"start":8254,"end":8293}],[{"start":8323,"end":8376}],[{"start":8402,"end":8425}],[{"start":8455,"end":8491}],[{"start":8517,"end":8528}],[{"start":8536,"end":8553}],[{"start":8561,"end":8575}],[{"start":8583,"end":8599}],[{"start":8629,"end":8635}],[{"start":8667,"end":8675}],[{"start":8756,"end":8783}],[{"start":8815,"end":8824}],[{"start":8854,"end":8892}],[{"start":8918,"end":8940}],[{"start":8972,"end":9000}],[{"start":9026,"end":9053}],[{"start":9085,"end":9158}],[{"start":9184,"end":9207}],[{"start":9237,"end":9265}],[{"start":9275,"end":9285}],[{"start":9317,"end":9324}],[{"start":9350,"end":9372}],[{"start":9380,"end":9408}],[{"start":9416,"end":9436}],[{"start":9474,"end":9490}],[{"start":9500,"end":9550}],[{"start":9558,"end":9606}],[{"start":9614,"end":9661}],[{"start":9712,"end":9782}],[{"start":9812,"end":9843}],[{"start":9851,"end":9884}],[{"start":9916,"end":9975}],[{"start":10005,"end":10045}],[{"start":10077,"end":10105}],[{"start":10131,"end":10135}],[{"start":10143,"end":10182}],[{"start":10190,"end":10212}],[{"start":10220,"end":10236}],[{"start":10244,"end":10260}],[{"start":10268,"end":10282}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_043.ks","basename":"SC_M_043.ks","indexIds":{"「あーいもしもし？」":0,"「あ、もしもし、僕ですが」":1,"「んむっ、まこくん？[l]\nやっとおきたですか？[l]\nだいじょぶ？」":2,"「御陰様で何とか大丈夫そうです。[l]\nあの、どうしましょうそっち向かいましょうか？」":3,"「んむ、ちょっと待ってください。[l]\n本人にかわります」":4,"は？":5,"本人？":6,"「はーいまこくんおひさし！[l]\nだいじょぶ？[l]\nもう動けますか？」":7,"あれ？":8,"「え？[l]\nは？」":9,"「うひひ、\n混乱してます混乱してます。[l]\nさすがはチノの声帯模写ですなあ。[l]\n電話越しとは言え完全に……":10,"まこくん？[l]\n状況把握してるかな？」":11,"あ、":12,"ああ。":13,"最初のはチノ嬢の声真似ですか。[l]\nそういや達者だったねあのひとは……":14,"「やっと分かりましたよ。[l]\n何してるんですか病み上がりの人間に対して。[l]\nチノさんまで巻き込んで……」":15,"「んむー、\n大丈夫だって信じてるって書いたでしょお？[l]\nこれくらいのかぁいい悪戯には耐えられる体力あるでしょお？」":16,"「……まあ、貴女には馴らされましたからね。[l]\nいいですよもう。[l]\n取り敢えずすぐ連絡寄越せって書いてあったので連絡したんですが。[l]\nバナナと茶漬けは食べましたけど」":17,"「ふぅん。[l]\nそっちの件は冬夏さんじゃなかったかな？[l]\n向こうさんには連絡したですか？」":18,"「え？[l]\nこの後するつもりですが……」":19,"そういえば『すぐに連絡寄越せ』って書いてあったのは、\n冬夏の書き置きの方だっけ。[l]\nいやその、起きた後の事は冬夏の紙参照ってあったし、\nてっきり両者の意思が通じてるのかと……":20,"「なるほど。[l]\nあ、あと知狡にも御礼言ってください。":21,"で、メールは？[l]\n今回はちゃんと視たですか？[l]\n何しろ今回はぁ、」":22,"「……ええ。[l]\nつーかだからあなたに先に電話したってのもありますがね。[l]\n冬夏にまであんな事さして、\n怒られなかったですかほんと」":23,"「んむっ。[l]\n冬夏さんは寧ろノリノリでやってくれましたよ？[l]\nまこくんの為なら、ってそれぁもう、\n文字通り一肌脱いでくれちゃったりなんかしちゃったりして！":24,"愛されてますなぁーまこくん。[l]\n宮なんか入り込む":25,"隙":26,"間も無いくらい、」":27,"「いやーそんなことぁ、」":28,"……ん？":29,"「んむ？」":30,"「は？あれ？[l]\nいや、\n違います。":31,"冬夏にそんなまで愛されてるかどうかについての疑問符、\nなのであって、\n別にその、あなた──":32,"や、いいんですよそんな話は。[l]\nとっとと本題入りましょう」":33,"「………」":34,"「……あれ？[l]\nもしもし？」":35,"「まこくん、\n最近溜まってる？」":36,"「あぁ、繋がってたっ……って、え？」":37,"「なぁんか、\n様子がヘンですなぁ。":38,"ご褒美ほしがってます？[l]\nさっきそのメールしたじゃんー。[l]\n……足りない？のかな？」":39,"「……いったいなんのおはなしでしょうカ。[l]\nそっちこそ何か最近、調子が狂うというか、」":40,"「（…かし…な。[l]\n…イの抑えが……？）」":41,"「すみません、聞こえないんですがー。[l]\nあれそれとも電話自体の調子が悪いのかな」":42,"「んむ？[l]\nいあ、だいじょぶですよ。":43,"えっと、あ、ごめんです、\nじゃあ……もうこんな時間なので、[l]\n晩御飯食べてお風呂──お風呂おっけーかなまこくん？」":44,"「は？[l]\n風呂？！」":45,"「……体調的にって事ですけど」":46,"「あっ！？[l]\nああ、ああはい大丈夫です。":47,"寧ろ１日入ってない分、今にも入りたくてしょうがないくらいで、\nすみませんちょっと":48,"吃":49,"驚してしまいまして、\nえらい勘違いを」":50,"「ふむ。[l]\nではお風呂上がったら部屋に来てください。":51,"冬夏さんは連れて来ないように。[l]\n晩御飯の時点でちゃんとお相手して満足させといてくださいよ。[l]\n大分心配してたようですから。":52,"うひひ、宮にはどうぞお構いなく。[l]\n遠慮せずに宜しくやっちゃってください」":53,"「え、あ、あの」":54,"なんだ。":55,"「んむ？[l]\nなに？」":56,"「晩御飯はご、……ご一緒に…ですか？[l]\n僕等２人、という意味ですが」":57,"なんなんだ。[l]\n僕は。[l]\n何を訊いてる。":58,"「え？[l]\nそれは構いませんよ？":59,"今からそっち行きますから、\nそれまでに冬夏さんに連絡してあげといてください。[l]\n勿論ご飯中だけなら、彼女の同席も可です」":60,"「わっ──かりましたー。[l]\nじゃこれ切ったら電話しときます。[l]\n部屋で待ってますんで」":61,"何でだ。":62,"何だこの焦燥感は。[l]\n何でこんなに、":63,"「まこくん、」":64,"「は、はい」":65,"「今晩一緒に寝とく？」":66,"「…………は？」":67,"一瞬何のことか分からなかったが、":68,"………。":69,"いやいや、\n数秒経っても何のことか分からない。":70,"ただ、\n何だか神妙な雰囲気であったのは確かなので、\n":71,"揶いやなんやでないのだろうとは思う、けれど……":72,"「何か心配になってきた。[l]\n冬夏さんに任せるには──ちょっと事情が込み入ってますしね。":73,"彼女にはいずれ色々遊んで貰うとしても……[l]\nチノも一緒に作業してますけどそれでも良ければ、ですけど。[l]\nまあ寝るのに邪魔ならないようにしますけどね勿論。":74,"ね、どうする？」":75,"あ、ああ。[l]\n僕の最近の不調に対して、\n純粋に心配してくれていたようだ。":76,"保護者視点ね。[l]\nチノ嬢も同席というのは……":77,"いやいや、その方が間違いが無いと言うか、\n安全弁？[l]\n当然よね。[l]\n当然……":78,"「あの……まあ断る理由は無い……ですよ？[l]\n今のところこちらにも」":79,"「んむ。[l]\nわかった。[l]\nじゃ今日は仕事の話をしたらそのまま宮の部屋にお泊まりです。[l]\nでは後程～」":80,"ヘンなことしたら殺すわよ的な或いは、\nいつでもどうぞ的な茶化しがないのが若干気になるけども、":81,"ともあれ会話は打ち切られた。":82,"「やっぱり何かこう……[l]\nあ、冬夏の事を聞いたのかいな」":83,"や、それであんな変節するような宮さんじゃないと思う。[l]\n寧ろもっと押せ押せで弄ってくる。":84,"無意識にでも、\n僕の方が変節したのだろうか。[l]\nそれこそ冬夏への意識が何かしら……":85,"「……何にしても話しないと分からん。[l]\n想像は何処まで行っても想像だし、」":86,"いや、だから何でそんなに気にするんだ、\nあのひとの事を。[l]\n冬夏の事を考えるならまだしも──":87,"「は…く……たいのに……べて…さ……う」":88,"ん？":89,"はやく？":90,"はっ。":91,"「そうだ、早く飯──否、\nその前に何かするべき事が」":92,"ああ、どんどん混乱していく～～～。":93,"一体、僕は何に煩悶してるんだろう。[l]\nこうなると、\n大神とかれお嬢のあっさりいった感は何だったんだろうな、\nと思わざるを得ない。":94,"勿論、こういう事情に限らずとも人それぞれだし、\n普遍的なマニュアルなんかありはしないんだが、\nなんだか大神が、\n酷く羨ましくなってしまった。":95,"あの２人はこう、なるべくしてなった、と言った感じで、":96,"冬夏のが『ど』ストレートなだけに──":97,"待て、":98,"これじゃあ、\n僕が":99,"恋":100,"煩いに":101,"罹った前提の思考じゃないかよ。":102,"そんなことぁ、":103,"「あ、冬夏にも連絡だ」":104,"やばい、\n妄想暴走で無為に時を過ごすところであった。":105,"「えーと、三春三春……」":106,"ここここん。":107,"「……入りまーす。[l]\nどんな感じかなーと……[l]\nあ！！！」":108,"はれ？[l]\n宮さんが先に着いちゃった、と思いきや、\nえ、えらいタイミングでまたこれ……[l]\n悪くはないけど……":109,"「おあっびっくらしたよ……[l]\nお、おはようございます……[l]\nこの度は色々とご迷惑をおかけして……」":110,"「わわわわわわーーーおおおおお、\n驚いた！！！[l]\n":111,"ごっ！[l]\n":112,"ごめんなさいまだ寝てると思ってあぁあわわわわ」":113,"「やややそんなにびびらなくても」":114,"狩屋と言い、\n血縁関係無いにしては何か通じるものがあるなあ……[l]\nギョっとすると、リアクションなんて皆同じなのかも知れないけど……":115,"あ、ひょっとしてあの画像に関してかぇ。":116,"「ええーと、今丁度そっちに連絡しようとしてたんだ。[l]\n御陰様でこの通り、\n何とか復調したから」":117,"「え？[l]\n":118,"あ、いえこちらこそ何にも出来なくて……」":119,"「ほんとにありがとう、\nなんかその宮さんが何か無茶振りしたみたいで──」":120,"「おぇぁっ！？[l]\n":121,"いえ、その、私なんかで良ければいつだっていくらでも、\nだ、だだだだめ！！[l]\n感想は聞かないから！！":122,"言わないで！！[l]\nお願い！！！[l]\n後生だから！！！」":123,"「は、はあ……[l]\nじゃ、じゃあ、うん、言わずにおきます……」":124,"別に悪い事言うつもりもなかったけれど、\n気持ちは良く分かる。[l]\nでも年頃の娘さんが『後生だから！！』って言う？[l]\nうーむ、流石は冬夏さんですなあ……":125,"「良かったよそれにしても。[l]\n良かったぁ……」":126,"と言うと入り口付近に突っ立ってたままだった冬夏は、\nこちらに近寄ってきて、":127,"「私何か待つのってすごい苦手だから……[l]\nこのまま誕生日過ぎても寝てたらどうしようとか、\nあはは、\nエゴ丸出しの事ばっか頭に浮かぶんだよね。":128,"理性じゃ、なんて不謹慎！って思うんだけど、[l]\n感情は全然そんな事情お構いなしにさ、\n苦しいの、\nそんな自分自身を視せつけられてさ、":129,"こんな私が貴方を好きだとか、\n痛々しくてちゃんちゃらおかしくなったり、\n自分がほんっと厭になって、そういった感情の振り幅って、\n他人とね、話さないと、自分ループに":130,"嵌っちゃって、":131,"良くないよね、\nだからね、\nああもうね、\nいっぱい喋りたくってしょうがなかった！！！！！":132,"真言さんといっぱいね、いーーーっぱい話したかったよぉ。[l]\nああもう、ほんとごめんね？[l]\n私こんなで。[l]\nほんとごめん……":133,"ああもうわかんない何言ってるか。[l]\nとにかくね、\n良かった！！[l]\n今はね、とにかく、すっごい嬉しい」":134,"前の時もそうだったけども、\n言葉……というか、[l]\n彼女の感情の奔流に圧倒されるばかりで、\n僕もどう反応（リアクション）して良いのか判らないままに、":135,"「う、うん。[l]\nそれはその、そう思って頂けると僕も、\n嬉しく思います……」":136,"と言うだけだった。[l]\nするとやっぱり少々残念そうな顔をされまして、":137,"「……いいですそんな反応でも。[l]\n無いよりましだっ。[l]\nああもう、\n──」":138,"冬夏は何かを呑み込むかのようにぐっと眼を瞑り、":139,"「良かったよぅ……[l]\nほんとに、\n良かったよぅ……」":140,"と、小さく繰り返した。":141,"ぼくはなにかすごくわるいきがして、":142,"戯れ、という訳でも無いけど、":143,"無意識に、何となしに頭を撫でた。":144,"「……！？」":145,"「……よしよし」":146,"「えっ。[l]\nやっ。[l]\nえっ？」":147,"「や、なんとなく」":148,"「ごごごごめんなさいこんなとき、\nどういうりあくそんをしたらいいか」":149,"先刻の僕の立場と同じような感想を述べる冬夏。":150,"「……いや、ごめん、[l]\n戯れが過ぎたようで」":151,"押しの強いひとは押されると弱いという例がまたここに……":152,"「いっつもそっちからばっかだから、\nこっちからやるとどうなるのか、\n少しばかり気になって……[l]\nごめん、気にしないで」":153,"ほんとに、自分でもよく解らない行動だと思う……":154,"「気にするなって言われてもぉさぁあ、\nそれは……":155,"酷ってものだよ……」":156,"「うーん──」":157,"そうか……[l]\nそういうことか……":158,"発する側にその気が無くとも、\n受ける側次第で──":159,"此方がどんなに入れ込んでも、彼方側は──":160,"「ん、ごめん、\nちょっと":161,"昂ぶっちゃってた。[l]\nそだね。[l]\nいっつも私が真言さんにしてるような事よね。":162,"ん。[l]\n………。[l]\nまままままままま、ご！[l]\nそう、ご飯！！":163,"ご飯どうするの？[l]\n晩御飯だいじょうぶ？！[l]\n食べれる？食べられる？」":164,"「ごめん、こっちも病み上がりで、\n頭が未だ……[l]\nそれよりええとご飯？[l]\nあの、宮さんと一緒で良ければ──」":165,"「え？[l]\n……あぁーあ、[l]\nん、行く。":166,"今から？[l]\n部屋の片付けとか一応しに来たんだけど──」":167,"「あ、そうか、ありがとう。[l]\n多分大丈夫じゃないかな……[l]\n今行くときに宿の人に言っておくよ」":168,"「ん。[l]\nじゃ準備して来るー。[l]\nまた此処来ればいい？」":169,"「うん、\n宮さんとも此処で待ち合わせだから……」":170,"僕等は、":171,"悪意が無くても、知らないうちに、\n互いに残酷なことをしている、んだな。":172,"そんな単純なことに、\n今更気付いた。":173,"じゃあどうすれば、という問いに、":174,"答えがあるとは到底思えなかった。":175,"僕等はきっとおなじものを──":176},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_043.ks","relPath":"/data/scenario/SC_M_043.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":174,"length":177,"percent":98.30508474576271},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[165,1]},"/data/scenario/SC_M_044.ks":{"data":[["夕御飯は、\n病み上がりの僕に配慮したのかややあっさりめのメニューで、\n","晚餐是，\n或许考虑到我刚病愈，菜单偏清淡，\n"],["饂","乌"],["飩 ","冬 "],["蕎","荞"],["麦 ","麦 "],["入","混"],["麺と言った、\n和風麺系をメインに、油軽めのおかずとサラダといった風に構成。","面之类的，\n以和风面类为主，配低油脂小菜和沙拉的组合。"],["構成っていうか要するに、\n","说是组合其实就是，\n"],["件のヴァイキング方式の食堂に来てるだけ。[l]\nただ何故か冬夏と宮さんまでが、\n僕と同じものを選んでるけど……","那家自助式食堂的常规操作。[l]\n但不知为何连冬夏和宫小姐，\n都选了和我一样的菜色……"],["冬夏はまあなんだかんだ言って、\n体型維持とか気にしてという意味もあるかもね、\nお年頃の女子だしね。","冬夏嘛虽然嘴上总爱抱怨，\n可能也有在意体型维持的因素吧，\n毕竟到了会在意这些的年纪。"],["バナナと茶漬けで多少は腹に入っていたとはいえ、\nほぼ丸１日食べてなかった僕は、\n無茶しない程度ではあるものの普通にそれらを食し、\n心身ともにほぼ全快したもよう。","虽然香蕉和茶泡饭勉强垫过肚子，\n但几乎一整天没进食的我，\n在不过量的前提下正常吃完这些，\n身心都基本完全恢复了。"],["うーむ、\nやはり風邪の治りかけとは違う感じである事を実感する。","唔嗯，\n确实能感觉到和感冒痊愈时不同。"],["病み上がりにしては食欲が普通過ぎる。","作为病后初愈来说食欲过于正常了。"],["僕だけかも知れないけど、\n今までは風邪程度でも結構食欲減退するので、\n今回は余程完璧に治ったのか、或いは病気じゃなかったか、","或许只是我个人情况，\n以往就算小感冒也会食欲大减，\n这次要么是彻底痊愈了，要么根本不是生病，"],["真","真"],["逆きぃの変な影響があるとか……[l]\n彼奴は彼奴でそれこそ今日はバリバリだったそうだし……","要么就是小贵那家伙的古怪影响……[l]\n那家伙自己今天倒是生龙活虎的……"],["そのきぃの見舞いに行った……既に昨日の事か、冬夏は、[l]\n終始僕の横で気遣ってくれてた。","去探望那个小贵的……已经是昨天的事了吗，冬夏她，[l]\n始终在我身边细心照料着。"],["人事不省中に色々世話になってた事や、\nこの後、仕事の話で一緒に居られないという後ろめたさも手伝って、\n僕も宮さんの視線を気にしながら、\n彼女に積極的に対応していた……ような気がする。","包括在人事不省时受到的各种照顾，\n再加上之后因为工作没法陪他的愧疚感，\n我也一边在意着宫小姐的视线，\n一边积极地回应着她……大概是这样。"],["──あらゆることがうしろめたいくせに──","──明明每件事都让我愧疚得要死──"],["久々に人と愉しく喋った気がして、\n夕食は皆で穏和に過ごせたと思う。[l]\n意味なく昂揚して、普段よりよく喋った。","感觉很久没和人聊得这么开心了，\n晚餐时大家也相处得很融洽。[l]\n莫名亢奋着，比平时话更多。"],["久々に言語野が刺激されたってことかな……[l]\n１度だけ携帯をチェックしてみたが、\n姫様ちゃんからの着信は未だ無かった。","大概是语言中枢久违地被刺激到了吧……[l]\n只查看了一次手机，\n姫様酱还没打来过。"],["食事があらかた終わり、\n冬夏には今から仕事がある旨伝え、\n謝ると、","吃得差不多时，\n告诉冬夏现在要去工作，\n道歉后，"],["「んー、残念だけど、分かったー。[l]\nあ、きぃがね、\nもう大丈夫そう。[l]\n真言さんにも御礼言いたいって、","「嗯~虽然遗憾但明白啦—[l]\n啊、小贵她啊，\n看起来已经没事了。[l]\n说也想向真言先生道谢，"],["今度私と一緒に会えない？[l]\nまあ、\n御礼言いに行って逆に、\nまた何か奢らなきゃならなくなるかもだけどね、\nあはは」","这次能和我一起见面吗？[l]\n嘛、\n跑去道谢反而、\n可能又得请你吃点什么呢、\n啊哈哈」"],["と提案された。","她这样提议道。"],["「つーかまさにそこが目的じゃないのそれ、\n会うに","「不如说那根本就是目的吧、\n借着"],["託けてってさあ、\n全く彼奴ぁしょうがないな……別に良いけどさ」","见面的名义、\n那家伙真是没救了……不过我倒无所谓啦」"],["「ん、\nきぃは何かちゃんと御礼も用意してるみたいよ？」","「嗯、\n小贵好像有好好准备谢礼哦？」"],["「へぇえ？[l]\n無理しなくていいのに……","「诶诶？[l]\n不用勉强自己啊……"],["そんなの用意するくらいなら自分の食い","与其准备那些不如把"],["扶","伙"],["持に\n回してくれた方がこっちも安心出来るんだけどな……[l]\nはっ、まさか」","食费\n留着自己用更让我放心呢……[l]\n哈、难道说」"],["「お金で買えない価値のモノかもねー。[l]\nなぁーんでしょうねえ、\n肩叩き券とかかしらーあ」","「用金钱买不到价值的东西呢——[l]\n会是什么呢——\n大概是捶肩券之类的吧——」"],["いや、なんでそんな眼で僕を！[l]\n別に邪な事を想像したりはしてません！","喂、为什么用那种眼神看我！[l]\n我才没在想象什么下流的事情！"],["「……まあ、[l]\nなんでもいいや。[l]\nケースバイケースで……」","「……算了，[l]\n怎样都无所谓。[l]\n看情况吧……」"],["「で、どうしよ？[l]\n行ける？[l]\n行けない？」","「那、怎么办？[l]\n能去？[l]\n不能去？」"],["うーん、\nここで姫様ちゃん達の事を","唔——\n在这里顾虑姫様她们"],["慮るのも、\n複雑な面倒が起こりそうだし、\nそもそも向こうの話もいつ来るか分からないし……","的事情，\n感觉会引发复杂的麻烦，\n而且那边也不知道什么时候会来消息……"],["という事で、\nやはりこのお方の指示を仰ぎます。","所以，\n还是请示这位大人吧。"],["「えーと……どうですかね？[l]\nあの、宮さん」","「那个……您觉得呢？[l]\n请问、宫小姐」"],["「んむー？[l]\n構わないんじゃないですか。[l]\nあ、でもまあ今夜の報告次第で。[l]\n基本的にはだいじょぶでしょ」","「嗯唔——？[l]\n不也没关系吧。[l]\n啊、不过要看今晚的报告情况。[l]\n基本上没问题吧」"],["食後のお茶をすすっていた宮さんは、\nこちらを一瞬だけちらりと視て、あっさりそう応えた。","正在啜饮饭后茶的宫小姐，\n朝这边轻轻瞥了一眼，干脆地回答道。"],["「あ、そうですか、\n……だってさ」","「啊、这样啊、\n……因为嘛」"],["「あそ、じゃ、問題無ければ明日とかで良い？[l]\n日曜だし。[l]\nきぃには私から連絡しとくね。[l]\nあ、移動手段は……」","「那、如果没问题的话明天也行？[l]\n反正周日。[l]\n小贵那边我会联系的。[l]\n啊、交通方式……」"],["「ああ、レンタカーあるし大丈夫、\n場所教えてくれれば」","「啊啊、有租车没问题的、\n告诉我地点就行」"],["「………んと、[l]\nあ、どうぞどうぞ、お二人はごゆるりと～\nちと離席しまー」","「………呃、[l]\n啊、请便请便、二位慢慢聊～\n我稍微离开下ー」"],["「はい？」","「啊？」"],["「らじゃー」","「好哒ー」"],["宮さんは昨日……じゃないもうその前だ、いい加減ややこしいな、[l]\nと、同じように、何処かへ立ち去った。","宫小姐昨天……不对是更早之前、真是越来越混乱了、[l]\n就这样、同样地、不知去向何方。"],["また電話か何かか？[l]\n前回もどうだったか覚えてないけど……[l]\n普通にお手洗いかね。","又是电话什么的吗？[l]\n上次怎样也记不清了……[l]\n普通地去洗手间了吧。"],["……だからいちいち詮索する事じゃないっての。[l]\n気にしすぎだ僕って。","……所以说没必要事事都追根究底啦。[l]\n我真是操心过头了。"],["「………」",""],["何故かこっちをじーと視てる冬夏と眼が合った。","不知为何和直勾勾盯着这边的冬夏对上了视线。"],["「……な、なんでしょう？」","「……怎、怎么了？」"],["「ん、\n手強いなーって」","「嗯、\n觉得你很难搞呢ー」"],["「はい？[l]\n何が？」","「哈？[l]\n什么啊？」"],["「それはですね、」","「这个嘛、」"],["「のわ！！！！！」","「才怪！！！！！」"],["「……いや、説明は無粋ですねあまりにも。[l]\n私からは止しておきましょう。","「……不、解释实在太煞风景了。[l]\n我就不多说了。"],["今店長に電話を取り次ぎに来まして──\n","刚才是来转接店长电话的──\n"],["取り次ぎ？[l]\nとりつぎ……何か違うか……[l]\n","转接？[l]\n转接……好像哪里不对……[l]\n"],["まあ、どっちでもいいんですがそこは。","嘛、这点怎样都无所谓啦。"],["ああ、","啊啊，"],["此","来"],["方初めてですね？[l]\n挨拶をしておこうと思い","是初次见面吧？[l]\n想着来打个招呼"],["罷り越した次第です」","就过来叨扰了」"],["僕等２人の死角から現れたチノ嬢が、\nいつもの口調でそう言った。[l]\n勿論、","从我们两人视线死角现身的千乃小姐、\n用一贯的腔调说道。[l]\n当然、"],["形","已知生物的"],["貌もいつもの通りである。","表情也一如既往。"],["「ああああれ？[l]\n宮さんなら今さっき……[l]\nあ、そもそも宮さんの離席それが理由ですか？[l]\nというか、あれ、冬夏初めてだっけ？」","「啊啊啊咧？[l]\n宫小姐的话刚刚才……[l]\n啊、难道宫小姐离席就是因为这个？[l]\n话说、那个、冬夏是第一次见吗？」"],["冬夏はまだ動揺してるようで僕を視て、\n首をぶんぶん横に振った。[l]\nあ、あれ、そうだったか。","冬夏似乎还在动摇地看着我、\n用力左右摇头。[l]\n啊、啊咧、是这样吗。"],["「え、えーと、\nどうも、えー、\nえ、店長って？ことは？」","「呃、那个、\n你好、呃、\n诶、店长？怎么回事？」"],["「お察しの通り、\nこちらとは同僚です。[l]\nとは言えこちらが店長の下に来ましたのもつい最近、\nワタシもそれまで外つ國に居ましたのでね、","「正如您所料、\n这位是我的同事。[l]\n虽说我调来店长麾下也是最近的事、\n毕竟我之前都在外邦之地、"],["同僚と言っても、\n必要以上に親密な訳でも支障がある程に険悪な訳でもありませんのでね、\n","说是同事、\n既没有过分亲密也不至于关系恶劣、\n"],["どうか御心配なく。[l]\nさて」","还请放心。[l]\n那么」"],["ごほごほ、と、\nどこまで本気か判らない咳き込み方をして、\nチノ嬢は改めて冬夏に向き直った。","咳咳、地、\n用真假难辨的做作方式清了清嗓子、\n千乃小姐重新面向冬夏。"],["「貴女の事は店長から伺っておりますので、\nこちらの自己紹介をさせて頂きますとね、\nワタシ、\n千野チノと申します。","「您的事已经从店长那里听说了，\n这边请允许我做下自我介绍呢，\n我、\n名叫千野千乃。"],["秘書……否、","秘书……不对、"],["処","处"],["務か？[l]\n敢えて言うなら──ああ、\n申し訳ありません、\n","勤务？[l]\n硬要说的话──啊、\n非常抱歉、\n"],["どっちでもいいんです」","怎样都无所谓啦」"],["「は、あ……千野、さん？」","「哈、啊……千野、小姐？」"],["やっぱ冬夏はこういうキャラに弱いか……","果然冬夏对这种角色没辙吧……"],["と、チノ嬢は服の裾をつまんで、\n所謂『お姫様会釈』とでも言うべきあのポージングをし、\n冬夏を更に萎縮させる結果に。","只见千乃小姐捏着衣角、\n摆出所谓『公主式欠身』的姿势、\n结果让冬夏更加畏缩了。"],["「……におきましてはご機嫌麗しう、[l]\n今宵は","「……在此恭祝贵体安康、[l]\n今夜"],["御","御"],["拝","拜"],["謁","谒"],["賜りたく、\nという奴ですかね」","承蒙召见、\n就是这种调调吧」"],["「わ、たし、そんなんじゃ──」","「我、我才不是那样──」"],["チノ嬢が何と言ったのか聞こえなかったが、\n冬夏も多分それどころじゃない。[l]\n否、オジョウサマ扱いに対してはあまり良い気分じゃない筈だから、\nもしかして気を悪くした──？","虽然没听清千乃小姐说了什么、\n但冬夏大概也无暇顾及。[l]\n不、被当成大小姐对待应该不会让她高兴、\n莫非惹她生气了──？"],["察しが良いのが売りのチノ嬢にしては……[l]\nそれとも何か意味があるのか、\n別の意図なのかやっぱり他意はないのか──","对于以善解人意著称的千乃小姐来说……[l]\n还是说另有深意、\n别有用心或者其实毫无企图──"],["「まあ、そこはどっちでも。[l]\n問題無いですね？そうですね？」","「嘛、这个怎样都好。[l]\n没问题吧？对吧？」"],["「──は、い」","「──是、的」"],["あれ？[l]\n僕の心配を","咦？[l]\n我的担心"],["余","余"],["所に、\n特に問題無い事になってるな。","之处、\n似乎完全不成问题呢。"],["「敢えて察しない事が功を奏する事も無きにしも非ず、\n役割としてそういうキャラが要される場も無きにしも非ず、\nそれがワタシかどうか、今ココなのかは別ですが、","「有时刻意装糊涂反而奏效、\n某些场合也需要这种角色定位、\n至于那是否就是我或当下是否需要另当别论、"],["ま、\nそれはどっちでもいいんです。","不过、\n这些都无所谓啦。"],["ともあれ何かありましたらね、\n今後ともよしなに。[l]\nでは。今戻ってくるでしょう店長も」","总之有任何需要的话、\n今后还请多关照。[l]\n那么。店长也该回来了」"],["「ああ、はあ、よしなに……」","「啊、好、请多关照……」"],["「お、お疲れ様です……」","「辛、辛苦了……」"],["いつものようにすーっと立ち去っていくチノ嬢。","千乃小姐像往常般飘然离去。"],["「おまたー」","「我回来啦─」"],["入れ違いに戻ってくる宮さん。","与宫小姐擦肩而过。"],["「お、おかいもんー」","「欢、欢迎回来─」"],["まだ困惑中らしい冬夏が迎える。[l]\nと言っても僕とて思考が明晰だった訳でなく、\n単にうかうかと状況に流されていただけです。","仍在困惑中的冬夏应声道。[l]\n虽说我的思绪也不甚清晰、\n只是浑浑噩噩随波逐流罢了。"],["「あ、あれ、今チノさんが電話がどうとか……」","「啊、那个、刚才千乃小姐说什么电话来着……」"],["宮さんの椅子を引いてあげながら言うと、","边为宫小姐拉开椅子边问、"],["「んむ？[l]\nそうですよ。[l]\nそれで離席してたです。[l]\n最近お仕事が忙しくって……」","「嗯唔？[l]\n是呀。[l]\n所以刚才离席了。[l]\n最近工作太忙啦……」"],["え？[l]\nそれにしちゃ入れ替わりのタイミングが良過ぎやしないか？[l]\nてか宮さんの離席唐突だったじゃんよ。[l]\n報告来てから移動したとかじゃなかったでしょ？","诶？[l]\n但这交接时机未免太巧了吧？[l]\n而且宫小姐离席明明很突然啊。[l]\n不是接到通知才离开的吧？"],["……まさかチノ嬢が僕等の死角からジェスチャーとか手招き的に合図してた？[l]\nだったらその後、わざわざ僕等に姿を現したんじゃ二度手間では……","……难道千乃小姐从我们视线死角打手势召唤她了？[l]\n可之后特意现身岂不是多此一举……"],["それと、\n仕事って、僕が辺りをうろうろする以外の内容、だよな？[l]\n何してるんだろ？","还有、\n所谓工作、应该不止是让我在这附近瞎晃悠吧？[l]\n到底在搞什么啊？"],["どうせ本家絡みなんだろうけど、\nそっちの仕事は振ってくれないんだなあ。","反正肯定和本家有关吧、\n但那边的工作从来不会分给我呢。"],["そういう中身なんだろうけど、\n忙しいて言うくらいなら少しは頼ってくれてもいいんでないかなあ……","虽然大概就是这么回事、\n既然都说忙了偶尔依赖我一下也没关系吧……"],["「状況が流動的でして。[l]\nまこくんにも苦労をかけてます、\n駄目な上司でごめんね、\nよよよ」","「因为情况变动很大。[l]\n给小真也添了不少麻烦、\n我这个上司真不称职呢、\n呜呜呜」"],["「泣かした！」","「把她弄哭了！」"],["「は？！」","「哈？！」"],["冬夏、或る意味立ち直り早いな！","冬夏、某种意义上恢复得真快！"],["「はうあ、ここで乗っかられても結構困る……」","「哇啊、这种时候扑过来我也很困扰的……」"],["「あれ？」","「咦？」"],["あれ？[l]\n宮さんそれ割と","咦？[l]\n宫小姐这个反应"],["切ねぇ反応！[l]\nでも、\nここぞとばかりに僕も華麗にスルーしたい所存。","相当不妙啊！[l]\n不过、\n这种时候我也想华丽地装作没看见呢。"],["「じゃ、その件はそこまで！以上！[l]\n僕は風呂に入ります！」","「那、这件事就到此为止！以上！[l]\n我要去洗澡了！」"],["「んむ、\nここは致し方なし、さあお行き！」","「嗯唔、\n这就没办法啦、快去吧！」"],["「あれ？[l]\nあれれ？？」","「啊咧？[l]\n啊咧咧？？」"],["「ではおつかれでした！！」","「各位辛苦啦！！」"],["と移動しかけた僕の手首を、","正要移动的我手腕突然被、"],["「──ちょいとお待ち？」","「──稍等一下？」"],["がっしと掴む冬夏。","冬夏牢牢抓住。"],["「明日のきぃとの約束の事とかをぉー、\n調整しなきゃいけないでしょーう？[l]\nねえ？[l]\nウフフフ本気じゃないんだよね？","「明天和小贵的约定之类的事情呀、\n不是得调整一下吗～？[l]\n对吧？[l]\n呵呵呵你是在开玩笑对吧？"],["折角話に乗っかろうとした私を、\nその私ひとり置いて行こうとしたのはね？[l]\nそうよね？","难得我想配合话题、\n却打算把我一个人丢在这里呢？[l]\n是这样吧？"],["このままじゃ私超恥ずいひとだもん、\nそんな非道いことするなんて、\nねえ私の誤解だもんね？[l]\n","这样下去我会超级羞耻的、\n做出这么过分的事情、\n呐这一定是我的误会对吧？[l]\n"],["お二人さん？」","两位？」"],["………無言の圧力というよりも、[l]\n実質僕を椅子に座らそうとするチカラが腕に込められています。","………与其说是无声的压力、[l]\n不如说她的力道简直要把我按回椅子上。"],["恥ずい行為をよくする割に、\nその反動も激しい冬夏さん、\n照れ隠しも入ってるからだと思いますが眼が血走ってます。","虽然经常做些羞耻的事、\n但反弹起来也很激烈的冬夏小姐、\n因为带着掩饰害羞的成分眼睛都充血了。"],["……掴むチカラもそろそろ、結構鬼気迫ってきてます。","……手上的力道也渐渐变得鬼气森森。"],["「そ、そうす、こんな、ねえ、\n冗句っすよねえ？[l]\nねえ宮さん？」","「这、这样啊、这种、呐、\n是在开玩笑吧？[l]\n对吧宫小姐？」"],["「……まあこの後ミーティングあるとは言え、[l]\n丸１日寝てた訳だし、\n何もしないでは今晩の寝付きも悪そうですしねぇ。","「……虽说之后确实有会议、[l]\n但毕竟睡了整整一天、\n什么都不做的话今晚恐怕也很难入睡呢。"],["も少しだけここで談笑してくのも良いかもですね、\nおほほほほ、\n","稍微在这里聊会儿天也不错、\n哦呵呵呵、\n"],["あ、じゃあまこくん、改めてお茶でもみんなの分を」","啊、那小真、麻烦重新给大家泡茶」"],["「あーい了解です少々お待ちを～」","「好～嘞稍等片刻～」"],["ずっと僕の手首を握ってた冬夏が、\nそこで","一直抓着我手腕的冬夏、\n这时"],["漸くその手を離してくれまして、\n僕はドリンクのエリアへ向かおうとしてふと気付き、","终于松开了手、\n我走向饮品区时突然想到、"],["「えっと、温かいのと冷たいのどっちが……」","「那个、要热的还是冰的……」"],["「冷たいので」","「冰的」"],["「は、らじゃー、わかりました」","「啊、好哒——明白啦」"],["まさに猫舌？[l]\n関係ないか……","果然是猫舌头？[l]\n没关系吧……"],["立ち去る瞬間、\nうっすらと、\n二人のつぶやきがそれぞれ聞こえかけたが──","转身离去的瞬间，\n隐约听见\n两人各自漏出的低语──"],["流石…っても……の裔、……が強いというか何というか──","不愧是…虽说…的后裔、……该说是顽强还是什么呢──"],["…らいなあ……ったく……せつけないでよ……──","…烦死了……真是……别戳穿人家啦……──"],["どっちもよく判らなかったし、\n二人とも互いに気にしてないようだったので、\nそのまま放置してお茶を取りに向かった。","两边都没听太清楚，\n不过看她们似乎都没在意，\n我便径直去准备茶水。"],["四角のお盆に３つ冷えウーロン入り湯飲みを乗っけて、\n戻って来ると一体何の話をしてたものか、","在方形托盘上摆好三杯冰镇乌龙茶杯，\n回来时完全搞不懂她们在聊什么，"],["「",""],["先","不"],["刻私テンパってさ、\n食べれる食べられるって言ったじゃない？[l]\nら抜き言葉ってさ、\nあれだよね、","我啊超慌的，\n不是说了能吃能吃吗？[l]\n那个省略ra的用法啊，\n就是那个对吧，"],["私","我"],["等的にはさ、\n受動態の『られる』との差別化しようとして、\n自然に使い分けてたつもりなんだと思うんだけど。","从等级上来说啊，\n为了和被动式的『られる』区分开来，\n我觉得应该是自然地区分使用了吧。"],["食べられるだとさ、\nライオンとかに食べられるぅ～って感じが、\nするでしょ？","说到被吃掉的话，\n被狮子什么的吃掉啊～就是这种感觉，\n对吧？"],["ガクジュツ的にどうかは知らないけど、\n使ってる当人としてはそんな感じ」","学术上是否正确我不知道，\n但使用者本人就是这么觉得的」"],["と、\n","突然被抛来\n"],["俄にはよく判らない話題を唐突に振られた。","一个令人摸不着头脑的话题。"],["「あ、お茶ありがとうです。[l]\n前にちょっとだけ調べたら、\n割と前から使用例はあったようですので、","「啊、谢谢你的茶。[l]\n之前稍微查过资料，\n这种用法其实很早就有记载，"],["所","的"],["謂若者の言葉の乱れと、\n一蹴してしまっていい問題とも限らないようですが」","所以不能武断地\n归咎于年轻人用语混乱呢」"],["「何の話ですか二人して。[l]\nほい、冬夏」","「你们俩在聊什么啊。[l]\n给、冬夏」"],["「ありがとー。[l]\nんとね、\nトラディションについて」","「谢啦～[l]\n那个啊，\n在说tradition的事」"],["「は？」","「哈？」"],["traditionのこと？","tradition？"],["「伝統、しきたりですね」","「传统、习俗之类的」"],["「や、し、知ってますよ。[l]\n何だってそんな話」","「当、当然知道啊。[l]\n怎么突然说这个」"],["彼女にとってそれって結構、\nデリケートな話題じゃないのかな。[l]\nそれとも冬夏から切り出したんだろうか。","这对她来说\n不是挺敏感的话题吗。[l]\n还是说是冬夏先提起的呢。"],["「大体伝統とかいうものはですね、\n秘されるモノだし、\n変化も……時に進化すらせず、","「所谓传统这种东西啊，\n本就是秘而不宣之物，\n既不会改变……有时甚至不会进化，"],["ただただ継承し伝えられるから伝統なんですよ、\n基本的にはね。[l]\n時代にそぐわないとかもあるでしょうけどね、\n変えてしまっては意味はないんです。[l]\nあ、保守とか革新とか言うつもりは毛頭無いですよ。[l]\n……冬夏さん、ついてきてます？」","仅仅靠代代传承才成为传统，\n基本上是这样。[l]\n虽然也有不合时宜的情况，\n但擅自改变就失去意义了。[l]\n啊、我完全没有保守或革新之类的立场哦。[l]\n……冬夏小姐，能跟上吗？」"],["「……たぶん。なんとか」","「……大概。勉强可以」"],["僕も席に着く。[l]\n何やらチノ嬢ばりにカタリ出しそうな気配が──\nこの場合……に限らずだけども、","我也落座。[l]\n总觉得千乃小姐又要开始长篇大论──\n这种情况……倒也不限于此，"],["果たして語りなのか","究竟是讲述"],["騙りなのか……[l]\nそれが問題だ。[l]\nいや、どうでもいいか。[l]\nただの雑談だわな。","还是诡辩……[l]\n这才是问题所在。[l]\n不、其实无所谓吧。[l]\n不过是闲聊罢了。"],["「モノによっては秘されているという事実自体に、\n意味がある場合もありますしね。[l]\n古今伝授がどうとかという以前に、ほら、\n女子のはぁともね？","「有些事物被隐藏这一事实本身，\n就具有意义呢。[l]\n在讨论古今传授之前，你看，\n女孩子的秘密也是吧？"],["男子にとっては知らぬが花、\n知った瞬間に……意味を成さないならまだしも、[l]\n幻滅したり、マイナス面が発生する事項もあるわけです。","对男生来说不知为妙，\n知道的瞬间……若只是失去意义还好，[l]\n但有些事会让人幻灭或产生负面影响呢。」"],["一子相伝とか、\nほんとに何かを伝授されてるとは限らない訳で。","所谓单传秘法之类的，\n未必真在传授什么实质内容。"],["『お前が継承者』、\nという資格を与える為の","『你是继承者』，\n这种名分授予的"],["約","约"],["款、\n建前である可能性もあるのですよ。","条款，\n可能只是表面形式哦。」"],["それを対外的に行う事で、そうだと示す、\n言わばポーズですね」","通过对外宣告来确立权威，\n说白了就是作秀呢」"],["内容的にも何か、\n真綿で首を絞めるような、\n遠回しに何か彼女を責めてるようにも聞こえるが、","内容上也带着某种\n温水煮青蛙般的、\n拐弯抹角责备她的意味，"],["どこまで自覚的なんだか、\nそこまでは宮さんの顔からは読み取れない。","但究竟有几分自觉，\n从宫小姐脸上可看不出来。"],["……元より僕に人の顔色読むスキルは無いけども。[l]\n察するだの何だのは、\nそれこそ完全にチノ嬢の領域ですね。","……虽然我本来就不会察言观色。[l]\n揣测人心之类的，\n那完全是千乃小姐的专长呢。」"],["第一、\n基本的には何を言ってるのかよく分からんですよ。","再说了，\n我压根听不懂她在说什么。」"],["「秘されてる事に意味があるのは分かります、\nでもそのためにシキタリをつくって……[l]\n無自覚に……当人の了解も得ず……その」","「我明白隐藏意义这种事，\n但为此制定规矩……[l]\n在本人无意识……未经同意的情况下……」"],["「んむー、\n言いたい事は何となく、\nただそれは少し話題のステージが違うというか、\n毛色の違う、矛先の違う話ですかねぇ」","「嗯唔——\n你想说的我大概懂，\n不过话题层级似乎不太一样，\n性质不同、矛头指向也不同吧？」"],["口を挟む空気でもなし、\n取り敢えず僕は黙って茶をすすった。","插不上话的我\n只好默默啜饮茶水。"],["その音に紛れて話題が変わったのか、\n連続した話なのか僕には判別つきかねたまま、\n宮さんはかたり続ける。","不知是借喝茶声转换话题，\n还是继续原有脉络，宫小姐\n兀自说着。"],["「個人的意見ですけど、\nルールというのは、\n建前だし大義名分ですよ。","「个人认为，\n所谓规则，\n就是门面和大义名分。"],["当然の如くヒトがつくったものだし、\n場所時代で変動もしますしね、\n現状、殆ど真理実利に則ったルールというものはない……[l]\nと思いますけどねー」","理所当然由人制定，\n也会随时代地域变动，\n现今几乎没有符合真理实效的规则……[l]\n我是这么想的啦」"],["「そう言う事はなんかチノさんが前言ってたなぁ……」","「这种话千乃小姐之前也说过……」"],["「んむ？[l]\nそですか。[l]\n大義名分というのは、\nもう文字通りだし面倒なので説明は省略！」","「嗯唔？[l]\n这样啊。[l]\n大义名分这个词，\n字面意思就够麻烦所以跳过说明！」"],["と椅子に座ったまま背伸びをする宮さん。","宫小姐坐在椅子上伸懒腰。"],["ここいらでお開きかと思いきや、\nしかし、話はまだ続くらしかった。","以为要结束时，\n她却似乎意犹未尽。"],["「ルール……んむ、[l]\nルールはですね、","「规则……嗯唔，[l]\n规则呢，"],["禁忌のように、\n『ある事象が起きないように予防線を張る』\nという設計思想である事が多いので、","就像禁忌般，\n多以『预防某些现象发生』\n为设计理念，"],["しなければならない、\nよりは、\nしてはいけない、\nが多い感覚がないですか？","比起必须做，\n更多是\n不能做，\n的感觉对吧？」"],["これは『何故してはいけないのか』、\nと言う背景には、\nしてはいけない具体的な理由よりも、\nしたら","这个『为什么不能这么做』的问题，\n其背后原因，\n比起具体禁止的理由，\n更多是"],["拙い事がある故である事が割とあってですね。","因为做了就会引发糟糕状况的情况还挺多的呢。"],["今さっき言ったように予防線、\nつまり闇雲に禁止してる訳ではないのですけれど、","就像我刚才说的预防线，\n也就是说并不是盲目禁止的，"],["そこが忘れられると、\n『建前として語られる禁止している理由』そのものに違和感を感じて、\nルール自体を糾弾しかねないんですね。","但如果忘记这点，\n就会对『表面上宣称的禁止理由』本身感到违和，\n甚至可能批判规则本身呢。"],["ところが、説明したようにですね、\n『そこ』に難癖を付けても、\n実は見当外れである事が多いです、ルール作成した側から視れば。","不过正如我解释的，\n就算对『那个』吹毛求疵，\n实际上大多都搞错方向了——从规则制定者的视角来看。"],["しかしてヒトはルールの成り立ちを忘れる事もありまして、\n後代その意義が失われた時、糾弾に応じて改変される事もあり得る訳ですが、","然而人类有时会忘记规则的由来，\n当后世其意义丧失时，也可能迫于批判而修改规则，"],["今いった成立事情の場合、且つ、\nその表出させたくなかった","但刚才说的成立背景情况下，再加上\n那些不愿被暴露的"],["拙い事象がまだ生きている場合は、\n少々ややこしい事が起こる……事もあるという訳ですなー」","拙劣现象仍然存在时，\n偶尔会发生些麻烦事……就是这样啦—"],["な、長いですなー。[l]\n流石に口が渇いたか、\n宮さんは一気に茶をあおった。[l]\n冬夏は……神妙な顔をして黙って聞いていたようだ。","啊—好长啊—[l]\n毕竟说太多口渴了吧，\n宫小姐一口气灌下了茶。[l]\n冬夏……似乎一直保持着严肃表情静静聆听。"],["「まままま、冬夏さんもそんな顔しないで、\nあくまで個人的見解として聞いてくださいよ？[l]\nちょっと話は違うかもですが、」","「好啦好啦，冬夏小姐也别摆那种表情，\n就当是个人见解听着玩嘛？[l]\n虽然话题可能有点偏了，」"],["そこで宮さんは何故か僕の方をちらっと視て、\nほくそ笑むような顔をしてから、\n話を再開する。","这时宫小姐不知为何朝我瞥了一眼，\n露出窃笑般的表情后，\n重新开始讲述。"],["「例えば本とかＤＶＤとかフィギュアとか──\n観賞用保存用予備用等々と、\n複数個おんなじモノを買う人間にとってはですね、","「比如书籍啊DVD啊手办之类的──\n观赏用收藏用备用等等，\n对于会重复购买相同物品的人来说啊，"],["揃ってる状態、処女地であることの、\nつまり完全に揃っている事の意味の為に、\n永久に、決して中身を視る事のない閉じられたハコにも、\n価値をみいだせている訳ですね。","保持整套完整、处于未开封状态，\n也就是说为了追求完全集齐的意义，\n即便是永远、绝对不会打开查看内容的封闭盒子，\n也是能从中发现价值的呢。"],["ハコにはハコとしての存在価値がある、\nとあるお方も仰っておられたようにですね、\nそこには実利的……読むとか観るとか遊ぶとか……[l]\nそう言った価値とは別の話な訳で、","盒子有盒子存在的价值，\n就像某位大人说过的那样呢，\n这和实际用途……阅读啊观看啊把玩啊……[l]\n是区别于那种价值的，"],["あ、\n勘違いしないで欲しいですが、\n実利的価値を認めないではないのです。[l]\nだからこそ観賞用というのがあるですからね。","啊，\n希望您不要误会，\n我并非否定实用价值。[l]\n正因如此才会存在观赏用这个分类嘛。」"],["ただ、そうでない、\n『そこに一揃いある』という価値、\n『全てが揃ってる美しさ』、\nそう言った価値をみいだして、\n尚且つ、実際金銭を支払うものがいるという事実も知ってますね？","只不过，并非如此，\n『那里有一整套』的价值，\n『全部集齐的美感』，\n我是能理解这种价值的，\n而且也知道确实存在愿意为此掏钱的人对吧？"],["だからですね、\n開けないなんて勿体ないとか、\n余ってるなら他人に譲った方が、とか、\nそういう次元の話じゃないですよ、わかるでしょぉ？","所以啊，\n说什么不拆封太浪费啦，\n有多的不如让给别人啦，\n根本不是这种层面的问题哦，懂的吧～？"],["なので、\n『こうした方が有意義だ』、\n『こうした方が無駄がない』、\nというアドバイスは、","因此，\n『这样做更有意义』，\n『这样更不浪费』，\n这类建议呢，"],["あくまでケースによりますけど、\n見当違いも甚だしい訳ですよね？","终究要看具体情况，\n根本是南辕北辙对吧？"],["なので、先程の話に戻りますが、\n伝統に対してですね、\nいかにそれが無意味そうで無駄の極致に視えても、\nそこは責め所が違う気がしますよね。","所以回到刚才的话题，\n对于传统啊，\n哪怕它看起来多么毫无意义像在极致浪费，\n我觉得批判的点不该在那里呢。"],["ほら、\nこの國に限らず、\n祭、祭儀というものがあるでしょ？","喏，\n不仅限于这个国家，\n总有些祭祀啊仪式之类的存在吧？"],["あれ、テレビでネタになるくらい、\n突拍子もないのも中にはあるわけじゃないですか。","那些啊，甚至能成为电视节目的素材，\n其中也不乏些荒诞不经的内容不是吗。"],["成り立ちには深淵な意味があったかも知れませんが、\n否、無くてもですね、\nそれを守り、\n継承し、","虽然其起源或许蕴含着深邃的意义，\n不、即便没有，\n守护它、\n传承它、"],["続けていく事に意味があるが故に行っている行為に関しては、\n外部からの言葉、届くかどうか疑問である場合が多そうですけど。[l]\n論点がずれてるので平行線になるんでしょうね。","坚持延续下去这件事本身就有意义的行为，\n来自外界的评价，多半都难以传达到他们耳中吧。[l]\n因为论点错位所以才会变成平行线争论呢。"],["あ、そうですね、\n要するに、伝統って、モノによるでしょうが、\n極端に言えば、\n約束事を守るゲーム、とでも言いましょうか。","啊、确实呢，\n简而言之，传统这东西要分情况，\n极端点说，\n不妨称之为遵守规则的游戏吧。"],["制約やお約束を破らずに行為を成す事に価値を見出す遣り方、\nという場合もあるんですかね。つまり。[l]\nと話してきてはみたものの、何事もこう、\n一概には言えませんからね、","在恪守制约与既定规则的前提下完成行为才有价值的做法，\n这种情况也是存在的吧。也就是说。[l]\n虽然说了这么多，但凡事都是这样，\n不能一概而论呢，"],["先刻言った通り、\n宮の、宮達の個人的見解という奴で、\n流し聞いてくれればいいのです」","正如方才所言，\n这不过是宫、宫等人的个人见解，\n你们随便听听就好」"],["宮達って、あと誰？[l]\nこんだけ長広舌もふるってるし、その背景には、\n……チノ嬢か。","宫等人，还有谁啊？[l]\n能这么长篇大论，背后肯定有——\n……是千乃小姐吧。"],["如何にもあのひとの話そうな中身だし……[l]\nというか、まさか、\nこの会話全部チノ嬢の声帯模写じゃないだろうな。","这内容完全像是那个人会说的话……[l]\n或者说，难道说，\n这段对话该不会全是千乃小姐的声带模仿吧。"],["腹話術的な。[l]\n一応その辺視回したが、\n……流石に違うか。[l]\n居なかった。","腹语术那种。[l]\n姑且环视了四周，\n……果然不是呢。[l]\n没人在。"],["「──まあ、そういった訳で、\n伝統を守るべき意味、\nそれはあるひとにとってはあるし、\nないひとにとってはないんです。","「──总之呢，就是这么回事，\n守护传统的意义，\n对某些人来说是存在的，\n对另一些人来说则不存在。"],["成立事情から維持の意思、\n運用の目的から価値観の決定的な相違、\nそこに妥協点は無いんです。","从成立缘由到维持意志，\n从运作目的到价值观的决定性差异，\n这里不存在妥协点。"],["だから、\n伝統行事とかそういうのに参加、加入したければ、\n理不尽に視えようと、\nそのルールには従わねばならないんです。","所以，\n如果想参加传统活动这类事情，\n即便觉得毫无道理，\n也必须遵守那些规则。"],["問題は、\n冬夏さんの言ったように、\n意思とは別にその伝統に組み込まれた場合ですね。[l]\n世襲とか」","问题在于，\n就像冬夏小姐说的那样，\n是违背个人意志被纳入传统的情况呢。[l]\n比如世袭之类的」"],["冬夏が一瞬、\n身体を強張らせたような気がした。[l]\n長い話を座りっぱなしで聞いてたから、\n単に身体がびくっと","冬夏似乎\n瞬间绷紧了身体。[l]\n或许只是因为坐着听了太久，\n单纯身体"],["痙","抽"],["攣したのかも知れないけど……","搐了一下……"],["「と、言うだけ言っておいて何ですが、\n宮でもその辺どう解決したらいいかは中々、\n考えが及びません。","「虽、虽然这么说了，\n但就连宫也不太清楚\n该怎么解决这个问题。"],["うひひ、そもそも、\n今話してた事の大半が、\n兄様の受け売りでして」","嘻嘻，其实呢，\n刚才说的那些话大半都是\n从兄长大人那里现学现卖的」"],["え、お兄様がいらした？[l]\n初耳な気がするんですが……","咦，您有兄长大人吗？[l]\n感觉是第一次听说……"],["へえー、兄妹いたんだ。[l]\nそりゃあ全く知らなんだ。[l]\nさっきの宮『達』の『達』って、\n或いはその事かしら。","诶～原来有兄妹啊。[l]\n这个我完全不知道呢。[l]\n刚才宫『们』的『们』字，\n或许就是指这个吧。"],["それ以前に、","在那之前，"],["長い！！","好长！！"],["「んむ？[l]\nそろそろいいお時間かな？[l]\n済みませんね長々と」","「嗯唔？[l]\n差不多到时间了吧？[l]\n抱歉说了这么久」"],["口に出して言った訳じゃないが、\nどうやら宮さん自身もそう思っていたらしく、\n話を切り上げた御様子。[l]\n今夜はお開きかな？","虽然没直接说出口，\n但看来宫小姐自己也这么觉得，\n就结束了话题的样子。[l]\n今晚就到此为止吗？"],["「……あ、いえ、[l]\n知り合いに同じくらい長くてややこしい話するひと、\n居るから……[l]\nあ、別に悪いって言ってる訳じゃないんでその」","「……啊、不是，[l]\n我认识的人里也有说话又长又复杂的家伙，\n所以……[l]\n啊、我不是说这样不好啦」"],["「うひひ、分かってますよぉ。[l]\nじゃ、ちゃちゃっとお二人さん、\n本題の方を。","「嘻嘻，我懂啦～[l]\n那就赶快请两位，\n进入正题吧。"],["そしたらまこくんお風呂行って、\nその後お仕事の打ち合わせということで」","那小真就去洗澡吧，\n之后还要开工作会议呢」"],["「はぁ、分かりました」","「哈啊、明白了」"],["「んー、\n真言さん、\n流石に今晩、お風呂一緒は無理よね？」","「嗯——\n真言先生，\n今晚果然没法一起洗澡对吧？」"],["「え？！[l]\nあ、いや、その、\nは？！」","「诶？！[l]\n啊、不、那个、\n哈？！」"],["「ん、\n明日のきぃとの事も、\nついでにそこで話し合おうかなーとか、\n思ったんだけど。","「嗯、\n明天和小贵的事、\n顺便就在那儿商量下吧——之类的、\n我是这么想的。"],["前は一緒にお風呂入れなかったし」","之前都没能一起泡澡呢」"],["「え、いずれご一緒するって話でしたっけ……？」","「咦、是说迟早要一起洗来着……？」"],["マタアトデネとは言ってた気がするけど……[l]\nよもやそう言う意味とは思いませんですがな。","好像说过下次再约之类的……[l]\n但没想到会是这种意思呢。"],["「あによ、\n迷ってないでいってくればいいじゃん、\n","「哎呀、\n别犹豫直接去不就好了、\n"],["いってきなよーまこくぅん」","快去啦——小真」"],["「ん、\nそーしよう。[l]\n","「嗯、\n就这么办吧。[l]\n"],["準備してきまーす♪」","我去准备啦♪」"],["「えええええーーー？！[l]\nちょ、ま、」","「诶诶诶诶诶——？！[l]\n等、等等、」"],["ってくれる筈も無く、冬夏はさっさと席を立ち、","冬夏压根没给我拒绝的机会，利索地站起身，"],["「真言さんの部屋に行くから部屋で待っててー」","「我要去真言同学的房间所以你在屋里等着哦」"],["と言って食堂をつついーっと出て行ってしまった。","说完就戳着食堂的桌子哒哒哒地跑走了。"],["……宮さん、[l]\nどうしてくれるよ。","……宫小姐、[l]\n这可怎么办啊。"],["「ほんとに大胆だなぁ冬夏さんてば。[l]\nまこくん愛されてるーぅ」","「冬夏同学真是胆大包天呢。[l]\n真酱被狠狠爱着呢～」"],["白々しく言いながら僕の脇腹をつつかれても、\nその、\nどうにもならんだろ。","听着这假惺惺的调侃还被戳了侧腹，\n那个、\n我也无计可施啊。"],["「あのですね……[l]\nえ？[l]\nほんとに行ってこいと？」","「我说啊……[l]\n哈？[l]\n真要我过去吗？」"],["「だって冬夏さんはもう動いちゃってますが。[l]\n賽は投げられた、覆水盆に返らず、\n毒を食らわば皿まで、えーと、","「毕竟冬夏同学已经行动起来了。[l]\n骰子已经掷下，覆水难收，\n一不做二不休，呃、"],["ま、女子の側が拒否ってないんなら別にねえ、\nまこくんが遠慮する事ぁないでしょぉ？[l]\nえー、据え膳喰わぬは何とかかんとか……」","嘛、女生那边没拒绝的话就无所谓啦\n小真你不用客气吧？[l]\n诶～送到嘴边的饭不吃就是那个啥来着……」"],["「……僕がそんなキャラに視えます？」","「……我看起来像那种角色吗？」"],["「んむー、ノーコメント」","「嗯唔——，无可奉告」"],["何故ここでどっちつかず？","为什么这时候要模棱两可？"],["「まこくんは水着持ってるし、\n冬夏さんもこないだ買ったから問題なっしんぐです」","「小真有泳衣的，\n冬夏小姐前几天也买了所以完全没问题呢」"],["「問題はそこじゃない気が……」","「我觉得问题不在这里……」"],["「んむー、\n女子がああまで言ってきたのに、\n逆に失礼とか思ったりはしないんだ？","「嗯唔——\n女生都说到这个份上了，\n反过来不会觉得失礼吗？"],["私って魅力ないのねよよよ、\nとか泣かれても良いんだ？","我是不是完全没有魅力呜呜呜，\n就算被这样哭着质问也没关系吗？"],["義理でも社交辞令でも何でも良いですから、\n相手を気遣う事を考えないとねー、\n女子相手なら尚更、ですことよ？」","哪怕是客套话或社交辞令什么都行，\n总得考虑下对方的感受吧——\n对方是女生的话就更该这样了，对吧？」"],["だから貴女に言われても、\n今ひとつああそうですかと素直に納得し難いのよね。","所以就算被你这么说，\n现在也很难坦率地接受啊。"],["「ぼ、僕は本心と本心のぶつかり合いをモットーとしてます！","「我、我的人生信条是真心与真心的碰撞！"],["しょ、しょうがないんでじゃあ行ってきますけど、\n……う、打ち合わせの時も、[l]\n入浴時に関しての詳しい報告しませんからね。[l]\nじゃ覚悟は決めましたんで……さっくり逝って参ります……」","没、没办法那就去吧，\n……但、但是开会的时候，[l]\n关于入浴的详细报告我是不会做的。[l]\n既然做好觉悟了……那我就速速告辞……」"],["「…なんかひっかかりますけど、[l]\nお風呂上がったら宮の部屋に集合ー。[l]\n必要な物あったら持参して来てくださいな。[l]\nんじゃー、いっ、てらっしゃ～い」","「…虽然有点在意，[l]\n洗完澡后到宫小姐房间集合——[l]\n有需要的东西记得带过来哦。[l]\n那么——请、请慢走～」"],["何そのイントネーション。","这什么奇怪语调。"],["宮さんはもうちょっと茶をすするとか言ってその場に残り、\n僕は冬夏が来る前に部屋へと戻ることにした。","宫小姐说着再喝杯茶什么的留在原地，\n我决定在冬夏来之前先回房间。"],["はあ、気が重い……っていうのも失礼だけんども、[l]\nその、\nあの夜のあの意思表示があったその後に、\n二人で風呂って言うのは、","哈啊，心情沉重……虽然这么想也很失礼，[l]\n那个，\n在经历过那晚的表白之后，\n两个人共浴什么的，"],["どういう空気になるよ？","会是什么气氛啊？"],["いっそ宮さんも込みで３人ならまだ──","干脆连宫小姐三个人一起还——"],["「……いかんいかん、[l]\n………。[l]\n……いかんいかん」","「……不行不行，[l]\n………。[l]\n……不行不行」"],["僕は無心で部屋へ向かった。","我放空大脑走向房间。"],["「ふひーー、\nこれぁ、\n気持ちいいったらないなあ」","「呼咿——\n这个啊，\n简直舒服到极点了」"],["風呂から上がり脱衣場から出ると、\n心地よい冷気でさっぱりした気分に包まれる。","洗完澡走出更衣室时，\n惬意的凉意让人神清气爽。"],["結論から言うと、\n明日の時間と場所だけこっち２人で仮に決めて、\nあとは冬夏が風呂上がってからきぃに連絡、\n確認してから改めて最終決定案を僕に伝える、","长话短说，\n明天的时间和地点先由我们俩暂定，\n等冬夏洗完澡再联系小贵，\n确认后重新通知我最终方案，"],["という何か二度手間的な事を──否、\nまさに二度手間三度手間な中間処理をするという事で、\n調整は終了した。","这种像是绕远路的安排——不，\n根本就是反复折腾的中间流程，\n总之算是调整完了。"],["冬夏も一体何がしたかったんだか……って、[l]\nはい、約束通り入浴時の詳しい描写は無し！[l]\n不純異性交遊禁止！","冬夏到底想干什么啊……啊，[l]\n对了，按约定不描写入浴细节！[l]\n禁止不纯异性交往！"],["いやだから何もないですって。[l]\nほんとうです。","所以说真的什么都没发生啦。[l]\n是真的。"],["まあ、実際それどころではなく、\n姫様ちゃんとバッティングしたらどうすべえ……","不过实际上根本顾不上那些，\n要是和姫様撞上了该怎么办啊……"],["とか懸念もあったけども、\nこればっかりは、\n向こうの都合次第なのでどうすることも出来ぬ。","虽然也有这种担忧，\n但这种事，\n全看对方安排也没办法。"],["開校記念日の休日とかに来るかもしんないし、\n……冬夏もその日何かしたがるかもしんないけど、","说不定会在开学纪念日假期来，\n……冬夏可能那天也想做点什么，"],["うーん、\nそういう人間関係は苦手だなあ……[l]\n単に人付き合いが少なすぎて経験値が無いとも言う……","嗯——\n那种人际关系我实在应付不来啊……[l]\n或者说单纯是社交经验太少导致经验值不足……"],["それはさておき、\n格別資料とかもないので、\n冬夏を部屋に送った後、連絡後でくれるという約束をして、\n宮さんの部屋に向かった。","这个先放一边，\n既然没有特别资料，\n和冬夏约好送她回房后会联系，\n我就往宫小姐房间走去。"],["先日の夜の記憶があったので、\n何となく気後れしながらノックすると、","因为记得前晚的事，\n敲门时莫名有些畏缩，"],["「おっかえりなさ～い。[l]\nどうぞご遠慮なく～」","「欢迎回～家～[l]\n请不用客气～」"],["「……またチノさんですか？[l]\n──ほれ、やっぱり」","「……又是千乃小姐？[l]\n──你看，果然吧」"],["いつもと違う格好──当たり前っちゃ当たり前だが──の、\nチノ嬢が入り口で出迎えてくだすった。[l]\nただやっぱりマスクはしてるんだけども。[l]\nということで当然、先程のは彼女の声帯模写です。","与平日不同的装扮——虽然也是理所当然——\n千乃小姐在门口迎接我。[l]\n不过果然还是戴着口罩。[l]\n所以刚才那声音自然是她的声带模仿。"],["「毎度ご苦労様です……」","「每次都辛苦您了……」"],["「いえいえこの程度。[l]\n御陰様で最近羽目を外す機会が多くて愉快ですよ。[l]\nではどうぞ」","「哪里哪里小意思。[l]\n托您的福最近常有放纵的机会很愉快呢。[l]\n请进吧」"],["部屋の中に入ると、\n宮さんが手をひらひら振って出迎えてくれた。[l]\nチノ嬢は隣に居ますのでと言って、\n襖の向こうに行って、ご丁寧に襖もがっつりお閉めになる。","走进房间，\n宫小姐晃着手向我打招呼。[l]\n千乃小姐说了句\"我在隔壁\"，\n就走到拉门对面，还周到地把门严严实实关好。"],["僕が座に着くと宮さんが口を開いた。","我刚落座宫小姐就开口："],["「さて！[l]\n……なんか久々ですね。","「好啦！[l]\n……感觉好久不见了呢。"],["ちょっとこっちもばたばたしてまして。[l]\n色々放置してて済みませんでした。[l]\n──何か、待ちきれなくて切ない想いをさせちゃってたみたいで」","这边也忙得团团转。[l]\n很多事搁置着真对不起。[l]\n──似乎让你等得心痒难耐了呢」"],["「……細かいニュアンスの差異は兎も角、[l]\nそこは否定しませんよ。","「……细微的语义差别暂且不论，[l]\n这点我不否认。"],["何気に僕ぁ、\nすっかり貴女にいいように調律されてるんですから。[l]\n下僕の身にもなってください」","毕竟不知不觉间，\n我完全被你随心所欲地调教了呢。[l]\n也体谅下仆从的处境吧」"],["「うひひ、\n自覚が出て来たようで何よりですね。[l]\nじゃあ早速御主人様に報告なさい」","「唔嘻嘻，\n能有这份自觉比什么都好。[l]\n那就快向主人汇报吧」"],["……いかん、[l]\nこれは思ったより悪くな……","……不妙，[l]\n这比想象中更糟……"],["いや！[l]\nちが！！[l]\nそんなはず！！！","不对！[l]\n不是！！[l]\n怎么可能！！！"],["げふんげふん。","咳咳。"],["「まず、\n……何でしたっけ？","「首先，\n……说到哪来着？"],["ああ、あの蔵の話からですか？[l]\nそもそもあの紙どうでした？[l]\n役に立ってますんでしょうか」","啊，是从那个仓库的事开始吗？[l]\n话说那张纸怎么样了？[l]\n派上用场了吗？」"],["「そですね。[l]\nだいぶ調べは進んでます。","「是啊。[l]\n调查进展不少。"],["それであの蔵の中、\n前の時は詳しく聞かずに話切り上げちゃったんですが、\n何か、報告するに値する、\nおかしな出来事ありませんでしたか？」","关于那个仓库里面，\n上次没细问就结束话题了，\n有没有什么值得汇报的、\n奇怪的事情发生呢？」"],["「あの……中でですか？[l]\nええーと、\n最近妙に記憶の巡りが良いんで、\nちょっと待ってくださいよ……」","「那个……在里面吗？[l]\n呃——\n最近记忆力出奇地好，\n稍等让我想想……」"],["道中、\nここ最近言ってるような、\nおかしなものを視た気がする。","路上，\n就像最近常说的那样，\n总觉得看到了奇怪的东西。"],["蔵自体が、\n隠し部屋があったりと、飯窪本家の地下と構造が近しかった。","仓库本身\n设有暗室等结构，与饭洼本家地下的构造很相似。"],["インクや墨のにおいがあまりせず、\n古書が集められた空間にしては違和感があった。","几乎没有墨水或墨汁的气味\n作为收藏古籍的空间显得不太协调。"],["冬夏の言から推測して、\n其処には本来、御神体が在ったはずなのに、\n冬夏も知らないうちに移動されていたかも知れない。","根据冬夏的叙述推测\n那里原本应该供奉着神体\n可能是在冬夏不知情时被转移了。"],["そういった事を、\n今までの僕にしては驚異的な記憶の蘇りによって、\n簡略にまとめながら説明、報告していく。","这些事\n凭借我至今为止堪称惊人的记忆复苏\n被简要整理后进行说明汇报。"],["逐一ふむふむ頷く宮さん。","宫小姐全程嗯嗯地点头附和"],["そして、","接着"],["不気味……否、奇妙な鳴き声がした。","响起毛骨悚然……不、诡异的鸣叫声"],["あの事を口にすると、","提起那件事时"],["「それは何か……獣のような？[l]\nそれともヒトのような？」","「那声音像是……野兽？[l]\n还是说更像人类？」"],["と、他と比べてやや大きめのリアクションが返ってきた。","得到了相较他人略显夸张的反应"],["「そうですね、発情期の猫のような、\nヒトみたいな、何とも判別付きかねる声、或いは音でしたね。","「是啊，像发情期的猫一样，\n又像人类似的，难以分辨的声音，或者说声响呢。」"],["冬夏の知る限りじゃ家でも飼ってないそうですから、\n猫だとすれば野良猫、\n違うとしても","据冬夏所知家里应该没养猫，\n如果是猫的话就是野猫，\n如果不是的话"],["逆ＵＭＡ的な何かってことは、あ」","那就是反向UMA之类的存在吧，啊」"],["「？」",""],["「その謎動物で思い出した。[l]\nスナトノホウシの……[l]\nあの神使八乃舞の後片付けの手伝いの報告まだでしたね？」","「说到这个谜之生物想起来了。[l]\n砂户之方石的……[l]\n帮神使八乃舞善后的报告还没交吧？」"],["「んむ、そでしたね。[l]\nあの時はまこくんが冬夏さん同伴で戻って来たのですっかり……","「嗯嗯，是呢。[l]\n那次小真带着冬夏小姐一起回来就完全忘了……"],["ではえーと、\nそのスナトノホウシの手伝いの報告をおし！」","那么呃——\n现在立刻汇报砂户之方石的善后工作！」"],["思い出したようにそんな物言いしなくても……","不用突然用这种命令口气啦……"],["「分かりました御主人様。[l]\nええと」","「遵命主人大人。[l]\n那个——」"],["「あっ！！」","「啊！！」"],["「なっ、なんですか？！」","「怎、怎么了？！」"],["「御嬢様の方が良いかなあ。[l]\nまこくんも執事の方が良くない？[l]\nよくよくない？","「叫大小姐会不会更好点。[l]\n小真也觉得执事称呼更合适吧？[l]\n合不合适嘛？」"],["ぁあっ、そだ！！[l]\nいっそメイドて言う方向もアリか……[l]\nチノをメイド長としてみっちり教育を……うひひひひ」","啊、对啦！！[l]\n干脆往女仆方向考虑也不错……[l]\n让千乃当女仆长好好调教……嘻嘻嘻」"],["女装ネタはもうええちゅうねん。","女装梗已经玩够啦。"],["「……いっそ下僕で、[l]\nもう潔ぎよくそれでお願いします」","「……不如当男仆[l]\n干脆痛快地选这个吧」"],["「あーによー。[l]\nそんな事言われたらこっちも遠慮出来なくなっちゃうし？[l]\n","「啊呀呀。[l]\n被这么说人家可就不客气啦？[l]\n"],["迂","迂"],["闊なことは言わぬが吉ですよー」","话别说太满比较好哦ー」"],["「……どうせ執事でもメイドでも、[l]\nこの場合大して立場が変わらないかと」","「……反正当管家还是女仆[l]\n这种情况下立场都没差吧」"],["「どーゆー意味です？[l]\nあー、宮をそー視てるんだまこくんてば？","「这话什么意思？[l]\n啊ー你原来是这么看宫的吗小真？"],["てか、\nこないだの夜這いといいさっきのお風呂といい、\n宮の知らない内に、\n冬夏さんに言い寄られたりしてたんじゃないのかな？","话说\n上次夜袭也好刚才泡澡也好\n趁宫不知道的时候\n冬夏小姐是不是对你出手了？"],["あの","那个"],["娘ってば結構大胆だし、\n視たところ完全にまこくんに気があるぞと、\nそういうオーラばりばり出してましたけど」","那姑娘可是相当大胆\n看起来完全对小真有意思\n浑身都在散发这种气场呢」"],["「えあ？！[l]\n夜這いなんてされてないです！！[l]\nいやまあ、\nいろいろお話はしたですけど……","「诶啊？！[l]\n才没有被夜袭呢！！[l]\n不是啦那个、\n虽然聊了各种各样的话题……"],["やややや、\n寧ろ貴女が焚き付けたんじゃないんか、って思ってましたが」","呀呀呀呀、\n我反倒觉得是你煽动的呢」"],["「まままま、まー、まー。[l]\n別にね、宮にね、遠慮なんかしなくっても良いのよ？","「嘛嘛嘛嘛，嘛—，嘛—。[l]\n不用啦，对宫不用客气的哦？"],["いっちゃっても良いのよ？[l]\nえっ、いくって言ってもほら、\nまこくんてばっ、なに言わそうとしてるですかもうー」","说出来也没关系的哦？[l]\n诶、就算你让我说那个，\n小真真是的、现在到底想让我说什么啦—」"],["「……なんか","「……总觉得"],["漸くいつも通りの貴女を[l]\n視られた気がしますよ。","终于看到[l]\n平常的你了呢。"],["僕を","只要"],["弄ろうとする意図がぶれてないだけで、\n言ってる内容が完全に支離滅裂です。[l]\n本題にいきましょうよ本題に」","捉弄我的意图没变，\n说话内容完全支离破碎也无所谓。[l]\n快进入正题啦正题」"],["「んむーっ、\n台本ある訳じゃあるまいし、\nリアル会話がそうそう破綻無く成立してる","「嗯唔——\n又不是有剧本的演出，\n现实对话哪能每次都这么顺利成立"],["例なんて無いですよ！","不冷场的啦！"],["あ、こないだ貰ったお土産、\nまだ開けてないので。[l]\n食べましょうか」","啊、之前收到的特产，\n还没开封呢。[l]\n要尝尝吗」"],["「土産、ああ、ねこしっぽ何とかですか」","「特产、啊，是猫尾巴什么的吧」"],["もはやこれは休憩モードですね、\nはいはい開けますよ……ってどこだ？[l]\n冷蔵庫？","这已经完全进入休息模式了呢，\n好啦好啦我来开……话说放哪儿了？[l]\n冰箱？"],["「そですー。[l]\n勝手に持って来ちゃってたですが。[l]\n駄目だったかな？」","「是的—。[l]\n擅自就带过来了。[l]\n不可以吗？」"],["「いえそんなこと、\n全く問題無いです」","「没这回事，\n完全没问题」"],["「うひひ、優しいね」","「呜嘻嘻，真温柔呢」"],["んむ、そんなだから──","嗯唔，所以才会——"],["「んむ？[l]\nいあいあ何も？」","「嗯唔？[l]\n没没没什么？」"],["「あーそうすか。[l]\n最近じゃもう貴女の幻視幻聴やら、\n記憶の侵蝕やらが始まってましてね。[l]\nもう何が現実で何が妄想なんだか……」","「啊—这样啊。[l]\n最近已经开始出现你的幻视幻听，\n记忆侵蚀之类的症状了呢。[l]\n已经分不清什么是现实什么是妄想了……」"],["「うを？！[l]\n","「呜哇？！[l]\n"],["おおう、そそそ、そーか、\nそんなにかー……[l]\nどうしたもんかな」","噢噢，是是是，是这样啊，\n已经到这种程度了吗……[l]\n该怎么办才好」"],["えーとどれだどれだ、\nあ、これか。","呃—哪个来着哪个来着，\n啊，是这个吧。"],["……一応、酒の類は無いな。[l]\nあったら怖ぇけど……[l]\nって、いま何か言ってたか？","……还好没有酒类。[l]\n要是有就可怕了……[l]\n话说，刚才你说什么了？"],["「はい？[l]\n度々申し訳ありませんが、\n包装紙剥いでたんでぜんっぜん聞こえないんすけど。","「嗯？[l]\n虽然屡次抱歉，\n我在撕包装纸完全听不见啦。"],["兎も角、今持っていきますっ……て、[l]\n茶請けだけじゃ駄目っすよねぇ、\nお茶とかどうしますか？」","总之，现在拿过去……啊，[l]\n光茶点不行吧，\n要准备什么茶饮吗？」"],["「んむ、コーヒーくらいは宮が直々に入れたげましょう。[l]\n折角の下僕のお仕事奪うのも気が引けますが、\n","「嗯唔，咖啡就由宫亲自来泡吧。[l]\n虽然抢走仆人的工作有点过意不去，\n"],["有り難く戴くがいいですようひひ♪」","但你就心怀感激地享用吧呜嘻嘻♪」"],["「……砂糖と別の何かをベタに間違ったりしないでくださいよ」","「……请不要把砂糖和其他粉末搞混啊」"],["「んむっ。[l]\nそんな甘味調節なんてセルフでやるでしょ当然でしょぉ？[l]\n味の趣味なんて完璧、人それぞれですもぉん。[l]\nそこの自主性を侵害する女子に視えますぅ？」","「嗯唔。[l]\n那种甜度调节当然要自己动手才对吧啊啊？[l]\n口味偏好可是完美因人而异的啦～[l]\n你觉得我会是侵犯他人自主权的女生吗吗？」"],["……なんかやっぱり、[l]\nそういう台詞を貴女に言われると納得が行かないと言うか、\n素直に『そうは視えません』、とは言い難いなにかが。","……果然，[l]\n这种台词从你嘴里说出来就让人难以信服，\n坦率地说『看起来不像』之类的话总觉得哪里不对劲。"],["「ふんだ。[l]\nいーですよ。[l]\n","「哼。[l]\n饭可以哦。[l]\n"],["まこくんどうせ冬夏さんが居るから宮はどうでもよくなったんだぁー。[l]\nいじいじいじいじいじいじ」","小真反正有冬夏小姐在所以神社怎样都无所谓了啦ー。[l]\n闹别扭闹别扭闹别扭闹别扭闹别扭」"],["「拗ねないでくださいって……","「都说别闹别扭了……"],["まだ冬夏には何もその、返事的な事は言ってないし、\n大体、ここんとこ、\nそっけなかったのはそっちでしょうが、\nその、あ？」","我还没对冬夏说过任何那、回应性质的话，\n说到底，这段时间，\n态度冷淡的明明是那边吧，\n那个，啊？」"],["「……にひひ」","「……嘻嘻」"],["何をどうとは判らねども、\nどうも墓穴を掘った気分に！","虽然搞不清具体怎么回事，\n总觉得像是自掘坟墓了！"],["あくまで気分ですよ、だって墓穴を掘るって事は、\nこの場合は……","只是感觉啦，因为所谓自掘坟墓，\n这次的情况是……"],["「にひひひひ♪」","「嘻嘻嘻嘻♪」"],["「なんすかその笑いは。[l]\n……ああもうとっとと続きしますよ。[l]\nはいこれ、じゃコーヒーお願いしますからっ」","「这笑声几个意思。[l]\n……啊啊够了赶紧继续吧。[l]\n给这是咖啡拜托了啦」"],["「はぁーい旦那様♪\nちょっと待ってねー」","「好ー的老爷♪\n稍等一下下ー」"],["今度はそっちがメイド？","这回轮到那边当女仆？"],["──なんだろう。[l]\n少し前までは、こういう距離が当たり前だったような、\nいや、そんなに知り合ってから長い訳でも無かろうに、","──搞不懂。[l]\n就在不久前，这种距离感还理所当然似的，\n不，明明相识也没那么久，"],["でも、\nこんなやりとりでも、\nちょっとの間でも出来なかったときは、\n何故か、","但是，\n就连这样的对话，\n短暂中断的时候，\n不知为何，"],["……まあ、なんだってそうだろう。そうだよな。[l]\n別にあのひとに限った訳じゃ──","……嘛，凡事都这样吧。是啊。[l]\n倒也不是仅限于那个人──"],["「──で、本題です。[l]\nスナトノホウシに向かう途中、\nあの彼女等の斎場とかいう私有地だったかな？","「──那么进入正题。[l]\n前往砂户星途中，\n经过她们那个叫斋场的私有地来着？"],["その山道の中でですね、\nでっかい獣らしきものが車の上にどすっと」","在那段山路上啊，\n有只巨型野兽模样的东西咚地砸在车顶上」"],["「……んむ？[l]\nケモノ？？」","「……嗯？[l]\n野兽？？」"],["コーヒーカップを２つ持って来た宮さんが自分と僕の前に\nそれを置きながら疑問符を投げかけた。","端着两个咖啡杯的宫小姐在我和真面前\n放下杯子的同时抛出疑问。"],["「結局何だか分からなかったんですが、\n少なくともヒトかそれ以上の重量を持ったものが、\n車の天井に落ちてきて、それで」","「最后也没搞清是什么，\n但至少是人或更重的物体，\n落在车顶上，然后」"],["「視なかったんですか？」","「没看见吗？」"],["土産物を食べ始めた僕に対し、\n詰問するように宮さんが言う。","对着开始吃土特产的我，\n宫小姐质问道。"],["「や、だって僕運転してましたから。[l]\n突然上がだんって鳴って、\nすぐそれもどっかに飛んでったらしく居なくなったんですよ。[l]\nそしたら」","「哎，因为我在开车嘛。[l]\n突然车顶咚地巨响，\n那东西好像马上又跳到别处消失了。[l]\n之后」"],["「綾目と狩屋が追跡でも？[l]\n奇士もかな？」","「绫目和狩屋去追踪了？[l]\n奇士也去了？」"],["「は？[l]\nあ、いえ、ほんとにそうです、\n奇士……道具さんは僕と車に居ましたが、[l]\n２人はそれを追いに出て行きました。","「哈？[l]\n啊不，确实如此，\n奇士……道具小姐留在车里，[l]\n但那两人追出去了。"],["それがよくわからんのですが、\nあの２人は、『その為』に居るとかなんとか──」","虽然不太明白，\n那两人说是『为此而来』什么的──」"],["「………２人は無事に戻って来た？[l]\nでしょうね」","「………两人平安回来了？[l]\n应该吧」"],["「え？[l]\nええ、逃げられたとかで、\nその後は普通にその斎場まで、\n何事もなく。","「诶？[l]\n嗯，说是被逃掉了，\n之后正常抵达那个斋场，\n平安无事。"],["僕は心配でしたが、\n彼女等にとっては何か当然みたいな振る舞いしてたので、\nそんなに深刻じゃないのかと、それに」","虽然我很担心，\n但她们表现得像是理所当然的事一样，\n所以我想或许没那么严重吧，而且」"],["「それに？」","「而且？」"],["「ほんとかどうか疑問に思う点が無いでも無いですが、\nこれもつい","「虽然也不是完全没有怀疑真假的地方，\n这个也是"],["刻眼が醒めた直後の話ですけど、","刚在刻眼觉醒后不久的事，"],["奇士道具さんからリーク情報で、\n月末の祭は、\n予定通り行われると。","从奇士道具小姐那里得到的情报说，\n月底的祭祀，\n会按计划举行。"],["その理由が、その時遭遇したケモノがどうやら熊とか何とかで、\nその死骸があげられたからだって言うんですね。[l]\n実際狩ったのかな？[l]\nそこまでは聞いてなかったような」","理由好像是当时遇到的怪物是熊什么的，\n说是把那具尸体献祭就行了。[l]\n实际上真的猎到了吗？[l]\n这倒没听说」"],["「……んむ。[l]\nなるほどね……同行したまこくんにそれを言うか……[l]\nどういう了見だろうな……？」","「……嗯。[l]\n原来如此……居然对同行的小真说这种话……[l]\n到底打的什么主意呢……？」"],["「……？[l]\n宮さん？」","「……？[l]\n宫小姐？」"],["「んむ？[l]\nなんでもないですよぉ。[l]\nそか、なるほどなるほど」","「嗯？[l]\n没什么啦。[l]\n这样啊，原来如此原来如此」"],["……？",""],["祭がどうあれ強行されるだろうと言ってたのは、\n確か宮さんじゃなかった？[l]\n別のひとだっけか？","之前说不管祭祀如何都会强行举行的，\n我记得不是宫小姐吗？[l]\n还是说是别人来着？"],["「んむ、\nじゃあそろそろ覚悟決めて貰おうかなあ」","「嗯，\n那差不多该让你做好觉悟了吧」"],["そだな、現状いくつか選択肢があるから……","是啊，现状有几个选择……"],["まだ完全ではない、\n僕の記憶領域の曖昧な働きを余所に、\n宮さんは確かに今そう言った。","虽然还不完全，\n抛开我记忆区域模糊运作的问题，\n宫小姐刚才确实这么说了。"],["「はあ。[l]\nいくつか」","「哈啊。[l]\n几个」"],["幸か不幸か、順調に仲良く……というか交流は深まってるけれど、[l]\n肝心の所には今ひとつ近づいてないというか、","幸运还是不幸，虽然顺利变得友好……或者说交流加深了，[l]\n但关键部分总觉得还差一步，"],["その、蔵の紙の調査は進んでるようだが、\n最も対象に近いはずの冬夏でも分からない以上、\n最早祭の当日、祭儀に潜入以外ないんではなかろうか。","那个，仓库纸张的调查似乎有进展，\n但既然连最接近对象的冬夏都不明白，\n恐怕只能在祭祀当天潜入仪式了吧。"],["「まあ、今日話を聞いて、あ、蔵の中とかのです、\n大体視えては来てるんですけどね。","「嘛，今天听了些话，啊、关于仓库里的那些，\n大体上已经能看出来了。"],["んむー、\n一番愉快そうなのはぁ、\n冬夏さんを完全に懐柔……てゆうか、[l]\nまあ","嗯——，\n最愉快的办法嘛，\n完全笼络冬夏小姐……或者说，[l]\n嘛"],["娶っちゃえば一発で解決？","直接娶进门不就解决了？"],["あ、ちがうか、婿入りしなきゃ駄目だ。[l]\n三春真言、ＭＭ……ぷひひっ、","啊、不对，必须得入赘才行。[l]\n三春真言，MM……噗嘻嘻，"],["……ってごめごめ、[l]\nまこくんの気持ちってものもあるしねー。[l]\nわかってるってば、そんな眼で視ないでよぉ」","……啊抱歉抱歉，[l]\n也得考虑小真的心情呢。[l]\n都说了我明白啦，别用那种眼神看我嘛」"],["「いや別に僕おかしな眼で視た覚えはないですが……[l]\n僕のよりも冬夏の気持ち考えてあげてください、\nあんな事さしたり、\n彼女も家庭の事情で色々悩んでるんですから……」","「不我倒不记得用奇怪的眼神看过你……[l]\n请多考虑冬夏的心情吧，\n做那种事的话，\n她也因为家庭问题有很多烦恼……」"],["それに、","而且，"],["貴女は僕の気持ちなんか、全然わかってないですよ。","你根本不懂我的心情。"],["全然わかってない……","完全不懂……"],["「んむー、\nまこくんってばお真面目さんだなぁ。","「嗯——，\n小真真是个认真的人呢。"],["ま、実際、今ばたばたしてますのはね、\n『こっち側』の事情が少々動いてまして、\nそっちの調整なんですよね。","嘛，实际上现在手忙脚乱是因为，\n『这边』的情况有些变动，\n正在做那边的调整。"],["だから取り敢えずまこくんは明日西石さんとやら……[l]\n……ニシイシ？」","所以总之小真明天先和西石小姐什么的……[l]\n……西石？」"],["「え？[l]\nああ、そうです、きぃの快気祝いの名目で飯奢ってきたり」","「咦？[l]\n啊啊、是的、以小贵的康复庆祝为名义让饭请客来着」"],["………？",""],["なんだこの","这算什么"],["間は？","间隔？"],["「………きぃ、[l]\nをつけて行ってきてね？[l]\n","「………小贵、[l]\n要带着去哦？[l]\n"],["呉","吴"],["呉も油断しないように」","吴也别忘了保持警惕」"],["「油断て……[l]\nまあ、確かに油断したら飯代だけで幾ら飛ぶか分かんないですけど、\n無い袖は振れないという奴でそこは何とか」","「警惕啊……[l]\n嘛、确实要是大意的话不知道饭钱会飞走多少、\n但巧妇难为无米之炊这点还请多包涵」"],["「そんなに食べるひと？[l]\n女子で？」","「这么能吃的人？[l]\n女生吗？」"],["「言ってませんでしたっけ。[l]\nそうですよ。[l]\n","「我没说过吗。[l]\n是的哟。[l]\n"],["今日","今天"],["日珍しくないでしょ、\n女子の大喰いなんて……」","不算稀奇吧、\n女生的大胃王什么的……」"],["「それもそうですねぇ。[l]\nんむ。[l]\n──じゃ、色々詳細が決定していくのは多分、\n週明け以降になると思うので」","「这么说也是呢。[l]\n嗯呣。[l]\n──那、各种细节确定大概要\n等到下周之后了」"],["今日はゆっくりお休みなさい。","今天就好好休息吧。"],["「……今からでも僕、[l]\n部屋に戻りましょうか？[l]\n何か調子も戻って来たし……その……」","「……现在开始我也、[l]\n回房间比较好吧？[l]\n状态好像也恢复了些……那个……」"],["「いーのいーの、\n上司として部下の体調の経過観察をですね、\nん？[l]\n体調管理？","「不用啦不用啦、\n作为上司要对下属的身体状况进行后续观察呢、\n嗯？[l]\n健康管理？"],["まーどっちでもいいですね。[l]\nそういうことで。[l]\n良いですよ、今晩は泊まってって」","嘛——怎样都行啦。[l]\n就这么说定了。[l]\n可以哟、今晚就住下吧」"],["「普通の会社でもそんな管理はしないような気が、\nしないでもないですが……」","「普通公司应该不会做这种管理吧、\n虽然也不是完全没有……」"],["「女子が今夜は泊まってって言ってるんだからぁ、\n大人しく泊まってけばいいんです。[l]\n将来ほんと苦労するよまこくん。","「女生都说今晚住下来啦、\n乖乖留下就好。[l]\n将来真会吃苦头的哦小真。"],["あ、丁度胃に物が入ったところで、\n風邪薬も念のため、はい。[l]\nもう歯磨いた？[l]\nお布団は……チノ？」","啊、正好胃里有东西了、\n感冒药也以防万一、给。[l]\n刷牙了吗？[l]\n被子……千乃？」"],["「用意は出来てます。[l]\n今問われるより","「已经准备好了。[l]\n与其现在被追问"],["遡ること……否、[l]\n止しましょう具体的な時間経過を言うのは。[l]\nそれよりワタシもその土産物のお相伴にあずかりたく」","不如追溯……不、[l]\n具体时间流逝还是别说了。[l]\n比起那个我也想分享那些伴手礼呢」"],["いきなり宮さんが隣室に声を掛けると、\n音もなく襖が開きチノ嬢がそう言った。","宫小姐突然向隔壁搭话时、\n纸门无声滑开、千乃小姐这么说道。"],["そ、そう言えば\nい、居たんでしたね？[l]\nずっとそこに。","这、这么说来\n你、你一直在啊？[l]\n始终在那里。"],["土産をまず所望するとは、\n結構お腹が空いてたのか……[l]\nそんなに話し込んでたのか僕等。","首先索要伴手礼、\n看来相当饿了呢……[l]\n我们居然聊了这么久吗。"],["「あっと、寝る前に冬夏に明日の確認取らねばですよ」","「啊对了、睡前要和冬夏确认明天安排才行」"],["「んむ、\n冬夏さんが寝ちゃう前にどぞ。","「嗯呣、\n趁冬夏小姐还没睡快去吧。"],["まあこの部屋で寝るとは──\n言わない方が良いでしょうねえ流石に。[l]\n宮も彼女に申し訳ないしー」","不过在这个房间睡觉什么的——\n还是别说为妙吧果然。[l]\n宫也觉得对不起她嘛—」"],["今更何を……というよりですね、[l]\n僕だって自分から言う気は毛頭無いです。","事到如今还……不如说、[l]\n我压根也没打算主动提啦。"],["貰った風邪薬を飲む。[l]\nチノ嬢は自分でコーヒーをいれ、\n例の土産を食そうとして、\nふと気付いたようにこちらを視た。","把收到的感冒药喝了。[l]\n千乃小姐自己泡了咖啡，\n正打算吃那个伴手礼时，\n突然注意到似地看向这边。"],["「──ああ、\nマスクの下、視たいですか？」","「──啊啊，\n是想看口罩下面吗？」"],["「へ？[l]\nああ、いえ、そんな、\n特に、というか、積極的に視たいとまでは……」","「诶？[l]\n啊、不、那个，\n倒也不是特别、或者说并没有积极想看到那种程度……」"],["まあ、そのまま視てれば、\n食べる時外すであろうマスクの下は視られたんだろうが、\n今言ったようにそこまで気になってる訳じゃないし……[l]\n何よりもその、何か視てはいけないものの気がする……","不过要是继续盯着看的话，\n待会她吃东西摘下口罩时就能看到了吧，\n但就像刚才说的其实也没在意到那种地步……[l]\n更重要的是总觉得、看了什么不该看的东西似的……"],["「そうですか……それは残念」","「这样啊……真遗憾」"],["「あ、じゃあ僕は冬夏に連絡してきますのでごゆっくり……」","「啊、那我去联系冬夏你们慢慢聊……」"],["視ないでいるのも不自然で疲れそうなので、\n部屋から出ることにした。","一直刻意回避视线反而显得不自然又累人，\n于是决定先离开房间。"],["──電話したら冬夏はもうかなり眠そうだったが、\n明日の予定については確認出来た。","──打电话时冬夏已经困得不行，\n不过明天的安排总算确认好了。"],["その眠気の御陰か、今夜は会話もあっさり切り上げられて、\n若干の、若干のだが、肩すかし感を覚えつつ、\n部屋に戻……ろうとして、","托这股睡意的福，今晚的对话也很快结束，\n带着些许、真的只是些许的落空感，\n正要回房……"],["一応チノ嬢が食べ終わってそうな頃合いを見計らう為、\n５分ほどうろうろする。","为了等千乃小姐差不多吃完的时机，\n在走廊晃悠了五分钟。"],["「おかいもんー、\nもういつでも寝られるよぉー。[l]\n歯磨き忘れずにねー」","「买完东西啦—\n随时都可以睡了哟—[l]\n别忘了刷牙呀—」"],["部屋に戻るとそう言われた。[l]\n幸いチノ嬢は既に食し終え、マスクも再装着済。","回到房间时听到她这么说。[l]\n幸好千乃小姐已经吃完，口罩也重新戴好。"],["「歯ブラシとか、\nこの部屋でも僕の分残ってます？」","「牙刷之类的，\n这个房间还备着我的份吗？」"],["「問題は無いです。[l]\nワタシは自分の部屋より確保してますので」","「没问题。[l]\n我从自己房间多拿了一套过来」"],["「わかりました……では準備しますー」","「知道了……那我去准备—」"],["時間を稼いだ所為か、風邪薬が良い具合に効き始めて、\nすぐにも眠れるモードに。","或许因为拖延了时间，感冒药开始恰到好处地生效，\n立刻进入了昏昏欲睡的状态。"],["或る意味幸いだろう、\nこの状況で眼が冴えるよりはいい。[l]\n……コーヒーの後で薬ってよくよく考えるとどうだ。","某种意义上算是幸运吧，\n总比在这种情形下精神亢奋要好。[l]\n……喝完咖啡再吃药仔细想想真的没问题吗。"],["歯磨きを終え用を足し、\n２人に就寝の挨拶をする頃には、\nもうすっかり朦朧としだしていた。","刷完牙解决完生理需求，\n向两人道晚安的时候，\n意识已经彻底朦胧了。"],["ぎりぎりに保った理性で、\n明日の約束の時間に間に合う目覚ましアラームを設定、","用最后残存的理性，\n设好了能赶上明天约定时间的闹钟，"],["かつ２人にその了解を得、\n布団に入ると、\n宮さんが電気を消してくれた。","并征得她俩同意后，\n刚钻进被窝，\n宫就帮我关了灯。"],["「では……[l]\nおやすみなさい……」","「那么……[l]\n晚安……」"],["\n心地よい浮遊感と共に、[l]\n\n眠りへ落ち行く意識のはしっこに、[l]\n\n何かことばがきこえていたような、","\n伴随着舒适的漂浮感，[l]\n\n在坠入梦乡的意识边缘，[l]\n\n似乎听见了什么话语，"],["\n──ね、\n\nまこくんは私の下で働けるの、嬉しい？[l]\n\n今のこういう感じって嬉しい？[l]\n\n私のこと●●？[l]\n\nほんとうに、●●？●●？●●●●？[l]\n\n偽りナく──？","\n「呐，\n\n小真能在我手下工作很开心吗？[l]\n\n现在这样的感觉喜欢吗？[l]\n\n你●●我吗？[l]\n\n真的、●●？●●？●●●●？[l]\n\n没有说谎──？」"],["\nぼくは、[l]\n\nへんじをすることもままならず、[l]\n\n\nみやさんのこえに……まさかチノ……てことはないよな……","\n我，[l]\n\n连回答都做不到，[l]\n\n\n被宫的声音……该不会是千乃……不可能吧……"],["\n\nつつまれて……","\n\n包裹着……"],["\n\n\nあんし……てねむ……","\n\n\n安心……地睡去……"]],"context":[["SC_M_044.ks/index/1/text"],["SC_M_044.ks/index/4/text"],["SC_M_044.ks/index/6/text"],["SC_M_044.ks/index/8/text"],["SC_M_044.ks/index/10/text"],["SC_M_044.ks/index/12/text"],["SC_M_044.ks/index/14/text"],["SC_M_044.ks/index/16/text"],["SC_M_044.ks/index/19/text"],["SC_M_044.ks/index/21/text"],["SC_M_044.ks/index/23/text"],["SC_M_044.ks/index/25/text"],["SC_M_044.ks/index/27/text"],["SC_M_044.ks/index/29/text"],["SC_M_044.ks/index/31/text","SC_M_044.ks/index/686/text"],["SC_M_044.ks/index/33/text"],["SC_M_044.ks/index/35/text"],["SC_M_044.ks/index/37/text"],["SC_M_044.ks/index/39/text"],["SC_M_044.ks/index/41/text"],["SC_M_044.ks/index/43/text"],["SC_M_044.ks/index/45/text"],["SC_M_044.ks/index/47/text"],["SC_M_044.ks/index/49/text"],["SC_M_044.ks/index/51/text"],["SC_M_044.ks/index/53/text"],["SC_M_044.ks/index/55/text"],["SC_M_044.ks/index/57/text"],["SC_M_044.ks/index/59/text"],["SC_M_044.ks/index/61/text"],["SC_M_044.ks/index/63/text"],["SC_M_044.ks/index/65/text"],["SC_M_044.ks/index/67/text"],["SC_M_044.ks/index/69/text"],["SC_M_044.ks/index/71/text"],["SC_M_044.ks/index/73/text"],["SC_M_044.ks/index/75/text"],["SC_M_044.ks/index/77/text"],["SC_M_044.ks/index/79/text"],["SC_M_044.ks/index/81/text"],["SC_M_044.ks/index/83/text"],["SC_M_044.ks/index/85/text"],["SC_M_044.ks/index/87/text"],["SC_M_044.ks/index/89/text"],["SC_M_044.ks/index/91/text"],["SC_M_044.ks/index/93/text"],["SC_M_044.ks/index/95/text","SC_M_044.ks/index/765/text"],["SC_M_044.ks/index/97/text"],["SC_M_044.ks/index/99/text"],["SC_M_044.ks/index/101/text"],["SC_M_044.ks/index/103/text"],["SC_M_044.ks/index/105/text","SC_M_044.ks/index/380/text","SC_M_044.ks/index/484/text"],["SC_M_044.ks/index/107/text"],["SC_M_044.ks/index/109/text"],["SC_M_044.ks/index/111/text"],["SC_M_044.ks/index/113/text"],["SC_M_044.ks/index/115/text"],["SC_M_044.ks/index/117/text"],["SC_M_044.ks/index/119/text"],["SC_M_044.ks/index/121/text"],["SC_M_044.ks/index/124/text"],["SC_M_044.ks/index/127/text"],["SC_M_044.ks/index/129/text"],["SC_M_044.ks/index/131/text"],["SC_M_044.ks/index/133/text"],["SC_M_044.ks/index/135/text"],["SC_M_044.ks/index/137/text"],["SC_M_044.ks/index/139/text"],["SC_M_044.ks/index/141/text"],["SC_M_044.ks/index/143/text"],["SC_M_044.ks/index/145/text"],["SC_M_044.ks/index/147/text"],["SC_M_044.ks/index/149/text"],["SC_M_044.ks/index/151/text"],["SC_M_044.ks/index/154/text"],["SC_M_044.ks/index/156/text"],["SC_M_044.ks/index/158/text"],["SC_M_044.ks/index/160/text"],["SC_M_044.ks/index/162/text"],["SC_M_044.ks/index/164/text"],["SC_M_044.ks/index/167/text"],["SC_M_044.ks/index/169/text"],["SC_M_044.ks/index/171/text"],["SC_M_044.ks/index/173/text"],["SC_M_044.ks/index/175/text"],["SC_M_044.ks/index/177/text"],["SC_M_044.ks/index/179/text"],["SC_M_044.ks/index/181/text"],["SC_M_044.ks/index/183/text"],["SC_M_044.ks/index/185/text"],["SC_M_044.ks/index/187/text"],["SC_M_044.ks/index/189/text"],["SC_M_044.ks/index/191/text"],["SC_M_044.ks/index/193/text"],["SC_M_044.ks/index/195/text"],["SC_M_044.ks/index/197/text"],["SC_M_044.ks/index/199/text"],["SC_M_044.ks/index/201/text"],["SC_M_044.ks/index/203/text"],["SC_M_044.ks/index/205/text"],["SC_M_044.ks/index/207/text"],["SC_M_044.ks/index/209/text"],["SC_M_044.ks/index/211/text"],["SC_M_044.ks/index/213/text"],["SC_M_044.ks/index/215/text"],["SC_M_044.ks/index/217/text"],["SC_M_044.ks/index/219/text"],["SC_M_044.ks/index/221/text"],["SC_M_044.ks/index/223/text"],["SC_M_044.ks/index/225/text"],["SC_M_044.ks/index/227/text"],["SC_M_044.ks/index/229/text"],["SC_M_044.ks/index/231/text"],["SC_M_044.ks/index/233/text"],["SC_M_044.ks/index/235/text"],["SC_M_044.ks/index/237/text"],["SC_M_044.ks/index/239/text"],["SC_M_044.ks/index/241/text"],["SC_M_044.ks/index/243/text"],["SC_M_044.ks/index/245/text"],["SC_M_044.ks/index/247/text"],["SC_M_044.ks/index/249/text"],["SC_M_044.ks/index/251/text"],["SC_M_044.ks/index/253/text"],["SC_M_044.ks/index/255/text"],["SC_M_044.ks/index/257/text"],["SC_M_044.ks/index/259/text"],["SC_M_044.ks/index/261/text"],["SC_M_044.ks/index/263/text"],["SC_M_044.ks/index/265/text"],["SC_M_044.ks/index/267/text"],["SC_M_044.ks/index/269/text"],["SC_M_044.ks/index/271/text"],["SC_M_044.ks/index/274/text"],["SC_M_044.ks/index/276/text"],["SC_M_044.ks/index/278/text"],["SC_M_044.ks/index/280/text"