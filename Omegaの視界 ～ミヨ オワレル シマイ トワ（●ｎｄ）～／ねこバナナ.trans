30665,"end":30676}],[{"start":30694,"end":30711}],[{"start":30752,"end":30758}],[{"start":30810,"end":30848}],[{"start":30854,"end":30872}],[{"start":30878,"end":30897}],[{"start":30907,"end":30921}],[{"start":30952,"end":30962}],[{"start":31024,"end":31037}],[{"start":31068,"end":31100}],[{"start":31130,"end":31140}],[{"start":31171,"end":31241}],[{"start":31316,"end":31371}],[{"start":31377,"end":31414}],[{"start":31420,"end":31458}],[{"start":31464,"end":31540}],[{"start":31550,"end":31577}],[{"start":31583,"end":31610}],[{"start":31670,"end":31685}],[{"start":31719,"end":31749}],[{"start":31780,"end":31801}],[{"start":31831,"end":31866}],[{"start":31900,"end":31941}],[{"start":31969,"end":32023}],[{"start":32048,"end":32094}],[{"start":32104,"end":32107}],[{"start":32121,"end":32129}],[{"start":32173,"end":32204}],[{"start":32232,"end":32329}],[{"start":32359,"end":32418}],[{"start":32449,"end":32475}],[{"start":32503,"end":32508}],[{"start":32517,"end":32518}],[{"start":32528,"end":32556}],[{"start":32616,"end":32648}],[{"start":32682,"end":32705}],[{"start":32736,"end":32791}],[{"start":32850,"end":32863}],[{"start":32894,"end":32944}],[{"start":32972,"end":33075}],[{"start":33135,"end":33179}],[{"start":33213,"end":33263}],[{"start":33318,"end":33410}],[{"start":33441,"end":33498}],[{"start":33528,"end":33536}],[{"start":33556,"end":33589}],[{"start":33620,"end":33654}],[{"start":33684,"end":33708}],[{"start":33746,"end":33768}],[{"start":33774,"end":33795}],[{"start":33805,"end":33809}],[{"start":33819,"end":33828}],[{"start":33834,"end":33845}],[{"start":33855,"end":33868}],[{"start":33878,"end":33882}],[{"start":33892,"end":33898}],[{"start":33933,"end":33965}],[{"start":33995,"end":34000}],[{"start":34031,"end":34038}],[{"start":34066,"end":34095}],[{"start":34160,"end":34187}],[{"start":34215,"end":34314}],[{"start":34344,"end":34384}],[{"start":34415,"end":34452}],[{"start":34482,"end":34505}],[{"start":34533,"end":34545}],[{"start":34576,"end":34598}],[{"start":34628,"end":34634}],[{"start":34662,"end":34705}],[{"start":34715,"end":34722}],[{"start":34728,"end":34734},{"start":34905,"end":34911}],[{"start":34744,"end":34753},{"start":34921,"end":34930}],[{"start":34763,"end":34772},{"start":34940,"end":34949}],[{"start":34778,"end":34854}],[{"start":34864,"end":34879}],[{"start":34889,"end":34895}],[{"start":34955,"end":34965}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_057.ks","basename":"SC_M_057.ks","indexIds":{"あんな粗食ですら僕を眠りに誘うには十分だったらしく、\n昨日のその食事からは記憶が曖昧だった。[l]\n血が一気に下に行くような感覚と共に、\n強烈な眠気とだるさ、\nそれでいて頭に広がる妙な充足感……[l]\n……それはきっと緊急回避的な、[l]\n現実逃避の一種でもあるのだろうけれど、\n兎も角僕はかなりの時間寝入っていたらしい。[l]\n先日もかなりの時間寝過ごしたりしたが、\nああいうのや今回のようなのは、\n基本的に余程無茶した時の筈で、\n大抵は体感時間よりも短い時間であることの方が多い……[l]\nだから、\nやっぱり、\n余程の場合なんだろう……今の僕は。":0,"やはり全く覚えてないのだけれど、\n後部座席に移って寝ていたらしい。[l]\nスモークガラスである所為か、\n瞬時に時間と天候が把握出来ない。":1,"苦労して半身起こし……て、あれ、":2,"「ででで……んあ゛……ぐぐ」":3,"お、重いというか、だるいというか、\n":4,"「……う゛あ……、はぁ……[l]\n………いてててて」":5,"身体の節々が痛いが、\n":6,"「首は…無事……ぽいな」":7,"はあ……まあ、[l]\n寝違えてないのは幸いだった。[l]\n今そんな事になってたら、\n色んな意味で地味に厳しい……":8,"「……何時だ？[l]\n今……」":9,"携帯電話で確認すると、\n既に狩屋との約束の時間になっていた。":10,"ああ、\nこれの充電も、どうしようか……[l]\n今の処はまだゲージあるけども、\n……単に待機状態ならまだしも、[l]\n結構通話とかで使ってるし、\n":11,"コンビニ……に電池充電とか、[l]\nそういうのあったっけっか……":12,"まあ、\n待ち合わせのバスも来るし……[l]\nバス停近くに何か店でも、\nあったかな……？":13,"コンビニに行くなんて、\n夕べはその余裕……というか気力が無かったのは確かだし、[l]\n今もまだ、\n他人と接触するのには少し抵抗ある、のは確かだけど……":14,"ああ、もう、\n卑近でリアルな問題と、\n大仰で現実味のない問題が脳内に並列して存在してると、\n気が遠くなるというか、\n分裂しそうというか、\nスケール感とか深度がわやくちゃになって、\n":15,"「……まあ、[l]\n狩屋と会った後で考えよう……」":16,"思考は結局その辺で落ち着いてしまう。[l]\n良いのか悪いのか、\nそれこそさっぱりだけども、\n":17,"「……まずは……[l]\nそのバス停か……[l]\n乗る人と間違われないように……[l]\nしないと……」":18,"……そういうことには頭回るんだよなぁ、[l]\nやっぱり……":19,"でも、\n":20,"正直なところ自分がナニでナニをしてるのか、\n苛まれるよりは、\n":21,"──だからそれすらも単なる逃避の結果だと、\n":22,"でもそれでは駄目だという、\nクソ真面目な意思が強固に巣くうこの、\nしこう、\n":23,"──何度●ったらワカル。":24,"「っ、おわ？！[l]\nび、吃驚した……」":25,"次のバス停で着くとこまで来た、\nとメールが来た。":26,"………。":27,"「……律儀なやつ……なんだよな彼奴は……」":28,"身支度をして、\n車を降りる。":29,"……外に出ると、身体が震えた。":30,"バスは平日の昼間だし、\n地域的なものなんだろうが、\n殆ど客が乗ってないであろう事は容易に想像でき、\n故に矢張り迂闊にバス停近くに立ってるのは憚られた。[l]\n……ベンチとかあれば、[l]\nがっつり座り込んで乗らない意思を主張出来たんだろうけど、\n残念ながら此処は単に、\n時刻表──殆ど空欄──の付いた例の看板が立ってるだけだ。":31,"不自然でない程度に、\nかつ明確に乗る意思が無いのを態度で主張しつつ、\n近辺をうろうろしていると、\nそう時を開けずにバスがやってきて停車場で止まった。[l]\nバス停には誰一人として乗り待ちの客は居なかったし、\n僕が客と間違われたのでない限り、\n降りる客が居るのだろう。[l]\nつまり、\n":32,"「……おひさし」":33,"狩屋が降りてきたのだった。":34,"他に誰も降車する客は居らず、\n僕の事も、\n彼女を出迎えた人間と了解したのだろう、\nバスはそのまま走り去っていく。":35,"「お゛う……」":36,"「にょえあ……」":37,"歩み寄って挨拶すると、\nお互いにいがらっぽい声だった。":38,"「……風邪でも引いたのか？」":39,"僕の方は、\nまあ、あの時からの自分を取り巻く状況の事もさることながら、\n実際『寝り』の体勢とか環境が影響してるんだろうが。[l]\n流石に夕べは──\n例え給油とかででも余計な人との接触を避けたかったので──\n車中もエンジンかけなかったし、\nそれで多少寒かったような気もするけど、\n狩屋が風邪引く程だったかどうか、\nそれは分からない。":40,"「え、そんにゃに声変？[l]\n":41,"……別に風邪じゃにゃいけど、[l]\n":42,"ま、寒いは寒いかもにぇ……特に夕べから今は……[l]\n":43,"ん、ういは大丈夫だよ。[l]\n":44,"あんまし寝てにゃいだけ」":45,"そうだったのか……[l]\nあんなあっさり眠りに落ちるとも思わなかったし、\n冬場だったら危険だったかも知れない。":46,"何にせよ、\n風邪じゃなくたって、\n……様子は確かにおかしいし、[l]\nああ、あまり寝てないって言ったか。[l]\nそもそも今回会おうという話も、\n決して愉しい中身じゃないんだろうから、\nこのテンションも不思議ではないんだろう。":47,"やるせなくなって、\n兎に角コトバを発しようとする僕。":48,"「おひさしっていうか、\nなんか……久しぶりなのかどうなのか、[l]\nよくわかんなくなってるよ……[l]\nまあ、どっちでもいいんだけどさ……」":49,"「ぬ、どうにゃっけ……？[l]\nういもよくわかんにゃい」":50,"実際は、\n出会い頭にいきなり、\nテンションギアマックスの方が不自然だろうけども、\n……要するに僕等はやっぱりぎくしゃくしたまんまで、[l]\n会話もそこで途絶えてしまった。":51,"そのまま数秒、\n変な距離を……精神的にも肉体的にも、[l]\nおいて、微妙に探り合う感じのおかしな空気が流れる。":52,"お互いに視線を合わせないまま。":53,"「………」":54,"折角昨日復調しかけたと思った僕も、\n人と接触しないまま一晩のインターバルは、\n思いの外に、\n浮かれた感じを冷却してしまった……らしい。":55,"均衡を保とうとした結果、\nつまり感情落差を早く埋めようと、\n無意識にでも、必要以上にクールダウンしたということなのか、\nこんな事も今までに経験無い訳じゃなかったけど、\n":56,"というよりそれ以前に僕等、\nこの二人という組み合わせの違和感というか……[l]\n今までは狩屋と姫様ちゃんは常にセットだったし、\nこの場に僕と狩屋だけ、というのは、\n":57,"「ん゛っ、んんっ」":58,"無意味に咳き込む。[l]\n間が持たない。[l]\n空気を悪くしたい訳じゃないので、\n何とかしたいとは思ってるのだが、\nそれがまたプレッシャーになるっていうか、\nそして彼女からも同様のオーラがばりばり放出されてるし、\n":59,"「んー、\nんー、\n………」":60,"………。[l]\nまあ、\nそうでなくても、\n多分、\nお互いここに来るまで、\n誰とも喋らずにずっと黙っていたのだろう。[l]\n先刻の声の出し方は要するにそういう事だったのかと思う。":61,"「えーーと、\nその、………、[l]\nあのね」":62,"「……あのさ、[l]\nえあ？」":63,"やっと口火を切ろうと決意したのはいいけれど、\n再び発言のタイミングがモロ被りする僕等。":64,"「にゃにゃにゃ、\nにゃんだべさ？」":65,"「いいいいや、その、\nどうぞそっちが、\nてか僕等なんかあれだな？[l]\nいつもこんなだな？[l]\n何してんだか……あはは……」":66,"「はっ、ははあはげほげほげほ、\nどっ、どう、え？[l]\n":67,"ちょ、ごめ、\nえふえふえふっ」":68,"「む、無理しなさんな、\n落ち着け、\nなんかしらんけど悪かった、\nほれ、な？」":69,"「い、いあ、\nこちらこそ、\nちょ、ちょっとまってごめんなさい、\nはぁあぁ～～～……[l]\nひぃいぃ～～～……」":70,"「ん、思う存分深呼吸してくれ……[l]\n……僕もしとくか……[l]\nはぁ……」":71,"ま、まあ、\n出だしさえ何とかすれば、\n相変わらず視線を合わせないままではあるけど、\n":72,"漸く場が暖まってきたと言うか、\nなんか、\n良いのか悪いのか、\n此奴と話してると何故か頭は活性化する……んだよな。[l]\nスムーズに動いてるかは別として、だけど……":73,"冬夏とかは何もせずとも向こうから攻めて来るし、\nどうしてもこっちはいつも受け身になりがちだったから、\nこう、\nまともに対等っぽい位置で語り合えるのが、\n狩屋……っていうのはあったかも知れない。[l]\n前例で言えば、\n少ない友人であるところの大神がその位置な訳で、\n":74,"「そうだなあ、\nなんかあれだな……[l]\nまるでお前とも、ずっと前からともだ──ちだったようなかん……」":75,"そう言いながら何の気もなく狩屋の方を向いただけなのに、\nそこで初めてモロに視線があったからなのか、":76,"「………！！？？[l]\n………っ、ぅふうぁ、[l]\n":77,"……んっ！！[l]\nばっ！！！」":78,"「……？」":79,"何か息を呑んだり、色々と慌てふためきのリアクションをする狩屋。":80,"「？[l]\n？[l]\nあ、いや、その、あれ？」":81,"「げふっ、こほっ、\nぬ、にゃ、にゃんでもっ。[l]\n":82,"あわわわわわわ、あ、あれっ？[l]\n":83,"あれっ？[l]\nえっえっ？？」":84,"ぎくしゃくというよりは最早、\nあわあわのふわふわで、\nあの時の冬夏みたいだな──\n":85,"……ああ、まあ、[l]\n冷静に考えれば一般的な男女間の会話としては、\nちょっと変な意味に取られかねない唐突な物言いと動きだった……か。[l]\nそういう判断、というか距離感とか、\n今ちょっと混乱してる……んだろう僕は。":86,"別に格別変な意味とかなく、\nその、敢えて言うなら、\n引いてないかとかそういうネガティヴな意味での顔色伺い的に、\nあくまでも一般的コミュニケーションとしての範疇での正否を、\n確認しようとした上での動きだったんだと思うけど、\nまあいずれ、\nそういう事すらも考えてる時点で、あれだ、\nまだ、\n……あうあ。":87,"ていうか、\n狩屋も、ちっと、":88,"先":89,"刻からそれ狼狽え過ぎじゃない？":90,"「い、いーけどさぁ、ういはっ。[l]\nあ、兄ぃはその、\nま、前も言ったにゃが！[l]\nそういうことにゃから！！」":91,"「あはは……それなら……いいけどな……」":92,"……ごめん、[l]\nホントのことを言うと前何を言われてたかは、\n記憶に定かじゃなかった。[l]\nでも、\n":93,"「ありがとな……」":94,"素直に本心から、\nそう言った。":95,"「………めてよ……[l]\n":96,"そんな、……」":97,"……何か切羽詰まった様な眼で僕を":98,"視":99,"据えたまま、[l]\n硬直しながら何か呟いて、いるみたいだけど、\n":100,"──さっきなにか、\n":101,"何と言ってるのかまでは、\n":102,"──刺激したか或いはされたか、\n":103,"分からなかった。":104,"──もうひとりからなにか、\n":105,"と、矢庭に理解可能な声で彼女が話し出した。[l]\n或いは僕の方で可聴状態になっただけかも知れないけど……":106,"「……じゃあさぁ、[l]\nそう思うならさぁ、\nういのその、\n":107,"ういの話もちゃんと聞いてね……？」":108,"「そりゃまあ、僕なんかでいいならば……」":109,"ただの相談ごとじゃない、のだろう。[l]\n冬夏や狩屋達には、\nあの、\nネコガミやら……それは最早、僕とも無関係ではない、[l]\nという事でもあって、\n":110,"………？":111,"「……どうした？[l]\n痛いのか？寒いのかやっぱ？」":112,"頻りに手首をさすっていたので、\n思わずそう問うた。":113,"「え？[l]\n":114,"ああ、\n":115,"……ぬぬ？」":116,"明確な返答をせず、\n何故か首を傾げる狩屋は、\nその、前会った時と同じ格好で、\nつまり、\n":117,"端から視てて脚が……寒そうで。":118,"「え、あ、その、\n兄ぃと違って若いからいっかなーと思ったけど、\n":119,"にゃんか、やっぱちっと寒いにぇ？[l]\nはは……」":120,"「まあ、確かにそのなりじゃな……はは……[l]\n女子は脚出すくらい大丈夫かも知れんけど、\n無理しなさんなよ？」":121,"どっかで聞いたような話だった気もするけど、\n考えないことにした。":122,"「ちょっとばたばたしたまま出て来たからさ……[l]\n寝てないのもあるけど、その割に、\n準備とか全然、してにゃいってか、何も考えるよゆうもさ……[l]\nまっ、その、\n":123,"いいの、ういの脚のことはっ。[l]\nなんにしても……あ、兄ぃが、思ったよりは元気そうで、[l]\n":124,"よかった、うん」":125,"……どうにも拭えないこの、[l]\n互いに気を遣ってる感が\n僕がこんななのは兎も角、\n狩屋には一体何事があったんだろう。[l]\nそれを今から話してくるのだろうけど、\n何にしろ狩屋にしてはしおらしいテンションに違いはない。[l]\nとは言え、ここであの時みたいにぶん殴られても、\nそれはそれであれだけど……":126,"「……」":127,"そんなつもりは毛頭無かったけど、\n別に『あの時』から連想した訳じゃないんだけども、\n思わず狩屋の脚に視線を這わせてしまい、\n":128,"「や、ちょ、えっ？！」":129,"「あっ、ごめっ、いや、あ？！[l]\n違う、違うがな！！[l]\nいみはないです！！」":130,"つ、つーか、\nえ、僕の眼ぇそんな眼だったか？！":131,"慌てて視線を逸らし、\n上空に眼を転じると、\n":132,"「あっ、ああ、\nて、天気悪いな、気付かなかっ……たな……」":133,"意識して空なんか視てなかったから、\n":134,"ああ、これ、は……":135,"「一雨来そう……かな……」":136,"「ぬい？[l]\nああ、うん……[l]\n雪、なるかもにぇ、\nこの辺じゃこの時期でも、\nたまーに降るときあるから……」":137,"言われてみると、\n湿度やら空気の感じ、空の鋭さ……とでもいうべきか、[l]\n遠くの景色の視え方とかが、\nまるで締め付けるが如き凛とした厳格さで僕等に迫って、\n":138,"「へえ……雪……か」":139,"中央の方に居たときは、\n冬真っ只中だろうと、滅多に雪なんか降らなかった。[l]\nにも関わらず、\n僕等の上空を覆うこの、\n雪を予感させる何かは、\n容易にその存在を感じさせるに十分だった。":140,"それとも、\n子供の頃の記憶なのか。[l]\n或いは、\n旅行先での経験故か。":141,"いずれにしても、\nこの空気感は、\n厳然とした、まさに冷酷さを":142,"湛えて、\n今にも、\n世界を白く染めんと、\n":143,"「セカイが……白く……」":144,"「……？[l]\n兄ぃ？[l]\nうっあ、あうぅ」":145,"「え？[l]\nあ、ああ、ごめんなんでも」":146,"……あれ、[l]\n何故か鼻声に……[l]\nまあ、まさに実際寒いのだろうし、\n………。":147,"「……いてるの？[l]\nんんん、いあ、にゃんでも、\nえっとほら、\nまあ、移動しよう、ね？[l]\nまずは。[l]\n此処で立ち話って怪しすぎるからっ」":148,"あ、ああ、そうか。[l]\n駄目だなあ……[l]\n眠いのも空腹も、暑いのもあれだけど、\n寒いのも、十全な思考を妨げるんだよな、\nいかんいかん、\nいかん……":149,"ぐすっ、\n":150,"一度はなを啜る。[l]\n四月末だってのに、全くよう……":151,"「えーとじゃあ、\nどっか行く……アテある？」":152,"「ぬ？[l]\nん……[l]\n車、にいこか。[l]\n車の中行こ。[l]\nまずは。[l]\nういもその、\nよくわかんにゃい、いま、いろいろ」":153,"「わかった……じゃあ、[l]\nこっち、\n行こうか」":154,"狩屋は、\n一瞬横に並ぶべきか後ろをついて行くべきか躊躇したようだったけど、\n":155,"「……うぅ……やっぱさぶいよばかぁっ」":156,"と、そわそわしながら、\n横に並んだ。":157,"……僕等は２人とも、[l]\n今物凄く安定を欠いているのだろう。[l]\n打ち沈んでるのにも関わらず、\n明るく振る舞いたい、\nそうありたい、と思う意思が、\n過剰に表面に顕れるので、\n一見明るそうには視えるのだけれど、\nそれが、また、\n空回りしてるようで、\nそれが逆に切なくて、\nすぐに現実に引き戻されて、\nでも、それが辛くて、やっぱり無理に明るくあるべく振る舞おうと、\n":158,"そんな２人が揃ったら、\nそれはもう……":159,"痛々しいったらありゃしない。":160,"とは言え、\n狩屋の方の事情はまだ分かってない訳で、\n僕が勝手に瑕の舐め合いと思うのは早計かもだが、\n":161,"「あっ、のっ」":162,"「……あっ？[l]\nあ、あー、なんだ？」":163,"知らず僕が自分の思考に没入してると、\n急に狩屋が声を上擦らせた。":164,"「あー、あのさ、\n電話で声だけ聞いたときは、\nちょっと心配したけど、っ、\nそらーもう、\nこっちがしっかりしにゃきゃと思うくらい？[l]\nでも実際こうして会ってみたら視たら、\nまあ、\nそんなでもなかったから、\nまあ、\nよかった、ですよ。[l]\nよかったです」":165,"「あー、\nまあ、\n実はそうでもないけどな、\nとか言って余計な心配をかけてみたりな……」":166,"「ばか、\nほら全然だいじょぶそうじゃんよ。[l]\nあーもう、\nういの方が寧ろ今──」":167,"「……どうかしたのか？[l]\nてか、\n……いきなり無理に話さんでもいいぜ、[l]\n僕も、ほれ\n期待されてるフォローなんか出来ないかも、\n知れないし……」":168,"そこは、\n告白を後回しにされたって一緒ではあるんだけど……":169,"「ん～～、\nまあ、\n車、行ってから。[l]\nね。[l]\n":170,"……昨日ね、電話してから、[l]\n行き場が無くなっちゃって、\n":171,"本当はすぐにでも会いたかったんだけど、[l]\n":172,"っっって、別にその変な意味に取っちゃだめでせあ！！[l]\nああああの、\n手持ち無沙汰！[l]\n手持ち無沙汰になったってこと！！[l]\n無駄に待つ時間にゃんかつくんなきゃ良かったって、\n思っただけ！！」":173,"「あいあい……わかってます……」":174,"「うぅ……[l]\n兄ぃに迷惑かけちゃだめかと思って、\n時間あけたのにさ、\n何か、\n……いいですもう。[l]\n":175,"あ、何か食べた？」":176,"「あ、いや、\nでも何か喰うなら、入れれば入る、\nなしでも構わない、て感じかな……」":177,"「……ぬーん。[l]\n":178,"じゃ、ちょっとコンビニで買いたい。[l]\nごはんレベルまでいかにゃいあれで……」":179,"「ああ、じゃあ今度こそ僕が":180,"奢るから、\nその、僕は外で待ってるから……[l]\nほれ、お金」":181,"「え？[l]\nなんで一緒にいかないの？[l]\nてか、お金、\n":182,"ああ、あう、……確かに今、手持ちが微妙です……[l]\n":183,"ぬゅうぅ、でも……」":184,"「僕はその、ほれ、僕というかお前があれだよ、\n隣町とは言え噂になったりしたらアレだろぅ……」":185,"「はぃ？[l]\nなに？」":186,"「や、兎に角僕はいいんだ。[l]\nあああれか、問題はそっちじゃなくてか？[l]\nあれ気にしてるんならだな、\nこれで借りを返したとか言わないから、\n遠慮無くもってきな、\nどうしても気になるなら返してくれりゃいいし」":187,"……そんな機会が、[l]\nこのあと、事態が進展したあとでも、\nあるなら、\nだけど……":188,"「……なんかよくわかんないけど、[l]\nじゃー兄ぃの欲しいのも買ってくるよ？[l]\nなにほしい？」":189,"「あ、あーーー……[l]\nじゃあ甘いもんを……[l]\n脳に糖分が欲しい……[l]\nブドウ糖強化系のなんかそういうやつ……があったようなないような」":190,"「ん、なんとなくわかった、\nじゃ、行ってくるにぇ、\n":191,"ぇあーっと、此処に居る？」":192,"「あー、うん、此処に居る。[l]\nいってらさい」":193,"たたたたた………と狩屋は足早に店へ向かった。":194,"もし僕が、\n":195,"………きめてしまったら、":196,"この娘とも、\n敵……という言い方が合ってるかは分かんなけど、[l]\nこんな風に話す事なんか不可能な関係になるも知れない……[l]\nのか。":197,"いや、\n猶予があるとか思うこと自体、\n僕が勝手に考えて──否、考えないようにしてるというか、\nそう、\nどっちにしてもこんな悠長な有様、\n":198,"──なぜってワレは●●だからさ。":199,"強烈な逃避、つまり今までもずっと考えてるように、\n深刻になりすぎないように反作用的に、\nカラダとココロが防衛機構を働かせてるのか、\n":200,"──もうすこしで、\n":201,"あたまのどこかでは頑なとも言える程の安寧感が、\n":202,"──まだ忘れている●●●●が●り●だし、\n":203,"なんなのだろう、絶対的なジシンが僕に内在していて、\n":204,"──あとはどの●●とネ●コ●になるか。":205,"……どの？":206,"──それともすべてと、\n":207,"すべて？":208,"──例えばクタイを":209,"ソ":210,"ク":211,"シ":212,"ツ─\n":213,"「ただいまー、\nんに？」":214,"……あれ？":215,"ああ、頭、ちょっと熱っぽいか、\n":216,"逆":217,"上せた感じがする……":218,"「お帰り……[l]\nなんか……[l]\nお前ともすっかりその、なかよ──」":219,"逆上せてる所為か、\n何故かそんなコトバが口をつき、って、\n":220,"……いきなり何を言ってるのだ僕は。":221,"「へっ？！[l]\nあ、う、お、え、\n":222,"だっからっ、二度も言わなくていい！！[l]\nはっ、はず、うっ、\n":223,"あっ、ごめ、\n":224,"お手洗い行ってくる！」":225,"あああ、案の定というか、\nまた狩屋を無駄にあわあわさせてしま……って、[l]\nえ？！":226,"「はいっ？！[l]\n急にかい！[l]\nな、なんでまた、\nてかお前、\n今のときに行っとけばよかったのに……」":227,"「きゅ、急だからしょうがにゃいでしょ！！[l]\nさむいからだよ？？！[l]\nさむいからだよ！！！[l]\nちょ、ちょっとこれ持って、\n":228,"あああああもう、\nこんなのきーちゃに視たり聞いたりされてたら、\nまたっ、\n":229,"きー、ちゃに、\n～～～……」":230,"「て、手洗い行きたいならそんな悩んでないで、\n僕がわ、悪かったから、\nほれ、行ってこいもっかいコンビニ、\n此処で待ってるから」":231,"狩屋は半分涙眼で僕に袋を押し付けて、\n今出て来たばかりの店に向かって再び走り去った。":232,"車を停めてある駐車場にはがっつり公衆トイレもあるが、\nそんな口を挟む状況ではなかった……よね。[l]\nまあ、女子の生理現象は色々デリケェトなんだろう、\nよくわからないけど……":233,"というか僕もどうかしとる、\nいや、でもあの程度、\n別に重く受け止めるとは限らない範囲だと思うが、\nまあ、\nいかん、\nいかんな、\nてかあれだ、\n狩屋じゃないけどこの寒さで実際、\n風邪でも引いたのかも知れないな。[l]\nよくよく思い起こせば、\n僕も病み上がりは病み上がりであるし……":234,"ああ、\n早いとこ車に戻ろう。":235,"狩屋、\n姫様ちゃんと居た時より、\n口調が不安定というか、\nいつもの砕けたアレと、\n年上に対しての一般的な距離感との間を、\nいったりきたり──\nというよりも、\n前も思った事だけども、\nその普通の方の喋りが、\n真面目で文武両道と聞く彼女の本来の":236,"有り":237,"様なのか、\n":238,"否、それとも、他人行儀な部分、なのか。":239,"そうだ姫様ちゃん、\n":240,"……姫様ちゃん……":241,"あの":242,"娘は、\n":243,"──グアイのいいアイショウだったので、\n":244,"彼女達の中でも格別何か、\n":245,"──いずれスべてない状態では、\n":246,"あの神社で会う前の時点では、\n確かに体調も悪そうではあったけど、\n":247,"──●ウソウしてもやむないな、\n":248,"でも一体どうして、\n":249,"冬夏とあんな確執が、\n":250,"──ＣＡＴのそもそもは敵を除するための朋だから、\n":251,"狩屋と合わせて、二人は確か、\n":252,"──敵を除する相がもっとも──\n":253,"……といった話も、[l]\n僕はあのひとじゃないひとから、聞かされて、\n":254,"道具さん、\n":255,"道具さん……も、何かにつけ色んな事を僕に、":256,"……まさか僕の──コトも知ってい、て？":257,"道具さ、あっ、きぃ……は？":258,"──きぃ？":259,"西石貴奴？":260,"──●？":261,"なにか、\n":262,"「……っとにばかぁ……としか言い様がないよぅ……[l]\n":263,"はぁぃ、今戻りました……」":264,"「あっ？[l]\nおー、おう、おかいも……」":265,"「おか？？」":266,"「いあ、にゃんでもない……」":267,"「？[l]\n":268,"あ、袋ありがと、\nじゃ、行こ」":269,"……あれ、[l]\n今僕は何か、\nあれ、\n何を考えてた……？":270,"思考は一度中断されると、\nもう、\n必死に忘れようとする例の防衛システムの御陰か、\n":271,"将":272,"又僕の脳空転の所為か、\n雲散霧消して、\n":273,"と言うよりも、\n眼前に他人が居る時点で、\n普通は、独り思考してる余裕はないだろう。[l]\n相手を無視前提なら兎も角、\n当然今はそんな状況ではない。[l]\n寧ろ……":274,"「いいよ、これはこのまま持ってるから。[l]\nえーと、こっちな」":275,"「え、あ、\nあうあ、\nうう」":276,"車でこのコンビニ来れば早かったな……[l]\n等と思いつつ、\n僕等は連れ立って歩き出した。":277,"「そういえば、\n学校はどうした？[l]\n……平日だよな？今日」":278,"すっかり曜日の感覚を失念してたが、\n確かそうだった……筈だ。":279,"すると狩屋は気まずそうというか、\nバツが悪そうに、\n":280,"「ああ、\nまあ、ういらは一応祭一週間前くらいからは、\n任意で休める……[l]\n有休みたいに出席に影響しにゃい事になってるんだ、\n皆勤賞とかは、ナシになるけどさ……[l]\nその辺はまあ、こっち側の配慮らしいけど。[l]\n……特別扱いされてるからね、三春の……ってことでういら。[l]\n自分等から贔屓を頼んだ訳じゃないです、っていう、\nこれみよがしな遠慮というか防波堤みたいなもん。[l]\nまあ、そんなことしなくても、ういらはずっと、\n腫れ物扱いだけどさ……[l]\n露骨に仲間外れにはされなかったけど、[l]\n畏怖とか過剰な敬意にね、\nだから、\n友達は身内──きーちゃとかしか、\n一緒に居られなくて、あー、\n愚痴るつもりはないんだけど……」":281,"そう言った。":282,"「ああ……[l]\nまあ、なんとなくわかった……[l]\nその、三春……」":283,"そう、特別扱い、\n初めはこの地方の郷士みたいな立場、\n書庫の町を取り仕切るのもその、書の所蔵故かと、\nそう聞いてたのだかそう思ったのだったか、\n":284,"だが、\n":285,"「ネコガミ……か、[l]\nおま、……君等のその、[l]\n背景にあるのは」":286,"すると狩屋の表情は一瞬堅くなり、声を潜めて、\n":287,"「……今は言えない」":288,"二人だけになってからで──\n":289,"と言った。":290,"ああ、\n言われてみれば少し不用意だった……":291,"「……てか、にゃによ、[l]\nいきなり呼び方変えなくていいよ。[l]\nそれにえー、\n………、[l]\n………、[l]\n……ああ、冬夏ちゃが、言ったの？[l]\nそれともきーちゃが？」":292,"ぼんやり曖昧に、\nという言外の意思を感じて、\n僕もそれなりに言葉を選ぶ。":293,"「……ああ、その……[l]\n言わなかったっけか、\nりょうほう……ってかんじかな……[l]\n具体的にというか最初にというかその、\nそれをそれしてきたのは、\n……」":294,"言うべきかどうか一瞬だけ迷ったけれど、\n隠す意味が、\n……熟考すればあったのかも知れないが、[l]\n今の僕にはみいだせず、\n":295,"「……冬夏、からだけどな……[l]\nでも、\nあの時電話で言ったように、\n僕はもうそういうのは──気にしないっていうか」":296,"そう答えた。":297,"──もう、ワガミのことだし──\n":298,"「へえ……[l]\n……んでだろうなぁ……[l]\n…………」":299,"狩屋は深刻そうに黙ってしまったので、\n":300,"「でもほら、\n時間としてはタッチの差というか、\nそれに、\n会った時から何かそういう空気を出してたじゃんか、\n姫様ちゃんのが寧ろ、\nだから、どっちが先とか、\nあんまり関係、ないんじゃないかな……」":301,"思わずフォローめいた事を口早に付け加えた。":302,"しかし、\nそこで会話は完全に途切れて、\n車に着くまで僕等は一言も言葉を交わすことはなかった。":303,"「……『視えて』る、んだよね？」":304,"助手席に狩屋、運転席に僕が乗り込み、\n一時の静寂の":305,"後、\n彼女は切り出した。":306,"「あ？[l]\nあ、ああ、そう言ったな、確か電話で、\nあっさりとな、\n言っちゃったな……[l]\nああ、でも、最初っからじゃない……[l]\nこっち来てから、\nえー、まあ、そうなった……」":307,"真偽の程はまあ、未だにあれだけど、\nそれでも敢えて言うなら、『視えてる』のが本来の僕で、\nなのに、\n眼の前の、":308,"彼":309,"女達に、\n気付かれないように、\n":310,"──ミルハ、しかし、それでもまだ、\n":311,"「へぇ……？[l]\n……きーちゃ、今、[l]\n……うん、だからか、うん、そうなのかな……[l]\nじゃあ、冬夏ちゃは……」":312,"その語尾は問うでもなく、\n僕の方を視てもいなかったので、\n声を掛けるのは止した。":313,"矢張り姫様ちゃんの事で、\n何かあるんだな……":314,"そう、\n姫様ちゃんの言動も、\n最初は何の事やら分からなかったけど、\n今なら──\n":315,"「そ、それにしてもあれだな、\nその、電話の時は、\nあたふたしてて、\nお前にしてみりゃ、\nほんとなら、\n衝撃の告白だったんだろけどそんな深刻さぁ欠片も、\n無かったっていうか、\nさっさと順応しちゃったっていうか、\nああ、お前からすれば普通の事なのか、\nえー、その、なんだ」":316,"沈黙に堪えられず、\nなるべく軽薄に喋る。":317,"……駄目だ、逆に、[l]\n気を遣ってる感ばりばりで、\n":318,"「まあ……オハナシみたいな話だし、[l]\n実はそうそう簡単に信じられても困るコトにゃんだよね、\nういらのコトは」":319,"「ん……ああ、まあ、そうだろうな……」":320,"「それ以前に、\n基本ヒトに他言なんかしないけど、\n話したところでね、\n幸い……なのかな、[l]\n普通は痛がられて終わりでしょ。[l]\n良くて与太話と思われて軽くスルー……[l]\nどっちにしても、まあ」":321,"「……ああ、まあ、それも、そうだろうな……」":322,"共感された場合は、\n僕みたいに、\n『おなじ』者ととられるって事なのかな……[l]\n姫様ちゃんの言動もそうだけども、\n道具さんが矢鱈僕に突っかかってたのも、\n今思えば、そうなのかも知れないが……[l]\n冬夏は、\n冬夏は……？":323,"昔に会ってた、のも、あるの、か。":324,"とうか──\n":325,"「でも、\n冬夏んち、みは……あの家がくろ……あの土地で影響力持ってるのは、[l]\n":326,"そ":327,"れに畏怖されてるからじゃ、ないって事か？」":328,"既に僕等は車中ではあったけれど、\n何となく口にするのが憚られて、\nいちいち代名詞にする僕だったが、\n狩屋も特に突っ込むことをしなかった。":329,"「……":330,"あ":331,"れを":332,"の":333,"為に使ったって意味では、[l]\n間接的にそうだけど、\nまあ、\nご先祖代々からみたいだし……[l]\n今の人達はもう、そういう慣例になってるっていうか、\n理由とかはもう殆ど知らないかもね……[l]\nうーん……[l]\nその辺、あまり深くは、\nでもその、\nまあ、そういうこと……[l]\nごめん……」":334,"「……ああ、別にいい……」":335,"……あのひとの言ってた事と、[l]\n併せ考えれば、色々、\n更にワカルこともあるんだろうけど、\n実のところ、\nあまり考えたくもない……":336,"何でもかでも真実を":337,"詳らかにすればいいという訳ではない、\n":338,"と言うことを僕は厭という程思い知らされた訳で、\n":339,"知らずにいれば●●●●だったのに、という、\n後ろ向きな安寧を求めてるのは分かってはいるけど、\n":340,"「逃避なんて……悪手なのに……」":341,"「……？[l]\n握手？」":342,"「？[l]\nなにが？」":343,"「え、今言わなかった？」":344,"「いや、え？[l]\n記憶にない……」":345,"「あそう……」":346,"……？":347,"勝手に何か口をついて出てしまったんだろうか。[l]\n自分でも":348,"居た":349,"堪れぬ過去の失態を思い出すと、\n耐えられずに悶絶して勝手に声が出る事はあるけど、\nそれをやらかしたのかな……":350,"いずれ、\n絡め取られる前の逃避ならまだしも、\nしっかりと眼前に頑然と突きつけられた状態では、\n":351,"──面と向かって対処するのが冴えた遣り方ではあるけど、\n":352,"逃げたところで気休めでしかないし、\n":353,"──要が無いなら自分から出歯亀根性出すこともなし、\n":354,"……敢えて状況を整理したり、建設的な思考をするにはまだ、":355,"──好奇心猫を殺すってどういう意味だっけな？":356,"……黙っていたって、それに、今は、狩屋の事もあるし、":357,"──適量ならば成長にも助けになるけど、\n　　ヒトに●●かけてまで、\n":358,"……無理に、結論を、急がなくても、\n…否、それは、ない、":359,"──視るべき現実と秘すべき建前の均衡というのがある、\n":360,"……駄目だ、分からない、どうすれば、":361,"──Ｃは偏ってたからさ、それでワレらは、\n":362,"……どうしろって、いうんだ。":363,"「──ぃ？[l]\n兄ぃ？[l]\nだいじょぶ、なの？」":364,"「あっ、ごめん、\n……ああああ、そうだ、喰うか、まずは。[l]\nお前がまず腹ごしらえしないとなー。[l]\nほれ、それ、食べぇな」":365,"場を誤魔化すかのようで、我ながらあれだけど、\nその割に、\n買い物袋はもう返してあったので、\nこっちからは言葉で言うしかないのがもどかしい。":366,"狩屋はそれでも素直に買った物を取り出して、\n僕に甘い物……チョコレートを寄越し、[l]\nもくもくと食べ始めた。":367,"袋をがさがさする音だけが大きく車内に響く。":368,"「……カレーパン……じゃないんだな」":369,"「……ういは揚げパン系苦手気味……」":370,"「ああ……そうなんか……」":371,"何故、\n":372,"余計な事を言ってしまうか僕は。":373,"本題に入る前に、\n馬鹿話でもしなきゃ、\n前頭葉も活性化してないし口も重いままだし、\n":374,"と、\n思っただけなのに。":375,"──コトバ一つで、全て台無しにし得るのがヒトだからなぁ……":376,"コトバってのは、\n厄介なものだけど、\n":377,"──言わずともワカル、事だけを重視するＣでは、\n":378,"く……、ど……":379,"ど、っちがいいのか、\n":380,"「……っ」":381,"……チョコ噛み砕き損ねた。":382,"「ん？」":383,"「いや、なんでも……」":384,"喰ったらいよいよ、\n本題か……":385,"狩屋が何を話したいのかは分からないが、\n少なくとも僕の方は、\n……話さないで、黙ったまま、という選択も、[l]\n無いではない、けど、\n":386,"これ以上背徳い事に耐えるのと、\n果たしてどっちが、\n":387,"……それは自分の事しか、考えてない故の、[l]\n迷いだ、\nそれはそうなんだ、\nでも、\n":388,"……話を、[l]\nするとして、\n":389,"既に僕が、視える者というバラシはしてるけど、\n僕には、もっと、\nその先が、\n":390,"その先なんて、\n":391,"──この娘等がワレのミの、":392,"簒":393,"奪者の裔だと、\n":394,"そんなの、話せるか……？":395,"言うべきか、\n言うにしたって、\nそれこそさらにその先を、\n":396,"つまり、\n":397,"まこくんが八相を殲滅して、\n　　　キミでキミ自身の身体を取り戻せ。":398,"どう伝えろっていうんだ、\n僕が、\n":399,"──フハイ":400,"等は此の地を箱庭にすべく置かれたから、\n":401,"逃げられない、\n":402,"──事が始まれば箱は閉じられて開くことはないし、\n":403,"つまりは僕が、己の意思で、\n或いは全てをなげうって、\n":404,"狩屋達を、冬夏を、\n":405,"──ミルハの言うのを鵜呑みにするのもあれだけど、\n":406,"僕はどう決断したらいいのか、\n":407,"──この件に関しては、自分の事だからね、\n":408,"どっちにしても、\n":409,"──●●は無いんだよ。":410,"何も、\n何を、\nどう話せばいいのか、\n否、話してしまうべきなのかどうか、\n":411,"それ以上に、\n":412,"口にしてしまってはシマイだ──\n":413,"という意識が、\nどうしてもそれ以上の思考を拒ませる。[l]\nかといって、\n最前から分かってる通り、\nこのまま黙っていようと、\nどうしようと、\n………、":414,"………、":415,"………言葉を選ぼうとするまでもなく、[l]\n完全に思考は停止……して……":416,"「………っ、………ぅ」":417,"フリーズして、ハングって、\n":418,"まるで、\n別れ話してるような……そんな経験もほぼゼロに近い僕ではあるけど、[l]\nそういう重い沈黙が、\n二人の間に流れる……":419,"狩屋も、\nあんな喋りだから一見あれだったけど、\n此奴はやっぱり、\n本来は、\n":420,"だから、\nあのひととは違うし、冬夏や姫様ちゃんとも違う、\n道具さんとも、\n":421,"つまり、\n僕のことを、\nヒト並みに慮ってくれてるのだろう、\n":422,"──Ｃに親和してる割には珍しく。":423,"僕等はお互い、\n数値上の成績は兎も角、真面目な優等生タイプではあるのだろうから、\n隙をつけ狙うような物言いなんか出来ない、\n気の利いたことも言えない、\n嘘を吐いて慰めたりといった器用な真似もまるで………":424,"要するにバカ正直な真っ向勝負しか出来ない、\n野暮で無粋で不器用な、\n":425,"否、単に失敗が怖いだけの、\n":426,"あのひとのキライそうな、\n":427,"いくじなし。":428,"──だが、それで、いいんだ。":429,"……空がどんどん、灰色に、なってく。":430,"この沈黙は一体どうしたら、\n":431,"何か良いコトバは？[l]\n何を言えばいい？":432,"──":433,"女達の愉悦を満たそうとするなら覚悟がいるのさ、\n":434,"そんなもの何も思いつかない、\n":435,"──だってたまたま『アタリ』を言ったって、それは、\n":436,"思いついても、それは単なる一時凌ぎ……":437,"──顔色を窺って、\n    神経をすり減らし正解を選択し続ける意義が、\n    価値があるか？":438,"でも、求められてる答えが出せないと、\n僕は、あのひとに、\n":439,"──それがアイだというなら、\n":440,"あのひと……？":441,"──そうだな、だからＹは、\n":442,"あのひと……なんか、":443,"──というか、ワレはもとよりイキにくきもので、\n":444,"あのひとは、\n関係ない……っ、":445,"──格好付けたいのはわかるけど、\n":446,"自分を殺してまで、\n強がることに、\n独り善がりの痩せ我慢なんかに、\n僕は意味なんか、\n":447,"みいだしたくはない……":448,"──あれ自身は我を通してる訳だからな、\n":449,"だからといって僕が僕をただただ押し通すのも、\nきっと、違う、\n":450,"──考える主体が一つ所に二以上あれば、\n　　必ず軋轢は生まれるさ、\n":451,"僕は、ただ、おもいをつたえたいだけなのに、\n":452,"──●く●かれるの話がややこしいのはそこで、\n":453,"拒否されたって構わないのに、なぜ、\n何で僕に、何を勝手に期待して、\n自分だけが正解を知ってる問題を勝手に出して、\nそれで、\n僕がしくじったら、\n勝手に僕を、\nみすてるつもり、\n":454,"……み、すて、":455,"──ほら、なあ、":456,"粋":457,"憎いよな、いまは。":458,"言わなくても通じる事はあるだろうが、\n言わなければ、\n":459,"「……んないだろ……っ……！」":460,"それが、\n言葉を使うヒトという種だろっ？！":461,"──ワかる事とイキは違うんだけど、\n　　ＣとＤでは、そこが決定的に、\n":462,"だから、\n":463,"僕":464,"等は、\n":465,"●●●なんだ、\n":466,"●●が●●●で、\n":467,"──もう、すこしで。":468,"──もうあんなのはいやだね。":469,"……もうあんなのはいやだ……":470,"損得が全てではないにしても、\n誰も得しない、あの、\n":471,"──Ｃ。":472,"否、\n自己陶酔を満たすという意味で\n当人は好いのかも知れないが、\n":473,"──それがＣ。":474,"そんなものはヒトの中で生きるのには、\n":475,"──Ｄとはちがう。":476,"僕はヒトでありたい、\n":477,"──ワレはそれを拒否することを、\n":478,"──………。":479,"……思考が止まって、代わりに、[l]\n別方向へずれていた……ようだ。":480,"な、何を考えていたんだろうか、僕は。":481,"あのひとの事を考えるとおかしくなる、\n":482,"僕は慌てて狩屋に声を掛けた。":483,"「えー、あのさ……」":484,"「食べたら眠くなった……」":485,"「あ？[l]\nあ、ああ、そうな、\n分かるわ……」":486,"「……寝てもいい？」":487,"「はぃ？[l]\nや、ああ、僕は構わないけど……[l]\nそういやあんまり寝てないんだろ、\nいいよ、僕は……それで……」":488,"結局、狩屋もあまり話したくは無かった、のかな……[l]\n本題……そもそも無かったのかも知れないけど……":489,"それとも、僕のように、\n単に他人と一緒に居たかっただけなのかな……":490,"独りで居ると、\n思考に歯止めがないから、どんどん凹んでしまうから……":491,"勿論、一緒の相手次第ではそのマイナスも倍増しかねない訳だけど、\nそう言う意味では、僕等二人はあまり良くない組み合わせではある、\nので、\n":492,"狩屋の提案に、\n正直安心、しているのも事実だ。":493,"今はどうやったって、\n何もコトバが、でない……":494,"「うっそ、やっぱだめ。[l]\n":495,"あー、にゃんかこう、ぱーっとするとこ、\n行かない？」":496,"「……え？[l]\nあ、いや、は？」":497,"「それどころじゃにゃいのは分かってるけど、\n分かってるけど、\n":498,"……にゃんもできんし……できにゃい……[l]\nせっ……ふぐっ……めて……」":499,"こんな現状も必ずちゃんと、\nどうにかなるって思っていたいから、\n悲観していたくはないから、\n":500,"無理にでも、ちゃんとしてなきゃ、\n無理にでも、前を向かなきゃ、\nいけない、\n":501,"のか？":502,"──●●●だな。":503,"「え、あ、ああ、ああ……[l]\nそう──だ、な、……」":504,"ともあれ僕は、\nその提案を拒否してまで、\n陰鬱な自分に酔いたい訳じゃないので、\n……どうあれ今は、[l]\n此奴が何かしたいっていうなら、\nそう、しよう……":505,"「……あーあ……[l]\n独りで処理出来ればにゃにも兄ぃにゃんかに、\n……たのっ、まない、の、にっ……」":506,"「あ……？[l]\nそらぁ、わるかったな……」":507,"……どんな":508,"罵":509,"言でも、[l]\nいつもと違うノリよりはましか……":510,"「って、てか、兄ぃを慰めにゃーだもんね！[l]\nそう、\n":511,"そういうことで、そういうことにしろばぁか！！」":512,"「あーそうかい、御厚意痛み入りますよ……[l]\nそれはそれでいいけどさ、\nで、どこ行くってよ」":513,"「どこでも、兄ぃ決めてよ」":514,"「……お前なぁ……[l]\n僕ぁ地元民ちゃうちゅうねん……[l]\n分かるわけないがな」":515,"一瞬、前冬夏と行ったカラオケを思い出したが、\n……流石にそこまでのテンションは気が引ける、[l]\n単に華やいだ場所に行くだけとは違って、\n思いっきり能動的な行為をしに行く場所だし……":516,"「そっか、平日の昼間にゃった。[l]\nぬーん、じゃー、単に遠乗りでも……[l]\n":517,"あ、映画でも、それにゃな！！[l]\n映画！！！[l]\nホラーとお涙頂戴以外で！！！」":518,"映画、ねえ……[l]\nまあ完全に受動行為だし、\n狩屋も寝ようと思えば寝られるし、\n互いに会話、する必要もないし、\nうってつけと言えばうってつけかもな……":519,"「ああ、じゃあそれで……[l]\n観るものは現地で決めるでいいんだな？[l]\nじゃ映画館て何処よ？」":520,"「この辺だと……":521,"処しかにゃいな……[l]\nちっと遠いけど、案内するにゃが」":522,"「あーそう。[l]\nまあナビに入力すりゃー済む話だけど……」":523,"「にゅあ、そりゃー、どっちでもいいけどさぁ……」":524,"自分が今、何をしてるのか、もうよく判らない。":525,"分かりたくないのが本心かも知れないけど、\n":526,"今は、\n":527,"流されてみよう……":528,"それが僕だ、昔から、\n":529,"自分の外にある大きな流れの":530,"侭に、\n":531,"それが──\n":532,"「じゃ、シートベルト締めい。[l]\n……チケット代は、」":533,"「割り勘」":534,"「あいよ……」":535,"発車させ、道路に出ると、\n遠くまで空が視界に入る。":536,"「……これ、降るな、[l]\n雪かは兎も角……」":537,"山の方は既に靄がかっていて、\n只の灰色になっていた。[l]\n風向きとかよく分からないけど、\n海の方とて晴れ間は視えなかったから、\nいずれ雨か何かは降って来る、だろう。":538,"「あ、傘持ってきてにゃいす……[l]\n濡れちゃ……ったらどうしよう……」":539,"「あん、そのくらいはどうにかすっから、\nそんな●●しなくていいよ」":540,"「え？[l]\nあ、うん……ありがとぅ」":541,"何やらもじもじする狩屋。":542,"「……寒いか？[l]\n暖房入れるか」":543,"「……うん」":544,"車のエアコンを入れると、\n車内は低い稼働音に包まれて、\n思考はより一層":545,"鈍まっていく。":546,"自分が今、\n":547,"何をしてるのか、\n":548,"もうよく判らない。":549,"僕等二人は、\n暫しの間、\n偽りの安寧の如き……母の胎内で聴くという血流の音に似た、[l]\n轟音と、\nその暖かきの中で、\n":550,"おそらくなにもかんがえずに、\n":551,"たがいに、\n":552,"なにをしてるのか、\n":553},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_057.ks","relPath":"/data/scenario/SC_M_057.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":541,"length":554,"percent":97.65342960288808},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[365,1]},"/data/scenario/SC_M_058.ks":{"data":[["「……おい、寝なさんなよ」","「……喂，别睡啊」"],["「……ふがっ、へあっ、[l]\nうううそんなごむたいな……」","「……呼嘎，嘿啊，[l]\n呜呜不要这么粗暴嘛……」"],["「今助手席で寝られると結構きついんだよ……[l]\nてかお前がっつり映画観覧しとったんか、\n寝りゃ良かったろうが……」","「现在副驾驶睡着的话挺麻烦的……[l]\n话说你不是全程认真看电影来着，\n干脆睡觉不就好了……」"],["「だってさ……」","「因为啊……」"],["「しょうがない、\nしりとりでもするかよ。[l]\nや、マジで」","「真拿你没办法，\n玩词语接龙吧。[l]\n喂，认真的」"],["「……ぬぃあ、[l]\nしりとり、の、り、りんご……」","「……喵啊，[l]\n词语接龙，龙，苹果……」"],["「ゴリラ……」","「猩猩……」"],["「らっきょ……」","「藠头……」"],["「……それ、『きょ』扱いか？[l]\n『よ』扱い？」","「……那个算『kyo』开头？[l]\n还是『yo』开头？」"],["「……じゃあらっきょう、で『う』……」","「……那就藠头（rakkyou），接『u』……」"],["……自分が今、","……自己现在"],["何をしてるのか、\n","在做什么，\n"],["もうよく判らな……ていうか、まあ、しりとりではあるんだが……","已经不太明白……不对，嘛，虽然确实是在玩词语接龙……"],["何故こんな有様になったかと言えば、\nこちらの距離感及び時間感覚の違い、\n向こうとのスケールの差と言おうか、\n……旅行に慣れてれば理解しててしかるべき事ではあったのだけど、","要说为何会变成这样，\n是这边对距离感和时间感的认知差异，\n或者说与那边的规模差距吧，\n……若是旅行经验丰富本该理解这种事的，"],["映画館への道程がこれまた結構な遠距離移動だったのだ。","但去电影院的路程偏偏又是相当远的长途移动。"],["到着予想時刻に気を回すとか、\nそういった基本的な思考回路が飛んでいたようで、\n単にナビの言うまま走らせていたら、\n","操心预计到达时间之类的，\n似乎连这种基本思考回路都飞走了，\n单纯照着导航指示开车的结果，\n"],["映画館に着いた時点で数時間経過済みだった。","到达电影院时已经过去了好几个小时。"],["挙げ句の果てに、\nどの映画を選ぼうと、\n入場までにはそこそこの時間を待つ必要アリのタイミングだった為、\n再びタイムロス、\nそしてそれが故の検討時間は十分にあったにも関わらず、\n選んで入った映画が３時間モノという、\n","最要命的是，\n无论选哪部电影，\n都需要等待相当时间才能入场，\n导致再度浪费时间，\n尽管因此有了充足的斟酌时间，\n最终选择的却是长达3小时的电影，\n"],["時間つぶしというにはあまりにも、\nがっつりと、時間を使う事となったのであった。","对于消磨时间而言实在过于——\n彻彻底底地，消耗了时间。"],["内容は、寝ていた訳でもないのに、\n全く印象に残らなかったけれど。","至于内容，虽然没睡着，\n却完全没留下任何印象。"],["僕等が来たこの施設は、映画館と言うよりも、\n巨大モールの上階みたいな所の、\n言わば複合施設の一部みたいなものだった。[l]\nファミレス階のような所もすぐアクセス出来たので、\n鑑賞を終えた僕等は時間を鑑みて、\n……もうかなり夕方なだったから、[l]\n晩飯もその場で二人して食した。","我们来到的这个设施，与其说是电影院，\n更像是大型商场的上层、\n某种综合设施的一部分。[l]\n由于能直接通往家庭餐厅楼层，\n观影结束后我们考虑到时间——\n……毕竟已经相当接近傍晚，[l]\n两人就直接在那里吃了晚饭。"],["で、\n立体駐車場から内部通路が延びていて、\n天候に左右されずにモール建物内に行けるため気付かなかったのだが、\n","然后，\n从立体停车场延伸的内部通道，\n让人没注意到天气变化就能进入商场建筑，\n"],["ほんとうに、\n","实际上，\n"],["雪が、\n","雪，\n"],["降っていた。","正在下。"],["いかに北の地とはいえ、\nたまにあるとは言っていたとはいえ、\nレンタカーのタイヤは雪道仕様ではなく、\n僕とて雪道に慣れてる訳でもなく、\n","虽说是在北方地区，\n虽然提过偶尔会下雪，\n但租来的车并未配备雪地轮胎，\n而我也没有雪地驾驶经验，\n"],["もし、\nテンションが戻らないままだったなら、\nとても耐えられないような、\nしかも、\n既に陽は落ちて、\n暗く、寒い、割と危険な路面状況を、\n帰らねばならなくなった、のだ。","如果，\n继续保持这种心不在焉的状态，\n恐怕会难以承受——\n更何况，\n太阳早已落下，\n必须在这种黑暗、寒冷、相当危险的路况下，\n驱车返回了。"],["……しかも往路の時間を考えると、","……考虑到来程花费的时间，"],["──色んな意味で自我の存亡がかかってきてるなぁ。","──从各种意义上来说都关乎自我存亡啊。"],["そう言う意味では御陰で、\n御陰でといっていいのかどうかあれだけども、\n……運転に集中せざるを得ないという意味も込めて、","从这个角度来说倒是托它的福，\n虽然不确定能否称之为托福，\n……某种意义上不得不集中精神驾驶，"],["自分の置かれてる状況というのは、\n一時とは言え忘れることが、出来た、と思う。","让我暂时得以忘却，\n自己所处的境况。"],["それが良い事か悪い事なのかは、\n分からないけど……","这究竟是好事还是坏事，\n我也说不清……"],["少なくとも活動への活力として、\n","但至少作为行动力来源，\n"],["──イきようとする事に集中するのは悪くないね。","──专注于即将到来的高潮并非坏事。"],["ニクシミを糧に動いたり、\n","比起靠怨恨驱动行动，\n"],["将","将"],["又、\n絶望で動けないよりは、ましだ……","又或者，\n因绝望而动弹不得要好得多……"],["………。",""],["「……ほれ、兄ぃ、兄ぃの番にゃって」","「……喂，大哥，轮到大哥接龙了」"],["「……は？[l]\nああ、悪い、聞き逃した、\nなんだ最後の文字は？」","「……啊？[l]\n哦抱歉，没听清，\n最后那个字是什么？」"],["「……そんなぼやんとしたひとの運転じゃ怖いにゃあ……[l]\nヒトの命あずかってんにゃからしっかりしてよにぇ」","「……这么恍惚的人开车好可怕喵……[l]\n可是握着人命关天的方向盘呀认真点啦喵」"],["「ああ、そこは前例がある、から……[l]\n同じような真似は二度と、……、[l]\nいや、ああ、何でもない、\nてかそれにゃーお前のしりとりにもかかってんだからな、\n真面目にやろうぜ真面目に」","「啊，这方面倒是有前车之鉴……[l]\n不会重蹈覆辙……，[l]\n不，没事，\n话说这接龙也关系到你喵，\n认真玩啊给我认真玩」"],["「だぁかあらぁ、ぼーとしてんにゃ兄ぃのほうにゃから！[l]\n『る』！[l]\n『たんたる』の『る』！」","「哎呀呀，发啥呆呢大哥这边儿！[l]\n『る』！[l]\n『たんたる』的『る』！"],["「タンタルってお前……まあいいや、[l]\nる、る、","「坦塔尔你这家伙……算了不管了，[l]\n呜、呜、"],["瑠","瑠"],["璃も","璃也"],["玻","玻"],["璃も照らせば光る……」","璃也照一照就会发光……」"],["「慣用句はだめ」","「惯用句不行」"],["「あ？[l]\nじゃあるり……るり……るりるり……」","「啊？[l]\n叽啊噜哩……噜哩……噜哩噜哩……」"],["「……単に瑠璃でいいじゃんよ」","「……直接用瑠璃不就好了」"],["そうこうして、\n復路もどうにか、\n出発点、あの海岸の道の駅までは無事やってこれた。","就这样，\n回程也总算，\n平安抵达了起点——那个海岸公路驿站。"],["「……ほれ……寝にゃかったよ、ういも……[l]\n褒めろばか……えらいでしょが……」","「……瞧……没睡着吧，我也……[l]\n快夸我笨蛋……很厉害吧……」"],["「……ああ……真面目にさんくす……[l]\nおっそろしく……神経使った……[l]\nいででででででで……」","「……啊……认真说声谢谢……[l]\n简直……神经紧绷……[l]\n疼疼疼疼疼疼……」"],["──ああ、こういう緊張は宜しいな。だいぶ、","──啊啊，这种紧张感不错。相当，"],["あったま痛ってぇ……","脑袋要裂开了……"],["──ダイブ、イキ、トウゴウに近づいた。","──距离DIVE、生还、统合更近了。"],["……こんな長時間、しりとりしまくったのって初めてじゃないか……","……这么长时间连续玩词语接龙还是第一次吧……"],["「ちっと此処で……トイレ休憩……[l]\nあとこっからお前どうするか決めよう……」","「稍微在这儿……上个厕所休息下……[l]\n顺便决定接下来你怎么办……」"],["「……にぇあ？[l]\nぬぅ、きこえなかったけどいい、後できく、\nトイレトイレ……」","「……嗯啊？[l]\n唔、没听清但算了，待会再说，\n厕所厕所……」"],["僕より余程我慢してたんだろう、\n狩屋はシートベルトを解除するのももどかしく、\nそそくさと車を降りていった。[l]\nもっと早めにトイレ休憩いれたかったのは山々なれど、\n僕等のどっちも口に出さなかったというか、\n集中してる間はそういう欲求は横に退けられてるもんだわな。[l]\n緊張で逆にもよおす事はあるけど……","比我憋得厉害多了，\n狩屋急不可耐地解开安全带，\n慌慌张张冲下了车。[l]\n虽然早就想中途休息上厕所，\n但我们俩谁都没提这事儿，\n专注的时候这种需求会被抛到脑后吧。[l]\n不过紧张时反而会想上厕所……"],["外が寒いのは分かっていたが、\n逆にその冷気に触れたくて、エンジンを止めて僕も外に出る。","明知外面很冷，\n却因贪恋冷空气，熄火后我也下了车。"],["今まで轟音に包まれていた所為か、異常なまでの静寂に感じる。","或许因一直被引擎轰鸣包围，此刻寂静得反常。"],["「さっぶぃな……[l]\n４月下旬じゃないな……[l]\nいつ晴れるんだろこれ……[l]\n突発的なもんだろうけどなあ……」","「超冷……[l]\n完全不像四月下旬……[l]\n这天气啥时候放晴啊……[l]\n虽然肯定是突发性的……」"],["ちょっと前に台風みたいな暴風雨あったばっかだっていうのに、\n異常気象が続くなあ……","明明前不久刚有过台风般的暴风雨，\n异常天气接连不断啊……"],["──……いや、何も言うまい。","──……不，还是闭嘴吧。"],["雪のせいで妙な明るさはあるものの、\n頃は既に夜である。","积雪反光造成奇特的明亮感，\n但时间已是深夜。"],["狩屋が言い出さなかったし、\n道中余裕も無かったから問わなかったけど、\n彼奴これからどうするのか決めねばなるまい。[l]\nいかに学校は休めども、\n家には帰らないと、いけないんじゃないか、一応……[l]\nそれとも、\n曲がりなりにも、それこそ一族ぐるみ異能者の端くれ、\nそんな常識的な心配は無用なのだろうか。","既然狩屋没主动说，\n路上也没机会问，\n现在必须决定这家伙何去何从了。[l]\n虽说学校可以请假，\n但总得回家一趟吧，按理说……[l]\n或者说，\n作为勉强算得上异能者家族末裔的存在，\n这种常识性担忧或许多余？"],["……いや、そんなことはないだろう、[l]\nチカラを有するとはいえマイノリティーが存続していくにあたって、\n逆に凡俗に紛れる事に腐心せねばならぬ事が多かろう。[l]\n道具さんみたいなのは別としても……","……不，应该不会，[l]\n即便拥有力量，少数群体要想存续，\n反而更需要费心混迹于世俗。[l]\n虽然像道具小姐那样的另当别论……"],["いずれ冬夏みたいに決意の家出とかでも無い限り、\n年頃の女子が、\n得体の知れない男子旅行者とこんな時間まで一緒に居ては、\n……一度狩屋の母さんとは会ってるけど、[l]\n……あれ？[l]\nそういえば、かりや……、","除非像冬夏那样下定决心离家出走，\n这个年纪的女生，\n和来历不明的男性旅行者待到这么晚，\n……虽然之前见过狩屋的妈妈，[l]\n……啊咧？[l]\n说起来，狩屋……，"],["──あまり深入りしたい話題じゃない気がするな。","──总觉得这不是该深究的话题。"],["………とうかが、あのひ泣いていた、のは……","………冬夏那时候在哭是因为……"],["「……～～～～っ、[l]\nさっ、さむいって、\nほんとに頭痛してきた……」","「……～～～～呜，[l]\n好、好冷啊，\n头真的开始痛了……」"],["今風邪引いたら洒落にならん、\nそろそろ中に入ろう……","现在感冒可不是闹着玩的，\n该进屋了……"],["……冬夏……はそう言えば、[l]\n無事としか聞いてないけど、\n明らかに様子が、\n","……说到冬夏，[l]\n虽然只听说她平安无事，\n但那个状态明显\n"],["怪","很"],["訝しかった……のは何故だ？","很不对劲……为什么？"],["眼の修復は恐らく何かしらの、\n……ネコガミの何かがあったのだろうが、","眼睛的修复恐怕是用了某种\n……猫神相关的力量吧，"],["あの態度は、\n僕があの時混乱してたことを差し引いても、\n普通の反応とは、\n思えないけど、\n","但那种态度\n就算扣除我当时混乱的因素，\n也不像是\n正常反应，\n"],["それとも、\n","还是说\n"],["単純に、嫌われたの……かな……","单纯被讨厌了……呢……"],["なんでかは知らないけど……","虽然不知道原因……"],["女子ってのはその辺よくわからないからな……","女生这种生物本来就很让人费解啊……"],["がちゃ！","哐当！"],["「さぁ～～～～～～～～～～ぶいってばか！！！[l]\n～～にこれぇばっかじゃにゃいのぉおおうあ～～～～～！！[l]\n","「冷死啦啊啊啊啊笨蛋！！！[l]\n这种鬼天气喵才不要出门啦啊啊啊～～～～～！！[l]\n"],["たっっだいまぁ～～～～～～～～兄ぃ～～～、[l]\n","我回～来～啦～哥哥～～～，[l]\n"],["げ、[l]\n","呜噫，[l]\n"],["暖房入れてよ暖房～～～～～～～」","快开暖气啦暖气～～～～～～～」"],["ばだん！","砰！"],["「おう、おかえり……」","「哦，欢迎回来……」"],["エンジンを動かすと、\n再び轟音が車内に響き渡った。[l]\n狩屋は前の送風口に手をかざしたり、\n太腿をさすりまくったり、\n二の腕をがすがすマッサージしたり、\n","引擎启动时，\n轰鸣声再次充斥车厢。[l]\n狩屋对着前排出风口搓手，\n拼命摩擦大腿，\n用力按摩上臂，\n"],["一",""],["頻り騒いで何とか体温を上げようとする。","闹腾着试图提升体温。"],["──まあ、なんだ、\n","──嘛，怎么说呢，\n"],["「そのなりじゃしょうがないわな……[l]\nあんさんそれほんとに寒そうだしなあ……」","「穿成这样也没办法呢……[l]\n小哥你看上去真的很冷啊……」"],["「ああああ兄ぃその、う、上着かにゃんか貸してよ」","「啊啊啊哥哥那个、外、外套借我喵」"],["「え？[l]\nでももう、あれだろ、\nもうお前帰らにゃ、\nそんな今更本格防寒したところで──」","「诶？[l]\n但你不是马上就要\n回去了吗，\n现在才全副武装──」"],["「………」",""],["「………ん～～～～～～～」","「………嗯～～～～～～～」"],["………？",""],["「……ちょっとさ、変なこというけどね、[l]\n変な風に取んないでね、[l]\n","「……有件事虽然说出来很奇怪，[l]\n但别误会啊，[l]\n"],["あの、………、[l]\n","那个，………，[l]\n"],["あーー、うあーー～～……」","啊──呜啊──～～……」"],["「……言ってる事が矛盾しとるけどまあ、[l]\nなにさ」","「……虽然前言不搭后语，[l]\n什么事？」"],["言いにくそうではあるが、\n深刻そうな感じじゃない……[l]\nなんだろうか、\n","虽然难以启齿，\n但看起来不是什么严重的事……[l]\n到底是什么呢，\n"],["──この状況で、\n","──在这种状况下\n"],["……ずっと前を凝視したまま黙ってしまった。","……一直盯着前方陷入了沉默。"],["「……おま──」","「……你──」"],["「………[l]\n………[l]\n",""],["今夜はその、帰りたく……にゃいん、[l]\n","今晚那个、不想回……喵，[l]\n"],["ですね……う、ういは」","呢……呜、呜咿」"],["「…えなぁ、あ、ああ、[l]\n……ふーん……[l]\n………[l]\n………[l]\n………は？」","「…呃啊、啊、啊啊、[l]\n……哼嗯……[l]\n………[l]\n………[l]\n………哈？」"],["「……っだっから、や、やめ、ちが、[l]\nだっからもうああ、[l]\n変な意味じゃにゃいって！[l]\nそのままの意味にゃが！！[l]\n何の婉曲表現でもありませんし？！！！[l]\nまさに文字通りでぇあすのよ！！！！！！！」","「…就、就说了别、别这样、不是、[l]\n都说了别啊啊、[l]\n不是奇怪的意思喵！[l]\n就是字面意思喵！！[l]\n这根本不是什么委婉说法？！！！[l]\n就是字面上的意思呀！！！！！！！」"],["………。[l]\nいや、まあ、\nそらそうだろうけど……。","………。[l]\n不、那个、\n虽然确实是这么回事啦……。"],["「えーーーーと……[l]\n文字通りというか、\nここは敢えて、\n敢えて明瞭にしとくけども、\n……その、所謂『そういう』意味じゃないな？[l]\nあっ、その、あれだ、」","「呃——————……[l]\n说是字面意思、\n这里要特意、\n特意说明清楚才行、\n……那个、所谓的『那种』意思不存在吧？[l]\n啊、那个、就是、」"],["こういう発言するときは血の気が引くなあ……[l]\nあのひととだったらこれくらいの……いや、[l]\n……くそっ、[l]\nそんなこといまさら、\n","说这种话时血都会往头上涌啊……[l]\n和那个人的话倒是能轻松说出口……不对、[l]\n……该死、[l]\n这种事到现在才、\n"],["──思い出すだに●●が●●●だろ。やめよう。","──光是回想●●就会●●●啊。别想了。"],["……畜生、……。","……畜生……。"],["僕の無意味な葛藤に気付く筈もなく、\n狩屋は、\n","她当然不会察觉我无意义的纠结、\n狩屋、\n"],["「どういう意味？！！[l]\nへんたいか兄ぃわ！！！[l]\n何度もいわせんなばか！！！[l]\nてか上着貸して！！！[l]\n早く！！！！！！！」","「什么意思？！！[l]\n哥哥是变态吗！！！[l]\n别让我重复那么多遍笨蛋！！！[l]\n话说外套借我！！！[l]\n快点！！！！！！！」"],["と、顔を真っ赤にし怒鳴る。","涨红着脸吼道。"],["「よっくわかりましたぁーー、だ……」","「完全明白啦——的说……」"],["上着という程アウターとしての意味合いを意図してた訳じゃないが、\n一番上に羽織ってた服を脱いで、\n奴に渡した。","虽然本意不是要当正式外套穿、\n还是脱下最外层衣服、\n扔给了这家伙。"],["……誰もお前にそんな期待とかしてねえよ！","……根本没人对你抱那种期待啊！"],["「……ありがとぅ……[l]\n","「……谢啦……[l]\n"],["ぬぅ、ぬくい……」","唔、好暖和……」"],["一呼吸遅れた僕の怒りも、\n小さくなって服に","我迟了一拍的怒火、\n也在看到这家伙"],["包まった此奴を視て、\nすぐさま","蜷缩在衣服里的模样后、\n立刻"],["萎れる。","蔫了。"],["「……で、どうしたいって事だよ」","「……所以、你到底想怎样」"],["そう、\n『帰りたくない』って、\n文字通りに受け取ったとしても、\n軽い話題ではない……よな……","没错、\n就算把『不想回家』\n按字面意思理解、\n也不是轻松的话题……对吧……"],["「うん……[l]\nちっとした……時間つぶしというか……[l]\n居た","「嗯……[l]\n算是……打发时间吧……[l]\n因为"],["堪れなくて、向こうは……[l]\n兄ぃみたいにぶちまけられるような相手なんか他に……[l]\n居ないしさ……[l]\nきーちゃは今ちょっと調子悪いし、\n家はごたごたしてるし、あっ、\n冬夏ちゃの家がきっちり世話してるから、\nういが居なくても心配はいらにゃいんだけど、ね……」","实在受不了那边……[l]\n除了哥哥以外根本没有能倾诉的对象……[l]\n嘛……[l]\n小姬现在状态不太好、\n家里也乱糟糟的、啊、\n冬夏家把她照顾得很好、\n所以我不在也不用担心喵、呢……」"],["ぶちまけるってなんだよ。[l]\n大体その、\nお前、\n祭があるだろ……もう、すぐに……","「发泄情绪算什么啊。」[l]\n「说到底那个，」\n「你这家伙，」\n「祭典就要开始了吧……马上、就要……」"],["──そうしたらもう、\n","「──等到那时候，」\n"],["その頃には、\n","「到那个时候，」\n"],["「そ、そう言えば姫様ちゃんが？[l]\n調子悪いってどういうことだよ」","「「对、对了姫様她？」[l]\n「身体不舒服是怎么回事啊」"],["「え。[l]\nあ、その、……まあ、だいじょぶって言われたけど、[l]\n説明が、……」","「「欸。[l]\n「啊、那个、……嘛、虽然说是没事，」[l]\n「但具体说明、……」"],["まだ、核心には触れられないという事なのか、\n此奴自身にも分かっていない領分の事なのか、\n結局口籠もってしまう。","「是还未能触及核心这件事，」\n「还是连这家伙自己都不清楚的领域，」\n「最终变得支支吾吾。」"],["それに、\n冬夏は──どうした。","「而且，」\n「冬夏她──怎么了？」"],["「冬夏ちゃ……も無事、ってか、うん……[l]\nただその、\nういもきーちゃも、……兄ぃも分かってると思うけど、[l]\nそんなに仲良い訳じゃ、ないし、\nどっちかというと主従関係……っていうか、[l]\n主筋と分家的なその、\n……」","「「冬夏酱……也没事，应该说、嗯……」[l]\n「只是那个，」\n「小姬和我、……老哥应该也明白的，」[l]\n「我们关系其实没那么要好，」\n「更该说是主从关系……或者说，」[l]\n「宗家和分家那种感觉，」\n「……」"],["──それはワカル、●●●●が蒔いた事だな。","「──我懂了，●●●●搞的鬼吧。」"],["「……？」",""],["──どうした？","「──怎么了？」"],["……話が途切れたので狩屋を視ると、","「……见话题中断而看向狩屋时，」"],["そこで一瞬奴と眼が合った。","「与那家伙的视线瞬间对上了。」"],["「…ふっ…く！[l]\nあぢあぢあぢあぢ」","「「…呜…咕！[l]\n「啊叽啊叽啊叽啊叽」"],["異常なほど慌てふためいて、\n頭をぶんぶん左右に振る狩屋。[l]\nそして腕をごしごしさすって──\n……先刻もこんな事があったよなぁ。[l]\n激しい照れ隠しというか、\n否、\n照れるってのはこっちにとって好意的な受け取り方だ、\n","「异常慌乱地，」\n「狩屋拼命左右摇晃脑袋。」[l]\n「接着用力搓着手臂──」\n「……刚才也这样来着。」[l]\n「说是强烈的害羞掩饰，」\n「不，」\n「害羞这种说法对这边而言算善意解读了，」\n"],["………、",""],["……厭なら、[l]\nそう言ってくれりゃ、\n","「……要是讨厌的话，」[l]\n「直接说出来就行，」\n"],["「（にゃんだこれ……にゃによ、なによ、[l]\n","「「（喵喵这是什么……喵什么、什么啊，」[l]\n"],["……もう、うそ……）」","「……真是、够了……）」"],["「……まあ話したくないならいいよ……[l]\nいいけど、じゃあ、」","「……嘛不想说就算了……」[l]\n「不说也行，但是，」"],["なんで僕と一緒に今、此処に居るんだよ。","「那为什么现在要和我一起待在这里啊。」"],["「……すーーーー、[l]\n……はーーーーー……」","「……呼————，」[l]\n「……哈————……」"],["問いに答えず、\n肩で大きく深呼吸をする狩屋。","「没有回答问题，」\n「狩屋用肩膀做着夸张的深呼吸。」"],["数秒、そのまま息をしていた。","「数秒间，就这样维持着呼吸。」"],["すると奴は、\n何か吹っ切ったかのように、\n突然ぴた、\nと動きを止めた。","「随后那家伙，」\n「像是下定决心般，」\n「突然啪地，」\n「停止了动作。」"],["「……ふぅ……」","「……呼……」"],["「……や、いいけどな……言わなくても……」","「……嘛、不说也行啦……」"],["「……一緒に時間つぶし」","「……一起打发时间」"],["「……ぇあっ」","「……诶啊」"],["いや、それはそう言ってたかも知れないけども、\nと言うか話題の対象がすり替わってるような気も、\nああ、僕が変な事言ったからか……","「不、虽然可能是这么说过，」\n「但总觉得话题对象被偷换了，」\n「啊、是因为我说了奇怪的话吗……」"],["「…たしたちは、独りじゃ、だめなん、[l]\nでしょ」","「…我们、独自一人、是不行的，」[l]\n「对吧」"],["……まあ、","「……嘛，」"],["──それぞれ単体『だけ』では、あまりにつらいよな。","「──各自单独『仅凭自己』的话，实在太难受了。」"],["だから気持ちは分からないでも、ないが、\n","「所以这份心情也不是不能理解，」\n"],["……ないんだが、","……没有啊，"],["言ってる意味が、\n","你说的意思，\n"],["──もしかして、●●の余波が、\n","──难道说，●●的余波，\n"],["まあ、前も言われた通り、\n","嘛，就像之前被说过的那样，\n"],["──●●●ニ●●●イ？","──●●●尼●●●伊？"],["……コトバ通りに受け取るにとどめよう。","……就按字面意思理解吧。"],["「……のは兄ぃしか、居ないんだもん……」","「……只有哥哥，没有别人了啦……」"],["「………つに…………い……」","「………tsu ni…………i……」"],["………。[l]\n何だかよく判らないが、\nだからといって、\nこの状況で黙ってるのにはとてもじゃないが耐えられない、\nねるべく平静に、且つ軽薄そうに、\n僕は口を開いた。","………。[l]\n虽然不太明白怎么回事，\n但即便如此，\n这种状况下保持沉默实在让人受不了，\n尽量保持平静，且装作轻浮的样子，\n我开口了。"],["「ああ、そりゃ、光栄で……[l]\nいや、で、どうするつもりよ、今から……","「啊，那个，很荣幸……[l]\n不，所以，你打算怎么办，现在开始……"],["真","真"],["逆、[l]\nどっか泊まる気か？」","反过来，[l]\n要找个地方住吗？」"],["現状では、\n冬夏みたいに、僕の宿泊先アテにされると困る……","按现在的情况，\n要是像冬夏那样被安排到我住处就麻烦了……"],["「僕も、\n今旅館には……戻りづらいというか……[l]\n戻れないというか、今晩も車中泊、なのかな……」","「我也，\n现在回旅馆有点……该说难以回去……[l]\n还是说回不去，今晚也要睡车里吧……」"],["実際は、今宵どうしようかなんて、\n今の今まで思考の","实际上，今晚该怎么办这种事，\n直到刚才都"],["埒","被"],["外だった。","没考虑过。"],["……どうしよう。","……怎么办。"],["「だからどっかアテがあるなら送るから、」","「所以有地方去的话我送你，」"],["「……ぃじゃん、一緒に居れば」","「……不挺好嘛，在一起的话」"],["「……は？」","「……哈？」"],["「さっきから言ってるでしょぅ、[l]\n","「不是从刚才就在说吗，[l]\n"],["時間つぶし付き合って……ください……」","陪我打发时间……求你了……」"],["「……だめ？ですか？」","「……不行吗？」"],["「急にそんなしおらしくされてもなぁ……[l]\n大体お前、結局ずっと寝てないだろが……[l]\n寝なきゃあかん、だろ……」","「突然这么乖巧我也很为难啊……[l]\n话说你，其实一直没睡吧……[l]\n不睡不行吧……」"],["「眠くなったら寝る……から、それまで……」","「困了就会睡……所以在那之前……」"],["………や、だから、","………喂，所以说，"],["「寝るにしたってだからおま、\n泊まるとこどうするんだよ……[l]\n百歩譲って付き合うのは構わんとしてもだ、その……」","「要睡的话话说你啊，\n住的地方怎么办……[l]\n退一百步说陪你倒无所谓，但那个……」"],["「一緒に居るって言ってんだよ……[l]\nういも車中泊でいいよ……」","「说了要在一起啊……[l]\n我也睡车里就行……」"],["「……フハッ」","「……噗哈」"],["さっきの前置き無かったら、\n完璧にゴカイを招くぞ。","要是没有刚才的铺垫，\n绝对会招来误解啊。"],["──ゴカイか？","──误解吗？"],["冬夏にしても此奴にしても、\n","无论是冬夏还是这家伙，\n"],["──どうにも彼女等はねたがる、\n","──她们总是莫名执着，\n"],["僕はそんなに枯れてるように視えるか？","我看上去那么干瘪吗？"],["──Ｙはもうすっかり●起状態なのに、\n","──Y已经完全●起状态了，\n"],["あんまり安心されても、\n","被这么放心，\n"],["──切ないだろ。","──挺难受的吧。"],["いや、だからといってどうこうするつもりもないけど、\n","不，虽然也没打算做什么，\n"],["現実的なのか非現実的なのか、\nよく判らない心配をしつつ、半ば諦めて此奴に確認する。","分不清是现实还是非现实，\n怀着难以名状的担忧，半放弃地向这家伙确认。"],["「……あー、その、[l]\n家の方はほんとにいいんだな？」","「……啊，那个，[l]\n家里真的没关系吗？」"],["「……うん」","「……嗯」"],["「あと、その、お前自身もそうだけど、\n冬夏とか、姫様ちゃんは本当に、\n大丈夫なんだな？」","「还有，那个，虽然你自己也是这样，\n冬夏啊，姫様她们真的，\n没问题吗？」"],["自分の状況がしんどいときは、\n他人の事を心配する方が、\n気が紛れることもある。","当自己处境艰难时，\n担心别人的事，\n有时候反而能分散注意力。"],["──勿論時と場合によるけど、それよりも、\n","──当然要看时间和场合，不过比起那个，\n"],["もし、何か問題があったとしても、\n","就算真的出了什么问题，\n"],["僕に一体何が出来るのか、\nまるで見当も付かないけど……","我到底能做什么，\n完全心里没底啊……"],["「そう、ういは信じてる……んじてます……」","「嗯，我相信你……信你啦……」"],["「……そうか、……」","「……这样啊，……」"],["「自分の力や行動、言葉が、\n状況の好転になんら影響力を持たないのって、\n耐えられないよ……」","「自己的力量、行动和话语，\n对扭转局势起不到任何作用这种事，\n实在难以忍受……」"],["「結果を待つしかできない……って、[l]\nその時間が長ければ長い程、\n厭な想像とたたかわなきゃいけないのって、\n独りで、それは、」","「只能等待结果……而且，[l]\n等待的时间越长，\n就越要和糟糕的想象对抗，\n独自一人，那种感觉，」"],["「……そう、だな」","「……是啊」"],["気持ちは分かる、\n分かってる、つもり……だ、[l]\n同じものかは分からないけど、\n","这份心情我懂，\n自以为……是懂的，[l]\n虽然不确定是否相同，\n"],["──待つのは、\n","──等待的过程，\n"],["いたいよな……","确实煎熬啊……"],["「まあ、友達居ないんなら、\nしょうがないわな、\n僕が面倒みてやらあ、\n……ああそういや、[l]\nこんで借りは返し、でいいな？」","「嘛，要是没朋友的话，\n那也没办法，\n就由我来照顾你吧，\n……啊对了，[l]\n这次就当还你人情，行不？」"],["なるべく軽薄に、上滑りな感じで、\n僕は言った。","尽量用轻浮的、敷衍的语气，\n我这么说道。"],["──まあ、彼女達とはいずれ、\n","──反正和她们迟早会，\n"],["……友達、ともだち……","……朋友，朋友……"],["ああ、\n大神……彼奴になら、[l]\n電話しても良かったのかも、知れないな、\n今にして思えば、\n","啊，\n大神……要是那家伙的话，[l]\n说不定打电话也行得通，\n现在想来，\n"],["──オウトのことは予想外だったから、\n","──欧托的事确实出乎意料，\n"],["うん、今のこの状況が落ち着いたら……","嗯，等眼下这个状况稳定后……"],["「うっさいよばか……[l]\nそう言われたら、\nちゃんと、もっと他の返しがいい……」","「吵死了笨蛋……[l]\n被这么一说，\n应该好好想个更得体的回应……」"],["「あ？[l]\n……現金なやつめ……[l]\nじゃあそれはそれだ、\n勝手にお前が決めなさい、\nあーあ、……っしょっと」","「啊？[l]\n……现实的家伙……[l]\n那就这样吧，\n随你自己决定，\n啊真是……烦死了」"],["緊張状態を脱するように、\n僕は伸びをする。","为了缓解紧张状态，\n我伸了个懒腰。"],["「……うしよう……」","「……糟了……」"],["「……っと、あ？」","「……咦，啊？」"],["「にゃ？[l]\n","「喵？[l]\n"],["にゃんでもにゃーす！[l]\nばぁか、[l]\n","啥事都喵喵的！[l]\n笨蛋，[l]\n"],["ほれやっぱにゃんか買ってこようよ、[l]\n自販機いこうよ」","干脆去买点喵粮吧，[l]\n去自动贩卖机啦」"],["「自販機っていうか、\nコンビニでもいいぞ？[l]\nお前、本気で帰らない気なら色々準備もそれなりに……」","「说是自动贩卖机，\n便利店也行哦？[l]\n你要是真不打算回去的话，各种准备也得相应……」"],["「いいよ、\nまた貸しがどうとか言われそうにゃし、[l]\n","「不用啦，\n又要被说什么欠人情喵，[l]\n"],["夜に食べるにゃんて恐ろしくて……」","半夜吃东西太可怕了……」"],["──ああ、その歳でそんな気を遣ってるから、\n　　発育が……","──啊，这个年纪就这么操心，\n　　发育会……"],["……な、何を想像してる。[l]\n当然口には出さな……","……喂，你在想象什么。[l]\n当然没说出口……"],["「……？[l]\nどした」","「……？[l]\n怎么了」"],["何か掴みかけている、感覚が、……？","仿佛抓住了什么，那种感觉，……？"],["「……何かが……掴み……なんだ……？」","「……有什么……抓住了……什么……？」"],["「……つかむ……？[l]\n","「……抓住……？[l]\n"],["……はっ」","……哈」"],["「……あ？」","「……啊？」"],["「ばっ、………！！！！！！！」","「哇、………！！！！！！！」"],["「……？[l]\n……お前またトイレか？」","「……？[l]\n……你又要去厕所吗？」"],["突然囚われた奇妙な思考によって気が","突然被囚禁的怪异思绪扰乱了"],["漫ろだった僕が、\n故に特に意味もなく奴の顔を視ようとすると、\nまた視線ががっつりと、\n","心不在焉的我，\n因此毫无意义地试图直视那家伙的脸时，\n视线又一次死死地，\n"],["「……ちっ……！！！！！！！が！！[l]\nばかもの！！！！！！！[l]\nにゃんだこれわ！！！！[l]\n","「……切……！！！！！！！靠！！[l]\n笨蛋！！！！！！！[l]\n这啥玩意儿喵！！！！[l]\n"],["にゃんだこれゥアーーーーお」","这啥玩意儿喵呜啊啊啊——」"],["ごしごしごしごし、\nと両腕を抱いてさすり……というか擦り上げて[l]\n叫ぶ狩屋。","搓搓搓搓搓搓，\n抱着双臂摩挲……或者说蹭上去[l]\n大叫的狩屋。"],["今日は会ってからずっとそういう態度が所々で、\nなんなんだ、\n眼が合ったくらいでお前……","今天见面后处处都是这种态度，\n搞什么啊，\n不过是眼神对上了你……"],["「だからキライなら別に、\n言えばいいだろが、なんで、そんな暴れんだったら、」","「所以讨厌的话直说，\n不就行了吗，干嘛，这样暴跳如雷的，」"],["「はっ？！[l]\n","「哈？！[l]\n"],["誰がキライだっての？！[l]\nんなことひとっっっっっっことも言ってにゃいが！！！！！！！[l]\nっっっしろ、あ、うあ、あああああもう、\nあっ、あっ、ああ兄ぃの被害妄想野郎！！！[l]\nそんな心配すんなばか！！！」","谁说我讨厌了？！[l]\n这种话老子半句都没说过喵！！！！！！！[l]\n笨笨笨、啊、呜啊、啊啊啊真是的，\n啊、啊、啊啊大哥这个被害妄想狂！！！[l]\n别瞎操心蠢货！！！」"],["「……あっ、そう……ですか……」","「……啊、这样……吗……」"],["……あはは。","……啊哈哈。"],["そうか、僕は、\n","是吗，我，\n"],["──心配は無いんだよ。","──不用担心哦。"],["ああ、もう、\n","啊啊，真是的，\n"],["──もうすぐつかめる。","──马上就要抓住了。"],["だからもういまは、\n具体的に話す事なんか、\n無くたって、\n","所以现在，\n具体要说的那些事，\n就算没有，\n"],["──こうやっていっしょにいても、\n","──像这样待在一起，\n"],["いいのか。","也可以的吧。"],["──それが彼女達にとっても、\n","──对她们来说，\n"],["とは言え、確実に決断の時は、くる、\n","即便如此，做决定的时刻终会来临，\n"],["──そしてまだ問題はあるから、\n","──而且还有问题没解决，\n"],["……あのひととの、","……和那个人的，"],["──だからしっかりと、ツカまないとな。","──所以必须牢牢抓住才行。"],["だけど、\n今は、\n","不过，\n现在，\n"],["──これで、\n","──这样，\n"],["いいんだ。","就好。"],["……いいんだ。","……就好。"],["「あー、\nそのな、……」","「啊——，\n那个啊，……」"],["「にゃによ！」","「喵个啥！」"],["「……じゃあやっぱその、[l]\n車で夜明かしはやばいと思う……[l]\n経験者が語るんだから間違いないわな、\nしかもこの天気だし、\nそのかっこじゃ風邪も怖いし」","「……果然还是觉得，[l]\n在车里过夜太危险了……[l]\n过来人告诉你绝对错不了，\n何况这种天气，\n穿这么少肯定会感冒」"],["「……」",""],["貸した服をしっかりと握り、\n","紧攥着借来的衣服，\n"],["不","不"],["貞","贞"],["腐れたように窓の外を視る狩屋。","像腐烂般凝视窗外的狩屋。"],["「きいてんのか？[l]\nあと、祭……も近いんだからよう、[l]\n朝になったら、戻りなよ。[l]\n僕も、色々と、\n","「有在听吗？[l]\n还有，祭典……也快到了，[l]\n天亮后就回去吧。[l]\n我也有，各种各样，\n"],["──しなければならないことがある、\n","──必须去做的事，\n"],["……あるんだよ」","……有的啊」"],["「……？[l]\n…………、[l]\n……ふぅん」","「……？[l]\n…………，[l]\n……哼嗯」"],["顔だけこっちを向き、\n何か怪訝な顔をしたが、\n深く追求することなく頷き、前に向き直った。","只有脸转向这边，\n露出些许疑惑的表情，\n但没深究就点点头转回前方。"],["よく判らないが、僕はエンジンを切って奴に言う。","虽然不太明白，我还是熄火对那家伙说。"],["「まあいいや、えーとあれか、\n自販機？[l]\n行こうか。[l]\n一応軽い食い物も買えんことはないし」","「算了无所谓，呃那个，\n自动贩卖机？[l]\n要去吗。[l]\n顺便也能买点轻食」"],["「ういは","「窝才"],["要らにゃーい。[l]\n飲み物だけでいいもんにぇー。[l]\nういしょと」","不要咧—。[l]\n只要饮料就行啦—。[l]\n嘿咻」"],["急に普通のテンションに戻ったと思ったのも束の間、\n","刚以为她突然恢复平常状态，\n"],["ばたむ。","啪嗒。"],["「さっ！！！！！！！[l]\nさぶいっっっっって！！！」","「好！！！！！！！[l]\n好冷冷冷冷冷啊！！！」"],["降りずとも知れてた事ではあるけれど、\nまだ降り続けてるんだこれがまた！！[l]\nつーか数段レベルがあがってないかこれ！！","虽然不下车也知道情况，\n但这雪居然还在下！！[l]\n话说雪势是不是又升级了啊！！"],["「どっ！[l]\nどっち！どこ、どれ！！！」","「哪！[l]\n哪边！哪里，哪个！！！」"],["「こっ！[l]\nこっち！そこ、それ！！！」","「这！[l]\n这边！那里，那个！！！」"],["「さんみぃーーーだよこればかかっておわああああもうううう」","「冷死啦———笨蛋吗啊啊啊真是的」"],["「あいだだだだ走りにきぃだろがあああああさぶさぶさびぃい」","「中中中中间跑起来啊超冷冷冷」"],["小走りに自販機に向かう僕の腕をがすっと掴んで引き寄せる狩屋。","小跑向自动贩卖机的我，手腕被狩屋唰地抓住拽过去。"],["「い゛い゛がら、はや゛ぐ」","「快、快走」"],["がっつり密着してきやがる。[l]\nてかそのチカラが強ぇえって！！！","整个人都贴了上来。[l]\n话说这力气也太大了吧！！"],["「までまでまで、小銭がこれ、また、う゛う゛う゛う゛う゛う゛、\nほれ、おめえの分じゃい」","「等等等等，零钱这个，又，呜呜呜呜，\n喏，你的份」"],["「ひいあーーーーさんくすあんどはりあーーっぷ」","「噫啊———三克油哈利路亚———」"],["がたがた震えながら僕等は、\n件の自販機にたどり着いたはいいけれど、\nあんまりこのままだと、\n思考も止まるって、\nいうよりもう、\nだので選んでるヒマとか余裕もなく、\n適当に、且つ即決して、\n僕等２人、ダッシュで車に戻りました。","哆哆嗦嗦发抖的我们，\n好不容易到达目标贩卖机，\n但再这样下去，\n连思考都要，\n不如说已经，\n所以根本没空慢慢挑选，\n随便且迅速地决定后，\n我们俩冲刺跑回了车里。"],["「きーーーーーーあげでーーーーーーーーはようーーーー」","「开——————暖气——————快点——————」"],["「わがっでるっでのおおおうううううううう」","「冻冻冻冻死啦啊啊啊啊啊」"],["どむ、ばだむ！！","咚，啪嗒！！"],["「いででいででいでで」","「好冷冷好冷冷好冷冷」"],["「……！！！[l]\n……！！！[l]\n……！！！！！！！」",""],["エンジンを掛け直し、暖房が効き始めるまで、\n狩屋は何故か僕の腕やら肩やらをばふばふ叩きまくり、\n謎の鼻歌……というには","重新发动引擎，在暖气生效前，\n狩屋不知为何啪啪拍打我的手腕和肩膀，\n哼着谜之小调……说是"],["烏","恬"],["滸がましい、[l]\n謎のメロディを唸りながら、\n己が暖まるまでを堪え忍んでいた。","过于嚣张的，[l]\n谜之旋律，\n强忍到身体暖和为止。"],["結局そうやって、僕等の両方が落ち着くまでに、\n五分以上かかってた……ようだ。","结果就这样，直到我俩都平静下来，\n花了超过五分钟……的样子。"],["「……と、いろいろ実感したところでだ、[l]\nやっぱ、お前だけでもどっかちゃんとしたとこに、\n泊まった方が、\nいいんじゃないかね……[l]\nこの寒さは尋常じゃない……」","「……在切实体会到各种状况之后，[l]\n果然还是该让你至少找个正经地方，\n住下来比较，\n好吧……[l]\n这寒冷程度太反常了……」"],["「……でも兄ぃ、[l]\n向こうの彼処以外で泊まれるとこって言ったら、\n……その、あの、」","「……可是老哥，[l]\n要说除了那边那地方之外还能住哪儿的话，\n……那个，呃，」"],["ああ、そう言えば、\n手持ちの予算も微妙だし無茶は出来まい。[l]\n祭が近いとなれば六母屋以外の宿も飛び込みでは難しいかも知れない、\nしかしそうなると、\n田舎の道端でよくある簡易宿泊施設とかしか、\n思いつかん……","啊对，说起来，\n手头预算也够呛，乱来不得吧。[l]\n临近祭典的话，六母屋以外的旅馆临时投宿恐怕也难，\n但这样的话，\n就只剩下乡下路边常见的那种简易住宿设施，\n想不到了……\""],["「……道中でもあるにはあったが、いや、しかし、[l]\nそれは……」","「……路上倒也不是完全没有，但不行，可是，[l]\n那个……」"],["「道中……ってどれ？[l]\nあったっ、け……」","「路上……指哪个？[l]\n有过吗……」"],["「……？[l]\n………」",""],["「あーその、\n","「啊那个，\n"],["所","的"],["謂だな、\nこう、素泊まりの、ホテルっつーか……」","怎么说呢，\n就是，光住宿的，酒店之类的……」"],["「あーあー、確かにあっ──[l]\n","「啊—啊—，确实有啊──[l]\n"],["………はぅあ！[l]\n","………哈呜！[l]\n"],["ちが！！[l]\n","不对！！[l]\n"],["ばか！！あほう！！[l]\nねねねねねネっ、げほ、カフェだっつーの！！！！[l]\n","笨蛋！！蠢货！！[l]\n喂喂喂喂喂喂，咳咳，是咖啡馆啦！！！！\"[l]\n"],["ラっ……ありえないから！！！[l]\n","怎……怎么可能啊！！！[l]\n"],["それはないから！！！！！！！」","这绝对不可能！！！！！！！」"],["「あ？！[l]\nあ、あーーああ、ああ、ああ、\nネカフェな！！　いわゆるネットカフェな！！[l]\nわかってるての！！！[l]\nただあれだ、──そもそもあるのか？存在するのか？[l]\nこの辺でも」","「啊？！[l]\n啊、啊──啊啊、啊啊、啊啊、\n是网咖！！就是所谓的网络咖啡厅！！[l]\n我明白的！！！[l]\n只是那个啊──说到底真的存在吗？[l]\n这附近」"],["無理矢理冷静な方向へ軌道修正する。","强行将话题掰回冷静的方向。"],["ともあれ、うーん……[l]\n馬鹿にしてる訳じゃないが、\n土地によってはネットインフラ厳しいからな……[l]\nアナログな僕ではあるが、旅行してる関係でその程度は知ってる。[l]\nこういう所は設備に対してのネット人口少なくて快適か、\n単にインフラ整備が遅れてきついかのどっちかだった気がした。","总之，嗯……[l]\n倒不是在嘲笑你，\n有些地方的网络基建确实很糟糕……[l]\n虽然我是个老派的人，但因为旅行关系这点常识还是有的。[l]\n这种地方要么因为用网络的人少所以很舒适，\n要么就是单纯基建落后用起来很痛苦。"],["ましてやまともに宿泊可能なサービスが期待出来るかどうか、\n需要がある土地柄とは、うーん……","更何况能否期待像样的住宿服务，\n要说是不是有需求的地段，嗯……"],["「えあ。[l]\n","「呃啊。[l]\n"],["わ……っかんにゃい……[l]\n","搞……搞不懂喵……[l]\n"],["つかったことは……にゃい」","用过……没有喵」"],["まあ、そうだろうな……[l]\n此奴も知識で知ってただけだろうし……","嘛，也是啊……[l]\n这家伙也只是从知识层面知道而已……"],["「………。[l]\nまあ、\n最悪ネカフェじゃなくても、\nあれだ、何にもしなけりゃ良い訳だろ！[l]\nその、素泊まり的なとこでもだ、\n値段とかにもよるけど……」","「………。[l]\n不过，\n最坏情况不去网吧也行，\n那个啊，什么都不做不就好了嘛！[l]\n就算是那种，只提供住宿的地方，\n虽然也要看价格啦……」"],["「……！！[l]\n",""],["っ、う、うえあ、いやぁ……それは……[l]\n","呜、呜哇啊，不……那个……[l]\n"],["や、やばいですやばいですぜったい、[l]\n","糟、糟糕了完蛋了绝对，[l]\n"],["……ぜったいやばいですぅうう……」","……绝对完蛋了呜啊啊……」"],["「そうかなあ……」","「是这样吗……」"],["お前も僕も先刻から、\n変な気はないとしつこいほど明言してるだろうに、\nそこだけひっかかる意味も今更、\n","你和我从刚才开始，\n不是反复强调过没觉得奇怪吗，\n事到如今还在意这个的意义，\n"],["と思ってそっちを視ると、\n完全に同じタイミングでこちらの方を向いた奴と、\n真っ向から視線が合う。","正这么想着看向那边时，\n和完全同步转向这边的家伙，\n视线笔直地对上了。"],["「……っあっ……と」","「……呜啊……那个」"],["「……なんだよ」","「……搞什么啊」"],["何度視線が合おうと、それ自体は別におかしなことでも何でも、\n","无论视线交汇多少次，这本身根本不是什么奇怪的事\n"],["「──ほっ、ほっ、ほぅーーん」","「──呼、呼、呼诶──」"],["──ないんだろうに、\n","──明明不该有的\n"],["声を裏返して思いっきり真正面に向き直って、\n大わらわになりながら続けた。","声音发颤地猛然转回正前方\n手忙脚乱地继续说着"],["「ほ、ほんとに最悪の時は車中泊じゃにゃいん！？[l]\nいいよういは若いし一晩くらい、\n……ややや、ういだってさ、[l]\n仮に変なトコ泊まったって何もないよ？[l]\nあるわけないすよ？[l]\nないけど、[l]\n","「真、真的最糟情况要睡车里喵！？[l]\n反正还年轻熬一晚也没\n……呀呀呀、饭也说过啦[l]\n就算住可疑地方也不会出事？[l]\n怎么可能出事嘛？[l]\n虽然不会出事[l]\n"],["その、別に兄ぃがヤだって事じゃなくて、[l]\n","那个、不是讨厌大哥的意思[l]\n"],["だから傷付かないで欲しいんだけど、[l]\n","所以希望你别受伤[l]\n"],["その、」","就是、」"],["……あ、ああ、[l]\nああ。[l]\nいや、まあ、\n気にしてないというかそこまで押し広げて考えてなかった、\nので、傷付くも何も……[l]\nなのでそう言った。","……啊、啊啊[l]\n啊啊[l]\n不、那个\n与其说不在意不如说根本没想那么深\n所以受伤什么的也…[l]\n于是这么说了"],["「ぐ、それはそれでにゃんかむかつくのう……」","「呜、这样反而更火大喵…」"],["どうしろと……","要我怎样…"],["というか、お前が何かと僕をフォローするのって、\n","话说回来、你总在各方面关照我\n"],["「……姫様ちゃんに言われてるからだろ？[l]\nなんつーかその、僕の事は、\nもっと素直に、\nイヤならイヤって言って構わないし、その、\n社交辞令は逆に辛いしさこっちも」","「……是姫様吩咐的吧？[l]\n该怎么说呢、关于我的事\n更坦率点\n讨厌就说讨厌也没关系\n客套话反而让人难受」"],["「……期待させられといて引っ繰り返されるのは、[l]\nもう、ヤなんだよ……[l]\nあっ、いあ、お前に期待してる訳じゃねーぞ！！[l]\n………。[l]\nでもまあそういうこったから、\n自分の意思とか感情で、僕に接してくれて構わんし……[l]\n姫様ちゃんとの事も分からんでもないが、そこは、まあ、」","「……给了期待又反悔这种事[l]\n真的、很讨厌…[l]\n啊、不是、不是说对你有所期待！！[l]\n………。[l]\n不过就是这么回事\n按你自己的意志或感情对待我也没关系…[l]\n虽然理解你和姫様的关系、但那里、那个」"],["「……あれまた地雷ふんだか？」","「……又踩地雷了？」"],["「……そう思いたいならそう思えばいーんじゃないのっ？」","「……要这么想随你便啦！」"],["「え、地雷？」","「咦、地雷？」"],["「そっちじゃにゃー！[l]\n","「不是那边喵！[l]\n"],["……いいよもう、いいよもうっ。[l]\nあーもうあのね、あなた、\nいい加減自信もってくんないとわたし、[l]\n","……够了真的、够了啦[l]\n啊真是的、你啊\n再没点自信我就要[l]\n"],["むらむらしてもういっ──ちゃ、……」","躁动得快要──…」"],["「……むらむら？」","「……躁动？」"],["「むらむら、……むらむら？[l]\n","「躁动、……躁动？[l]\n"],["違った！！！[l]\n","不对！！！」[l]\n"],["いらいら！！！！！！！[l]\n苛苛です！！！！！！！[l]\n","是焦躁！！！！！！！[l]\n烦躁啦！！！！！！！[l]\n"],["てかもうだから、[l]\n","所以说啊[l]\n"],["ういはすきだから兄ぃのことは！！！[l]\nふつうのいみでふつうのはんちゅうでですけど！！！！[l]\nだから変に卑屈なんないでくれるっていうかこっちを視ないで！！[l]\n…んなかんじになるからっ」","饭是喜欢大哥的！！！[l]\n普通意义上的普通范围啦！！！！[l]\n所以别莫名其妙自卑也别看这边！！[l]\n…会变成这样的」"],["……普通の意味……気に入ってるとかそういう、[l]\nやわい意味、だろう。[l]\nというか『こっちを視んな』っていう発言とどう並立させよう。","……普通意义…中意之类的[l]\n温和的意思、吧[l]\n话说『别看这边』的发言要怎么自圆其说"],["「それにわたくしもう何回かいってる気がしますけどっ？？！！[l]\n今までにもそういうことは既にっ！！！[l]\n兄ぃなら、兄ぃとなら、あああもうこう言うとまた、\n兎に角きにしないで！！[l]\n厭だったらきーちゃに言われてたってこんなに近づけません！！！[l]\n","「而且本小姐感觉说过好多遍了好吗？？！！[l]\n之前就已经这样说过啦！！！[l]\n如果是大哥、和大哥的话、啊啊啊又说这种话\n总之别在意！！[l]\n真讨厌的话被小姬说也不会靠这么近啦！！！[l]\n"],["きーちゃのこととは、関係、あー、[l]\n","和小姬的事、关系、啊──[l]\n"],["きーちゃのこととは……」","关于小姬的事……」"],["「わ、わかった、わかった！！！[l]\nとっ、兎に角、泊まるとこだ！！！[l]\nそれをかんがえよう！！！」","「我、我知道了，知道了！！！[l]\n总、总之先找个住的地方！！！[l]\n先考虑这个！！！」"],["いらぬ方向にずれて、\nいらぬ糾弾や気遣いを互いにする羽目になる前に、\n強引に話を戻した。[l]\nまあ、己が蒔いた種だけども……[l]\nどうにもそういう、\nそれこそ地雷を踏む率が此処に来て跳ね上がってるような、\n","在话题朝着多余的方向偏离、\n演变成互相无谓指责和过度关心的局面之前，\n强行把话题拉了回来。[l]\n虽说这也是自己种下的恶果……[l]\n但不知为何、\n就像踩雷概率突然飙升似的、\n"],["迂","迂"],["闊な言動が多くなってるな……[l]\n状況を鑑みて当然と言えば当然かもだけど……","最近口无遮拦的情况越来越多了……[l]\n考虑到现状倒也算理所当然……"],["──というか、此奴がそういう方向に誘導してる節が、\n","──或者说，总觉得是这家伙在刻意引导话题、\n"],["あるというか、\nゴカイを招くような、\n","往这种方向发展、\n就像在招引蜈蚣般、\n"],["──トーカのように","──像冬夏那样"],["直","直"],["情","情"],["径","径"],["行じゃなく、\n","直不行、\n"],["ややこしい真似をしよるから、\n","净搞些麻烦的操作、\n"],["「う、うぬ、[l]\nあっ、そのね、[l]\n","「呜、呜嗯、[l]\n啊、那个啦、[l]\n"],["眼、眼だけ急に合わせないで……[l]\n","别、别突然只盯着眼睛看……[l]\n"],["ああああの、●●が●●●●●ゃうからさぁ……」","啊啊啊那个，●●会●●●●●的啦……」"],["「あ、ああ、よく分からんが分かった……」","「啊、啊，虽然不太懂但明白了……」"],["実際にどう防いだら良いかは定かじゃないが、\nまあ、顔面向けなきゃ良いんだろうし、\n発言の後半も聞き取れなかったので返答としても有耶無耶、\n格別きっちりと厳守しようと思う程でもなく、生返事する。","其实也不知道具体该怎么防范、\n不过只要不盯着脸看就行了吧、\n后半句话也没听清就含糊其辞、\n也没打算严格遵守要求，随便应付着回答。"],["奴はまた暫く腕をさすってばかりいたが、\nトーンが落ち着いた頃に言った。","她又搓了好一会儿手臂、\n等语气平静些时才开口。"],["「……はふぅ……えー、っと？[l]\n……周りに駐めてる車ないし、[l]\nいいよもう、\n此処で寝ちゃおうよぅ。[l]\n無闇に探し回るには路面、きついでしょが」","「……哈呼……呃—，那个？[l]\n……周围也没停着的车、[l]\n算了啦、\n就在这儿睡吧。[l]\n这种路况到处乱找太遭罪了」"],["「あ？[l]\nあ、あー、そう……かもなあ、[l]\nナビで探してももう、きついかこれは……」","「啊？[l]\n啊、啊—，确实……可能吧、[l]\n用导航找现在也太勉强了……」"],["「というかもうね、\nげんかいなのれす、\nこのままねられれば、\nなやまないでいけそう……」","「不如说真的、\n到极限了啦、\n就这样睡着的话、\n说不定反而不会烦恼……」"],["……よく判らないが、[l]\n多分前後不覚な感じのまま眠りに落ちれば、\n余計な……ネガティヴな思索に陥らず、[l]\nそのまま永き忘我の時間、\n睡眠というしあわせな時間に入れるという事、\nだろうか。","……虽然不太明白、[l]\n但大概是以迷糊的状态入睡的话、\n就不会陷入多余的……负面思考、[l]\n直接进入长久的忘我时光、\n也就是睡眠这种幸福状态、\n的意思吧。"],["実際、車中も暖まってきて、\n今の大暴れ──精神面も含む──で、\n寝てない疲労が一気に奴を襲ったのだろう。[l]\n今し方自販機で買ってきた飲料に口を付ける間もなく、\n此奴の動きは既に結構な緩慢加減になってきていた。","实际上车里也暖和起来了、\n加上刚才那通大闹──包括精神层面──\n长期缺觉的疲惫应该瞬间袭倒了她。[l]\n连刚从自动贩卖机买的饮料都来不及喝、\n这家伙的动作已经明显变得迟缓。"],["いや、しかし、\nほんとに此処で車中泊でいいのか……","不过话说回来、\n真要在车里过夜吗……"],["「……いいか、タダだしな……」","「……反正免费……」"],["「うーぬ、\nにゃんでもええにょうー……」","「唔—嗯、\n怎样都好啦—……」"],["今更","事到如今"],["斯","此"],["様な現金な理由でマジに決断した訳じゃなく、\n単に僕ももう考えるのが","倒也不是因为这种现实理由认真做的决定、\n单纯是我也懒得"],["億",""],["劫になってきてるからだった。[l]\n変なゴネ方をしても、\nゴネる理由が全てその、そっち方面に根を持つ訳で、\n身に","因为已经变成劫了。[l]\n就算用奇怪的方式纠缠，\n纠缠的理由全都扎根于那个、那方面的事，\n如果"],["疚しい事が無ければなんら問題は無い筈であり、\n……単に先延ばしである事は重々承知していたけれど、","心里没鬼的话本应毫无问题，\n……虽然心知肚明只是单纯在拖延，"],["──今は伏して待つのがいい、\n","──现在还是趴着等待比较好，\n"],["それで、いいんだ。","这样，就好。"],["「じゃ、\nお前後ろ行け。[l]\n背もたれ倒せるから」","「那，\n你到后面去。[l]\n可以放倒椅背」"],["「うー、このまんまここでもいいにょうー……」","「呜～就这样待在这里也可以嘛～……」"],["「いや、マジできついから、\n今の内にほれ、動けって」","「不、真的很难受，\n趁现在快动起来」"],["「にゅあー」","「喵啊～」"],["先刻の口振りからいって、\nまた外気に触れたがらないとは思っていたが、\n此奴、\n助手席を少し倒して、無理矢理車内移動で後ろに行こうとした。[l]\n行くこと自体は出来そうだったが、その、……奴の下半身が近くなるので、[l]\n僕はずっとドア側に身体を寄せて外を凝視する羽目になった。","从刚才说话的语气来看，\n虽然料到他又不愿接触外界空气了，\n这家伙，\n把副驾驶座稍微放倒，想强行挪到车后排。[l]\n移动本身似乎可行，但那个、……因为下半身会靠得太近，[l]\n我不得不一直紧贴车门盯着窗外。"],["移動が済んで、\n後ろで準備も出来たようだったから、\n置きっぱなしにしていった飲料を手渡して、\n運転席を倒すスペースだけ気をつけるように言った。[l]\n暗くてよく判らないが、\nどうやら髪もほどいたらしい。","等他挪完位置，\n后面好像也准备好了，\n就把随手放着的饮料递过去，\n只提醒他注意留出放倒驾驶座的空间。[l]\n虽然太暗看不清楚，\n似乎连头发也解开了。"],["「あと、エンジン切るからな、\nちゃんと","「还有，我要熄火了，\n好好"],["包まっとけよ」","裹紧被子啊」"],["「にゃおー」","「喵嗷～」"],["「あとはまあ、勝手に寝てくれ……[l]\n僕も適当に、寝る……」","「之后你就随便睡……[l]\n我也随便，睡会儿……」"],["「にゃいー」","「喵咿～」"],["「……なんかあったら遠慮無く起こして構わないから、[l]\nなんかあったら言えよ」","「……要是有什么事不用客气尽管叫醒我，[l]\n有事就说啊」"],["「にゅいー……」","「喵呜～……」"],["エンジンを切った。","熄灭了引擎。"],["先刻のように、\n急激に静寂に包まれる。","如同先前一般，\n骤然被寂静包围。"],["耳鳴りがする程に、静だ。","静得几乎耳鸣。"],["幸か不幸か、\n","幸或不幸的是——\n"],["──あれらの所為で、\n","托那些事的福，\n"],["こういうシチュエーションにはもう慣れたから、\n僕も格別感情が昂ぶるでもなく、\n滞りなく、奴の言うところの好い具合に意識が混濁するに至りそうで、\n","对这种状况已经习以为常了，\n我也没特别情绪高涨，\n顺顺当当就要达到那家伙所说的意识模糊的绝佳状态，\n"],["……ああ、[l]\nこんなときに、\n誰かが側に居るというのは、\n思ったよりも、\n","……啊啊，[l]\n这种时候，\n有人陪在身边这件事，\n比想象中更——\n"],["「……シャワーとか浴びてないから、[l]\n……におったらごめん」","「……还没洗澡，[l]\n……有味道的话抱歉」"],["「そんなこといったらこっちの方があれだ、\nお互い様っていうか、\nいや……お前はにおってないから心配しなさんな……[l]\nむしろこっちこそ、」","「这么说的话我这边才更那个，\n算是彼此彼此吧，\n不对……你根本没味道别担心啦……[l]\n倒是我这边才该——」"],["「ん……、[l]\nんーん、におわないよ。[l]\n借りた服だってほら、\n……ん、大丈夫」","「嗯……、[l]\n嗯～嗯，没味道呀。[l]\n借来的衣服你看，\n……嗯，没关系」"],["……嗅ぐな嗅ぐな。","……别闻别闻。"],["「あと自分じゃわかんないけど……[l]\n指摘されたことぁ無いけどそういう機会がそもそもだな、\nいや、兎に角あれだ、\n","「还有自己可能察觉不到……[l]\n虽然没人指出过但本来就没那种机会吧，\n不、总之就是那个，\n"],["鼾だの","鼾声啊"],["歯","磨牙"],["軋りだの、\nうるさかったらごめんな……」","还有各种动静、\n吵到你的话抱歉啦……」"],["「んーー、\n……だいじょうぶ……なれてる……」","「嗯——\n……没关系……我习惯了……」"],["「……そいつは結構……[l]\nじゃあ、おやすみ……」","「……那样倒也不错……[l]\n那就晚安啦……」"],["「……ぐっす……みん……」","「……呼噜……呼……」"],["………なに？[l]\nいあ、まあ、いいや……","………啥？[l]\n啊、算了、没事……"],["「……やっぱさむい」","「……果然好冷」"],["「……ああん、[l]\nでもなあ、流石にエンジン入れっぱなしは……」","「……啊啊、[l]\n不过啊，引擎一直开着果然还是……」"],["「……こっちで密着してねようぜぇ」","「……不如贴着我睡吧」"],["「……っあ？！」","「……哈啊？！」"],["おまえ、おまえなあ、\n","你这家伙、我说你啊、\n"],["──お前は誰かさん達か。","──你莫非是那位的手下。"],["「にゃんでそういうことになる？！」","「为啥会变成这种展开？！」"],["思い出すだろうが、色々と、ああもう、\n","你应该能想起来吧，各种事情，啊啊真是、\n"],["──そろそろお●●けはきつくなってきてるしさあ。","──再说●●也快到极限了。"],["前言撤回、\n或る意味で今までのより激しいだろ、\n冬夏ですら布団越し……いや、兎に角、[l]\nそこまでのシチュエーションには慣れてない！[l]\nこ、此奴は知る由もないけど……","我收回前言、\n某种意义上比之前的更激烈吧、\n连冬夏都隔着被子……不对、总之、[l]\n这种状况我可没经历过！[l]\n这、这家伙当然不知道……"],["しかし、\n当然僕のこの反応は予想していたらしく、\n","但是、\n她似乎早就预料到我的反应、\n"],["「へ、変な気にゃいなら逆にだいじょぶでしょぉ！[l]\nケチって身体壊すハメになるよりは、\n私そんなことで別に、変なアレもないし？[l]\n兄ぃはきらいじゃないしむしろすきだし？[l]\nと前もって言ってみました！！！[l]\nだから気にする事はありません！！！[l]\nこれでいいでしょ？？！[l]\nああああああもうさむいんだってだからっ！[l]\n凍死させるきか！！[l]\nいいの！！本人が言ってるんだからっ、[l]\nこいはやく！！ほら！！」","「既、既然不觉得奇怪反而没问题吧！[l]\n比起吝啬到搞坏身体、\n我又不会因为这种事产生奇怪的念头？[l]\n不如说我根本不讨厌哥哥反而很喜欢？[l]\n这些我早就声明过了！！！[l]\n所以完全不用在意！！！[l]\n这样总行了吧？？！[l]\n啊啊啊都说了超冷的啦！[l]\n想冻死我吗！！[l]\n没关系！！本人都这么说了、[l]\n快点过来！！快啦！！」"],["と言う。","说道。"],["………ほんっとに、","………真是的、"],["──自己存亡の危機に際し、\n　　そういう方向に行くのは自然だけどな。","──面临生存危机时、\n　　产生这种想法也很自然吧。"],["いや、いやいや、\n此奴自身も言ってる通り、\nそう言う方向とかそんなつもりはない！！！[l]\nただ、\n","不、不不、\n就像她自己说的、\n根本不是那种方向或那种意图！！！[l]\n只是、\n"],["──イきようとする意思にとっては好影響というか、\n","──对求生意志来说算是积极影响、\n"],["深刻になりすぎて自滅するよりは、\n","比起过度认真导致自我毁灭、\n"],["──こうやって気を紛らわし、\n","──像这样转移注意力、\n"],["多少現実から眼を背けた楽観主義的であっても、\n","哪怕暂时逃避现实保持乐观、\n"],["──在りたい、残りたい残したいという、\n","──想要存在、想要留存的心意、\n"],["前向きな気持ちの方が、\n","这种积极的心态、\n"],["──いい場合もあるさ、なにしろワレらの本分は、\n","——有时候反而更好，毕竟我们的本分就是、\n"],["「……マジですか……」","「……认真的吗……」"],["「……マジです……」","「……是认真的……」"],["……というわけで、[l]\n無駄に強烈な覚悟を決める事にしました。","……就这样、[l]\n我下定了无比强烈的决心。"],["「わ、わかったっての……[l]\nっこいしょ……」","「知、知道啦……[l]\n嘿咻……」"],["前後の座席を、がっつり２人が寝られるように調整し、\n準備を整えると、\n","把前后座椅调成足够两人平躺的空间、\n做好准备后、\n"],["「うい……どうぞ……」","「来……请吧……」"],["上着を布団のように持ち上げ僕を招き入れる狩屋。","狩屋像掀被子般提起外套示意我钻进来。"],["……なんだかなあこのかんじは……","……这莫名的心跳加速感……"],["まあ、","不过，"],["邪な気持ちはこれっぽっちもないので！[l]\n堂々と奴と密着する。[l]\nもう１枚脱いでいた服を更に重ねてはみたが、\n２人とも","我可没有半点邪念哦！[l]\n光明正大地和他紧贴在一起。[l]\n虽然试着把脱下的另一件衣服又盖了上去，\n但两个人"],["仰","仰"],["臥姿勢では、\nどうしてもはみ出る。[l]\n当然奴にきっちり被るようにはしたけれど、\n僕がはみ出てる事に気付いたのか、狩屋は横臥姿勢に、\n","卧姿势的话，\n无论如何都会露出来。[l]\n虽然确实让他严严实实地盖住了，\n但狩屋似乎注意到我露在外面的部分，改用侧卧姿势，\n"],["──しかもこっち向きで、\n","──而且还是面朝我这边，\n"],["びたっと文字通り密着してきやがった。","啪地一声真就贴了上来。"],["「ほ、ほらだいぶ、\nあったかい……」","「看、看吧已经很、\n暖和了……」"],["「うーーーーーーん、お前、\n横向きは良い案だと思うけども、\n背中合わせで良いんじゃないのか……」","「唔——————嗯，你\n觉得侧卧是好主意，\n但背靠背不是更好吗……」"],["「……？[l]\nこれで……何か……問題が？」","「……？[l]\n这样……有什么……问题吗？」"],["舌の根の乾かぬうちにと言うか、\nお前","俗话说话音刚落，\n你这家伙"],["先","不"],["刻視線合わすなとか言ったろう！[l]\nきゅ、急じゃなきゃいいって訳じゃないだろうに！","不是说过别对上视线吗！[l]\n呜、就算不急也不代表可以这样吧！"],["「……寝れば……問題にゃいじゃんにょう……」","「……睡觉……就没事了喵……」"],["「あー、……あー」","「啊——……啊——」"],["下手に突っ込むと先の再現になるので、\n……というか此奴の貞操観念の程度が分かんなくなってきた……[l]\n何処までがアリなのか境界が……[l]\nそれとも、\n眠さで何処か頭のネジ飛んでるのか……[l]\nそ、それはさておき、\n流石に僕の方は慌てて背中を向ける。","贸然插话可能会重蹈覆辙，\n……或者说这家伙的贞操观念程度越来越让人搞不懂了……[l]\n到底哪里是允许的界限啊……[l]\n还是说，\n困得脑子哪里的螺丝飞掉了……[l]\n那、那个先放一边，\n就连我也不由慌忙转过身去。"],["すると背中の方から、\n奴が何か言った。","结果从背后传来，\n那家伙说了些什么。"],["「……抱き……状態のが……[l]\nよさげ……かなあ……」","「……抱着……的状态……[l]\n好像……不错……啊……」"],["「……表面積を……なく……」","「……减少……表面积……」"],["「……？？」",""],["もうほぼ完全に寝惚けてる感を","已经几乎完全处于睡迷糊的状态了"],["醸し出し始めた狩屋は、\n何かぶつぶつ言いながら、\nのっそりと、\n僕に脚と腕を絡ませて……つまり、[l]\n僕を抱き枕のように、\n状況的にはおんぶに近いわけだが、\n","开始酝酿情绪的狩屋，\n一边嘟嘟囔囔地说着什么，\n慢吞吞地，\n把腿和手臂缠到我身上……也就是说，[l]\n把我当成人肉抱枕，\n从姿势上来说更接近背驮式，\n"],["いや、おまえ、\n","喂、你这家伙，\n"],["「……おー……これ……いい……おっき…て…あったか……」","「……喔……这个……好……好大…又…暖和……」"],["寝惚けてるのもあろうか、\nそれとも誰かと間違えてるのか、\n……お前、後で我に返って誰かみたいに猛烈後悔するなよ……","可能是还没睡醒吧，\n又或者是认错人了，\n……你清醒后可别像某些人一样后悔得捶胸顿足啊……"],["案外、\n","出乎意料的是，\n"],["僕もこのまま寝られそうだな……","我好像也能就这样睡着呢……"],["「……なんでだ……」","「……为什么啊……」"],["思った程違和感が無い……","并没有想象中那么违和……"],["そう、\nこれは状況慣れとは違う、\n","没错，\n这和习惯成自然不同，\n"],["……ああ、そうか、","……啊、原来如此，"],["──七相は、\n","──七相，\n"],["「……ふへあっ、[l]\n……っ、ごめん、とんでました……[l]\n……なに？」","「……呼诶啊、[l]\n……、抱歉、我走神了……[l]\n……什么？」"],["「……いや、なんでもない、[l]\n寝れてるならいい……そのまま寝なさい……」","「……不、没什么、[l]\n能睡着就好……继续睡吧……」"],["「……ぁい……ん……ふす……」","「……好……嗯……呼噜……」"],["「くー……[l]\nすー……[l]\nくー……」","「呼——……[l]\n吸——……[l]\n呼——……」"],["………",""],["「……うか……」","「……冬夏……」"],["とうか、\n","冬夏、\n"],["冬夏、ともこんなに、いや、\n","冬夏、居然能这么、不、\n"],["──あっちは","──那边"],["背","背"],["景が","景色"],["混","各"],["淆としていて、\n","混沌不清、\n"],["あの頃は僕もなにも解ってなかった、それでも、\n","那时候我也什么都不懂、即便如此、\n"],["──いまもまだ掴みかけだが、\n","──现在也还没完全抓住、\n"],["これから、どうしたら、いいのか、\n","今后、该、怎么办、\n"],["──彼女達と、どうあるのがヨきミちだろうか、\n","──和她们、怎样相处才是正确的道路呢、\n"],["それにあのひと……のことは、","还有那个人……的事、"],["──………。",""],["兎に角、\n……どのこともめをそらさずにきめなければならない、でも、","总之、\n……每件事都必须正视着决定、但是、"],["──忘れている何かを思い出せれば、\n","──如果能想起被遗忘的什么、\n"],["必ず何とかなる、道がある、という、根拠はないけど妙に安心出来る、\n確信が、ある。","肯定有办法的、有路的、虽然没根据但莫名感到安心、\n我有这样的、确信。"],["「……様ちゃん、狩屋……」","「……小样、狩屋……」"],["背中一面から直に感じる此奴の、\n","从整个背部直接感受到的这家伙、\n"],["………自覚のないまま、憎んでもいない他人と敵対するなんて、[l]\n前に僕……僕があのひとにどう言ったかは知らないが、","………在毫无自觉的情况下、与并无仇恨的他人敌对这种事、[l]\n以前我……我不知道自己对那个人说过什么、"],["──やるならあれの愉しみとは無関係でなければ、\n","──要做就必须与那家伙的乐趣无关、\n"],["まともに考えるにはまだ何も、\n分からないままだけど、\n","认真思考的话还是什么都、\n不明白、\n"],["……ああ、もう僕も、眠い、奴の体温が、やばいくらいに心地よく、","……啊、我也、困了、这家伙的体温、舒服到危险的地步、"],["──まずは掴むこと、忘れていることを思い出すのをめざして、\n","──首先抓住目标、以想起遗忘之事为目的、\n"],["今夜は、……やすもう……","今晚、……睡吧……"],["──われに近しい","──与我亲近的"],["旧き","古老"],["朋も、どうやら、\n","友人们、似乎也、\n"],["……大神……には……明日に……でも……","……大神……那边……明天……再说……"],["……かすかに……とおく……なみのおとが……","……隐约……远处……海浪声……"],["「…………サ…イこう……」","「…………晚…安……」"],["「……んぁ……ぅ……ふっ……ん……」","「……嗯啊……呜……呼……嗯……」"],["「………っくふぅ………はふ………ん……あ……」","「………呼嗯………哈呼………嗯……啊……」"],["「…………………」",""]],"context":[["SC_M_058.ks/index/1/text"],["SC_M_058.ks/index/3/text"],["SC_M_058.ks/index/5/text"],["SC_M_058.ks/index/7/text"],["SC_M_058.ks/index/9/text"],["SC_M_058.ks/index/11/text"],["SC_M_058.ks/index/13/text"],["SC_M_058.ks/index/15/text"],["SC_M_058.ks/index/17/text"],["SC_M_058.ks/index/19/text"],["SC_M_058.ks/index/21/text"],["SC_M_058.ks/index/23/text"],["SC_M_058.ks/index/26/text"],["SC_M_058.ks/index/28/text"],["SC_M_058.ks/index/30/text"],["SC_M_058.ks/index/32/text"],["SC_M_058.ks/index/35/text"],["S