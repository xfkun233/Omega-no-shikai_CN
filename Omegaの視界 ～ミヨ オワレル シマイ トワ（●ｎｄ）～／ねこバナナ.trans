14157,"end":14159}],[{"start":14198,"end":14204}],[{"start":14210,"end":14212}],[{"start":14218,"end":14221}],[{"start":14258,"end":14280}],[{"start":14286,"end":14292}],[{"start":14328,"end":14369}],[{"start":14375,"end":14381}],[{"start":14387,"end":14411}],[{"start":14450,"end":14474}],[{"start":14511,"end":14549}],[{"start":14617,"end":14628}],[{"start":14634,"end":14641}],[{"start":14679,"end":14692}],[{"start":14731,"end":14735}],[{"start":14741,"end":14749}],[{"start":14755,"end":14777}],[{"start":14814,"end":14820}],[{"start":14826,"end":14869}],[{"start":14905,"end":14912}],[{"start":14918,"end":14924}],[{"start":14930,"end":14952}],[{"start":14989,"end":14993}],[{"start":15061,"end":15067}],[{"start":15106,"end":15110}],[{"start":15116,"end":15128}],[{"start":15164,"end":15167}],[{"start":15173,"end":15217}],[{"start":15231,"end":15267}],[{"start":15364,"end":15383}],[{"start":15389,"end":15425}],[{"start":15431,"end":15440}],[{"start":15479,"end":15518}],[{"start":15524,"end":15539}],[{"start":15576,"end":15597}],[{"start":15603,"end":15639}],[{"start":15645,"end":15655}],[{"start":15691,"end":15714}],[{"start":15720,"end":15735}],[{"start":15741,"end":15753}],[{"start":15821,"end":15839}],[{"start":15877,"end":15893}],[{"start":15930,"end":15941}],[{"start":15947,"end":15954}],[{"start":15960,"end":15969}],[{"start":16053,"end":16080}],[{"start":16086,"end":16154}],[{"start":16193,"end":16230}],[{"start":16267,"end":16270}],[{"start":16276,"end":16283}],[{"start":16319,"end":16364}],[{"start":16382,"end":16396}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_008.ks","basename":"SC_M_008.ks","indexIds":{"「あー、まあなかなかいいんでないの？":0,"こういう風情は嫌いじゃないよ」":1,"多少今時の建築物ではあるものの、\n明らかに民家の一階を改装したような大衆食堂、":2,"というか定食屋？":3,"二階は完全に居住空間である。":4,"洗濯物ばりばり干してあるし。":5,"当人らの意図は伺い知れないのであくまで主観だが、\nどうみても外装に気を遣った感はない。が、\n中央の方にある、人為的隠れ家的な処とは違う、\n計算がないところが好ましい。":6,"穴場、と言ってしまうと、\nどうもメディアによる操作感ありの\nイメージになってしまうので言いたくはないが。":7,"「あんまり小洒落た所似合わなそうだもんね。":8,"似合わないっていうか苦手そう」":9,"「…どうせ似合わないよ僕には。":10,"いいんだ別に。":11,"そういうとこの客層は苦手だしね」":12,"人混みとかコンパが嫌いな僕が、\n今風の店になんか行ける訳がない。":13,"だいたい小洒落てる＝美味いという訳でも無いし。":14,"むしろ、":15,"「物食べるのに、\n周りや何やに色々気遣うのは面倒なんだよ。":16,"店員さんもお爺ちゃんお婆ちゃんみたいなのだと、\nより結構」":17,"と言ってやった。":18,"大神曰く、\nそれは僕が主として同年代に対して変にコンプレックスを\n持っているのではないか、ということだが。":19,"つまりは、同世代を生きる者として、\n時勢に乗れてない（と、思いこんでる）自分を無意識に恥じてる\n結果じゃないか、ということらしい。":20,"オタやってるとそういうことは良くある、とも言ってたけど。":21,"価値観なんて好きか嫌いかだから、それを突き通せるか否かで、\n人間関係や他人の評価も有る程度固まるんだと。":22,"…なんか知狡さんが橋の上で言ってた事と似てるな。":23,"まあいいや。":24,"――実際のところ、理由なんてどうとでも後付できる訳で、\n僕自身は、\n入力された情報に対しての出力がこうであるとしか言いようがない。":25,"嫌いなの、人混みとか、面倒なのが。":26,"「やっぱりねー。":27,"中央でもそんなだったんだ？」":28,"悪かったですな。":29,"更に言い訳するならば、\n宮さんとこのバイトで多少稼ぎがあったとはいえ、\n本だのの購入費にあてつつ旅行代にも回していれば、\n食事も学食とか、":30,"まさに目の前のようなのに入り浸るを得ないわけで、\n結果高そうな店なんか行くことは殆どなかったさ。":31,"それ以前に、この辺には小洒落た店なんかないだろ？":32,"あるのか？":33,"「なるほど、私の田舎者としての偏見だったか。":34,"中央の大学生ともなれば、\nさぞや…って、ああもう社会人だっけ？":35,"職場の上司からセクハラされてるんだよね」":36,"………。":37,"そういう話は聞き流しておいて頂きたかったんですが…":38,"ここは素知らぬ振りをして話を進める。":39,"「まあどこも半々じゃないのかな。":40,"大学生なんてボンボンか苦学生、みたいなところあるし。":41,"田舎だろうが中央だろうがその辺は…":42,"まーきぃにも小洒落た処にしてくれと言ったわけじゃなし、\n肝心なのは味だ味」":43,"「だから、個人の味覚次第だから、":44,"保証は出来ないって言ったよ。":45,"でもま、自信はあるけどね。とにかく入るのだわ」":46,"こちらの返事を待たずにドアを開け、":47,"振り向くきぃ。":48,"もう待ちきれないかい。":49,"冬夏は来たことあるらしく、さっさと中へと入る。":50,"ああ、そういや味知ってるんだもんな。":51,"体験済みなわけだ。":52,"「あ、まこちゃんここ食券制だから、\nほらこっち来るのだわ」":53,"「はいはい。":54,"僕の奢りですからねーっと、\nどうれ…」":55,"食券自販機にはボタンがずらりと並んでいる。":56,"基本らしきメニューが、更に並や大盛りなど、\n量に分かれていくつかと、\n単品兼トッピングメニューが多数、\nボタン部の紙に手書きで書いてあった。":57,"基本メニューは大体３００～５００円で、\n単品は１００円前後で色々ある。":58,"まあ格別バカ安か、と言われると微妙なラインだな。":59,"と思いつつ、きぃに五千円札を渡す。":60,"「ま、今回はこの範囲でご自由に。":61,"で良いかいきぃ？」":62,"「ふおお！":63,"まじ！！":64,"やた！！！":65,"先にまこちゃんと冬夏選ぶさ、":66,"残金わたしが消化するのだわ！！」":67,"お前そんな、俺らの意見を聞いてから…":68,"って冬夏を見ると、彼女はさも当然のように、\n動じることなく自分の分を選びに入っている。":69,"…いつもの事なのか、こんな事でがっつく程\n困っていないのか……":70,"「………まあいいけどな。":71,"しかし、仮に僕らが千円分くらいずつとしても、\n…食えるのかお前？":72,"別に全額消費せんでも……」":73,"「いいからいいから。":74,"早く選ぶさ。":75,"余計な心配ご無用なのだわ」":76,"「うん、この子食べるよー。":77,"仮にね、１万出してもその分食べると思うな」":78,"――うそーん。":79,"と、とりあえず五千円にしといて良かった。":80,"ほんとかどうかは、まだ半信半疑だが、\n冬夏の眼も口振りも大真面目、全く巫山戯てない。":81,"「ら、らじゃー。":82,"え、えーとじゃ僕はどうしようかな。":83,"何かオススメある？」":84,"きぃに問うてみる。":85,"「ううん、まこちゃんて食べれるほう？":86,"並でも結構な量あるからさ、\nまずはノーマルのこれ、\n":87,"いってみるといいのだわ」":88,"そういってきぃが指さしたのは、『肉野菜丼・並』":89,"まあ、読んで字の如くだろう。":90,"変なメニューはあとで一人の時に頼むとして、\nまずはそれを頼む事にする。":91,"「あでも最初は小盛りのほうがいいかなあ…」":92,"おい、押してもうたがな。":93,"てかそんなに多いんか。":94,"まあ、とはいえだ。":95,"こんなだが僕とて育ち盛り食べ盛り？の男子である。":96,"多少の量には対応できるだろ。":97,"「私これね。":98,"今回は…ふふ。":99,"こんな愉快な人を紹介してくれた事だし。":100,"きぃにいっぱい食べさせたげよう」":101,"冬夏が選んだのは、\n『野菜丼・小盛り』":102,"という、一番安い基本メニュー１枚だった。":103,"野菜丼たって鳥唐揚ついてるらしいけど。":104,"「さっすが冬夏、\nわかってるのだわ」":105,"「じゃとっとと席つこうか…」":106,"なんかもうぐったりです………":107,"周りを見渡すと、昼時をやや過ぎているせいか、\n客はまばらだ。":108,"きぃが言っただけあって、\n学生らしき層は殆どいない。":109,"「いわば長距離運転手さん御用達なのさ。":110,"あとは工事の人達とかよく来てるのだわ」":111,"「あときぃが、さっきああは言ったけどね、\n学生達でいっぱいになる時間帯もあるんだよね。":112,"うちの高校含めて近隣の運動部で」":113,"ただそれは練習後の夕方とからしく、\n昼や、今日の始業式のような日は別らしい。":114,"「ふーん…それなりにタイミングみないといけないわけな。":115,"と言うことは、\nきぃも別に顔馴染みとかっていう訳ではないんだな？」":116,"「まー、色んな時間帯行ってるしね。":117,"ここはバイトの人多いし、":118,"顔を覚えられなくて便利さ」":119,"仕事中はともかく、わたし服いっつも同じのだから、\n恥ずかしいのだわ。":120,"ときぃは言った。":121,"そういうことね。":122,"一瞬物騒な事を連想してしまっただろうが。":123,"それにね、ときぃは続ける。":124,"「鬱陶しいしょ常連だからって話しかけられると？」":125,"まあ、わからんでもないけどな。":126,"ちょっと毒舌だなきぃ。":127,"「まあな…":128,"僕は旅行中、新幹線で隣り合った見知らぬお婆さんと、\n目的地まで３時間近く喋り続けた男だけどな。":129,"じゃ床屋で話しかけられたりするのも嫌そうだな」":130,"「あんねーそれも探し回ったさ！":131,"安くて腕がよくて客に話しかけない処。":132,"これはなかなか骨が折れたのだわ…」":133,"「そういえば新学期早々面倒な行事があるんだよね。":134,"運動会？":135,"体育祭だっけ？":136,"球技大会だっけか？」":137,"「あー、わたしに聞かれても分かんないけど、\n確かそうじゃない？":138,"ふああ、今日朝早くて眠いのだわ」":139,"うちの母さんもそうだったけど、\n女性は何故こうも咬み合わない会話を齟齬なく…\nと言う訳ではないな、\n指摘し合う事無く続けられるのだろう。":140,"ごーいんぐまいうぇい。":141,"にしたって、\n互いにそれを突っ込まないのがすげえ。":142,"目の前で展開されてる二人の会話は、\nまだ通じてる方だが、\n母さんより上の世代あたり同士の会話は、\n端から見て不思議でしょうがなかった覚えがある。":143,"…一般論というにはサンプル少なすぎだけど。":144,"ところで冬夏さん、\n制服のまま来て臭いとか大丈夫か？":145,"どうにもこの店油っぽいんですけど…":146,"「ん？":147,"大丈夫だよ。":148,"替えはあるし帰ったら洗濯するから。":149,"それに」":150,"あれもあるから、":151,"と言いながら、身体にスプレーする所作をする冬夏。":152,"名前が出てこないらしく、代名詞を連呼している。":153,"恐らく香水だの、臭い消しか何か持ってるってことだろう。":154,"成る程ねー。":155,"と、本題には入らず、\n取り敢えずはぐだぐだどうでもいい話をしていた。":156,"多少他の処より待ち時間が長い感じではあったが、\nそれは僕がいつもゴゴイチとかの、\n早い店ばっかり行ってる所為かも知れない。":157,"やがて料理がきた。":158,"「…おおい。":159,"おおおおい。":160,"なんですかこれは」":161,"あの。":162,"まず器が丼です。":163,"しかも所謂牛丼だののより何まわりもでかい。":164,"というかこれラーメン用器じゃねえの？":165,"それにご飯やら野菜やら肉だののおかずが、\nごそっと盛られているのですよ。":166,"僕のは並だからか、満載ではなく、\n器に対して半分程度の盛りなんだが、\n目の前のきぃのは…って、":167,"げ！":168,"「あ？":169,"ちょとまてきぃお前、\n食えんのそれ？":170,"うあ、まてまてまて、\nおいおいおい」":171,"「ふええ？":172,"どうしたのさ？":173,"あ、ま、驚くかなこれは。":174,"初心者には刺激が強すぎるのだわ」":175,"冬夏も僕も単品だったので、\n二人でほぼ千円近くだろ、\n単純にきぃは僕らの４倍の値段分食うわけだ。":176,"で、大盛りがこれか…":177,"ぱっと見、丼からあふれる程に盛ってる訳ではないので、\n一瞬ふうん？とか思うのだが、\nラーメンドンブリの大きさに、\n普通に見えるように盛ってるわけですこれが。":178,"相対的に当然そりゃあそれなりの量になってるし、\n大体きぃはトッピングも結構追加してるのだった。":179,"そして、何よりも、\nそれが一つじゃない。":180,"複数個なんですけど！":181,"…店員もそら間違えて僕の前に丼置いていくよ……":182,"「んじゃま、取り敢えずえー、乾杯？":183,"ただの水だけどっ」":184,"「まことさんとの出会いに乾杯ー」":185,"唖然とする僕を余所に、\nきぃが場を仕切っていく。":186,"こいつはもう既に食いに集中しつつあり、\n気がそぞろであるのが丸分かり。":187,"しかし冬夏も特に異議を唱えず、淡々と従っていく。":188,"しょうがないな…":189,"「…かんぱーい」":190,"ちーん。":191,"これ以上出費がないと分かってるからいいものの、\n今後きぃと食いに来ることあるときゃ心しておこう…":192,"「それではいただきます…」":193,"ぱき。":194,"御":195,"手":196,"元を口に銜えておっさんのように割ると、":197,"「あー、話進めといて構わないよ？":198,"わたしあそこの中に入れてくれたらそんでいいからさ。":199,"じゃ、お二人さん、お任せするのだわ」":200,"と言い放ち、":201,"食事、というか摂食を開始した。":202,"「――うわー、":203,"テレビみてえだ…」":204,"そんなにがっついてるわけではないのに、\nみるみるうちに減っていく料理。":205,"いつもお腹空かしてるからとかそういうレベルでは\n無いなこれ。":206,"単純にこいつが大食いなんだ…":207,"――と、とりあえず僕も食べることにする。":208,"これ以上見てるとそれだけで満腹なりそうだ。":209,"そして冬夏と話進めようにも、":210,"「話は食べちゃってからでいいでしょ。":211,"きぃは私達と多分同じくらいに食べ終わるとみた」":212,"だとさ。":213,"…まあ、目の前を見る限り疑問を挟む余地はないので、\n従いますとも冬夏御嬢様。":214,"「あー、":215,"まー、":216,"美味いわ。":217,"ただちょっと量がさ、\n多すぎるんではないかしら…」":218,"実際口をつけると、\n見た目から想像した以上にボリュウムがある。":219,"野菜類、海藻類、卵に肉etc、そしてご飯。":220,"うあ、納豆とバナナ（丸々１本）も付いてました…":221,"最初は格別安いとは思わなかったが、\nこの量にしてその価格、\n相対的には格安なわけな。":222,"コストパフォーマンスは確かに良いなー。":223,"あくまで、食べ切れた場合は、だけど…":224,"きぃの大盛りは当然として、\n僕の並盛りもかなりということは分かった。":225,"次来るとしたら小盛りで十分だなこりゃ。":226,"あとちっと油っこいかなー。":227,"もう少し歳いったら、小盛りにしても食える気しないぜ…":228,"「私はこういうの家では出されないからなー。":229,"体型維持がどうのって煩いんだよね。":230,"母様も年頃の女子に何言ってるんだか」":231,"一旦箸を置き、\n自分の胸や腰をむんずとつかむ冬夏。":232,"男子の前ではやめてそれ…":233,"思わず眼を逸らす。":234,"「なんかすごい神経質なんだよ。":235,"私の外観に関して異常に拘る。":236,"モデルにでもしたいのかってのよ」":237,"「んーまあ、":238,"僕には何とも…":239,"でもあれだ、綺麗に越したことはないし…」":240,"私みたいなの、まことさんの好みなのかな？":241,"なら母様の言いつけも少しは積極的に聞けるかなー」":242,"「うあ？":243,"や、ちが！":244,"ちがっていうかその、":245,"いいい一般論の話だって！！」":246,"だー。":247,"その手の揶いはもうええて…":248,"女子てのはおっかねえ…":249,"「あーでも私胸ないんだよね。":250,"それでもいい？":251,"あでも、まことさんがどうにかしてくれれば大きく…」":252,"「…年頃の女子ならそんなこと口にするんじゃ\nありません！":253,"つーかきぃ、お前も何とか言え…って」":254,"きぃは聞こえてるのかどうか、\n何のフォローもしてくれない。":255,"一緒になって僕を揶ってるのか、\nはたまた食事に集中してるのか…":256,"――多分後者だなこれは。":257,"僕が一人で赤面してる内に、\n冬夏は綺麗に食べ終えつつあった。":258,"さすが、すまーとに食されましたなあ。":259,"米の一粒も残ってない。":260,"きぃの場合は『喰い尽くす』って感じだけれど。":261,"気付くと、きぃもあんだけの量をほぼ食べ終えており、\n結局僕だけがまだ食べ終わっていない。":262,"…多いんだよ単純に。きぃは別格すぎる。":263,"どうせ食えないと思ったので、\nバナナはきぃにあげた。":264,"当然のようにあっさり胃に収めてみせるきい。":265,"お前って…":266,"「ふああ食べた食べた。":267,"ごっちそうさまーまこちゃん！":268,"ほんとにありがとなのだわっ！！」":269,"「ごちそうさまでした」":270,"「いえいえどういたしまして」":271,"食器も下げられ、とりあえず一段落。":272,"幸い店内に僕らの他客はいなくなり、\n有線だけが流れる午後。":273,"さて、いよいよ具体的な話に入ろうか。":274,"「えーと、さっきも言ったけど、\n今回はきぃが話を強引に進めてくれたから、\n何もかも急なんだよねえ。":275,"済し崩しだもんなこの成り行き。":276,"お前どこまで話したの？":277,"というかきぃも何か目的あったんだろ？」":278,"さすがにいきなり御神体の話を振るのは抵抗があるし、\nとりあえずきぃをダシに様子見するか。":279,"思えばそもそも、門前払いをくらった時点で、\n僕は蔵の中を見るのにそんなに積極的ではなかったのだ。":280,"きぃの強行ともいうべき積極的行動の故に今、\nこんな状況になってるんだしな。":281,"あーんとね、\nま、うん。":282,"見たかっただけさ。":283,"入れてくんないから。":284,"好奇心と反発心てやつ？」":285,"「お前も勢いで言ったのかよ…":286,"自分連れてくのが前提条件とか言ってたろ」":287,"「いいじゃないのさ。":288,"只働きはしたくなかっただけなのだわ。":289,"貧乏人の意地、転んでも只では起きない！」":290,"あ、そうなの…":291,"ここに来る前に考えた事はやはり取り越し苦労か。":292,"別に疑った訳ではないが、\nいやそれにしても。":293,"「へええ…":294,"その割には速攻行動起こしてた気が…」":295,"「あのねえ――":296,"わたし的には昔馴染みのまこちゃんの為に\n好意で骨折ったんだからさ、\nも少ししゃきっとしてよね。":297,"趣味なんでしょ？":298,"古本見るのが」":299,"「骨折ってくれたのは感謝してるけどな…":300,"お前自分で只働き嫌だって言ったばっかだろ。":301,"ああ飯奢られて元は取ったのか…":302,"あと、\n古本っていうと字義的には間違っちゃいないんだろうけど、\n何かイメージ違うぞ…":303,"ま、それはそれとしてそういうことだよ。":304,"趣味で旅行しながらそういったモノを\n見て歩いてるんだよね僕」":305,"半分程は真実だが、基本的にはその場凌ぎ、\n建前十割と言っても過言じゃない。":306,"少々嘘臭くなるのも詮無きこと。":307,"だが、とりあえずは気取られることはなかったようで、\n冬夏はあっさり流して言った。":308,"「成る程ね。":309,"そういえば学生じゃないんだったね」":310,"「…まあ、正確にはついこないだまでは僕だって\n大学生だったんだけど。":311,"さっき言ったとおり職場の上司にセクハラされながら\n働いて旅費稼ぎしてるわけ」":312,"「ふうん。":313,"ま、いいけど」":314,"…今更なんでそんな眼で見るですか。":315,"「あのね実際のところ、\n私も大層な目的無くたって付き合うつもりだったし。":316,"いいか面倒な話は。手順だけ話そう」":317,"結局、来る前に話された事とほぼ大差のない内容ではあったが、\n他にきちんと具体的な待ち合わせ場所や時間、連絡方法等を決めた。":318,"といっても、冬夏の家人が手薄に…というとあれだが、\n要するに例の母様達が家を空け、蔵のセキュリティが甘くなったときに冬夏が携帯で連絡をくれるだけ。":319,"それまで僕ときぃが近場で待機ということになった。":320,"さすがに正面玄関から大手を振って突入という訳にはいかないが、その辺りも冬夏が何とかしてくれるらしい。":321,"さて、目的をぼやかしている以上、\nそれとなく探してみる他どうしようもない。":322,"幸いモノのサンプルは、宮さんの例の資料で分かってるし、\nきぃが居れば冬夏の注意も分散するだろう。":323,"協力的態度でいてくれるとはいえ、\n冬夏にわざわざ本当の目的を教える理由は、\n今のところ無い。":324,"「それで、\nさっきも言ったとおり、\n私に出来ること、\n特に中では何もないと思うから。":325,"精々、見つかった時の言い逃れくらいだね。":326,"で」":327,"「ああうん。":328,"で。":329,"で？」":330,"「その危険性も更に減ずる方法があるんだなあ…":331,"聞きたい？」":332,"…何やら加虐的というか悪戯めいた笑みを口許に浮かべながら、\n僕を視る冬夏。":333,"何か不穏だ。":334,"宮さんがよく僕に見せる表情と同様の気配を感じる。":335,"「…厭な予感がぷんぷんするけど一応聞いとこうか」":336,"「あのねえ、\n二人にもこの制服着て貰って、同級生の振りしてもらうの」":337,"「ふええ、いいねそれ。":338,"予備あるんだ？":339,"まこちゃん似合いそうだわ」":340,"「は！？":341,"女子制服かよ！！":342,"同級生って事ならガクランで構わないだろ！！」":343,"「駄目だよ。":344,"男子連れ込みは別の意味で警戒されるし、\n第一ガクランなんて持ってないもんねー」":345,"駄目だ駄目だ。":346,"却下します。":347,"保険というより揶われてるだけと判断しました。":348,"「残念」":349,"「なのだわ」":350,"「君達…":351,"いいやもう…出ようか…」":352,"ふう。":353,"あとは知狡さんに事の成り行きを伝えて、\n本家の用とやらをこなさなくてはならない。":354,"食券制だから既に会計も済んでいるので、\nそのまま僕らは店を出た。":355,"「ふああ、改めてごちそうさまでしたっ。":356,"わたし食い溜めできない体質だけど、\n満腹感は久々に味わえたのさ。":357,"ありがとなのだわ」":358,"「今後また来るかどうかは別として、\n良い店紹介してもらってこちらこそ。":359,"話も進んだしじゃあ日曜にまた」":360,"「私も愉快な邂逅が出来てとても好かったよ。":361,"ま、今日のところは精々大人しくして\n母様を油断させとかないとね。":362,"ご飯御馳走様でした」":363,"店の前で、別れの挨拶の為しばし立ち止まる僕ら。":364,"店内が油ぽかったので清々しい。":365,"ウーロン茶飲みたいなー。":366,"「じゃ、わたし用があるから帰るのさ。":367,"あとは二人で宜しくやってね～♪」":368,"「勿論そのつもりです。":369,"じゃあねきぃ。":370,"今日はありがとう」":371,"食べた直後とは思えない、軽い足取りできぃは立ち去った。":372,"冬夏の言葉を聞き逃し、ろくなリアクションもとらず、\nしばし呆然と見送った後、\nふと気になった事を問おうと僕は口を開いた。":373,"「ところで、\n今更なんだけど、\n君等一体どういう関係――」":374,"「え？":375,"なに？…――」":376,"微笑みつつ振り向いた冬夏の目線の焦点が、\n表情の変化を伴って僕の後方へと遷移する。":377,"急に僕の袖がぐいと引かれた。":378},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_008.ks","relPath":"/data/scenario/SC_M_008.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":379,"length":379,"percent":100},"cellInfo":[null,null,[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,[null,{"t":"HU"}],null,null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"t":"HU"}],null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"t":"HU"}],null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,null,null,[null,{"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"t":"HU"}],null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"t":"HU","v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[377,1],"note":"完成"},"/data/scenario/SC_M_009.ks":{"data":[["「どうし…おわあ？！","「怎么…呜哇！？"],["吃","吃…"],["驚し…たあぁ？","吃惊了啊？"],["おうえ？？」","啥情况？？」"],["冬夏の視線の先、僕の袖を引いた何者かを視んと振り向くと、","顺着冬夏视线回头看向拽我袖子的人，"],["「あ、れ、れ？」","「啊，这，这？」"],["「ちょとまったきーちゃ…って、あ、","「等等小姬…不对，啊，"],["あは、あはは、","啊哈，啊哈哈，"],["あはははは…","啊哈哈哈…"],["どうもこんちゃ……」","你好呀……」"],["「あ、え、キサマ？","「啊，呃，姫様？"],["何これどういうことカツエ？","这是怎么回事啊克杖？"],["君等なにしてんの？」","你们在干什么？」"],["冬夏と同じ制服を着た女子二名が、\n一人は僕をじっと見つめ…というか睨んでるようにしか見えないが、\nとにかく袖を掴んだままで居り、\nもう一人は、ばつの悪そうな苦笑いを浮かべて冬夏に弁明している。","两名穿着和冬夏相同制服的女生，\n其中一人直勾勾地盯着我…或者说看起来更像在瞪视，\n总之仍抓着我的袖子不放，\n另一人则挂着尴尬的苦笑向冬夏解释。"],["「やその、あたしにもわかんにゃいんですけど\nあはは…","「那个、其实我也不太清楚\n啊哈哈…"],["なんかきーちゃが冬夏ちゃをみるなりいきなり…」","小姬一看到冬夏就突然…」"],["同じ学校の生徒というだけでなく、\nどうやら冬夏の知り合いらしい。","不仅是同校学生，\n似乎还是冬夏的熟人。"],["にしてもキサマってなに？","话说kisama是啥啊？"],["貴様てことか？ちょっとイントネーション違ってたけども。","是在说「贵様」吗？虽然语调有点不一样。"],["「……ふうん？","「……哼嗯？"],["でも見る限り、私というよりこの…」","但看起来比起说是看到我，更像是因为看到他了…」"],["困惑しきりの僕よりは、\nこの新たな登場人物を見知っているだけ\n事態が分かっているらしい冬夏だが、\nそれでも堅く険しい表情のまま僕を指す。","比起完全困惑的我，\n冬夏似乎认识这个新登场人物，\n对状况有所了解的样子，\n但仍维持着僵硬严肃的表情指向我。"],["「…んに…は」","「…嗯呢…哈」"],["「……あい？」","「……哎？」"],["突然僕の袖を持ったままのその娘が何かを言った。","突然那个仍抓着我袖子的女孩说了什么。"],["しかし聞こえない。","但听不清楚。"],["「こん！","「你！"],["…にちは」","…好」"],["「ああう、","「啊呃，"],["あ、こ、こんにちわ……」","你、你好……」"],["僕を睨んだり眼を逸らしたり、\n忙しなく視線が泳ぎつつ、\nただ全体的に不機嫌そうなオーラを発しながらその娘が…\nこれは挨拶でいいのか？してきた。","时而瞪视时而移开视线，\n目光慌乱游移着，\n全身散发着明显不悦的气场，那女孩…\n这种时候，该打招呼吗？我心里这么想着。"],["きーちゃと呼ばれていた気がするが、\nよく分からない。","记得是被称作小姬，\n但不太确定。"],["きぃと語感かぶっとるし、ややこしいな。","发音和小贵太像了，真混乱啊。"],["というかあなたがたはどなた？","话说你们到底是谁？"],["冬夏さん、一体これはどういう事でしょう？？","冬夏小姐，这究竟是怎么回事？？"],["そろそろ説明していただけると有り難いんですが。","差不多该给个解释了吧。"],["と至極当然の要求をしようとした矢先、\nもう一人のちっさいのが叫んだ。","正当我要提出这理所当然的要求时，\n另一个小个子突然叫起来。"],["「にゃ？！","「喵？！"],["きーちゃどうした！","小姬怎么了！"],["んあ？あれ？","嗯啊？咦？"],["ていうかあんた誰よ」","话说你谁啊」"],["おぉいおまえ、今まで気付かなかったのかぁー。","喂喂你这家伙，居然现在才注意到吗ー。"],["「んんー？","「嗯嗯ー？"],["みない顔だな？","没见过这张脸呢？"],["うちの生徒でもにゃいだろー。","不是我们学校的学生吧ー。"],["何の用でここにいるのょ」","来这里有何贵干呀」"],["「ああ？」","「哈啊？」"],["…こいつ。","…这家伙。"],["礼儀がなってないとか以前に、\n悪意敵意剥き出しじゃねえかよ。","别说礼不礼貌了，\n根本是赤裸裸的恶意敌意吧。"],["僕が何かしたか？","我做过什么吗？"],["それ以前に初対面の人間によくそこまででかい態度とれるな。","更何况对初次见面的人态度居然能这么嚣张。"],["きぃですら最初は丁寧語だったぞ。","就连小贵最初都用敬语的。"],["「どこの誰かは知らないけどな、\nそもそも僕は高校生じゃない。","「虽然不知道你是哪里的谁，\n首先我可不是高中生。"],["もう成人間近の歴とした社会人だ。","已经是临近成年的正经社会人了。"],["おま…きみは、趣味で着てるんでも無い限り、\nどう見たって中高生だろうが」","你…小姑娘，除非是兴趣使然，\n怎么看都是初中生或高中生吧」"],["「は！なにそれ。","「哈！什么啊。"],["だから敬えって？","所以是要我尊敬你？"],["年上だったら偉ぶっていいとでも\n思ってんにゃか？」","难道以为年长就能摆架子\n了喵？」"],["「は！じゃねえよ。","「哈！才不是呢。"],["それと無礼を働く事はまるきり無関係だろよ。","这和有没有礼貌完全没关系吧。"],["そういうこと言ってるんじゃないんだ僕は。","我不是在说这个意思。"],["最低限の礼儀ってもんがあるだろ」","最基本的礼仪总该有吧」"],["「説教にゃか？","「说教喵？"],["怖い人から言われたらそんな反論してないだろー。","要是被可怕的人这么说你根本不敢顶嘴吧—"],["目下と思って差別して、無礼はあんたの方にゃさ」","觉得对方是晚辈就搞歧视，没礼貌的明明是你喵」"],["「指をさすな指を！」","「不许指人！不许指！」"],["いかん、血が胃に行ってる所為か、いつもの空転脳に…","糟了，是血液流向胃部的缘故吗，平常的放空大脑..."],["寝起きと空腹満腹時には判断力が著しく低下するから、\n只でさえとても臨戦態勢とは言えない状況なのに、\nよりによってこいつは一番厭なタイプが。","刚睡醒和空腹饱腹时判断力会显著下降，\n本来就已经很难说是临战状态了，\n偏偏这家伙还是最讨厌的类型。"],["理詰めなのか屁理屈なのか、\nはたまた現実主義者なのか、\n理論的に反論するには破綻しており、\n感情的に対抗するには全く以てやりにくい。","不知是讲道理还是胡搅蛮缠，\n又或者是现实主义者，\n从理论上反驳会漏洞百出，\n从情感上对抗又完全无处下手。"],["女子とは口論するもんじゃない…","和女人吵架实在不明智..."],["腕力でどうこうするつもりも勿論ないけど。","当然也没打算用武力解决。"],["てかそれこそ差別だって突っ込まれる。","话说这反而会被指责是歧视吧。"],["「なんなら拳で白黒つけてもいいにゃさ。","「要不就用拳头分个胜负喵。"],["遠慮しなくていいぞー。","不用客气哟—"],["ほれほれ」","来呀来呀」"],["…思った側からこの女…。","...刚想到这茬这女人就..."],["ぐ、しかしさすがに手は出しませんよ。","呜、但还真不能动手啊。"],["つーかそこまで挑発されると逆に冷めるわい。","倒不如说被挑衅到这种程度反而冷静下来了。"],["――まあ、そうでなくても目立つことはしたくない。","――况且就算没这事我也不想引人注目。"],["自慢じゃないが、腕っ節もからきしだしな。","不是自夸，我这胳膊根本使不上劲。"],["「あのー君等、","「那个—你们俩，"],["互いに紹介せずされず、\nそこまで喋りあえるなら逆に気が合ってるのかなー？","既没自我介绍也没被介绍，\n能聊到这种程度反而说明很投缘吧—？"],["と、思う訳にもいかないからさ、\nまことさんとりあえず紹介させて。","虽然也不能这么认为啦，\n总之先介绍下真言先生。"],["ほんとに殴り合いになったら…いや、\n一方的な暴行になりかねないしこの娘の場合」","真要打起来的话...不对，\n搞不好会变成单方面施暴呢这姑娘的情况」"],["はい？","喂？"],["それは僕のヘタレ具合とは関係なしにと言うことか？","这是在不考虑我有多废柴的前提下说的吗？"],["冬夏が見た目で既に僕を見縊ってるんで無い限り、\n対象の力量を度外視しても尚、","只要冬夏没有光凭外表就已经把我给看扁了，\n那么即便暂且不考虑对方实力如何，"],["このちっさい小生意気な娘が相手をボコボコに出来るという\n前提があるが故の発言ということになるんですが。","这番话也是建立在\n这小不点嚣张丫头能把人揍扁的前提上对吧。"],["…まさかねぇ。","...不至于吧。"],["……ですよねぇ。","……就是说啊。"],["それともう一人は放置ですか。","另外一个人就不管了吗。"],["僕の袖はもう放してくれてるが、こいつ同様説明がまだだけど。","虽然已经放开我袖子了，但和这家伙一样还没说明呢。"],["「あー？","「啊—？"],["なんだ冬夏ちゃの知り合いにゃんか。","原来是冬夏的朋友喵。"],["珍しいにゃあ」","真稀奇喵」"],["「克杖がもう少し常識人だったら私も楽なんだけどね…","「要是克杖再有点常识我就能轻松点了..."],["えーとねまことさん、","那个呢真言先生，"],["まずこの","首先这个"],["娘、彼女はまあ、\n私の処と…家ぐるみの付き合いがあって、\nこんな田舎だとほとんど親戚みたいなものだよ。","姑娘，她呢，\n和我家...算是世交，\n在这种乡下地方基本算亲戚了。"],["狩","狩"],["屋","屋"],["克","克"],["杖。","杖。"],["同じ学校の後輩で一個下。","同校学妹，小一届。"],["中学からずっと陸上部」","从初中开始就一直在田径部」"],["陸上競技という括りよりは、\n身体技能全般に秀でているらしい。","与其说是田径选手，\n更像是身体机能全方面都很优秀。"],["しかも、\n喋りはこんなだが学業の方もそこそこだという。","而且，\n虽然说话这样但学业据说也不错。"],["…やっぱり厭なキャラだな。","...果然是讨厌的角色啊。"],["人によってはコンプレックスを衝かれるタイプだろう。","对某些人来说会是直击自卑心的类型吧。"],["そして『よろしく』の挨拶一つも無いのなこいつは。","然后这家伙连句『请多关照』的问候都没有。"],["「で、こっちが、\nまた家ぐるみの…あの公園の近くの土産屋あったでしょう。","「然后这边这位，\n又是全家老小...就是那个公园附近的土产店记得吧。"],["『","『"],["嘉","嘉"],["多","多"],["里","里"],["辺","边"],["茶","茶"],["屋』。","屋』。"],["あそこ綾目という家なんだけど、そこの","那家叫绫目的家族，他们家的"],["娘。","女儿是三姐妹。"],["綾","绫"],["目","目"],["姫","姫"],["様。","様。"],["克杖とは同級生で３人姉妹。","和克杖是同年级的。"],["ちょっと訳有りで万年帰宅部。","因为某些原因常年都是归宅部。"],["きぃから聞いてるかもだけど、\nまあ色々あって、\n最近はちょっとうちと出入りというか、行き来頻繁にあったりしたんだけど」","可能从小贵那里听说过，\n总之发生了很多事，\n最近经常和我们家来往或者说频繁走动」"],["…例の死人が出たという件か。","...是之前死了人的那件事吗？"],["そもそも最初に此処に来た時に、\n喪服の行列が――そこで冬夏を視たのだが――あったのは、\nそういう事なのか？","说起来最初来这里的时候，\n看到穿丧服的队伍――当时还看见了冬夏――\n就是因为这个吗？"],["きぃのバイト先の診療所の方も関係あるんだろうが。","小贵打工的诊所那边应该也有关系吧。"],["と、紹介を受けた彼女、\n綾目姫様…キサマって名前なんだな…ちゃんが、\nこっちへの視線を固定したまま会釈をした。","而被介绍的她，\n绫目姫様酱...名字叫Kisama啊，\n维持着看向这边的视线点头致意。"],["なので三白眼でばりばりガン付けられてるみたいなんですが…","所以就像被三白眼（译注：瞳孔靠上或靠下，露出较多眼白的眼型，可以理解成鄙视眼？）狠狠瞪着一样..."],["「で、二人とも。","「然后，两位。"],["こちらまことさん。","这位是真言先生。"],["旅行で此処に来たんだって。","说是旅行来到这里的。"],["きぃ、貴奴は知ってるね？","小贵认识吧就是贵奴，"],["永久の処でバイトしてるあの――そう。","在永久那边打工的那个――对。"],["の、幼馴染みで昔玄ノ森に居たことあるそうだけど」","说是他青梅竹马，以前在玄之森住过」"],["「…どうも初めまして、真言です。","「...初次见面，我是真言。"],["健忘症なものでね、あんまり覚えてないから、\n一旅行者として考えて貰って結構だよ」","我这不是有健忘症嘛，（关于玄之森）很多事都记不太清，\n就当我是个普通旅行者就好」"],["何気に卑屈になってしまう僕であったが、\nいかなアドレナリン大放出の最悪の出会い方でも、\n女子に囲まれるとこんなだ。","虽然我不自觉地变得低声下气，\n但就算是在肾上腺素狂飙的最糟糕初见场合，\n被女生包围时还是会这样。"],["宮さんの仕込みが効いてるねえ…","宫小姐的训练见效了呢..."],["単純に、こんなにも女子だらけという状況に馴れてない所為もあるが。","当然也因为单纯不习惯被这么多女生围着。"],["三春の系列も飯窪も直系男子が殆ど居ないようだが、\nそれにしても実際ここまで女子にまみれることになるとは…","虽然三春派系和饭洼家几乎都没有直系男性，\n但实际被女生淹没到这种程度还是..."],["と、またこの狩屋とかいう女子が毒づいた。","这时那个叫狩屋的女生又恶语相向。"],["「は。","「哈。"],["いかにもな顔してんにゃおまえ。","你这脸可真够典型的。"],["ケンボーショーだなんて上等なもんじゃにぇーだろー。","说什么健忘症装得挺像那么回事嘛。"],["ただののーたりんめ」","不就是个呆子」"],["こいつ…","这家伙..."],["にしても何だって僕にこうも楯突くんだこいつは。","但为什么专挑我对着干啊。"],["いちいち怒るのも馬鹿臭い（というか腕力で敵わない）ので、\n放置を決め込んでやる。へへーん。ガキめ。","每次都生气就显得很蠢（主要是打不过），\n决定无视她。哼哼。小鬼头。"],["と思っていたら、\n冬夏が諫めるより早く、\nもう一人の女子がそいつ――狩屋の腕を掴んで振り向かせた。","刚这么想着，\n冬夏还没开口劝阻，\n另一个女生就抓住那家伙――狩屋的手腕把她拽过来。"],["「克杖」","「克杖」"],["「にゃあ？」","「喵？」"],["「ちゃんと挨拶して」","「好好打招呼」"],["「え。","「诶。"],["こいつに？」","对这货？」"],["「『こいつ』じゃない。","「不是『这货』。"],["真言さん」","是真言先生」"],["「うぇえーなんでよー。","「呜诶——为什么啦——"],["きーちゃおかしいにぇー今日ー。","小姬今天好奇怪——"],["なんでこんな、や…つ……」","凭什么要对这种家...伙...」"],["「ひぁ」","「咿」"],["姫様ちゃんが狩屋をそれはそれは恐ろしい眼で睨んだ。","姫様酱用超级可怕的眼神瞪着狩屋。"],["声は小さいし哀願している…のかも知れないが、\n何か禍々しいオーラが視えそうでこわいですぼく…","虽然声音很小像在哀求...也许，\n但总觉得能看到什么不祥的气场好可怕啊我..."],["「う・あ…","「呜・啊…"],["ごめ…」","对不…」"],["実際狩屋も異常な怯え方をし出している。","实际上狩屋也开始表现出异常的恐惧。"],["他称暴力女子がここまでびびるとは、\n綾目ちゃん…","号称暴力女的她居然吓成这样，\n绫目酱…"],["まさかフィジカルで狩屋を上回ってるんじゃないだろうな…","该不会在体能上超越了狩屋吧…"],["眼が怖いからにしては狩屋のこの反応、尋常じゃないぞ……","虽说眼神可怕但狩屋这反应也太夸张了……"],["「で・でもあ、そうそうもうあたし行っちゃうし？","「那・那个啊对对对我要走了哦？"],["この場はさらばでおけーでだめ？にゃ？」","就此别过行不行嘛？喵？」"],["「駄目です」","「不行」"],["「………や・やだなもー！？","「………讨・讨厌啦！？"],["じょうだんだってば！","都说是开玩笑啦！"],["ね！！","喂！！"],["真言おにーさん！","真言哥哥！"],["よろしくしてくださいにゃん♪♪」","请多关照喵♪♪」"],["思いっきり余所行き猫撫で声を出す狩屋。","狩屋使出浑身解数发出谄媚的猫叫声。"],["宮さんかお前は。","你是宫小姐吗。"],["にゃん♪♪","喵♪♪"],["とか止めい。","快住口。"],["冬夏も心なしか先刻から態度が冷ややかだぞ。","冬夏的态度也不知何时起变得冷淡起来。"],["ん？","嗯？"],["こいつら現れてからずっとかも。","可能从这群人出现后就一直这样。"],["「まあ良いけどな…\nこっちもちょっとリミット外れてたし。","「嘛算了…\n我这边也有点过火了。"],["よく分からないけどとにかくいろいろ悪かった、よろしく」","虽然不太明白总之抱歉了，请多包涵」"],["三春の系列といざこざ起こしたらまずいのだ、\nということを今更ながら思い出し、\n実は僕の心中は非常に焦っていたのだった。","和三春家系起冲突可就糟了，\n这种事现在才想起来，\n其实我心里正急得火烧火燎。"],["血の気も引いてるし冷や汗モノだ、実際のところ。","吓得面无血色直冒冷汗，真的。"],["穏便に済ませそうで良かったよ。","能和平解决真是太好了。"],["あぶねえあぶねえ…","好险好险…"],["「許してください」","「请原谅我」"],["「えあ…？","「诶啊…？"],["なななにを？」","原原原谅什么？」"],["「克杖が失礼しました」","「克杖失礼了」"],["「う、うんそれは別に…","「没、没事那个…"],["君が謝ることでもない、ですし……」","又不是需要你道歉的事……」"],["もう僕には争う気も毛頭ない、ですし……","我现在完全没有争斗的心思了……」"],["「私達を嫌わないでください」","「请不要讨厌我们」"],["「にゃ！？","「喵！？"],["きーちゃ？！」","小姬？！」"],["「あ、それはもう、勿論デスヨ？","「啊，那个当然不会啦？"],["だからそんなに気にしないで…」","所以别太在意…」"],["「めんどくさいなー握手でもしたら？」","「真麻烦啊干脆要不握个手？」"],["やっぱりテンション低めの反応というか、\n放っておかれたせいか少々不機嫌そうな冬夏。","果然反应很冷淡，\n或许是被冷落的缘故，冬夏显得有些不高兴。"],["姫様ちゃんの爆弾発言はスルーですか。","姫様的爆炸性发言就这么无视了吗。"],["…いや、どうやらほんとに上の空というか、\n興味無さげだし、聞き逃したもよう。","…不，看样子她是真的心不在焉，\n似乎毫无兴趣，像是根本没听见。"],["それか、\n姫様ちゃんいつもそういう言動をする人かだな。","要么就是，\n姫様平时就是会说这种话的人吧。"],["「は？","「哈？"],["いえあ、でもにゃあ…","不不不，但是喵啊…"],["うー、しょがない冬夏ちゃがいうならば…」","呜～既然冬夏酱这么说的话…」"],["狩屋は、冬夏と姫様ちゃんを気にしつつ困り顔で","狩屋边留意冬夏和姫様边露出困扰的表情，"],["僕に手を出しかけて――","朝我伸出手――"],["「にゃう？」","「喵呜？」"],["「うあ？」","「呜啊？」"],["「克杖は男嫌いなんです」","「克杖讨厌男性」"],["と、すごい勢いで僕と狩屋の間に入る姫様ちゃん。","姫様以惊人速度插进我和狩屋之间。"],["狩屋の方を視ずに喋ってますがほんとですかそれ。","她说话时都没看狩屋那边，真的假的啊。"],["「きーちゃ、\nそこまでしにゃくても…」","「小姬，\n不用做到这份上…」"],["男嫌いて、だからって百合めいてる訳じゃないんだろうが…","讨厌男性，但也不代表就是百合吧…"],["てかこいつ自身は握手しかけてたのに、\nこいつの台詞じゃないが何故姫様ちゃんが、\nそこまでして止めるだよ。","话说这家伙自己明明都主动要握手了，\n虽然不该由这家伙来说但为什么姫様酱，\n要拼命阻止到这种地步啊。"],["貴女方二人が百合の仲だってことですか。","莫非您二位是百合关系吗。"],["あーだから僕に対して邪険だったのか狩屋。","啊——所以狩屋才对我这么刻薄啊。"],["そんな妄念に襲われながらふと冬夏を視ると、\n姫様ちゃん達を視る眼が険しかった。","一边被这种妄想侵袭一边瞥向冬夏，\n发现她看向姫様酱她们的眼神很尖锐。"],["面子を潰されたような状況だから仕方ないかもだが、\nひょっとして…","毕竟面子被驳了的状况也难怪，\n该不会是……"],["――嫉妬か？","――在嫉妒？"],["なんてなー。","开玩笑啦。"],["………いや、いいです…","………不、当我没说…"],["「え・と、どうしよう冬夏ちゃ？」","「呃・那个，怎么办冬夏酱？」"],["「ん？","「嗯？"],["適当言っただけだから気にしなくていいよ」","只是随口说的别在意啦」"],["狩屋、板挟みか。","狩屋，左右为难啊。"],["三春の娘たる冬夏に気を遣うのは分かるが、\n姫様ちゃんとはやはり…","顾虑身为三春家千金的冬夏可以理解，\n但和姫様酱果然还是…"],["リリーの仲ですか？","百合关系吗？"],["結局ここまで否定してねえぞお前。","结果你压根没否定到这一步啊。"],["にしても冬夏、ちと冷たすぎやしないか。","不过冬夏也冷淡过头了吧。"],["まあ身近な人間が故のしがらみもあるだろうし、\n自発的に発生した友情でも無い限り、\n単なる家同士の繋がりなぞ煩わしい事のが多いしな。","嘛毕竟有身边人带来的束缚，\n只要不是自发产生的友情，\n单纯家族间的往来多半都挺烦人的。"],["只でさえ冬夏は家とは仲が悪いそうだから、\n連なる他家の人間とも色々あるんだろうが。","况且听说冬夏本来就和家里关系不好，\n和其他家族的人肯定也有各种纠葛吧。"],["「えー、んっんー。","「诶——嗯嗯——。"],["じゃもういいですか。","那可以结束了吗。"],["私はまことさんと寄るところあるから。","我和真言先生有些事要处理。"],["君等はどうぞお先に。","诸位请先走吧。"],["まことさん大丈夫ですか時間？」","真言先生时间没问题吗？」"],["口調が、やや冷たく他人行儀になった冬夏が\nそう言ったのを契機に、","语气略显冷淡疏离的冬夏\n以这句话为契机，"],["各々が我に返ったような顔をする。","众人纷纷露出如梦初醒的表情。"],["寄る処あるなんて聞いてない…が、\n言外に何かを察して僕も黙っていた。","可没听说有什么要处理的事…但\n察觉到弦外之音的我也没有作声。"],["目配せも何も、合図の類が一切無いだけに、\n恐らく真剣に何かを隠蔽していると思われ、\n茶化すのも躊躇われたからだ。","既没有眼神交流也没有任何暗示，\n恐怕是真心想隐瞒什么，\n所以也不好插科打诨。"],["「にゃ！","「喵！"],["わかりました！","明白啦！"],["いこうきーちゃ。","走吧小姬。"],["うちらも用事…あるしさー！♪」","我们也有事…要办嘛！♪」"],["「また逢えますか？」","「还能再见面吗？」"],["「って、きーちゃぁ！","「喂、小姬啊！"],["にゃに言ってるーっ！！？","你在说什么喵！！？"],["そんなキャラ違うしょっ！！！」","这根本人设崩塌了好吗！！！」"],["冬夏の言を聞いて、\n一旦緊張からの解放モードに入ったはずの狩屋が、\n姫様ちゃんに真っ向シカトされた上、\n彼女から僕に向かって発せられた微妙な台詞でまた混乱状態に。","听到冬夏的话，\n本该刚从紧张中解放的狩屋，\n先是被姫様酱当面无视，\n又被她对我说的暧昧台词再次搞混乱。"],["というか僕も混乱せざるを得ないぞそんな言い方されたら。","话说这种说法连我也不得不混乱啊。"],["ど、どういう意味でしょうカ…","这、这是什么意思啊…"],["「え…っとぉう…","「呃…那个…"],["まあしばらく滞在する予定だから、\nもしかしたらまた逢うこともあるか…もねぇ…？","反正会暂住一段时间，\n说不定还有机会见面…吧…？"],["…そういうことじゃなくて？」","…不是这个意思？」"],["「また逢えたら幸せです。","「若能重逢便是我的幸运。"],["お名残惜しいですが冬夏さんが…\nああ仰っておられるので。","虽依依不舍但冬夏小姐…\n既然这么说了。"],["それでは。","那么就此别过。"],["御身体お気をつけて」","请多保重贵体」"],["――うーん…","――唔嗯…"],["輪を掛けて微妙なレス……","变本加厉的暧昧回应……"],["何のつもりにゃのやら…","到底打的什么主意喵…"],["冬夏に対しても微妙に当て付けてるように\n聞こえるしさ…","对冬夏也隐约带着些讽刺\n听起来是这样…"],["「にゃおぅ？！","「喵嗷？！"],["ま・まってきーちゃ！！","等、等一下小姬！！」"],["…あはは、\nじゃ、また冬夏ちゃ、と、","…啊哈哈，\n那、下次见冬夏、"],["真言…","真言…"],["兄ぃ」","哥哥」"],["言うだけ言って結局僕にとっては謎のまま、\nすたすた、というには若干猫背気味に、\nこの場から立ち去る姫様ちゃん。","说完就留给我满脑子疑问，\n微微弓着背\n快步离开现场的姫様。"],["と、追う狩屋。","以及追上去的狩屋。"],["こいつからの呼び名、真言兄ぃになるのか…","看来她要管我叫真言哥哥了…"],["今後も本当に彼女らに逢うことあればの話だけど。","当然前提是今后还会和她们见面。"],["まあ、多分何度も逢うことになる気がするわ…","不过多半会经常碰头吧…"],["いつもの勘てやつですか先生？\nはははそうだよ！","又是您平时那种直觉吗老师？\n哈哈哈没错！"],["閑話休題。","闲话休提。"],["…なんかよくわからないままにまた事態が進行していったが、\nまあ狩屋が百合女子だとしても、\nどうやら片想いぽいということは察せられた。","…虽然不明就里但事态仍在发展，\n就算狩屋是百合女，\n也能看出她似乎是单相思。"],["そんなことが判明しても何にもならんな……","知道这个也没什么用……"],["呆然というよりも寧ろ半ば悄然と見送る僕であった。","我半是茫然半是怅然地目送她们离去。"],["程なく狩屋と姫様ちゃんが視界から消える。","很快狩屋和姫様消失在视野中。"],["僕と冬夏、二人だけになった途端、","当只剩我和冬夏两人时，"],["「（あのさまことさん）」","「（那位真言先生）」"],["がっ、と僕の肩を掴み、顔を寄せてひそひそ声で\n冬夏が囁いてきた。","她突然抓住我肩膀凑近耳边\n用气声悄悄说道："],["「（あの","「（在"],["娘達の前では、\nその、例の件隠しといてね。","那些女孩们面前\n要瞒着那件事哦。"],["あの娘ら、","她们是"],["母様から言われて私のお目付役みたいな\nもんだからさ。","母亲派来监视我的\n眼线。"],["私がおいたするとすぐチクるんだよ）」","要是我犯错会立刻打小报告）」"],["近いって近いって。","太近了实在太近了。"],["飯後の、例の消臭兼ねた香水の芳香が鼻孔をくすぐる。","饭后用来除味的香水气息搔弄着鼻腔。"],["宮さんはあんまりそういうのしないので、\n僕もその方面はまだ免疫が薄いのだった。","因为宫小姐不常用香水，\n我对这类气味还很敏感。"],["ほんとに君等、\nもう少し男子との接触に抵抗持った方が…というか、\nなんていうの、出し惜しみしといた方が良いんじゃないか。","你们女生真的该\n对男性接触多点戒心…或者说\n稍微矜持点比较好吧。"],["「（特に姫様は鬼真面目で融通利かないから）」","「（特别是姫様死脑筋不懂变通）」"],["へえ…","哎…"],["眼も怖かったしな…","眼神也很吓人啊…"],["あの娘、最初はおどおどしてた印象だったが、\n何気に芯は強いようだったし、冬夏のいうのも真なのだろう。","那孩子起初看着怯生生的，\n没想到意外地强势，冬夏说得应该不假。"],["思いこみ激しそうなのがちょっとあれだけど。","就是有点钻牛角尖的倾向。"],["「（今日はちょっと態度おかしかった）」","「（今天她态度有点怪）」"],["「（？）」","「（？）」"],["更に声が小さくなったので良く聞き取れなかったが、\n思わず小声で聞き返した僕の疑問はスルーされた。","后面声音太小没听清，\n我小声追问也被无视了。"],["まあ、伝えようとした事柄なら言い直すだろうし、\nどうでも良いことなんだろう。","反正重要的事肯定会重新回答的，\n大概无关紧要吧。"],["「（まことさんも眼付けられたみたいだし、\n気を付けた方がいいよ。あはは。","「（真言先生也被盯上了，\n最好当心点。呵呵。"],["精々殺されないようにね。","争取别被弄死哦。"],["女の情念蛇体と化すか、ああ恐ろしおそろし…）」","当心被女人的怨念变成蛇哦，可怕可怕…）」"],["そして冬夏は、\nやさぐれ気味ではあるが笑みも交えつつ囁く。","冬夏带着\n自暴自弃的笑容继续低语。"],["どうやら彼女のテンション低下は、\n状況的に置いてけぼりだった所為でもなく、\n機嫌が悪かったというより、\n彼女らが苦手だったからのようだ。","她情绪低落的原因\n既不是被冷落，\n也并非心情不好，\n纯粹是不擅长应付她们。"],["しかもお目付役ときたか。","居然还有监视者。"],["確かに計画の支障たり得る存在。","确实可能妨碍到计划。"],["彼女も神経質になってたという事だろうか。","她是不是也变得神经质了呢。"],["まあ、そうでなくてもあんな濃いキャラのコンビに\n近くをウロウロされたら大層疲れそうだけど…","嘛，就算不是这样被那两个浓烈性格的家伙\n在附近晃来晃去的话也会很累人的吧…"],["どっちにしろ、\nいつもの…とは言っても知り合って間もないし\nどんなのが常態かは分からないが、","不管怎样，\n说是平常…其实也才认识没多久\n所以也不知道怎样才算常态，"],["あっけらかんとした冬夏に戻って良かった。","能恢复成那个爽朗的冬夏真是太好了。"],["――ところで、","――话说，"],["もうそろそろ身体離してくれても結構ですよ？","现在差不多可以放开我的身体了吧？"],["「さて、まあもう少しだけ、\nほんとに付き合ってくれる？","「好啦，再稍微维持一会儿嘛，\n真的不愿意陪我吗？"],["時間、半端に余っちゃって。","时间多到有点浪费呢。"],["きぃももう行っちゃったし。","小贵也已经先走了。"],["歩きながら適当に会話でもしようよ」","边散步边随便聊点什么吧」"],["ようやく僕から離れ、通常の声のボリュウムで喋り出す。","终于从我身上离开，用正常音量开口说道。"],["「ああうん。","「啊嗯。"],["いいけど。","倒也不是不行。"],["二人だけの処なんか、\n人に視られて恥ずかしいとかはないの？」","但两个人独处什么的，\n不觉得被人看到会很羞耻吗？」"],["「勿論恥ずかしいから、\n人目に付かない場所選んで行く。","「当然会觉得羞耻啦，\n所以会选没人看见的地方走。"],["あはははは！」","啊哈哈哈！」"],["怒んないでね、と付け加えられた。","又补充了一句别生气嘛。"],["まあそれは構わないが、\n人気の無い処に二人切りで行くのもどうかと思う。","我倒是不介意这个，\n但特意去没人的地方独处总觉得不太对劲。"],["余程警戒されてないんだな僕は。","看来我完全没被戒备啊。"],["「これ、言わないでね」","「这话可别告诉别人」"],["「ん？」","「嗯？」"],["そこで突然冬夏がトーンを下げた。","冬夏突然压低了声线。"],["@r","@r"],["「私あの娘きらいなんだ」","「我其实很讨厌那孩子」"]],"context":[["SC_M_009.ks/index/1/text"],["SC_M_009.ks/index/3/text"],["SC_M_009.ks/index/5/text"],["SC_M_009.ks/index/7/text"],["SC_M_009.ks/index/9/text"],["SC_M_009.ks/index/11/text"],["SC_M_009.ks/index/13/text"],["SC_M_009.ks/index/15/text"],["SC_M_009.ks/index/17/text"],["SC_M_009.ks/index/19/text"],["SC_M_009.ks/index/21/text"],["SC_M_009.ks/index/23/text"],["SC_M_009.ks/index/25/text"],["SC_M_009.ks/index/27/text"],["SC_M_009.ks/index/29/text"],["SC_M_009.ks/index/31/text"],["SC_M_009.ks/index/33/text"],["SC_M_009.ks/index/35/text"],["SC_M_009.ks/index/37/text"],["SC_M_009.ks/index/39/text"],["SC_M_009.ks/index/41/text"],["SC_M_009.ks/index/43/text"],["SC_M_009.ks/index/45/text"],["SC_M_009.ks/index/47/text"],["SC_M_009.ks/index/49/text"],["SC_M_009.ks/index/51/text"],["SC_M_009.ks/index/53/text"],["SC_M_009.ks/index/55/text"],["SC_M_009.ks/index/57/text"],["SC_M_009.ks/index/59/text"],["SC_M_009.ks/index/61/text"],["SC_M_009.ks/index/63/text"],["SC_M_009.ks/index/65/text"],["SC_M_009.ks/index/67/text"],["SC_M_009.ks/index/69/text"],["SC_M_009.ks/index/71/text"],["SC_M_009.ks/index/73/text"],["SC_M_009.ks/index/75/text"],["SC_M_009.ks/index/77/text"],["SC_M_009.ks/index/79/text"],["SC_M_009.ks/index/81/text"],["SC_M_009.ks/index/83/text"],["SC_M_009.ks/index/85/text"],["SC_M_009.ks/index/87/text"],["SC_M_009.ks/index/89/text"],["SC_M_009.ks/index/91/text"],["SC_M_009.ks/index/93/text"],["SC_M_009.ks/index/95/text"],["SC_M_009.ks/index/97/text"],["SC_M_009.ks/index/99/text"],["SC_M_009.ks/index/101/text"],["SC_M_009.ks/index/103/text"],["SC_M_009.ks/index/105/text"],["SC_M_009.ks/index/107/text"],["SC_M_009.ks/index/109/text"],["SC_M_009.ks/index/111/text"],["SC_M_009.ks/index/113/text"],["SC_M_009.ks/index/115/text"],["SC_M_009.ks/index/117/text"],["SC_M_009.ks/index/119/text"],["SC_M_009.ks/index/121/text"],["SC_M_009.ks/index/123/text"],["SC_M_009.ks/index/125/text"],["SC_M_009.ks/index/127/text"],["SC_M_009.ks/index/129/text"],["SC_M_009.ks/index/131/text"],["SC_M_009.ks/index/133/text"],["SC_M_009.ks/index/135/text"],["SC_M_009.ks/index/137/text"],["SC_M_009.ks/index/139/text"],["SC_M_009.ks/index/141/text"],["SC_M_009.ks/index/143/text"],["SC_M_009.ks/index/145/text"],["SC_M_009.ks/index/147/text"],["SC_M_009.ks/index/149/text"],["SC_M_009.ks/index/151/text"],["SC_M_009.ks/index/153/text"],["SC_M_009.ks/index/155/text"],["SC_M_009.ks/index/157/text"],["SC_M_009.ks/index/159/text"],["SC_M_009.ks/index/161/text"],["SC_M_009.ks/index/163/text"],["SC_M_009.ks/index/165/text"],["SC_M_009.ks/index/167/text"],["SC_M_009.ks/index/169/text"],["SC_M_009.ks/index/171/text"],["SC_M_009.ks/index/173/text"],["SC_M_009.ks/index/175/text"],["SC_M_009.ks/index/177/text"],["SC_M_009.ks/index/179/text"],["SC_M_009.ks/index/181/text"],["SC_M_009.ks/index/183/text"],["SC_M_009.ks/index/185/text"],["SC_M_009.ks/index/187/text"],["SC_M_009.ks/index/189/text"],["SC_M_009.ks/index/191/text"],["SC_M_009.ks/index/193/text"],["SC_M_009.ks/index/195/text"],["SC_M_009.ks/index/197/text"],["SC_M_009.ks/index/199/text"],["SC_M_009.ks/index/201/text"],["SC_M_009.ks/index/203/text"],["SC_M_009.ks/index/205/text"],["SC_M_009.ks/index/207/text"],["SC_M_009.ks/index/209/text"],["SC_M_009.ks/index/211/text"],["SC_M_009.ks/index/213/text"],["SC_M_009.ks/index/215/text"],["SC_M_009.ks/index/217/text"],["SC_M_009.ks/index/219/text"],["SC_M_009.ks/index/221/text"],["SC_M_009.ks/index/223/text"],["SC_M_009.ks/index/225/text"],["SC_M_009.ks/index/227/text"],["SC_M_009.ks/index/229/text"],["SC_M_009.ks/index/231/text"],["SC_M_009.ks/index/233/text"],["SC_M_009.ks/index/235/text"],["SC_M_009.ks/index/237/text"],["SC_M_009.ks/index/239/text"],["SC_M_009.ks/index/241/text"],["SC_M_009.ks/index/243/text"],["SC_M_009.ks/index/245/text"],["SC_M_009.ks/index/247/text"],["SC_M_009.ks/index/249/text"],["SC_M_009.ks/index/251/text"],["SC_M_009.ks/index/253/text"],["SC_M_009.ks/index/255/text"],["SC_M_009.ks/index/257/text"],["SC_M_009.ks/index/259/text"],["SC_M_009.ks/index/261/text"],["SC_M_009.ks/index/263/text"],["SC_M_009.ks/index/265/text"],["SC_M_009.ks/index/267/text"],["SC_M_009.ks/index/269/text"],["SC_M_009.ks/index/271/text"],["SC_M_009.ks/index/273/text"],[