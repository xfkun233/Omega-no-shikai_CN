}],[{"start":8047,"end":8064}],[{"start":8093,"end":8142}],[{"start":8168,"end":8181}],[{"start":8212,"end":8238}],[{"start":8269,"end":8279}],[{"start":8339,"end":8354}],[{"start":8406,"end":8422}],[{"start":8451,"end":8510}],[{"start":8536,"end":8552}],[{"start":8632,"end":8713}],[{"start":8739,"end":8755}],[{"start":8761,"end":8765}],[{"start":8800,"end":8817}],[{"start":8871,"end":8904}],[{"start":8931,"end":8999}],[{"start":9023,"end":9033}],[{"start":9062,"end":9099}],[{"start":9130,"end":9189}],[{"start":9213,"end":9243}],[{"start":9274,"end":9278},{"start":13281,"end":13285}],[{"start":9305,"end":9361}],[{"start":9469,"end":9472},{"start":10291,"end":10294}],[{"start":9514,"end":9520},{"start":10336,"end":10342}],[{"start":9557,"end":9584}],[{"start":9590,"end":9612}],[{"start":9670,"end":9744}],[{"start":9775,"end":9880}],[{"start":9998,"end":10006}],[{"start":10036,"end":10074}],[{"start":10107,"end":10111}],[{"start":10168,"end":10212}],[{"start":10373,"end":10417}],[{"start":10476,"end":10483}],[{"start":10525,"end":10565}],[{"start":10589,"end":10642}],[{"start":10652,"end":10663}],[{"start":10681,"end":10755}],[{"start":10828,"end":10857}],[{"start":10884,"end":11038}],[{"start":11047,"end":11049}],[{"start":11058,"end":11060}],[{"start":11069,"end":11071}],[{"start":11080,"end":11119}],[{"start":11150,"end":11182}],[{"start":11206,"end":11231}],[{"start":11260,"end":11319}],[{"start":11345,"end":11349}],[{"start":11355,"end":11384}],[{"start":11411,"end":11493}],[{"start":11523,"end":11568}],[{"start":11618,"end":11628}],[{"start":11657,"end":11721}],[{"start":11752,"end":11801}],[{"start":11828,"end":11894}],[{"start":11949,"end":12030}],[{"start":12057,"end":12100}],[{"start":12131,"end":12268}],[{"start":12296,"end":12340}],[{"start":12346,"end":12365}],[{"start":12392,"end":12435}],[{"start":12466,"end":12470}],[{"start":12519,"end":12524}],[{"start":12556,"end":12569}],[{"start":12694,"end":12711}],[{"start":12717,"end":12885}],[{"start":12920,"end":12973}],[{"start":12979,"end":12997}],[{"start":13003,"end":13021}],[{"start":13027,"end":13116}],[{"start":13122,"end":13129}],[{"start":13135,"end":13188}],[{"start":13194,"end":13233}],[{"start":13313,"end":13370}],[{"start":13380,"end":13395}],[{"start":13461,"end":13475}],[{"start":13496,"end":13504}],[{"start":13541,"end":13544},{"start":14682,"end":14685}],[{"start":13581,"end":13589}],[{"start":13653,"end":13666}],[{"start":13695,"end":13725}],[{"start":13762,"end":13774}],[{"start":13805,"end":13840}],[{"start":13869,"end":13933}],[{"start":13964,"end":14011}],[{"start":14040,"end":14070}],[{"start":14154,"end":14222}],[{"start":14243,"end":14256}],[{"start":14262,"end":14275}],[{"start":14337,"end":14386}],[{"start":14396,"end":14397}],[{"start":14407,"end":14528}],[{"start":14554,"end":14599}],[{"start":14605,"end":14653}],[{"start":14711,"end":14722}],[{"start":14768,"end":14832}],[{"start":14838,"end":14928}],[{"start":14941,"end":14942}],[{"start":14951,"end":14988}],[{"start":14994,"end":15026}],[{"start":15036,"end":15158}],[{"start":15164,"end":15192}],[{"start":15200,"end":15222}],[{"start":15228,"end":15262}],[{"start":15295,"end":15305}],[{"start":15378,"end":15388}],[{"start":15417,"end":15456}],[{"start":15487,"end":15513}],[{"start":15550,"end":15621}],[{"start":15655,"end":15660}],[{"start":15670,"end":15671}],[{"start":15680,"end":15683}],[{"start":15729,"end":15734}],[{"start":15744,"end":15753}],[{"start":15787,"end":15796}],[{"start":15802,"end":15806}],[{"start":15815,"end":15821}],[{"start":15841,"end":15842}],[{"start":15851,"end":15852},{"start":15903,"end":15904}],[{"start":15872,"end":15874}],[{"start":15883,"end":15884}],[{"start":15893,"end":15894}],[{"start":15913,"end":15916}],[{"start":15936,"end":15937}],[{"start":15946,"end":15947},{"start":15977,"end":15978}],[{"start":15956,"end":15958}],[{"start":15967,"end":15968}],[{"start":15987,"end":15990}],[{"start":16000,"end":16007}],[{"start":16072,"end":16073}],[{"start":16084,"end":16084}],[{"start":16116,"end":16126}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_079.ks","basename":"SC_M_079.ks","indexIds":{"「…」":0,"静かだ。":1,"大通りはそんなに遠くないはずなのに、\n車の音も人々の喧噪も、フィルターを通した別次元に\nあるかのように聞こえる。[l]\n建物―――店の中に居るのだから、当然と言えば当然だ。[l]\nしかし、この古い建築物が、\n余計に現実からの乖離感を助長もしてるのだろう。":2,"いや、実際、直線距離が近いだけで、大通りへ出ようとすれば\nかなり入り組んだ小道を通り抜ける必要があるほど、\nここの立地はややこしく、テレビで見る田舎の村の一角のようなのだ。[l]\n関東圏ではあるものの、まだこのあたりは山中と言っていい。[l]\n最近新たな路線が開通したとはいえ、ここがその恩恵を受けるには\nまだ何らかの要があるだろう。[l]\n地元では有名な山の麓近くにここはあり、\n外見は完全に古民家の様相を呈している。":3,"看板は…ほとんど読めない。[l]\n周囲の寂れ具合が何ともはや。[l]\n夏の夕方ともなれば、\n近くの山から蜩が鳴く声が聞こえ、\n大層あれな雰囲気になるのだろう。":4,"狭い店内、見渡す限り、古本の収められた書棚。":5,"紙独特の匂いが、\nこの建物自体の持つ、古い匂いと混じって、\n僕にとっては非常に心地いいのだが。":6,"これでいいのだろうか。":7,"ここは店だ。":8,"古本屋と聞いている。":9,"『ねこざんまい』という。":10,"世間じゃ今、学校も春休みで、終日僕はここに居る。":11,"ああ、今午後四時を回った。":12,"まだまだ寒さも残る日もあるが、\n春先なので西日も柔らかだ。[l]\n眠い…。[l]\n仕事といっても、やるべき仕事は、\nカウンターに座って客の対応をすることだけ。[l]\n在庫をどうこうしたり、\n棚を弄ったりは寧ろ止められている。[l]\nが、同じ場所に正確に戻す条件で、商品たる古本の読書は\n許可されている。[l]\nしかし。":13,"今日もこのまま、\n終わっていきそうだ…。":14,"そう思い、なんとなしに振り向くと、\n勝手口から戻ってくる、宮岡冬夏が居た。":15,"「んー、牛乳と、納豆と、卵と、\n甘いものと、お茶と買っておかなきゃだ、\nあとは…えっと、インクとケーブルと１００円ショップに行って…」":16,"彼女は買い物の時にメモを取る事で、\n家事してる感を堪能するのが好きらしく、\n今も何かぶつぶつ言いながらメモに細かく\n書き込んでいた。[l]\n彼女は良いトコの出なので、\nそういう瑣事をするのが新鮮で楽しいらしい。":17,"「…あの、冬夏」":18,"「…ん？　なにー」":19,"「僕は君と暮らすようになってから、\nお客というものを見たことがないですよ」":20,"ここに来たのは冬夏との結婚が決まり、\nつまり彼女が高校卒業してすぐだったが、\nあれから何年か経つというのに、\n少なくとも僕が店番をしてる最中に来客があったことは\n一度もない。[l]\nだから結局古本読書が仕事のようなものだ。":21,"「ん。[l]\nそうだねー」":22,"冬夏は――、\nいやに幸せそうな顔をしながら頷いた。[l]\nきっと、今日も裏で猫どもの相手をしてきたに\n違いない。":23,"「":24,"狩":25,"山の方の面倒見もあるのに、\nいつまでもこんな道楽してて良いんだろうか。[l]\nまあ、一応蓄えはあるし、\n":26,"真":27,"神の同人手伝いとかのボーナスもあるけどさ、\nなんというかな、独り暮らしならまだしも──」":28,"「そだね、\nこんなにも出来た美女と一緒に、\nなぁんておまけ付きじゃ、気が引けるのも分かるけど」":29,"…しれっと言われた。":30,"金髪碧眼というその容姿は、\nいかにも古民家なこの店には大変そぐわない。[l]\n隔世遺伝らしいが、\n中身は完全にこの國の人間で、外つ國の言語は話せない。[l]\n寧ろ横文字に弱いくらい……":31,"「あー…、そうね。　そうすね。[l]\nまさにその通りです。[l]\nこれでも引け目を感じまくりなんだよ僕は。[l]\n店長」":32,"そうなのだ。[l]\n彼女はそんなでありながら、\nここの主なのだった。":33,"この店には、\n":34,"五":35,"十":36,"六":37,"禅さんという年齢不詳の男性と、\n":38,"千":39,"万":40,"野チノという、これまた年齢不詳でマスク常備の女性が、\n店員……というか事務というか、[l]\nお手伝いさんというか、\n雑用みたいなことをしてくれる人として通ってくれている。[l]\n中身は結構変わった人達だが、\n見た目だけでいうとまさに執事長とメイド長みたいなコンビで、\n公私共に色々世話になってる。[l]\n主という立場の冬夏とも仲が良い。":41,"僕の実家の方の縁という事情もあるし、\nまあ、言ってみれば家族のようなものだ。":42,"そもそもこの店自体が、\n実家ゆかりの物件であって、\n……そう言えば母さんも、[l]\nそのうち見に来るとか何とか、\n知狡伯母さんから逃げたいとか、\nよく判らんこと言ってたな。[l]\n二人とも旅館の経営の中枢にいる人間だから、\n……いや、[l]\n単に知狡伯母さんが厳しすぎるからだろうな。":43,"「そんなことより、今から買い物行きたい。[l]\nついでに晩ご飯食べようよ。[l]\nゴゴイチのカレーが食べたい気分だけど真言さんはどう？」":44,"「あ、あー、いいけど。[l]\n禅さん達まだ居る？[l]\nあれなら一緒に誘ってもいいんじゃない」":45,"「ん？[l]\nあの２人なら今日も２人でおデートじゃないかなぁ？[l]\n何かずっと一緒に行動するよねーあの２人」":46,"「デートって感じかなあ……[l]\n何かもの凄い割り切った感の距離に見えるけど。[l]\nそれは僕が恋愛音痴だからですか。そうですか。[l]\nあっとじゃあ、買い物は食ってからか？[l]\n帰りは道路混むかもだけど」":47,"「恋愛音痴とか言ってるし。[l]\n克杖の件とかどの口が説明してくれんのかしらぁ？[l]\nあ、そいえば、\n克杖とは今度いつ会ってくるの？[l]\nてかそろそろあの話も振っておいてよね。[l]\nもう就職とかしたんだっけ、私全然聞いてないや。[l]\n":48,"新":49,"目の姉妹も大変なのかな、\n姫様のとこにお見舞いに行ってばっかでしょあの娘」":50,"「姫様ちゃんね……[l]\nまあ、大変というか……」":51,"僕あたりがどうこう言うのもあれだけど、\n克杖からは色々聞いてたのは確かなので、\nそのことを話す。":52,"「車椅子からは大分前に、それこそ卒業したらしいけど。[l]\nただ両腕に少し障碍が残るとか、\n普通の生活してる分には支障はないらしいけど、\n重い物持ったり、極度に細かい作業は厳しいってさ」":53,"「ふーん……[l]\nでもあんな事故にあって、\n死ななかっただけでもほんとに不幸中の幸いだったよ。[l]\n──やっぱ、記憶の方は、……？」":54,"姫様ちゃんは、\n数年前、[l]\n冬夏の実家のあるとある地方の、\nそこの祭の最中に起きた事故──山中で、\n野生動物に襲われた……らしい。[l]\n発見された時は大怪我を負っていて、\nその事故では、\n彼女の縁者だった数人が犠牲になった。[l]\n彼女の家が所有する山の中での祭儀だった為、\n犠牲者が身内だけで済んだ……のは或る意味で幸いだった。[l]\nが、[l]\nそれ以来祭は中止となり、\nもう何年も開催されていない。[l]\n冬夏は、もうやるつもりはないらしいし、\n元々マイナーな祭で、\n一定数の固定客でもってたようなものだから、\nま、今は別のイベントでも行われてるのかも知れない。[l]\nただ、出身校のよく判らない伝統的舞踊、\nみ、みつはの、みつはちなんとか？[l]\nそれはまだ続いているらしい。[l]\n僕も観たことがあるし、\nそのときは冬夏が主役だった。":55,"そう、彼女達に会ったのは、\nあの四季の始まり──春。":56,"「うーん……[l]\n言いたくないけど、\n難しい……っぽいみたい。[l]\nもう、記憶は戻んないのかもなあ……て、[l]\n言ってたけど……[l]\nああでも、在夜ちゃんは全然元気そうだったし、\n新しく今の状況を順調に、\n姫様ちゃんの頭の中に上書きしてるってさ。[l]\nてか、在夜ちゃんは、\nまるで妹が出来たみたいで嬉しいですーとか、\nあの娘もちっちゃいのにしっかりしてるよ。[l]\nま、あれだ。[l]\n別に記憶なんて無くたって、\n僕だってほら、よっく脳空転しててもこうやって、」":57,"「あっははははは。[l]\n確かに。[l]\n説得力あるよねー。[l]\nん、大丈夫よあの娘も。[l]\n生きてさえいればなんとでも、ね。[l]\nお姉さんもしっかりしてたし。[l]\nあー……、名前忘れたけど」":58,"運さんでしょが。[l]\n冬夏こそ脳空転の記憶喪失だなこれ。[l]\nそういや、\n旅行も最近行ってないな、\n東部もそうだし、\n西部も……[l]\nああ、西部といえば、きぃの話」":59,"「ん？[l]\n聞いた聞いた。[l]\nてか真言さんから聞いたんだっけ？[l]\nやっと家出放浪生活やめて、\n西部で":60,"加":61,"納":62,"子達と暮らすんでしょ」":63,"「うん、\n色々しがらみも解消したらしいし……」":64,"「やっとほんとうの『姉』妹になれるんだ。[l]\nあーあ、行く前に盛大にパーティーでもしたかったのに、\nいつの間にかだもんねー。[l]\n":65,"鬼怒":66,"子も水臭いなぁー」":67,"「その辺は多分、\n道具さんがまた強引にというか、\nドッキリのつもりだったとか、\n面白がった……つもりでいるんじゃないかな……[l]\nあのひとは":68,"艮家と一体どういう関係なんだか、\n人ん家の事でも構わずえらく干渉するのが好きだから……[l]\nそれに、きぃとは、\n僕だってあの時から全然会ってない──……」":69,"「あー……。[l]\n":70,"南":71,"ヶ":72,"斑さんならしそうだけど、\nそれでも、友達とのことよ？[l]\nひっどいよねぇ。[l]\n……およ？[l]\nそう言えば最後にきぃと会ったのいつだっけな……？[l]\n………。[l]\n……あぁん、[l]\nマジで私の記憶もやばいなぁ。[l]\nてか、[l]\n──まさか、[l]告られたりしてないよね？」":73,"「は？！[l]\nだれにすか」":74,"「きぃに決まってるでしょ。[l]\nあのこ、あれで真言さんには、\n友情以上の何かを秘めてた気がするのよねー。[l]\n顔もま、並の女子よりはかぁいいし？[l]\n真言さんもまんざらじゃなかったりして……」":75,"「あのなあ、\n真神の言い分じゃないけど、\n何で女子はそういう妄想を働かすかなあ？[l]\nオタとか関係なくＢＬ系話大好きよな……」":76,"「なんでだろね？[l]\n多分、\nほんとの男女の交わりが怖いんじゃないの。[l]\n現実逃避かなぁ──って、[l]\nあ、時間的にほら、[l]\nそろそろ行かないと混んじゃうよ、[l]って、[l]\n私が話を脱線させてました！[l]てへ！[l]なぁんて、[l]\n………。[l]\n……どしたの？」":77,"きぃ、[l]\nいつ、あって、[l]\nいつから、[l]あってないんだっけな？[l]\n……、[l]\n……、":78,"「──、え？[l]\nあ、いや、空転してた。[l]\n了解了解。[l]\n戸締まりと準備するんで、\n車のキーだけ用意しといてくれる」":79,"さて僕はどうしようか…[l]\nサラダとカレーきしめんでいいか。[l]\nいっつも同じだけど。":80,"「あ。[l]車の音楽、えーと、[l]なんだっけ？[l]\nえふえむとらんす、[l]と、[l]とらみってー？」":81,"「はいはい了解、\nえふえむとら、[l]とら……[l]ま、[l]解ってます、解ってますって。[l]\nそれはもう車内にあっから。[l]\nプレイヤーだけ冬夏準備してよ。[l]\n僕のは充電切れてる。[l]\nおりゃ、ちゃんとテレビも消しましたーっ、と。[l]\nじゃ、行きますか」":82,"そのとき、":83,"コンコン。":84,"戸を叩く音。":85,"店の入り口に人影が見えた。":86,"「すみませんーっ。あのぉーっ」":87,"顔を見合わせる僕と冬夏。":88,"コンコン。[l]\nその人物―――声からすると女性のようだ―――は、\n再び入り口の引き戸を叩いた。":89,"「…誰だ。冬夏、知り合い来る予定でも？」":90,"それともまさか。":91,"「もう閉まっちゃいましたぁーっ？[l]\n店長ーっ。　居ませんかぁーっ」":92,"「ちょ、ちょっと、冬夏さん。[l]\nなんかお客さんっぽいんですけど！」":93,"「んお？[l]\nなんでお客なんか来る？[l]\nあーもう店仕舞でご飯なのに…」":94,"「と、と、とりあえず僕出てくるわ」":95,"「…んー？　あっ！　真言さん待って！[l]\n思い出したっ！[l]\n忘れてたっ！！」":96,"入り口の引き戸を開けると、":97,"「いねーの？[l]\nあれか便所（ＷＣ）か？」":98,"「お待たせし…は？」":99,"「…い？　あっ……？　はっ！」":100,"互いに目が合い、一瞬間が空いた。":101,"「いらっしゃーい！[l]\nごっめんあぶないとこだった！！[l]\nそうそう真言さん、\n今日ね、」":102,"そこには、\n僕の親友の、":103,"「あんだえ、\n言ってなかったか冬夏ちん。[l]\n相変わらずどじっ娘だなああはははは。[l]\nよう、[l]\n嫁と娘、連れてきたでよ」":104,"真神雪鳴とその嫁かれお嬢が居た。":105,"しかも、":106,"「お前、うおお、それが娘さんか？」":107,"うわああああああ～～……なんだこれ、[l]\nなんだこれっ。":108,"「あー、ちなみんっての。[l]\nほんとは計画じゃ、\n第一子は男子の筈だったんだけんどなあ……[l]\nほれ、挨拶」":109,"「こぉんばんわぁっ」":110,"「いやっ……！[l]\nあぁん、[l]か、[l]可愛ぃぃぃっ！！！」":111,"「……なんか、友達の子供って、[l]\nすげえ奇妙な気分だな……、[l]\nああ、こんばんわ、因ちゃん？」":112,"「お姉ちゃんこんばんわ！[l]\nおじちゃんだーれ？」":113,"「……」":114,"「このおじちゃんは、\nパパンのお友達の真言おじちゃん。[l]\nこっちはその美人妻……のひと──」":115,"ごす！":116,"「あっで！」":117,"そこで僕はヤツのドタマをどついて発言を強制終了させた。":118,"まだ●●歳ってか、てめえと同い年だろうが！！":119,"「あ、このこったらもう、[l]\nパパもそんな、駄目デスよ、[l]\nす、[l]スミマセン……[l]\nお、[l]お久しぶりデス」":120,"「あ、かれおさん、\nいえ、いいんです、おっさんですもう……[l]\nてか、何か声変わりましたか？[l]\n落ち着いて大人っぽくなったんですかね、\n済みません先刻も気付きませんで……」":121,"「へっ？[l]\n":122,"い、いああそんな、[l]\nセクシー度が増したって言いマスか、[l]\n":123,"えへっ」":124,"「かれおん、\nそれって褒められてるのか？[l]\n老けたって意味じゃ──」":125,"「？！[l]\nや、褒めてますよ？[l]\n良い意味です、良い意味ですよ？」":126,"「おほほほほ」":127,"「……な、なんかキャラ変わりました？[l]\n子供出来たせいかしらん……」":128,"確かに、\n妙な凄味というか、安定感が。[l]\n真神もなんだかんだ言って尻に敷かれとるがな。":129,"にしても、子供かぁ……":130,"僕は、\n急にあるひとのことを思い出して、\n刹那、\n心に痛みを感じて彼等から眼を逸らし、\n部屋の中の古びた本を眺めた。":131,"「……はっ、[l]\nまさか、お前、この子にも既に」":132,"「あ？[l]\nあっちの仕込みは勿論してるってか、\n門前の小僧なんとやら、\n染まらぬ方が無理というものよ。[l]\n絵は兎も角、歌の方は結構もういけるぜ。[l]\nふっふっふ、歌チョイスのセンスもぱーぺきだわ。[l]\n手技術の方はこれからだろしな、\nいずれ『":133,"Br":134,"ow":135,"nB":136,"lack』も継げるくらい、[l]\nああ、まあ、続けられてればだけどな」":137,"「ひぇええ～～……[l]\nすげぇな……てか怖ぇぇな……」":138,"僕が若干引いてると、\n冬夏が大声を出した。":139,"「えーと、\nごめんなさいっ、\n完全に忘れて外食のつもりでその、\n夕飯料理の準備がにゃにも……」":140,"………。":141,"僕に似てきたか、冬夏。[l]\n記憶力がほんとに……":142,"「いーっていーって。[l]\nそんかわり、\n外食ついでに、\n久方ぶりに美声を披露して貰いましょかね。[l]\nそんでチャラちゅうことで」":143,"「おあ！[l]\nそれいいデスね！[l]\n噂の冬夏さんの歌是非聴きたいデス」":144,"「からおけー！！！」":145,"「おうっ？！[l]\nえ、[l]えへへ、[l]じゃあ、[l]\nそういうことで？[l]\nいいかな真言さん？」":146,"「え？[l]\nあ、そりゃ勿論。[l]\n僕も久しぶりに冬夏の本意気カラオケ聴きたい」":147,"「よっし、じゃ、時間もあれだし早速行きますか。[l]\n車はうちのでいいから。[l]\nちなみんの玩具とかあるからさー」":148,"女性陣２人と因ちゃんが、\nわいのわいの言いながら車へ移動して行くのを見送り、\n戸締まりだの何だのをしてると、[l]\n真神が耳打ちしてきた。":149,"「（ホントのことをお前にだけは言おう、[l]\n……まだ、アレな腕な訳だろ？）」":150,"「（……まあ、大分馴れてきたけど、[l]\nやっぱその、下手の横好きなままというか、[l]\n熱心ではあるんだけどな、[l]\nいや、徐々に上達はしてるわ、[l]\nまあ、[l]その、[l]あれだ、[l]\n知狡伯母さんのよりは全然いい……）」":151,"……実際、知狡伯母さんのを一度でも食したら、[l]\n誰のでも食える、ようになる。":152,"料理は克杖がすげえ上手いんだよなあ……":153,"「……。[l]\nじゃ、行くべえ。[l]\n積もる話もぎょうさんあるだろ」":154,"「ああ」":155,"僕等は、\n":156,"夕暮れの街へと繰り出した。":157,"楽しい時間はあっと言う間に過ぎる。":158,"泊まっていけって言ったけど、\n因ちゃんの事もあったのと、\n既にホテルを予約してたとかで、\n明日も一応会う予定を立て、\nあちら一家とは別れた。[l]\nそもそも今回は、\n西部に居を構える彼等が、\n久しぶりにこっちに旅行がてらに来たという事だったので、\n数日は滞在するのだろう。":159,"家に着いて真っ暗な玄関をくぐり、\n中に入るやいなや、\n丁度タイミング良く、宅配便が届いた。":160,"──あれ、[l]いつもの人じゃない。":161,"玄関先に居たのは女性の配達員だった。":162,"中央近しとは言えこんな所にいると、\nどうしても通販のが便があり、\n結果何度も宅急便が来るわけだが、\n当然ながらほぼ毎回同じ人が来て最早顔なじみだったのだ。":163,"だから驚いた。":164,"新入社員とかが来る時期なのかな？[l]\nそれとも時間帯だろうか。[l]\nもう、夜だしなあ。":165,"買った物を整理しに台所へ向かう冬夏を尻目に、\n僕はその荷物を確認する。":166,"ハコの票には、[l]\n覚えがあるがどうしても思い出せない、[l]\nある差出人の名前が書かれていて、":167,"その通信欄みたいな空白部分に、":168,"ゲームを始める？Y/X(N)":169,"と書いてあった。":170,"「？」":171,"なんじゃそりゃ。":172,"「……なんか気持ち悪いな」":173,"「なにそれ？[l]\n誰から？[l]\n通販？」":174,"戻って来た冬夏が言った。":175,"「いや、[l]あ、[l]冬夏、[l]\nこのひと知ってるよな？」":176,"「ん？[l]\n……ん。[l]\n知ってるの、知ってるのよ？[l]\nでも、[l]……だ、[l]誰だっけ……」":177,"「いや、いいんだ、\nやっぱ知ってるひとだよなぁ……[l]\n親戚だっけかな……」":178,"「……開けずに捨てちゃおうか？[l]\nでもなあ……」":179,"箱の中身は開けるまでは判らない、[l]\n　　最後に●●が？[l]\n　　否、[l]\n　　箱の中に私は●を視たから。":180,"急にそんな言葉が浮かんだ。":181,"どこできいたのだったか──":182,"「……はこの中に、[l]\n箱の中（P'sB）に残されているのは、[l]\n……悪しき":183,"禍":184,"事が解き放たれてなお、[l]\n只一つ、[l]世に出られなかった、[l]\n我等が知る事の叶わぬ何か、[l]\nだから『そのこと』は、[l]\n世界にとって禍か福か、[l]\n──あの話が言いたいのはどっちだ？」":185,"要らぬものが世に溢れ出て、[l]\n本来必要なものが与えられなかったという事なのか？":186,"大部分は取り返しが付かなかったが、[l]\n本当に大事なものは、無事だったという事なのか？":187,"だが、一つ言えるのは、":188,"知ってしまって辛くなる事はあっても、\n知らずにいれば幸せでいられる、[l]\nそういう事は殊の外多いということだ。":189,"そもそも僕等の脳からして、\n情報は取捨選択をしてる、[l]\nヒトが思うような純然たる真実など誰もみていない。[l]\nただ──[l]全員がそうだから、[l]\n":190,"僕":191,"等同士だけで通じる範囲であっても、\n差し支えなく通るというだけだ。":192,"僕等の知覚の外側、[l]\nそんなものがあると言われても、":193,"そこいらじゅうが細菌だらけと言われるようなもの、[l]\n知ろうが知るまいが、[l]\nずっと其処に居たものが、[l]\n意識し出した瞬間から存在し始めたかのように、[l]\n錯覚させられるのは余計なお世話というものだ。":194,"知らずにいれば、[l]\n知らずにいられればこそ、":195,"可能な他人とのコミュニケーションだってある。":196,"相手が自分をどう思っているかなど、\n正確に知ってしまったら、":197,"とてもじゃないが──":198,"「……それでも……」":199,"「？[l]\nどしたの？[l]\nそんなに悩むんだったらもう──」":200,"「え？[l]\nあ、いや、どうするべえか……」":201,"勝手な妄想が頭を支配していたが、\nあの一文とそれが一致してると考えるのは、\nあまりにも現実離れしてる、[l]\nしかし、":202,"ゲーム……":203,"遊":204,"戯……":205,"「何かが、":206,"嘗てあった──？」":207,"脳が空転し始めた。":208,"猫が裏で":209,"啼いている、":210,"痛":211,"い":212,"実か":213,"優":214,"し":215,"嘘か、":216,"Ａ":217,"ｎ":218,"ｄか":219,"Ｅ":220,"ｄか、":221,"僕の選択は──":222,"Ｙ":223,"@r":224,"Ｘ（バツ或いはＮｏ）":225},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_079.ks","relPath":"/data/scenario/SC_M_079.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":208,"length":226,"percent":92.03539823008849},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[32,0]},"/data/scenario/SC_M_080.ks":{"data":[["「……おあ」","「……哇」"],["箱を開けると、[l]\n白いねこの縫いぐるみ、[l]\nこれは、[l]\n確か、","打开箱子，[l]\n白色猫咪玩偶，[l]\n这个，[l]\n应该是，"],["それに、","而且，"],["「何これ？[l]\nあっ！[l]\nシロ？[l]\nシロじゃん！！[l]\nなんでー！？[l]\n超懐かしいーーー！！！[l]\nってことはやっぱ本家の誰かからかな？[l]\nってあれ、他にも何か」","「什么啊这是？[l]\n啊！[l]\n小白？[l]\n是小白啊！！[l]\n为什么啊！？[l]\n超级怀念啊啊啊！！！[l]\n这么说果然是本家谁送来的吧？[l]\n话说等等，还有其他东西」"],["「慌てなさんなって、\nなんだこれ、\nバインダー……中身無しの。[l]\n……補強板のつもりかな……えーと、[l]\nそれに？[l]\n便箋封筒……か？[l]\n手紙──だけじゃなくて何か入ってるな、\nん？[l]\n固い、わっか、リング……」","「别这么慌张，\n这是什么，\n活页夹……里面空的。[l]\n……难道是当加固板用的……呃，[l]\n还有呢？[l]\n信纸信封……吗？[l]\n信——不止有信还装着别的，\n嗯？[l]\n硬的，圆环，戒指……」"],["「みせてよ、\nん、これは！」","「给我看看，\n嗯，这是！」"],["「……指輪","「……戒指"],["が二つ？[l]\n君と……僕にか？な？」","有两枚？[l]\n给你……和我的？哈？」"],["「──ふう。[l]\n何にしてももう少し時間と、\ninterludeが──おや」","「──呼。[l]\n总之还需要点时间，\ninterlude就要——哎呀」"],["「遅くまでご苦労さん。[l]\n少し休んだら？」","「加班辛苦了。[l]\n稍微休息下？」"],["「そうしましょう。[l]\n疲れました。[l]\nこころをおににするというのは、\n存外に力の要るものですね。[l]\n世の者共が●●●すのもよくわかります」","「就这么办吧。[l]\n我累了。[l]\n把心变成鬼这种事，\n意外地很费力气呢。[l]\n世人会●●●也是可以理解的」"],["「耳が痛いよ。[l]\nでもま、御陰様で準備は出来た。[l]\nありがとう」","「听着刺耳啊。[l]\n不过嘛，托您的福准备都完成了。[l]\n多谢」"],["「いえ……」","「不……」"],["「んむ？」","「嗯唔？」"],["「ある日取りを決めて、\n知人同士でイベントめいた計画──[l]\n会食やら交遊やらをするとしましょう。[l]\n事前にプランをしっかりたてて、\nいざ本番にのぞみます、すると、\nでも、[l]\n当日は存外にあっさり終わってしまうものです。[l]\n費用対効果としては……無駄骨かも知れません、[l]\n期待したりした分ハードルも上がっていたり、\nあまり──その、[l]\nあなたは●●んでくれたのでしょうか」","「假设定下某个日子，\n和熟人搞些活动性质的计划──[l]\n比如聚餐啊联谊啊什么的。[l]\n事先认真制定好计划，\n等到正式实施时却发现，\n可是，[l]\n当天往往会意外地草草收场。[l]\n从投入产出比来看……或许白费功夫，[l]\n越是期待门槛就抬得越高，\n实在──那个，[l]\n您●●●了吗？」"],["「とは言えそういうものだよ。[l]\n例えば、\n探し求めていた稀覯本、\nいざ覚悟を決めて、\n大きな街の本屋を軒並みローラー作戦！[l]\nと、そんな気負いでね、\n出掛ける前に沢山の書店を下調べしたとて、\n最初に入った本屋であっさり見つかる事もあるさ。[l]\n運が良いとは言えるだろうが、\nしかし、[l]\n一種の物足りなさも感じるだろ？[l]\nそれでも、[l]\n目的は達して、寧ろ上々の結果だ。[l]\n優先順位の錯綜、混乱、取違、\n主観によるただの感想は、\n時に何の役にも立たず、\n寝れば忘れる程度の静かな細波さ。[l]\nともあれ、\n此度の劇によって、\n当初から計画していた通りの重要な結果はもたらされた。[l]\n故に、[l]\nちゃんと●●んだよ、個人的には。[l]\n過程で起きた予期せぬイベントも、\n必要な旗さえ立っていれば、良き余興だった訳だしね」","「话虽这么说但就是这样的。[l]\n比方说，\n苦苦寻觅的珍本，\n好不容易下定决心，\n跑遍大城市的书店搞地毯式搜索！[l]\n怀着这般干劲，\n即便出门前查遍各家书店信息，\n也可能在进的第一家店就轻松找到。[l]\n可以说运气很好吧，\n但是，[l]\n总会感到某种意犹未尽吧？[l]\n即便如此，[l]\n目的已经达成，结果堪称上乘。[l]\n优先级错乱、混淆、误解，\n这些主观的感想，\n有时毫无用处，\n不过是睡一觉就会忘记的细微涟漪。[l]\n总之，\n通过这次戏剧，\n得到了与最初计划完全一致的重要结果。[l]\n所以，[l]\n我个人确实●●●了。[l]\n过程中发生的意外事件，\n只要关键flag立住了，就是不错的余兴节目」"],["「ならばよいのですが。[l]\nその旗を立てるにおいて有用だった彼ですが──」","「那就好。[l]\n不过那位立flag有功之人──」"],["「彼には、\nゆっくり休んで貰いたい。[l]\n","「希望他能\n好好休息。[l]\n"],["劇","戏剧"],["の","的"],["司","司"],["会","会"],["者","者"],["視","视"],["界は、\n手間も掛かるし疲れるものだ。[l]\n彼はそれこそ、[l]\nその主体人格を無視され──否、[l]\n無視して、巻き込まれた──否、[l]\n巻き込んだに過ぎない。[l]\nボクの我が儘にね。[l]\n流石のボクも同情を禁じ得ない」","界这地方，\n既费事又累人。[l]\n他呀，[l]\n连主体人格都被无视──不，[l]\n是我们无视他，硬把他卷进来──不，[l]\n应该说是利用了他。[l]\n为了我的任性。[l]\n连我都不禁要同情他」"],["「……保留扱いにしておりますが、[l]\n必要があれば、\n彼の者にはまた舞台に上がって貰わざるを得ません。[l]\nその為の、[l]\n──ええ、なので今度は、\n事前に自主的な選択を可能なように配慮しました」","「……目前暂作保留处理，[l]\n但如有必要，\n不得不再次请他登上舞台。[l]\n为此——[l]\n嗯，所以这次，\n我们事先考虑到了让他能自主选择的可能性」"],["「んむ、それくらいしか出来ることはないだろうな。[l]\nま、先は長い。[l]\nつかの間とは言っても、\n新たな世代を育むくらいの時間はあるだろうさ。[l]\nそれはきっと幸せな時間だろう。[l]\nボクには絶えて久しい時間──」","「唔，能做的也就这些了吧。[l]\n嘛，来日方长。[l]\n虽说只是短暂间隙，\n也足够培育新一代了。[l]\n那想必会是幸福的时光吧。[l]\n对我而言早已久违的时光——」"],["「……」",""],["「ボクと、妹の為に、\nキミにこんなことを強いるのを、\n恨むかい？[l]\nノート（Note）・デュー（Due）。[l]\nＤＥＷ（しずく）と似て非なるもの、\nＷＥＤ（結びつけるの逆（さか）さ）にて、\nＧＭ（遊戯の仕切り人）」","「为了我和妹妹，\n强迫你做这些事，\n会恨我吗？[l]\nNote・Due。[l]\n与DEW（水滴）似是而非之物，\n以WED（联结之逆）为名，\nGM（游戏主持人）」"],["「私は貴方の望むがままに。[l]\n貴方が貴方を厭えと言えば、\n命令通りに厭うてみせましょう。[l]\n貴方が私に貴方以外の誰かを愛せというなら、\n愛してみせましょう。[l]\n私にとっては貴方が全て。[l]\nそして、\n貴方が●●と言うなら、従うまでです。[l]\nそれが、」","「我会如你所愿。[l]\n若你说厌恶自己，\n我便按令表现出厌恶。[l]\n若你命我去爱除你之外的某人，\n我也会去爱。[l]\n对我而言你就是全部。[l]\n然后，\n只要你说●●，我就会服从。[l]\n这就是，」"],["──私のアイです。","——我的爱。"],["「……感謝しているよ。[l]\nでは、[l]\n","「……我很感激。[l]\n那么，[l]\n"],["いまはもう、[l]おやすみ」","现在该[l]晚安了」"],["「……わかりました」","「……明白了」"],["ゲームをするには","进行游戏需要"],["面","面"],["子と動作環境が必要。","子和运行环境。"],["そして、","接着"],["敵と","敌与"],["味方とが、","友方，"],["漸く振り分けられた。","终于分配完毕。"],["あとは盤と駒に、","接下来只需对棋盘与棋子，"],["今少し仕込みが必要。","稍作最后准备。"],["「長き、永き夜はまた、始まる……」","「漫长、漫长的夜，又要开始了……」"],["そう願って──","如此祈愿着——"]],"context":[["SC_M_080.ks/index/1/text"],["SC_M_080.ks/index/3/text"],["SC_M_080.ks/index/5/text"],["SC_M_080.ks/index/7/text"],["SC_M_080.ks/index/9/text"],["SC_M_080.ks/index/11/text"],["SC_M_080.ks/index/13/text"],["SC_M_080.ks/index/15/text"],["SC_M_080.ks/index/17/text"],["SC_M_080.ks/index/19/text"],["SC_M_080.ks/index/21/text"],["SC_M_080.ks/index/23/text"],["SC_M_080.ks/index/25/text"],["SC_M_080.ks/index/27/text"],["SC_M_080.ks/index/29/text"],["SC_M_080.ks/index/31/text"],["SC_M_080.ks/index/33/text"],["SC_M_080.ks/index/35/text"],["SC_M_080.ks/index/38/text"],["SC_M_080.ks/index/40/text","SC_M_080.ks/index/48/text"],["SC_M_080.ks/index/42/text"],["SC_M_080.ks/index/44/text"],["SC_M_080.ks/index/46/text"],["SC_M_080.ks/index/50/text"],["SC_M_080.ks/index/52/text"],["SC_M_080.ks/index/54/text"],["SC_M_080.ks/index/56/text"],["SC_M_080.ks/index/58/text"],["SC_M_080.ks/index/60/text"],["SC_M_080.ks/index/62/text"],["SC_M_080.ks/index/64/text"],["SC_M_080.ks/index/66/text"],["SC_M_080.ks/index/69/text"],["SC_M_080.ks/index/71/text"],["SC_M_080.ks/index/73/text"],["SC_M_080.ks/index/75/text"],["SC_M_080.ks/index/77/text"],["SC_M_080.ks/index/79/text"],["SC_M_080.ks/index/81/text"],["SC_M_080.ks/index/83/text"],["SC_M_080.ks/index/85/text"],["SC_M_080.ks/index/87/text"],["SC_M_080.ks/index/89/text"],["SC_M_080.ks/index/91/text"],["SC_M_080.ks/index/93/text"]],"tags":[],"parameters":[[{"start":157,"end":163}],[{"start":227,"end":276}],[{"start":286,"end":290}],[{"start":334,"end":454}],[{"start":485,"end":634}],[{"start":663,"end":681}],[{"start":712,"end":717}],[{"start":730,"end":753}],[{"start":1560,"end":1607}],[{"start":1642,"end":1669}],[{"start":1749,"end":1840}],[{"start":1871,"end":1915}],[{"start":1943,"end":1949}],[{"start":1980,"end":1985}],[{"start":2013,"end":2250}],[{"start":2281,"end":2746}],[{"start":2774,"end":2816}],[{"start":2847,"end":2873}],[{"start":2887,"end":2888}],[{"start":2898,"end":2899},{"start":2940,"end":2941}],[{"start":2909,"end":2910}],[{"start":2920,"end":2921}],[{"start":2930,"end":2931}],[{"start":2950,"end":2951}],[{"start":2960,"end":3102}],[{"start":3130,"end":3251}],[{"start":3282,"end":3413}],[{"start":3441,"end":3445}],[{"start":3476,"end":3610}],[{"start":3638,"end":3804}],[{"start":3866,"end":3875}],[{"start":3921,"end":3947}],[{"start":3977,"end":3991}],[{"start":4019,"end":4029}],[{"start":4091,"end":4099}],[{"start":4109,"end":4110}],[{"start":4121,"end":4131}],[{"start":4137,"end":4141}],[{"start":4160,"end":4162}],[{"start":4171,"end":4176}],[{"start":4186,"end":4196}],[{"start":4202,"end":4210}],[{"start":4220,"end":4230}],[{"start":4299,"end":4316}],[{"start":4406,"end":4413}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_080.ks","basename":"SC_M_080.ks","indexIds":{"「……おあ」":0,"箱を開けると、[l]\n白いねこの縫いぐるみ、[l]\nこれは、[l]\n確か、":1,"それに、":2,"「何これ？[l]\nあっ！[l]\nシロ？[l]\nシロじゃん！！[l]\nなんでー！？[l]\n超懐かしいーーー！！！[l]\nってことはやっぱ本家の誰かからかな？[l]\nってあれ、他にも何か」":3,"「慌てなさんなって、\nなんだこれ、\nバインダー……中身無しの。[l]\n……補強板のつもりかな……えーと、[l]\nそれに？[l]\n便箋封筒……か？[l]\n手紙──だけじゃなくて何か入ってるな、\nん？[l]\n固い、わっか、リング……」":4,"「みせてよ、\nん、これは！」":5,"「……指輪":6,"が二つ？[l]\n君と……僕にか？な？」":7,"「──ふう。[l]\n何にしてももう少し時間と、\ninterludeが──おや」":8,"「遅くまでご苦労さん。[l]\n少し休んだら？」":9,"「そうしましょう。[l]\n疲れました。[l]\nこころをおににするというのは、\n存外に力の要るものですね。[l]\n世の者共が●●●すのもよくわかります」":10,"「耳が痛いよ。[l]\nでもま、御陰様で準備は出来た。[l]\nありがとう」":11,"「いえ……」":12,"「んむ？」":13,"「ある日取りを決めて、\n知人同士でイベントめいた計画──[l]\n会食やら交遊やらをするとしましょう。[l]\n事前にプランをしっかりたてて、\nいざ本番にのぞみます、すると、\nでも、[l]\n当日は存外にあっさり終わってしまうものです。[l]\n費用対効果としては……無駄骨かも知れません、[l]\n期待したりした分ハードルも上がっていたり、\nあまり──その、[l]\nあなたは●●んでくれたのでしょうか」":14,"「とは言えそういうものだよ。[l]\n例えば、\n探し求めていた稀覯本、\nいざ覚悟を決めて、\n大きな街の本屋を軒並みローラー作戦！[l]\nと、そんな気負いでね、\n出掛ける前に沢山の書店を下調べしたとて、\n最初に入った本屋であっさり見つかる事もあるさ。[l]\n運が良いとは言えるだろうが、\nしかし、[l]\n一種の物足りなさも感じるだろ？[l]\nそれでも、[l]\n目的は達して、寧ろ上々の結果だ。[l]\n優先順位の錯綜、混乱、取違、\n主観によるただの感想は、\n時に何の役にも立たず、\n寝れば忘れる程度の静かな細波さ。[l]\nともあれ、\n此度の劇によって、\n当初から計画していた通りの重要な結果はもたらされた。[l]\n故に、[l]\nちゃんと●●んだよ、個人的には。[l]\n過程で起きた予期せぬイベントも、\n必要な旗さえ立っていれば、良き余興だった訳だしね」":15,"「ならばよいのですが。[l]\nその旗を立てるにおいて有用だった彼ですが──」":16,"「彼には、\nゆっくり休んで貰いたい。[l]\n":17,"劇":18,"の":19,"司":20,"会":21,"者":22,"視":23,"界は、\n手間も掛かるし疲れるものだ。[l]\n彼はそれこそ、[l]\nその主体人格を無視され──否、[l]\n無視して、巻き込まれた──否、[l]\n巻き込んだに過ぎない。[l]\nボクの我が儘にね。[l]\n流石のボクも同情を禁じ得ない」":24,"「……保留扱いにしておりますが、[l]\n必要があれば、\n彼の者にはまた舞台に上がって貰わざるを得ません。[l]\nその為の、[l]\n──ええ、なので今度は、\n事前に自主的な選択を可能なように配慮しました」":25,"「んむ、それくらいしか出来ることはないだろうな。[l]\nま、先は長い。[l]\nつかの間とは言っても、\n新たな世代を育むくらいの時間はあるだろうさ。[l]\nそれはきっと幸せな時間だろう。[l]\nボクには絶えて久しい時間──」":26,"「……」":27,"「ボクと、妹の為に、\nキミにこんなことを強いるのを、\n恨むかい？[l]\nノート（Note）・デュー（Due）。[l]\nＤＥＷ（しずく）と似て非なるもの、\nＷＥＤ（結びつけるの逆（さか）さ）にて、\nＧＭ（遊戯の仕切り人）」":28,"「私は貴方の望むがままに。[l]\n貴方が貴方を厭えと言えば、\n命令通りに厭うてみせましょう。[l]\n貴方が私に貴方以外の誰かを愛せというなら、\n愛してみせましょう。[l]\n私にとっては貴方が全て。[l]\nそして、\n貴方が●●と言うなら、従うまでです。[l]\nそれが、」":29,"──私のアイです。":30,"「……感謝しているよ。[l]\nでは、[l]\n":31,"いまはもう、[l]おやすみ」":32,"「……わかりました」":33,"ゲームをするには":34,"面":35,"子と動作環境が必要。":36,"そして、":37,"敵と":38,"味方とが、":39,"漸く振り分けられた。":40,"あとは盤と駒に、":41,"今少し仕込みが必要。":42,"「長き、永き夜はまた、始まる……」":43,"そう願って──":44},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_080.ks","relPath":"/data/scenario/SC_M_080.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":44,"length":45,"percent":97.77777777777777},"cellInfo":[],"cacheResetOnChange":{},"lastSelectedCell":[28,0]},"/data/scenario/SC_S_000.ks":{"data":[["五日も間が空けば、\nそれなりに気持ちに整理もついて、\n今では、僕はむしろ何かしらの重圧から逃れたような\n爽快と言ってもいい気分となっていた。","间隔五天之后，\n心情总算整理得差不多，\n现在反倒像是从某种重压下逃脱，\n甚至可以说神清气爽。"],["面倒なことは大嫌いな上に眠ると忘れる質、というのも\n助けになったのだろう。[l]\n勿論かつて暮らした田舎への帰郷、ということもあるが、\nそもそも僕は都会よりは田舎の方が好きなのだ。[l]\nそれは大学に一年いて、出来た友人が大神ただ一人、\nしかも学部ではなくサークルで、\nという事からもわかるように、\n僕はやや対人関係が苦手なのである。","讨厌麻烦事加上睡醒就忘的体质，\n大概也帮了忙吧。[l]\n当然也有重返曾经生活的乡下之故，\n毕竟我本就偏爱乡村胜过都市。[l]\n从大学一年间仅交到大神一个朋友，\n而且还是在社团而非学部，\n这件事就能看出，\n我确实不太擅长人际关系。"],["田舎は田舎で、土着というか、\n人が少ないが故に出来上がる、\nしがらみめいた人間関係もあるわけだが、\n僕のは単純に人混みが嫌いというのもあって\n（コンパだのが大嫌いだった）、\n何かと一人で田舎の方を旅するのが好きなのだった。[l]\n宮さんの所でのバイトが有る程度たまると連休などを選んで、\nよく近場ならドライブ、遠方なら新幹線で泊まりがけ、\nというのをこの一年はしたものだ。[l]\nそれでも何故か玄ノ森には行かなかったな、\n今にして思えば。","乡下有乡下的规矩，说是乡土气也好，\n正因为人少才形成的、\n那种盘根错节的人际关系也是有的，\n而我纯粹是讨厌人多的地方\n（最烦联谊会了），\n总之就是喜欢独自在乡下旅行。[l]\n在宫小姐店里打工攒到一定程度后，就会选个连休、\n近处就开车兜风，远处就坐新干线过夜、\n这一年里经常这么干。[l]\n现在想来,\n不知为何唯独没去玄之森."],["で、大神といえば。[l]\nこっちの準備は割と早くすんだので、\n宮さん達の方を手伝ったりしたのだが、\n大神と、戻ってからじゃなく今飲むか、という話になった時、\nまだ滞在していたかれお嬢も一緒に誘ったのだ。","说到大神。[l]\n因为我这边准备得比较快、\n就去帮宫小姐他们打下手、\n结果和大神商量\"现在喝一杯吧别等回去\"的时候、\n把还留在店里的卡蕾欧小姐也一起叫上了。"],["そうしたら二人はえらい勢いで意気投合し、\n僕もまだ気持ちが不安定な時だったので、\nいつも以上に飲みが進んであんまり記憶がないのだが、\nお二方には何かしらの関係が生まれたようだった。[l]\nただ、覚えてる限りの記憶では、\n愛情というよりは友情が生まれた感じだったけど。[l]\nまあ、温かく見守らせてもらうよ。[l]\nそんな余裕が僕にあればだがな。","结果那两人意气相投得不得了、\n加上我当时情绪也不太稳定、\n喝得比平时猛所以记忆很模糊、\n不过那两位之间似乎产生了某种羁绊。[l]\n只是根据我残存的记忆、\n感觉更像是友情而非爱情啦。[l]\n嘛，我就默默祝福他们吧。[l]\n虽然我未必有这份余裕就是了。"],["ちなみにかれお嬢は、その後すぐに例の所用とやらで\n出立したらしい。[l]\n見送りは出来なかった。大神の去就は知るところではない。","顺带一提卡蕾欧小姐之后很快就因为那件所谓的要事、\n动身离开了。[l]\n没能送行。大神的去向也不得而知。"],["その飲みの席で知ったことだが、某日宮さんの所に来たとき、\n彼女は携帯電話を持ってなかったのだそうだ。[l]\nだから来訪も急だったようで、宮さんに掛かってきた謎の番号は、\nそこいらの人に借りたり、店に入ったりして掛けてきたものだった。[l]\n番号変えたとかいうレベルじゃなかった、ということで、\nあとで宮さんに教えたら、また憤慨しておられた。","那次酒局上听说，她那天来宫小姐店里时，\n居然没带手机。[l]\n所以来访也很突然，宫小姐接到的神秘来电，\n是她向路人借手机或是进店里打的。[l]\n根本不是换号码这种程度的问题、\n后来告诉宫小姐时，她又气得够呛。"],["といった事情で二人は携帯番号の交換も\nままならなかったようだが、\n僕が出発直前に大神に連絡したところ、\n奴も思ったよりサバサバしていたので、\n何らかの交信手段は得たのかも知れなかった。[l]\nいずれそろそろ学校も始まるし、大神も案外余裕がないのか、\n或いは単なるバカなのか。[l]\nそれとも女子にはがっつくほど餓えてもないのか。[l]\n僕も宮さんの御陰で、女性との交流自体に躍起になる事はないが、\nそうは言ってもお付き合いするような女子とは出会いたい。[l]\nというのは勿論なので、少々奴が羨ましい。","因为这些缘故两人连手机号码、\n都没能交换成、\n不过我在出发前联系大神时、\n那家伙意外地爽快、\n说不定已经搞到了某种联系方式。[l]\n毕竟学校快开学了，大神可能也没那么从容、\n或者单纯就是个笨蛋。[l]\n又或者对女生还没饥渴到那种程度？[l]\n托宫小姐的福，我倒不会执着于和女性交往、\n但话虽如此还是想遇到能正经谈恋爱的姑娘。[l]\n这点心思当然有，所以稍微有点羡慕那家伙。"],["ま、大神よ、読めない奴で面白かったが、これでしばしのお別れだ。[l]\nたった一年の付き合いだったが楽しかったよ。[l]\n縁があったらまた会おう。[l]\n無ければそれまで。惜しい縁でも無し。[l]\n後腐れ無く忘れ合おうや。","嘛，大神你这捉摸不透的家伙还挺有趣，暂时要分别啦。[l]\n虽然只相处了一年，真的很开心。[l]\n有缘再会吧。[l]\n无缘就算了。也不是什么可惜的缘分。[l]\n干脆利落地相忘于江湖吧。"],["さて、今日は朝から待ち合わせて、\n私鉄の駅に行くと、宮さんは余所行きの姿で一人で先に来ていた。[l]\nむう、なんかイメージが違うな。[l]\nさすが女子、化けますなぁ。[l]\nあれ、というか一人なのか。[l]\n店、禅さんに任せたと言っていたが、見送りにも来ないんだな…。[l]\n待たせて済みません、と謝りながら早速僕らは改札へ。[l]\nそこから中央の駅へ向かい、\n新幹線で飯窪本家のある北の田舎へと、出発する。","话说今天早上约好碰头、\n赶到私铁车站时，宫小姐已独自换上外出服先到了。[l]\n唔，和想象中不太一样呢。[l]\n不愧是女孩子，真会变装啊。[l]\n咦，就她一个人吗？[l]\n说是把店交给禅先生了，居然连送行都不来…[l]\n边道歉说久等了，我们立刻通过检票口、[l]\n前往中央车站、\n搭乘新干线前往饭洼本家所在的北方乡下。"],["中央の駅についた時点で、時間的には予定通り。[l]\n宮さんはタバコの煙が大嫌いだったので、\n禁煙席の指定券を前日に購入してある。[l]\n指定席なのでずっとホームで並ぶ必要もなく、\n幸いダイヤの乱れも無いようだしと、\n僕と宮さんは発車時刻まで、駅構内の飲食店にて時間を潰した。","抵达中央车站时，时间还算符合预期。[l]\n宫小姐最讨厌香烟的烟雾，\n所以提前一天买好了禁烟席的指定座票。[l]\n既然是指定座位就无需在月台排队，\n所幸列车时刻表也没出现混乱，\n我和宫小姐在发车前就在站内餐饮店消磨时间。"],["ぶっちゃけ（おそらく僕だけでなく二人とも）眠かったのだが、\n旅への高揚感か、今のところテンションは保っている。[l]\n乗ってしまえばさっくり寝そうだがそれはそれだ。[l]\n別に寝ちゃいけない訳でもない。[l]\nただ、宮さんに寝顔見られるのに抵抗があるだけだ。","说实话（可能不止我，我俩都）困得要命，\n但或许是旅途的兴奋感，目前情绪还算高涨。[l]\n上车后估计倒头就睡，不过也无所谓。[l]\n本来就没规定不能睡觉。[l]\n只是不想宫小姐看到我的睡相罢了。"],["過去一度だけバイト中に寝落ちてしまい、\nかなり弄られたことがあった故である。[l]\nそれまで全く自覚が無かったのだが、\n僕は目を開いたまま寝る系の人らしい。[l]\n寝言をハキハキ喋るというのは昔から言われてたんだが、\n目の件は初めて知らされて、かなりショックだった。","过去只有一次在打工时不小心睡着了，\n结果被狠狠捉弄了一番的缘故。[l]\n在此之前完全没有自觉，\n我似乎是那种睁着眼睛睡觉的类型。[l]\n说梦话会清清楚楚讲出来这事从小就被说，\n但睁眼睡觉是第一次知道，相当受打击。"],["しかーし、\n今日は宮さんも寝そうだから、逆に寝顔を見てやるくらいの\n気概でいきたい。","不过——\n今天宫小姐也快睡着了，我反倒要拿出欣赏她睡颜的\n气概来。"],["知狡さん達に中央の土産も買って行こうとしたのだが、\nきちんとめの売店がまだ開いておらず、\nホーム売店の有り体な菓子を買わざるを得なかったのが残念。","本想给知狡她们买些中央车站的土特产，\n但正经卖特产的店铺还没开门，\n只好买了站台小卖部的寒酸点心，实在遗憾。"],["発車時刻になり、ホームにアナウンスが流れる。[l]\n二階建ての新幹線が入ってきた。[l]\nこの車両、一階席の目線はあまりに悲しいと思ってるのだが、\n今日は二階席なのでちょっとだけ嬉しい。","发车时刻到，站台响起广播。[l]\n双层新干线进站了。[l]\n我一直觉得这车厢的一楼座位视野不好，\n不过今天是二楼座位，所以稍微有点开心。"],["たまたまかも知れないが、\n周りは上品そうな老人が大半で、\n子供連れは勿論、酒臭いおっさんどもは居なかった。[l]\nグリーン車ではよく見る光景だが、普通車両ではあまり経験がない。[l]\n…よく見るったってそんなに回数乗ってませんがね！[l]\nグリーンなんて！[l]\nまあ、平日昼間だから当然と言えば当然だが、\nハズレに当たるとまさに、","说不定只是偶然，\n周围大半是看起来很有品位的老人，\n别说带小孩的，连酒气熏天的大叔们都不见踪影。[l]\n这份清净这在绿色车厢（译注：类似于国内的商务座）是常见景象，但普通车厢可就不常遇到了。[l]\n…说是“常见”其实我也没坐过几次啦！[l]\n毕竟是绿色车厢嘛！[l]\n不过平日的白天倒也理所当然，\n要是碰上倒霉的时候，"],["「まこくんはお休みの日にしか新幹線に乗ったこと\nないですか？[l]\n平日はですねえ、\nサラリーマンが酒とつまみを食しながらくだを巻く、\nそれはもう宮の嗅覚視覚聴覚にとっては害悪以外の何者でもない\n三重苦の箱と化すのです。[l]\nありえないす。ありえないすよ！[l]\nんむ～、想像するだに身の毛のよだつっ！」","「小真难道只在休息日才坐新干线\n吗？[l]\n工作日的话啊，\n上班族们边喝酒嚼零食边胡扯闲谈，\n对宫的嗅觉视觉听觉来说简直就是彻头彻尾的祸害\n会变成三重折磨的牢笼。[l]\n太离谱了。简直离谱！[l]\n嗯唔～光是想象就让人毛骨悚然啦！"],["と、宮さんが半泣きになって力説する状況になってげっそりする訳である。[l]\nそういえば、最初はしきりにグリーンに乗りたがってたなあ。[l]\n宮さんは今までほとんど普通車両に乗ったことがないというから、\nそんなに高確率であたらねえよと思って、というより単にもったいなかったので、\nなだめすかして普通のを買ったのだが、\nよくよく考えれば、旅費は僕持ちじゃなかったのだし、\n宮さんの聞いてやれば良かったかも。","看到宫小姐半哭着极力主张的样子，我不由得蔫了下来。[l]\n说起来，一开始她可是拼命闹着要坐绿色车厢来着。[l]\n因为宫小姐说她至今几乎没坐过普通车厢（译注：这里应该是绿色车厢，多半是作者的笔误），\n虽说我觉得中奖率根本没她想的那么高——更准确说是觉得太浪费，\n连哄带骗给她买了普通票，\n仔细想想旅费又不用我出，\n或许该听她的才对。"],["我ながらケチな小市民であることよ。[l]\nこれがあと一ヶ月後だったりすると連休突入して、\n大変なことになったりするので、\n僕も迷わず宮さん案に乗っかるんだが。","连自己都觉得真是个小市民吝啬鬼。[l]\n要是这事晚一个月赶上连休开始的话，\n绝对会演变成大麻烦，\n到时候我肯定二话不说就采纳宫小姐的方案。"],["とりあえず今回は当たりで良かった。[l]\n宮さんと一緒に自分の席を探す。","总之这次能抽中真是太好了。[l]\n我和宫小姐一起寻找座位。"],["「ああ、ここですね。[l]\n窓側行きます？[l]\n僕はどっちでもいいですよ」","「啊，是这里呢。[l]\n您要坐靠窗位吗？[l]\n我坐哪边都行」"],["お手洗いが近い人にとっては通路側のが都合が好いわけだが、\nここでそれは聞けるはずもない。[l]\n宮さん自身の判断に委ねる。","对于容易上厕所的人来说靠过道的座位确实更方便，\n但这种话现在根本问不出口。[l]\n全权交给宫小姐自己决定。"],["「んむ、降りる駅までは２時間半くらいですか。[l]\nじゃ、宮窓側いきます。[l]\n寝ててもいいすよまこくん。[l]\nかあいい寝顔、じっくり見ててあげますから。うひひ」","「嗯～到站大概要两个半小时吧。[l]\n那我要靠窗位。[l]\n小真可以睡觉哦。[l]\n我会好好欣赏你可爱的睡脸的。嘻嘻」"],["「…ぁのねぇ、そんな事言って、宮さんこそ眠いでしょうよ。[l]\nどうぞどうぞ寝てて下さい。[l]\n駅着いたら起こしますから。[l]\n悪戯なんかしませんよ？　えへへ」","「……我说啊，讲这种话的宫小姐才更困吧。[l]\n请尽管睡没关系。[l]\n到站我会叫醒你的。[l]\n不会恶作剧啦？嘿嘿」"],["と適当な応酬を仕合いながら宮さんを先に座らせ、\n上着を脱ぎ、僕らの荷物を棚の上に置こうとしたが、\n宮さんは足下に置いた方が利便性があると言って\n僕の申し出を断った。[l]\n成る程、僕もそうしよう。[l]\n持ってきた暇潰し本は一冊じゃないし。","就这样随口应付着让宫小姐先入座，\n脱下外套正要把行李放到架子上，\n宫小姐却说放在脚边更方便\n拒绝了我的提议。[l]\n原来如此，那我也这么办吧。[l]\n毕竟带来的消遣读物也不止一本。"],["そして宮さん、早速そのバッグから何らかのモバイル機器を取り出す。[l]\n僕はデジタル系の知識に疎いのでよくわからない。[l]\nそういうのは大神の領域だ。[l]\n奴は見てくれが普通なだけで、\n趣味嗜好は完全にあっち側の人間なのだ。[l]\n学部はモロに情報系だし。","只见宫小姐立刻从包里掏出某种移动设备。[l]\n我对数码产品不太了解。[l]\n那是大神的专长领域。[l]\n那家伙虽然外表普通，\n兴趣爱好完全是那个世界的人。[l]\n专业也是纯正的信息系。"],["「宮さんそれ携帯ゲーム機？　ペン使うってやつ？」","「宫小姐那是掌机吗？用触控笔的那种？」"],["「違いますよ。[l]\nもう、恥ずかしいから騒がないで下さい。[l]\n読書です。[l]\n本のデータをダウンロードしてですね、\nたくさん持ち歩けるから良いですよ。[l]\n音楽も聴けますし」","「不是啦。[l]\n别嚷嚷，太丢人了。[l]\n是电子书阅读器。[l]\n可以下载书籍数据，\n能随身带很多本很方便哦。[l]\n还能听音乐」"],["バッテリー対策はしないといけませんが、\nと言いつつ、早速イヤホンをつける宮さん。","不过得注意电量问题，\n说着宫小姐立刻戴上了耳机。"],["「あー、僕は完全に読書はアナログ派というか\n現物至上主義ですな。[l]\nテンポが全てですから僕の場合」","「啊——我完全属于读书界的模拟派（译注：此处的模拟是指正与数字化的digital相反的analog）\n或者说实体书至上主义者。[l]\n毕竟阅读节奏对我来说就是一切」"],["テンポと言っても、話の筋とかの事ではなくて、\n読む行為のテンポが大事、という事だ。","虽说节奏，倒不是指剧情展开，\n而是翻页的节奏感很重要。"],["今回の事で飯窪本家の書痴振りに呆れた僕ではあるが、\n結局のところ僕自身もその影響下にある事は否めない。[l]\nつまりは本好きなのだ。","虽然这次被饭洼本家的书痴程度惊到，\n但不得不承认我自己也深受影响。[l]\n说白了就是喜欢书。"],["本は良い。","书真好。"],["単純な知識欲だけでなく、\n物にもよるが、割と安価に物欲をも満たせるのが、尚良しと思う。[l]\n本棚が埋まっていく様、というのは非常に心地よい。","不仅能满足求知欲，\n某些书还能以相对低廉的价格连物欲也一并满足，这就更好了。[l]\n看着书架逐渐填满的感觉实在美妙。"],["今やどっぷりデジタルの時代にあって、\nまさに今の宮さんのように小説やらなにやらまで、\nＰＣ上で読めたりする訳だが、\n僕にとって本の優位性はまるで揺るがない。","虽说现在已是数字化的时代，\n像宫小姐这样连小说什么的\n都能在电脑上阅读，\n但书本对我的优势依然毫不动摇。"],["デジタル上で読む文章というのは、\nスクロールにしたってクリックにしたって、\nページ単位で文章全体を画像として読む、という\n速読に近い読み方をする僕にとっては\n自分のペースで読めないだけストレスがたまる代物だ。","在电子设备上阅读时，\n无论是滚动页面还是点击翻页，\n对于我这种习惯把整页文字当作一幅图像来读、\n近乎速读方式的人来说，\n无法按自己节奏阅读只会积累压力。"],["あとは「本」というモノの、\n性とか象徴、存在が好きなんだろうな。[l]\nつまり、小説だとか、内容が好きなのとはちょっと違う。[l]\nだから漫画だろうと、辞書だろうと、小説だろうと、あまり意味はなくて、実際僕の部屋の本棚には玉石混淆、…言葉の意味はちょっと違う気がするが、それこそ読みもしない本、コレクターとしての意味合いのみで購入した本があったりするわけで。[l]\nその辺りの感性はもしかすると本家の血かも知れないな。","还有就是喜欢「书」这个物体\n本身的属性啊象征意义啊存在感之类的吧。[l]\n这和喜欢小说内容什么的有点不同。[l]\n所以漫画也好辞典也好小说也罢，其实区别不大，我房间书架上确实良莠不齐…虽然成语用得不太准确，有些书根本不会看，纯粹是作为收藏品买的。[l]\n这种审美搞不好是本家血脉使然。"],["また、ランダムアクセス性とかは勿論その他色々、\nいくらでもデジタル本に対する優位性は上げられると思う。[l]\nまともに状態良好を保とうと思ったら、\n相当気を遣わなければならない点が難点ではあるが、\n僕はあまりそういった事は気にしないので問題無しだ。[l]\nそう、面倒なことは嫌いなのだ。あはは。[l]\n血気盛んな頃はこだわって、\nそれこそ保存用なぞと称して複数冊買っていた頃もあったが、\n今やこの有様。","而且，不用说随机读取性之类的优势，其他方面也一样，\n我觉得纸质书相比电子书的优势能举出一大堆。[l]\n虽说如果想好好保持书本的良好状态，\n就必须格外费心，这一点确实是缺点，\n不过我基本不在意这些所以没问题。[l]\n没错，我讨厌麻烦事。啊哈哈。[l]\n血气方刚的时候还挺讲究，\n甚至有过号称收藏用买好几本的时候，\n如今却成了这副德性。"],["ぶっちゃけゼニカネの問題という現実にぶち当たったから。[l]\n今でこそ、バイトでそれなりに使える金は増えた訳だが、\n一端こだわりを無くしてみると案外それでもいけることが\n分かってしまったので、もうお気楽なものだ。[l]\n『読まない本』は未だ買ったりもするけど。","说白了就是撞上了金钱问题的现实。[l]\n现在靠打工总算有了些可支配的钱，\n但一旦放下执着后发现意外地也能凑合，\n所以现在就很随性了。[l]\n『不看的书』偶尔还是会买啦。"],["ちなみに今日持ってきてる本は、昨日買った雑学系文庫本で、\nそれこそ、いつでも且つどこからでも読める本をセレクトした。[l]\nのめり込む内容のだと疲れたり、集中しすぎて乗り過ごすし、\nあまりにどうでもいいと読まずに寝てしまう。[l]\nそのバランスを考慮すると、丁度良い本というのも割と見つからないので、毎度遠出するときの本探しは苦労するのだ。","顺便一提今天带的书是昨天买的杂学类文库本，\n特意选了这种随时随地都能读的书。[l]\n内容太投入的话会累，太专注又容易坐过站，\n太无聊的话就直接睡着不看了。[l]\n考虑到这种平衡性，恰到好处的书其实挺难找的，每次出远门找书都很费劲。"],["にしても、宮さんも古書肆を名乗る割に結構デジタル使いなんだよな…[l]\nむしろ僕より本という現物にこだわってるかと思っていたのだが。[l]\n大神が特殊な例かと思ってたけど、\n実は単に僕がアナログかつアナクロなのか。","话说宫小姐虽然自称旧书店，倒是挺会用数字设备的啊…[l]\n不如说我还以为她比我对实体书更执着呢。[l]\n原以为是大神比较特殊，\n其实单纯是我太模拟怀旧了吗。"],["「あ、見ます？[l]\n一応データ放り込んできたんですが、\nこれが玄ノ森の祭の画像ですよ。[l]\nデジカムで撮った動画もありますが、\nどっちも下界の方のだからあまり意味はないですけどね。[l]\n知狡の旅館がこれで…」","「啊，要看吗？[l]\n我姑且存了些数据，\n这是玄之森祭典的照片哦。[l]\n还有数码像机拍的视频，\n不过都是下界那边的所以意义不大啦。[l]\n知狡的旅馆是长这样的…」"],["言って、宮さんがその機械に画像を表示させて僕に示した。[l]\n今は動画も静止画も音楽もこんな小さい機械一つで視聴できるんだな…[l]\n大したもんだわ…","说着，宫小姐在那个机器上调出图片给我看。[l]\n现在连视频照片音乐都能用这么个小机器看了啊…[l]\n真厉害啊…"],["見せられた画像は昼の風景で、\n河川敷にびっしり出店やなにやらと、\n提灯のようなものがずらーっと飾り付けられており、\n祭というよりは何かの大会みたいに見える気もする。[l]\n…いや改めて、全く記憶にないな。[l]\n宮さん曰く、桜は時期的にぎりぎり咲いてるか否かのあたりで、\n年によってまちまちらしい。[l]\n写真ではよく分からなかったが、咲いてる年は、\nそれは綺麗なロケーションとなるらしい。","展示的图片是白天的景象，\n河滩上密密麻麻排满摊贩什么的，\n灯笼之类的装饰物挂得满满当当，\n与其说是祭典更像是什么大会的感觉。[l]\n…果然完全没印象。[l]\n据宫小姐说，樱花根据年份不同，\n在这个时期也有可能勉强还开着。[l]\n照片上看不太清，但开花的年份，\n据说会形成非常漂亮的景致。"],["「下界で行われる祭自体は、普通なんです。[l]\nただ、時期が春先なので、みんなが思ってるのとは毛色は違うかもですね。[l]\nま、昼間は町中御輿パレードで、夜は出店が、ああ、神社じゃなくて河川敷になんですけどね。知狡の旅館の近くの。[l]\nという感じです。夜は花火もやるはずですよ」","「下界举办的祭典本身很普通。[l]\n不过因为是初春时节，可能和大家想象的氛围不太一样。[l]\n白天是镇上的神轿巡游，晚上会有摊贩，啊对了不是在神社是在河滩啦。就在知狡旅馆附近。[l]\n大概就是这样。晚上应该还会放烟花」"],["北では運動会が春にあるのだが、\nそれはほとんどの家が農家の為に、秋は稲刈りで忙しく、\n親が参加できないからだと聞いたことがある。[l]\nが、こういう祭を春にするのは確かに珍しいかもだ。[l]\n格別日本中の祭に詳しい訳ではないから何とも言えないけど。[l]\nふーん出店なんか、え？[l]\n夜の河川敷ってかなり寒いんじゃないか？","北方倒是春天办运动会，\n听说因为大多人家务农，秋天要忙着收稻子，\n家长没法参加才这样的。[l]\n但春天办这种祭典确实挺少见。[l]\n当然我对全国祭典也没多了解就是了。[l]\n嗯～摊贩啊，欸？[l]\n晚上河滩不会超冷吗？"],["「本来的な意味でのメインは秘事である神事ですから、\nどうでもいいんでしょうけど、\n今はその寒い中でたこ焼きとか焼きそばとか食べるの、\n逆にみんな堪能してるみたいですねー。[l]\n冬におでん屋台みたいな？[l]\n雰囲気としては元旦に近いかも」","「从原本的意义来说，核心是作为秘事的神事，\n所以（山下的祭典）可能无关紧要，\n但现在大家反而更享受在寒冷中吃章鱼烧、炒面之类的，\n看起来都乐在其中呢—[l]\n就像冬天里的关东煮摊那种感觉？[l]\n氛围上更接近元旦吧」"],["外で食べるカップラーメンは旨いって奴か。[l]\nまあ風流ではあるんだろうな…","这就是所谓在户外吃的杯面特别香吧。[l]\n倒也确实挺风雅的…"],["「知狡の旅館も賑わうですよ。[l]\n関西からも固定客いるらしいんですが。[l]\n河川敷目の前ですし、部屋から花火見えまくり、\nベストポジションですね。[l]\n今回は…宮達は見られませんけどね」","「知狡的旅馆也会很热闹哦。[l]\n听说就连关西那边都有固定的客人呢。[l]\n正对着河滩，从房间里能尽情观赏烟花，\n绝佳观景位呢。[l]\n只不过这次…我们是看不到了」"],["そう、かなりの確率で、僕らは山の中でスパイ行為中の\nはずである。[l]\n出店が寒いとか関係なかったな。[l]\nそれどころか夜の山中て。[l]\n…おーい、どうなるんだぁ。","没错，按理说我们大概率正在山里\n执行间谍行动。[l]\n摊位的寒冷根本不算什么。[l]\n不如说深夜的山里才要命。[l]\n…喂喂，这到底是要怎样啊。"],["「夏場のほうが余程きついですよ。[l]\n蚊とか虫がすごいし、あの辺て蝮いっぱいいますし、\n生命蠢く季節に山の中なんて行きたくないです」","「夏天进山反而更难受。[l]\n蚊虫肆虐，那边还到处都是蝮蛇，\n万物躁动的季节谁想往山里钻啊」"],["植生も生物分布も中央とは全然違うし、\n地味ーに嫌な虫だらけですよ。[l]\nと、言う宮さん。","植被和生物分布都和中央地区完全不同，\n还净是些土里土气讨人厌的虫子呢。[l]\n这么说着的宫小姐。"],["そういや北の東側の夏て、湿度も高いんだっけ。[l]\n梅雨が明けない時もあるし…[l]\nとんと忘れてるなあ、というか子供の頃はそんな事\n分からないし気にしないし。[l]\n結局、寒い方がまだマシのようだ。[l]\nく、熊とか大丈夫だろうな。","说起来北边的东侧夏天，湿度也很高来着。[l]\n有时候连梅雨季都过不完…[l]\n完全忘记了呢，或者说小时候根本\n不懂这些也不会在意。[l]\n说到底，还是寒冷更让人能忍受些。[l]\n熊、熊之类的应该没问题吧。"],["それから二人とも自分の読書に没頭した。","之后两个人都埋头看起了自己的书。"],["およそ道程の半分くらいに至って、\n周りの客が弁当を開け始め、\n匂いが食欲を刺激する。[l]\nそういえば、僕らは弁当買ってなかったのだった。","大约行进到路程一半时，\n周围乘客开始打开便当，\n香味刺激着食欲。[l]\n说起来我们没买便当呢。"],["「宮さん、何かお昼的なもの食べません？[l]\n車内販売来ますよ」","「宫小姐，要不要吃点午饭什么的？[l]\n车上贩卖要过来了哦」"],["「ええ～？[l]\n宮は向こう着くまで我慢しますよ？[l]\n知狡のとこにはご飯時に着きますし。[l]\n折角、久しぶりに美味しいご飯を食べられるのに、\nもったいないなぁまこくん～」","「诶～？[l]\n宫要忍到那边再吃哦？[l]\n到知狡那儿正好是饭点。[l]\n难得隔这么久能吃到美味饭菜，\n太浪费啦真～」"],["なんだ、わざと買ってなかったのな。[l]\nしかしゴゴイチのカレーで満足してる人から言われても…[l]\nとはいえ、宮さんのいう事も尤もだったし、\n朝に軽く食べてもいるし我慢できない程じゃない。[l]\n最悪、寝てやり過ごすかだ。","搞什么嘛，原来是故意没买啊。[l]\n不过被在五五壹吃咖喱就满足的人这么说…[l]\n不过宫小姐说得也确实在理，\n早上也稍微吃了点东西，倒不至于饿到忍不住。[l]\n大不了睡一觉熬过去呗。"],["「っかりましたよ。[l]\n飴でも舐めてます」","「上当啦。[l]\n我在吃糖哦」"],["「あっ宮にも下さいよ。[l]\n…ハッカじゃないですよね？」","「啊，也给宫一颗呀。[l]\n…不是薄荷味的吧？」"],["「ハッカ？[l]\nなんですハッカって」","「薄荷？[l]\n薄荷是什么东西啊」"],["「んむあ？！[l]\nハッカはハッカですよ！？[l]\n知らない？　通じない？[l]\n白くてすーすーするだけのっ！[l]\n甘くも何ともないっっ！！」","「嗯唔啊？！[l]\n薄荷就是薄荷啊！？[l]\n不知道？听不懂？[l]\n就是白白的那种凉飕飕的东西！[l]\n既不甜也没别的味道！！」"],["その後、数分に渡り説明を受けようやく理解。[l]\nああ、要するにミントね。[l]\n昔母さんとかが言ってた気がするよ。[l]\nこうなると、僕がアナクロかどうかも分からなくなってくるのだが、\nそれより飴＝ハッカ入りという発想自体が…[l]\n宮さん……","随后经过几分钟的解释终于理解了。[l]\n啊，说白了就是薄荷糖嘛。[l]\n隐约记得以前老妈他们也提过。[l]\n这么一来连我算不算落伍都搞不清了，\n不过比起这个，糖果=含薄荷的想法本身...[l]\n宫小姐......"],["あれかなあ、ガムって言えば梅、それも板ガムみたいな世代じゃないだろうな…[l]\nさておき持ってた飴はビタミン系レモン味のだったので、\n宮さんも無難に受け入れてくれた。[l]\nなんか疲れた、精神的に。[l]\n逆に空腹になったらどうしようか、全く…","该不会是那种一提到口香糖就想到梅子味、还是板状口香糖的年代吧…[l]\n话说回来带的糖是维生素系的柠檬味，\n宫小姐也没什么意见地收下了。[l]\n总觉得心好累。[l]\n反而要是饿肚子了可怎么办啊，真是…"],["さて、そんなこんながあり、\nしばらくまた二人は各々読書に没入。[l]\nともあれあと一時間くらいなんだが。[l]\nどうしようかなあ、眠いなあ。[l]\nいや、しかし宮さんに見られるのもなー…[l]\nと横を見ると、","总之经过这些事，\n两人又各自埋头看了会儿书。[l]\n反正还剩一小时左右。[l]\n怎么办好呢，好困啊。[l]\n不行，被宫小姐看到的话也太…[l]\n往旁边一瞥，"],["@l","@l"],["「………すー[l]\n………すー」","「………呼——[l]\n………呼——」"],["お、おお。[l]\nおおお。","哦、哦哦。[l]\n哦哦哦。"],["寝てる、宮さん。[l]\nつーか、\nよだ、よだれ出てる！[l]\nこれは…どうしたらいいんだ？[l]\nやばいこのままでは服に垂れるがな！","睡着了，宫小姐。[l]\n话说，\n流、流口水了！[l]\n这…该怎么办？[l]\n糟了这样下去会滴到衣服上的！"],["起こして注意すれば良いのか？[l]\nそれとも見て見ぬ振りが良いのか？[l]\nはたまた黙って拭いてあげるべきなのか？","该叫醒她提醒一下吗？[l]\n还是装作没看见比较好？[l]\n又或者该默默帮她擦掉？"],["いかな年齢不詳の宮さんとはいえ、\n相手は女性だ。[l]\n行動選択に迷いもする。[l]\n大神がようやるゲームならば、\nまさに好感度変動選択肢出現とでもいうべき場面であろう。","虽说宫小姐年龄成谜，\n但毕竟是女性。[l]\n行动选择令人犹豫。[l]\n要是大神常玩的那种游戏，\n现在就是该出现好感度变动选项的场面了吧。"],["いや、別に好感度あげようというつもりはないが、\nだからといって、わざわざ下げるつもりもない。[l]\nまず写真撮ったろうかとも思わないでもなかったが、\nここはぐっと堪えて、ティッシュを準備だ。[l]\n汚れ防止を優先させよう。[l]\nあとは起きればどうにかなろう。","不，我倒没想特意提升好感度，\n但也不是说，就故意要去降低它。[l]\n说实话，我甚至也闪过要不先拍张照的念头，\n但还是强忍住，掏出了纸巾。[l]\n还是先以防止弄脏为优先吧。[l]\n至于其他的，等她醒了再说吧。"],["ティッシュを片手に、宮さんの口許へいつでもフォロー出来るようにしつつ、宮さんの肩を揺する。","一手拿着纸巾随时准备接住，同时轻晃宫小姐的肩膀。"],["「…み、宮さん？[l]\n宮さん？[l]\n大丈夫？　起きてくださーい？」","「…宫、宫小姐？[l]\n宫小姐？[l]\n没事吧？请醒醒——？」"],["「……んむぅ？[l]\nんあ？」","「……嗯唔？[l]\n嗯啊？」"],["目が合った。[l]\n…ん？[l]\n僕らのこの体勢は、\n顔も近づいて、\nちょっとあれか？[l]\nイケナイ感じか？","对上了视线。[l]\n…嗯？[l]\n我们现在这个姿势，\n脸也靠得很近，\n该不会是那个？[l]\n像在做什么不可描述的事？"],["「やっ…！　ちょ、なに？[l]\nんんっ！」","「呀…！　等、干嘛？[l]\n嗯嗯！」"],["急に動き出した宮さん。[l]\nご、誤解です！[l]\nと言うより先に、僕の身体は涎を拭くほうを咄嗟に選んだらしい。[l]\n結果宮さんの口をふさぐ形になる。[l]\n何しろ周りに普通に他の客はいるのだ。[l]\n大声出されても困ってしまう。[l]\n僕自身も極力ボリュームを下げて、\nしかし圧は上げつつ囁いた。","宫小姐突然动起来。[l]\n误、误会！[l]\n话未出口身体已本能选择去擦口水。[l]\n结果变成捂住宫小姐的嘴。[l]\n毕竟周围还有其他普通顾客。[l]\n被大声叫喊就麻烦了。[l]\n我自己也尽量压低音量，\n但加强语气低声说："],["「しーっ！　しーっ！[l]\nは、はいこれ、ティッシュ！」","「嘘——！　嘘——！[l]\n给、给你，纸巾！」"],["折角ここまで気を遣ったのに、\n今更大声でよだれがどうとも言えず、\nとにかくティッシュをそのまま押しつけて、\n急いで身体を離した。[l]\n周りの客は特に反応しておらず、何とか乗り切れたようだ。[l]\nふー、あぶねえ…","明明小心翼翼到现在，\n事到如今也没法大声解释口水的事，\n总之直接把纸巾按上去，\n慌忙拉开距离。[l]\n周围顾客没什么反应，总算蒙混过关。[l]\n呼——，好险…"],["宮さんは寝起きでもあり、\n状況を把握するのに少々間が空いたが、\n何とか覚醒してくれたようだった。","宫小姐刚睡醒，\n花了一点时间才理解现状，\n最后总算是清醒过来了。"],["「あーもうびっくりしたよぉ、\n思い切ったことされるのかと思ったぁ…」","「啊——真是吓死我了，\n还以为你要对我做什么过火的事呢...」"],["「しませんて！[l]\nあ、まあ済みません、ちょっと事態が事態だと思ったので…[l]\n出過ぎた真似を…」","「才不会啦！[l]\n啊、那个抱歉，因为情况特殊就...[l]\n做了越界的事...」"],["いいですいいです、と言いながら身繕いをし\n居住まいを正す宮さんだが、\nしっかりとその呟きが僕の耳に入った。","好啦好啦，一边说着边整理衣衫\n端正坐姿的宫小姐，\n那声嘀咕却清晰地传进我耳朵。"],["「ちっ、\nまこくんに見られた…はずかしいところ…」","「切，\n被小真看到...丢脸的样子...」"],["僕が無理矢理有耶無耶にはしたものの、\n涎の件は自覚してるらしく、\nちょっと本気で恥ずかしそうな宮さん。[l]\n分かっております、見なかったことにしますよ。[l]\nその為にあんなに気ぃ遣ったんだしな。[l]\nこれでも僕ぁ女子には優しいつもりですよいつも。","虽然我强行把事情糊弄过去了，\n但她好像意识到流口水的事，\n宫小姐现在正羞得恨不得钻地缝呢。[l]\n我明白的，就当没看见好啦。[l]\n所以才那么小心翼翼地照顾她嘛。[l]\n别看我这样，对女孩子我可是一向很温柔的，。"],["結局宮さんはこの後決して寝なかったのだった。","结果宫小姐之后死活都不肯继续睡了。"],["あー、\nそれにしてもちょっとドキドキした。[l]\nすっかりドタバタしてしまったが、\n宮さんの寝顔も初めて見られたわけで。[l]\n無防備な彼女の寝顔はちょっとばかり、\n可愛く思えてしまった。[l]\nきっと先日の夢も後を引いてたのだろうが。[l]\n変に意識してしまった、いかんいかん。","啊——\n不过刚才确实有点心跳加速呢。[l]\n虽然闹得鸡飞狗跳的，\n但好歹第一次看到了宫小姐的睡颜。[l]\n她那毫无防备的睡脸，\n让我觉得有点可爱呢。[l]\n肯定是前几天那个梦的后遗症吧。[l]\n糟糕糟糕，越想越在意了。"],["精神的な疲弊よりも心拍数上昇のが上回ったのか、\n僕は眠くなることもなく、\n今回は宮さんに寝顔を見られずに済んだ。[l]\nそして。","比起精神疲劳，心跳加速的感觉更强烈，\n我完全睡不着，\n这次总算没让宫小姐看到我的睡相。[l]\n然后。"],["車内アナウンスが告げる次の停車駅、\n僕らが降りる駅だ。[l]\nとはいえあくまで新幹線を降りる駅、\nまだ先は長い。","车内广播播报着下一站停靠站名，\n我们要下车的站点。[l]\n不过说到底只是新干线的下车点，\n离目的地还远着呢。"],["「さーてぇ！[l]\n降りますよっ。[l]\n忘れ物ないですね？」","「好——嘞！[l]\n要下车咯。[l]\n没落下东西吧？」"],["メロディと共に再度アナウンスが鳴り―――","伴随着旋律广播再次响起——"],["到着。[l]\n僕らは荷物を持って、列車を降りた。[l]\n","到站。[l]\n我们拎着行李走下列车。[l]\n"]],"context":[["SC_S_000.ks/index/1/text"],["SC_S_000.ks/index/3/text"],["SC_S_000.ks/index/5/text"],["SC_S_000.ks/index/7/text"],["SC_S_000.ks/index/9/text"],["SC_S_000.ks/index/11/text"],["SC_S_000.ks/index/13/text"],["SC_S_000.ks/index/15/text"],["SC_S_000.ks/index/17/text"],["SC_S_000.ks/index/19/text"],["SC_S_000.ks/index/21/text"],["SC_S_000.ks/index/23/text"],["SC_S_000.ks/index/25/text"],["SC_S_000.ks/index/27/text"],["SC_S_000.ks/index/29/text"],["SC_S_000.ks/index/31/text"],["SC_S_000.ks/index/33/text"],["SC_S_000.ks/index/35/text"],["SC_S_000.ks/index/37/text"],["SC_S_000.ks/index/39/text"],["SC_S_000.ks/index/41/text"],["SC_S_000.ks/index/43/text"],["SC_S_000.ks/index/45/text"],["SC_S_000.ks/index/47/text"],["SC_S_000.ks/index/49/text"],["SC_S_000.ks/index/51/text"],["SC_S_000.ks/index/53/text"],["SC_S_000.ks/index/55/text"],["SC_S_000.ks/index/57/text"],["SC_S_000.ks/index/59/text"],["SC_S_000.ks/index/61/text"],["SC_S_000.ks/index/63/text"],["SC_S_000.ks/index/65/text"],["SC_S_000.ks/index/67/text"],["SC_S_000.ks/index/69/text"],["SC_S_000.ks/index/71/text"],["SC_S_000.ks/index/73/text"],["SC_S_000.ks/index/75/text"],["SC_S_000.ks/index/77/text"],["SC_S_000.ks/index/79/text"],["SC_S_000.ks/index/81/text"],["SC_S_000.ks/index/83/text"],["SC_S_000.ks/index/85/text"],["SC_S_000.ks/index/87/text"],["SC_S_000.ks/index/89/text"],["SC_S_000.ks/index/91/text"],["SC_S_000.ks/index/93/text"],["SC_S_000.ks/index/95/text"],["SC_S_000.ks/index/97/text"],["SC_S_000.ks/index/99/text"],["SC_S_000.ks/index/101/text"],["SC_S_000.ks/index/103/text"],["SC_S_000.ks/index/105/text"],["SC_S_000.ks/index/107/text"],["SC_S_000.ks/index/109/text"],["SC_S_000.ks/index/111/text"],["SC_S_000.ks/index/113/text"],["SC_S_000.ks/index/115/text"],["SC_S_000.ks/index/117/text"],["SC_S_000.ks/index/119/text"],["SC_S_000.ks/index/121/text"],["SC_S_000.ks/index/123/text"],["SC_S_000.ks/index/125/text"],["SC_S_000.ks/index/127/text"],["SC_S_000.ks/index/129/text"],["SC_S_000.ks/index/131/text"],["SC_S_000.ks/index/133/text"],["SC_S_000.ks/index/136/text"],["SC_S_000.ks/index/138/text"],["SC_S_000.ks/index/140/text"],["SC_S_000.ks/index/142/text"],["SC_S_000.ks/index/144/text"],["SC_S_000.ks/index/146/text"],["SC_S_000.ks/index/148/text"],["SC_S_000.ks/index/150/text"],["SC_S_000.ks/index/152/text"],["SC_S_000.ks/index/154/text"],["SC_S_000.ks/index/156/text"],["SC_S_000.ks/index/158/text"],["SC_S_000.ks/index/160/text"],["SC_S_000.ks/index/162/text"],["SC_S_000.ks/index/164/text"],["SC_S_000.ks/index/166/text"],["SC_S_000.ks/index/168/text"],["SC_S_000.ks/index/170/text"],["SC_S_000.ks/index/172/text"],["SC_S_000.ks/index/174/text"],["SC_S_000.ks/index/176/text"],["SC_S_000.ks/index/178/text"],["SC_S_000.ks/index/180/text"],["SC_S_000.ks/index/182/text"],["SC_S_000.ks/index/184/text"],["SC_S_000.ks/index/186/text"],["SC_S_000.ks/index/188/text"]],"tags":[],"parameters":[[{"start":93,"end":175}],[{"start":189,"end":384}],[{"start":398,"end":657}],[{"start":671,"end":788}],[{"start":802,"end":1002}],[{"start":1018,"end":1090}],[{"start":1106,"end":1296}],[{"start":1312,"end":1602}],[{"start":1618,"end":1744}],[{"start":1784,"end":2020}],[{"start":2034,"end":2191}],[{"start":2205,"end":2350}],[{"start":2364,"end":2517}],[{"start":2531,"end":2581}],[{"start":2597,"end":2678}],[{"start":2694,"end":2799}],[{"start":2844,"end":3038}],[{"start":3062,"end":3243}],[{"start":3257,"end":3482}],[{"start":3496,"end":3587}],[{"start":3603,"end":3643}],[{"start":3669,"end":3715}],[{"start":3731,"end":3800}],[{"start":3826,"end":3921}],[{"start":3947,"end":4041}],[{"start":4057,"end":4197}],[{"start":4213,"end":4363}],[{"start":4389,"end":4413}],[{"start":4439,"end":4551}],[{"start":4567,"end":4611}],[{"start":4637,"end":4696}],[{"start":4712,"end":4757}],[{"start":4773,"end":4847}],[{"start":4863,"end":4868}],[{"start":4884,"end":4963}],[{"start":4979,"end":5069}],[{"start":5085,"end":5205}],[{"start":5221,"end":5446}],[{"start":5462,"end":5695}],[{"start":5709,"end":5855}],[{"start":5869,"end":6055}],[{"start":6071,"end":6190}],[{"start":6216,"end":6343}],[{"start":6359,"end":6442}],[{"start":6458,"end":6685}],[{"start":6711,"end":6863}],[{"start":6879,"end":7065}],[{"start":7091,"end":7231}],[{"start":7247,"end":7289}],[{"start":7315,"end":7427}],[{"start":7443,"end":7543}],[{"start":7569,"end":7644}],[{"start":7660,"end":7713}],[{"start":7729,"end":7866}],[{"start":7882,"end":7901}],[{"start":7917,"end":7998}],[{"start":8024,"end":8060}],[{"start":8086,"end":8190}],[{"start":8206,"end":8334}],[{"start":8360,"end":8386}],[{"start":8412,"end":8445}],[{"start":8471,"end":8494}],[{"start":8520,"end":8608}],[{"start":8624,"end":8767}],[{"start":8781,"end":8919}],[{"start":8972,"end":9096}],[{"start":9180,"end":9180}],[{"start":9257,"end":9277}],[{"start":9293,"end":9310}],[{"start":9326,"end":9408}],[{"start":9424,"end":9489}],[{"start":9505,"end":9606}],[{"start":9620,"end":9770}],[{"start":9786,"end":9831}],[{"start":9857,"end":9900}],[{"start":9926,"end":9945}],[{"start":9978,"end":10053}],[{"start":10079,"end":10104}],[{"start":10120,"end":10298}],[{"start":10324,"end":10356}],[{"start":10372,"end":10499}],[{"start":10513,"end":10569}],[{"start":10595,"end":10633}],[{"start":10659,"end":10718}],[{"start":10734,"end":10795}],[{"start":10821,"end":10850}],[{"start":10866,"end":11012}],[{"start":11028,"end":11050}],[{"start":11066,"end":11234}],[{"start":11250,"end":11326}],[{"start":11379,"end":11447}],[{"start":11473,"end":11512}],[{"start":11528,"end":11548}],[{"start":11560,"end":11592}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_000.ks","basename":"SC_S_000.ks","indexIds":{"五日も間が空けば、\nそれなりに気持ちに整理もついて、\n今では、僕はむしろ何かしらの重圧から逃れたような\n爽快と言ってもいい気分となっていた。":0,"面倒なことは大嫌いな上に眠ると忘れる質、というのも\n助けになったのだろう。[l]\n勿論かつて暮らした田舎への帰郷、ということもあるが、\nそもそも僕は都会よりは田舎の方が好きなのだ。[l]\nそれは大学に一年いて、出来た友人が大神ただ一人、\nしかも学部ではなくサークルで、\nという事からもわかるように、\n僕はやや対人関係が苦手なのである。":1,"田舎は田舎で、土着というか、\n人が少ないが故に出来上がる、\nしがらみめいた人間関係もあるわけだが、\n僕のは単純に人混みが嫌いというのもあって\n（コンパだのが大嫌いだった）、\n何かと一人で田舎の方を旅するのが好きなのだった。[l]\n宮さんの所でのバイトが有る程度たまると連休などを選んで、\nよく近場ならドライブ、遠方なら新幹線で泊まりがけ、\nというのをこの一年はしたものだ。[l]\nそれでも何故か玄ノ森には行かなかったな、\n今にして思えば。":2,"で、大神といえば。[l]\nこっちの準備は割と早くすんだので、\n宮さん達の方を手伝ったりしたのだが、\n大神と、戻ってからじゃなく今飲むか、という話になった時、\nまだ滞在していたかれお嬢も一緒に誘ったのだ。":3,"そうしたら二人はえらい勢いで意気投合し、\n僕もまだ気持ちが不安定な時だったので、\nいつも以上に飲みが進んであんまり記憶がないのだが、\nお二方には何かしらの関係が生まれたようだった。[l]\nただ、覚えてる限りの記憶では、\n愛情というよりは友情が生まれた感じだったけど。[l]\nまあ、温かく見守らせてもらうよ。[l]\nそんな余裕が僕にあればだがな。":4,"ちなみにかれお嬢は、その後すぐに例の所用とやらで\n出立したらしい。[l]\n見送りは出来なかった。大神の去就は知るところではない。":5,"その飲みの席で知ったことだが、某日宮さんの所に来たとき、\n彼女は携帯電話を持ってなかったのだそうだ。[l]\nだから来訪も急だったようで、宮さんに掛かってきた謎の番号は、\nそこいらの人に借りたり、店に入ったりして掛けてきたものだった。[l]\n番号変えたとかいうレベルじゃなかった、ということで、\nあとで宮さんに教えたら、また憤慨しておられた。":6,"といった事情で二人は携帯番号の交換も\nままならなかったようだが、\n僕が出発直前に大神に連絡したところ、\n奴も思ったよりサバサバしていたので、\n何らかの交信手段は得たのかも知れなかった。[l]\nいずれそろそろ学校も始まるし、大神も案外余裕がないのか、\n或いは単なるバカなのか。[l]\nそれとも女子にはがっつくほど餓えてもないのか。[l]\n僕も宮さんの御陰で、女性との交流自体に躍起になる事はないが、\nそうは言ってもお付き合いするような女子とは出会いたい。[l]\nというのは勿論なので、少々奴が羨ましい。":7,"ま、大神よ、読めない奴で面白かったが、これでしばしのお別れだ。[l]\nたった一年の付き合いだったが楽しかったよ。[l]\n縁があったらまた会おう。[l]\n無ければそれまで。惜しい縁でも無し。[l]\n後腐れ無く忘れ合おうや。":8,"さて、今日は朝から待ち合わせて、\n私鉄の駅に行くと、宮さんは余所行きの姿で一人で先に来ていた。[l]\nむう、なんかイメージが違うな。[l]\nさすが女子、化けますなぁ。[l]\nあれ、というか一人なのか。[l]\n店、禅さんに任せたと言っていたが、見送りにも来ないんだな…。[l]\n待たせて済みません、と謝りながら早速僕らは改札へ。[l]\nそこから中央の駅へ向かい、\n新幹線で飯窪本家のある北の田舎へと、出発する。":9,"中央の駅についた時点で、時間的には予定通り。[l]\n宮さんはタバコの煙が大嫌いだったので、\n禁煙席の指定券を前日に購入してある。[l]\n指定席なのでずっとホームで並ぶ必要もなく、\n幸いダイヤの乱れも無いようだしと、\n僕と宮さんは発車時刻まで、駅構内の飲食店にて時間を潰した。":10,"ぶっちゃけ（おそらく僕だけでなく二人とも）眠かったのだが、\n旅への高揚感か、今のところテンションは保っている。[l]\n乗ってしまえばさっくり寝そうだがそれはそれだ。[l]\n別に寝ちゃいけない訳でもない。[l]\nただ、宮さんに寝顔見られるのに抵抗があるだけだ。":11,"過去一度だけバイト中に寝落ちてしまい、\nかなり弄られたことがあった故である。[l]\nそれまで全く自覚が無かったのだが、\n僕は目を開いたまま寝る系の人らしい。[l]\n寝言をハキハキ喋るというのは昔から言われてたんだが、\n目の件は初めて知らされて、かなりショックだった。":12,"しかーし、\n今日は宮さんも寝そうだから、逆に寝顔を見てやるくらいの\n気概でいきたい。":13,"知狡さん達に中央の土産も買って行こうとしたのだが、\nきちんとめの売店がまだ開いておらず、\nホーム売店の有り体な菓子を買わざるを得なかったのが残念。":14,"発車時刻になり、ホームにアナウンスが流れる。[l]\n二階建ての新幹線が入ってきた。[l]\nこの車両、一階席の目線はあまりに悲しいと思ってるのだが、\n今日は二階席なのでちょっとだけ嬉しい。":15,"たまたまかも知れないが、\n周りは上品そうな老人が大半で、\n子供連れは勿論、酒臭いおっさんどもは居なかった。[l]\nグリーン車ではよく見る光景だが、普通車両ではあまり経験がない。[l]\n…よく見るったってそんなに回数乗ってませんがね！[l]\nグリーンなんて！[l]\nまあ、平日昼間だから当然と言えば当然だが、\nハズレに当たるとまさに、":16,"「まこくんはお休みの日にしか新幹線に乗ったこと\nないですか？[l]\n平日はですねえ、\nサラリーマンが酒とつまみを食しながらくだを巻く、\nそれはもう宮の嗅覚視覚聴覚にとっては害悪以外の何者でもない\n三重苦の箱と化すのです。[l]\nありえないす。ありえないすよ！[l]\nんむ～、想像するだに身の毛のよだつっ！」":17,"と、宮さんが半泣きになって力説する状況になってげっそりする訳である。[l]\nそういえば、最初はしきりにグリーンに乗りたがってたなあ。[l]\n宮さんは今までほとんど普通車両に乗ったことがないというから、\nそんなに高確率であたらねえよと思って、というより単にもったいなかったので、\nなだめすかして普通のを買ったのだが、\nよくよく考えれば、旅費は僕持ちじゃなかったのだし、\n宮さんの聞いてやれば良かったかも。":18,"我ながらケチな小市民であることよ。[l]\nこれがあと一ヶ月後だったりすると連休突入して、\n大変なことになったりするので、\n僕も迷わず宮さん案に乗っかるんだが。":19,"とりあえず今回は当たりで良かった。[l]\n宮さんと一緒に自分の席を探す。":20,"「ああ、ここですね。[l]\n窓側行きます？[l]\n僕はどっちでもいいですよ」":21,"お手洗いが近い人にとっては通路側のが都合が好いわけだが、\nここでそれは聞けるはずもない。[l]\n宮さん自身の判断に委ねる。":22,"「んむ、降りる駅までは２時間半くらいですか。[l]\nじゃ、宮窓側いきます。[l]\n寝ててもいいすよまこくん。[l]\nかあいい寝顔、じっくり見ててあげますから。うひひ」":23,"「…ぁのねぇ、そんな事言って、宮さんこそ眠いでしょうよ。[l]\nどうぞどうぞ寝てて下さい。[l]\n駅着いたら起こしますから。[l]\n悪戯なんかしませんよ？　えへへ」":24,"と適当な応酬を仕合いながら宮さんを先に座らせ、\n上着を脱ぎ、僕らの荷物を棚の上に置こうとしたが、\n宮さんは足下に置いた方が利便性があると言って\n僕の申し出を断った。[l]\n成る程、僕もそうしよう。[l]\n持ってきた暇潰し本は一冊じゃないし。":25,"そして宮さん、早速そのバッグから何らかのモバイル機器を取り出す。[l]\n僕はデジタル系の知識に疎いのでよくわからない。[l]\nそういうのは大神の領域だ。[l]\n奴は見てくれが普通なだけで、\n趣味嗜好は完全にあっち側の人間なのだ。[l]\n学部はモロに情報系だし。":26,"「宮さんそれ携帯ゲーム機？　ペン使うってやつ？」":27,"「違いますよ。[l]\nもう、恥ずかしいから騒がないで下さい。[l]\n読書です。[l]\n本のデータをダウンロードしてですね、\nたくさん持ち歩けるから良いですよ。[l]\n音楽も聴けますし」":28,"バッテリー対策はしないといけませんが、\nと言いつつ、早速イヤホンをつける宮さん。":29,"「あー、僕は完全に読書はアナログ派というか\n現物至上主義ですな。[l]\nテンポが全てですから僕の場合」":30,"テンポと言っても、話の筋とかの事ではなくて、\n読む行為のテンポが大事、という事だ。":31,"今回の事で飯窪本家の書痴振りに呆れた僕ではあるが、\n結局のところ僕自身もその影響下にある事は否めない。[l]\nつまりは本好きなのだ。":32,"本は良い。":33,"単純な知識欲だけでなく、\n物にもよるが、割と安価に物欲をも満たせるのが、尚良しと思う。[l]\n本棚が埋まっていく様、というのは非常に心地よい。":34,"今やどっぷりデジタルの時代にあって、\nまさに今の宮さんのように小説やらなにやらまで、\nＰＣ上で読めたりする訳だが、\n僕にとって本の優位性はまるで揺るがない。":35,"デジタル上で読む文章というのは、\nスクロールにしたってクリックにしたって、\nページ単位で文章全体を画像として読む、という\n速読に近い読み方をする僕にとっては\n自分のペースで読めないだけストレスがたまる代物だ。":36,"あとは「本」というモノの、\n性とか象徴、存在が好きなんだろうな。[l]\nつまり、小説だとか、内容が好きなのとはちょっと違う。[l]\nだから漫画だろうと、辞書だろうと、小説だろうと、あまり意味はなくて、実際僕の部屋の本棚には玉石混淆、…言葉の意味はちょっと違う気がするが、それこそ読みもしない本、コレクターとしての意味合いのみで購入した本があったりするわけで。[l]\nその辺りの感性はもしかすると本家の血かも知れないな。":37,"また、ランダムアクセス性とかは勿論その他色々、\nいくらでもデジタル本に対する優位性は上げられると思う。[l]\nまともに状態良好を保とうと思ったら、\n相当気を遣わなければならない点が難点ではあるが、\n僕はあまりそういった事は気にしないので問題無しだ。[l]\nそう、面倒なことは嫌いなのだ。あはは。[l]\n血気盛んな頃はこだわって、\nそれこそ保存用なぞと称して複数冊買っていた頃もあったが、\n今やこの有様。":38,"ぶっちゃけゼニカネの問題という現実にぶち当たったから。[l]\n今でこそ、バイトでそれなりに使える金は増えた訳だが、\n一端こだわりを無くしてみると案外それでもいけることが\n分かってしまったので、もうお気楽なものだ。[l]\n『読まない本』は未だ買ったりもするけど。":39,"ちなみに今日持ってきてる本は、昨日買った雑学系文庫本で、\nそれこそ、いつでも且つどこからでも読める本をセレクトした。[l]\nのめり込む内容のだと疲れたり、集中しすぎて乗り過ごすし、\nあまりにどうでもいいと読まずに寝てしまう。[l]\nそのバランスを考慮すると、丁度良い本というのも割と見つからないので、毎度遠出するときの本探しは苦労するのだ。":40,"にしても、宮さんも古書肆を名乗る割に結構デジタル使いなんだよな…[l]\nむしろ僕より本という現物にこだわってるかと思っていたのだが。[l]\n大神が特殊な例かと思ってたけど、\n実は単に僕がアナログかつアナクロなのか。":41,"「あ、見ます？[l]\n一応データ放り込んできたんですが、\nこれが玄ノ森の祭の画像ですよ。[l]\nデジカムで撮った動画もありますが、\nどっちも下界の方のだからあまり意味はないですけどね。[l]\n知狡の旅館がこれで…」":42,"言って、宮さんがその機械に画像を表示させて僕に示した。[l]\n今は動画も静止画も音楽もこんな小さい機械一つで視聴できるんだな…[l]\n大したもんだわ…":43,"見せられた画像は昼の風景で、\n河川敷にびっしり出店やなにやらと、\n提灯のようなものがずらーっと飾り付けられており、\n祭というよりは何かの大会みたいに見える気もする。[l]\n…いや改めて、全く記憶にないな。[l]\n宮さん曰く、桜は時期的にぎりぎり咲いてるか否かのあたりで、\n年によってまちまちらしい。[l]\n写真ではよく分からなかったが、咲いてる年は、\nそれは綺麗なロケーションとなるらしい。":44,"「下界で行われる祭自体は、普通なんです。[l]\nただ、時期が春先なので、みんなが思ってるのとは毛色は違うかもですね。[l]\nま、昼間は町中御輿パレードで、夜は出店が、ああ、神社じゃなくて河川敷になんですけどね。知狡の旅館の近くの。[l]\nという感じです。夜は花火もやるはずですよ」":45,"北では運動会が春にあるのだが、\nそれはほとんどの家が農家の為に、秋は稲刈りで忙しく、\n親が参加できないからだと聞いたことがある。[l]\nが、こういう祭を春にするのは確かに珍しいかもだ。[l]\n格別日本中の祭に詳しい訳ではないから何とも言えないけど。[l]\nふーん出店なんか、え？[l]\n夜の河川敷ってかなり寒いんじゃないか？":46,"「本来的な意味でのメインは秘事である神事ですから、\nどうでもいいんでしょうけど、\n今はその寒い中でたこ焼きとか焼きそばとか食べるの、\n逆にみんな堪能してるみたいですねー。[l]\n冬におでん屋台みたいな？[l]\n雰囲気としては元旦に近いかも」":47,"外で食べるカップラーメンは旨いって奴か。[l]\nまあ風流ではあるんだろうな…":48,"「知狡の旅館も賑わうですよ。[l]\n関西からも固定客いるらしいんですが。[l]\n河川敷目の前ですし、部屋から花火見えまくり、\nベストポジションですね。[l]\n今回は…宮達は見られませんけどね」":49,"そう、かなりの確率で、僕らは山の中でスパイ行為中の\nはずである。[l]\n出店が寒いとか関係なかったな。[l]\nそれどころか夜の山中て。[l]\n…おーい、どうなるんだぁ。":50,"「夏場のほうが余程きついですよ。[l]\n蚊とか虫がすごいし、あの辺て蝮いっぱいいますし、\n生命蠢く季節に山の中なんて行きたくないです」":51,"植生も生物分布も中央とは全然違うし、\n地味ーに嫌な虫だらけですよ。[l]\nと、言う宮さん。":52,"そういや北の東側の夏て、湿度も高いんだっけ。[l]\n梅雨が明けない時もあるし…[l]\nとんと忘れてるなあ、というか子供の頃はそんな事\n分からないし気にしないし。[l]\n結局、寒い方がまだマシのようだ。[l]\nく、熊とか大丈夫だろうな。":53,"それから二人とも自分の読書に没頭した。":54,"およそ道程の半分くらいに至って、\n周りの客が弁当を開け始め、\n匂いが食欲を刺激する。[l]\nそういえば、僕らは弁当買ってなかったのだった。":55,"「宮さん、何かお昼的なもの食べません？[l]\n車内販売来ますよ」":56,"「ええ～？[l]\n宮は向こう着くまで我慢しますよ？[l]\n知狡のとこにはご飯時に着きますし。[l]\n折角、久しぶりに美味しいご飯を食べられるのに、\nもったいないなぁまこくん～」":57,"なんだ、わざと買ってなかったのな。[l]\nしかしゴゴイチのカレーで満足してる人から言われても…[l]\nとはいえ、宮さんのいう事も尤もだったし、\n朝に軽く食べてもいるし我慢できない程じゃない。[l]\n最悪、寝てやり過ごすかだ。":58,"「っかりましたよ。[l]\n飴でも舐めてます」":59,"「あっ宮にも下さいよ。[l]\n…ハッカじゃないですよね？」":60,"「ハッカ？[l]\nなんですハッカって」":61,"「んむあ？！[l]\nハッカはハッカですよ！？[l]\n知らない？　通じない？[l]\n白くてすーすーするだけのっ！[l]\n甘くも何ともないっっ！！」":62,"その後、数分に渡り説明を受けようやく理解。[l]\nああ、要するにミントね。[l]\n昔母さんとかが言ってた気がするよ。[l]\nこうなると、僕がアナクロかどうかも分からなくなってくるのだが、\nそれより飴＝ハッカ入りという発想自体が…[l]\n宮さん……":63,"あれかなあ、ガムって言えば梅、それも板ガムみたいな世代じゃないだろうな…[l]\nさておき持ってた飴はビタミン系レモン味のだったので、\n宮さんも無難に受け入れてくれた。[l]\nなんか疲れた、精神的に。[l]\n逆に空腹になったらどうしようか、全く…":64,"さて、そんなこんながあり、\nしばらくまた二人は各々読書に没入。[l]\nともあれあと一時間くらいなんだが。[l]\nどうしようかなあ、眠いなあ。[l]\nいや、しかし宮さんに見られるのもなー…[l]\nと横を見ると、":65,"@l":66,"「………すー[l]\n………すー」":67,"お、おお。[l]\nおおお。":68,"寝てる、宮さん。[l]\nつーか、\nよだ、よだれ出てる！[l]\nこれは…どうしたらいいんだ？[l]\nやばいこのままでは服に垂れるがな！":69,"起こして注意すれば良いのか？[l]\nそれとも見て見ぬ振りが良いのか？[l]\nはたまた黙って拭いてあげるべきなのか？":70,"いかな年齢不詳の宮さんとはいえ、\n相手は女性だ。[l]\n行動選択に迷いもする。[l]\n大神がようやるゲームならば、\nまさに好感度変動選択肢出現とでもいうべき場面であろう。":71,"いや、別に好感度あげようというつもりはないが、\nだからといって、わざわざ下げるつもりもない。[l]\nまず写真撮ったろうかとも思わないでもなかったが、\nここはぐっと堪えて、ティッシュを準備だ。[l]\n汚れ防止を優先させよう。[l]\nあとは起きればどうにかなろう。":72,"ティッシュを片手に、宮さんの口許へいつでもフォロー出来るようにしつつ、宮さんの肩を揺する。":73,"「…み、宮さん？[l]\n宮さん？[l]\n大丈夫？　起きてくださーい？」":74,"「……んむぅ？[l]\nんあ？」":75,"目が合った。[l]\n…ん？[l]\n僕らのこの体勢は、\n顔も近づいて、\nちょっとあれか？[l]\nイケナイ感じか？":76,"「やっ…！　ちょ、なに？[l]\nんんっ！」":77,"急に動き出した宮さん。[l]\nご、誤解です！[l]\nと言うより先に、僕の身体は涎を拭くほうを咄嗟に選んだらしい。[l]\n結果宮さんの口をふさぐ形になる。[l]\n何しろ周りに普通に他の客はいるのだ。[l]\n大声出されても困ってしまう。[l]\n僕自身も極力ボリュームを下げて、\nしかし圧は上げつつ囁いた。":78,"「しーっ！　しーっ！[l]\nは、はいこれ、ティッシュ！」":79,"折角ここまで気を遣ったのに、\n今更大声でよだれがどうとも言えず、\nとにかくティッシュをそのまま押しつけて、\n急いで身体を離した。[l]\n周りの客は特に反応しておらず、何とか乗り切れたようだ。[l]\nふー、あぶねえ…":80,"宮さんは寝起きでもあり、\n状況を把握するのに少々間が空いたが、\n何とか覚醒してくれたようだった。":81,"「あーもうびっくりしたよぉ、\n思い切ったことされるのかと思ったぁ…」":82,"「しませんて！[l]\nあ、まあ済みません、ちょっと事態が事態だと思ったので…[l]\n出過ぎた真似を…」":83,"いいですいいです、と言いながら身繕いをし\n居住まいを正す宮さんだが、\nしっかりとその呟きが僕の耳に入った。":84,"「ちっ、\nまこくんに見られた…はずかしいところ…」":85,"僕が無理矢理有耶無耶にはしたものの、\n涎の件は自覚してるらしく、\nちょっと本気で恥ずかしそうな宮さん。[l]\n分かっております、見なかったことにしますよ。[l]\nその為にあんなに気ぃ遣ったんだしな。[l]\nこれでも僕ぁ女子には優しいつもりですよいつも。":86,"結局宮さんはこの後決して寝なかったのだった。":87,"あー、\nそれにしてもちょっとドキドキした。[l]\nすっかりドタバタしてしまったが、\n宮さんの寝顔も初めて見られたわけで。[l]\n無防備な彼女の寝顔はちょっとばかり、\n可愛く思えてしまった。[l]\nきっと先日の夢も後を引いてたのだろうが。[l]\n変に意識してしまった、いかんいかん。":88,"精神的な疲弊よりも心拍数上昇のが上回ったのか、\n僕は眠くなることもなく、\n今回は宮さんに寝顔を見られずに済んだ。[l]\nそして。":89,"車内アナウンスが告げる次の停車駅、\n僕らが降りる駅だ。[l]\nとはいえあくまで新幹線を降りる駅、\nまだ先は長い。":90,"「さーてぇ！[l]\n降りますよっ。[l]\n忘れ物ないですね？」":91,"メロディと共に再度アナウンスが鳴り―――":92,"到着。[l]\n僕らは荷物を持って、列車を降りた。[l]\n":93},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_000.ks","relPath":"/data/scenario/SC_S_000.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":94,"length":94,"percent":100},"cellInfo":[null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[64,1],"note":"完成"},"/data/scenario/SC_S_001.ks":{"data":[["玄ノ森に来るのが久々である以上、\n当然本家に来るのも同じだけ時が空いている。","既然时隔许久才再度造访玄之森，\n自然回本家也同样隔了这么久。"],["そのせいか、どうなのか。","不知是否因为这个缘故，"],["「なんか人間の記憶もいい加減なもんですねえ。[l]\nさっきから、見えてる景色も覚えがあるような、\nないような…」","「人类的记忆还真是靠不住呢。[l]\n从刚才起，眼前的景色好像记得，\n又好像没印象…」"],["覚えてるような景色がふっと現れても、\n次に現れる視界が記憶の再構成による予想と\nまるで違っていたりして、\n甚だ心許ない。","即便突然浮现似曾相识的风景，\n接下来映入眼帘的画面\n又与记忆重构的预期截然不同，\n实在让人心里没底。"],["「思いこみやすり込み、願望が、\n記憶の埋め込みを為すこともありますからねー。[l]\nこうだったらいいのに、\nと思っていただけのはずの事象が、\nいつのまにか当人にとって過去の現実になることは\nままあるですよ」","「因为臆想和反复灌输的愿望，\n有时候也会对记忆进行篡改呢ー。[l]\n原本只是想着\n『要是这样就好了』的事情，\n不知何时就会变成当事人记忆中\n真实的过去呢」"],["「それも何かで読みましたねー。[l]\n記憶の美化もそれに類するんでしたっけ」","「这个我也在哪儿读到过ー。[l]\n记忆的美化也属于这类现象对吧」"],["前、旅行先の山の中で、\n神社か何かの大きな門が林立してるのをみたことがあった。","以前去山里旅行时，\n曾见过神社之类的地方耸立着许多大牌坊。"],["その時、\n『こんなかんじに鳥居も立ってたらさぞや壮観だろうなあ』\nと思って数年後、\n僕の脳は完全に記憶を取り違えており、\n『前行ったあの山の中には大きな鳥居が沢山立ってて壮観だ』\nという贋記憶に見事なまでに置換されていた。","当时\n『要是这里也有鸟居的话该多壮观啊』\n这么想着的几年后，\n我的大脑完全记错了事实，\n『之前去的那座山里立着好多大鸟居可壮观了』\n就这样被替换成了完美的虚假记忆。"],["おかげで、そこを再訪したときは当然、愕然・狼狽し、\nようよう真相に気付いた時は、己が脳に焦燥・幻滅したものである。[l]\nしかもその時同行した大神には、さんざ吹聴した上で\n連れて行ったものだから尚更だ。[l]\n奴には、そりゃもう呆れられなじられた。[l]\n憐憫の笑みさえ浮かべられたさ。","多亏如此，当我再次造访那里时，自然是愕然失措、狼狈不堪，\n好不容易察觉到真相时，对自己的脑子感到焦躁又幻灭。[l]\n更何况当时同行的大神，\n是在我大肆吹嘘后才带他去的，就更丢人了。[l]\n那家伙可是把我狠狠嘲笑了一通。[l]\n甚至露出了怜悯的笑容呢。"],["しかし、この場合で言えば、\n情景という視覚情報であるがゆえに、\nたとえ虚妄とはいえ、想像した画像が実記憶とすり替わると、\n『見た』ものとして、他より現実味を持ってしまうのかも知れない。[l]\n…それとも僕の想像力が泉の如く豊かな所為かな。[l]\nははは。[l]\nはははは。[l]\nともあれ。[l]\n文字の連なりを図像として一緒くたに読むという、\n僕の速読めいた癖においても若干弊害があって、\n一旦違う字面で印象づけてしまうと、\n後々まで間違って覚えてることはよくあることだ。[l]\nま、これはあまり読み方とか関係ないか。[l]\nよくあることだ。","不过就这种情况而言，\n正因为是视觉信息构成的情景，\n即便明知是虚妄，当想象的画面与真实记忆混淆时，\n或许会比其他信息更具『亲眼所见』的现实感。[l]\n…又或者是因为我的想象力像泉水般过于丰富吧。[l]\n哈哈哈。[l]\n哈哈哈哈。[l]\n总之。[l]\n就连我把文字连缀当作图案囫囵吞枣的、\n这种类似速读的坏习惯也多少有点弊端，\n一旦被别的字形先入为主，\n往后总会记错很久。[l]\n嘛，这和阅读方法倒没太大关系。[l]\n常有的事啦。"],["「面白いと思ってた懐かしのゲームが、\n今やってみると存外つまんなかったりしますねー。[l]\n自分が変化したと見るか、\n過去が美化されたのか、\nま、どっちもあるかもですけど」","「本以为会很有趣的怀旧游戏，\n现在实际一玩意外地觉得无聊呢ー。[l]\n不知该说是自己变了，\n还是过去被美化了，\n嘛，或许两者都有吧」"],["昔好きだったアニメのDVDが最近になって出、\n買ったは良いものの今見返すと…[l]\nという愚痴は大神からよく聞かされる。","最近出了以前喜欢的动画DVD、\n买是买了但现在重温就觉得…[l]\n这类牢骚经常从大神那里听到。"],["僕は本に関しての姿勢の通り、どっちかというとコレクター気質なのでその辺はあまり関係ない。[l]\nモノそのものを所持していることが重要。","我就像对待书本的态度那样，更偏向收藏家性格所以不太在意这些。[l]\n重要的是拥有物品本身。"],["や、アニメ以外の話ですよ？アニメはそもそも観ないですよ？[l]\nいずれにしろ、\n嫌な記憶は薄れるし取捨選択的に残るのは覚えがいいものなわけで、\n当然過去は美化もされるのだ！","啊、是说动画以外的事哦？动画我本来就不看哦？[l]\n总而言之，\n讨厌的记忆会淡忘而选择性留下的都是美好的回忆，\n当然过去也会被美化！"],["歳取った人が「昔は良かった」といっても実際は割とそうでもないぞ！","上了年纪的人说「过去真好」其实也未必如此！"],["「まーあんまり気にしないほうが良いですよまこくん。[l]\n宮は過去に捕らわれないで前を向いてる君が好き♪」","「嘛ー小真还是别太在意比较好。[l]\n宫喜欢不被过去束缚勇往直前的你♪」"],["無意味にヒートした僕の脳を見透かしたように、\n宮さんがいつもの悪巫山戯モードに入ったので、\n僕も面倒な思考を停止した。","就像看透了我那无意义发热的脑子般，\n宫小姐又切换成往常的恶作剧模式，\n我也就停止了麻烦的思考。"],["別に宮さんに好かれたい訳ではないが、\n前見て生きてくのがいいよね。","倒也不是特别想被宫小姐喜欢，\n不过往前看活着比较好对吧。"],["閑話休題。","闲话休提。"],["本家と呼んではいるものの、\n宗家家元がどうの分家がこうのといった\nその系の格式めいた背景があるでもなく、\nうちの母さんが一人で中央に越してきただけだ。[l]\nなのでつまるところ、普通にいう単なる親元の田舎である。","虽然称之为本家，\n但既没有宗家掌门分家嫡系之类的\n那种系谱相关的显赫背景，\n只是我家老妈独自搬来中央区而已。[l]\n所以归根结底，就是普通意义上的老家乡下罢了。"],["姉である","对于身为姐姐的"],["知","知"],["狡さんに反目、とまではいかずとも、\n何らかの負い目や居づらさは感じていたような空気は\nたまに見せるので、僕の知らないしがらみがあったのかも知れない。","狡小姐虽不到反目的地步，\n但偶尔会流露出某种愧疚或不适的氛围，\n或许存在着我所不知的纠葛。"],["いつもは呆れる程ちゃらんぽらんな母さんだが、\n裏返しなんだろうか、と思ったこともあった。[l]\nとはいえ基本的にはドロドロした血縁上の怨恨などはなく、\n少なくと表面上本家とうちは問題なく付き合っている。","虽然老妈平时散漫得令人傻眼，\n但偶尔会觉得这可能是种反向表现。[l]\n不过基本上没有狗血的血缘恩怨，\n至少表面上本家和我们相处融洽。"],["と思う。[l]\n単純に出来の良い姉に対するコンプレックスかなあ。","我是这么认为的。[l]\n大概只是对优秀姐姐的自卑情结吧。"],["さて、\n現在の旅館のトップはその姉、\n僕にとっては伯母である知狡さんが担ってはいるが、\n先代もしっかりと健在である。[l]\n僕の祖父、飯窪","那么，\n现在旅馆的掌权者是她的姐姐、\n对我来说则是伯母的知狡阿姨，\n上一代也依然健在。[l]\n我的祖父，饭洼"],["源","源"],["四。","四。"],["ただ、僕がレアだともてはやされたように、\n飯窪家ではなかなか男子が生まれないので、\n過去の幾数代同様、婿養子なんだが。[l]\n飯窪は結構古くから続いてる――\nどの家だって『今』ある以上、続いてきた過去があるんだが――\nそこそこ由緒ある家と母さんは吹聴してるが、\nどうにも男子が生まれてこないそうだ。","不过，就像我被当作珍稀物种追捧那样，\n饭洼家一直很难生出男孩，\n所以和过去几代一样，招了上门女婿。[l]\n饭洼家算是延续了很久的――\n反正只要现在存在的家族，都有延续下来的历史――\n老妈总吹嘘说咱家是有点来头的名门，\n但据说就是死活生不出男丁。"],["そういう場合、遺伝的な問題を考えてしまうわけだが、\n過去から近代に至るまで、何故か飯窪は病院や何やで\n原因を検査するでもなく、","这种情况难免让人怀疑是遗传问题，\n可从古至今，饭洼家不知为何从不去医院\n检查具体原因，"],["良く言えばあるがままを受け入れて、女系とも言える体系を紡ぎ時を重ねてきたらしい。[l]\nそういった中僕は生まれたわけで、\nそりゃまあ多少の騒ぎにもなるだろうさ。","往好了说是顺其自然，实际上似乎就这样维系着近乎母系的体系延续至今。[l]\n我就是在这种背景下出生的，\n会引起些骚动也不奇怪啦。"],["知狡さんが旅館を継いだのも僕の誕生直後らしいが、\n関連は聞いてない。[l]\n通例だと婿養子がその座に就いてきたのだが、\n彼女は未婚なのでそのまま自身が長となった。","听说知狡阿姨继承旅馆的时候也正好是我刚出生那会儿，\n不过详细情况没打听过。[l]\n按惯例本该是招个上门女婿来继承的，\n但她一直单身所以就自己当了老板。"],["そんな無理をせずとも、祖父もまだ現役で通じるし、\n引退せずにいれば良かったろうにと思うが、\n何故かこの人事というか継承は行われたのだった。","其实不用这么勉强，爷爷现在也还能胜任工作，\n我觉得他要是没退休就好了，\n但不知为何这个人事安排或者说继承就这么定下来了。"],["ともあれほとんど部外者として別の土地で育った僕には、\n詳しいことはわからない。","总之对于几乎作为外人在别处长大的我来说，\n具体情况并不清楚。"],["「そろそろだ。[l]\n――気分は大丈夫か？」","「差不多到时间了。[l]\n――你感觉还好吗？」"],["「あ、ええ。[l]\n大丈夫です。[l]\nご心配どうもです」","「啊，嗯。[l]\n没问题的。[l]\n让您费心了」"],["食事の後だったせいか、無為な思索をしてたつもりが\nちょっとばかり寝落ちしていたらしい。[l]\nその間に車は本家に近づいたようだった。","或许是饭后缘故，本打算随便想想事情\n结果好像稍微打了个盹。[l]\n这期间车子似乎已接近本家了。"],["ラーメン屋はある意味ドライブイン的店舗だったから\n比較的大きな国道沿いにあったが、","拉面店某种意义上算是公路驿站型店铺\n虽然开在比较大的国道沿线，"],["本家は旅館とはまた離れた、宅地…というには過疎にすぎるが[l]\nまあ古い家屋が集まり、区画整理などされていない、\n塀に囲まれた入り組んだ道の先にあるのだった。","本家位于与旅馆又有一段距离的住宅区…虽说是住宅区却过于冷清[l]\n嘛 就是些老旧房屋聚集在一起 也没经过什么区域规划\n要穿过被围墙包围的错综复杂的小路才能到达"],["――つまりは、こうして久々に来てみると、\nまさに『ねこざんまい』のある辺りとよく似ている。","――也就是说 时隔许久再来这里时\n发现和『猫三昧』所在的那一带特别相似"],["まもなく、車は本家に到着した。","很快 车子就到达了本家"],["家そのものは『ねこざんまい』のように古屋敷然と\nしているでもないが、\n例の書蔵とおぼしきものが数棟、\n敷地内にあるのが見える。[l]\nただそれらも、昔からの建造物というよりも、\n無機質な直方体の倉庫と言う感じで、おそらく近代に建て直したか、\n保護のために外側に建てたガワと思われた。","房子本身倒不像『猫三昧』那样透着古宅气息\n不过\n能看到院内有好几栋\n像是藏书库的建筑[l]\n只是那些建筑与其说是自古就有的\n不如说更像是无机质的长方体仓库 估计是近代重建的\n或为了保护原建筑而在外围加盖的外壳"],["「あ、宮は乗ってますから、\n二人でぱぱっと挨拶してきてください。[l]\n宮まで行くと長くなるかもなので」","「啊 宫就坐在车上\n你们两个快去快回打个招呼就行[l]\n要是连宫都去的话可能会拖很久」"],["「え、あ、そうですか。[l]\nいいんすか？」","「诶 啊 这样啊[l]\n真的可以吗？」"],["「ん？[l]\nああ、構わないだろう。[l]\n事前に言い置いてあるし問題はない」","「嗯？[l]\n啊 没关系吧[l]\n事先都说好了应该没问题」"],["そうなのか？[l]\n宮さん雇われの身じゃないんか。[l]\n礼儀としてどうなのよ。","是这样吗？[l]\n宫小姐不是被雇佣的身份吗。[l]\n作为礼节来说这算怎么回事啊。"],["「あ、ドライバーさん、エンジンも付けっぱなしで。[l]\nラジオ聴きますから。[l]\nアイドリングされるの嫌なら二人とも、\n早めに済ませてください」","「啊，司机师傅，引擎也一直开着吧。[l]\n我要听收音机。[l]\n如果嫌怠速吵的话，你们俩\n就赶紧完事吧」"],["「了解です。[l]\nじゃ、行こうか真言」","「明白。[l]\n那走吧真言」"],["更なる傲岸ぶりを発揮しつつ、\nしかして知狡さん、それを咎めることもない。[l]\n…結局本家の人間もそんな感じな。[l]\n宮さん恐るべし…","她愈发显露出傲慢姿态，\n但知狡阿姨并未加以责备。[l]\n…说到底本家的人都这副德性。[l]\n宫小姐真可怕…"],["これからは姫とでも呼んでやろうか。","以后干脆叫她公主得了。"],["ところで乗ってきたこれ、\n車こそハイヤーではあるが、完全に旅館お抱え送迎車といったほうがいいようだ。","话说回来坐的这辆车，\n虽说是高级租赁车，但完全该说是旅馆专属接送车。"],["車庫も旅館内にあるというし。[l]\n運転手さんも旅館の従業員だそうな。","听说车库也在旅馆内。[l]\n司机好像也是旅馆员工。"],["宮さんもああ言ってるし、他の人間とはまた改めて、と、\n知狡さんは僕を早足で家へと招き入れ、\n足早にある部屋へと向かった。","既然宫小姐都那么说了，其他人就改天再——\n知狡阿姨快步将我引进屋内，\n疾步走向某个房间。"],["他意無き感想だと断っておくが、\nよくある田舎の金満家のようにそこかしこに置物や洋画などが\n飾ってある、まさにおじいちゃんおばあちゃんの家といった風情。[l]\n煙草の臭いはしないかわり、木の匂いが漂う。","事先声明这只是客观感受，\n就像常见乡下暴发户那样到处摆着装饰品和西洋画\n完全就是爷爷奶奶家的氛围。[l]\n虽然没有烟味，但飘着木头香气。"],["所謂洋間と思われる部屋の扉、ドアの両脇にも本棚があり、\n更にその対面にも向かい合わせで設置され、廊下を狭くしている。","疑似所谓西式房间的门扉两侧也放着书架，\n对面又对称摆放着书架，让走廊显得狭窄。"],["そこで知狡さんが立ち止まり、ドアをノックした。","知狡阿姨在此停步敲门。"],["「親父殿、入るぞ」","「父亲大人，我进来了」"],["おぉ、入りなさい、という返事が戻り、\nドアを開ける知狡さん。[l]\n僕に入るよう促す。[l]\nおおう緊張しますな。","听到\"请进\"的回应后，\n知狡阿姨推开门。[l]\n示意我进去。[l]\n呜哇好紧张。"],["これまた所謂書斎。[l]\n…なんとなく校長室に入る気分に近いな。[l]\nと周りに注意を向ける間もなく、\n目の前に鎮座しておられた人物が視界に入る。","这里应该就是所谓书房。[l]\n…莫名有种进校长室的感觉。[l]\n还没顾上观察四周，\n视线就捕捉到端坐眼前的人物。"],["銀髪の老年――いやさ壮年といっても通るんではなかろうか――\n未だ矍鑠としてはいるが険のあるわけでもなく、\nしかして力の衰えを感じさせない眼光がある。","银发老者――不说是壮年也完全合适――\n虽精神矍铄却不显严厉，\n目光中仍能感受到未衰退的魄力。"],["やや色素が薄く、グレーがかった瞳に、\n眼鏡をかけたその人物が、\n我が祖父たる飯窪源四その人であった。","那双色素较浅的灰调眼眸上，\n戴着眼镜的这位，\n正是我祖父饭洼源四本人。"],["「連れてきました。[l]\n真言です」","「人带来了。[l]\n这是真言」"],["「おぉおぉ、良く来た！[l]\n覚えとらんだろうが君の祖父だ。[l]\n改めまして、飯窪源四といいます、よろしく」","「噢噢，来得正好！[l]\n你应该不记得了吧，我是你祖父。[l]\n重新自我介绍，我叫饭洼源四，请多指教」"],["知狡さんのようにはきはきとした口調で喋る祖父。[l]\n手を差し出され、がっちり握手をされた。[l]\nさすがにかれお嬢のように、その後ぶんぶん振ったりはしない。","祖父用比知狡阿姨更爽利的语气说道。[l]\n他伸出手与我用力相握。[l]\n倒不会像卡蕾欧小姐那样握完还甩来甩去。"],["ほとんど初対面に等しい邂逅ではあるが、\n僕ももう成人になろうかという歳である。[l]\n多少緊張はすれども親族との会話だ。[l]\n他人行儀に鯱張ったりはしない。[l]\nそれが良いか悪いかは別だが。","虽说是近乎初次见面的重逢，\n但我也快到而立之年了。[l]\n虽有些紧张毕竟是和亲人对话。[l]\n不会过分客套拘谨。[l]\n虽说不知这样是好是坏。"],["「いえいえお久しぶりです。[l]\n…正直、仰るとおりご尊顔は覚えてないんですが、[l]\nお世話になりました。[l]\nあ、ええと、母がよろしくと…」","「哪里哪里好久不见。[l]\n…说实话确实如您所说记不清尊容，[l]\n承蒙您照顾了。[l]\n啊，那个，家母让我代问好…」"],["そう言うと、\nあいつはあんなだから、いつも君に苦労をかけてないか心配だ、\nと困り顔になる。","听我这么说，\n祖父露出困扰表情：\n那丫头总是那副德性，一直担心她给你添麻烦"],["「今回のことはすまんな。[l]\nが、学校まで辞めさせただけの\n埋め合わせはしよう。[l]\nとにかく君の母さんや","「这次的事对不住。[l]\n但我会补偿到\n能抵销让你退学的程度。[l]\n总之你别去责怪你母亲"],["宮","和宫"],["殿を責めたりはせんでくれ」","大人她们」"],["「ええ、大丈夫です。[l]\nもう心の整理は着きましたし逆に感謝してるくらいです。[l]\n学校行くことが人生の目的じゃないですし、\n面倒なことは忘れるのがモットーですから。[l]\n前を向いて生きるのが僕の信条です。あはは」","「嗯，没关系的。[l]\n我已经整理好心情了，反而要感谢您。[l]\n上学又不是人生的目的，\n我的座右铭就是忘记麻烦事。[l]\n向前看是我的信条。哈哈哈」"],["緊張してるのか弛緩してるのか、もはや自分でもわかりません。[l]\nテンションが普通でないだけなんだろうけど。","是紧张还是放松，连我自己都搞不清了。[l]\n大概只是情绪不太正常吧。"],["「そうか。[l]\nなら多くは言うまい。[l]\n難儀な事ですまんが宜しく頼む」","「这样啊。[l]\n那我就不多说了。[l]\n给你添麻烦了，拜托了」"],["宮殿が一緒ならば安心だろう、\nと付け加えられた。","有宫大人陪着应该没问题吧，\n他又补充道。"],["どういうことよ。","什么意思啊。"],["「で、あの、その宮さんにですね、\n早く戻るように言われてるんで…」","「那个，宫小姐她呢，\n让我早点回去…」"],["「ん？[l]\nああ。宮殿の言いつけか。[l]\n今日も立ち寄り下さらんか。","「嗯？[l]\n啊。是宫大人的吩咐吗。[l]\n今天也不来坐坐吗。"],["残念だが致し方ない。[l]\n宜しく伝えてほしい」","遗憾但也没办法。[l]\n帮我带个好」"],["「わかりました。伝えます」","「明白了。会转达的」"],["「親父殿」","「父亲大人」"],["「ん？[l]\nああ、真言くん」","「嗯？[l]\n啊，真言君」"],["「え、あ、はい。[l]\nなんでしょうか」","「啊，是。[l]\n有什么事吗」"],["「こちらの都合で恐縮だが、後で見てもらいたいものがある。[l]\nその時は知狡に連絡するから是非また来てくれ給え。[l]\n本来ならば今日今にでも、と思っていたんだが」","「虽然是我们这边冒昧，但有东西想请你之后看看。[l]\n到时候会让知狡联系你，务必再来一趟。[l]\n本来想今天现在就…」"],["「は？[l]\nはい、わかりました…」","「诶？[l]\n好的，明白了…」"],["「聞けば君も本好きだということだから、\n勿論自慢の書蔵を見て貰うのも結構なんだが、\nそれとは別なんだ。","「听说你也喜欢书，\n当然让你看看我珍藏的书库也不错，\n但不是这个。"],["三春が御神体を秘蔵しているように、\n我が飯窪にも実は代々伝わる家宝があるのだな。[l]\nそれこそ、かの家のように門外不出、なのだがね。","就像三春家秘藏着御神体一样，\n其实我们饭洼家也有代代相传的家宝。[l]\n不过和那家一样，都是绝不外传的。"],["何しろ君は飯窪の直系の男子だからな。[l]\n家内が色々と伝えたいことがあるそうだ。[l]\nというわけで、\nわしより婆さんの方から詳しいことは聞いてくれ。[l]\n…それとも知狡が説明するかな」","毕竟你是饭洼家的直系男丁。[l]\n我老伴说有很多事想告诉你。[l]\n所以呢，\n具体细节还是听老太太说吧。[l]\n…或者让知狡说明」"],["「あるいは宮さんが」","「也可能由宫小姐来说」"],["へえ、飯窪にもそんなものが。[l]\nちなみに本ではないのだという。[l]\nにしても、『家宝』という言葉、実際耳にすると\nすごい安っぽというか、胡散臭く聞こえるのは何故だろう。","嘿，饭洼家也有这种东西啊。[l]\n顺便说不是书本。[l]\n不过『家宝』这个词，实际听到时\n总觉得特别廉价可疑，为什么呢。"],["最後に祖父は、","最后祖父"],["「何かあったらいつでもこっちに来ると良い。[l]\nではまた後日に。[l]\n今日はゆっくり休みなさい」","「有事随时可以过来。[l]\n那就改天见。[l]\n今天好好休息吧」"],["と言い、また僕の手を力強く握った。[l]\nにしても知狡さん、さっきから口数少ないな。[l]\n僕と違って毎日顔会わせてるんだろうし、\nむしろ近しい故の態度ということだろうか。","说着又用力握了握我的手。[l]\n不过知狡阿姨话好少啊。[l]\n和我不一样，你们天天见面吧，\n或许正因为亲近才这样？"],["「では親父殿、そういうことだ。[l]\nまた後で」","「那父亲大人，就这么说定了。[l]\n待会见」"],["「わかっている。[l]\n宮殿によろしくな」","「知道啦。[l]\n替我向宫大人问好」"],["縫うように部屋から出ると、\n来たときと同じように、\n知狡さんと僕は足早に車へと戻っていく。","像穿针引线般走出房间，\n和来时一样，\n知狡阿姨和我快步回到车上。"],["と、","这时、"],["「今の親父殿の話だが」","「关于刚才父亲大人提到的事」"],["僕の方を見ずに知狡さんが言う。","知狡阿姨没有看我这边，开口说道。"],["「できれば今回の、くだんの調査を始める前に済ませたい。[l]\nそういう事態になる前に言ってくれるか」","「如果可以的话，希望能在这次开始那项调查前解决。[l]\n能否在那类事态发生前告知我」"],["「そうなんですか？[l]\nまあ、わかりましたよ。[l]\nそうします」","「是这样吗？[l]\n啊，我明白了。[l]\n会照办的」"],["「なるべく早くこちらも調整する」","「我们这边也会尽快协调」"],["…やっぱり、なんとなく不機嫌そうかな？[l]\nそれとも照れ隠しなんだろうかな。[l]\n――気にしすぎか。","…果然，总觉得她好像不太高兴？[l]\n又或者是在掩饰害羞呢。[l]\n――是我想太多了吧。"],["車に戻ると、宮さんがこちらに気づきにやり、として\n居住まいを正した。","回到车上时，宫小姐注意到这边，\n端正了坐姿。"],["「んむ、思ったより早かったですね。[l]\n感心感心です。[l]\nさ、ちゃっちゃと出発ですよ」","「嗯，比预想的要早呢。[l]\n值得表扬值得表扬。[l]\n来，赶快出发吧」"],["知狡さんの妙に重げな空気など知ってか知らずか、\n宮さんはまるで事も無げである。[l]\n当の知狡さんも薄く笑みを浮かべつ、車に乗り込んでいった。","不知是否察觉到知狡阿姨异常沉重的氛围，\n宫小姐表现得若无其事。[l]\n而知狡阿姨本人也浮现淡淡微笑，坐进了车里。"],["なんだよ。[l]\nやっぱり僕が気にしすぎだったかな。","什么嘛。[l]\n果然是我太敏感了吧。"],["僕の乗車を確認すると、車は一路旅館へ、\n『六母屋』へと向かって走り出した。[l]\n","确认我上车后，车辆径直驶向旅馆——\n朝着『六母屋』疾驰而去。[l]\n"]],"context":[["SC_S_001.ks/index/1/text"],["SC_S_001.ks/index/3/text"],["SC_S_001.ks/index/5/text"],["SC_S_001.ks/index/7/text"],["SC_S_001.ks/index/9/text"],["SC_S_001.ks/index/11/text"],["SC_S_001.ks/index/13/text"],["SC_S_001.ks/index/15/text"],["SC_S_001.ks/index/17/text"],["SC_S_001.ks/index/19/text"],["SC_S_001.ks/index/21/text"],["SC_S_001.ks/index/23/text"],["SC_S_001.ks/index/25/text"],["SC_S_001.ks/index/27/text"],["SC_S_001.ks/index/29/text"],["SC_S_001.ks/index/31/text"],["SC_S_001.ks/index/33/text"],["SC_S_001.ks/index/35/text"],["SC_S_001.ks/index/37/text"],["SC_S_001.ks/index/39/text"],["SC_S_001.ks/index/41/text"],["SC_S_001.ks/index/43/text"],["SC_S_001.ks/index/45/text"],["SC_S_001.ks/index/47/text"],["SC_S_001.ks/index/49/text"],["SC_S_001.ks/index/51/text"],["SC_S_001.ks/index/53/text"],["SC_S_001.ks/index/55/text"],["SC_S_001.ks/index/57/text"],["SC_S_001.ks/index/59/text"],["SC_S_001.ks/index/61/text"],["SC_S_001.ks/index/63/text"],["SC_S_001.ks/index/65/text"],["SC_S_001.ks/index/67/text"],["SC_S_001.ks/index/69/text"],["SC_S_001.ks/index/71/text"],["SC_S_001.ks/index/73/text"],["SC_S_001.ks/index/75/text"],["SC_S_001.ks/index/77/text"],["SC_S_001.ks/index/79/text"],["SC_S_001.ks/index/81/text"],["SC_S_001.ks/index/83/text"],["SC_S_001.ks/index/85/text"],["SC_S_001.ks/index/87/text"],["SC_S_001.ks/index/89/text"],["SC_S_001.ks/index/91/text"],["SC_S_001.ks/index/93/text"],["SC_S_001.ks/index/95/text"],["SC_S_001.ks/index/97/text"],["SC_S_001.ks/index/99/text"],["SC_S_001.ks/index/101/text"],["SC_S_001.ks/index/103/text"],["SC_S_001.ks/index/105/text"],["SC_S_001.ks/index/107/text"],["SC_S_001.ks/index/109/text"],["SC_S_001.ks/index/111/text"],["SC_S_001.ks/index/113/text"],["SC_S_001.ks/index/115/text"],["SC_S_001.ks/index/117/text"],["SC_S_001.ks/index/119/text"],["SC_S_001.ks/index/121/text"],["SC_S_001.ks/index/123/text"],["SC_S_001.ks/index/125/text"],["SC_S_001.ks/index/127/text"],["SC_S_001.ks/index/129/text"],["SC_S_001.ks/index/131/text"],["SC_S_001.ks/index/133/text"],["SC_S_001.ks/index/135/text"],["SC_S_001.ks/index/137/text"],["SC_S_001.ks/index/139/text"],["SC_S_001.ks/index/141/text"],["SC_S_001.ks/index/143/text"],["SC_S_001.ks/index/145/text"],["SC_S_001.ks/index/147/text"],["SC_S_001.ks/index/149/text"],["SC_S_001.ks/index/151/text"],["SC_S_001.ks/index/153/text"],["SC_S_001.ks/index/155/text"],["SC_S_001.ks/index/157/text"],["SC_S_001.ks/index/159/text"],["SC_S_001.ks/index/161/text"],["SC_S_001.ks/index/163/text"],["SC_S_001.ks/index/165/text"],["SC_S_001.ks/index/167/text"],["SC_S_001.ks/index/169/text"],["SC_S_001.ks/index/171/text"],["SC_S_001.ks/index/173/text"],["SC_S_001.ks/index/175/text"],["SC_S_001.ks/index/177/text"],["SC_S_001.ks/index/179/text"],["SC_S_001.ks/index/181/text"],["SC_S_001.ks/index/183/text"],["SC_S_001.ks/index/185/text"],["SC_S_001.ks/index/187/text"],["SC_S_001.ks/index/189/text"],["SC_S_001.ks/index/191/text"],["SC_S_001.ks/index/193/text"],["SC_S_001.ks/index/195/text"],["SC_S_001.ks/index/197/text"],["SC_S_001.ks/index/199/text"],["SC_S_001.ks/index/201/text"],["SC_S_001.ks/index/203/text"],["SC_S_001.ks/index/205/text"],["SC_S_001.ks/index/207/text"],["SC_S_001.ks/index/209/text"],["SC_S_001.ks/index/211/text"],["SC_S_001.ks/index/213/text"]],"tags":[],"parameters":[[{"start":169,"end":211}],[{"start":225,"end":237}],[{"start":275,"end":339}],[{"start":371,"end":443}],[{"start":482,"end":605}],[{"start":645,"end":687}],[{"start":721,"end":764}],[{"start":778,"end":909}],[{"start":923,"end":1086}],[{"start":1100,"end":1424}],[{"start":1463,"end":1565}],[{"start":1597,"end":1665}],[{"start":1679,"end":1750}],[{"start":1764,"end":1862}],[{"start":1876,"end":1908}],[{"start":1947,"end":2004}],[{"start":2036,"end":2103}],[{"start":2117,"end":2154}],[{"start":2170,"end":2175}],[{"start":2191,"end":2313}],[{"start":2329,"end":2333}],[{"start":2344,"end":2345}],[{"start":2357,"end":2439}],[{"start":2453,"end":2566}],[{"start":2580,"end":2616}],[{"start":2632,"end":2717}],[{"start":2729,"end":2730}],[{"start":2741,"end":2743}],[{"start":2759,"end":2932}],[{"start":2946,"end":3017}],[{"start":3031,"end":3119}],[{"start":3135,"end":3228}],[{"start":3242,"end":3319}],[{"start":3333,"end":3376}],[{"start":3416,"end":3442}],[{"start":3482,"end":3519}],[{"start":3551,"end":3625}],[{"start":3641,"end":3686}],[{"start":3700,"end":3787}],[{"start":3801,"end":3850}],[{"start":3866,"end":3881}],[{"start":3926,"end":4091}],[{"start":4130,"end":4190}],[{"start":4230,"end":4256}],[{"start":4296,"end":4343}],[{"start":4375,"end":4423}],[{"start":4462,"end":4547}],[{"start":4587,"end":4611}],[{"start":4643,"end":4723}],[{"start":4737,"end":4754}],[{"start":4768,"end":4822}],[{"start":4836,"end":4875}],[{"start":4889,"end":4957}],[{"start":4973,"end":5085}],[{"start":5101,"end":5163}],[{"start":5179,"end":5202}],[{"start":5242,"end":5251}],[{"start":5283,"end":5352}],[{"start":5397,"end":5482}],[{"start":5498,"end":5580}],[{"start":5596,"end":5654}],[{"start":5694,"end":5716}],[{"start":5755,"end":5818}],[{"start":5850,"end":5937}],[{"start":5953,"end":6066}],[{"start":6106,"end":6191}],[{"start":6223,"end":6276}],[{"start":6315,"end":6382}],[{"start":6394,"end":6395}],[{"start":6407,"end":6420}],[{"start":6460,"end":6586}],[{"start":6618,"end":6676}],[{"start":6715,"end":6761}],[{"start":6793,"end":6821}],[{"start":6837,"end":6845}],[{"start":6885,"end":6922}],[{"start":6961,"end":7005}],[{"start":7019,"end":7047}],[{"start":7087,"end":7100}],[{"start":7140,"end":7145}],[{"start":7184,"end":7203}],[{"start":7243,"end":7267}],[{"start":7306,"end":7396}],[{"start":7436,"end":7458}],[{"start":7497,"end":7556}],[{"start":7570,"end":7645}],[{"start":7659,"end":7770}],[{"start":7810,"end":7820}],[{"start":7852,"end":7951}],[{"start":7965,"end":7972}],[{"start":8009,"end":8067}],[{"start":8099,"end":8197}],[{"start":8237,"end":8265}],[{"start":8304,"end":8329}],[{"start":8392,"end":8445}],[{"start":8459,"end":8461}],[{"start":8499,"end":8510}],[{"start":8542,"end":8557}],[{"start":8597,"end":8651}],[{"start":8689,"end":8731}],[{"start":8769,"end":8785}],[{"start":8817,"end":8877}],[{"start":8891,"end":8929}],[{"start":8966,"end":9020}],[{"start":9052,"end":9131}],[{"start":9145,"end":9175}],[{"start":9191,"end":9236}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_001.ks","basename":"SC_S_001.ks","indexIds":{"玄ノ森に来るのが久々である以上、\n当然本家に来るのも同じだけ時が空いている。":0,"そのせいか、どうなのか。":1,"「なんか人間の記憶もいい加減なもんですねえ。[l]\nさっきから、見えてる景色も覚えがあるような、\nないような…」":2,"覚えてるような景色がふっと現れても、\n次に現れる視界が記憶の再構成による予想と\nまるで違っていたりして、\n甚だ心許ない。":3,"「思いこみやすり込み、願望が、\n記憶の埋め込みを為すこともありますからねー。[l]\nこうだったらいいのに、\nと思っていただけのはずの事象が、\nいつのまにか当人にとって過去の現実になることは\nままあるですよ」":4,"「それも何かで読みましたねー。[l]\n記憶の美化もそれに類するんでしたっけ」":5,"前、旅行先の山の中で、\n神社か何かの大きな門が林立してるのをみたことがあった。":6,"その時、\n『こんなかんじに鳥居も立ってたらさぞや壮観だろうなあ』\nと思って数年後、\n僕の脳は完全に記憶を取り違えており、\n『前行ったあの山の中には大きな鳥居が沢山立ってて壮観だ』\nという贋記憶に見事なまでに置換されていた。":7,"おかげで、そこを再訪したときは当然、愕然・狼狽し、\nようよう真相に気付いた時は、己が脳に焦燥・幻滅したものである。[l]\nしかもその時同行した大神には、さんざ吹聴した上で\n連れて行ったものだから尚更だ。[l]\n奴には、そりゃもう呆れられなじられた。[l]\n憐憫の笑みさえ浮かべられたさ。":8,"しかし、この場合で言えば、\n情景という視覚情報であるがゆえに、\nたとえ虚妄とはいえ、想像した画像が実記憶とすり替わると、\n『見た』ものとして、他より現実味を持ってしまうのかも知れない。[l]\n…それとも僕の想像力が泉の如く豊かな所為かな。[l]\nははは。[l]\nはははは。[l]\nともあれ。[l]\n文字の連なりを図像として一緒くたに読むという、\n僕の速読めいた癖においても若干弊害があって、\n一旦違う字面で印象づけてしまうと、\n後々まで間違って覚えてることはよくあることだ。[l]\nま、これはあまり読み方とか関係ないか。[l]\nよくあることだ。":9,"「面白いと思ってた懐かしのゲームが、\n今やってみると存外つまんなかったりしますねー。[l]\n自分が変化したと見るか、\n過去が美化されたのか、\nま、どっちもあるかもですけど」":10,"昔好きだったアニメのDVDが最近になって出、\n買ったは良いものの今見返すと…[l]\nという愚痴は大神からよく聞かされる。":11,"僕は本に関しての姿勢の通り、どっちかというとコレクター気質なのでその辺はあまり関係ない。[l]\nモノそのものを所持していることが重要。":12,"や、アニメ以外の話ですよ？アニメはそもそも観ないですよ？[l]\nいずれにしろ、\n嫌な記憶は薄れるし取捨選択的に残るのは覚えがいいものなわけで、\n当然過去は美化もされるのだ！":13,"歳取った人が「昔は良かった」といっても実際は割とそうでもないぞ！":14,"「まーあんまり気にしないほうが良いですよまこくん。[l]\n宮は過去に捕らわれないで前を向いてる君が好き♪」":15,"無意味にヒートした僕の脳を見透かしたように、\n宮さんがいつもの悪巫山戯モードに入ったので、\n僕も面倒な思考を停止した。":16,"別に宮さんに好かれたい訳ではないが、\n前見て生きてくのがいいよね。":17,"閑話休題。":18,"本家と呼んではいるものの、\n宗家家元がどうの分家がこうのといった\nその系の格式めいた背景があるでもなく、\nうちの母さんが一人で中央に越してきただけだ。[l]\nなのでつまるところ、普通にいう単なる親元の田舎である。":19,"姉である":20,"知":21,"狡さんに反目、とまではいかずとも、\n何らかの負い目や居づらさは感じていたような空気は\nたまに見せるので、僕の知らないしがらみがあったのかも知れない。":22,"いつもは呆れる程ちゃらんぽらんな母さんだが、\n裏返しなんだろうか、と思ったこともあった。[l]\nとはいえ基本的にはドロドロした血縁上の怨恨などはなく、\n少なくと表面上本家とうちは問題なく付き合っている。":23,"と思う。[l]\n単純に出来の良い姉に対するコンプレックスかなあ。":24,"さて、\n現在の旅館のトップはその姉、\n僕にとっては伯母である知狡さんが担ってはいるが、\n先代もしっかりと健在である。[l]\n僕の祖父、飯窪":25,"源":26,"四。":27,"ただ、僕がレアだともてはやされたように、\n飯窪家ではなかなか男子が生まれないので、\n過去の幾数代同様、婿養子なんだが。[l]\n飯窪は結構古くから続いてる――\nどの家だって『今』ある以上、続いてきた過去があるんだが――\nそこそこ由緒ある家と母さんは吹聴してるが、\nどうにも男子が生まれてこないそうだ。":28,"そういう場合、遺伝的な問題を考えてしまうわけだが、\n過去から近代に至るまで、何故か飯窪は病院や何やで\n原因を検査するでもなく、":29,"良く言えばあるがままを受け入れて、女系とも言える体系を紡ぎ時を重ねてきたらしい。[l]\nそういった中僕は生まれたわけで、\nそりゃまあ多少の騒ぎにもなるだろうさ。":30,"知狡さんが旅館を継いだのも僕の誕生直後らしいが、\n関連は聞いてない。[l]\n通例だと婿養子がその座に就いてきたのだが、\n彼女は未婚なのでそのまま自身が長となった。":31,"そんな無理をせずとも、祖父もまだ現役で通じるし、\n引退せずにいれば良かったろうにと思うが、\n何故かこの人事というか継承は行われたのだった。":32,"ともあれほとんど部外者として別の土地で育った僕には、\n詳しいことはわからない。":33,"「そろそろだ。[l]\n――気分は大丈夫か？」":34,"「あ、ええ。[l]\n大丈夫です。[l]\nご心配どうもです」":35,"食事の後だったせいか、無為な思索をしてたつもりが\nちょっとばかり寝落ちしていたらしい。[l]\nその間に車は本家に近づいたようだった。":36,"ラーメン屋はある意味ドライブイン的店舗だったから\n比較的大きな国道沿いにあったが、":37,"本家は旅館とはまた離れた、宅地…というには過疎にすぎるが[l]\nまあ古い家屋が集まり、区画整理などされていない、\n塀に囲まれた入り組んだ道の先にあるのだった。":38,"――つまりは、こうして久々に来てみると、\nまさに『ねこざんまい』のある辺りとよく似ている。":39,"まもなく、車は本家に到着した。":40,"家そのものは『ねこざんまい』のように古屋敷然と\nしているでもないが、\n例の書蔵とおぼしきものが数棟、\n敷地内にあるのが見える。[l]\nただそれらも、昔からの建造物というよりも、\n無機質な直方体の倉庫と言う感じで、おそらく近代に建て直したか、\n保護のために外側に建てたガワと思われた。":41,"「あ、宮は乗ってますから、\n二人でぱぱっと挨拶してきてください。[l]\n宮まで行くと長くなるかもなので」":42,"「え、あ、そうですか。[l]\nいいんすか？」":43,"「ん？[l]\nああ、構わないだろう。[l]\n事前に言い置いてあるし問題はない」":44,"そうなのか？[l]\n宮さん雇われの身じゃないんか。[l]\n礼儀としてどうなのよ。":45,"「あ、ドライバーさん、エンジンも付けっぱなしで。[l]\nラジオ聴きますから。[l]\nアイドリングされるの嫌なら二人とも、\n早めに済ませてください」":46,"「了解です。[l]\nじゃ、行こうか真言」":47,"更なる傲岸ぶりを発揮しつつ、\nしかして知狡さん、それを咎めることもない。[l]\n…結局本家の人間もそんな感じな。[l]\n宮さん恐るべし…":48,"これからは姫とでも呼んでやろうか。":49,"ところで乗ってきたこれ、\n車こそハイヤーではあるが、完全に旅館お抱え送迎車といったほうがいいようだ。":50,"車庫も旅館内にあるというし。[l]\n運転手さんも旅館の従業員だそうな。":51,"宮さんもああ言ってるし、他の人間とはまた改めて、と、\n知狡さんは僕を早足で家へと招き入れ、\n足早にある部屋へと向かった。":52,"他意無き感想だと断っておくが、\nよくある田舎の金満家のようにそこかしこに置物や洋画などが\n飾ってある、まさにおじいちゃんおばあちゃんの家といった風情。[l]\n煙草の臭いはしないかわり、木の匂いが漂う。":53,"所謂洋間と思われる部屋の扉、ドアの両脇にも本棚があり、\n更にその対面にも向かい合わせで設置され、廊下を狭くしている。":54,"そこで知狡さんが立ち止まり、ドアをノックした。":55,"「親父殿、入るぞ」":56,"おぉ、入りなさい、という返事が戻り、\nドアを開ける知狡さん。[l]\n僕に入るよう促す。[l]\nおおう緊張しますな。":57,"これまた所謂書斎。[l]\n…なんとなく校長室に入る気分に近いな。[l]\nと周りに注意を向ける間もなく、\n目の前に鎮座しておられた人物が視界に入る。":58,"銀髪の老年――いやさ壮年といっても通るんではなかろうか――\n未だ矍鑠としてはいるが険のあるわけでもなく、\nしかして力の衰えを感じさせない眼光がある。":59,"やや色素が薄く、グレーがかった瞳に、\n眼鏡をかけたその人物が、\n我が祖父たる飯窪源四その人であった。":60,"「連れてきました。[l]\n真言です」":61,"「おぉおぉ、良く来た！[l]\n覚えとらんだろうが君の祖父だ。[l]\n改めまして、飯窪源四といいます、よろしく」":62,"知狡さんのようにはきはきとした口調で喋る祖父。[l]\n手を差し出され、がっちり握手をされた。[l]\nさすがにかれお嬢のように、その後ぶんぶん振ったりはしない。":63,"ほとんど初対面に等しい邂逅ではあるが、\n僕ももう成人になろうかという歳である。[l]\n多少緊張はすれども親族との会話だ。[l]\n他人行儀に鯱張ったりはしない。[l]\nそれが良いか悪いかは別だが。":64,"「いえいえお久しぶりです。[l]\n…正直、仰るとおりご尊顔は覚えてないんですが、[l]\nお世話になりました。[l]\nあ、ええと、母がよろしくと…」":65,"そう言うと、\nあいつはあんなだから、いつも君に苦労をかけてないか心配だ、\nと困り顔になる。":66,"「今回のことはすまんな。[l]\nが、学校まで辞めさせただけの\n埋め合わせはしよう。[l]\nとにかく君の母さんや":67,"宮":68,"殿を責めたりはせんでくれ」":69,"「ええ、大丈夫です。[l]\nもう心の整理は着きましたし逆に感謝してるくらいです。[l]\n学校行くことが人生の目的じゃないですし、\n面倒なことは忘れるのがモットーですから。[l]\n前を向いて生きるのが僕の信条です。あはは」":70,"緊張してるのか弛緩してるのか、もはや自分でもわかりません。[l]\nテンションが普通でないだけなんだろうけど。":71,"「そうか。[l]\nなら多くは言うまい。[l]\n難儀な事ですまんが宜しく頼む」":72,"宮殿が一緒ならば安心だろう、\nと付け加えられた。":73,"どういうことよ。":74,"「で、あの、その宮さんにですね、\n早く戻るように言われてるんで…」":75,"「ん？[l]\nああ。宮殿の言いつけか。[l]\n今日も立ち寄り下さらんか。":76,"残念だが致し方ない。[l]\n宜しく伝えてほしい」":77,"「わかりました。伝えます」":78,"「親父殿」":79,"「ん？[l]\nああ、真言くん」":80,"「え、あ、はい。[l]\nなんでしょうか」":81,"「こちらの都合で恐縮だが、後で見てもらいたいものがある。[l]\nその時は知狡に連絡するから是非また来てくれ給え。[l]\n本来ならば今日今にでも、と思っていたんだが」":82,"「は？[l]\nはい、わかりました…」":83,"「聞けば君も本好きだということだから、\n勿論自慢の書蔵を見て貰うのも結構なんだが、\nそれとは別なんだ。":84,"三春が御神体を秘蔵しているように、\n我が飯窪にも実は代々伝わる家宝があるのだな。[l]\nそれこそ、かの家のように門外不出、なのだがね。":85,"何しろ君は飯窪の直系の男子だからな。[l]\n家内が色々と伝えたいことがあるそうだ。[l]\nというわけで、\nわしより婆さんの方から詳しいことは聞いてくれ。[l]\n…それとも知狡が説明するかな」":86,"「あるいは宮さんが」":87,"へえ、飯窪にもそんなものが。[l]\nちなみに本ではないのだという。[l]\nにしても、『家宝』という言葉、実際耳にすると\nすごい安っぽというか、胡散臭く聞こえるのは何故だろう。":88,"最後に祖父は、":89,"「何かあったらいつでもこっちに来ると良い。[l]\nではまた後日に。[l]\n今日はゆっくり休みなさい」":90,"と言い、また僕の手を力強く握った。[l]\nにしても知狡さん、さっきから口数少ないな。[l]\n僕と違って毎日顔会わせてるんだろうし、\nむしろ近しい故の態度ということだろうか。":91,"「では親父殿、そういうことだ。[l]\nまた後で」":92,"「わかっている。[l]\n宮殿によろしくな」":93,"縫うように部屋から出ると、\n来たときと同じように、\n知狡さんと僕は足早に車へと戻っていく。":94,"と、":95,"「今の親父殿の話だが」":96,"僕の方を見ずに知狡さんが言う。":97,"「できれば今回の、くだんの調査を始める前に済ませたい。[l]\nそういう事態になる前に言ってくれるか」":98,"「そうなんですか？[l]\nまあ、わかりましたよ。[l]\nそうします」":99,"「なるべく早くこちらも調整する」":100,"…やっぱり、なんとなく不機嫌そうかな？[l]\nそれとも照れ隠しなんだろうかな。[l]\n――気にしすぎか。":101,"車に戻ると、宮さんがこちらに気づきにやり、として\n居住まいを正した。":102,"「んむ、思ったより早かったですね。[l]\n感心感心です。[l]\nさ、ちゃっちゃと出発ですよ」":103,"知狡さんの妙に重げな空気など知ってか知らずか、\n宮さんはまるで事も無げである。[l]\n当の知狡さんも薄く笑みを浮かべつ、車に乗り込んでいった。":104,"なんだよ。[l]\nやっぱり僕が気にしすぎだったかな。":105,"僕の乗車を確認すると、車は一路旅館へ、\n『六母屋』へと向かって走り出した。[l]\n":106},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_001.ks","relPath":"/data/scenario/SC_S_001.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":107,"length":107,"percent":100},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[104,1],"note":"完成"},"/data/scenario/SC_S_002.ks":{"data":[["あーもーめんどくさいしねむいしさむいよもー\nなんかさもうやってらんにぇって感じ\nきーちゃももうだっこしていい？","啊——烦死了又困又冷真是的\n怎么说呢已经受不了啦这种感觉\n小姬现在可以抱抱了吗？"],["「だめです」","「不行」"],["あーなによもうけちけちすんなよなー\nさむいんだもんいいじゃんなー","啊——搞什么嘛小气鬼略略略\n人家很冷嘛有什么关系啦"],["…あ[l]\nあそう\nごめごめわかったってば","…啊[l]\n啊对哦\n抱歉抱歉知道啦知道啦"],["ご\nごめんなさい\nもうしません","对\n对不起\n不会再犯了"],["そ\nそれにしてもさ\nもうなんつーの？めんどうくさいなー[l]\nいよいよひにちじょうってやつをじっかんだにぇ\nこんなひがほんとにくるとはねー","话\n话说回来啊\n该怎么说呢？麻烦死了啦[l]\n终于要实地体验那个所谓的日常了呢\n没想到真的会有这种日子啊——"],["あ？[l]\nどしたきーちゃ？","嗯？[l]\n怎么了小姬？"],["ちょ\nちょっと\nなにそのおとめちっくなしせんは？","等\n等一下\n那个少女心爆棚的视线是怎么回事？"],["ややややきーちゃきーちゃ\nなによもー\nあたしってもんがありながら\nだんしなんかにめーうばわれるとは","哎呀呀小姬小姬\n搞什么嘛真是的\n明明有我在场\n居然会被那种男人吸引目光"],["んなんだあのだんしは？[l]\nあうあ？[l]\nなんでとうかちゃがいる？","那男的是怎么回事啊？[l]\n啊呜？[l]\n为什么冬夏酱会在这里？"]],"context":[["SC_S_002.ks/index/1/text"],["SC_S_002.ks/index/3/text"],["SC_S_002.ks/index/5/text"],["SC_S_002.ks/index/7/text"],["SC_S_002.ks/index/9/text"],["SC_S_002.ks/index/11/text"],["SC_S_002.ks/index/13/text"],["SC_S_002.ks/index/15/text"],["SC_S_002.ks/index/17/text"],["SC_S_002.ks/index/19/text"]],"tags":[],"parameters":[[{"start":124,"end":187}],[{"start":201,"end":207}],[{"start":221,"end":257}],[{"start":271,"end":300}],[{"start":314,"end":337}],[{"start":351,"end":436}],[{"start":450,"end":468}],[{"start":482,"end":514}],[{"start":528,"end":589}],[{"start":603,"end":646}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_002.ks","basename":"SC_S_002.ks","indexIds":{"あーもーめんどくさいしねむいしさむいよもー\nなんかさもうやってらんにぇって感じ\nきーちゃももうだっこしていい？":0,"「だめです」":1,"あーなによもうけちけちすんなよなー\nさむいんだもんいいじゃんなー":2,"…あ[l]\nあそう\nごめごめわかったってば":3,"ご\nごめんなさい\nもうしません":4,"そ\nそれにしてもさ\nもうなんつーの？めんどうくさいなー[l]\nいよいよひにちじょうってやつをじっかんだにぇ\nこんなひがほんとにくるとはねー":5,"あ？[l]\nどしたきーちゃ？":6,"ちょ\nちょっと\nなにそのおとめちっくなしせんは？":7,"ややややきーちゃきーちゃ\nなによもー\nあたしってもんがありながら\nだんしなんかにめーうばわれるとは":8,"んなんだあのだんしは？[l]\nあうあ？[l]\nなんでとうかちゃがいる？":9},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_002.ks","relPath":"/data/scenario/SC_S_002.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":10,"length":10,"percent":100},"cellInfo":[null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[5,0],"note":"完成"},"/data/scenario/SC_S_003.ks":{"data":[["お。","哦。"],["あんた何で此処に居るンだ。","你为啥会在这儿啊。"],["「君が●●を殺めてしまったので、\n急場凌ぎで僕が喚ばれたのだよ。[l]\nお嬢様が御身を汚されたのでね」","「因为你杀掉了●●，\n所以临时把我叫来顶替的。[l]\n毕竟大小姐弄脏了身子呢」"],["あ？怪我された？","哈？受伤了？"],["「眼を抉った」","「把眼珠挖出来了」"],["ああ？[l]\nあれは、あれはそういう事か。[l]\n何でそンな事。[l]\nまーいいや。[l]\n取り敢えず腹を満たしたいんだよ。[l]\n脳が空転すると抑えが効かなくなるんだあ。[l]\n言語機能もおかしくな、ななッて、あぐぐぐぐ。","啊啊？[l]\n那个啊，那个是这么回事吗。[l]\n为啥要干这种事。[l]\n嘛——算了。[l]\n总之先把肚子填饱啊。[l]\n脑子空转的话就刹不住车了啦。[l]\n语言功能也乱乱乱、乱套了，咕呜呜呜。"],["……がッ。[l]\nふーっ、[l]\nふーっ、[l]\n――めンどくせぇなあ。","……嘎。[l]\n呼——[l]\n呼——[l]\n――真他妈麻烦死了。"],["無駄に二人も殺す羽目になって、\n祭の開催にまで支障が出たんじゃ面倒臭ぇだろぉおが。[l]\n…あんたらまさか知っててやらせたんじゃないのか。[l]\n●●●●、●●●、●●●…は","白白搞死两个人，\n要是连祭典都办不成可就头疼了吧啊啊。[l]\n…你们该不会是明知故犯吧。[l]\n●●●●、●●●、●●●…"],["殺り損ねたが、[l]\nそいつら全部、東部八相の実戦闘担当だろう。[l]\nまず腕をもがせようとしたンじゃないのか。","是没能杀成，[l]\n但那帮家伙全是东部八相的实战担当吧。[l]\n你们不就是想先废掉他们的胳膊吗。"],["「失礼な事言うね君が勝手に暴走したんだよ。[l]\n薬を処方通り服用しないから。[l]\n大体、実戦闘能力を獲得出来ていればいたで、\nそれだけで勝ちは決まったようなものだったのだよ」","「真失礼啊明明是你擅自暴走的。[l]\n谁让你不按处方吃药。[l]\n大体来说，只要能获得实际战斗能力，\n仅凭这一点就相当于胜券在握了」"],["「●●●と●●●●の物理非物理防壁はどうするつもりです」","「●●●和●●●●的物理非物理防壁你打算怎么解决」"],["「んー？[l]\n貴女方の調伏されたのとは違う。[l]\n現状では●●●を除きツキノモノを餌に稼働する八相の猫は、\n自在に使役できるような代物じゃない。[l]\n式日は別ですがね。[l]\nいずれ、やはり猫そのものを『喰』わなければ意味はないようだし。[l]\n魔眼の質そのものでは無いと言うことか」","「嗯——？[l]\n和您被降服的情况不同。[l]\n现阶段除了●●●之外，以月之物为饵食的八相之猫，\n可不是能随意使唤的东西。[l]\n不过到了仪式日的话就另说了呢。[l]\n终究还是得把猫本身『吃掉』才有意义吧。[l]\n看来问题不在魔眼本身的品质」"],["「もう既知の事象では？[l]\n彼の言い分では無いですが無駄な事をなさったようですね」","「这不是已知事项吗？[l]\n虽然不该由他说，但您似乎做了无用功呢」"],["「僕はテクスト読むより実地経験で理解するタイプなんだけどなあ」","「我比起看文本更习惯通过实地经验来理解啦」"],["「我流だけでは限界がありますよ」","「只靠野路子是有极限的」"],["「そんなことはないよ。[l]\n己が眼で視、手で触れ、頭で理解。[l]\n情報の取捨選択、理論構築、行動反映。[l]\n案ずるより産むが易し。[l]\n年経りしモノの","「才没那回事。[l]\n用双眼去看，用手去触碰，用头脑去理解。[l]\n筛选信息，构建理论，付诸行动。[l]\n船到桥头自然直。[l]\n历经岁月的事物"],["優るる事","其优越性"],["甚だし。[l]\nよきものよ、我が血肉と成れ。[l]\nそれが本来的な『喰う』でしょう」","是极为显著的。[l]\n化为吾血肉吧，良质之物。[l]\n这才是真正的『进食』吧」"],["「純粋論理的思考過程の軽視は身を滅ぼします」","「轻视纯粹逻辑思考过程会要命的」"],["こっちを無視して話進めてんじゃねぇよ。[l]\n何語喋ってんだかわっかんねぇんだよ。","别无视老子自说自话啊。[l]\n根本听不懂你们在放什么屁。"],["あの時は、\n腹減りすぎて脳も空転しててどうしようもなかったし、\nあんたら止めなかっただろぉが。[l]\n男の魔眼はそうなンだろ。[l]\n抑えが効かねぇと。[l]\n知ってて造った癖に何抜かす。","那时候，\n饿得脑子空转根本控制不住，\n你们不也没拦着吗啊啊。[l]\n男人的魔眼不就这德行。[l]\n根本刹不住车。[l]\n明明知道还造出来装什么蒜。"],["「それを実験してるんだけどねえ、僕としては」","「我就是在做实验嘛，从我的立场」"],["よりにもよって人をネズミ扱いかよ。","居然把人当小白鼠耍。"],["「まあ兎に角君には色々して貰うから。[l]\n代価は勿論――」","「总之会安排你做各种事的。[l]\n代价当然是――」"],["「………」","「………」"],["ナナだかナナシだか忘れたけどそんな眼で俺を視るな。","是叫名无（Nana）还是无名（Nanashi）已经忘了，但别用那种眼神看我。"],["「結局二人以上が其処に居れば、軋轢は起きてしまうのだね。[l]\n同類とはいえ他人は他人、反発もすれば排斥も起きるか。[l]\n今まで抑制されてきた事自体が反自然的だったのかもね」","「果然只要超过两人在场就会产生摩擦呢。[l]\n就算是同类但终究是外人，会有冲突也会有排斥。[l]\n或许以往的抑制本身才违反自然」"],["「たとえ有益なものであっても他者のモノは拒絶するのが\n我々の性です」","「即便是有益之物，排斥他者所有\n正是我们的本性」"],["なんかしらねェけど、\nどいつもこいつも信用し合ってねぇなぁ。[l]\n流石オンナの園、俺ら男を消してまでしてここまで――","虽然不知道为啥，\n但你们这帮家伙压根儿就不互相信任啊。[l]\n不愧是女人堆，甚至不惜消灭我们男人也要搞成这样――"],["それにしても杜撰だな。[l]\n穴だらけ隙だらけだ。[l]\n","不过也太草率了吧。[l]\n漏洞百出破绽连连。[l]\n"],["歪だ。[l]\n行き当たりばったりだ。","扭曲。[l]\n完全随心所欲。"],["あんたらもそうだぜ。","你们也是这副德性。"],["どれだけ隠し仰せてきたか知らねーが、\nこの……が、[l]\nここにきて一気にこの有様か。[l]\n徐々に綻んだふうじゃないな。[l]\n事が一気に起こってる。","不知道你们隐瞒了多少事情，\n但这个……[l]\n事到如今突然变成这副惨样。[l]\n不像是逐渐崩溃的样子呢。[l]\n事情是一下子爆发的。"],["あ？[l]\n起きたことはその時点で全て確率十割？[l]\n何それ。[l]\n知らないよ難しい事は。","啊？[l]\n发生的事在那一刻概率都是百分之百？[l]\n啥玩意儿。[l]\n不懂啦这些复杂的东西。"],["「僕らが探してるのは、八相の猫じゃないカミだよ。[l]\nナナから教授されて、僕が実験してるのに、\n結果は知らされないし、\n大体ね、猫の出所自体が怪しかったのだよ」","「我们要找的可是不属于八相之猫的神啊。[l]\n明明从Nana那里学到知识，我也做了实验，\n却不告诉我结果，\n说到底那只猫的来历本身就很可疑」"],["「●の彼女はこの國でも有能な筋と聞きましたから、\n自然に見出す事も或いはあるかと思っていましたが──\nやはりそんな事は無かったのですね。[l]\n『猫の芽』ツェロルを発見隠匿しているのでしょう。[l]\n運び手だった姉妹の一人をどうしたのかまでは、\n分りませんが」","「听说●的她在这个国家也是能力出众的人物，\n还以为或许能自然发现线索——\n结果果然还是不行呢。[l]\n你们肯定把『猫之芽』赛萝洛藏起来了吧。[l]\n至于把负责搬运的姐妹之一怎么样了，\n我就不清楚了」"],["「さて、誰かが嘘吐きなのか、\nまあ僕が言う事じゃないけどね…」","「那么，到底是谁在说谎，\n虽然由我来说也不太合适…」"],["（あんたらふたりとも、自分だけが一番大事そうだけどな）","（你们俩啊，看起来都只把自己当成最重要的）"],["「おっと、そろそろお開きの時間か。[l]\nじゃあ今回分の錬成薬を渡しておこう。[l]\nくれぐれも今の君の姿、視られることの無いように。[l]\n期待してるよ、●●の息子」","「哎呀，差不多该散会了。[l]\n先把这次份的炼成药剂给你吧。[l]\n千万注意别让人看见你现在这副模样。[l]\n我很期待哦，●●的儿子」"]],"context":[["SC_S_003.ks/index/1/text"],["SC_S_003.ks/index/3/text"],["SC_S_003.ks/index/5/text"],["SC_S_003.ks/index/7/text"],["SC_S_003.ks/index/9/text"],["SC_S_003.ks/index/11/text"],["SC_S_003.ks/index/13/text"],["SC_S_003.ks/index/15/text"],["SC_S_003.ks/index/17/text"],["SC_S_003.ks/index/19/text"],["SC_S_003.ks/index/21/text"],["SC_S_003.ks/index/23/text"],["SC_S_003.ks/index/25/text"],["SC_S_003.ks/index/27/text"],["SC_S_003.ks/index/29/text"],["SC_S_003.ks/index/31/text"],["SC_S_003.ks/index/33/text"],["SC_S_003.ks/index/35/text"],["SC_S_003.ks/index/37/text"],["SC_S_003.ks/index/39/text"],["SC_S_003.ks/index/41/text"],["SC_S_003.ks/index/43/text"],["SC_S_003.ks/index/45/text"],["SC_S_003.ks/index/47/text"],["SC_S_003.ks/index/49/text"],["SC_S_003.ks/index/51/text"],["SC_S_003.ks/index/53/text"],["SC_S_003.ks/index/55/text"],["SC_S_003.ks/index/57/text"],["SC_S_003.ks/index/59/text"],["SC_S_003.ks/index/62/text"],["SC_S_003.ks/index/64/text"],["SC_S_003.ks/index/66/text"],["SC_S_003.ks/index/68/text"],["SC_S_003.ks/index/70/text"],["SC_S_003.ks/index/72/text"],["SC_S_003.ks/index/74/text"],["SC_S_003.ks/index/76/text"],["SC_S_003.ks/index/78/text"]],"tags":[],"parameters":[[{"start":164,"end":166}],[{"start":180,"end":193}],[{"start":207,"end":266}],[{"start":280,"end":288}],[{"start":302,"end":309}],[{"start":323,"end":459}],[{"start":475,"end":523}],[{"start":539,"end":638}],[{"start":649,"end":713}],[{"start":729,"end":830}],[{"start":846,"end":874}],[{"start":890,"end":1059}],[{"start":1075,"end":1121}],[{"start":1137,"end":1168}],[{"start":1184,"end":1200}],[{"start":1216,"end":1311}],[{"start":1323,"end":1327}],[{"start":1340,"end":1390}],[{"start":1406,"end":1428}],[{"start":1444,"end":1489}],[{"start":1505,"end":1619}],[{"start":1635,"end":1657}],[{"start":1673,"end":1690}],[{"start":1706,"end":1740}],[{"start":1756,"end":1761}],[{"start":1777,"end":1802}],[{"start":1818,"end":1914}],[{"start":1930,"end":1968}],[{"start":1984,"end":2051}],[{"start":2065,"end":2098}],[{"start":2115,"end":2137}],[{"start":2153,"end":2163}],[{"start":2179,"end":2271}],[{"start":2287,"end":2346}],[{"start":2362,"end":2455}],[{"start":2471,"end":2621}],[{"start":2637,"end":2672}],[{"start":2688,"end":2715}],[{"start":2731,"end":2827}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_003.ks","basename":"SC_S_003.ks","indexIds":{"お。":0,"あんた何で此処に居るンだ。":1,"「君が●●を殺めてしまったので、\n急場凌ぎで僕が喚ばれたのだよ。[l]\nお嬢様が御身を汚されたのでね」":2,"あ？怪我された？":3,"「眼を抉った」":4,"ああ？[l]\nあれは、あれはそういう事か。[l]\n何でそンな事。[l]\nまーいいや。[l]\n取り敢えず腹を満たしたいんだよ。[l]\n脳が空転すると抑えが効かなくなるんだあ。[l]\n言語機能もおかしくな、ななッて、あぐぐぐぐ。":5,"……がッ。[l]\nふーっ、[l]\nふーっ、[l]\n――めンどくせぇなあ。":6,"無駄に二人も殺す羽目になって、\n祭の開催にまで支障が出たんじゃ面倒臭ぇだろぉおが。[l]\n…あんたらまさか知っててやらせたんじゃないのか。[l]\n●●●●、●●●、●●●…は":7,"殺り損ねたが、[l]\nそいつら全部、東部八相の実戦闘担当だろう。[l]\nまず腕をもがせようとしたンじゃないのか。":8,"「失礼な事言うね君が勝手に暴走したんだよ。[l]\n薬を処方通り服用しないから。[l]\n大体、実戦闘能力を獲得出来ていればいたで、\nそれだけで勝ちは決まったようなものだったのだよ」":9,"「●●●と●●●●の物理非物理防壁はどうするつもりです」":10,"「んー？[l]\n貴女方の調伏されたのとは違う。[l]\n現状では●●●を除きツキノモノを餌に稼働する八相の猫は、\n自在に使役できるような代物じゃない。[l]\n式日は別ですがね。[l]\nいずれ、やはり猫そのものを『喰』わなければ意味はないようだし。[l]\n魔眼の質そのものでは無いと言うことか」":11,"「もう既知の事象では？[l]\n彼の言い分では無いですが無駄な事をなさったようですね」":12,"「僕はテクスト読むより実地経験で理解するタイプなんだけどなあ」":13,"「我流だけでは限界がありますよ」":14,"「そんなことはないよ。[l]\n己が眼で視、手で触れ、頭で理解。[l]\n情報の取捨選択、理論構築、行動反映。[l]\n案ずるより産むが易し。[l]\n年経りしモノの":15,"優るる事":16,"甚だし。[l]\nよきものよ、我が血肉と成れ。[l]\nそれが本来的な『喰う』でしょう」":17,"「純粋論理的思考過程の軽視は身を滅ぼします」":18,"こっちを無視して話進めてんじゃねぇよ。[l]\n何語喋ってんだかわっかんねぇんだよ。":19,"あの時は、\n腹減りすぎて脳も空転しててどうしようもなかったし、\nあんたら止めなかっただろぉが。[l]\n男の魔眼はそうなンだろ。[l]\n抑えが効かねぇと。[l]\n知ってて造った癖に何抜かす。":20,"「それを実験してるんだけどねえ、僕としては」":21,"よりにもよって人をネズミ扱いかよ。":22,"「まあ兎に角君には色々して貰うから。[l]\n代価は勿論――」":23,"「………」":24,"ナナだかナナシだか忘れたけどそんな眼で俺を視るな。":25,"「結局二人以上が其処に居れば、軋轢は起きてしまうのだね。[l]\n同類とはいえ他人は他人、反発もすれば排斥も起きるか。[l]\n今まで抑制されてきた事自体が反自然的だったのかもね」":26,"「たとえ有益なものであっても他者のモノは拒絶するのが\n我々の性です」":27,"なんかしらねェけど、\nどいつもこいつも信用し合ってねぇなぁ。[l]\n流石オンナの園、俺ら男を消してまでしてここまで――":28,"それにしても杜撰だな。[l]\n穴だらけ隙だらけだ。[l]\n":29,"歪だ。[l]\n行き当たりばったりだ。":30,"あんたらもそうだぜ。":31,"どれだけ隠し仰せてきたか知らねーが、\nこの……が、[l]\nここにきて一気にこの有様か。[l]\n徐々に綻んだふうじゃないな。[l]\n事が一気に起こってる。":32,"あ？[l]\n起きたことはその時点で全て確率十割？[l]\n何それ。[l]\n知らないよ難しい事は。":33,"「僕らが探してるのは、八相の猫じゃないカミだよ。[l]\nナナから教授されて、僕が実験してるのに、\n結果は知らされないし、\n大体ね、猫の出所自体が怪しかったのだよ」":34,"「●の彼女はこの國でも有能な筋と聞きましたから、\n自然に見出す事も或いはあるかと思っていましたが──\nやはりそんな事は無かったのですね。[l]\n『猫の芽』ツェロルを発見隠匿しているのでしょう。[l]\n運び手だった姉妹の一人をどうしたのかまでは、\n分りませんが」":35,"「さて、誰かが嘘吐きなのか、\nまあ僕が言う事じゃないけどね…」":36,"（あんたらふたりとも、自分だけが一番大事そうだけどな）":37,"「おっと、そろそろお開きの時間か。[l]\nじゃあ今回分の錬成薬を渡しておこう。[l]\nくれぐれも今の君の姿、視られることの無いように。[l]\n期待してるよ、●●の息子」":38},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_003.ks","relPath":"/data/scenario/SC_S_003.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":39,"length":39,"percent":100},"cellInfo":[null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[11,1],"note":"完成"},"/data/scenario/SC_S_004.ks":{"data":[["「何をしてるの！[l]\n馬鹿な真似はお止めなさい！！」","「你在干什么！[l]\n别做这种蠢事了！！」"],["正気なのっ、\nという怒号。","你疯了吗，\n这般怒吼。"],["正気とはなんだろう。","什么才叫疯了呢。"],["自分の眼を抉る事が？","是挖掉自己眼睛这种行为吗？"],["それとも、長年●●●●●を平然と、\n罪も無いものを、\n大量に、重ねているのと、\nどっちが正気だというんだろう。","还是说，是长年将●●●●●视作平常，\n把无辜之人，\n大量地、反复地，\n究竟哪边才算是疯了。"],["私の身体の方が、視た眼が大事だとでもいうのか。[l]\n私のこの姿がそんなに大事なのか。[l]\n忌まわしい。","难道我的身体反倒不如这双看得见的眼睛更重要吗。[l]\n我这副模样就那么重要吗。[l]\n令人作呕。"],["「今はナ……サもまだ遣えないのに！[l]\n今度の祭儀にはあのお方がいらっしゃるのに、\n顔に疵なんかつけて、もう大変だわ！[l]\nこれじゃ合わせる顔が無い…[l]\nミ…ルは私からもう離れたのに、\n仕方ないわ一時中止ね、\nオ……ロはまだ…さ……ように……」","「现在连纳……萨都还不能使用！[l]\n下次祭典那位大人会亲临现场，\n脸上带伤可就糟透了！[l]\n这样根本没法见人…[l]\n米…尔已经离开我了，\n没办法先暂停吧，\no……ro还…没…好……」"],["何を言っているのか、\n","她在说什么，\n"],["只","一"],["管に煩く気色の悪い声、言葉、\nこの女の態度そのものが、\n私に理解を拒絶させる。","味地发出刺耳又令人不适的声音和话语，\n这女人的整个态度，\n都让我拒绝去理解。"],["私の顔がどうだっていうんだ。[l]\nもっと大事なものをあんた達はどれだけ傷付け喪わせてきたんだ。","我的脸怎么样那又算得了什么。[l]\n你们到底伤害和剥夺了多少更重要的东西。"],["たった一人の妄執なのに。[l]\n誤謬ですらない、知っててしてるんだ。","明明只是一个人的执念。[l]\n连谬误都算不上，是明知故犯。"],["私の死が償いになればどんなにいいだろう。[l]\n死んだって構わなかったのに。[l]\n","如果我的死能赎罪该有多好。[l]\n明明死了也无所谓的。[l]\n"],["仮","就"],["令逃避だと云われても、\nあんなものの頂点になど据えられたくは無い。","算被说成是逃避，\n我也不想被推上那种东西的顶点。"],["この狂った視界をもたらすこの眼が、\n無駄とは識っていても。[l]\n視覚視界は単なる補助に過ぎない。[l]\n眼、外皮、外部刺激受容器官の因、脳髄の外界情報処理の果。","这双带来疯狂视野的眼睛，\n即便知道是徒劳。[l]\n视觉不过是辅助手段罢了。[l]\n眼、表皮、外部刺激感受器官为因，脑髓处理外界信息为果。"],["ミ●ルとタ●●サ。[l]\n分かたれた象徴だ、見立てだ。[l]\n認識能こそが魔眼質。[l]\nハコの中の●●を視、認識する為の──","米●尔与达●●萨。[l]\n被分割的象征，此为比拟。[l]\n魔眼质的核心正是认知能力。[l]\n为了看见并认知箱中的●●──"],["そう、だから事実、\nそこのそれがずっと視えるんだ。","对，所以事实上，\n那里的那个我一直都能看见。"],["私の眼球が転がった先にあるその、\n二相の紙。[l]\n二相の神。[l]\n二相の猫。","在我眼球转动方向的那里，\n二相之纸。[l]\n二相之神。[l]\n二相之猫。"],["痛い。[l]\n痛い。[l]\nじん、じん、じん。[l]\n黒く空いているであろう眼窩から、\n熱い何かがずきずきと身体を巡る。","好痛。[l]\n好痛。[l]\n一阵阵地。[l]\n从想必已是漆黑空洞的眼窝里，\n某种灼热的东西抽痛着流遍全身。"],["分かってるんだ、無駄な事だとは。[l]\n三相が居なくても四相が代替するだろう。[l]\nそうでなくても私が私である限り、\nこのシュからもバクからも逃れられはしない。","我明明很清楚，这是徒劳的事。[l]\n就算没有三相也会有四相来替代。[l]\n即便如此只要我还是我，\n就无法从这 “囚” 与 “罚” 中逃脱。"],["だからこれは、抗議行動でしかない。","所以这不过是抗议行动罢了。"],["でも。[l]\nああ、何かすっきりとした気分には為れた気がする。[l]\n禁忌の破壊は凶暴な","但是。[l]\n啊，感觉心情倒是畅快了些。[l]\n将禁忌破坏是一种狂暴的"],["快","快"],["楽だ。[l]\nこれが私の、本当の――","感。[l]\n这才是我的，真正的──"],["ずき。[l]\n血の臭い、鼻腔の深奥に鉄の味。[l]\nずきずき。","抽痛。[l]\n血的气味，鼻腔深处铁锈的味道。[l]\n抽痛不止。"],["しかし、命の代替は命じゃなく、\n何をしても償いには。[l]\n穴を埋める事では。","但生命的替代品终究不是生命，\n无论做什么都无法补偿。[l]\n无法填补空洞。"],["そうか。","这样啊。"],["これからは。","从今往后。"],["この力は私で止める。[l]\n馬鹿げた因習で殺められた私たちの兄等に対するせめてもの\n手向け。","这股力量由我来阻止。[l]\n这至少是对那些因愚蠢陋习而被杀害的兄长们，\n献上的一点祭奠。"],["このかみのねこ諸共に消えて、\nころしを止める為のころしはしない。[l]\n猫たちを、私が。","让这些该死的猫连同一切都消失吧，\n不为制止杀戮而杀戮。[l]\n猫们，就由我来。"],["なら、この姿に生まれたのも定めと思おう。","那么，就当生为这副模样是一种宿命吧。"],["痛みが思考を掻き乱す。[l]\n衝動の波が、雫の落ちた","疼痛扰乱思绪。[l]\n冲动之潮如同水滴落于"],["水","水"],["面のようにさざなむ、\n波紋がずきずきと瞼の裏の光のように閃いては消える、","面般泛起涟漪，\n波纹阵阵悸动，像眼睑内侧的光一般闪烁又消逝。"],["痛い、\n痛い、\n痛い。[l]\n畜生。","好痛，\n好痛，\n好痛。[l]\n畜生。"],["「とにかく医者に！[l]\n病院に連れて行きます！！[l]\nこの際仕方ありません、隣町まで――\nいえ、駄目ね、","「总之先找医生！[l]\n我带你去医院！！[l]\n现在管不了那么多了，哪怕要去邻镇──\n不，不行呢，"],["道","道"],["具は、\nあの","具你，\n快去联系"],["娘に連絡を――」","那个姑娘──」"],["母様。[l]\nおぞましい女。[l]\nいや、母様の母様もその母様もその母様も──\nだがもう少しのあいだだけ、\n貴女達の因習に倣っておいてあげる。","母亲大人。[l]\n令人作呕的女人。[l]\n不，母亲的母亲还有母亲的母亲的母亲——\n但就再稍微忍耐一会儿，\n我会配合你们那些陈规陋习。"],["猫がこっちを視ている。[l]\n母様の枷から離れたあの猫が。","猫在看着这边。[l]\n那只脱离母亲大人枷锁的猫。"],["おいで。[l]\n私の血を受けて。[l]\n月のものがわたしたちをつなぐ。[l]\n貴方の名は――ミハル。","过来。[l]\n接受我的血液。[l]\n月之物将我们相连。[l]\n你的名字是――米哈尔。"],["にそうみはる、識式は死期色の檻、織と如きもの見張りたる。[l]\nミ・コネカヤナサンコネキャラナサ・ワ──\n宜しくミハル。おまえと繋がるのは私。","二相三春，识式为死期色之槛，如织物般将其守望。[l]\nmi・ko ne ka ya na san ko ne kya ra na sa・wa——\n请多指教米哈尔。在此我与你缔结。"],["ああ、何故思い出すんだ。[l]\nあの頃逢った、あの少年。[l]\n彼に逢ってからたくさんのことが。","啊，为何会想起来。[l]\n那时遇见的，那个少年。[l]\n遇见他之后发生了太多事。"],["彼は雫だ。[l]\n濁ったみどろをさざめかせ、停止した時間を動かす針だ。[l]\n父様の様な安らぎ──","他是水滴。[l]\n是那搅动着浑浊泥泞、让停滞的时间重新运转的指针。[l]\n如同父亲大人般的安宁——"],["ふふ。[l]\nまた逢いたいな。[l]\n確か名は●●●●●●●、","呵呵。[l]\n真想再见一次啊。[l]\n记得名字是●●●●●●●，"],["……アア。[l]\n血がだくだくと流れ出て、\nこれも、\nミハルの餌になるのだろうか。","……啊啊。[l]\n鲜血咕嘟咕嘟地涌出，\n这些，\n也会成为米哈尔的饲料吧。"],["「キ…ムラの…を応急処置として……」","「奇...姆拉的…作为应急处理……」"],["ふふふ。[l]\nやっぱり、\n覚悟だけでは痛みは和らがないね。[l]\n","呵呵呵。[l]\n果然，\n光有觉悟是缓解不了疼痛的呢。[l]\n"],["愈","隐"],["愈鈍痛が激しくなる。[l]\n鈍器で顔面や頭や首筋を殴られているかのよう。[l]\nこれは、しかし生きている証でもある。[l]\n居たい、痛い、遺体。[l]\nああ。","隐地，钝痛愈发剧烈。[l]\n就像被钝器击打面部、头部和后颈。[l]\n但这正是活着的证明。[l]\n存在、疼痛、遗体。[l]\n啊啊。"],["そして私は気を失った。[l]\n","接着我便失去了意识。[l]\n"]],"context":[["SC_S_004.ks/index/1/text"],["SC_S_004.ks/index/3/text"],["SC_S_004.ks/index/5/text"],["SC_S_004.ks/index/7/text"],["SC_S_004.ks/index/9/text"],["SC_S_004.ks/index/11/text"],["SC_S_004.ks/index/13/text"],["SC_S_004.ks/index/15/text"],["SC_S_004.ks/index/18/text"],["SC_S_004.ks/index/20/text"],["SC_S_004.ks/index/22/text"],["SC_S_004.ks/index/24/text"],["SC_S_004.ks/index/26/text"],["SC_S_004.ks/index/29/text"],["SC_S_004.ks/index/31/text"],["SC_S_004.ks/index/33/text"],["SC_S_004.ks/index/35/text"],["SC_S_004.ks/index/37/text"],["SC_S_004.ks/index/39/text"],["SC_S_004.ks/index/41/text"],["SC_S_004.ks/index/43/text"],["SC_S_004.ks/index/45/text"],["SC_S_004.ks/index/47/text"],["SC_S_004.ks/index/49/text"],["SC_S_004.ks/index/51/text"],["SC_S_004.ks/index/53/text"],["SC_S_004.ks/index/55/text"],["SC_S_004.ks/index/57/text"],["SC_S_004.ks/index/59/text"],["SC_S_004.ks/index/61/text"],["SC_S_004.ks/index/63/text"],["SC_S_004.ks/index/65/text"],["SC_S_004.ks/index/67/text"],["SC_S_004.ks/index/69/text"],["SC_S_004.ks/index/71/text"],["SC_S_004.ks/index/73/text"],["SC_S_004.ks/index/75/text"],["SC_S_004.ks/index/77/text"],["SC_S_004.ks/index/79/text"],["SC_S_004.ks/index/81/text"],["SC_S_004.ks/index/83/text"],["SC_S_004.ks/index/85/text"],["SC_S_004.ks/index/87/text"],["SC_S_004.ks/index/89/text"],["SC_S_004.ks/index/91/text"],["SC_S_004.ks/index/93/text"],["SC_S_004.ks/index/95/text"],["SC_S_004.ks/index/97/text"],["SC_S_004.ks/index/99/text"],["SC_S_004.ks/index/101/text"],["SC_S_004.ks/index/104/text"],["SC_S_004.ks/index/106/text"],["SC_S_004.ks/index/108/text"]],"tags":[],"parameters":[[{"start":99,"end":130}],[{"start":144,"end":161}],[{"start":175,"end":185}],[{"start":199,"end":209}],[{"start":223,"end":290}],[{"start":304,"end":365}],[{"start":379,"end":529}],[{"start":543,"end":554}],[{"start":570,"end":571}],[{"start":583,"end":630}],[{"start":644,"end":696}],[{"start":710,"end":748}],[{"start":762,"end":808}],[{"start":824,"end":825}],[{"start":836,"end":873}],[{"start":887,"end":980}],[{"start":994,"end":1069}],[{"start":1083,"end":1112}],[{"start":1126,"end":1178}],[{"start":1192,"end":1268}],[{"start":1282,"end":1375}],[{"start":1389,"end":1406}],[{"start":1420,"end":1472}],[{"start":1483,"end":1484}],[{"start":1496,"end":1518}],[{"start":1532,"end":1571}],[{"start":1585,"end":1632}],[{"start":1646,"end":1650}],[{"start":1664,"end":1670}],[{"start":1684,"end":1738}],[{"start":1752,"end":1804}],[{"start":1818,"end":1838}],[{"start":1852,"end":1882}],[{"start":1894,"end":1895}],[{"start":1906,"end":1946}],[{"start":1960,"end":1990}],[{"start":2004,"end":2070}],[{"start":2082,"end":2083}],[{"start":2095,"end":2105}],[{"start":2116,"end":2124}],[{"start":2138,"end":2225}],[{"start":2239,"end":2272}],[{"start":2286,"end":2348}],[{"start":2362,"end":2441}],[{"start":2455,"end":2511}],[{"start":2525,"end":2582}],[{"start":2596,"end":2635}],[{"start":2649,"end":2702}],[{"start":2716,"end":2734}],[{"start":2748,"end":2790}],[{"start":2806,"end":2807}],[{"start":2819,"end":2914}],[{"start":2945,"end":2960}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_004.ks","basename":"SC_S_004.ks","indexIds":{"「何をしてるの！[l]\n馬鹿な真似はお止めなさい！！」":0,"正気なのっ、\nという怒号。":1,"正気とはなんだろう。":2,"自分の眼を抉る事が？":3,"それとも、長年●●●●●を平然と、\n罪も無いものを、\n大量に、重ねているのと、\nどっちが正気だというんだろう。":4,"私の身体の方が、視た眼が大事だとでもいうのか。[l]\n私のこの姿がそんなに大事なのか。[l]\n忌まわしい。":5,"「今はナ……サもまだ遣えないのに！[l]\n今度の祭儀にはあのお方がいらっしゃるのに、\n顔に疵なんかつけて、もう大変だわ！[l]\nこれじゃ合わせる顔が無い…[l]\nミ…ルは私からもう離れたのに、\n仕方ないわ一時中止ね、\nオ……ロはまだ…さ……ように……」":6,"何を言っているのか、\n":7,"只":8,"管に煩く気色の悪い声、言葉、\nこの女の態度そのものが、\n私に理解を拒絶させる。":9,"私の顔がどうだっていうんだ。[l]\nもっと大事なものをあんた達はどれだけ傷付け喪わせてきたんだ。":10,"たった一人の妄執なのに。[l]\n誤謬ですらない、知っててしてるんだ。":11,"私の死が償いになればどんなにいいだろう。[l]\n死んだって構わなかったのに。[l]\n":12,"仮":13,"令逃避だと云われても、\nあんなものの頂点になど据えられたくは無い。":14,"この狂った視界をもたらすこの眼が、\n無駄とは識っていても。[l]\n視覚視界は単なる補助に過ぎない。[l]\n眼、外皮、外部刺激受容器官の因、脳髄の外界情報処理の果。":15,"ミ●ルとタ●●サ。[l]\n分かたれた象徴だ、見立てだ。[l]\n認識能こそが魔眼質。[l]\nハコの中の●●を視、認識する為の──":16,"そう、だから事実、\nそこのそれがずっと視えるんだ。":17,"私の眼球が転がった先にあるその、\n二相の紙。[l]\n二相の神。[l]\n二相の猫。":18,"痛い。[l]\n痛い。[l]\nじん、じん、じん。[l]\n黒く空いているであろう眼窩から、\n熱い何かがずきずきと身体を巡る。":19,"分かってるんだ、無駄な事だとは。[l]\n三相が居なくても四相が代替するだろう。[l]\nそうでなくても私が私である限り、\nこのシュからもバクからも逃れられはしない。":20,"だからこれは、抗議行動でしかない。":21,"でも。[l]\nああ、何かすっきりとした気分には為れた気がする。[l]\n禁忌の破壊は凶暴な":22,"快":23,"楽だ。[l]\nこれが私の、本当の――":24,"ずき。[l]\n血の臭い、鼻腔の深奥に鉄の味。[l]\nずきずき。":25,"しかし、命の代替は命じゃなく、\n何をしても償いには。[l]\n穴を埋める事では。":26,"そうか。":27,"これからは。":28,"この力は私で止める。[l]\n馬鹿げた因習で殺められた私たちの兄等に対するせめてもの\n手向け。":29,"このかみのねこ諸共に消えて、\nころしを止める為のころしはしない。[l]\n猫たちを、私が。":30,"なら、この姿に生まれたのも定めと思おう。":31,"痛みが思考を掻き乱す。[l]\n衝動の波が、雫の落ちた":32,"水":33,"面のようにさざなむ、\n波紋がずきずきと瞼の裏の光のように閃いては消える、":34,"痛い、\n痛い、\n痛い。[l]\n畜生。":35,"「とにかく医者に！[l]\n病院に連れて行きます！！[l]\nこの際仕方ありません、隣町まで――\nいえ、駄目ね、":36,"道":37,"具は、\nあの":38,"娘に連絡を――」":39,"母様。[l]\nおぞましい女。[l]\nいや、母様の母様もその母様もその母様も──\nだがもう少しのあいだだけ、\n貴女達の因習に倣っておいてあげる。":40,"猫がこっちを視ている。[l]\n母様の枷から離れたあの猫が。":41,"おいで。[l]\n私の血を受けて。[l]\n月のものがわたしたちをつなぐ。[l]\n貴方の名は――ミハル。":42,"にそうみはる、識式は死期色の檻、織と如きもの見張りたる。[l]\nミ・コネカヤナサンコネキャラナサ・ワ──\n宜しくミハル。おまえと繋がるのは私。":43,"ああ、何故思い出すんだ。[l]\nあの頃逢った、あの少年。[l]\n彼に逢ってからたくさんのことが。":44,"彼は雫だ。[l]\n濁ったみどろをさざめかせ、停止した時間を動かす針だ。[l]\n父様の様な安らぎ──":45,"ふふ。[l]\nまた逢いたいな。[l]\n確か名は●●●●●●●、":46,"……アア。[l]\n血がだくだくと流れ出て、\nこれも、\nミハルの餌になるのだろうか。":47,"「キ…ムラの…を応急処置として……」":48,"ふふふ。[l]\nやっぱり、\n覚悟だけでは痛みは和らがないね。[l]\n":49,"愈":50,"愈鈍痛が激しくなる。[l]\n鈍器で顔面や頭や首筋を殴られているかのよう。[l]\nこれは、しかし生きている証でもある。[l]\n居たい、痛い、遺体。[l]\nああ。":51,"そして私は気を失った。[l]\n":52},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_004.ks","relPath":"/data/scenario/SC_S_004.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":53,"length":53,"percent":100},"cellInfo":[[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[51,0],"note":"完成"},"/data/scenario/SC_S_005.ks":{"data":[["さて、\nいーくんが大学を辞して、\n北の地に出向いてから何日たったろう。","话说，\n自从饭君从大学退学，\n北上赴任已经过去多少天了。"],["まあ曜日だの何だの、\n時間感覚なんかとうの昔に無くした俺だから、\n大して意味は無いんだが。","反正星期几什么的，\n我早就失去时间概念了，\n倒也没什么意义。"],["とは言えこの場合、\nイコール俺と彼女、かれおんとの出会いからの期間と\n重なるので、多少は思い入れあるかな。","不过这种情况下，\n等同于我和她——卡蕾欧相遇以来的时长，\n所以多少有点感慨吧。"],["……そうか、思ったよりは経ってないんだな。[l]\n結構いったような気がしてたが、\nひと月経ってもいなかったか。[l]\n俺とかれおんの日々は濃密だけどな。","……这样啊，其实还没过多久。[l]\n总觉得已经过了挺长时间，\n结果连一个月都不到吗。[l]\n不过我和卡蕾欧的日子倒是很充实。"],["今日は取り敢えず、新学期早々休講がわんさと発生したので、\n大変に困った。[l]\nＧＷもまだ先だっていうのに、\n教授ら何してるんだかな。","今天因为新学期刚开始就大量停课，\n真是够呛。[l]\n明明连黄金周都还没到，\n教授们到底在搞什么啊。"],["専攻はともかく、偶然だろうがよりによって、\n俺の他学の選択授業が集中してそんなだって何でだ。[l]\nいじめじゃないかと思ったな。","专业课就算了，偏偏我选的跨学科选修课，\n居然全都集中在这时候停课，太离谱了吧。[l]\n简直像在针对我。"],["俺、在学中にしていーくんが自主退学したこの大学は、\n馬鹿みたいに敷地が広い為に、\n学棟間の移動をみんな自転車で行うのが常だ。","我就读的这所大学——饭君主动退学的地方，\n因为占地面积大得离谱，\n平时大家都骑自行车往返各教学楼。"],["一限目始まる前なんかはなかなか壮観なシーンを拝めるのだが、\nつまりは移動がすげえ面倒くさいという事だ。","第一节课前那场面还挺壮观的，\n不过也说明通勤超级麻烦。"],["休講が教室やら実験室前まで行ってから判明しても大変に\nげんなりするだけで、\n非常に悲しい。","就算停课通知要走到教室或实验室前才确认也很麻烦\n光是想想就够烦的，\n非常悲伤。"],["同期生から情報もなかったし、\nまァそんな日もあらァな。[l]\n出席心配するのはもっと後なってからだろうし、\nいーくんの事を思えば多少の事は甘んじられるね。","同期生那里也没收到消息，\n嘛～总会有这种日子啦。[l]\n担心出勤率什么的还早着呢，\n想到饭君的话这点小事还是能忍的。"],["「とは言え、だ……[l]\nこれは面倒くさいスなあ……」","「话虽如此……[l]\n这也太麻烦了吧……」"],["二期以降に楽しようと一期目に結構単位とれるように\n組んだから６限までみっちりあるはずが、\n午前は３限、午後は６限のみという非常に半端な状況にある。","为了能在二期之后轻松点 特意在一期多修了些学分\n所以本该排满六节课的，\n现在却变成上午三节、下午仅六节的尴尬局面。"],["「しょうがねえ、\nいつものとこか……[l]\nこんな時間からじゃ誰もいねえだろうけど」","「没办法，\n还是去老地方吧……[l]\n不过这个点去估计鬼影都没」"],["俺はアパートから一番遠い専攻の学棟群、その中のとある一棟から出て、山程駐輪してある自転車から己の愛車を選び出し、ある場所へと漕ぎ出した。","我从离公寓最远的专业教学楼群中某栋出来，在成堆的自行车里挑出自家爱车，朝着某个地方蹬去。"],["俺といーくんが出会ったサークルのブースがある、\n文化系サークル棟だ。","那里有我和饭君相遇的社团摊位，\n也就是文化类社团大楼。"],["部室ってか、仕切のないワンフロアを、\n各サークルがロッカーやなんらで区分けしてるだけなので、\nそう呼ぶ方がしっくりくる。","说是社团活动室，其实也就是用储物柜之类的东西\n把一整层没有隔断的空间分隔开来而已，\n这么叫（译注：指前文的 “社团摊位”）反而更贴切。"],["まあ文化系サークルとは言っても、\nどこの大学にもある漫研みたいなもんで、\n創作だけでなく研究と言う名の鑑賞も活動内容に入る。","虽说是文化类社团，\n其实就跟每所大学都有的漫画研究会差不多，\n活动内容不光有创作，还包括以研究为名的鉴赏。"],["いーくんはサークルに在籍はしてたが、\n俺等の属するそっち系の人間だった訳でなく、","饭君虽然登记在社团名册上，\n但和我们不是一路人，"],["ラノベだのでもない、新書だのハードカバーだの、\n文庫小説は海外翻訳モノだの、あとは●●事典といった資料系、\nそれもアングラネタ系から物理生物人文言語に至るまで、\n俺等受けするような表紙とは全く別次元の本を好んで読んでいた。","他既不读轻小说也不看新书精装书，\n文库本只读海外翻译作品，剩下的就是●●百科这类资料书，\n从地下题材到物理生物人文语言领域，\n他专挑那些和我们口味完全不在一个次元的书来读。"],["そんないーくんが何でうちらのサークル来たのかは\nよくわからんが、","这样的饭君为什么会来我们社团\n实在搞不懂，"],["何か入学後の勧誘時期に、ブースから流れてた歌（アニソン）が\n聞いたことがあるやつだったとかなんとか、\nなかなか珍しい理由だった気がする。","好像是因为招新时听到摊位放的动漫歌\n恰好是他听过的曲子什么的，\n记得是个相当稀罕的理由。"],["結局一年で退学したが、\n俺以外とは馬も合って無かったようだから\n逆に良かったんじゃないか。[l]\n俺との出会いだけがフラグイベントだと思ってくれ。[l]\n俺にしたって、かれおんと出会ったのはいーくん経由だしな。","结果一年就退学了，\n不过他好像除了我以外跟谁都合不来\n这样反而更好吧。[l]\n你就当只有和我的相遇才是flag事件。[l]\n对我来说，认识卡蕾欧也是通过饭君的关系。"],["と、まあ俺の周辺事情をあんまり掘り下げたところで\n無聊の慰めにはならないな。","不过嘛，就算深挖我这些周边琐事\n也排解不了无聊啊。"],["結局ブースのスケブに色々落書きしてるうちに、\n時間が来て行ったり来たり、","结果在摊位的素描本上乱涂乱画期间，\n到了时间，大家就这么来来去去的，"],["大体今日はミーティングの日だから、\n６限終わってからまた此処なんだ。[l]\n日がな一日たむろってんな俺。","因为今天基本是开会日，\n第六节课结束后还得来这儿。[l]\n我这一天简直就是在这儿耗着了啊。"],["という今日、\n諸々偶然の重なった大学での一日の締めくくり間際、","就在今天，\n诸多偶然叠加之下，大学一日临近尾声时，"],["サークルのミーティングが終わって棟を出ると、\n入り口にかれおんが立っていたのだった。","社团会议结束后刚走出大楼，\n就看到卡蕾欧站在入口处。"],["みんなと適当に飯を喰った後誰かのアパート行って、\n春のイベント合わせの本の打ち合わせだのやりつつ、","和大家随便吃完饭后去了某人公寓，\n边做春季活动企划书的讨论，"],["ゲームだの、先輩の持ってきたよく分からないマイナーな、\nかつしっかり新作のOVAだのを観せられたり……","边打游戏、玩前辈带来的不知所云的小众作品、\n还被强迫看些制作还算精良的新作OVA……"],["のはずだったんだが。[l]\n今日彼女と逢う約束は特に無い。","本应如此的。[l]\n今天没有和她见面的特别约定。"],["「あ、雪鳴さん、[l]\n急な話なんですが。","「啊，雪鸣先生，[l]\n突然有件事想拜托您。"],["ちょっと知り合い……というか、[l]\n同僚……あいえ、同業者を紹介しても？」","想给您介绍些熟人……或者说，[l]\n同事……不对，是同行业的人可以吗？」"],["「おー。[l]\nいいすよ。[l]\nほんと急だけど。","「哦。[l]\n没问题啊。[l]\n不过确实挺突然的。"],["脈絡なしっすけど。[l]\nかれおんはそういう面白い女子だから\nノープロ。","虽然毫无关联啦。[l]\n卡蕾欧就是这种有趣的女生\n没问题的。"],["おｋ。[l]\nお気になさらず」","OK。[l]\n请别在意」"],["今日は眼鏡じゃなくてコンタクトの日か、勿体ないのう。[l]\n……そもそも彼女は出会ったときから、\n携帯電話持ってなかった訳だが、未だ導入して頂けていない。","今天没戴眼镜改戴隐形啊 真可惜呢。[l]\n……说到底她从我们初次见面时\n就没有手机 到现在也没配备。"],["基本的には、例のいーくんのバイト先の本屋の固定電話を\n借用しているらしい。","基本上都是借用\n那位饭君打工书店的固定电话。"],["故にこういった急用の場合、\n彼女が在宅中に思いついたのでは無い限り、\n公衆電話使うかこうしてアポ無しで直に来るしかない。","所以像这种紧急情况\n除非她正好在家时想到\n就只能用公用电话或者像这样不预约直接上门。"],["最近はめっきり電話ボックス減ったし、\n俺がこの時間此処にいることは分かってるし、\nだから別にいい。","最近电话亭越来越少\n她知道我这个时间会在家\n所以倒也无所谓。"],["「あうあ、怒ってますかっ。[l]\nそ、そのうちお詫びの埋め合わせを…」","「啊呜啊 生气了吗。[l]\n那、那个改天会补偿道歉的…」"],["いや、怒ってるとしても、\n埋め合わせとかで詫びじゃなくて、\n単に携帯電話を導入さえしてくれれば早いんだが。","不 就算真生气了\n也不需要什么补偿道歉\n只要肯配部手机就解决了。"],["「あーそう、[l]\nまあ、じゃあ後ろのお知り合いの方々には\n聞かせられないような事で是非。","「啊这样啊[l]\n那接下来就说点不好让后面的\n熟人们听到的事吧。"],["いや嘘だけどね。[l]\n別になんともおもってないす」","开玩笑的啦。[l]\n我完全没在意哦」"],["携帯電話のない時代というのも間違いなく存在していた訳だから、\n当時を思えば生死に関わる問題という訳でもないが、\n……まあ、","毕竟确实存在没有手机的时代\n按那时候的标准这也不算生死攸关的问题\n……不过"],["彼女に関しては格別『主義』があっての事じゃないようだし、\nリスクとリターンのバランスでみたとて、\nそんなに渋る理由も無いと思うんだが、\n単に面倒なのか、そっち系アレルギーなのか――","她看起来也不是有什么特别的『主义』\n从风险收益比来看\n实在想不通为什么要这么抗拒\n是单纯嫌麻烦 还是对电子产品过敏――"],["近くにデジタル馬鹿でも居るのかね。[l]\n俺の所為じゃないのは確かだし、\n寧ろ俺の属するこっち側の人間としての素質は、全然有望なんだが。","难不成身边有个数码白痴？[l]\n肯定不是我的原因\n倒不如说作为我这边阵营的成员，明明很有潜力的。"],["「はうっ、[l]\nそう言ってても絶対おかずが一品減ったり\nデザートの質が下がったりするですよ！？[l]\nかれお的にそれは厳しっ」","「呜诶[l]\n嘴上这么说绝对会少一道菜\n或者甜点降档次的！？[l]\n对卡蕾欧来说这很严重啦」"],["「んな事ないっすよ被害妄想だって。[l]\nほれ、後ろの方々置いてけ堀にしてどうすんの。","「才不会啦被害妄想症吗。[l]\n喂，把后面那群人晾着不管合适吗。"],["折角俺が諸事情を察して、色々突っ込まずに話を進めようと\nしてんのに」","难得我体察状况\n都没多问就配合话题」"],["電気街裏通りとかの中古屋とかで、\nレアかつ格安なお宝見つけるのも得意だし、\nそういう","在电器街后巷的中古店里\n她特别擅长淘稀有又便宜的宝贝\n这种"],["才","才"],["能持ちなのは確かだ。","能确实很突出。"],["鼻が利く、という能力はあらゆる局面において、\n非常に有用なスキルであることは言うまでもない。","嗅觉灵敏这种能力在任何场合，\n都是极其有用的技能毋庸置疑。"],["結局、彼女はキャパシティ内での能力ポイント割り振りが、\nやや偏ってるんだろう。","说到底还是她能力值分配\n有点偏科吧。"],["しかし、\n平均的に割り振った使えない汎用ユニットよりは、\n何かに特化した方が使い物になる、事が多い。[l]\n無論システム的にパーティープレイ前提の環境下においては、だが。","不过，\n比起平均分配的无能通才，\n专精某项反而更实用，多数情况下。[l]\n当然前提是系统设定需要组队作战的环境。"],["そんで、他のスキル担当が後ろの方々、という事かな、\nこれは。","所以其他技能就交给后面那群人\n是这样吗。"],["「……何か引っかかりますけど[l]\n","「……总觉得被敷衍了[l]\n"],["概 ねサンクスですっ。[l]\nみんな、こっちにかまーん」","不过大体上3Q啦。[l]\n各位，看这边啦」"],["「都合の好い男とお呼びあれ、てスルーすか。[l]\nおあ」","「当我是个‘方便好用的男人’，就这么忽略过去吧。[l]\n哦对了」"],["相変わらず思考と喋りの機構をリンクさせないでいるのは、\n当人には分かんないとはいえ良心が咎めるねー。","依旧不把思考系统和说话系统链接起来的毛病，\n虽说本人没自觉但挺让人良心不安的啊ー。"],["気持ちが入ってないという事は断じてないが、\n一つの事に全注力してないのは確かだからな。[l]\nま、それはそれ。","绝非没有投入感情，\n但确实没对一件事物全神贯注啊。[l]\n嘛，这另当别论。"],["相手の事情を察する事が出来るのは、ヒトの徳というものだ。[l]\n察した上でそっとしとくか敢えて突っ込むかはまた別の問題、\n人品骨柄経験値がものをいう。","能体察对方处境算是人类的美德。[l]\n体察后选择默默守护还是刻意介入又是另一回事，\n全看个人品性骨气经验值说话。"],["ん。[l]\n使い方間違ってるか？[l]\nまあ、そんなことはどうでもいい。[l]\n取り敢えず現実に眼を向けますと、","嗯。[l]\n用错方式了吗？[l]\n算了，这种事无所谓。[l]\n总之先把视线转回现实，"],["「（この國の人間じゃないな――）」","「（不是这个国家的人呢――）」"],["「あー、\nまあ驚かれるのも無理はなっしんぐでして、\nそのですね」","「啊ー，\n嘛会被吓到也是理所当然的，\n就是说呢」"],["「いや、キャンパス内では割と見かけるから\n驚いてる訳じゃ……いや、","「不，在校园里还算常见\n倒不是被吓到……不对，"],["やっぱ驚いたわ。[l]\nどうもどうも。[l]\nぐだふたぬーん」","果然还是被吓到了。[l]\n幸会幸会。[l]\n古德阿夫塔努嗯」"],["インターネットが無かった時代、\nＰＣがフロッピーでなんとかなってた時代、\nＤＶＤでなくＶＴだった時代、","在没有互联网的时代，\n电脑靠软盘将就的时代，\n用VT录像带而非DVD的时代，"],["ＣＧは少ない色数でドット打ちしていた時代、\nＣＤでなくレコードだった時代、\nテレビがモノクロだった時代、","用少量色块点阵做CG的时代，\n听黑胶唱片而非CD的时代，\n电视还是黑白的时代，"],["その過渡期を見届けている者としては、\n感慨に耽って昔は良かった今は駄目だ、\nと思うこともないではない。","作为见证过过渡期的人，\n偶尔也会沉浸在怀旧情绪里觉得今不如昔，\n这种想法倒也不是没有。"],["いーくんと話した時は、\n昔と今、という括りでのカテゴライズ自体が認識として不具合が\nあるという方向になったか。","和饭君聊天时，\n发现以'过去与现在'为框架的分类认知本身\n似乎存在问题来着？"],["確かに昔だろうと今だろうと、\n良いものは良いし駄目なモンは駄目だ。","确实无论过去现在，\n好东西就是好东西烂货就是烂货。"],["「ばんわーっ」","「晚好ー」"],["「初めまして」","「初次见面」"],["「ども」","「你好」"],["「………（会釈）」","「………（点头致意）」"],["ツールが","对那些"],["端から用意されている世代は個人的に趣味が合わないから、積極的にかかずらりたいとは思わないが、","工具唾手可得的世代，我个人因兴趣不合并不想主动接触，"],["年寄りが若造と折り合いが合わないのは\nいつの時代にもある不毛な価値観の相違ではある。[l]\n主観がどの世代に属するかだ。","但老古董和年轻人合不来\n不过是任何时代都存在的无谓价值观差异。[l]\n关键在主观意识属于哪个世代。"],["「あれ、\n喋りも堪能ですね。","「哎呀，\n说话也很流利呢。"],["ども、\nこっちの彼氏してます、\n大神雪鳴です。","你好，\n我是这位的男友，\n大神雪鸣。"],["ゆっきーとお呼び下さい。[l]\nや、もうどうとでもお好きなように」","请叫我阿雪就好。[l]\n啊，随您怎么称呼都行」"],["まあ、過渡期を戦った人等は、そのしんどさを解消すべく尽力して、結果、後代の奴等がそういう苦労を知らずに育つという、","嘛，奋战过渡期的人们为消除不便竭尽全力，结果后辈们得以在不知艰辛中成长——"],["先代の思惑通りにはなったのではあるのだけれど、\nいわば、","虽然确实符合前辈们的预期，\n但换言之，"],["御","也"],["緩環境育ちが出来上がる訳で、","就造就了温室培育的一代，"],["そんな本末転倒みたいな事は世界あらゆる局面で起きるのだから、\nどの世代であれ、先代からの受け継ぎを利用してる事には変わりなく、","这类本末倒置的现象在世界各处上演，\n所以无论哪个世代，本质上都在享用前人的遗产，"],["でないといちいちリセットされゼロからの出発になるから\n当たり前なんだが、","否则每次都要重置从零开始\n虽是理所当然，"],["先輩にやられたしごきが嫌だったからって、\n後輩を野放しにしといた所で何もならない。","但若因厌恶前辈的严苛管教，\n就对后辈放任自流也毫无意义。"],["単なる甘やかしになってぐだぐだになるだけだった。[l]\nという場面も高校くらいの年頃には何度か視てきた。","只会宠出废柴把事情搞砸。[l]\n这类场景在高中年纪时也见过好几次。"],["先代の知識や技術を使役するのは悪いことではないだろうが、\n改良にせよ何にせよ停滞ではない事が必須なのだから\n結局の所、","驱使先人的知识和技术并非坏事，\n但改良也好什么都好必须确保不是停滞不前，\n说到底，"],["先人達の遺物なり智慧を、\n上っ面だけを単に享受するだけの消費者となるか、\n改変改良を尊び新たに次世代への遺物の作り手となるかが、\n俺が興味を持てる存在かどうかという点だな。","对于先人留下的遗产或智慧，\n是仅作为浮于表面的消费者坐享其成，\n还是尊崇变革改良成为面向下一代的遗产创造者，\n这才是我能否产生兴趣的关键啊。"],["個人的な趣味で言えば\n『若いときの苦労は買ってでもしろ』\nというのは全く以て至言であり、","以个人趣味来说\n『年轻时的苦难花钱也要买』\n这句话完全是至理名言，"],["若くして頭角を現すという存在は基本的には\n興味を持てない。","所以对那些年纪轻轻就崭露头角的人\n我基本提不起兴趣。"],["ポテンシャルよりも、\n実地的に実時間を伴って蓄積された経験値の方が俺的には\nモノに価値を見出す基準に於ける優先事項だからで、\n世間や方面によっては勿論そうでない事もある。","比起潜力，\n在实际时间中积累的经验值对我而言\n才是衡量事物价值时的优先标准，\n当然在某些领域或圈子里未必如此。"],["「あれこちら随分お若いお嬢さんじゃないすか。[l]\nかれおんと同僚って、ああ、どなたかの妹さん？」","「哎呀这位不是相当年轻的小姐吗。[l]\n和卡蕾欧是同事？啊啦，莫非是哪位的妹妹？」"],["「あいえ、\nえん……のある","「不不是，\n是名字带‘en’…… "],["娘でして！[l]\nナカマ、ふぇろう、ふれんど！」","的姑娘啦！[l]\n同伴，fellow，friend！」"],["「あによもう、\nカレったらノリがへん！[l]\nボクらＷＣぃのなか」","「哥哥呀，\n卡蕾可是个怪人呢！[l]\n我们WC里面」"],["「御嬢、殿方の前ですよ」","「大小姐，这可是在这位先生面前呢」"],["「彼？[l]\nえ、俺の事？」","「他？（译注：日语中“彼”和“カレ”读音一致）[l]\n咦，在说我吗？」"],["「あいえあ、わ、ワタシのことですっ。[l]\n仲間内ではカレと呼ばれていまスのよっ。[l]\nお、お手洗いも一緒に行く仲で」","「不不不，是、是我啦！[l]\n在伙伴之间大家都叫我卡蕾的说。[l]\n连、连洗手间都一起上的交情」"],["「ややこしくてゴメンナサイ」","「搞得这么复杂真是抱歉」"],["「むぅ」","「唔」"],["「いえいえお気になさらず。[l]\nカレ、カレね。カレカレ」","「没事没事请别在意。[l]\n卡蕾，卡蕾呢。卡蕾卡蕾」"],["満足というものをしてしまっては、\n生物は停滞し最悪滅することもあるという皮肉な世界さな。","一旦产生满足感，\n生物就会停滞甚至最糟走向灭亡——这世界就是如此讽刺。"],["刺激刺激、闘い相争う事で存在は成長するという、\n良く言えば自由競争、切磋琢磨、\nだが、それを大っぴらに許容してしまっても成り立たない\nヒトの社会というものがある。","通过反复刺激、斗争竞争让存在得以成长，\n说得好听叫自由竞争、切磋琢磨，\n但人类社会若公然允许这些也维持不下去\n就是这么个东西。"],["本音と建て前は大事だ。","真心话和场面话都很重要。"],["いーくんから借りたＳＦ物にはよく、\n完全管理されたが故に平和だが予定調和で閉塞停滞した世界から、\n危険と争いがあるが未確定で活性化した世界への復活回帰をテーマにしたものが結構あったが、","从饭君那里借来的科幻作品里常有\n从因被完全管控而实现和平，却在预定调和中陷入闭塞停滞的世界，\n回归到充满危险争斗却充满不确定性与活力的世界为主题的故事，"],["それを可なりとするのは問題だろうし、\n本音と建て前は大事だし、\n放っておいてもこの世はとかく生き難いのだ。","但若认为这样就行得通也有问题，\n毕竟真心话和场面话都很重要，\n就算放任不管这世道也够难熬了。"],["敢えてしんどい方向に認識しなくても十分にしんどい。[l]\nだから、積極的な愉悦はなくとも、\nせめてストレスのない生き方が出来るように尽力するのが、\n俺の遣り方。","就算不刻意往艰难处想也已经够艰难。[l]\n所以即便没有积极的愉悦，\n至少要为能过上无压力的生活而尽力，\n这就是我的处世之道。"],["その為には障害を時には腕力を以て排除するという\n物理的衝突が起こり得るという矛盾も、\nまあ勧善懲悪話並には発生する訳で、\nそれを極力一次的接触無しで行うべく仕込まれた――","为此有时需要靠武力排除障碍\n可能引发物理冲突的矛盾，\n嘛就像劝善惩恶故事里常有的桥段，\n为了尽量避免直接接触而预先布局――"],["さて、彼女さんにもお友達にも悪いから、\nそろそろ思考と行動をリンクさせるか。","好了，对这位小姐和她朋友都不好意思，\n该把思考和行动衔接起来了。"],["人間は言ってる事とやってる事は違うらしいが、\n俺のこれは更にずれてるようだし。","据说人类总是言行不一，\n我这种情况偏差得还要更离谱些。"],["まー色々と入り組んだバックボーンがあるというか、\n特殊な身の上なんだよね俺は。","该说是有着错综复杂的背景呢，\n我的身世比较特殊啦。"],["「雪鳴さん？[l]\nどしました？」","「雪鸣先生？[l]\n怎么了？」"],["「あ、ごめ。[l]\nなんでも。[l]\n引き続き詳しく紹介よろ」","「啊、抱歉。[l]\n没什么。[l]\n继续详细介绍吧」"],["「……なんか今日冷たくないですか？[l]\nご、ごほん、えーと、\nこちらから、","「……今天是不是有点冷？[l]\n咳、咳咳、那个、\n这边的话、"],["みみみちゃん、\nアイさん、\nアルコさん、\nサクラさん、","咪咪咪酱、\n亚衣小姐、\n阿露子小姐、\n樱小姐、"],["と、お呼び下さい。[l]\n仕事でこっちに来られまして、\nちょっとしばらく一緒にいることに\nなりましたのですよっ。","请这样称呼。[l]\n因为工作来到这边、\n会和大家\n相处一段时间呢。」"],["真言さんのあの――バイト先の本屋、\n御存知でしたよね？","真言先生的那家――打工的书店、\n您知道的吧？"],["滞在中はあそこにみんなで厄介になるのです。[l]\nで、ワタシもこの度色々とつるむ用事もありまして」","暂住期间大家都要叨扰那里。[l]\n然后、我这次也有些结伴同行的事要办」"],["「成る程ね。[l]\n諒解」","「原来如此。[l]\n理解」"],["「あ、\n勿論愛称ですヨ？[l]\n本名はその、視たとおり外語圏なのでですね、\n色々とその」","「啊、\n当然是昵称啦？[l]\n本名嘛、如您所见是外语圈的、\n所以那个」"],["「らじゃらじゃ、\nさっきから言ってっけど、\n俺ってば察し良いのがウリですから。","「哎呀哎呀、\n刚才就说过了、\n我这个人最擅长的就是察言观色啦。"],["みみみちゃん、アイさん、アルコさん、サクラさん、\nんで、かれおんがカレね」","咪咪咪酱、亚衣小姐、阿露子小姐、樱小姐、\n然后卡蕾欧就是卡蕾哦」"],["「ゆ、雪鳴さんが呼ぶときは\nかれおんでいいんですっ」","「雪、雪鸣先生称呼的时候\n用卡蕾欧就好啦」"],["みみみ＝元気ロリ娘。[l]\nアイ＝ツン眼鏡。[l]\nアルコ＝おっとり不思議ちゃん。[l]\nサクラ＝暴力女。","咪咪咪=元气萝莉。[l]\n亚衣=高冷眼镜。[l]\n阿露子=温吞神秘系。[l]\n樱=暴力女。"],["ざっくりカテゴライズするとそんなとこか。[l]\nちなみにかれおんは……[l]\nいや、いいかそんな戯れは。","粗略分类大概就是这样。[l]\n顺便卡蕾欧是……[l]\n算了、这种玩笑还是别开了。"],["カテゴリ設定自体も、同じこっち側の世界ですら世代で全く違うからなー。","分类标准本身、就算在同个世界里不同世代也完全不一样啊—"],["にしても彼女達――\nふーん。[l]\nこれは、\nＰＴ（パーティー）だったら担当はそれぞれ、","不过她们――\n嗯哼。[l]\n这个、\n要是组队（Party）的话分工应该是、"],["切り札、援護支援、間接後衛、近接前衛……[l]\n違う、もっと入り組んでんな。[l]\n討伐よりか捕獲重視の――\nってそれはもういい。","王牌、支援辅助、间接后卫、近战前锋……[l]\n不对、更复杂些。[l]\n比起讨伐更重视捕获的――\n啊这个不用说了。"],["「えーとですネ、\n真言さんから聞いてるかもですが、","「那个呢、\n可能真言先生已经提过了、"],["ワタシはよく","我经常"],["外つ","去外"],["國にですネ、\nええ――と、出張とか、主に書籍探しですけど、が多いので、\n自然とそういう人脈が出来ましてっっ。","国呢、\n就是――那个、出差啊、主要是找书之类的比较多、\n自然就积累了这样的人脉啦。」"],["で、\n今回はみんなこうして一同に会する機会がありまして、\nえとその、","然后、\n这次难得有机会让大家聚在一起、\n那个就是、"],["ダイジョブです、この國の言葉はこの通り、\n慣用表現から現代若者言葉まで、\n超流暢ですからっ。","没问题的、这个国家的语言就像这样、\n从惯用表达到现代年轻人用语、\n都超级流利啦。"],["――え、えと、それで、しばらくはご一緒出来る時間がその……」","――啊、那个、所以、能和你共处的时间那个……」"],["「さっきも聞いたよかれおん。[l]\nしどろもどろになりなさんな。[l]\nこの雪鳴さんを信じなさい。","「刚才都听过了卡蕾欧。[l]\n别语无伦次的。[l]\n要相信雪鸣先生哦。"],["俺はまだボンクラ学生だけど、\nかれおんは社会人ですからね。","虽然我还是个糊涂学生，\n但卡蕾欧已经是社会人了。"],["限られたコミュの中だけじゃなく、\n色んな付き合いは大事にしないとね。[l]\n承知してます」","不能只局限在有限的圈子里，\n各种人际关系都要好好维系才行。[l]\n我明白的」"],["「は、ハイ？」","「啊、啊咧？」"],["というかれおんの反応を優しく微笑み受け流して、\n俺は彼女等に改めて挨拶した。","对卡蕾欧这样的反应温柔地笑着带过，\n我重新向她们打了招呼。"],["「ま、俺よりも付き合い長そうですし、\nこんな様はもう重々承知の上でしょうが、","「嘛、看起来交往时间比我还要长，\n这种状况应该早就心知肚明了吧，"],["不肖ゆっきーの、更に","不成器的阿雪的、更加"],["不","不成"],["束","体统的"],["者の彼女ですけど、どうか面倒みてやってください」","这位女朋友就拜托你们多关照啦」"],["「にぁはははは！[l]\nゆっきーおもしろいな！[l]\nさすがカレの彼だぉ！！」","「咿呀哈哈哈！[l]\n阿雪真有意思！[l]\n不愧是卡蕾的男朋友！！」"],["「え、おもしろいか？」","「诶、有意思吗？」"],["「お前も御嬢のいうこといちいち気にするなよ」","「你也别太在意大小姐说的每句话啦」"],["「お二人とも、\n失礼ですよ」","「两位都、\n太失礼了」"],["「或る意味御嬢が一番……」","「某种意义上大小姐才是最……」"],["「み、みんなが失礼ですっ！」","「大、大家都太失礼了！」"],["「はははははは、\nおーけーおーけー、\nで、皆さんはこれから？[l]\nすぐお戻りに？」","「哈哈哈哈哈哈，\nOKOK、\n那各位接下来？[l]\n马上回去吗？」"],["「そうです……ね？[l]\nカレ」","「是的……对吧？[l]\n卡蕾」"],["「で、です」","「是、是的」"],["「ま、じゃ俺も用事あるし、\nあとは皆さんごゆるりと。","「嘛、那我也有事，\n各位请自便。"],["かれおんは携帯電話持ってないから、\nこっちから連絡出来ない事には変わりないからなぁ。[l]\nま、そんなわけで常に受け身で慣れっこっスから。","卡蕾欧没带手机，\n所以还是没法从我这边联系啊。[l]\n不过反正我也习惯总是被动接受了。"],["何かあったら連絡よろ。[l]\nいってら～」","有事就联系我。[l]\n走啦～」"],["「ちょちょちょっとあっさりしすぎな気がっ」","「等等这也太干脆了吧！」"],["「おかずの心配も俺の愛も心配しなくていいから。[l]\nフレとかツレとかってのはそういうもんだ。","「不用担心配菜也不用担心我的爱。[l]\n所谓朋友恋人就是这样的。"],["常に眼に視える行動態度で顕されるとは限らんのよ、\nかれおん。","不一定会通过肉眼可见的行动态度表现出来，\n卡蕾欧。"],["ま、気にしない気にしない。[l]\n俺がかれおん愛してることには微塵も嘘はない」","嘛，别在意别在意。[l]\n我爱卡蕾欧这件事没有半分虚假」"],["「へぇ……」","「嘿……」"],["「じゃあまた、機会あれば」","「那有机会再见」"],["「グッバイれでぃーす。[l]\nらう゛ゅーかれおん。[l]\nじゃね」","「Goodbye ladies。[l]\nLove you 卡蕾欧。[l]\n拜拜」"],["「さようなら」","「再见」"],["「ゆっきーおつぅ！！またよろ！！」","「阿雪辛苦啦！！下次再约！！」"],["「てかさあんた、何であんな片言で喋ってんの？[l]\nそういうキャラ設定？","「话说你啊，为什么说话这么磕巴？[l]\n是角色设定吗？」"],["「いえその、\n","「不是那个、\n"],["已むに","实在是"],["已まれぬ事情がありまして……」","有些不得已的情况……」"],["「ああ……なんかチノだか店長だかが愉快な事件がどうとか\n言ってた奴か」","「啊……就是千乃还是店长说的那个什么愉快的事件\n之类的吧」"],["「でなにあんた、\nご飯カレシに作って貰ってるんだ？[l]\n相変わらず本業以外のスキルは磨かないにも程があんな」","「所以你啊、\n连饭都让男朋友做？[l]\n主业之外的技能完全不提升也该有个限度吧」"],["「ああああれは、外食したときの話ですっ。[l]\n奢りですが上限額は雪鳴さん次第で毎回……」","「啊啊那个、是外食时候的事啦。[l]\n虽然是他请客但每次上限金额都取决于雪鸣先生……」"],["「宮殿と一緒の時と変わりないですね","「和宫大人在一起时没差别呢"],["「ThousandBrainsは向こう付きね……[l]\n浮いてなきゃいいけど。遅いか。浮いてるな絶対。","「ThousandBrains还真是让人捉摸不透啊……[l]\n虽说没出什么岔子就好，可这也太慢了吧。肯定是出什么状况了。"],["で、\nZenonは店で留守番しつつ待機で、\n対受動事象下の待機組はあとは、」","那、\nZenon在店里留守待命、\n被动事件应对组的待命人员就剩、」"],["「下賜されましたリストによりますと、","「根据下赐的清单所示、"],["WC_NK:AntLion、","WC_NK:AntLion、"],["和　","和　"],["音 は","音是"],["白","白"],["雨カゲロウ。[l]\nWC_NK:Beehive、","雨蜉蝣。[l]\nWC_NK:Beehive、"],["八","八"],["重","重"],["洲うら。[l]\nWC_NK:-cide、","洲卯良。[l]\nWC_NK:-cide、"],["水","水"],["小","小"],["月シカネ。","月鹿音。"],["対受動事象下、つまり後の始末は彼等の担当ですね。[l]\nThousandBrainsが向こう付きになったのは、\n人種的にはこの國に紛れても違和感が無いからですが」","被动事件应对组、也就是善后工作由他们负责呢。[l]\nThousandBrains靠不住、\n不过从人种来说混在这个国家也不会违和就是了」"],["「キャラが濃すぎるだろ、\nそれ以前にさあ。","「角色设定也太浓了吧、\n在那之前我说啊。"],["中央のなんつたっけあの、\n若モンの街並みに混じるならともかくよ、\n玄ノ森っていやぁその」","中央区那个叫啥来着、\n混在年轻人街区倒也罢了、\n玄之森这种地方实在是」"],["「それよりもなんで和名なんか考えてあるの。[l]\nどうみてもうちら邦人じゃないでしょ」","「比起那个为啥连和名都准备好了啊。[l]\n怎么看我们都不是本国人吧」"],["「さっきの誰かみたいに愉快な言い訳でもするつもりだったんじゃないですか。[l]\n和名自体は単に面白がって作ったそうですが」","「该不会想像刚才某人那样找些愉快的借口吧。[l]\n听说和名纯粹是觉得好玩才取的」"],["「誰が？」","「谁取的？」"],["「勿論店長が。","「当然是店长。"],["今回のCovenに関しては、\n実際、使う機会もないと思ったんでしょう。[l]\nThousandBrainsといつもしてらっしゃる思考遊戯の範疇でしょう」","关于这次Coven行动、\n实际上觉得根本用不上吧。[l]\n大概属于和ThousandBrains常玩的思维游戏范畴」"],["「多少は店長だのKaleidoだのはそーする意味があるし、\n外見上違和感ねーから良いけどよ、\nThousandもまーいいや、\nあたしらまで結局使う羽目になったじゃねーかよ。","「店长和Kaleido他们搞这套还算有点意义、\n外表没违和感也就算了、\nThousand嘛也还行、\n但最后连我们都得用这套名字太离谱了吧。"],["セカンドネームまで和名つくってあって絶句したわ。[l]\nそこまでは使わずに済んだけど、\nヒヤヒヤだったろ。","连中间名都准备了和名真是让人无语。[l]\n虽然最后没用上、\n当时可紧张坏了吧。"],["カレの彼がああいう……人間で良かったわ。[l]\nいい加減、面白いかどうかだけで物事決めるのはどうかと」","幸好卡蕾的那位是那种……人真是太好了。[l]\n差不多该改改光凭有趣与否做决定的毛病了」"],["「っあーあぁ、\n狩りたいなぁ……[l]\n狩りたいなぁ、狩りたいなぁ狩りたいなぁ狩りたいなぁっ！[l]\nあいつが失敗したときだけってそんなのつまんないぉ！！」","「啊——啊啊、\n好想狩猎啊……[l]\n好想狩好想狩好想狩好想狩猎啊！[l]\n只有那家伙失败时才能出手太无趣了！！」"],["「御嬢、\nどうか自重なさって下さい。[l]\n今回は我々はあくまでバックアップとして」","「大小姐、\n请您务必克制。[l]\n这次我们终究只是作为后备」"],["「……御嬢は今日も今日とて、[l]\n相変わらずだねえ（あんたが甘やかすから！）」","「……大小姐今天也是老样子、[l]\n一如既往呢（都怪你太宠她了！）」"],["「店長も、この世はゲェム、愉快さだけが至上だと\n仰って居られたでしょう。","「店长也说过、\n这世间是游戏，愉快才是至上吧。"],["獲物の中にもどうやらそういう主義のが\n居るようですし、どうもこの世界は好き嫌いが判断の基準と\nしてスタンダードなのかもしれませ――」","猎物里似乎也有奉行这种主义的\n说不定这个世界就是以好恶作为判断基准——」\n「Iron你越来越像Thousand了……"],["「Ironあんた、Thousandに似てきたな……[l]\nそんな人間ばっかだとあたしみたいな真面目っ娘が\n浮いちゃうじゃん」","周围全是这种人类的话、[l]\n像我这样的认真派\n不就显得格格不入了嘛」"],["「（Ironは元E.Sで改宗させたのは彼女だからね）」","「（Iron原属E.S，是她负责劝改宗的呢）」"],["「くすんっ！」","「呜嗯！」"],["「ん？[l]\nどうした？[l]\nそのクシャミはどっちだ？」","「嗯？[l]\n怎么了？[l]\n那个喷嚏是哪边的？」"],["「いえ、んっんーっ。[l]\nああ今の、リアルだよ。","「没、嗯嗯——[l]\n啊刚才的、是真实的。"],["たぶん、\n……向こうの連中がしてるかなワタシの噂でも。[l]\nどっちでもいいけどね」","大概、\n……是对面那群人在议论我吧。[l]\n不过都无所谓啦」"],["「そう言えば、\n黒の断片はともかく、\n赤の女王、今回狩れるかな」","「说起来、\n黑之碎片暂且不论、\n赤之女王这次能猎到吗」"],["「あ？[l]\n姉妹の残りとツェロルが居る限り、\n来るだろ。","「啊？[l]\n只要姐妹残党和赛萝洛还在、\n总会来的吧。"],["雫が咬んでてそのイベントフラグだけ立たないってことぁ\nないだろーよ」","雫都咬下去了，却说唯独那个事件 flag 没立起来\n这种情况不存在啦ー」"],["「もう雫は確定なんだ？[l]\nツェロルの話も？","「雫已经确定入伙了？[l]\n还有赛萝洛的事也是？"],["ま、いいや。[l]\nWC_001:GM、このリスト上の和名だと","嘛、算了。[l]\nWC_001:GM、按这份列表上的和名来看"],["真 ","真 "],["然 ","然 "],["名","名"],["無が\n全て掌握済か……","无\n已经全部掌控了吧……"],["固有真名を持つ数少ない同胞にして\n司書長のお気に入りの女子」","作为少数拥有固有真名的同胞\n还是司书长最宠爱的女孩子」"],["「長の愛でるは『","「司书长大人疼爱的只有『"],["妹 ","妹妹"],["君』だけですよ」","』啦」"],["「っえーー\nミートゥーだってばぁ！」","「诶——\n明明我也是啊！」"],["「で？[l]\nKaleidoがわざわざ、\nあたしらをカレシに引き合わせたのは何でよ？","「所以？[l]\nKaleido特意\n把我们介绍给他，到底是为了什么啊？"],["命令あるまでの暇潰しって事はないだろ。[l]\nまさかとぁ思うけど、\n――只の自慢だったらぶっ飛ばすかんな」","总不至于是命令下达前的消遣吧。[l]\n虽然觉得不太可能、\n――要只是炫耀的话我可要揍飞你哦」"],["「え、ええと、\nやっぱりわかんなかったですか」","「那、那个、\n果然还是没明白吗」"],["「まあ、そう言うことを為せ得る存在が、\nもし意図的に隠蔽してきたら","「毕竟、如果存在能做到这种事的家伙、\n还刻意隐瞒至今的话，"],["如","那么即便说是"],["何に魔眼といえど、\n余程PHASE:2強化をした猫の手助け無しにはなかなか。","任凭什么魔眼、\n没有经过相当程度的PHASE:2强化过的猫帮忙也很难察觉吧。"],["え、そういう存在の話なのか？[l]\nキミのフェンリロスが何か嗅ぎ付けたの？」","咦、是在说这种存在吗？[l]\n你家的芬里洛斯嗅到什么了？」"],["「ワタシも彼の前でみせたことはないですし、\n自覚があるかどうかは分からないデスが……[l]\n彼、というか彼の……は恐らく――」","「我在他面前也没展现过那种能力、\n不确定他是否有自觉就是了……[l]\n他、或者说他的……恐怕――」"],["「あれ、黒の９は持ってるだけなのか。[l]\nまー再統合するならそうだわな。[l]\nで、なんだっての。勿体つけなくていーよ」","「咦、黑之9只是持有状态吗。[l]\n嘛ー要重新统合的话确实会这样呢。[l]\n所以、到底怎么回事。别卖关子啦ー」"],["「ええと、ＷＣＬ収蔵のデータと照合しましても、どうやら、あの、","「那个、即使对照WCL收藏的数据、似乎、那个、"],["Ｄの、『","是所谓的D的、『"],["茶","茶"],["黒の","黑之"],["首 』のようです」","首 』」"],["「なに？」","「什么？」"],["「マジか」","「真假」"],["「黒の１０と同様の存在として？」","「作为与黑之10同等的存在？」"],["「ですね。[l]\nヒトの肉を器に、まあ強制分割された訳ではないので、\n黒の１０と全く同様という事では――」","「是的。[l]\n以人类肉体为容器、虽非强制分割、\n但要说和黑之10完全相同也――」"],["「","「"],["Ｄなんて……永久欠番、所在不明だったはずでしょう。","D什么的……本该是永久除籍、下落不明的存在。"],["ミアキスの、私達の","米亚基斯的、并非我们的"],["Ｃじゃない、","C、"],["Ｄの顕現体、\nナナムシルorgの最初の出芽双体、ナナムシルaltの片割れ、","而是D的显现体、\n名无姆希尔org最初的萌芽双子、名无姆希尔alt的半身、"],["つまり『黒の","亦即称为『黑之"],["偽 』の兄弟とでも言うべき、\n『","虚伪 』的兄弟、\n『"],["首 』。","首 』。"],["安定せず消失したとばかり――\nまさか黒の１０と共に此処に居たなんて」","本以为是因不稳定而消失――\n没想到竟和黑之10一同在此处」"],["「アイはむずかしいことしってんねー！」","「亚衣懂的事情可真难啊！」"],["「雫か。[l]\nこうなるとほぼ確定せざるを得ないな。[l]\n後世に於いて語られるまでは便宜上とするのが本来だが、雫の波紋","「雫啊。[l]\n这样一来几乎可以确定了。[l]\n虽然后世流传的说法只是权宜之计，但雫的波纹"],["畏るべしだな」","确实令人敬畏啊」"],["「あのいえ、うーん……[l]\n一応ちらっとチノの方には匂わせた報告してあるんですが、\n向こうから呼び戻す訳にもいかなくてですね、\nそれでちょっと、みなにお目通しをと……」","「那个，嗯……[l]\n姑且算是向千乃那边稍微透露了一些，也做了报告，\n但也不可能让她从那边回来，\n所以就想请大家过目一下……」"],["「１０も今は自覚無しなんだし、否、１０の肉の方だけかそれは。[l]\nオウトとやらもそうなんじゃねーのか？[l]\nカレはそもそも、それでカレに近づいたのか？」","「10现在也没有自觉吧，不，或许只是10的肉体部分？[l]\n那个叫欧托的家伙不也一样吗？[l]\n卡蕾从一开始就是因为这个才接近他的吗？」"],["「いえ、まったくの偶然ですっ。[l]\n判ってたらチノにもまず確認させてマスよ！[l]\nほ、ほんとに打算じゃなくて、純粋に惹かれ合い？愛？[l]\nいえその、それは置いといテ！","「不，完全是偶然啦。[l]\n要是早知道的话肯定会先让千乃确认呀！[l]\n真、真的不是算计，纯粹是互相吸引？爱？[l]\n啊不是，这个先放一边！"],["黒の９を検索した時にも……[l]\nあ、同じ土地でしたし、両者が近すぎたのかもっ……うーん。","之前搜索黑之9的时候也……[l]\n啊，因为是在同一片土地，可能两者距离太近了……嗯。"],["自覚に関してはワタシも何とも、\nただ一緒にいてそういう気配は、彼はおくびにも出さないデス」","关于自觉这方面我也说不准，\n但就算在一起时，他也完全没有流露出那种气息呢」"],["「あんたのお","「你的"],["惚","迷"],["気はどーでもいいんだ。","恋怎样都无所谓。"],["いずれにしろ、\nあたしらじゃわかんなかったわけだから、\nお目通しも無駄だったな」","反正\n我们也没能搞明白，\n看了也是白费功夫」"],["「Kaleidoのフェンリロスは理論上の存在だった","「Kaleido的芬里洛斯原本只是理论上的存在"],["Ｄ寄りにチューンされた特殊な……だからね。[l]\n相当『鼻が利く』」","被调谐成偏向D的特殊……所以啊。[l]\n相当『嗅觉灵敏』」"],["「い、いえそんな大層なものでは……[l]\nと、取り敢えず最終的な確認をしたかったのですが……","「没、没那么夸张啦……[l]\n总、总之是想做最后确认……"],["仕方ないですね。[l]\n極めて曖昧な根拠ですが、\nこのまま宮店長に報告します……」","没办法呢。[l]\n虽然依据极其模糊，\n就这样向宫店长汇报吧……」"],["「めんどうなことはわかんないぉ！[l]\nカレがそう思ったんならそうなんだぉ！」","「麻烦的事我不懂啦！[l]\n卡蕾既然这么想那肯定没错啦！」"],["「御嬢は大変にsensibleであらせられます」","「大小姐可是非常sensible（译注：明智的）的存在」"],["「あんたの甘やかし、たまに皮肉に聞こえるな……」","「你的溺爱，偶尔听着像讽刺呢……」"],["「ま、いいんじゃねーか。[l]\nただ、","「嘛，不也挺好。[l]\n只不过"],["Ｄなんぞ今回のゲームに絡めたら、\n店長の現時点でのスキルキャパはオーバーするだろな。","要是把D什么的牵扯进这次游戏，\n店长现在的技能容量会超负荷吧。"],["オウトはKaleidoがちゃんと手綱握っとくのが賢明だろーがな。[l]\nどうせ実戦闘になっても、事に当たるのはあたしらだし」","欧托那边还是让Kaleido好好牵制比较明智。[l]\n反正实战的时候出力的也是我们」"],["「ですね。[l]\n私も御嬢のお世話で忙しいですし」","「是啊。[l]\n我也要忙着照顾大小姐」"],["「なんでもいいからご飯食べ行こうよ」","「随便什么都好快去吃饭啦」"],["「それーっ！[l]\nそれがいいぉ！」","「就是啊！[l]\n这个提议超棒！」"],["「あう、\nじゃじゃあ、『ねこざんまい』に取り敢えず……[l]\n電話あそこのしかワタシ使えないので……」","「啊呜\n那那那就先去『猫三昧』……[l]\n因为我只能用那里的电话……」"],["「にてしても、\n懐かしいものを大量に視たな。[l]\nかれおんのナカマだから当然か……」","「话虽如此\n也算是看到了大量令人怀念的东西。[l]\n毕竟是卡蕾欧的伙伴，所以这也是理所当然的吗……」"],["視えた時はまだ、\n意識と言動は不一致だったんで、\n彼女等には俺が気付いたかどうかは伝わんなかったかな。[l]\nその方が善いかもな。","看到的时候\n意识和行动还不一致，\n她们应该没察觉到我注意到了吧。[l]\n这样或许更好。"],["そうかそうか……","这样啊这样啊……"],["イーくん、\n頑張れよ。","小伊\n加油啊。"],["いかなプレイアァの資格者、語り部の視覚者とはいえ、\n出来ることはゲームの視界の司会だけじゃないはずだからな。","作为可行动玩家的资格者，身为讲述者的视觉者，\n能做的事不该仅限于掌管游戏的视野才对。"],["頑張れ。[l]\nまた俺達が逢えるように。","加油啊。[l]\n为了我们能再次相逢。"]],"context":[["SC_S_005.ks/index/1/text"],["SC_S_005.ks/index/3/text"],["SC_S_005.ks/index/5/text"],["SC_S_005.ks/index/7/text"],["SC_S_005.ks/index/9/text"],["SC_S_005.ks/index/11/text"],["SC_S_005.ks/index/13/text"],["SC_S_005.ks/index/15/text"],["SC_S_005.ks/index/17/text"],["SC_S_005.ks/index/19/text"],["SC_S_005.ks/index/21/text"],["SC_S_005.ks/index/23/text"],["SC_S_005.ks/index/25/text"],["SC_S_005.ks/index/27/text"],["SC_S_005.ks/index/29/text"],["SC_S_005.ks/index/31/text"],["SC_S_005.ks/index/33/text"],["SC_S_005.ks/index/35/text"],["SC_S_005.ks/index/37/text"],["SC_S_005.ks/index/39/text"],["SC_S_005.ks/index/41/text"],["SC_S_005.ks/index/43/text"],["SC_S_005.ks/index/45/text"],["SC_S_005.ks/index/47/text"],["SC_S_005.ks/index/49/text"],["SC_S_005.ks/index/51/text"],["SC_S_005.ks/index/53/text"],["SC_S_005.ks/index/55/text"],["SC_S_005.ks/index/57/text"],["SC_S_005.ks/index/59/text"],["SC_S_005.ks/index/61/text"],["SC_S_005.ks/index/63/text"],["SC_S_005.ks/index/65/text"],["SC_S_005.ks/index/67/text"],["SC_S_005.ks/index/69/text"],["SC_S_005.ks/index/71/text"],["SC_S_005.ks/index/73/text"],["SC_S_005.ks/index/75/text"],["SC_S_005.ks/index/77/text"],["SC_S_005.ks/index/79/text"],["SC_S_005.ks/index/81/text"],["SC_S_005.ks/index/83/text"],["SC_S_005.ks/index/85/text"],["SC_S_005.ks/index/87/text"],["SC_S_005.ks/index/89/text"],["SC_S_005.ks/index/91/text"],["SC_S_