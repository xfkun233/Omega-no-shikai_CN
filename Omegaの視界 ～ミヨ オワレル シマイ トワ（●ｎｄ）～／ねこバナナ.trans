":7829},{"start":7835,"end":7838}],[{"start":7844,"end":7849}],[{"start":7859,"end":7865}],[{"start":7875,"end":7895}],[{"start":7905,"end":7930}],[{"start":7940,"end":7965}],[{"start":7975,"end":7987}],[{"start":8005,"end":8011}],[{"start":8034,"end":8042}],[{"start":8060,"end":8066}],[{"start":8089,"end":8099}],[{"start":8134,"end":8170}],[{"start":8198,"end":8237}],[{"start":8243,"end":8411}],[{"start":8421,"end":8445}],[{"start":8455,"end":8465}],[{"start":8500,"end":8510}],[{"start":8538,"end":8547}],[{"start":8553,"end":8563}],[{"start":8569,"end":8655}],[{"start":8661,"end":8696}],[{"start":8706,"end":8720}],[{"start":8726,"end":8729}],[{"start":8735,"end":8738}],[{"start":8744,"end":8750}],[{"start":8783,"end":8791}],[{"start":8817,"end":8823}],[{"start":8860,"end":8873}],[{"start":8901,"end":8920}],[{"start":8930,"end":8947}],[{"start":8953,"end":9020}],[{"start":9026,"end":9030}],[{"start":9075,"end":9080}],[{"start":9103,"end":9110}],[{"start":9128,"end":9134}],[{"start":9157,"end":9167}],[{"start":9185,"end":9196}],[{"start":9219,"end":9228}],[{"start":9246,"end":9255}],[{"start":9278,"end":9282}],[{"start":9300,"end":9306}],[{"start":9378,"end":9385}],[{"start":9413,"end":9447}],[{"start":9508,"end":9583}],[{"start":9611,"end":9618}],[{"start":9632,"end":9643}],[{"start":9666,"end":9672}],[{"start":9686,"end":9695}],[{"start":9718,"end":9722}],[{"start":9740,"end":9750}],[{"start":9769,"end":9773}],[{"start":9787,"end":9793}],[{"start":9812,"end":9819}],[{"start":9837,"end":9852}],[{"start":9871,"end":9879}],[{"start":9885,"end":9914}],[{"start":9920,"end":9943}],[{"start":9949,"end":9964}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_055.ks","basename":"SC_M_055.ks","indexIds":{"すべての音が明瞭にきこえてはいるけれど、\n":0,"ただそれだけ。":1,"只管にざわついたあのときは過ぎ去って、\n":2,"今思考は停止してるようなものだ。":3,"でもきっと眼の前の波と同じく、\n":4,"寄せては返すその波と同じく、\n":5,"再びこころは荒れたりさざめいたりするのだろう。":6,"今の僕は──否、昔からきっと僕は、\n":7,"僕のこころは、\n":8,"まるで両手に持った大きなベニヤ板の上のボーリング玉なんだ。":9,"落とさない様にするには\n常に力を込めてバランスを取らねばならない。":10,"少しでも転がり出せば、止めるのは容易でない。":11,"そのままでは端から落ちる。":12,"だから反作用的に別方向に傾けないといけない。":13,"そしてそれも行き過ぎては駄目だ。":14,"繰り返し。":15,"必死で腕を、身体を引き攣らせながら。":16,"何とか玉を落ち着けようとする。":17,"静かで安寧な状態は僕自身が静止するしかないのに、\n":18,"そうはいかない。":19,"セカイには僕だけが居る訳じゃないし、\n":20,"風も吹くし雨も降る。":21,"僕以外の要素が絶えず僕の板を、玉を揺るがす。":22,"他のひとはきっと、バランスを取るのが巧いか、\n":23,"或いは板の端にストッパーがあるとか、\n玉自体が扱いやすい大きさ、重さ、\n":24,"だったりするんだろうな。":25,"否、そうでなくても僕が特に、扱いが下手なんだ、\nそうなんだきっと。":26,"どっちにしても、今の僕は、\n":27,"端から落ちた玉を拾い上げて、\n":28,"板の上に置いただけなんだ。":29,"だから屹度また揺れ出すんだ。転がり出すんだ。":30,"制御出来る程の力が戻らなきゃ、\nその重い玉はまたどんどん加速して──\n":31,"そう、\n":32,"僕を一層苦しめる、というか、自己嫌悪に陥る理由（わけ）は、\n":33,"どうあれ今の僕にすら、\n":34,"板も玉も存在してるという事なんだ。":35,"「──腹もしっかり減る、トイレにも行ける、\n身体的欲求は何も、変わらない……」":36,"そしてその事自体を認識し、\n自己嫌悪のようなざわざわした感情にぶちのめされる。":37,"冷静な僕と、\n掻き乱された僕が、\n":38,"不思議と同居している。":39,"きっとこれは反動、\n自己防衛のこころのはたらき──\nあまりにも強烈な衝撃は逆に、\nそれを緩衝しようとする働きも強固に現れるんだろう、\n今は、\n全くの、\n":40,"「……」":41,"今、この混沌故の冷静さがほんとうに納まったら、\n":42,"沈殿して鎮静化したら、\n":43,"恐らくその後に来るのは、\n改めての自己嫌悪か、その逆、つまり、\n":44,"「貴女を……憎いと思うように……[l]\nなる…………のかな……」":45,"貴女にはっきりと、攻撃、罵倒、されたのなら、\nそういう感情にもすんなりなれるのだろう、\n":46,"いっそ貴女が、\n":47,"僕をキライだと言っていて":48,"呉れていれば、\n":49,"だけど、\n":50,"それすら、\n":51,"だから、\n":52,"「………」":53,"思考はそこで止まる。":54,"空転すらしない。":55,"動きようがない、足掻きようがない、\n":56,"理不尽に説教をされてる時のように、\n":57,"そして結局、\n冷静になったり、\nそれでいて未解決の問題がずっと存在を主張するから、\n乱れ、\n":58,"でもロジカルな思考に逃げようとも行き詰まる、\n":59,"──何かを忘れているから？":60,"いや、\n":61,"思考が止まるのは、\n":62,"──自分で道を閉ざすからだ。":63,"本来あるはずの選択肢、選ばざるを得ない道が厳然とあるのに、\n":64,"──こころの奥底では拒むのだが明文化出来ないから、\n":65,"言い訳が出来なくて、\n":66,"──コトバを使おうとするならfrEEzEすることに、\n":67,"望んでいるのに言えない本当のことがあるから、\n":68,"「……ちくしょう……」":69,"フラストレーションはどうしたって、\n":70,"イカリに変わっていく。":71,"怒りを思う事自体、\n八つ当たりだと分かってる、でも、\nそれを自制しようとする行為が更に、\n苛立ちや、苦しみや、そういった厭なものが、\n":72,"──適度、あくまでも適度な範疇で、\n":73,"発散しなければ、\n":74,"──その程度の事は餌として扱えよう。":75,"「……波が……振幅の差が……」":76,"……明鏡止水なんて状況は、[l]\nそうそうないんだろう。":77,"眼前の海は常に、\nざわめいて、\nどんなに静かって言っても波が無くなる事はない。":78,"──雫の一滴が波紋を、\n":79,"でも僕は、\nそんなのは、\n嘘でも僕は、\n":80,"「………昇った分だけ落ちるくらいなら、[l]\nはじめから──」":81,"鏡面の如く凪いだ":82,"水":83,"面をのぞむのに──\n":84,"──雫は波紋をもたらすもの。":85,"「………きらいだ……って言えたなら……」":86,"………。":87,"度を超えた痛み故か、\n何度も考えてるように単なる反動か、\n":88,"今の僕のなかは、\n":89,"「……あんな、……くそ、……」":90,"くろいかんじょうがある。":91,"それは反動として……つまり副作用として──[l]\n副作用という言葉がこの場合、\n合ってるのかどうか分からないけど、\n自分を護る為に、\nあのひとを悪者にしようとしてる、\nそんなかんじょうなんだと思う。":92,"我ながら冷静に分析するけど、\nそう考えるって事は暗に、\n『本当はそうじゃない』、『あのひとは悪くない』と、\n思いたい事の顕れだろう。":93,"逆に言えば、\nそう思わずに居られないのは、\n":94,"それが反動の所為なんかじゃなく、\n":95,"『本心から』あのひとを、\n":96,"「………●●●だったら、どう、しよう……」":97,"って、思うからで……":98,"そして再び僕は、\nざわざわして、\n締め付けるようなかんじょうの痛みに顔を":99,"顰めた。":100,"いま、ぼくのこころにある冷静でない部分は、\n":101,"これはきっと、\n":102,"やっぱり悲しみや何かというよりも。":103,"怒りであり、\n":104,"悔しさであり、\n":105,"……憎しみなのか。":106,"なぜ？":107,"なぜなんです。":108,"なんでですか。":109,"どうして。":110,"止まる思考が行き着く所はせいぜい、\nそのコトバ。":111,"きっとただの反動なんだ、自己防衛なんだ、\n自己弁護の言い訳、屁理屈なんだ、\nそう思いたいけど──\n":112,"「……あなたが、●●●だ……」":113,"──自己を保つ為に他者を相対的に貶めること、\n":114,"じゃないと僕は、泣きたい、逃げたい、ただの、\n":115,"──絶対的位相を処するならそれもやむなし、自己完結なら、\n":116,"でもそれじゃ駄目なんだ、ヒトとして、\n":117,"──ヒト？":118,"僕はヒトだって、\n":119,"──その思考は無為だ。":120,"「僕は、ひとが……ひとなんて……」":121,"……僕は沢山の他人と接するのが怖かった。[l]\n友人以上に親しくするのには物凄く慎重だった。":122,"それは":123,"偏に他人に嫌われるのが怖かったからだ。[l]\n自分というものがあやふやで、\nいつも他人を評価（批評？）しながら、[l]\nつまり相対的に自分の":124,"位":125,"置というものを確認しなけりゃ、\n不安で不安でしょうがないから、\nだから、他人に自分の事を否定──嫌われたり、怒られたり、\n避けられたり無視されたりするのが怖くて、\n必要のない存在と思われるのが耐えられなくて、\n彼我の温度差を感じるのが":126,"堪らなく悲しくて、\n":127,"あんな思いをするのはイヤだから、\n":128,"そんな仕打ちを受けるならいっそ最初からと、\n一定以上に親しくなるのを避けていたんだ。":129,"近づけば近づく程、\n向こうを向かれた時の痛みが、\nあんな、──。[l]\n……そんな機会を自分から増やすなんて、[l]\n沢山の他人と知人友人になるなんて、\n":130,"──疑うべき対象が許容量を超えてしまっては、\n":131,"僕は、傷付きたくなかったんだよ。":132,"──面倒なだけで何の利点も無いからな。":133,"そして、\n":134,"──はじめからそんなものいなければいいとおもったのだな\n":135,"それでも僕も処世術のようなものを小賢しく身につけて、\n一般的な範疇での社交性のようなものを纏いながら……[l]\n纏った気になりながら、\n":136,"──他人とのかかわりが時に重くなる\n":137,"新たなコミュニティーに属すようなこともあったけれど、\n":138,"──自分を悪者にしてでも、他人を貶めてでも\n":139,"重くなる、その視えない恐怖が、不安が、\n繋がり続けることに対しての、\nやがて来るわかれを予感して、\n":140,"僕を見捨てないでと、\n":141,"──ワレがひつようなのだろ\n":142,"心の底から、期待に添いたいのに、\n":143,"──アレがそういったのだ\n":144,"応えられなかったらどうしよう、どうしよう、\n":145,"──だから\n":146,"自らその繋がりを辞してきた。":147,"──不用意な繋がりの網はアレらにとっても望まぬ所だった\n":148,"……でもそれは単に経験して成長するのを怠ってきたに過ぎなかった。":149,"それなのに、僕もこんな、いいオトナになってしまった。":150,"大人の麻疹は重症だって、\n今更、\n":151,"他の普通のヒト達はきっとこんなこと、\n何ともなく過ごせているんだろうし、\nきっと僕が悩んだり苦しんだりしてる事も、\nみんなが経験して、克服したり、やり過ごしたりしてる、\nただの日常なんだ。":152,"でも、そんな事すらも、\nいちいち":153,"躓いて、痛がったり打ちのめされたりしてる、\n僕はそんな自分が、\n":154,"──自分が●●●なのか？":155,"たにんをうらやんで、\n卑下して、\n自信も何もなく流されていく事自体に心地よさすら感じて、\nそれでも、やっぱり悔しさや何かをしっかり抱えながら、\n屈折したそんな、\n":156,"そんな僕でも、\nこの人になら近づきたいと思えたひとたち、\n大神や、\n……、":157,"「み…や、さん」":158,"誰よりも他人との繋がりを欲している癖に、\n誰よりも他人を怖がって嫉妬して来た僕は、\n":159,"他人を、否、友人知人を、\n自分に都合の良い道具としか視ていなかったという、\n事なのかな？":160,"……その報いがこの有様か。":161,"「……わからない……」":162,"もういやだ、いやなのに、\n":163,"──":164,"単":165,"体で":166,"生くは不可能なんだよ\n":167,"冷静な部分が、\n":168,"まだみちがあると、\nクダラナイ事で止まるなと、\n瑣事だ瑣事だ瑣事なんだよと、\n":169,"──事実だ\n":170,"必死になって立て直そうとするその無意識的思考は、\n":171,"──設問が誤な為に解法を模索するのは徒労だ\n":172,"どうしても、あのひとのことを、\n":173,"──本調子まであと何律か──\n":174,"それとも僕はほんとうにあのひとが憎いのか。":175,"分からない……":176,"でも、\n":177,"時は流れていく、容赦なく、\n":178,"このままじっとしていても、たとえ僕が何もしなくても、\n":179,"僕があのひとを憎まない道を選んだとしても、\n":180,"それはつまり、\n":181,"彼女達との──\n":182,"歪で":183,"背":184,"徳い出会いではあったけど、\n僕を受け入れてくれたあの、\n例えその理由が……その……であっても、[l]\n僕が●●●だからなんだとしても、\n":185,"それでも僕は、\n":186,"……それとも貴女を憎んだまま、[l]\n貴女のもとに居られるのかな。":187,"彼女達の敵になってまで？":188,"貴女が言ったように、\nこのまま僕がいなくなってしまえば楽なのかな。":189,"僕がどうなろうと、\n":190,"──ゴカイだ\n":191,"誰も傷付くことはないんだろうし、\n":192,"──ゴカイだよ\n":193,"それならもう、\n":194,"──冷静に\n":195,"かえりたい、かえりたい、かえりたい……":196,"──かんがえろ\n":197,"そして、あなたが、いまはもう、ごめん、\n":198,"──根源的なあやまりをしているみたいだから\n":199,"……。":200,"脳空転、\n":201,"というか、\n":202,"何度も同じ事を考えてるような気がする、\n":203,"思考がロックされてるのかスパイラルに陥ったのか、\n":204,"空腹時と寝起きは、ヒトと会話しないようにしよう、\n":205,"そう肝に銘じてるのに、\n":206,"──いきろ\n":207,"やっぱりほら、\n":208,"──いける\n":209,"なにがなにやら──\n":210,"「ああ、そうか……[l]\n空腹というか……腹……減ったなあ……」":211,"空腹は覚えていたけれど、\n実際は此処に来てから何も食べてなかったんだ。":212,"だからなのか、\n疲れて休みたいのに、\n眠気が来ない。[l]\n精神だけは尖って張り詰めて、\n思考ループに捉えられてるし、\n一種の興奮状態のようなざわざわしたこのかんじは、\n……だめだ。[l]\n実際今の今まで何を思考してたのかとか、\nそういったものまで乱暴にとっちらかって、\n":213,"脳空転と言うより思考暴走とでもいうべき状態で、\n":214,"感情自体が今もう、\n":215,"「……と、にかく、」":216,"──何か食べるか。":217,"食べないと眠れない。":218,"どんなに疲れてても、\nそれだけでは眠れない。[l]\n一晩寝ればいろいろなことをやり過ごせた僕でも、\nやっぱりお腹が空いてた時は寝られなかったものだ。":219,"時間を確かめようと、取り出した携帯電話、\n知らず知らず僕は、\n":220,"アドレス帳を呼び出していた。":221,"あ……":222,"い……":223,"飯窪現実……":224,"「母、さん……」":225,"選択して、\n":226,"「……うぅ、あ、あぁ……」":227,"絶望的な答えが返ってくるのが怖くて、\n":228,"どうしても発信ボタンを、押せない。":229,"低血糖時だから、じゃないんだろう、\n動悸が、早鐘を打つような、\nどくどくと血流が頭の中を巡る、\nああからだが。":230,"震え、\n":231,"──奮え\n":232,"ゆらゆらと、\n":233,"──フルエ\n":234,"そして僕の眼から、\n":235,"──もう少しなんだよ\n":236,"また溢れそうな、\n":237,"──心配いらない\n":238,"熱い、\n":239,"──ワレは、":240,"「………はっ」":241,"どれだけ忘我の状態だったのか、\n手の中の携帯電話が鳴っ、た。":242,"「──タイミングよくイベント起きるか……[l]\nはは……………………[l]\n…………………………[l]\n………………………っ」":243,"……もういい。":244,"──何かを忘れている\n":245,"誰、だろう？":246,"──何かを忘れて\n":247,"ああ、\n":248,"──……ミ、…カミ？":249,"狩屋……":250,"──…ガミ？":251,"そういえば、\n":252,"──もう少しで、何かを忘れ……":253,"手が震えたので、":254,"その所為でボタンを二度押しなぞして通話切断しないようにと、":255,"冷静なのかどうなのか微妙な思考を走らせながら、":256,"僕は慎重に電話に、[l]出た。":257},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_055.ks","relPath":"/data/scenario/SC_M_055.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":253,"length":258,"percent":98.06201550387597},"cellInfo":[]},"/data/scenario/SC_M_056.ks":{"data":[["「……はい」","「……是的」"],["「……あ、狩屋です、克杖、[l]\nえー、あー……[l]\n──兄ぃ？[l]\nもしもし？」","「……啊，我是狩屋，克杖，[l]\n呃，那个……[l]\n──老哥？[l]\n喂喂？」"],["僕は一瞬、何故か、\n●きそうになって、\n大きく深呼吸をした。","我瞬间差点，\n●过去，\n做了个深呼吸。"],["そうすると、僕の身体は震えて、\nだから呼吸も、がくがくと震えて、\nまるで●いてるみたいになって、\n何とか意識を集中させようとする。","结果身体抖得更厉害，\n连呼吸都咯咯作响地颤抖，\n简直像●了一样，\n拼命集中意识。"],["勿論、食事してないとか、\n状況的な要因は色々あるだろうけど、\n","当然，没吃饭之类，\n客观因素有很多吧，\n"],["そもそも空腹時と寝起きに他人と会話を控えようと\n思う程に、\n","说到底在空腹和刚睡醒时应该避免和他人交谈\n这么想着，\n"],["「あ、ああ……かりや、狩屋な？[l]\nんっ、ああ、はぁ──」","「啊、啊啊……狩、狩屋吗？[l]\n嗯、啊、哈──」"],["今までは、\n冷静だった、というより、\n単に内に向かって閉じて思考に没入していたのを、\n沈着していると錯覚していたのかも知れない。","直到现在，\n说是冷静，不如说\n单纯是封闭内心沉浸在思考中，\n可能误以为那是沉着吧。"],["声だけとは言え実際に他人と接すると、\n全然フラットじゃなかった……な。[l]\nそれとも、\nこれも一種の、","虽说只是声音但实际接触到他人时，\n完全没法保持平静……呢。[l]\n或者说，\n这也算是某种"],["「……もしもし、ごめん。[l]\nああ、その」","「……喂喂、抱歉。[l]\n啊、那个」"],["安心感なのかな。","安心感吗。"],["そんなはず……ないか。[l]\nもしそうだったとしてもそれはそれで、\n……困る……よな……","应该……不是吧。[l]\n就算是那样也另当别论，\n……会很困扰……啊……"],["「……なんか、[l]\nだいじょぶ？[l]\n声がさ、\n元気ない……」","「……那个，[l]\n没事吧？[l]\n你的声音，\n听起来没精神……」"],["「え……？[l]\nあ、あぁ……[l]\nまあ、なんだ、\nなんとかする……なんとかするさ……」","「诶……？[l]\n啊、啊啊……[l]\n嘛、怎么说，\n总会有办法……总会有办法的……」"],["「……？[l]\nんー、えーと、\nあー、うーと、\nじゃあ、\n…………………[l]\n何から話したらいいのかういも混乱してるんだけど、\n………、[l]\nあ、まずね、こないだはごめん、\nちょっとどたばたしてその」","「……？[l]\n嗯ー、那个，\n啊ー、呃ー，\n那，\n…………………[l]\n完全不知道该从何说起脑子一片混乱，\n………，[l]\n啊、首先呢、上次对不起，\n稍微有点手忙脚乱那个」"],["「いや、こっちこそ……[l]\nじゃあもう……落ち着いたのか？[l]\nそっちは」","「不、我这边才是……[l]\n那现在……冷静下来了吗？[l]\n你那边」"],["「……んーーーーと、[l]\nまあ、その、たぶん……[l]\nういは特にすることないって言われて、\nああ、道具さん……知ってるよね、ああ、うん、[l]\n会ってるもんね、\nその、そのひとにお願いして、\n大丈夫っていうか、その、言われたけど、\n………、[l]\nきーちゃも冬夏ちゃも、\n……」","「……嗯ーーーーー，[l]\n嘛、那个、大概……[l]\n我被说没什么特别要做的，\n啊、道具小姐……认识的吧、啊、嗯，[l]\n见过面的，\n那个、拜托了那个人，\n说是没问题、那个、被这么告知了，\n………，[l]\n小姬和冬夏酱，\n……」"],["「……どうした？」","「……怎么了？」"],["「大丈夫……だよ、[l]\nそう言ってたもん……ただその、[l]\n……あ、え、そっか、もう、」","「没问题的……哦，[l]\n她们都这么说……只是那个，[l]\n……啊、诶、这样啊、已经，」"],["「……まあ、なんとなく……わかった……[l]\n言いたくないなら今は別に──」","「……嘛、大概……明白了……[l]\n不想说的话现在也不用──」"],["僕自身も、今他人のくるしみをまともにうけられるような、\nそんな状態では、\n","我自己现在也没法正经承受他人的痛苦，\n处于这种状态，\n"],["──でも聞かなきゃ\n","──但不得不问\n"],["……彼女達は、………","……她们，………"],["──正面から向き合う以外に解決策はないんだし\n","──除了正面面对之外没有解决办法\n"],["それも、我がミ……の為、ということ？","这也是、为了我们的主……吗？"],["──敵は、\n","──敌人是，\n"],["と、暫く呻吟するような間をおいて、\n狩屋が切り出した。","如此、经过一段仿佛痛苦呻吟的沉默后，\n狩屋开口了。"],["「言いたくないっていうか、\n話したい……話さなきゃのことは沢山あるの……[l]\nでね、こないだ言ったけど、\n明日……会い……会える？」","「不是不想说，\n想聊……必须聊的事情还有很多……[l]\n那个，之前也提过，\n明天……能见……见面吗？」"],["「あ、ああ……そうだった……[l]\nわかった……けど……」","「啊、啊啊……对哦……[l]\n知道了……不过……」"],["あの公園……て、[l]\n玄ノ森の真っ只中……だし、[l]\n彼処の近く……だよな……","那个公园……在、[l]\n玄之森的正中央……而且、[l]\n离那里……很近吧……」"],["「あの時はさ、\nあの公園で会おうって言ったけど、\n兄ぃさえ良ければさ、\n場所、変えちゃだめ？[l]\n……ういもあの辺居づらい…っていうか……」","「那时候啊，\n虽然约了在那个公园见面，\n只要哥哥你同意的话，\n能不能换个地方？[l]\n……我在那一带也待得难受……应该说……」"],["「え……？[l]\nああ、それは、構わない……というか、[l]\n助かる……」","「诶……？[l]\n啊，那个，没关系……不如说，[l]\n正合我意……」"],["……なんだろう、狩屋の理由は……[l]\nまあ、他人の事を慮る余裕も無いし……[l]\nこの場合、好都合とも言える……[l]\nそう、\n都合……よく、いろんな……事が……","……怎么回事呢，狩屋的理由……[l]\n嘛，我也没有余力顾虑别人……[l]\n这种情况，可以说正合适……[l]\n是啊，\n各种……事情……都……很凑巧……"],["「……っ、[l]\nど、何処にしようか、\nえーあー、」","「……唔、[l]\n那、那去哪儿好呢，\n呃啊——，」"],["「じゃ、何処に、ってええええと、\nうを？！[l]\nは、ご、ごめ」","「那、去哪里、那个呃呃呃呃、\n呜哇？！[l]\n抱、抱歉」"],["……被った。","……撞话了。"],["だけだったのに、\n妙に可笑しくて、\n","明明只是这样，\n却莫名好笑，\n"],["「っははは、あはは……[l]\n悪い、ごめん、ははは……」","「噗哈哈哈，啊哈哈……[l]\n对不起，抱歉，哈哈哈……」"],["この、タイミングの良さすらも、\n……かも知れないけど、[l]\nそれでも……[l]\n何だか、\n","就连这种时机的巧合，\n……或许也是吧，[l]\n即便如此……[l]\n总觉得，\n"],["「あは、あはは……[l]\nほんとに悪い、久々に、\n笑った……[l]\nちょっと愉しくなってきた……[l]\nあははは……」","「啊哈，啊哈哈哈……[l]\n真的对不起，好久没、\n笑了……[l]\n稍微开心起来了……[l]\n啊哈哈哈……」"],["「にゃ、にゃんだえ！[l]\nひひひとをしし、心配……いや、い、[l]\nいいけどさぁ……[l]\nへこんでるよりはそのほうが、\nいいよね……？」","「喵、喵什么啊！[l]\n害害人白白、担心……才、才不是，[l]\n这样也好啦……[l]\n总比垂头丧气强，\n对吧……？」"],["「あぁ……そう……だな……[l]\n……はは……だから、[l]\nそっちも──」","「啊……是啊……[l]\n……哈哈……所以，[l]\n你那边也──」"],["「そ、そうにゃが、あう、ういだって、\nういのこともちゃんと慰めろ！！[l]\nいあ、ちが、ああもうこっちも混乱してるんだからぁ……」","「对对喵错，啊啊、我也、\n也要好好安慰我啦！！[l]\n啊不、搞错、啊啊真是的我也混乱得要死啦……」"],["「ぐす……あ、ああ、[l]\n悪……げほっ、悪かったって……[l]\nいやその、僕もまあ、混乱というか、どうしていいのか、\nいや、なんつーか……」","「呜咽……啊、啊啊，[l]\n对不……咳咳、对不起啦……[l]\n不是那个，我也该说，与其说是混乱，不如说不知该怎么办，\n不，该怎么说……」"],["「うん、その、こっちもごめん……[l]\nもう、ね、今、こんなかんじなの……[l]\nだから、あうぅ」","「嗯、那个、我这边也抱歉……[l]\n真是的，你看，现在就是这种状态……[l]\n所以，啊呜」"],["「ああ、……まあ、気にするな、[l]\n兎に角、その、\n用がある──んだろ、こっち、僕に」","「啊啊、……嘛，别在意，[l]\n总之，那个，\n是有事──要谈吧，和我」"],["「うん──\nじゃ、どうしようかな……[l]\nえっと、そっちは今どこ？」","「嗯──\n那、该怎么办呢……[l]\n那个、你现在在哪儿？」"],["「え、ああ、\nあの、碁石松原ってとこ……」","「诶、啊、\n那个、在叫碁石松原的地方……」"],["「碁石？[l]\nあーじゃあ、丁度いいのかな。[l]\n玄ノ森から離れてるし……[l]\nういがバスでそっち行く？」","「碁石？[l]\n啊—那正好呢。[l]\n离玄之森也远……[l]\n要不我坐巴士过去？」"],["「ああ、そうなる、かな……[l]\nどうしよう、迎えに……行くか？」","「啊、这样啊、可能……[l]\n怎么办、要去……接你吗？」"],["本当なら、\n向こう方面にはあまり……","其实的话、\n那边方向不太……」"],["「ん、いい。[l]\nバスで行く。[l]\nまー、やっと元気出たみたいだけど、\nまだにゃんか心配だし、\n事故られても怖いからさ、\nういの命も預けるにゃー、今の兄ぃはね、\nおっかなすぎて。[l]\nだから気にしにゃいで」","「嗯、不用。[l]\n我坐巴士去。[l]\n嘛—虽然总算看起来有精神了、\n但还是有点担心、\n也怕你出事故、\n现在的老哥太不靠谱了、\n让人提心吊胆的。[l]\n所以别在意啦」"],["「ああ、そ、そうか、\nまあ、なら、それで……[l]\nあ、バス代くらいは出……」","「啊、这、这样啊、\n嘛、那就、那样吧……[l]\n啊、车费至少让我……」"],["「いいっての。[l]\nこの際、貸しつくっとく」","「都说不用啦。[l]\n这次就当全是我借你的」"],["「あ？[l]\n……や、まあ、[l]\n今回は甘んじて受ける……[l]\nすまん……」","「哈？[l]\n……嘛、也罢、[l]\n这次我就厚着脸皮接受了……[l]\n抱歉……」"],["「まあ、精精数百円の貸しだろけどにぇ……[l]\nでも、ちゃんと返してよ、いつか、\n……ういになんかあったらね」","「反正也就几百日元的债嘛……[l]\n不过、要好好还哦、总有一天、\n……要是我有个万一的话」"],["「ああ、もちろん、\nなんつーか、色々、\n…すけられたのは事実だしな……」","「啊、当然、\n该怎么说呢、各方面、\n…确实被你救了呢……」"],["「へ？[l]\n蹴られた？」","「诶？[l]\n被踢了？」"],["「いや、ちが……[l]\nまあいいや、\nとにかくその、サンクスということで……」","「不、不是……[l]\n算了、\n总之那个、谢啦……」"],["「？[l]\nは、はあ……」","「？[l]\n哈、哈啊……」"],["そして、\n彼女はおよその時間を予定時刻として、\nまた明日のその時に改めて連絡くれる由を告げて、\n電話を切った。","然后、\n她告知了大致的时间作为预定时刻、\n说明天会再联系、\n便挂断了电话。"],["「………なんだろう、[l]\nこのかんじは……」","「………怎么回事、[l]\n这种感觉……」"],["背","背"],["徳さと安堵感が同居したような、\nそれでいてやはり何処かで","既混杂着感激又带着安心、\n但某处依然"],["燻る止めようのない、\n強迫観念のような焦燥、\n","萦绕着无法抑制的、\n近乎强迫观念的焦躁、\n"],["「……ちゃんと寝ないと、[l]\n自律神経失調症ぽいのも……あるかな……」","「……不好好睡觉的话、[l]\n说不定会得自律神经失调症什么的……」"],["でも、\n","可是，\n"],["今晩は車中泊することに、した。[l]\n狩屋の御陰で大分ましにはなったけど……[l]\nまだ、人には会いたくない、今は。","今晚决定在车里过夜。[l]\n多亏狩屋总算好些了……[l]\n但现在、还是不想见人。"],["今し方考えていたように、\nきっとこの一時的な高揚感が、\n今から独りになったときに、\nそのテンションの落差で打ち沈む事になる布石に成り果てる、\nそう予感……否、予想していたし、[l]\n本来ならそういう時こそ他人と接触するのが良いのかも知れない、\nけど……","正如刚才所想的，\n这份短暂的高昂情绪，\n在即将独自一人时，\n终会因情绪落差沦为令人消沉的伏笔，\n这种预感……不，是早已预料到的，[l]\n按理说这种时候才更应该接触他人，\n但是……"],["確実にその時その相手には、\n色んな意味で","可以确定到那时对那个人，\n从各种意义上"],["縋ってしまう事になる、だろう事も、\nそれこそ容易に予想出来た。","都会产生依赖吧，\n这种事也轻易就能预见。"],["だから、今は、\n独りでねるよ。","所以现在，\n我要独自睡觉。"],["ねて、おきて、脳空転はうまいぐあいにいやなことを、\nそれで僕は今まで──\n","睡着、醒来、让大脑空转来巧妙逃避，\n借此我一直——\n"],["………。",""],["「……その為にも、[l]\n少しでも喰わなきゃ……[l]\nもういい加減はらがへりすぎてねられない……」","「……为此，[l]\n至少得吃点东西……[l]\n肚子饿过头已经没法睡了……」"],["空腹による脳空転は、\n強烈な空転を確かにしてはくれるけども、\n同時にかなりな、睡眠の妨げにもなるから……","空腹引发的脑内空转，\n虽然确实能带来强烈的放空感，\n但同时也会严重妨碍睡眠……"],["幸い、こないだ冬夏と来たときに、\n自販機でも菓子の類が買える事は分かってたから、\n其処で非カフェイン系の飲み物と一緒に適当なものを買い込んだ。","幸好上次和冬夏来时，\n就知道自动贩卖机也能买点心，\n就在那儿随便买了些无咖啡因饮料和零食。"],["というか、\n我ながら、\n何故此処から、何処か遠い所へ逃げようとか思わないのか、\n不思議でならない──いや、当然でもあるんだけれど、\n","话说回来，\n连自己都觉得，\n为什么没想过从这里逃到远方去，\n实在不可思议——不，其实也很合理，\n"],["逃げても無駄、みたいなことは、\n……あのひとも言ってたこと。","毕竟逃了也没用，\n……那个人也说过这话。"],["──逃げた先にもストレッサーはあり、\n　　つまり己という檻を持つ限りは","——逃往之处亦有压力源，\n　　只要还困在自我牢笼中"],["それに、僕がきえたところで、\n","况且就算我消失了，\n"],["──誰も得をしないし\n","——也没人会受益\n"],["………それにしても、","………即便如此，"],["「……なんか、[l]\n現実離れしすぎると……[l]\n経験則じゃ間に合わないからか、\n頭も身体も対応しようと必死になって、\n逆に冷静に対処、してる、ってこと……なのかな」","「……怎么说呢，[l]\n当现实过于脱离常轨时……[l]\n或许因为经验法则不够用，\n头脑和身体都会拼命适应，\n反而显得异常冷静……是这样吗」"],["それに加え、パニックの時期は過ぎたからか。[l]\nテンションの落差の話じゃないけど、\n均衡を保と","再加上恐慌期可能已经过去。[l]\n虽不是指情绪落差，\n但就像有某种"],["うとする機構とでも言おうか、\nアンチテーゼと言うか反作用と言うか、\nフラットに戻ろうと逆向きの何かが働いて、\n","维持平衡的机制，\n可称之为反命题或反作用力，\n某种逆向力量让人回归平静，\n"],["──喰ってからミにするまでは、\n　　消化吸収のインターバルがあって\n","——从进食到消化之间，\n　　存在着吸收缓冲期\n"],["だから今はもう、必死で冷静になろうとした結果なのか、\n","所以现在这状态，或许是拼命冷静的结果，\n"],["──取捨選択、整理が必要だもんね\n","——需要取舍整理呢\n"],["さっきまでの陰鬱とした思考も、\nそれが行き過ぎていた所為か、\n逆向きで中和して、おさまろうとして、\n","方才阴郁的思绪，\n或因过度极端，\n正被逆向中和逐渐平息，\n"],["──ただ喰ったのでは鵜呑み丸呑みで、\n　　己がミには成り","——囫囵吞枣式的进食，\n　　终究无法真正"],["難いってこと\n","化为己有\n"],["それこそボーリングの玉の、\n","就像保龄球需要，\n"],["──コウタイはコウゲンなくしてはつくれない、成長にだって、\n","——矿胎离不开矿源，成长也是，\n"],["成長……？","成长……？"],["──相応の代償あってこそのゼンシン、\n　　黙っててじっとしてても何も変わらない\n","——唯有付出相应代价才能前进，\n　　沉默静止不会改变任何事\n"],["そうだろうけど、\n","话虽如此，\n"],["──まあ、いまは食休みのようなものだから、\n","——不过现在算是饭后休息时间，\n"],["まだヒトにも、あのひとにもあいたくないけど、\n","虽然还是不想见人，包括那个人，\n"],["──ワレらも、われらも\n","──我们也是，我们也是\n"],["狩屋、\n","狩屋、\n"],["──からだ\n","──身体\n"],["……冬夏、姫様ちゃん、","……冬夏、姫様酱、"],["──かさな\n","──重叠\n"],["「君等とは……ほんとうにアイタイと、おもうよ──」","「和你们……真的觉得好爱──」"],["笑うってことは、\n","能笑出来，\n"],["笑えるってことはしあわせなんだと、\n","能笑出来就是幸福，\n"],["──grin like a Cheshire cat?\n",""],["なんでって、","为什么呢，"],["嗤いっていうのは、\n","因为嗤笑这种行为，\n"],["──do it for a giggle?\n",""],["「……食べるか、取り敢えず……そして、[l]\nねよう……もう……かんがえるのも……きつい……[l]\n……つらい……」","「……先吃点东西吧……然后，[l]\n睡吧……已经……思考也……好累……[l]\n……好痛苦……」"]],"context":[["SC_M_056.ks/index/1/text"],["SC_M_056.ks/index/3/text"],["SC_M_056.ks/index/5/text"],["SC_M_056.ks/index/7/text"],["SC_M_056.ks/index/9/text"],["SC_M_056.ks/index/12/text"],["SC_M_056.ks/index/15/text"],["SC_M_056.ks/index/17/text"],["SC_M_056.ks/index/19/text"],["SC_M_056.ks/index/21/text"],["SC_M_056.ks/index/23/text"],["SC_M_056.ks/index/25/text"],["SC_M_056.ks/index/27/text"],["SC_M_056.ks/index/29/text"],["SC_M_056.ks/index/31/text"],["SC_M_056.ks/index/33/text"],["SC_M_056.ks/index/35/text"],["SC_M_056.ks/index/37/text"],["SC_M_056.ks/index/39/text"],["SC_M_056.ks/index/41/text"],["SC_M_056.ks/index/43/text"],["SC_M_056.ks/index/46/text"],["SC_M_056.ks/index/49/text"],["SC_M_056.ks/index/51/text","SC_M_056.ks/index/173/text"],["SC_M_056.ks/index/54/text"],["SC_M_056.ks/index/56/text"],["SC_M_056.ks/index/59/text"],["SC_M_056.ks/index/61/text"],["SC_M_056.ks/index/63/text"],["SC_M_056.ks/index/65/text"],["SC_M_056.ks/index/67/text"],["SC_M_056.ks/index/69/text"],["SC_M_056.ks/index/71/text"],["SC_M_056.ks/index/73/text"],["SC_M_056.ks/index/75/text"],["SC_M_056.ks/index/77/text"],["SC_M_056.ks/index/79/text"],["SC_M_056.ks/index/82/text"],["SC_M_056.ks/index/84/text"],["SC_M_056.ks/index/87/text"],["SC_M_056.ks/index/89/text"],["SC_M_056.ks/index/91/text"],["SC_M_056.ks/index/93/text"],["SC_M_056.ks/index/95/text"],["SC_M_056.ks/index/97/text"],["SC_M_056.ks/index/99/text"],["SC_M_056.ks/index/101/text"],["SC_M_056.ks/index/103/text"],["SC_M_056.ks/index/105/text"],["SC_M_056.ks/index/107/text"],["SC_M_056.ks/index/109/text"],["SC_M_056.ks/index/111/text"],["SC_M_056.ks/index/113/text"],["SC_M_056.ks/index/115/text"],["SC_M_056.ks/index/117/text"],["SC_M_056.ks/index/119/text"],["SC_M_056.ks/index/121/text"],["SC_M_056.ks/index/123/text"],["SC_M_056.ks/index/125/text"],["SC_M_056.ks/index/127/text"],["SC_M_056.ks/index/129/text"],["SC_M_056.ks/index/131/text"],["SC_M_056.ks/index/133/text"],["SC_M_056.ks/index/135/text"],["SC_M_056.ks/index/137/text"],["SC_M_056.ks/index/140/text"],["SC_M_056.ks/index/142/text"],["SC_M_056.ks/index/145/text"],["SC_M_056.ks/index/147/text"],["SC_M_056.ks/index/149/text"],["SC_M_056.ks/index/151/text"],["SC_M_056.ks/index/153/text"],["SC_M_056.ks/index/155/text"],["SC_M_056.ks/index/158/text","SC_M_056.ks/index/160/text","SC_M_056.ks/index/162/text","SC_M_056.ks/index/186/text","SC_M_056.ks/index/188/text","SC_M_056.ks/index/271/text","SC_M_056.ks/index/273/text","SC_M_056.ks/index/275/text"],["SC_M_056.ks/index/164/text"],["SC_M_056.ks/index/166/text"],["SC_M_056.ks/index/168/text"],["SC_M_056.ks/index/170/text"],["SC_M_056.ks/index/176/text"],["SC_M_056.ks/index/178/text"],["SC_M_056.ks/index/180/text"],["SC_M_056.ks/index/183/text"],["SC_M_056.ks/index/190/text"],["SC_M_056.ks/index/192/text"],["SC_M_056.ks/index/194/text"],["SC_M_056.ks/index/196/text"],["SC_M_056.ks/index/199/text"],["SC_M_056.ks/index/202/text"],["SC_M_056.ks/index/205/text"],["SC_M_056.ks/index/208/text"],["SC_M_056.ks/index/211/text"],["SC_M_056.ks/index/213/text"],["SC_M_056.ks/index/216/text"],["SC_M_056.ks/index/219/text"],["SC_M_056.ks/index/222/text"],["SC_M_056.ks/index/224/text"],["SC_M_056.ks/index/227/text"],["SC_M_056.ks/index/230/text"],["SC_M_056.ks/index/233/text"],["SC_M_056.ks/index/236/text"],["SC_M_056.ks/index/239/text"],["SC_M_056.ks/index/242/text"],["SC_M_056.ks/index/245/text"],["SC_M_056.ks/index/247/text"],["SC_M_056.ks/index/250/text"],["SC_M_056.ks/index/252/text"],["SC_M_056.ks/index/255/text"],["SC_M_056.ks/index/258/text"],["SC_M_056.ks/index/261/text"],["SC_M_056.ks/index/263/text"],["SC_M_056.ks/index/266/text"],["SC_M_056.ks/index/269/text"]],"tags":[],"parameters":[[{"start":162,"end":168}],[{"start":198,"end":253}],[{"start":305,"end":343}],[{"start":349,"end":426}],[{"start":432,"end":467}],[{"start":477,"end":511}],[{"start":548,"end":582}],[{"start":610,"end":686}],[{"start":692,"end":756}],[{"start":789,"end":815}],[{"start":841,"end":849}],[{"start":855,"end":907}],[{"start":939,"end":984}],[{"start":1017,"end":1074}],[{"start":1106,"end":1240}],[{"start":1271,"end":1318}],[{"start":1348,"end":1525}],[{"start":1556,"end":1565}],[{"start":1595,"end":1649}],[{"start":1680,"end":1722}],[{"start":1750,"end":1791}],[{"start":1809,"end":1819}],[{"start":1842,"end":1852}],[{"start":1866,"end":1889},{"start":5827,"end":5850}],[{"start":1912,"end":1930}],[{"start":1944,"end":1950}],[{"start":1973,"end":2004}],[{"start":2036,"end":2115}],[{"start":2146,"end":2179}],[{"start":2185,"end":2234}],[{"start":2264,"end":2351}],[{"start":2382,"end":2427}],[{"start":2453,"end":2551}],[{"start":2594,"end":2628}],[{"start":2658,"end":2698}],[{"start":2724,"end":2730}],[{"start":2736,"end":2758}],[{"start":2793,"end":2825}],[{"start":2853,"end":2911}],[{"start":2946,"end":3021}],[{"start":3051,"end":3137}],[{"start":3168,"end":3214}],[{"start":3244,"end":3317}],[{"start":3348,"end":3431}],[{"start":3461,"end":3518}],[{"start":3549,"end":3601}],[{"start":3631,"end":3674}],[{"start":3705,"end":3730}],[{"start":3760,"end":3827}],[{"start":3858,"end":3895}],[{"start":3901,"end":3923}],[{"start":3953,"end":4087}],[{"start":4118,"end":4165}],[{"start":4195,"end":4222}],[{"start":4253,"end":4305}],[{"start":4335,"end":4398}],[{"start":4429,"end":4473}],[{"start":4503,"end":4520}],[{"start":4551,"end":4598}],[{"start":4628,"end":4645}],[{"start":4671,"end":4738}],[{"start":4820,"end":4847}],[{"start":4864,"end":4865}],[{"start":4875,"end":4907}],[{"start":4918,"end":4945}],[{"start":4980,"end":5020}],[{"start":5046,"end":5050}],[{"start":5060,"end":5126}],[{"start":5132,"end":5282}],[{"start":5288,"end":5312}],[{"start":5322,"end":5357}],[{"start":5363,"end":5382}],[{"start":5388,"end":5429}],[{"start":5439,"end":5443},{"start":5449,"end":5453},{"start":5459,"end":5463},{"start":6046,"end":6050},{"start":6056,"end":6060},{"start":7497,"end":7501},{"start":7507,"end":7511},{"start":7517,"end":7521}],[{"start":5494,"end":5552}],[{"start":5580,"end":5640}],[{"start":5646,"end":5725}],[{"start":5731,"end":5809}],[{"start":5873,"end":5907}],[{"start":5921,"end":5960}],[{"start":5979,"end":5994}],[{"start":6012,"end":6023}],[{"start":6066,"end":6076}],[{"start":6107,"end":6207}],[{"start":6237,"end":6293}],[{"start":6308,"end":6371}],[{"start":6389,"end":6427}],[{"start":6450,"end":6477}],[{"start":6495,"end":6512}],[{"start":6535,"end":6593}],[{"start":6611,"end":6643}],[{"start":6653,"end":6660}],[{"start":6683,"end":6697}],[{"start":6715,"end":6745}],[{"start":6768,"end":6773}],[{"start":6787,"end":6831}],[{"start":6854,"end":6863}],[{"start":6881,"end":6903}],[{"start":6926,"end":6949}],[{"start":6967,"end":6979}],[{"start":7002,"end":7006}],[{"start":7024,"end":7030}],[{"start":7053,"end":7064}],[{"start":7078,"end":7084}],[{"start":7132,"end":7157}],[{"start":7183,"end":7192}],[{"start":7202,"end":7220}],[{"start":7238,"end":7266}],[{"start":7289,"end":7295}],[{"start":7305,"end":7315}],[{"start":7333,"end":7355}],[{"start":7403,"end":7469}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_056.ks","basename":"SC_M_056.ks","indexIds":{"「……はい」":0,"「……あ、狩屋です、克杖、[l]\nえー、あー……[l]\n──兄ぃ？[l]\nもしもし？」":1,"僕は一瞬、何故か、\n●きそうになって、\n大きく深呼吸をした。":2,"そうすると、僕の身体は震えて、\nだから呼吸も、がくがくと震えて、\nまるで●いてるみたいになって、\n何とか意識を集中させようとする。":3,"勿論、食事してないとか、\n状況的な要因は色々あるだろうけど、\n":4,"そもそも空腹時と寝起きに他人と会話を控えようと\n思う程に、\n":5,"「あ、ああ……かりや、狩屋な？[l]\nんっ、ああ、はぁ──」":6,"今までは、\n冷静だった、というより、\n単に内に向かって閉じて思考に没入していたのを、\n沈着していると錯覚していたのかも知れない。":7,"声だけとは言え実際に他人と接すると、\n全然フラットじゃなかった……な。[l]\nそれとも、\nこれも一種の、":8,"「……もしもし、ごめん。[l]\nああ、その」":9,"安心感なのかな。":10,"そんなはず……ないか。[l]\nもしそうだったとしてもそれはそれで、\n……困る……よな……":11,"「……なんか、[l]\nだいじょぶ？[l]\n声がさ、\n元気ない……」":12,"「え……？[l]\nあ、あぁ……[l]\nまあ、なんだ、\nなんとかする……なんとかするさ……」":13,"「……？[l]\nんー、えーと、\nあー、うーと、\nじゃあ、\n…………………[l]\n何から話したらいいのかういも混乱してるんだけど、\n………、[l]\nあ、まずね、こないだはごめん、\nちょっとどたばたしてその」":14,"「いや、こっちこそ……[l]\nじゃあもう……落ち着いたのか？[l]\nそっちは」":15,"「……んーーーーと、[l]\nまあ、その、たぶん……[l]\nういは特にすることないって言われて、\nああ、道具さん……知ってるよね、ああ、うん、[l]\n会ってるもんね、\nその、そのひとにお願いして、\n大丈夫っていうか、その、言われたけど、\n………、[l]\nきーちゃも冬夏ちゃも、\n……」":16,"「……どうした？」":17,"「大丈夫……だよ、[l]\nそう言ってたもん……ただその、[l]\n……あ、え、そっか、もう、」":18,"「……まあ、なんとなく……わかった……[l]\n言いたくないなら今は別に──」":19,"僕自身も、今他人のくるしみをまともにうけられるような、\nそんな状態では、\n":20,"──でも聞かなきゃ\n":21,"……彼女達は、………":22,"──正面から向き合う以外に解決策はないんだし\n":23,"それも、我がミ……の為、ということ？":24,"──敵は、\n":25,"と、暫く呻吟するような間をおいて、\n狩屋が切り出した。":26,"「言いたくないっていうか、\n話したい……話さなきゃのことは沢山あるの……[l]\nでね、こないだ言ったけど、\n明日……会い……会える？」":27,"「あ、ああ……そうだった……[l]\nわかった……けど……」":28,"あの公園……て、[l]\n玄ノ森の真っ只中……だし、[l]\n彼処の近く……だよな……":29,"「あの時はさ、\nあの公園で会おうって言ったけど、\n兄ぃさえ良ければさ、\n場所、変えちゃだめ？[l]\n……ういもあの辺居づらい…っていうか……」":30,"「え……？[l]\nああ、それは、構わない……というか、[l]\n助かる……」":31,"……なんだろう、狩屋の理由は……[l]\nまあ、他人の事を慮る余裕も無いし……[l]\nこの場合、好都合とも言える……[l]\nそう、\n都合……よく、いろんな……事が……":32,"「……っ、[l]\nど、何処にしようか、\nえーあー、」":33,"「じゃ、何処に、ってええええと、\nうを？！[l]\nは、ご、ごめ」":34,"……被った。":35,"だけだったのに、\n妙に可笑しくて、\n":36,"「っははは、あはは……[l]\n悪い、ごめん、ははは……」":37,"この、タイミングの良さすらも、\n……かも知れないけど、[l]\nそれでも……[l]\n何だか、\n":38,"「あは、あはは……[l]\nほんとに悪い、久々に、\n笑った……[l]\nちょっと愉しくなってきた……[l]\nあははは……」":39,"「にゃ、にゃんだえ！[l]\nひひひとをしし、心配……いや、い、[l]\nいいけどさぁ……[l]\nへこんでるよりはそのほうが、\nいいよね……？」":40,"「あぁ……そう……だな……[l]\n……はは……だから、[l]\nそっちも──」":41,"「そ、そうにゃが、あう、ういだって、\nういのこともちゃんと慰めろ！！[l]\nいあ、ちが、ああもうこっちも混乱してるんだからぁ……」":42,"「ぐす……あ、ああ、[l]\n悪……げほっ、悪かったって……[l]\nいやその、僕もまあ、混乱というか、どうしていいのか、\nいや、なんつーか……」":43,"「うん、その、こっちもごめん……[l]\nもう、ね、今、こんなかんじなの……[l]\nだから、あうぅ」":44,"「ああ、……まあ、気にするな、[l]\n兎に角、その、\n用がある──んだろ、こっち、僕に」":45,"「うん──\nじゃ、どうしようかな……[l]\nえっと、そっちは今どこ？」":46,"「え、ああ、\nあの、碁石松原ってとこ……」":47,"「碁石？[l]\nあーじゃあ、丁度いいのかな。[l]\n玄ノ森から離れてるし……[l]\nういがバスでそっち行く？」":48,"「ああ、そうなる、かな……[l]\nどうしよう、迎えに……行くか？」":49,"本当なら、\n向こう方面にはあまり……":50,"「ん、いい。[l]\nバスで行く。[l]\nまー、やっと元気出たみたいだけど、\nまだにゃんか心配だし、\n事故られても怖いからさ、\nういの命も預けるにゃー、今の兄ぃはね、\nおっかなすぎて。[l]\nだから気にしにゃいで」":51,"「ああ、そ、そうか、\nまあ、なら、それで……[l]\nあ、バス代くらいは出……」":52,"「いいっての。[l]\nこの際、貸しつくっとく」":53,"「あ？[l]\n……や、まあ、[l]\n今回は甘んじて受ける……[l]\nすまん……」":54,"「まあ、精精数百円の貸しだろけどにぇ……[l]\nでも、ちゃんと返してよ、いつか、\n……ういになんかあったらね」":55,"「ああ、もちろん、\nなんつーか、色々、\n…すけられたのは事実だしな……」":56,"「へ？[l]\n蹴られた？」":57,"「いや、ちが……[l]\nまあいいや、\nとにかくその、サンクスということで……」":58,"「？[l]\nは、はあ……」":59,"そして、\n彼女はおよその時間を予定時刻として、\nまた明日のその時に改めて連絡くれる由を告げて、\n電話を切った。":60,"「………なんだろう、[l]\nこのかんじは……」":61,"背":62,"徳さと安堵感が同居したような、\nそれでいてやはり何処かで":63,"燻る止めようのない、\n強迫観念のような焦燥、\n":64,"「……ちゃんと寝ないと、[l]\n自律神経失調症ぽいのも……あるかな……」":65,"でも、\n":66,"今晩は車中泊することに、した。[l]\n狩屋の御陰で大分ましにはなったけど……[l]\nまだ、人には会いたくない、今は。":67,"今し方考えていたように、\nきっとこの一時的な高揚感が、\n今から独りになったときに、\nそのテンションの落差で打ち沈む事になる布石に成り果てる、\nそう予感……否、予想していたし、[l]\n本来ならそういう時こそ他人と接触するのが良いのかも知れない、\nけど……":68,"確実にその時その相手には、\n色んな意味で":69,"縋ってしまう事になる、だろう事も、\nそれこそ容易に予想出来た。":70,"だから、今は、\n独りでねるよ。":71,"ねて、おきて、脳空転はうまいぐあいにいやなことを、\nそれで僕は今まで──\n":72,"………。":73,"「……その為にも、[l]\n少しでも喰わなきゃ……[l]\nもういい加減はらがへりすぎてねられない……」":74,"空腹による脳空転は、\n強烈な空転を確かにしてはくれるけども、\n同時にかなりな、睡眠の妨げにもなるから……":75,"幸い、こないだ冬夏と来たときに、\n自販機でも菓子の類が買える事は分かってたから、\n其処で非カフェイン系の飲み物と一緒に適当なものを買い込んだ。":76,"というか、\n我ながら、\n何故此処から、何処か遠い所へ逃げようとか思わないのか、\n不思議でならない──いや、当然でもあるんだけれど、\n":77,"逃げても無駄、みたいなことは、\n……あのひとも言ってたこと。":78,"──逃げた先にもストレッサーはあり、\n　　つまり己という檻を持つ限りは":79,"それに、僕がきえたところで、\n":80,"──誰も得をしないし\n":81,"………それにしても、":82,"「……なんか、[l]\n現実離れしすぎると……[l]\n経験則じゃ間に合わないからか、\n頭も身体も対応しようと必死になって、\n逆に冷静に対処、してる、ってこと……なのかな」":83,"それに加え、パニックの時期は過ぎたからか。[l]\nテンションの落差の話じゃないけど、\n均衡を保と":84,"うとする機構とでも言おうか、\nアンチテーゼと言うか反作用と言うか、\nフラットに戻ろうと逆向きの何かが働いて、\n":85,"──喰ってからミにするまでは、\n　　消化吸収のインターバルがあって\n":86,"だから今はもう、必死で冷静になろうとした結果なのか、\n":87,"──取捨選択、整理が必要だもんね\n":88,"さっきまでの陰鬱とした思考も、\nそれが行き過ぎていた所為か、\n逆向きで中和して、おさまろうとして、\n":89,"──ただ喰ったのでは鵜呑み丸呑みで、\n　　己がミには成り":90,"難いってこと\n":91,"それこそボーリングの玉の、\n":92,"──コウタイはコウゲンなくしてはつくれない、成長にだって、\n":93,"成長……？":94,"──相応の代償あってこそのゼンシン、\n　　黙っててじっとしてても何も変わらない\n":95,"そうだろうけど、\n":96,"──まあ、いまは食休みのようなものだから、\n":97,"まだヒトにも、あのひとにもあいたくないけど、\n":98,"──ワレらも、われらも\n":99,"狩屋、\n":100,"──からだ\n":101,"……冬夏、姫様ちゃん、":102,"──かさな\n":103,"「君等とは……ほんとうにアイタイと、おもうよ──」":104,"笑うってことは、\n":105,"笑えるってことはしあわせなんだと、\n":106,"──grin like a Cheshire cat?\n":107,"なんでって、":108,"嗤いっていうのは、\n":109,"──do it for a giggle?\n":110,"「……食べるか、取り敢えず……そして、[l]\nねよう……もう……かんがえるのも……きつい……[l]\n……つらい……」":111},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_056.ks","relPath":"/data/scenario/SC_M_056.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":109,"length":112,"percent":97.32142857142857},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[27,1]},"/data/scenario/SC_M_057.ks":{"data":[["あんな粗食ですら僕を眠りに誘うには十分だったらしく、\n昨日のその食事からは記憶が曖昧だった。[l]\n血が一気に下に行くような感覚と共に、\n強烈な眠気とだるさ、\nそれでいて頭に広がる妙な充足感……[l]\n……それはきっと緊急回避的な、[l]\n現実逃避の一種でもあるのだろうけれど、\n兎も角僕はかなりの時間寝入っていたらしい。[l]\n先日もかなりの時間寝過ごしたりしたが、\nああいうのや今回のようなのは、\n基本的に余程無茶した時の筈で、\n大抵は体感時間よりも短い時間であることの方が多い……[l]\nだから、\nやっぱり、\n余程の場合なんだろう……今の僕は。","那种粗茶淡饭似乎也足以诱我入眠，\n关于昨天那顿饭的记忆已模糊不清。[l]\n伴随着血液猛然下沉的错觉，\n强烈的困倦与乏力，\n同时脑中扩散着奇异的满足感……[l]\n……那想必是紧急避险式的、[l]\n某种逃避现实的表现吧，\n总之我似乎昏睡了相当长时间。[l]\n前些天也曾睡过头很久，\n但像那次和这次的情况，\n基本都发生在过度乱来的场合，\n通常实际耗时比体感时间要短得多……[l]\n所以，\n果然，\n现在我的状态……属于相当特殊的情况吧。"],["やはり全く覚えてないのだけれど、\n後部座席に移って寝ていたらしい。[l]\nスモークガラスである所為か、\n瞬時に時間と天候が把握出来ない。","虽然完全不记得过程，\n但似乎转移到后座睡了。[l]\n或许是烟色玻璃的缘故，\n无法立刻判断时间与天气。"],["苦労して半身起こし……て、あれ、","费力地支起半边身子……咦，"],["「ででで……んあ゛……ぐぐ」","「动动动……呜啊……咕咕」"],["お、重いというか、だるいというか、\n","哦、与其说沉重不如说酸软，\n"],["「……う゛あ……、はぁ……[l]\n………いてててて」","「……呜哇……、哈啊……[l]\n………痛痛痛痛」"],["身体の節々が痛いが、\n","全身关节都在疼，\n"],["「首は…無事……ぽいな」","「脖子…应该……没事」"],["はあ……まあ、[l]\n寝違えてないのは幸いだった。[l]\n今そんな事になってたら、\n色んな意味で地味に厳しい……","哈……还好，[l]\n没落枕算走运了。[l]\n要是现在落枕的话，\n各方面都会很难熬……"],["「……何時だ？[l]\n今……」","「……几点了？[l]\n现在……」"],["携帯電話で確認すると、\n既に狩屋との約束の時間になっていた。","用手机确认发现，\n已到和狩屋约定的时间。"],["ああ、\nこれの充電も、どうしようか……[l]\n今の処はまだゲージあるけども、\n……単に待機状態ならまだしも、[l]\n結構通話とかで使ってるし、\n","啊，\n这个充电问题怎么办……[l]\n目前电量还有剩余，\n……单纯待机倒还好，[l]\n但通话用得挺频繁，\n"],["コンビニ……に電池充電とか、[l]\nそういうのあったっけっか……","便利店……有没有充电服务，[l]\n好像有这类服务来着……"],["まあ、\n待ち合わせのバスも来るし……[l]\nバス停近くに何か店でも、\nあったかな……？","不过，\n约好的巴士也快来了……[l]\n车站附近有没有店铺，\n来着……？"],["コンビニに行くなんて、\n夕べはその余裕……というか気力が無かったのは確かだし、[l]\n今もまだ、\n他人と接触するのには少し抵抗ある、のは確かだけど……","昨晚确实没余力……\n或者说没心思去便利店，[l]\n现在也还是，\n不太想接触他人……虽然确实如此……"],["ああ、もう、\n卑近でリアルな問題と、\n大仰で現実味のない問題が脳内に並列して存在してると、\n気が遠くなるというか、\n分裂しそうというか、\nスケール感とか深度がわやくちゃになって、\n","啊、真是的、\n庸俗又现实的烦恼、\n和夸张又缺乏真实感的问题在脑中同时存在时、\n简直要晕过去、\n或者说快要分裂、\n规模感和深度全都乱成一团、\n"],["「……まあ、[l]\n狩屋と会った後で考えよう……」","「……算了、[l]\n见到狩屋之后再考虑吧……」"],["思考は結局その辺で落ち着いてしまう。[l]\n良いのか悪いのか、\nそれこそさっぱりだけども、\n","思绪最终就这样草草收场。[l]\n不知是好是坏、\n虽然完全搞不清楚、\n"],["「……まずは……[l]\nそのバス停か……[l]\n乗る人と間違われないように……[l]\nしないと……」","「……首先……[l]\n那个公交站台吧……[l]\n别被当成等车的人……[l]\n必须小心……」"],["……そういうことには頭回るんだよなぁ、[l]\nやっぱり……","……这种时候脑子转得倒是快，[l]\n果然……"],["でも、\n","可是，\n"],["正直なところ自分がナニでナニをしてるのか、\n苛まれるよりは、\n","老实说根本搞不清自己在干嘛，\n与其被折磨，\n"],["──だからそれすらも単なる逃避の結果だと、\n","──所以连这都只是逃避的结果，\n"],["でもそれでは駄目だという、\nクソ真面目な意思が強固に巣くうこの、\nしこう、\n","但这样是不行的，\n这个被该死的认真性格牢牢占据的，\n思考，\n"],["──何度●ったらワカル。","──要死●多少次才明白。"],["「っ、おわ？！[l]\nび、吃驚した……」","「呜、啊咧？！[l]\n吓、吓死我了……」"],["次のバス停で着くとこまで来た、\nとメールが来た。","短信说到下一个站台就快到了，\n消息这么写着。"],["………。",""],["「……律儀なやつ……なんだよな彼奴は……」","「……死板的家伙……他到底算什么啊……」"],["身支度をして、\n車を降りる。","整理好衣着，\n走下车。"],["……外に出ると、身体が震えた。","……来到车外，身体颤抖起来。"],["バスは平日の昼間だし、\n地域的なものなんだろうが、\n殆ど客が乗ってないであろう事は容易に想像でき、\n故に矢張り迂闊にバス停近くに立ってるのは憚られた。[l]\n……ベンチとかあれば、[l]\nがっつり座り込んで乗らない意思を主張出来たんだろうけど、\n残念ながら此処は単に、\n時刻表──殆ど空欄──の付いた例の看板が立ってるだけだ。","因为是平日的白天巴士，\n虽然可能是地区性的缘故，\n但很容易想象几乎不会有乘客，\n所以果然还是不宜贸然站在巴士站附近。[l]\n……要是有长椅之类的话，[l]\n倒是可以大喇喇坐着表明不乘车的态度，\n可惜这里仅仅立着\n那块贴着时刻表——几乎全是空白——的招牌。"],["不自然でない程度に、\nかつ明確に乗る意思が無いのを態度で主張しつつ、\n近辺をうろうろしていると、\nそう時を開けずにバスがやってきて停車場で止まった。[l]\nバス停には誰一人として乗り待ちの客は居なかったし、\n僕が客と間違われたのでない限り、\n降りる客が居るのだろう。[l]\nつまり、\n","我以不至于显得不自然的程度，\n同时用肢体语言明确表达没有乘车意愿，\n在附近徘徊时，\n没过多久巴士就驶来停在了站台。[l]\n巴士站没有任何候车的乘客，\n只要不被误认为是乘客的话，\n应该是有下车的人吧。[l]\n也就是说，\n"],["「……おひさし」","「……好久不见」"],["狩屋が降りてきたのだった。","下车的是狩屋。"],["他に誰も降車する客は居らず、\n僕の事も、\n彼女を出迎えた人間と了解したのだろう、\nバスはそのまま走り去っていく。","没有其他乘客下车，\n大概也把我\n当成了来接她的人，\n巴士就这么径直开走了。"],["「お゛う……」","「呜哇……」"],["「にょえあ……」","「咿呃……」"],["歩み寄って挨拶すると、\nお互いにいがらっぽい声だった。","走上前去打招呼时，\n彼此的声音都带着刺儿。"],["「……風邪でも引いたのか？」","「……难道是感冒了？」"],["僕の方は、\nまあ、あの時からの自分を取り巻く状況の事もさることながら、\n実際『寝り』の体勢とか環境が影響してるんだろうが。[l]\n流石に夕べは──\n例え給油とかででも余計な人との接触を避けたかったので──\n車中もエンジンかけなかったし、\nそれで多少寒かったような気もするけど、\n狩屋が風邪引く程だったかどうか、\nそれは分からない。","我这边，\n嘛，除了当时以来围绕自己的状况之外，\n实际『睡觉』的姿势或环境也有影响吧。[l]\n毕竟昨晚——\n就算是为了加油之类也想避免和多余的人接触——\n车里也没开发动机，\n所以可能有点冷，\n但狩屋是否到了感冒的程度，\n那就不清楚了。"],["「え、そんにゃに声変？[l]\n","「诶、声音变这喵样？[l]\n"],["……別に風邪じゃにゃいけど、[l]\n","……倒没感冒喵，[l]\n"],["ま、寒いは寒いかもにぇ……特に夕べから今は……[l]\n","不过、冷确实是有点冷喵……特别是昨晚到现在……[l]\n"],["ん、ういは大丈夫だよ。[l]\n","嗯、没、没事的。[l]\n"],["あんまし寝てにゃいだけ」","只是没怎么睡喵」"],["そうだったのか……[l]\nあんなあっさり眠りに落ちるとも思わなかったし、\n冬場だったら危険だったかも知れない。","原来如此……[l]\n没想到会那么轻易睡着，\n要是冬天可能就危险了。"],["何にせよ、\n風邪じゃなくたって、\n……様子は確かにおかしいし、[l]\nああ、あまり寝てないって言ったか。[l]\nそもそも今回会おうという話も、\n決して愉しい中身じゃないんだろうから、\nこのテンションも不思議ではないんだろう。","总之，\n就算不是感冒，\n……状态也确实不对劲，[l]\n啊，说是没怎么睡来着。[l]\n本来这次说要见面，\n内容也绝不可能是愉快的，\n这种氛围也不奇怪吧。"],["やるせなくなって、\n兎に角コトバを発しようとする僕。","感到郁闷，\n总之试图开口的我。"],["「おひさしっていうか、\nなんか……久しぶりなのかどうなのか、[l]\nよくわかんなくなってるよ……[l]\nまあ、どっちでもいいんだけどさ……」","「该说好久不见，\n还是……不知道算不算久违，[l]\n已经搞不清楚了……[l]\n嘛，怎样都无所谓啦……」"],["「ぬ、どうにゃっけ……？[l]\nういもよくわかんにゃい」","「唔、怎么喵来着……？[l]\n人家也搞不清喵」"],["実際は、\n出会い頭にいきなり、\nテンションギアマックスの方が不自然だろうけども、\n……要するに僕等はやっぱりぎくしゃくしたまんまで、[l]\n会話もそこで途絶えてしまった。","实际上，\n刚碰面就突然，\n情绪高涨反而更不自然，\n……总之我们果然还是尴尬着，[l]\n对话也在此中断了。"],["そのまま数秒、\n変な距離を……精神的にも肉体的にも、[l]\nおいて、微妙に探り合う感じのおかしな空気が流れる。","就这样过了几秒，\n保持着奇怪的距离……精神上和肉体上都是，[l]\n弥漫着微妙试探的古怪气氛。"],["お互いに視線を合わせないまま。","彼此都没对上视线。"],["「………」",""],["折角昨日復調しかけたと思った僕も、\n人と接触しないまま一晩のインターバルは、\n思いの外に、\n浮かれた感じを冷却してしまった……らしい。","本以为昨天好不容易恢复状态的我，\n没和人接触就度过一晚的间隔，\n意外地，\n把亢奋感冷却掉了……似的。"],["均衡を保とうとした結果、\nつまり感情落差を早く埋めようと、\n無意識にでも、必要以上にクールダウンしたということなのか、\nこんな事も今までに経験無い訳じゃなかったけど、\n","试图保持平衡的结果，\n也就是想尽快填补感情落差，\n无意识地过度冷静了下来，\n这种事倒也不是没经历过，\n"],["というよりそれ以前に僕等、\nこの二人という組み合わせの違和感というか……[l]\n今までは狩屋と姫様ちゃんは常にセットだったし、\nこの場に僕と狩屋だけ、というのは、\n","不如说在那之前我们，\n这两个人组合的违和感该怎么说……[l]\n毕竟之前狩屋和姫様总是成对出现，\n现在只有我和狩屋在场，\n"],["「ん゛っ、んんっ」","「嗯、嗯嗯」"],["無意味に咳き込む。[l]\n間が持たない。[l]\n空気を悪くしたい訳じゃないので、\n何とかしたいとは思ってるのだが、\nそれがまたプレッシャーになるっていうか、\nそして彼女からも同様のオーラがばりばり放出されてるし、\n","无意义地咳嗽。[l]\n无法打破沉默。[l]\n并不想搞坏气氛，\n虽然想设法改善，\n但这反而成了压力，\n而且她也正释放着同样的强烈气场，\n"],["「んー、\nんー、\n………」","「嗯——\n嗯——\n………」"],["………。[l]\nまあ、\nそうでなくても、\n多分、\nお互いここに来るまで、\n誰とも喋らずにずっと黙っていたのだろう。[l]\n先刻の声の出し方は要するにそういう事だったのかと思う。","………。[l]\n那个、\n就算不是这样、\n大概、\n我们俩在来到这里之前、\n都一直没跟任何人说话保持沉默吧。[l]\n刚才发声的方式说到底就是这么回事吧。"],["「えーーと、\nその、………、[l]\nあのね」","「呃——\n那个、………、[l]\n我说啊」"],["「……あのさ、[l]\nえあ？」","「……那个啊、[l]\n诶啊？」"],["やっと口火を切ろうと決意したのはいいけれど、\n再び発言のタイミングがモロ被りする僕等。","好不容易下定决心要打破沉默、\n结果我们俩的发言时机又完全撞在一起。"],["「にゃにゃにゃ、\nにゃんだべさ？」","「喵喵喵、\n咋回事喵？」"],["「いいいいや、その、\nどうぞそっちが、\nてか僕等なんかあれだな？[l]\nいつもこんなだな？[l]\n何してんだか……あはは……」","「不不不、那个、\n还是你先、\n话说我们这样该怎么说呢？[l]\n总是这种状态呢？[l]\n到底在搞什么……啊哈哈……」"],["「はっ、ははあはげほげほげほ、\nどっ、どう、え？[l]\n","「哈、哈哈啊咳咳咳咳、\n怎、怎么、诶？[l]\n"],["ちょ、ごめ、\nえふえふえふっ」","等、抱歉、\n呃呼呃呼呃呼」"],["「む、無理しなさんな、\n落ち着け、\nなんかしらんけど悪かった、\nほれ、な？」","「别、别勉强自己、\n冷静点、\n虽然不知道为啥但对不起啦、\n喏、对吧？」"],["「い、いあ、\nこちらこそ、\nちょ、ちょっとまってごめんなさい、\nはぁあぁ～～～……[l]\nひぃいぃ～～～……」","「没、没事、\n我才是、\n等、等一下对不起、\n哈啊～～～……[l]\n咿呀～～～……」"],["「ん、思う存分深呼吸してくれ……[l]\n……僕もしとくか……[l]\nはぁ……」","「嗯、你尽管深呼吸……[l]\n……我也来一下……[l]\n哈啊……」"],["ま、まあ、\n出だしさえ何とかすれば、\n相変わらず視線を合わせないままではあるけど、\n","嘛、算了、\n只要开好头、\n虽然还是老样子不敢对视、\n"],["漸く場が暖まってきたと言うか、\nなんか、\n良いのか悪いのか、\n此奴と話してると何故か頭は活性化する……んだよな。[l]\nスムーズに動いてるかは別として、だけど……","但总算可以说气氛开始缓和了、\n怎么说、\n不知是好是坏、\n和这家伙说话时脑子总会莫名活跃起来……真奇怪。[l]\n虽然实际运作是否顺畅另当别论……"],["冬夏とかは何もせずとも向こうから攻めて来るし、\nどうしてもこっちはいつも受け身になりがちだったから、\nこう、\nまともに対等っぽい位置で語り合えるのが、\n狩屋……っていうのはあったかも知れない。[l]\n前例で言えば、\n少ない友人であるところの大神がその位置な訳で、\n","像冬夏那种会主动进攻的类型、\n搞得我总是被动应付、\n所以像这样、\n能在看似对等的位置交谈的、\n大概只有狩屋……了吧。[l]\n以前例来说、\n少数朋友里的大神就处于这种位置、\n"],["「そうだなあ、\nなんかあれだな……[l]\nまるでお前とも、ずっと前からともだ──ちだったようなかん……」","「是啊、\n怎么说呢……[l]\n简直像和你早就是朋——友似的……」"],["そう言いながら何の気もなく狩屋の方を向いただけなのに、\nそこで初めてモロに視線があったからなのか、","明明只是随口说着转向狩屋那边、\n却因为第一次直接对上视线、"],["「………！！？？[l]\n………っ、ぅふうぁ、[l]\n","「………！！？？[l]\n………呜哇、[l]\n"],["……んっ！！[l]\nばっ！！！」","……嗯！！[l]\n啪！！！」"],["「……？」",""],["何か息を呑んだり、色々と慌てふためきのリアクションをする狩屋。","狩屋倒吸一口气手忙脚乱的反应。"],["「？[l]\n？[l]\nあ、いや、その、あれ？」","「？[l]\n？[l]\n啊、不、那个、咦？」"],["「げふっ、こほっ、\nぬ、にゃ、にゃんでもっ。[l]\n","「咳哼、咳咳、\n呜、喵、喵啥事也没有。[l]\n"],["あわわわわわわ、あ、あれっ？[l]\n","慌慌慌慌慌、啊、咦？[l]\n"],["あれっ？[l]\nえっえっ？？」","咦？[l]\n诶诶？？」"],["ぎくしゃくというよりは最早、\nあわあわのふわふわで、\nあの時の冬夏みたいだな──\n","与其说是生硬不如说完全是\n手忙脚乱的状态，\n简直像那时候的冬夏一样──\n"],["……ああ、まあ、[l]\n冷静に考えれば一般的な男女間の会話としては、\nちょっと変な意味に取られかねない唐突な物言いと動きだった……か。[l]\nそういう判断、というか距離感とか、\n今ちょっと混乱してる……んだろう僕は。","……啊啊、那个、[l]\n冷静想想作为普通男女间的对话来说，\n刚才的言行举止确实可能被误解成奇怪的意思……吧。[l]\n这种判断、或者说距离感之类的，\n我现在稍微有点混乱……大概。"],["別に格別変な意味とかなく、\nその、敢えて言うなら、\n引いてないかとかそういうネガティヴな意味での顔色伺い的に、\nあくまでも一般的コミュニケーションとしての範疇での正否を、\n確認しようとした上での動きだったんだと思うけど、\nまあいずれ、\nそういう事すらも考えてる時点で、あれだ、\nまだ、\n……あうあ。","倒也不是有什么特别奇怪的意思，\n那个、硬要说的话，\n只是担心会不会被疏远之类的负面意义上的察言观色，\n纯粹想确认作为普通社交范畴内的\n行为是否恰当而已，\n不过说到底，\n会考虑这种事情本身就已经、那个、\n还、\n……呜哇。"],["ていうか、\n狩屋も、ちっと、","话说回来，\n狩屋你也、稍微、"],["先","不"],["刻からそれ狼狽え過ぎじゃない？","从刚才开始是不是慌张过头了？"],["「い、いーけどさぁ、ういはっ。[l]\nあ、兄ぃはその、\nま、前も言ったにゃが！[l]\nそういうことにゃから！！」","「没、没事啦饭哥，呜哇。[l]\n啊、大哥你那个、\n嘛、之前也说过的喵！[l]\n就是这样的喵！！」"],["「あはは……それなら……いいけどな……」","「啊哈哈……那样的话……倒也没关系……」"],["……ごめん、[l]\nホントのことを言うと前何を言われてたかは、\n記憶に定かじゃなかった。[l]\nでも、\n","……抱歉，[l]\n说实话之前具体被说了什么，\n我记不太清了。[l]\n但是、\n"],["「ありがとな……」","「谢谢啦……」"],["素直に本心から、\nそう言った。","发自内心地\n这么说道。"],["「………めてよ……[l]\n","「………别这样……[l]\n"],["そんな、……」","这种、……」"],["……何か切羽詰まった様な眼で僕を","……她用近乎走投无路般的眼神"],["視","视"],["据えたまま、[l]\n硬直しながら何か呟いて、いるみたいだけど、\n","直直盯着我，[l]\n僵在原地似乎在小声嘀咕什么，\n"],["──さっきなにか、\n","──刚才是不是、\n"],["何と言ってるのかまでは、\n","具体说了什么、\n"],["──刺激したか或いはされたか、\n","──是被刺激到还是刺激了别人、\n"],["分からなかった。","我搞不清楚。"],["──もうひとりからなにか、\n","──突然听到另一个\n"],["と、矢庭に理解可能な声で彼女が話し出した。[l]\n或いは僕の方で可聴状態になっただけかも知れないけど……","她能发出可以理解的正常声音了。[l]\n也可能只是我这边恢复了听力……"],["「……じゃあさぁ、[l]\nそう思うならさぁ、\nういのその、\n","「……那我说啊，[l]\n既然这么想的话，\n我的那个、\n"],["ういの話もちゃんと聞いてね……？」","我的事情也要好好听哦……？」"],["「そりゃまあ、僕なんかでいいならば……」","「这个嘛，只要不嫌弃我的话……」"],["ただの相談ごとじゃない、のだろう。[l]\n冬夏や狩屋達には、\nあの、\nネコガミやら……それは最早、僕とも無関係ではない、[l]\nという事でもあって、\n","应该不只是普通的商量吧。[l]\n对于冬夏和狩屋他们来说，\n那个、\n猫神什么的……说到底也和我脱不了干系，[l]\n正因为如此，\n"],["………？",""],["「……どうした？[l]\n痛いのか？寒いのかやっぱ？」","「……怎么了？[l]\n是疼吗？还是说果然觉得冷？」"],["頻りに手首をさすっていたので、\n思わずそう問うた。","因为一直不停地揉着手腕，\n不由得这样问道。"],["「え？[l]\n","「诶？[l]\n"],["ああ、\n","啊啊，\n"],["……ぬぬ？」","……嗯嗯？"],["明確な返答をせず、\n何故か首を傾げる狩屋は、\nその、前会った時と同じ格好で、\nつまり、\n","没有给出明确的回答，\n不知为何歪着头的狩屋，\n那副，和上次见面时一样的打扮，\n也就是说，\n"],["端から視てて脚が……寒そうで。","从旁边看腿……显得很冷的样子。"],["「え、あ、その、\n兄ぃと違って若いからいっかなーと思ったけど、\n","「啊、那个、\n想着和大哥不一样还年轻应该没关系吧，\n"],["にゃんか、やっぱちっと寒いにぇ？[l]\nはは……」","但果然还是有点冷吧？[l]\n哈哈……」"],["「まあ、確かにそのなりじゃな……はは……[l]\n女子は脚出すくらい大丈夫かも知れんけど、\n無理しなさんなよ？」","「嘛，确实这身打扮……哈哈……[l]\n女生露腿可能没什么问题，\n但别太勉强自己啊？」"],["どっかで聞いたような話だった気もするけど、\n考えないことにした。","总觉得这话好像在哪听过，\n但决定不去多想。"],["「ちょっとばたばたしたまま出て来たからさ……[l]\n寝てないのもあるけど、その割に、\n準備とか全然、してにゃいってか、何も考えるよゆうもさ……[l]\nまっ、その、\n","「因为有点匆忙就出来了……[l]\n虽然也有没睡觉的原因，但相比之下，\n完全没做准备什么的，或者说根本没空想这些……[l]\n嘛、那个、\n"],["いいの、ういの脚のことはっ。[l]\nなんにしても……あ、兄ぃが、思ったよりは元気そうで、[l]\n","没事的，腿的事无所谓啦。[l]\n不管怎样……啊，大哥看起来比想象中有精神，[l]\n"],["よかった、うん」","太好了，嗯」"],["……どうにも拭えないこの、[l]\n互いに気を遣ってる感が\n僕がこんななのは兎も角、\n狩屋には一体何事があったんだろう。[l]\nそれを今から話してくるのだろうけど、\n何にしろ狩屋にしてはしおらしいテンションに違いはない。[l]\nとは言え、ここであの時みたいにぶん殴られても、\nそれはそれであれだけど……","……无论如何都挥之不去的这种，[l]\n互相客套的感觉\n我这样倒没什么，\n但狩屋到底发生了什么事呢。[l]\n虽然接下来应该会告诉我，\n但不管怎样狩屋这异常乖巧的态度实在罕见。[l]\n话虽如此，就算现在像那时一样被揍，\n那也是另一回事了……"],["「……」",""],["そんなつもりは毛頭無かったけど、\n別に『あの時』から連想した訳じゃないんだけども、\n思わず狩屋の脚に視線を這わせてしまい、\n","虽然完全没有那个意思，\n也不是因为联想到『那时候』的事，\n却不自觉地把视线移向狩屋的腿，\n"],["「や、ちょ、えっ？！」","「啊、等、诶？！」"],["「あっ、ごめっ、いや、あ？！[l]\n違う、違うがな！！[l]\nいみはないです！！」","「啊、抱歉、不是、诶？！[l]\n不对、不是那样的！！[l]\n没有别的意思！！」"],["つ、つーか、\nえ、僕の眼ぇそんな眼だったか？！","不、不是，\n诶、我的眼神有那么奇怪吗？！"],["慌てて視線を逸らし、\n上空に眼を転じると、\n","慌忙移开视线，\n抬头望向天空，\n"],["「あっ、ああ、\nて、天気悪いな、気付かなかっ……たな……」","「啊、啊啊，\n天、天气真差啊，都没注意到呢……」"],["意識して空なんか視てなかったから、\n","因为没刻意看天空，\n"],["ああ、これ、は……","啊，这是……"],["「一雨来そう……かな……」","「要下一场雨了吧……大概……」"],["「ぬい？[l]\nああ、うん……[l]\n雪、なるかもにぇ、\nこの辺じゃこの時期でも、\nたまーに降るときあるから……」","「嗯？[l]\n啊，嗯……[l]\n说不定会下雪呢，\n这地方就算在这个季节，\n偶尔也会下的……」"],["言われてみると、\n湿度やら空気の感じ、空の鋭さ……とでもいうべきか、[l]\n遠くの景色の視え方とかが、\nまるで締め付けるが如き凛とした厳格さで僕等に迫って、\n","被这么一说，\n湿度啊空气的感觉、天空的锐利……或者说，[l]\n远处景色的可见度之类的，\n仿佛被勒紧般带着凛冽的严苛压迫着我们，\n"],["「へえ……雪……か」","「诶……雪……啊」"],["中央の方に居たときは、\n冬真っ只中だろうと、滅多に雪なんか降らなかった。[l]\nにも関わらず、\n僕等の上空を覆うこの、\n雪を予感させる何かは、\n容易にその存在を感じさせるに十分だった。","在中央地区的时候，\n就算正值隆冬也很少下雪。[l]\n尽管如此，\n笼罩在我们上空的这种，\n预示着雪的某种气息，\n已足够让人轻易感受到它的存在。"],["それとも、\n子供の頃の記憶なのか。[l]\n或いは、\n旅行先での経験故か。","又或者是，\n童年时的记忆呢。[l]\n也可能是，\n旅行途中的经历所致。"],["いずれにしても、\nこの空気感は、\n厳然とした、まさに冷酷さを","无论如何，\n这种氛围，\n俨然正是冷酷"],["湛えて、\n今にも、\n世界を白く染めんと、\n","蓄积着，\n眼看就要，\n将世界染成纯白，\n"],["「セカイが……白く……」","「世界要……变白了……」"],["「……？[l]\n兄ぃ？[l]\nうっあ、あうぅ」","「……？[l]\n老哥？[l]\n呜啊、啊呜」"],["「え？[l]\nあ、ああ、ごめんなんでも」","「诶？[l]\n啊、啊啊、抱歉没什么」"],["……あれ、[l]\n何故か鼻声に……[l]\nまあ、まさに実際寒いのだろうし、\n………。","……奇怪，[l]\n不知为何带着鼻音……[l]\n嘛，实际上确实很冷吧，\n………。"],["「……いてるの？[l]\nんんん、いあ、にゃんでも、\nえっとほら、\nまあ、移動しよう、ね？[l]\nまずは。[l]\n此処で立ち話って怪しすぎるからっ」","「……疼吗？[l]\n嗯嗯嗯、没、没啥，\n那个你看，\n总之先移动吧，好吗？[l]\n首先。[l]\n站在这种地方说话太可疑了啦」"],["あ、ああ、そうか。[l]\n駄目だなあ……[l]\n眠いのも空腹も、暑いのもあれだけど、\n寒いのも、十全な思考を妨げるんだよな、\nいかんいかん、\nいかん……","啊、啊啊、说的对。[l]\n不妙啊……[l]\n虽然犯困和空腹，还有炎热也是原因，\n但寒冷也会妨碍正常思考啊，\n不行不行，\n不行……"],["ぐすっ、\n","呜咽、\n"],["一度はなを啜る。[l]\n四月末だってのに、全くよう……","先抽了一下鼻子。[l]\n明明都四月底了，真是够了……"],["「えーとじゃあ、\nどっか行く……アテある？」","「呃—那啥、\n找个地方去……有安排吗？」"],["「ぬ？[l]\nん……[l]\n車、にいこか。[l]\n車の中行こ。[l]\nまずは。[l]\nういもその、\nよくわかんにゃい、いま、いろいろ」","「唔？[l]\n嗯……[l]\n车、去车上吧。[l]\n去车里。[l]\n先这样。[l]\n还有就是那个、\n搞不太懂啦喵、现在、各种事情」"],["「わかった……じゃあ、[l]\nこっち、\n行こうか」","「知道了……那、[l]\n这边、\n走吧」"],["狩屋は、\n一瞬横に並ぶべきか後ろをついて行くべきか躊躇したようだったけど、\n","狩屋、\n似乎犹豫了一瞬是该并肩走还是跟在后面、\n"],["「……うぅ……やっぱさぶいよばかぁっ」","「……呜……果然好冷啊笨蛋」"],["と、そわそわしながら、\n横に並んだ。","这样说着，局促不安地、\n并排走到身旁。"],["……僕等は２人とも、[l]\n今物凄く安定を欠いているのだろう。[l]\n打ち沈んでるのにも関わらず、\n明るく振る舞いたい、\nそうありたい、と思う意思が、\n過剰に表面に顕れるので、\n一見明るそうには視えるのだけれど、\nそれが、また、\n空回りしてるようで、\nそれが逆に切なくて、\nすぐに現実に引き戻されて、\nでも、それが辛くて、やっぱり無理に明るくあるべく振る舞おうと、\n","……我们俩啊，[l]\n现在大概都处于极度不稳定的状态吧。[l]\n明明消沉得要命，\n却硬要装出开朗的样子，\n这份想要强撑的念头，\n过度浮现在表面，\n乍看好像挺阳光的，\n但那种状态\n反而像是在白费力气，\n让人看了更揪心，\n转眼就被现实拽回原形，\n可又因为太痛苦，还是忍不住强颜欢笑，\n"],["そんな２人が揃ったら、\nそれはもう……","要是那两个人凑到一起的话，\n那可真是……"],["痛々しいったらありゃしない。","惨不忍睹到没眼看。"],["とは言え、\n狩屋の方の事情はまだ分かってない訳で、\n僕が勝手に瑕の舐め合いと思うのは早計かもだが、\n","话虽如此，\n狩屋那边的情况还没完全搞明白，\n我擅自觉得是互相舔伤口可能还为时过早，\n"],["「あっ、のっ」","「啊、那个」"],["「……あっ？[l]\nあ、あー、なんだ？」","「……啊？[l]\n啊、啊ー、怎么了？」"],["知らず僕が自分の思考に没入してると、\n急に狩屋が声を上擦らせた。","不知不觉我沉浸在自己的思绪里时，\n狩屋突然提高了嗓门。"],["「あー、あのさ、\n電話で声だけ聞いたときは、\nちょっと心配したけど、っ、\nそらーもう、\nこっちがしっかりしにゃきゃと思うくらい？[l]\nでも実際こうして会ってみたら視たら、\nまあ、\nそんなでもなかったから、\nまあ、\nよかった、ですよ。[l]\nよかったです」","「啊ー、那个啊，\n电话里只听到声音的时候，\n还有点担心的，呃，\n现在嘛——\n反倒该我振作起来才行吧？[l]\n但实际这样见面一看，\n呃，\n也没那么严重，\n所以，\n挺好的，真的。[l]\n挺好的」"],["「あー、\nまあ、\n実はそうでもないけどな、\nとか言って余計な心配をかけてみたりな……」","「啊ー，\n其实，\n倒也没那么夸张啦，\n不过说这种话反而会让你多操心吧……」"],["「ばか、\nほら全然だいじょぶそうじゃんよ。[l]\nあーもう、\nういの方が寧ろ今──」","「笨蛋，\n你看这不是完全没事嘛。[l]\n啊真是的，\n现在明明是我更——」"],["「……どうかしたのか？[l]\nてか、\n……いきなり無理に話さんでもいいぜ、[l]\n僕も、ほれ\n期待されてるフォローなんか出来ないかも、\n知れないし……」","「……怎么了？[l]\n话说，\n……突然硬聊也没必要，[l]\n我啊，那个\n可能也做不到你期待的回应，\n说不定……」"],["そこは、\n告白を後回しにされたって一緒ではあるんだけど……","这方面，\n和告白被拖延的情况倒是如出一辙……"],["「ん～～、\nまあ、\n車、行ってから。[l]\nね。[l]\n","「嗯～～，\n算了，\n上车再说吧。[l]\n好吗。[l]\n"],["……昨日ね、電話してから、[l]\n行き場が無くなっちゃって、\n","……昨天啊，打完电话后，[l]\n就无处可去了，\n"],["本当はすぐにでも会いたかったんだけど、[l]\n","其实当时就想立刻见面的，[l]\n"],["っっって、別にその変な意味に取っちゃだめでせあ！！[l]\nああああの、\n手持ち無沙汰！[l]\n手持ち無沙汰になったってこと！！[l]\n無駄に待つ時間にゃんかつくんなきゃ良かったって、\n思っただけ！！」","但但但、别往奇怪的方向想啊！！[l]\n啊啊啊那个，\n闲得发慌！[l]\n就是闲得发慌的意思！！[l]\n早知道不该在无谓的等待时间瞎折腾，\n只是这么想而已！！」"],["「あいあい……わかってます……」","「好啦好啦……我懂的……」"],["「うぅ……[l]\n兄ぃに迷惑かけちゃだめかと思って、\n時間あけたのにさ、\n何か、\n……いいですもう。[l]\n","「呜……[l]\n想着不能给哥哥添麻烦，\n特意空出时间的，\n结果，\n……算了不说了。[l]\n"],["あ、何か食べた？」","啊，吃过东西了吗？」"],["「あ、いや、\nでも何か喰うなら、入れれば入る、\nなしでも構わない、て感じかな……」","「啊、没，\n不过要吃东西的话，塞得下就塞，\n不吃也行，这种感觉吧……」"],["「……ぬーん。[l]\n","「……唔嗯。[l]\n"],["じゃ、ちょっとコンビニで買いたい。[l]\nごはんレベルまでいかにゃいあれで……」","那我去便利店买点。[l]\n至少得达到正经饭食级别才行……」"],["「ああ、じゃあ今度こそ僕が","「啊啊，那这次就由我"],["奢るから、\nその、僕は外で待ってるから……[l]\nほれ、お金」","来请客，\n那个，我在外面等着……[l]\n喏，钱」"],["「え？[l]\nなんで一緒にいかないの？[l]\nてか、お金、\n","「咦？[l]\n为什么不一起进去？[l]\n话说这钱，\n"],["ああ、あう、……確かに今、手持ちが微妙です……[l]\n","啊啊、呃……确实现在手头有点紧……[l]\n"],["ぬゅうぅ、でも……」","唔唔、可是……」"],["「僕はその、ほれ、僕というかお前があれだよ、\n隣町とは言え噂になったりしたらアレだろぅ……」","「我是说那个、你看、与其说我不如说你啊，\n虽说只是邻镇但传出流言的话会很麻烦吧……」"],["「はぃ？[l]\nなに？」","「哈？[l]\n啥意思？」"],["「や、兎に角僕はいいんだ。[l]\nあああれか、問題はそっちじゃなくてか？[l]\nあれ気にしてるんならだな、\nこれで借りを返したとか言わないから、\n遠慮無くもってきな、\nどうしても気になるなら返してくれりゃいいし」","「嘛、总之我没事。[l]\n啊啊是说那个吗，问题不在那边？[l]\n如果在意那件事的话，\n我保证不会说什么'这下还清人情'之类的话，\n别客气收下吧，\n实在过意不去以后还我就行」"],["……そんな機会が、[l]\nこのあと、事態が進展したあとでも、\nあるなら、\nだけど……","……那样的机会，[l]\n在这之后、事态发展之后，\n如果还有的话，\n但是……"],["「……なんかよくわかんないけど、[l]\nじゃー兄ぃの欲しいのも買ってくるよ？[l]\nなにほしい？」","「……虽然不太明白，[l]\n那——我顺便帮哥哥买想要的东西？[l]\n想要什么？」"],["「あ、あーーー……[l]\nじゃあ甘いもんを……[l]\n脳に糖分が欲しい……[l]\nブドウ糖強化系のなんかそういうやつ……があったようなないような」","「啊、啊——……[l]\n那就甜食吧……[l]\n大脑需要糖分……[l]\n葡萄糖强化系的那种东西……好像有又好像没有」"],["「ん、なんとなくわかった、\nじゃ、行ってくるにぇ、\n","「嗯、大概明白了，\n那我去去就回喵，\n"],["ぇあーっと、此処に居る？」","诶呃——、是在这里等？」"],["「あー、うん、此処に居る。[l]\nいってらさい」","「啊——、嗯，就在这里。[l]\n路上小心」"],["たたたたた………と狩屋は足早に店へ向かった。","哒哒哒哒哒………狩屋快步奔向商店。"],["もし僕が、\n","如果我，\n"],["………きめてしまったら、","………做出决定的话，"],["この娘とも、\n敵……という言い方が合ってるかは分かんなけど、[l]\nこんな風に話す事なんか不可能な関係になるも知れない……[l]\nのか。","和这女孩，\n敌人……这种说法是否准确虽不确定，[l]\n很可能就会变成连这样对话都不可能的关系……[l]\n吗。"],["いや、\n猶予があるとか思うこと自体、\n僕が勝手に考えて──否、考えないようにしてるというか、\nそう、\nどっちにしてもこんな悠長な有様、\n","不，\n以为还有余裕这种想法本身，\n就是我擅自认为──不，应该说是刻意不去思考，\n没错，\n无论如何这般悠哉的状态，\n"],["──なぜってワレは●●だからさ。","──因为老子是●●啊。"],["強烈な逃避、つまり今までもずっと考えてるように、\n深刻になりすぎないように反作用的に、\nカラダとココロが防衛機構を働かせてるのか、\n","强烈的逃避，正如同至今为止的思考模式，\n为了避免过于沉重而产生反作用，\n身体与心灵启动了防御机制，\n"],["──もうすこしで、\n","──再这样下去，\n"],["あたまのどこかでは頑なとも言える程の安寧感が、\n","脑海中某处近乎顽固的安宁感，\n"],["──まだ忘れている●●●●が●り●だし、\n","──尚未遗忘的●●●●正在●出●头，\n"],["なんなのだろう、絶対的なジシンが僕に内在していて、\n","究竟是什么，绝对的自信扎根在我体内，\n"],["──あとはどの●●とネ●コ●になるか。","──接下来就看和哪个●●变成猫●了。"],["……どの？","……哪个？"],["──それともすべてと、\n","──亦或是与全部，\n"],["すべて？","全部？"],["──例えばクタイを","──比如将纽带"],["ソ","撕"],["ク","口"],["シ","扯"],["ツ─\n","断─\n"],["「ただいまー、\nんに？」","「我回来了ー、\n嗯咦？」"],["……あれ？","……咦？"],["ああ、頭、ちょっと熱っぽいか、\n","啊啊、头、好像有点发热、\n"],["逆","就"],["上せた感じがする……","感觉血往上涌……"],["「お帰り……[l]\nなんか……[l]\nお前ともすっかりその、なかよ──」","「欢迎回来……[l]\n总觉得……[l]\n和你已经完全那个、要好──」"],["逆上せてる所為か、\n何故かそんなコトバが口をつき、って、\n","可能是血气上涌的缘故、\n不知为何这种话脱口而出、\n"],["……いきなり何を言ってるのだ僕は。","……我突然在说什么啊。"],["「へっ？！[l]\nあ、う、お、え、\n","「诶？！[l]\n啊、呜、哦、呃、\n"],["だっからっ、二度も言わなくていい！！[l]\nはっ、はず、うっ、\n","所、所以说、不用重复两遍！！[l]\n哈、羞、呜、\n"],["あっ、ごめ、\n","啊、抱、\n"],["お手洗い行ってくる！」","我去趟洗手间！」"],["あああ、案の定というか、\nまた狩屋を無駄にあわあわさせてしま……って、[l]\nえ？！","啊啊啊、果然不出所料、\n又让狩屋白白慌张起来……[l]\n咦？！"],["「はいっ？！[l]\n急にかい！[l]\nな、なんでまた、\nてかお前、\n今のときに行っとけばよかったのに……」","「哈诶？！[l]\n突然要去！[l]\n为、为什么又、\n话说你、\n刚才那会儿去不就好了……」"],["「きゅ、急だからしょうがにゃいでしょ！！[l]\nさむいからだよ？？！[l]\nさむいからだよ！！！[l]\nちょ、ちょっとこれ持って、\n","「因、因为急得没办法嘛！！[l]\n是因为太冷了？？！[l]\n是因为太冷了！！！[l]\n稍、稍等帮我拿这个、\n"],["あああああもう、\nこんなのきーちゃに視たり聞いたりされてたら、\nまたっ、\n","啊啊啊真是的、\n要是被小姬看到听到这种场面、\n又要、\n"],["きー、ちゃに、\n～～～……」","被小、姬、\n～～～……」"],["「て、手洗い行きたいならそんな悩んでないで、\n僕がわ、悪かったから、\nほれ、行ってこいもっかいコンビニ、\n此処で待ってるから」","「要、要去洗手间就别纠结了、\n是我不、不好、\n喏、再去趟便利店吧、\n我在这儿等你」"],["狩屋は半分涙眼で僕に袋を押し付けて、\n今出て来たばかりの店に向かって再び走り去った。","狩屋含着半眼泪把袋子塞给我、\n朝着刚出来的店铺又跑了回去。"],["車を停めてある駐車場にはがっつり公衆トイレもあるが、\nそんな口を挟む状況ではなかった……よね。[l]\nまあ、女子の生理現象は色々デリケェトなんだろう、\nよくわからないけど……","停车场的公厕明明近在咫尺、\n但根本插不上话……对吧。[l]\n嘛、女生的生理现象总是很微妙、\n虽然不太懂……"],["というか僕もどうかしとる、\nいや、でもあの程度、\n別に重く受け止めるとは限らない範囲だと思うが、\nまあ、\nいかん、\nいかんな、\nてかあれだ、\n狩屋じゃないけどこの寒さで実際、\n風邪でも引いたのかも知れないな。[l]\nよくよく思い起こせば、\n僕も病み上がりは病み上がりであるし……","话说我也不太对劲、\n不、不过那种程度、\n应该不至于太在意吧、\n算了、\n不行、\n不妙、\n话说回来、\n虽然不是狩屋但这天气、\n说不定真会感冒呢。[l]\n仔细想想、\n我也是刚病愈的状态……"],["ああ、\n早いとこ車に戻ろう。","啊啊、\n赶紧回车上吧。"],["狩屋、\n姫様ちゃんと居た時より、\n口調が不安定というか、\nいつもの砕けたアレと、\n年上に対しての一般的な距離感との間を、\nいったりきたり──\nというよりも、\n前も思った事だけども、\nその普通の方の喋りが、\n真面目で文武両道と聞く彼女の本来の","狩屋、\n比起和姫様在一起的时候、\n语气显得不太稳定、\n在平时那种随意的说话方式、\n和面对年长者时该有的普通距离感之间、\n来回摇摆──\n或者说、\n我之前也这么想过、\n她那种普通的说话方式、\n到底是传闻中正经又文武双全的她、"],["有り","本"],["様なのか、\n","来的样子、\n"],["否、それとも、他人行儀な部分、なのか。","还是说、那只是对外人的客套而已。"],["そうだ姫様ちゃん、\n","对了姫様、\n"],["……姫様ちゃん……","……姫様……"],["あの","那个"],["娘は、\n","那孩子、\n"],["──グアイのいいアイショウだったので、\n","──是爱的好榜样来着、\n"],["彼女達の中でも格別何か、\n","在她们当中也是特别的存在、\n"],["──いずれスべてない状態では、\n","──在还没完全恢复的状态下、\n"],["あの神社で会う前の時点では、\n確かに体調も悪そうではあったけど、\n","在那间神社见面之前、\n确实看起来身体状况也不太好、\n"],["──●ウソウしてもやむないな、\n","──●就算说谎也情有可原、\n"],["でも一体どうして、\n","但到底为什么、\n"],["冬夏とあんな確執が、\n","会和冬夏有那么深的矛盾、\n"],["──ＣＡＴのそもそもは敵を除するための朋だから、\n","──CAT原本就是为了除敌而结成的同伴、\n"],["狩屋と合わせて、二人は確か、\n","加上狩屋、两个人应该、\n"],["──敵を除する相がもっとも──\n","──是最擅长除敌的组合──\n"],["……といった話も、[l]\n僕はあのひとじゃないひとから、聞かされて、\n","……这些话、[l]\n我也是从那个不是她的人那里听来的、\n"],["道具さん、\n","道具小姐、\n"],["道具さん……も、何かにつけ色んな事を僕に、","道具小姐……也总是把各种事情、"],["……まさか僕の──コトも知ってい、て？","……该不会连我的──事情都知道、吧？"],["道具さ、あっ、きぃ……は？","道具小、啊、小贵……？"],["──きぃ？","──小贵？"],["西石貴奴？","西石贵奴？"],["──●？",""],["なにか、\n","有什么、\n"],["「……っとにばかぁ……としか言い様がないよぅ……[l]\n","「……真是笨蛋啊……只能这么说了……[l]\n"],["はぁぃ、今戻りました……」","哈啊、我回来了……」"],["「あっ？[l]\nおー、おう、おかいも……」","「啊？[l]\n哦、哦、欢迎回……」"],["「おか？？」","「欢迎？？」"],["「いあ、にゃんでもない……」","「没、没什么……」"],["「？[l]\n",""],["あ、袋ありがと、\nじゃ、行こ」","啊、谢谢袋子、\n那、走吧」"],["……あれ、[l]\n今僕は何か、\nあれ、\n何を考えてた……？","……奇怪、[l]\n刚才我在想、\n什么、\n在想什么来着……？"],["思考は一度中断されると、\nもう、\n必死に忘れようとする例の防衛システムの御陰か、\n","思考一旦被打断、\n就、\n或许是因为那个拼命想要忘记的防御系统、\n"],["将","将"],["又僕の脳空転の所為か、\n雲散霧消して、\n","又或者是因为我的脑子又空转了、\n全都烟消云散了、\n"],["と言うよりも、\n眼前に他人が居る時点で、\n普通は、独り思考してる余裕はないだろう。[l]\n相手を無視前提なら兎も角、\n当然今はそんな状況ではない。[l]\n寧ろ……","或者说、\n眼前有别人在的时候、\n一般来说、也没空一个人想东想西吧。[l]\n如果无视对方倒另当别论、\n当然现在不是那种情况。[l]\n不如说……"],["「いいよ、これはこのまま持ってるから。[l]\nえーと、こっちな」","「没关系、这个我拿着就好。[l]\n呃、这边」"],["「え、あ、\nあうあ、\nうう」","「诶、啊、\n啊呜啊、\n呜呜」"],["車でこのコンビニ来れば早かったな……[l]\n等と思いつつ、\n僕等は連れ立って歩き出した。","开车来这家便利店的话就能更快了……[l]\n一边这么想着，\n我们结伴走了出去。"],["「そういえば、\n学校はどうした？[l]\n……平日だよな？今日」","「说起来，\n学校那边怎么办？[l]\n……今天是工作日吧？」"],["すっかり曜日の感覚を失念してたが、\n確かそうだった……筈だ。","已经完全忘记星期几了，\n但应该没错……大概。"],["すると狩屋は気まずそうというか、\nバツが悪そうに、\n","于是狩屋露出有些尴尬，\n或者说难为情的表情，\n"],["「ああ、\nまあ、ういらは一応祭一週間前くらいからは、\n任意で休める……[l]\n有休みたいに出席に影響しにゃい事になってるんだ、\n皆勤賞とかは、ナシになるけどさ……[l]\nその辺はまあ、こっち側の配慮らしいけど。[l]\n……特別扱いされてるからね、三春の……ってことでういら。[l]\n自分等から贔屓を頼んだ訳じゃないです、っていう、\nこれみよがしな遠慮というか防波堤みたいなもん。[l]\nまあ、そんなことしなくても、ういらはずっと、\n腫れ物扱いだけどさ……[l]\n露骨に仲間外れにはされなかったけど、[l]\n畏怖とか過剰な敬意にね、\nだから、\n友達は身内──きーちゃとかしか、\n一緒に居られなくて、あー、\n愚痴るつもりはないんだけど……」","「啊，\n那个，我们祭典前一周左右开始，\n可以自由选择休假……[l]\n就像带薪假一样不影响出勤率，\n不过全勤奖之类的就没了……[l]\n这部分算是校方的特别照顾吧。[l]\n……毕竟三春家是特权阶级嘛，我们。[l]\n倒不是我们自己要求搞特殊化，\n这种刻意保持距离的态度更像某种防护墙。[l]\n其实就算不这样，我们也一直\n被当成易碎品对待……[l]\n虽然没被明显排挤，[l]\n但总是承受着过度的敬畏，\n所以\n朋友只有自家人──比如小姬这样的，\n才能待在一起，啊——\n倒不是想抱怨啦……」"],["そう言った。","她这么说道。"],["「ああ……[l]\nまあ、なんとなくわかった……[l]\nその、三春……」","「这样啊……[l]\n大概能理解……[l]\n那个，三春家……」"],["そう、特別扱い、\n初めはこの地方の郷士みたいな立場、\n書庫の町を取り仕切るのもその、書の所蔵故かと、\nそう聞いてたのだかそう思ったのだったか、\n","对，特殊待遇，\n最初听说像是地方乡绅的地位，\n能管理书库町也是因为藏书的关系，\n不知是听说的还是自己推测的，\n"],["だが、\n","不过\n"],["「ネコガミ……か、[l]\nおま、……君等のその、[l]\n背景にあるのは」","「猫神……吗，[l]\n你们背后……[l]\n是那个在支撑？」"],["すると狩屋の表情は一瞬堅くなり、声を潜めて、\n","狩屋的表情突然僵硬，压低声音说：\n"],["「……今は言えない」","「……现在不能说」"],["二人だけになってからで──\n","等只剩我们两个人的时候——\n"],["と言った。","如此宣布道。"],["ああ、\n言われてみれば少し不用意だった……","啊，\n说起来确实有点冒失了……"],["「……てか、にゃによ、[l]\nいきなり呼び方変えなくていいよ。[l]\nそれにえー、\n………、[l]\n………、[l]\n……ああ、冬夏ちゃが、言ったの？[l]\nそれともきーちゃが？」","「……话说，搞啥啊，[l]\n不用突然改称呼啦。[l]\n而且那个——\n………，[l]\n………，[l]\n……啊，是冬夏告诉你的？[l]\n还是小姬？」"],["ぼんやり曖昧に、\nという言外の意思を感じて、\n僕もそれなりに言葉を選ぶ。","感受到她含糊其辞中\n暗含的试探意味，\n我也谨慎地斟酌用词。"],["「……ああ、その……[l]\n言わなかったっけか、\nりょうほう……ってかんじかな……[l]\n具体的にというか最初にというかその、\nそれをそれしてきたのは、\n……」","「……嗯，就是……[l]\n我没说过吗，\n两边都……算是吧……[l]\n具体来说或者该说最开始，\n把这事挑明的\n……」"],["言うべきかどうか一瞬だけ迷ったけれど、\n隠す意味が、\n……熟考すればあったのかも知れないが、[l]\n今の僕にはみいだせず、\n","短暂犹豫是否该说出口，\n或许深思熟虑后\n能找到隐瞒的理由，[l]\n但现在的我想不出来，\n"],["「……冬夏、からだけどな……[l]\nでも、\nあの時電話で言ったように、\n僕はもうそういうのは──気にしないっていうか」","「……虽然是从冬夏那边听说的……[l]\n不过，\n就像之前在电话里说的，\n我已经不再在意那种事了──或者说根本无所谓」"],["そう答えた。","这么回答道。"],["──もう、ワガミのことだし──\n","──毕竟，都已经是过去的事了──\n"],["「へえ……[l]\n……んでだろうなぁ……[l]\n…………」","「嘿……[l]\n……原来如此啊……[l]\n…………」"],["狩屋は深刻そうに黙ってしまったので、\n","狩屋神情凝重地陷入沉默，\n"],["「でもほら、\n時間としてはタッチの差というか、\nそれに、\n会った時から何かそういう空気を出してたじゃんか、\n姫様ちゃんのが寧ろ、\nだから、どっちが先とか、\nあんまり関係、ないんじゃないかな……」","「不过你看，\n时间上也就差那么一丁点儿，\n再说了，\n从见面时起不就散发着那种氛围嘛，\n倒不如说姫様那边，\n所以谁先谁后，\n根本没什么关系吧……」"],["思わずフォローめいた事を口早に付け加えた。","我不由得加快语速补充了像是打圆场的话。"],["しかし、\nそこで会話は完全に途切れて、\n車に着くまで僕等は一言も言葉を交わすことはなかった。","然而，\n对话在此彻底中断，\n直到上车前我们都没再说过一句话。"],["「……『視えて』る、んだよね？」","「……你确实『看得见』对吧？」"],["助手席に狩屋、運転席に僕が乗り込み、\n一時の静寂の","狩屋坐进副驾驶，我坐上驾驶位，\n短暂的静默"],["後、\n彼女は切り出した。","过后，\n她开口道。"],["「あ？[l]\nあ、ああ、そう言ったな、確か電話で、\nあっさりとな、\n言っちゃったな……[l]\nああ、でも、最初っからじゃない……[l]\nこっち来てから、\nえー、まあ、そうなった……」","「啊？[l]\n哦、哦哦，确实在电话里说过，\n轻描淡写地，\n就说出来了呢……[l]\n啊不过，不是从一开始就……[l]\n是来到这边之后，\n呃──该怎么说，就变成这样了……」"],["真偽の程はまあ、未だにあれだけど、\nそれでも敢えて言うなら、『視えてる』のが本来の僕で、\nなのに、\n眼の前の、","真假暂且不论，\n但硬要说的话，『看得见』才是原本的我，\n可是，\n眼前的，"],["彼","那"],["女達に、\n気付かれないように、\n","这些女人们，\n都没能察觉到──\n"],["──ミルハ、しかし、それでもまだ、\n","──米尔哈，即便如此现在还是，\n"],["「へぇ……？[l]\n……きーちゃ、今、[l]\n……うん、だからか、うん、そうなのかな……[l]\nじゃあ、冬夏ちゃは……」","「诶……？[l]\n……小姬刚才，[l]\n……嗯，所以是这样吗，嗯，原来如此……[l]\n那冬夏她……」"],["その語尾は問うでもなく、\n僕の方を視てもいなかったので、\n声を掛けるのは止した。","这句话尾音并非询问，\n她甚至没看向我这边，\n我便没再搭话。"],["矢張り姫様ちゃんの事で、\n何かあるんだな……","果然和姫様有关，\n有什么隐情吧……"],["そう、\n姫様ちゃんの言動も、\n最初は何の事やら分からなかったけど、\n今なら──\n","说起来，\n姫様的言行，\n起初完全搞不懂什么意思，\n但现在──\n"],["「そ、それにしてもあれだな、\nその、電話の時は、\nあたふたしてて、\nお前にしてみりゃ、\nほんとなら、\n衝撃の告白だったんだろけどそんな深刻さぁ欠片も、\n無かったっていうか、\nさっさと順応しちゃったっていうか、\nああ、お前からすれば普通の事なのか、\nえー、その、なんだ」","「话、话说回来啊，\n那个，打电话的时候，\n慌慌张张的，\n在你看来，\n本来应该是，\n超级震撼的告白结果连半点严肃感都，\n没有对吧，\n不如说我很快就适应了，\n啊，对你来说这是理所当然的事吗，\n呃──就是，怎么说呢」"],["沈黙に堪えられず、\nなるべく軽薄に喋る。","实在受不了沉默，\n就拼命说些轻浮的话。"],["……駄目だ、逆に、[l]\n気を遣ってる感ばりばりで、\n","……不行，反倒[l]\n显得刻意到刺眼，\n"],["「まあ……オハナシみたいな話だし、[l]\n実はそうそう簡単に信じられても困るコトにゃんだよね、\nういらのコトは」","「嘛……反正像童话故事似的，[l]\n其实要是被轻易相信反而更困扰呢，\n关于我的事」"],["「ん……ああ、まあ、そうだろうな……」","「嗯……啊，嘛，说得也是呢……」"],["「それ以前に、\n基本ヒトに他言なんかしないけど、\n話したところでね、\n幸い……なのかな、[l]\n普通は痛がられて終わりでしょ。[l]\n良くて与太話と思われて軽くスルー……[l]\nどっちにしても、まあ」","「在那之前，\n基本上不会跟别人提起这种事，\n就算说了也只会，\n幸运……或许吧，[l]\n通常只会换来对方喊痛就结束了吧。[l]\n好一点的话会被当成胡言乱语直接无视……[l]\n无论哪种结果，唉」"],["「……ああ、まあ、それも、そうだろうな……」","「……啊、嗯、确实、是这样呢……」"],["共感された場合は、\n僕みたいに、\n『おなじ』者ととられるって事なのかな……[l]\n姫様ちゃんの言動もそうだけども、\n道具さんが矢鱈僕に突っかかってたのも、\n今思えば、そうなのかも知れないが……[l]\n冬夏は、\n冬夏は……？","如果被共情的话，\n就会像我这样，\n被当作『同类』的存在吧……[l]\n姫様酱的言行也是如此，\n道具小姐之前总莫名其妙针对我，\n现在想来可能也是这个原因……[l]\n冬夏她，\n冬夏她……？"],["昔に会ってた、のも、あるの、か。","难道我们，以前就见过面吗。"],["とうか──\n","冬夏──\n"],["「でも、\n冬夏んち、みは……あの家がくろ……あの土地で影響力持ってるのは、[l]\n","「但是，\n冬夏家、三春……那个家族在漆……那片地区很有影响力，[l]\n"],["そ","那"],["れに畏怖されてるからじゃ、ないって事か？」","不是因为被畏惧着才这样的吗？"],["既に僕等は車中ではあったけれど、\n何となく口にするのが憚られて、\nいちいち代名詞にする僕だったが、\n狩屋も特に突っ込むことをしなかった。","虽然我们已经在车里了，\n但总觉得说出口有些忌讳，\n我每次都用代词指代，\n狩屋也没有特意追问。"],["「……",""],["あ","啊"],["れを","为了"],["の","的"],["為に使ったって意味では、[l]\n間接的にそうだけど、\nまあ、\nご先祖代々からみたいだし……[l]\n今の人達はもう、そういう慣例になってるっていうか、\n理由とかはもう殆ど知らないかもね……[l]\nうーん……[l]\nその辺、あまり深くは、\nでもその、\nまあ、そういうこと……[l]\nごめん……」","使用那个的意义上来说，[l]\n虽然算是间接的，\n嘛，\n从祖先那代开始就这样了……[l]\n现在的人们大概已经，该说是形成这种惯例了吧，\n可能几乎都不知道理由了……[l]\n嗯……[l]\n这方面还是别太深究，\n不过那个，\n嘛，就是这么回事……[l]\n抱歉……」"],["「……ああ、別にいい……」","「……啊，没事的……」"],["……あのひとの言ってた事と、[l]\n併せ考えれば、色々、\n更にワカルこともあるんだろうけど、\n実のところ、\nあまり考えたくもない……","……那个人说过的话，[l]\n综合起来考虑的话，\n应该还能明白更多事吧，\n但实际上，\n我根本不想去思考……"],["何でもかでも真実を","并非所有真相"],["詳らかにすればいいという訳ではない、\n","都必须刨根问底不可，\n"],["と言うことを僕は厭という程思い知らされた訳で、\n","这个道理我已经深刻到厌烦地体会到了，\n"],["知らずにいれば●●●●だったのに、という、\n後ろ向きな安寧を求めてるのは分かってはいるけど、\n","明明不知道的话就能●●●●的，\n虽然明白这是在追求消极的安宁，\n"],["「逃避なんて……悪手なのに……」","「逃避什么的……明明是下策……」"],["「……？[l]\n握手？」","「……？[l]\n握手？」"],["「？[l]\nなにが？」","「？[l]\n什么？」"],["「え、今言わなかった？」","「哎、刚才没说吗？」"],["「いや、え？[l]\n記憶にない……」","「不、呃？[l]\n完全没有印象……」"],["「あそう……」","「啊这样……」"],["……？",""],["勝手に何か口をついて出てしまったんだろうか。[l]\n自分でも","难道是下意识脱口而出了什么吗。[l]\n虽然我自己"],["居た","更"],["堪れぬ過去の失態を思い出すと、\n耐えられずに悶絶して勝手に声が出る事はあるけど、\nそれをやらかしたのかな……","想起不堪回首的糗事时，\n也会忍不住呻吟出声，\n但刚才该不会也……"],["いずれ、\n絡め取られる前の逃避ならまだしも、\nしっかりと眼前に頑然と突きつけられた状態では、\n","说到底，\n在被逼入绝境前逃避倒也罢了，\n当问题已赤裸裸摆在眼前时，\n"],["──面と向かって対処するのが冴えた遣り方ではあるけど、\n","──正面应对固然是明智之举，\n"],["逃げたところで気休めでしかないし、\n","可就算逃了也不过是自我安慰，\n"],["──要が無いなら自分から出歯亀根性出すこともなし、\n","──若无必要也不会主动逞强，\n"],["……敢えて状況を整理したり、建設的な思考をするにはまだ、","……要我现在立刻梳理状况或进行建设性思考，"],["──好奇心猫を殺すってどういう意味だっけな？","──话说好奇心害死猫到底什么意思来着？"],["……黙っていたって、それに、今は、狩屋の事もあるし、","……保持沉默的话，况且现在还有狩屋的事，"],["──適量ならば成長にも助けになるけど、\n　　ヒトに●●かけてまで、\n","──适量压力虽有助于成长，\n　　但也不至于对人●●到那种地步，\n"],["……無理に、結論を、急がなくても、\n…否、それは、ない、","……不必急于，得出，结论，\n…不对，那也，不行，"],["──視るべき現実と秘すべき建前の均衡というのがある、\n","──既要直面现实又要维持表面平衡，\n"],["……駄目だ、分からない、どうすれば、","……不行，搞不懂，该怎么办，"],["──Ｃは偏ってたからさ、それでワレらは、\n","──因为C是偏激派啊，所以我们才\n"],["……どうしろって、いうんだ。","……到底要我，怎样。"],["「──ぃ？[l]\n兄ぃ？[l]\nだいじょぶ、なの？」","「──咦？[l]\n哥哥？[l]\n你没事吧？」"],["「あっ、ごめん、\n……ああああ、そうだ、喰うか、まずは。[l]\nお前がまず腹ごしらえしないとなー。[l]\nほれ、それ、食べぇな」","「啊、抱歉，\n……啊啊啊对了，先吃东西吧。[l]\n你得先填饱肚子才行啊。[l]\n来，这个，吃吧」"],["場を誤魔化すかのようで、我ながらあれだけど、\nその割に、\n買い物袋はもう返してあったので、\nこっちからは言葉で言うしかないのがもどかしい。","虽然显得像在转移话题，连自己都觉得拙劣，\n可偏偏\n购物袋已经还回去了，\n现在只能靠言语表达实在憋屈。"],["狩屋はそれでも素直に買った物を取り出して、\n僕に甘い物……チョコレートを寄越し、[l]\nもくもくと食べ始めた。","即便如此狩屋还是老实取出买来的东西，\n把甜食……巧克力递给我，[l]\n自己默默吃了起来。"],["袋をがさがさする音だけが大きく車内に響く。","只有塑料袋沙沙声在车内格外响亮。"],["「……カレーパン……じゃないんだな」","「……不是咖喱面包啊」"],["「……ういは揚げパン系苦手気味……」","「……我其实不太喜欢油炸面包……」"],["「ああ……そうなんか……」","「啊……这样啊……」"],["何故、\n","为什么\n"],["余計な事を言ってしまうか僕は。","我非要说出这种多余的话。"],["本題に入る前に、\n馬鹿話でもしなきゃ、\n前頭葉も活性化してないし口も重いままだし、\n","明明进入正题前，\n只是想着\n说点蠢话活跃下前额叶，让嘴巴放松，\n"],["と、\n思っただけなのに。","结果\n却搞成这样。"],["──コトバ一つで、全て台無しにし得るのがヒトだからなぁ……","──人类就是会被一句话毁掉一切的生物啊……"],["コトバってのは、\n厄介なものだけど、\n","语言这东西\n虽然麻烦，\n"],["──言わずともワカル、事だけを重視するＣでは、\n","──但在只看重实质的C派看来，\n"],["く……、ど……","咕……哪……"],["ど、っちがいいのか、\n","哪边，更好呢，\n"],["「……っ」","「……呜」"],["……チョコ噛み砕き損ねた。","……巧克力没咬碎。"],["「ん？」","「嗯？」"],["「いや、なんでも……」","「不，没什么……」"],["喰ったらいよいよ、\n本題か……","吃完就该，\n进入正题了吧……"],["狩屋が何を話したいのかは分からないが、\n少なくとも僕の方は、\n……話さないで、黙ったまま、という選択も、[l]\n無いではない、けど、\n","虽然不知道狩屋想说什么，\n至少我这边，\n……不开口、保持沉默这个选项，[l]\n也不是没有，\n"],["これ以上背徳い事に耐えるのと、\n果たしてどっちが、\n","但继续忍受这种背德行为，\n到底哪边更——\n"],["……それは自分の事しか、考えてない故の、[l]\n迷いだ、\nそれはそうなんだ、\nでも、\n","……这不过是只顾着自己、[l]\n产生的迷茫，\n这点我承认，\n可是，\n"],["……話を、[l]\nするとして、\n","……要说的话，[l]\n就算要说，\n"],["既に僕が、視える者というバラシはしてるけど、\n僕には、もっと、\nその先が、\n","虽然我已经暴露了能『视』的身份，\n但我还有更——\n更往后的，\n"],["その先なんて、\n","更往后的事——\n"],["──この娘等がワレのミの、","──这群女孩是吾等身、"],["簒","篡"],["奪者の裔だと、\n","夺者的后裔这种事，\n"],["そんなの、話せるか……？","怎么可能……说得出口？"],["言うべきか、\n言うにしたって、\nそれこそさらにその先を、\n","该说吗，\n就算要说，\n那之后更远的事，\n"],["つまり、\n","也就是，\n"],["まこくんが八相を殲滅して、\n　　　キミでキミ自身の身体を取り戻せ。","小真歼灭八相后，\n　　　用你来夺回你自己的身体。"],["どう伝えろっていうんだ、\n僕が、\n","这让我怎么传达，\n我——\n"],["──フハイ","──腐坏"],["等は此の地を箱庭にすべく置かれたから、\n","等被安置在此地作为箱庭，\n"],["逃げられない、\n","无法逃脱，\n"],["──事が始まれば箱は閉じられて開くことはないし、\n","──事件开始后箱子就会紧闭永不开启，\n"],["つまりは僕が、己の意思で、\n或いは全てをなげうって、\n","也就是说我必须靠自己的意志，\n或是舍弃一切，\n"],["狩屋達を、冬夏を、\n","对狩屋他们、对冬夏——\n"],["──ミルハの言うのを鵜呑みにするのもあれだけど、\n","──虽然全盘接受米尔哈的说辞也不妥，\n"],["僕はどう決断したらいいのか、\n","我究竟该如何抉择，\n"],["──この件に関しては、自分の事だからね、\n","──这件事毕竟关乎我自己，\n"],["どっちにしても、\n","无论怎样，\n"],["──●●は無いんだよ。","──●●是不存在的。"],["何も、\n何を、\nどう話せばいいのか、\n否、話してしまうべきなのかどうか、\n","什么都不，\n该说什么，\n该怎么开口，\n不、到底该不该说出来，\n"],["それ以上に、\n","更重要的是，\n"],["口にしてしまってはシマイだ──\n","一旦说出口就完了——\n"],["という意識が、\nどうしてもそれ以上の思考を拒ませる。[l]\nかといって、\n最前から分かってる通り、\nこのまま黙っていようと、\nどうしようと、\n………、","这种意识，\n无论如何都阻止了更深层的思考。[l]\n话虽如此，\n正如最初就明白的，\n无论现在保持沉默，\n还是采取行动，\n………，"],["………、",""],["………言葉を選ぼうとするまでもなく、[l]\n完全に思考は停止……して……","………根本无需斟酌词句，[l]\n思考已完全停滞……了……"],["「………っ、………ぅ」","「………呃、………呜」"],["フリーズして、ハングって、\n","僵住、宕机，\n"],["まるで、\n別れ話してるような……そんな経験もほぼゼロに近い僕ではあるけど、[l]\nそういう重い沈黙が、\n二人の間に流れる……","简直像，\n在谈分手似的……虽然我几乎没这种经验，[l]\n但那种凝重的沉默，\n确实流淌在两人之间……"],["狩屋も、\nあんな喋りだから一見あれだったけど、\n此奴はやっぱり、\n本来は、\n","狩屋也，\n虽然那样说话乍看很那个，\n但这家伙果然，\n本质上，\n"],["だから、\nあのひととは違うし、冬夏や姫様ちゃんとも違う、\n道具さんとも、\n","所以，\n和那个人不同，也和冬夏或姫様不同，\n与道具小姐也，\n"],["つまり、\n僕のことを、\nヒト並みに慮ってくれてるのだろう、\n","也就是说，\n对我的事，\n是当作普通人来体谅的吧，\n"],["──Ｃに親和してる割には珍しく。","──对C相性良好却难得这样。"],["僕等はお互い、\n数値上の成績は兎も角、真面目な優等生タイプではあるのだろうから、\n隙をつけ狙うような物言いなんか出来ない、\n気の利いたことも言えない、\n嘘を吐いて慰めたりといった器用な真似もまるで………","我们彼此，\n抛开数值成绩不谈，应该都属于认真优等生类型，\n说不出钻空子的话，\n也讲不出漂亮话，\n连撒谎安慰这种灵巧事也完全………"],["要するにバカ正直な真っ向勝負しか出来ない、\n野暮で無粋で不器用な、\n","总之只会笨拙地正面硬刚，\n又土又没情调还笨手笨脚的，\n"],["否、単に失敗が怖いだけの、\n","不，单纯只是害怕失败，\n"],["あのひとのキライそうな、\n","那个人最讨厌的，\n"],["いくじなし。","窝囊废。"],["──だが、それで、いいんだ。","──但这样就好。"],["……空がどんどん、灰色に、なってく。","……天空渐渐，染成，灰色。"],["この沈黙は一体どうしたら、\n","这沉默到底该怎么打破，\n"],["何か良いコトバは？[l]\n何を言えばいい？","有什么好台词吗？[l]\n该说什么才好？"],["──",""],["女達の愉悦を満たそうとするなら覚悟がいるのさ、\n","若要满足女人们的欢愉可得有觉悟，\n"],["そんなもの何も思いつかない、\n","完全想不出任何点子，\n"],["──だってたまたま『アタリ』を言ったって、それは、\n","──就算偶然说中『正确答案』，那也只是，\n"],["思いついても、それは単なる一時凌ぎ……","即便想到，也不过是权宜之计……"],["──顔色を窺って、\n    神経をすり減らし正解を選択し続ける意義が、\n    価値があるか？","──察言观色，\n    持续消耗神经选择正确答案的意义，\n    有价值吗？"],["でも、求められてる答えが出せないと、\n僕は、あのひとに、\n","但如果给不出被期待的答案，\n我就会被那个人，\n"],["──それがアイだというなら、\n","──若那就是爱的话，\n"],["あのひと……？","那个人……？"],["──そうだな、だからＹは、\n","──是啊，所以Y才会，\n"],["あのひと……なんか、","那个人……总觉得，"],["──というか、ワレはもとよりイキにくきもので、\n","──或者说我本就难以生存，\n"],["あのひとは、\n関係ない……っ、","那个人，\n没有关系……呃，"],["──格好付けたいのはわかるけど、\n","──想装帅的心情我懂，\n"],["自分を殺してまで、\n強がることに、\n独り善がりの痩せ我慢なんかに、\n僕は意味なんか、\n","但不惜扼杀自我，\n也要逞强的，\n这种自以为是的硬撑，\n我根本不觉得，\n"],["みいだしたくはない……","有任何意义……"],["──あれ自身は我を通してる訳だからな、\n","──那家伙本身就很固执，\n"],["だからといって僕が僕をただただ押し通すのも、\nきっと、違う、\n","但我也一味坚持己见的话，\n肯定，不对，\n"],["──考える主体が一つ所に二以上あれば、\n　　必ず軋轢は生まれるさ、\n","──思考主体若有两个以上，\n　　必然会产生摩擦，\n"],["僕は、ただ、おもいをつたえたいだけなのに、\n","我只是想传达心意而已，\n"],["──●く●かれるの話がややこしいのはそこで、\n","──●被●搞复杂的原因就在此，\n"],["拒否されたって構わないのに、なぜ、\n何で僕に、何を勝手に期待して、\n自分だけが正解を知ってる問題を勝手に出して、\nそれで、\n僕がしくじったら、\n勝手に僕を、\nみすてるつもり、\n","就算被拒绝也无所谓，可为什么，\n凭什么擅自对我抱有期待，\n擅自出只有你知道答案的考题，\n然后，\n若我搞砸了，\n就擅自把我，\n打算抛弃，\n"],["……み、すて、","……抛、弃、"],["──ほら、なあ、","──喂，我说，"],["粋","粋"],["憎いよな、いまは。","真可恨啊，现在。"],["言わなくても通じる事はあるだろうが、\n言わなければ、\n","就算不说也能明白的事也是有的吧，\n但若不说出口，\n"],["「……んないだろ……っ……！」","「……才没有……吧……！」"],["それが、\n言葉を使うヒトという種だろっ？！","这不正是\n人类这种使用语言的物种吗？！"],["──ワかる事とイキは違うんだけど、\n　　ＣとＤでは、そこが決定的に、\n","──理解与活着是两回事，\n　　C和D的差别就在于此，\n"],["だから、\n","所以\n"],["僕","仆"],["等は、\n","所谓\n"],["●●●なんだ、\n","●●●啊，\n"],["●●が●●●で、\n","●●是●●●，\n"],["──もう、すこしで。","──还差一点。"],["──もうあんなのはいやだね。","──已经受够那种事了。"],["……もうあんなのはいやだ……","……已经受够那种事了……"],["損得が全てではないにしても、\n誰も得しない、あの、\n","虽说得失并非全部，\n但那种谁都得不到好处的\n"],["──Ｃ。",""],["否、\n自己陶酔を満たすという意味で\n当人は好いのかも知れないが、\n","不，\n在满足自我陶醉的意义上\n或许当事人觉得不错，\n"],["──それがＣ。","──这就是C。"],["そんなものはヒトの中で生きるのには、\n","这种东西对人类生活而言\n"],["──Ｄとはちがう。","──和D不同。"],["僕はヒトでありたい、\n","我想作为人类活下去，\n"],["──ワレはそれを拒否することを、\n","──吾辈拒绝承认\n"],["──………。",""],["……思考が止まって、代わりに、[l]\n別方向へずれていた……ようだ。","……思考停滞的同时[l]\n似乎偏移到了别的方向……"],["な、何を考えていたんだろうか、僕は。","我、我刚才在想什么呢。"],["あのひとの事を考えるとおかしくなる、\n","一想到那个人就会变得奇怪，\n"],["僕は慌てて狩屋に声を掛けた。","我慌忙向狩屋搭话。"],["「えー、あのさ……」","「呃——那个啊……」"],["「食べたら眠くなった……」","「吃完就犯困了……」"],["「あ？[l]\nあ、ああ、そうな、\n分かるわ……」","「哈？[l]\n啊、啊啊，这样啊，\n我懂……」"],["「……寝てもいい？」","「……能睡吗？」"],["「はぃ？[l]\nや、ああ、僕は構わないけど……[l]\nそういやあんまり寝てないんだろ、\nいいよ、僕は……それで……」","「哈啊？[l]\n不、不是，我倒无所谓……[l]\n说起来你确实没怎么睡吧，\n睡吧，我……那个……」"],["結局、狩屋もあまり話したくは無かった、のかな……[l]\n本題……そもそも無かったのかも知れないけど……","结果狩屋也不太想说话，或许……[l]\n正题……可能根本不存在吧……"],["それとも、僕のように、\n単に他人と一緒に居たかっただけなのかな……","又或者和我一样，\n单纯只是想有人陪着……"],["独りで居ると、\n思考に歯止めがないから、どんどん凹んでしまうから……","独自一人时，\n思绪会不受控制地不断消沉……"],["勿論、一緒の相手次第ではそのマイナスも倍増しかねない訳だけど、\nそう言う意味では、僕等二人はあまり良くない組み合わせではある、\nので、\n","当然，若同伴不合适这种负面情绪还可能倍增，\n从这个意义上说我们俩的组合并不理想，\n所以\n"],["狩屋の提案に、\n正直安心、しているのも事実だ。","对于狩屋的提议\n说实话感到安心也是事实。"],["今はどうやったって、\n何もコトバが、でない……","现在无论如何\n都说不出任何……话语……"],["「うっそ、やっぱだめ。[l]\n","「骗人的果然不行。[l]\n"],["あー、にゃんかこう、ぱーっとするとこ、\n行かない？」","啊——喵的就想找个能唰地\n发泄的地方？」"],["「……え？[l]\nあ、いや、は？」","「……诶？[l]\n啊、不，啥？」"],["「それどころじゃにゃいのは分かってるけど、\n分かってるけど、\n","「虽然知道不是干这个的时候，\n虽然知道，\n"],["……にゃんもできんし……できにゃい……[l]\nせっ……ふぐっ……めて……」","……喵也做不到……做不到啦……[l]\n至……呜咕……少……」"],["こんな現状も必ずちゃんと、\nどうにかなるって思っていたいから、\n悲観していたくはないから、\n","这样的现状也一定能够\n顺利解决的，我是这么相信的，\n因为不想陷入悲观，\n"],["無理にでも、ちゃんとしてなきゃ、\n無理にでも、前を向かなきゃ、\nいけない、\n","就算勉强，也必须振作起来，\n就算勉强，也必须向前看，\n不行，\n"],["のか？","吗？"],["──●●●だな。","──●●●啊。"],["「え、あ、ああ、ああ……[l]\nそう──だ、な、……」","「哎、啊、啊啊、啊啊……[l]\n没错──呢、……」"],["ともあれ僕は、\nその提案を拒否してまで、\n陰鬱な自分に酔いたい訳じゃないので、\n……どうあれ今は、[l]\n此奴が何かしたいっていうなら、\nそう、しよう……","总之我，\n并不想不惜拒绝那个提案，\n也要沉醉在阴郁的自我中，\n……无论如何现在，[l]\n如果这家伙想做什么的话，\n那就，做吧……"],["「……あーあ……[l]\n独りで処理出来ればにゃにも兄ぃにゃんかに、\n……たのっ、まない、の、にっ……」","「……唉呀呀……[l]\n要是能独自处理就不用拜托哥哥他们，\n……明明、没、有、拜托的……」"],["「あ……？[l]\nそらぁ、わるかったな……」","「啊……？[l]\n那个嘛、抱歉啦……」"],["……どんな","……无论"],["罵","骂"],["言でも、[l]\nいつもと違うノリよりはましか……","什么话，[l]\n总比平时不同的调调要好吧……"],["「って、てか、兄ぃを慰めにゃーだもんね！[l]\nそう、\n","「那个、话说、人家才不要安慰老哥呢！[l]\n对、\n"],["そういうことで、そういうことにしろばぁか！！」","就是这样、就这么定了笨蛋！！」"],["「あーそうかい、御厚意痛み入りますよ……[l]\nそれはそれでいいけどさ、\nで、どこ行くってよ」","「啊这样啊，真是受宠若惊呢……[l]\n那样倒也不错啦、\n所以、到底要去哪儿啊」"],["「どこでも、兄ぃ決めてよ」","「哪儿都行，老哥决定啦」"],["「……お前なぁ……[l]\n僕ぁ地元民ちゃうちゅうねん……[l]\n分かるわけないがな」","「……你啊……[l]\n俺可是土生土长的本地人啊……[l]\n怎么可能知道啦」"],["一瞬、前冬夏と行ったカラオケを思い出したが、\n……流石にそこまでのテンションは気が引ける、[l]\n単に華やいだ場所に行くだけとは違って、\n思いっきり能動的な行為をしに行く場所だし……","一瞬间想起了之前和冬夏去卡拉OK的事、\n……但实在提不起那么高的兴致、[l]\n和单纯去热闹地方不一样、\n这可是要去做些积极主动的事情的地方啊……"],["「そっか、平日の昼間にゃった。[l]\nぬーん、じゃー、単に遠乗りでも……[l]\n","「这样啊，工作日下午来着。[l]\n嗯—那、干脆去兜风……[l]\n"],["あ、映画でも、それにゃな！！[l]\n映画！！！[l]\nホラーとお涙頂戴以外で！！！」","啊、看电影也行、就那个！！[l]\n看电影！！！[l]\n除了恐怖片和催泪片以外！！！」"],["映画、ねえ……[l]\nまあ完全に受動行為だし、\n狩屋も寝ようと思えば寝られるし、\n互いに会話、する必要もないし、\nうってつけと言えばうってつけかもな……","电影啊……[l]\n嘛完全是被动行为呢，\n狩屋想睡的话也能睡，\n彼此也不需要交谈，\n要说合适的话或许确实挺合适……"],["「ああ、じゃあそれで……[l]\n観るものは現地で決めるでいいんだな？[l]\nじゃ映画館て何処よ？」","「啊，那就这样……[l]\n看什么到了那边再决定就行了吧？[l]\n那电影院在哪儿啊？」"],["「この辺だと……","「这附近的话……"],["処しかにゃいな……[l]\nちっと遠いけど、案内するにゃが」","只有处所而已喵……[l]\n虽然有点远，不过我来带路喵」"],["「あーそう。[l]\nまあナビに入力すりゃー済む話だけど……」","「啊—这样啊。[l]\n嘛虽然输入导航就能解决啦……」"],["「にゅあ、そりゃー、どっちでもいいけどさぁ……」","「唔啊，那个—，怎样都无所谓啦……」"],["自分が今、何をしてるのか、もうよく判らない。","自己现在到底在做什么，已经完全搞不明白了。"],["分かりたくないのが本心かも知れないけど、\n","或许内心根本不想搞明白，\n"],["今は、\n","现在，\n"],["流されてみよう……","就随波逐流吧……"],["それが僕だ、昔から、\n","这就是我，从以前开始，\n"],["自分の外にある大きな流れの","存在于自身之外的巨大洪流"],["侭に、\n","尽管，\n"],["それが──\n","那就是──\n"],["「じゃ、シートベルト締めい。[l]\n……チケット代は、」","「那，系好安全带。[l]\n……电影票钱，」"],["「割り勘」","「AA制」"],["「あいよ……」","「好嘞……」"],["発車させ、道路に出ると、\n遠くまで空が視界に入る。","发动车子驶上道路后，\n远处的天空尽收眼底。"],["「……これ、降るな、[l]\n雪かは兎も角……」","「……这个，要下了吧，[l]\n是不是雪另当别论……」"],["山の方は既に靄がかっていて、\n只の灰色になっていた。[l]\n風向きとかよく分からないけど、\n海の方とて晴れ間は視えなかったから、\nいずれ雨か何かは降って来る、だろう。","山那边已经笼罩着雾气，\n变成了一片灰蒙。[l]\n虽然搞不清风向，\n但海的方向也看不到晴空，\n迟早会下雨或什么的吧。"],["「あ、傘持ってきてにゃいす……[l]\n濡れちゃ……ったらどうしよう……」","「啊，没带伞喵……[l]\n淋湿了……的话怎么办……」"],["「あん、そのくらいはどうにかすっから、\nそんな●●しなくていいよ」","「没事，这点小事总会有办法，\n不用那么●●啦」"],["「え？[l]\nあ、うん……ありがとぅ」","「诶？[l]\n啊、嗯……谢谢你」"],["何やらもじもじする狩屋。","狩屋不知为何扭扭捏捏的。"],["「……寒いか？[l]\n暖房入れるか」","「……冷吗？[l]\n要开暖气吗」"],["「……うん」","「……嗯」"],["車のエアコンを入れると、\n車内は低い稼働音に包まれて、\n思考はより一層","打开车载空调后，\n车厢被低沉的运转声包围着，\n思考越发"],["鈍まっていく。","变得迟钝。"],["自分が今、\n","自己现在\n"],["何をしてるのか、\n","在做什么，\n"],["もうよく判らない。","已经不太明白了。"],["僕等二人は、\n暫しの間、\n偽りの安寧の如き……母の胎内で聴くという血流の音に似た、[l]\n轟音と、\nその暖かきの中で、\n","我们两人\n在短暂的时光里，\n仿佛置身于虚假的安宁……如同在母胎中听到的血流声般，[l]\n被轰鸣声与\n那份温暖包裹着，\n"],["おそらくなにもかんがえずに、\n","大概什么都没在想，\n"],["たがいに、\n","彼此\n"],["なにをしてるのか、\n","在做什么，\n"]],"context":[["SC_M_057.ks/index/1/text"],["SC_M_057.ks/index/3/text"],["SC_M_057.ks/index/5/text"],["SC_M_057.ks/index/7/text"],["SC_M_057.ks/index/9/text"],["SC_M_057.ks/index/12/text"],["SC_M_057.ks/index/14/text"],["SC_M_057.ks/index/17/text"],["SC_M_057.ks/index/19/text"],["SC_M_057.ks/index/21/text"],["SC_M_057.ks/index/23/text"],["SC_M_057.ks/index/25/text"],["SC_M_057.ks/index/28/text"],["SC_M_057.ks/index/30/text"],["SC_M_057.ks/index/32/text"],["SC_M_057.ks/index/34/text"],["SC_M_057.ks/index/37/text"],["SC_M_057.ks/index/39/text"],["SC_M_057.ks/index/42/text"],["SC_M_057.ks/index/44/text"],["SC_M_057.ks/index/46/text"],["SC_M_057.ks/index/49/text"],["SC_M_057.ks/index/52/text"],["SC_M_057.ks/index/55/text"],["SC_M_057.ks/index/58/text"],["SC_M_057.ks/index/60/text"],["SC_M_057.ks/index/62/text"],["SC_M_057.ks/index/64/text","SC_M_057.ks/index/66/text","SC_M_057.ks/index/167/text","SC_M_057.ks/index/169/text","SC_M_057.ks/index/290/text","SC_M_057.ks/index/353/text","SC_M_057.ks/index/459/text","SC_M_057.ks/index/765/text","SC_M_057.ks/index/889/text","SC_M_057.ks/index/926/text","SC_M_057.ks/index/928/text","SC_M_057.ks/index/967/text","SC_M_057.ks/index/974/text","SC_M_057.ks/index/1022/text","SC_M_057.ks/index/1038/text","SC_M_057.ks/index/1202/text","SC_M_057.ks/index/1307/text","SC_M_057.ks/index/1386/text"],["SC_M_057.ks/index/68/text"],["SC_M_057.ks/index/70/text"],["SC_M_057.ks/index/72/text"],["SC_M_057.ks/index/74/text"],["SC_M_057.ks/index/76/text"],["SC_M_057.ks/index/79/text"],["SC_M_057.ks/index/81/text"],