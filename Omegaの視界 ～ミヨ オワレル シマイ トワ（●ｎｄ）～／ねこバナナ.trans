t":9289,"end":9357}],[{"start":9369,"end":9390}],[{"start":9402,"end":9459}],[{"start":9471,"end":9472}],[{"start":9484,"end":9503}],[{"start":9515,"end":9557}],[{"start":9569,"end":9575}],[{"start":9604,"end":9655}],[{"start":9736,"end":9738}],[{"start":9750,"end":9753}],[{"start":9765,"end":9769}],[{"start":9781,"end":9796}],[{"start":9808,"end":9811}],[{"start":9849,"end":9851}],[{"start":9863,"end":9918}],[{"start":9930,"end":10108}],[{"start":10120,"end":10313}],[{"start":10331,"end":10364}],[{"start":10513,"end":10599}],[{"start":10611,"end":10672}],[{"start":10684,"end":10714}],[{"start":10754,"end":10835}],[{"start":10847,"end":10928}],[{"start":10940,"end":10949}],[{"start":11020,"end":11043}],[{"start":11055,"end":11113}],[{"start":11125,"end":11164}],[{"start":11176,"end":11191}],[{"start":11203,"end":11217}],[{"start":11229,"end":11388}],[{"start":11400,"end":11415}],[{"start":11427,"end":11438}],[{"start":11450,"end":11461}],[{"start":11473,"end":11484}],[{"start":11496,"end":11512}],[{"start":11524,"end":11569}],[{"start":11581,"end":11640}],[{"start":11652,"end":11656}],[{"start":11680,"end":11681}],[{"start":11693,"end":11787}],[{"start":11799,"end":11856}],[{"start":11868,"end":11877}],[{"start":11948,"end":11952}],[{"start":11964,"end":12046}],[{"start":12089,"end":12128}],[{"start":12238,"end":12314}],[{"start":12354,"end":12362}],[{"start":12418,"end":12456}],[{"start":12468,"end":12478}],[{"start":12549,"end":12561}],[{"start":12573,"end":12607}],[{"start":12619,"end":12653}],[{"start":12665,"end":12698}],[{"start":12710,"end":12752}],[{"start":12764,"end":12817}],[{"start":12829,"end":12843}],[{"start":12855,"end":12919}],[{"start":12931,"end":13003}],[{"start":13015,"end":13075}],[{"start":13087,"end":13107}],[{"start":13131,"end":13132}],[{"start":13143,"end":13217}],[{"start":13229,"end":13269}],[{"start":13281,"end":13302}],[{"start":13314,"end":13372}],[{"start":13384,"end":13400}],[{"start":13412,"end":13465}],[{"start":13477,"end":13566}],[{"start":13578,"end":13686}],[{"start":13698,"end":13753}],[{"start":13821,"end":13830}],[{"start":13879,"end":13918}],[{"start":13948,"end":13956}],[{"start":13968,"end":13973}],[{"start":14009,"end":14034}],[{"start":14090,"end":14160}],[{"start":14172,"end":14235}],[{"start":14247,"end":14266}],[{"start":14278,"end":14356}],[{"start":14418,"end":14458}],[{"start":14494,"end":14537}],[{"start":14599,"end":14629}],[{"start":14659,"end":14695}],[{"start":14707,"end":14764}],[{"start":14776,"end":14832}],[{"start":14844,"end":14896}],[{"start":14908,"end":14955}],[{"start":14967,"end":15014}],[{"start":15026,"end":15071}],[{"start":15083,"end":15128}],[{"start":15140,"end":15188}],[{"start":15200,"end":15256}],[{"start":15268,"end":15346}],[{"start":15364,"end":15374}],[{"start":15468,"end":15545}],[{"start":15557,"end":15594}],[{"start":15624,"end":15638}],[{"start":15674,"end":15697}],[{"start":15732,"end":15773}],[{"start":15809,"end":15885}],[{"start":15920,"end":15957}],[{"start":15993,"end":16048}],[{"start":16083,"end":16134}],[{"start":16164,"end":16219}],[{"start":16231,"end":16266}],[{"start":16278,"end":16327}],[{"start":16339,"end":16404}],[{"start":16416,"end":16461}],[{"start":16473,"end":16547}],[{"start":16559,"end":16626}],[{"start":16638,"end":16699}],[{"start":16791,"end":16853}],[{"start":16889,"end":16901}],[{"start":16936,"end":16983}],[{"start":17013,"end":17039}],[{"start":17051,"end":17087}],[{"start":17123,"end":17149}],[{"start":17179,"end":17212}],[{"start":17274,"end":17277}],[{"start":17352,"end":17377}],[{"start":17426,"end":17488}],[{"start":17500,"end":17525}],[{"start":17537,"end":17576}],[{"start":17588,"end":17667}],[{"start":17679,"end":17690}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_019.ks","basename":"SC_M_019.ks","indexIds":{"時間感覚は無くなっていた。":0,"歌が始まってからいったいどれくらいたったのか、\n館内の時計も、暗くて判別出来ない。":1,"だから、\n永いのか、\n短いのか、":2,"――終わってない以上、\n現時点でそれを判ずる事がそもそも見当違いなんだけど。":3,"初見なので、余程分かり易い『起承転結』が無い限り、\n進行度合いがどれくらいかなど知る由もない。":4,"「……」":5,"僕も全く何でこんな格好で、\nこんな場所まで入り込んで、\nいったい何してるんだろう。":6,"と、今更冷めて自己分析などしてはいけない。":7,"鏡をずっと視てると気持ち悪くなるように、\n己を客観視する事が、\n良い方向に働く場合とそうでない場合がある。":8,"僕はもう……色々覚悟して此処に来たのだから、[l]\n眼前の事物に集中するのだ。そうなのだ。":9,"全ての元凶は宮さん……とは言うまい。[l]\n宮さんとはまた別の謎の根元、綾目姫様ちゃん。[l]\n彼女の ":10,"唆 し――というか\nよく分からない押しの強さが今の状況を作り上げた一因であるのも\n間違いなく、\nうーん、彼女が本家の目的たる三春関係の人間である事を\nさっ引いても、\n個人として謎だよなあ。":11,"謎。":12,"謎とは、\n事象を受け取る当人にとっての理解不能な事柄であって、\nテストとかゲームとか推理モノの創作物とかじゃない限り、\n当然出題者……いや、そのもの自体は別に他人を\n騙そうとか思ってる訳じゃないのだ。":13,"から、姫様ちゃんにしたってそうなんだろうが、\nその行為の":14,"所":15,"以のなんたるかを知りたいこっちに\n説明が無いからには、さっきみたいにどうカッコつけたって\n謎は謎だよ。[l]\n答えが割り切れるものとは限らないのが世の常だが、\n少しは説明してくれてもいいよなー。[l]\n……訊けない僕が悪いのかねえ……":16,"で、謎ついでにいうならば、\n僕の幻覚？をも侵蝕しつつあるこの謎言語。[l]\nこの謎言語が全編に散りばめられたこの不思議な歌劇、\nというか解る言語が一切ありません。[l]\n洋画とかなら、役者の演技にしろ舞台背景にしろ、\nシチュエーションが視えるから、\n吹き替えや字幕なくても在る程度は想像もつくんだが、\nこれは訳もなにもない、他言語域でのミュージカルかオペラといった風で、歌と音楽では、感情の傾向とかいった曖昧なものしか、\nむーん。":17,"僕ぁ宮さんの車内アニソンが好きな訳じゃないが、\nクラシックと演歌民謡がはっきりって苦手なんだよな。[l]\n民俗音楽系とか、先日宮さんが言ってたように、\n儀式的要素のある、トランス状態への入り口みたいな、\n……トランスってジャンルもあったか？[l]\nよくわかんないんだ僕。が、そういうのを好んで聴く。[l]\nまあ、それはそれだ。[l]\nこの歌劇の場合は色々と":18,"混":19,"淆していて、\nキライじゃない、のは確かだ。[l]\n取り敢えずあの狩屋が言うには、\nこれの内容は感得するものだというんだが……":20,"それが主目的なのに、\n悪いけど、\n今のところよくわからないというのが正直なところだなあ……[l]\n不思議だとか、神秘的とか、\n凡庸な感想はあるけれど、\nそれをわざわざ……とも思えないし、[l]\nそもそも感得ってえらい主観的な話だからな。[l]\nそうと言われた訳ではないが、\n感得と言うからには理屈で考えちゃいけないような\n気もするし、おもうがままに何かを感じようとは思うんだけど。":21,"まあ見知った女子が異装をして演舞してるという事自体に\nどうも気がいって、\nへんなむず痒さには襲われています。[l]\n大神に言わせれば、僕はギャップに弱いというか、\nあんまり奴は使いたがらなかったがギャップ萌えというやつ？[l]\nいずれそれこそお祭りとかコスプレやら制服にしろ、\n非日常をロールプレイするというシチュエーションには\n何かしら":22,"昂":23,"揚する要素を\n感じる事があるのは確かに否めません。":24,"――宮さんまさかそういう所で僕の足下みてるつもりか？[l]\nどっちかというとあの人の影響があってこそ……いやいやいや。[l]\n宮さんが今回のに同意したのは……宮さんなりの意図があったようだしなあ。[l]\nと己の様を振り返ってげんなりする僕。[l]\n言い出しっぺは姫様ちゃんだけどな……[l]\n場内が暗いのと知らない人の前だから何とか耐えてるが、\nそうでなかったらとてもじゃないが――":25,"「……、？」":26,"「……♪」":27,"て、隣りに座る、\n":28,"件の何かしら察しの良い女子はすっかりご機嫌というか、\n聞こえない程度の鼻歌というかハミングをしとるのだった。[l]\n若干ハモってるな。[l]\n音感良いのか、初見じゃないのか、\nただの偶然か……そんくらい出来る奴なら山程居るし、[l]\nそういえば先刻の態度は、何かしら訳知りな感じだった――":29,"「――？」":30,"（み、\nぉろこなもろこねきゃなさつこねきゃなさつこねきゃみゃる、\nきゃみゃろろきゃきゃみゃるつかやこねきょろかやこねきょろ、わ。）":31,"「……？、……？？」":32,"聞こえている歌に違う音が、否――\n声？[l]\n声が混じってきた。":33,"しかも、これは、\n謎言語、そして――\n明らかに別音源の声――":34,"極めて近くから、耳元で囁かれてるように、":35,"思わず左右を見回そうとするが、":36,"……動かない。":37,"瞬きも出来ない。[l]\nい、否、出来るんだが、自分の意志とリンクしてない、ぞ？[l]\n舞台の方向を視たまま、僕の身体は凍り付いたように\n動かない、じゃなく動かせない。":38,"――正確には意志通りに動かないと言うべきか、\n弛緩でも硬直でもない。[l]\n何とかの穴って洋画があったがそれみたいな感覚と\nいうか、\n強制操作されてるというか、":39,"なんて考えてる場合か、\nどどどどどどどどどどうしよう！！！？？？":40,"動かないまま式が終わったらこの格好ではいやだとか、\nいや不法侵入がまず先かとかばれると色々問題が！":41,"どこまでが冷静な問題認識なのか焦ってる僕の、\n――肉体はこんなだからあくまで脳内がひたすら\nテンパってるだけなんだが、":42,"そんな状況には無関係に、\n再度声が聞こえた。":43,"（雷、カミナリ。）":44,"（たまあずさのつかわし、\nかむながらにさかごと。）":45,"（つながるひも、じぐざぐじくさく、\nあやつりにんぎょう不正操作。）":46,"な、何だ…って？？":47,"てか、今度はわかるぞ？[l]\n明かに僕らの使用言語だ……":48,"脈絡とか意味は不明だが、\n言ってる言葉は判る。":49,"と、取り敢えず焦るのはお預けにし、\n眼前の別問題に注力して冷静になろう。":50,"瞬間的に現実逃避することは、\n生命危機に対して変性意識状態に陥ることにより困難を打破するための本能だし！":51,"言ってる側から混乱してる気がするけど、\n緊急時にロジカルを求めたところで益少なしだ。[l]\n誰かが聞いてる訳じゃ無いけどまあいいです。":52,"くだらない思考走らせると、\nまあ落ち着くのには良いかもだ。[l]\n取り敢えず多少はマシになった。":53,"この数日、伊達に怒濤の連続謎イベント体験してた訳じゃないんだぜ、僕だって。":54,"宮さんの仕込みが効いてるね！[l]\nはは……":55,"――さて。":56,"「（……♪）」":57,"隣りのあの女子は相変わらず鼻歌を続けている。[l]\n僕以外の者には、特に何事も起きてないのだろうか？":58,"もし同じ様な状況が起きていたら、\n当然物理的なリアクションはとれず、":59,"端からじゃ\n分かんないんだけど。":60,"ただ隣りの女子がこうであるからには、\n少なくとも行動の自由を妨げられる様子は無いようだし、\n……くそ、他の生徒がどうなってるのかが知りたい……":61,"僕の煩悶とは無関係に、\n謎の声は響き続ける。":62,"それは冬夏が舞う舞台、歌と相まって、\nしかして調和というよりは、\n奇妙なモアレのような目眩感を僕に与えていた。[l]\n不協和音ではないが据わりの悪い――":63,"（憑き村或いは月村と呼び習わしめるショウケラノムラ、\nミハルモノのムレ、\nショウキラノムレ、ショクラノモリ、":64,"クロノムレクロノモリ、砕き山を抱く黒の森、\n祭儀をもって我等は忘れまじ。）":65,"くろのもり？[l]\nそれ以外の言葉も、単語として認識は出来なくもない、\nが、\nそれだけだ。":66,"総体としての意味はさっぱり判らない。[l]\nそれに、\nこの聞こえてくる声というかオトは、少々早口で抑揚が薄いのだ。":67,"一昔前の映画やテレビに出てくるような、\nレトロな近未来風機械音声のように不自然で一本調子だ。[l]\n現在の現実の合成音声の方が余程自然に聞こえるだろう。":68,"（聖なるかな正なるかな凄なるかな昔居まし今忌まし後来たり、\n刀自御名どれみりあ・りでる、三春、オクロをヨリマシに、":69,"翅を獲た":70,"蟻":71,"子、\n":72,"蜂となりて我等月に跳ねるもの、\nツキノモノのちぎりにてむすばれた猫遣い。）":73,"三春？[l]\nオ、クロ？[l]\nそれは――":74,"（神の嫁は紙を読み、咬みて黄泉送る火の車、\nみつはのめ。":75,"御":76,"眼は":77,"有":78,"也":79,"無":80,"也。[l]\nしろおにのものなればなんとしょう。）":81,"みつはのめ？[l]\nしろ……のもの？":82,"（律を選ずる我が命をきけ。）":83,"（ワレは醍醐、大悟、第五。）":84,"う゛うううううぅぅぅぅぅうううぅぅぅ――ん。":85,"相変わらず身体の自由が利かないので平静を装ってるように\n視えるかもだが、\nもし両手が自由ならば耳を塞いでいるような、\n激しめの耳鳴り、否、":86,"高周波なんだか重低音なんだか、\nまるでハードディスクや冷却ファン、高速ドライブが鳴り出したような、要するに電子機器系の騒音のような……[l]\n神経をざわつかす厭なオトが頭に響く。":87,"（――韻律走査中。）":88,"（――因律操作中。）":89,"な、なんだって？[l]\nいんりつそうさ、ちゅう？":90,"（":91,"於":92,"菟の音に":93,"祝":94,"詞乗りて。）":95,"………。[l]\nオトかコエか、響くのはその繰り返しになった。":96,"しばらく様子を見る。":97,"体感的に２、３分、\nそれに注意を払ったが、\n特に変化は無い。":98,"身体の方も進展はなく、ただ":99,"只":100,"管に舞台を視ている。":101,"も、もしかするといつの間にか寝てしまって、\n夢でも視てるんじゃ……":102,"しかし、実経験から言って、夢の中で自覚を持ったら大抵\nその時点で夢からは醒めるはず。[l]\nしかしどうやら……":103,"「………」":104,"そうはならないようだ。[l]\n取り巻く状況に変化はない。[l]\nや、わかってたことだけどな……":105,"――そ、それはとにかく、この感覚は":106,"怪":107,"訝しい。[l]\nいや、怪訝しいったらそれは、ここ数日間ずっと怪訝しいわけだが、\nこの音に限って案ずるに、\n何というか、\n漫画や小説ではよく描写される、\n脳に直接語りかけられてるというか、\nサラウンドのように音が回り込んで予想外の所から聴こえてる\nというか……[l]\nそれこそ金縛りの時のように、\n耳鳴りのような、\n鼓膜と聴神経ではない受容器で聴いてるような異常な感覚、":108,"ああ、視覚に続いて聴覚も――いや、\n猫が喋ってる幻覚にも襲われたし、\n妄想だろうがなんだろうがもう、\nだいぶツかれてるのだろうか……[l]\n診療所の処置でももう間に合わないくらいの\n辛労だったのかなあ今度の一連は。":109,"典型的な巻き込まれ型主人公じゃないかよ、\nと此処に来る前は思ったが、\nあの時は単なる喩えとして思っただけだ。":110,"巻き込まれるどころか、\n虚構のような出来事が僕の身に怒濤のように起きていく。[l]\nこれじゃあまるで、":111,"……否。[l]\nそうではない場合の、\nおそろしい想像。":112,"僕の身を襲うこれらの出来事が、\n全て、\n幻覚でもなんでもなく、":113,"………。":114,"何が現実でそうでないかの境界など、\n思考の主体自身が知る事は永劫に無いんだろうが、":115,"故に今僕が思考する事が、\n主観的観測事象だけが、\n僕にとっての事実とするならば、":116,"そんなばかな。[l]\nそんなのは、\nそんなのじゃ、":117,"まるで、\n御伽話か何かで、\nファンタジーじゃあるまいし、\nまるっきりゲームの登場人――":118,"………？":119,"なんだ。":120,"何かがいる？":121,"首が、熱い。":122,"と、\n唐突にそれが顕れた。":123,"「！？」":124,"後ろ首筋に戦慄が走った。[l]\n当然恐怖だ。[l]\nあの蔵の中のように総毛立ち、\n怖気をふるったような粟立つ感じを感じた、":125,"はずだった。":126,"しかし、やはりさっきから身体が硬直して――いる。[l]\n声も出ない、否、出せないんだ。":127,"だがそんな事にはお構いなしに、\n厳然として眼前に『それ』がいる。":128,"な、な、な、\nなんだよ…っ、これは……！":129,"実体があるようには視えないが、\nある、いる、そこに、\n『それ』が。":130,"眼もいかれて、耳もおかしくて、\nや、やっぱり眼もどうにかなったのかよ！？[l]\n全てが幻か、さもなきゃ、なきゃあ、":131,"そうだ、\n流石にここまで来ると、":132,"小難しい理屈なんか関係ない！":133,"いる、\n今そこに少なくとも、\n眼に視える何かがいる！[l]\n意識もはっきりしてるし脳空転もしていない！":134,"いつまでたってもそいつは消えないで\nそこにいるんだ！":135,"ああ、もう、\nこの状況のどの要素に焦ったらいいのか混乱するって！[l]\n上演してる『これ』に関係してるのか？":136,"もしそうならば姫様ちゃん、知ってて僕を呼んだのか？[l]\nそれとも偶々なのか？":137,"幸か不幸か身体の方は至って平静……というか、[l]\n意のままに動かないのが或る意味救いではある、が……":138,"視界のど真ん中に『それ』がいる。[l]\n首が、熱い。":139,"どうしても身体は意のままにならない。":140,"相変わらず、\n呼吸は僕の意志とは無関係に":141,"恙 ":142,"無く行われていく。":143,"身体操作の主導権が無いというか、\n他者に取って代わられたような、と言った方が正確な感じだろうか。":144,"何しろ眼は開いているし、\n呼吸も脈拍も平常、\n汗もかいてなければ震えもない。":145,"いやそんな冷静に分析してる場合とちがう。":146,"それ、よりも……ッ、[l]\n突如顕れた『それ』だ、\nなんなんだ、これ……":147,"端的に表現するなら、一つ目で、一本脚の、\n種から根っこが出たてのような、\nいわば『お花』を漫画的表現にしたような、\n巻いた":148,"蔓のような髭のようなものもある、":149,"猫？":150,"いや、それより、こんな……モノが、[l]\n居る――なん、\nいくら最近変なものが視えるとはいえ――":151,"どうしても受け入れろというのか、\nこんな現……":152,"熱、\n首が熱いのだが、\n未だ身体の自由は戻ってくれない。[l]\n他人から視ればやはり完全に普段通りなのだろうが…":153,"そして、猫だ、\nこれは猫なんだと、":154,"どうしても頭が認識する。[l]\n最近はどうも猫が頭に浮かぶ、にしてもだ。[l]\n明らかに既知生物の":155,"形":156,"態じゃないこれを、\n何故猫と、":157,"まさ、か、\nこれが、姫様ちゃん達の言う、\n感得すべきモノ、なの、か？":158,"ううううう。":159,"そ、そんな、こと、が、\n思考が麻痺、するよう、だ、\nこ、れは、\n空転、する脳、":160,"―。":161,"――。":162,"―――。":163,"（ぜえええれんふりいいいでん）":164,"（○）":165,"は？":166,"あ、おおう。[l]\n何か一瞬気付けのような感覚を覚え、\nどうやら思考麻痺は収まった……ようだ。":167,"が、肉体的には何ら改善への進展はみられない。[l]\n何かおかしな言葉が聞こえた――\nこの場合は脳内に、という意味だが、\nような気がしたが、\nもはやどこがリアルでどこが妄念なのかが曖昧な僕にとって、\nまるで夢の中での出来事を視る、その夢見る主体のように、\n何故か全てが結構性のある事象として受け入れられていく。":168,"その言葉きっかけで意識がはっきりとしたような、\nそうでもないような……そう感じる根拠として、\nそこだけ声が違う……この場合言葉が合ってるかどうか\n定かではないが、いわば別人の声、\nそれも何か聞き覚えのあるような声だったが故に、\nしかし誰かまでがいまいち――\nそして最後に言葉ではない、\n是認の意志を感じて、\n妙な安堵感が、":169,"と、眼前の方の状況に変化が生じて、\n僕の思考は中断された。":170,"視界が前方に固定された為に、左右広域を確認は出来ない。[l]\nが、幸いにというか、僕の座っていた位置がほぼ最後列のために、\n暗いが、大半の生徒は視認出来る。":171,"状況に変化が生じたというより、\n僕に、周囲を認識出来る余裕が生まれたと言った方が\n良いかも知れないんだが。":172,"暗い会場内、\nそこには沢山の小さな『それ』が、いた。":173,"恐らく会場内の全員の前にいる。[l]\n舞台の上の、演者にもだ。[l]\n冬夏の前にも――\nく、眼を凝らす事もままならぬ身がもどかしいなあっ。":174,"すると、僕の眼の前にいる奴も含め、\n一斉に小さいそれらが、\n互いに細かい――例の髭のような極細の繊維のようなものを延ばし、\n連結し出した。":175,"き、きもちわる……":176,"もはや、幻覚幻視がどうとかいうレベルじゃない。":177,"大神の言う『視える』がどういう感じか知らないが、\n兎に角、僕もどうやら、\n『何かが視えてる』ようだ。":178,"周囲が暗い所為もあるかも知れないが、\n余計にそれらが際だって、おえ……":179,"と、オトの方にも変化が生じた。":180,"――制御系閉鎖式手順諒解……":181,"――ミル　　　　　　　　ハ、\n　　　　ア　　ヤメ　ミ　ハ\n　　ル　　ナ　　ガ　ヒ　　サ\n　　　　キサ　ム　　ラ　　タ\n　　　マ　ズ　　サ　クイ\n　　　　カ　　　リヤオ　オ\n　　　　ク　ロ　コ　トハ\n　　　　　ネ　イイ　ハ、\n　　　イ　ツ　　　　　　　ワ。":182,"――白一二三四五六七八九十黒。":183,"――カミはわれとアリ。":184,"――世は全て事も無し。":185,"――なぁぁぁぁぁう゛。":186,"――３、ω、Σ、Ｍ、Ｅ、Ｗ、了。":187,"解る単語とそうでないのがごたまぜに聞こえ、\nもう完全に混乱し意味など把握できない。":188,"リョウ、のオトの後、\n突如例の振動音モドキが止まり、\n心なしか『それら』も一斉に制止したように視えた。":189,"すると、":190,"明":191,"瞭とは確認出来ないが、\n舞台の上のやつ、冬夏のも含む『それら』から始まり、\n最前列右端から順に『それ』が次々に一つにまとまって――\nその度に徐々に大きくなっていく。":192,"このままだと……席の順序からいって僕の位置に来るまでには、[l]\n相当統合が進んでることになるなこれは……":193,"く、来るぞ……ッ！":194,"びゅっ！":195,"と音がしそうなくらいの速度で、\n結構な大きさになった『それ』が\n眼の前を横にスライドしていったかと思うと、\n眼前にいた『それ』が姿を消した。":196,"隣の女子にも恐らく居たのだろうが、\nそいつも吸収していったのだろうか。":197,"『そいつら』に気を取られていて気付かなかったが、\nまだ、彼女は鼻歌を続けてたらしい。[l]\nやっぱり、視えてないってことか、他の人には。":198,"「……・ワ――」":199,"あ、あれ？[l]\n舞台の照明が落とされて、\n幕も下りてきた。":200,"シキは終わり――か。":201,"周りはまだ静かなままだ。":202,"――あまりにも、\nタイミングが合いすぎている。よな、これは。":203,"とても、\n無関係とは思えないが……[l]\nしかし……":204,"ううん、この一連の事は、\n姫様ちゃん達なら解るのだろうか。":205,"もしこれが彼女等の祭やらに関連しており、\nみせたかったモノがこれだとして――":206,"そう、蔵の件もあれば、\nそもそも本家の目的、\nそして僕の視界がおかしくなってきていること、":207,"どうも事が起こりすぎている。":208,"宮さんにも相談すべきだろうなあ。[l]\n僕に今回の事を勧めた時点で、少なくとも何を僕が得る事になるかは知ってるはずだし、":209,"……まさか『あれ』らの事を知ってるとは思えないから、[l]\nそれならそれで、本当は何を知らしめたかったのかは\n確認出来るだろう。":210,"終わった今となっては、\nどっちかというと『あれら』しか印象にないし、\nいわんとしていた事の方が気になる。":211,"或いは、\n大神に電話してみるか。":212,"彼":213,"奴の『視える』のがどんななのか、\nモノにしろ視え方にしろ、\n多少は得るものがあるかも知れない。[l]\n久々に話もしたいしな。":214,"あと、冬夏には知られずに済んでる事を祈るのみだ。[l]\nあらゆる意味で。":215,"兎に角、\n歌劇は終わってしまった。":216,"照明もまだ点かないし、アナウンスもないし、\n誰も一言も喋らないし、\nしーんと静まりかえったままだが。":217,"二幕構成とかじゃないよな、これ。":218,"うーん、\n取り敢えず、この式に参加した事によって、\n変な体験をしたことは間違いなく確かだ。":219,"劇の内容を感得というのとはちょっと違ってるけど、\nそこはどうなんだろうなあ。[l]\n宮さん大神だけじゃなく、勿論姫様ちゃん達にも当たることに\nなるだろう。":220,"彼女達に誘われてこうなった訳だし、触れない訳にはいかない。[l]\nこの制服も返さなきゃならないし、\n話をするに当たっては注意を払わなければならなそうだが、\n兎に角後半は殆ど舞台どころじゃな――":221,"そうだ、変な体験をした、じゃなくしてる、んだ。[l]\nと、取り敢えず、身体の問題が、まだ現在進行中……":222,"「（ちょ、兄ぃ）」":223,"「……っっ！！[l]\nび、\n（吃驚したぁ……お、あ、おおう）」":224,"かかか、狩屋か。":225,"と、あれ？":226,"「（あ、あいうえお、アメンボアカイナ……おおう）」":227,"意識と運動神経がようやく連動したようだ。[l]\nま、まだ慣れてないのと、\n本気吃驚した所為でやや大きめの声を出してしまった。":228,"何とか男子声とは気付かれないレヴェルを保つ努力はした！[l]\n任務遂行に熱心というか、女装とばれるのがいやだからです。":229,"兎に角身体の主導権は取り戻せたらしい。":230,"『あれ』が消えた所為なのか、\nやはり全てが夢で、\n狩屋の御陰でそれから醒めたのかは判然としないが……[l]\n否、後者はない、と思う。":231,"「（もう終わりにゃえ。[l]\n兄ぃまさか寝てたんじゃにゃいだろうな？）」":232,"「（そ、そんなことない……とおもう、[l]\nてかむしろそうだったらどんだけ）」":233,"「（しっ。[l]\n少しだまれ。そんな暇にゃいから）」":234,"明るくなる前に脱出した方がそりゃいいだろうけど、\n隣の女子は……":235,"狩屋は一瞬そっちを視て、\nあ、という表情をしたがすぐ僕の方に視線を戻し、\n手を取って僕を立たせた。":236,"早足の彼女に急かされて、\n仕方なく黙ったまま、\n映画を途中退席する客みたいに前屈みでついていく。":237,"諸々で忘れかけてたが、\n隣の席の彼女だけでなく、\n黒衣の人物と猫も気にはなるんだけど……":238,"猫に関しては宮さんが何から警告されてたし、\nこれ以上周囲に顔を晒してもリスク高すぎる。":239,"何しろ、\n己のこの格好。[l]\n隣の女子が何でお見通し＆お見逃し下さったのか？":240,"という、\n今の僕にとって有り難いのか、\nややこしい要因が増えて厄介なのか、":241,"微妙な属性を持った女子の登場はさておき、\n普通はこんなのばれたら色んな意味でもう。":242,"狩屋は僕を、\nてっきり舞台と反対方向、\n後方の出入り口に連れてくのかと思いきや、":243,"なんと舞台下横の、所謂校歌の歌詞――木彫りのあれ――\nが飾ってある真下の入り口に引っ張っていくのだった。":244,"しかし、暗いのと、\n狩屋が大道具だからという所為もあるのか、\nはたまた舞台終わりの余韻なのか、\nこっちに気を払う者は殆ど居なかった。":245,"静かに其処に入ると、":246,"「ま、今日の処はさっさと帰るといいにゃわ。[l]\n……きーちゃは色々兄ぃに用あるだろうけど、[l]\nにゃんにしたって落ち着いてからにゃな。":247,"制服もその時返せばいいから。[l]\n本人に伝えとくから心配すんな」":248,"と、にべもなく狩屋は言った。":249,"「てて、ていうか、これは、この式は結局さ……」":250,"「あ？[l]\nああ、まあ、\n――その辺はだからきーちゃと話してよ」":251,"「あいや、そういう事じゃなくてだな、\n――ま、まあ今はゆっくり話せる状況じゃないのは\n解ってるし端的にも説明しにくいのは確かだけど……」":252,"「だぁらさっきから言ってんにゃろ。[l]\nほれちゃっちゃとうごけ」":253,"「わ、わかったって。[l]\nじゃあ、姫様ちゃんによろしく、\nお前もさんくす……なのかなあ……」":254,"「にゃんでもいーわばか。[l]\n兄ぃに感謝されてもしゃーにゃいのっ。[l]\n帰り帰り」":255,"あーそうすか。[l]\nわかったわかった。[l]\nまーお前は元々そんなに乗り気じゃなかったしな。":256,"姫様ちゃんがいたらこんな態度もとれんかったろうが、\n仕方ない。":257,"僕もお前と顔突き合わせて真剣な……内容はアレだが、[l]\n相談なんかしたくはないっつーの。":258,"さぁてあとは、知狡さんの迎えの車まで何とも接触せずに乗り込めるかどうかだ。[l]\nこの身に起きた諸々の事の検討はそれから！":259,"知狡さんの事だから時間にはきっかり来てると思うが、\n何にしろこういうのはもう結構。":260,"見知らぬ場所で一人重大な事を成さねばならないという感覚は、\n大学受験を思い出すわい。[l]\n……いいんだ、色んな意味で終わった事は。":261,"舞台裏というか舞台袖みたいな所の出口は、\nアリーナとは隔絶されてるので、\nドアを開けても光がそっちに洩れることはない。":262,"狩屋はそれでもがさつな動作ではなく、\nあくまで慎重に扉を開け、\nしかし僕の手は乱暴に引いて一緒に外に出た。":263,"「一応敷地の外までは送るにゃさ。[l]\n何かあったらきーちゃに面目がたたにゃいからな！[l]\nほれ来い兄ぃ」":264,"「い、痛いですぅ先輩ぃ」":265,"「や、やめぃ！[l]\nなまじ似合ってんにゃから！[l]\nも、も、もうよせ！！」":266,"はん。[l]\nまあ僕も何とか復調してきたわ。":267,"或る意味ではお前の御陰だな。[l]\nそこは素直に感謝してやろう。":268,"「じゃーな。[l]\nまたどうせあとで……あ」":269,"振り向くと、\nいつの間にかあの女子も出入り口に立っていて、":270,"「♪」":271,"「？[l]\nまだあっこまで行くにぇ、ほれ」":272,"僕に、\nというより狩屋に向かってにっこりと笑みを浮かべて、\n目立たないように手を顔の前でひらひらさせていた。":273,"狩屋は気付いてないのか、そのまま僕の手を引き出す。":274,"それ以上、気を回す余裕は無く、\n僕は敷地外まで狩屋に連れられて行った。":275,"宮さんが喋る猫に関して知ってる素振りをしていたことにも、\n三春の蔵から持ち出した紙片に反応をしていたことにも、\n当然、気を回す余裕は無かった。":276,"雨は小雨になっていた。":277},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_019.ks","relPath":"/data/scenario/SC_M_019.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":278,"length":278,"percent":100},"cellInfo":[null,null,[null,{"v":1}],null,[null,{"t":"HU","v":1}],[null,{"t":"HU"}],[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"v":1}],null,[null,{"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"t":"HU","v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"t":"HU"}],null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"t":"HU","v":1}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,null,null,null,[null,{"t":"HU","v":1}],null,null,null,null,[null,{"t":"HU"}],null,null,[null,{"v":1}],null,[null,{"t":"HU"}],null,null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"t":"HU","v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,[null,{"t":"HU","v":1}],null,null,null,null,[null,{"v":1}],[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[273,0],"note":"完成"},"/data/scenario/SC_M_020.ks":{"data":[["「あー毎度毎度疲れること。[l]\nレバ刺しか何かでも食べようかねぇ。[l]\nこれまでの生涯で旨いと思うたことはないけども、\n身になるならば喰うほかは…あら」","「啊～每次都这么累人。[l]\n要不要吃个生肝刺身啥的。[l]\n虽然这辈子都没觉得那玩意儿好吃过，\n但要是对身体有好处的话也只能……哎呀」"],["「あー終わった終わった…[l]\n式はともかくあっちはいつ見てもきしょ…いにゃわわわわわわ」","「啊～总算结束了结束了…[l]\n仪式就算了那边每次看到都好恶心…喵哇哇哇哇」"],["「おおぅ、お疲れさまだよぅ。[l]\n今日の冬夏ちゃん良かったねぇ」","「噢～辛苦啦。[l]\n今天冬夏酱表现很棒呢」"],["「う、んあ、せせせ、選の字にゃんか。[l]\n","「呜、嗯啊、选选选、选律大人喵！[l]\n"],["きき、きしょうえいせいとんでけーーーーー！！！」","去去、恶心气息飞走吧——————！！！」"],["「どうも克杖ちゃん。[l]\n気色悪ぅい猫を遣います、選律婆さんで御座いますよぅ。[l]\n","「你好呀克杖酱。[l]\n我是驱使恶心猫咪的选律婆婆哟。[l]\n"],["あははは。","啊哈哈哈。"],["相変わらずうちみたいなもんにもフランクに接してくれるねぇ。[l]\n","你还是这么坦率地对待像我这样的人呢。[l]\n"],["なんもかんもしきたり守ればええちゅうもんではないしやねぇ、\nうちもほんまにあん頃思い出しますよって、\n嬉しいねぇ」","倒不是说死守规矩就行啦，\n我也常想起你们小时候的事呢，\n真开心呀」"],["「いあ、だ、だって、\n裏刀自様ってお呼びするのわご自分でお止めにならられれれ、\nそそそれに、きしょいだにゃんてそんな、\nういのにくらべればぜんぜん！","「噫啊、可、可是，\n “裏刀自大人” 这个称呼，还是希望您能别让我这么叫，\n而而而且、说什么恶心喵的太过分，\n和那位比起来根本不算什么！"],["タマ様は大変に！[l]\n見目麗しゅう御座いまするにょよ！！」","塔玛大人可是非常！[l]\n容貌端丽尊贵无双喵！！」"],["「あははせやからそんな、堅くならんでもえぇのんよ。[l]\nほんま真面目やねぇ克杖ちゃん。[l]\n西部あたりじゃ苦労しますよぅ。","「啊哈哈所以说不用这么拘谨啦。[l]\n克杖酱真是认真呢。[l]\n在西部那边会很辛苦哟。"],["ま、のぎかちゃんやあんお方みたいな方々には、\n克杖ちゃんくらいが丁度都合のいい","不过对于希香酱那样的大人物们来说，\n克杖酱这样程度的姑娘"],["娘ぉやろけど。","正好合适吧。"],["卑尊ちゃんはもうちょっと道具ちゃんと\n仲良うしてくれたらねぇ……[l]\n価無ちゃんもまだまだ子供やから、\n色々勉強して貰わんとねぇ。","要是卑尊酱能多和道具酱\n亲近些就好啦……[l]\n价无酱也还是个孩子，\n得多学习才行呢。"],["克杖ちゃんも、もう慣れはったんやね？[l]\nカリヤは割と扱いは楽やしねぇ。","克杖酱也差不多习惯了吧？[l]\n卡利亚还算好相处的啦。"],["それはそうと、\nいつもの喋りに戻しなさいな。[l]\n同じ年頃の娘御同士の会話に視えんとねぇ」","话说回来，\n快恢复平常的说话方式吧。[l]\n不然都不像同龄女孩间的对话啦」"],["「ま、まあ、うら…せ、選の字がそういうにゃら……」","「嘛、嘛、既、既然选律大人都这么说了喵……」"],["「気にせんとどんどん。[l]\nヒトなんて裏表があるくらいが丁度ええいうか、健全なんよ。[l]\n所詮世ン中なんて縦に綺麗すっぱり割れるもんでは無いからねぇ。","「别在意尽管说。[l]\n人啊有点表里不一才叫健全嘛。[l]\n说到底这世道哪能泾渭分明一刀切呢。"],["どっちに偏っても据わりの悪い気ぃがしますよぅ。[l]\n善し悪しなんてふわふわしたもん、\n嘘と承知で清濁併せ呑むんが、人生というもんですなぁ」","偏向哪边都觉得心里不踏实哟。[l]\n善恶这种飘忽不定的东西、\n明知虚假却清浊并吞、这才是人生啊」"],["「……それを言い訳にして勝手する輩が居るから、[l]\nテンプレを用意せざるを得なくなったんにゃろ、世の中って」","「……正因有人会以此为借口恣意妄为，[l]\n才不得不准备模板的吧，这世道」"],["「そうそうその調子でねぇ。[l]\nにしてもあらぁ、若いのに理屈っぽいねぇ。[l]\nあ、若いから、かしらねぃ」","「对对就是这种状态啦。[l]\n不过哎呀呀，年纪轻轻就这么爱讲道理呢。[l]\n啊，因为是年轻人，或许吧」"],["「だいたい選の字……シキタリを軽んじろにゃんて、[l]\n西部八相の刀自の言うこととは思えにゃいんだけど。[l]\n選の字のポジションだと何か企んでるみたいにゃえ」","「说到底选律……竟然轻视规矩，[l]\n真不像是西部八相的刀自大人会说的话呢。[l]\n以选律的立场来说总觉得在谋划什么喵」"],["「まさかぁ。[l]\nあんお方が幾ら三春を","「怎么可能啦。[l]\n就算那位大人再怎么偏袒"],["贔","三"],["屓してるからって、\nやっかんでる訳じゃありませんよぅ。","春家，\n也并非是在故意刁难呀。"],["ただ、","只是，"],["中","中"],["心 ","心 "],["教","法"],["義とて今や、\n書き換えられることもあるいう事ですよぅ。[l]\n今あることが在るべしと言う訳では無いいう事ですかなぁ」","则如今，\n也是有可能被重写的哟。[l]\n现存之物未必就是应有之物这个道理啦」"],["「選の字の昔の事にゃんかういだって詳しく教えて\n貰ってにゃいけども、\n聞いたところでホントか嘘かわかんにゃいからな。","「毕竟也不是不能请谁来\n好好讲讲选律过去的事儿，\n但就算听了也分不清真假吧。"],["道具さんといい、西部は言葉が軽すぎにゃんよ。[l]\n一言一言の重み一個もにゃいわ。[l]\n価無ちゃはまあ…あれにゃけど」","道具小姐也是，西部人说话太轻飘飘了。[l]\n字字句句连一点分量都没有。[l]\n价无酱嘛…虽然是那样但是」"],["「そんなん西国のノリですやんか。[l]\n『意味の在る深刻な嘘』平気で吐きはるんはどっちかいうたら\nこの辺の方々ちゃいますかねぇ」","「这不就是西国的风气嘛。[l]\n说着『有意义的深刻谎言』还面不改色的\n不正是这边的人吗？」"],["「人によるにゃなそれは。[l]\nもう、ういが悪かったですよ……[l]\nにゃんでも縦割りにあてはめちゃいかんにぇえ……","「这要看人吧。[l]\n真是的，刚才是我不好啦……[l]\n不能啥都往地域黑上套啊……"],["で、一応きーちゃが言うからあんたにも根回ししといたけどさ、\n……にゃんかわかった？[l]\n兄ぃ――てか、あのその、今日の例のあれで」","对了，既然是小姬说了我就先给你通个气，\n……明白了吗？[l]\n哥――不对，就是今天那件事啦」"],["「ああぁー……[l]\n隣りに来はった女装の子ぉやね」","「啊啊啊……[l]\n是坐在旁边那个女装的孩子吧」"],["「げ、\n選の字の真隣にゃったんか？[l]\n暗くてきづかなかた。","「吓，\n就在选律正旁边？[l]\n太暗了没注意到。"],["そこまではあたしが仕込んだ訳じゃにゃいけど……[l]\nで？」","那部分倒不是我事先安排的喵……[l]\n然后呢？"],["「えらい可愛い子ぉやったねぇ」","「真是个超可爱的孩子呢～」"],["「う、ま、まあにぇ……[l]\nいや、そうではにゃくて、その」","「呜、嘛、算是喵……[l]\n不对、不是那样的、那个」"],["「んー？[l]\n今日のスキャンには特に引っ掛かってないよぅ。[l]\n姫様ちゃん、不思議だねぃ。[l]\nもしかして、御婿候補いうことかねぇ？","「嗯～？[l]\n今天的扫描结果没啥特别异常哟～[l]\n姫様酱、真不可思议呢～[l]\n莫非、是候选驸马这回事儿？"],["眼だけを持った殿方は確かに有用だけど\n――最初女子制服で来た時はおや、と思ったけどねぃ、\nそういう趣味かとね、姫様ちゃんもその子も」","那位只有着眼睛的先生确实挺有用的\n――不过最初穿女生制服来时倒是让人家小吃一惊呢～\n原来是有这种爱好呀、姫様酱和那孩子都是」"],["「いあ、あれはたまたまというかにゃ、\nまあ、あははは……」","「噫啊、那个只是碰巧啦喵、\n嘛、啊哈哈哈……」"],["「たまたま、偶々ねえ。","「碰巧、偶然是吧～"],["タマといえばねぇ、\nうちのタマちゃんが","说到塔玛呢～\n咱家的塔玛"],["何 も反応しないからには、\nうん、\nそういう殿方じゃないと思うけど。","既然没有任何反应，\n嗯，\n我觉得他不是那种人啦。"],["ほならほうで姫様ちゃん、どうした事かなぁ。[l]\nわざわざシキタリを余所者に晒すリスクがわからへんねぇ。","那姫様酱到底怎么回事嘛。[l]\n完全不懂为啥要冒险让外人接触式契。"],["まぁ、うん、\n好きになった殿方にご執心するンは結構やけど、\nもしもの事があっても困るし……[l]\nそれとも本気で旦那にするつもりやろか」","嘛，嗯，\n虽然对心仪的男人着迷也挺好，\n但万一出事就麻烦啦……[l]\n该不会真想让他当丈夫吧」"],["「そ、そんなまさかぁ……[l]\nきーちゃは兄ぃを視たときから怪訝しいんだ……[l]\nひとつに――いや、にゃにゃ、\nにゃんというか過激な事まで言い出すし！","「怎、怎么可能啦……[l]\n小姬从见到哥哥起就怪怪的……[l]\n比如说――啊不是，喵喵，\n甚至说出些过激的话！"],["って、選の字、\nシキタリ云々はさっきと違うこと言ってんにゃん」","话说选律，\n你刚才说的式契和现在完全对不上喵」"],["「綾目は――姫様ちゃんは、\nそうねぇ、まさか……","「绫目家――姫様酱呢，\n这个嘛，应该不至于……"],["ん？あぁ、気にせんとってねぇ。[l]\n","嗯？啊，别在意啦。[l]\n"],["ま、冬夏ちゃんがあんなかんじやから、\n多少責任も強う背負ってるつもりなんかもねぇ。","毕竟冬夏酱是那种性格，\n多少也有点被迫扛责任的意味在啦。"],["色々大変やのにねぇ。[l]\nあ、克杖ちゃんもねぇ」","明明已经很不容易了。[l]\n啊，克杖酱也是呢」"],["「いいよその話は。[l]\nあたしだって八相家狩屋の『つぎめ』だ。[l]\n今更――」","「这个话题打住吧。[l]\n我好歹也是八相家狩屋的『继承者』。[l]\n事到如今――」"],["「ままま、だからそう深刻にならんと。[l]\n振ったうちが悪かったですぅ。","「好啦好啦，别这么严肃。[l]\n是人家提起话头不对啦。"],["うーん、神使八乃舞自体は溶媒のようなものやし、\n●●も解る人だけ解ればいい、程度の抽象式やからねぇ。","唔~神使八乃舞本身就像溶剂，\n因为这●●是那种‘只有懂的人能懂’程度的抽象表达啦。"],["それこそ大悟、頓悟を要求するペダン……ちっくだと[l]\n少々意味が違いますかなぁ。[l]\nま、多少そこいらの凡俗に見られたかて特に問題は」","非要说就是需要大彻大悟、顿悟的迂腐…… 气[l]\n意思上稍微有点偏差呢。[l]\n不过就算被世俗之辈看到也没啥问题」"],["「ももも、もういいて。[l]\nどっちでもいいにゃわ。[l]\n八相の人間はみんな本読み仕込まれるからもう\nみんなそんにゃだ。","「够够够了，打住吧。[l]\n怎样都无所谓喵。[l]\n八相的人从小都被灌输经典，\n大家都这德性喵。"],["ういも小学校高学年なるまで気付かなかったにゃけど、\n普通はそんな面倒な小理屈なんか一個も考えにゃいで\n生きてるんぜ」","咱直到小学高年级都没察觉，\n普通人根本不会想这些麻烦的小道理\n照样活得好好哒」"],["「だからそうやって軽薄な振りしてはるんでしょう？[l]\n凡俗達に無理に混じわらんでもええでしょうに……[l]\nああ、彼女の為ねぇ」","「所以才会装出这副轻浮模样吧？[l]\n明明没必要硬挤进凡俗堆里……[l]\n啊，都是为了她呢」"],["「……高尚さとか衒学趣味とか、[l]\n生きてくのにゃあ面倒なものにゃだけにゃさ」","「……高尚啊炫学趣味啊，[l]\n对生活来说都是麻烦玩意儿喵」"],["「それを察する能力は確かに、\n貴くありますが知識の","「虽然确实具备洞察的能力\n确实是很宝贵的，"],["能","但"],["力とは無関係やからねえ。","它与知识水平无关啦。"],["ほんまええ娘やなぁ克杖ちゃん。[l]\n","真是个好姑娘呀克杖酱。[l]\n"],["でもあんまりのめり込んだらあきませんよぅ。[l]\n凡俗に馴れ","不过太沉迷可不行哟。[l]\n就算迎合"],["合うてもなぁんもええこと……","凡俗也没啥好处……"],["冬夏ちゃんはねぇ、まぁ、あん出で立ちやからねぇ、\n違う事を思てるようやけど。[l]\nそれも世ン中出ないうちですよぅ。[l]\nいずれわかります」","冬夏酱嘛，毕竟那副派头，\n好像有不同想法。[l]\n那种人在世上也少见哟。[l]\n迟早会明白的」"],["「せ、選の字が言うと洒落ににゃらないから。[l]\nでも」","「选、选律说出来就不好笑啦。[l]\n但是」"],["「目立たぬ人生で、平穏に、\n静かに暮らしたい、いうんもあるでしょうな。","「想过不惹眼的人生，\n平静安稳地生活，也是有的吧。"],["まあでもねえ克杖ちゃん、\n平均的な大衆凡俗でいる方がむずかしことかもしれんよ。","不过呢克杖酱，\n当个普通大众可能更难哦。"],["それこそどっかの殺人鬼みたいにね、\n目立たなく在るべしと努力し注意を払う、というのも\nなかなか大変な事やないでしょかねぇ。","那简直就像某个杀人鬼一样呢，\n努力保持低调不引人注目这种事\n也是相当不容易的吧。"],["ましてやうちらは八相の猫遣い、\n白の者から追われる身ぃでもありますよ。[l]\n平穏無事に過ごすにはすべき事も出てきますわな」","更何况我们是八相的猫使，\n还是被白之众追捕的身份。[l]\n想要平安度日就得做些必要之事呢」"],["「………まあね」","「………也是呢」"],["「まあ、話戻りますけどな、\nタマちゃんが反応しなかった以上、\nその、","「话说回来，\n既然塔玛没什么反应，\n那个，"],["件 の殿方が白の者とも考え難いし、","那位先生恐怕也不太可能是白之众，"],["もし仮にそうだとしても、\n姫様ちゃんともあろう","就算假设真是如此，\n很难想象像姫様酱这样的"],["娘が、\n白の者と結ぶなんてそんな下手を打つとは……ねぇ。","女孩，\n会犯下与白之众勾结这种低级错误呢……对吧。"],["結局さっきの話と同じところをぐるぐるまわりますなぁ。[l]\n――いつもだったら色々精査もするんだけどねぇ、\n今回は色々立て込んでるし、\n心配なら克杖ちゃんが色々探ってみれば？」","结果又绕回刚才讨论的老问题了呢。[l]\n――平时明明会仔细调查各种线索的，\n但这次实在忙得不可开交，\n实在担心的话不如克杖亲自去查查看？」"],["「い、いきなり口調変えるってか？[l]\n","「突、突然改变说话方式是怎样？[l]\n"],["や、あんにゃ健忘……の――」","该、该不会健忘症又……――」"],["「？[l]\nどうしたのきょろきょろして？」","「？[l]\n怎么东张西望的？」"],["「や、きーちゃに聞かれてないかとにぇ……[l]\n","「没、就想确认小姬有没有在偷听……[l]\n"],["選の字がいきなり口調変えたから誰か来たかとおもたにゃんか。","选律突然变口音还以为有人来了喵。"],["あ、兄ぃは大体、冬夏ちゃから紹介されたんにゃし、\nういはもうきーちゃが言うがまましてたらこのありさま……」","啊对了老哥基本是冬夏介绍来的喵，\n我都是按小姬说的做才搞成这样……」"],["「まあ、克杖ちゃんは、\n姫様ちゃんの相手は誰であろうと心配なんだろうけどねぃ。","「不过克杖你啊，\n不管姫様酱和谁交往都会担心的吧。"],["どうにもあのお方の悪い影響かなぁ、\n克杖ちゃんも早ういい人見つけてくれないと、\n『つぎめ』が『つぎめ』じゃなくなっちゃうよぅ」","大概是被那位大人的坏习惯传染了，\n克杖不快点找个好对象的话，\n『继任者』就要名不副实了哟』"],["「うぇ？[l]\nや、にゃ、それは……ははははは」","「欸？[l]\n呀，怎、这可…… 哈哈哈哈哈」"],["「というわけで、\nどうかなぁ、\n普通に考えると、姫様ちゃん、\nその彼をやっぱり単純に御婿にしたいって事じゃない？","「所以说啊，\n你觉得呢\n按常理推断，姫様酱，\n果然还是单纯想招他当女婿吧？"],["眼を持たない殿方の方が、あのお方は安心するでしょうしねぃ」","没有‘眼’的那位先生，对那位大人来说反而会更放心吧」"],["「じょじょじょじょじょじょーだんじゃないよ！！」","「才才才才才不是这样！！」"],["「綾目の家の場合は特別だからねぃ、\n色んな意味で早い段階で抱き込もうとしたのかなぁ」","「毕竟绫目家情况很特殊，\n可能是想趁早笼络他吧」"],["「そんな……そんなのはちょっと、[l]\nういもどうしたらいいか……」","「这种……这种事也太突然了，[l]\n我都不知道该怎么办……」"],["「さっきも言ったけどねぃ、\n克杖ちゃんもあのお方じゃあるまいし、\nいい人見つけた方がみんなの為になるよぅ。","「刚才也说过，\n克杖又不是那位大人，\n找个好对象对大家都好。"],["いつまでも姫様ちゃん追っかけてる訳にはいかないんだし。[l]\nあのお方じゃないんだから、その辺は、ねぇ。","总不能永远追着姫様大人跑吧。[l]\n毕竟你不是那位大人啊。"],["さ、取り急ぎ克杖ちゃんのところは下のきょうだいのが大事かな。[l]\nそう言えば道具ちゃんも卑尊ちゃんも来たんでしょう。","眼下还是先处理克杖弟弟妹妹的事吧。[l]\n说起来道具和卑尊都来了吧。"],["寧子ちゃんも怪我までして――妹だと良いねえ。[l]\n姫様ちゃんに余計な負担かけずに済む」","连宁子都受伤了――如果是妹妹就好了。[l]\n这样就不会给姫様添麻烦了」"],["「……この時代、ホントはもうわかるんにゃろによ、[l]\nなんでわざわざ……[l]\n大体その辺のスケジューリングとか仕切ってるのは――」","「……这年头明明可以避免的，[l]\n何必非要……[l]\n说到底日程安排都是――」"],["「●●●はそう都合良く動かないからだよぅ。[l]\n人工的に……するのは色々面倒だからねぃ。[l]\n仕切は●●●●だから、あの件が起きて今回ごたごたしたのは\nしょうがないねぃ」","「●●●可不会那么听话哟。[l]\n人工堕胎……太麻烦了。[l]\n调度是●●●●负责的，这次乱成这样\n也是没办法呢」"],["「選律さん」","「选律大人」"],["「お、姫様ちゃん。[l]\nお疲れぃ。","「啊呀，姫様。[l]\n辛苦啦。"],["丁度いいや。[l]\nいきなり真面目な話でなんだけどぅ、そうそう、克杖ちゃんもね。[l]\n例の件はどうなってるん？","正好。[l]\n突然要说正经事呢，对对，克杖酱也是。[l]\n那件事怎么样了？"],["うふふ、\n色恋に","呵呵，\n谈情说爱"],["現 を抜かすんも――\n必要やけど、\nま、ほどほどに、やね。","摆脱现实――\n确实是有必要的，\n嘛，不过还是适可而止比较好啦。"],["祭は、何としてもやらなあきませんよってね」","祭典无论如何都必须举办呢」"],["「あの件の話でしたら、すみません。[l]\n進展はまだです。でも――","「那件事的话，抱歉。[l]\n还没有进展。不过――"],["選律さんからものぎかさんからも、\nこの件のプライオリティーは低めに感じましたけど。[l]\n","选律小姐和希香小姐都\n觉得这件事优先级不高呢。[l]\n"],["克杖、真言さんは？」","克杖，真言先生呢？」"],["「！[l]\nえ、えあ、取り敢えずは帰って貰ったよ」","「！[l]\n啊、啊嗯，总之先让他回去了」"],["「………」","「………」"],["「だ、だってあの格好のままじゃいろいろ……」","「因、因为那副打扮实在有点……」"],["「……残念……」","「……遗憾……」"],["「え……とぅ、[l]\nじゃ、あたしは後片付けあるからお二人で？[l]\n話ある？かにゃ？？」","「那个……[l]\n那、那我还要收拾，你们两位？[l]\n有话要说？喵？」"],["「じゃあ……私も手伝う」","「那……我也来帮忙」"],["「そ、そう？あそう！らにゃー！！」","「这、这样？啊对！喵呜！！」"],["「真言さんには……[l]\nあとで家に来て貰おうかな……」","「真言先生……[l]\n稍后要不要请他来家里呢……」"],["「にゃ！？」","「喵！？」"],["「では。[l]\n失礼します」","「那么。[l]\n失礼了」"],["「ああ、うちんことは気にせんでねぇ～。[l]\nあとで三春の家ででも話ましょかぁ」","「啊，我的事就不用在意啦～[l]\n待会儿在三春家再聊吧」"],["「で、でぁ、選の字、またあとでっ。[l]\n","「那、那选律，回头见。[l]\n"],["きーちゃ、待って」","小姬，等等我啦」"],["「ん～……[l]\nナナは何も言うてなかったけどなぁ……","「嗯～……[l]\n名无什么都没说呢……"],["まあ姫様ちゃんもいよいよホントに色気づいたいうことかいな。[l]\nふふ、同類の","看来姫様酱也终于到了情窦初开的年纪啦。[l]\n呼呼，作为同类"],["誼 で、無理に察するのは止めといてあげましょ。","的情分，就别勉强她察觉啦。"],["よくやってはるしねぇ彼女は。[l]\nつむじ曲げられても困りますよってね……","她可是很努力了呢。[l]\n要是闹别扭可就麻烦了呢……"],["祭の執行は大前提やから、例の件は別件いう意味で、\n確かにプライオリティーは低めやけどねぇ。","祭典执行是大前提，那件事算是另一码事，\n确实优先级比较低啦。"],["とはいえ、\nもうあんまり関係無くなるやろな。[l]\n早急に事を成せばそのような一切は瑣事となる、ねぇ。[l]\nうふふふふふふふ。ふふ」","不过话说回来，\n很快就不再相关了吧。[l]\n只要尽快成事，这些都会变成琐碎小事呢。[l]\n呵呵呵呵呵呵。呼呼」"]],"context":[["SC_M_020.ks/index/1/text"],["SC_M_020.ks/index/3/text"],["SC_M_020.ks/index/5/text"],["SC_M_020.ks/index/7/text"],["SC_M_020.ks/index/10/text"],["SC_M_020.ks/index/12/text"],["SC_M_020.ks/index/15/text"],["SC_M_020.ks/index/17/text"],["SC_M_020.ks/index/20/text"],["SC_M_020.ks/index/22/text"],["SC_M_020.ks/index/24/text"],["SC_M_020.ks/index/26/text"],["SC_M_020.ks/index/28/text"],["SC_M_020.ks/index/30/text"],["SC_M_020.ks/index/32/text"],["SC_M_020.ks/index/34/text"],["SC_M_020.ks/index/36/text"],["SC_M_020.ks/index/38/text"],["SC_M_020.ks/index/40/text"],["SC_M_020.ks/index/42/text"],["SC_M_020.ks/index/44/text"],["SC_M_020.ks/index/46/text"],["SC_M_020.ks/index/48/text"],["SC_M_020.ks/index/50/text"],["SC_M_020.ks/index/52/text"],["SC_M_020.ks/index/54/text"],["SC_M_020.ks/index/56/text"],["SC_M_020.ks/index/58/text"],["SC_M_020.ks/index/60/text"],["SC_M_020.ks/index/62/text"],["SC_M_020.ks/index/64/text"],["SC_M_020.ks/index/66/text"],["SC_M_020.ks/index/68/text"],["SC_M_020.ks/index/70/text"],["SC_M_020.ks/index/72/text"],["SC_M_020.ks/index/74/text"],["SC_M_020.ks/index/76/text"],["SC_M_020.ks/index/78/text"],["SC_M_020.ks/index/80/text"],["SC_M_020.ks/index/82/text"],["SC_M_020.ks/index/84/text"],["SC_M_020.ks/index/86/text"],["SC_M_020.ks/index/88/text"],["SC_M_020.ks/index/90/text"],["SC_M_020.ks/index/92/text"],["SC_M_020.ks/index/94/text"],["SC_M_020.ks/index/96/text"],["SC_M_020.ks/index/98/text"],["SC_M_020.ks/index/100/text"],["SC_M_020.ks/index/102/text"],["SC_M_020.ks/index/104/text"],["SC_M_020.ks/index/106/text"],["SC_M_020.ks/index/108/text"],["SC_M_020.ks/index/111/text"],["SC_M_020.ks/index/113/text"],["SC_M_020.ks/index/115/text"],["SC_M_020.ks/index/117/text"],["SC_M_020.ks/index/119/text"],["SC_M_020.ks/index/121/text"],["SC_M_020.ks/index/123/text"],["SC_M_020.ks/index/125/text"],["SC_M_020.ks/index/127/text"],["SC_M_020.ks/index/129/text"],["SC_M_020.ks/index/131/text"],["SC_M_020.ks/index/133/text"],["SC_M_020.ks/index/135/text"],["SC_M_020.ks/index/137/text"],["SC_M_020.ks/index/140/text"],["SC_M_020.ks/index/142/text"],["SC_M_020.ks/index/144/text"],["SC_M_020.ks/index/146/text"],["SC_M_020.ks/index/148/text"],["SC_M_020.ks/index/150/text"],["SC_M_020.ks/index/152/text"],["SC_M_020.ks/index/154/text"],["SC_M_020.ks/index/156/text"],["SC_M_020.ks/index/158/text"],["SC_M_020.ks/index/160/text"],["SC_M_020.ks/index/162/text"],["SC_M_020.ks/index/164/text"],["SC_M_020.ks/index/166/text"],["SC_M_020.ks/index/168/text"],["SC_M_020.ks/index/171/text"],["SC_M_020.ks/index/173/text"],["SC_M_020.ks/index/175/text"],["SC_M_020.ks/index/178/text"],["SC_M_020.ks/index/180/text"],["SC_M_020.ks/index/182/text"],["SC_M_020.ks/index/184/text"],["SC_M_020.ks/index/186/text"],["SC_M_020.ks/index/188/text"],["SC_M_020.ks/index/190/text"],["SC_M_020.ks/index/192/text"],["SC_M_020.ks/index/194/text"],["SC_M_020.ks/index/196/text"],["SC_M_020.ks/index/198/text"],["SC_M_020.ks/index/200/text"],["SC_M_020.ks/index/202/text"],["SC_M_020.ks/index/204/text"],["SC_M_020.ks/index/206/text"],["SC_M_020.ks/index/208/text"],["SC_M_020.ks/index/210/text"],["SC_M_020.ks/index/212/text"],["SC_M_020.ks/index/214/text"],["SC_M_020.ks/index/216/text"],["SC_M_020.ks/index/218/text"],["SC_M_020.ks/index/220/text"],["SC_M_020.ks/index/222/text"],["SC_M_020.ks/index/224/text"],["SC_M_020.ks/index/227/text"],["SC_M_020.ks/index/229/text"],["SC_M_020.ks/index/231/text","SC_M_020.ks/index/256/text"],["SC_M_020.ks/index/233/text"],["SC_M_020.ks/index/235/text"],["SC_M_020.ks/index/237/text"],["SC_M_020.ks/index/239/text"],["SC_M_020.ks/index/241/text"],["SC_M_020.ks/index/243/text"],["SC_M_020.ks/index/245/text"],["SC_M_020.ks/index/247/text"],["SC_M_020.ks/index/249/text"],["SC_M_020.ks/index/251/text"],["SC_M_020.ks/index/254/text"],["SC_M_020.ks/index/258/text"],["SC_M_020.ks/index/260/text"],["SC_M_020.ks/index/262/text"],["SC_M_020.ks/index/264/text"],["SC_M_020.ks/index/266/text"],["SC_M_020.ks/index/268/text"]],"tags":[],"parameters":[[{"start":196,"end":286}],[{"start":348,"end":397}],[{"start":458,"end":495}],[{"start":557,"end":579}],[{"start":610,"end":634}],[{"start":695,"end":743}],[{"start":776,"end":781}],[{"start":820,"end":853}],[{"start":886,"end":951}],[{"start":1013,"end":1099}],[{"start":1136,"end":1170}],[{"start":1231,"end":1302}],[{"start":1341,"end":1384}],[{"start":1395,"end":1402}],[{"start":1414,"end":1492}],[{"start":1531,"end":1572}],[{"start":1611,"end":1665}],[{"start":1727,"end":1752}],[{"start":1797,"end":1882}],[{"start":1894,"end":1972}],[{"start":2034,"end":2093}],[{"start":2154,"end":2216}],[{"start":2278,"end":2366}],[{"start":2427,"end":2451}],[{"start":2463,"end":2464}],[{"start":2475,"end":2506}],[{"start":2547,"end":2550}],[{"start":2562,"end":2563}],[{"start":2576,"end":2578}],[{"start":2590,"end":2591}],[{"start":2602,"end":2668}],[{"start":2730,"end":2796}],[{"start":2833,"end":2901}],[{"start":2962,"end":3034}],[{"start":3096,"end":3162}],[{"start":3174,"end":3248}],[{"start":3293,"end":3323}],[{"start":3385,"end":3424}],[{"start":3461,"end":3495}],[{"start":3556,"end":3571}],[{"start":3633,"end":3667}],[{"start":3712,"end":3793}],[{"start":3805,"end":3879}],[{"start":3941,"end":3974}],[{"start":4019,"end":4030}],[{"start":4042,"end":4065}],[{"start":4078,"end":4120}],[{"start":4132,"end":4188}],[{"start":4200,"end":4280}],[{"start":4342,"end":4430}],[{"start":4467,"end":4502}],[{"start":4563,"end":4591}],[{"start":4630,"end":4649}],[{"start":4682,"end":4727}],[{"start":4739,"end":4768}],[{"start":4830,"end":4879}],[{"start":4940,"end":4980}],[{"start":5019,"end":5073}],[{"start":5085,"end":5162}],[{"start":5224,"end":5297}],[{"start":5334,"end":5400}],[{"start":5461,"end":5534}],[{"start":5596,"end":5640}],[{"start":5701,"end":5730}],[{"start":5742,"end":5743}],[{"start":5754,"end":5766}],[{"start":5805,"end":5824}],[{"start":5857,"end":5891}],[{"start":5902,"end":5916}],[{"start":5955,"end":6038}],[{"start":6100,"end":6132}],[{"start":6193,"end":6232}],[{"start":6244,"end":6287}],[{"start":6328,"end":6397}],[{"start":6409,"end":6479}],[{"start":6541,"end":6549}],[{"start":6594,"end":6636}],[{"start":6649,"end":6666}],[{"start":6678,"end":6705}],[{"start":6717,"end":6749}],[{"start":6761,"end":6861}],[{"start":6923,"end":6943}],[{"start":6974,"end":6988}],[{"start":7049,"end":7074}],[{"start":7136,"end":7160}],[{"start":7191,"end":7220}],[{"start":7257,"end":7314}],[{"start":7375,"end":7418}],[{"start":7430,"end":7501}],[{"start":7563,"end":7591}],[{"start":7636,"end":7704}],[{"start":7716,"end":7745}],[{"start":7807,"end":7831}],[{"start":7876,"end":7922}],[{"start":7984,"end":8022}],[{"start":8067,"end":8128}],[{"start":8140,"end":8196}],[{"start":8208,"end":8271}],[{"start":8283,"end":8331}],[{"start":8393,"end":8468}],[{"start":8513,"end":8612}],[{"start":8700,"end":8706}],[{"start":8767,"end":8789}],[{"start":8828,"end":8892}],[{"start":8904,"end":8916}],[{"start":8929,"end":8966}],[{"start":8978,"end":8999}],[{"start":9060,"end":9097}],[{"start":9136,"end":9185}],[{"start":9215,"end":9225}],[{"start":9287,"end":9316}],[{"start":9377,"end":9382},{"start":10360,"end":10365}],[{"start":9444,"end":9466}],[{"start":9530,"end":9538}],[{"start":9600,"end":9653}],[{"start":9717,"end":9729}],[{"start":9791,"end":9808}],[{"start":9872,"end":9904}],[{"start":9966,"end":9972}],[{"start":10033,"end":10051}],[{"start":10112,"end":10156}],[{"start":10218,"end":10239}],[{"start":10270,"end":10279}],[{"start":10426,"end":10457}],[{"start":10469,"end":10512}],[{"start":10525,"end":10548}],[{"start":10560,"end":10601}],[{"start":10613,"end":10662}],[{"start":10703,"end":10782}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_020.ks","basename":"SC_M_020.ks","indexIds":{"「あー毎度毎度疲れること。[l]\nレバ刺しか何かでも食べようかねぇ。[l]\nこれまでの生涯で旨いと思うたことはないけども、\n身になるならば喰うほかは…あら」":0,"「あー終わった終わった…[l]\n式はともかくあっちはいつ見てもきしょ…いにゃわわわわわわ」":1,"「おおぅ、お疲れさまだよぅ。[l]\n今日の冬夏ちゃん良かったねぇ」":2,"「う、んあ、せせせ、選の字にゃんか。[l]\n":3,"きき、きしょうえいせいとんでけーーーーー！！！」":4,"「どうも克杖ちゃん。[l]\n気色悪ぅい猫を遣います、選律婆さんで御座いますよぅ。[l]\n":5,"あははは。":6,"相変わらずうちみたいなもんにもフランクに接してくれるねぇ。[l]\n":7,"なんもかんもしきたり守ればええちゅうもんではないしやねぇ、\nうちもほんまにあん頃思い出しますよって、\n嬉しいねぇ」":8,"「いあ、だ、だって、\n裏刀自様ってお呼びするのわご自分でお止めにならられれれ、\nそそそれに、きしょいだにゃんてそんな、\nういのにくらべればぜんぜん！":9,"タマ様は大変に！[l]\n見目麗しゅう御座いまするにょよ！！」":10,"「あははせやからそんな、堅くならんでもえぇのんよ。[l]\nほんま真面目やねぇ克杖ちゃん。[l]\n西部あたりじゃ苦労しますよぅ。":11,"ま、のぎかちゃんやあんお方みたいな方々には、\n克杖ちゃんくらいが丁度都合のいい":12,"娘ぉやろけど。":13,"卑尊ちゃんはもうちょっと道具ちゃんと\n仲良うしてくれたらねぇ……[l]\n価無ちゃんもまだまだ子供やから、\n色々勉強して貰わんとねぇ。":14,"克杖ちゃんも、もう慣れはったんやね？[l]\nカリヤは割と扱いは楽やしねぇ。":15,"それはそうと、\nいつもの喋りに戻しなさいな。[l]\n同じ年頃の娘御同士の会話に視えんとねぇ」":16,"「ま、まあ、うら…せ、選の字がそういうにゃら……」":17,"「気にせんとどんどん。[l]\nヒトなんて裏表があるくらいが丁度ええいうか、健全なんよ。[l]\n所詮世ン中なんて縦に綺麗すっぱり割れるもんでは無いからねぇ。":18,"どっちに偏っても据わりの悪い気ぃがしますよぅ。[l]\n善し悪しなんてふわふわしたもん、\n嘘と承知で清濁併せ呑むんが、人生というもんですなぁ」":19,"「……それを言い訳にして勝手する輩が居るから、[l]\nテンプレを用意せざるを得なくなったんにゃろ、世の中って」":20,"「そうそうその調子でねぇ。[l]\nにしてもあらぁ、若いのに理屈っぽいねぇ。[l]\nあ、若いから、かしらねぃ」":21,"「だいたい選の字……シキタリを軽んじろにゃんて、[l]\n西部八相の刀自の言うこととは思えにゃいんだけど。[l]\n選の字のポジションだと何か企んでるみたいにゃえ」":22,"「まさかぁ。[l]\nあんお方が幾ら三春を":23,"贔":24,"屓してるからって、\nやっかんでる訳じゃありませんよぅ。":25,"ただ、":26,"中":27,"心 ":28,"教":29,"義とて今や、\n書き換えられることもあるいう事ですよぅ。[l]\n今あることが在るべしと言う訳では無いいう事ですかなぁ」":30,"「選の字の昔の事にゃんかういだって詳しく教えて\n貰ってにゃいけども、\n聞いたところでホントか嘘かわかんにゃいからな。":31,"道具さんといい、西部は言葉が軽すぎにゃんよ。[l]\n一言一言の重み一個もにゃいわ。[l]\n価無ちゃはまあ…あれにゃけど」":32,"「そんなん西国のノリですやんか。[l]\n『意味の在る深刻な嘘』平気で吐きはるんはどっちかいうたら\nこの辺の方々ちゃいますかねぇ」":33,"「人によるにゃなそれは。[l]\nもう、ういが悪かったですよ……[l]\nにゃんでも縦割りにあてはめちゃいかんにぇえ……":34,"で、一応きーちゃが言うからあんたにも根回ししといたけどさ、\n……にゃんかわかった？[l]\n兄ぃ――てか、あのその、今日の例のあれで」":35,"「ああぁー……[l]\n隣りに来はった女装の子ぉやね」":36,"「げ、\n選の字の真隣にゃったんか？[l]\n暗くてきづかなかた。":37,"そこまではあたしが仕込んだ訳じゃにゃいけど……[l]\nで？」":38,"「えらい可愛い子ぉやったねぇ」":39,"「う、ま、まあにぇ……[l]\nいや、そうではにゃくて、その」":40,"「んー？[l]\n今日のスキャンには特に引っ掛かってないよぅ。[l]\n姫様ちゃん、不思議だねぃ。[l]\nもしかして、御婿候補いうことかねぇ？":41,"眼だけを持った殿方は確かに有用だけど\n――最初女子制服で来た時はおや、と思ったけどねぃ、\nそういう趣味かとね、姫様ちゃんもその子も」":42,"「いあ、あれはたまたまというかにゃ、\nまあ、あははは……」":43,"「たまたま、偶々ねえ。":44,"タマといえばねぇ、\nうちのタマちゃんが":45,"何 も反応しないからには、\nうん、\nそういう殿方じゃないと思うけど。":46,"ほならほうで姫様ちゃん、どうした事かなぁ。[l]\nわざわざシキタリを余所者に晒すリスクがわからへんねぇ。":47,"まぁ、うん、\n好きになった殿方にご執心するンは結構やけど、\nもしもの事があっても困るし……[l]\nそれとも本気で旦那にするつもりやろか」":48,"「そ、そんなまさかぁ……[l]\nきーちゃは兄ぃを視たときから怪訝しいんだ……[l]\nひとつに――いや、にゃにゃ、\nにゃんというか過激な事まで言い出すし！":49,"って、選の字、\nシキタリ云々はさっきと違うこと言ってんにゃん」":50,"「綾目は――姫様ちゃんは、\nそうねぇ、まさか……":51,"ん？あぁ、気にせんとってねぇ。[l]\n":52,"ま、冬夏ちゃんがあんなかんじやから、\n多少責任も強う背負ってるつもりなんかもねぇ。":53,"色々大変やのにねぇ。[l]\nあ、克杖ちゃんもねぇ」":54,"「いいよその話は。[l]\nあたしだって八相家狩屋の『つぎめ』だ。[l]\n今更――」":55,"「ままま、だからそう深刻にならんと。[l]\n振ったうちが悪かったですぅ。":56,"うーん、神使八乃舞自体は溶媒のようなものやし、\n●●も解る人だけ解ればいい、程度の抽象式やからねぇ。":57,"それこそ大悟、頓悟を要求するペダン……ちっくだと[l]\n少々意味が違いますかなぁ。[l]\nま、多少そこいらの凡俗に見られたかて特に問題は」":58,"「ももも、もういいて。[l]\nどっちでもいいにゃわ。[l]\n八相の人間はみんな本読み仕込まれるからもう\nみんなそんにゃだ。":59,"ういも小学校高学年なるまで気付かなかったにゃけど、\n普通はそんな面倒な小理屈なんか一個も考えにゃいで\n生きてるんぜ」":60,"「だからそうやって軽薄な振りしてはるんでしょう？[l]\n凡俗達に無理に混じわらんでもええでしょうに……[l]\nああ、彼女の為ねぇ」":61,"「……高尚さとか衒学趣味とか、[l]\n生きてくのにゃあ面倒なものにゃだけにゃさ」":62,"「それを察する能力は確かに、\n貴くありますが知識の":63,"能":64,"力とは無関係やからねえ。":65,"ほんまええ娘やなぁ克杖ちゃん。[l]\n":66,"でもあんまりのめり込んだらあきませんよぅ。[l]\n凡俗に馴れ":67,"合うてもなぁんもええこと……":68,"冬夏ちゃんはねぇ、まぁ、あん出で立ちやからねぇ、\n違う事を思てるようやけど。[l]\nそれも世ン中出ないうちですよぅ。[l]\nいずれわかります」":69,"「せ、選の字が言うと洒落ににゃらないから。[l]\nでも」":70,"「目立たぬ人生で、平穏に、\n静かに暮らしたい、いうんもあるでしょうな。":71,"まあでもねえ克杖ちゃん、\n平均的な大衆凡俗でいる方がむずかしことかもしれんよ。":72,"それこそどっかの殺人鬼みたいにね、\n目立たなく在るべしと努力し注意を払う、というのも\nなかなか大変な事やないでしょかねぇ。":73,"ましてやうちらは八相の猫遣い、\n白の者から追われる身ぃでもありますよ。[l]\n平穏無事に過ごすにはすべき事も出てきますわな」":74,"「………まあね」":75,"「まあ、話戻りますけどな、\nタマちゃんが反応しなかった以上、\nその、":76,"件 の殿方が白の者とも考え難いし、":77,"もし仮にそうだとしても、\n姫様ちゃんともあろう":78,"娘が、\n白の者と結ぶなんてそんな下手を打つとは……ねぇ。":79,"結局さっきの話と同じところをぐるぐるまわりますなぁ。[l]\n――いつもだったら色々精査もするんだけどねぇ、\n今回は色々立て込んでるし、\n心配なら克杖ちゃんが色々探ってみれば？」":80,"「い、いきなり口調変えるってか？[l]\n":81,"や、あんにゃ健忘……の――」":82,"「？[l]\nどうしたのきょろきょろして？」":83,"「や、きーちゃに聞かれてないかとにぇ……[l]\n":84,"選の字がいきなり口調変えたから誰か来たかとおもたにゃんか。":85,"あ、兄ぃは大体、冬夏ちゃから紹介されたんにゃし、\nういはもうきーちゃが言うがまましてたらこのありさま……」":86,"「まあ、克杖ちゃんは、\n姫様ちゃんの相手は誰であろうと心配なんだろうけどねぃ。":87,"どうにもあのお方の悪い影響かなぁ、\n克杖ちゃんも早ういい人見つけてくれないと、\n『つぎめ』が『つぎめ』じゃなくなっちゃうよぅ」":88,"「うぇ？[l]\nや、にゃ、それは……ははははは」":89,"「というわけで、\nどうかなぁ、\n普通に考えると、姫様ちゃん、\nその彼をやっぱり単純に御婿にしたいって事じゃない？":90,"眼を持たない殿方の方が、あのお方は安心するでしょうしねぃ」":91,"「じょじょじょじょじょじょーだんじゃないよ！！」":92,"「綾目の家の場合は特別だからねぃ、\n色んな意味で早い段階で抱き込もうとしたのかなぁ」":93,"「そんな……そんなのはちょっと、[l]\nういもどうしたらいいか……」":94,"「さっきも言ったけどねぃ、\n克杖ちゃんもあのお方じゃあるまいし、\nいい人見つけた方がみんなの為になるよぅ。":95,"いつまでも姫様ちゃん追っかけてる訳にはいかないんだし。[l]\nあのお方じゃないんだから、その辺は、ねぇ。":96,"さ、取り急ぎ克杖ちゃんのところは下のきょうだいのが大事かな。[l]\nそう言えば道具ちゃんも卑尊ちゃんも来たんでしょう。":97,"寧子ちゃんも怪我までして――妹だと良いねえ。[l]\n姫様ちゃんに余計な負担かけずに済む」":98,"「……この時代、ホントはもうわかるんにゃろによ、[l]\nなんでわざわざ……[l]\n大体その辺のスケジューリングとか仕切ってるのは――」":99,"「●●●はそう都合良く動かないからだよぅ。[l]\n人工的に……するのは色々面倒だからねぃ。[l]\n仕切は●●●●だから、あの件が起きて今回ごたごたしたのは\nしょうがないねぃ」":100,"「選律さん」":101,"「お、姫様ちゃん。[l]\nお疲れぃ。":102,"丁度いいや。[l]\nいきなり真面目な話でなんだけどぅ、そうそう、克杖ちゃんもね。[l]\n例の件はどうなってるん？":103,"うふふ、\n色恋に":104,"現 を抜かすんも――\n必要やけど、\nま、ほどほどに、やね。":105,"祭は、何としてもやらなあきませんよってね」":106,"「あの件の話でしたら、すみません。[l]\n進展はまだです。でも――":107,"選律さんからものぎかさんからも、\nこの件のプライオリティーは低めに感じましたけど。[l]\n":108,"克杖、真言さんは？」":109,"「！[l]\nえ、えあ、取り敢えずは帰って貰ったよ」":110,"「………」":111,"「だ、だってあの格好のままじゃいろいろ……」":112,"「……残念……」":113,"「え……とぅ、[l]\nじゃ、あたしは後片付けあるからお二人で？[l]\n話ある？かにゃ？？」":114,"「じゃあ……私も手伝う」":115,"「そ、そう？あそう！らにゃー！！」":116,"「真言さんには……[l]\nあとで家に来て貰おうかな……」":117,"「にゃ！？」":118,"「では。[l]\n失礼します」":119,"「ああ、うちんことは気にせんでねぇ～。[l]\nあとで三春の家ででも話ましょかぁ」":120,"「で、でぁ、選の字、またあとでっ。[l]\n":121,"きーちゃ、待って」":122,"「ん～……[l]\nナナは何も言うてなかったけどなぁ……":123,"まあ姫様ちゃんもいよいよホントに色気づいたいうことかいな。[l]\nふふ、同類の":124,"誼 で、無理に察するのは止めといてあげましょ。":125,"よくやってはるしねぇ彼女は。[l]\nつむじ曲げられても困りますよってね……":126,"祭の執行は大前提やから、例の件は別件いう意味で、\n確かにプライオリティーは低めやけどねぇ。":127,"とはいえ、\nもうあんまり関係無くなるやろな。[l]\n早急に事を成せばそのような一切は瑣事となる、ねぇ。[l]\nうふふふふふふふ。ふふ」":128},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_020.ks","relPath":"/data/scenario/SC_M_020.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":129,"length":129,"percent":100},"cellInfo":[[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"t":"HU"}],null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[126,1],"note":"完成"},"/data/scenario/SC_M_021.ks":{"data":[["「お疲れさまです」","「辛苦了」"],["「……ふぅっ。[l]\n……ん？[l]\nああ、綾目か……お疲れさま……[l]\nはぁ……ふー……」","「……呼……[l]\n……嗯？[l]\n啊，绫目啊……辛苦了……[l]\n哈……呼……」"],["折角面倒な事が済んだと思ったのに、\nほんとに、絶妙に嫌なタイミングで姿をみせるのね。","刚以为麻烦事总算结束了，\n偏偏在这种微妙时刻出现呢。"],["気分がささくれ立つ。","心情烦躁。"],["ワザとか否かなどどっちでもいい。[l]\nそういう結果をもたらしてる以上、\n同じ事だ。","是不是故意的都无所谓。[l]\n既然导致了这样的结果，\n都一样。"],["「昨日の遅くまでの練習の御陰でしょう。[l]\nとても素晴らしい式でした。[l]\n同時に随分お疲れのようですが」","「多亏了昨天练习到很晚吧。[l]\n仪式非常出色。[l]\n不过看起来也相当疲惫呢」"],["「……ありがとう」","「……谢谢」"],["ふう、\nはあ。","呼，\n哈。"],["呼吸はまだ荒いままだ。","呼吸仍然很急促。"],["血の巡りが促進されている所為だろう、\n左眼の","大概是血液循环加快的缘故吧、\n左眼的"],["疵","伤"],["痕が、\nずきずきと痛い。","疤正在、\n一跳一跳地疼。"],["疲れているのは本当だ。[l]\nだから、邪魔をするな。","确实很疲惫。[l]\n所以、别来碍事。"],["気分はどんどんとささくれ立つ。[l]\n早く何処かへ行って欲しい。","情绪变得越来越暴躁。[l]\n希望你赶紧去别的地方。"],["「御自宅に戻ったのは深夜だったんですね」","「您回到宅邸时已是深夜了呢」"],["「……そうよ。[l]\n狩屋も知ってるわ。準備で遅くまで居たもの。[l]\nあなたは端役だからすぐ帰ったのでしょうけど」","「……是啊。[l]\n狩屋也知道。因为筹备工作留到很晚。[l]\n你这种龙套角色倒是早早回去了吧」"],["「私は選律さんに用事がありましたから」","「我找选律小姐有事要办」"],["「私、先生達の許可も取ったわよ。[l]\n運動部のシャワーもあるし、\n食事も準備してたわ。[l]\n何か気に入らない事があるとでも言うのかしら？」","「我可是取得老师们许可的。[l]\n运动部的淋浴间也能用、\n连餐点都准备好了。[l]\n莫非你还有什么不满意的事要说？」"],["「選律さんも、あの方もいらしてるのに」","「选律小姐和那位大人都专程到场了」"],["「……そうだったかしらね」","「……是这样吗」"],["「だからですか？」","「就因为这个？」"],["「は？[l]\n何が？」","「哈？[l]\n什么啊？」"],["「あの方が直々にいらっしゃることなど\n滅多に無かったことですから」","「那位大人亲自莅临的场合\n可是非常罕见的」"],["「そんなことより出てってくれる」","「比起这个请你出去」"],["「……」","「……」"],["「着替えるの。[l]\n子供じゃないんだから一人でやれるわよ。[l]\n幾らあなたがメイドみたいな仕事割り振られてようと、」","「我要换衣服。[l]\n又不是小孩子了自己能搞定。[l]\n就算你被分配了女仆般的杂务、」"],["「承知してます。[l]\nそんな事のために居るとでも本気で思いましたか」","「我很清楚。[l]\n您真以为我是为这种事留下的吗」"],["「……なに？」","「……什么？」"],["「ご機嫌が悪いようですね」","「您似乎心情不佳呢」"],["「いい加減にしなさいよ！[l]\nほっといてくれる！[l]\n狩屋のとこにでも行ってなさいよ！」","「适可而止吧！[l]\n别管我！[l]\n去狩屋那边待着啊！」"],["「冬夏さんに言ってないことがありました」","「有件事没告诉冬夏小姐」"],["「……なによ。[l]\nそれでわざわざ言いに来たとでも言うの？」","「……怎样。[l]\n特意跑来就为说这个？」"],["「今日、\n此処にあの人が居たということ」","「今天、\n那个人就在这里」"],["「は？[l]\n誰よ？！[l]\n何のことよ！[l]\n――","「哈？[l]\n谁啊？！[l]\n说什么呢！[l]\n――"],["明","把"],["瞭モノを言えッ！！」","话说清楚！！」"],["「貴女では気付けなくても――」","「就算您未曾察觉――」"]],"context":[["SC_M_021.ks/index/1/text"],["SC_M_021.ks/index/3/text"],["SC_M_021.ks/index/5/text"],["SC_M_021.ks/index/7/text"],["SC_M_021.ks/index/9/text"],["SC_M_021.ks/index/11/text"],["SC_M_021.ks/index/13/text"],["SC_M_021.ks/index/15/text"],["SC_M_021.ks/index/17/text"],["SC_M_021.ks/index/19/text"],["SC_M_021.ks/index/21/text"],["SC_M_021.ks/index/23/text"],["SC_M_021.ks/index/25/text"],["SC_M_021.ks/index/27/text"],["SC_M_021.ks/index/29/text"],["SC_M_021.ks/index/31/text"],["SC_M_021.ks/index/33/text"],["SC_M_021.ks/index/35/text"],["SC_M_021.ks/index/37/text"],["SC_M_021.ks/index/39/text"],["SC_M_021.ks/index/41/text"],["SC_M_021.ks/index/43/text"],["SC_M_021.ks/index/45/text"],["SC_M_021.ks/index/47/text"],["SC_M_021.ks/index/49/text"],["SC_M_021.ks/index/51/text"],["SC_M_021.ks/index/53/text"],["SC_M_021.ks/index/55/text"],["SC_M_021.ks/index/57/text"],["SC_M_021.ks/index/59/text"],["SC_M_021.ks/index/61/text"],["SC_M_021.ks/index/63/text"],["SC_M_021.ks/index/65/text"],["SC_M_021.ks/index/67/text"],["SC_M_021.ks/index/69/text"],["SC_M_021.ks/index/71/text"],["SC_M_021.ks/index/73/text"]],"tags":[],"parameters":[[{"start":207,"end":216}],[{"start":250,"end":309}],[{"start":339,"end":385}],[{"start":397,"end":407}],[{"start":419,"end":469}],[{"start":504,"end":567}],[{"start":601,"end":610}],[{"start":640,"end":651}],[{"start":663,"end":674}],[{"start":686,"end":712}],[{"start":724,"end":725}],[{"start":737,"end":753}],[{"start":765,"end":795}],[{"start":807,"end":843}],[{"start":878,"end":898}],[{"start":932,"end":998}],[{"start":1033,"end":1052}],[{"start":1086,"end":1169}],[{"start":1204,"end":1223}],[{"start":1257,"end":1270}],[{"start":1305,"end":1314}],[{"start":1348,"end":1363}],[{"start":1398,"end":1435}],[{"start":1469,"end":1485}],[{"start":1520,"end":1524}],[{"start":1558,"end":1626}],[{"start":1661,"end":1700}],[{"start":1734,"end":1741}],[{"start":1776,"end":1789}],[{"start":1823,"end":1877}],[{"start":1912,"end":1932}],[{"start":1966,"end":2001}],[{"start":2036,"end":2060}],[{"start":2094,"end":2133}],[{"start":2145,"end":2146}],[{"start":2158,"end":2168}],[{"start":2203,"end":2218}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_021.ks","basename":"SC_M_021.ks","indexIds":{"「お疲れさまです」":0,"「……ふぅっ。[l]\n……ん？[l]\nああ、綾目か……お疲れさま……[l]\nはぁ……ふー……」":1,"折角面倒な事が済んだと思ったのに、\nほんとに、絶妙に嫌なタイミングで姿をみせるのね。":2,"気分がささくれ立つ。":3,"ワザとか否かなどどっちでもいい。[l]\nそういう結果をもたらしてる以上、\n同じ事だ。":4,"「昨日の遅くまでの練習の御陰でしょう。[l]\nとても素晴らしい式でした。[l]\n同時に随分お疲れのようですが」":5,"「……ありがとう」":6,"ふう、\nはあ。":7,"呼吸はまだ荒いままだ。":8,"血の巡りが促進されている所為だろう、\n左眼の":9,"疵":10,"痕が、\nずきずきと痛い。":11,"疲れているのは本当だ。[l]\nだから、邪魔をするな。":12,"気分はどんどんとささくれ立つ。[l]\n早く何処かへ行って欲しい。":13,"「御自宅に戻ったのは深夜だったんですね」":14,"「……そうよ。[l]\n狩屋も知ってるわ。準備で遅くまで居たもの。[l]\nあなたは端役だからすぐ帰ったのでしょうけど」":15,"「私は選律さんに用事がありましたから」":16,"「私、先生達の許可も取ったわよ。[l]\n運動部のシャワーもあるし、\n食事も準備してたわ。[l]\n何か気に入らない事があるとでも言うのかしら？」":17,"「選律さんも、あの方もいらしてるのに」":18,"「……そうだったかしらね」":19,"「だからですか？」":20,"「は？[l]\n何が？」":21,"「あの方が直々にいらっしゃることなど\n滅多に無かったことですから」":22,"「そんなことより出てってくれる」":23,"「……」":24,"「着替えるの。[l]\n子供じゃないんだから一人でやれるわよ。[l]\n幾らあなたがメイドみたいな仕事割り振られてようと、」":25,"「承知してます。[l]\nそんな事のために居るとでも本気で思いましたか」":26,"「……なに？」":27,"「ご機嫌が悪いようですね」":28,"「いい加減にしなさいよ！[l]\nほっといてくれる！[l]\n狩屋のとこにでも行ってなさいよ！」":29,"「冬夏さんに言ってないことがありました」":30,"「……なによ。[l]\nそれでわざわざ言いに来たとでも言うの？」":31,"「今日、\n此処にあの人が居たということ」":32,"「は？[l]\n誰よ？！[l]\n何のことよ！[l]\n――":33,"明":34,"瞭モノを言えッ！！」":35,"「貴女では気付けなくても――」":36},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_021.ks","relPath":"/data/scenario/SC_M_021.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":37,"length":37,"percent":100},"cellInfo":[null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,null,[null,{"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[35,1],"note":"完"},"/data/scenario/SC_M_022.ks":{"data":[["僕は、\n夕暮れの屋上が好きだ。","我啊、\n喜欢黄昏的屋顶。"],["とは言え、\n屋上というのは、思ったよりもそうそう簡単には\n入れるエリアではない。[l]\n体験し得るシチュエーション自体、\nそういう意味では限定されるよな。[l]\n例えば学校の放課後とか、学祭の時とか、\nはたまた、幼少期に、まさに此処、\n本家経営の六母屋の屋上でそういう契機があったのかも知れないが、\n","虽说如此、\n屋顶这种地方、实际上并不像想象中那样\n能够轻易进入。[l]\n能体验这种情境的机会本身、\n从这个意义上说就很有限呢。[l]\n比如放学后的学校啦、学园祭的时候啦、\n又或者、小时候就在这个地方、\n本家经营的六母屋屋顶上有过类似契机也说不定、\n"],["何","究竟是出于什么"],["契","契"],["機でそういう嗜好になったのか、\n正直、明確に説明は出来ない──ま、大体そういうもんかも\n知れないけど。[l]\nま、契機はどうあれ、\n僕の中で夕暮れの屋上には、\n何かしら惹かれる","机才养成了这样的喜好、\n老实说没法明确解释——嘛、大概就是这么回事\n吧。[l]\n嘛、契机怎样都好、\n在我心里黄昏的屋顶总带着\n某种难以抗拒的"],["因","因"],["子がある事には\n間違いない。","素\n这一点是毋庸置疑的。"],["びょおおおおおおおおぅ……","呼嗷嗷嗷嗷嗷嗷呜……"],["風の音だ。[l]\nそれしか聞こえない。","是风声。[l]\n除此之外什么都听不见。"],["小雨になっていたとは言え、出たときはまだ降っていた雨が、\n今はもうすっかり晴れ上がっている。","虽说转成了小雨，但出门时还下着的雨，\n此刻已经完全放晴了。"],["眼下には、\n来た時の夕暮れ、あの橋の上とはまた別の視界が広がる。[l]\n昼間の嵐が去った、何とも言えない爽やかさの混じる風が、\nオレンジ色の空と雲、異常に澄んだ大気を走っていく。[l]\n雨後が常に好い感じとは限らないが、\nこの、こういう雨上がりは好きだ。","在眼底，\n与来时黄昏桥上的景色截然不同的视野正铺展开来。[l]\n白昼的暴风雨离去后，夹杂着难以言喻的清爽感的风，\n正掠过橙色的天空、云朵和异常澄澈的大气。[l]\n雨后未必总是令人愉悦，\n但像这样的雨过天晴我很喜欢。"],["リセットというと何かネガティヴワードぽいけど、\nまあなんというか、\n感傷がどうとか言う前に、\n物理的に大気は洗浄されてるんだろうし、\n掃除した直後のサッパリした感、\n新品の感じが好い。[l]\n未開封の積み本ばっかあったしな僕は！[l]\n処女地好きなんです！","虽说重置听起来像是个消极词汇，\n不过该怎么说呢，\n在纠结感伤之前，\n物理层面上大气确实被洗涤过了吧，\n就像刚打扫完那种神清气爽的感觉，\n崭新的状态最棒了。[l]\n我可是囤了一堆未拆封的书啊！[l]\n我就是喜欢处女地啊！"],["いや、それはまあどうでもいいんだけど。","啊不，这个其实无所谓啦。"],["最初の契機は説明出来ずとも、\n好きな理由はこう割と簡単に理屈付けられるね。[l]\nで、屋上が好きだというのには別の理由もある。","最初的契机虽无法说明，\n但喜欢的理由倒是能这样简单地找出道理来呢。[l]\n而喜欢屋顶还有另一个理由。"],["たまにででも、\n通常視点とは違う視点に立ってみるというのは必要と思うからだ。","哪怕只是偶尔，\n我认为有必要站在与平常不同的视角看看。"],["ものの見方というのは一個ではないという戒めを得るとでも言おうか、見方の角度だけでなく","可以说，我领悟到了‘看待事物的方式并非只有一种’这一告诫，不仅是看待事物的角度，就连衡量的"],["尺","尺"],["度にも色んな段階があるという事は日常生活ではなかなか思いを巡らすことはないし。[l]\n大学時代には、ちっとは実習実験もやってたから、\n顕微鏡の世界、即ち","度也存在诸多不同的层级，这在日常生活中很难意识到。[l]\n大学时代好歹也做过些实习实验，\n显微镜的世界，也就是所谓的"],["極","微"],["微の世界というのにも\n触れる機会があったけど、\nそっちはなかなか設備が無いと難しいもんね。","观世界\n也曾有过接触的机会，\n但那边（指微观世界）要是没有设备就相当困难呢。"],["自分に視えてる世界だけが全部な訳ではなく、\n掌握してる世界というのはこの惑星の次元という限定された中での\n更に小さな一個人の脳内の勝手な解釈なのかも知れぬ、[l]\nという自省を得る為にも、\nモノ視る物差しは、色んな種類を持っておくことに\n越したことはない。","自己所见的世界并非全部，\n所掌握的世界或许只是在这颗星球维度限制下的\n更微小的单个人脑中的任意解读，[l]\n为了获得这般自省，\n衡量事物的标尺，多备几种\n总是没错的。"],["そういったずれた視界――あくまで相対的に、\nという意味で――を持つと、\n世の中渡って行く上で、楽しいこともあるかもね。[l]\nと、母さんに言われて育ったのだ、僕は。[l]\n幼少期の記憶は曖昧な僕だが、\nまあ未だに続く嗜好、習慣だからなんとか憶えてる。","那种错位的视野――当然只是相对的，\n在这个意义上――拥有这样的视角，\n在世间行走时，或许也会遇到些乐事吧。[l]\n我就是被妈妈这样教育长大的。[l]\n虽然幼年记忆很模糊的我，\n不过因为这是延续至今的癖好和习惯，所以勉强还记得。"],["何か今にして思えば、知狡さんがあの日橋の上で言った話も、\nそういう感じの事を言いたかったのかなあ……て[l]\n気もするけど。[l]\nなんたって一応は姉妹だしな。[l]\n表出してる","现在回想起来，知狡阿姨那天在桥上说的话，\n大概也是想表达类似的感觉吧……[l]\n虽然这么觉得。[l]\n毕竟好歹也算是姐妹嘛。[l]\n表露出来的"],["為 ","为 "],["人は真反対だけど……","人却完全相反……"],["「さりとて、\n凡俗たる僕にはこうやって、","「话虽如此，\n作为凡夫俗子的我也只能这样，"],["高みから世を","从高处将世间"],["睥","睥"],["睨し、\n","睨而视，\n"],["厭","故作厌"],["世","世"],["家を気取り我が身を憂うのが関の山、\nなんつってな……」","之态，一味忧虑自身，\n开玩笑的啦……」"],["実際、\n下界の喧噪と、此処に孤独で居る事の","实际上，\n下界的喧嚣与在此独处的"],["対","对"],["比は、\nまあ嫌な言い方だけども、ナルシス的な愉悦に浸れるというか、\nヒトの文明社会から隔絶された感がステキ……っていうと[l]\nカッコつけしぃみたいだな、\nえーと何とかと煙は高いところが……","比，\n虽然说法有点讨厌，但确实能沉浸在自恋般的愉悦中，\n或者说与人类文明社会隔绝的感觉真棒……这么一说[l]\n显得有点装模作样呢，\n呃…什么和烟往高处飘……"],["じゃなくて、\n電波が届きやすい……じゃないや、[l]\n自分がヒトの社会構造から逸脱してる錯覚がだな……[l]\nいやいやそれもどうだよ。[l]\n一人思考の中でどんどん墓穴を掘ってる気がしてきた……","不对，\n是信号更容易接收……也不对，[l]\n大概是觉得自己脱离了人类社会结构的错觉吧……[l]\n不不这样也不太对。[l]\n感觉独自思考时越挖坑越深了……"],["僕も理屈っぽい人間という自覚はあるけど、\nチノ嬢に逢ってから何か拍車がかかってきたかも……[l]\n宮さんはどっちかというと感覚重視系のケがあるしなあ。","虽然我自认是个爱讲道理的人，\n但遇见千乃小姐后好像变本加厉了……[l]\n宫小姐相比之下更偏向感性派呢。"],["でもまあ……[l]\nやっぱり最終的には、\n小難しい理屈が無くても、\n夕暮れの屋上は好きなんだよね。","不过……[l]\n说到底最终\n就算没有复杂的道理，\n黄昏的屋顶就是让人喜欢啊。"],["結局最後は好きか嫌いか、か。[l]\nいやだからそれは宮さん――","归根结底还是看喜欢与否，对吧。[l]\n不对所以这是宫小姐――"],["「――まるで、猫」","「――简直像猫一样」"],["うん、\nあのひとは猫だなあ……","嗯，\n那个人确实像猫……"],["猫は、[l]\n\n犬とは違って自ら愛想は振りまかない、\n愛想よく視えるときは自分がそうしたいからだ。[l]\n相手を","猫啊，[l]\n\n和狗不同不会主动讨好，\n看起来亲热时也只是它自己想那样。[l]\n并非"],["慮っての行為じゃない、\n自分の利になるとみたときには、[l]\n\n……誰の台詞だっけな、それ？","体贴对方的行为，\n而是判断对自己有利时才会——[l]\n\n……这是谁来着说过的话？"],["と、風が吹き抜けた。","风，呼啸而过。"],["まあいいや。[l]\n理屈で判断するのも好き嫌いで判断するのも、\n別に並列不可の事象じゃないし。","算了无所谓。[l]\n用理性判断和用喜好判断，\n本来就不是非此即彼的事。"],["にしても、[l]\n\n今日は本当に大変疲れた。[l]\nこっちに来てから、今までで一番、目的が定かで無さ過ぎた、\nというか自覚が足りないまま発動したイベントだからか、[l]\n否、先刻の話じゃないが小難しい理屈を捏ねずとも、\n見知らぬ秘密行事に女装で潜入したらばそりゃあ、\n疲弊もしますよ。","即便如此，[l]\n\n今天真的累坏了。[l]\n来这儿之后最没明确目标的一次，\n或者说因为是在没自觉的情况下触发的事件，[l]\n不，就像刚才说的就算不搬弄大道理，\n女装潜入陌生秘密仪式这种事\n当然会精疲力尽啊。"],["あー、何か未だに下半身を中心に変な違和感があるわ……[l]\n女子ってのぁ大変だねえ。","啊…下半身到现在还有种奇怪的违和感……[l]\n当女孩子可真不容易。"],["変な感心の仕方をしながら、\n視線を遠くに向けてみる。","一边用奇怪的方式感慨着，\n一边将视线投向远方。"],["「暗くなってても、とーおくまで視えるなぁ……[l]\nやっぱモニター越しのカメラ映像やＣＧとは違うよな。[l]\nいかに技術が進歩しようと模倣は模倣じゃからのう」","「就算天黑了也能看得很远呢……[l]\n果然和隔着显示器的摄像画面或CG不一样。[l]\n技术再进步模仿终究是模仿啊」"],["そんなアナログ……というかアナクロ大好き発言すると、[l]\n宮さんとか大神にまた可哀相な眼で視られるけどな……","这种复古…或者说反潮流的发言要是说出口，[l]\n又会被宫小姐和大神用怜悯的眼神看了……"],["そして夕暮れという要素が今加味されて、\n一層センチな感情に包まれる僕。[l]\nあの、陰と陽の境界の、白、黄、赤、橙、紫、青、黒、\nスペクトル、グラデーションの遷移の経緯。[l]\n時間量としても刹那的な、\nこの","再加上此刻黄昏的渲染，\n让我愈发陷入多愁善感的情绪。[l]\n那道阴与阳交界处的白、黄、红、橙、紫、蓝、黑，\n光谱渐变推移的轨迹。[l]\n作为时间量也转瞬即逝的，\n这个"],["誰そ","黄昏"],["彼時という時間帯が、\n非常に郷愁を誘うというか、\n子供の頃の記憶が曖昧にすぎる僕でさえ、","时刻，\n总是格外勾起乡愁——\n就连童年记忆模糊不清的我，"],["「――母さんも今頃何してるかなあ。[l]\nこっちからは兎も角、向こうからも電話もよこさねえんだもんな。","「――妈妈现在在做什么呢。[l]\n我这边暂且不论，她那边也从不打电话来啊。」"],["んー、\nま、適当なタイミングでかけてみるかな……」","嗯——\n嘛，找个合适的时机打过去吧……」"],["と思ったりしてしまったりするのであった。[l]\nそしてそうだなあ、明け方はと言えば、何か、\n寝ないで徹夜してもうた！的な勿体ない感のほうが強まって、[l]\n寧ろ残念な印象なんだよなあ。[l]\nあくまでも僕は、だが。","之类的想法时不时冒出来。[l]\n而且说到黎明时分啊，\n总觉得「居然通宵没睡！」这种浪费感更强烈，[l]\n反而留下遗憾的印象呢。[l]\n不过说到底这只是我的感受。"],["夜が、闇が好きなのかなあ。[l]\nよるはみかた……[l]\n？[l]\nそれもどっかで聞いたな。","或许我更喜欢夜晚、喜欢黑暗吧。[l]\n黑夜是同伴……[l]\n？[l]\n这话好像也在哪儿听过。"],["……[l]\n@r……[l]\n@r……[l]\n@r――いかん、また変な方向に思考ロックされそうだ。","……[l]\n@r……[l]\n@r……[l]\n@r――不行，思维又要往奇怪的方向卡死了。"],["「ちっと腰下ろそうっと。[l]\nって何か","「稍微坐会儿吧。[l]\n话说回来"],["先","从刚才开始"],["刻から独り言多いな僕ぁ。[l]\nまぁだ","我的自言自语是不是变多了啊。[l]\n该不会"],["昂ってんのかなあ……」","还在亢奋吧……」"],["と、いう訳で。[l]\nちょっと、今日色々で","于是乎。[l]\n因为今天发生了各种事，"],["昂","本想"],["揚した頭を冷やすつもりで、\nわざわざ知狡さんに許可を得て、僕は此処に来たはずなのだが、\n何の因果かどうにもリフレッシュに集中できない。","冷却下发热的脑袋，\n特意获得知狡阿姨许可来到这里的，\n可不知怎的完全无法集中精神放松。"],["「はあー……[l]\n深呼吸でもしよ……[l]\nふーーーー、\nはーーーー。[l]\nふーーーー、\nはーーーー」","「哈啊……[l]\n做做深呼吸吧……[l]\n呼————，\n哈————。[l]\n呼————，\n哈————」"],["……[l]\n@r……[l]\n@r……あとはちゃんと喰って寝よう。[l]\n何だかんだ言って、僕らのしてる仕事は期限付きなのだ。[l]\n体調管理も気をつけないと……","……[l]\n@r……[l]\n@r……之后好好吃饭睡觉吧。[l]\n说到底我们的工作是有期限的。[l]\n必须注意身体状况……"],["「って、あいてててて」","「啊痛痛痛」"],["思ってる","想着"],["傍から肩の方はまだ凝ってるなあもう。[l]\nなんたって、\n式から抜け出して、知狡さんの車が迎えに来るまで――\n……駄洒落じゃないですよ？[l]\nあの格好であるからヒヤヒヤだったし、\n乗り込んだら乗り込んだで運転してたのはチノ嬢だったし、\n事情に関しては察しのいいあの","肩膀这边果然还是僵得厉害。[l]\n毕竟从\n仪式脱身到知狡阿姨的车来接为止――\n……不是双关语哦？[l]\n那副打扮让人提心吊胆，\n上车后发现开车的竟是千乃小姐，\n关于内情因为是那位"],["女","善解人意"],["性の事だから\n深くは追求されなかったけど、","的女性，\n所以她没有深入追问，"],["「詳しく語りたいのでしょうが、\n――ん？[l]\n逆ですか？語りたくない？","「您是想详细说明吧，\n――嗯？[l]\n反了？不想说？"],["まあ、どっちでもいいんです。[l]\nワタシではなく宮店長にお話するが善いでしょう。","嘛，怎样都好。[l]\n比起我，您更该向宫店长汇报。"],["それが最良、ロスの少ない遣り方……[l]\n否、この場合は……どちらにし」","这才是损失最小的最佳方案……[l]\n不，这种情况下……无论哪」"],["「どど、どっちでもいいんですよね？[l]\nええ、あー、\nそ、そうですよね、宮さんにだけ直接語ります。[l]\nまあ、はあ……ははははは」","「反、反正都无所谓对吧？[l]\n啊，那个——\n对、对，我只直接告诉宫小姐。[l]\n嘛，哈……哈哈哈哈」"],["と、例によって変な含みを持った反応をされました。","对方照例给出了意味深长的反应。"],["出来れば知狡さんに来て欲しかったけど、\n何か丁度用事があったそうな。","虽然更希望知狡阿姨能来，\n但听说她正好有事。"],["で、結局当たり障りのない無難な話題を見つけようと\nするも、脳は空転して無意味に唸ってみたり、\n車を降りるときに","结果想找些安全稳妥的话题，\n大脑却空转着发出无意义的呻吟，\n下车时"],["「ああ、\n似合ってますよそれ」","「啊啊、\n那身很适合你哦」"],["と変に上機嫌に視えた気がするチノ嬢に言われるまで、\n……彼女の場合そういう印象が当てになるかどうか[l]\n","直到被莫名显得心情愉悦的千乃小姐这么说道，\n……在她身上这种印象是否可靠[l]\n"],["余","比起"],["所より余計に疑問の余地があるが……[l]\n大変にバツの悪い無言の間が続いたのだった。","其他情况，更添几分疑虑……[l]\n持续着一段极为尴尬的沉默。"],["そしてあの居心地の悪さは只でさえ緊張していた僕の首筋を、\n更に硬化させるに足る状況だったようだ。[l]\n部屋で着替えて人心地ついてみれば、\n肩から何からガッチガチになっていたのだった。[l]\nまあ車中での事は、単なる駄目押しに過ぎない。","而那份不自在似乎足以让本就紧张的我，\n后颈变得更加僵硬。[l]\n在房间换好衣服缓过神来才发现，\n从肩膀到全身都绷得死紧。[l]\n说到底车上的事不过是雪上加霜。"],["大元の原因は、","最根本的原因还是，"],["「……ミヅハノメ───」","「……\t神使八乃舞───」"],["そう、\nあの式を思い返すに――[l]\n\n姫様ちゃんや狩屋が言っていたとは言え、\nやはり吹き替え無しの洋画が如し、\n判る言語ではないために内容自体はあくまで印象としてしか\n憶えていない。","没错，\n回想那场仪式――[l]\n\n虽说是姫様和狩屋他们提及的，\n但就像没字幕的外国电影，\n因为听不懂语言内容本身终究只能作为印象\n残留下来。"],["大体、それも前半のみで、\n後半に至っては……","大体上连这也仅限于前半段，\n至于后半部分……"],["なんだったのか、『あれ』は。","那到底是什么啊，『那个』。"],["そして、『あれ』にかまけて印象薄くなってたが、\n会場に居たあの喋る猫…らしき影と、[l]\n僕の隣りの席に座っていた女子も気になる要素だ。[l]\nどっちとも何か危害を加えられた訳でも無く、\n後者は特に寧ろ友好的とも取れるアプローチ……では\nあったんだが……","而且光顾着纠结『那个』导致印象模糊了，\n会场里那只说话的猫…似的影子，[l]\n还有坐在我邻座的女生也都是令人在意的要素。[l]\n两边倒都没受到什么伤害，\n后者甚至可以说是友善的接触……\n虽然确实如此……"],["察しのいい女子、察しのいい女子──\n……それも何処かで聞いた話だなーおい。[l]\nなんだかなあ……","善解人意的女生、善解人意的女生──\n……这说法也在哪儿听过啊喂。[l]\n真是的……"],["うーん……[l]\nああもう、\n演者である冬夏本人に聴けたらどんなに楽だろう……[l]\nしかし、状況的にそれは厳しすぎる。","唔嗯……[l]\n啊啊真是，\n要是能直接问表演者冬夏本人该多轻松……[l]\n但眼下这状况实在太困难了。"],["少なくとも知狡さんにせよ母さんにせよ、\nあれを通ってきたはずではあるし、\n宮さんもなにげに詳細知ってそうな口振りだったから、\n『あんな事』が『メインのイベント』だとすれば、\n幾ら何でも、事前通達してくれてるはず……[l]\nだと思うんだけどなあ。","至少无论是知狡阿姨还是老妈，\n按理说都该经历过那个，\n宫小姐当时也一副知晓内情的口吻，\n如果『那种事』算是『主要活动』的话，\n再怎么说也该提前通知……[l]\n我本来是这么想的。"],["宮さんだけならまだしも、\n知狡さんが面白がって僕にドッキリ仕掛けるとも思えないし。[l]\nドッキリにしたってあんな……なぁ。[l]\n仕掛け自体無理だよ。","光是宫小姐倒也罢了，\n但知狡阿姨应该不会为了恶作剧故意坑我。[l]\n就算是恶作剧也不至于那么……对吧。[l]\n根本没法人为布置啊。"],["となると、\nやっぱり内容なのか？[l]\nいやでも、感覚で解れと言われるほどに、\n分かり易い暗喩や取っ掛かりがあるでもなく、\nうーん、感得ってかぁ……","这么看来，\n果然问题出在内容上？[l]\n可要说靠直觉领悟，\n既没有明显的隐喻也没有线索，\n唔嗯，靠感悟吗……"],["通過儀礼とか芸能オーディションみたいに、\n点数制ペーパーテストとは違う、\nまるで面接試験でも受けさせられてるみたいだ。[l]\n無理に言えば禅の公案に近いかな……","就像成人礼或演艺选拔那样，\n不同于计分制的笔试，\n简直像是在参加面试考试。[l]\n硬要说的话更接近禅的公案吧……"],["それとも、\nあの式が行われている事の背景を考えるべきか。[l]\n新入生に毎年、部外秘でみせられる謎言語の歌劇……","又或者，\n该考虑那场仪式背后的意义？[l]\n每年给新生秘密展示的谜语歌剧……"],["「……わからん」","「……搞不懂」"],["『あれ』が現実に起こったこととして受け入れても\n良いものかどうか、という問題もある。[l]\nいくら僕が、基本脳空転気味で、最近","还有是否该接受『那个』\n确实发生在现实中的问题。[l]\n就算我这脑子经常转不动弯、最近"],["頓に変なモノを\n視たり聞いたりしてるとは言え、\n──いや、しかし、あれは。[l]\nそれこそ真偽は知れないが、幻視？に関しては大神という先例が\n身近にある訳で、……","突然看到些怪东西\n或是听见怪声虽说如此，\n──不对，但是，那个。[l]\n虽然真伪难辨，但幻视？这方面有大神这个先例\n就在身边……"],["まあ、主観でしか世界を認識できない以上、\n僕が僕の身に『起こった』と『認識した事象』が\n僕にとっての現実だ。[l]\nあの時あの場で、確かに何かがあって、\nそれで……","嘛，既然只能通过主观认识世界，\n在我身上『发生』并被『认知的现象』\n就是我的现实。[l]\n那时那地确实发生了什么，\n所以……"],["堂堂巡りだなあ。","又绕回原点了啊。"],["起きた事に関してはとにかく受け入れる努力をするにしても、\n内容に関しては、\n結局はとにかく感得すべしもの、という事か……[l]\nそうか、そもそも言葉や理屈では説明できんから感得なんだよな。[l]\nそれを言語化しようとしてもそりゃあ、\nそうだよな。","就算努力接受发生的事，\n至于内容，\n终究只能靠直觉领悟是吧……[l]\n也对，本来就没法用语言道理说明才要靠感悟。[l]\n硬要用语言表达的话那当然，\n是这样啊。"],["しかし、姫様ちゃんには何かしら言わねばなるまい。[l]\n当初の状況だったら、\nなるべく無関心を通した方が良かったんだろうが、\n方針が変わりつつある今となっては、\nなるべく情報を引き出せる興味の示し方のがいいんだろうし。","但是，必须得和姫様说点什么才行。[l]\n要是按最初的情况，\n保持尽量不关心的态度可能更好，\n但现在方针正在改变，\n还是用能尽量套出情报的方式表示兴趣比较好吧。"],["にしても、姫様ちゃんの思惑は未だ解らず、\n狩屋も姫様ちゃんに直接話せとか、\nまるで","即便如此，还是搞不清姫様的意图，\n狩屋也说要直接和姫様谈，\n简直就像"],["刻のチノ嬢のような――\n時間軸でいうと逆なんだけど、\n何かそんなんばっかりだなあ。[l]\nまあ仲立ち人に喋った所で仕方ないし、\n間に人が入ると要らぬ齟齬が生じて喧嘩の元だしな……","时刻在线的千乃小姐那样――\n虽然时间轴上是反过来的，\n怎么尽是这种事啊。[l]\n不过就算和中间人说了也没用，\n中间隔着人反而会产生不必要的分歧成为吵架的根源……"],["ああ、制服だのウィッグだのも返さなきゃいかんのだ。[l]\nクリーニングは先刻知狡さんに頼んだから、\nそのうち姫様ちゃん達と連絡とるか。[l]\n今日が水曜だから……まあ、向こうの都合次第だけど[l]\n土日とかだと丁度いいかもだ。","啊，制服和假发也得还回去才行。[l]\n干洗刚才已经拜托知狡阿姨了，\n过段时间再和姫様他们联系吧。[l]\n今天是周三……嘛，虽然要看对方方便，[l]\n周末可能正合适。"],["何かすっかり、\n彼女らと馴染んでしまってる感があるけど、\nいいのかそれで。[l]\n宮さんの方針転換にはそぐうんだろうけど……","总觉得已经完全\n和她们混熟了呢，\n这样真的好吗。[l]\n虽然符合宫小姐改变的方针啦……"],["兎に角、今回起こった事は何とか自分の中で整理して、\n宮さんに報告だけはしておく事にしよう。[l]\n───そう、報告な……[l]\n経緯はどうあれ、\n僕のしてる事は","总之得先把这次发生的事在自己心里整理好，\n至少要向宫小姐汇报一下。[l]\n───没错，是汇报啊……[l]\n不管过程如何，\n我现在做的事"],["殆ど","几乎"],["間","就"],["諜のような\nもんなんだよな。[l]\n冬夏にも姫様ちゃんにも、\n……後ろめたい気分は","跟间谍\n没两样啊。[l]\n对冬夏也好对姫様也好，\n……这种心虚的感觉"],["拭えないなあ……","始终挥之不去……"],["だって、\n今しがた思ったように、\n彼女らとは、\nすっかり馴染んでしまっている、\n少なくとも僕はそう感じているのだ。[l]\nもはやすれ違っただけとかそういうレヴェルじゃないのだ。","因为，\n就像刚才想到的那样，\n和她们之间\n已经完全打成一片了，\n至少我是这么觉得的。[l]\n早就不是擦肩而过那种程度的关系了。"],["会話したり食事したり、……まあ多少の物理的接触もあり、[l]\nつまりは、\n赤の他人ではなくなってしまった。[l]\n少しでも関わり持ってしまったら、\n感情移入もせざるを得ないだろうよ。","聊天吃饭、……呃偶尔也有些肢体接触，[l]\n也就是说，\n已经不再是陌生人的关系了。[l]\n只要产生一丝瓜葛，\n就难免会投入感情吧。"],["まあ、そうねえ、\n僕と宮さんが、彼女に全てを","呃，这个嘛，\n我和宫小姐，"],["奉げられるような関係性だったらば\n気も楽っていうか、迷いも生じないんだろうけど。[l]\n幸か不幸か、僕と宮さんは、\n雇用者と被雇用者みたいなものだからね！[l]\nご主人様と執事とかまでには流石になってねぇと思うけど……[l]\n流され型巻き込まれ型主人公かぁ……少しは自主性もって行動したいのう。[l]\nてか、雇用被雇用の関係の方が、\n私情を挟む余地ないだろう、僕。","要是能处于那种能为她奉献一切的关系就好了，\n这样或许会更轻松吧，也不会产生迷惘。[l]\n不知是幸运还是不幸，我和宫小姐\n基本就是雇主和雇员的关系啦！[l]\n虽然应该还不至于发展到主人和执事的程度……[l]\n随波逐流型被动卷入型主角吗……真想多少有点自主行动力啊。[l]\n话说回来，雇主和雇员的关系\n反而没机会掺杂私情吧，我。"],["──いかんいかん、脳空転が深刻になってきたもよう。","──不妙不妙，脑子空转的情况好像越来越严重了。"],["とにかく夜には宮さんと話す。[l]\nそうする。[l]\n気分転換に此処に来たんだってばだから。[l]\n意識しないとリラックスも出来ないって……","总之晚上要和宫小姐谈谈。[l]\n就这么办。[l]\n都说了我是来这儿转换心情的。[l]\n不刻意放松反而没法放松啊……"],["「……痛てて」","「……痛痛痛」"],["今度は眼が痛い。[l]\n最近の不思議状況と関連性があるのかと心配になる。[l]\n診療所で点滴を打った直後だってのに喋る猫を視たり、\n今日の極めつけの『あれ』であったり、\n本家の地下、三春の蔵からこっち、\nどうにも、\n視える謎存在はどんどん具象化してきている。[l]\n例えば選ばれた人間でありたいという隠れた願望が、\n錯覚や勘違いを補強しているのとは訳が違う――と思う。","这次是眼睛疼。[l]\n忍不住担心是不是和最近的异常状况有关。[l]\n明明刚在诊所打完点滴就看到会说话的猫\n今天还遇到最离谱的『那个』\n从本家地下室、三春的仓库过来这边\n总觉得\n能看见的谜之存在正逐渐实体化。[l]\n和那种『希望成为天选之人』的潜在愿望\n强化错觉或误判的情况完全不同――我是这么想的。"],["特に体育館でも再び見掛けた……同一存在と僕が思い込んでる[l]\nだけかもしれないが……あの喋る猫に関しては、[l]\n『喋った』のは気のせいかも知れずとも、\n虚でなく、確実に実を伴った存在だ。[l]\n抜け出る時は余裕無かったし確認できなかったが\nでもそう、宮さんからは今度見かけても近づかない方が良いと\n釘を刺されてたっけ。","尤其在体育馆又见到……我认为是同一个存在[l]\n虽然可能只是我这么觉得……关于那只说话的猫[l]\n就算『说话』可能是错觉\n但确实是具有实体的存在。[l]\n逃出来时太匆忙没能确认\n不过宫小姐确实叮嘱过下次见到也不要靠近\n被严厉警告了呢。"],["そうだなあ、\n視える視えないの件は、やっぱり大神にも相談してみるか。[l]\nこっち来てから電話もしてないし。","是啊\n关于看得见看不见的问题，果然还是该找大神商量下。[l]\n来这儿之后还没给他打过电话。"],["にしても、\n何だ、猫って。","话说回来\n为什么是猫啊。"],["何故に僕の認識能は、視えるそれらを猫だと捉えるんだろう。[l]\nうーん、宮さんの印象が……刷り込まれてるのかなあ。[l]\n猫だしなぁあのひとは。[l]\nいやいや、そんな曖昧な根拠だけで。[l]\nそんな多大な影響力を宮さんが持って……るのかなあ。[l]\nいやだなあ。","为什么我的认知能力会把看见的那些认定为猫呢。[l]\n唔～可能是被宫小姐的印象……潜移默化了？[l]\n毕竟那个人就像猫一样。[l]\n不不，仅凭这么模糊的依据[l]\n宫小姐居然有这么大的影响力……吗？[l]\n真讨厌啊。"],["まあこっち来た時に知狡さんも、玄ノ森は猫がどうとか――\n早くもうろ覚えだけど。[l]\n公園で読んだ詩集にもなんかそう、やたら猫が題材に――\nそういった地道なイメージの刷り込みが……","说起来刚到这儿时知狡阿姨也提过玄之森和猫有关――\n虽然早就记不清了。[l]\n在公园看的诗集里也频繁出现猫题材――\n这种潜移默化的印象灌输……"],["「ってえなぁって……いででででで」","「想这么多干嘛……疼疼疼疼疼」"],["――今度こそ、ゴミでも入ったか？[l]\nこんな良い風吹いてるとは言え、\n嵐の後だからな。[l]\n葉っぱだのなんだの塵やらが――","――这次该不会是进沙子了？[l]\n虽说现在吹着舒服的风\n毕竟刚过暴风雨。[l]\n树叶啊灰尘啊什么的――"],["――。","――。"],["ん。[l]\n背筋首筋の毛が逆立つ感じ……","嗯。[l]\n后颈汗毛倒竖的感觉……"],["あ、こ、れは。","啊，这，是。"],["「……あ！」","「……啊！」"],["急に覚醒したときのような、\n記憶の回路が繋がり活性化したときのような、\n疑問の氷解、忘れていた物を思い出したときの\nあの、\n声を上げたくなる感触。[l]\nカタルシス、\n欲求の充足。[l]\nそれが何故今此処でなのか、\nというと、","就像突然觉醒时\n记忆回路接通激活的瞬间\n疑惑冰释、想起遗忘之物时\n那种\n令人想要喊出声的感触。[l]\n宣泄、\n欲望的满足。[l]\n要说为什么此刻在此地\n产生这种感觉、"],["「――懐か、しい……のか？」","「――是怀、念……吗？」"],["この景色は懐かしい。[l]\n懐かしいと言うことは懐古であり、\n回顧すべき過去が在ったという事だ。","这景色令人怀念。[l]\n说怀念就意味着怀旧，\n说明存在值得回顾的过去。"],["そうだ。[l]\n僕は此処を、この景色を知ってる。","没错。[l]\n我知道这里，认得这景色。"],["眼前のこの世界を構成している要素要素が、\n記憶を刺激している。","构成眼前世界的每个要素，\n都在刺激着我的记忆。"],["最初の","最初的"],["機、\nファーストインパクト、\n黄昏の屋上はやっぱり此処、だったのだろうか。","契机、\n第一次冲击、\n黄昏的屋顶果然就是这里吗。"],["今までの","迄今为止的"],["懊","烦"],["悩が、\n眼前の新たな問題？と摩り替わって","恼，\n已被眼前的新问题？所替换"],["摩","磨"],["滅した。[l]\nそれが良い事なのか悪い事なのか、","灭了。[l]\n不知这是好事还是坏事，"],["「あれは海に……[l]\nそして花火？","「那是海……[l]\n还有烟花？"],["いや、祭り、遊び、海、山、二個下の女の子、\n猫、親戚中の人間が其処に……","不对，是祭典、玩耍、大海、山峦、小两岁的女孩、\n猫咪、所有亲戚都在那里……"],["……なんだ？[l]\n何の記憶だ？","……什么？[l]\n这是何时的记忆？"],["イグ？[l]\nイグシマ……それは、」","Ig？[l]\n伊古希马……那是，」"],["幼少期に関しては全く以て曖昧だった僕の脳の蔵が、\n","关于幼年期完全暧昧不清的我的记忆仓库，\n"],["漸く、少しだけ開きかけたのか、\nいや、どうだろう、僕の場合、記憶の混濁は元より、\n思い込みによる","终于稍微打开了一点，\n不，或许吧，我的记忆本就混乱，\n再加上主观臆测的"],["改","篡"],["竄や改変は既に経験済みだし、\nテレビか本かの情報の","改和扭曲已是常态，\n电视或书籍信息的"],["残","残"],["滓が混じり合った可能性は\n否めない。","渣混杂其中的可能性\n无法否认。"],["が、\nそれにしても、\n記憶違いやデ・ジャビュにしてはあまりに鮮烈な印象が……","但\n即便如此，\n作为记忆偏差或既视感又未免太过鲜明……"],["「まあ……[l]\n小さいときぁ此処にいたんだから、\n景色に見覚えあったって別段","「也罢……[l]\n小时候确实在这里住过，\n即便觉得这景色似曾相识，也并非"],["怪","什么"],["訝しな\n事じゃないんだけど――","值得\n大惊小怪的事――"],["女子、猫、海……は、なんだ？」","但女孩、猫咪、海……是什么？」"],["この辺りはリアス式海岸で、\n海岸線ぎりぎりまで山地になっているところも珍しくないが、\n玄ノ森に関していえば完全に内陸で、\n海岸に出るには少し時間を要する。[l]\n当然家族か親戚と行ったんだろうが、\n女子ってなんだ？","这一带虽是里亚斯型海岸，\n海岸线紧挨山地的情况也不罕见，\n但玄之森完全位于内陆，\n去海边需要花些时间。[l]\n应该是和亲戚家人同去的，\n可女孩是怎么回事？"],["「あぁ……！[l]\nそれがきぃなの――か？[l]\n二個下……」","「啊……！[l]\n难道那是小贵――吗？[l]\n低两届……」"],["条件で言えば冬夏もそうだけど、\nきぃの自己申告もあるし、\n冬夏と会ったときも完全に初対面のやりとりだもんなあ。[l]\n三春家の人間だし、玄ノ森在住だったのは間違いないから、\n可能性として逢ってないとは言い切れない上、\nちっさい時だからお互い憶えはないかも知れないのだが……[l]\nそこまで考えを及ばしてたら切りがない。[l]\nそれこそ条件に当てはまる女子はごまんと居る事になってしまう。","按条件冬夏也符合，\n但小贵自己说过，\n而且和冬夏初见时完全是陌生人的反应。[l]\n虽说是三春家的人，确实在玄之森住过，\n不能断言没见过面，\n可能因为年纪太小彼此都不记得了……[l]\n再想下去就没完没了。[l]\n符合条件的女孩简直多如牛毛。"],["だが、\nそうだとしても、\n何かが引っ掛かる――","可是\n即便如此，\n总觉得有什么梗在心头――"],["ざわざわしたモノが拭い去れない。[l]\n落ち着かない。[l]\n","无法拭去那份躁动不安的感觉。[l]\n静不下心来。[l]\n"],["喉に骨がつかえたような、\n気持ちが悪いというか据わりが悪いというか、","就像有根鱼骨卡在喉咙里，\n说是恶心又不太准确，更像是如鲠在喉，"],["とは言え、\nちょっと一生懸命に、思い出さないと、\n只でさえすっぽり抜けた幼少期の記憶は、\n空転気味の僕のアタマではなかなか……","话虽如此，\n不拼命去回想的话，\n本就支离破碎的童年记忆，\n在我这空转的脑瓜里实在难以……"],["あぁ――[l]\n@r首が熱い。[l]\n――耳鳴りもしてきた。[l]\n……静か過ぎるのかなあ。","啊――[l]\n@r脖子好烫。[l]\n――连耳鸣都开始了。[l]\n……可能是太安静了吧。"],["「海、猫、\nそうか……砂、砂浜――","「海、猫、\n对了……沙、沙滩――"],["堤防だ。[l]\n夕暮れに堤防の、\nある、すなはま、\n波の音がした、","是防波堤。[l]\n黄昏时分的防波堤上，\n某处、沙滩、\n有海浪的声音、"],["や、くそ――\nく……[l]\nしろのしろ、","靠、该死――\n呜……[l]\n白之白、"],["――？[l]\n白の城？」","――？[l]\n白之城？」"],["と、\n迷走気味に想起し続けるキィワードとは無関係に、\n唐突に映像が浮かんだ。","就在\n与这些走马灯般的关键词毫无关联之际，\n画面突然浮现。"],["それは、[l]\n@r小さい僕が、\n誰かと海辺の砂浜に。","那是，[l]\n@r幼小的我，\n和某人在海边沙滩上。"],["セピア写真じゃないはずなのに、\nきっと今と同じような夕暮れだったのか、\n全体が","明明不该是泛黄老照片，\n但想必和现在同样的黄昏吧，\n整个"],["橙の色彩で、\n逆光、ハイコントラストの陰、\n彩度はあるが色調が均一で、髪の色も何も――\nそこには――\nさらに別の、だれかが、\n猫のような少女が、","浸染着橙红色，\n逆光、高对比度的阴影，\n色彩饱和却色调单一，连发色都看不清――\n那里还有――\n另一个、某人，\n猫一般的少女，"],["は？","哈？"],["なんだって――[l]\n@r……宮さ、ん？[l]\n@rそ…んな莫迦な。","怎么会――[l]\n@r……宫、小姐？[l]\n@r开…什么玩笑。"],["「…いかん。[l]\n過去映像を侵蝕されるほどとは……","「…不行。[l]\n连记忆影像都被侵蚀到这种程度……"],["いくら振り回されっ放しとは言え\nそこまで刷り込まれた自覚は無いんだけどな……[l]\nあーもうこれじゃあまるで――」","虽说一直被耍得团团转\n但也不至于被洗脑成这样啊……[l]\n啊—这样下去简直就像——」"],["………。[l]\n@r………。[l]\n@rいやぁ。[l]\nいやいやいやいや。","………。[l]\n@r………。[l]\n@r哎呀。[l]\n不不不不。"],["「よし、やめやめ！！[l]\n気分転換終了！[l]\n戻ります！！」","「好了，打住打住！！[l]\n转换心情结束！[l]\n我要回去了！！」"],["もう暗くなってきたしな！","天都快黑了！"],["「なんだかなぁまったくどうかしてる……","「真是的完全不对劲啊……"],["って独り言言ってるこの有様はまるっきり\nどんどんドツボにはまってる気がするってもう\n言葉遣いも怪訝しくなってきてあああ、","会这样自言自语的状态根本就是\n感觉越来越深陷泥潭了连\n说话方式都变得诡异起来啊啊啊，"],["全くあのひとにどんだけ心動かされてるんだっつー……\nの？[l]\n――まて、」","到底被那个人动摇到什么程度啊我说……\n的？[l]\n――等等，」"],["変じゃないのか。[l]\nいや、\nあのひとの刷り込みの話じゃなく、","这不奇怪吗。[l]\n不对，\n不是指那个人的洗脑，"],["「別段矛盾は無い、の、か？[l]\nまてよ……そんな事が、だって、」","「并没有什么矛盾之处，对吧？[l]\n等等……这种事情，怎么可能，」"],["じりりりりぃん！[l]\nじりりりりぃん！[l]\nじりりりりぃん！","滋滋滋滋滋！[l]\n滋滋滋滋滋！[l]\n滋滋滋滋滋！"],["「おあ！！」","「哇啊！！」"],["いきなり携帯電話が鳴動した。","手机突然响了起来。"],["び、","吓、"],["吃","吃"],["驚させんなよ。[l]\n誰？[l]\nまさか、ここでこのタイミングの良さは……","别吓人啊。[l]\n谁啊？[l]\n该不会，这时候打来也太巧了吧……"],["「あれ？[l]\n違った、これは――」","「咦？[l]\n不对，这是――」"],["こないだ衣装の借用時に聞いた、\n狩屋の番号だった。","之前借服装时听到的，\n是狩屋的号码。"],["なんで","为什么"],["彼","那"],["奴が？[l]\n今すぐ制服返せとかかな……","家伙？[l]\n该不会现在就要我还制服吧……"],["と、とにかく通話、と。","总、总之先接电话。"],["「ぁ、あい？」","「啊，喂？」"],["「うにゃ、兄ぃ？[l]\nコール一回で出ろよなー。[l]\nいま暇？電話だいじょぶにゃか？」","「唔喵，老哥？[l]\n一次就接了啊ー。[l]\n现在有空吗？电话方便喵？」"],["「あ？[l]\nえ、ああ、\nだいじょぶだ……[l]\nあんだいきなりお前こそ」","「哈？[l]\n呃，啊，\n方便是方便……[l]\n你突然打来才是」"],["「あー、\nそのにゃんだ。[l]\nきーちゃのことも…あるんにゃけど……","「啊ー，\n是这样的喵。[l]\n小姬的事…也算有点关系喵……"],["あれだ。[l]\n後片付け手伝え。暇にゃんにゃったら」","就是那个。[l]\n来帮忙收拾。有空喵的话」"],["「後片付け？[l]\nなんのだよ。[l]\n主語をハッキリ言え主語を」","「收拾？[l]\n收拾什么啊。[l]\n主语说清楚主语」"],["「察しにゃよそんくらい。[l]\n式の。[l]\nういは裏方大道具みたいなもんっていったにゃろ」","「这都猜不到喵？[l]\n仪式的。[l]\n咱不是说过咱就像幕后大道具喵」"],["「あ？[l]\n舞台セット解体とかってことか？[l]\n今暇何も、もう暗くなってきてるじゃないかよ。","「哈？[l]\n拆舞台布景之类的？[l]\n现在天都黑了还谈什么有空没空。"],["ってお前、\nそもそもそんなに簡単に部外者がどうこうしても良いのかいな」","话说你，\n外人随便插手这种事真的没问题吗」"],["もしそうなら、\nあの苦労は何だったんだって話です。","要是可以的话，\n之前的辛苦算什么啊。"],["「んにゃ、片付けは明日にゃって、あ・し・た。[l]\n暇かどうかきいたんは、\nいま電話対応できるか？っていう確認にゃろが」","「不是喵，收拾是明天喵，明・天。[l]\n问有没有空是，\n确认现在能不能接电话喵」"],["いやいやいや、\nわかんねえだろ、先刻の話しぶりからは。[l]\n明日だ、っていう要素が大体にして初出だろう。[l]\n主語も順序もわやくちゃですがな。[l]\nどっかの誰かじゃあるまいし……","不不不，\n这谁能懂啊，从刚才的说话方式。[l]\n明天，这个要素明明是第一次提到。[l]\n主语和顺序都乱七八糟的。[l]\n又不是什么路人甲……"],["「まー部外者に関してはにゃな、\n平日にゃけど明日は学校休み。[l]\n式の振替休日……みたいなもん。","「嘛外人这方面倒是喵，\n虽然是工作日但明天学校放假。[l]\n仪式的调休……类似这种。"],["新入生にとっての、初日からワンクッション的に\n配置される休日にゃのさ」","给新生第一天之后缓冲用的\n安排的休息日喵」"],["「へえ、成る程ね……[l]\n金曜行ったらすぐ土日連休てことになるのか？[l]\n今時の","「嘿，原来如此……[l]\n周五上完课直接接周末连休？[l]\n现在的"],["若","年"],["人は恵まれてんなぁ……」","轻人真幸福啊……」"],["「……話、続けるかんにぇ。","「……继续说话喵。"],["えーとにゃな、\n基本、段ボール＆再利用不可の木材とかのでっかいゴミ投げだけにゃし、","那个喵啊、\n基本上只有纸箱＆不可回收木材之类的大件垃圾要扔喵、"],["捨て場も校舎からはちーと離れてるから誰かに視られるとかは心配すんにゃ。[l]\nとにかく、うい一人の当番、ってか係なわけ」","而且垃圾场离校舍有段距离所以不用担心被人看到喵。[l]\n总之就是轮到我一个人当值、或者说负责啦」"],["狩屋一人しか裏方居ないっての？[l]\nいくら小さな学校ったって半分は男子だろうになあ。","狩屋家就你一个后勤人员？[l]\n再小的学校也该有一半是男生吧。"],["それとも","还是说"],["此","来"],["奴、\n校内一の腕力系ですか。[l]\nう、考えられなくはないという事自体が怖い。","那家伙、\n是校内腕力第一的主儿？[l]\n呜、光是能想到这种可能性就够吓人的。"],["「はぁーん……力仕事に女子ひとりねぇ……[l]\n周りが薄情なのかお前が信頼されてるが故なのか\nよく解らんけど……」","「哈啊……让女生独自干体力活呢……[l]\n到底是周围人太薄情还是你太值得信赖\n实在搞不懂……」"],["「","「"],["已むに","实在是"],["已まれぬ事情があるんにゃこれが……」","有不得不这么做的苦衷喵……」"],["狩屋の説明によれば、\n一応あの式、『神使八乃舞』は伝統の神事という事で、\n使い回すものは別として、破棄される諸々は、\n何か儀礼的に廃棄処理するのだそうだ。","据狩屋解释、\n那个『神使八乃舞』好歹算是传统神事、\n可重复使用的物品另当别论、需要废弃的各类物件、\n都要按某种仪式规程来处理。"],["で、三春の管轄地にそういう式場があるそうな。[l]\nやはり例の祭とリンクしてるだけあって、\n普通の学校行事とは扱いが一線を画しているのか。","而三春家管辖地就有这类仪式场地。[l]\n果然和那个祭典有关联、\n和普通学校活动规格就是不一样吧。"],["いずれ玄ノ森の古くからの実力者たる三春家が\nその辺も仕切ってるって事のようだ。","看来作为玄之森老牌势力的三春家\n把这类事务也都包揽了。"],["「まーいつもだったらういの家とかきーちゃん家とか、\n卑尊さんとこから人手出るんけどにょう、\n今回はその……","「嘛平时的话我家或小姬家、\n还有卑尊医生那边都会派人手喵、\n但这次那个……"],["色々立て込んでてぇ――\nああそそ、ういが丁度在学中にゃったからな。","各家都忙得团团转啦――\n啊对了、正好我还在上学喵。"],["優等生としては自らその責を負うのは当然――\nえ？冬夏ちゃ？[l]\n三春の家の者がそんな雑務はしないよ……」","作为优等生主动承担责任是理所当然――\n诶？冬夏酱？[l]\n三春家的人不会干这种杂务啦……」"],["「だってなあ……[l]\nお前のとこだって大変そうじゃないかよ」","「可是啊……[l]\n你家情况看起来也不轻松吧」"],["「おうあ？","「啊咧？"],["あー、\nいいにゃよういは。[l]\nパパンも居るし……[l]\nだぁら、心配してくれんにゃら手伝えてば」","啊——、\n没关系的喵我啊。[l]\n还有爸爸在……[l]\n所以、不用操心喵愿意帮忙的话就尽管说」"],["「もう毎度の事だけどいきなり言われてもなあ……[l]\n兎に角結局の所は、あれ、\nなんだっけ、『どんと祭』みたいなもんか？","「虽然每次都这样但突然被告知还是有点……[l]\n归根结底还是那个，\n叫啥来着，类似'咚打祭'那种？"],["って、そういや先刻からゴミ投げって言ってるけどお前、\n投げってなんだ」","话说你刚才一直说扔垃圾、\n这个‘扔’到底是怎么个扔法啊」"],["「兄ぃ、昔この辺いたんじゃにゃかったんか？[l]\n方言で捨てるを投げるというんにゃろがっ。[l]\n変に古い行事とかは知ってるくせに……」","「老哥以前没在这边待过喵？[l]\n方言里把丢弃说成扔啦喵。[l]\n明明对古老仪式之类倒是很了解……」"],["「ああ……うっすら聞いたような聞いてないような……[l]\n大学で同期生にそういう方言がどうとか……","「啊……模模糊糊有点印象……[l]\n大学同学好像提过这种方言什么的……"],["いや、それはまあいいんだ。[l]\n――そういや姫様ちゃんは？」","不、这个先放一边。[l]\n――话说姫様呢？"],["一応三春の関係者だし、二人はセットの印象で定着してるんだけど。[l]\n当然在学中だろうから、条件は狩屋と大差ないと思うんだが。","好歹算是三春家相关人士、你俩总是形影不离的印象。[l]\n按理说也该在读、条件和狩屋差不多吧。"],["「あーー……[l]\n来るよ明日。[l]\n一緒に作業する。[l]\n今日の――体育館での片付け分は二人で終わらせたし。","「啊——……[l]\n明天会来。[l]\n一起干活。[l]\n今天体育馆的收拾工作我们已经两个人搞定了。"],["ていうかにゃな、\nまあそのぅ……そもそもこの話、[l]\nきーちゃが、\n言い出し……っぺにゃんだけど」","不过说真的喵、\n其实那个……整件事[l]\n是小姬\n提出来的……喵」"],["何だ、歯切れ悪いな。","怎么、说话吞吞吐吐的。"],["「っさいにゃあ、\nだぁら、手伝えってのはダシ！[l]\nいや、その逆だ！[l]\nあぁあーもうわけわかんにゃ！","「吵死了喵、\n所以说、要帮忙就是个借口！[l]\n不对、正好相反！[l]\n啊啊啊完全搞不懂喵！"],["ういがきーちゃの希望をダシに兄ぃをこき使うって事！[l]\nでいいにゃろ！！[l]\nそぇで納得しろばか！！！」","就是我拿小姬的愿望当借口使唤哥哥干活！[l]\n这样总行了吧！！[l]\n给我接受啊笨蛋！！！」"],["「っさいのはお前だ、\n電話口ででけぇ声出してんじゃないよ！」","「吵的是你、\n别在电话里扯着嗓子喊！」"],["毎度毎度何だっていうんだ","每次都这样到底想怎样"],["奴は。[l]\nなんか知らんがどっちでもええわいこっちは。","那家伙。[l]\n不知为啥反正两边都无所谓啦咱这边。"],["「あ、ご、\nごめ……[l]\n怒んないで……[l]\nお願いだから……」","「啊、对、\n对不起……[l]\n别生气……[l]\n求你了……」"],["あ、あれ？？[l]\nいきなり何か態度が……[l]\n調子狂うなぁ。","啊、咦？？[l]\n突然态度怎么……[l]\n让人摸不着头脑啊。"],["「や、その、……気にするな。[l]\nま、まあだな、\nこっちもどうせ制服返したりしなきゃならないし、\n良いって事よ。","「别、那个、……别在意。[l]\n嘛、算是吧、\n反正咱也得去还制服什么的、\n就这样吧。"],["そのついでに、\n何やら哀れなお前に救いの手を差しのべてやるから\n有り難く思え。","顺便、\n给可怜巴巴的你伸出援手\n要感恩戴德哦。"],["しょうがないなあ克杖ちゃんは。[l]\nがはははははは」","真拿克杖酱没办法呢。[l]\n嘎哈哈哈哈」"],["「……っさいよばぁか……[l]\nいいよ、もう、来てくれるんなら。[l]\nありがと」","「……吵死了傻样……[l]\n好啦、只要你能来。[l]\n谢谢」"],["いやにしんみりしてる狩屋。","异常消沉的狩屋。"],["そういや、三春の関係者が二人も死んだり――\n表向きはどうか知らないが極めてコロシの線が強いと――\nっていう状況ではあるからな。","说起来、三春家相关者死了两个人――\n表面如何不清楚但极有可能是他杀――\n确实是这种状况呢。"],["狩屋も、怪我で済んだとは言え、母親が……[l]\nん？[l]\nそういえばそれも、事件に関連してるのか？","狩屋虽说只是受伤、但母亲她……[l]\n嗯？[l]\n说起来那个也和事件有关联吗？"],["……いや、そんならもう少し深刻な態度でいたと思うのは\n僕が古い頭なのか、はたまた世間知らずなのか。","……不、要是那样的话态度应该更严肃些\n是我想法太老派、还是不懂人情世故呢。"],["まあ、姫様ちゃんにしろ冬夏にしろ、\n身内が（それも恐らくは不自然に）亡くなったにしては、\nあまりに普通の振る舞いをしてるとは感じる。[l]\n言われなければ判らない程だ。","不过、无论是姫様还是冬夏、\n对于家人（很可能还是非正常）去世的情况、\n表现得未免太普通了。[l]\n不说根本看不出来程度。"],["まさか『そんなこと』は日常茶飯事――","总不至于『那种事』是家常便饭――"],["という事でもなかろうし、\n親戚家族が亡くなったからと言って、\n泣き伏せっていなければならぬという決まりがあるでもないが、\n――冬夏はともかく姫様ちゃんは常態がよう判らぬからのう…","倒也不至于、\n虽说没有亲戚去世就必须\n哭得死去活来的规矩、\n――冬夏另说但姫様平时就让人摸不透啊…"],["卑尊さんは医者でもあるし、\n多少死にはドライなのかも知れないけど、\n宮さんらから聞いてる三春の家の印象からして、","卑尊医生毕竟是做这行的、\n可能对死亡比较冷静、\n但从宫小姐那里听到的三春家印象来看、"],["どうしてもヒトの死に対して冷酷に処理してるというか、\n二の次にされてる感があるんだよな……","总觉得他们对人命处理得过于冷酷、\n有种被当作次要事项的感觉……"],["ま、","嘛，"],["何れにしても、\nそういう物騒な近況だ、\n狩屋も多少は弱気になってんのかもな。","无论如何、\n眼下是这么危险的状况、\n狩屋会有点消沉也正常吧。"],["それか……姫様ちゃんの要望を満たせた事への安堵の顕れか。[l]\n相変わらず複雑だなあ……","或者说……是满足了姫様要求的安心表现？[l]\n还是一如既往复杂啊……"],["「そ、そのかわり行くだけだぞ、出来るのは。[l]\n労働力として期待はすんなよ、\n僕ぁこれでも文人だからな……」","「先、先说好只是去而已、能做的就这些。[l]\n别指望我当劳动力、\n好歹咱也算读书人呐……」"],["「兄ぃ、大事なこと忘れてないか？[l]\nいくらきーちゃがその……[l]\nいあそのな、何の理由もなく兄ぃを喚ぶと思うか？","「老哥，重要的事没忘吧？[l]\n不管小姬她……[l]\n啊不是啦，你觉得我会无缘无故叫老哥来吗？"],["制服返すのは当たり前として、\nその制服を貸した目的があるだろが。[l]\n今日の『あれ』に喚んだそもそもがにゃな……","还制服是理所当然的，\n但借你制服是有目的的吧。[l]\n今天叫你来参加『那个』的根本原因是……"],["きーちゃは兄ぃが当然、今日の色々で話す事があると\nおもってるんにゃから。[l]\n……選の字にも聞いたしういにはさっぱりにゃけど……」","小姬觉得老哥肯定会对今天的各种事\n有话要说啦。[l]\n……选律姐那边也问过了但完全搞不懂……」"],["こいつすぐいつもの調子に戻りやがって……[l]\nにしても、\n姫様ちゃんが僕の感得の","这家伙马上又变回平常那副德行了……[l]\n不过话说回来，\n姫様是想打听"],["如","我的"],["何を訊きたがってる、\nて事か。","感受如何，\n之类的东西吧。"],["初めから姫様ちゃんは、\n僕があの式を目指してこの地に来たかのような口調でいたし、\nそれに乗っかって潜入はしたものの――","从一开始姫様就用\n好像我是专程为那个仪式来这儿的语气说话，\n虽然顺势潜入是成功了――"],["先刻まで考えていたとおり、\n不思議体験が起こりこそすれ、感得すべきものが何なのか、\n","但就像刚才一直在想的，\n怪事确实发生了，可该感知到什么，\n"],["寧ろこっちが『あれ』がなんだったのか\n訊きたいくらいだ。","倒不如说我这头更想问问\n『那个』到底是什么。"],["そういう意味で確かに彼女等と話はしたいのだが、\n――ん？[l]\nセンノジってなんだ？[l]\nそういやあの時センリツさんがどうしたこうしたって、","从这个角度确实想和她们聊聊，\n――嗯？[l]\n选律是啥？[l]\n说起来那时候好像说了选律姐什么什么的，"],["「んあ？[l]\nにゃにした？[l]\nもしもーし？？[l]\nあれ、きれたかにゃ？」","「啊？[l]\n说啥了？[l]\n喂喂——？？[l]\n咦，断线了吗？」"],["「あ、ああ、聞こえてる、悪い悪い。[l]\nそ、それとだな、わわ、忘れてたわけじゃないっての。[l]\n人間会話をしながらじゃ、論理的且つ効率的な\n話の組み立てなどそうそう簡単には…","「啊、啊啊，听得见，抱歉抱歉。[l]\n还、还有啊，我我我才没忘记呢。[l]\n一边进行人类对话一边要组织逻辑严密\n且高效的话题哪有这么容易…"],["ていうか、\nお前が今日僕を早々に追い返したようなもんだろ。[l]\nだから何の会話も……","话说，\n你今天不是早早把我赶走了嘛。[l]\n所以根本没机会……"],["――ははぁ、そんで怒られたか。[l]\nで、こうやって改めて約束取り付けるように\n言われたってとこだな」","――哈啊，所以就挨骂了是吧。[l]\n然后像这样被要求\n重新约定时间对吧」"],["……こういう事を喋ってると、[l]\nまるで姫様ちゃんが僕にぞっこん（死語）だという前提で、\nしかもそれを自覚してるみたいじゃんな。","……说这种话的时候，[l]\n简直像默认姫様对我死心塌地（过时用语），\n而且还自觉意识到这点的样子呢。"],["――馬鹿か僕は。[l]\n自意識過剰自重……","――我傻了吧。[l]\n自我意识过剩给我收敛点……"],["「フハッ」","「噗哈」"],["なんだそのリアクション。[l]\n呆れの溜息なんだか","这什么反应啊。[l]\n不知是无奈的叹息"],["咽せたんだか、\n鼻から抜けたような謎の吐息を漏らす狩屋。","还是被呛到，\n狩屋漏出谜一般的像是从鼻腔挤出来的吐息。"],["「あーあ、\nにゃんでだろうな……ういも……のに………とは」","「唉——\n为什么呢……我也……可是……话说」"],["「？」","「？」"],["「ま、それは置いといて。[l]\nで、その場所、人目につかにゃいのはいいんにゃがなー、\nほれ、最近この辺物騒にゃんだ。[l]\n兄ぃもちろん自動車免許持ってるにょあ？」","「嘛，这个先放一边。[l]\n所以那个地方，虽然不容易被人发现是不错啦，\n喏，最近这带不太平嘛。[l]\n老哥当然有汽车驾照吧？」"],["「ああ、そらマニュアル持ってるけど」","「啊，手动挡的倒是有的」"],["「きーちゃの話し相手だけじゃすまさにゃいじぇ。[l]\n腕力に期待してない分ドライバーとして\nきりきり働いて貰うかんな」","「光当小姬的聊天对象可不够看。[l]\n既然不指望你出力\n就给我拼命当好司机吧」"],["「今更ながらお前のその物言いはどうかと思うが、\nまあ良いさ。[l]\n物騒なのは本当……のようだからな」","「事到如今你这种说话方式很有问题，\n不过算了。[l]\n不太平倒是真的……看样子」"],["其処がどんな場所かは知らないが、\nこの地で人死にがあったのは確かな訳だし。[l]\n宮さん、引いては知狡さんの言に依れば、\n人為的と思しき、だ。","虽然不知道那是个什么地方，\n但在这片土地上确实发生过命案。[l]\n根据宫小姐、乃至知狡阿姨的说法，\n很可能是人为的。"],["しかも狙われたのは挙って三春の眷属か……","而且被盯上的全是三春的眷属……"],["……そんなん、実際何者かに襲われたら、[l]\n僕だって対抗出来るような用意は何もないけど……","……真要遇到那种被什么人袭击的情况，[l]\n我这边也没做任何能对抗的准备就是了……"],["「にゃんかちょくちょく黙り込むにゃあ兄ぃ。[l]\nま、今更厭だっていっても、\n引き受けてくれる前提で担任にも言ったからにゃあ」","「喵的哥你动不动就突然沉默喵。[l]\n嘛，现在才说不乐意也晚了，\n班主任那边可是按你答应为前提通知的喵」"],["駄目ならいくらでも方策はあるんだけど……そういう訳には……","虽然要拒绝也不是没办法……但那样就……"],["と小声で何やら呟く狩屋。","狩屋小声嘀咕着什么。"],["「わかったって」","「知道啦」"],["……あ。","……啊。"],["そういえば、\n今更だけど、\n流れ的に独断で決めてしまったけど、\nいいんだろうか。","说起来，\n现在才意识到，\n顺着气氛就擅自决定了，\n这样真的好吗。"],["宮さんに報告もこれからだし、\n今後の予定どうなるか確認してからが良かったか？","还得事后向宫小姐汇报，\n是不是该先确认后续安排比较妥当？"],["――いや、\nたまには自分の意志というものも発信せんとな！","――不对，\n偶尔也该表达下自己的意志！"],["まあ宮さんに言ってみて駄目と言われたら中止しよ……[l]\nってそれがアカンのじゃないのか。","嘛要是跟宫小姐说了被否决就取消吧……[l]\n这样不就本末倒置了吗。"],["い、いや、\n仕事で来てるから！僕は！！[l]\n雇用主の意向には添わないとね！！[l]\nと言うより今回も単に状況に流されてるだけの気がするが……","不、不行，\n我可是来工作的！！[l]\n必须遵从雇主的意愿！！[l]\n或者说这次感觉又只是被形势推着走……"],["「にゃにブツブツ言ってんにゃよ。[l]\nほんとにゃらういだって別に兄ぃを\nわざわざ喚びたくぁにゃいわ。[l]\nし、しかし、にゃな……」","「喵喵叨叨什么呢喵。[l]\n真要拒绝的话本喵才懒得\n特地来叫你呢喵。[l]\n可、可是喵……」"],["まあ前回の式潜入の","回想上次潜入仪式"],["時","时"],["然り、\n彼女等の内部に食い込むという意味では、\nまっこと順調にフラグが立ってってると言って差し支えないんでは\nなかろうか。","也是，\n从打入她们内部的角度来看，\n可以说flag立得相当顺利\n吧。"],["方式が最早、懐柔策というかそっち方向シフトしつつあるし、\n姫様ちゃんの言動の根拠が謎な事を除けば、\n取り敢えずは今回の事も、調査の一環と成り得る提案だろう。","方式都快变成怀柔策略那种走向了，\n除了姫様酱的言行依据成谜之外，\n这次的事暂时也能作为调查环节的提案吧。"],["「色んな意味で怖いんだろ。[l]\n察してやるよそこは。[l]\nお互い逆らえないヒトが近くに居ると大変だな…」","「各种意义上都很可怕吧。[l]\n这点我很能理解。[l]\n身边有个无法违抗的人真是够呛啊…」"],["或る意味僕と似た者同士と……言えなくも……ないか？[l]\n意志決定機構が己の外側に在りそれに振り回されるという点\nに於いては。[l]\nいや、同病相憐れむにしてもどうだろう互いにそのポジションて。","某种意义上和我算是同类……这么说也……未尝不可？[l]\n意志决定机构存在于自身之外并被其摆布\n这点上。[l]\n不，就算同病相怜，彼此立场也还是微妙啊。"],["「にゃ、にゃんの話にゃよ！」","「喵、喵在说什么喵！」"],["「あ、でもだな、\n僕にもその、そう言うわけで、\n逆らえない上司がいるから。","「啊不过啊，\n我这边也是，那个，同样有\n无法违抗的上司。"],["どうしても駄目な場合は今晩中に連絡する、\nで良いよな。[l]\n","实在不行的话今晚内会联系，\n这样可以吧。[l]\n"],["時まで起きてんだ……って、メールでいいのか。[l]\nお前にで良いんだな？」","你到时会醒着吧……话说发邮件就行？[l]\n你那边没问题吧？」"],["本来、間に人を挟んでアポ取るのは面倒なだけなんだが、\n姫様ちゃんに直通というのも……[l]\n正直まっとうなコミュニケーションを\n成立させる自信は無いなあ……","本来通过中间人预约就很麻烦，\n但直接联系姫様酱又……[l]\n老实说没信心能进行\n正常沟通啊……"],["「そ、そうにゃな。[l]\nういにで。[l]\nんーとにゃな、まー予習とかしてるから、\n１０時から１１時頃までは即時対応できるじぇ」","「是、是这样喵。[l]\n人家的话。[l]\n嗯—喵，因为要预习什么的，\n10点到11点可以即时回复哟」"],["「予習っておまホントかよ、新学期開始早々からすげぇな……[l]\nあー、時間に関してはわかった、なるべくそれまでに連絡するよ。","「预习？你小子认真的？新学期刚开始就这么拼啊……[l]\n啊，时间方面我知道了，尽量在那之前联系你。"],["あと、姫様ちゃんといえばその、\n悪いけど制服はもうクリーニングに\n頼んじまったから、\n返せるのはまた後日になると思うけど。多分だけど」","另外，说到姫様酱那个……\n不好意思制服已经送去\n干洗店了，\n估计要过几天才能还你。大概吧」"],["「あっ…そう。[l]\nまあ、きーちゃにとっては……[l]\n（絡む口実が……増えたってことか……）","「啊…这样。[l]\n嘛，对小姬来说……[l]\n（纠缠的借口……变多了呢……）"],["いあ、にゃんでも。[l]\nわかた。[l]\nいいんじゃにゃいの」","没、没啥。[l]\n知道了。[l]\n不挺好的嘛」"],["「なに？途中がわからんかった。[l]\n悪ぃけど電波遠いみたいで聞こえねぇ」","「啥？中间没听清。[l]\n抱歉好像信号不好听不见」"],["「なんでもない！ばか！[l]\nいーからとっととその上司とやらにお伺いたててこい！[l]\nじゃな！！」","「什么事都没有！笨蛋！[l]\n饭桶赶紧去给你那个上司还是什么的请安吧！[l]\n再见！！」"],["「ま、まて！[l]\n最後に一個だけ」","「等、等等！[l]\n最后再问一个」"],["健忘さんの僕だが、\n一応気がかりだった事を訊いてみる。[l]\n決して今しがた思い出した訳では……否、そうです。","虽然我是健忘症患者，\n姑且还是问问在意的事。[l]\n绝不是刚刚才想起来的……不，就是。"],["「冬夏ちゃ？[l]\nちっと機嫌悪いみたいにゃけど、\nさっきも言ったように三春の者はそもそもこんな雑務しにゃいんだ。","「冬夏酱？[l]\n看起来有点不高兴喵，\n刚才也说过三春家的人本来就不该干这种杂活。"],["だから別に居合わせることはにゃいと思うにぇ。[l]\n――まあ兄ぃには関係にゃいんじゃないの？[l]\nあるんか？」","所以应该不会碰巧在场喵。[l]\n――反正和老哥你没关系吧？[l]\n有关系吗？」"],["「ま、いや別に、念のためだ……[l]\n呼び止めて悪かった、じゃな」","「不，没啥，就确认下……[l]\n叫住你不好意思，再见」"],["ぷつっ。","嘟——"],["はあ……[l]\nさて。","哈啊……[l]\n好了。"],["結局気も休まらないまま、\nまたどんどんと事は起きて――\n見渡せば、もう真っ暗寸前じゃないかよ。","结果根本没休息成，\n事情又一桩接一桩――\n环顾四周，这不都快黑透了吗。"],["「僕ぁ……[l]\nあれかな、そういう体質なのかな。[l]\n大神が言うところのフラグ立ちまくり、\nイベントの連鎖、事を巻き起こす……」","「我该不会是……[l]\n那种体质吧。[l]\n就像大神说的疯狂立flag，\n事件连锁，引发事端……」"],["でも、別に宮さんと逢うまでは、\n平々凡々な日々だったと……[l]\nいや、まあ、幼少期の記憶は殆ど無…い、にしろ――","不过，在和宫小姐相遇之前，\n明明过得平平淡淡……[l]\n不对，虽说童年记忆几乎没…有就是了――"],["「しろのしろをそこに――」","「白中之白在此――」"],["ぼぉーーーーーぼぉーーぼぉーーーー。","嗡————嗡——嗡————"],["突然辺りに、\n鈍い音の音楽が鳴り響いた。","突然周遭响起\n沉闷的音乐声。"],["ああ、\nこの町の緊急警報用のスピーカーか何かから流れる、\n午後六時の音楽だった。[l]\nこっち来てから何回か聴いてたけど、\nこの場所だと結構でかく聴こえるんだな……","啊啊，\n是这个镇子的紧急警报喇叭之类放的\n下午六点报时音乐。[l]\n来这儿之后听过几次，\n在这地方听着特别响……"],["エコーしまくって、途中から下手くそな輪唱みたいに\n音がごっちゃまぜになる。[l]\nその不協和音が、すっかり暗くなった景色と相まって、\n下手なサイレンが流れるよりもずっと焦燥感というか、\n恐怖感を煽る。[l]\n音がそもそもずれてるので大変据わりも悪い。","回声太重，中途变成拙劣的轮唱\n音效全糊在一起。[l]\n这不和谐音配上完全暗下来的景色，\n比随便放个警笛更让人焦躁，\n甚至诱发恐惧。[l]\n音准本来就偏听着特别难受。"],["ぼぉぼぉーーーーーーーーー……………。","嗡嗡——————……………"],["数分なのか数十秒足らずだったのか、\n気持ちの悪い余韻を残して放送は終わった。","不知持续了几分钟还是不到几十秒，\n广播在残留的诡异余韵中结束了。"],["……思わず聴き入っちゃったけども、[l]\nつまりはもう六時な訳だな。[l]\n流石に肌寒くもなってきたし、今度こそ戻るか下に。","……不小心听入神了，[l]\n也就是说已经六点了啊。[l]\n确实有点凉了，这次真该回去了。"],["あれ、","哎呀、"],["刻何か考え事してなかったっけ？[l]\nなんか脳裏に浮かびかけてたような……","刚才是不是在琢磨什么事来着？[l]\n总觉得有什么在脑海里若隐若现……"],["「ま、いいか」","「嘛、算了」"],["空腹で、脳空転はいよいよヤバげだし。[l]\n恐らく思考暴走の","饿得脑子都快宕机了。[l]\n这八成是"],["類だ、ということで手を打とう。","思维暴走，得赶紧控制住。"],["食事して落ち着いたら、\n色々考えねばならない事が山積みだなあ……[l]\n目的はしっかりあるんだが、\n手法がぶれまくってるから結果巻き込まれてる感が増すんだよな。[l]\nそもそもの始まりがそうだから今更なんだが……","吃饱冷静下来后，\n还有堆积如山的事情得考虑啊……[l]\n目标倒是很明确，\n但手段变来变去搞得自己越来越像被卷进去的局外人。[l]\n毕竟从一开始就是这样现在也无可奈何……"],["えーとなんだ、","呃那个啥、"],["まずは今日の式について宮さんに報告、\nしつつ、明日狩屋達の手伝いの誘いについて是非を問う、\nかなあ。[l]\n個人的には他にも、冬夏や貴奴との今後や、\nセンリツさんとやら他の三春家の眷属、\nとどう接するかも考えつつ、","首先得向宫小姐汇报今天的仪式情况，\n顺便问问明天要不要帮狩屋他们干活，\n大概这样吧。[l]\n我个人还想和冬夏、贵奴聊聊今后打算，\n以及怎么应对选律小姐和其他三春家眷属，\n这些都得考虑清楚，"],["喋る猫やらの幻視に関して大神に相談してみたい、\nといった諸項目はあるけど。","还想找大神商量看到会说话的猫之类的幻觉，\n不过这些都是后话。"],["調査自体は、\n宮さんの方向転換を真面目に受け取れば、\n結局祭までは彼女等に親和する事が","调查方面，\n如果认真对待宫小姐转变方向这件事，\n说不定在祭典前和她们搞好关系"],["最","才是最短"],["早最短かも\n知れない訳だが、\nそこも今夜のお伺い次第だ。","最快\n的解决路径，\n不过这也得看今晚拜访的结果。"],["祭の開催自体がどうなるかも冬夏の家次第なんだろうが……[l]\n対になってるという『神使八乃舞』が通常通り施行されたし、\n彼女等の意向としては\nほぼ確定で強引にでも事を進めるようではあるものの、\n依然として人死にの件は進展を見せていない。","虽然祭典能否举办还得看冬夏家族的意思……[l]\n但配套的『神使八乃舞』已经照常举行了，\n看她们的架势\n就算硬来也要推进计划，\n可人命案子的调查还是毫无进展。"],["そっちに関して僕が何か出来るとは思わないし、\nしろと命じられた訳でもなくしようとも思わないが、\n三春家の威光を以てしても看過出来ない何かが要因だとしたら……","我不觉得自己能帮上什么忙，\n也没人命令我去查更没打算插手，\n但如果连三春家的威望都压不住事态的话……"],["祭の開催自体が危ぶまれてしまったならば、\n飯窪本家が言うような、\n多少無茶な実力行使――例えば蔵に忍び込むような――\nを強要されるかも知れないのだ。[l]\n正直それはあまりにも厳しい。[l]\nあくまでも彼女等が自主的に取り出した御神体を、\n『偶然』盗み視るのが言い訳もきくというものだ。……多分。","万一祭典真的办不成，\n可能就得像饭洼本家说的，\n采取些过激手段――比如潜入仓库――\n被迫硬来了。[l]\n说实话那也太难了。[l]\n最好是等她们主动取出神体后，\n再『偶然』偷看到才算有个说法。……大概。"],["そう言えば蔵の中では目的のモノは見つからなかったが、\nあの紙片に関しても宮さんからは、特にあれから何も聞いてない。","话说在仓库里没找到目标物品，\n而且宫小姐后来也没再提过那张纸片的事。"],["あれを返すかどうかとか、\n祭の開催やら極力御神体に近しい人間の懐柔……[l]\nそ、それはあまりにもドライな考えなので\n僕自身は心では違うと思っていたいが……[l]\nいずれ冬夏ともまた逢わねばならないだろう。","要不要还回去啊，\n还有筹办祭典啦尽量拉拢靠近神体的人啦……[l]\n这、这种想法实在太功利了\n虽然我内心并不认同……[l]\n迟早还得再见冬夏一次。"],["貴奴は……[l]\nまあ、飯でも奢るか……安いのを。","至于贵奴……[l]\n嗯，请她吃个饭吧……便宜点的。"],["そういえば首の熱いのは、知らない内に収まってたな。[l]\n狩屋の電話ですっかり意識の外だった。","说起来脖子发烫的感觉不知什么时候消退了。[l]\n被狩屋的电话彻底转移了注意力。"],["屋上の扉を開けて中に入り、施錠して階段を降りる。","打开天台门锁进入室内，锁好门走下楼梯。"],["「しろのしろ……うーん」","「白之白……唔嗯」"],["幼少期の記憶、\nぼんやりとしか思い出せないが故に変に引っ掛かるけど、\nまずは――[l]\n@r飯食おうと思います。","因为童年记忆\n模糊不清反而格外在意，\n不过首先――[l]\n@r先去吃饭吧。"]],"context":[["SC_M_022.ks/index/1/text"],["SC_M_022.ks/index/3/text"],["SC_M_022.ks/index/6/text","SC_M_022.ks/index/650/text"],["SC_M_022.ks/index/8/text","SC_M_022.ks/index/284/text"],["SC_M_022.ks/index/10/text"],["SC_M_022.ks/index/12/text"],["SC_M_022.ks/index/14/text"],["SC_M_022.ks/index/16/text","SC_M_022.ks/index/91/text"],["SC_M_022.ks/index/18/text"],["SC_M_022.ks/index/20/text"],["SC_M_022.ks/index/22/text"],["SC_M_022.ks/index/24/text"],["SC_M_022.ks/index/26/text"],["SC_M_022.ks/index/28/text"],["SC_M_022.ks/index/30/text"],["SC_M_022.ks/index/32/text"],["SC_M_022.ks/index/34/text"],["SC_M_022.ks/index/36/text"],["SC_M_022.ks/index/38/text"],["SC_M_022.ks/index/40/text"],["SC_M_022.ks/index/42/text"],["SC_M_022.ks/index/44/text"],["SC_M_022.ks/index/46/text"],["SC_M_022.ks/index/48/text"],["SC_M_022.ks/index/50/text"],["SC_M_022.ks/index/52/text"],["SC_M_022.ks/index/54/text"],["SC_M_022.ks/index/56/text"],["SC_M_022.ks/index/58/text"],["SC_M_022.ks/index/61/text"],["SC_M_022.ks/index/63/text"],["SC_M_022.ks/index/65/text"],["SC_M_022.ks/index/67/text"],["SC_M_022.ks/index/69/text"],["SC_M_022.ks/index/71/text"],["SC_M_022.ks/index/73/text"],["SC_M_022.ks/index/75/text"],["SC_M_022.ks/index/77/text"],["SC_M_022.ks/index/79/text"],["SC_M_022.ks/index/81/text"],["SC_M_022.ks/index/83/text"],["SC_M_022.ks/index/85/text"],["SC_M_022.ks/index/87/text"],["SC_M_022.ks/index/89/text"],["SC_M_022.ks/index/93/text"],["SC_M_022.ks/index/95/text"],["SC_M_022.ks/index/97/text"],["SC_M_022.ks/index/99/text"],["SC_M_022.ks/index/101/text"],["SC_M_022.ks/index/103/text"],["SC_M_022.ks/index/105/text"],["SC_M_022.ks/index/107/text"],["SC_M_022.ks/index/109/text"],["SC_M_022.ks/index/111/text"],["SC_M_022.ks/index/113/text"],["SC_M_022.ks/index/115/text"],["SC_M_022.ks/index/117/text"],["SC_M_022.ks/index/119/text"],["SC_M_022.ks/index/121/text"],["SC_M_022.ks/index/123/text","SC_M_022.ks/index/216/text","SC_M_022.ks/index/708/text"],["SC_M_022.ks/index/125/text"],["SC_M_022.ks/index/127/text"],["SC_M_022.ks/index/129/text"],["SC_M_022.ks/index/131/text"],["SC_M_022.ks/index/133/text"],["SC_M_022.ks/index/135/text"],["SC_M_022.ks/index/137/text"],["SC_M_022.ks/index/139/text"],["SC_M_022.ks/index/141/text"],["SC_M_022.ks/index/143/text"],["SC_M_022.ks/index/145/text"],["SC_M_022.ks/index/147/text"],["SC_M_022.ks/index/149/text"],["SC_M_022.ks/index/151/text"],["SC_M_022.ks/index/153/text"],["SC_M_022.ks/index/155/text"],["SC_M_022.ks/index/157/text"],["SC_M_022.ks/index/159/text"],["SC_M_022.ks/index/161/text"],["SC_M_022.ks/index/163/text"],["SC_M_022.ks/index/165/text"],["SC_M_022.ks/index/168/text"],["SC_M_022.ks/index/170/text"],["SC_M_022.ks/index/172/text"],["SC_M_022.ks/index/174/text"],["SC_M_022.ks/index/176/text"],["SC_M_022.ks/index/178/text"],["SC_M_022.ks/index/180/text"],["SC_M_022.ks/index/182/text"],["SC_M_022.ks/index/184/text"],["SC_M_022.ks/index/186/text"],["SC_M_022.ks/index/188/text"],["SC_M_022.ks/index/190/text"],["SC_M_022.ks/index/192/text"],["SC_M_022.ks/index/194/text"],["SC_M_022.ks/index/196/text"],["SC_M_022.ks/index/198/text"],["SC_M_022.ks/index/200/text"],["SC_M_022.ks/index/202/text"],["SC_M_022.ks/index/204/text"],["SC_M_022.ks/index/206/text"],["SC_M_022.ks/index/208/text"],["SC_M_022.ks/index/210/text"],["SC_M_022.ks/index/212/text"],["SC_M_022.ks/index/214/text"],["SC_M_022.ks/index/218/text"],["SC_M_022.ks/index/220/text"],["SC_M_022.ks/index/222/text"],["SC_M_022.ks/index/224/text"],["SC_M_022.ks/index/226/text"],["SC_M_022.ks/index/228/text"],["SC_M_022.ks/index/230/text"],["SC_M_022.ks/index/232/text"],["SC_M_022.ks/index/234/text"],["SC_M_022.ks/index/236/text"],["SC_M_022.ks/index/238/text"],["SC_M_022.ks/index/240/text"],["SC_M_022.ks/index/242/text"],["SC_M_022.ks/index/244/text"],["SC_M_022.ks/index/246/text"],["SC_M_022.ks/index/248/text"],["SC_M_022.ks/index/250/text"],["SC_M_022.ks/index/252/text"],["SC_M_022.ks/index/254/text"],["SC_M_022.ks/index/256/text"],["SC_M_022.ks/index/258/text"],["SC_M_022.ks/index/260/text"],["SC_M_022.ks/index/262/text"],["SC_M_022.ks/index/264/text"],["SC_M_022.ks/index/266/text"],["SC_M_022.ks/index/268/text"],["SC_M_022.ks/index/270/text"],["SC_M_022.ks/index/272/text"],["SC_M_022.ks/index/274/text"],["SC_M_022.ks/index/276/text"],["SC_M_022.ks/index/278/text"],["SC_M_022.ks/index/280/text"],["SC_M_022.ks/index/282/text"],["SC_M_022.ks/index/286/text"],["SC_M_022.ks/index/288/text"],["SC_M_022.ks/index/290/text"],["SC_M_022.ks/index/292/text"],["SC_M_022.ks/index/294/text"],["SC_M_022.ks/index/296/text"],["SC_M_022.ks/index/298/text"],["SC_M_022.ks/index/300/text"],["SC_M_022.ks/index/302/text"],["SC_M_022.ks/index/304/text"],["SC