"end":1083}],[{"start":1089,"end":1107}],[{"start":1113,"end":1128}],[{"start":1134,"end":1148}],[{"start":1154,"end":1169}],[{"start":1179,"end":1188}],[{"start":1194,"end":1220}],[{"start":1226,"end":1301}],[{"start":1311,"end":1354}],[{"start":1400,"end":1407}],[{"start":1428,"end":1455}],[{"start":1486,"end":1490}],[{"start":1521,"end":1547}],[{"start":1576,"end":1630}],[{"start":1677,"end":1720}],[{"start":1730,"end":1765}],[{"start":1775,"end":1787}],[{"start":1833,"end":1913}],[{"start":1944,"end":1982}],[{"start":2011,"end":2037}],[{"start":2068,"end":2117}],[{"start":2146,"end":2169}],[{"start":2200,"end":2211}],[{"start":2240,"end":2318}],[{"start":2349,"end":2355}],[{"start":2401,"end":2418}],[{"start":2424,"end":2432}],[{"start":2475,"end":2476}],[{"start":2485,"end":2486},{"start":2585,"end":2586}],[{"start":2495,"end":2496},{"start":2555,"end":2556}],[{"start":2505,"end":2506}],[{"start":2525,"end":2526}],[{"start":2535,"end":2536}],[{"start":2545,"end":2546}],[{"start":2565,"end":2566}],[{"start":2595,"end":2596}],[{"start":2605,"end":2622}],[{"start":2632,"end":2663}],[{"start":2693,"end":2696}],[{"start":2705,"end":2707}],[{"start":2716,"end":2718}],[{"start":2727,"end":2729}],[{"start":2738,"end":2740}],[{"start":2749,"end":2751}],[{"start":2760,"end":2761}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_064.ks","basename":"SC_E_064.ks","indexIds":{"「……まあ、[l]\n家とかに確認するまで、\n放っておこう。[l]\n怖すぎる」":0,"「んー、まあ、\nそれが無難だよね」":1,"後で電話してみるー、と言って、\n冬夏はお風呂の準備をしに行った。":2,"僕はその箱を、\n押し入れの奥へと仕舞い込む。[l]\n流石に捨ててしまうのには気が引けた。":3,"が、":4,"──きっと、[l]\nこのまま、放置することになるだろう。[l]\nそんな気がする。":5,"真神の御陰で、\n前から書籍には通じてたとしても、[l]\n加えて僕もそっち系のＤＶＤやらフィギュアだの、\n買うようになった。[l]\n宅配の人と馴染みになったのも結局それも大きいのだが、\nそうしてると、たまに古い、\nオタ的視点では観てなかったアニメだの、\n今になってＢＯＸで出るのにも、\n手を出したりはする、":6,"するけど、":7,"記憶の美化による修正、[l]\nそれが虚飾だったと気付くのが、幻滅するのが、[l]\n怖くて、[l]\n結局部屋の棚に並べるだけで満足するが多くなった。":8,"箱は開けずとも、[l]\n所持してる事で僕の心は満たされると言うか、[l]\n蒐集者の業とでも言おうか、[l]\n中に何が入ってるか、[l]\nというよりは、[l]\n":9,"目":10,"録を埋めるという感覚こそが大事なのだ。":11,"閉じた箱をわざわざ開けて、[l]\n自分から辛い思いをするなんて、[l]\nそんな選択は怖くて出来ない。":12,"箱の中の●が生きてるのか死んでるのか、":13,"箱を開けようとするから問題になる。":14,"開けなければ、永遠に未確定のままだ。":15,"どっちつかずでいいじゃないか。":16,"どっちだっていいじゃないか。":17,"卑怯で臆病なのかも知れないが、":18,"忘却とは優しさだ。":19,"真実とは、\nきっとそんなにいいものじゃない。":20,"♂と♀が永遠に、[l]\n解り合える事無く、[l]\n勘違いしたままでも、[l]\n愛し合い、[l]\n寄り添っていけるのは、":21,"やはり先刻思った通り、[l]\n互いに互いの全てを知り得ないからだと思うから──":22,"「なあ、冬夏」":23,"戻って来た冬夏を真正面から見て、\n僕は言った。":24,"「ん？」":25,"「あいしてる、[l]ずっと、[l]これからもきみを」":26,"「ぶっ、[l]\nあ、[l]あああっ？！[l]\nな、[l]な、[l]\n……えへへへへ」":27,"僕は、[l]\n或るひとには言えなかった、[l]\n届かなかった言葉を──":28,"僕には確か、そんなひとがいて、[l]\nそのひとに僕は恋をして、":29,"でもそれは終わったこと。":30,"「……ん、[l]\nま、色々言いたい事あるけど、\n今は素直に受け取っておきます。[l]\n私も愛してる。[l]\n大好き、まことさん」":31,"「ありがとう。[l]\n……さーて、[l]\n一緒に風呂っすか」":32,"「……えろめ！[l]\nまだ沸いてません！！」":33,"「あーそらそうか。[l]\nあ、折角だからスク水でも着て貰おうかのう、\nげへへへへ」":34,"「……。[l]\n……いいよ、いいけど」":35,"「うむ。にゃんだね？」":36,"「わかってるでしょ、ばか！[l]\nえろめ！！[l]\nさ、さっきのほら、因ちゃんとかみてたらさ？[l]\nわっ、私も、その、は、早く、」":37,"「……了解」":38,"夜は始まり、そしてまた明けていく。":39,"僕等はこうして、":40,"T":41,"h":42,"e":43,"y":44,"l":45,"i":46,"v":47,"d":48,"a":49,"ppily ever after.":50,"\n\n\n\n\n\n\n":51,"...":52,"Ha":53,"pp":54,"yE":55,"nd":56,"in":57,"g":58},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_064.ks","relPath":"/data/scenario/SC_E_064.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":41,"length":59,"percent":69.49152542372882},"cellInfo":[]},"/data/scenario/SC_E_065.ks":{"data":[["O PEN\n",""],["Writing\n",""],["O[l]m[l]e[l]g[l]a[l]ﾉ[l]ｼ[l]ｶ[l]ｲ[l]\n","O[l]m[l]e[l]g[l]a[l]的[l]死[l]骸[l]\n"],["NOW LOADING\n",""],["O [l]M [l]E [l]G [l]A [l]ﾉ[l]ｼ[l]ｶ[l]ｲ[l]\n[l]　　G [l]O [l]M [l]E [l]A [l]ﾉ[l]ｶ[l]ｼ[l]ｲ[l]\n[l]　　G [l]A [l]O [l]M [l]E [l]ﾉ[l]ｶ[l]ｲ[l]ｼ[l]\n[l]　　G [l]A [l]M [l]E [l]O [l]ﾉ [l]ｶ[l]ｲ[l]ｼ[l]\n","O [l]M [l]E [l]G [l]A [l]的[l]死[l]界[l]\n[l]　　G [l]O [l]M [l]E [l]A [l]的[l]价[l]值[l]观[l]\n[l]　　G [l]A [l]O [l]M [l]E [l]的[l]解[l]释[l][l]\n[l]　　G [l]A [l]M [l]E [l]O [l]的 [l]解[l]释[l][l]\n"],["Game\"O\"の開始\n","Game\"O\"的开始\n"],["or\n",""],["interlude=\"或るファの音眼\"\n","interlude=\"某个Fa音之瞳\"\n"],["[l]\n[l]\n[l]\n[l]\n[l]\n[l]\n[l]\n[l]\nNOW [l]LOADING[l].[l].[l].",""]],"context":[["SC_E_065.ks/index/1/text"],["SC_E_065.ks/index/4/text"],["SC_E_065.ks/index/7/text"],["SC_E_065.ks/index/10/text","SC_E_065.ks/index/16/text"],["SC_E_065.ks/index/13/text"],["SC_E_065.ks/index/19/text"],["SC_E_065.ks/index/22/text"],["SC_E_065.ks/index/25/text"],["SC_E_065.ks/index/28/text"]],"tags":[],"parameters":[[{"start":122,"end":129}],[{"start":136,"end":145}],[{"start":154,"end":192}],[{"start":199,"end":212},{"start":425,"end":438}],[{"start":221,"end":418}],[{"start":447,"end":459}],[{"start":466,"end":470}],[{"start":477,"end":498}],[{"start":526,"end":609}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_065.ks","basename":"SC_E_065.ks","indexIds":{"O PEN\n":0,"Writing\n":1,"O[l]m[l]e[l]g[l]a[l]ﾉ[l]ｼ[l]ｶ[l]ｲ[l]\n":2,"NOW LOADING\n":3,"O [l]M [l]E [l]G [l]A [l]ﾉ[l]ｼ[l]ｶ[l]ｲ[l]\n[l]　　G [l]O [l]M [l]E [l]A [l]ﾉ[l]ｶ[l]ｼ[l]ｲ[l]\n[l]　　G [l]A [l]O [l]M [l]E [l]ﾉ[l]ｶ[l]ｲ[l]ｼ[l]\n[l]　　G [l]A [l]M [l]E [l]O [l]ﾉ [l]ｶ[l]ｲ[l]ｼ[l]\n":4,"Game\"O\"の開始\n":5,"or\n":6,"interlude=\"或るファの音眼\"\n":7,"[l]\n[l]\n[l]\n[l]\n[l]\n[l]\n[l]\n[l]\nNOW [l]LOADING[l].[l].[l].":8},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_065.ks","relPath":"/data/scenario/SC_E_065.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":4,"length":9,"percent":44.44444444444444},"cellInfo":[]},"/data/scenario/SC_M_000.ks":{"data":[["「…」","「…」"],["静かだ。","好安静。"],["大通りはそんなに遠くないはずなのに、\n車の音も人々の喧噪も、フィルターを通した別次元に\nあるかのように聞こえる。[l]\n建物―――店の中に居るのだから、当然と言えば当然だ。[l]\nしかし、この古い建築物が、\n余計に現実からの乖離感を助長もしてるのだろう。","明明主干道应该离得不远，\n车声与人潮喧嚣却像隔着滤镜般\n仿佛来自另一个次元。[l]\n建筑物——毕竟是在店里，这么说也是理所当然。[l]\n但这栋老建筑，\n反倒更助长了与现实剥离的感觉吧。"],["いや、実際、直線距離が近いだけで、大通りへ出ようとすれば\nかなり入り組んだ小道を通り抜ける必要があるほど、\nここの立地はややこしく、テレビで見る田舎の村の一角のようなのだ。[l]\n関東圏ではあるものの、まだこのあたりは山中と言っていい。[l]\n最近新たな路線が開通したとはいえ、ここがその恩恵を受けるには\nまだ何らかの要があるだろう。[l]\n地元では有名な山の麓近くにここはあり、\n外見は完全に古民家の様相を呈している。","不，实际上虽然直线距离很近，要去主干道的话\n得穿过相当错综复杂的小路，\n这地方选址很麻烦，就像电视里看到的乡下村落一角。[l]\n虽属关东圈，这一带仍可说是山区。[l]\n虽说最近开通了新线路，但要让这里受益\n恐怕还需要些别的契机。[l]\n店铺位于当地有名的山脚附近，\n外观完全就是老民宅的模样。"],["看板は…ほとんど読めない。[l]\n周囲の寂れ具合が何ともはや。[l]\n夏の夕方ともなれば、\n近くの山から蜩が鳴く声が聞こえ、\n大層あれな雰囲気になるのだろう。","招牌…几乎看不清字。[l]\n周遭的荒凉感简直了。[l]\n若是夏日傍晚时分，\n还能听见附近山上传来的寒蝉鸣叫，\n想必会营造出相当那啥的氛围吧。"],["狭い店内、見渡す限り、古本の収められた書棚。","狭窄的店内，举目皆是收纳旧书的书架。"],["紙独特の匂いが、\nこの建物自体の持つ、古い匂いと混じって、\n僕にとっては非常に心地いいのだが。","纸张特有的气味\n与这栋建筑本身的陈旧气息交融，\n对我而言倒是相当惬意。"],["これでいいのだろうか。","这样真的好吗。"],["ここは店だ。","这里可是店铺。"],["古本屋と聞いている。","听说是家旧书店。"],["『ねこざんまい』という。","名叫『猫三昧』。"],["今は大学も春休みで、終日僕はここに居る。","现在大学正值春假，我整天都待在这儿。"],["ああ、今午後四時を回った。","啊，刚过下午四点。"],["まだまだ寒さも残る日もあるが、\n春先なので西日も柔らかだ。[l]\n眠い…。","偶尔还会有余寒未消的日子，\n但毕竟是初春，夕阳也很温柔。[l]\n好困…。"],["バイトといっても、命じられてる仕事は、\nカウンターに座って客の対応をすることだけ。[l]\n在庫をどうこうしたり、\n棚を弄ったりは寧ろ止められている。","说是打工，被指派的工作\n却只是坐在柜台应对客人。[l]\n不管是整理库存\n还是摆弄书架都是被禁止的。"],["が、同じ場所に正確に戻す条件で、商品たる古本の読書は\n許可されている。[l]\nしかし。","不过只要原样归位，阅读作为商品的旧书\n倒是被允许的。[l]\n但是。"],["今回もこのまま、\n終わっていきそうだ…。","今天大概也要\n这么结束了…。"],["そう思い、なんとなしに振り向くと、\n勝手口から戻ってくる、宮岡[ruby text=\"か\"]門[ruby text=\"ど\"]王[ruby text=\"み\"]水が居た。","正这么想着漫然回头时，\n看见宫冈门王水从后门回来了。"],["「んー、牛乳と、納豆と、卵と、\n甘いものと、お茶と買っておかなきゃだ、\nあとは…んむー、インクとケーブルと１００円ショップに行って…」","「嗯~得买牛奶、纳豆、鸡蛋、\n甜点和茶叶才行，\n还有…嗯唔~墨水、数据线还得去百元店…」"],["彼女は買い物の時にメモがないと、\n悉く買うべき物を忘れるタイプなので、\n今も何かぶつぶつ言いながらメモに細かく\n書き込んでいた。","她属于购物时不列清单\n就绝对会漏买东西的类型，\n现在也正边嘀咕边往备忘录上\n仔细记录着。"],["「…あの、宮さん」","「…那个，宫小姐」"],["「…ん。　何ですかー」","「…嗯。什么事呀—」"],["「僕はここに来てこの方、\nお客というものを見たことがないですよ」","「我来这儿之后\n从没见过所谓的客人呢」"],["ここに来たのは大学への入学が決まり、\n高校を卒業してすぐだったが、\nあれから一年近くも経つというのに、","我来这里是因为确定了要上大学，\n高中毕业就立刻过来了，\n但从那时起已经过去快一年了，"],["少なくとも僕が店番をしてる最中に来客があったことは\n一度もない。[l]\nだから結局古本読書が仕事のようなものだ。","至少在我看店期间有顾客光临的情况\n一次都没有过。[l]\n所以到头来读旧书反而成了主要工作。"],["「ん。　そうですねー」","「嗯。是这样呢ー」"],["宮さんは―――僕は彼女をそう呼称する―――、\nいやに幸せそうな顔をしながら頷いた。[l]\nきっと、今日も裏で猫どもの相手をしてきたに\n違いない。","宫小姐——我这么称呼她——\n带着异常幸福的表情点了点头。[l]\n肯定又是在后院陪那些猫玩过了\n准没错。"],["「僕はですね、伯母の紹介だったからこそ、\nここでバイトしてる訳ですが。[l]\n愉快にこうして好きな本に囲まれて、\n読書に耽りながら時間だけがゆるゆる過ぎて、\n客なんか一人も来ないのに、\nそれでお金を貰えるという事に」","「我呢，正因为是伯母介绍的\n才会在这里打工。[l]\n开开心心被喜欢的书包围着，\n沉迷阅读任由时间缓缓流逝，\n明明一个客人都没有，\n居然还能领到工资这件事」"],["「こんなにも可愛らしい美少女と一緒に、が抜けてますねえー」","「漏掉了『和这么可爱的美少女一起』这句呢ー」"],["…しれっと言われた。[l]\nそう、宮さんは、僕がこうして敬称付きで呼ぶにも関わらず、\n見た目十代前半くらいの少女なのだった。[l]\n『美』をつけるかどうかは、各人の好みというものもあるし、\nあまり深くは触れないでおこう。[l]\nまあ、僕個人の女性に対する外見の趣味嗜好でいうなら、\nテレビで見る子役やらアイドルやらよりはランク上、\nと言っておく。[l]\nが、あくまで相対的、比較論の話だ。[l]\nそういう趣味があるわけではない。","...被她若无其事地指出。[l]\n没错，尽管我这样用敬称称呼宫小姐，\n她看起来却像是个初中生模样的少女。[l]\n要不要加『美』这个前缀，取决于个人审美偏好，\n还是不要深入讨论为好。[l]\n不过单就我个人对女性外表的喜好来说，\n比电视上的童星啊偶像啊还是要高一个档次，\n先这么声明。[l]\n但这终究是相对比较的说法。[l]\n我倒没有那种特殊癖好。"],["「あー…、そうね。　そうすね。[l]\nじゃあ追加で。[l]\nで、そんなご身分にね、一年も経てばいよいよ引け目を感じますよ。僕は。[l]\n店長」","「啊...确实呢。是这样呢。[l]\n那就追加一句。[l]\n而且啊，这种处境持续一年的话，连我都会觉得过意不去呢。[l]\n店长」"],["そうなのだ。[l]\n彼女はそんなでありながら、\nここの主なのだった。","事情就是这样。[l]\n尽管她看起来如此，\n却是这家店的主人。"],["この店には『禅さん』という初老の男性も居り、\n親子では無いのだというのは、始めに説明された。[l]\n本名は本人も宮さんも教えてくれず、\nその後禅さんとは、数回だけ顔を合わせたが、\n彼はどっちかというと\n（そんなはずはないだろうが）お付きの人、\nいわば『じいや』みたいな雰囲気で、\n決して保護者と扶養家族という感じではなかった。","店里还有位叫『禅先生』的中年男性，\n事先说明过他们并非父女关系。[l]\n本名连他自己和宫小姐都不肯透露，\n后来虽然见过禅先生几次，\n但他给人的感觉更像是\n（虽然应该不至于）随从人员，\n或者说像是『老管家』的氛围，\n完全不像监护人与被抚养人的关系。"],["実際、色々取り仕切ってるのは宮さんで、\n第一彼女は（見た目通りならば中か高）学校にも行ってないのだ。[l]\n僕が知らされてないだけなのだが、\n彼女の実年齢は不詳なのである。[l]\n僕が彼女を敬称で呼ぶのはその為だ。[l]\n本屋に居るせいかもしれないが、\n知識的にも僕を凌駕していて、\n立ち振る舞いはともかく、性格…もともかくとして、[l]\n知能に於いては確かに子供ではない。[l]\n見た目に幼い成人女性も、世に全くいないわけではないし、\n本人は勿論、関係者の誰に尋ねても、彼女の年齢は教えてくれず、\n仕方なく無難な距離で接することにしている。[l]\nただ、向こうはこちらに対して丁寧語を使ってくるので、\n見た目も相まって、たまに、年下の少女に対する態度になってしまう事もあるが。","实际打理各种事务的是宫小姐，\n首先她（看外表应该是初中或高中年龄）甚至没去上学。[l]\n可能只是我没被告知，\n她的真实年龄成谜。[l]\n这就是我用敬称称呼她的原因。[l]\n或许是因为待在书店的缘故，\n她在知识量上也碾压我，\n举止姑且不论，性格...也暂且不提，[l]\n至少在智力层面确实不是小孩子。[l]\n外表稚嫩的成年女性也并非不存在，\n但无论问本人还是相关者，都没人透露她的年龄，\n只好保持安全距离相处。[l]\n只是她对我使用敬语，\n加上外貌缘故，偶尔会不自觉用对待年幼少女的态度应对。"],["そういった諸々がある故、\nここを紹介された時は大変不信に感じたが、\n伯母は馬鹿が付くほど真面目で堅い人間だったので、\nなかば信用貸し状態で、なし崩しに話はまとまった。","正因为有这些种种情况，\n刚被介绍来这里时我非常怀疑，\n但伯母是个死脑筋的严肃老实人，\n半信半疑间事情就这么稀里糊涂定下来了。"],["母親はどうせなら「姉さんの伝手だしー住み込みですれば良いジャン」と言わんばかりに乗り気だったが、そこは単純に通学の都合で僕が却下した。","母亲倒是跃跃欲试地说什么「反正有姐姐这层关系ー干脆住店里算了」，但被我以通勤不方便为由直接否决了。"],["免許取らせるだけ取らせておいて、\n車の所有は許してくれなかった癖に、\n学舎まで自転車で往復２時間の物件など冗談じゃない。","明明让我考了驾照，\n却不允许我拥有车，\n要我住每天骑车两小时往返学校的房子开什么玩笑。"],["しかし結局、伯母や本家とこの店の関係も、\n単に『本家の縁者だ』とだけ説明されたにすぎず、\n気持ちの悪い部分は残る。","但说到底，伯母和本家与这家店的关系，\n也不过被简单解释成『本家的远亲』罢了，\n总让人觉得不太舒服。"],["まあ、それに関して言えば、\n僕が聞きそびれてその後放っておいただけであり、\n改めて説明を求めれば、全く大したことではない返答が\n待っているのかも知れない。","啊，说到这个，\n只是我当时忘了问后来也没在意，\n如果现在再要求解释，得到的回答大概\n也没什么大不了的。"],["しかし不思議なことに、その気になったことは今までなかった。[l]\n元来僕は、面倒なことは眠ると忘れる","但奇怪的是，我至今都没产生过这种念头。[l]\n我天生就是睡一觉就会忘记麻烦事的"],["性","体"],["質なのだ。","质。"],["それに実際我が身に起こると、\n話の中の登場人物のように、\n全て理に適った行動というのはなかなかとれない。","而且现实中发生在自己身上时，\n根本没法像故事里的角色那样\n做出完全合乎逻辑的行动。"],["あらゆるしがらみや、お話では書かれることのない、\n連続した日常のなにがしか。","各种现实羁绊啊，故事里不会描写的\n连续日常中的种种琐事。"],["そういったものに左右されて、\n第三者からみると非常に不条理な行動というのは殊の外みなとってる。","被这些东西影响后，\n在旁人看来就会做出特别荒谬的举动。"],["…とそれこそ何かの本で読んだけど。[l]\nとにかく現状僕は、\n特にこの件に関しては追求する気持ちはない。","...这话好像在哪本书里读到过。[l]\n总之现在的我，\n对这件事完全没有深究的欲望。"],["「んむー、もう、知狡が言わなかったですか？[l]\n此処はそもそも、飯窪本家の道楽の延長なのです。[l]\nつまりは此処は外付け書庫？っす。　商売は建前、ついでです」","「嗯唔——真是的，知狡没跟你说过吗？[l]\n这里本来就是饭洼本家消遣的延伸。[l]\n说白了就是外置书库？做生意只是表面功夫啦」"],["あれ。[l]\nそうだったのか。[l]\nでは、宮さん達は昔で言う使用人みたいなものなのか。[l]\n一年以上の付き合いになるというのに、聞いた記憶はなかった。[l]\n我ながら茫洋と過ごしていたんだな…","啊咧。[l]\n原来是这样。[l]\n那宫小姐他们算是旧时代的佣人吗？[l]\n明明都相处一年多了，居然没印象听过这事。[l]\n连我自己都觉得过得稀里糊涂的..."],["「…いや、僕が聞いたのはここが本家と縁のある店っていうことだけですよ。[l]\nだいたいそれじゃ僕にバイト代が出てることの理由にならないでしょう。[l]\nというか商売気がないんなら、余計におかしいでしょうが」","「...不对，我只听说这里和本家有关系。[l]\n再说了要真是那样，给我发工资就说不通了吧。[l]\n不如说既然不想赚钱，反而更奇怪好吗」"],["「思うに知狡は、只で仕送りするのが嫌なんですね。[l]\n昔からお堅いです、相変わらず。[l]\nあくまで労働対価としての援助という体裁にしたいんですよ。[l]\nま、結局遊んでるようなものっすけどね。[l]\n","「要我说啊，知狡就是不想白给生活费。[l]\n她向来古板，现在还是老样子。[l]\n非要搞成劳动报酬形式的资助才满意。[l]\n嘛，其实和玩差不多啦。[l]\n"],["知狡ちゃんまこくんに甘甘ですねえー。　愛されてるですよ。　うひひ」","知狡对小真真是宠溺呢～超被爱的～呜嘻嘻」"],["…それは何の説明にもなって無くないか？","...这根本算不上解释吧？"],["この知狡さんというのが、僕の伯母―――つまり母の実姉で、\n現在、田舎の旅館の女将である。[l]\nまだ四十前にしては異常なまでに若作り（宮さんには劣るが）で、\n相当しっかりした女性だが、それには理由がある。","这位知狡，是我的伯母——也就是母亲的亲姐姐，\n现在经营着乡下的旅馆。[l]\n明明不到四十岁却保养得异常年轻（虽然比不上宫小姐），\n是个相当能干的女性，不过这是有原因的。"],["なにやら飯窪本家の経営しているその旅館、『","饭洼本家经营的旅馆『"],["六","六"],["母屋』というのだが、女系の一族で[l]（というより飯窪は家系的に男子があまり生まれないらしい。だから僕は相当のレアらしく、覚えていないが出生直後は色々ドタバタがあったそうだ）、[l]\n長女は主として育てられる。","母屋』是母系家族[l]（更准确说是饭洼家系里很少生男孩。所以我算是稀有物种，据说出生时闹得鸡飞狗跳，只是我不记得了），[l]\n长女都是作为继承人培养的。"],["婿取りこそまだのようだが、家を継ぐ必要もなくさっさと中央に来たうちの母親とは違って、えらく貫禄もあるのだ。[l]\nまだ僕が田舎、玄ノ森に居た頃はよく叱られたのでそう感じるだけかも知れないが。","虽然还没招赘，但和早早离开家来中央的母亲不同，她可是很有当家人的派头。[l]\n可能只是因为我小时候在乡下玄之森老挨她骂才这么觉得。"],["正確には、僕は生まれは中央だが、そのドタバタの際に一時的に玄ノ森の本家に居たことがあって、知狡さんにはその時お世話になったのだ。","准确说，我出生在中央，但出生时那场混乱期间曾被暂时寄养在玄之森的本家，那时受过知狡阿姨照顾。"],["「というわけでですね、まこくんへのお給料も、\nここの売り上げから捻出されてるわけではないのです。[l]\nついでに言うなら、\n宮も禅も、ここの経営者というより管理人ですね。[l]\n費用は飯窪本家から出てるです。[l]\nまこくんも素直に哀れみと施しを受けるが良いのに」","「所以说呢，小真的工资\n也不是从这里的营业额里挤出来的。[l]\n顺便一提，\n宫和禅与其说是这里的经营者不如说是管理员呢。[l]\n费用都是由饭洼本家支出的。[l]\n小真不如老老实实接受怜悯和施舍吧」"],["説明が事実なら、まさに出来の悪い身内にお飾りの役職を与えて\n面目を保ってますみたいな、","如果说明属实，简直就像给不成器的亲戚挂个虚职\n来保全颜面，"],["それともお小遣いの欲しい子供にそれこそガキの使いみたいなことをさせる親みたいな、ということになるのだろうが、そんな言い方はないと思う。","或者像给想要零花钱的小孩跑腿打杂的父母那样，虽然我觉得不该这么形容。"],["まあ、やはり使用人というか、従業員みたいなものだった訳だ。[l]\nその割には知狡さんにも臆面なく接するし、いよいよ以て宮さんがわからない。","嘛，说到底还是佣人或者说员工之类的存在吧。[l]\n但面对知狡阿姨却毫无惧色，我越来越看不懂宫小姐了。"],["「…ああ…何となくわかった…。[l]\nそうな、本当に真面目というか、お堅いからなー。[l]\nあのひとは。　求道者だな。　流石だな」","「…啊…大概明白了…。[l]\n这样啊，因为那个人实在太认真或者说古板了吧ー。[l]\n是个求道者呢。真厉害」"],["「まああと、知狡自身の趣味というよりも、\nまこくんの本家の人たちは基本的に愛本家というか、書痴すよー。[l]\nまこくんは、学校に上がる前にすぐ","「还有就是，与其说是知狡个人的兴趣，\n小真本家的人们基本都爱书成痴啦ー。[l]\n小真在上学前就去"],["関","关"],["東に来たから、\nあまり知らないのも無理はないです。[l]\n玄ノ森の当主んとこのもっとすごい蔵、知ってるでしょーに？[l]\nそもそも昔はその三春家と飯窪家が、結託して本の蒐集してたっすからね」","东那边了，\n不了解也很正常。[l]\n玄之森当主家那个更厉害的藏书库，你总该知道吧ー？[l]\n本来从前三春家和饭洼家就联手收集书籍来着」"],["「結託ってなんか悪巧みみたいですよ…」","「联手听起来像在密谋坏事似的…」"],["あそこには知狡さんの旅館の他に、\n『三春家』という昔の地主みたいなでかい屋敷があって、\nみんな『当主』と呼んでいた。[l]\n実際、町（","那里除了知狡阿姨的旅馆外，\n还有座叫『三春家』的像旧时地主宅邸的大房子，\n大家都称主人为『当主』。[l]\n实际上大概相当于町长（"],["玄","玄"],["ノ","之"],["森は市ではない）長だったのだろうが、\n子供の頃なので興味がなく、認識は曖昧なままだ。[l]\nともかく三春の屋敷には、これまたでかい蔵があって、\n今目の前にあるような古本や、えらく古びたまさに古文書の類が、\n山と収めてある、という噂だった。","森不是地级市），\n但小时候对此没啥兴趣，所以至今印象模糊。[l]\n总之三春宅邸里也有个大藏书库，\n据说堆满了眼前这种旧书、\n以及相当古老的真正古籍。"],["こっちに来てから知狡さんに聞いた話では、\n玄ノ森とは集落の古い名称の様な物で、\n更にいうと、元々は『","来这边后听知狡阿姨说，\n玄之森像是聚落的古称，\n更准确地说原本叫『"],["書","书"],["蔵 ","藏 "],["守 』だったようだ。[l]\nそれがどこかの時代で今の呼称になったらしい。[l]\nその地名の元になったのが三春飯窪両家の本の蔵という訳である。","守』。[l]\n不知哪个时代改成了现在的称呼。[l]\n地名的由来就是三春与饭洼两家的藏书库。"],["実際玄ノ森の辺りの家には、古代からの書物が割と残されていたらしく、当主たる三春家と、何故か飯窪家がとりわけ大きな蔵を持っていた。","实际上玄之森周边民家似乎都保存着不少古代书籍，而身为当主的三春家与饭洼家（不知为何）拥有特别大的藏书库。"],["町下のその手の書物は、今は大体がどちらかの蔵に寄贈されている、とは知狡さんの言である。","据知狡阿姨说，如今町里这类书籍基本都捐赠给了其中一家藏书库。"],["と言うわけで勿論六母屋には件の書蔵があって、幼少期の本家暮らしの際に、相当僕の人格形成に影響を及ぼしたと思われる。","所以六母屋当然也有那个藏书库，童年在本家生活时，想必对我的人格形成影响颇大。"],["「しっかり飯窪の素質は発現した訳ですね。[l]\n離ればなれに育った双子の話みたいっす。面白ーい」","「充分显现了饭洼家的素质呢。[l]\n像分开抚养的双胞胎故事似的。真有趣ー」"],["「面白っておま、いや宮さん…[l]\nま、僕が好きなのは、本という紙媒体自体みたいなもんだし、\n古文も漢文も外語も苦手ですけどね…[l]\n血と言うより環境の様な気がしますよ。[l]\nまあいいや、どっちにしろ飯窪本家がスポンサーということで、\n僕は何の気兼ねも要らない立場なわけですか」","「有趣什么啊，不对宫小姐…[l]\n嘛，我喜欢的其实是书本这种纸质载体本身，\n古文汉文外语都不擅长啦…[l]\n与其说是血缘不如说是环境影响吧。[l]\n算了无所谓，反正饭洼本家是赞助商，\n我就是不用顾虑任何事的立场对吧」"],["しかし知狡さん、一人暮らしになるからって、\n何でわざわざ僕に此処を斡旋したりしたんだろうか。","然而知狡阿姨，明明我是要开始独居生活了，\n为什么偏偏要给我介绍这个地方呢。"],["「『妹は当てにならない』からだそうですょ。[l]\nしかして単なる仕送りでは知狡の気が済まないので―――」","「『因为妹妹靠不住』据说是这样呢。[l]\n而且单纯寄生活费的话知狡会不满意——」"],["「はあ…面倒くさいことですなあ……」","「哈啊…真是麻烦透顶啊……」"],["好意は大変にありがたいが、\nもう少し素直に事態を回して欲しいものだ。[l]\n本家も此処もただでさえややこしいという事が今わかったのに。","这番好意实在令人感激，\n但真希望她能更坦率地处理事情。[l]\n现在才明白本家这边和这里本来就够复杂了。"],["「そうですねえー。[l]\nうひひ、第一ですね、ここの本はだから、ほとんどが売ってはいけない本なのです。","「就是说啊——[l]\n嘻嘻，首先呢，这里的书基本上都是不能卖的书哦。"],["結局は単なる個人の蔵書っすからねえ。[l]\n本屋にしたのは結構最近」","说到底不过是私人藏书罢了。[l]\n改造成书店是最近的事」"],["「じゃあなんですか、\nこのおよそ読めない看板とか、店に見えない外装とか、\n分かり難い立地とか、\n全部『客除け』ってことスか？」","「那难不成\n这根本看不懂的招牌啦、完全不像店铺的外观啦、\n偏僻难找的地理位置啦、\n全都是为了『赶客』吗？」"],["「立地は元からですから関係ないですが、ま、そういうことです。[l]\nだって売れたら困るんです」","「地理位置本来就是那样倒没关系，嘛，差不多就是这么回事。[l]\n因为卖出去就麻烦啦」"],["じゃあ一体何でわざわざ店舗の体裁にしたんだ。","那到底为什么要特意弄成店铺的架势啊。"],["「だって『美少女","「因为『美少女"],["古","古"],["肆』って、\nなんかいい感じでしょお？　萌えるでしょお？」","书店』什么的，\n听起来不是很棒吗？超萌的对吧？」"],["………。","………。"],["「…は？[l]\nそれだけの理由？[l]\nっていうかだからあんた幾つ…じゃない、[l]\n何だそれは！[l]\nそんなことがあり得るんスか！」","「…哈？[l]\n就这理由？[l]\n话说你到底几岁…不对、[l]\n这算什么啊！[l]\n怎么可能有这种事！」"],["「言い出しっぺは飯窪本家の人間ですもんねー。[l]\n宮たちは乗っかっただけですう。[l]\nいいじゃないですか、御陰でまこくん、只働きならぬ只儲けですよ？[l]\n本家の道楽なんだから何でもありです何でも！[l]\n気にしすぎだぜ若者ぉー！」","「提议者可是饭洼本家的人呢——[l]\n我们只是跟着起哄而已啦。[l]\n不也挺好嘛，托这个福小真你可是白赚不赔哦？[l]\n反正是本家的消遣怎么搞都行啦怎样都行！[l]\n年轻人别太较真啊——！」"],["マジか。[l]\nこの場合何代前の飯窪かは考慮の要があるが、\nいくら何でもそんなに遡れるはずもないだろうし、\n…まさか知狡さんじゃないだろうな。[l]\nそうならちょっと尊敬の念が薄れてしまうぞ。[l]\nていうか宮さん、テンション変。","真的假的。[l]\n这种情况得考虑是饭洼家第几代干的好事，\n但再怎么想也不至于追溯到那么久远，\n…该不会是知狡阿姨吧。[l]\n要真是那样的话我对她的尊敬可要打折扣了。[l]\n话说宫小姐你情绪高涨过头了吧。"],["「それよりもですね、今日は今から買い物行きたいのです。[l]\nついでに晩ご飯食べましょう。[l]\nゴゴイチのカレーが食べたい気分ですがまこくんはどうです？」","「比起这个，今天我想现在就去购物。[l]\n顺便把晚饭解决了吧。[l]\n突然想吃五五壹的咖喱了，小真觉得呢？」"],["「あ、あー、いいですよ。車貸してくれれば回します。[l]\nじゃ、佐倉の通りの方に行きますか、ゴゴイチもあるし」","「啊、嗯、好啊。借我车的话我来开。[l]\n那去佐仓街道那边吧，五五壹也在那里」"],["あっさり話題が転換されたが、乗っかる事にした。[l]\n普通の本屋にも行きたかったし。[l]\n面倒な関係説明にも辟易してたんだ。","话题突然被带偏，但我决定顺着接话。[l]\n本来也想去普通书店看看。[l]\n而且那些麻烦的关系说明听得我头都大了。"],["「天無も捨てがたいですが、\n今日はラーメンではなくカレーです！[l]\n新作出てるらしいですよ！[l]\n休みで浮かれた学生どもで混み合う前に行かねばであります！」","「天无拉面也挺让人纠结的，\n但今天不吃拉面改吃咖喱！[l]\n听说出了新品哦！[l]\n必须赶在放假狂欢的学生挤满之前去才行！」"],["「まあ着いてギリギリ六時前かな…[l]\nま、あそこはそんなに混んでないでしょう。[l]\n中高生じゃあるまいし、休みが終わり近いからって\n大学生なんてそんなに居ないんじゃないですか？[l]\nあっとじゃあ、買い物は食ってからですかね。[l]\n帰りは道路混むかもですけど」","「大概勉强能在六点前到吧…[l]\n嘛，那里应该不会太挤。[l]\n又不是中学生，就算快开学了\n大学生也没那么多吧？[l]\n啊那购物就等吃完之后咯。[l]\n回程可能会堵车就是了」"],["「それで構わないです。で、帰りはＰＣ屋を先で。[l]\nスーパーは夕方レジ混むし丁度いーでしょ」","「这样就行。回去时先去电脑城。[l]\n超市傍晚收银台很挤刚好顺路嘛」"],["「了解。[l]\n戸締まりと準備するんで、\n車のキーだけ用意しといてください」","「了解。[l]\n我去锁门做准备，\n先把车钥匙准备好就行」"],["さて僕はどうしようか…[l]\nサラダとカレーきしめんでいいか。[l]\nいっつも同じだけど。","那么我该怎么办呢…[l]\n沙拉和咖喱宽面就行了吧。[l]\n虽然每次都点一样的。"],["「あ。車のＣＤ、再編集しといたのと変えといて下さいね」","「啊。车里的CD我重新编辑过了，记得换掉哦」"],["「はいはい了解です。[l]\nおりゃ、ちゃんとテレビも消しましたーっ、と。[l]\nじゃ、行きましょうか」","「知道啦知道啦。[l]\n嘿咻，电视也好好关掉了——这样。[l]\n那咱们出发吧」"],["そのとき、","就在这时，"],["コンコン。","咚咚。"],["戸を叩く音。","敲门声。"],["店の入り口に人影が見えた。","店门口出现了人影。"]],"context":[["SC_M_000.ks/index/1/text","SC_M_000.ks/index/3/text","SC_M_000.ks/index/13/text","SC_M_000.ks/index/21/text","SC_M_000.ks/index/23/text","SC_M_000.ks/index/35/text","SC_M_000.ks/index/37/text","SC_M_000.ks/index/47/text","SC_M_000.ks/index/49/text","SC_M_000.ks/index/138/text"],["SC_M_000.ks/index/5/text","SC_M_000.ks/index/15/text"],["SC_M_000.ks/index/7/text"],["SC_M_000.ks/index/9/text"],["SC_M_000.ks/index/11/text"],["SC_M_000.ks/index/17/text"],["SC_M_000.ks/index/19/text"],["SC_M_000.ks/index/25/text"],["SC_M_000.ks/index/27/text"],["SC_M_000.ks/index/29/text"],["SC_M_000.ks/index/31/text"],["SC_M_000.ks/index/33/text"],["SC_M_000.ks/index/39/text"],["SC_M_000.ks/index/41/text"],["SC_M_000.ks/index/43/text"],["SC_M_000.ks/index/45/text"],["SC_M_000.ks/index/51/text"],["SC_M_000.ks/index/53/text"],["SC_M_000.ks/index/55/text"],["SC_M_000.ks/index/57/text"],["SC_M_000.ks/index/59/text"],["SC_M_000.ks/index/61/text"],["SC_M_000.ks/index/63/text"],["SC_M_000.ks/index/65/text"],["SC_M_000.ks/index/67/text"],["SC_M_000.ks/index/69/text"],["SC_M_000.ks/index/71/text"],["SC_M_000.ks/index/73/text"],["SC_M_000.ks/index/75/text"],["SC_M_000.ks/index/77/text"],["SC_M_000.ks/index/79/text"],["SC_M_000.ks/index/81/text"],["SC_M_000.ks/index/83/text"],["SC_M_000.ks/index/85/text"],["SC_M_000.ks/index/87/text"],["SC_M_000.ks/index/89/text"],["SC_M_000.ks/index/91/text"],["SC_M_000.ks/index/93/text"],["SC_M_000.ks/index/95/text"],["SC_M_000.ks/index/97/text"],["SC_M_000.ks/index/99/text"],["SC_M_000.ks/index/101/text"],["SC_M_000.ks/index/103/text"],["SC_M_000.ks/index/105/text"],["SC_M_000.ks/index/107/text"],["SC_M_000.ks/index/109/text"],["SC_M_000.ks/index/111/text"],["SC_M_000.ks/index/113/text"],["SC_M_000.ks/index/115/text"],["SC_M_000.ks/index/117/text"],["SC_M_000.ks/index/120/text"],["SC_M_000.ks/index/122/text"],["SC_M_000.ks/index/124/text"],["SC_M_000.ks/index/126/text"],["SC_M_000.ks/index/128/text"],["SC_M_000.ks/index/130/text"],["SC_M_000.ks/index/132/text"],["SC_M_000.ks/index/134/text"],["SC_M_000.ks/index/136/text"],["SC_M_000.ks/index/140/text"],["SC_M_000.ks/index/142/text"],["SC_M_000.ks/index/144/text"],["SC_M_000.ks/index/146/text"],["SC_M_000.ks/index/148/text"],["SC_M_000.ks/index/150/text"],["SC_M_000.ks/index/152/text"],["SC_M_000.ks/index/154/text"],["SC_M_000.ks/index/156/text"],["SC_M_000.ks/index/158/text"],["SC_M_000.ks/index/160/text"],["SC_M_000.ks/index/162/text"],["SC_M_000.ks/index/164/text"],["SC_M_000.ks/index/166/text","SC_M_000.ks/index/204/text"],["SC_M_000.ks/index/168/text"],["SC_M_000.ks/index/170/text"],["SC_M_000.ks/index/172/text"],["SC_M_000.ks/index/174/text"],["SC_M_000.ks/index/176/text"],["SC_M_000.ks/index/178/text"],["SC_M_000.ks/index/180/text"],["SC_M_000.ks/index/182/text"],["SC_M_000.ks/index/184/text"],["SC_M_000.ks/index/186/text"],["SC_M_000.ks/index/188/text"],["SC_M_000.ks/index/190/text"],["SC_M_000.ks/index/192/text"],["SC_M_000.ks/index/194/text"],["SC_M_000.ks/index/196/text"],["SC_M_000.ks/index/198/text"],["SC_M_000.ks/index/200/text"],["SC_M_000.ks/index/202/text"],["SC_M_000.ks/index/206/text"],["SC_M_000.ks/index/208/text"],["SC_M_000.ks/index/210/text"],["SC_M_000.ks/index/212/text"],["SC_M_000.ks/index/214/text"],["SC_M_000.ks/index/216/text"],["SC_M_000.ks/index/218/text"],["SC_M_000.ks/index/220/text"],["SC_M_000.ks/index/222/text"],["SC_M_000.ks/index/224/text"],["SC_M_000.ks/index/226/text"],["SC_M_000.ks/index/228/text"],["SC_M_000.ks/index/230/text"],["SC_M_000.ks/index/232/text"],["SC_M_000.ks/index/234/text"],["SC_M_000.ks/index/236/text"],["SC_M_000.ks/index/238/text"],["SC_M_000.ks/index/240/text"],["SC_M_000.ks/index/242/text"]],"tags":[],"parameters":[[{"start":139,"end":142},{"start":180,"end":183},{"start":779,"end":782},{"start":961,"end":964},{"start":1002,"end":1005},{"start":1190,"end":1193},{"start":1231,"end":1234},{"start":1541,"end":1544},{"start":1582,"end":1585},{"start":6432,"end":6435}],[{"start":215,"end":219},{"start":814,"end":818}],[{"start":233,"end":380}],[{"start":394,"end":632}],[{"start":646,"end":741}],[{"start":832,"end":854}],[{"start":868,"end":923}],[{"start":1037,"end":1048}],[{"start":1062,"end":1068}],[{"start":1082,"end":1092}],[{"start":1106,"end":1118}],[{"start":1132,"end":1152}],[{"start":1266,"end":1279}],[{"start":1293,"end":1338}],[{"start":1352,"end":1438}],[{"start":1452,"end":1503}],[{"start":1617,"end":1641}],[{"start":1655,"end":1742}],[{"start":1831,"end":1906}],[{"start":1938,"end":2014}],[{"start":2052,"end":2061}],[{"start":2171,"end":2182}],[{"start":2220,"end":2256}],[{"start":2288,"end":2347}],[{"start":2361,"end":2425}],[{"start":2527,"end":2538}],[{"start":2570,"end":2654}],[{"start":2692,"end":2820}],[{"start":2925,"end":2954}],[{"start":2986,"end":3236}],[{"start":3274,"end":3357}],[{"start":3389,"end":3431}],[{"start":3445,"end":3636}],[{"start":3650,"end":4041}],[{"start":4055,"end":4150}],[{"start":4164,"end":4231}],[{"start":4243,"end":4311}],[{"start":4325,"end":4390}],[{"start":4404,"end":4493}],[{"start":4507,"end":4561}],[{"start":4572,"end":4573}],[{"start":4584,"end":4589}],[{"start":4603,"end":4663}],[{"start":4677,"end":4719}],[{"start":4733,"end":4784}],[{"start":4798,"end":4858}],[{"start":4958,"end":5047}],[{"start":5079,"end":5193}],[{"start":5231,"end":5342}],[{"start":5445,"end":5559}],[{"start":5592,"end":5625}],[{"start":5657,"end":5676}],[{"start":5690,"end":5804}],[{"start":5818,"end":5839}],[{"start":5851,"end":5852}],[{"start":5863,"end":5976}],[{"start":5990,"end":6089}],[{"start":6103,"end":6169}],[{"start":6242,"end":6394}],[{"start":6467,"end":6514}],[{"start":6528,"end":6597}],[{"start":6611,"end":6684}],[{"start":6722,"end":6795}],[{"start":6868,"end":6947}],[{"start":6959,"end":6960}],[{"start":6971,"end":7078}],[{"start":7116,"end":7135}],[{"start":7167,"end":7246}],[{"start":7258,"end":7259}],[{"start":7270,"end":7271}],[{"start":7283,"end":7418}],[{"start":7432,"end":7490}],[{"start":7502,"end":7503},{"start":9124,"end":9125}],[{"start":7515,"end":7517}],[{"start":7530,"end":7608}],[{"start":7622,"end":7688}],[{"start":7700,"end":7745}],[{"start":7759,"end":7818}],[{"start":7923,"end":7975}],[{"start":8013,"end":8174}],[{"start":8206,"end":8256}],[{"start":8329,"end":8385}],[{"start":8423,"end":8441}],[{"start":8473,"end":8548}],[{"start":8621,"end":8676}],[{"start":8690,"end":8728}],[{"start":8766,"end":8841}],[{"start":8914,"end":8965}],[{"start":8997,"end":9019}],[{"start":9092,"end":9100}],[{"start":9111,"end":9112}],[{"start":9136,"end":9168}],[{"start":9200,"end":9204}],[{"start":9242,"end":9326}],[{"start":9399,"end":9533}],[{"start":9565,"end":9700}],[{"start":9773,"end":9859}],[{"start":9897,"end":9956}],[{"start":9988,"end":10059}],[{"start":10132,"end":10224}],[{"start":10262,"end":10415}],[{"start":10488,"end":10539}],[{"start":10577,"end":10623}],[{"start":10655,"end":10708}],[{"start":10781,"end":10808}],[{"start":10846,"end":10905}],[{"start":10937,"end":10942}],[{"start":10982,"end":10987}],[{"start":10999,"end":11005}],[{"start":11017,"end":11030}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_000.ks","basename":"SC_M_000.ks","indexIds":{"「…」":0,"静かだ。":1,"大通りはそんなに遠くないはずなのに、\n車の音も人々の喧噪も、フィルターを通した別次元に\nあるかのように聞こえる。[l]\n建物―――店の中に居るのだから、当然と言えば当然だ。[l]\nしかし、この古い建築物が、\n余計に現実からの乖離感を助長もしてるのだろう。":2,"いや、実際、直線距離が近いだけで、大通りへ出ようとすれば\nかなり入り組んだ小道を通り抜ける必要があるほど、\nここの立地はややこしく、テレビで見る田舎の村の一角のようなのだ。[l]\n関東圏ではあるものの、まだこのあたりは山中と言っていい。[l]\n最近新たな路線が開通したとはいえ、ここがその恩恵を受けるには\nまだ何らかの要があるだろう。[l]\n地元では有名な山の麓近くにここはあり、\n外見は完全に古民家の様相を呈している。":3,"看板は…ほとんど読めない。[l]\n周囲の寂れ具合が何ともはや。[l]\n夏の夕方ともなれば、\n近くの山から蜩が鳴く声が聞こえ、\n大層あれな雰囲気になるのだろう。":4,"狭い店内、見渡す限り、古本の収められた書棚。":5,"紙独特の匂いが、\nこの建物自体の持つ、古い匂いと混じって、\n僕にとっては非常に心地いいのだが。":6,"これでいいのだろうか。":7,"ここは店だ。":8,"古本屋と聞いている。":9,"『ねこざんまい』という。":10,"今は大学も春休みで、終日僕はここに居る。":11,"ああ、今午後四時を回った。":12,"まだまだ寒さも残る日もあるが、\n春先なので西日も柔らかだ。[l]\n眠い…。":13,"バイトといっても、命じられてる仕事は、\nカウンターに座って客の対応をすることだけ。[l]\n在庫をどうこうしたり、\n棚を弄ったりは寧ろ止められている。":14,"が、同じ場所に正確に戻す条件で、商品たる古本の読書は\n許可されている。[l]\nしかし。":15,"今回もこのまま、\n終わっていきそうだ…。":16,"そう思い、なんとなしに振り向くと、\n勝手口から戻ってくる、宮岡[ruby text=\"か\"]門[ruby text=\"ど\"]王[ruby text=\"み\"]水が居た。":17,"「んー、牛乳と、納豆と、卵と、\n甘いものと、お茶と買っておかなきゃだ、\nあとは…んむー、インクとケーブルと１００円ショップに行って…」":18,"彼女は買い物の時にメモがないと、\n悉く買うべき物を忘れるタイプなので、\n今も何かぶつぶつ言いながらメモに細かく\n書き込んでいた。":19,"「…あの、宮さん」":20,"「…ん。　何ですかー」":21,"「僕はここに来てこの方、\nお客というものを見たことがないですよ」":22,"ここに来たのは大学への入学が決まり、\n高校を卒業してすぐだったが、\nあれから一年近くも経つというのに、":23,"少なくとも僕が店番をしてる最中に来客があったことは\n一度もない。[l]\nだから結局古本読書が仕事のようなものだ。":24,"「ん。　そうですねー」":25,"宮さんは―――僕は彼女をそう呼称する―――、\nいやに幸せそうな顔をしながら頷いた。[l]\nきっと、今日も裏で猫どもの相手をしてきたに\n違いない。":26,"「僕はですね、伯母の紹介だったからこそ、\nここでバイトしてる訳ですが。[l]\n愉快にこうして好きな本に囲まれて、\n読書に耽りながら時間だけがゆるゆる過ぎて、\n客なんか一人も来ないのに、\nそれでお金を貰えるという事に」":27,"「こんなにも可愛らしい美少女と一緒に、が抜けてますねえー」":28,"…しれっと言われた。[l]\nそう、宮さんは、僕がこうして敬称付きで呼ぶにも関わらず、\n見た目十代前半くらいの少女なのだった。[l]\n『美』をつけるかどうかは、各人の好みというものもあるし、\nあまり深くは触れないでおこう。[l]\nまあ、僕個人の女性に対する外見の趣味嗜好でいうなら、\nテレビで見る子役やらアイドルやらよりはランク上、\nと言っておく。[l]\nが、あくまで相対的、比較論の話だ。[l]\nそういう趣味があるわけではない。":29,"「あー…、そうね。　そうすね。[l]\nじゃあ追加で。[l]\nで、そんなご身分にね、一年も経てばいよいよ引け目を感じますよ。僕は。[l]\n店長」":30,"そうなのだ。[l]\n彼女はそんなでありながら、\nここの主なのだった。":31,"この店には『禅さん』という初老の男性も居り、\n親子では無いのだというのは、始めに説明された。[l]\n本名は本人も宮さんも教えてくれず、\nその後禅さんとは、数回だけ顔を合わせたが、\n彼はどっちかというと\n（そんなはずはないだろうが）お付きの人、\nいわば『じいや』みたいな雰囲気で、\n決して保護者と扶養家族という感じではなかった。":32,"実際、色々取り仕切ってるのは宮さんで、\n第一彼女は（見た目通りならば中か高）学校にも行ってないのだ。[l]\n僕が知らされてないだけなのだが、\n彼女の実年齢は不詳なのである。[l]\n僕が彼女を敬称で呼ぶのはその為だ。[l]\n本屋に居るせいかもしれないが、\n知識的にも僕を凌駕していて、\n立ち振る舞いはともかく、性格…もともかくとして、[l]\n知能に於いては確かに子供ではない。[l]\n見た目に幼い成人女性も、世に全くいないわけではないし、\n本人は勿論、関係者の誰に尋ねても、彼女の年齢は教えてくれず、\n仕方なく無難な距離で接することにしている。[l]\nただ、向こうはこちらに対して丁寧語を使ってくるので、\n見た目も相まって、たまに、年下の少女に対する態度になってしまう事もあるが。":33,"そういった諸々がある故、\nここを紹介された時は大変不信に感じたが、\n伯母は馬鹿が付くほど真面目で堅い人間だったので、\nなかば信用貸し状態で、なし崩しに話はまとまった。":34,"母親はどうせなら「姉さんの伝手だしー住み込みですれば良いジャン」と言わんばかりに乗り気だったが、そこは単純に通学の都合で僕が却下した。":35,"免許取らせるだけ取らせておいて、\n車の所有は許してくれなかった癖に、\n学舎まで自転車で往復２時間の物件など冗談じゃない。":36,"しかし結局、伯母や本家とこの店の関係も、\n単に『本家の縁者だ』とだけ説明されたにすぎず、\n気持ちの悪い部分は残る。":37,"まあ、それに関して言えば、\n僕が聞きそびれてその後放っておいただけであり、\n改めて説明を求めれば、全く大したことではない返答が\n待っているのかも知れない。":38,"しかし不思議なことに、その気になったことは今までなかった。[l]\n元来僕は、面倒なことは眠ると忘れる":39,"性":40,"質なのだ。":41,"それに実際我が身に起こると、\n話の中の登場人物のように、\n全て理に適った行動というのはなかなかとれない。":42,"あらゆるしがらみや、お話では書かれることのない、\n連続した日常のなにがしか。":43,"そういったものに左右されて、\n第三者からみると非常に不条理な行動というのは殊の外みなとってる。":44,"…とそれこそ何かの本で読んだけど。[l]\nとにかく現状僕は、\n特にこの件に関しては追求する気持ちはない。":45,"「んむー、もう、知狡が言わなかったですか？[l]\n此処はそもそも、飯窪本家の道楽の延長なのです。[l]\nつまりは此処は外付け書庫？っす。　商売は建前、ついでです」":46,"あれ。[l]\nそうだったのか。[l]\nでは、宮さん達は昔で言う使用人みたいなものなのか。[l]\n一年以上の付き合いになるというのに、聞いた記憶はなかった。[l]\n我ながら茫洋と過ごしていたんだな…":47,"「…いや、僕が聞いたのはここが本家と縁のある店っていうことだけですよ。[l]\nだいたいそれじゃ僕にバイト代が出てることの理由にならないでしょう。[l]\nというか商売気がないんなら、余計におかしいでしょうが」":48,"「思うに知狡は、只で仕送りするのが嫌なんですね。[l]\n昔からお堅いです、相変わらず。[l]\nあくまで労働対価としての援助という体裁にしたいんですよ。[l]\nま、結局遊んでるようなものっすけどね。[l]\n":49,"知狡ちゃんまこくんに甘甘ですねえー。　愛されてるですよ。　うひひ」":50,"…それは何の説明にもなって無くないか？":51,"この知狡さんというのが、僕の伯母―――つまり母の実姉で、\n現在、田舎の旅館の女将である。[l]\nまだ四十前にしては異常なまでに若作り（宮さんには劣るが）で、\n相当しっかりした女性だが、それには理由がある。":52,"なにやら飯窪本家の経営しているその旅館、『":53,"六":54,"母屋』というのだが、女系の一族で[l]（というより飯窪は家系的に男子があまり生まれないらしい。だから僕は相当のレアらしく、覚えていないが出生直後は色々ドタバタがあったそうだ）、[l]\n長女は主として育てられる。":55,"婿取りこそまだのようだが、家を継ぐ必要もなくさっさと中央に来たうちの母親とは違って、えらく貫禄もあるのだ。[l]\nまだ僕が田舎、玄ノ森に居た頃はよく叱られたのでそう感じるだけかも知れないが。":56,"正確には、僕は生まれは中央だが、そのドタバタの際に一時的に玄ノ森の本家に居たことがあって、知狡さんにはその時お世話になったのだ。":57,"「というわけでですね、まこくんへのお給料も、\nここの売り上げから捻出されてるわけではないのです。[l]\nついでに言うなら、\n宮も禅も、ここの経営者というより管理人ですね。[l]\n費用は飯窪本家から出てるです。[l]\nまこくんも素直に哀れみと施しを受けるが良いのに」":58,"説明が事実なら、まさに出来の悪い身内にお飾りの役職を与えて\n面目を保ってますみたいな、":59,"それともお小遣いの欲しい子供にそれこそガキの使いみたいなことをさせる親みたいな、ということになるのだろうが、そんな言い方はないと思う。":60,"まあ、やはり使用人というか、従業員みたいなものだった訳だ。[l]\nその割には知狡さんにも臆面なく接するし、いよいよ以て宮さんがわからない。":61,"「…ああ…何となくわかった…。[l]\nそうな、本当に真面目というか、お堅いからなー。[l]\nあのひとは。　求道者だな。　流石だな」":62,"「まああと、知狡自身の趣味というよりも、\nまこくんの本家の人たちは基本的に愛本家というか、書痴すよー。[l]\nまこくんは、学校に上がる前にすぐ":63,"関":64,"東に来たから、\nあまり知らないのも無理はないです。[l]\n玄ノ森の当主んとこのもっとすごい蔵、知ってるでしょーに？[l]\nそもそも昔はその三春家と飯窪家が、結託して本の蒐集してたっすからね」":65,"「結託ってなんか悪巧みみたいですよ…」":66,"あそこには知狡さんの旅館の他に、\n『三春家』という昔の地主みたいなでかい屋敷があって、\nみんな『当主』と呼んでいた。[l]\n実際、町（":67,"玄":68,"ノ":69,"森は市ではない）長だったのだろうが、\n子供の頃なので興味がなく、認識は曖昧なままだ。[l]\nともかく三春の屋敷には、これまたでかい蔵があって、\n今目の前にあるような古本や、えらく古びたまさに古文書の類が、\n山と収めてある、という噂だった。":70,"こっちに来てから知狡さんに聞いた話では、\n玄ノ森とは集落の古い名称の様な物で、\n更にいうと、元々は『":71,"書":72,"蔵 ":73,"守 』だったようだ。[l]\nそれがどこかの時代で今の呼称になったらしい。[l]\nその地名の元になったのが三春飯窪両家の本の蔵という訳である。":74,"実際玄ノ森の辺りの家には、古代からの書物が割と残されていたらしく、当主たる三春家と、何故か飯窪家がとりわけ大きな蔵を持っていた。":75,"町下のその手の書物は、今は大体がどちらかの蔵に寄贈されている、とは知狡さんの言である。":76,"と言うわけで勿論六母屋には件の書蔵があって、幼少期の本家暮らしの際に、相当僕の人格形成に影響を及ぼしたと思われる。":77,"「しっかり飯窪の素質は発現した訳ですね。[l]\n離ればなれに育った双子の話みたいっす。面白ーい」":78,"「面白っておま、いや宮さん…[l]\nま、僕が好きなのは、本という紙媒体自体みたいなもんだし、\n古文も漢文も外語も苦手ですけどね…[l]\n血と言うより環境の様な気がしますよ。[l]\nまあいいや、どっちにしろ飯窪本家がスポンサーということで、\n僕は何の気兼ねも要らない立場なわけですか」":79,"しかし知狡さん、一人暮らしになるからって、\n何でわざわざ僕に此処を斡旋したりしたんだろうか。":80,"「『妹は当てにならない』からだそうですょ。[l]\nしかして単なる仕送りでは知狡の気が済まないので―――」":81,"「はあ…面倒くさいことですなあ……」":82,"好意は大変にありがたいが、\nもう少し素直に事態を回して欲しいものだ。[l]\n本家も此処もただでさえややこしいという事が今わかったのに。":83,"「そうですねえー。[l]\nうひひ、第一ですね、ここの本はだから、ほとんどが売ってはいけない本なのです。":84,"結局は単なる個人の蔵書っすからねえ。[l]\n本屋にしたのは結構最近」":85,"「じゃあなんですか、\nこのおよそ読めない看板とか、店に見えない外装とか、\n分かり難い立地とか、\n全部『客除け』ってことスか？」":86,"「立地は元からですから関係ないですが、ま、そういうことです。[l]\nだって売れたら困るんです」":87,"じゃあ一体何でわざわざ店舗の体裁にしたんだ。":88,"「だって『美少女":89,"古":90,"肆』って、\nなんかいい感じでしょお？　萌えるでしょお？」":91,"………。":92,"「…は？[l]\nそれだけの理由？[l]\nっていうかだからあんた幾つ…じゃない、[l]\n何だそれは！[l]\nそんなことがあり得るんスか！」":93,"「言い出しっぺは飯窪本家の人間ですもんねー。[l]\n宮たちは乗っかっただけですう。[l]\nいいじゃないですか、御陰でまこくん、只働きならぬ只儲けですよ？[l]\n本家の道楽なんだから何でもありです何でも！[l]\n気にしすぎだぜ若者ぉー！」":94,"マジか。[l]\nこの場合何代前の飯窪かは考慮の要があるが、\nいくら何でもそんなに遡れるはずもないだろうし、\n…まさか知狡さんじゃないだろうな。[l]\nそうならちょっと尊敬の念が薄れてしまうぞ。[l]\nていうか宮さん、テンション変。":95,"「それよりもですね、今日は今から買い物行きたいのです。[l]\nついでに晩ご飯食べましょう。[l]\nゴゴイチのカレーが食べたい気分ですがまこくんはどうです？」":96,"「あ、あー、いいですよ。車貸してくれれば回します。[l]\nじゃ、佐倉の通りの方に行きますか、ゴゴイチもあるし」":97,"あっさり話題が転換されたが、乗っかる事にした。[l]\n普通の本屋にも行きたかったし。[l]\n面倒な関係説明にも辟易してたんだ。":98,"「天無も捨てがたいですが、\n今日はラーメンではなくカレーです！[l]\n新作出てるらしいですよ！[l]\n休みで浮かれた学生どもで混み合う前に行かねばであります！」":99,"「まあ着いてギリギリ六時前かな…[l]\nま、あそこはそんなに混んでないでしょう。[l]\n中高生じゃあるまいし、休みが終わり近いからって\n大学生なんてそんなに居ないんじゃないですか？[l]\nあっとじゃあ、買い物は食ってからですかね。[l]\n帰りは道路混むかもですけど」":100,"「それで構わないです。で、帰りはＰＣ屋を先で。[l]\nスーパーは夕方レジ混むし丁度いーでしょ」":101,"「了解。[l]\n戸締まりと準備するんで、\n車のキーだけ用意しといてください」":102,"さて僕はどうしようか…[l]\nサラダとカレーきしめんでいいか。[l]\nいっつも同じだけど。":103,"「あ。車のＣＤ、再編集しといたのと変えといて下さいね」":104,"「はいはい了解です。[l]\nおりゃ、ちゃんとテレビも消しましたーっ、と。[l]\nじゃ、行きましょうか」":105,"そのとき、":106,"コンコン。":107,"戸を叩く音。":108,"店の入り口に人影が見えた。":109},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_000.ks","relPath":"/data/scenario/SC_M_000.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":110,"length":110,"percent":100},"cacheResetOnChange":{},"cellInfo":[[null,{"t":"HU","v":1}],null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"t":"HU","v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}]],"lastSelectedCell":[105,0],"note":"完成"},"/data/scenario/SC_M_001.ks":{"data":[["「すみませんーっ。あのぉーっ」","「不好意思——那个——」"],["顔を見合わせる僕と宮さん。","我和宫小姐面面相觑。"],["コンコン。[l]\nその人物―――声からすると女性のようだ―――は、\n再び入り口の引き戸を叩いた。","咚咚。[l]\n那个人——听声音似乎是女性——\n再次敲响了入口的拉门。"],["「…誰すかね。宮さん、知り合い来る予定でも？」","「…谁啊这是。宫小姐，有熟人说要来吗？」"],["それともまさか。","还是说难道。"],["「もう閉まっちゃいましたぁーっ？[l]\n店長ーっ。　居ませんかぁーっ」","「已经打烊了吗——？[l]\n店长——。不在吗——」"],["「ちょ、ちょっと、宮さん。[l]\nなんかお客さんっぽいんですけど！」","「等、等等宫小姐。[l]\n好像是客人啊！」"],["「んむー？[l]\nなんでお客なんか来るんですかねぇ？[l]\nあーもう店仕舞でご飯なのに…」","「嗯哼——？[l]\n为什么会有客人来啊？[l]\n啊——明明都关店准备吃饭了…」"],["「と、と、とりあえず僕出てきますね」","「总、总、总之我先出去看看吧」"],["「…んー？　あっ！　まこくん待ってください！」","「…嗯——？啊！小真请等一下！」"],["入り口の引き戸を開けると、\nそこには僕と同じくらいの年格好にして背丈を持った女性が、\n手をグーに振りかざしながら声をあげ続けていた。","拉开入口的拉门后，\n看见个和我年纪相仿、个头差不多的女性，\n正挥舞着拳头持续叫喊着。"],["「私ぃーっ、ＷＣぃー……」","「是我呀——WC——……」"],["「お待たせし…は？　だぶりゅー？」","「让您久…啥？WC？」"],["「…い？　あっ……？　はっ！」","「…咦？啊……？啊！」"],["互いに目が合い、一瞬間が空いた。[l]\n客なのだから見知らぬ人間なのは当然なんだが、\n耳に入った言葉があまりに意表をついたものだったせいだ。[l]\nきっと。","四目相对的瞬间，时间仿佛凝固了。[l]\n虽然是客人所以理应陌生，\n但传入耳中的话语实在太过出乎意料。[l]\n肯定是这样。"],["「あ、あのぉ、お手洗いをー、お借りしたくてっ」","「那、那个，想借、借下洗手间——」"],["「あ、あ？　ああ、お手洗い、お手洗いのＷＣね。[l]\nええーと少々お待ち下さいよ、\n宮さん！」","「啊、啊？啊啊，洗手间，洗手间的WC是吧。[l]\n呃——请稍等片刻，\n宫小姐！」"],["「もうっ、聞こえてましたっ。[l]\nお客様、いらっしゃいませ。[l]\nお手洗いは、外のその…」","「真是的，都听见啦。[l]\n欢迎光临这位客人。[l]\n洗手间在外面的那个…」"],["「あーっ、お久しぶりですミーぃ店長！」","「啊——好久不见啊米————店长！」"],["奥から宮さんが靴を履きながら出てきたとたん、","宫小姐刚趿拉着鞋从里屋出来，"],["そのお客は、宮さんを指さし、そして持っていたでかい旅行用トランクをがったんと落としながら両手を組み、顔の左右にぶんぶん振り回した後、駆け寄ったかと思いきや手を握りしめながらぐいんぐいんと宮さんの手を一緒に上下させた。","这位客人就指着宫小姐，把拎着的大号旅行箱哐当一放，双手交握在脸旁来回摇晃，突然冲过来紧握宫小姐的手上下晃动。"],["なんでいちいち描写しているかというと、\n彼女のその一連が、まるで漫画やドラマのベタを地でいくような\nまさしくテンプレ、定型文のごとくあまりにわざとらしく見えたからだ。","之所以事无巨细地描写，\n是因为她这一连串动作，活脱脱像是从漫画电视剧里走出来的\n标准模板套路，刻意到令人尴尬。"],["ちょっと白々しいが、印象としてはまあ『面白女子』と言って差し支え無しか。[l]\n服装もちょっとばかり突飛系だし。","虽然有点假，但印象算是个『搞笑系女生』吧。[l]\n穿着也有点标新立异。"],["フェイスペイント？とでもいうのか？をしていて…[l]おそらくタトゥーではないだろうが、大学でも芸専あたりには居そうな感じの女性だ。","脸上还画着类似彩绘？的东西…[l]应该不是纹身，像是大学艺术系会有的类型。"],["や、あくまでも、ファッション音痴の僕のへぼ引き出しの中での話だけど。","当然，这只是我这个时尚白痴的肤浅见解。"],["いや、しかし初対面相手にいきなりそこまで思う僕もあれだな…ちょっと疲れてるのかな…[l]\nうーん、飯前だからだろうと思いたい。","不过初次见面就想到这些的我也有点…可能太累了吧…[l]\n嗯，就当是饭前低血糖好了。"],["「…っとやっぱり。[l]\n相変わらず考え無しですね、\n直しなさいと言ったでしょう？　かれお」","「…果然。[l]\n还是这么没脑子，\n说过要改的吧？卡蕾欧」"],["「はあ…、大変に、…ソーリーです……」","「哈啊…，非常…，骚瑞啦……」"],["「…まあ良いです。[l]\nはやくＷＣに行くが良いですよ。ＷＣに」","「…算了。[l]\n快去WC吧。去WC」"],["「ううっ…、ではお借りいたしますぅーっ」","「呜呜…、那我就借用一下啦ー」"],["ぼーっと思索に入っていた僕を余所に、\n二人の話は進行していたようだ。","我正发着呆思考事情时，\n两人的对话似乎仍在继续。"],["それにしても宮さんの知り合いには悪いが、\n漫画に出てくる似非外国人みたいな人だな…","不过说真的虽然对宫小姐的朋友很抱歉，\n这人简直像漫画里冒牌的假老外啊…"],["さっきからの印象として面白要素とは別に、\n何かのステロタイプ、作り物みたいな行動に感じる。","从刚才起除了搞笑要素之外，\n总觉得她的行为像是某种刻板印象的产物。"],["あまり今までの友人知人には居なかったタイプではあるが、\n世に全く居ないという訳でもないし、気にしすぎか。","虽然在我认识的朋友里从没见过这种类型，\n但世上也不是完全没有这种人，可能是我太敏感了。"],["どうもあれだ、空腹の所為か変な方向に思考が飛ぶ。[l]\nいかんいかん。","大概是因为空腹导致思维跑偏了吧。[l]\n不行不行。"],["あ、今にして思えば、不可抗力だったとは言え、\n妙齢の女子にあのような事を言わせたのはちょっと無遠慮だったかも。","啊、现在想想，虽说是不可抗力，\n让妙龄少女说出那种话可能有点欠考虑。"],["咄嗟のことだったが、男子に対してなかなか言い難い事項だったろうに。[l]\n昔それで大変に気まずい思いをした（宮さんではない、念のため）僕としてはちょっとばかり心が重い。","虽然是情急之下的事，但对男生来说也是难以启齿的内容吧。[l]\n以前就因此经历过超级尴尬的场面（不是宫小姐，特此声明），现在心里有点沉重。"],["とはいえ今回は僕がどうこう出来た事ではないし、\nとりあえず宮さんに色々訊くことにした。","不过这次也不是我能控制的事，\n总之决定先向宫小姐打听情况。"],["「なんだ、結局知り合いじゃないですか。[l]\n近所の人ですか？」","「什么嘛，结果不还是熟人吗。[l]\n是附近的人？」"],["「いえ、全然遠くです。[l]\nと、いうより、いっつもふらふらしてて、\n一カ所に定住しないんですよ。[l]\nここ十数年近くは会ってもいなかったんです。[l]\n日本に居ない事もしょっちゅうですし」","「不，住得超远的。[l]\n或者说，她总是到处晃悠，\n从来不在一个地方定居。[l]\n最近十几年都没见过面。[l]\n还经常不在日本」"],["あの喋りはそれでか？[l]\nさっきから感じていたのはそのせいなのか？[l]\nいやしかし、あれはあまりにキャラっぽくないか？","所以说话才那样？[l]\n刚才的感觉是因为这个？[l]\n不过那也太像角色扮演了吧？"],["コントか漫画でしか見たことないぞ。[l]\n日本人が考える外国人じゃん…","我只在短剧或漫画里见过这种。[l]\n完全是日本人幻想中的外国人嘛…"],["「ふーん…[l]\nでも何か用があって来たんじゃないんですか？","「嗯…[l]\n但她应该是有事才来的吧？"],["まさか本当に、偶然トイレ借りに来た家がここだった、\nってわけじゃないでしょう」","总不可能真是偶然找厕所找到这儿\n的吧」"],["「かれおはもう呆れる程ゆるゆるなんです。[l]\n昔っから無思慮無計画、困った女子ですね。[l]\nだから全国放浪したりするんです。","「卡蕾欧已经散漫到让人傻眼的地步了。[l]\n从小就没脑子没计划，问题少女呢。[l]\n所以才会在全国到处流浪。"],["２、３日前から得体の知れない番号から何度も電話が\n掛かってきてですね、おそるおそる出てみたら\nかれおでした。","两三天前开始有个陌生号码\n反复打过来，战战兢兢接起来\n发现是卡蕾欧。"],["前聞いた番号と全然違うから分からなかったですよ。[l]\nその時も『そのうち行く』としか聞いてないですし、\nまさか今日来るなんて、全くもう…準備も何もしてないですよ…」","和以前留的号码完全不同根本认不出来。[l]\n当时也只听说『改天过去』，\n哪想到今天突然就来…完全没做准备啊…」"],["「はあ…よく分かりませんが大変ですなあ……[l]\nああ、というか飯、飯どうしましょう？」","「哈…虽然不太明白但真够呛……[l]\n啊对了，饭、吃饭怎么办？」"],["「しょうがないので連れて行きたいんですが\n駄目ですか？[l]\nかれおの用件は道行きで聞きます。[l]\nまずはカレーが最優先！[l]\nかれおよりカレーです！」","「带她一起去不就\n行了嘛？[l]\n路上再问卡蕾欧的来意。[l]\n现在咖喱最优先！[l]\n咖喱比卡蕾欧重要！」"],["え、ギャグなのか？[l]\nわ、笑った方が良いのかな…","呃，这是搞笑吗？[l]\n要、要配合笑吗…"],["「まあ、そのかれおさん？　かれおさんが良いというなら僕は気にしませんが…[l]\n何で来たんだろ？　バス？　タクシー？」","「既然那位卡蕾欧小姐？不介意的话我也无所谓…[l]\n怎么来的？公交？出租车？」"],["とりあえず笑いはスルーだ。無難な話題に振り替えよう。","总之跳过笑点。转移话题比较稳妥。"],["「どうせ泊まる気で来てますから、\n帰りの事は気にしなくていいです。[l]\nそうかー、禅に準備させとかなきゃだなー」","「反正她是打算住下来的，\n不用考虑回去的事。[l]\n对了，得让禅准备一下ー」"],["そこに、かれお嬢が持参のでかいトランクを持ち直して戻ってきた。[l]\nキャリー形式でないようだが、つまり車移動時以外は持ち運んで来たということだ。","这时卡蕾欧小姐拎着带来的大行李箱回来了。[l]\n不是滑轮款，说明她是徒手搬过来的（除了坐车时）。"],["背もあるし、結構、力あるんだな…と何となしに思った。","看她个子挺高，力气应该不小…我漫不经心地想着。"],["「ふーっ、どうも、さ、さんくすでした。[l]\nミー…ぃ店長、改めましてご無沙汰です、[l]\n雨山かれお只今参りましたっ」","「呼——多谢款待，谢、谢谢啦。[l]\n宫…宫店长，久疏问候，[l]\n雨山卡蕾欧现在正式报到啦」"],["そこでぐりっと身体ごと僕の方を向き、","说着她整个身子咯吱转向我，"],["「そちらの男子さんも改めまして\nナイストゥーミーチュー！","「那边的男生也重新问候一下\nNice to meet you！"],["私、ミぃ店長の古い知り合いであります、\n雨山かれおと申しますっ。","我是宫店长的老相识，\n名叫雨山卡蕾欧。"],["これからもよくして下さいねっ。[l]\nプリーズヘルプミー！」","今后也请多多关照啦。[l]\nPlease help me！」"],["「あ、どうも初めましてこちらこそ…（へるぷみー…？）[l]\nここでバイトしてます、飯窪真言でス。[l]\n今後とも宜しく…」","「啊、初次见面请多指教…（赫鲁普米…？）[l]\n我在这里打工，叫饭洼真言。[l]\n今后也请…」"],["怪しい挨拶をなさった。[l]\n思わず胡乱に返答をしてしまう僕だったが、\nその瞬間彼女のテンションのギアがまた上がった。","她打了这么个可疑的招呼。[l]\n我不由得含糊其辞地回应着，\n但那一瞬间她的情绪档位又升高了。"],["「あぁあーっ、貴方が！[l]\nお話は伺ってます、そうですか貴方が！","「啊啊啊——原来您就是！[l]\n我听说了您的事，原来您就是！"],["私、ミぃ店長の古い知り合いであります、\n雨山かれおと申しますっ。[l]\n","我是宫店长的老相识，\n名叫雨山卡蕾欧。[l]\n"],["これからもよくして下さいねっ」","今后也请多多关照啦」"],["い、いや、二度言われても。[l]\nてか宮さん僕の事を話してたのか。","呃、就算说两遍也...[l]\n话说宫小姐和你提过我吗？"],["どういう風に伝わってるのやら、なんか気になる\n反応なんですけど…[l]\n『そうですか貴方が！』って、何を聞いたんだ…？","不知道她是怎么描述我的，总觉得有点在意\n这个反应...[l]\n『原来您就是！』到底是听说什么了…？"],["「ええと、何を伺ったのかは判りませんが、\n僕がその、飯窪真言です。[l]\nこちらこそ宜しくしてください…」","「那个，虽然不清楚您听说了什么，\n我就是那个，饭洼真言。[l]\n我这边才要请您多关照…」"],["僕も二度言うしかないがな。[l]\n何だこのあれな感じは。[l]\n宮さんどうにかしてください。","虽然我也得说两遍就是了。[l]\n这莫名奇妙的感觉是怎么回事。[l]\n宫小姐快想想办法啊。"],["「挨拶は良いですよ、\nそれよりご飯行きますけど来ますよね？","「寒暄就到此为止吧，\n比起这个要去吃饭了你来不来？"],["かれおが来なくても宮達は行きますけどね？[l]\nそのときはかれおに留守番お願いしますけど？」","就算卡蕾欧不来我们也要去的哦？[l]\n到时候就拜托卡蕾欧看家咯？」"],["「いいぇ、行きます行きますっ。[l]\nはっ、もしかして奢っていただけるのでしょうかっ」","「不、要去要去！[l]\n哈，难道说要请客吗」"],["「…ゴゴイチですから構いませんですけどね。[l]\nあ、でもでもトッピング二品までですよ。[l]\n勿論普通盛りより上は却下です」","「…反正是去五五壹所以没关系啦。[l]\n啊不过配料最多加两种哦。[l]\n当然普通分量以上的要求一律驳回」"],["「はいっ勿論承知の上です！[l]\nでは参りましょうか皆様！[l]\n飯窪様、会ったばかりで恐縮ですが、どうかよしなにっ」","「明白！早就做好心理准备啦！[l]\n那各位我们出发吧！[l]\n饭洼大人，刚见面就这么厚脸皮真不好意思，请多担待啦」"],["二品も付けたら結構豪華だと思うんだが、\n…リミット無ければいつもはもっと付けてるということか？","加两种料其实已经挺豪华了，\n…难道说没有限制的话平时会加更多？"],["もしそうなら、成る程背も腕力もどうやら伊達ではないらしい。[l]\n現状身近な女子が宮さんだっただけに、ちょっと新鮮ではある。","要真是这样，难怪身高和臂力都不是虚的。[l]\n毕竟身边女性长期只有宫小姐，感觉还挺新鲜的。"],["「ああ、どうぞおかまいなく…[l]\nあと、『様』はちょっと…[l]\n僕ぁもう宮さん専属ドライバーみたいなもんなんで…","「啊，请别在意我…[l]\n还有『大人』这个称呼有点…[l]\n我基本上就是宫小姐的专属司机…"],["車中で宮さんと詳しい話でもなさってください」","在车上和宫小姐慢慢详谈吧」"],["さて、春先とはいえ四月前だから、まだ日はそんなに長くない。[l]\n五時六時ともなれば結構暗くなる。[l]\nライトを点灯し、大通りへ向かうべく、\n僕たちの車は細く入り組んだ路地を走った。","虽说已是初春，但毕竟未到四月，白昼还不算长。[l]\n五六点钟天色就会暗下来。[l]\n点亮车灯准备驶向主干道，\n我们的车穿行在错综复杂的小巷里。"],["カーステレオには宮さんの古今東西アニソン撰集が入っていて\nいつも非常に恥ずかしいのだが（僕はアニメは観ないのだが\n宮さんのこれの所為で知識だけはある）、","车载音响放着宫小姐的古今动漫金曲精选\n每次都让我特别难为情（虽然我不看动漫\n但因为宫小姐这个癖好倒是知道了不少），"],["古い知り合いならばその辺りは了承済みだろう。[l]\nむしろこのキャラならば大いに乗って歌い出してもおかしくない。[l]\nが、今のところ有り難いことにそれは無かった。","卡蕾欧小姐既然是老相识应该早就习惯了吧。[l]\n倒不如说以她的性格就算跟着大声唱也不奇怪。[l]\n不过谢天谢地目前还没发生这种事。"],["状況が状況なので、いつもは助手席に座る宮さんも、\n今日は後部に二人で座ってしばらく何か話し込んでいた。","由于情况特殊，平时坐副驾的宫小姐\n今天和她在后排聊了好一阵子。"],["僕は運転に集中しており、そして何となく聞き耳たてるのも\n憚られたので、内容は殆ど判らなかった。","我正专注于驾驶，而且总觉得竖起耳朵偷听\n也不太合适，所以几乎没听清内容。"],["ある程度走った所で、二人の話が一段落着いたのか、\nかれお嬢が話しかけてきた。","开了一段路后，两人的谈话似乎告一段落，\n卡蕾欧小姐主动搭话了。"],["「聞いたところによりますと、\n私の方が２つほど年上ですね。","「听说啊，\n我比您年长两岁左右呢。"],["全くもってお恥ずかしい限りです。[l]\nどうにも落ち着きがないと叱られますっ」","真是羞死人了。[l]\n总被说静不下心来呢」"],["ということは２２、３歳というところ。[l]\nまあ予想の範疇か。","这么说来是22、3岁左右。[l]\n嘛，也算预料之中。"],["大学の同期生は学生ということもあり、[l]（浪人経験者を除き）まだまだ高校あがり、あまり大人の女性という感覚ではないが、","大学同学因为还是学生，[l]（复读生除外）基本都刚高中毕业，没什么成熟女性的感觉，"],["このひとは背も高く、コートを着込んでいたのでスタイルこそよく分からないが綺麗な大人の女性と言っても良いんではないだろうか。[l]\n…黙っていて且つファッションを変えればだけど。","但这位个子高挑，虽然穿着大衣看不清身材，说是漂亮的成熟女性也不为过吧。[l]\n…前提是别开口且换掉这身打扮。"],["「でも宮さんとも古い知り合いなんですよね？[l]\nつまりは…子供の頃から宮さんが面倒みてらした？」","「不过您和宫小姐也是老相识了吧？[l]\n也就是说…从小就是宫小姐在照顾您？」"],["「言葉のアヤです。[l]\nせいぜい５、６年くらいの付き合いですよ。[l]\nそんな、宮がすごい年寄りみたいに聞こえる～」","「这是措辞问题。[l]\n顶多认识五六年而已。[l]\n说得好像宫是个老太婆似的～」"],["「ま、真言さん、店長に歳の事は禁句ですっ。[l]\n私の言い方が悪いせいで誤解を与えてしまったようで\nベリーソーリーですっ」","「嘛，真言，年龄对店长可是禁忌话题。[l]\n都怪我表达不当造成误会\n非常抱歉」"],["焦るかれお嬢。[l]\nそうか、やはり禁句なのか。","慌张的卡蕾欧小姐。[l]\n这样啊，果然是禁忌。"],["…どこまでホントか分からないが、[l]\nいよいよ以て宮さんの歳わからないな…[l]\n本気で怖くなってきた…","…不知有几分可信，[l]\n越来越搞不清宫小姐的年龄了…[l]\n真心开始害怕了…"],["今後もやはりこの話題には触れずの姿勢継続決定だ。","决定今后继续保持绝不触碰这个话题的方针。"],["「そんなことよりかれおは今晩どうするですよ？[l]\nホテルなんか店からも遠いし、とってないんでしょう？」","「比起这个，卡蕾今晚怎么办？[l]\n酒店离店里也远，还没订吧？」"],["「私は、今晩はミぃ店長の所に泊まるつもりで\n来てますがっ。お泊まりセットはトランクに常備ですから[l]\nノープレですっ」","「我本来就打算\n今晚住宫店长家。过夜套装常备在后备箱[l]\n毫无问题」"],["「やっぱりね…[l]\n夕方来た時点でもうしょうがないですけどね。[l]\n一日空けるのでちゃんと日取り決めてと言ったでしょう。","「果然啊…[l]\n傍晚过来时就料到会这样。[l]\n明明说过要空出一天提前定好日子的。"],["準備は禅にさせますけど。[l]\nだいたい急いで行かないと、\nカレー屋さんが学生共で…」","不过会让禅去准备。[l]\n再不赶紧去的话，\n咖喱店就要被学生党…」"],["「あーも少しです宮さん。[l]\nお、空いてるぽいな。ああ、空いてる空いてる！[l]\n良かったですね、ナイスタイミングす」","「啊——快到了宫店长。[l]\n噢，好像有空位。啊，有空位有空位！[l]\n太好了呢，时机完美」"],["「はいかれお！罰です。[l]\n奥の禁煙席確保して！さあ行くのです！」","「喂卡蕾！惩罚游戏。[l]\n去抢最里面的禁烟席！快上！」"],["「ぐっ！あ、あいさー！失礼、真言さんっ！」","「咕！啊，好嘞——！失礼了真言！」"],["ばたんっ！","砰！"],["言うなり彼女、\nまだ駐車途中で動いてる車から、ドアを開けて降りていった。[l]\nあ、あぶねえって！","话音刚落，\n她就从尚未停稳的车里推门跳了下去。[l]\n喂喂太危险了吧！"],["彼女自身もそうだけど、どっかにドアぶつけたらどうするんだ。[l]\nと、宮さんを見るも、\n…特にノーリアクションかよ。","不光她自己，万一车门撞到东西怎么办。[l]\n转头看向宫小姐，\n…居然毫无反应吗。"],["茶飯事なのか、この二人にとっては。[l]\nそして見る間に店内に入り、店員に案内されていくかれお嬢。","对这二人来说是家常便饭吗。[l]\n转眼间卡蕾欧小姐已冲进店内，正被店员领着走。"],["まあ、もういいか。[l]\n早く飯を喰って落ち着こう。","算了，随她去吧。[l]\n赶紧吃饭压压惊。"],["僕らが入店してからは、続々と学生らしき若者の団体が入ってきて、タイミングとしては本当にギリギリだったようだ。","我们进店后，成群的学生模样的年轻人陆续涌入，时机真是千钧一发。"],["宮さんは先刻から、学生どもをまるで目の敵のように言っているが、学生に限らず、集団になり気が大きくなってる人間連中を見るのが嫌らしい。","宫小姐从刚才就把学生们当眼中钉，不过她讨厌的倒不限于学生，而是所有聚众壮胆的浮躁人群。"],["つまり飲み屋なんかはまず絶対無理なんだろうが、\nこの外見の御陰でまず門前払いになるだろうし、\n僕の知る限りそんな状況は見たことがない。","也就是说居酒屋之类的地方肯定完全没戏吧，\n不过就凭宫小姐这外表首先就会被拒之门外，\n据我所知还没见过她去居酒屋的情况。"],["ここのメニューにアルコールは無いが、\n若いエネルギーのテンションは侮れない、とは宮さんの談。[l]\nそれは僕も新歓で色々経験したので頷いた話だった。","这里的菜单上虽然没有酒精饮料，\n但年轻人的高涨情绪不容小觑——这是宫小姐的说法。[l]\n这点我也在新人欢迎会上深有体会，所以点头赞同。"],["ま、今日はそういった客層でもないようだから、\nさっさと食事をして早々に残る用事を済ませよう。[l]\n僕はテーブルにあったメニューを手に取った。","嘛，今天看起来也没那种类型的客人，\n赶紧吃完早点把该办的事办完吧。[l]\n我拿起桌上的菜单。"],["「あー…、新メニューなあ…[l]\n杉屋の豚丼なら出るたび挑戦してるんですけどね…","「啊——…有新菜单呢…[l]\n杉屋的猪排饭每次出新款我都会挑战…"],["カレーは冒険しないなあ、そういえば…っと[l]\nというわけで、\n僕はきしめんとサラダ単品で」","不过咖喱倒是从来不敢尝试呢…话说…[l]\n就这样，\n我点了清汤荞麦面和单点沙拉」"],["宮さんは最前からの宣言どおりに、よく分からない新メニューに\n決めたようだ。","宫小姐正如先前宣称的那样，选了份看不懂的新品\n看样子是决定了。"],["宮さんの着る服は大抵白が多いのだが、そのせいか、\nカレーに限らず汁を飛ばさないように食うことに関しては\n神業の持ち主なのだった。","宫小姐穿的衣服大多以白色为主，或许正因为如此，\n不仅是咖喱，在防止汤汁飞溅的进食技巧方面\n她堪称神乎其技。"],["そうでもなければ、\nあんな服でカレー好きではいられないのかもな。[l]\n何しろ前掛けみたいなナプキンも使わないのだから\n恐れ入る。","要不是这样的话，\n穿这种衣服还喜欢咖喱根本不可能吧。[l]\n毕竟她连围裙式的餐巾都不用\n真是服了。"],["と、手渡したメニューを凝視していたかれお嬢が\n宮さんに言った。","这时，接过菜单一直盯着看的卡蕾欧小姐\n对宫小姐说道："],["「チキンカツとっ、\n……納豆トッピングの並でっ」","「炸鸡排，\n……加纳豆的普通份」"],["「半端に健康志向みたいな真似を…[l]\n前みたいにビーフ＆チキンじゃないんですか？[l]\n体型維持もむつかしいお年頃？」","「半吊子的健康主义做派…[l]\n不像以前那样点牛肉&鸡肉双拼了吗？[l]\n是到了维持身材很困难的年纪？」"],["「いやいやいやそういうことではなくテ！[l]\n値段に気を遣ったのですっ！[l]\nご覧の通り変わらずナイスバディーですからっ！　私はっ！」","「不不不才不是这样啦！[l]\n是在意价格啦！[l]\n如您所见我的身材依然很棒哦！看我！」"],["着ていたコートを丁度脱ぎかけていたのだが、\nその動作を引き継ぐ形で前を開き、胸部を突き出すかれお嬢。","正好要脱掉穿着的外套，\n顺势敞开前襟挺起胸部的卡蕾欧小姐。"],["出会いの振る舞いのインパクトの方が強烈だったので\nあまり気付かなかったが、意識してみると、\n…ああ結構大きいな。","因为初次见面时的冲击性举动更令人印象深刻，\n所以之前没太注意，现在刻意观察的话，\n…啊确实挺大的。"],["宮さんと比較するのはあまりに酷というものだ。[l]\n胸部の大小のみをもってしてバディーのナイスさを断じるのも\n考えものだと僕は思っているが、","拿宫小姐来比较实在太残忍了。[l]\n虽然我觉得仅凭胸部大小来判断身材好坏\n很有问题，"],["彼女は腰もしっかり細く臀部もしっかりしていて、同期の連中あたりには受けがいいだろう。","但她腰肢纤细臀部又挺翘，在同龄人里应该很受欢迎。"],["僕はどちらかというと胸部を含めスレンダー系が好みなのだが、…と僕はこんな所で何を考えているのだろう。[l]\n空腹時の脳髄の空転具合というのは斯くも恐ろしき物なりか。","我个人其实更喜欢包括胸部在内的纤细型…等等我到底在想什么。[l]\n空腹时的大脑空转程度竟恐怖如斯。"],["「どうせ宮はお子様体型です。[l]\n当て付けですか。嫌味ですか。むかつきますね。[l]\nそんなに気を遣いたいならサラダだけ頼むがいいです」","「反正宫是儿童体型。[l]\n是在讽刺吗。真让人火大。[l]\n这么在意身材的话你干脆只点沙拉好了」"],["「うあ、待った！うえいと！せめてオンタマかコロッケがーっ…」","「呜啊，等等！呜诶！至少加个溏心蛋或可乐饼啦…」"],["本当にこの人たちの力関係はどうなっているんだろうか。[l]\nいや、力関係は明らかなのだ。","这群人之间的权力关系到底怎么回事。[l]\n不，权力关系其实很明显。"],["知人としか聞いていないが、これは上下関係にある仲であろう。[l]\nしかも宮さんのが上位の、だ。","虽然只听说是熟人，但这明显是上下级关系。[l]\n而且宫小姐是上位者。"],["宮さんの年齢が不明なだけに想像がしにくい、\nというか想像の幅が有りすぎてわかりにくさ倍増だ。[l]\n食べながらそれとなく聞いてみようか。[l]\n齢に関する事項に触れないようにしなきゃいけないけど。","正因为宫小姐年龄不详才难以想象，\n或者说可能性太多反而更让人摸不着头脑。[l]\n要不边吃边委婉问问看。[l]\n不过得注意别触及年龄相关的话题。"],["結局、かれお嬢はサラダ単品は免れはしたが、\n一番安上がりな組み合わせにさせられたようだった。","最终卡蕾欧小姐虽然逃过了单点沙拉的命运，\n但似乎被迫选了最便宜的搭配。"],["途中宮さんの携帯が鳴って一時席を離れたりもしたが、\n各々が食事をし、それなりに僕の脳も落ち着きを取り戻した頃に、\nそれとなく二人の関係を訊ねてみた。","途中宫店长的手机响了暂时离席，\n各自吃着饭，差不多在我脑子也冷静下来的时候，\n我若无其事地打探起两人的关系。"],["「あー、私はですね、飯窪本家様とは別に、\nミぃ店長個人がご指定の本を探索及び買い付けをしたり、\nそれと勿論、本家の命を受けて雑用をこなしております。[l]\nあ、禅にはお会いになりました？[l]\n彼の同僚とお考えになって下されば結構です」","「啊—我呢，和饭洼本家是分开的，\n是宫店长个人委托我探索和采购指定的书籍，\n当然也接受本家指派处理杂务。[l]\n啊，您见过禅了吗？[l]\n把他当作我的同事理解就行」"],["「あまりに古い本とか稀覯本とか、\nネットでも手に入らないものが多いので、全国は勿論、海外まで\n出回って貰ってるんす。[l]\nそういう能力は卓越してますから。彼女。[l]\nその分他の能力が劣ってますけどね」","「因为太过古老的书或珍本，\n很多在网上也买不到，所以不仅跑遍全国，连海外\n都让我去搜罗呢。[l]\n这方面能力她可是超群的。[l]\n相对的其它能力就有点惨不忍睹了」"],["「…（宮さんひどいな）へえ、雨山さんも飯窪絡みの人ですか。[l]\nもしかして玄ノ森のご出身…？」","「…（宫店长好过分）诶，雨山小姐也是和饭洼有关的人吗？[l]\n该不会是玄之森出身…？」"],["「いえ、そうではないでス。生まれは関西です。[l]\n玄ノ森には何度か行ったことはありますがっ」","「不，不是的。我出生在关西。[l]\n玄之森倒是去过几次」"],["そうなのか。[l]\n全く関西弁の匂いはしない、というより、\nおかしな外国人みたいな匂いはするのだが、\nそれも結局海外を渡り歩いているというその仕事ゆえなのか。","这样啊。[l]\n完全听不出关西腔，倒不如说，\n有种古怪外国人的感觉，\n这也是因为长期在海外奔波的工作性质吧。"],["と先刻も思ったことを考えた。","我又想起刚才的念头。"],["「では今回いらしたのもそのお仕事ですか？[l]\n宮さんに頼まれた本を…」","「那这次来也是工作相关？[l]\n宫小姐委托的书…」"],["「そ、それがっ。[l]\nミぃ店長？」","「其、其实呢。[l]\n宫店长？」"],["「えーとねまこくん、\n少々込み入った話になりそうだから、\nあとは帰ってからにしましょう。","「那个啊小真，\n接下来可能要说些复杂的事，\n剩下的等回去再说吧。"],["まこくんにも関係ある話。[l]\n残りの買い物は今日はキャンセル、ごめんねっ」","也和小真有关。[l]\n今天剩下的采购取消，抱歉啦」"],["「はい？あ、わかりました…」","「诶？啊，好的…」"],["代わりにここは奢りですっ、\nと言って宮さんは伝票持ってレジに行ってしまった。[l]\nかれお嬢は顔の前で手を合わせ、\n『ごちそうさま』のポーズをし、","作为补偿这顿我请，\n说着宫店长拿着账单走向收银台。[l]\n卡蕾欧小姐在脸前双手合十，\n做了个『多谢款待』的姿势，"],["「さ、行きましょうっ」","「好，出发吧」"],["と身支度を開始する。","开始收拾随身物品。"],["「………」","「………」"],["なんだか妙な展開でないか？[l]\n僕にも関係ある話って何だ。","总觉得发展有点诡异？[l]\n和我有关的事是什么。"],["なんか面倒そうだな…と思うまもなく、[l]\n空くのを待っていたらしい次の客が早々にテーブルに来たので、\n僕は急いで二人の後を追って店を出た。","正觉得可能很麻烦时，[l]\n等待空位的下组客人迅速来到桌前，\n我慌忙追着两人离开店铺。"],["帰り道は既に真っ暗で、\n僕は少々憂鬱だった。","归途已完全暗下来，\n搞得我稍微有点忧郁。"],["アパートまではこの車を使えないので、\nこの闇の中、自転車で帰らなければならないからだ。[l]\nまさかかれお嬢と一緒に泊まらせてくれとは言えないだろう。[l]\nいろんな意味であり得ない。","回公寓不能用这辆车，\n我得在黑暗中骑自行车回去。[l]\n总不能开口说要和卡蕾欧小姐一起在书店过夜吧。[l]\n无论从哪个角度都不可能。"],["で、店に着くなり、宮さんはかれお嬢から書類封筒のような\nものを受け取り早々に奥に入っていった。","回到店里后，宫店长从卡蕾欧小姐那里接过\n像是文件袋的东西立刻进了里屋。"],["僕は何故かかれお嬢から「少々お待ちを」と説明を受け、[l]\n応接間の畳の上で彼女と茶を飲みながら待つことになった。[l]\n茶とはいっても煎れるような上等なものではなくて、\n冷蔵庫に入っていたペットボトルのだが。","我莫名被卡蕾欧小姐告知「请稍等」，[l]\n只好在接待室的榻榻米上和她喝茶等待。[l]\n说是茶，也不是现泡的高级货，\n只是冰箱里的瓶装茶。"]],"context":[["SC_M_001.ks/index/1/text"],["SC_M_001.ks/index/3/text"],["SC_M_001.ks/index/5/text"],["SC_M_001.ks/index/7/text"],["SC_M_001.ks/index/9/text"],["SC_M_001.ks/index/11/text"],["SC_M_001.ks/index/13/text"],["SC_M_001.ks/index/15/text"],["SC_M_001.ks/index/17/text"],["SC_M_001.ks/index/19/text"],["SC_M_001.ks/index/21/text"],["SC_M_001.ks/index/23/text"],["SC_M_001.ks/index/25/text"],["SC_M_001.ks/index/27/text"],["SC_M_001.ks/index/29/text"],["SC_M_001.ks/index/31/text"],["SC_M_001.ks/index/33/text"],["SC_M_001.ks/index/35/text"],["SC_M_001.ks/index/37/text"],["SC_M_001.ks/index/39/text"],["SC_M_001.ks/index/41/text"],["SC_M_001.ks/index/43/text"],["SC_M_001.ks/index/45/text"],["SC_M_001.ks/index/47/text"],["SC_M_001.ks/index/49/text"],["SC_M_001.ks/index/51/text"],["SC_M_001.ks/index/53/text"],["SC_M_001.ks/index/55/text"],["SC_M_001.ks/index/57/text"],["SC_M_001.ks/index/59/text"],["SC_M_001.ks/index/61/text"],["SC_M_001.ks/index/63/text"],["SC_M_001.ks/index/65/text"],["SC_M_001.ks/index/67/text"],["SC_M_001.ks/index/69/text"],["SC_M_001.ks/index/71/text"],["SC_M_001.ks/index/73/text"],["SC_M_001.ks/index/75/text"],["SC_M_001.ks/index/77/text"],["SC_M_001.ks/index/79/text"],["SC_M_001.ks/index/81/text"],["SC_M_001.ks/index/83/text"],["SC_M_001.ks/index/85/text"],["SC_M_001.ks/index/87/text"],["SC_M_001.ks/index/89/text"],["SC_M_001.ks/index/91/text"],["SC_M_001.ks/index/93/text"],["SC_M_001.ks/index/95/text"],["SC_M_001.ks/index/97/text"],["SC_M_001.ks/index/99/text"],["SC_M_001.ks/index/101/text"],["SC_M_001.ks/index/103/text"],["SC_M_001.ks/index/105/text"],["SC_M_001.ks/index/107/text"],["SC_M_001.ks/index/109/text"],["SC_M_001.ks/index/111/text"],["SC_M_001.ks/index/113/text"],["SC_M_001.ks/index/115/text"],["SC_M_001.ks/index/117/text"],["SC_M_001.ks/index/119/text"],["SC_M_001.ks/index/121/text"],["SC_M_001.ks/index/123/text"],["SC_M_001.ks/index/125/text"],["SC_M_001.ks/index/127/text"],["SC_M_001.ks/index/130/text"],["SC_M_001.ks/index/132/text"],["SC_M_001.ks/index/134/text"],["SC_M_001.ks/index/136/text"]