t"],["SC_E_002.ks/index/193/text"],["SC_E_002.ks/index/195/text"]],"tags":[],"parameters":[[{"start":128,"end":151}],[{"start":157,"end":173}],[{"start":187,"end":194}],[{"start":200,"end":216}],[{"start":222,"end":238}],[{"start":244,"end":258}],[{"start":272,"end":310}],[{"start":316,"end":337}],[{"start":351,"end":384}],[{"start":390,"end":407}],[{"start":421,"end":433}],[{"start":439,"end":447}],[{"start":453,"end":476}],[{"start":482,"end":543}],[{"start":557,"end":577}],[{"start":591,"end":608}],[{"start":614,"end":663}],[{"start":677,"end":682}],[{"start":688,"end":708}],[{"start":714,"end":719}],[{"start":733,"end":773}],[{"start":779,"end":790}],[{"start":796,"end":816}],[{"start":830,"end":837}],[{"start":843,"end":858}],[{"start":872,"end":890}],[{"start":896,"end":945}],[{"start":959,"end":963}],[{"start":969,"end":980}],[{"start":986,"end":1038}],[{"start":1052,"end":1073}],[{"start":1079,"end":1111}],[{"start":1117,"end":1137}],[{"start":1143,"end":1153}],[{"start":1167,"end":1194}],[{"start":1200,"end":1213}],[{"start":1219,"end":1248}],[{"start":1254,"end":1309}],[{"start":1315,"end":1335}],[{"start":1349,"end":1362}],[{"start":1368,"end":1406}],[{"start":1412,"end":1428}],[{"start":1434,"end":1469}],[{"start":1483,"end":1517}],[{"start":1523,"end":1531}],[{"start":1545,"end":1555}],[{"start":1569,"end":1571}],[{"start":1577,"end":1580}],[{"start":1586,"end":1593}],[{"start":1607,"end":1635}],[{"start":1649,"end":1653}],[{"start":1659,"end":1666}],[{"start":1672,"end":1685}],[{"start":1699,"end":1727}],[{"start":1733,"end":1753}],[{"start":1759,"end":1772}],[{"start":1778,"end":1801}],[{"start":1807,"end":1820}],[{"start":1826,"end":1848}],[{"start":1862,"end":1877}],[{"start":1891,"end":1929}],[{"start":1943,"end":1952}],[{"start":1966,"end":1975}],[{"start":1981,"end":1998}],[{"start":2004,"end":2021}],[{"start":2035,"end":2046}],[{"start":2052,"end":2059}],[{"start":2065,"end":2074}],[{"start":2080,"end":2088}],[{"start":2102,"end":2113}],[{"start":2127,"end":2135}],[{"start":2149,"end":2154}],[{"start":2168,"end":2186}],[{"start":2192,"end":2216}],[{"start":2230,"end":2251}],[{"start":2257,"end":2273}],[{"start":2279,"end":2299}],[{"start":2313,"end":2321}],[{"start":2327,"end":2347}],[{"start":2353,"end":2372}],[{"start":2386,"end":2400}],[{"start":2406,"end":2445}],[{"start":2451,"end":2466}],[{"start":2480,"end":2514}],[{"start":2520,"end":2527}],[{"start":2533,"end":2551}],[{"start":2565,"end":2610}],[{"start":2624,"end":2665}],[{"start":2671,"end":2686}],[{"start":2692,"end":2732}],[{"start":2746,"end":2786}],[{"start":2792,"end":2804}],[{"start":2810,"end":2824}],[{"start":2830,"end":2852}],[{"start":2866,"end":2923}],[{"start":2937,"end":2957}],[{"start":2971,"end":2984}],[{"start":2990,"end":2999}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_002.ks","basename":"SC_E_002.ks","indexIds":{"「あ、どうも、\nご無沙汰しとりますぅ。":0,"…この國の言葉でよろしですか？」":1,"「構わないよ。":2,"いつまで経っても嫌味な娘子だね。":3,"さっさと本題に入ろうじゃないの。":4,"何やら厄介事があったって？」":5,"「はぁ、本題いうても、\n元々は式に来て欲しいいうのが本題でしたから。":6,"厄介事はあくまで突発的事故いうやつですぅ」":7,"「だからいちいち揚げ足を取るんじゃないと\n言ってるんだよ。":8,"どこの家の誰と誰が殺されたって？」":9,"「二人とも東家ですけど。":10,"三と一の当主が。":11,"あと七の当主が襲われましたが無事やそうですぅ。":12,"なんでも、傷口はぐっちゃぐちゃ、刃物とは到底思えない、\nいうなら熊にでも咬み殺されたような具合やったそうですよぅ」":13,"「６が何かしたということはないんだね？」":14,"「そんなわけはない思いますけどぉ。":15,"第一、■■ちゃんはどっぷりうちらの者ですし、\nまだツキノモノがきたばっかりのお子様ですぅ」":16,"「ふうん。":17,"それにしても３がやられたんじゃ面倒だね。":18,"継承は？」":19,"「三には■■ちゃんがいてますし、\n一はもう、ちょっと前に済んでますなぁ。":20,"七も問題はないですぅ。":21,"ただ、妊娠中やと聞いてますなぁ七の家は」":22,"「もう検査は？":23,"３が殺される前だったろうね？」":24,"「難儀ですがまだやったそうですわぁ。":25,"■■ちゃんが本業も継ぎますんで問題はないですが、\nちょっと時間はかかってまうでしょうなぁ」":26,"「ふん。":27,"何から何まで厄介だね。":28,"７が動けるなら問題はないだろうけど、\n事態の進行を邪魔するこういった事象は\n大嫌いだよ」":29,"「長年生きてはっても嫌なもんは嫌ですなぁ。":30,"ま、今度の事は何とか処理して、\n早いとこ式を始めましょ。":31,"二の■■ちゃんに早う会わせたいですよぅ。":32,"びっくりしますよぉ」":33,"「…あたしはそのために老体にむち打ってやってきたんだ。":34,"今更無しとは言わせないよ。":35,"忌まわしき白の連中の眼を逃れるのも簡単じゃないんだからね。":36,"『八人姉妹』の再興に足る、それだけの価値があると、\nあんたが言ったからこうやってベロアも連れてきたさ。":37,"それより７に早く犯人を追わせることだね」":38,"「あはは、はぁ老体、ねえ。":39,"まぁ今代の娘達…殺された二人の跡継ぎも入れて、\n結構な案配ですよぉ。":40,"勿論このあたしも入れてですよぅ。":41,"七の姉妹も、姉はダメでしたが妹の方がそらもう\n結構なもので――":42,"再びアリスの血族の元に猫が集まる日も\n近いいうわけですなぁ。":43,"そうすれば白の」":44,"「ときに５の娘――」":45,"「？":46,"はぁ。":47,"なんでしょ？」":48,"「――あんた『ツェロル』に関して何か隠しておいでかぇ？」":49,"「はぁ。":50,"『つぇろる』。":51,"なんにもかくしてませんが」":52,"「…あんたの言は極力吟味咀嚼してから判断したいもんだよ。":53,"『ツェロル』は我らの復興に重要な因子だ。":54,"あんたも知ってるとおりね。":55,"おかしなこと考えてると後々面倒なことになるよ。":56,"正直に言うなら今のうちだ。":57,"どうなんだい。本当に何も隠してないのかぇ？」":58,"「どこかでそういうお話でも？」":59,"「残りの『姉妹』達と『ツェロル』について\n本当に何も隠してないと？」":60,"「はぁ、なんにも」":61,"「――まあいいさ。":62,"じゃそっちの準備は進めることだね。":63,"あたしらはしばらく休ませて貰うよ」":64,"「はぁ、わかりました。":65,"では、魔女殿。":66,"さよぉならですぅ。":67,"ベロアちゃんも」":68,"「―――――――――」":69,"「――――――」":70,"「―――」":71,"「毎度のことながら小憎らしい娘さね。":72,"魔眼の者で無ければとっくに始末してるところだよ」":73,"「あいつはうそつきだな、マスターミリアム。":74,"うかつに耳を貸すと身を滅ぼすよ。":75,"ほんとうはベロア来たくなかったよこの國」":76,"「わかってるよ。":77,"これでもあの娘とは長い付き合いだからね。":78,"あんたには苦労を掛けてすまないけどね」":79,"「ほんとうにわかってるかい？":80,"それにあいつひとりが特別に扱われてるのは\n不当だな、マスターミリアム。":81,"会ったときから嫌いだよあの女」":82,"「真のアリスの末裔を守り伝えるのがきゃつらに\n与えた役割さ。":83,"知ってるだろ。":84,"５はこの國では一番の魔眼の者だった。":85,"しかし、\n下女には下女の分相応というものがあることを、\n忘れさせはしない」":86,"「マスターミリアムはアリスの一族のことになると\n視界がくもるのが危険だな。":87,"それは相手が思い、決めること。":88,"そもそもあいつがのさばってるのも、\n■■■■■の出来が悪かったせいだよ。":89,"いい加減『LuLe』の呪縛から放たれたほうがいいな、\nマスターミリアム。":90,"■■■■■はもう死んだ。":91,"よく似た子孫が生まれただけ。":92,"…ベロアの肉も限界がちかいし無理は禁物だよ。":93,"こんなことをしなくても、\nベロアはベロアとマスターミリアムが心穏やかに暮らせれば\nそれでいいのに。":94,"――聞こえてるかい、マスターミリアム？」":95,"「ド―ミリア――もうすぐ…":96,"再び会えよう――」":97},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_002.ks","relPath":"/data/scenario/SC_E_002.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":98,"length":98,"percent":100},"cellInfo":[null,null,null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],[null,{"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[90,1],"note":"完成"},"/data/scenario/SC_E_003.ks":{"data":[["盲の者共が、その数の多きを嵩に、[l]\n\nわれら真の視界をみるものを害すか。[l]\n\nさても彼らに天敵は居ぬ。[l]\n\nもはやヒトを殺すのは極大極微のものらのみ。[l]\n\nあるいはヒト同士の争いの果て。[l]\n\nならば。[l]\n\nわれらがヒトの天敵となろう。[l]\n\n彼ら盲の羊は供される饗される。","盲眼之徒，仗其数量之众，[l]\n\n欲加害吾等得见真实视界之人乎。[l]\n\n诚然他们了无天敌。[l]\n\n如今能杀人的唯有极大极微之物。[l]\n\n抑或是人类彼此争斗的尽头。[l]\n\n那么。[l]\n\n就由吾等来当人类的天敌吧。[l]\n\n那些盲眼的羊群正待宰割享用。"],["われらこそヴァイァラス。[l]\n\n不死たるカンサー。[l]\n\nわれらの天敵は白き者ども。[l]\n\nみいろのみとろ、","吾等正是病毒。[l]\n\n乃不死之癌。[l]\n\n吾等的天敌是白之众。[l]\n\n三色之涂，"],["White Cat's-","White Cat's-"],["White Corpuscle,","White Corpuscle（译注：白血球）,"],["Witch Capture,","Witch Capture（译注：魔女狩猎）,"],["anti-Alice。","anti-Alice。"],["赤の女王の呼び名、敢えて冠しようぞ。[l]\n\nくうかくわれるか。[l]\n\nアリスの血は","赤之女王的称号，且由吾等加冕。[l]\n\n被吞噬或被隐藏。[l]\n\n爱丽丝的血脉"],["ふたたびめぐる","再度循环"],["二度巡る","二次轮回"],["再び廻る[l]\n\nわれらはツキノモノを遣いし月の者。","重新流转[l]\n\n吾等是操纵月之物的月之民。"],["赤き血をもって月に供す。","以赤红之血供奉月。"],["パラミアキス喚びし者のともがら。[l]\n\nLunatic Leap。[l]\n\nアリスの忠実なるしもべ、[l]\n\n八人姉妹の長姉の称号賜りし、[l]\n\n我が名はミリアム。[l]\n\n","被称作帕拉米亚基斯的同族。[l]\n\nLunatic Leap。[l]\n\n爱丽丝忠实的仆从，[l]\n\n获赐八姐妹长姐称号的，[l]\n\n吾名米莉安姆。[l]\n\n"],["七つの頭を伏して待つもの――","俯伏七首静待之物――"]],"context":[["SC_E_003.ks/index/1/text"],["SC_E_003.ks/index/3/text"],["SC_E_003.ks/index/5/text"],["SC_E_003.ks/index/7/text"],["SC_E_003.ks/index/9/text"],["SC_E_003.ks/index/11/text"],["SC_E_003.ks/index/13/text"],["SC_E_003.ks/index/15/text"],["SC_E_003.ks/index/17/text"],["SC_E_003.ks/index/19/text"],["SC_E_003.ks/index/21/text"],["SC_E_003.ks/index/23/text"],["SC_E_003.ks/index/26/text"]],"tags":[],"parameters":[[{"start":140,"end":345}],[{"start":359,"end":440}],[{"start":446,"end":458}],[{"start":464,"end":480}],[{"start":486,"end":500}],[{"start":506,"end":517}],[{"start":531,"end":590}],[{"start":596,"end":603}],[{"start":609,"end":613}],[{"start":619,"end":653}],[{"start":659,"end":671}],[{"start":685,"end":808}],[{"start":833,"end":847}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_003.ks","basename":"SC_E_003.ks","indexIds":{"盲の者共が、その数の多きを嵩に、[l]\n\nわれら真の視界をみるものを害すか。[l]\n\nさても彼らに天敵は居ぬ。[l]\n\nもはやヒトを殺すのは極大極微のものらのみ。[l]\n\nあるいはヒト同士の争いの果て。[l]\n\nならば。[l]\n\nわれらがヒトの天敵となろう。[l]\n\n彼ら盲の羊は供される饗される。":0,"われらこそヴァイァラス。[l]\n\n不死たるカンサー。[l]\n\nわれらの天敵は白き者ども。[l]\n\nみいろのみとろ、":1,"White Cat's-":2,"White Corpuscle,":3,"Witch Capture,":4,"anti-Alice。":5,"赤の女王の呼び名、敢えて冠しようぞ。[l]\n\nくうかくわれるか。[l]\n\nアリスの血は":6,"ふたたびめぐる":7,"二度巡る":8,"再び廻る[l]\n\nわれらはツキノモノを遣いし月の者。":9,"赤き血をもって月に供す。":10,"パラミアキス喚びし者のともがら。[l]\n\nLunatic Leap。[l]\n\nアリスの忠実なるしもべ、[l]\n\n八人姉妹の長姉の称号賜りし、[l]\n\n我が名はミリアム。[l]\n\n":11,"七つの頭を伏して待つもの――":12},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_003.ks","relPath":"/data/scenario/SC_E_003.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":13,"length":13,"percent":100},"cellInfo":[[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"t":"HU","v":1}],[null,{"t":"HU","v":1}],[null,{"t":"HU","v":1}],[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[5,0],"note":"完成"},"/data/scenario/SC_E_004.ks":{"data":[["今更感情移入もないだろう。","事到如今也不会共情了吧。"],["もうすぐCovenが来るぞ。","Coven马上就要来了。"],["そうなればもう。","到那时就。"],["いよいよ永きに渡った我らの役目も終わりだ。","漫长岁月里吾等的职责终将完结。"],["偽が完全となり真は消える。","伪物臻至完美，真物就此消散。"],["ヒトの世界とは途切れよう。","与人类世界的联系终将断绝。"],["我らが肉を檻枷として、\nありすが結び留めた魔具の片割が揃う。","以吾等血肉为牢笼，\n爱丽丝所系魔具的残片终将齐聚。"],["再び猫の――","再度化为猫的――"],["心とは脳髄という器官の活性状態における一現象だ。","所谓心不过是脑髓器官活性状态下的现象。"],["いのちでは無い。","并非生命。"],["そのような不確かなモノに揺さぶられるな。","莫被这般不确定之物动摇。"],["それが我らが視、認識する視界に於ける常態であれ、\n同時に来し方のこの界が如く醜悪なものとなるぞ。","纵使那是吾等视觉所认知的常态，\n此界亦将如过往般沦为丑恶之物。"],["『刺し手』として完成すれば或いは。","若以『刺客』之姿完成或许。"],["かの詩人の作にもあったな。","那位诗人的作品中也写过呢。"],["まさに『猫が死ぬか自分が死ぬか』だ。","正是『猫死或我亡』。"],["とはいえお前も知っているだろう。","不过你也该明白。"],["Deus ex machina。","Deus ex machina。"],["その顕現は救いでもあるが、\n事象は混迷するだろうよ。","那显现虽是救赎，\n事态却会陷入混沌。"],["この期に及んで三重偉大など、\nしかし真が在り続けるにはおそらく。","这种时候还提三重伟大，\n但若要真物继续存在恐怕。"],["飯","饭"],["食。","食。"],["魔眼の刺し手。","魔眼之刺客。"],["呼び水たる月の雫。","引月之雫。"],["そのような面倒な事態を望むのは得策ではないぞ。","期待那种麻烦局面可非上策。"],["特に雫は誰にも御せないぞ。","尤其雫可是谁都控制不了的。"],["波紋を生じさせはするがそれ自体が思考も施行もしないものだ。","虽会激起涟漪，但其本身既无思考亦无作为。"],["ありすの血の源流。","爱丽丝的血脉源流。"],["月が水を介し肉に波を起こす。","月借水波撼动血肉。"],["揺らぎ。","摇曳。"],["媒質あるところ契機となりて全てをざわめかす。","凡有媒介之处皆成契机，令万物躁动。"],["白殿が事態を寛容しても、\nNote-Dueが修正を図るだろうよ。","纵使白大人宽容事态，\nNote-Due也会试图修正吧。"],["頭の固いあれがまた、\n強硬に過ぎて機嫌を損ねねば良いが。","那个顽固的家伙又，\n但愿别因过于强硬而惹人不快。"],["Ender達も居るというのにどうするのだか。","明明Ender他们也在场，到底要怎么办啊。"],["あの方の望みはなんだろうね。","那位大人的愿望究竟是什么呢。"],["赤の女王の捕縛か。","是要捕获赤之女王吗。"],["つぇろるの回収か。","还是要回收赛萝洛呢。"],["偽りの黒の完成か。","亦或是完成虚伪之黑。"],["三重偉大の顕現があの方にとっては最良だろうが、しかし。","三重伟大的显现对那位大人而言最为理想，但是——"],["猫は骸盗みて操るものぞ。","猫可是会盗取骸骨加以操纵的。"],["火車を視よ、骸仮借して――","看那火车，假借骸骨之形――"],["いずれにしても、\n最強の白、その主にして兄君のために。","无论如何，\n为了最强的白，那位主君兼兄长大人。"],["ありすの血より分かたれし我等と彼奴等の、\n狩りの遊戯も仕上げだ。","由爱丽丝之血分离的吾等与彼等，\n狩猎游戏也该收尾了。"],["しかし、あの子が雫であれば、\n予期をはるかに上回る混迷の劇を引き起こすのではあるまいな。","不过若那孩子是雫的话，\n恐怕会引发远超预期的混乱剧目吧。"],["予防線なぞ意にも介さないのが雫の波だ。","雫之浪潮可不会在意什么防线。"],["誰にも何も出来ない。","谁都无能为力。"],["放っておいてもおなじこと。","放任不管结果也一样。"],["お前の妹、","你妹妹，"],["現","现"],["実は何を思うたか。","实究竟在想什么呢。"],["お前は余計な真似をしない娘だと信じているよ。","我相信你不是会多管闲事的姑娘。"],["――どうやら、\n最初の旗を立てに来たね。","――看来，\n是来立第一面旗的呢。"],["此の國に果てし我等が祖の遺物、\n視線を断てるは四の死の眼。","在这片土地上传承不绝的我等先祖的遗物，\n能阻断视线的唯有四之死眼。"],["四器の如き即ち規矩準縄、\n四色の如きの式を以て、","四器即为规矩准绳，\n以四色之式，"],["屍鬼に死来たらしめ紙に封じ神に奉じ、\n書蔵守たる我等しろいもじ、","令尸鬼迎来死亡封入纸中献予神明，\n作为书藏守的我等白之文字，"],["飯食の送り手、飯守女の一族が、\n厄たる役を、終える時ぞ。","供奉食物之人，饭守女一族，\n终结灾厄职责之时已至。"],["おめがの瞳の祝あれ。","愿汝等瞳孔获得祝福。"],["御斎串魔眼窪――","御斋串魔眼洼――"],["あとは、任せたよ。","之后就交给你了。"]],"context":[["SC_E_004.ks/index/1/text","SC_E_004.ks/index/17/text","SC_E_004.ks/index/51/text","SC_E_004.ks/index/65/text","SC_E_004.ks/index/107/text"],["SC_E_004.ks/index/3/text"],["SC_E_004.ks/index/5/text"],["SC_E_004.ks/index/7/text"],["SC_E_004.ks/index/9/text"],["SC_E_004.ks/index/11/text"],["SC_E_004.ks/index/13/text"],["SC_E_004.ks/index/15/text"],["SC_E_004.ks/index/19/text"],["SC_E_004.ks/index/21/text"],["SC_E_004.ks/index/23/text"],["SC_E_004.ks/index/25/text"],["SC_E_004.ks/index/27/text"],["SC_E_004.ks/index/29/text"],["SC_E_004.ks/index/31/text"],["SC_E_004.ks/index/33/text"],["SC_E_004.ks/index/35/text"],["SC_E_004.ks/index/37/text"],["SC_E_004.ks/index/39/text"],["SC_E_004.ks/index/41/text"],["SC_E_004.ks/index/43/text"],["SC_E_004.ks/index/45/text"],["SC_E_004.ks/index/47/text"],["SC_E_004.ks/index/49/text"],["SC_E_004.ks/index/53/text"],["SC_E_004.ks/index/55/text"],["SC_E_004.ks/index/57/text"],["SC_E_004.ks/index/59/text"],["SC_E_004.ks/index/61/text"],["SC_E_004.ks/index/63/text"],["SC_E_004.ks/index/67/text"],["SC_E_004.ks/index/69/text"],["SC_E_004.ks/index/71/text"],["SC_E_004.ks/index/73/text"],["SC_E_004.ks/index/75/text"],["SC_E_004.ks/index/77/text"],["SC_E_004.ks/index/79/text"],["SC_E_004.ks/index/81/text"],["SC_E_004.ks/index/83/text"],["SC_E_004.ks/index/85/text"],["SC_E_004.ks/index/87/text"],["SC_E_004.ks/index/89/text"],["SC_E_004.ks/index/91/text"],["SC_E_004.ks/index/93/text"],["SC_E_004.ks/index/95/text"],["SC_E_004.ks/index/97/text"],["SC_E_004.ks/index/99/text"],["SC_E_004.ks/index/101/text"],["SC_E_004.ks/index/103/text"],["SC_E_004.ks/index/105/text"],["SC_E_004.ks/index/109/text"],["SC_E_004.ks/index/111/text"],["SC_E_004.ks/index/113/text"],["SC_E_004.ks/index/115/text"],["SC_E_004.ks/index/117/text"],["SC_E_004.ks/index/119/text"],["SC_E_004.ks/index/121/text"],["SC_E_004.ks/index/123/text"]],"tags":[],"parameters":[[{"start":151,"end":164},{"start":329,"end":342},{"start":777,"end":790},{"start":931,"end":944},{"start":1514,"end":1527}],[{"start":170,"end":184}],[{"start":190,"end":198}],[{"start":204,"end":225}],[{"start":231,"end":244}],[{"start":250,"end":263}],[{"start":269,"end":303}],[{"start":309,"end":315}],[{"start":348,"end":372}],[{"start":378,"end":386}],[{"start":392,"end":412}],[{"start":418,"end":470}],[{"start":484,"end":501}],[{"start":507,"end":520}],[{"start":526,"end":544}],[{"start":550,"end":566}],[{"start":572,"end":588}],[{"start":594,"end":624}],[{"start":630,"end":666}],[{"start":692,"end":693}],[{"start":704,"end":706}],[{"start":712,"end":719}],[{"start":725,"end":734}],[{"start":748,"end":771}],[{"start":804,"end":817}],[{"start":823,"end":852}],[{"start":858,"end":867}],[{"start":873,"end":887}],[{"start":893,"end":897}],[{"start":903,"end":925}],[{"start":958,"end":994}],[{"start":1000,"end":1032}],[{"start":1038,"end":1060}],[{"start":1074,"end":1088}],[{"start":1102,"end":1111}],[{"start":1117,"end":1126}],[{"start":1132,"end":1141}],[{"start":1155,"end":1182}],[{"start":1196,"end":1208}],[{"start":1214,"end":1227}],[{"start":1241,"end":1272}],[{"start":1278,"end":1314}],[{"start":1328,"end":1376}],[{"start":1382,"end":1401}],[{"start":1407,"end":1417}],[{"start":1423,"end":1436}],[{"start":1442,"end":1447}],[{"start":1459,"end":1460}],[{"start":1471,"end":1480}],[{"start":1486,"end":1508}],[{"start":1541,"end":1565}],[{"start":1579,"end":1612}],[{"start":1618,"end":1646}],[{"start":1652,"end":1688}],[{"start":1694,"end":1726}],[{"start":1732,"end":1742}],[{"start":1756,"end":1764}],[{"start":1778,"end":1787}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_004.ks","basename":"SC_E_004.ks","indexIds":{"今更感情移入もないだろう。":0,"もうすぐCovenが来るぞ。":1,"そうなればもう。":2,"いよいよ永きに渡った我らの役目も終わりだ。":3,"偽が完全となり真は消える。":4,"ヒトの世界とは途切れよう。":5,"我らが肉を檻枷として、\nありすが結び留めた魔具の片割が揃う。":6,"再び猫の――":7,"心とは脳髄という器官の活性状態における一現象だ。":8,"いのちでは無い。":9,"そのような不確かなモノに揺さぶられるな。":10,"それが我らが視、認識する視界に於ける常態であれ、\n同時に来し方のこの界が如く醜悪なものとなるぞ。":11,"『刺し手』として完成すれば或いは。":12,"かの詩人の作にもあったな。":13,"まさに『猫が死ぬか自分が死ぬか』だ。":14,"とはいえお前も知っているだろう。":15,"Deus ex machina。":16,"その顕現は救いでもあるが、\n事象は混迷するだろうよ。":17,"この期に及んで三重偉大など、\nしかし真が在り続けるにはおそらく。":18,"飯":19,"食。":20,"魔眼の刺し手。":21,"呼び水たる月の雫。":22,"そのような面倒な事態を望むのは得策ではないぞ。":23,"特に雫は誰にも御せないぞ。":24,"波紋を生じさせはするがそれ自体が思考も施行もしないものだ。":25,"ありすの血の源流。":26,"月が水を介し肉に波を起こす。":27,"揺らぎ。":28,"媒質あるところ契機となりて全てをざわめかす。":29,"白殿が事態を寛容しても、\nNote-Dueが修正を図るだろうよ。":30,"頭の固いあれがまた、\n強硬に過ぎて機嫌を損ねねば良いが。":31,"Ender達も居るというのにどうするのだか。":32,"あの方の望みはなんだろうね。":33,"赤の女王の捕縛か。":34,"つぇろるの回収か。":35,"偽りの黒の完成か。":36,"三重偉大の顕現があの方にとっては最良だろうが、しかし。":37,"猫は骸盗みて操るものぞ。":38,"火車を視よ、骸仮借して――":39,"いずれにしても、\n最強の白、その主にして兄君のために。":40,"ありすの血より分かたれし我等と彼奴等の、\n狩りの遊戯も仕上げだ。":41,"しかし、あの子が雫であれば、\n予期をはるかに上回る混迷の劇を引き起こすのではあるまいな。":42,"予防線なぞ意にも介さないのが雫の波だ。":43,"誰にも何も出来ない。":44,"放っておいてもおなじこと。":45,"お前の妹、":46,"現":47,"実は何を思うたか。":48,"お前は余計な真似をしない娘だと信じているよ。":49,"――どうやら、\n最初の旗を立てに来たね。":50,"此の國に果てし我等が祖の遺物、\n視線を断てるは四の死の眼。":51,"四器の如き即ち規矩準縄、\n四色の如きの式を以て、":52,"屍鬼に死来たらしめ紙に封じ神に奉じ、\n書蔵守たる我等しろいもじ、":53,"飯食の送り手、飯守女の一族が、\n厄たる役を、終える時ぞ。":54,"おめがの瞳の祝あれ。":55,"御斎串魔眼窪――":56,"あとは、任せたよ。":57},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_004.ks","relPath":"/data/scenario/SC_E_004.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":58,"length":58,"percent":100},"cellInfo":[[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"t":"HU","v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[54,1],"note":"完成"},"/data/scenario/SC_E_005.ks":{"data":[["@rもう。","@r真是的。"],["なに？","怎么了？"],["ああ。","啊啊。"],["滞り無く進んでるのね。","进展很顺利嘛。"],["はいはい。","好啦好啦。"],["初段は済んだと。","第一阶段已经完成了。"],["@rもう殆ど揃ったの？","@r差不多人都到齐了吧？"],["あーノートも来た…え。","啊-Note也来了…呃。"],["まだ？","还没？"],["珍しい。","真稀奇。"],["ふうん。","哼嗯。"],["@r解ってるはずだけど、\n基本的には手出し無用だよ。","@r你应该明白的，\n原则上禁止擅自插手哦。"],["特にノートとEnder、あとIronには重ねて念押ししといてよ。","尤其要反复叮嘱Note和Ender，还有Iron让他们记牢。"],["@rあ、９の彼女のとこにも人回しといて。","@r啊，9她那边也派个人过去。"],["なんか、色々不測の事態が起きてる風なんだよね。","总觉得好像发生了各种意外状况呢。"],["狩りは仮ってね、愉快な遊戯になりそうで結構なんだけど。","狩猎暂且先不提，看样子会变成一场有趣的游戏，倒也不错呢。"],["そうか、全員向こう待機でもいいな。","这样啊，全员在那边待命也行。"],["それは？駄目なの？","不行吗？"],["Ender、９のガードに回せば良いじゃない。","让Ender去护卫9不就好了。"],["Ironはくっついてくでしょそうすれば。","Iron肯定会跟着去的吧。"],["ノートは言うこと聞かなそうだからしょうがないけど。","Note那家伙估计不会听话，那就没办法了。"],["@r…にしてもぉー、\nあんまり開封が順調だと、\nちょっと淋しいな。","@r…不过啊—\n如果解封进展太顺利的话，\n反而有点寂寞呢。"],["兄様には内緒にしといて欲しいんだけど、\n最近彼のこと、\nなんか、","希望你能对兄长大人保密呢，\n最近对他，\n那个，"],["結構いいかも。","总感觉还挺不错的。"],["と思って来ちゃったんだよねー。","就这么想着想着就变成这样了—"],["@r三重偉大の完成に期待するのも良いかな、\nそういう事になると。","@r期待三重伟大的完成也不错呢，\n就是这么回事。"],["悲劇は喜劇って言うしね。","悲剧也被称为喜剧嘛。"],["十三番目の劇は喜劇にしたいところだなー。","第十三场剧真想做成喜剧啊ー。"],["Deusの評価は客次第、\n私は好きなんだけど。","Deus的评价取决于观众，\n虽然我个人挺喜欢的。"],["嫌いな客も多いだろうから。","但讨厌的观众应该也不少吧。"],["黒衣の…","黑衣的…"],["@rえ？","@r咦？"],["あー彼女に気を遣った訳じゃないよ。","啊ー不是刻意关照她啦。"],["何か最近思い詰めた風で心配ではあるけど、\n猫も持ってないし大丈夫だとは思うよ。","只是最近看她总是一副钻牛角尖的样子有点担心，\n不过她也没持有猫应该没事的。"],["私の姿勢の変遷には影響してないね。","对我的立场转变没影响啦。"],["@r彼が気になるのはね、","@r我在意的是他啦，"],["もうすぐ無くなるものとか、\n他人が欲しがってるものはさ、","快要绝版的东西啊，\n别人都想要的东西啊，"],["自分が確保したくなるでしょお？","自己就会忍不住想囤货对吧ー？"],["『在庫残り３個です』","『库存仅剩3件』"],["とか、","之类的，"],["人が買おうかどうか迷ってるの視ると、\n思わずカートに入れちゃうでしょお？","看到别人犹豫要不要买的时候，\n就会不自觉加入购物车对吧ー？"],["それとも、","或者说，"],["遅い発情期かな。","难道是迟来的发情期？"],["…冗談だって。","…开玩笑的。"],["ま、兄様に怒られない程度にね。","嘛，只要别惹兄长大人生气就行。"],["@rあとさところで、ノート、何か仕組んでない？","@r对了,话说Note是不是动了什么手脚？"],["ツェロル回収とは別に何かしてる気がするな。","总觉得除了回收赛萝洛还搞了别的名堂。"],["不正操作は好みじゃないよ？","不正当操作可不受欢迎哦？"],["私も兄様も。","我也是兄长大人也是。"],["ずーーーーーーっと兄様に懸想してる割に、\n分ぁかってないからなあ。","明明ーーーーーー一直单恋着兄长大人，\n却完全搞不懂他在想什么呢ー。"],["@rじゃ、こっちはこっちで。","@r那就各走各路吧。"],["少しは愉しませてもらうね。","让我也稍微享受下乐趣。"],["みんなによろしくいっといて。","替我向大家问好。"],["@rじゃまた、うん。","@r那就这样，嗯。"],["はーい。","好ー的。"]],"context":[["SC_E_005.ks/index/1/text"],["SC_E_005.ks/index/3/text"],["SC_E_005.ks/index/5/text"],["SC_E_005.ks/index/7/text"],["SC_E_005.ks/index/9/text"],["SC_E_005.ks/index/11/text"],["SC_E_005.ks/index/13/text"],["SC_E_005.ks/index/15/text"],["SC_E_005.ks/index/17/text"],["SC_E_005.ks/index/19/text"],["SC_E_005.ks/index/21/text"],["SC_E_005.ks/index/23/text"],["SC_E_005.ks/index/25/text"],["SC_E_005.ks/index/27/text"],["SC_E_005.ks/index/29/text"],["SC_E_005.ks/index/31/text"],["SC_E_005.ks/index/33/text"],["SC_E_005.ks/index/35/text"],["SC_E_005.ks/index/37/text"],["SC_E_005.ks/index/39/text"],["SC_E_005.ks/index/41/text"],["SC_E_005.ks/index/43/text"],["SC_E_005.ks/index/45/text"],["SC_E_005.ks/index/47/text"],["SC_E_005.ks/index/49/text"],["SC_E_005.ks/index/51/text"],["SC_E_005.ks/index/53/text"],["SC_E_005.ks/index/55/text"],["SC_E_005.ks/index/57/text"],["SC_E_005.ks/index/59/text"],["SC_E_005.ks/index/61/text"],["SC_E_005.ks/index/63/text"],["SC_E_005.ks/index/65/text"],["SC_E_005.ks/index/67/text"],["SC_E_005.ks/index/69/text"],["SC_E_005.ks/index/71/text"],["SC_E_005.ks/index/73/text"],["SC_E_005.ks/index/75/text"],["SC_E_005.ks/index/77/text"],["SC_E_005.ks/index/79/text"],["SC_E_005.ks/index/81/text"],["SC_E_005.ks/index/83/text"],["SC_E_005.ks/index/85/text"],["SC_E_005.ks/index/87/text"],["SC_E_005.ks/index/89/text"],["SC_E_005.ks/index/91/text"],["SC_E_005.ks/index/93/text"],["SC_E_005.ks/index/95/text"],["SC_E_005.ks/index/97/text"],["SC_E_005.ks/index/99/text"],["SC_E_005.ks/index/101/text"],["SC_E_005.ks/index/103/text"],["SC_E_005.ks/index/105/text"],["SC_E_005.ks/index/107/text"],["SC_E_005.ks/index/109/text"]],"tags":[],"parameters":[[{"start":163,"end":170}],[{"start":176,"end":179}],[{"start":185,"end":188}],[{"start":194,"end":205}],[{"start":211,"end":216}],[{"start":222,"end":230}],[{"start":244,"end":257}],[{"start":263,"end":274}],[{"start":280,"end":283}],[{"start":289,"end":293}],[{"start":299,"end":303}],[{"start":317,"end":349}],[{"start":355,"end":387}],[{"start":401,"end":423}],[{"start":429,"end":452}],[{"start":458,"end":485}],[{"start":491,"end":508}],[{"start":514,"end":523}],[{"start":529,"end":551}],[{"start":557,"end":577}],[{"start":583,"end":608}],[{"start":622,"end":665}],[{"start":671,"end":711}],[{"start":717,"end":724}],[{"start":730,"end":745}],[{"start":759,"end":797}],[{"start":803,"end":815}],[{"start":821,"end":841}],[{"start":847,"end":874}],[{"start":880,"end":893}],[{"start":899,"end":903}],[{"start":917,"end":923}],[{"start":929,"end":946}],[{"start":952,"end":995}],[{"start":1001,"end":1018}],[{"start":1032,"end":1046}],[{"start":1052,"end":1084}],[{"start":1090,"end":1105}],[{"start":1111,"end":1121}],[{"start":1127,"end":1130}],[{"start":1136,"end":1176}],[{"start":1182,"end":1187}],[{"start":1193,"end":1201}],[{"start":1207,"end":1214}],[{"start":1220,"end":1235}],[{"start":1249,"end":1274}],[{"start":1280,"end":1301}],[{"start":1307,"end":1320}],[{"start":1326,"end":1332}],[{"start":1338,"end":1375}],[{"start":1389,"end":1405}],[{"start":1411,"end":1424}],[{"start":1430,"end":1444}],[{"start":1458,"end":1470}],[{"start":1476,"end":1480}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_005.ks","basename":"SC_E_005.ks","indexIds":{"@rもう。":0,"なに？":1,"ああ。":2,"滞り無く進んでるのね。":3,"はいはい。":4,"初段は済んだと。":5,"@rもう殆ど揃ったの？":6,"あーノートも来た…え。":7,"まだ？":8,"珍しい。":9,"ふうん。":10,"@r解ってるはずだけど、\n基本的には手出し無用だよ。":11,"特にノートとEnder、あとIronには重ねて念押ししといてよ。":12,"@rあ、９の彼女のとこにも人回しといて。":13,"なんか、色々不測の事態が起きてる風なんだよね。":14,"狩りは仮ってね、愉快な遊戯になりそうで結構なんだけど。":15,"そうか、全員向こう待機でもいいな。":16,"それは？駄目なの？":17,"Ender、９のガードに回せば良いじゃない。":18,"Ironはくっついてくでしょそうすれば。":19,"ノートは言うこと聞かなそうだからしょうがないけど。":20,"@r…にしてもぉー、\nあんまり開封が順調だと、\nちょっと淋しいな。":21,"兄様には内緒にしといて欲しいんだけど、\n最近彼のこと、\nなんか、":22,"結構いいかも。":23,"と思って来ちゃったんだよねー。":24,"@r三重偉大の完成に期待するのも良いかな、\nそういう事になると。":25,"悲劇は喜劇って言うしね。":26,"十三番目の劇は喜劇にしたいところだなー。":27,"Deusの評価は客次第、\n私は好きなんだけど。":28,"嫌いな客も多いだろうから。":29,"黒衣の…":30,"@rえ？":31,"あー彼女に気を遣った訳じゃないよ。":32,"何か最近思い詰めた風で心配ではあるけど、\n猫も持ってないし大丈夫だとは思うよ。":33,"私の姿勢の変遷には影響してないね。":34,"@r彼が気になるのはね、":35,"もうすぐ無くなるものとか、\n他人が欲しがってるものはさ、":36,"自分が確保したくなるでしょお？":37,"『在庫残り３個です』":38,"とか、":39,"人が買おうかどうか迷ってるの視ると、\n思わずカートに入れちゃうでしょお？":40,"それとも、":41,"遅い発情期かな。":42,"…冗談だって。":43,"ま、兄様に怒られない程度にね。":44,"@rあとさところで、ノート、何か仕組んでない？":45,"ツェロル回収とは別に何かしてる気がするな。":46,"不正操作は好みじゃないよ？":47,"私も兄様も。":48,"ずーーーーーーっと兄様に懸想してる割に、\n分ぁかってないからなあ。":49,"@rじゃ、こっちはこっちで。":50,"少しは愉しませてもらうね。":51,"みんなによろしくいっといて。":52,"@rじゃまた、うん。":53,"はーい。":54},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_005.ks","relPath":"/data/scenario/SC_E_005.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":55,"length":55,"percent":100},"cellInfo":[null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[46,0],"note":"完成"},"/data/scenario/SC_E_006.ks":{"data":[["生物は雌が基本型としてあるのでは、という夢想にかられる。","不禁幻想生物或许都以雌性为基本型。"],["\nある種の微生物は環境が良であれば誕生するものは雌性であり、\n環境の悪化に伴い雄性が現れる。","\n某些微生物在环境优良时诞生的都是雌性，\n环境恶化时才会出现雄性。"],["\nある種の魚は集団内の雌雄比率に応じて性転換を行う。","\n某些鱼类会根据群体内的雌雄比例进行性别转换。"],["\n無論、夢想妄念の類だ。","\n当然，这都是痴心妄想。"],["\n先に雄性が成熟し雌性に変換する例もある。","\n也存在雄性先成熟再转化为雌性的例子。"],["\n蜂は単為生殖で生まれる個体は全て雄で、有性生殖でないと雌は生まれない。","\n蜜蜂单性生殖的个体全是雄蜂，必须有性生殖才能诞生雌蜂。"],["両性具有。","雌雄同体。"],["\n曖昧な性差。","\n暧昧的性别差异。"],["\n雌雄という認識がそもそも。","\n所谓雌雄的概念本身。"],["\n所詮は、ヒトが見出し発見したと思いこんでいる知識。","\n终究只是人类自以为发现的认知罢了。"],["\nその領域での、有限たるルールの中での夢想。","\n不过是局限领域内，有限规则中的幻想。"],["全てが。","世间万物。"],["\n在るだけで。","\n存在即合理。"],["\n不完全さも内包した完全さ。","\n连不完美都包容的完美。"],["\nその領域での思索ではない。","\n这已超出那个领域的思考范畴。"],["私の","我的"],["疚しき意識のステージ。","负罪意识的舞台。"],["\n私が女であることからの思い入れは否めない。","\n无法否认我作为女性的执念。"],["\nしかしてそれすらも世界より生じてここに在るモノだ。","\n但连这份执念也是世界孕育的产物。"],["\nＸＸ。","\nＸＸ。"],["\nＸＹ。","\nＸＹ。"],["\n異物たる男、","\n作为异物的男性，"],["三","三"],["色の猫、三重偉大。","色之猫，三重伟大。"],["mtEVE。","mtEVE。"],["\n途切れることのない女の血統。","\n从未断绝的女性血统。"],["\n続く血統。無限の増殖。カンサーの如く。","\n延续的血脉。无限的增殖。宛如癌变。"],["\nアリスの見出し魔女の猫。","\n爱丽丝发现的魔女之猫。"],["\nパラミアキスの子ら。","\n帕拉米亚基斯的孩子们。"],["\nかの國に失せた雄の","\n在那个国度消失的雄性"],["裔。","末裔。"],["\n久しく途切れた雄の。","\n久未现世的雄性。"],["誕生発生は種の危機なのか。","诞生现象是物种的危机吗。"],["\n単為生殖有性生殖性転換。","\n单性生殖有性生殖性别转换。"],["\nエネルギーの転換機構。","\n能量的转换机制。"],["\n他から奪い己のものとする制約。","\n从他人处掠夺并据为己有的限制。"],["\n他の生物を捕食することが前提にある。","\n以捕食其他生物为前提。"],["\n殺し合いの舞台たるこの世界。","\n作为杀戮舞台的这个世界。"],["それでもなお。","即便如此。"],["\n生物の振る舞いに意味などあるのか。","\n生物的行为有何意义可言。"],["\n情報の複製伝達。","\n信息的复制传递。"],["\nヒトの意識など複雑構造の反応の表出にすぎない。","\n人类的意识不过是复杂结构反应的表象。"],["\n主体などではない。","\n并非主体。"],["\nそれが生命ではない。","\n那并非生命。"],["\n私の命題。","\n我的命题。"],["勝敗でも善し悪しでもないと、ある人物が云っている。","无关胜负亦不论善恶，某人曾如此说道。"],["\nそう。","\n没错。"],["\n好きか嫌いか。","\n喜欢或厌恶。"],["\n私の愛するモノのために思い判断し動くこと。","\n为我所爱之物思虑判断并行动。"],["\n全ては狩りだ。","\n一切皆为狩猎。"],["視る眼を。","凝视之眼。"],["\n見る女をみる雌を。","\n注视女人注视雌性。"],["\nミルメを。","\n注视着米尔梅。"],["\n存続させ続けるための果て無き業苦。","\n为延续存在的无尽业苦。"],["観測者無くして世界無し。","无观测者则无世界。"],["\n意識を持つ存在の意義――世界の観測。","\n具意识之存在的意义――观测世界。"],["\n在るとたらしめること。","\n令其存在。"],["\n記録の蔵庫――ＷＣＬ。","\n记录的宝库――WCL。"],["\n最強の白のために、","\n为了最强的白，"],["@r@r@r@r@r@r@r","@r@r@r@r@r@r@r"],["わたしはあるべくしてあるもの。","我是理应存在之物。"]],"context":[["SC_E_006.ks/index/1/text"],["SC_E_006.ks/index/3/text"],["SC_E_006.ks/index/5/text"],["SC_E_006.ks/index/7/text"],["SC_E_006.ks/index/9/text"],["SC_E_006.ks/index/11/text"],["SC_E_006.ks/index/13/text"],["SC_E_006.ks/index/15/text"],["SC_E_006.ks/index/17/text"],["SC_E_006.ks/index/19/text"],["SC_E_006.ks/index/21/text"],["SC_E_006.ks/index/23/text"],["SC_E_006.ks/index/25/text"],["SC_E_006.ks/index/27/text"],["SC_E_006.ks/index/29/text"],["SC_E_006.ks/index/31/text"],["SC_E_006.ks/index/33/text"],["SC_E_006.ks/index/35/text"],["SC_E_006.ks/index/37/text"],["SC_E_006.ks/index/39/text"],["SC_E_006.ks/index/41/text"],["SC_E_006.ks/index/43/text"],["SC_E_006.ks/index/45/text"],["SC_E_006.ks/index/47/text"],["SC_E_006.ks/index/49/text"],["SC_E_006.ks/index/51/text"],["SC_E_006.ks/index/53/text"],["SC_E_006.ks/index/55/text"],["SC_E_006.ks/index/57/text"],["SC_E_006.ks/index/59/text"],["SC_E_006.ks/index/61/text"],["SC_E_006.ks/index/63/text"],["SC_E_006.ks/index/65/text"],["SC_E_006.ks/index/67/text"],["SC_E_006.ks/index/69/text"],["SC_E_006.ks/index/71/text"],["SC_E_006.ks/index/73/text"],["SC_E_006.ks/index/75/text"],["SC_E_006.ks/index/77/text"],["SC_E_006.ks/index/79/text"],["SC_E_006.ks/index/81/text"],["SC_E_006.ks/index/83/text"],["SC_E_006.ks/index/85/text"],["SC_E_006.ks/index/87/text"],["SC_E_006.ks/index/89/text"],["SC_E_006.ks/index/91/text"],["SC_E_006.ks/index/93/text"],["SC_E_006.ks/index/95/text"],["SC_E_006.ks/index/97/text"],["SC_E_006.ks/index/99/text"],["SC_E_006.ks/index/101/text"],["SC_E_006.ks/index/103/text"],["SC_E_006.ks/index/105/text"],["SC_E_006.ks/index/107/text"],["SC_E_006.ks/index/109/text"],["SC_E_006.ks/index/111/text"],["SC_E_006.ks/index/113/text"],["SC_E_006.ks/index/115/text"],["SC_E_006.ks/index/117/text"],["SC_E_006.ks/index/119/text"],["SC_E_006.ks/index/122/text"]],"tags":[],"parameters":[[{"start":128,"end":156}],[{"start":160,"end":216}],[{"start":220,"end":252}],[{"start":256,"end":274}],[{"start":278,"end":305}],[{"start":309,"end":351}],[{"start":367,"end":372}],[{"start":376,"end":389}],[{"start":393,"end":413}],[{"start":417,"end":449}],[{"start":453,"end":481}],[{"start":497,"end":501}],[{"start":505,"end":518}],[{"start":522,"end":542}],[{"start":546,"end":566}],[{"start":582,"end":584}],[{"start":596,"end":607}],[{"start":611,"end":639}],[{"start":643,"end":675}],[{"start":679,"end":689}],[{"start":693,"end":703}],[{"start":707,"end":720}],[{"start":731,"end":732}],[{"start":744,"end":753}],[{"start":769,"end":775}],[{"start":779,"end":800}],[{"start":804,"end":830}],[{"start":834,"end":853}],[{"start":857,"end":874}],[{"start":878,"end":894}],[{"start":906,"end":908}],[{"start":912,"end":929}],[{"start":945,"end":958}],[{"start":962,"end":981}],[{"start":985,"end":1003}],[{"start":1007,"end":1029}],[{"start":1033,"end":1058}],[{"start":1062,"end":1083}],[{"start":1099,"end":1106}],[{"start":1110,"end":1134}],[{"start":1138,"end":1153}],[{"start":1157,"end":1187}],[{"start":1191,"end":1207}],[{"start":1211,"end":1228}],[{"start":1232,"end":1244}],[{"start":1260,"end":1285}],[{"start":1289,"end":1299}],[{"start":1303,"end":1317}],[{"start":1321,"end":1349}],[{"start":1353,"end":1367}],[{"start":1383,"end":1388}],[{"start":1392,"end":1408}],[{"start":1412,"end":1424}],[{"start":1428,"end":1452}],[{"start":1468,"end":1480}],[{"start":1484,"end":1509}],[{"start":1513,"end":1531}],[{"start":1535,"end":1553}],[{"start":1557,"end":1573}],[{"start":1624,"end":1648}],[{"start":1677,"end":1692}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_006.ks","basename":"SC_E_006.ks","indexIds":{"生物は雌が基本型としてあるのでは、という夢想にかられる。":0,"\nある種の微生物は環境が良であれば誕生するものは雌性であり、\n環境の悪化に伴い雄性が現れる。":1,"\nある種の魚は集団内の雌雄比率に応じて性転換を行う。":2,"\n無論、夢想妄念の類だ。":3,"\n先に雄性が成熟し雌性に変換する例もある。":4,"\n蜂は単為生殖で生まれる個体は全て雄で、有性生殖でないと雌は生まれない。":5,"両性具有。":6,"\n曖昧な性差。":7,"\n雌雄という認識がそもそも。":8,"\n所詮は、ヒトが見出し発見したと思いこんでいる知識。":9,"\nその領域での、有限たるルールの中での夢想。":10,"全てが。":11,"\n在るだけで。":12,"\n不完全さも内包した完全さ。":13,"\nその領域での思索ではない。":14,"私の":15,"疚しき意識のステージ。":16,"\n私が女であることからの思い入れは否めない。":17,"\nしかしてそれすらも世界より生じてここに在るモノだ。":18,"\nＸＸ。":19,"\nＸＹ。":20,"\n異物たる男、":21,"三":22,"色の猫、三重偉大。":23,"mtEVE。":24,"\n途切れることのない女の血統。":25,"\n続く血統。無限の増殖。カンサーの如く。":26,"\nアリスの見出し魔女の猫。":27,"\nパラミアキスの子ら。":28,"\nかの國に失せた雄の":29,"裔。":30,"\n久しく途切れた雄の。":31,"誕生発生は種の危機なのか。":32,"\n単為生殖有性生殖性転換。":33,"\nエネルギーの転換機構。":34,"\n他から奪い己のものとする制約。":35,"\n他の生物を捕食することが前提にある。":36,"\n殺し合いの舞台たるこの世界。":37,"それでもなお。":38,"\n生物の振る舞いに意味などあるのか。":39,"\n情報の複製伝達。":40,"\nヒトの意識など複雑構造の反応の表出にすぎない。":41,"\n主体などではない。":42,"\nそれが生命ではない。":43,"\n私の命題。":44,"勝敗でも善し悪しでもないと、ある人物が云っている。":45,"\nそう。":46,"\n好きか嫌いか。":47,"\n私の愛するモノのために思い判断し動くこと。":48,"\n全ては狩りだ。":49,"視る眼を。":50,"\n見る女をみる雌を。":51,"\nミルメを。":52,"\n存続させ続けるための果て無き業苦。":53,"観測者無くして世界無し。":54,"\n意識を持つ存在の意義――世界の観測。":55,"\n在るとたらしめること。":56,"\n記録の蔵庫――ＷＣＬ。":57,"\n最強の白のために、":58,"@r@r@r@r@r@r@r":59,"わたしはあるべくしてあるもの。":60},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_006.ks","relPath":"/data/scenario/SC_E_006.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":61,"length":61,"percent":100},"cellInfo":[null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"t":"HU"}],[null,{"t":"HU"}],null,[null,{"t":"HU"}],null,[null,{"t":"HU"}],null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"t":"HU","v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[59,1],"note":"完成"},"/data/scenario/SC_E_007.ks":{"data":[["窓の外を視る。","望向窗外。"],["景色の全てから彩度が消失したかの如く、\n灰色と化した街並。[l]\nコンクリートの建造物によって構成され、\n塵や煙霧のフィルターが掛けられたこの國の中央都市、\nだがそんなことは関係がない。[l]\n私の田舎とても、この状況では同じく\nモノクロォムの視界を為す。","仿佛景色中的所有饱和度都消失了般，\n化作灰色的街景。[l]\n由混凝土建筑构成的，\n笼罩在尘雾滤镜下的这个国家中央都市，\n但这些都无关紧要。[l]\n即便在我的故乡，这般情形下同样\n会形成单色视野。"],["強雨である。","暴雨如注。"],["うんざりする。[l]\n私の置かれた此の場の状況にも。[l]\n天候湿度気圧云々は私にとって重要な要素だ。[l]\nこんな多湿かつ低気圧では思考が乱れる。[l]\n苛々する。[l]\n早く話を終わらせて眠りたい。[l]\nなのに。","令人厌烦。[l]\n对我所处此地的状况亦是如此。[l]\n天气湿度气压等因素对我至关重要。[l]\n如此潮湿且低气压会扰乱思考。[l]\n烦躁不堪。[l]\n想快点结束对话去睡觉。[l]\n可是。"],["「ええ、まだ遣えません。[l]\nツキノモノが来るまで――動かすことは。[l]\n折角迎えに来て頂いたんですが、\nこればっかりはどうしようも――」","「是的，现在还不行。[l]\n在月之物到来前――不可轻举妄动。[l]\n虽承蒙您专程迎接，\n唯独这件事实在――」"],["私『達』が従わざるを得ない眼前のひとは\nどうにも狼狽していて、\n――私をささくれ立たせる一端となっているのだった。[l]\nこのひどい気候と共に。","我『们』不得不服从的眼前之人\n显得相当狼狈，\n――这正成为令我暴躁的部分原因。[l]\n与这恶劣气候共同作用。"],["……只でさえこれは猫、なのだ。[l]\n見立てであろうとも。[l]\n餌をやっただけで手懐けられるものなら苦労はいらない。[l]\n綾目は特殊な例だ。[l]\n私は、厭だ。","……本来这就是猫，啊。[l]\n即便只是推测。[l]\n若投喂就能驯服倒省事了。[l]\n绫目是特例。[l]\n我，很讨厌。"],["いつだって此奴等は自己中心に振る舞い、\n私らはまるで奴等の人形だ。[l]\nどっちが操作され遣われているのか判ったものではない。[l]\n動くも動かざるも向こうの都合次第。[l]\n向こうがそうしようと思えば擦り寄っても来ようが、\nこちらが必要とするなら代価を要求する。[l]\n物の喩えだがそういう事だ。","无论何时这帮家伙都我行我素地行动，\n我们简直像是他们的提线木偶。[l]\n根本搞不清到底是谁在操控谁。[l]\n动或不动全凭他们心情。[l]\n只要他们想，就算倒贴也会凑过来，\n若是我们有所求就得付出代价。[l]\n打个比方就是这么回事。"],["しかし、\n未だかつて私も遭った事はないし、これからもそれは御免で、\nそもそもその為に（つまりは逢わずに済むように）心を砕いてきたその相手、\n白の連中とやらは、\n完全に統制された奴等を遣うときく。[l]\nそれではもう猫じゃないじゃないか。[l]\nそれか遣う者が猫の王なのかだ。[l]\n私達の猫は……[l]\n…ああ、気分が悪い。[l]\nそう、在る程度自在に使役する遣り方がないでもないが、\n綾目は特殊な例だ。[l]\n私は、やりたくない。","但是，\n我至今没遇到过，今后也不想碰见，\n说到底就是为了避免碰面（也就是为了不相见）费尽心思的那个对象，\n所谓的白之众，\n听说驱使的都是完全受控的家伙。[l]\n那根本就不是猫了吧。[l]\n要么就是驱使它们的是猫之王？[l]\n我们的猫……[l]\n…啊啊，真恶心。[l]\n不过嘛，某种程度上自由使唤的方法倒也不是没有，\n绫目是特例。[l]\n我，不想这么做。"],["「綾目のように――と云いたい処ですが、\n貴女には今の状況で無理はさせたくありません。[l]\n幸い","「虽然想说‘要像绫目那样――’，\n不过，目前这种状况下，我不想勉强您。[l]\n幸好"],["道","道"],["具が彼女のと一緒にこちらに\n来て応急処置しています。[l]\n致し方在りませんが、貴女のが動かせるまでは\nそれで何とかするしかないわ」","具和她一起来到\n这边做应急处理了。[l]\n实在没办法，在您能行动之前\n只能靠这个凑合了」"],["「トモが？[l]\n","「道具？[l]\n"],["奇","是奇"],["士が来てるのですか。[l]\nま――祭の日程が確定しない限り、\n…しても守るかどうか知りませんが[l]\n面倒臭がって動かないような奴かと思ってましたが」","士来了吗。[l]\n只要祭典的日程还没定下来，\n……就算（做了什么），也不知道能不能守住就是了[l]\n不过我还以为她是个嫌麻烦不肯动的家伙呢」"],["「喚んだわ。[l]\n確かに、やけに素直でしたけど。[l]\n今回は流石に事が事ですからね、\nあれも少しは考えたのでしょう。[l]\n東部と西部の八相が一同に会する祭、\n今年はあの方までいらっしゃるというのに、\nそれがあのような事が起きた上に今度は冬夏が」","「叫来了。[l]\n确实，意外地老实呢。[l]\n毕竟这次事态严重，\n那孩子多少也考虑了吧。[l]\n东部与西部八相齐聚的祭典，\n今年连那位大人都要莅临，\n偏偏在这种节骨眼上冬夏又…」"],["「落ち着いてくださいよ」","「请冷静」"],["「…ごめんなさい。[l]\n今はミハルもオオクロも、繋がっていないし\n不安で仕方ないのよ。[l]\nあの方が来るまでに何とかしないと…[l]\n西部の裏刀自様も冬夏には\n――最悪の場合には、\n貴女には悪いけど綾目と同じ事をして貰わなければ」","「…抱歉。[l]\n现在既联系不上米哈尔也联系不上大黑，\n我实在不安得要命。[l]\n在那位大人到来前必须想办法…[l]\n西部里刀自大人对冬夏\n――最坏的情况下，\n虽然对您很抱歉，但可能得让您和绫目遭受同样待遇」"],["嫌だ。[l]\nが、口には出さない。","不要。[l]\n但没说出口。"],["「そうならずに済む事を祈りますが。[l]\n私だって道具の世話にはなりたくないですから。[l]\nようよう母から受け継ぎましたが、全く重荷ですね。[l]\n今回の事が無くても母は早死にしそう\nでしたよ端から見てて。[l]\nもう少し遣い勝手が良ければ好かったのでしょうにね。[l]\nそれにしてもお嬢様も何をお考えなのか…」","「但愿不会走到那一步。[l]\n我也不想受道具照顾啊。[l]\n虽然从母亲那儿继承了这些，真是沉重的负担呢。[l]\n就算没这次的事，母亲看起来也快短命了\n从我旁观的角度看。[l]\n要是用起来更顺手就好了呢。[l]\n话说回来大小姐到底在打什么主意…」"],["彼女に関しての不思議を言えば、\nそもそも生まれた時からの話だが、\n今更我らの　","若要说关于她的不可思议之处，\n其实得从出生时说起，\n事到如今　"],["理　に疑問を持つとは。[l]\n何代にも渡ってそのような異分子は存在しなかったと言うのに。[l]\n猫を知った者は……[l]\n…ああ、そろそろ本当に辛い。[l]\n早く休ませて欲しい。[l]\n――お嬢様さえ無茶な事をしなければ、\n少しはコトが単純に済んだだろうに。[l]\n●を●●るなど正気の沙汰ではない\nどうせ●●する事を知っている筈なのに。[l]\nつまりは、\n明確な抗議行動ということだ。[l]\nそんな無意味な事をしなければ、\n少しはコトが単純に済んだだろうに。","竟然对我们的 “理” 产生了质疑。[l]\n历代都未曾出现过这样的异端分子。[l]\n知晓猫之事的家伙……[l]\n…啊，真的快撑不住了。[l]\n让我早点休息吧。[l]\n――只要大小姐别做那些荒唐事，\n事情本可以简单些的。[l]\n●出●●这种事绝非理智之举\n明明早该知道会●●的。[l]\n也就是说，\n这是明确的抗议行为。[l]\n若不做那些无意义的事，\n事情本可以简单些的。"],["事が起こり過ぎだ。","变故实在太多了。"],["「ところで道具はお屋敷に？」","「话说道具在宅邸吗？」"],["「あの娘が診療所に寝泊まりするって聞かないから\nそうしたわ」","「没听说那孩子要在诊所过夜\n就安排她过去了」"],["「！[l]\nなんですそれは？！」","「！[l]\n这算什么？！」"],["「仕方ないでしょう。[l]\n別に良いでしょ貴女達仲良かったのではなくて？」","「没办法呀。[l]\n反正你们关系也不好，无所谓吧？」"],["………。[l]\n他人の眼とは解らないものだ。[l]\nそう視えていたのか。","………。[l]\n他人的眼光总是难以揣度。[l]\n原来在他们眼里是这样。"],["「世の中論理じゃないものね。[l]\nとにかくもう過ぎた事よ、\n従って頂戴」","「世间果然不讲逻辑呢。[l]\n总之都是过去的事了，\n请服从安排」"],["言い訳にもなっていない。","这连借口都算不上。"],["「裏刀自様とあのお方はうちに御逗留戴きますけどね。[l]\n玖威もそう。[l]\n……祭儀は予定通りに行わなければなりません。[l]\nずれ込みは避けなければ。[l]\n今回に限っては」","「里刀自大人和那位会暂住我们这儿。[l]\n玖威也是。[l]\n……祭仪必须如期举行。[l]\n绝不能延误。[l]\n唯独这次」"],["Miriam.SHOBが来る。","Miriam.SHOB要来了。"],["私のナガヒサの力を施さねばならない。[l]\n彼女の猫はもう限界近いと聞いている。[l]\nベロアの第十相とやらは不完全な為に、\n私のナガヒサに当たる――主に第三相に不全が生じたらしい。[l]\n猫に関して詳しい事は知らない。[l]\n知りたいわけでもない。[l]\n眼前の事で精一杯だ。[l]\n使役場が限定されたチカラなどに興味はない。[l]\nトモとは違う。[l]\nあれは愉しんでいる。異常なまでに興味を持ち執心している。[l]\n私はあんなじゃない。","必须施展我的纳伽希萨的力量。[l]\n听说她的猫已接近极限。[l]\n由于贝萝娅第十相的不完整，\n影响到我的纳伽希萨――主要是第三相出现了缺陷。[l]\n我对猫的详情并不了解。[l]\n也没兴趣了解。[l]\n眼前的事已够我焦头烂额。[l]\n对受限于使役场的力量毫无兴趣。[l]\n和道具不一样。[l]\n那家伙乐在其中。异常执着地沉迷于此。[l]\n我才不是那样。"],["いずれ祭の時、４月３０日は特別な日だ。[l]\n全員が揃い実際に猫を動かそうという事は稀だ。[l]\n今までは餌の問題が――\nその猫達への餌を意のままに出来れば。[l]\nその先鞭としてアヤメがキサムラと共に犯した禁忌が如き所業――","待到祭典之时，4月30日是个特殊日子。[l]\n全员齐聚实际操控猫的情况很罕见。[l]\n至今都是饲料问题――\n若能自由掌控那些猫的饲料。[l]\n作为先例的绫目与奇士共同犯下的禁忌般行径――"],["ああ。[l]\n苛立つ。","啊。[l]\n真令人烦躁。"],["何故今になって。","为何偏偏是现在。"],["冬夏を視た選律が言い始めた事だが、\nその冬夏がこんな事になり、誰かに二人も殺されて――","那是曾见过冬夏的选律所讲述的事情，\n但如今冬夏变成这样，还连累两人被杀――"],["事が起こり過ぎている。[l]\n余計な事が。","变故实在太多了。[l]\n尽是节外生枝。"],["「あの方がいよいよ、冬夏達を姉妹になさるのかも\n知れない。[l]\n貴女も勿論その一人。羨ましいわ」","「那位大人说不定终于要让冬夏她们\n成为姐妹。[l]\n你自然也是其中一员。真令人羡慕」"],["それは――別に構わない。[l]\n使役場の限定解除が為されるのなら。[l]\n私達はその為に永年、\n連綿とこの血とネコのカミを伝えてきたのだし。[l]\nある種ある程度の犠牲は伴ってきたが。[l]\n八相家の存在意義はそれなのだから。[l]\nその流れに逆らう程の理由があるわけでも無い。","那倒――无所谓。[l]\n只要使役场的限定解除能够完成。[l]\n我们为此长年累月，\n连绵不绝地传承着这份血脉与猫神。[l]\n虽然伴随着某种程度的牺牲。[l]\n这就是八相家存在的意义。[l]\n也没有非要逆流而上的理由。"],["「母や","「那杀害母亲和"],["遊","游"],["女さんを殺した奴はどうするんです」","女的人要怎么处理」"],["「祭を優先させるわよ。[l]\n早急に事を成せばそのような一切は瑣事となる、と仰せです。[l]\n綾目と狩屋には動いて貰っているけど」","「优先举行祭典吧。[l]\n那位大人说只要迅速成事，这些都会变成琐碎小事。[l]\n虽然已经让绫目和狩屋去行动了」"],["瑣事――だというか。[l]\n身内の生命が絶たれても、否、\n関係ないのか。","琐事――或者说。[l]\n即使至亲的生命被夺走，不，\n都无关紧要吗。"],["「――。[l]\n向こうは晴れていれば良いですがね。[l]\n湿度高いのは苦手なんです。[l]\n生理的に気持ち悪くて苛々と」","「――。[l]\n只要那边天气晴朗就好。[l]\n我讨厌湿度高的环境。[l]\n生理上会恶心烦躁」"],["「この混迷した状況に関して云えば、\n心の底からそう思うわ」","「关于这混乱的局面，\n我打心底这么认为」"],["そして私達は立ち上がった。","于是我们站了起来。"]],"context":[["SC_E_007.ks/index/1/text","SC_E_007.ks/index/92/text"],["SC_E_007.ks/index/3/text"],["SC_E_007.ks/index/5/text"],["SC_E_007.ks/index/7/text"],["SC_E_007.ks/index/9/text"],["SC_E_007.ks/index/11/text"],["SC_E_007.ks/index/13/text"],["SC_E_007.ks/index/15/text"],["SC_E_007.ks/index/17/text"],["SC_E_007.ks/index/19/text"],["SC_E_007.ks/index/21/text"],["SC_E_007.ks/index/23/text"],["SC_E_007.ks/index/25/text"],["SC_E_007.ks/index/28/text"],["SC_E_007.ks/index/30/text"],["SC_E_007.ks/index/32/text"],["SC_E_007.ks/index/34/text"],["SC_E_007.ks/index/36/text"],["SC_E_007.ks/index/38/text"],["SC_E_007.ks/index/40/text"],["SC_E_007.ks/index/42/text"],["SC_E_007.ks/index/44/text"],["SC_E_007.ks/index/46/text"],["SC_E_007.ks/index/48/text"],["SC_E_007.ks/index/50/text"],["SC_E_007.ks/index/52/text"],["SC_E_007.ks/index/54/text"],["SC_E_007.ks/index/56/text"],["SC_E_007.ks/index/58/text"],["SC_E_007.ks/index/60/text"],["SC_E_007.ks/index/62/text"],["SC_E_007.ks/index/64/text"],["SC_E_007.ks/index/66/text"],["SC_E_007.ks/index/68/text"],["SC_E_007.ks/index/70/text"],["SC_E_007.ks/index/72/text"],["SC_E_007.ks/index/74/text"],["SC_E_007.ks/index/76/text"],["SC_E_007.ks/index/78/text"],["SC_E_007.ks/index/80/text"],["SC_E_007.ks/index/82/text"],["SC_E_007.ks/index/84/text"],["SC_E_007.ks/index/86/text"],["SC_E_007.ks/index/88/text"],["SC_E_007.ks/index/90/text"],["SC_E_007.ks/index/94/text"],["SC_E_007.ks/index/96/text"],["SC_E_007.ks/index/98/text"]],"tags":[],"parameters":[[{"start":182,"end":189},{"start":4184,"end":4191}],[{"start":201,"end":353}],[{"start":365,"end":371}],[{"start":383,"end":516}],[{"start":540,"end":623}],[{"start":635,"end":719}],[{"start":731,"end":829}],[{"start":841,"end":1014}],[{"start":1028,"end":1288}],[{"start":1313,"end":1369}],[{"start":1381,"end":1382}],[{"start":1394,"end":1472}],[{"start":1496,"end":1505}],[{"start":1521,"end":1522}],[{"start":1534,"end":1621}],[{"start":1646,"end":1795}],[{"start":1819,"end":1831}],[{"start":1856,"end":1997}],[{"start":2009,"end":2030}],[{"start":2054,"end":2235}],[{"start":2247,"end":2294}],[{"start":2308,"end":2586}],[{"start":2598,"end":2607}],[{"start":2631,"end":2645}],[{"start":2670,"end":2704}],[{"start":2728,"end":2748}],[{"start":2773,"end":2814}],[{"start":2826,"end":2870}],[{"start":2895,"end":2940}],[{"start":2952,"end":2964}],[{"start":2989,"end":3094}],[{"start":3106,"end":3121}],[{"start":3133,"end":3394}],[{"start":3406,"end":3535}],[{"start":3549,"end":3566}],[{"start":3580,"end":3588}],[{"start":3602,"end":3649}],[{"start":3663,"end":3688}],[{"start":3713,"end":3770}],[{"start":3784,"end":3947}],[{"start":3971,"end":3974}],[{"start":3985,"end":3986}],[{"start":3997,"end":4014}],[{"start":4039,"end":4112}],[{"start":4126,"end":4170}],[{"start":4215,"end":4287}],[{"start":4312,"end":4345}],[{"start":4359,"end":4372}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_007.ks","basename":"SC_E_007.ks","indexIds":{"窓の外を視る。":0,"景色の全てから彩度が消失したかの如く、\n灰色と化した街並。[l]\nコンクリートの建造物によって構成され、\n塵や煙霧のフィルターが掛けられたこの國の中央都市、\nだがそんなことは関係がない。[l]\n私の田舎とても、この状況では同じく\nモノクロォムの視界を為す。":1,"強雨である。":2,"うんざりする。[l]\n私の置かれた此の場の状況にも。[l]\n天候湿度気圧云々は私にとって重要な要素だ。[l]\nこんな多湿かつ低気圧では思考が乱れる。[l]\n苛々する。[l]\n早く話を終わらせて眠りたい。[l]\nなのに。":3,"「ええ、まだ遣えません。[l]\nツキノモノが来るまで――動かすことは。[l]\n折角迎えに来て頂いたんですが、\nこればっかりはどうしようも――」":4,"私『達』が従わざるを得ない眼前のひとは\nどうにも狼狽していて、\n――私をささくれ立たせる一端となっているのだった。[l]\nこのひどい気候と共に。":5,"……只でさえこれは猫、なのだ。[l]\n見立てであろうとも。[l]\n餌をやっただけで手懐けられるものなら苦労はいらない。[l]\n綾目は特殊な例だ。[l]\n私は、厭だ。":6,"いつだって此奴等は自己中心に振る舞い、\n私らはまるで奴等の人形だ。[l]\nどっちが操作され遣われているのか判ったものではない。[l]\n動くも動かざるも向こうの都合次第。[l]\n向こうがそうしようと思えば擦り寄っても来ようが、\nこちらが必要とするなら代価を要求する。[l]\n物の喩えだがそういう事だ。":7,"しかし、\n未だかつて私も遭った事はないし、これからもそれは御免で、\nそもそもその為に（つまりは逢わずに済むように）心を砕いてきたその相手、\n白の連中とやらは、\n完全に統制された奴等を遣うときく。[l]\nそれではもう猫じゃないじゃないか。[l]\nそれか遣う者が猫の王なのかだ。[l]\n私達の猫は……[l]\n…ああ、気分が悪い。[l]\nそう、在る程度自在に使役する遣り方がないでもないが、\n綾目は特殊な例だ。[l]\n私は、やりたくない。":8,"「綾目のように――と云いたい処ですが、\n貴女には今の状況で無理はさせたくありません。[l]\n幸い":9,"道":10,"具が彼女のと一緒にこちらに\n来て応急処置しています。[l]\n致し方在りませんが、貴女のが動かせるまでは\nそれで何とかするしかないわ」":11,"「トモが？[l]\n":12,"奇":13,"士が来てるのですか。[l]\nま――祭の日程が確定しない限り、\n…しても守るかどうか知りませんが[l]\n面倒臭がって動かないような奴かと思ってましたが」":14,"「喚んだわ。[l]\n確かに、やけに素直でしたけど。[l]\n今回は流石に事が事ですからね、\nあれも少しは考えたのでしょう。[l]\n東部と西部の八相が一同に会する祭、\n今年はあの方までいらっしゃるというのに、\nそれがあのような事が起きた上に今度は冬夏が」":15,"「落ち着いてくださいよ」":16,"「…ごめんなさい。[l]\n今はミハルもオオクロも、繋がっていないし\n不安で仕方ないのよ。[l]\nあの方が来るまでに何とかしないと…[l]\n西部の裏刀自様も冬夏には\n――最悪の場合には、\n貴女には悪いけど綾目と同じ事をして貰わなければ」":17,"嫌だ。[l]\nが、口には出さない。":18,"「そうならずに済む事を祈りますが。[l]\n私だって道具の世話にはなりたくないですから。[l]\nようよう母から受け継ぎましたが、全く重荷ですね。[l]\n今回の事が無くても母は早死にしそう\nでしたよ端から見てて。[l]\nもう少し遣い勝手が良ければ好かったのでしょうにね。[l]\nそれにしてもお嬢様も何をお考えなのか…」":19,"彼女に関しての不思議を言えば、\nそもそも生まれた時からの話だが、\n今更我らの　":20,"理　に疑問を持つとは。[l]\n何代にも渡ってそのような異分子は存在しなかったと言うのに。[l]\n猫を知った者は……[l]\n…ああ、そろそろ本当に辛い。[l]\n早く休ませて欲しい。[l]\n――お嬢様さえ無茶な事をしなければ、\n少しはコトが単純に済んだだろうに。[l]\n●を●●るなど正気の沙汰ではない\nどうせ●●する事を知っている筈なのに。[l]\nつまりは、\n明確な抗議行動ということだ。[l]\nそんな無意味な事をしなければ、\n少しはコトが単純に済んだだろうに。":21,"事が起こり過ぎだ。":22,"「ところで道具はお屋敷に？」":23,"「あの娘が診療所に寝泊まりするって聞かないから\nそうしたわ」":24,"「！[l]\nなんですそれは？！」":25,"「仕方ないでしょう。[l]\n別に良いでしょ貴女達仲良かったのではなくて？」":26,"………。[l]\n他人の眼とは解らないものだ。[l]\nそう視えていたのか。":27,"「世の中論理じゃないものね。[l]\nとにかくもう過ぎた事よ、\n従って頂戴」":28,"言い訳にもなっていない。":29,"「裏刀自様とあのお方はうちに御逗留戴きますけどね。[l]\n玖威もそう。[l]\n……祭儀は予定通りに行わなければなりません。[l]\nずれ込みは避けなければ。[l]\n今回に限っては」":30,"Miriam.SHOBが来る。":31,"私のナガヒサの力を施さねばならない。[l]\n彼女の猫はもう限界近いと聞いている。[l]\nベロアの第十相とやらは不完全な為に、\n私のナガヒサに当たる――主に第三相に不全が生じたらしい。[l]\n猫に関して詳しい事は知らない。[l]\n知りたいわけでもない。[l]\n眼前の事で精一杯だ。[l]\n使役場が限定されたチカラなどに興味はない。[l]\nトモとは違う。[l]\nあれは愉しんでいる。異常なまでに興味を持ち執心している。[l]\n私はあんなじゃない。":32,"いずれ祭の時、４月３０日は特別な日だ。[l]\n全員が揃い実際に猫を動かそうという事は稀だ。[l]\n今までは餌の問題が――\nその猫達への餌を意のままに出来れば。[l]\nその先鞭としてアヤメがキサムラと共に犯した禁忌が如き所業――":33,"ああ。[l]\n苛立つ。":34,"何故今になって。":35,"冬夏を視た選律が言い始めた事だが、\nその冬夏がこんな事になり、誰かに二人も殺されて――":36,"事が起こり過ぎている。[l]\n余計な事が。":37,"「あの方がいよいよ、冬夏達を姉妹になさるのかも\n知れない。[l]\n貴女も勿論その一人。羨ましいわ」":38,"それは――別に構わない。[l]\n使役場の限定解除が為されるのなら。[l]\n私達はその為に永年、\n連綿とこの血とネコのカミを伝えてきたのだし。[l]\nある種ある程度の犠牲は伴ってきたが。[l]\n八相家の存在意義はそれなのだから。[l]\nその流れに逆らう程の理由があるわけでも無い。":39,"「母や":40,"遊":41,"女さんを殺した奴はどうするんです」":42,"「祭を優先させるわよ。[l]\n早急に事を成せばそのような一切は瑣事となる、と仰せです。[l]\n綾目と狩屋には動いて貰っているけど」":43,"瑣事――だというか。[l]\n身内の生命が絶たれても、否、\n関係ないのか。":44,"「――。[l]\n向こうは晴れていれば良いですがね。[l]\n湿度高いのは苦手なんです。[l]\n生理的に気持ち悪くて苛々と」":45,"「この混迷した状況に関して云えば、\n心の底からそう思うわ」":46,"そして私達は立ち上がった。":47},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_007.ks","relPath":"/data/scenario/SC_E_007.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":48,"length":48,"percent":100},"cellInfo":[null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[37,0],"note":"完成"},"/data/scenario/SC_E_008.ks":{"data":[["みみゃるみゃるきゃめきゃきゃらこねみゃるかやわ\nみたさたさきゃなさめきゃらきゃらきゃらわ","mi mya ru mi mya ru kya me kya kya ra ko ne mi mya ru ka ya wa\nmi ta sa ta sa kya na sa me kya ra kya ra kya ra wa"],["一相\n愛し尊し我が身の死、死のみが和、死貴しといい\n夷と死と疎し和神の紙、紙のみが儂と疎し問い\n","一相\n爱矣尊矣吾身之死，唯死为和，死乃贵兮\n夷与死与疏和神之纸，唯纸与吾疏兮问\n"],["二相\n我がけもの身の我が誰とても”やそ”の如、\n読み返すれば黒十字の刻\n識式は死期色の檻、織と如きもの見張りたる\n","二相\n吾孤身之，吾无论何人皆如”此般”，\n若重读则为黑十字之刻\n识式乃死期色之槛，如织者见守之\n"],["三相\n無量を霧は伐り斬り断り手、露めらが是とするならば伏し\n","三相\n无量之雾伐斩断之手，若露所言此为正道则伏地\n"],["四相\n秘も化神、葉煎らす子と泣く待つ滝の御身、\n河原図百々無父子ともに\n","四相\n秘亦化神，煎叶之子泣待瀑之御身，\n共赴河原图景中万千无父无子之境\n"],["五相\n人の火となる神鳴る雷、全てを統べり殊玉言霊\n","五相\n为人火之神鸣雷，统御万物殊玉言灵\n"],["六相\n身と魂盗り合い武者、鎖腐りて茅ノ輪が忌の空\n","六相\n互盗身魂之武者，锁腐忌空茅之轮\n"],["七相\n憎しき首切れ夷と化して、久遠の鬼神身を立て誇らん\n","七相\n斩憎恶之首化夷而立，久远鬼神夸耀其身\n"],["八相\n ","八相\n "],["禍 ","祸 "],["霊 ","灵 "],["役 ","役 "],["降 ","降 "],["王、祭と烏合の終、","王，祭与乌合之终，"],["是より白の月、不一\n","自此白月，不一\n"],["番外\nふたつたりぬは玄の寝子に、これにてさらばと月跳ね狂え\n","例外\n双失玄寝子，就此别过月跃狂兮\n"],["※以下確保済\n","※以下已确保\n"],["九相異羽\nありすはちの首木をはずしたるこの羽を憑かせ呼びたるつくはねと、しかし故に軛\n","九相异羽\n解首木之艾莉丝凭此羽唤名筑羽根，然故为轭\n"],["十相飯食\n玄の寝子、偽を統べて真の内に有り、巣を血で塗る眼の美絵となるかは白も知ろうことなきか\n","十相饭食\n玄寝子统伪存真，血涂巢眼成美绘兮白亦不知乎\n"]],"context":[["SC_E_008.ks/index/1/text"],["SC_E_008.ks/index/3/text"],["SC_E_008.ks/index/6/text"],["SC_E_008.ks/index/9/text"],["SC_E_008.ks/index/12/text"],["SC_E_008.ks/index/15/text"],["SC_E_008.ks/index/18/text"],["SC_E_008.ks/index/21/text"],["SC_E_008.ks/index/24/text"],["SC_E_008.ks/index/26/text"],["SC_E_008.ks/index/28/text"],["SC_E_008.ks/index/30/text"],["SC_E_008.ks/index/32/text"],["SC_E_008.ks/index/34/text"],["SC_E_008.ks/index/36/text"],["SC_E_008.ks/index/39/text"],["SC_E_008.ks/index/42/text"],["SC_E_008.ks/index/45/text"],["SC_E_008.ks/index/48/text"]],"tags":[],"parameters":[[{"start":186,"end":234}],[{"start":248,"end":304}],[{"start":320,"end":389}],[{"start":405,"end":439}],[{"start":455,"end":499}],[{"start":515,"end":544}],[{"start":560,"end":589}],[{"start":605,"end":637}],[{"start":653,"end":658}],[{"start":674,"end":676}],[{"start":688,"end":690}],[{"start":703,"end":705}],[{"start":717,"end":719}],[{"start":731,"end":740}],[{"start":752,"end":762}],[{"start":778,"end":812}],[{"start":828,"end":835}],[{"start":851,"end":898}],[{"start":914,"end":966}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_008.ks","basename":"SC_E_008.ks","indexIds":{"みみゃるみゃるきゃめきゃきゃらこねみゃるかやわ\nみたさたさきゃなさめきゃらきゃらきゃらわ":0,"一相\n愛し尊し我が身の死、死のみが和、死貴しといい\n夷と死と疎し和神の紙、紙のみが儂と疎し問い\n":1,"二相\n我がけもの身の我が誰とても”やそ”の如、\n読み返すれば黒十字の刻\n識式は死期色の檻、織と如きもの見張りたる\n":2,"三相\n無量を霧は伐り斬り断り手、露めらが是とするならば伏し\n":3,"四相\n秘も化神、葉煎らす子と泣く待つ滝の御身、\n河原図百々無父子ともに\n":4,"五相\n人の火となる神鳴る雷、全てを統べり殊玉言霊\n":5,"六相\n身と魂盗り合い武者、鎖腐りて茅ノ輪が忌の空\n":6,"七相\n憎しき首切れ夷と化して、久遠の鬼神身を立て誇らん\n":7,"八相\n ":8,"禍 ":9,"霊 ":10,"役 ":11,"降 ":12,"王、祭と烏合の終、":13,"是より白の月、不一\n":14,"番外\nふたつたりぬは玄の寝子に、これにてさらばと月跳ね狂え\n":15,"※以下確保済\n":16,"九相異羽\nありすはちの首木をはずしたるこの羽を憑かせ呼びたるつくはねと、しかし故に軛\n":17,"十相飯食\n玄の寝子、偽を統べて真の内に有り、巣を血で塗る眼の美絵となるかは白も知ろうことなきか\n":18},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_008.ks","relPath":"/data/scenario/SC_E_008.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":19,"length":19,"percent":100},"cellInfo":[[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[2,0],"note":"完成"},"/data/scenario/SC_E_009.ks":{"data":[["可笑しいな。","真奇怪啊。"],["いや、おかしいな。","不，太奇怪了。"],["あったよ。[l]\nLunatic Leap、把握してるのとは違うのが。","找到了。[l]\nLunatic Leap，和掌握的情报不同。"],["変だ。[l]\nこれ、此処の連中に造れる筈ないんだけどなあ。","不对劲。[l]\n这玩意，这里的家伙应该造不出来才对啊。"],["赤の女王の猫…は考え難いし、[l]\nどういうことだろうねえ。","赤之女王的猫…这难以想象，[l]\n到底是怎么回事呢。"],["WCLのIg以外で封紙を創れる事なんか有り得ないよねえ。[l]\nしかも大量？[l]\nどゆことだ。","除了WCL的Ig之外不可能有人能制作封纸的吧。[l]\n而且还是大量？[l]\n搞什么啊。"],["Igも無いのにカミにフウじる？[l]\nIgはもはやWCLの専売、\n大体にして野猫がそもそもそう簡単に…[l]\nん？[l]\nだからツェロル回収の話を？[l]\nだとしたら何で私が知らなかったのさ、今まで。[l]\n変な隠し事とかして…るとしたらあの女か。","连Ig都没有就想对神进行封印？[l]\nIg早已是WCL的专卖品，\n说到底野猫本来就不可能这么轻易就...[l]\n嗯？[l]\n所以才会提到赛萝洛回收的事？[l]\n要真是这样为什么我一直不知情啊。[l]\n如果是有人偷偷搞鬼...那就是那个女人了吧。"],["それとも、\n単に見逃してた月狂跳なのかなあ。[l]\n否、\n新しい上に操作の跡もあるんだよ。[l]\n純粋な封紙じゃない、相の強化を試みた跡もある、\nセキュリティまで掛かってる、起動音が要るぽいんだなあ。[l]\n私の知らないパターンだなあ。[l]\n解除出来なくはないけど、\nそういう問題じゃないでしょ。[l]\nこれがほんとのOut Of Place Artifactsだね、\n場違いもいいところ、\n今此処に在ってはいけないもの、\nんーむ、というか、これは…","又或者，\n单纯是我看漏的月狂跳吗。[l]\n不对，\n这不仅是新品还留有操作痕迹。[l]\n不是纯粹的封纸，能看到尝试强化相的痕迹，\n甚至还加了安全锁，好像需要启动音的样子。[l]\n是我没见过的类型呢。[l]\n倒也不是不能解除，\n但问题不在这里吧。[l]\n这才是真正的Out Of Place Artifacts呢，\n何止是格格不入，\n是此刻绝不该出现在此处的物品，\n嗯——或者说这是..."],["視えなくても構わないものを創ろうとしてるのかな？[l]\n魔眼資質が無かろうと、\n猫の側で一方的に宿主を定めて…か……[l]\n成功するかなそんな試み。[l]\n饗すべき血は…受肉か？それはＹの…[l]\nそういえばLinkableFormの話もあったか…[l]\n大体そんなことして何になるって、\n──あれらによるLu･Leの再興か。","难道是想制造即使看不见也无所谓的东西？[l]\n就算没有魔眼资质，\n也能通过猫单方面选定宿主...吗...[l]\n这种尝试真能成功吗。[l]\n需要献祭的血脉是...受肉？难道是Y的...[l]\n说起来确实有过LinkableForm的传闻...[l]\n说到底做这种事有什么意义，\n——原来是想靠那些东西复兴Lu・Le吗。"],["私が言えた義理じゃないけど、\n本末転倒だね、猫が魔女を選ぶなんて。[l]\nどちらが使い魔か分からないよ。[l]\nまあ使い魔は、常に召喚者を出し抜こうと虎視眈々なのが常だし、\n","虽然我也没资格说别人，\n这根本是本末倒置啊，让猫来选择魔女。[l]\n都分不清谁才是使魔了。[l]\n不过使魔本来就总是虎视眈眈想反噬召唤者，\n"],["強ち間違ってもいないか。ふふふ。[l]\nでもいずれ調査はしといた方が好いよねえ。[l]\n想定の外の話だし。","倒也不算全错呢。呵呵。[l]\n但总之还是调查下比较好吧。[l]\n毕竟是超出预期的情况。"],["…で、ノートは何してる？[l]\nは？[l]\n内部からの流出を疑うのは当然でしょ。[l]\nさっきから言ってるよね、\n何で八相の連中がこんなのを持ってるんだよ。[l]\nこそこそ動けるのはあの女だけだし、\n仮にSHOBがツェロルその他、把握してたって無理なんだ。[l]\nWCLの場合は下っ端疑ったってしょうがないからね。","...话说Note在干嘛？[l]\n啊？[l]\n怀疑内部泄密很正常吧。[l]\n我从刚才就在说了，\n为什么八相的人会持有这种东西。[l]\n能偷偷行动的只有那个女人，\n就算SHOB掌握了赛萝洛和其他情报也做不到。[l]\nWCL的情况怀疑底层人员也没用啊。"],["そうだよ。[l]\nあの女の事だからバレないとでも思ったとは考えられない。[l]\nもしそうでないなら見縊られたものだけど。[l]\nだからこれは確信的背信行為、明確な抗議行動――…","没错。[l]\n以她的性格不可能觉得能瞒天过海。[l]\n如果不是这样就是我们被小看了。[l]\n所以这是确凿的背叛行为，明确的抗议行动――..."],["え？確信犯じゃ意味が違うでしょお。[l]\n知ってる癖に。[l]\n試したの？私を。[l]\nん、そう。[l]\nどっちでもいいんだけどね。[l]\nもしあの女の仕業ならその言い回しでも或る意味当たってるしね。[l]\n全く、赤の女王じゃあるまいし、\n愛に殉ずるなんて迷惑極まりない行為…[l]\n他人の事は言えないって？[l]\nそうだね。ふふ。","哎？说是确信犯的话意思就不一样了呀。[l]\n明明知道还这样。[l]\n是在试探我吗？[l]\n嗯，是啊。[l]\n不过怎样都无所谓啦。[l]\n如果是她干的，那种说法某种意义上也算没错。[l]\n真是的，又不是赤之女王，\n为爱殉情这种给人添麻烦的行为...[l]\n你说我没资格说别人？[l]\n确实呢。呵呵。"],["にしてもあーっっもうっ！[l]\n…取り敢えずは放置でいいか。[l]\n面倒起こすなら起こすで、こっちの大義名分も立つからね。[l]\n大体この程度のアクシデントに対応できないで『彼』の\n顕現なんか有り得ないよ。[l]\nでもまあ一応、ツェロル探しも積極的にやった方が良いのかな私は。[l]\nどうやらあの女を追っかけてると自然と行き着きそうだし。[l]\nもし自分で隠匿してたとなれば重大な造反行為だ。","即便如此啊——真是的！[l]\n…暂时放着不管也行吧。[l]\n要是惹麻烦就尽管惹，反正我们这边也有正当理由。[l]\n连这种程度的意外都处理不了的话\n『他』的显现根本不可能啦。[l]\n不过嘛，我是不是也该积极搜寻赛萝洛比较好？[l]\n毕竟追查那女人的话似乎自然就能找到线索。[l]\n如果是她自己藏匿起来就是严重的造反行为了。"],["という訳で、八相とLu･Leはまあ、予定通りでいいんじゃない。[l]\n彼の","所以呢，八相和Lu･Le就按原计划进行吧。[l]\n会成为他的"],["遊","遊"],["戯","戏"],["相","伙"],["手になるでしょ。[l]\nこの狩の庭でのね。[l]\n私？[l]\n面白そうならって、最初言った通り。[l]\nあの女、邪魔しないかちょっと様子視てないとね。[l]\n愉快が至上の私らしくないって？[l]\n","伴吧。[l]\n在这个狩猎庭院里。[l]\n我？[l]\n就像最初说的，有趣的话就参与。[l]\n得盯着点那女人会不会碍事才行。[l]\n说这不像以愉悦至上的我？[l]\n"],["彼","那"],["奴みたいなのは別だよ。[l]\n分かってるでしょお？[l]\n察してよ。","家伙是例外啦。[l]\n你明白的吧？[l]\n懂我意思嘛。"],["馬鹿女、兄様の眼をどうしても惹きたいのか。[l]\nもし一線を越えたら、\nやりすぎたなら、\n――とほうもない報いを与えてやるよ。[l]\n兄様が何と言おうと排除、削除して貰う。[l]\nさもなければ私がやるさ。[l]\n場合によっては喰ってあげるのも佳いかもね。[l]\n『喰い殺す』方で。[l]\nま、或る意味本望でしょ。[l]\n私に喰われるなら。","蠢女人，就这么想吸引兄长大人的目光吗。[l]\n要是越界的话，\n做得太过火的话，\n――我会给予超乎想象的惩罚哦。[l]\n就算兄长大人反对也要清除掉。[l]\n不然就由我来动手。[l]\n视情况吃掉也不错呢。[l]\n用『啃食致死』的方式。[l]\n嘛，某种意义上也算求仁得仁吧。[l]\n如果是被我吃掉的话。"],["蠅の物そのものを叩き潰すか現象だけを潰すか。[l]\nはたまた両方か。[l]\n人生美味礼讃、形而下の食、\n魔眼者の視界、形而上の食、\nどっちにしても不要なモノは吐くし下すさ。[l]\n分割された不全の６には出来ないこと。[l]\n……いいってもうこの話題は。[l]\n不愉快。[l]\nあんなの眼中に入れておけないよ。","是把苍蝇本体拍碎还是只消灭现象呢。[l]\n或者双管齐下？[l]\n人生美味礼赞，物质层面的进食，\n魔眼者的视界，精神层面的进食，\n反正多余的东西都会吐出来或排出去。[l]\n这是分裂残缺的6做不到的事。[l]\n……这个话题到此为止。[l]\n不愉快。[l]\n那种东西根本不配入眼。"],["彼の今後ね。[l]\nま、取り敢えず魔眼はちゃんと起動してたようだし。[l]\nイーハももう起こしてある。[l]\nイーハに引っ張られて、\n身体の方からは寄ってくるかも。[l]\nもう八相の何人かと接触もしてるし、封紙と強く結んだ女は反応しててもおかしくないねえ。","关于他的未来啦。[l]\n嘛，总之魔眼似乎顺利启动了。[l]\n伊哈也早就唤醒了。[l]\n被伊哈牵引着，\n肉体那边可能也会靠过来。[l]\n已经接触过几个八相成员了，和封纸紧密相连的女人有反应也不奇怪。"],["恋に落ちてたりしてねえ。ふふふふ。[l]\nまあそうならないように鈴を着けたんだけど、\n寝たままのイーハに反応できるほどの資質者が居た場合は\nもう遅いかもね。[l]\nどうだろうなー、\nそんなに強く結んでたら『猫の萌芽（ツェロル）』みたいに侵蝕されてるよ。","说不定正坠入爱河呢。呵呵呵呵。[l]\n虽然装了铃铛防止这种事，\n但如果有人资质强到能感应沉睡的伊哈，\n可能就来不及阻止了。[l]\n谁知道呢——\n联系太紧密的话会像『猫之萌芽（赛萝洛）』那样被侵蚀哦。"],["ああ、予想してない事というのは面白いけど疲れるね。[l]\nにしても事が起こりすぎてるなあ…","啊，预料之外的事虽然有趣但真累人啊。[l]\n不过事态发展得也太密集了…"],["これはもしかするともしかするねぇ…[l]\n雫……","这该不会真的是…[l]\n雫……"],["流石は私の兄様、色々見越してたか。","不愧是我的兄长大人，早就预料到各种情况了吧。"],["さあ、奴らの祭儀、どうなるかな。[l]\n何か楽しくなってきたかも。","来吧，看看那群人的祭仪会变成怎样。[l]\n好像变得有点意思了呢。"],["あーっと、どうしようかな。[l]\nやっぱり、……[l]\n９もこっち喚びだしとこうかなあ。[l]\nEnder達もくるのはしょうがない。[l]\nその代わりしっかり張り付かせといてよ。","啊—呃，该怎么办呢。[l]\n果然还是，……[l]\n9也召唤过来吧。[l]\nEnder们会来也是没办法的事。[l]\n但要把他们牢牢固定住哦。"],["異","异"],["羽、あれ","羽，那个是叫"],["憑","凭"],["羽だっけ？[l]\nいずれあれも揃ってないとしょうがないし、\n今の状況だと即座に動かせるとこに置いた方がよさそう…え？[l]\nああ、聞いてるよ。[l]\nなんか例の男子について気になる事があるとかないとか？[l]\n私らとは違うミアキスの子の筋。[l]\n雫に近しかった存在だから、\n確かに色々ありそうではあるんだけど…","羽来着？[l]\n反正那些不凑齐也没办法，\n现在这状况还是放在能立即调动的地方比较好吧…咦？[l]\n啊，我在听。[l]\n关于那个男生有什么在意的事吗？[l]\n和我们不同体系的米亚基斯孩子。[l]\n因为是曾接近雫的存在，\n确实感觉会有很多故事…"],["この遊びが終わったら詳しくは聞くよ。[l]\nこの状況に犬まで絡んだらもう大変なことになるよ。[l]\n犬の扱いに関しては現時点で完全にキャパ超えでしょう。[l]\n土俗のオオカミと憑物筋かぁ…[l]\n ","等这场游戏结束再详细问你。[l]\n要是连狗都掺和进来可就真麻烦了。[l]\n现阶段完全超出处理犬类的能力范围了吧。[l]\n乡野的狼和凭物血脉啊…[l]\n "],["狼 ","狼 "],["天を","征讨"],["討ち","上天"],["犬","终成"],["神となりしか？[l]\n興味はあるけどもぉ……[l]\n今は眼の前の事を処理。[l]\n何しろ事がおかしな方向に行ってるようだし、\n次への前振りだと思っておけば、愉しくもなるかな。","犬神？[l]\n虽然有兴趣但…[l]\n现在先处理眼前的事。[l]\n毕竟事态正往奇怪方向发展，\n当作下个阶段的铺垫的话，或许会变得有趣呢。"],["場合によっては、私も猫かぶるのやめるね。[l]\n遊んでる余裕が無くなったら、\n早めに『彼』に自覚して貰って、早々に戦力ユニットに組み込もう。[l]\n問題はどの『彼』を選ぶかだけど。[l]\nまだ迷ってるよ、そりゃ。","必要时我就不装乖猫了。[l]\n要是没余裕再玩下去，\n就早点让『他』觉醒，尽快编入战斗单元。[l]\n问题在于选哪个『他』。[l]\n还在犹豫啦，这个。"],["猫は獲物を、仕留める前に甚振るものでしょ。[l]\n獲物がどれかって？[l]\nうひひ。[l]\nさ、どれでしょうか。[l]\n美味しそうなんだもん、食べたくなっちゃうのを、\n兄様への貞操が抑えてるんだから、\n少しは慰みがあっても…ね？","猫在猎杀前都会玩弄猎物对吧。[l]\n问猎物是哪个？[l]\n嘻嘻。[l]\n来猜猜是哪个呢。[l]\n看起来太美味了，忍不住想吃掉，\n全靠对兄长大人的忠贞在压抑着，\n稍微找点乐子也没关系吧…？"],["冗談はさておき、\n『彼』に関してはね。[l]\n雫絡みだったらそもそもどうしようもないし。[l]\n騒ぎそうな人間が一人いるし…","玩笑先放一边，\n关于『他』的事。[l]\n要是涉及雫就根本无计可施。[l]\n还有个可能会闹腾的人类…"],["さて、そろそろ話終わりで良いかい？[l]\n君と喋ると取り留めなく話題シフトしたり会話時間延びたりして\nよくわかんなくなるんだよ。[l]\n君は察してくれるからまだ通じるけどさ。","好了，差不多该结束对话了吧？[l]\n和你说话总会话题跳脱又拖长时间\n搞得我都糊涂了。[l]\n你能理解所以还能沟通啦。"],["はいはい、私も最優先命題は忘れてない…と思うよ。[l]\nんむ？[l]\nメモしないことは忘れる性質なんだよ私は。[l]\nはいはい、はーい。[l]\n敵は●●。","知道知道，我也没忘首要命题…大概。[l]\n嗯唔？[l]\n不记备忘录就会忘事是我的特性嘛。[l]\n好啦好啦，知—道了。[l]\n敌人是●●。"],["あーもう。[l]\n飽きたら抜けるって言ったけど、\nそうもいかないか…[l]\nやりたくは無いけど、\nほんとに飽きたら強行モードに行っちゃうかもだよ。[l]\n建設創造の快楽とそれを破壊する快感愉悦は常に背中合わせ、\nドミノ然り？[l]\n砂の曼荼羅然り？","啊真是的。[l]\n虽然说过腻了就退出，\n看来行不通呢…[l]\n虽然不想这么做，\n真腻了可能会强行切换模式哦。[l]\n建设创造的快乐与破坏的快感总是如影随形，\n多米诺如此？[l]\n沙曼荼罗亦如此？"],["え？[l]\n抑圧からの解放によるカタルシスは違うよ。[l]\nあんなの単なるギャップによる相対的感覚差の擬似感情でしょう。[l]\n零位からでないと意味が無い。[l]\nただ強行モードはなー。[l]\nあの馬鹿女の遣り方みたいで厭なんだよなー。[l]\nこうなったら、\n『彼』には頑張って貰わないと。[l]\n福音光輝十二の悲劇はほんとに痛々しい話だったからね。","啊？[l]\n因压抑得到释放产生的快感可不一样哦。[l]\n那种不过是因反差导致的相对感觉差异的伪感情罢了。[l]\n不从零开始就没有意义。[l]\n但强行模式啊——[l]\n跟那个蠢女人的做法似的真让人不爽啊——[l]\n事到如今，\n只能让『他』加把劲了。[l]\n福音光辉十二悲剧可是个惨痛的故事呢。"],["なんだかなぁ、\n私もまだまだ遊戯の支配者として未熟だと痛感です。[l]\n皆には迷惑かけてすまないね。[l]\n出来れば生暖かく見守ってよ。[l]\nありがとう。","该怎么说呢，\n我也深刻体会到作为游戏管理者还不够成熟。[l]\n给大家添麻烦真对不起啦。[l]\n可能的话请温柔地守护我吧。[l]\n谢谢。"]],"context":[["SC_E_009.ks/index/1/text"],["SC_E_009.ks/index/3/text"],["SC_E_009.ks/index/5/text"],["SC_E_009.ks/index/7/text"],["SC_E_009.ks/index/9/text"],["SC_E_009.ks/index/11/text"],["SC_E_009.ks/index/13/text"],["SC_E_009.ks/index/15/text"],["SC_E_009.ks/index/17/text"],["SC_E_009.ks/index/19/text"],["SC_E_009.ks/index/22/text"],["SC_E_009.ks/index/24/text"],["SC_E_009.ks/index/26/text"],["SC_E_009.ks/index/28/text"],["SC_E_009.ks/index/30/text"],["SC_E_009.ks/index/32/text"],["SC_E_009.ks/index/34/text"],["SC_E_009.ks/index/36/text"],["SC_E_009.ks/index/38/text"],["SC_E_009.ks/index/40/text"],["SC_E_009.ks/index/43/text"],["SC_E_009.ks/index/45/text"],["SC_E_009.ks/index/47/text"],["SC_E_009.ks/index/49/text"],["SC_E_009.ks/index/51/text"],["SC_E_009.ks/index/53/text"],["SC_E_009.ks/index/55/text"],["SC_E_009.ks/index/57/text"],["SC_E_009.ks/index/59/text"],["SC_E_009.ks/index/61/text"],["SC_E_009.ks/index/63/text"],["SC_E_009.ks/index/65/text"],["SC_E_009.ks/index/67/text"],["SC_E_009.ks/index/69/text"],["SC_E_009.ks/index/71/text"],["SC_E_009.ks/index/73/text"],["SC_E_009.ks/index/75/text"],["SC_E_009.ks/index/77/text"],["SC_E_009.ks/index/79/text"],["SC_E_009.ks/index/81/text"],["SC_E_009.ks/index/83/text"],["SC_E_009.ks/index/85/text"],["SC_E_009.ks/index/87/text"],["SC_E_009.ks/index/89/text"],["SC_E_009.ks/index/91/text"],["SC_E_009.ks/index/93/text"],["SC_E_009.ks/index/95/text"],["SC_E_009.ks/index/97/text"],["SC_E_009.ks/index/99/text"]],"tags":[],"parameters":[[{"start":166,"end":172}],[{"start":186,"end":195}],[{"start":209,"end":248}],[{"start":262,"end":295}],[{"start":309,"end":343}],[{"start":357,"end":413}],[{"start":427,"end":575}],[{"start":589,"end":863}],[{"start":877,"end":1068}],[{"start":1082,"end":1181}],[{"start":1198,"end":1259}],[{"start":1273,"end":1458}],[{"start":1472,"end":1572}],[{"start":1586,"end":1788}],[{"start":1802,"end":2026}],[{"start":2040,"end":2081}],[{"start":2093,"end":2094}],[{"start":2105,"end":2106}],[{"start":2118,"end":2119}],[{"start":2130,"end":2248}],[{"start":2264,"end":2265}],[{"start":2276,"end":2318}],[{"start":2332,"end":2537}],[{"start":2551,"end":2737}],[{"start":2751,"end":2899}],[{"start":2913,"end":3059}],[{"start":3073,"end":3122}],[{"start":3136,"end":3164}],[{"start":3178,"end":3195}],[{"start":3209,"end":3246}],[{"start":3260,"end":3365}],[{"start":3391,"end":3392}],[{"start":3403,"end":3407}],[{"start":3419,"end":3420}],[{"start":3432,"end":3616}],[{"start":3630,"end":3742}],[{"start":3759,"end":3761}],[{"start":3773,"end":3775}],[{"start":3786,"end":3788}],[{"start":3800,"end":3801}],[{"start":3813,"end":3916}],[{"start":3930,"end":4052}],[{"start":4066,"end":4204}],[{"start":4218,"end":4292}],[{"start":4306,"end":4405}],[{"start":4419,"end":4512}],[{"start":4526,"end":4678}],[{"start":4692,"end":4899}],[{"start":4913,"end":5007}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_009.ks","basename":"SC_E_009.ks","indexIds":{"可笑しいな。":0,"いや、おかしいな。":1,"あったよ。[l]\nLunatic Leap、把握してるのとは違うのが。":2,"変だ。[l]\nこれ、此処の連中に造れる筈ないんだけどなあ。":3,"赤の女王の猫…は考え難いし、[l]\nどういうことだろうねえ。":4,"WCLのIg以外で封紙を創れる事なんか有り得ないよねえ。[l]\nしかも大量？[l]\nどゆことだ。":5,"Igも無いのにカミにフウじる？[l]\nIgはもはやWCLの専売、\n大体にして野猫がそもそもそう簡単に…[l]\nん？[l]\nだからツェロル回収の話を？[l]\nだとしたら何で私が知らなかったのさ、今まで。[l]\n変な隠し事とかして…るとしたらあの女か。":6,"それとも、\n単に見逃してた月狂跳なのかなあ。[l]\n否、\n新しい上に操作の跡もあるんだよ。[l]\n純粋な封紙じゃない、相の強化を試みた跡もある、\nセキュリティまで掛かってる、起動音が要るぽいんだなあ。[l]\n私の知らないパターンだなあ。[l]\n解除出来なくはないけど、\nそういう問題じゃないでしょ。[l]\nこれがほんとのOut Of Place Artifactsだね、\n場違いもいいところ、\n今此処に在ってはいけないもの、\nんーむ、というか、これは…":7,"視えなくても構わないものを創ろうとしてるのかな？[l]\n魔眼資質が無かろうと、\n猫の側で一方的に宿主を定めて…か……[l]\n成功するかなそんな試み。[l]\n饗すべき血は…受肉か？それはＹの…[l]\nそういえばLinkableFormの話もあったか…[l]\n大体そんなことして何になるって、\n──あれらによるLu･Leの再興か。":8,"私が言えた義理じゃないけど、\n本末転倒だね、猫が魔女を選ぶなんて。[l]\nどちらが使い魔か分からないよ。[l]\nまあ使い魔は、常に召喚者を出し抜こうと虎視眈々なのが常だし、\n":9,"強ち間違ってもいないか。ふふふ。[l]\nでもいずれ調査はしといた方が好いよねえ。[l]\n想定の外の話だし。":10,"…で、ノートは何してる？[l]\nは？[l]\n内部からの流出を疑うのは当然でしょ。[l]\nさっきから言ってるよね、\n何で八相の連中がこんなのを持ってるんだよ。[l]\nこそこそ動けるのはあの女だけだし、\n仮にSHOBがツェロルその他、把握してたって無理なんだ。[l]\nWCLの場合は下っ端疑ったってしょうがないからね。":11,"そうだよ。[l]\nあの女の事だからバレないとでも思ったとは考えられない。[l]\nもしそうでないなら見縊られたものだけど。[l]\nだからこれは確信的背信行為、明確な抗議行動――…":12,"え？確信犯じゃ意味が違うでしょお。[l]\n知ってる癖に。[l]\n試したの？私を。[l]\nん、そう。[l]\nどっちでもいいんだけどね。[l]\nもしあの女の仕業ならその言い回しでも或る意味当たってるしね。[l]\n全く、赤の女王じゃあるまいし、\n愛に殉ずるなんて迷惑極まりない行為…[l]\n他人の事は言えないって？[l]\nそうだね。ふふ。":13,"にしてもあーっっもうっ！[l]\n…取り敢えずは放置でいいか。[l]\n面倒起こすなら起こすで、こっちの大義名分も立つからね。[l]\n大体この程度のアクシデントに対応できないで『彼』の\n顕現なんか有り得ないよ。[l]\nでもまあ一応、ツェロル探しも積極的にやった方が良いのかな私は。[l]\nどうやらあの女を追っかけてると自然と行き着きそうだし。[l]\nもし自分で隠匿してたとなれば重大な造反行為だ。":14,"という訳で、八相とLu･Leはまあ、予定通りでいいんじゃない。[l]\n彼の":15,"遊":16,"戯":17,"相":18,"手になるでしょ。[l]\nこの狩の庭でのね。[l]\n私？[l]\n面白そうならって、最初言った通り。[l]\nあの女、邪魔しないかちょっと様子視てないとね。[l]\n愉快が至上の私らしくないって？[l]\n":19,"彼":20,"奴みたいなのは別だよ。[l]\n分かってるでしょお？[l]\n察してよ。":21,"馬鹿女、兄様の眼をどうしても惹きたいのか。[l]\nもし一線を越えたら、\nやりすぎたなら、\n――とほうもない報いを与えてやるよ。[l]\n兄様が何と言おうと排除、削除して貰う。[l]\nさもなければ私がやるさ。[l]\n場合によっては喰ってあげるのも佳いかもね。[l]\n『喰い殺す』方で。[l]\nま、或る意味本望でしょ。[l]\n私に喰われるなら。":22,"蠅の物そのものを叩き潰すか現象だけを潰すか。[l]\nはたまた両方か。[l]\n人生美味礼讃、形而下の食、\n魔眼者の視界、形而上の食、\nどっちにしても不要なモノは吐くし下すさ。[l]\n分割された不全の６には出来ないこと。[l]\n……いいってもうこの話題は。[l]\n不愉快。[l]\nあんなの眼中に入れておけないよ。":23,"彼の今後ね。[l]\nま、取り敢えず魔眼はちゃんと起動してたようだし。[l]\nイーハももう起こしてある。[l]\nイーハに引っ張られて、\n身体の方からは寄ってくるかも。[l]\nもう八相の何人かと接触もしてるし、封紙と強く結んだ女は反応しててもおかしくないねえ。":24,"恋に落ちてたりしてねえ。ふふふふ。[l]\nまあそうならないように鈴を着けたんだけど、\n寝たままのイーハに反応できるほどの資質者が居た場合は\nもう遅いかもね。[l]\nどうだろうなー、\nそんなに強く結んでたら『猫の萌芽（ツェロル）』みたいに侵蝕されてるよ。":25,"ああ、予想してない事というのは面白いけど疲れるね。[l]\nにしても事が起こりすぎてるなあ…":26,"これはもしかするともしかするねぇ…[l]\n雫……":27,"流石は私の兄様、色々見越してたか。":28,"さあ、奴らの祭儀、どうなるかな。[l]\n何か楽しくなってきたかも。":29,"あーっと、どうしようかな。[l]\nやっぱり、……[l]\n９もこっち喚びだしとこうかなあ。[l]\nEnder達もくるのはしょうがない。[l]\nその代わりしっかり張り付かせといてよ。":30,"異":31,"羽、あれ":32,"憑":33,"羽だっけ？[l]\nいずれあれも揃ってないとしょうがないし、\n今の状況だと即座に動かせるとこに置いた方がよさそう…え？[l]\nああ、聞いてるよ。[l]\nなんか例の男子について気になる事があるとかないとか？[l]\n私らとは違うミアキスの子の筋。[l]\n雫に近しかった存在だから、\n確かに色々ありそうではあるんだけど…":34,"この遊びが終わったら詳しくは聞くよ。[l]\nこの状況に犬まで絡んだらもう大変なことになるよ。[l]\n犬の扱いに関しては現時点で完全にキャパ超えでしょう。[l]\n土俗のオオカミと憑物筋かぁ…[l]\n ":35,"狼 ":36,"天を":37,"討ち":38,"犬":39,"神となりしか？[l]\n興味はあるけどもぉ……[l]\n今は眼の前の事を処理。[l]\n何しろ事がおかしな方向に行ってるようだし、\n次への前振りだと思っておけば、愉しくもなるかな。":40,"場合によっては、私も猫かぶるのやめるね。[l]\n遊んでる余裕が無くなったら、\n早めに『彼』に自覚して貰って、早々に戦力ユニットに組み込もう。[l]\n問題はどの『彼』を選ぶかだけど。[l]\nまだ迷ってるよ、そりゃ。":41,"猫は獲物を、仕留める前に甚振るものでしょ。[l]\n獲物がどれかって？[l]\nうひひ。[l]\nさ、どれでしょうか。[l]\n美味しそうなんだもん、食べたくなっちゃうのを、\n兄様への貞操が抑えてるんだから、\n少しは慰みがあっても…ね？":42,"冗談はさておき、\n『彼』に関してはね。[l]\n雫絡みだったらそもそもどうしようもないし。[l]\n騒ぎそうな人間が一人いるし…":43,"さて、そろそろ話終わりで良いかい？[l]\n君と喋ると取り留めなく話題シフトしたり会話時間延びたりして\nよくわかんなくなるんだよ。[l]\n君は察してくれるからまだ通じるけどさ。":44,"はいはい、私も最優先命題は忘れてない…と思うよ。[l]\nんむ？[l]\nメモしないことは忘れる性質なんだよ私は。[l]\nはいはい、はーい。[l]\n敵は●●。":45,"あーもう。[l]\n飽きたら抜けるって言ったけど、\nそうもいかないか…[l]\nやりたくは無いけど、\nほんとに飽きたら強行モードに行っちゃうかもだよ。[l]\n建設創造の快楽とそれを破壊する快感愉悦は常に背中合わせ、\nドミノ然り？[l]\n砂の曼荼羅然り？":46,"え？[l]\n抑圧からの解放によるカタルシスは違うよ。[l]\nあんなの単なるギャップによる相対的感覚差の擬似感情でしょう。[l]\n零位からでないと意味が無い。[l]\nただ強行モードはなー。[l]\nあの馬鹿女の遣り方みたいで厭なんだよなー。[l]\nこうなったら、\n『彼』には頑張って貰わないと。[l]\n福音光輝十二の悲劇はほんとに痛々しい話だったからね。":47,"なんだかなぁ、\n私もまだまだ遊戯の支配者として未熟だと痛感です。[l]\n皆には迷惑かけてすまないね。[l]\n出来れば生暖かく見守ってよ。[l]\nありがとう。":48},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_009.ks","relPath":"/data/scenario/SC_E_009.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":49,"length":49,"percent":100},"cellInfo":[null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[47,0],"note":"完成"},"/data/scenario/SC_E_010.ks":{"data":[["@rどんな按配ですかぁ？[l]\nこの辺も結構いいとこでしょぅ。[l]\n今更いうことでもないんですけど。[l]\n間ぁが保たないだけで。[l]\nにはははははははははは。","@r现在是什么状况呀？[l]\n这一带也算不错的地方吧～[l]\n虽然现在说这个也有点晚啦。[l]\n只是维持不了平衡而已。[l]\n嘻哈哈哈哈哈哈哈。"],["@rはぃ？[l]\nいえ、遊んでるわけやないですて。[l]\nわかってますよぅ。[l]\nほんまはうちで決められる事をね、\nだから三春の決定を待ってるやないですかぁ。[l]\nうちは西部仕切、総締代行にすぎません。[l]\nそこは弁えてますがな。[l]\nいっとうは三春ちゃん、ドレミリアの子ぉら\nうちらは","@r啥？[l]\n没、没在玩啦。[l]\n人家明白的啦～[l]\n其实是有些事得我们自己内部决定，\n这不就在等三春做决定嘛～[l]\n咱只是西部负责人、总代理执行而已。[l]\n这点还是清楚的。[l]\n最上位是三春酱和德蕾米莉娅的孩子们\n我们"],["八","八"],["少","少"],["女、カミに仕えし八人姉妹の候補\nあんさんも入れてぇの八人でしょう。[l]\n","女、是侍奉神的八姐妹候选\n加上那位小姐的话，正好八个人吧。[l]\n"],["仮","即便是"],["令それでほら、今回みたいに、\n使えない上の人間の決定待ちで無駄な時間を\nつくることになろうともですなぁ…[l]\n──冗談ですよぅ。[l]\nそないな顔せんでもよろしがな。","是那样，你看啊，就像这次，\n等着没用的上级做决定\n白白浪费时间也是常有的事啦…[l]\n──开玩笑的啦～[l]\n不用摆那种表情嘛。"],["@r付き合いも随分永うなるいうのに、\n全く信用されてへんなぁ。[l]\nわたしも悲しなりますわ。","@r明明交往这么久\n完全不被信任呢。[l]\n人家也会伤心的呀。"],["@r実際あん","@r其实啊，"],["娘らにはしっかりして貰うか、\nだまってうちらの言う事聞いてくれるかして呉れたら\n好いんですがねぇ…[l]\nあいや、ですから、喩えです冗談ですよぅ。[l]\nそれはそれです。[l]\n今回いよいよコトを動かすわけでしょう。[l]\nそろそろ西部八相も動く準備しますよって、\nあんさんもようしとってくださいねぇ。[l]\nあ、","要是让那些丫头们靠谱点，\n或是乖乖听从我们的安排\n就好啦…[l]\n哎呀不是、所以说、是比喻是玩笑啦～[l]\n那归那。[l]\n这次终于要行动了对吧。[l]\n西部八相也该准备行动了\n您也请做好准备呀。[l]\n啊，"],["奇","奇"],["士の","士家的"],["道","道"],["具ちゃんねえ、\n前入りしてます。[l]\nちょっと用事があって。勿論紙も一緒ですぅ。[l]\nあん","具小姐不在呢，\n已经先过去了。[l]\n有点事情要办。当然纸也一起啦～[l]\n那些"],["娘は手放さんのですぅ。困ってますわ。[l]\n娘もつくらんと自分でよう遣いよるんで…","丫头们真是让人放不下啊。实在太头疼呀。[l]\n毕竟要是不把她们管教好，就得自己亲力亲为了…"],["@rはぃ？[l]\nお前が言うなと。[l]\nまぁまぁ、そう言わんといて下さいよぅ。[l]\n","@r啥？[l]\n轮不到你说。[l]\n哎呀呀、别这么说嘛～[l]\n"],["具ちゃんに関してはその御陰様で冬夏ちゃんが…[l]\nねぇ、使える娘なんですぅ。[l]\nはぁ、当時を知るんも、もううちだけですねぇ。[l]\n種を蒔いた最初の女としての責任ちゅう事ですよぅ。[l]\nはいはい。[l]\n弁えてます。[l]\nなんにしてもまぁ、\n永いことかかりましたなぁ。ここまで。","关于小具的事 多亏了那件事冬夏才…[l]\n呐 是个能干的姑娘呢。[l]\n哈 知道当年事的 也就只剩咱家了呢。[l]\n这可是作为播种最初之女的责任哟。[l]\n是是。[l]\n我明白。[l]\n不管怎么说嘛\n花了相当长时间呢 走到这一步。"],["@rあ、ほいで、\nうちもですね、\n祭の前にまず、\n例のシキに行かなあかんのですよぅ。[l]\nま、そういう訳なので。[l]\n一緒しますのは、","@r啊 对了\n咱家也是呢\n祭典之前得先\n去那个仪式才行哟。[l]\n嘛 就是这么回事。[l]\n同行的只有"],["玖","玖"],["威の","威家的"],["価","价"],["無ちゃん。[l]\nだけですねぇ。[l]\n陸路でよろしいか？[l]\nまっとうな空路はチェックが厳しいですし、ベロアちゃんが…ねぇ。","无小妹。[l]\n就她一个哦。[l]\n走陆路可以吗？[l]\n正规空路检查太严 贝萝娅又…唉。"],["@rま、行く日までこの辺でも散策なさったらどうです。[l]\nそれとも古都巡りでもお付き合いしましょか。[l]\nなんせ見所はようさんあるんで――[l]\n玄ノ森辺りはまた趣向の違う風情で、\n山の自然も楽しめれば海も繁華街も温泉もありますよって、\n平地は少ないですがな、[l]\nなんの少しくらい坂の多い方が健康には──","@r嘛 在出发前要不要在这附近逛逛[l]\n或者陪您游览古都也行[l]\n毕竟值得看的地方可多啦――[l]\n玄之森那边又是别样风情\n既能享受山林自然 又有海景商业街和温泉\n就是平地少了些[l]\n不过坡道多些对健康倒——"],["@rはい？[l]\nうちと一緒に行きはりますのん？[l]\n信用ないですなあ。[l]\nそれもある？はぁ。[l]\nベロアちゃんの具合ですかぁ。[l]\nこの辺の御水がお口に合わんと、はぃはぃ。[l]\n下は兎も角、山からの水は美味し思いますけどなあ。[l]\nまあいいですよぅ。[l]\nうちも別に疚しいこともないですし。","@r嗯？[l]\n您要和我同行吗？[l]\n真信不过人呢。[l]\n也有这层原因？哈啊。[l]\n贝萝娅的状况吗？[l]\n这带的水不合口味是吧 明白明白[l]\n下游暂且不论 山上的水应该很美味才对啊。[l]\n嘛没关系啦[l]\n咱家又没做什么亏心事"],["@rさて…では価無ちゃんも一緒せなあきませんねぇ。[l]\nうちが面倒任されてますんで。[l]\nそうなりますと、\n学校早めに休ませなあきませんよって、[l]\nちょっとだけ待って下さいよ。[l]\nほな、その辺が済んだら三人と一匹、\n愉快な道ノ奥旅と洒落込みますか。","@r那么…价无小妹也得跟着来了呢[l]\n毕竟麻烦事都推给咱家了[l]\n这样的话\n得让学校提前放假才行[l]\n请稍等片刻[l]\n那等这些安排妥当 就三人加一只\n来场愉快的深山之旅如何？"],["@rこっちと違うてまだまだ寒いですから、\nなんぞ羽織った方がよろしいですねぇ。[l]\nあら、その黒外套、で行きはりますかぁ。[l]\nまるで●●ですな。[l]\n正しく『あんさんに相応しい』ですよぅ。","@r那边可比这儿冷得多\n最好披件外套呢[l]\n哎呀 就穿这件黑外套去吗？[l]\n简直像●●一样[l]\n正可谓『与您相称』呢"],["@r@rよぉく、お似合いです。","@r@r非常 非常合适"]],"context":[["SC_E_010.ks/index/1/text"],["SC_E_010.ks/index/3/text"],["SC_E_010.ks/index/5/text"],["SC_E_010.ks/index/7/text"],["SC_E_010.ks/index/9/text"],["SC_E_010.ks/index/12/text"],["SC_E_010.ks/index/14/text"],["SC_E_010.ks/index/16/text"],["SC_E_010.ks/index/18/text"],["SC_E_010.ks/index/20/text"],["SC_E_010.ks/index/22/text"],["SC_E_010.ks/index/24/text"],["SC_E_010.ks/index/26/text","SC_E_010.ks/index/35/text"],["SC_E_010.ks/index/28/text"],["SC_E_010.ks/index/30/text"],["SC_E_010.ks/index/32/text"],["SC_E_010.ks/index/37/text"],["SC_E_010.ks/index/39/text"],["SC_E_010.ks/index/41/text"],["SC_E_010.ks/index/43/text"],["SC_E_010.ks/index/45/text"],["SC_E_010.ks/index/47/text"],["SC_E_010.ks/index/49/text"],["SC_E_010.ks/index/51/text"],["SC_E_010.ks/index/53/text"],["SC_E_010.ks/index/55/text"],["SC_E_010.ks/index/57/text"]],"tags":[],"parameters":[[{"start":136,"end":236}],[{"start":248,"end":429}],[{"start":440,"end":441}],[{"start":453,"end":454}],[{"start":465,"end":506}],[{"start":522,"end":523}],[{"start":534,"end":634}],[{"start":646,"end":703}],[{"start":715,"end":723}],[{"start":734,"end":923}],[{"start":935,"end":936}],[{"start":948,"end":950}],[{"start":962,"end":963},{"start":1172,"end":1173}],[{"start":975,"end":1034}],[{"start":1045,"end":1090}],[{"start":1102,"end":1156}],[{"start":1185,"end":1357}],[{"start":1369,"end":1460}],[{"start":1471,"end":1472}],[{"start":1483,"end":1485}],[{"start":1496,"end":1497}],[{"start":1508,"end":1584}],[{"start":1596,"end":1778}],[{"start":1790,"end":1978}],[{"start":1990,"end":2146}],[{"start":2158,"end":2274}],[{"start":2286,"end":2305}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_010.ks","basename":"SC_E_010.ks","indexIds":{"@rどんな按配ですかぁ？[l]\nこの辺も結構いいとこでしょぅ。[l]\n今更いうことでもないんですけど。[l]\n間ぁが保たないだけで。[l]\nにはははははははははは。":0,"@rはぃ？[l]\nいえ、遊んでるわけやないですて。[l]\nわかってますよぅ。[l]\nほんまはうちで決められる事をね、\nだから三春の決定を待ってるやないですかぁ。[l]\nうちは西部仕切、総締代行にすぎません。[l]\nそこは弁えてますがな。[l]\nいっとうは三春ちゃん、ドレミリアの子ぉら\nうちらは":1,"八":2,"少":3,"女、カミに仕えし八人姉妹の候補\nあんさんも入れてぇの八人でしょう。[l]\n":4,"仮":5,"令それでほら、今回みたいに、\n使えない上の人間の決定待ちで無駄な時間を\nつくることになろうともですなぁ…[l]\n──冗談ですよぅ。[l]\nそないな顔せんでもよろしがな。":6,"@r付き合いも随分永うなるいうのに、\n全く信用されてへんなぁ。[l]\nわたしも悲しなりますわ。":7,"@r実際あん":8,"娘らにはしっかりして貰うか、\nだまってうちらの言う事聞いてくれるかして呉れたら\n好いんですがねぇ…[l]\nあいや、ですから、喩えです冗談ですよぅ。[l]\nそれはそれです。[l]\n今回いよいよコトを動かすわけでしょう。[l]\nそろそろ西部八相も動く準備しますよって、\nあんさんもようしとってくださいねぇ。[l]\nあ、":9,"奇":10,"士の":11,"道":12,"具ちゃんねえ、\n前入りしてます。[l]\nちょっと用事があって。勿論紙も一緒ですぅ。[l]\nあん":13,"娘は手放さんのですぅ。困ってますわ。[l]\n娘もつくらんと自分でよう遣いよるんで…":14,"@rはぃ？[l]\nお前が言うなと。[l]\nまぁまぁ、そう言わんといて下さいよぅ。[l]\n":15,"具ちゃんに関してはその御陰様で冬夏ちゃんが…[l]\nねぇ、使える娘なんですぅ。[l]\nはぁ、当時を知るんも、もううちだけですねぇ。[l]\n種を蒔いた最初の女としての責任ちゅう事ですよぅ。[l]\nはいはい。[l]\n弁えてます。[l]\nなんにしてもまぁ、\n永いことかかりましたなぁ。ここまで。":16,"@rあ、ほいで、\nうちもですね、\n祭の前にまず、\n例のシキに行かなあかんのですよぅ。[l]\nま、そういう訳なので。[l]\n一緒しますのは、":17,"玖":18,"威の":19,"価":20,"無ちゃん。[l]\nだけですねぇ。[l]\n陸路でよろしいか？[l]\nまっとうな空路はチェックが厳しいですし、ベロアちゃんが…ねぇ。":21,"@rま、行く日までこの辺でも散策なさったらどうです。[l]\nそれとも古都巡りでもお付き合いしましょか。[l]\nなんせ見所はようさんあるんで――[l]\n玄ノ森辺りはまた趣向の違う風情で、\n山の自然も楽しめれば海も繁華街も温泉もありますよって、\n平地は少ないですがな、[l]\nなんの少しくらい坂の多い方が健康には──":22,"@rはい？[l]\nうちと一緒に行きはりますのん？[l]\n信用ないですなあ。[l]\nそれもある？はぁ。[l]\nベロアちゃんの具合ですかぁ。[l]\nこの辺の御水がお口に合わんと、はぃはぃ。[l]\n下は兎も角、山からの水は美味し思いますけどなあ。[l]\nまあいいですよぅ。[l]\nうちも別に疚しいこともないですし。":23,"@rさて…では価無ちゃんも一緒せなあきませんねぇ。[l]\nうちが面倒任されてますんで。[l]\nそうなりますと、\n学校早めに休ませなあきませんよって、[l]\nちょっとだけ待って下さいよ。[l]\nほな、その辺が済んだら三人と一匹、\n愉快な道ノ奥旅と洒落込みますか。":24,"@rこっちと違うてまだまだ寒いですから、\nなんぞ羽織った方がよろしいですねぇ。[l]\nあら、その黒外套、で行きはりますかぁ。[l]\nまるで●●ですな。[l]\n正しく『あんさんに相応しい』ですよぅ。":25,"@r@rよぉく、お似合いです。":26},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_010.ks","relPath":"/data/scenario/SC_E_010.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":27,"length":27,"percent":100},"cellInfo":[null,[null,{"v":1,"t":"HU"}],[null,{"t":"HU","v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[21,1],"note":"完成"},"/data/scenario/SC_E_011.ks":{"data":[["私には八人の姉妹が居たんです。[l]\n姉妹は今はばらばらなのです。[l]\n私は一番上のお姉さまの大事な猫…あれ、人だったかしら。[l]\nを、こっそり持ち出しました。[l]\nだって一番上のお姉さまは、悪い人達に真っ先に狙われそうな、\n強い魔女でしたから。[l]\n姉さまの猫ベロアちゃんなら、姉さまを守ってくれるでしょうし、\n私が手助けできることは、大事な猫…あれ、人だったかしら。[l]\nを、連れて逃げる事だと思って。[l]\n末妹ドレミリアさまも一緒にです。[l]\nアリスの直系なのですが、猫達との馴染がいまいちで、\nとても可愛い娘なのですけど、ええ。[l]\n姉さまがこよなく愛でていらっしゃる娘でしたので。","我曾经有八位姐妹[l]\n如今姐妹们已各奔东西[l]\n我把大姐最珍视的猫…咦 是人来着吗[l]\n偷偷带了出来[l]\n因为大姐是最可能被坏人盯上的\n强大的魔女[l]\n想着大姐的猫贝萝娅能保护她\n我能做的就是带着重要的猫…咦 是人来着吗[l]\n一起逃走[l]\n还有小妹德蕾米莉娅大人[l]\n虽是爱丽丝直系 但和猫处不来\n虽然是个非常可爱的孩子[l]\n是大姐无比疼爱的姑娘呢"],["私は眠ったままの、パストラリーの猫、猫の萌芽を連れて、\n遠く海の上を飛んで逃げました。[l]\n魔女ですから。[l]\n魔女は猫を連れて月夜の空を飛行するものと云いませんか。[l]\nわれわれはみたてなんです。[l]\nドレミリアさまもどうにか私に着いてこられました。","我带着沉睡中的、帕斯托拉里的猫、猫之萌芽，\n远渡重洋飞逃而去。[l]\n因为是魔女嘛。[l]\n不是说魔女就该带着猫在月夜飞行吗？[l]\n我们就是这样的存在。[l]\n德蕾米莉娅大人总算也跟上我了。"],["パストラリーの猫ですか？[l]\nあれ、人だったかしら…[l]\nそうそう、元は人でした。そうです。[l]\nツェロル。[l]\nかつて猫に喰われた器、失敗した受肉の宿り、\n目覚めている間は永遠に猫の芽を出し続ける、\n狂ったテロメア。[l]\n心無い仲間は『ツェロルの悪夢』と呼んでました。[l]\nはい。[l]\n連れて逃げてる時はずっと眠ったままです。[l]\n昔に誰かがそうしたんです。[l]\n失敗しなかった受肉？[l]\n知っていますが言いたくありません。","帕斯托拉里的猫？[l]\n啊咧、是人来着吗…[l]\n对对、原本是人类。没错。[l]\n赛萝洛。[l]\n曾被猫吞噬的容器、失败的受肉宿体、\n清醒时会永远持续萌发猫之芽的、\n疯狂的端粒。[l]\n无情的同伴们称之为『赛萝洛的噩梦』。[l]\n是的。[l]\n带着她逃亡时一直沉睡着。[l]\n很久以前有人这么做的。[l]\n没失败的受肉？[l]\n知道但不想说。"],["この國に逃げ着いて、\n私たちと同じ、強い眼を持った人と逢いました。[l]\n名前は…センリとか言ったと思います。[l]\n…センフ？いえ、違いますね。何の話です？Beast？C.W?[l]\nやはり関係ないと思いますが。[l]\n深読みなさっておいででは。[l]\n彼女はファーストネームしかなくて、\nその後カミを割り振った時に、玉梓と名乗りだしたんです。[l]\nそうです、結局センリは自分を含めて六人の魔眼者を見出しました。[l]\n七人目がドレミリアさまです。","逃到这个国家后、\n遇见了和我们一样拥有强大魔眼的人。[l]\n名字…好像是叫选律。[l]\n…选芙？不、搞错了。在说什么？Beast？C.W？[l]\n果然觉得没关系吧。[l]\n您这是在过度解读呢。[l]\n她只有名字、\n后来分配神明时才自称玉梓。[l]\n是的、最终选律找到了包括自己在内的六名魔眼使。[l]\n第七人就是德蕾米莉娅大人。"],["私たちより先に此処に来ていたらしい、\n黒のイツワと呼ばれた最強の猫の内の一匹は、\n私たちの敵が差し向けた追っ手と相討ちになってました。[l]\nはい？追っ手ですか。[l]\n『魔眼の刺し手』と呼ばれてました。[l]\nFascinum、男魔女、あの忌々しい白の兄と同じ。[l]\n猫をカミにするあの連中、\ncovenのような一団ではなく、\nその身に猫を纏いて独りでタつ厭らしい魔人。","似乎比我们更早来到这里的、\n被称为黑色伊兹瓦的最强猫之一、\n与我们敌人派来的追兵同归于尽了。[l]\n嗯？追兵吗？[l]\n被称为『魔眼杀手』。[l]\nFascinum、男魔女、和那个可恨的白之兄长一样。[l]\n那群把猫当作神明的家伙、\n不是coven那样的团体、\n而是独自披着猫皮战斗的卑劣魔人。"],["相討ちと言いましたけど、\n『魔眼の刺し手』の遺骸と、\n９と１０は無かったそうです。[l]\nええ、十に分かたれて──\n三魂七魄、魔弾、十種神宝、\nヒトの手の指の関係で？[l]\n十進法？[l]\n難しいことはわからないんです。[l]\n猫の話じゃないでした？","虽说同归于尽、\n但『魔眼杀手』的遗骸、\n据说没有9和10。[l]\n嗯、被分成十份——\n三魂七魄、魔弹、十种神宝、\n因为人类手指的关系？[l]\n十进制？[l]\n复杂的事情我不懂。[l]\n不是在说猫的事吗？"],["それで、\nこの國は東西に細長い島で、\n取り敢えずは東と西に分散させました。","然后、\n这个国家是东西狭长的岛屿、\n暂时分散在东部和西部。"],["センリの居た、西部には、[l]\n四相奇士（しそうきさむら）。[l]\n五相玉梓（ごそうたまずさ）、センリ。[l]\n六相玖威（むそうくい）。","选律所在的西部有、[l]\n四相奇士。[l]\n五相玉梓、选律。[l]\n六相玖威。"],["東部には、[l]\n一相綾目（いっそうあやめ）。[l]\n二相三春（にそうみはる）、ドレミリア。[l]\n三相永久（みそうながひさ）。[l]\n七相狩屋（ななそうかりや）。[l]\n八相大黒（やそうおおくろ）","东部有、[l]\n一相绫目。[l]\n二相三春、德蕾米莉娅。[l]\n三相永久。[l]\n七相狩屋。[l]\n八相大黑"],["オクラ？[l]\nいえ、オオクロです。[l]\nこれは三春が管理するただの●●で、\nですから実質７人です。[l]\n最後の８人目はミリアム姉さまですからね。","奥克拉？[l]\n不，是大黑。[l]\n这只是三春管理的●●，\n所以实际上只有7人。[l]\n因为最后的第8人是米莉安姆姐姐大人呀。"],["わたしはそのあと、\nツェロルを連れてドレミリアさまの元を去りました。[l]\n彼女が起きてしまう様な事があれば、\n彼女は本当に狂ってしまうでしょうからね。[l]\nはい、もう遅いのですがね。","在那之后，\n我带着赛萝洛离开了德蕾米莉娅大人身边。[l]\n要是发生让她苏醒的事情，\n她真的会彻底疯掉吧。[l]\n嗯，虽然已经太迟了。"],["という訳ですので、結局ミリアム姉さまには逢えませんでした。[l]\nご無事だといいのですけど…","因此最终也没能见到米莉安姆姐姐大人。[l]\n但愿她平安无事…"],["え。[l]\n私の名ですか。[l]\nアリスの創りし猫遣う魔女たる我ら、\n八人姉妹が一人、\nこの國にての偽りの隠れ名は、\n鍋島竹争（たから）です。","哎。[l]\n我的名字吗？[l]\n身为爱丽丝创造的驭猫魔女，\n八姐妹之一，\n在这个国家使用的伪隐藏名是，\n锅岛竹争（たから）。"],["本当の名？[l]\n………[l]\n………[l]\n……[l]\n過去の記憶が途切れてる？","真名？[l]\n………[l]\n………[l]\n……[l]\n过去的记忆中断了？"],["弄る能力は猫も、\nえ。[l]\nまさか。[l]\n私は──","连操控猫的能力也，\n哎。[l]\n难道。[l]\n我是──"],["@r","@r"],["猫がななななななななななななな","猫在喵喵喵喵喵喵喵喵喵喵喵"]],"context":[["SC_E_011.ks/index/1/text"],["SC_E_011.ks/index/3/text"],["SC_E_011.ks/index/5/text"],["SC_E_011.ks/index/7/text"],["SC_E_011.ks/index/9/text"],["SC_E_011.ks/index/11/text"],["SC_E_011.ks/index/13/text"],["SC_E_011.ks/index/15/text"],["SC_E_011.ks/index/17/text"],["SC_E_011.ks/index/19/text"],["SC_E_011.ks/index/21/text"],["SC_E_011.ks/index/23/text"],["SC_E_011.ks/index/25/text"],["SC_E_011.ks/index/27/text"],["SC_E_011.ks/index/29/text"],["SC_E_011.ks/index/31/text"],["SC_E_011.ks/index/34/text"]],"tags":[],"parameters":[[{"start":212,"end":563}],[{"start":577,"end":727}],[{"start":741,"end":1012}],[{"start":1026,"end":1288}],[{"start":1302,"end":1521}],[{"start":1535,"end":1692}],[{"start":1706,"end":1751}],[{"start":1765,"end":1845}],[{"start":1859,"end":1978}],[{"start":1992,"end":2083}],[{"start":2097,"end":2206}],[{"start":2220,"end":2270}],[{"start":2284,"end":2375}],[{"start":2389,"end":2446}],[{"start":2460,"end":2499}],[{"start":2511,"end":2511}],[{"start":2532,"end":2547}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_011.ks","basename":"SC_E_011.ks","indexIds":{"私には八人の姉妹が居たんです。[l]\n姉妹は今はばらばらなのです。[l]\n私は一番上のお姉さまの大事な猫…あれ、人だったかしら。[l]\nを、こっそり持ち出しました。[l]\nだって一番上のお姉さまは、悪い人達に真っ先に狙われそうな、\n強い魔女でしたから。[l]\n姉さまの猫ベロアちゃんなら、姉さまを守ってくれるでしょうし、\n私が手助けできることは、大事な猫…あれ、人だったかしら。[l]\nを、連れて逃げる事だと思って。[l]\n末妹ドレミリアさまも一緒にです。[l]\nアリスの直系なのですが、猫達との馴染がいまいちで、\nとても可愛い娘なのですけど、ええ。[l]\n姉さまがこよなく愛でていらっしゃる娘でしたので。":0,"私は眠ったままの、パストラリーの猫、猫の萌芽を連れて、\n遠く海の上を飛んで逃げました。[l]\n魔女ですから。[l]\n魔女は猫を連れて月夜の空を飛行するものと云いませんか。[l]\nわれわれはみたてなんです。[l]\nドレミリアさまもどうにか私に着いてこられました。":1,"パストラリーの猫ですか？[l]\nあれ、人だったかしら…[l]\nそうそう、元は人でした。そうです。[l]\nツェロル。[l]\nかつて猫に喰われた器、失敗した受肉の宿り、\n目覚めている間は永遠に猫の芽を出し続ける、\n狂ったテロメア。[l]\n心無い仲間は『ツェロルの悪夢』と呼んでました。[l]\nはい。[l]\n連れて逃げてる時はずっと眠ったままです。[l]\n昔に誰かがそうしたんです。[l]\n失敗しなかった受肉？[l]\n知っていますが言いたくありません。":2,"この國に逃げ着いて、\n私たちと同じ、強い眼を持った人と逢いました。[l]\n名前は…センリとか言ったと思います。[l]\n…センフ？いえ、違いますね。何の話です？Beast？C.W?[l]\nやはり関係ないと思いますが。[l]\n深読みなさっておいででは。[l]\n彼女はファーストネームしかなくて、\nその後カミを割り振った時に、玉梓と名乗りだしたんです。[l]\nそうです、結局センリは自分を含めて六人の魔眼者を見出しました。[l]\n七人目がドレミリアさまです。":3,"私たちより先に此処に来ていたらしい、\n黒のイツワと呼ばれた最強の猫の内の一匹は、\n私たちの敵が差し向けた追っ手と相討ちになってました。[l]\nはい？追っ手ですか。[l]\n『魔眼の刺し手』と呼ばれてました。[l]\nFascinum、男魔女、あの忌々しい白の兄と同じ。[l]\n猫をカミにするあの連中、\ncovenのような一団ではなく、\nその身に猫を纏いて独りでタつ厭らしい魔人。":4,"相討ちと言いましたけど、\n『魔眼の刺し手』の遺骸と、\n９と１０は無かったそうです。[l]\nええ、十に分かたれて──\n三魂七魄、魔弾、十種神宝、\nヒトの手の指の関係で？[l]\n十進法？[l]\n難しいことはわからないんです。[l]\n猫の話じゃないでした？":5,"それで、\nこの國は東西に細長い島で、\n取り敢えずは東と西に分散させました。":6,"センリの居た、西部には、[l]\n四相奇士（しそうきさむら）。[l]\n五相玉梓（ごそうたまずさ）、センリ。[l]\n六相玖威（むそうくい）。":7,"東部には、[l]\n一相綾目（いっそうあやめ）。[l]\n二相三春（にそうみはる）、ドレミリア。[l]\n三相永久（みそうながひさ）。[l]\n七相狩屋（ななそうかりや）。[l]\n八相大黒（やそうおおくろ）":8,"オクラ？[l]\nいえ、オオクロです。[l]\nこれは三春が管理するただの●●で、\nですから実質７人です。[l]\n最後の８人目はミリアム姉さまですからね。":9,"わたしはそのあと、\nツェロルを連れてドレミリアさまの元を去りました。[l]\n彼女が起きてしまう様な事があれば、\n彼女は本当に狂ってしまうでしょうからね。[l]\nはい、もう遅いのですがね。":10,"という訳ですので、結局ミリアム姉さまには逢えませんでした。[l]\nご無事だといいのですけど…":11,"え。[l]\n私の名ですか。[l]\nアリスの創りし猫遣う魔女たる我ら、\n八人姉妹が一人、\nこの國にての偽りの隠れ名は、\n鍋島竹争（たから）です。":12,"本当の名？[l]\n………[l]\n………[l]\n……[l]\n過去の記憶が途切れてる？":13,"弄る能力は猫も、\nえ。[l]\nまさか。[l]\n私は──":14,"@r":15,"猫がななななななななななななな":16},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_011.ks","relPath":"/data/scenario/SC_E_011.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":17,"length":17,"percent":100},"cellInfo":[[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"t":"HU","v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[13,1],"note":"完成"},"/data/scenario/SC_E_015.ks":{"data":[["夢を。[l]\nみている。[l]\n幾年も。","做着。[l]\n梦。[l]\n好多年。"],["若き","年轻"],["処","处"],["女のわたしと、\nあのひと。[l]\nそしてドレミリア。","女的我，\n和那个人。[l]\n还有德蕾米莉娅。"],["――センリが呼ぶ声がする。[l]\n相変わらず慇懃無礼な女。","――听见选律呼唤的声音。[l]\n还是那么虚情假意的女人。"],["この女に任せたのにはやむない理由があった。[l]\nこの最果ての島國に、果たしてどれだけの魔眼の者が居るか\n分からなかった故に、\nLu･Leにも稀な、猫との親和性を持ったこの女を、\n永代に生かした方が良策と思えたからだ。","托付给这女人实属无奈。[l]\n在这极东岛国上，究竟有多少魔眼持有者\n无从知晓，\n考虑到这女人拥有连Lu・Le都罕见的和猫的亲和性，\n让她永存才是上策。"],["あの白き者どもに","也因为那些白之众"],["輩の殆どを狩られていた為もある。[l]\n危険な賭けは出来なかった。","几乎猎杀了我们大半族人。[l]\n不敢冒险。"],["というよりも、\n八人姉妹の妹の誰かが、\nわたしより先にこの島に逃げ","或者说，\n八姐妹中有个妹妹\n比我更早逃到这座岛"],["果せていたのだ。","并完成了使命。"],["この女がドレミリアを連れて私の前に現れた時は\n大層驚いた。[l]\nドレミリアを此処まで連れ出した妹の行方は知らないと言った。[l]\nドレミリアは『猫の萌芽』ツェロルと一緒だと言ったが、\n妹と共にどこかに消えたという。","当这女人带着德蕾米莉娅出现在我面前时\n真是吓坏了。[l]\n她说不知道带德蕾米莉娅来此的妹妹下落。[l]\n虽然提到德蕾米莉娅和『猫之萌芽』赛萝洛在一起，\n但据说已随妹妹消失在某处。"],["妹はこの女──センリ──に猫のカミを預けていた。[l]\n私達の最後の望み、無楽の病の末裔の一、\n黒の猫イツワの、それは成れの果てだった。","妹妹将猫神托付给了这女人──选律──[l]\n我们最后的希望，无乐之病的末裔之一，\n黑猫伊兹瓦的，那便是最终形态。"],["８つのカミ。","八位神明。"],["この女は、土着民から６人を探し出し、\nドレミリアを長として７人を揃えていた。[l]\n都合の好い事に３と親和する者は早々に現れたので、\nこの女に不老を与えることが出来た。","这女人从原住民中找出6人，\n以德蕾米莉娅为首凑齐了7人。[l]\n幸运的是与3亲和者很快出现，\n才能赋予这女人不老之力。"],["アリスの直系、ドレミリア。[l]\nあの娘さえ、アリスの血統さえ残し得れば。[l]\nわたしの●●したひとの血脈を。","爱丽丝的直系，德蕾米莉娅。[l]\n只要那孩子、只要爱丽丝的血脉能留存下来。[l]\n我●●之人的血脉。"],["他の姉妹が一体どうなったのか。[l]\n猫は。[l]\n只管逃げるしかなかったわたしには、\nもはや独りで奴等に抗う術も力も消耗していた。","其他姐妹究竟遭遇了什么。[l]\n猫呢。[l]\n只顾着逃命的我，\n早已连独自对抗他们的手段与力量都消耗殆尽了。"],["そう。[l]\nあくまで消耗だ。[l]\n回復さえすれば、しかし、","没错。[l]\n彻彻底底的消耗。[l]\n只要能恢复的话，然而，"],["ベロアは逃亡のさなか疵付いてしまった。[l]\nわたしの不老性には衰えが顕れるだろう。[l]\n只でさえヒトの手で創られた偽りの意志が込められた、\n即ちヒトの手による第十相を付与された猫は、\n忠実では在るが不安定で不完全な存在なのだ。","贝萝娅在逃亡途中受了伤。[l]\n我的不老特性恐怕会出现衰退吧。[l]\n本就是由人类之手植入虚假意志的，\n即被人类赋予第十相的猫，\n虽忠诚却是不稳定且不完整的存在。"],["魔眼の刺し手とやらが切り裂き封じた\n黒の猫、\nこのカミに縋るしかないだろう。","被魔眼杀手斩裂封印的\n黑猫，\n只能仰仗这位神明了。"],["しかしこの地の新たな継承者に託したが故か、\nそれとも魔眼の刺し手…白の連中の式であるが故か、[l]\n既にわたしの知っている式とは勝手の違うモノ、\n一筋縄で行けるかどうかは判らぬ――\n否、なんとしてでも。","或许因托付给了此地的新继承者，\n又或因魔眼杀手…那些白之众的术式之故，[l]\n已与我知晓的术式运作方式迥异，\n能否顺利尚不可知――\n不，无论如何都要。"],["魔女の猫。[l]\n受肉せし","魔女的猫。[l]\n受肉降世"],["使","的"],["い","使"],["魔。","魔。"],["魔眼。[l]\n呪殺、\n不可視、\n不老と再生、\n毒、\n不正操作、\n喰、\n狂戦士、\n十の魔弾、\n飛行箒、\n","魔眼。[l]\n咒杀，\n不可视，\n不老与再生，\n毒，\n不正操作，\n吞噬，\n狂战士，\n十之魔弹，\n飞行扫帚，\n"],["骸 ","操控"],["操 る","尸骸"],["霊たる存在。","之灵。"],["わたしたちは身を隠してきたが、\n機は熟したという。[l]\nあれの誕生は……[l]\nまさに我等の復権に相応しいハレだ。[l]\nこの國で混じり薄まったかに思えたアリスの血が、\n再びわたしの前に顕れてくれたのだ。","我们虽一直隐匿行踪，\n但据说时机已成熟。[l]\n那位的诞生……[l]\n正是配得上我等复权的吉兆。[l]\n在这国家看似稀薄的爱丽丝之血，\n再度显现在我面前了。"],["なのに此処に至って面倒な事が。[l]\n全き面倒な事である。","偏偏此时节外生枝。[l]\n彻头彻尾的麻烦事。"],["八相を殺したモノを詮索し追撃している暇は最早無いやも知れぬが、早急に事を成せばそのような一切は瑣事となる。[l]\nベロアにもわたしにも時間が無い。[l]\n肉を得たが故に獲得した対老化能を故障したベロアには、\n新たな依代が必要だ。[l]\n同じ無楽の病から生じたあの──","或许已无暇追查追杀八相之人，但若速战速决这些便都是琐事。[l]\n贝萝娅和我都没时间了。[l]\n对于因获得肉体而取得抗衰老能力却故障的贝萝娅，\n需要新的依凭物。[l]\n同样源于无乐之病的那——"],["さて。[l]\nアリスの血を引きながら我等の敵となったあの兄妹、\n白の連中、\n『最悪の敵は己の中に居る』と、\n貴様達が教えたことだ。","那么。[l]\n继承爱丽丝血脉却与我等为敌的那对兄妹，\n白之众，\n『最恶之敌居于己身』，\n这可是你们教我的。"],["獅子身中の虫とはよく云ったもの、\n自らの組織を内部よりクイ破る、\n――そしてそのムシの中のムシ。[l]\n貴様は","所谓狮子身中虫说得好，\n从内部蛀空自身组织的，\n―― 而你，是那虫中之虫。[l]\n你这"],["死","死"],["屍","尸"],["無","无"],["私、ナナシ、","私、名无，"],["身","身获"],["獲りのハヤシ。","的林。"],["さても何にとっての排出機構であることかよ。[l]\n赤き血より出でし狂白の災は病みし闇となろう。[l]\n十字の時の如くあれ、アイは破壊的に訪れるもの。","这排泄机制究竟是为谁而设啊。[l]\n赤红鲜血孕育的苍白灾厄终成病态之暗。[l]\n如十字时标般，爱将以破坏之姿降临。"],["わたしは必ずとりもどす、\n全てを統べて。","我必定会夺回来，\n将一切都掌控在手中。"]],"context":[["SC_E_015.ks/index/1/text"],["SC_E_015.ks/index/3/text"],["SC_E_015.ks/index/5/text"],["SC_E_015.ks/index/7/text"],["SC_E_015.ks/index/9/text"],["SC_E_015.ks/index/11/text"],["SC_E_015.ks/index/13/text"],["SC_E_015.ks/index/15/text"],["SC_E_015.ks/index/17/text"],["SC_E_015.ks/index/19/text"],["SC_E_015.ks/index/21/text"],["SC_E_015.ks/index/23/text"],["SC_E_015.ks/index/25/text"],["SC_E_015.ks/index/27/text"],["SC_E_015.ks/index/29/text"],["SC_E_015.ks/index/31/text"],["SC_E_015.ks/index/33/text"],["SC_E_015.ks/index/35/text"],["SC_E_015.ks/index/37/text"],["SC_E_015.ks/index/39/text"],["SC_E_015.ks/index/41/text"],["SC_E_015.ks/index/43/text"],["SC_E_015.ks/index/45/text"],["SC_E_015.ks/index/47/text"],["SC_E_015.ks/index/49/text"],["SC_E_015.ks/index/52/text"],["SC_E_015.ks/index/54/text"],["SC_E_015.ks/index/56/text"],["SC_E_015.ks/index/58/text"],["SC_E_015.ks/index/60/text"],["SC_E_015.ks/index/62/text"],["SC_E_015.ks/index/64/text"],["SC_E_015.ks/index/66/text"],["SC_E_015.ks/index/68/text"],["SC_E_015.ks/index/70/text"],["SC_E_015.ks/index/72/text"],["SC_E_015.ks/index/74/text"],["SC_E_015.ks/index/76/text"],["SC_E_015.ks/index/78/text"],["SC_E_015.ks/index/80/text"],["SC_E_015.ks/index/82/text"]],"tags":[],"parameters":[[{"start":144,"end":172}],[{"start":186,"end":188}],[{"start":200,"end":201}],[{"start":212,"end":246}],[{"start":260,"end":293}],[{"start":307,"end":432}],[{"start":446,"end":454}],[{"start":468,"end":505}],[{"start":519,"end":560}],[{"start":572,"end":580}],[{"start":594,"end":718}],[{"start":732,"end":808}],[{"start":822,"end":828}],[{"start":842,"end":938}],[{"start":952,"end":1016}],[{"start":1030,"end":1108}],[{"start":1122,"end":1161}],[{"start":1175,"end":1306}],[{"start":1320,"end":1366}],[{"start":1380,"end":1497}],[{"start":1511,"end":1528}],[{"start":1540,"end":1541}],[{"start":1552,"end":1553}],[{"start":1565,"end":1567}],[{"start":1581,"end":1668}],[{"start":1685,"end":1687}],[{"start":1700,"end":1703}],[{"start":1715,"end":1721}],[{"start":1735,"end":1858}],[{"start":1872,"end":1905}],[{"start":1919,"end":2068}],[{"start":2106,"end":2187}],[{"start":2201,"end":2268}],[{"start":2279,"end":2280}],[{"start":2291,"end":2292}],[{"start":2303,"end":2304}],[{"start":2315,"end":2321}],[{"start":2332,"end":2333}],[{"start":2344,"end":2351}],[{"start":2365,"end":2447}],[{"start":2461,"end":2485}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_015.ks","basename":"SC_E_015.ks","indexIds":{"夢を。[l]\nみている。[l]\n幾年も。":0,"若き":1,"処":2,"女のわたしと、\nあのひと。[l]\nそしてドレミリア。":3,"――センリが呼ぶ声がする。[l]\n相変わらず慇懃無礼な女。":4,"この女に任せたのにはやむない理由があった。[l]\nこの最果ての島國に、果たしてどれだけの魔眼の者が居るか\n分からなかった故に、\nLu･Leにも稀な、猫との親和性を持ったこの女を、\n永代に生かした方が良策と思えたからだ。":5,"あの白き者どもに":6,"輩の殆どを狩られていた為もある。[l]\n危険な賭けは出来なかった。":7,"というよりも、\n八人姉妹の妹の誰かが、\nわたしより先にこの島に逃げ":8,"果せていたのだ。":9,"この女がドレミリアを連れて私の前に現れた時は\n大層驚いた。[l]\nドレミリアを此処まで連れ出した妹の行方は知らないと言った。[l]\nドレミリアは『猫の萌芽』ツェロルと一緒だと言ったが、\n妹と共にどこかに消えたという。":10,"妹はこの女──センリ──に猫のカミを預けていた。[l]\n私達の最後の望み、無楽の病の末裔の一、\n黒の猫イツワの、それは成れの果てだった。":11,"８つのカミ。":12,"この女は、土着民から６人を探し出し、\nドレミリアを長として７人を揃えていた。[l]\n都合の好い事に３と親和する者は早々に現れたので、\nこの女に不老を与えることが出来た。":13,"アリスの直系、ドレミリア。[l]\nあの娘さえ、アリスの血統さえ残し得れば。[l]\nわたしの●●したひとの血脈を。":14,"他の姉妹が一体どうなったのか。[l]\n猫は。[l]\n只管逃げるしかなかったわたしには、\nもはや独りで奴等に抗う術も力も消耗していた。":15,"そう。[l]\nあくまで消耗だ。[l]\n回復さえすれば、しかし、":16,"ベロアは逃亡のさなか疵付いてしまった。[l]\nわたしの不老性には衰えが顕れるだろう。[l]\n只でさえヒトの手で創られた偽りの意志が込められた、\n即ちヒトの手による第十相を付与された猫は、\n忠実では在るが不安定で不完全な存在なのだ。":17,"魔眼の刺し手とやらが切り裂き封じた\n黒の猫、\nこのカミに縋るしかないだろう。":18,"しかしこの地の新たな継承者に託したが故か、\nそれとも魔眼の刺し手…白の連中の式であるが故か、[l]\n既にわたしの知っている式とは勝手の違うモノ、\n一筋縄で行けるかどうかは判らぬ――\n否、なんとしてでも。":19,"魔女の猫。[l]\n受肉せし":20,"使":21,"い":22,"魔。":23,"魔眼。[l]\n呪殺、\n不可視、\n不老と再生、\n毒、\n不正操作、\n喰、\n狂戦士、\n十の魔弾、\n飛行箒、\n":24,"骸 ":25,"操 る":26,"霊たる存在。":27,"わたしたちは身を隠してきたが、\n機は熟したという。[l]\nあれの誕生は……[l]\nまさに我等の復権に相応しいハレだ。[l]\nこの國で混じり薄まったかに思えたアリスの血が、\n再びわたしの前に顕れてくれたのだ。":28,"なのに此処に至って面倒な事が。[l]\n全き面倒な事である。":29,"八相を殺したモノを詮索し追撃している暇は最早無いやも知れぬが、早急に事を成せばそのような一切は瑣事となる。[l]\nベロアにもわたしにも時間が無い。[l]\n肉を得たが故に獲得した対老化能を故障したベロアには、\n新たな依代が必要だ。[l]\n同じ無楽の病から生じたあの──":30,"さて。[l]\nアリスの血を引きながら我等の敵となったあの兄妹、\n白の連中、\n『最悪の敵は己の中に居る』と、\n貴様達が教えたことだ。":31,"獅子身中の虫とはよく云ったもの、\n自らの組織を内部よりクイ破る、\n――そしてそのムシの中のムシ。[l]\n貴様は":32,"死":33,"屍":34,"無":35,"私、ナナシ、":36,"身":37,"獲りのハヤシ。":38,"さても何にとっての排出機構であることかよ。[l]\n赤き血より出でし狂白の災は病みし闇となろう。[l]\n十字の時の如くあれ、アイは破壊的に訪れるもの。":39,"わたしは必ずとりもどす、\n全てを統べて。":40},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_015.ks","relPath":"/data/scenario/SC_E_015.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":41,"length":41,"percent":100},"cellInfo":[null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[35,1],"note":"完成"},"/data/scenario/SC_E_016.ks":{"data":[["僕は――\n選択を迫られていた。","我――\n正被迫做出选择。"],["僕は正直、\nあなたに、\n好かれたかったんだと思う。","说实话，\n我大概，\n是希望被你喜欢的。"],["僕はいつも自分に自信がないし、\nそのくせ","我总是对自己缺乏信心，\n可偏偏"],["自","自"],["尊","尊"],["心だけは人並みに、[l]\n否、きっとそれ以上にあったから、\n自分がその『場』に於いて、\n存在してもいい価値を見出せない時には、[l]\n馴染む努力も放棄して、\n他人より劣っている事を自覚することで、\n逆説的に優位性を保とうと必死だった。","心却与常人无异，[l]\n不、恐怕更甚，\n当察觉自己在那个『场合』里\n找不到存在的价值时，[l]\n就会连融入的努力都放弃，\n通过自觉比他人逊色，\n如同悖论般地拼命维持优越感。"],["だから、\n","所以在\n"],["彼","那"],["処でも、\n","学校里\n"],["奴以外の友人は作れなかったし、[l]\n","除了那家伙外交不到朋友，[l]\n"],["此","来"],["処に来てからも、\n能動的に彼女達と交流することには躊躇していた。[l]\nあくまでも、仕事だからとか、\n向こうの方から来るからだとか、\n自分から積極的に彼女達に対して思い入れを持たないように\n意識していたのだと思う。","到这里后，\n也始终犹豫是否该主动与她们交流。[l]\n不断告诫自己只是工作所需，\n或是对方主动接近的缘故，\n刻意避免对她们产生\n多余的感情。"],["そして、今にして思えば、\nあなたがいつも心の何処かを占めていたからなのかも知れない、","如今想来，\n或许因为心底始终被你占据着，"],["しかし、[l]\n\nそう、彼女達が、\n更に僕を責め","但[l]\n\n没错，她们\n变本加厉地"],["苛む。","苛责我。"],["感情移入は勿論、\n僕と彼女等はきっと同じものを――","共情自不必说，\n我与她们定然渴求着同样的――"],["しかし、[l]\n\nどんな知人でも、僕の知らない、\n僕にみせていない面がある。[l]\nそれをふと見せ付けられた時に感じる、\nあの焦燥感、寂寥感。[l]\nこちらの勝手な思い込みとは言え、\n裏切られた、という感覚が心を締め付ける。[l]\n誰もが、それぞれの中心を持っているんだという、\n本来当たり前の事すら僕は、\n――僕は、","可是[l]\n\n任何熟人都有我不了解的、\n未曾向我展示的面貌。[l]\n当偶然窥见那副模样时，\n那份焦躁与寂寥。[l]\n虽说是自作多情，\n被背叛的窒息感仍攥紧心脏。[l]\n『每个人都拥有独立的核心』\n连这般理所当然的事\n――我也"],["集団に馴染めないのは当たり前で、\n僕は自分と相手という、\n話し手と聴き手の二人、\n意識を向けるべき対象が確定している状態でないと、[l]\n──それはつまり八方美人なのかも知れないし、\n自意識過剰でありつつ自己防衛の為の自己の貶めから起因する、\n自信の無いときには、\nつまり相手から無視黙殺されたらどうしようという状況下では、","无法融入集体是必然的，\n我必须明确\n说话者与倾听者的二人关系，\n否则便无法聚焦意识对象。[l]\n──这或许算是八面玲珑，\n或是源于过度自我意识与防卫性自贬的、\n当缺乏自信时，\n即预想可能被对方无视时，"],["だから、[l]\n\n僕は相手から受け入れて貰えないという事に\n恐怖を感じているが故に、[l]\n\n受け入れられない事は当然なんだという諦めや言い訳で防御して、[l]\n\nそうだ。","所以、[l]\n\n我因为害怕不被对方接受这件事、\n出于这种恐惧、[l]\n\n用『不被接受是理所当然的』这种放弃或借口来防御、[l]\n\n没错。"],["僕は徹底的に卑怯なんだ。[l]\n\n相手に嫌われるのが怖いんだ。[l]\n僕が卑屈になるのは、\n流されるがままに引き回されるのは、[l]\n\n劣等感から逃れたいが為だ。[l]\n責任の放棄なのかも知れない。","我是个彻头彻尾的懦夫。[l]\n\n我害怕被对方讨厌。[l]\n我会变得卑躬屈膝、\n随波逐流任人摆布、[l]\n\n都是因为想逃离自卑感。[l]\n或许也是在逃避责任。"],["場や器そのものを拒否していないと、\n自分以外に中心のある場にいると、[l]\n\n疎外感だけが、[l]\n\n好きになるとかいうよりも、\n嫌われたり、無能だと思われたり、\n無価値な奴だと思われる事に異常なまでに\n恐怖を感じて生きているのが僕だ。","只要不拒绝整个场合或容器本身、\n身处以他人为中心的场合时、[l]\n\n就只有疏离感、[l]\n\n比起说什么喜欢不喜欢、\n我更病态地恐惧着、\n被讨厌、被当成无能、\n被当作毫无价值的家伙——我就是这样活着的。"],["想像力は諸刃の剣だと、\nかの","就像那个\n女"],["女","性也说过、"],["性も言っていたように、[l]\nこちらのアクションに対して無言である事は、\nそのインターバルは僕にとっては、\n脳が","想象力是把双刃剑、[l]\n对方对我的行动保持沉默时、\n那段间隔对我来说、\n大脑会"],["厭な想像を走らせる期間となる。[l]\n負のスパイラル。","不断产生糟糕的想象。[l]\n恶性循环。"],["その中で、\nあなたが僕に与えた奇妙な感情は、\n","而在其中、\n你带给我的那种奇妙情感、\n"],["途","是"],["轍もなく心地良い距離感で、\n時に身を","毫无滞涩的舒适距离、\n却又时常夹杂着"],["捩る程の切なさを伴って、\nある時は僕を","令人揪心的苦闷、\n有时会折磨着我"],["苛んだけれど、[l]\n\n──これを恋愛感情かと言われれば、\nそれは多分違うと思う。[l]\nコイではきっとない。[l]\nじゃあ、アイ、なんだろうか。","但——[l]\n\n若问这是否算恋爱感情、\n我想大概不是。[l]\n肯定不是恋慕之情。[l]\n那么，这份‘爱’，这到底是什么呢。"],["畏敬の念なのかも知れないな。[l]\nこの人になら、と思えるのだから、","或许是敬畏之情吧。[l]\n因为觉得若是这个人的话、"],["そう、だから、[l]\n\n僕は、\nあなたになら、","没错、所以、[l]\n\n我、\n若是你的话、"],["僕に『その価値がある』という理由でもってしてくれるならば、\nあなたに僕をそうさせる意味が、少しでも存在してくれさえすれば、\nその瞬間に僕を視てくれているなら、[l]\n\n喜んであなたの望むものになるための礎になる。","只要你能给我『你值得』的理由、\n只要让我觉得让你这样做的意义哪怕存在一点点、\n只要那一刻你正注视着我、[l]\n\n我会甘愿成为实现你愿望的基石。"],["元より状況に流されるまま生きてきた僕にとって、\nそれは消極的ではあるが肯定的な意味を、自分自身に見出せる[l]\n……と錯覚できることだから。","对于向来随波逐流的我而言、\n这虽消极却能从自身找到积极意义——[l]\n……能产生这种错觉。"],["でも、もう、[l]\n最初からそれすらの価値も無いのなら、[l]\n最初から僕に何も求めていなかったのなら、[l]\n最初からほんとうは僕以外の何かを視ていたのなら、[l]\n\n僕の採るべき選択は――","但是、如果[l]\n从一开始连这都不值得、[l]\n从一开始就对我毫无期待、[l]\n从一开始真正注视的就不是我、[l]\n\n那我该做的选择就是――"],["@r@r@r@r","@r@r@r@r"],["僕は思いっきりそこで、\n恥も外聞もなく子供のように大声を上げて、[l]\n泣いた。","我会在那里尽情地、\n不顾羞耻与体面像孩子般放声、[l]\n大哭。"],["@r@r@r@rかつてそこに僕らが墓標をつくった、[l]\n猫の死骸の埋められたあの、[l]\n砂の城は、もうない。","@r@r@r@r曾经我们在那里立了墓碑、[l]\n埋葬猫尸体的那座、[l]\n沙堡已经不复存在。"],["@r@r@r@r@r@r","@r@r@r@r@r@r"],["とっくの昔に、消えて","早在很久以前、就已经消逝"],["喪","丧"],["失ってた。","失了。"]],"context":[["SC_E_016.ks/index/1/text"],["SC_E_016.ks/index/3/text"],["SC_E_016.ks/index/5/text"],["SC_E_016.ks/index/7/text"],["SC_E_016.ks/index/9/text"],["SC_E_016.ks/index/11/text"],["SC_E_016.ks/index/13/text"],["SC_E_016.ks/index/16/text","SC_E_016.ks/index/21/text"],["SC_E_016.ks/index/18/text"],["SC_E_016.ks/index/23/text"],["SC_E_016.ks/index/26/text"],["SC_E_016.ks/index/28/text"],["SC_E_016.ks/index/30/text"],["SC_E_016.ks/index/32/text"],["SC_E_016.ks/index/34/text"],["SC_E_016.ks/index/36/text"],["SC_E_016.ks/index/38/text"],["SC_E_016.ks/index/40/text"],["SC_E_016.ks/index/42/text"],["SC_E_016.ks/index/44/text"],["SC_E_016.ks/index/46/text"],["SC_E_016.ks/index/48/text"],["SC_E_016.ks/index/50/text"],["SC_E_016.ks/index/52/text"],["SC_E_016.ks/index/54/text"],["SC_E_016.ks/index/56/text"],["SC_E_016.ks/index/59/text"],["SC_E_016.ks/index/61/text"],["SC_E_016.ks/index/63/text"],["SC_E_016.ks/index/65/text"],["SC_E_016.ks/index/67/text"],["SC_E_016.ks/index/69/text"],["SC_E_016.ks/index/71/text"],["SC_E_016.ks/index/73/text"],["SC_E_016.ks/index/75/text"],["SC_E_016.ks/index/77/text"],["SC_E_016.ks/index/80/text"],["SC_E_016.ks/index/82/text"],["SC_E_016.ks/index/84/text"],["SC_E_016.ks/index/87/text"],["SC_E_016.ks/index/89/text"],["SC_E_016.ks/index/91/text"]],"tags":[],"parameters":[[{"start":114,"end":133}],[{"start":141,"end":174}],[{"start":182,"end":206}],[{"start":215,"end":216}],[{"start":226,"end":227}],[{"start":236,"end":377}],[{"start":385,"end":390}],[{"start":404,"end":405},{"start":433,"end":434}],[{"start":414,"end":419}],[{"start":443,"end":462}],[{"start":475,"end":476}],[{"start":485,"end":612}],[{"start":620,"end":666}],[{"start":674,"end":710}],[{"start":721,"end":724}],[{"start":732,"end":761}],[{"start":769,"end":968}],[{"start":976,"end":1166}],[{"start":1174,"end":1282}],[{"start":1290,"end":1415}],[{"start":1423,"end":1569}],[{"start":1577,"end":1595}],[{"start":1604,"end":1605}],[{"start":1614,"end":1682}],[{"start":1692,"end":1723}],[{"start":1731,"end":1758}],[{"start":1772,"end":1773}],[{"start":1782,"end":1804}],[{"start":1814,"end":1837}],[{"start":1848,"end":1939}],[{"start":1947,"end":1985}],[{"start":1993,"end":2026}],[{"start":2034,"end":2154}],[{"start":2162,"end":2240}],[{"start":2250,"end":2364}],[{"start":2370,"end":2382}],[{"start":2430,"end":2478}],[{"start":2503,"end":2575}],[{"start":2581,"end":2601}],[{"start":2623,"end":2633}],[{"start":2643,"end":2644}],[{"start":2653,"end":2658}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_016.ks","basename":"SC_E_016.ks","indexIds":{"僕は――\n選択を迫られていた。":0,"僕は正直、\nあなたに、\n好かれたかったんだと思う。":1,"僕はいつも自分に自信がないし、\nそのくせ":2,"自":3,"尊":4,"心だけは人並みに、[l]\n否、きっとそれ以上にあったから、\n自分がその『場』に於いて、\n存在してもいい価値を見出せない時には、[l]\n馴染む努力も放棄して、\n他人より劣っている事を自覚することで、\n逆説的に優位性を保とうと必死だった。":5,"だから、\n":6,"彼":7,"処でも、\n":8,"奴以外の友人は作れなかったし、[l]\n":9,"此":10,"処に来てからも、\n能動的に彼女達と交流することには躊躇していた。[l]\nあくまでも、仕事だからとか、\n向こうの方から来るからだとか、\n自分から積極的に彼女達に対して思い入れを持たないように\n意識していたのだと思う。":11,"そして、今にして思えば、\nあなたがいつも心の何処かを占めていたからなのかも知れない、":12,"しかし、[l]\n\nそう、彼女達が、\n更に僕を責め":13,"苛む。":14,"感情移入は勿論、\n僕と彼女等はきっと同じものを――":15,"しかし、[l]\n\nどんな知人でも、僕の知らない、\n僕にみせていない面がある。[l]\nそれをふと見せ付けられた時に感じる、\nあの焦燥感、寂寥感。[l]\nこちらの勝手な思い込みとは言え、\n裏切られた、という感覚が心を締め付ける。[l]\n誰もが、それぞれの中心を持っているんだという、\n本来当たり前の事すら僕は、\n――僕は、":16,"集団に馴染めないのは当たり前で、\n僕は自分と相手という、\n話し手と聴き手の二人、\n意識を向けるべき対象が確定している状態でないと、[l]\n──それはつまり八方美人なのかも知れないし、\n自意識過剰でありつつ自己防衛の為の自己の貶めから起因する、\n自信の無いときには、\nつまり相手から無視黙殺されたらどうしようという状況下では、":17,"だから、[l]\n\n僕は相手から受け入れて貰えないという事に\n恐怖を感じているが故に、[l]\n\n受け入れられない事は当然なんだという諦めや言い訳で防御して、[l]\n\nそうだ。":18,"僕は徹底的に卑怯なんだ。[l]\n\n相手に嫌われるのが怖いんだ。[l]\n僕が卑屈になるのは、\n流されるがままに引き回されるのは、[l]\n\n劣等感から逃れたいが為だ。[l]\n責任の放棄なのかも知れない。":19,"場や器そのものを拒否していないと、\n自分以外に中心のある場にいると、[l]\n\n疎外感だけが、[l]\n\n好きになるとかいうよりも、\n嫌われたり、無能だと思われたり、\n無価値な奴だと思われる事に異常なまでに\n恐怖を感じて生きているのが僕だ。":20,"想像力は諸刃の剣だと、\nかの":21,"女":22,"性も言っていたように、[l]\nこちらのアクションに対して無言である事は、\nそのインターバルは僕にとっては、\n脳が":23,"厭な想像を走らせる期間となる。[l]\n負のスパイラル。":24,"その中で、\nあなたが僕に与えた奇妙な感情は、\n":25,"途":26,"轍もなく心地良い距離感で、\n時に身を":27,"捩る程の切なさを伴って、\nある時は僕を":28,"苛んだけれど、[l]\n\n──これを恋愛感情かと言われれば、\nそれは多分違うと思う。[l]\nコイではきっとない。[l]\nじゃあ、アイ、なんだろうか。":29,"畏敬の念なのかも知れないな。[l]\nこの人になら、と思えるのだから、":30,"そう、だから、[l]\n\n僕は、\nあなたになら、":31,"僕に『その価値がある』という理由でもってしてくれるならば、\nあなたに僕をそうさせる意味が、少しでも存在してくれさえすれば、\nその瞬間に僕を視てくれているなら、[l]\n\n喜んであなたの望むものになるための礎になる。":32,"元より状況に流されるまま生きてきた僕にとって、\nそれは消極的ではあるが肯定的な意味を、自分自身に見出せる[l]\n……と錯覚できることだから。":33,"でも、もう、[l]\n最初からそれすらの価値も無いのなら、[l]\n最初から僕に何も求めていなかったのなら、[l]\n最初からほんとうは僕以外の何かを視ていたのなら、[l]\n\n僕の採るべき選択は――":34,"@r@r@r@r":35,"僕は思いっきりそこで、\n恥も外聞もなく子供のように大声を上げて、[l]\n泣いた。":36,"@r@r@r@rかつてそこに僕らが墓標をつくった、[l]\n猫の死骸の埋められたあの、[l]\n砂の城は、もうない。":37,"@r@r@r@r@r@r":38,"とっくの昔に、消えて":39,"喪":40,"失ってた。":41},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_016.ks","relPath":"/data/scenario/SC_E_016.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":42,"length":42,"percent":100},"cellInfo":[null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"v":1}],[null,{"t":"HU","v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[40,0],"note":"完成"},"/data/scenario/SC_E_017.ks":{"data":[["@r@r@rＷＣＬ所蔵、単純資料類\nインストールウィザード準備中である●●年前の会話録\n一部暗号化未解読\n不鮮明部位多々有り","@r@r@rWCL所藏，单纯资料类\n安装向导准备中●●年前的对话记录\n部分加密未解密\n存在多处模糊部位"],["「久しぶり……になるかな？」","「好久不见……了吧？」"],["「………[l]\n直接","「………[l]\n直接"],["相","相"],["見えるのは初かも知れぬが。[l]\nいずれ今は只のヒトだ。[l]\n","见或许是第一次。[l]\n反正现在的我只是个普通人。[l]\n"],["其","你"],["方が白のミルハだな？[l]\nあの異端者の●にして●たる最強の」","就是白之米尔哈吧？[l]\n那个异端者的●同时也是●的最强者」"],["「……君はヒト前でもそんな喋りしてるのかい？[l]\n『只のヒト』はその肉年齢でそんな口調で会話したりしないよ。[l]\n寝過ぎたようだね。[l]\n言語もこの國に帰化したようだけど。[l]\nそれはそれで好都合」","「……你当着人类面也这么说话吗？[l]\n『普通人』可不会用这种语气，说出和自己年龄不符的话哦。[l]\n看来是睡太久了。[l]\n连语言都归化到这个国家了。[l]\n不过这样倒也方便」"],["「さて、何の用だ。[l]\nあの異端者の同調者が其処彼処に視えるのは知っている。[l]\nこの肉を","「那么，有何贵干。[l]\n我知道那个异端者的同伙遍布各处。[l]\n这副躯体"],["悉","完"],["皆まともに動かせるまで、\n少々年月を要したが、その間我の周りには\n紙封の遣い手ばかりが」","全正常运作之前，\n虽耗费了些年月，但那期间我周围尽是\n纸封的使用者」"],["「其処彼処も何も、\n君がかつて奪った骸はそもそも我々の眷属だよ。[l]\n当然今もその肉の元の属性に従って貰って、\n子孫一族我々の仲間。[l]\n君は私達の勢力圏の真っ只中に居るんだからね。[l]\n庇護されてると言ってもいい。[l]\n当然だよ。","「说什么遍布各处，\n你当初夺取的尸骸本就是我们眷属。[l]\n如今自然要让这躯体服从原本属性，\n子孙一族都是我们同伴。[l]\n你现在可是身处我们势力范围正中央。[l]\n说是受我们庇护也不为过。[l]\n理所当然啊。"],["さて。[l]\n理論上","好了。[l]\n理论上"],["Ｄのように代々継承されるのはＹ経由なのに、\n君はどうしたことかその辺りで重大なバグ、或いはエラーが起きたようでね。[l]\n君の存在は消えては居ないが、顕在化するのはシステム上無理だった。[l]\n殆ど修復は不可能だったんだよ。[l]\nソフトウェアというよりもハードウェアの問題で、\nかといってフォーマットしては意味がない。[l]\n全体を丸ごとムーヴは出来るようだったが、\n","D的世代传承本该通过Y实现，\n但你不知为何在那环节出现了重大bug或error。[l]\n你的存在虽未消失，但系统层面无法显化。[l]\n几乎无法修复。[l]\n与其说是软件问题不如说是硬件故障，\n但格式化又毫无意义。[l]\n虽然能做到整体迁移，\n"],["走らせる事はどうしても出来ない。[l]\nまあ、手を加えてどうにか出来る程には、\n誰もシステムを解っていた訳じゃない。","却无论如何无法运行。[l]\n况且也没人精通系统到\n能通过调试解决问题的程度。"],["しかしそれ故に、\n取り敢えずは保留として君を内在させたまま代を重ねる事にしたんだ。[l]\nいずれ解決出来る方策が見つかるかも知れなかったし、\n黒のイツワの１０を失うなんてあまりに惜しかったしね。[l]\nだから随分と待ったよ。[l]\n君が顕れるまでには相当の年月が掛かった。[l]\nと言うより半ば諦めていた……と言ったら君の肉の方の血筋に[l]\n申し訳ないけどね。","正因如此，\n才决定暂且将你作为内置模块保留着迭代。[l]\n或许将来能找到解决方案，\n毕竟失去黑之伊兹瓦的10实在太可惜。[l]\n所以等了很久啊。[l]\n到你显形花了相当长的岁月。[l]\n不如说几乎要放弃了……这么说对你肉体血脉的[l]\n先祖们有点失礼。"],["結局我々は待つ事以外してなかったけど、\nこうやって今、\n君と私は会話が出来ているという訳。[l]\n何とか彼女達の役目も果たされたという訳だ」","虽然我们除了等待别无他法，\n但现在\n你我总算能像这样对话了。[l]\n她们的任务总算是完成了」"],["「『ばぐ』とは何だ？[l]\n何を言っているのか判りづらいな其方は。[l]\n話も長い。[l]\nまあ良いだろう。[l]\n我の片割れはどうした？」","「『霸葛』是什么？[l]\n你的话真难懂。[l]\n还特别冗长。[l]\n算了无所谓。[l]\n我的另一半呢？」"],["「んむ？[l]\n君が眠りにつくより前に行方知れずになったままだよ。[l]\nでも、案外近くにいるかもね……何しろ君は、[l]\n──否、その話は後回し、というより確信に迫る話なんだな。[l]\n追々話すよ。","「嗯唔？[l]\n在你陷入沉睡之前就下落不明了哦。[l]\n不过，说不定意外地就在附近呢……毕竟你，[l]\n──不，这事稍后再说，不如说是接近确信的话题吧。[l]\n之后会慢慢告诉你的。"],["さて、\n元より敵同士だったのはもう……[l]\n遙か過去の事だし、\nそもそも私達は一つだろう。[l]\n争う理由は最早ない──と言っても良いかな。[l]\nそれよりも、\n今の君じゃ君の『元の肉』を関知するには厳しいかい？[l]\n『今の肉』も魔眼質なのかな？」","那么，\n原本是敌人的关系早就……[l]\n是遥远的往事了，\n说到底我们本就是一体的吧。[l]\n可以说已经没有争斗的理由了──[l]\n比起这个，\n现在的你要感知『原初之肉』还很困难吗？[l]\n『现世之肉』也具备魔眼特质吗？」"],["「先に言った通りだ、\nまともに動かせるようになったのはつい近頃だからな。[l]\nそれどころではなかったのだ。[l]\n我の肉……既に分かたれた挙げ句にカミにホウじられたのだぞ。[l]\n其方等が持って行ったのだろう。[l]\nだからこそ我を十全の名で呼ばぬのだろうが」","「正如先前所言，\n最近才能勉强自如活动。[l]\n根本无暇顾及那些。[l]\n吾之肉……早已被分割且奉献给神明。[l]\n想必是被你们带走了吧。[l]\n所以你们才不肯用十全之名称呼吾」"],["「まあ、十全だろうと十相だろうと名前なんていいじゃないか。[l]\n範疇錯誤というやつ？[l]\n而してイツワと呼ぶにはあまりに今の君は足りなすぎてるからね。[l]\nかといって正確に呼ぶのも面倒だし……","「哎呀，十全也好十相也罢名字无所谓啦。[l]\n这叫范畴谬误？[l]\n况且现在的你根本配不上伊兹瓦这个名号。[l]\n但准确称呼又太麻烦……"],["というかね、君は誤解してるよ。[l]\n我々は君の肉、そう、９枚を回収してない。[l]\nその辺りの事情は徐々に説明する。[l]\nで、\nその十全への再統合を手伝おう、\nという話なんだけどね」","话说回来，你搞错了。[l]\n我们并未回收你的肉，没错，那九片。[l]\n这些原委会逐步说明。[l]\n所以，\n想协助你重新统合为完全体，\n就是这么回事」"],["「──只ではあるまい？[l]\n今更虫のよい話だからな。[l]\n何が条件なのか言うてみよ」","「──不可能免费吧？[l]\n事到如今哪有这等美事。[l]\n说说条件」"],["「私達の──兄様の力になってほしい、\n平たく言えば仲間にならないか、ということなんだけど」","「希望你能成为我们──兄长大人的力量，\n简单来说就是邀请你入伙」"],["「仲間？[l]\n軍門に降れというのか。[l]\nLu=Leと未だに争っておるのか？[l]\n八人や『ＷＥ』の殆どは其方等に制圧されたのだろうが。[l]\n今更我の力を要するとは如何なる相手か」","「入伙？[l]\n是要我臣服吗。[l]\n你们还在和Lu=Le争斗？[l]\n八姐妹和『WE』大半都被你们镇压了吧。[l]\n如今还需要吾的力量，对手是何方神圣」"],["「一番面倒な","「最麻烦的"],["女が残ってるんだねぇこれが」","那个女人还留着呢」"],["「……其方より面倒な女が居るとは思えぬが」","「……难以想象还有比你更麻烦的女人」"],["「失礼な事を言うね。[l]\nLu=Leの殆どは確かにもういないけど、\n──覚えてるかな？[l]\n『八人姉妹』の長姉ミリアム・シュブ、その他数名、\nツェロルと共に未だ行方不明……違うか。[l]\n正確には、\n関係者とその居場所は掌握してる。[l]\nミリアム本人だけは未だに行方を掴めない」","「真失礼啊。[l]\nLu=Le确实基本覆灭了，\n──还记得吗？[l]\n『八姐妹』长女米莉安姆・舒布等数人，\n与赛萝洛一同下落不明……不对。[l]\n准确地说，\n相关人员和藏身处都已掌握。[l]\n唯独米莉安姆本人依然行踪成谜」"],["「『ＷＥ』の第一位にしてかの猫ベロアが健在なのか」","「『WE』首席的那只猫贝萝娅居然还健在」"],["「まあそんなところかな。[l]\nフェンリロスはまだ使えないし。[l]\n実働してもベロアの結界を突破出来るかどうかは分からない」","「差不多吧。[l]\n芬里洛斯还不能投入使用。[l]\n即便行动也不确定能否突破贝萝娅的结界」"],["「それで」","「所以」"],["「ま、実際ミリアムは後回しでも一向に構わないんだよね。[l]\nで、そのミリアムの関係者というのが、\n君の断片を遣ってる連中。[l]\nそう、我々じゃなくて其奴等が君の残りを持っていった張本人だよ。[l]\nカミ自体はミリアムじゃなくて其奴等の管理下だから」","「其实米莉安姆放着不管也无所谓。[l]\n关键是她的相关者，\n正是驱使你碎片的那些家伙。[l]\n没错，不是我们而是他们带走了你剩余的部分。[l]\n神明本身不在米莉安姆而在他们管理下」"],["「","「"],["何","在"],["処に居るか」","何处」"],["「『此処』さ。[l]\n君の子孫が延々と根付いた『此処』に、\n顔付き合わせて永い間ずっとね。[l]\n無論彼女達は知らない、と思うよ。[l]\n自分達は他とは違うという証拠を持ち得た彼女達は、\n……ま、それはいいや。","「就在『这里』啊。[l]\n在你子孙世代扎根的『这里』，\n我已经和她们面对面相处了很久很久了。[l]\n不过我想她们应该不知道吧。[l]\n这些拥有证明自己与他人不同的证据的她们，\n……算了，这个先不提。"],["ミリアムは用心深いから結構な縛りを与えてたようだけど、\nこちらも監視を兼ねて、君の奪ったあの『魔眼の刺し手』の身体の子孫、\nつまり今の君の属する一族『●●』が君を産むまで、\n準備をしながら待っていた。[l]\n此処はまさに我々の箱庭という訳」","米莉安姆因为很谨慎所以施加了相当强的束缚，\n我们这边也顺便监视着你夺来的那具『魔眼杀手』身体的子孙，\n也就是直到现在你所属的『●●』一族诞生你为止，\n一边准备一边等待着。[l]\n这里简直就是我们的箱庭」"],["「それは御苦労な事だな。[l]\n９枚全てが此処に？」","「那可真是辛苦你了。[l]\n9枚全都在这里？」"],["「否、PHASE:9だけはまだ見つかっておらず、\n彼女達の管理下にもない。[l]\nただ、それこそフェンリロスが稼働すれば見つかるとは思うよ。[l]\n今や彼女達は９は探すつもりはないようだし。[l]\n昔はどうか知らないけど」","「不，只有PHASE:9还没找到，\n也不在她们的管理范围内。[l]\n不过我觉得只要芬里洛斯启动就能找到。[l]\n现在她们似乎也没打算寻找9。[l]\n虽然不知道过去如何」"],["「詰まるところ我は統合されて、\n其方等の傘下に入りミリアム等を駆逐すればよいのか？」","「也就是说只要我被整合，\n加入你们麾下驱逐米莉安姆她们就行？」"],["「まあそうだねぇ……[l]\n実際のところ兄様の本心は私にも分からないけど──\n取り敢えず興味があるのは、\n君が『呼び水たる月の雫』の資質なのかどうか、\nってこと」","「嘛差不多吧……[l]\n其实兄长大人真正的想法我也不清楚──\n但眼下感兴趣的是，\n你是否具备『引月之雫』的资质，\n这件事」"],["「月の雫だ？」","「月之雫？」"],["「本来ならば君が再臨する可能性は恐ろしく低かったのは、\n否、ほぼ不可能だった筈なのは、\n先刻言った通り。[l]\n起きる確率が限りなく零に近い事象が起きたとき、そこには──」","「按理说你重新降临的可能性极低，\n不，本该近乎不可能的，\n正如刚才所说。[l]\n当发生概率无限趋近于零的事件时，那里就会──」"],["「始祖達の時のようにか」","「就像始祖们那时一样吗」"],["「そういう事。[l]\n我等ねこが降ろされた時のように、\n君が再び受肉してこの世に顕現したとは、\nまさに、\n『呼び水たる月の雫』の再臨ではないかと兄様は言った。","「正是如此。[l]\n就像我们猫降临之时那样，\n你重新获得肉体显现在这个世界，\n简直就是，\n兄长大人说这很可能就是『引月之雫』的再临。"],["とは言え『雫』は後代の者達が過去を振り返ってそう\n評するものだし、\n渦中の者が判ずる事が出来るものかどうかは……[l]\n兄様にも何か考えがあるようだけどぉ──","虽说『雫』是后世之人回顾过去时\n才如此称呼的，\n局中人能否意识到就……[l]\n不过兄长大人似乎另有考量──"],["ま、例えそうでなかろうと、\n君が私達の傘下に入れば\nとても納まりが好いと思うんだよ。[l]\n白と黒の（不明瞭）、\n本来対のパラミアキス、メイルとフィーメイルの受肉せし姿。[l]\n今なら君も、ヒトの肉を持つし丁度良いだろう」","嘛，就算不是这样，\n只要你加入我们麾下\n我觉得会是个很完美的结局。[l]\n白与黑的（模糊不清），\n本该成对的帕拉米亚基斯，男性与女性的肉身形态。[l]\n现在你也拥有人类的肉体正合适吧」"],["@r@r@r（不鮮明部位）","@r@r@r（模糊不清部分）"],["「んむ、\n出来うるだけ穏便にしたいんだけど。[l]\nもし素直に願いを聞いてくれないならば、\n仕方ないね。[l]\nこちらにはペイルホワイトがあるし、\nいざとなればテトライの遣い手たるEnderナンバーも","「嗯唔，\n我本想尽可能温和处理的。[l]\n如果你不肯乖乖听话的话，\n那就没办法了。[l]\n我们这边可有佩尔怀特，\n必要时还有身为Tetorai使用者的的Ender编号"],["活きの良いのが居る。","那些生龙活虎的家伙。"],["強制改宗にしろ完全に紙封するにしろ、\n悪いけど我等の管理下からは逃れられないよ。[l]\nそう言う意味で選択肢は無いに等しいんだけど……[l]\nどう考えても君には、\n断るメリットは無いと思うなあ。[l]\nだからこれは善意の交渉と思って欲しいね」","无论是强制改宗还是彻底封印，\n很遗憾你都逃不出我们的掌控。[l]\n从这个意义上来说你几乎没得选……[l]\n但不管怎么想，\n我都觉得你没有拒绝的理由呢。[l]\n所以希望你能把这当作善意的谈判」"],["「我とて馬鹿ではない。[l]\n今更固執する何があるでもなし、\n敢えていうならばその『本来の肉』を我が手に戻す事が意義。[l]\nそれを取り戻させるのが其方等であろうと、\n最早Lu=Leは（不明瞭）」","「我也不是傻子。[l]\n事到如今已无执着之物，\n硬要说的话，将『原本的肉体』夺回手中才有意义。[l]\n无论是你们来帮我夺回它也好，\n如今的Lu=Le已是（不明了）」"],["「大体、君は生まれ出る事が出来たとは言え、\n本来ならば有り得ないと言わざるを得ない極めて希有な状態なんだ\nからね。[l]\nPHASE:10をその肉からまた移動させれるかどうかは甚だ不安だ。[l]\nそれに、今更以前の身に戻ってもしょうがないだろ？[l]\nま、ARCHIVEに保存はしておいてあげるよ。[l]\nいずれツェロルが（不明瞭）」","「说到底，虽说你得以降生，\n但这终究是原本绝不可能存在的极特殊状态\n啊。[l]\n能否再次将PHASE:10从那具肉体转移出来实在令人不安。[l]\n况且，事到如今就算恢复原状也无济于事了吧？[l]\n嘛，我会帮你保存在ARCHIVE里的。[l]\n迟早赛萝洛会（不明了）」"],["@r@r@r（暫く不鮮明のまま）","@r@r@r（持续模糊不清）"],["@r@r@r（再可聴）","@r@r@r（恢复可听状态）"],["「まあ良かろう。[l]\n其方の言に従おうか。[l]\n流れのままに身を委ねる、それで佳い。[l]\nこの肉の","「也罢无妨。[l]\n就遵从尔等所言吧。[l]\n随波逐流，如此便好。[l]\n这具肉体的"],["質でもある。[l]\nしかし充電は必要だ。[l]\n起こすのは９が見つかってからにするがいい。[l]\n未だ見つかっていないのだったな？」","本质使然。[l]\n但需要充电。[l]\n等找到9再唤醒也不迟。[l]\n说起来还没找到对吧？」"],["「その通り。[l]\n君が顕在化するまでは、\n９の探索は優先度が低かったと言うのもあるけど……","「正是如此。[l]\n在你显化之前，\n9的搜索优先级确实较低……"],["今フェンリロスを使えるメンバーは\n一人被親和候補の女子が居るけど、\n本契約及び更新作業には時がかかる。[l]\nああ、その候補者が生まれたのも、\nつい最近だからね。","如今能驱使芬里洛斯的成员\n虽有一名被亲和候选的姑娘，\n但正式契约及更新手续需要时间。[l]\n啊，那位候选者诞生\n也是最近的事。"],["ほら、どうしても『月の雫』のバイアスを考えてしまうのさ。[l]\nいずれ本格的に探索を開始するのは数年先になるよ。[l]\nそれまでは精々愉しみに、\n箱庭を創っておこうか」","你看，总会不自觉地考虑『月之雫』的偏差问题。[l]\n正式展开搜索至少是几年后的事了。[l]\n在此之前不如尽情享乐，\n先造个箱庭玩玩如何？」"],["「其方等の悪い癖だな。[l]\n愉悦を信条にしていてはいずれ道を過つぞ」","「尔等的恶习啊。[l]\n若以愉悦为信条迟早会误入歧途」"],["「んむー？[l]\n寧ろ逆でしょお」","「嗯哼～？[l]\n应该说恰恰相反吧～」"],["「個としてはそれで善いかも知れぬが……[l]\n──","「对个体而言或许无妨……[l]\n──"],["斯","此"],["様な会話は無意味だな。止すとしよう」","等对话毫无意义。就此打住吧」"],["「話は済みましたかね？[l]\nでは細工が要るのですよ、\n貴方が奴等のscanに引っ掛からないように色々と。[l]\nfirewallか、人為的且つ目覚まし付きのtorporか……[l]\n加えて仕込みもしなければならない、\nその日が来た時に即戦力になれるよう」","「谈妥了吗？[l]\n那需要做些手脚，\n确保你不会被他们的scan检测到。[l]\nfirewall（译注：防火墙）也好，人为带唤醒功能的torpor（译注：冬眠）也罢……[l]\n还得预先埋入后手，\n以便那天来临时能立即投入战斗」"],["「すきゃん？」","「司坎？」"],["「十全でいうPHASE:5に特化した諸々の……[l]\nまあそれはどうでもいいんですが。[l]\n彼女等にしてみれば保険と防衛と維持強化を兼ねた\nritesとでも言いましょうかね。[l]\n貴方が休眠中も延々としてましたよ」","「准确说是专为十全中的PHASE:5特化的各种……[l]\n嘛这个暂且不提。[l]\n对她们而言算是集保险、防卫与强化维持于一体的\n姑且称之为rites（译注：仪式）吧。[l]\n在你休眠期间可一直没停过哦」"],["「まあ、そこは今の君の肉の母親の言うとおり、\n暫くは此処から離れて暮らして貰う事で当面回避は出来るだろう。[l]\nと言うより、君は現状、一時的に本家に逗留してるという形だしね。[l]\nいずれ仕込みが終わったら向こうに戻って貰うでしょ」","「嘛，正如你现在这具肉体的母亲所说，\n暂时离开这里生活应该能回避当前问题。[l]\n不如说你现在形式上算是暂住在本家。[l]\n等准备完毕就会让你回去的吧」"],["「さすればどれが（不明瞭）[l]\n我自身か？[l]\n我とは別に仮初めの（不明瞭）」","「如此一来哪个才是（不明了）[l]\n是我自身？[l]\n抑或是与我不同的临时的（不明了）」"],["「取り敢えず今までの記憶が無いままproxyを新規で立てても\n不自然だろうから、現状までの（不明瞭）を継続しつつ、[l]\n@r（不鮮明部位）[l]\n@r君の相対したあの刺し手のテトライ零号をpromptとして、[l]\n（不明瞭）」","「暂且不说，在没有过往记忆的情况下新建proxy（译注：代理）\n会显得不自然，所以维持现状的（不明了）同时，[l]\n@r（模糊部分）[l]\n@r以你遭遇过的那个刺客的Tetorai零号作为prompt（译注：提示语、契机），[l]\n（不明了）」"],["「ドレミリア？」","「德蕾米莉娅？」"],["「？[l]\nああ、\nいや、あれは」","「？[l]\n啊啊，\n不，那个」"],["「じゃあ、あとは任せた。[l]\n私もしばらく付き合うけど、\nあんまり此処に居るのも良くないし。[l]\nある程度の目処が立ったらお先するね」","「那剩下的就交给你了。[l]\n我也会暂时帮忙，\n不过老待在这里也不太好。[l]\n等事情有眉目了我就先撤啦」"],["「私も残りのCovenに諸々通達しなければならないので。[l]\n人員としてどれを駆り出すか……[l]\n001:GMナンバーたるあの方がどの段階で介入──いえ、\nご助力？[l]\n貴女にとってはどちらか分かりませんがねワタシには。[l]\n兎に角動かれるのかどうかは戻ってから確認します」","「我也得向剩余Coven成员传达各项事宜。[l]\n该调动哪些人员……[l]\n001:GM编号那位大人会在什么阶段介入——不，\n协助？[l]\n对你来说或许分不清，但对我来说可不一样。[l]\n总之是否行动等回去后再确认」"],["「あの女が知らない訳ないからもう動いてるでしょ。[l]\n用があれば言ってくるだろうしスルーしとけば」","「那个女人不可能不知道肯定已经行动了。[l]\n有事自然会来找我们，置之不理就行」"],["「その辺りはそつなく進めておきますが。[l]\nでは、ワタシも行きますよ。[l]\nご自愛を、白のミルハ、\nOmegaの瞳の祝福あれ」","「那些环节我会妥善处理。[l]\n那么，我也该走了。[l]\n请多保重，纯白的米尔哈，\n愿Omega之瞳祝福你」"],["@r@r@r（数分の間の後、独り言）","@r@r@r（数分钟后的自言自语）"],["「さて、メモしておかないと忘れそうだなあ。[l]\nまああの女が事細かく記録はしてるんだろうけど……[l]\nま、多少は自分でも忘れといた方がぁ、\nいざ本番の時に新鮮で面白いかもっ。[l]\n久々の大きな娯楽だから愉しまねば。[l]\nうひひ、期待してるよ」","「得记下来不然该忘了。[l]\n不过那个女人肯定事无巨细都记录了吧……[l]\n嘛，有些事自己忘了反而\n正式开始时可能更有新鲜感呢。[l]\n这可是久违的大型娱乐得好好享受。[l]\n嘿嘿，我很期待哦」"],["@r@r@r（更に十数分のブランクの後、\n最後に記録されていたもの、\n男女二人の幼児の声）","@r@r@r（又经过十几分钟空白后，\n最后记录的片段，\n男女两名幼童的声音）"],["「だぁれ？」","「你是谁呀？」"],["「ぼく？[l]\nぼくは、[l]\nいー、[l]\nいー、」","「我？[l]\n我是，[l]\n伊——，[l]\n饭————，」"],["@r@r@r@r@r@r（ファイル終了）","@r@r@r@r@r@r（档案结束）"]],"context":[["SC_E_017.ks/index/1/text"],["SC_E_017.ks/index/3/text"],["SC_E_017.ks/index/5/text"],["SC_E_017.ks/index/7/text"],["SC_E_017.ks/index/9/text"],["SC_E_017.ks/index/12/text"],["SC_E_017.ks/index/14/text"],["SC_E_017.ks/index/16/text"],["SC_E_017.ks/index/18/text"],["SC_E_017.ks/index/20/text"],["SC_E_017.ks/index/22/text"],["S