tart":13657,"end":13719}],[{"start":13727,"end":13816}],[{"start":13848,"end":13862}],[{"start":13893,"end":13914}],[{"start":13946,"end":13958}],[{"start":13989,"end":14053}],[{"start":14061,"end":14102}],[{"start":14147,"end":14193}],[{"start":14201,"end":14210}],[{"start":14218,"end":14253}],[{"start":14283,"end":14293}],[{"start":14325,"end":14376}],[{"start":14406,"end":14456}],[{"start":14467,"end":14476}],[{"start":14508,"end":14545}],[{"start":14575,"end":14631}],[{"start":14688,"end":14696}],[{"start":14704,"end":14790}],[{"start":14822,"end":14832}],[{"start":14858,"end":14880}],[{"start":14888,"end":14899}],[{"start":14907,"end":14917}],[{"start":14925,"end":14961}],[{"start":15043,"end":15049}],[{"start":15081,"end":15110}],[{"start":15169,"end":15195}],[{"start":15225,"end":15236}],[{"start":15266,"end":15269}],[{"start":15301,"end":15308}],[{"start":15353,"end":15398}],[{"start":15406,"end":15416}],[{"start":15424,"end":15450}],[{"start":15458,"end":15469}],[{"start":15529,"end":15557}],[{"start":15583,"end":15601}],[{"start":15638,"end":15652}],[{"start":15684,"end":15701}],[{"start":15764,"end":15782}],[{"start":15814,"end":15841}],[{"start":15926,"end":15948}],[{"start":15985,"end":15993}],[{"start":16032,"end":16035}],[{"start":16045,"end":16053}],[{"start":16090,"end":16104}],[{"start":16136,"end":16197}],[{"start":16260,"end":16326}],[{"start":16358,"end":16364}],[{"start":16390,"end":16414}],[{"start":16422,"end":16427}],[{"start":16435,"end":16469}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_031.ks","basename":"SC_M_031.ks","indexIds":{"レンタカー屋から、\n大分暗くなった中を二人して…えー、並んで歩いて戻ると、":0,"「……どうして分かった？」":1,"「え？[l]\n":2,"…ぅわっ」":3,"まだ何メートルもあるうちから、":4,"何故か既にロビーエントランスホールに居てこっちに\n手を振る宮さん。":5,"たまたま今までそこに居て、\nたまたまこっちに気付いたというよりも、\n":6,"端っからがっつりこっちを出迎える態勢じゃん。[l]\n……えらいニヤニヤしてんなあ。":7,"冬夏もあの視線に気圧されたのか、\nなんとなーく無言のまま僕との距離をとる。":8,"どうしようもないのでそのまま、\nその出迎え状態の宮さんの元へ向かう。":9,"「おっかえりなさーい♪\n":10,"おやおやお熱いですなあ、うひひっ」":11,"何というか、随分使い古された言い回しですこと……":12,"「……ただいま戻りました。[l]\n宮さん、さっき会ったばっかの人に対して\nいきなりそんなフランクに」":13,"「えーと、冬夏さん？[l]\nどうでしたこの子は？[l]\n":14,"さぞや揶い甲斐あったでしょお？」":15,"聞いてないし。[l]\nそれにこの子ってあんた……":16,"「え、あはははは……[l]\nそ、それはもう。[l]\n":17,"えーと……」":18,"「緊張しなぁい。[l]\nこれからは宮と冬夏さん、\nの、二人でまこくん弄り倒すんですから。":19,"何やら":20,"同じ趣味してそうですし？[l]\n":21,"いいなかまになれそうです」":22,"「そ、そうなんですか…？[l]\n":23,"え、その、あ、あうう」":24,"戸惑っとる戸惑っとる。[l]\nそらそうよね。[l]\nいかな今日の彼女のテンションでも、\nそのノリで対応するには厳しかったか…":25,"うーん冬夏さんったら、\n内弁慶？[l]\n外弁慶？[l]\n……こういう場合ってどっちなんだべ。":26,"「あーっ、そうそう、\nまこくんこないだの『お仕事』の件で、\nちょっと聞きたい事があったので、\n":27,"あとで宮のお部屋に、き・て・ねっ♪」":28,"「へ？[l]\nああ、はい分かりました」":29,"「……」":30,"「え？」":31,"「なーんでもっ。[l]\n私もう部屋戻りますっ。[l]\nじゃーねっ」":32,"「あ、うん、お疲れさま……」":33,"なんか急に不機嫌？[l]\n宮さん、怒らせた？":34,"すたすたとエレベータに向かうと、\n丁度よく降りてきた箱に乗り込んでしまい、\n彼女の姿はあっと言う間に視えなくなった。":35,"すると突然宮さんが言うのです。":36,"「んむー、まこくんモテモテですなぁ～」":37,"「なんでそうなるんですよ。[l]\nてか宮さんが怒らせたんじゃないんですか？[l]\n彼女のこと」":38,"「ほあ？[l]\n":39,"……あー、まこくん、[l]\nヤヴァイなー、\nその鈍感さは。":40,"将来問題になりそう」":41,"「……悪かったですね」":42,"「行ってきたらどうですか？[l]\n冬夏さんの部屋」":43,"「ぁんで？！[l]\nそうなりまスか？！[l]\nてかそのお仕事の話しましょうよ！[l]\nさっさと！！」":44,"「え、宮のお部屋には来たいって？」":45,"「あいあいそうです、\nそしてさくっと用件を済ませましょうよ」":46,"「んひひ、\n":47,"そんなに焦らないでぇ、\n":48,"じっくり愉しもうよぅ～、まぁこぉくぅーん」":49,"「…しばらく話さないうちに更におっさん化が進みました？[l]\n今日はもうそういうのはお腹いっぱいなんですよ、\nだから……」":50,"「ほう！ほうほうほう！[l]\n":51,"そんなにたくさん冬夏さんとゴニョゴニョが？[l]\nいーなー、\n":52,"何があったかもがっつり聞かせて貰おーっと♪」":53,"「……ほれ。[l]\n行きますよ」":54,"と手を引こうとすると、":55,"「んーーー、\nでも今は、冬夏さんのとこ行っててください。[l]\n鉄は熱いうちに打てというでしょう」":56,"やんわり僕の手を払って、\n肩をぽんと叩いた。":57,"「はい？[l]\nどういう意味？」":58,"や、慣用句というか諺としての意味は分かるが。":59,"「まー彼女もまこくんもまだまだ\nお若いってことです。[l]\n宮はその辺大丈夫だから。":60,"ほんとはいっぱいいーっぱい弄ってあげようと\n思ってたですけど、\n宮の愉しみは後にとっておくですよ、うひひっ。[l]\nささ、い・ま・は、ご遠慮なくいってら～」":61,"「なんすかそれは。[l]\n……だいたい行ったところで何をどうしろと」":62,"「え、みなまで言わす気？」":63,"うひひ、と笑って、\nひらひらと立ち去ってしまった。":64,"──どうあれ僕は、どこでも誰にでもこういう\n扱いをされる訳ね……":65,"「てか、よう考えたら、\n冬夏の部屋なんか知らないですよ……」":66,"と呆然としてると、":67,"ぶるるるるる。":68,"うあ振動が！！":69,"携帯に着信だった。":70,"て、……冬夏じゃん。":71,"「あいもしもし？」":72,"「真言さんちょっと来て」":73,"「え、どこに？」":74,"「私の部屋に決まってるでしょお？[l]\n話終わったんでしょ？」":75,"へっ、何でわかった？[l]\nタイミングが良いとかいうより、\n終わったんでしょって貴女、断言してるし。":76,"「ん？[l]\nああ、えとね、私そういうカンはすごいわけ。[l]\nあはは……」":77,"「まあ、確かにそっちに行こうとはしてたけどもね…」":78,"「えっ？[l]\nな、何で？」":79,"「え、その、\n…や、それよりそっちこそ何の用？[l]\nそれ以前に部屋何処さ？」":80,"「あっ！[l]\n言ってなかったっ！[l]\nごめーん、えっとね、」":81,"なんか知らないけども、\n宮さんの思惑通り？[l]\n冬夏の部屋に行くことに相成った。":82,"用件に関しては何故か有耶無耶のまま、\n言われた部屋に向かう。":83,"「あー、\nその、今日はお疲れ様でした。[l]\n":84,"なんか、えー、そのね」":85,"「ああ、いいよ、\n気にしなさんな。[l]\n僕はもう、そういう役回りらしいから……」":86,"「ん、そんなことないよ。[l]\n":87,"あのね、さっきはちょっと……吃驚しちゃって、[l]\n折角色々して貰ったのに御礼も言えなかったから」":88,"「え？[l]\nああ、いやいやいやいや、\nそんな、馴れてるから、女子へのご奉仕は」":89,"てか、\nもし単に御礼言うだけなら、\nわざわざ呼び出されてる僕の手間とか労力は\nどうなるのかしら？":90,"「ん、\nなんかこう、\n静かーな部屋で独りになったらさ、\n今日の色んな事思い出して、\n":91,"……すっごい恥ずかしくて死にそうなって」":92,"いてもたってもいられないから思わず呼んじゃった、":93,"って、言われてもなあ……":94,"「それよりまず中入ってよ。[l]\n落ち着かないし」":95,"入り口前で立ち話をしてた僕等は、\n仕方なく中へ入る。":96,"「あー、同じだな、そりゃそうだけど」":97,"「ささ、座って座って」":98,"部屋の内部を見回して、\n当たり前な感想を呟いてると、\n冬夏は座布団を勧めてきた。":99,"「ああ、ありがとう…」":100,"「お茶淹れ方よく分かんないけど……」":101,"「ああ、いいっていいって。[l]\n今は水分入らない感じの腹具合だし」":102,"「そうなの？[l]\nん、ま、いずれ覚えるねこういうのも」":103,"冬夏も向かいに座布団を敷いて、\nぽすっと座った。":104,"「うん、さて、\n……静かですなあ……」":105,"「だよね－！[l]\nだから呼んだんだけどさぁ……[l]\n独りで静かなとこに居ると\n色んな事考え込んじゃって」":106,"動的テンションを持て余してる感じ丸出しの\n冬夏が言った。":107,"「まあ、それは分かるけど、\n僕も何をすればいいのやら……」":108,"「ん？[l]\n話相手」":109,"「……今日散々話してネタ尽きてない？」":110,"「ん、私はそんな事無いよ。[l]\nあ、\nじゃあマッサージとかしてあげよか？[l]\n…やり方分かんないけど」":111,"「ええーーーー……と、[l]\nえ？！[l]\nマッサージ？[l]\nですか？」":112,"「なんか分かんないけど馬乗りになって背中とか\n押せばいいんでしょ。[l]\nあと足で踏むとか？」":113,"「や、僕も専門的に知ってる訳じゃないけど……[l]\nつーか別にいいって、\n疲れてはいるけれど、その、\n逆に疲れそう、精神的に」":114,"それかせめて肩もみレベルからで……":115,"「肩揉み。ん」":116,"「へ。え？なんで？」":117,"冬夏は僕の前面に回ると、\nすっ──としゃがみ込んで。":118,"僕の":119,"頸へと手を伸ばし──":120,"「肩揉み、前から。[l]\n":121,"どうこれ？[l]\n":122,"あははは！」":123,"……だからどうしたのよ今日は。[l]\nてかまた後で恥ずかしくなるんだから！[l]\n知らにゃいぞ！！":124,"なんかチノ嬢にも似たようなことされた覚えあるし。":125,"「……一瞬、頸締められるかと思ったってば」":126,"「こう？」":127,"ひやっ。":128,"首筋に、冬夏の冷たい指が絡まった。[l]\nチョーカーに覆われていない部分に、\n彼女の体温が、触れる──":129,"「……人が視たら誤解するよ」":130,"「──誤解。[l]\n":131,"……ん、そう、かもね」":132,"くんっ、と指に力がこめられて、":133,"冬夏の顔が──":134,"「………」":135,"──驚愕の表情になって、固まった。":136,"「……？」":137,"次の瞬間、":138,"ばっ！！":139,"と、両手を離して立ち上がる。":140,"何事？と思う間もなく、":141,"「……ぉたのしみのところ、[l]\nおっじゃましまぁーす♪」":142,"！！！！！！！！！！！！！！！！":143,"「っっくりしたぁっ！[l]\nなななななな、なぁ、み、宮さん！？」":144,"いつから居たんでスか？！":145,"僕は入り口に背を向けていたので\n完全に死角になってたが、\nそこに居たのは":146,"紛う事なく宮さんであらせられた。":147,"あなたは結局、あれ？[l]\n後つけてきたんじゃないだろうな……[l]\nそんな気配は無かったけど……":148,"「いあいあ、宮はなぁんにも視てませんよ？[l]\n今来たとこですよ？":149,"二人でお楽しみだったかなんてなぁ～んにも！[l]\n知りませんよ？[l]\n":150,"単なるブラフですよ鎌かけですよぉ？」":151,"「……。[l]\nま、まあ実際何も疚しい事はしてませんよ、\nねえ、」":152,"「あ、あうあう、いえそのは、はいっ」":153,"すっかり固まってた冬夏に降ると、\n不自然にぶんぶん頷いた。[l]\n実は冬夏、人見知り激しい子なの？[l]\n……否、宮さんの毒気に当てられてるだけだなきっと……":154,"にしても驚いた……色んな意味で。二人両方に。":155,"というか宮さん、最初から部屋知ってたのか？[l]\nいや、知狡さんから聞いたのかな……":156,"どっちにしろ、\n全く油断も隙もありゃしないっ、て、\n別に隙を狙って何かしてた訳じゃないけども！":157,"「にしてもノックなりなんなりしてくださいよ、\n常識的に考えても。":158,"一歩間違えたら不審者ですよ、\nホテルのルームメーキングの人でもそのくらいのことは\nしますよ、多分」":159,"「えー、のっくシタヨ？（嘘）」":160,"「バレバレの嘘を":161,"吐かない。[l]\n僕はまだ良いとして、\nほら、\n冬夏がすっかり怯えちゃってるでしょうが」":162,"「はぃ？[l]\n":163,"え、あの、わたちはだいじょぶでし」":164,"滑舌までおかしなっとる。[l]\nこれはこれで可愛……いや、面白いけど。":165,"「──で、結局何の用なんです」":166,"「んむー、冷たいな－。":167,"折角、\n夕御飯、宮が特別":168,"誂えの\nすぺさるメニューを頼んどきましたから、\n":169,"是非ご一緒いかがかな？":170,"と思って招待しに来たのに～。[l]\n":171,"あ、勿論宮たちの経費で落としますから冬夏さんは\n気にしない」":172,"「す、すぺさる？」":173,"「あ、まこくん、\n今日のは昨日みたいな精進料理的なのとはまた趣が違いまして。[l]\n割とまんまのすぺっさる系ですよ。":174,"えーとごめんです冬夏さん。[l]\nで、その":175,"夕":176,"餉のお時間がそろそろなもので、\n了承無くお邪魔してしまいました。[l]\n驚かせて済みませんでしたですよ」":177,"「え、あの、……え？」":178,"この部屋の場所を知った理由を言わないとそら、\n不審なままですわよね……":179,"もし身内コネクション経由だったら\n言うわけにもいかないし、\nと思ってたら、":180,"「んむー、\nまだまだ硬いなっ！[l]\n":181,"うりあ！！」":182,"宮さんの手が冬夏の胸元に伸びて──！？":183,"「きゃふっ？！」":184,"………。":185,"こ、こええぇぇえぇ……":186,"「うひひ、\n心配いりません、寸止めです。":187,"よくある展開ではここで！[l]\nばっちりバストまさぐりシーンがあるわけですが、\n":188,"そうは問屋が卸さないのが世の常ですよ」":189,"……何の常よ。[l]\nてかほんとにおっさん化してるなおい。":190,"「ひ、ひえぇぇぇぇ……」":191,"ああ、あの冬夏が翻弄されてるとは……[l]\n憐れなり……":192,"「宮さん、いい加減、\n":193,"虐めるのは僕だけにしといてください……":194,"ええと冬夏、……僕も良く分かんないけど、[l]\nなんか折角用意して貰ったようだし、\n……一緒に行こうか？」":195,"普段の自分を視てるようで、\n余りにも":196,"遣る":197,"瀬":198,"無くなった僕は、\n助け船を出す。[l]\nしかし、まだ困惑中の冬夏。":199,"「えっ、えっ、と、その──」":200,"「んむ。[l]\n遠慮はいらないですよ？[l]\n今日はまこくんが随分お世話になったようだし──」":201,"交流は是非深めておきたいので。":202,"宮さんは有無を言わさぬ力を言外に匂わせながら、\n冬夏の手を取った。":203,"陽が落ちた。":204,"「は、い──」":205,"「うひひ♪\nじゃー今宵は宴会ですなあ。[l]\n":206,"カラオケ稼働させますよ！[l]\n割と良い機械入れさ……置いてるらしいですしね！」":207,"うぇっ。":208,"……図らずもというか、":209,"「……カラオケあるってさ、[l]\n冬夏、よ…かった、ねぇ？」":210,"「あ、ははははは、あはははは……」":211,"こういう形で先手を取られるとは思いも寄らなかったであろう\n冬夏は、\n──それでもなんか、微妙にやったぜ感のある表情を\n顔に浮かべてる様に視えるんですが気のせいですか？":212,"いや、それより、宴会て。[l]\n騒ぐ打ち上げとしてより、\n純粋に滋養強壮の為の宴にして欲しいんだけど個人的に。":213,"貴女の為にお仕事で来てるんですよね僕は？":214,"「折角知り合いになれたんですし、\n懇親会と行きましょうー。[l]\nまこくんという肴もいる事ですしねうひひっ。[l]\n無礼講で行きましょ無礼講で」":215,"……そうか、例の方針転換すか。[l]\n懐柔策だのそれもこれも仕事のうちだと、\nそう言いたいわけですか。":216,"でもさあ、\n宮さんと冬夏が仲良くなる意味はあんまないでしょ？！":217,"寧ろ確か……":218,"「じゃあ、本気で……[l]\n……お言葉に甘え…ようかな……」":219,"「そーそ、だからー、遠慮にゃぞいらないですのよ？[l]\nれっつかまーん」":220,"「よ、よろしくお願いします……」":221,"冬夏が変に乗り気になってしもうて、\n疑念云々どころじゃなくなってるし。[l]\n幸いというべきかどうなのか……":222,"にしてもあれだな、\n冬夏も巻き込まれ型？[l]\n違うな、\n……宮さんが巻き込み型なだけ？[l]\nいあいあ、僕の場合は他の誰からも巻き込まれてるし、":223,"「結局、僕は僕って事か……」":224,"「んむ？[l]\n何か言いました？」":225,"「や、何でもないです…」":226,"「ふーん？[l]\nじゃ、\n行きましょう。[l]\nあ、冬夏さんも準備あるでしょうし、宮は先に行ってますね。":227,"場所はまこくんに案内させてやってください。[l]\nそういうことでよろし～」":228,"宮さんは僕に宴会場の場所を言いつけて、\n手をひらひらさせながらまた立ち去っていった。":229,"何しに来たんだ……":230,"いや、主旨はわかったけども、\nその諸々の色々の方が相変わらず。":231,"「……えーーーと、」":232,"「い、行こうか？[l]\nああ、準備いるっけ、\n部屋戻って来たばっかだったしねえあはは」":233,"「ん？[l]\nあ、うんちょっとだけ、\n着替えた方が良い…のかな？[l]\nあと":234,"厠に行ってきます」":235,"「わかった、じゃあ、そこの\n……エレベーター前のソファに座ってる」":236,"「ん。わかったー。[l]\nじゃ、ちょっとだけ待っててね。[l]\n……真言さんも大変なんだぁ……」":237,"入り口は閉じた。":238,"……何か最後にすげぇ憐れみかけられたような[l]\n気がするけど、\nきっと自意識過剰被害妄想というものだな！[l]\n彼女もそれどころじゃない筈だしな！":239,"「さて、はふー……」":240,"ソファに腰を下ろして数分の間、しばしの孤独。":241,"独りは落ち着くねぇ……":242,"寝そうになるわい……":243,"と、眼の前のエレベーターがこの階で止まった。[l]\n扉が開くと、":244,"「……おや」":245,"「あっ。[l]\nど、どうも、帰って参ってました…」":246,"「ああ、成る程。[l]\n察しました。[l]\n":247,"お疲れ様です。[l]\n":248,"では」":249,"「ぇぁはい？」":250,"あれ？[l]\n──エレベーターから降りずに、\nチノ嬢は扉を閉めてしまった。":251,"もう動き出してるし。":252,"え、なにしたの？てか何か用があってこの階来たんじゃ？":253,"呆気にとられてる間に、":254,"「お待たせしましたっ。[l]\n……何かあった？」":255,"中腰で口を半開きにしてる僕を視て、\n":256,"怪訝そうに顔を覗き込む冬夏。":257,"「…や、流石に疲れたってだけ……」":258,"「ふーん？[l]\n大丈夫？」":259,"「ああ、それはもう、\nいっつもこうだから……」":260,"「あは。[l]\n成る程ねー。[l]\n":261,"では参りますか。":262,"もう腹":263,"括った！[l]\n":264,"私覚悟決めると強い人だから」":265,"「あはは……[l]\n何の覚悟かはよくわからんけども……[l]\nまあ是非是非宮さんと仲良くしてやってよ……」":266,"「ん。[l]\n了解ー。[l]\n大丈夫、先刻は驚いてただけだし。[l]\nあの方、何か近しいモノを感じますもの」":267,"「へえ……」":268,"う、うーん、良いのか悪いのか判別つきかねるなあ。":269,"何にしろ、":270,"長い一日が、\nまだ、\n終わりそうもないって事だね……":271},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_031.ks","relPath":"/data/scenario/SC_M_031.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":267,"length":272,"percent":98.16176470588235},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[227,1]},"/data/scenario/SC_M_032.ks":{"data":[["「あはははは！[l]\nすっごい美味しいっ！","「啊哈哈哈哈！[l]\n超级好吃！"],["あっ、これとかもうたまんない、\nああもう、\n","啊、这个简直让人欲罢不能，\n啊啊真是的，\n"],["これは味覚を直撃する何とも染み渡る……[l]\n","这种直击味蕾的渗透感……[l]\n"],["んーーーーっ、お刺身超おいし！！","嗯～～～～，生鱼片超美味！！"],["はふぅ……さっきあんま食べないでおいて良かったっ。[l]\n","哈呼……还好刚才没吃太多。[l]\n"],["あのですねぇ、」","那个啊，」"],["だんっ！","咚！"],["と拳で卓を叩く勢いで──つまり実際にはしてないけども、\nそこで一呼吸おくと、\nきっと見得を切るようにこちらを視、","作势要用拳头敲桌子的架势──虽然实际上并没有，\n稍作停顿后，\n仿佛要摆出架势般直视这边，"],["「地元民だからって、\n","「就算是本地人，\n"],["新鮮な良い食材食べられる訳じゃないんですよぅーっ！」","也不代表能吃到新鲜好食材呀ー！」"],["と","如此"],["慟","恸"],["哭した。[l]\nや、慟哭は大袈裟だけど。","哭道。[l]\n啊、说恸哭可能有点夸张。"],["一応食べ方はまだ行儀良いんだけど、\nなんだろうな、","虽然吃相还算文雅，\n但该怎么说呢，"],["やっぱり擬音で現すならばがつがつって感じに、\n……まあ、当然貴奴程ではないけども、[l]\n料理を食していく冬夏。","非要用拟声词形容的话就是狼吞虎咽的感觉，\n……当然比不上贵奴那种程度，[l]\n继续进食的冬夏。"],["とは言え流石というか、それとも他の状態の彼女を視てないからか、\n眼前の光景に対して、宮さんが動じてる様子はない。","不过该说真不愧是呢，还是因为没见过她其他状态，\n宫小姐对眼前的景象似乎并不感到惊讶。"],["「喜んで貰えて何よりですよぉ。[l]\nお誘いした甲斐があるというものですっ。[l]\n","「您能喜欢比什么都好。[l]\n这次邀请总算没白费呢。[l]\n"],["（彼女、良いとこの娘ですよね？[l]\nこういうの食べ慣れてそうですが）」","（她是大户人家的小姐吧？[l]\n看起来应该很习惯吃这类东西）」"],["……いや、やっぱりそれなりの違和感を感じてたらしく、[l]\n小声でこちらに訊いてくる宮さん。","……不、看来还是感到些许违和，[l]\n宫小姐小声向我确认。"],["「（なんか体型維持がどうとかで、\n食事は結構制限されてるらしいですよ……","「（好像是为了保持体型，\n平时饮食限制很严格的样子……"],["まあ、単純に旨いし、テンションありきの発言\nじゃないすかね。[l]\n社交辞令…じゃないと思いますが）」","不过单纯是因为好吃，情绪高涨才这么说\n的吧。[l]\n应该不是客套话…）」"],["にしたって、\nきぃと３人で食事行った時は、\nこんなじゃ無かった気がするけどなあ。","即便如此，\n和小贵三个人吃饭的时候，\n感觉不是这样的啊。"],["幾ら今日はずっとおかしなノリだったとは言え、\n何かしら背景というか理由がありそうとは言え、\n腹括って覚悟決めると強い人なそうだとは言え、\nちっと不自然すぎやしないか。","虽说今天一整天都处于奇怪的状态，\n虽然可能有什么背景或原因，\n虽然看起来是下定决心就会很强势的人，\n但这也太不自然了吧。"],["……まさか、","……难道说，"],["「（あの宮さん、\nまさかアルコホォルを飲ませた訳じゃ、\n…ないですよね？）」","「（那位宫小姐、\n该不会让人喝了酒、\n…不会吧？）」"],["「（いあいあ、\nこれは多分、\nいわゆるー、\n雰囲気酔い？","「（哎呀哎呀、\n这大概是、\n所谓的——\n氛围醉？"],["なんか最近プレイしたゲームにも\n同じようなキャラが）」","最近玩的游戏里也有\n类似角色）」"],["「そこぉっ！！[l]\nコソコソといちゃつかない！！[l]\nするときは私も混ぜること！！[l]\n","「喂喂！！[l]\n别偷偷摸摸打情骂俏！！[l]\n要玩就带上我！！[l]\n"],["ん、それならゆるす！！」","嗯，那样的话可以原谅！！」"],["「（……居ましたし、[l]\nまあ別段不思議な現象じゃないんでしょうけど。[l]\n雰囲気酔い。プラシーボ的に。","「（……确实存在呢、[l]\n不过也不算特别奇怪的现象吧。[l]\n氛围醉。类似安慰剂效应。"],["浮き世の憂さは酒で晴らすも、\n飲めぬ若人は笑って晴らすと）」","尘世烦忧借酒消、\n不胜酒力者便以笑消愁）」"],["「（それ何かの慣用表現ですっけ？）」","「（这是某种惯用表达吗？）」"],["「（さあ？[l]\n今適当に言ってみたですよ）」","「（谁知道呢？[l]\n刚才随口编的）」"],["……あんだえ、聞いたような言葉だと思ったのに。","……明明觉得像是哪里听过的说法。"],["まあいいか。","算了无所谓。"],["酒に関しては、\n冬夏の同席を知ってる訳だし、\n流石に知狡さんが配慮したようだった。","关于酒水、\n既然知道冬夏在场、\n知狡阿姨果然有所顾虑。"],["つまり、\n料理的にオレンジジュースとかもどうよと思ったのか、\n烏龍茶が配されたのだけれど。","也就是说、\n可能考虑到橙汁之类配餐不合适、\n最后上了乌龙茶。"],["ただ、\nコース的に想定外だったのか烏龍茶はペットボトル。[l]\n虚より実を取れれば良いので別に構わないけども、\n……まあいいか。","不过、\n可能超出套餐预期，乌龙茶竟是瓶装的。[l]\n重实质轻形式倒也无妨、\n……算了。"],["変に融通利きすぎるのもバックのコネクションが\n視えそうでこわいし。[l]\n──あれ、変更出来てる時点で既にコネのチカラ丸出し？","过度灵活的应对反而让人害怕\n会暴露背后的人脉。[l]\n──等等，能临时变更不就说明人脉力量已经暴露了？"],["「……」",""],["ま、まあ、\n冬夏を視る限り、そこに引っ掛かってる様子もなし。[l]\n恐らく問題はないであろう。","嘛、也罢、\n看冬夏的样子，似乎没注意到这点。[l]\n应该问题不大。"],["と、宮さんがその烏龍をちびりと飲んで","这时宫小姐小啜一口乌龙茶"],["囁いた。","悄声道。"],["「（んむ、\n只の烏龍茶ですねぇ……[l]\nまこくんこそ何か仕込んだのデハ？[l]\nよからぬ事でも企んだ？）」","「（嗯唔、\n只是普通乌龙茶呢……[l]\n小真该不会动了什么手脚吧？[l]\n在策划什么坏事？）」"],["「（するわけ無いでしょうが……[l]\n仕込むモノもそうですけど、\n宮さんを２人に増やすような真似をなんで）」","「（怎么可能……[l]\n既没准备什么、\n也没理由把宫小姐变成两人）」"],["「（んむ？[l]\nなにかおっしゃいました？）」","「（嗯唔？[l]\n刚才说什么了？）」"],["「（いえなんにも……）」","「（没什么……」）"],["まあ、今日は会ったときから超のつくような\nハイテンションだったしなぁ……","毕竟她从今天见面起就\n异常亢奋啊……"],["余程溜まってた、にしても、\n半日ずっと発散に付き合ってるにも関わらず、\n未だ尚、こんなにもはじけるかよ。","就算压力积攒再多、\n陪她发泄了整整半天、\n没想到还能这么精力充沛。"],["「たぅ！」","「哒呜！」"],["「おわ！！」","「哇啊！！」"],["冬夏が、\n隣り合って座っていた僕と宮さんの間に入り込んできた。","冬夏突然\n挤进并排而坐的我和宫小姐之间。"],["「こんばんわ！」","「晚上好！」"],["「こんばんわ？！[l]\nこ、こんばんわ。[l]\nあは、あははは……」","「晚上好？！[l]\n晚、晚上好。[l]\n啊哈，啊哈哈哈……」"],["「いいですねー。[l]\nなかなかイイですよ。[l]\n冬夏さんには見込みがあります！」","「很不错啊ー。[l]\n相当不错呢。[l]\n冬夏小姐很有前途！」"],["「やった♪\nて、何のですかー？」","「太好啦♪\n诶、是什么呀ー？」"],["「うひひ、\nえーとですね、\nごにょにょ……」","「嘿嘿嘿，\n那个啊，\n咕哝咕哝……」"],["「……何すか。[l]\n何でひそひそ話なんスか」","「……搞啥呢。[l]\n为啥要窃窃私语啊」"],["「んむ？[l]\nえーと、\nまこくんは聞かない方が良いと思うですねぇ…」","「嗯唔？[l]\n呃——\n小真还是别问比较好呢…」"],["「え゛っ。[l]\n……あ、いや、じゃあ聞きません」","「诶゛？[l]\n……啊、不、那我不问了」"],["どうせロクな事ではないのだろうて。","反正不会是什么好事吧。"],["取り敢えず烏龍茶をあおる僕。","我暂且先灌了口乌龙茶。"],["疲れたとはいえ、\n僕は昼に姫様ちゃん達とそれなりの食事してたので、\n思ったよりそんなにそんなになんだよね。[l]\n喰えばちゃんと腹には入るけど。","虽说累了，\n我中午和姫様她们吃了顿像样的饭，\n所以倒也没想象中那么饿啦。[l]\n吃的话当然能塞进肚子就是了。"],["「あー、手酌っていけないんだー」","「啊ー、自己倒酒可不行啊ー」"],["「はい？」","「啊？」"],["密談を終えたらしい冬夏が、\nこっちを指差してぶーたれた。","似乎结束密谈的冬夏，\n指着这边鼓起脸颊。"],["「手酌は駄目なんじゃないの？[l]\nマナー的に」","「自己倒酒不太好吧？[l]\n礼仪上来说」"],["「手酌？[l]\nってああ、\nいやぁ……[l]\nそんなことぁないと思うけど……」","「手酌？[l]\n啊啊，\n哎呀……[l]\n我觉得没这回事啦……」"],["大神とかは他人が","像大神他们"],["注ごうとすると、\n寧ろ全力で拒否るけどなあ。[l]\nちゃんと他人には","别人要给他倒酒时，\n反而会全力拒绝呢。[l]\n他倒是会好好"],["注ぐ奴ではあるから\n変な謙遜なのかも知れないけど。","给别人斟酒的家伙\n可能是奇怪的谦虚吧。"],["「いいからいいから、\n貸して貸して」","「好啦好啦，\n给我给我」"],["「いや、別にいいし。[l]\n酒でもないしさ……」","「不、真的不用。[l]\n又不是酒……」"],["「先刻も言ったでしょ、\n私、こういうのしたい」","「刚才也说过了吧，\n我想做这种事」"],["「してもらえばいいのに。[l]\n宮に遠慮は要らないですよ？」","「让她做不就好了。[l]\n对宫不用客气的哦？」"],["こちらの喧噪など何処吹く風、\nとっとと料理をつついていた\n宮さんがそう言ったんですが、","这边的喧闹如同耳旁风，\n只顾着埋头吃菜的\n宫小姐虽然这么说了，"],["「や、貴女には遠慮してませんから……」","「不、我不是在和你客气啦……」"],["そもそも何の遠慮だ。","说到底有什么好顾忌的。"],["と、\n業を煮やしたらしい冬夏が僕をせっついた。","这时，\n似乎忍无可忍的冬夏开始催促我。"],["「ほら、グラス」","「来，杯子」"],["「グラス？[l]\nああ、コップでいいじゃないの……」","「杯子？[l]\n啊啊、用杯子不就行了吗……」"],["間違っちゃいないんだろうけど、\n空気的にというか、\n何かが違う。","虽然没说错，\n但氛围上或者说，\n总觉得哪里不对。"],["ともあれコッ……グラスを冬夏に向けて差し出すと、","总之把杯……杯子递给冬夏后，"],["「………よよよよよよ」","「………哟哟哟哟哟」"],["えらい真剣にペットボトルを掲げ、\nよくわからない擬音と共に烏龍を注いでくれたのだった。","她非常认真地举起塑料瓶，\n伴随着意义不明的拟声词给我倒了乌龙茶。"],["注ぎ終えると、額の汗を","倒完后，还擦了擦额头的汗"],["拭わんばかりに\nふぅー、と息を吐き出し、\n今度は宮さんの方に向き直る。","像要擦掉什么似的\n呼——地吐了口气，\n这次转向了宫小姐那边。"],["「じゃあ、こちらにも」","「那这边也请用」"],["「おおう？[l]\nありがとうございますっ。","「哦哦？[l]\n非常感谢！"],["いやいや、冬夏さんてば。[l]\n","哎呀呀，冬夏小姐真是的。[l]\n"],["良いお嫁さんになれそうですねえ、ねえ？[l]\nまこくん」","绝对能成为好新娘呢，对吧？[l]\n小真」"],["「え？[l]\nはあ、そーうですねえー」","「啊？[l]\n哈啊——是这样呢——」"],["今時そういう価値観も揺らいでる感があるけど、\n宮さんもわざわざ皮肉発言した訳じゃないだろうので、\n素直に褒め言葉として同意しておく。","虽然感觉如今这种价值观也有些动摇了，\n不过宫小姐应该也不是故意要说讽刺的话，\n我就老老实实当作夸奖表示同意吧。"],["「あはははは……[l]\nだといいけど……」","「啊哈哈哈……[l]\n能这样就再好不过了……」"],["おや？[l]\n若干トーンダウンした？","咦？[l]\n怎么感觉她情绪有点低落？"],["傷付いたというよりは、\n何だろう、痛い所突かれた的な感じだが……[l]\n気のせいかしらん。","与其说是受伤了，\n更像是被戳到痛处的感觉……[l]\n可能是我的错觉吧。"],["「まま、じゃあ宮はちっと中座しますね。[l]\nすぐ戻って来ますからご心配なく～」","「嘛～那宫小姐就先失陪一下啦。[l]\n马上就会回来的不用担心～」"],["「ん、はいわかりましたー」","「嗯，好的知道啦—」"],["「いってらっさい」","「路上小心」"],["宮さんは広間から廊下に出て行った。","宫小姐从大厅走向走廊。"],["「どうぞいちゃついててぇ～」","「请两位继续卿卿我我呀～」"],["……わざわざ廊下から言って寄越す宮さん。","……特意从走廊那边喊话的宫小姐。"],["「了解～」","「了解～」"],["……わざわざ返事する冬夏さん。","……特意回话的冬夏小姐。"],["僕は勿論スルーです。","我当然选择无视。"],["「手洗いかな……」","「是去洗手吧……」"],["「ん」","「嗯」"],["呟いたつもりだったが、\n冬夏は耳聡く反応してきた。[l]\n食事の席だし一応気を遣ったつもりだったんだけど……","本以为自己只是小声嘀咕，\n冬夏却敏锐地听到了并作出反应。[l]\n想着毕竟是在吃饭场合好歹该注意点分寸……"],["「私？[l]\n気にしないよそんなことで。","「我？[l]\n这种事完全不在意啦。"],["しきたりとか男だから女だからとか、\nそういうのに囚われるのってキライなの。[l]\n家では……まだしょうがないけど」","规矩啊因为是男的或是女的啊，\n最讨厌被这种条条框框束缚了。[l]\n在家里……还勉强能忍就是了」"],["「なるへそ……」","「原来如此……」"],["「だから、\n真言さんが多少気の利かない感じに鈍感な男子だとしても\n気にしないよ？[l]\n私がリードしちゃうし」","「所以说，\n就算真言先生是那种有点不解风情的迟钝男生\n我也不会介意哦？[l]\n我会主动引导的啦」"],["「それは悪うござんしたね……」","「那可真是对不住咯……」"],["「ん？[l]\nあっはははは、\nそこそこ、そこが鈍感なんだってば！[l]\nあれぇ、それともわざとなのかな？」","「嗯？[l]\n啊哈哈哈，\n对对对，就说你这里很迟钝嘛！[l]\n哎呀呀，还是说其实是故意的？」"],["「……よくわかんねけど、[l]\nまあ自分でも朴念仁の類だとは思うよ……」","「……虽然不太明白，[l]\n不过我也觉得自己确实属于榆木疙瘩那类人吧……」"],["そう言うと、\n何が可笑しかったのか、\nあはは、とまた笑う冬夏。[l]\nぼくねんじん、の語感で？","这么说着，\n不知有什么好笑的，\n冬夏又「啊哈哈」地笑了起来。[l]\n是「ぼくねんじん」的语感吗？"],["「ただいもんー」","「我回来了～」"],["「あ、おかいもんです」","「啊、我出门了」"],["「おかいもんー」","「我出门啦～」"],["今更ながら、\n何か『お買い物』って言ってるみたいでややこしいな。[l]\nそもそもただいもんて。","事到如今，\n说什么『购物』之类的感觉有点复杂啊。[l]\n说到底不过是土豆罢了。"],["ともあれ、\nいちゃつく間もなく戻って来て頂けて、\n大変にありがたい事です。","总之，\n连亲热的时间都没有就赶回来，\n实在是感激不尽。"],["「ふーやれやれ……」","「呼——真是的……」"],["と、\n年寄りみたいな声を出して座る宮さん。[l]\nそうだなあ、やっぱり厠…にしては早いな、[l]\n何だったんだろ？","说着，\n发出老人般叹息声坐下的宫小姐。[l]\n是啊，果然厕所…似乎还太早了点，[l]\n刚才是怎么回事呢？"],["「んむ？」","「嗯唔？」"],["「あいえ、何でもないです…」","「啊不，没什么…」"],["僕等の遣り取りを視ていた冬夏が、\nそこで突然ぶわさと立ち上がった。","旁观我们互动的冬夏，\n突然哗啦一声站了起来。"],["「んじゃー宮さまっ。[l]\nお歌お歌。[l]\n御一緒しましょ！」","「那么——宫大人。[l]\n唱歌唱歌。[l]\n一起来嘛！」"],["「んむ？[l]\nおーおー、そう来なすった？","「嗯唔？[l]\n哦哟哦哟，来这手啊？"],["うひひ、\n宮もカラオケにゃー","嘿嘿，\n宫也懂卡拉OK的～"],["一",""],["家","家"],["言ありますよ。[l]\n冬夏さんのお手並み拝見と行くですかね、\nうひひひひひひ」","有句话要说。[l]\n就让我见识下冬夏小姐的本事吧，\n嘿嘿嘿嘿嘿」"],["「えへへ、今日はたまたま喉ならし出来たのでー。[l]\n少しは聴かせられるかな？っと。[l]\n身近に凄いのが居るんで自信はないですけど。[l]\nお耳汚しですが、そこは平にご容赦くださいませっ」","「诶嘿嘿，今天刚好开过嗓了～[l]\n说不定能唱得还行？[l]\n不过身边有位超厉害的所以没自信啦。[l]\n可能会污染耳朵，还请多多包涵咯」"],["「いあいあ、\nあなたはワカルひとと視ましたですよ。","「哎呀哎呀，\n我看您是懂行的主儿。"],["少なくとも……よりは、んむ。[l]\nままままままま、\n","至少比……要强，嗯唔。[l]\n嘛嘛嘛嘛嘛嘛，\n"],["んじゃー、\n何唄いましょうか？","那么，\n唱什么好呢？"],["例えばこれ知ってます？[l]\nええとですね……」","比如说这首知道吗？[l]\n呃那个……」"],["「えーーっこれを御存知？！[l]\nすっごいところ突いてきますねー、\nでもっ、ぜんっっっぜん行けますよっ」","「诶——居然知道这首？！[l]\n切入点超厉害啊——\n不过完全——完全没问题哦！」"],["宮さんの中座の理由を気にしてもしょうがなし、\nというか何かえらく盛り上がってるなあ。","纠结宫小姐离席的理由也无济于事，\n不如说他们莫名嗨过头了吧。"],["つーか今、\n宮さん『少なくとも』って、\n誰よりはマシって言おうとしたのやら。[l]\nどうせ僕なんでしょうがね！","话说现在，\n宫小姐那句『至少』，\n是想说比谁强来着。[l]\n反正肯定是在说我吧！"],["ああそうですか！[l]\nで、冬夏の言った身近の凄いのってのは、\nやっぱ狩屋なんだろうなあ。","啊是这样吗！[l]\n另外冬夏说的身边那位超厉害的，\n果然是指狩屋吧。"],["「じゃ、これでー、\n私が上パートとコーラスやりますね。[l]\n宮さまは主メロで」","「那就这首～\n我来负责高音部和和声部分。[l]\n宫大人主旋律哦」"],["「はーい了解です♪\nま、でも主メロは交代交代でしょ。[l]\n２コーラス目は入れ替えでごー。[l]\nじゃ、行きましょう」","「好——明白啦♪\n不过主旋律要轮换着来吧。[l]\n第二段副歌就交换咯～[l]\n那么，开始吧」"],["「いってらっさーい……[l]\n……宮さまって何？いつからそう呼んでたっけ？」","「路上小心……[l]\n……宫大人是什么？从什么时候开始这么叫的？」"],["えらい勢いで親交が深まってる？","关系突飞猛进了？"],["でもなあ……","不过啊……"],["冬夏の、\nこういうのを視ると、\nやっぱり平素どれだけしんどいんだろうか、\nと裏事情を想像せずには居られない。","看着冬夏\n这副模样，\n果然会忍不住想象她平时过得有多辛苦，\n那些不为人知的隐情。"],["心の痛みを知って尚、\nそれを糧として他人を慮れる人間というのは、\n全ての場合においてとは限らないが、\n基本的には尊敬に値すると思う。","明明知晓内心伤痛，\n却能以此为养分体谅他人的人，\n虽然并非适用于所有情况，\n但本质上值得尊敬。"],["僕はそれはもう、\nうかうかと過ごしてるのであれだけども、\nそれでも精神的に傷付くことはままある。","我虽然一直都是\n浑浑噩噩地过日子，\n但精神上还是会时不时受伤。"],["そういう時に、\nそれを怒りに転換する事の方が多いわけで、\n愚痴ったりもするし、毒づいたりもする。","这种时候，\n多半会把情绪转化成怒火，\n要么发牢骚要么恶语相向。"],["それなのに、\n──なんかセンチな思考になってるな。[l]\n何でだろ？","即便如此，\n──怎么变得有点多愁善感了。[l]\n为什么呢？"],["ようよう考えれば、\n眼前で起きてる『これ』、\n別にそういう話じゃ、ないよなあ。[l]\n……寧ろ、今日の半日は冬夏の愚痴から始まってたような……","仔细想想的话，\n眼前发生的『这件事』，\n倒也不是那种话题吧。[l]\n……不如说，今天这半天是从听冬夏发牢骚开始的……"],["ま、まあ！[l]\n笑っていられるというのは良い事だ！[l]\n大神もよく言ってたし僕もそう思う！","嘛、嘛啊！[l]\n能笑出来总归是好事！[l]\n大神也常这么说我也这么觉得！"],["にしても、","不过、"],["周りを視回して改めて思うけど、\n経営者権限とは言え、\nたった三人の為によく押さえてくれたなあこんな部屋。[l]\n祭がもっと近づいてたら、多分無理だったのかもなあ。","环顾四周重新想想，\n虽说动用了经营者权限，\n只为三个人就包下这种房间真是破费了。[l]\n要是祭典日期再近些，恐怕就办不到了吧。"],["そう思っていると、\n二人は既にステージの方へと向かっていた。","正这么想着，\n两人已经往舞台方向走去了。"],["「いぇ～～～いぱちぱちぱちぱちぱちぱちぱち……」","「耶～～～啪啪啪啪啪啪啪……」"],["知狡さんやチノ嬢とか居れば多少は賑やかしになるんだろうけど、\nあくまで僕と旅館との関係は秘している以上、\nそういう訳にもいかず、","要是有知狡阿姨或千乃小姐在场应该能热闹些，\n但既然我和旅馆的关系必须保密，\n也就没法这么安排，"],["独りで","只好独自"],["幇","帮"],["間みたいな事をしつつ、\n二人のステージに視入る事になった。","衬着打拍子，\n将视线投向两人的舞台。"],["先刻の冬夏の歌唱力を知ってるので、\n宮さんとのコラボレーションが果たしてどうなるのか、\n実際愉しみではある。","因为已经领教过冬夏刚才的歌唱实力，\n和宫小姐的合作究竟会怎样，\n说实话还挺期待的。"],["とは言え、曲目次第のとこもあるかな……[l]\nそれより宮さん、アニソン以外行けんのかな？","不过也要看具体曲目吧……[l]\n话说宫小姐除了动漫歌曲还能唱别的吗？"],["つーか、疲れた身体で食事すると、\n血が胃に行って大変眠くなるん……","话说回来，累的时候吃完饭，\n血液都流到胃里会特别犯困……"],["「んではー、\n行きますねぇー」","「那么——\n我们要开始啦～」"],["「よろしくおねがいしまーす！」","「请大家多多指教～！」"],["もわもわーんとエコーの掛かった声で二人が言う。","两人用带着混响的软绵绵声音说道。"],["曲がはじまった。","歌曲开始了。"],["何か変拍子って言ったっけ？[l]\n何分の何だこれ。[l]\n難易度高そうな唄だな……[l]\n集中してアタマ使ったせいか眠気も少しは飛んだようだ。","这个是不是叫变拍子来着？[l]\n这到底是几几拍啊。[l]\n感觉是首难度很高的歌……[l]\n可能是因为集中精神用脑，困意似乎消退了些。"],["「今宵、巡れる──」","「今宵，轮回——」"],["打ち合わせてた通り、\n確かに宮さんが主旋律を担当してるようだ。[l]\nまずはあの方から歌い出す。","按照事先商量好的，\n确实是宫小姐在负责主旋律。[l]\n首先由那位开唱。"],["「不知夜月揺れる──」","「夜月摇曳不知——」"],["「──誘いの──」","「──邀约之──」"],["ハモるというより、まずは追っかけかぁ。[l]\nいや、追っかけつつハモりも被さるのか。","与其说是和声，不如说先是在跟唱吧。[l]\n不对，是边跟唱边叠上和声吗。"],["そして、二人の声が重なる、","接着，两人的声音重合了，"],["──零れ──……","──满溢──……"],["「深い夜に──」","「在深夜里──」"],["──。",""],["ハモりが完璧すぎて鳥肌立つんですけど……[l]\nで、やっぱり追っかけもするんだ。[l]\nよく初回で合わせられるなあ……[l]\nまあ、お互いよく知ってる唄なんだろうけど。","和声完美得让人起鸡皮疙瘩……[l]\n然后果然也开始跟唱了。[l]\n第一次就能配合得这么好……[l]\n嘛，毕竟是彼此都很熟悉的歌吧。"],["ワンコーラスていうのか、\n所謂１番が終わったあたりで、\n僕はすっかりやられた感じで惚けて聴き入っていた。","该说是第一副歌吗，\n在所谓第一段结束的地方，\n我完全被征服了，恍惚地沉浸其中。"],["と、唄が終わったらしい。","接着，歌声似乎结束了。"],["二人は何故かハグし合い、\nそのなんかのはずみでハウリングが起きてしまったようで、\n丁度惚けてた僕の脳をシャッキリさせてくれた。","两人不知为何互相拥抱，\n似乎因此产生了啸叫声，\n正好让我恍惚的脑袋清醒过来。"],["照れ笑いしながら…や、照れてるのは冬夏だけだけど…[l]\n二人は深々とお辞儀をし、\n座敷に降りてきた。","他们腼腆地笑着…啊，其实只有冬夏在害羞…[l]\n两人深深鞠躬，\n走下表演区。"],["最後のバックコーラスみたいなのなんて言ってたんだろ、\n月がどうとか……しか解らんかった。","最后那段像背景和声的歌词说了啥来着，\n只听清月亮什么的……"],["「いやはや、\nおっそろしいですなあ……[l]\nなんというか、\nうたってすごいですね」","「哎呀呀，\n真是太惊人啦……[l]\n该怎么说呢，\n连歌声都这么厉害呢」"],["何となくオール平仮名っぽい喋りになる僕。","我不知不觉用起了全平假名的说话方式。"],["つーかさあ、\nいよいよ狩屋の実力が大変気になるんスけど。","话说啊，\n我越来越在意狩屋的真实实力了。"],["彼奴、ほんとに喋りがあんなじゃなきゃ、\nルックスとて別段変ではないし、\nそれこそ完ぺ──\n……いや、だからか？","那家伙要不是说话那么古怪，\n长相其实也不差，\n根本就是完──\n……等等，难道正因为这样？"],["わざとなのか？[l]\n敢えて２位狙いの誰かさんみたいな？[l]\nそれはちと違うな……","是故意的吗？[l]\n像某个专攻第二名位置的家伙那样？[l]\n好像又不太一样……"],["「んー、\n宮さま素敵過ぎですたっ！」","「嗯～\n宫大人太出色啦！」"],["「んむ？[l]\nいえいえこの程度、\n一般教養の範疇、\n","「嗯哼？[l]\n哪里哪里这种程度，\n不过是常识范畴，\n"],["当然の","理所当然的"],["嗜みですのよおほほほほ」","修养罢了呵呵呵呵」"],["「ああもう、尊敬致しますー」","「啊啊真是，太令人尊敬了ー」"],["何かあすこで、\nまたぞろというか、\n繋がりが確固たるものになりつつあるな……","总觉得那边，\n该说又来了吗，\n两人的羁绊正变得越来越牢固呢……"],["「なんと言っても、\nうたはまほうですから、ね？」","「说到底，\n歌声就是魔法呢，对吧？」"],["「！！[l]\nんーっ、ですよね！ですよね！！[l]\n同意見ーーーっ」","「！！[l]\n嗯～就是啊！就是啊！！[l]\n完全同意ーーー」"],["そうか、それ、宮さんから聞いた言葉だった。[l]\nうたはまほう……[l]\n冬夏、同意見っていうか、そんなに一般的なフレーズかこれ？","对了，这句话原本是听宫说的。[l]\n歌声是魔法……[l]\n冬夏说完全同意，难道这是很常见的说法吗？"],["ぱっと言ってぱっと合致する言葉としては、\nちょっとばかり特殊な気がするんだけど……","作为能瞬间引发共鸣的台词，\n总觉得有点特别啊……"],["やっぱり僕の","莫非是在我"],["与り知らぬところで流行ってる\nのかなあ……","不知道的地方\n流行起来的……"],["「さて、\n次はまこくん？かな？」","「那么，\n下一位该小真了吧？」"],["「おっ。[l]\nほらほらー」","「哇哦。[l]\n来来来ー」"],["うぇえーまーじかよー。","呜诶～真的假的～"],["「や、僕は先刻散々歌ったから……」","「不，我刚才已经唱够多了……」"],["「えー？[l]\n全然歌ってなかったでしょー？」","「诶～？[l]\n根本就没怎么唱吧～？」"],["てかだからね、あんたらの今のその後でなにをしさらせと。","而且啊，在你们那样的表演之后要我怎么办嘛。"],["「レパートリーもあれだしさ……[l]\n多分おんなじの聴く羽目になるよ？[l]\n…あとはアニソンばっかだし」","「能唱的曲目也就那些……[l]\n估计你们又要听重复的了？[l]\n…剩下的全是动漫歌曲」"],["「いいよぅそれで。[l]\nあにそんでも」","「没关系啦。[l]\n动漫歌也行」"],["「んむ、じゃーまこくん宮と一緒にイっとく？[l]\n","「嗯哼，那小真就和宫一起上？[l]\n"],["ふたりでぇいつもの、ア・レ」","两个人唱那个，老・套・路」"],["厭なイントネーションでその台詞言わないで。","别用那种讨厌的语调说这句台词。"],["「いつものアレ？ってどれですか？」","「平时的那个？是指哪个啊？」"],["「いやーん言わせる気？[l]\nあれよぅアレぇ。[l]\n","「呀~非要人家说出来吗？[l]\n就是那个啦那个。[l]\n"],["年明けに散々、二人で特訓したでしょぉ？」","新年时我们不是特训过好多次嘛？」"],["ああ、あの、何とかいうアニソンね。[l]\nいつものって言う程のあれか？[l]\nて言うよりあれって……て、","啊啊，就是那个，叫什么来着的那首动漫歌。[l]\n能称得上是平时常练的那个吗？[l]\n与其说是那个不如说……呃，"],["…ほれ、[l]\n冬夏が変な眼でこっちを視てるし。[l]\nつーか冬夏も、宮さんの方に突っ込みなさいよー。","…喏，[l]\n冬夏正用奇怪的眼神盯着这边。[l]\n话说冬夏你也该吐槽宫小姐才对吧ー。"],["「……ほら、どうぞ！」","「……来，请用！」"],["つかつか僕に歩み寄ったかと思うと、\nマイクをぐいと押しつけて、\nがっしと手を掴み握らされた上から\n更にぎゅむと手を握り固めて来る。","她啪嗒啪嗒朝我走来，\n把麦克风猛地塞过来，\n从上方牢牢抓住我的手强迫握住后，\n又使劲捏紧了我的手掌。"],["で、僕をステージの方へと、文字通り突き放す冬夏。","接着冬夏就这么把我——字面意思地——推向了舞台。"],["何で不機嫌。","干嘛不高兴。"],["……え、フケツとでも言いたい？","……咦，是想说我呆若木鸡吗？"],["いやいや、大きな誤解ですしそもそも振ったのは宮さんなんですが？！","不不完全是误会而且明明是宫小姐先甩开我的啊？！"],["一瞬頬を膨らませて僕を睨み付けたと思うと、\n次の瞬間には破顔して僕等に拍手を寄越す冬夏。","她瞬间鼓起脸颊瞪了我一眼，\n下一秒却绽开笑容为我们鼓掌的冬夏。"],["何の意思表示なのやら、\n冬夏も感情の振り幅激しいなあ……[l]\n今日が特別なのかも知んないけど。","完全搞不懂她想表达什么，\n冬夏的情绪波动也太剧烈了……[l]\n说不定今天比较特殊吧。"],["「じゃー、冬夏さん、\nこれが宮たちの","「那么——冬夏小姐，\n这就是宫和我的"],["絆し……じゃない、[l]\n","羁绊……不对，[l]\n"],["絆のかたちです！」","羁绊的形式！」"],["「なにそれ……」","「什么鬼……」"],["またエコー掛かった声でおかしなことを…[l]\n","又用带着回音的嗓音说怪话…[l]\n"],["絆し、自由を束縛するモノね。[l]\n僕にとっちゃあそっちのが正解やがな。","羁绊就是束缚自由的东西啦。[l]\n对我来说后者才是正解呢。"],["「わーーーーぱちぱちぱちぱち」","「哇————啪啪啪啪」"],["すげえ微妙な拍手をして寄越す冬夏。[l]\nうっ、やりづらい……","冬夏送来一阵极其微妙的掌声。[l]\n呜、好难接话……"],["「おっと入力まだでした。[l]\nどれどれ……」","「啊呀还没点歌呢。[l]\n我看看……」"],["手早い操作で曲入れる宮さん。[l]\n相変わらず僕はぼーっと視てるだけです。[l]\nほらワカルひとがやった方が早いからね！","宫小姐熟练地操作着点歌机。[l]\n我依然只是呆呆看着。[l]\n看吧懂行的人动手就是快嘛！"],["さて前の曲とは打って変わって、\nちっと激しめの曲。","接着播放的是与先前截然不同的，\n稍显激烈的曲子。"],["まあアニソン的というか、\n所謂主題歌っぽい曲調であるのだが、\n一番の特徴は、","算是动漫风格吧，\n或者说典型的主题歌曲调，\n但最大特征是"],["歌詞が創作言語で、\n基本的には何言ってるのか判らないという点である。","歌词全是原创语言，\n基本上听不懂在唱什么。"],["それこそあの謎言語と比肩するくらいの、\n……まさか一緒ってことはないよなあ……[l]\n兎に角、そういう何か妙にトランス出来る曲である、\n個人的には。","简直能和那个谜之语言比肩，\n……该不会就是同一种吧……[l]\n总之是首莫名适合进入恍惚状态的曲子，\n至少我个人这么觉得。"],["ちなみにアニメの内容は他と同様、\n全く知らないんだよね……[l]\nというか、","顺带一提动画内容和其他作品一样，\n完全不了解呢……[l]\n或者说，"],["事実アニソンかどうかも実は定かではないけど、\n宮さんが何かそういう流れで僕に説明したから\nそういう認識でいるだけ。[l]\nや、だって大神も何か知ってるふうだったし。","其实连是不是动漫歌都不确定，\n只是宫小姐当初这么介绍我才\n一直这么认为的。[l]\n毕竟大神也装作知道的样子。"],["「てか結構マイナー曲も入ってるんすねえ……[l]\nや、何がメジャーかも知らないですけど……」","「话说冷门曲目还挺齐全的……[l]\n虽然我也不清楚哪些算热门啦……」"],["旅行してると結構ＬＤのカラオケとかまだあるので、\nこういった所できっちり曲数あるような設備と出逢うとは\n割と驚きだった。","旅行时发现不少地方还保留着LD伴唱机，\n能遇到这种曲库完备的设施\n还挺令人惊讶的。"],["「いきますよ？」","「要开始咯？」"],["「はいさぁ」","「好啦——」"],["今の二人の後でソロ唄うよりは、\n多少は楽な部分もあるけど、\nやっぱりアンサンブルというかデュエットではあるので\n失敗出来ないというプレッシャーはある。","比起在刚才那两人之后独唱，\n虽然某些部分会轻松些，\n但毕竟算是合奏或者说二重唱\n存在着不能失误的压力。"],["唾を飲んだり唇を舐めたりしてると、","当我反复吞咽唾沫舔着嘴唇时，"],["「だいじょぶです、\nさんざ仕込んだでしょ？」","「没问题的，\n不是特训过了嘛？」"],["にっこり","笑眯眯地"],["微","微"],["笑いかける宮さん。","朝我搭话的宫小姐。"],["まあ仕込まれたっていうか、\n先刻も言ってた通り、\nそれこそ今年の始めに、\n対新年会兵器としてがっつり練習させられたのだ。","说是特训嘛——\n就像刚才说的，\n其实就是今年年初\n被当作对抗新年会的武器狠狠操练过。"],["……新歓コンパで使う機会は無かったけど。","……虽然迎新酒会上没机会用。"],["「……あいさぁ」","「……好啦——」"],["曲が始まる。","歌曲开始了。"],["歌詞とリズム合わせがややっこしいけども、\nそこが逆に上手く唄えた時のトランス感というかグルーヴ感を\n与えてくれる要素にもなってるんだよね。","歌词和节奏配合虽然有点麻烦，\n但反而成为唱得好时\n那种恍惚感或者说律动感的来源。"],["──宮さんは何か踊ってますけど。[l]\nその振り付けまでは流石に僕も憶えられなかったので、\n棒立ちです。否、単純に恥ずいからです。","——宫小姐倒是跳得很起劲。[l]\n至于舞蹈动作我实在记不住，\n就杵着不动。不，单纯是害羞。"],["取り敢えずワンコーラス分は無難に終了。","总之第一段副歌平安结束。"],["……間奏のギターソロとか、[l]\nきっちり再現してるなあ。[l]\n耳コピ相当腕良いですよ。言える程僕もよく知らないけど。","……间奏的吉他独奏[l]\n还原得相当到位啊。[l]\n扒谱水平真厉害。虽然我也不太懂这些。"],["冬夏をちらと視ると、","偷瞄冬夏时发现"],["何か顔を覆って下を向いてたり、\nと思うとアタマぶんぶん振ってこっち向けて笑いながら\n手拍子したり、\n……親指立ててきたり。","她时而捂着脸低头，\n时而突然甩着脑袋转向这边笑着\n打起拍子，\n……时而竖起大拇指。"],["で、親指立て返す宮さん。","于是宫小姐也竖起拇指回应。"],["僕も仕方なくおずおず仕返そうとした所で、\nツーコーラス目が開始。","当我犹豫着要不要回礼时，\n第二段副歌开始了。"],["慌てて歌唱に集中する僕と、\n相変わらず完璧に振り付けをこなす宮さん。","慌忙集中精神唱歌的我，\n和依旧完美演绎动作的宫小姐。"],["踊りの一環なのか、\nたまに僕に纏わり付いてきたりしますけれども、\n当然リアクション不能です。","不知是不是舞蹈设计，\n她偶尔会贴过来，\n我当然完全接不住戏。"],["そうこうしてるうちに曲は終わり、\nまた深々とお辞儀する宮さんと、\n拍手で迎える冬夏。","这么折腾着歌曲结束，\n再次深深鞠躬的宫小姐，\n和鼓掌迎接的冬夏。"],["僕は心なしかほっとしながら、席に戻った。","我暗自松了口气回到座位。"],["「すっごいね、\n真言さん","「超厉害的，\n真言哥"],["先","不"],["刻のカラオケボックスでの\nソロとは全然違う」","和在刻时光KTV的\n独唱完全不一样」"],["「まあ、そもそも二人だし、\nだからつまりはあのひとのチカラだよね……[l]\n僕自身ぁ全然たいしたことないんだぁ……」","「毕竟本来就是两个人，\n所以说到底还是那位的功劳……[l]\n我自己根本没什么了不起啦……」"],["「え？[l]\nいあ、そんなことないよ。[l]\n真言さんの、歌い方から声の出し方からが全然違ってたよ」","「诶？[l]\n没、没这回事。[l]\n真言哥从唱法到发声都完全不同了」"],["「まあ、それはもう、」","「哎呀，那是因为」"],["「しっぽり二人っきりで特訓しましたからっ！[l]\n","「我们可是特训到浑身湿透呢！[l]\n"],["それはもう仕込みまくってあげたのデスモノ」","早就把他调教得服服帖帖啦」"],["エコー掛かったマイク持ったまま宮さんが会話に参加してきた。[l]\nあの、まだそっち方向で責める気ですか。","拿着带混响麦克风的宫小姐加入对话。[l]\n那个，还要继续往那个方向追击吗。"],["「あはははは……」","「啊哈哈哈……」"],["そして何故かまたトーンダウンの冬夏。[l]\n頬をポリポリと掻いて、\n何か切なげに斜め下に俯くのであった。","然后不知为何又蔫了的冬夏。[l]\n沙沙挠着脸颊，\n莫名落寞地低头斜视地面。"],["「んむ？[l]\nあーあー、大丈夫大丈夫、\nだいじょうぶですよぉ～」","「嗯唔？[l]\n啊—啊—，没事没事、\n没问题的啦～」"],["何がどう大丈夫なのか分かんないが、\nそう言いながら冬夏を抱きしめて頭を撫でる。","虽然搞不懂哪里没问题、\n这么说着抱住冬夏抚摸她的头。"],["で、冬夏も力なく……否、[l]\n何か安心したように微笑み返す。","接着冬夏也无力地……不、[l]\n像是松了口气般回以微笑。"],["「ありがとうございます。[l]\nだいじょぶです」","「非常感谢。[l]\n我没事的」"],["「んむ、それはなにより♪\nあだだだだだ」","「嗯唔，那就最好啦♪\n啊哒哒哒哒」"],["身長体格差の所為か、\n冬夏の抱き締め返しに悶絶しとる宮さん。","或许是身高体格差缘故、\n被冬夏回抱住的宫小姐快要窒息了。"],["……よくわからないけども、[l]\n兎に角何かは解決したようだ。","……虽然不太明白、[l]\n总之似乎解决了什么问题。"],["それを傍目に僕は喉を潤す為に烏龍を飲みますよ。","我旁观着为润喉喝了口乌龙茶。"],["ぐびびびびびび……","咕噜噜噜噜……"],["「ん、じゃあ次は私と真言さんだね。[l]\n何唄おうか？」","「嗯，那接下来轮到我和真言同学啦。[l]\n唱什么好呢？」"],["「ごふっ、げふげふげふ、\nんん゛ぇっ？！[l]\nあんでまた？？……うぇっふえふ」","「咕噗、咳咳咳、\n嗯嗯诶？！[l]\n为啥又是我？？……呜咳呼咳」"],["う、烏龍が気管に……","乌、乌龙茶呛进气管……"],["「んむー、まあそうなるのが順当というか、\n道理ですよねぇ。[l]\nがんばって♪」","「嗯唔—，嘛这种发展也算理所当然、\n合情合理呢。[l]\n加油哟♪」"],["「あははは、まあ、無理にとは言わないけど……」","「啊哈哈，倒也不会强迫你啦……」"],["……？[l]\n何か、\nちょこちょこトーンダウンするなぁ。","……？[l]\n总觉得、\n时不时就情绪低落呢。"],["うーん、冬夏は今日半日近く一緒だから、\n真面目に気遣いから出た言葉かも知れないが……","唔—，今天和冬夏待了大半天、\n可能是真心在顾虑我吧……"],["「や、だいじょ……大丈夫です。はい。[l]\n行きましょう、行きましょうとも！」","「没、没系……不要紧的。嗯。[l]\n走吧，这就走吧！」"],["そんな顔されてるのに断るなんて、","被那种眼神看着还拒绝的话、"],["──後で宮さんに怒られますから……","──回头会被宫小姐骂的……"],["「そう？[l]\nよかったっ。[l]\nじゃあ、さっきとは別の……[l]\nどれが良いかな」","「是吗？[l]\n太好啦。[l]\n那换首和刚才不同的……[l]\n选哪首好呢」"],["ああ、すぐにテンション戻るのね。[l]\n別にいいですけどね……","啊，立刻又恢复活力了呢。[l]\n不过也无所谓啦……"],["「まあまあ、まこくんの宿命ですよね」","「哎呀呀，这就是小真的宿命呀」"],["「なぁんでも。[l]\nんじゃ、みせつけておくんなましぃ～」","「没~啥。[l]\n那咱就献丑啦～」"],["ひらひら自分の席に戻る宮さん。[l]\nこのひとぁ相変わらずか……","宫小姐轻飘飘回到自己座位。[l]\n这人还是一如既往啊……"],["「ねね、\nこれどう？[l]\n知ってる真言さん？」","「呐呐、\n这首怎样？[l]\n真言同学知道吗？」"],["「んえ？[l]\nああ、ええと……」","「嗯诶？[l]\n啊，那个……」"],["そうして僕等は、","就这样我们、"],["しばしの宴に酔い痴れて……たのは僕以外だけかもだが、[l]\nそれなりに愉快な時間を過ごしたのであった。","沉醉在短暂宴会中……虽然可能只有我不在状态、[l]\n倒也度过了相当愉快的时光。"],["こういう時は時間が経つのも忘れるもので、\n一体今何時なのやら。","这种时候总会忘记时间流逝、\n完全搞不清现在几点。"],["携帯で時間を確認すると、","用手机确认时间后、"],["……そんなにも経ってないな。","……原来还没过多久。"],["ま、まあそういう時もある。[l]\n兎に角時間感覚が狂うという事で！","嘛，嘛偶尔也会这样。[l]\n总之就是时间感错乱啦！"],["とは言え。","话虽如此。"],["「冬夏さ、水をさすようであれだけど明日学校だよね？」","「冬夏啊，虽然扫兴但明天要上学吧？」"],["「ん？[l]\nうん。[l]\n大丈夫、半ドンだし」","「嗯？[l]\n嗯。[l]\n没事、因为是半天课」"],["は、半ドン？[l]\nややや、それ多分、今の人知らないぜ。","半、半天课？[l]\n哎呀呀、这个说法现在的人可能不知道哦。"],["尚説明させて頂きますと、\n異國語でいう日曜日、zondag、\nドンタクっていったかな？そこから、","请允许我补充说明，\n外语里说的星期日，zondag，\n是叫顿拓克来着？由此引申，"],["昔の土曜日授業みたいに午後から休みとか、\n半休日の事を半ドンというそうですよ。","像以前星期六下午不上课那样、\n把半天假日称为半天课。"],["僕ぁアナクロ人だから知ってたけども、\n冬夏、なかなかやるな……[l]\nそれともこれも知らない所で流行ってる？","我是老古董所以知道啦、\n冬夏、挺厉害嘛……[l]\n还是说这说法其实又在某地流行起来了？"],["はたまた僕が思い込んでただけで、\nこれくらいは一般常識なのか？","又或者只是我自以为是、\n这其实是常识范畴？"],["明日は金曜の筈だが、\nまあ新学期初日という事でそうなってるのかな。","明天应该是星期五、\n不过新学期第一天可能特殊安排吧。"],["「でも、ん、\nそろそろお開きな感じ？[l]\nお風呂も入りたいし」","「不过、嗯、\n差不多该散场了？[l]\n我还想泡个澡」"],["「んむ、ならば宮もご一緒しますか？[l]\nここまでお付き合いして貰ったですし、\nほら、毒を食らわば皿まで……いあいあ、[l]\n乗りかかった船？」","「唔、那宫要一起吗？[l]\n都陪我这么久了、\n俗话说、一不做二不休……啊哈哈、[l]\n骑虎难下？」"],["「あれ、露天てもう大丈夫なんですか？」","「啊咧、露天浴场已经可以用了？」"],["「の、筈ですよ。[l]\nちず……げふげふ。[l]\nち・らっと視たら、\n張り紙がしてあったような？気がしましたけど？」","「应、应该吧。[l]\n千……咳咳。[l]\n瞄・了一眼、\n好像贴着告示？大概？」"],["へえ……[l]\nてか今危なかったな宮さん。[l]\n幸い冬夏は気にしてないようだけど。","嘿诶……[l]\n话说刚才超危险啊宫。[l]\n幸好冬夏似乎没在意。"],["「そか、露天風呂あるんですね？[l]\nでも流石に恥ずかしいかなあ……というかその……」","「这样啊、有露天浴场呢？[l]\n不过果然还是有点害羞……或者说那个……」"],["──ああ、まあ、大衆浴場に行くには、\n冬夏としては色々ある、よなあ。","──啊、也是、去公共浴场的话、\n对冬夏来说确实有各种问题呢。"],["旅館だから地元民は少ないとは言え、否、\nだからこそ逆に好奇の眼で視られる可能性が、\nん、更に逆で、余所者同士異境の宿泊地では\n関係なくなるのかな。","虽说旅馆里本地人少、不、\n正因如此反而可能被好奇的目光打量、\n嗯、再反过来想、在异乡的住宿地陌生人之间、\n可能反而无所谓了吧。"],["ともあれ、\n本人が躊躇してるならば無理強いは出来まい。","总之、\n本人犹豫的话也不好勉强。"],["が、","但，"],["「あーだいじょぶです。[l]\n人の居ない時間帯知ってますから。[l]\n伊達に長逗留してないですようひひ」","「啊——没问题的。[l]\n我知道没人的时间段。[l]\n可不是白住这么久呢嘻嘻」"],["宣う宮さん。","宫如此宣称。"],["「はあ、じゃあ……折角だし、[l]\nご一緒して頂けます……？」","「好吧、那……机会难得、[l]\n就一起吧……？」"],["……本人が良いなら何も言うまい。","……本人愿意就没什么好说的。"],["「らじゃーです。[l]\nただ露天は水着着用なので、\n宮のを貸しま……」","「好嘞。[l]\n不过露天浴场要穿泳衣、\n把我的借给……」"],["そこで冬夏の肢体を繁々と視て止まる宮さん。[l]\nまあ、そりゃあ……","这时宫盯着冬夏的身体僵住了。[l]\n嘛、这也难怪……"],["「いあ、ストレッチきくし着られるとみた！[l]\nタイト気味ならそれはそれでこう、」","「啊、弹性够的话就能穿！[l]\n紧一点反而有种、」"],["いや、無理でしょう……[l]\nセパレートならまだしもあなたの持参してるのは、\nワンピでスク水でしょうが。","不、不可能吧……[l]\n分体式还勉强、你带的可是、\n连体校园泳装啊。"],["結局、宮さんが売店で買ってあげることになった。[l]\n冬夏は最初固辞したけども、\nまあそんな値段でもなかったし、\n何やらデザインとかも気に入ったようで。","结果变成宫去小卖部给她买。[l]\n冬夏起初坚决推辞、\n不过价格也不算贵、\n而且好像挺中意某个款式。"],["宮さんが有無を言わさなかったというのもあるけど……","虽然宫根本没给她拒绝的余地……"],["という訳で、\n広間からロビーに移動してた我々も、\nここで一端解散する事になったところで、","于是乎，\n从大厅移动到前台的我们，\n也在此暂时解散的时候，"],["「あ、まこくん……は流石に、お風呂今日は別々ですねぇ……」","「啊、小真……今天洗澡果然还是分开洗吧……」"],["いや、だから『今日は』とか言わんでいいのに……","不是、所以说不用特意强调『今天』啦……"],["「………」",""],["「ささ、行きましょうか冬夏さん。[l]\n時間的にもばっちりですし、\n質問があればみっちり受け付けますですので☆」","「好啦好啦、我们走吧冬夏小姐。[l]\n时间上也刚刚好，\n有问题的话我会全部解答的哦☆」"],["「……真言さん、[l]\n──マタアトデネ」","「……真言先生，[l]\n──待会见」"],["うっ……","呜……"],["ていうか何で冬夏不機嫌になる？[l]\nフケツとかいう理由だったら、\nどっちかというと貴女こそこう、\n何て言うの？","话说为什么冬夏会不高兴啊？[l]\n要是说什么不吉利的理由，\n倒不如说您自己才是那个，\n该怎么说来着？"],["不潔とは言わぬまでもほれ、\nフランクに過ぎるというか、オープンというか……","虽不至于说肮脏但你看，\n太过直率还是说、太开放了……"],["「……あれ」","「……咦」"],["二人は知らぬ間に居なくなってた。","两人不知何时已经不见了。"],["「まあいいや……[l]\n僕も風呂入ろ」","「算了……[l]\n我也去泡澡吧」"],["例の従業員用の室内風呂に。","去那个传说中的员工专用室内浴池。"],["「はあ、なんか、\nよくわからん１日だったな……」","「哈啊、怎么说呢，\n真是莫名其妙的一天啊……」"],["と、言うかさあ、\n何か大事な事を忘れてる気がするんだあ……","话说回来，\n总觉得忘了什么重要的事啊……"],["何だったかまでは、","具体是什么，"],["そりゃぁ、憶えてないんだけども。","那当然是、想不起来了。"]],"context":[["SC_M_032.ks/index/1/text"],["SC_M_032.ks/index/3/text"],["SC_M_032.ks/index/6/text"],["SC_M_032.ks/index/9/text"],["SC_M_032.ks/index/11/text"],["SC_M_032.ks/index/14/text"],["SC_M_032.ks/index/16/text"],["SC_M_032.ks/index/18/text"],["SC_M_032.ks/index/20/text"],["SC_M_032.ks/index/23/text"],["SC_M_032.ks/index/25/text","SC_M_032.ks/index/689/text"],["SC_M_032.ks/index/27/text"],["SC_M_032.ks/index/29/text"],["SC_M_032.ks/index/31/text"],["SC_M_032.ks/index/33/text"],["SC_M_032.ks/index/35/text"],["SC_M_032.ks/index/37/text"],["SC_M_032.ks/index/40/text"],["SC_M_032.ks/index/42/text"],["SC_M_032.ks/index/44/text"],["SC_M_032.ks/index/46/text"],["SC_M_032.ks/index/48/text"],["SC_M_032.ks/index/50/text"],["SC_M_032.ks/index/52/text"],["SC_M_032.ks/index/54/text"],["SC_M_032.ks/index/56/text"],["SC_M_032.ks/index/58/text"],["SC_M_032.ks/index/60/text"],["SC_M_032.ks/index/63/text"],["SC_M_032.ks/index/65/text"],["SC_M_032.ks/index/67/text"],["SC_M_032.ks/index/69/text"],["SC_M_032.ks/index/71/text"],["SC_M_032.ks/index/73/text"],["SC_M_032.ks/index/75/text"],["SC_M_032.ks/index/77/text"],["SC_M_032.ks/index/79/text"],["SC_M_032.ks/index/81/text"],["SC_M_032.ks/index/83/text"],["SC_M_032.ks/index/85/text","SC_M_032.ks/index/317/text"],["SC_M_032.ks/index/87/text"],["SC_M_032.ks/index/89/text"],["SC_M_032.ks/index/91/text"],["SC_M_032.ks/index/93/text"],["SC_M_032.ks/index/95/text"],["SC_M_032.ks/index/97/text"],["SC_M_032.ks/index/99/text"],["SC_M_032.ks/index/101/text"],["SC_M_032.ks/index/103/text"],["SC_M_032.ks/index/105/text"],["SC_M_032.ks/index/107/text"],["SC_M_032.ks/index/109/text"],["SC_M_032.ks/index/111/text"],["SC_M_032.ks/index/113/text"],["SC_M_032.ks/index/115/text"],["SC_M_032.ks/index/117/text"],["SC_M_032.ks/index/119/text"],["SC_M_032.ks/index/121/text"],["SC_M_032.ks/index/123/text"