],[{"start":30203,"end":30225}],[{"start":30231,"end":30237}],[{"start":30243,"end":30258}],[{"start":30272,"end":30312}],[{"start":30318,"end":30323}],[{"start":30356,"end":30367}],[{"start":30373,"end":30383}],[{"start":30389,"end":30397}],[{"start":30403,"end":30409}],[{"start":30448,"end":30459}],[{"start":30465,"end":30471}],[{"start":30510,"end":30526}],[{"start":30532,"end":30551}],[{"start":30557,"end":30574}],[{"start":30580,"end":30592}],[{"start":30628,"end":30651}],[{"start":30657,"end":30674}],[{"start":30713,"end":30723}],[{"start":30729,"end":30762}],[{"start":30798,"end":30845}],[{"start":30882,"end":30889}],[{"start":30928,"end":30931}],[{"start":30968,"end":30998}],[{"start":31004,"end":31019}],[{"start":31055,"end":31080}],[{"start":31096,"end":31106}],[{"start":31145,"end":31150}],[{"start":31189,"end":31192},{"start":31229,"end":31232}],[{"start":31271,"end":31287}],[{"start":31293,"end":31303}],[{"start":31309,"end":31345}],[{"start":31351,"end":31364}],[{"start":31370,"end":31389}],[{"start":31401,"end":31405}],[{"start":31411,"end":31423}],[{"start":31429,"end":31444}],[{"start":31480,"end":31543}],[{"start":31561,"end":31578}],[{"start":31584,"end":31587}],[{"start":31648,"end":31653}],[{"start":31690,"end":31695}],[{"start":31734,"end":31740}],[{"start":31746,"end":31754}],[{"start":31790,"end":31804}],[{"start":31841,"end":31853}],[{"start":31892,"end":31905}],[{"start":31911,"end":31922}],[{"start":31961,"end":31976}],[{"start":31982,"end":32006}],[{"start":32012,"end":32019}],[{"start":32058,"end":32112}],[{"start":32148,"end":32155}],[{"start":32161,"end":32190}],[{"start":32229,"end":32247}],[{"start":32283,"end":32298}],[{"start":32304,"end":32380}],[{"start":32398,"end":32438}],[{"start":32456,"end":32475}],[{"start":32481,"end":32494}],[{"start":32531,"end":32549}],[{"start":32555,"end":32571}],[{"start":32585,"end":32600}],[{"start":32621,"end":32636}],[{"start":32675,"end":32682}],[{"start":32688,"end":32703}],[{"start":32739,"end":32753}],[{"start":32790,"end":32804}],[{"start":32810,"end":32819}],[{"start":32825,"end":32838}],[{"start":32844,"end":32886}],[{"start":32892,"end":32905}],[{"start":32911,"end":32924}],[{"start":32960,"end":32969}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_011.ks","basename":"SC_M_011.ks","indexIds":{"ＰＰＰＰ。":0,"Ｐ。":1,"…んあ。":2,"あー、朝、か。":3,"昨日夜まで気疲れしたせいで、\n今朝はちょっとだるい。":4,"セットしておいた携帯のアラームを、\n眼を瞑ったまま操作し止める。":5,"若干肌寒いし、惰眠への誘惑が襲ってくるが、\n今日は本家に行かなければならない。":6,"とっとと起きよう…":7,"それにしても、\nこっち来てから、連日健康的な時間に起床してるなあ。":8,"遊びに来てるわけではないし別に良いんだが。":9,"大学行ってた頃より余程、規則正しい日々を過ごしております。":10,"というより、夜も遅いわけじゃないし。":11,"なーんにも愉快な番組無い上に、\n思ったよりもやることが連日あったので、\n結果そうならざるを得ないだけだけど。":12,"ま、それとは別に、只でさえ番組構成が向こうと違う所為か、\n曜日感覚が無くなったりと、順調に浮世離れは進んでいる。":13,"それは別にいいけど。":14,"とにかくまだ着いてから３日しか経ってない。":15,"気張ってるうちだけかも知れないし、\nま、体調及び精神状態の自己管理はしっかとせんとなあ。":16,"大神と毎日電話するのも気持ち悪いし、金も掛かる。":17,"奴も今頃何してるんだか。":18,"かれお嬢と逢えないながらも進展してるのかしらん。":19,"彼等、もし一緒になったら、大神まで飯窪本家の縁の者に\nなるのか。":20,"それともかれお嬢、寿退社的扱いに家庭に入るのか。":21,"前者だったら…とにかく気持ち悪いなあ。":22,"しかし彼女、特殊な技能で遣われてたようだし、\n本家が辞めさせないかもしれないな。":23,"大神、ＳＥとしてなら使えるかも知れないが、\nやっぱり直接親戚筋になる訳では無いとはいえ、\n友人以上に近しい処に世間的な位相を占められると\n何度も言うが気持ち悪いよ。":24,"と、一頻り暇つぶしの思考遊戯を揺蕩わせ、\n頭に血が巡るのを待っていた。":25,"「………ああ、そういやあ…」":26,"握りっぱなしにしていた携帯に、\nふと気付いて思い出した。":27,"夕べの宮さんからのメール。":28,"画像は見てなかったのよな。":29,"さてどうしたものか。":30,"視てあげっか折角だし。":31,"…変な意図は無いよ？":32,"また結構な労力割いたんだろうし、\n視てあげないと宮さんの苦労に申し訳ないからですよ？":33,"おかしな期待はシテナイヨ？":34,"………さ、自己弁解はそこそこにして、":35,"えーと…":36,"がた。":37,"そこで突然部屋の入り口が開く気配がし、":38,"驚いている間に、寝室の襖が開いて、":39,"また別の私服になってる宮さんが現れた。":40,"「おっはようございます。":41,"何か久しぶりなかんじですね？":42,"みましたか？メール。":43,"メール。":44,"どうでした？":45,"どうでした？」":46,"夕べ返信しなかったせいか、\nまずそこから訊いてきますか宮さん。":47,"なんか余程………な仕込みでもしてたのか。":48,"タイミング的に幸か不幸か、\n今まさに視ようとしてた処で。":49,"つまりはまだ視てないんです。":50,"それよりまず最初に、\n僕の入室許諾の可否を聞いてくれないでしょうか。":51,"「…おはようございます。":52,"朝から心臓に悪い登場の仕方ですね宮さん。":53,"大変申し訳在りませんが、\n昨日は疲れてあっという間に寝てしまいまして。":54,"件名は確認しましたけども」":55,"添付画像は見てません、\nというなり激しく落胆する宮さん。":56,"「んむーっ？":57,"折角宮が頑張って一肌脱いだのにっ！":58,"あーんなことまでしたのにっ！":59,"恥ずかしかったけどまこくんの事を思って":60,"一生懸命っ！」":61,"「あ、それは申し訳ないです…":62,"丁度今確認しようとしてたんで……」":63,"と持っていた携帯を操作しようとすると、":64,"「はうあ！":65,"ば、ばかーっ！":66,"今見ちゃ駄目です！":67,"寄越すです！！」":68,"えらい剣幕で焦りだし、まだ寝ぼけ気味でスローリー動作だった\n僕の手から携帯を奪い、\n何やら恐ろしい形相で操作しだした。":69,"「ふんだ！":70,"もう消しましたもんね！":71,"あーあ勿体ないです！":72,"悔しがるがいいです！」":73,"涙目…。":74,"時事ネタはタイミング命なんだからっ！":75,"と説教されている僕。":76,"話のスケールがやや違うが、\n言いたいことは解ります。":77,"まあその時その場所その面子でないと受けない笑いとか、\nあるよねあははー。":78,"ちゅうか宮さん、自身が居る前で視られるのが恥ずい、\nというのが理由の大半なんじゃ。":79,"いずれ後悔するくらいならやらんで欲しいんですけど。":80,"「もう二度とあんなの出来ないよぉ…":81,"ぐす」":82,"………。":83,"う、正直気にはなるが、\nここで喰い付く素振りを見せようものなら\n今後何かと弄られるのは目に見えている。":84,"「あーそうですね。":85,"悔しいったらないです。":86,"なのでこっちで勝手に色々と\n想像させて戴きます。":87,"ああ、一体どんな…":88,"マサカアンナ事ヤコンナ事ヲ宮サンガ…」":89,"「心がこもってないっ！":90,"変態さんってツッコミもできないですっ！」":91,"そのツッコミをさせないためにそうしたので":92,"当然です。":93,"「最近冷たいよまこくん。":94,"宮のこときらいなんだぁ…」":95,"「あのね…":96,"きらいとかそういう事じゃないでしょ。":97,"それに今始まった事でもない気が…」":98,"「前まではもっと愉快な反応してくれたですよぉ」":99,"結局だからそうでしょ…":100,"弄りたいだけなんだからこの人は…":101,"第一嫌いじゃないですよ、好きですよ！":102,"とかいうレスも変…というか別の意味になり兼ねないし。":103,"それともそう言わせたいのか。":104,"そして弄りたいか。そうなのか。":105,"「周囲の状況がここ最近、誰かさんの御陰で\n激変してて疲れてるんですよたぶん。":106,"きらいになんかなってないので\n安心してください」":107,"誰かさんとは目の前のこの人なのでちと矛盾してまぁす。":108,"「（じゃ、\n好きなのかな？）」":109,"「ハイ？」":110,"と、宮さんの手にした携帯が鳴った。":111,"「んむっ。":112,"こんな早くに誰でせう？":113,"…おおう知狡ですね。":114,"はいまこくん」":115,"「あおう、はいはい」":116,"なんと言ったか聞き取れなかったが、\n例によってあっさりモードが替わる宮さん。":117,"まあ丁度好い。":118,"変な話題になりかけた気配だったし。":119,"ありがとう知狡さん。":120,"『ああ、真言か？":121,"私だ。":122,"今から迎えがそちらに行くから、\n支度してロビーで待機してくれるか。":123,"センノチノという女性だ。":124,"多分、マスクをしていくだろうから、\nそれを目印にしてくれ。":125,"あ、マスクといっても被る方じゃないぞ。":126,"では、本家で待っている』":127,"生返事をしてるうちに、知狡さんはさっさと通話を切ってしまった。":128,"結構ドライだな。電話切るのに抵抗無いタイプな。":129,"あと、マスクったら普通、風邪用マスクをちゃんと想像しますから。":130,"心配性だなあ。":131,"「なんです？」":132,"「あ、何か今日、本家のお宝見せられるんですと。":133,"で、迎えが来るそうです今」":134,"「んむ？":135,"あー、今日なんですか。":136,"日程までは聞いてませんでした」":137,"「あ、そうですか…":138,"てかそもそも昨日夕方決まったんで、\n伝える間も無かったんですけどね。":139,"ん？":140,"本家にまた行くって話もしてなかった気が…」":141,"「んむ？？":142,"いやですねまこくん。":143,"宮は確かに車降りませんでしたけど、\nちゃんと知狡から聞いてます。":144,"というより、\n前から決まってた事ですから」":145,"へえー。":146,"そうなんですか。":147,"それはつまり、":148,"「なんか今回の調査と関係あるんすか？」":149,"「んむー、ま、遠からずですかね。":150,"取り敢えずは気にしないでだいじょぶでっす。":151,"うちで正式に働くんなら、飯窪の血統の者として、\n特にまこくんは直系男子ですからね、\nこの機会に家宝についても教わるべきということです」":152,"はあ。":153,"そういや、もしこのまま僕が宮さんや本家の方に\n世話になるとなると、\nその場合うちの母さんどうなるんだろう。":154,"向こうの家から離れる気はなさそうだし…":155,"「ま、\n早めに戻れそうなら今日は一緒に食事でも\nしましょうか。":156,"それとも今日も若い女子達と楽しく過ごすんですか。":157,"それならそれでいいですけど宮は。":158,"一人で寂しくごはんします。":159,"冷たいなぁ…まこくんが冷たいなぁ………":160,"冷たすぎて風邪引きそうです…」":161,"そのギャグが寒くてこっちが風邪引きそうです。":162,"しかし言えない。言えやしない。":163,"つーかまだそっちの話題引きずるか。":164,"自分の世界に入っとるし。":165,"「むつけ…いや、むくれないで下さい。":166,"きらいじゃないって言ってるでしょう。":167,"明日が蔵に入る本番だので今日は逢わないんですよ。":168,"宮さん昼間忙しいんじゃないんですか」":169,"不用意な接触をギリまで避けるのと、\nギリまで打ち合わせるのと、":170,"どっちが良いか考えたが、すべからく行き当たりばったりな\nこの状況で何を打ち合わせるものか困惑した僕は、\n前者を採択したのだった。":171,"大体今日の本家の用件もどんだけ掛かるか分からないし。":172,"「ま、実際どれだけ時間かかるか分かんないですし。":173,"まこくんが少しでも長く宮と一緒に居たそうだったから\n気を遣って言ってみました。":174,"別にタイミング合えばで結構ですよ宮は？":175,"どうしてもとは言いませんよ。":176,"どうせ宮はメモでもしないと忘れちゃいますもんね。":177,"でもぉ、まこくん次第でどうとでも都合してあげます。":178,"うひひ」":179,"「………」":180,"寝起きでこっちも脳が空転気味なので、\nこれ以上の論理的なレスは厳しい。":181,"ジト眼で見返す位が関の山だった。":182,"「さ、早く行かないと来ますよ迎えが。":183,"終わったらメール下さい。":184,"状況次第ではぁ…」":185,"「はいはい。一緒にご飯ね。":186,"じゃ、今後はメール来たらすぐ視るようにしますよ」":187,"「あーい。":188,"今日はメールのネタ仕込みする時間は無いから、\n今別の方法で直接元気を注入してあげまー」":189,"「ちゅーなら結構」":190,"「んむー！":191,"やっぱり冷たいっ！！":192,"ハグでもしたげなきゃかなっ！？」":193,"もうええちゅうねん。":194,"………って、オチてもいないというか、":195,"「それよりそろそろ出てってくれませんか。":196,"早く行けも何も着替えすら出来ないんですけども」":197,"「ん？":198,"おおう！":199,"そでしたね。":200,"今出まーす」":201,"ここはあっさり引くんだな。":202,"てっきり『宮には構わずどうぞ着替えてくださいうひひ』とか\n言うのかと思った。":203,"まあ、僕が遅れると他の人にも影響する状況だからな。":204,"「じゃ宮も戻りますね。":205,"頑張ってー。":206,"いってらっしゃい。":207,"チノによろしく」":208,"「何かをどうにか頑張る事柄なのかどうかも解りませんが了解です」":209,"宮さんが完全に部屋から出たのを確認し、\n僕は急いで支度を始め――":210,"――の前に、入り口に立ち小声で":211,"「………愛してます」":212,"と呟いた。":213,"途端に扉が開き、":214,"「うひひ。":215,"何ですかもぅっ。":216,"照れますなあ♪":217,"宮困ってしまいますぅ」":218,"やっぱり其処に居たのか。":219,"いや、\n何処にまず突っ込もうかも分かんなくなって来ましたよ…":220,"もうどうでもいいんで、とにかく早く部屋に戻って下さい」":221,"「はぁーい」":222,"「僕の部屋でなく貴女のお部屋にっ」":223,"「ちぇっ。":224,"んむー残念。":225,"わっかりましたぁー。":226,"知狡達に怒られないうちに退散しまーす。":227,"うひひっ」":228,"ようやく本当に立ち去る宮さん。":229,"朝からどっと疲れさせられたわもう…":230,"――てもう時間結構経ったじゃねえかよ。":231,"やばいやばい急いで支度だ。":232,"遅れたらしっかと宮さんの所為にするかんね…":233,"さて、初日の本家からの車移動時間から考えて、\nそろそろと思った時間には何とか支度も整い、\nロビーで待機していたのだが、\nまだそれらしき人物は到着していなかった。":234,"まあそもそも、本家から来るかどうかも定かじゃないし。":235,"来た気がするな。勘だけど。":236,"何でそう思ったか自分でも解らないが、\n車の音がしたでも無いのに、とにかくそう思った。":237,"で、ホントにどうやらそうだった。":238,"一瞬子供かと思ったくらい背が低く、\n知狡さんが言ったように、\nマスクをした女性がロビーから入ってきた。":239,"三白眼で目つきが悪い…というか、\n眼の下に隈があり、\nマスクと相まって非常に不健康そうに見える。":240,"実際にそうなのかも知れないが。":241,"宮さんとは別の意味で年齢がよく分からない。":242,"祖母の知り合いで、今日僕に色々説明してくれる人というのが、\nこの人なのだろうか。":243,"動作が何というか変に違和感あるというか、\n頭の高さが変わらずに歩いてるというか、\n一個一個の所作はスムースなんだが、\n逆にそれが全体的に視ると人間として不自然というか、":244,"……また初対面の人間に対して失礼な印象を持ってしまう。":245,"と思ってみれば、確かにどこかしらかれお嬢に通じる系の\nような気配もするな。":246,"飯窪本家そんなのばっかり集めてんのかしらん。":247,"向こうがこっちを見知ってるかどうかまでは定かでないので、\nこちらから声を掛けることにする。":248,"知狡さんが寄越してる以上は大丈夫だろうけど念の為。":249,"「あ、あのすみません。":250,"センノ…さん？ですか？」":251,"声を掛けると、その女性は眉を":252,"顰め、ゆっくりと、\nしかも目線ではなく、\nまるで機械のように顔ごとこちらに向けて、一度眼をしばたいた。":253,"「…ドウモ、こんにちわ。":254,"ん、お早う？":255,"どっちでもいいか。":256,"チズルに言われて迎えに来ました貴方を。":257,"私の名前は…チノ、":258,"千":259,"野チノです。":260,"宜しくどうぞ」":261,"「あ、やっぱりそうですか。":262,"おはよう…ございます。":263,"えーと、飯窪真言です。":264,"こちらこそ宜しくです」":265,"動作から受けるイメージとは裏腹に、\nといっても僕個人の主観の話だが、\nやけに耳障りの良い声である。":266,"マスクで籠もってはいるのだが、\n幼いとも大人の女性とも取れる、\nこちらの保護欲と母性への甘えの両方を刺激する微妙なる声。":267,"いわばカリスマ性というか、\n声質だけ聴くと人心掴めそうな声なのだ。個人主観だけど。":268,"惜しむらくは、文章自体に違和感あるとこか。":269,"あとゆっくりではあるのだが、\n途切れなく喋るのでやっぱり機械的な印象になるところとか。":270,"うーん僕がいちいち人の声中に、惹かれる部分を自動検索しすぎかねえ。":271,"大神あたりの、声優がどうとかいうのとは違うと思ってるんだが、\n何か自信無くなって来たな。":272,"「乗ってください車に早速。":273,"聞いてますよ時間がないと。":274,"ん？聞いてないかな？":275,"どっちでもいいですが。":276,"無いですしねゆっくりする理由も」":277,"ゲホゲホ、と見た目通り不健康そうな咳をする彼女。":278,"「あの、大丈夫ですか？":279,"とても体調宜しく無さそうなんですが…」":280,"「…大丈夫です心配は。無用。":281,"演技ですから相手の期待に応える為の。":282,"期待は裏切らないようにしたいんで」":283,"「はい？」":284,"「風邪ですかと問われますよねマスクをしていたら。":285,"ん？花粉症か？":286,"どっちでもいいんですが。":287,"人って少なくともfirst impressionは見た目十割ですが、\nその第一印象とはかけ離れた実状を個々人は持ってるでしょう。":288,"それを知って落胆される事は私にとってはとても悲しい事です。":289,"私これでも尽くすタイプなのですよ、はい。":290,"ギャップによって発生する価値もありますがね。":291,"私は感じませんがね。":292,"居ますけどね世の中には。":293,"とみに最近は対立項を並列させたり、\n逆ベクトル項を少々加味した存在をなんとか…なんだっけな？":294,"まあいいか。":295,"そういったモノに浅い大衆的価値を付加し見出してるでしょう。":296,"若年の浅い脳髄機構で走る思考電気などで、\nしかし消費システム界においては供給側はその流れに乗ってしまう傾向が大という悲しい現状…":297,"という現状に対するアンティテーゼのつもりで、":298,"しかし、それすらも私個人の嗜好にしか過ぎず、\n他人に強要すべきことでもないですしね、\n簡単に言いますと、\n眼鏡をかけた人間はインテリゲンチア、\nデブは大食い、":299,"と言ったコミック的なsterotype、\n理解できます？":300,"マスクをした人間は咳き込む人間。":301,"メディアを毛嫌いしながらメディアによって作られた虚像たらんと\nする…ヒトとは謎ですね。":302,"私これでも古いタイプの女なのですよ、はい」":303,"これはスタイルなだけですつまり、\nという、よく分からない返答をされた。":304,"長かったなおい…":305,"何か途中で熱こもってたし。":306,"……えー、…要するに、風邪だのアレルギーだので\n咳き込んだ訳ではない？":307,"もの凄くかみ砕いて解釈すると、\n『お約束はなるべくお約束通りに』":308,"という事かなあ…違うかなあ…":309,"遣ってる言葉も多分造語っぽかったな。":310,"僕が寡聞にして知らないだけかもだが、\n単語を、遣いたい意味のまま並べただけな気がするんですが。":311,"それで更に意味不明の度合いが増してました。":312,"あれ、ところでつまり、\nこの人がマスク着用の理由は他にあるって事か？":313,"その肝心な処を説明してくれないと、長々喋られる意義もへったくれも…":314,"と、がっと僕の手を握り、じゃない、\n手首を掴んで半ば引きずるような勢いで、\nチノ嬢が外に向かって歩き出した。":315,"「え、あ、はい？":316,"ななななんですかってちょっと！」":317,"「急がされていたんでした私達、チズルに」":318,"おいおいおいおい。":319,"いくら急ぐったって、\nまず基本的に貴女の喋りが長かったのが問題ではないのか。":320,"そしてまたスキンシップ女子ってか…":321,"宮さんや冬夏達のような、":322,"好意めいた行為（自分で言うと馬鹿みたいだな）でなく、\nあくまで効率的だからという理由のようだが。":323,"いずれにしても異性の身体に易々と接触できる感覚というのは\n僕的にはあれだなあ…":324,"僕もこれで古い頭の男子なのですよ、はい。":325,"というか貴女、古いタイプってどの辺がですか。":326,"「思わず長話で時間が経ってしまいましたのでご容赦下さい。":327,"お願いします急ぐ事を。":328,"で、迎え遅れたのは私の所為でして。":329,"ちょと忘れてました道路。":330,"何故なら私此処来ること久々なので」":331,"おお長話の自覚はあったんな、と思う間に、\n彼女は助手席のドアを開け僕に乗車を促してから、\n運転席にまわり、ぬるりと乗り込んだ。":332,"彼女が乗ってきたのはマニュアル車で、\n乗ると同時にクラッチを踏んでエンジン掛けるチノさん。":333,"僕のシートベルトの装着を確認するや否や、":334,"「っういー！？」":335,"急発進。":336,"バックで止めてたので前進スタートが可能だったのだった。":337,"そしてまさに機械の如き手つきでギアを入れ、\n速攻５速に入る。":338,"しかし、道中の運転そのものは、\n法定速度の許容範囲ギリギリをキープしてたり、\n車や人が全く無かろうが信号が赤ならばしっかと止まるなど、\n極めて模範的なものであった。":339,"まあそれは、そうあるべきであって何の問題も無いんだけども。":340,"ただ、とにかく発進が急気味なので、\nこれは、ちょっと酔うかもなあ…":341,"で、横からの車も歩行者も居ないのに何故か赤くなった押しボタン信号、それ待ちのややバツの悪い間が訪れた時、唐突に彼女が口を開いた。":342,"「ルール、ロウというのは同族生物が恙無く生活をする為のものですから、杓子定規に遵守すれば良いというモノではないですが。":343,"かといって他者に対して説得力を得るためには、\n独りの時も遵法者たらねばなりませんよ。":344,"精神論を語る気も無いですが。":345,"言語はこのヒトという種が属する文化の呪ですから。":346,"解釈の差違も面倒なものです。":347,"まあ現実現象としてNatureから生まれたヒトが、\n他生物同様生命本能に則って行動するのが真か、\nヒトとしての文化に準ずるのが真か、\n事実そこに在るモノが真か、\nヒトとその他を分かつという思考そのものが既に反自然ですし、":348,"思考主体の判断基準次第です。":349,"しかし、何にでも擬人化思考を以てして、\nヒトの価値観を他種に当て嵌めるのはどうにも。":350,"だからと言ってどう扱っても良い訳ではないのですよ。":351,"愛玩と友愛は違うということなんですがね。":352,"ま、向こうは向こうで被愛玩存在としての地位を確立することによる種の存続をかもしれませんから。":353,"それこそこちらの理屈を押しつける訳にもね。":354,"擬人化と言えば、\n容貌が可愛いか醜悪かで、もてはやしたり殲滅したりとかしますでしょう。":355,"勿論実利を採ってる場合もありますがね。":356,"その辺りを言い出すと、先刻言ったギャップの件と矛盾し出すのでこの辺で。":357,"で、結局の処、\n好嫌のみがこの世を動かしていると言えますかね、今のところ。":358,"どっちでもいいですが。私たちには」":359,"「申し訳ないですが何を仰って居られるのか":360,"僕にはさっぱり…」":361,"この人、途切れなく喋るから長く感じるのだろうが、\n何より相づちを打つ間が無いんだよ。":362,"そして自己完結的に終わるからレスのしようが無い。":363,"あと恐らくだが、自分の脳内での思考を進行するがままに\n声に出してる所為か、主語述語がくしゃくしゃな気がするし、\n尚かつ整合性が有るような無いような微妙な感じに。":364,"なので、衒学的にも聞こえそうで聞こえない。":365,"うーん…突拍子の無さと言語周りの違和感、\n平身低頭と慇懃無礼の違いはあるが、\nかれお嬢とやっぱり同類なんだなきっと…":366,"最近は知狡さんもこっちの部類になりつつある気配がするし、\n飯窪本家、びっくり人間集めて何かしらしたいのか。":367,"びっくり人間てなんやねん。":368,"「ああ、問題無いですよ。":369,"どっちでもいいことです」":370,"出会ってからの感じから判断して、\n怒ってる訳ではないと思うけども…":371,"この場合わかった振りして生返事の対応なんかしたら\n泥沼になりそうだし、どうしたものか。":372,"それとも無言の道中よりかはマシなのかな。":373,"と思っていると、":374,"「構いませんよ寝ていても」":375,"「え？":376,"あいえ、大丈夫です…":377,"もう着きますよね確か」":378,"「すみませんね。":379,"必要以上に人心、察してしまうのですよ」":380,"「はあ…」":381,"察しが良すぎるって事？":382,"別に眠かった訳ではないのだが、\n間が保たないなら狸寝入りもおｋだよ、\nというのを気を遣った迂遠な言い回しで\n言ったという事？":383,"ああ、僕も言語回路おかしくなってきた。":384,"自分でも何考えてるかわからん…":385,"――人の意を察すと言えば『 ":386,"覚 』、\n旅館の部屋名にもあったな。":387,"思わず、変な想像しないように構えてしまう僕。":388,"「言われて欲しくない事を口にしないという\n察し方を出来る人なので私。":389,"安心してください」":390,"「はあ、そうですか…」":391,"別に恥ずい思考を巡らせた訳ではないが、\nそれ以前にまさかこの人、本物じゃないよな。":392,"あははーそんなばかなー。":393,"「想像力とはその所持者にとって諸刃の剣ですよ」":394,"「は？":395,"はあ、そう、ですか…」":396,"な、何に対しての、その御言葉なんでしょうカ。":397,"「己の敵対する対象の行動原理を知るに当たり、\nprofiling的な想像力は助けにはなりますが、\n同時に嫌悪する対象と同調する事でもありますからね。":398,"潔癖性には辛いですよ」":399,"「…何かの小説で読んだ気がします…":400,"まあ、そうでなくても、恐怖症って要するに極端な想像力の\n発露の仕方ですしね、あはは…":401,"……違ってたら済みません」":402,"ああ私もよくわかりませんね。":403,"まあどっちでもいいんじゃないですかね」":404,"「そうですね…":405,"まあ…どっちでもいいです…」":406,"結局、前後の関連性は相変わらずわからないまま、\nそして車は例の入り組んだ町並みに入り込み、\n本家に近づいて来ていた。":407,"「おお、着きますね。":408,"チズルが出迎えています」":409,"「あ、ほんとですね。":410,"えーと、ありがとうございました」":411,"「問題無いです」":412,"知狡さんはえらい神妙な顔の直立不動体勢で僕らを迎えた。":413,"車はぬるりと駐車スペースへと入り、\n僕らは降りて知狡さんの元へ向かう。":414,"急発進はするけど急停止はしないチノ嬢であった。":415,"「おはよう二人とも。":416,"チノお疲れ、ありがとう」":417,"「どういたしまして。":418,"これからだけどね本当のお疲れは。":419,"ゲンシは立ち会わないんだね？」":420,"「親父殿は勿論、母殿もだ。他も今余所にいる。":421,"私と君だけでいく」":422,"呼ばれ、連れてこられただけの僕は\nとまれ今のところは立ち尽くすしかない。":423,"話が振られるまで待ちますよ。":424,"「真言、朝食は摂ったのか？」":425,"「あー、ちゃんとしたのはまだですね…":426,"軽くお菓子的なものを食しただけで。":427,"ああそう、早めに終わったら宮さんに\n食事誘われてますけど」":428,"「宮さんと？":429,"ああそうか。":430,"正直時間に関しては確約出来ないが、\nすまないが我慢してくれ。":431,"宮さんと食事……か、わかった、まあ善処はしよう」":432,"や、そこ深刻に検討しないでいいんですが。":433,"こないだの話、変なかたちで引きずってるな。":434,"「私もまだ別件で用事あるので。":435,"早速始めよう」":436,"「わかった。":437,"いいか真言？":438,"きちんとした食事はすまないが後で頼む。":439,"ではこちらだ」":440,"前に知狡さんとチノ嬢、\n僕一人がそれに後続する形で歩き出す。":441,"前の二人は僕より付き合いの長い知り合いであろうから、\n並んで歩いてるんだと思ったのだが、\nさして会話をするでもなく、\n黙々と屋敷の中へと入っていく。":442,"僕の所為？この空気。":443,"まあでも、仮にそうだとしてもどうしようもないわな。":444,"屋敷内を只ひたすら付いていく。":445,"前来た時の祖父の部屋とは、\n当然ながら違う場所を目指しているのだろう、\nもう道順から何からわかりません。":446,"まがりなりにも家宝、盗難予防に敢えて複雑な道程を設定\nしてるのだろうか。":447,"…朝飯がちゃんとしてなかった所為か、\nそろそろ脳が空転し出す予感…":448,"帰り道ぜってぇ分かんねえな…":449,"「真言」":450,"「はっ、":451,"ふぁい？」":452,"「ここから地下だ」":453,"「気を付けて足下は」":454,"地下？":455,"書じゃないというから、\n件の（飯窪の方の）蔵じゃないのは予想できたが、\n地下室なんてあるんだ。":456,"ほえー…":457,"いくつか並んだ洋風のドアの一つ、\n鍵穴に古びた鍵を挿す知狡さん。":458,"あーと、どのドアか覚える集中力ももう無いです。":459,"まあ今後一人で此処に来る用も無いだろうから\nいいでしょう、スルーしても。":460,"と先行する二人はドアを開け、入ったすぐ横の壁を\n探りスイッチを押したらしかった。":461,"地下への通路からオレンジ色の光が視え、どうやらすぐに下り階段なのだとわかる。":462,"知狡さん、チノ嬢、僕の順で降りて行く。":463,"「おおう、\nドアは閉めるでお願いします」":464,"「あ、はい」":465,"「鍵も頼む」":466,"「わかりましたぁ…と、\n暗いなあ……」":467,"湿気はさほどないが、\n独特の臭気と、肌寒さ。":468,"音も静かで、":469,"洋風なのか和風なのかよくわからないこの空間と相まって、\nあれだ、\n地方の空いてる民俗資料館みたいだ。":470,"喩えはあれだが。":471,"そもそも暗くてよくわからない。":472,"「ったた、おうあ、ごめんなさいすみません」":473,"「問題無いです、お気になさらず」":474,"まだ先があるらしいのに突然立ち止まった二人。":475,"思わずぶつかってしまった。":476,"階段でこんな暗いのに危ないな、\nちょっと間違えたら大惨事になるとこだった。":477,"僕の腰が引けてた御陰か何とか軽い接触で済んだが。":478,"――で、何で立ち止まったの？":479,"「ああ、説明不足で悪かった。":480,"念のためとはいえ妄りに口に出したくはなかったんだ」":481,"「下はフェイク。":482,"典型的過ぎてあまり効果は期待してませんが。":483,"気休めですこの仕掛け自体は」":484,"と言って二人は左手の壁を探った。":485,"「おお、おお何すかこれは。":486,"忍者屋敷じゃないすかまるで」":487,"漫画や映画のそれのように、隠し扉があったのだった。":488,"大仰な仕掛けではないが、壁にとけ込んでおり、\nその気になって探さなければ見つからないだろう。":489,"下に階段は続いてるのだし。":490,"吃驚はしてるんだが何気に大声を出しづらく、\n小声でリアクションする僕。":491,"「と言いますかですね、\n典型的と言われても普通の家屋には隠し扉自体が\n無いですよ…」":492,"二人は無言のまま扉を開け――こっちを外とすると中開の――、\n中に入った。":493,"やむなく従う。":494,"心なしか息苦しい感覚が僕を襲う。":495,"閉所恐怖症のケでもあったのかな。":496,"「うあ、こっちは完全に真っ暗ですね…」":497,"「今明かり点くよ」":498,"「そんなに明るくはならないからそのつもりで\nいてくれ」":499,"まあこの状況でいきなり強照度のライティングされたら\n眼に悪いだろうし…":500,"徐々に赤黄色い光が部屋を照らし出す。":501,"まさに博物館のような柔い照明が、\n暗所に馴れた僕の眼に視界を見せ始める。":502,"「………おおう？」":503,"――筺のような、\n何の飾り気もない、只の立方体のような部屋だった。":504,"セメント打ちっ放しのようにみえるが、\nそちら方面に明るくないので具体的な素材は知らない。":505,"ただ黒く四角い部屋。":506,"天井の四隅に明かり。":507,"入り口正面の、つまり最奥の壁際に、\n神棚なのか祭壇なのか、\n化粧台なのかサイドボードなのか、\n柩なのかショーケースなのか。":508,"とにかく、\n何かを供すべく配されたオブジェがあり。":509,"「奥まで入ってくれ。":510,"あれが――そうだ。":511,"私の父…と、母が見せたかったものだ」":512,"飯窪家に伝わるという家宝――\n今回の件とどう絡むのか、或いは絡まないのかは\n未だ定かではないが、\n三春家の蔵調査の前にこれをみせたかったという。":513,"「えーと、取り敢えず見るだけでいいんですかね？":514,"おー…":515,"なんですかこれは」":516,"年代物のようにはみえるが無國籍な意匠の施されたその台の上、\n四つの支柱が――といっても棒程度のものだが――に囲まれて、\nしかし天蓋はないその中央に。":517,"また同様の奇妙な意匠、印が蓋に捺された筺が、\n紐で封されていた。":518,"色紙よりやや大きいくらいの、所謂桐箱のようにみえるんだが…":519,"全く確証は無い。":520,"古いのかも新しいのかもわからない。":521,"「これ解いて良いんですか？僕が？」":522,"互い違いに頷く知狡さんとチノ嬢。":523,"ところで何で貴女方お二人は入り口横からこっちに\n来ないんでしょう。":524,"狭いから？ドッキリだから？":525,"まあいいや。":526,"空転脳てある種の低血糖状態だもので、\n指先手元が狂わないようこめかみの辺りに力を入れ集中する。":527,"紐自体に関しては、やや湿り気とべたつきを感じた位で、\n扱いに慎重を期す程に劣化した物ではなかった。":528,"では、蓋開けますよ。":529,"「………な…":530,"んでしょうかこれは？":531,"オーパーツ的な何か…ですか？":532,"視た感じあまり覚えのある…モノでは無いですなあ…」":533,"およそＹの字といっていいであろう、\n芽を出した双葉のような形状、\n子葉の部分が更に二股に分かれ、\n平行した四枚の葉のようになっていて、\nそれぞれが、":534,"ヒトの眼のようにみえる。":535,"色は暗さと照明の色味の所為で、今のところ褐色めいてしか\n視えない。":536,"材質…はなんだろう。":537,"木か、骨か。":538,"よくＵＭＡモノの本やテレビで視る河童の木乃伊とか、\nあんな感じではあるが、\nもっと工業的な意匠を感じるが。":539,"だからオーパーツ的な印象を受けたのだけど、\n知狡さんにその単語、意味が通じたかどうかは不明だ。":540,"「仮面だよ」":541,"――仮面。":542,"四つの眼をした仮面か。":543,"仮面といっても顔面全覆ではなく、漫画でよくある、\n仮装パーティーの眼だけ隠すあれみたいだけど。":544,"しかし葉に喩えると茎の部分というか、柄の部分が口に半端に被って据わり悪そうだな。":545,"耳紐もないし、まあ実用というよりは祭儀用か何かかな…":546,"にしても何時何処産のモノなんだ。":547,"少なくともこの國の感じでは無い。":548,"例えばその柄の下端部分、あれだ、前に大神が使ってるの視た事あるが、付けペンのペン先みたいな形だし。":549,"勿論スケールは違うし、あくまで概容、印象がだが。":550,"「…Ｉｇ」":551,"イグ？":552,"チノ嬢が呟いた、ように聞こえたが、こちらを見ていないし、\nどうやら独り言だろう。":553,"異具？そんな言葉は無いか。":554,"独り言以前に単に呻っただけかもな。":555,"うぐぅ。":556,"「飯窪が伝えてきたのはこれだ。":557,"…残念ながら正確な名称は長い間に――忘れられて、\nある時点から我々は仮に、":558,"『いぐしまめ』と呼ぶ」":559,"「イグシ、…マメ？」":560,"「ま、近しい単語があるからといって\nそこに喰い付かないが佳いよ」":561,"「そういうことだ。":562,"便宜上の仮称に過ぎない。":563,"とにかくこれは――」":564,"「『":565,"方":566,"相":567,"氏』、知ってるかな？」":568,"一瞬言葉に詰まる知狡さんに、被せ気味で言うチノ嬢。":569,"それより、さっきの呟きは『いぐしまめ』の『いぐ』だったか。":570,"「え、まあ、知ってますよ名前と概要くらいは。":571,"旅館の部屋名にもあったし…」":572,"極々簡単に言えば、\n節分の豆撒きの元になった、邪を祓い駆逐する者の事、\nとでも言えば良いのか。":573,"追儺、鬼遣い、方相氏。":574,"死体を狙うモノを廃す者。":575,"宮さんの言っていた、蠱物としての猫の、\n在る側面では、敵対者に位置されるとも言えるのか。":576,"猫は過去に於いて、死臭に誘われ死骸に近寄る性質の故、\n妖怪的なモノとして見られたらしいと、諸々の本を読む限りでは推測出来るが。":577,"猫魂だの、猫又が死体を踊らせるだの、\n火車が死骸を攫うだの、\nいずれ人類にとって普遍的と言える禁忌、\n『死』や『死骸』にかかずらるその振る舞いが、\n東西問わず太古より猫を魔性のものとして位置づける\n要因となったのか、という気はする。":578,"瞳孔の変化から来る月との関連、月と言えば女子との関連、\n女子と猫、ある時期に於いては魔女と使い魔という――":579,"またその一方、発生の地の関係か、\n古代の埃では愛玩または鼠駆除の為に飼われていたり、\n有名な猫の女神もおわすわけだが。":580,"まあ、その手の話は単純一筋縄では行かないのが常だけど…":581,"――思考が逸れた。私真言、只今脳空転遺憾なく発揮しております。":582,"いずれ方相氏は、…まあ猫に限った事ではないんだろうが、\n主に墓を害する魔物に対抗する存在であると、\nそう要約出来る…かな。":583,"僕ぁ本好きではあるが、あくまで娯楽、嗜好、\n読書によって、読まない人よりは知ってる事も貯えられはするが、\n真面目に勉強しようという意志を以てして、毎回読む訳でもないので、まあざっくりですよ、その辺は。へっへっへ。":584,"勉強に楽しみ見出したり、能動的に学びたいと思うのはもう少し\n年齢いってからだと聞くしな。":585,"うーん、\n死体を害すモノ、屍食鬼、屍鬼…\nそれを矛もて追い祓う…":586,"あ、方相氏も四つ目の仮面がどうとかいう描写だな。":587,"そういう事？":588,"「そう、そういう事です」":589,"視線を移しはしたものの口に出しては何も言ってないのに、\n丁度思考の区切れでチノ嬢が、合いの手的に言った。":590,"察するなあ…":591,"「あれに極めて性質の、ん？存在の？":592,"近しいモノと思ってください。":593,"色んな意味で符号はしてますがね」":594,"「とはいえ飯窪では、\n実際にこれを節分に被って追い回したり、\n豆撒きしてきた訳でもない」":595,"「まあ、そんな風習知ってる人間のが今や少ないでしょうし。":596,"何を以て正式とするかで更に…て、\n知狡さんには言うまでもないでしょうけど」":597,"「さて。":598,"ここで説話を少々するよ。":599,"ん、説話？違う？":600,"まあどっちでもいいか。":601,"人の眼についてかたられる魔力だね」":602,"――例によって彼女の解析に時間と労力を要する長広舌が\n始まってしまったが、\n脳空転も甚だしく成りつつある僕にはもう限界でした。":603,"そちら方面はそれなりに趣味で資料を読み漁ってたので、\nごめんなさい生返事で。":604,"大体知ってた事にゃったので此処では略しますにゃ。":605,"というかチノ嬢の話、噛み砕いて再構成するのは今厳し過ぎ…":606,"またの講釈にて。何だそれは。":607,"ごほん、とチノ嬢が咳払いした。":608,"心読まれた上でのツッコミなのか、例の演技咳なのかは分かんないけど。":609,"そして話し出した。":610,"「飯窪の家にこれが渡って以来、\nこれは飯窪の女当主及び直系の男子のみが接触を許可されているんですが。":611,"実質、男子はご存じの通りほとんど生まれていませんので、\n貴男は何年…ん？":612,"何十年？何百年？":613,"まあどれでもいいんですが。":614,"久方振りの接触者です。男子としての。":615,"当主であろうと女性はこれの管理保全を任せられているに過ぎず、\n使用権限は男子にあるというシキタリなんですが。":616,"試しに被ってみたらどうです？それ以外に用途ありますか？":617,"その眼から何かが視える、かも知れないね。":618,"興味あります私達も」":619,"「え、良いんですか？":620,"とと、唐突ですね…」":621,"知狡さんを視ると、":622,"「………それが今日の目的だからな」":623,"と、何か不機嫌そうに…と言うと語弊があるが、\nとにかく何かしら負の感情のこもった口調で頷いていた。":624,"まあ『達』と言うからには飯窪…最低でも目前の二人の\n意志なんだろう、興味あるのは。":625,"「じゃ、じゃあ…」":626,"触れる。":627,"外気というか部屋の気温は低めなのに、\n…人肌の様な温さで――":628,"というＢ級的な事は無く、\nだが相変わらず素材がわかんないので幾分気持ち悪い。":629,"乾燥した肉っぽいというか、変な弾力がある気が…":630,"被るったって、構造的にどう…と、実際持ち上げて裏面を\n視ると、かつて耳紐通した穴らしきものはある。":631,"が、だからといって…":632,"「顔にあてて眼の覗き穴から視るだけで結構」":633,"相変わらず察しまくりですなあ、\nしかし言語使用法の怪しさも相変わらずですわよ。":634,"脳は今や空転しまくってまして何もかんも言われるが侭です。":635,"四つ目全てに穴が開いているが、顔との比率バランスと\n形状の構造からして下段の一対が眼に当たるのだろう、\n虫眼鏡の如く柄の部分を持ち、\n顔に近づけた。":636,"「……わ」":637,"「わ？」":638,"また何か呟きが聞こえたが、\nこの御方のアクションにいちいちリアクションしてる程\nもう気を回せない。":639,"恙無く事態を進行させて、早くちゃんとした飯を喰いに…":640,"…別に宮さんとどうこうという訳じゃないが、\nまあ一応連絡は入れますけどね…":641,"さて、拙速は巧遅に勝る…ん？逆だっけ？":642,"視覚に意識を集中させる。":643,"レンズが有る訳でも無いこの仮面の眼窩越しに、\n何が視えるかって…":644,"「…いっち！」":645,"一瞬あの、\n冬夏を初めて視た時の眼の奥の痛みが走った。":646,"「………！":647,"――？」":648,"と、背筋が総毛立った。":649,"視界、":650,"臭い、":651,"聞こえ出す音、":652,"が、特定の記憶の取っ手を刺激する、":653,"つまり当時の状況との関連付けがある故に起きる、":654,"五感による記憶の想起、記憶？何の？":655,"記憶を喚起するものが、ちくちくと空転している脳を刺す、":656,"知っている筈の事を思い出せないときのもどかしい感触、":657,"知っている、知っているんだ、知っているのに、":658,"なんだこれは、いや、":659,"そんなことは今かんがえることじゃない、":660,"そして、ああああ。":661,"目の前が真っ赤になり、":662,"音が遠のいていく――":663,"身体が熱く燃えるように、":664,"意識が肉体に充満し圧迫されてルカノヨウダハレツスル":665,"再び遠くより音がさんざめくざわわわわわ":666,"ヒキズリダサレテコノママアカキホノオノナカニヤカレ":667,"ざざざああざざざざおあおあああ":668,"ナニカガヤケキレルオアアアオワアアアアアオギヤアア":669,"ごろろろろろろろろざざざざざざざざ":670,"ナキゴエガキコエルキョウチョウヲツゲルオトダロウカ":671,"ととつぜんめがさめるようなかんかくとともにぼくは":672,"気付くと座り込んでいた。":673,"立ちくらみというよりは、":674,"金縛りにあったときに近く、":675,"全身が冷や汗でびっしょりと濡れていた。":676,"突然の覚醒、変性意識からの帰還、この感覚、":677,"あ。":678,"あ？":679,"なんだ？":680,"肩口に気配がするが振り向いてもなにもない――":681,"当たり前だ。":682,"いつもの脳空転…に近いが違う…":683,"金縛りに近い、おかしな声や騒音が耳の奥から鳴っていたような\nねこ？くろ？":684,"いつ？わ？":685,"「だいじょうぶですか？":686,"しっかり気を持って。":687,"見えますかこれ？":688,"指何本に？」":689,"「肩の力を抜け、真言。":690,"どうした？」":691,"「…視界がじんわり赤くなって……":692,"神経が焼き切れたかと思うくらい身体が…":693,"熱くなった…死ぬんじゃないかと……":694,"焦った……驚いた………」":695,"二人は顔を見合わせて、それから僕を覗き込んだ。":696,"ああ、ほんとに吃驚した、今のは何。":697,"「なんだったんだか…":698,"ああ、済みません、\nまさかこれの所為じゃないですよねえ…」":699,"緊張からか、空腹からか、\nまさか即効性の変な病原菌付着してたとか、\nはたまた、":700,"「呪いだと？」":701,"「え」":702,"「ヒトは概してヒトガタのモノには妖しき気を見出すものなので。":703,"恥ずかしがることはありません」":704,"そのような推測を抱いてもね、と続けるチノ嬢の足下、":705,"視界を何かが動いた。":706,"「ねこが」":707,"「？」":708,"「あ、いえ、なにかがいまそこを…":709,"動いた気がしたので…":710,"でもなんで猫だと思ったんだろうな、\n思わずに口に出たんですけど。":711,"鼠か何か…かも知れません…":712,"猫なんて、こんな、ところにいるわけが…":713,"ははは…":714,"腹減ってるんですか…ね…":715,"自分でも何言ってるのか……が」":716,"眠気とも目眩ともつかない、\n混沌が僕の思考を、包み出し、\n空転する脳髄、\nまともにものを考えるのが――":717,"視界が揺らぎ斜めに、そして水平に、":718,"衝撃が":719,"「真言！」":720,"「おおう」":721,"「すまない。":722,"真言、すまない」":723,"知狡さんが僕を抱き留めている":724,"「宮店長に伝えてくるよ」":725,"「ああ頼む、大丈夫か真言、":726,"今背負ってやる…っく」":727,"「ああ…ああ…ごめんなさい……":728,"すみません…だ、だいじょう…ぶと言いたいところ…":729,"なんですが…」":730,"「解ってる、喋らなくていい、\n目的は達したから心配は要らない、\n宮さんとゆっくり休んでくれ」":731,"目的は達した？":732,"あ、いやいや宮さんと逢うことにそんなに執着してないってば…":733,"「はは…まだ…そんなへんなことを…」":734,"そのあたりでもう限界が訪れた。":735,"僕の少なくとも肉体的なスイッチが切れ、\n夢も現も判然としなくなり、\n眼は開けられない。\n瞼の裏の光の像のみが蠢き揺らぐのが視え…":736,"車に乗せられているのが判る、\n過去に救急車に乗った時のような感覚が甦る…":737,"その時、精神のスイッチも切れゆく中で、":738,"聴覚が捉えた最後の声が――":739,"「予定通りの旗は立てられたねチズル。":740,"次の舞台へ昇段移行の過程が動く。":741,"よく分からないなこの國の言葉。":742,"何を彼は視るかなミハルの蔵で」":743,"「…願わくば、":744,"――私もあれの顕現に賭けたい」":745,"それがお前の、ほんとうの――":746,"「全てはカリ、全てはゲェム。":747,"劇の幕は既に開き、":748,"語られる事は騙られる事さ。":749,"好嫌で位相は移相して、\nそれを決定するのはあの方か、\n雫の波紋のみ。":750,"じゃ、入ろうか次の準備に。":751,"●の●の………らん…とを」":752,"もう、聞こえない。":753},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_011.ks","relPath":"/data/scenario/SC_M_011.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":754,"length":754,"percent":100},"cellInfo":[[null,{"t":"HU"}],[null,{"t":"HU","v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"t":"HU"}],null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"t":"HU"}],null,[null,