[{"start":4654,"end":4671}],[{"start":4702,"end":4734}],[{"start":4766,"end":4781}],[{"start":4794,"end":4795}],[{"start":4804,"end":4858}],[{"start":4889,"end":4954}],[{"start":4986,"end":4999}],[{"start":5007,"end":5088}],[{"start":5096,"end":5165}],[{"start":5196,"end":5242}],[{"start":5260,"end":5304}],[{"start":5312,"end":5352}],[{"start":5360,"end":5434}],[{"start":5442,"end":5461}],[{"start":5492,"end":5518}],[{"start":5528,"end":5529}],[{"start":5538,"end":5564}],[{"start":5596,"end":5640}],[{"start":5671,"end":5737}],[{"start":5745,"end":5833}],[{"start":5851,"end":5930}],[{"start":5962,"end":6028}],[{"start":6059,"end":6081}],[{"start":6099,"end":6148}],[{"start":6180,"end":6251}],[{"start":6282,"end":6304}],[{"start":6314,"end":6333}],[{"start":6345,"end":6360}],[{"start":6392,"end":6469}],[{"start":6500,"end":6524}],[{"start":6532,"end":6543}],[{"start":6552,"end":6553}],[{"start":6562,"end":6606}],[{"start":6624,"end":6662}],[{"start":6671,"end":6694}],[{"start":6725,"end":6795}],[{"start":6827,"end":6882}],[{"start":6900,"end":6946}],[{"start":6977,"end":7008}],[{"start":7040,"end":7045}],[{"start":7076,"end":7123}],[{"start":7155,"end":7186}],[{"start":7194,"end":7244}],[{"start":7275,"end":7334}],[{"start":7366,"end":7412}],[{"start":7420,"end":7488}],[{"start":7519,"end":7550}],[{"start":7582,"end":7638}],[{"start":7669,"end":7735}],[{"start":7753,"end":7798}],[{"start":7830,"end":7871}],[{"start":7879,"end":7931}],[{"start":7962,"end":7972}],[{"start":7990,"end":8079}],[{"start":8087,"end":8114}],[{"start":8146,"end":8188}],[{"start":8196,"end":8240}],[{"start":8250,"end":8251}],[{"start":8261,"end":8271}],[{"start":8279,"end":8341}],[{"start":8372,"end":8380}],[{"start":8412,"end":8418}],[{"start":8460,"end":8491}],[{"start":8499,"end":8549}],[{"start":8581,"end":8588}],[{"start":8606,"end":8609}],[{"start":8617,"end":8627}],[{"start":8635,"end":8646}],[{"start":8677,"end":8680}],[{"start":8698,"end":8707}],[{"start":8738,"end":8746}],[{"start":8764,"end":8777}],[{"start":8796,"end":8809}],[{"start":8817,"end":8825}],[{"start":8856,"end":8871}],[{"start":8903,"end":8923}],[{"start":8947,"end":9016}],[{"start":9052,"end":9108}],[{"start":9139,"end":9142}],[{"start":9151,"end":9152}],[{"start":9162,"end":9165}],[{"start":9179,"end":9189}],[{"start":9218,"end":9222}],[{"start":9230,"end":9240}],[{"start":9302,"end":9340}],[{"start":9358,"end":9379}],[{"start":9494,"end":9572}],[{"start":9590,"end":9634}],[{"start":9642,"end":9720}],[{"start":9728,"end":9796}],[{"start":9804,"end":9853}],[{"start":9914,"end":9920}],[{"start":9957,"end":9992}],[{"start":10024,"end":10080}],[{"start":10098,"end":10164}],[{"start":10174,"end":10175}],[{"start":10185,"end":10194}],[{"start":10202,"end":10240}],[{"start":10272,"end":10283}],[{"start":10295,"end":10326}],[{"start":10335,"end":10336}],[{"start":10345,"end":10346}],[{"start":10355,"end":10404}],[{"start":10465,"end":10493}],[{"start":10530,"end":10549}],[{"start":10588,"end":10639}],[{"start":10676,"end":10682}],[{"start":10714,"end":10753}],[{"start":10817,"end":10839}],[{"start":10857,"end":10924}],[{"start":10985,"end":11042}],[{"start":11060,"end":11066}],[{"start":11098,"end":11141}],[{"start":11205,"end":11233}],[{"start":11265,"end":11280}],[{"start":11298,"end":11340}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_023.ks","basename":"SC_M_023.ks","indexIds":{"「おや。[l]\nおや？[l]\nふむ。[l]\n…んーーー、":0,"まあ、\n――。[l]\nどっちでもいいのか……」":1,"「ええ……っとぅ………[l]\n何が、と訊くのは諦めますので、\nそのですね、\nせめてその手をお離しになっては頂けませんでしょうか……」":2,"階段から廊下に戻るなり、\nチノ嬢と鉢合わせた。":3,"鉢合わせただけならともかく、":4,"「あー、\n失敬しましたね。[l]\n少々気になる事がありましたので」":5,"両の手は何故、僕の顔をがっしと掴んでいたのでしょうか。":6,"「痛くないようにしたつもりでしたが」":7,"「いやその、痛くはないです……[l]\nじゃなくて、その、僕の顔に何か気になる点でも……」":8,"「別に気になる点は無いですね、そう言う質問であるなら。[l]\nそれより察する所、空腹なのでは？":9,"今日はお疲れでしたね。[l]\n豪勢な夕餉が用意されている事でしょう。[l]\n無論チズルはcookingには参加してませんのでご安心を」":10,"言いながら、するすると手を降ろしていくチノ嬢。[l]\n何故か顔の輪郭をなぞるように、\n首のチョーカーに到達したところで":11,"漸く\n離してくれた。":12,"「あ、そ、そうすか……[l]\nそれは楽しみです、\nって、あれ？」":13,"こちらのリアクションを視るでもなく、\nすたすたと立ち去っていく。":14,"や、いいんだけど……[l]\n行動に緩急ありすぎじゃないかしら。[l]\nもう慣れたと思ってたけど、まだまだ深いなあ……":15,"「………」":16,"僕は呆けて後ろ姿を見送っていたが、\n彼女は廊下の曲がり角まで行ったところで急にこっちを向き":17,"「あまり":18,"香を残すとあの方が不機嫌になるので」":19,"と言って、角の向こうに姿を隠した。":20,"ガヲノコスってなんですか？？[l]\nで、あの方が不機嫌て……[l]\nえ、\nあの方ですか？":21,"「はあそれはどうもお心遣い感謝します……」":22,"何にしろ確かに言われたとおり、\n空腹にて脳は空転しておりまして、\nもうまともに考察なんか出来ないのが正直な所だので、":23,"チノ嬢が最後に角の向こうから親指だけを『ぐっ』と\n突き出したのを確認し、\n部屋へと戻ることにした。[l]\nご飯行く前にちっと寄ろうとしただけなんだが、":24,"「んむっ。[l]\nまこくんまこくん、\nちーっと、\nこっち来て下さい」":25,"「？」":26,"部屋の入り口前で宮さんが手招きしていた。":27,"「こっちって、此処は僕に":28,"宛がわれてる部屋ですが……」":29,"「さぁさ、さぁさ中にぃ～♪」":30,"「何なんです。何なんですか。[l]\nおあ、なんっでそんなに！[l]\n近づくんでっていでででででで\n":31,"痛いですってそんな引っ張らんでも」":32,"僕がキーで扉を開けるやいなや、\n宮さんは僕の腕をとって（組んで？）ぐいっぐいに\n引っ張り込むのです。[l]\nなぜ。":33,"「ほ、報告ならちゃんとしますってば、\nそんなに焦らないでも、\nというか夕ごは」":34,"「突然ですが、\n添い寝たーいむ！！」":35,"―。":36,"――。":37,"―――。":38,"あ゛っ。[l]\n何言ってらっしゃるんだこのひとは。":39,"「うひひ、\n久々にフリーの時間がとれたのでっ。[l]\n折角なのでまこくんの寝顔でも視ようと思いました」":40,"久々フリーって、ああそうなんですか。[l]\n確かに僕とは別動で色々するって事でしたが……[l]\nどうにもそんな忙し感が見受けられないゆえ……[l]\n否、そんな話がしたいんじゃない。":41,"「新幹線のリベンジ、でもありますよ。[l]\n":42,"勝ち逃げは許しませんことよ！」":43,"「あのね……[l]\nチノさんといい、唐突にも程がありますよ。[l]\n流行ってるんですか？脈絡無し行動。":44,"フリーの時間ったって、\nほらもういつもこの時間は夕飯の時間でしょ。[l]\nまずは飯食いましょうよ」":45,"「んむっ。[l]\n脈絡無しなんて失礼ですね。[l]\n理由は今言ったでしょぉ？[l]\n":46,"それにっ！」":47,"布団を敷きながら喋っていた宮さんはそこで\nびし、と指を突きつけ言いました。":48,"「食べてすぐ横になったら牛になるです！[l]\n故にだから、急ぎ今、":49,"食前が好ましいっ！":50,"でもま、\n――しょうがないですね、\n":51,"…じゃー五分だけっ。[l]\n":52,"ままままま、ほらここにごろーーんと」":53,"「あの……[l]\nまあ、えー、\nしょうがないですなあ……[l]\n五分だけですよ」":54,"なんだこの会話。":55,"「宮さんに今日の報告したら、\n大神に電話しようと思ってたんですから……」":56,"「あ、別に一緒に布団入ろーというわけじゃないですから。":57,"ここにごろ寝で……あ、[l]\nなになにまこくん期待しちゃった？[l]\n流石に宮でもいきなりそこまではぁ……」":58,"「はいはい、変な事もせんと一緒に風呂も入った仲でしょ……[l]\n横に寝っ転がるくらいどーおってことぁないですよ、\nよっ……と」":59,"結局、敷かれた布団一式にそのまま、\nつまり掛け布団の上にぐったりと横になる。":60,"諦めというか、\n言うとおりにしないと話が進展しそうになかったし、\nスルーすればいいじゃないの、という至極簡単な手は\n空腹によって空転してた脳では思いつかなかったようだ。":61,"決して一緒に寝たかった照れ隠しでは断じてない。[l]\n断じて！":62,"「でっ、なんでしたっけ、\n大神？[l]\nああぁー、雪鳴氏。":63,"そう言えば丁度、\nかれおから連絡がここのところ立て続けに入ってまして。[l]\nその彼氏さんの事で色々と相談事などを。":64,"喧嘩とかじゃないですよ？[l]\n今後の展望についてとかですね……」":65,"「":66,"余":67,"所の":68,"惚":69,"気話にゃあ興味ないっすなあー……」":70,"「んむ！[l]\nそれは自分のなら興味あるって事ですね？」":71,"「まあそりゃあねえ……[l]\n":72,"他":73,"人のよりはね……[l]\nで、彼奴、昔から変なモノが視える体質なんで……[l]\n相談しようと」":74,"「あー、まこくんまだ調子が変なのですね。[l]\n点滴程度じゃぁ、……んむ？[l]\nへぇ……雪鳴氏ってそういうヒト」":75,"「言ってませんでしたっけ？":76,"何か、\n極度に疲労すると抑えが効かなくなるとか言って、\n真っ昼間からもじゃもじゃした塊が浮かんでるの視たとか、\n言ってきた事ありますよ……":77,"勿論僕にはさっぱり、だったんですが……[l]\nもし最近視える色々が……[l]\n同じような症状なら……参考になるかもと……」":78,"「なるー。[l]\nお、良い具合に脱力して来ましたね？[l]\n良き哉良き哉♪」":79,"空腹で横になったら脱力もしまさあな……[l]\n会話の方向も定まらずになってるし。":80,"と、宮さんは部屋の電気を消して、\n僕の横にぼふっ、と寝転がった、らしい。":81,"らしい、と言うのは暗くなったからとかじゃなく、\n既に僕の眼は閉じていた故で、\nこれはこのまま下手したら本気で寝てしまうかも知れぬ……":82,"――今日はだからツかれてるんだっての。":83,"「さぁ～て電気消しましたっと……[l]\nで、":84,"先":85,"刻の話、\nまこくんは彼女さんつくんないの？」":86,"「彼女ねぇ……[l]\n欲しいですねぇ……[l]\nいいひといればねぇ……」":87,"「んむー、心籠もってないなぁっ。[l]\n――まあ、まこくんに彼女……[l]\nもしそうなったらちょと残念といいますか、":88,"まこくんにはこう、\n今のポジションで居て欲しいっていうか？[l]\nみんなのものであって欲しいっていうか？[l]\n曖昧なままにしておきたぁいっていうか？」":89,"この状況でその質問で、\n尚かつ自問自答というか自作自演……は何か違うな、[l]\nいやその、\n貴女は一体全体何をなさりたいのでしょうカ。":90,"「そんな事言われましてもね、\nだって宮さんが責任とってくれるわけでもないんでしょう、\n無責任発言なら止してください」":91,"「んむ？[l]\nまあ、うひひひひひ」":92,"――否定はせんのね……[l]\n……や、まあそりゃ、[l]\nべ、別にいいんだけど……":93,"「解ってくれればいいんです。[l]\nじゃー性懲りもないこんな思わせぶりな行為の方も、\nそろそろご遠慮して頂きたいのですが……」":94,"「えぇー？！[l]\nだってこれは宮の":95,"愉しみですからー。[l]\n別に":96,"邪な意図なんかないですもんー」":97,"「世はこういうのを異性不純交遊と見なすんですよ……[l]\nもし僕が彼女持ちの男子だったらですな、\nこんな有様彼女さんに視られた日には……」":98,"「んむー、\nまこくん真面目小学生ですか。":99,"この程度のじゃれ合いで":100,"逆":101,"上せてたら、\n女子にいいように使われますよ。[l]\n前も言いましたけど」":102,"逆上せてるかどうかは別として、\n女子にいいように使われる男子としては":103,"疾うの昔に\nその座を獲得してますがな。":104,"「女子にとってこの程度は、\n嫌いじゃない相手なら友人レヴェルの距離感ですよ？[l]\nん、まあ、個人差はあるでしょうけど……」":105,"「いや、一緒に……文字通りの意味ですがね、[l]\n一緒に寝るのがＯＫなのは特殊な例だと思いますが……」":106,"如何に僕が保守的というか、アナクロ人間である事を差し引いても、\nそう思うけどなあ……":107,"「ふぅーん。[l]\nあ、\nもしかしてまこくん」":108,"「はい？」":109,"「じゃじゃじゃあ、\n宮が他の……男の人と仲良くしてたら、[l]\nジェラシー？」":110,"「べっつにー、\nどうともおもわんのでわないでしょーか。":111,"僕を弄る労力をそっちに割いてくれるなら願ったりですね、\n寧ろ！[l]\nあははははは」":112,"「んむーん。[l]\nあ、そうですか。[l]\nその乾いた笑いに免じてここは聞き流してあげます、うひひ♪」":113,"「……よう判りませんが、[l]\nそういう質問をなさるならば、\nえーとですね、":114,"明日また彼女等と\n『御デート』のお約束を取り付けたのですが……[l]\nどういう感想をお持ちになるんですかしら、宮さんは」":115,"「んむっ！？[l]\nななななんのはなしかなっ？？！！」":116,"「おっと……[l]\n五分では語り尽くせませんでね……[l]\n夕飯の後でゆっくり説明しますよ……」":117,"「ふむっ。[l]\n――ま、いいです。[l]\n宮も動揺してみせただけですもんねー今。[l]\nんっ…んふぅ……」":118,"へんな吐息をついて宮さんは、\n宮も眠くなってきましたー、と、むにゃった声で仰った。":119,"「いやいや、五分経ったら飯ですよ……[l]\n憶えてますからね幾ら僕だって。":120,"ああ、憶えてるといやぁ……[l]\nこんな僕ですが、\n子供の頃の記憶というか思い出が――」":121,"「んぁ、むぅんぬ？」":122,"おかしな体勢だったのか、\n変な声でリアクションする宮さん。[l]\nまあ、僕の寝顔が視たくてこんな事してるそうだから、\n最適なアングルでも探してるんだろう。":123,"僕は目を閉じたままで独り言の様に\n話し続ける。":124,"「何か薄ぼんやりですけど……[l]\nようやくこの辺りの情景も重なってきて……":125,"まあ、覚えのない風景も芋づる式に出てきた訳ですが、\nそれが何だったかまではまだ、":126,"明":127,"瞭してないですけど。":128,"でですね……[l]\n何故かその記憶の風景に、\nみ――。[l]\n……いや、そのなんでも、ないです……」":129,"「まこくん――」":130,"「………？」":131,"おや？[l]\n目を瞑っていても明暗の変化くらいは判る。":132,"衣擦れの音だってするし、\nこの距離で隣に寝てるひとが動けば判らない方が\nおかしい――":133,"「………！？」":134,"多分、":135,"今、眼前に顔がある。":136,"眼は、開けられな、い。":137,"「ん」":138,"首に指が触れた――":139,"「――ろそろか」":140,"吐息がものすごい近くに――":141,"なのに、聴き取れなかった。":142,"今なんて言った？":143,"「まこくんは、いま、楽しい？」":144,"「え、は？[l]\nなにがです？」":145,"宮さんの指が、そして身体が離れていった。[l]\nどうやら身を起こしたらしく上方から聞こえる声を確認して、\n僕は目を開いた。":146,"向こうを向いてるので顔は視えない。[l]\n部屋も暗いままだし。[l]\n――と、呟きが耳に届いた。":147,"「宮は":148,"俄":149,"然、\n":150,"愉しくなってきたよ」":151,"宮さん？":152,"何だか、雰囲気が――":153,"「はぁい五分でぇーーす。[l]\nお時間参りましたぁーと、んしょ…っ」":154,"電気が点いたのが判ったので眼を開けた、が。":155,"「じゃ、そろそろご飯にしますか。[l]\n今日は疲れたでしょうし、\n精のつくもの用意させてますから。[l]\n明日も色々ある訳でしょ？」":156,"うひひ、とほくそ笑んでこっちを向いた宮さんは、\nやはりいつも通りの宮さんだった。":157,"まあ、雰囲気違うったって、\nキャラの違う事してはいけない決まりがあるでもないし、\n人は少なからず複数の顔を持ってるのだから別に良いのだが……":158,"チノ嬢はそう言う意味では自分のキャラを遵守してるって事に\nなるんだろうな。[l]\nあの時言ってた事が今判った気がします。":159,"判ったところでどうにもならんけど。[l]\nただ、\n今の宮さんから感じた違和感は――":160,"「んむー、\n":161,"ほらほら早く起きなさぁい！[l]\n宮もお腹すいたですからっ！」":162,"「えええ……[l]\nそのように責められましても、\n当方としましては何かこう腑に落ちませんが……」":163,"かなり自己中な意見を述べられながら地団駄を踏む宮さんに加え、\nもう空腹空転脳が相まって、\n抵抗する余力も無かった僕は":164,"鈍":165,"々と立ち上がった。":166,"と、いうか、そもそも夕飯食べにですね、\nいたところをあなたにですね。":167,"「何がしたかったのかは":168,"私如きには到底\n及びもつきませんが、\nこの度は":169,"目":170,"出":171,"度くリベンジもなされたようなので、\n大変にご機嫌うるわすう、いやさうるさしゅう、いやさ、」":172,"「ああもう言葉の用法から滑舌からぐだぐだですよ。[l]\n":173,"宮が悪かったですからもう行きましょう。":174,"そですね、\n昼間の詳しい報告はぁ、\n食事の後のお・風・呂、でゆーっくり聞くってことで\n":175,"けてーい♪」":176,"「いやっほうー、また宮さんと混浴だぁいー。[l]\nさー飯飯飯飯………」":177,"「んむぅまこくんってば何そのりあくしょん！」":178,"無意味なスキンシップはいつもの事だし、\n逆上しないように、とは宮さん自身が言った言葉にて、\nしかと肝に銘じましたので！":179,"「うひひ、\nそうですか、そういう態度しますか。[l]\nみてるがいいですよ。[l]\nうひひ」":180,"はいはい……":181,"「じゃー数時間後を楽しみにしてます、\nということで、行きますよ今度こそ夕飯に」":182,"「はぁーい♪\n宮もお腹ぺっこぺこのぺこりんぐ！」":183,"「なんすかその言い回しは……」":184,"駄目押しのぐったり要素を喰らい、\n僕は宮さんを伴って夕飯に向かったのだった。":185},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_023.ks","relPath":"/data/scenario/SC_M_023.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":186,"length":186,"percent":100},"cellInfo":[null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,[null,{"t":"HU"}],null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],null,[null,{"t":"HU","v":1}],null,null,null,null,null,null,null,null,null,[null,{"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU"}],null,null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"t":"HU"}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"t":"HU","v":1}],null,[null,{"v":1}],[null,{"t":"HU","v":1}],null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[185,1],"note":"完成"},"/data/scenario/SC_M_024.ks":{"data":[["夕飯は大層豪勢なご馳走だった……と言いたいところだが、[l]\n『精のつく』と言った場合は必ずしも量だの旨さだのとは\nイコールで繋がらない訳で、\n大層…ではあったが、至極身体に良さそうなものが並ぶ、[l]\n舟盛りだの肉満載だ何だのといったイメージとは、\n若干異なる夕飯であった。","晚餐本该是极其丰盛的料理……虽然想这么说，[l]\n但所谓『滋补』之物未必\n与分量或美味划等号，\n虽说确实丰盛…但摆满的都是些对身体极好的食材，[l]\n与想象中的船形拼盘或肉山盛宴\n略有出入。"],["決して不味くはないし、疲弊した肉体には染み入る料理の数々。[l]\n","绝非难吃，疲惫的身体反而被这些料理深深治愈。[l]\n"],["全き下戸であって、\n","作为彻头彻尾的酒精苦手，\n"],["未だ飲み慣れぬ酒も少々","面对尚未习惯的少量酒水"],["乍ら","仍"],["嗜みつつ\n大変宜しい感じの夕餉だったのだが、\n贅沢を言えば味が薄めだので少々物足りなさ感が残ったくらいか。","浅酌慢饮，\n本应是顿相当惬意的晚餐，\n硬要说的话就是味道偏淡稍欠满足感罢了。"],["まあ初日の知狡さんの『あれ』を思えば……[l]\nで、結局何だかんだと言いくるめられて、\n報告は本気で混浴しながらと言う事態になったとさ。","不过想到首日知狡阿姨的『那个』……[l]\n结果被各种花言巧语糊弄，\n最终演变成真要混浴时汇报的事态。"],["うーん、混浴も二日目以来か？[l]\nって、恋人夫婦じゃあるまいし、\n普通はそう何度も一緒に入らないんだろうが。","唔…上次混浴还是第二天来着？[l]\n话说又不是恋人夫妇，\n正常人不会这么频繁共浴吧。"],["しかして、今日は何故か屋内風呂であるらしい。[l]\n嵐の後だし露天はまだ入れないのかな。","然而今天不知为何似乎是室内浴池。[l]\n可能是暴风雨后露天浴场还不能使用吧。"],["で、連れてこられたこの風呂は。","然后，被带来的这个浴池。"],["こっちに来てから使ってた、従業員用らしい浴室とはまた更に別の、\n普通の家庭にあるようなユニットバスを少し……いや、[l]\n結構大きめにした内装だった。","和来这边后使用的、貌似是员工专用的浴室又完全不同，\n像是普通家庭那种整体浴室稍微……不，[l]\n应该说内部装修得相当宽敞。"],["浴槽もでかく、金持趣味じゃ無い限り、\n複数人同時入浴が前提の設計であることは間違いない。[l]\n脱衣場も変に広いしなあ。","浴缸也很大，只要不是土豪趣味的话，\n这设计毫无疑问是以多人同时入浴为前提的。[l]\n更衣室也莫名宽敞呢。"],["中央に間仕切りのようにロッカーが置かれていて、\n宮さんと僕はそれを挟んで着替え……というか脱衣準備。","中央像隔断般摆放着储物柜，\n宫小姐和我隔着它更衣……或者说做入浴准备。"],["ただ、あんまり使ってないからか、\n蛍光灯が古びてるらしく明かりが妙な具合だ。[l]\nにしても一体誰用の風呂なんだろ？","不过或许因为很少使用，\n荧光灯似乎老化导致光线有些诡异。[l]\n话说这浴池到底是给谁用的啊？"],["「大昔はこっちがお客用の温泉だったですよ。[l]\nまだ小さかった頃ですね。[l]\n位置的には半分地下みたいな感じです。","「很久以前这边是客人用的温泉哦。[l]\n还是规模很小的时候呢。[l]\n位置来说算是半地下结构。"],["旅館自体を大きくするときに、\n記念というか趣味というか、こういう時の為にと言うか？","在扩大旅馆整体规模时，\n该说是纪念还是兴趣，或者说是为了这种时候？"],["うひひ、\n壊さないで改装する形で残しておいたです」","呜嘻嘻，\n就用不拆除只改建的方式保留下来啦」"],["準備出来たらしく、\nロッカーの向こうから現れた宮さんは、\n例によって紺色の水着だったようだが、","似乎准备完毕了，\n从储物柜对面现身的宫小姐，\n照例穿着藏青色泳衣，"],["繁","但是"],["繁と視るわけにはいかないので\nなるべく視線を逸らせつ喋りつ、早々に浴室に入った。","不能明目张胆一直盯着看\n只好尽量移开视线边说话边快速进入浴室。"],["「へえ……[l]\nだから浴室いやにでかいんすか。","「嘿……[l]\n所以浴室才大得不正常啊。"],["湯船もなんかでかいし、\n照明も暗くて前元号時代みたいな空気ですけど。","浴缸也大得离谱，\n灯光又暗得像上个年代的气氛。"],["その所為か、ちょっと怖いですね……[l]\n音もすごい静かつーか、\n古い映画みたいで」","搞得有点毛骨悚然呢……[l]\n声音也静得出奇，\n简直像老电影」"],["何でそんな昔を知ってるかは訊かない約束であろう。[l]\nま、宮さんも本家の人づてに事情聞いたのかも知れないしな！","约好不问为什么她知道那么久远的事。[l]\n嘛，宫小姐可能也是从本家人口中听说的情况吧！"],["「露天はまだ使えないし、\nいつもの浴室じゃ二人でゆっくりできないですしね。[l]\n此処なら静かも静か、変な声出しても\n誰にも聞こえませんようひひ☆」","「露天浴场还不能用，\n平常的浴室也没法两人慢慢泡。[l]\n这里安静得过分，发出奇怪声音也\n不会被任何人听到哦呜嘻嘻☆」"],["「だれがなにゆえへんなこえを……」","「会有谁为了什么而发出奇怪声音啊……」"],["変な声は兎も角、\nえーと、こちらはと言えば、\n今日はその、ノーガードというか、\nタオル一枚巻きのみです。","奇怪声音先放一边，\n呃、至于我这边，\n今天该说是毫无防备还是什么，\n总之是只围着一条毛巾的状态。"],["朝から色々あったので、\n本来はゆっくり身体を休めたい訳で、\nそもそも風呂で報告とは急な話だったであるとか、","从早上就经历各种事，\n本来是想好好放松身体，\n突然变成要在浴池里汇报什么的，"],["宮さんが\n『疲れてるなら何も履かない方が！締め付け良くないです！』","包括宫小姐\n『要是累了最好什么都不穿！不会束缚身体！』"],["と強く勧めてきたとかそう言った諸々の、\n話の流れ的にそうなったと言うか、\n拒否する余力も無かったと言うか、","这样强烈建议之类的种种原因，\n该说是顺水推舟，\n或者说没力气拒绝，"],["酒が入ってどうでも良くなってたと言うか、\n別に疚しい事をする訳じゃないしと言うか、","又或是喝了酒就无所谓了，\n反正也不是要做亏心事，"],["今日はテンションがおかしいんだね。[l]\nそう、朝から色々あったから無理もないですがな。","今天情绪就是不太对劲啦。[l]\n是啊，从早上就经历那么多也难怪。"],["まあ如何に疚しい感情が無かろうと、\n流石に宮さんがバスタオル一枚って訳にはいかないので、\n向こう様には水着着て貰った。","不过就算没有愧疚感，\n毕竟不能让宫小姐也只围浴巾，\n就请她那边穿上泳衣了。"],["そこに関しては本人も渋ることなくあっさり提案は通ったので\n良かった良かった。","这点她倒是爽快同意没多纠结，\n太好了太好了。"],["「そ、そう言えば、その水着、\n前のとは違いますね？」","「对、对了，这件泳衣，\n和之前那件不同吧？」"],["ちらっと視た感じ初回のとは何かが違う。[l]\n色は同じに視えたけど……","乍看之下感觉和第一次的有些不同。[l]\n颜色看起来是一样的……"],["「んむ？[l]\n今日のはですねぇ、\nこれはいわゆる競泳用スク水。","「嗯唔？[l]\n今天这件呢，\n是所谓的竞技用死库水。"],["ほら、前のみたいにここに穴がないし、\n生地の質も違いますよ」","你看，不像之前那样这里有洞，\n布料质地也不同哦」"],["下腹部の布を","下腹部的布料"],["抓んだり引っ張ったりしてるらしく、\nぺしぺし音がする。[l]\nが、決してそちらは視ません！","似乎被又捏又拽地，\n发出啪嗒啪嗒的声音。[l]\n但、绝对不看那边！"],["「あぁーあ、\nなんか大神がスク水と言えば旧型以外認めねぇとかどうとか……[l]\n前の奴が旧型？」","「啊——\n说起来大神对学校泳装的看法好像是只认旧款什么的……[l]\n之前那件是旧款？」"],["「そうです。[l]\nまースク水のフォルムに関しては色々派閥もあるので……[l]\n宮は旧型かつ白のがお気に入りですけど」","「没错。[l]\n不过关于学校泳装的款式各流派众说纷纭……[l]\n宫偏爱旧款且白色的呢」"],["「白い奴なんかあるんですか？[l]\n僕のそちら系知識も、大神とか宮さんの所為で偏って来てますが、\nまあ深入りしないようにしますよ……」","「居然有白色的吗？[l]\n我这方面的知识也因为大神和宫小姐变得很偏门，\n还是别深入探究了……」"],["「うひひ、\n深入りしようったってそう簡単には入れないのがアチラ側の世界ですけどね」","「嘻嘻，\n想深入也没那么容易哦那边可是门槛很高的世界呢」"],["「難儀ですなあ……[l]\nではそろそろ今日の色々、報告致します……」","「真是难搞啊……[l]\n那么差不多该汇报今天的各种情况了……」"],["「はぁーい。","「好——"],["じゃ、\nお背中流しますから腰降ろしてください。[l]\n『ながら』で報告の方どうぞー」","那，\n现在要搓背请把腰放低。[l]\n可以边洗边汇报哦——」"],["ぽしゅぽしゅぽしゅ。","噗咻噗咻噗咻。"],["宮さんの手がスポンジを泡立たせる音が静かな浴室に響く。","宫小姐用海绵打起泡沫的声音在静谧的浴室里回响。"],["所","背"],["謂お風呂用の腰掛けに背中を向けて座ると、\n宮さんがうんしょと後ろにスタンバイする。","对着浴用凳子坐下后，\n宫小姐嘿咻一声在背后准备就绪。"],["蛇口を使う関係もあり壁面の鏡とは平行に並んだので、\nまあ僕の前面が視られる事はない。[l]\nそうでなくても、お湯は張ってあったので\n浴室は湯気でモヤってたし。","因为要使用水龙头所以和墙面的镜子平行排列，\n至少我的正面不会被看到。[l]\n就算没有这个，热水已经放好\n浴室里也雾气朦胧。"],["とりあえずは一安心である。[l]\nなにが一安心かは……[l]\nまあ、皆まで言わすな。","总之暂时放心了。[l]\n为什么要放心呢……[l]\n嘛，心照不宣啦。"],["「ええと背中の方はどうぞお構いなく、\n御無理のない程度でお願いします……」","「那个背部请不用太在意，\n量力而行就好……」"],["あの時以来、\nチョーカーは外すなと言われていたが、\n例外的に入浴時は外している。","自从那次之后，\n虽然被告知不能摘下项圈，\n但洗澡时例外可以取下。"],["それ以外は寝るときも駄目だとさ。[l]\nお守りってのはそういう物だと……まあ、そうかなあ。","其他时候连睡觉都不行。[l]\n护身符这种东西就是这样吧……嗯，大概吧。"],["縁起物ってのは故に縁起物なのであって、\nただ、最近首が熱くなるのはこれの所為な気もするけど……[l]\n皮膚に接触物があると局地的に意識が向くからなあ。","吉祥物之所以是吉祥物正因为其寓意，\n不过最近脖子发热总觉得是这东西的缘故……[l]\n皮肤接触物品会让人特别在意那块区域嘛。"],["何か格別良い素材なのか、ずっと身につけてる割には\nいやに無臭を保ってるので困りはしないが。[l]\nや、とは言っても外した時には除菌消臭処理してますよ？","不知是什么特殊材质，长期佩戴\n却毫无异味倒是不错。[l]\n啊、不过取下时都会做除菌消臭处理哦？」"],["「ああ、\n大変に好い感じです……[l]\nありがとうございます」","「啊，\n非常舒服……[l]\n谢谢您」"],["宮さんの擦りテクニックは、\n今日疲弊しまくった僕には、先の料理のように心地良い。[l]\nここのところ怒濤の連続イベントでしんどかったし、\nしばしこの快楽に身を委ねても罰は当たるまい。","宫小姐的搓洗技巧，\n对今天精疲力尽的我而言，就像先前的料理般令人愉悦。[l]\n最近连续高强度活动累坏了，\n暂时沉溺于这份快乐应该不会遭报应。"],["……何か誤解を招きそうな表現だな。","……这种说法容易引起误会啊。"],["おかしな方向へと思考が空転しないよう、\n邪念を振り払おうと、ふと目の前の壁を視る。","为了防止思维往奇怪方向暴走，\n我甩开杂念突然看向面前的墙壁。"],["鏡のある壁と垂直な位置関係となる眼前の壁には、\n大きな窓があるのだった。","与镜面墙垂直的眼前墙壁上，\n原来有扇大窗户。"],["昔は外が望めたらしい大きな窓からは、\nこれまたかつては吹き抜けの中庭だったらしい空間が視える。","从那扇据说曾经能望见外面的大窗户看出去，\n还能看到过去似乎是挑高中庭的空间。"],["今は物置みたいに、何かでかい桶みたいなもの等々が積んである。[l]\n只でさえ暗い照明なので、無灯のそっち側は混沌としていて、\n更に前時代的不安感を煽る不気味な","如今那里堆满像是储物间里的大木桶之类的东西。[l]\n本就昏暗的照明下，没有灯光的另一侧混沌不清，\n更散发着煽动前时代不安感的"],["佇まいだった。","诡异氛围。"],["そんな僕の視線を察したのか、","或许是察觉到了我的视线，"],["「昔はよくこの窓にカエルが張り付いてたりしてですね……」","「以前经常有青蛙趴在这扇窗户上呢……」"],["と宮さんが言った。","宫小姐这么说道。"],["だから何で知ってるんです、と言わせたいんかい。","所以为啥会知道这种事啊，故意让我吐槽是吧。"],["「明かりに惹かれて超でけえ蛾が来たりですかね……」","「说不定还会有被灯光吸引来的超大飞蛾呢……」"],["取り敢えず迎合しつつスルーしました。","我暂且迎合着糊弄过去了。"],["「来ますねーでっかい蛾。[l]\n","「会来哦——超大的蛾子。[l]\n"],["樟","像是樟"],["蚕みたいなの。[l]\nこれが西部だと","蚕那种的。[l]\n这要是在西部的话"],["守","壁"],["宮がまたそこらじゅうに出るですよ。[l]\n","虎又会到处乱窜了呢。[l]\n"],["蝙","还有蝙"],["蝠とか」","蝠什么的」"],["「西部は旅行で数回泊まりがけしましたけど、\nそんな山奥行ったことないですからねえ。[l]\n……宮さん西部にも詳しいんですか？」","「西部倒是旅行时住过几次，\n但那么深的山里可没去过呢。[l]\n……宫小姐对西部也很熟吗？」"],["「んむっ、別に山奥じゃなくて、街中の塀にいますよ、守宮。[l]\n詳しいと言いますか、西部に関してはかれおというソースがありますので」","「嗯唔、不是深山啦，是在城镇的墙上的守宫。[l]\n说熟悉嘛，关于西部我有卡蕾欧这个情报源呢」"],["「ソース？お好みの？[l]\nあ、情報の出所という意味で。[l]\n西國の話だしややこしいったらないですな……」","「酱料？您喜欢的？[l]\n啊、是指信息来源的意思。（译注：酱料的英文sauce，来源的英文source，发音相似）[l]\n西国的事情真是复杂得要命啊……」"],["そうか、かれお嬢、西部出身て言ってたっけ。[l]\n喋りがああだから全然印象ないけど……","对哦，卡蕾欧小姐说过是西部出身来着。[l]\n但说话方式完全让人没印象呢……"],["「さて、\nではそろそろ、\n真面目な話しましょうか」","「好了，\n那么差不多，\n该谈正事了吧」"],["発汗でアルコールも多少飛んだのか、\nやや","或许是出汗挥发掉部分酒精，\n将渐渐"],["明","清"],["瞭してきた意識を集中して僕は、\n宮さんに説明を始めた。","醒过来的意识集中起来，\n我开始向宫小姐说明。"],["「午前中の例のあの式ですが、\nまず入るなり――」","「关于上午那个仪式，\n首先一进去就――」"],["見破られた。[l]\n隣にいた謎の眼鏡女子は、\n自分も不法侵入者である事を告白し、\n同類の","被识破了。[l]\n身旁那个神秘的眼镜女孩，\n坦白了自己也是非法入侵者，\n似乎是出于"],["誼で僕を見逃してくれたらしいが……","同类的情谊才放我一马……"],["「なるほど……[l]\n不思議ですねー」","「原来如此……[l]\n真是不可思议呢—」"],["「ええ、\nやけにニッコニコしてたというか、\nもしほんとに部外者なら、\n場慣れしてたというか肝が据わってたというか。","「是啊，\n该说是笑得异常灿烂呢，\n如果真是外来者的话，\n倒像是老江湖般镇定自若。"],["途中は鼻歌まじりでしたし、\nやっぱり何度も潜入してるかもですね。[l]\n僕らと同じように三春の御神体とか祭とかの秘密を探ってるんでしょうか」","中途还哼起了小曲，\n果然可能已经潜入很多次了吧。[l]\n会不会和我们一样在调查三春的御神体或祭祀的秘密呢」"],["「手引きしてくれた子とは関連性なかたですか？」","「和给你带路的孩子有关联吗？」"],["「……うーーん、[l]\n狩屋、とですよね？","「……嗯——[l]\n是说狩屋，对吧？"],["………。[l]\n………。[l]\nああ、そう言えば僕がそこから出る時、\n狩屋に手を振ってた――ように視えました。","………。[l]\n………。[l]\n啊对了，我从那里出来时，\n好像看见――她在向狩屋在挥手。"],["ただ彼奴は気付いてませんでしたからそこはなんとも……[l]\nあとは、そうですね……[l]\n今にして思えば何か言葉のイントネーションが不自然というか、\n若干","只是那家伙没注意到所以也谈不上……[l]\n还有就是，嗯……[l]\n现在回想起来总觉得说话语调有点不自然，\n稍微"],["態とらしい感じが――した、ようなしないような」","刻意装模作样的感觉――说有也有，说没有也没有」"],["「なるる。[l]\nお互い詮索無用ということで、何かされた訳では無いんですね？[l]\n何となく諒解しました。","「原来如此。[l]\n既然双方都无需深究，那您并没有遭遇什么特别的事吧？[l]\n我大概明白了。"],["んむ――\nん、取り敢えずその眼鏡さんは後程にしましょう。[l]\nどぞ、続けてください」","嗯唔――\n嗯，总之那位眼镜小姐的事稍后再说吧。[l]\n请、请继续」"],["背中を向けてるので宮さんの表情は伺えないが、\n兎に角報告を続ける。","因为背对着所以看不见宫小姐的表情，\n总之先继续报告。"],["「で、前言った喋る猫……喋るのは妄想かもですが……","「关于之前提到的会说话的猫……会说话可能是妄想……"],["そいつかどうかは当然判らなかったんで、\n関係あるかどうかはアレですけど、\n猫を抱いた黒ずくめの――\nえーと初日に冬夏が着てたような奴ですね。","当然无法确认是不是那家伙，\n虽然不确定是否有关联，\n但有个抱着猫的全黑打扮的――\n呃就是第一天冬夏穿的那种衣服。"],["鍔の広い帽子も被ってて。[l]\nそういう人影が会場に、\n………[l]\n――あれ？」","还戴着宽檐帽。[l]\n这样的人影出现在会场，\n………[l]\n――咦？」"],["「んむ？」","「嗯唔？」"],["「え、ええと、\nあの暗い場内で何故そう認識出来たのか解らないんですが、\nうーん、何でですかね？","「啊，那个，\n明明会场那么暗不知道为什么能认出来，\n唔，到底是为什么呢？"],["と、兎に角その会場に居た、と『判りました』。[l]\n猫を抱いた黒ずくめの人物が」","总、总之那个人确实在会场，而且『知道了』。[l]\n是个抱着猫的全黑打扮的人」"],["「『判りました』？」","「『知道了』？」"],["「ん、んー……[l]\n改めて追求されると根拠は弱いですねえ……[l]\nおっかしいな、何でそう『判った』んだ？」","「嗯，嗯――……[l]\n被追问的话确实依据薄弱呢……[l]\n好奇怪，为什么当时会『知道』呢？」"],["「思ったではなくて判ったですか？」","「不是觉得而是知道吗？」"],["「え？[l]\n今僕そう言いました？」","「诶？[l]\n我刚才这么说了吗？」"],["「ん、\nいえ。[l]\n大丈夫です。","「嗯，\n没事。[l]\n没关系。"],["まこくんのことは信じてますよ！[l]\nどうぞ続けてください？」","我相信小真哦！[l]\n请继续说吧？」"],["「はあ、\nまあこの件に関しては、\n今言ったように根拠は薄弱でして……","「哈啊，\n关于这件事，\n就像刚才说的依据很薄弱……"],["何で気になったのかと言われれば、\n喋る猫自体が幻視であるかも知れないという\n心許ない根拠ではありますが、","硬要说为什么在意的话，\n虽然会说话的猫本身可能是幻觉\n这种理由不太可靠，"],["宮さんは近づかない方が善いと言ってましたし、\n何か心に引っ掛かってた、という感じですかね……」","但宫小姐说过最好不要靠近，\n大概就是心里莫名在意吧……」"],["「なるー……[l]\n向こうからは気付かれなかったんですね？[l]\n式に夢中だったか……それとも」","「这样啊――……[l]\n对方没发现你吗？[l]\n是沉迷仪式还是……」"],["「はい？[l]\nえ、まあ、多分ですが。","「啊？[l]\n呃，大概没有吧。"],["入場時に若干目を引いたかもですが、\nその後特に、接触があったりした訳では無いです」","入场时可能稍微引起了注意，\n但之后并没有特别接触」"],["「で、\n一匹野良が紛れ込んで来たとかじゃなく、\n誰かに抱かれてた訳ですね？[l]\nその……猫は」","「那么，\n不是野猫混进来，\n而是被人抱着的对吧？[l]\n那只……猫」"],["「ええと、僕の見立てが本当なら、ですが……[l]\n何か引っ掛かります？」","「呃，如果我的判断没错的话……[l]\n有什么问题吗？」"],["「なるる。[l]\nなるるです。","「原来如此。[l]\n原来如此。"],["いえ、玄ノ森には猫が多いので。[l]\nどっちだろう、と思っただけです。[l]\nこないだまこくんが視たのは、人に呼ばれてどっかに行ったんですよね？」","不，因为玄之森猫很多。[l]\n只是在想是哪边的猫。[l]\n上次小真看到的猫，是被谁叫走了对吧？」"],["「そうですね。[l]\nあ、飼い猫だってことですか？","「是的。[l]\n啊，是说那是家猫吗？"],["まあ呼んでたのは子供の声だったようですから\n何とも言えませんけど。[l]\n子供はそういうの何にでも声かけそうですしねえ」","不过听起来像是小孩子的声音\n所以也不好说什么。[l]\n小孩子就是会对什么都搭话嘛」"],["「色と顔が判ればなぁ……」","「要是知道颜色和长相就好了啊……」"],["「はい？[l]\n済みません聞こえませんでした」","「啊？[l]\n抱歉我没听清」"],["「んむ？[l]\n何にも言ってないですよ？」","「嗯？[l]\n我什么都没说哦？」"],["あれ？[l]\nおかしいな。","咦？[l]\n好奇怪。"],["「既に候…は限…なく…まってる…ら……[l]\n…ぼ確…だ……」","「候…乎…已…定…了……[l]\n…本确…定……」"],["「え？」","「诶？」"],["「………」","「………」"],["「どしたの？」","「怎么了？」"],["「何か言いませんでした？」","「你刚才有说什么吗？」"],["「言ってないですよぉー。[l]\nやだまこくん、\n幻聴ぶり返し？[l]\nそれとも季節外れの……」","「我可没说过哟～[l]\n讨厌啦小真、\n幻听又犯了吗？[l]\n还是说季节错乱了呢……」"],["「ややややめてくださいよ。[l]\nどっちもやですよ」","「哇呀呀呀快住手啦。[l]\n两种都讨厌啦」"],["「うひひ、\n怖がりですなぁー。[l]\nま、こないだ喋る猫に近づくなと言ったですが、\n玄ノ森はほら、知狡も言いましたけど猫が大事にされてますから」","「呜嘻嘻、\n真是胆小呢～[l]\n嘛、虽然前几天提醒过你别靠近会说话的猫、\n但玄之森那边啊，知狡也说过猫咪们很受重视呢」"],["「から？」","「所以呢？」"],["「『月狂跳』にそういう内容のもあるですね。[l]\n人語を解する猫の……禁忌？」","「《月狂跳》里也有类似桥段吧。[l]\n通晓人语的猫……禁忌？」"],["「うえあっ。[l]\n怖い系の伝承すか」","「呜哇啊。[l]\n这是恐怖系的传说吗」"],["蠱物としての伝承が世界的にあるし、\nこの國じゃ特にそう言う面が色濃くあると思うが、\n玄ノ森がそういう風潮の強い地域とは――記憶にないなあ。[l]\n僕の場合はそれがまた当てにならないんだが。","虽然世界各地都有蛊物相关的传说、\n这个国家尤其充斥着这类元素、\n但玄之森是那种风俗盛行的地方吗――完全没印象啊。[l]\n不过我的记忆本来就不靠谱就是了。"],["「書蔵守の頃の伝承にしろ、\n","「无论是书藏守时代的传说也好、\n"],["件の祭や秘儀御神体にしろ、\nまあ今日の式にしろですね、\nこの町では猫に関する禁忌は","无论是那场祭祀还是秘仪的神体，\n或者说今天的仪式也是，\n在这座小镇关于猫的禁忌"],["其","无"],["処","处"],["彼","不"],["処に」","在」"],["え？[l]\nあの式も、か？[l]\n猫絡みなのか？","诶？[l]\n那个仪式也是吗？[l]\n和猫有关联？"],["それよりそんな事まで宮さん何故……","比起那个 为什么连这种事宫小姐都……"],["「あれ、そうか、知ってるんでしたっけ。[l]\n母さんも知狡さんも体験してるって……","「啊咧 对了 您原来知道啊。[l]\n妈妈和知狡阿姨都亲身经历过……"],["そういやあの変な言語にも、解読すると呪われるとかいう","说起来那种奇怪语言也是 据说解读就会遭诅咒"],["謂れがあるとか言ってた……[l]\nでもあれのどこに猫関係の要素が」","好像有什么渊源来着……[l]\n但那里面哪里有和猫相关的要素」"],["「感得した者にとって、\nそれは不自然ではないのですが、\n……説明は難しいと言いますか不能と言いますか」","「对于感知到的人而言，\n那并非不自然之事，\n……该说是难以解释还是无法解释呢」"],["「あの言語がみゃんみゃん言ってて猫っぽい、てのは解りますけど。","「虽然能理解那种语言喵喵叫很像猫啦。"],["音に対する印象であって、意味に関しては理解は勿論、\n感想すらマトモに思いつかないですよ。[l]\nその、言葉もそうですがね、あの式は一体なんだっていうんです？」","那只是对声音的印象 至于含义别说理解，\n连正经感想都憋不出来。[l]\n那个 语言先放一边 那个仪式到底是什么来头？」"],["それを知る事が僕自身の\n――飯窪家や宮さんは知ってるようなので――\n目的の一つの筈だった訳だが、\nここに来て完全に匙を投げました。","知晓那件事本应是我\n――既然饭洼家和宫小姐似乎知情――\n的目标之一才对，\n但来到这里后我彻底放弃了。"],["「結局は、ですから感得した事があの式の全てです」","「说到底，我所感知到的就是那个仪式的全部了」"],["えあっ。","呃啊。"],["「それは大悟とか","「那难道是‘大彻大悟‘"],["頓","‘顿"],["悟とか禅の話みたいなですか？[l]\n","悟‘之类的禅学话题吗？[l]\n"],["不 ","不 "],["立 ","立 "],["文","文"],["字？以心伝心とかの？」","字？以心传心之类的吗？」"],["「んむ－、\n要するに、言わなくてもわかるでしょ？[l]\nという、『感覚を共有できる事自体』が大事なのです。","「嗯唔－、\n简而言之，就算不说也能明白吧？[l]\n这种『能够共享感觉的事实本身』才是最重要的。"],["ヒト以外の事はここでは横に置いておきますよ。[l]\n言葉というのはそれこそ文化圏それぞれで異なる訳で、\nコミュニケーションの手段としては極めて曖昧なのです。","非人类的事情暂且搁置不谈。[l]\n语言这东西本就因文化圈不同而产生差异，\n作为沟通手段是极其暧昧的。"],["この國は島國だから気付きにくいですが、\n多言語間で解釈の差違が増幅されることは度々あるでしょう？","这个国家是岛国所以不易察觉，\n但在多语言间解读差异被放大的情况很常见吧？"],["翻訳ソフトって知ってます？[l]\nバラエティでネタになるくらい誤訳…というか、[l]\n直訳しただけだとしても意味は相当に変わってしまいます。","知道翻译软件吗？[l]\n在综艺节目里常被当成段子的误译…或者说，[l]\n即使只是直译意思也会大不相同。"],["意訳にしたって訳者の趣味嗜好ですからね、\nどんなに性能が上がっても、完全に正確な変換はまあ、\nほぼ無理ですよね」","意译又受译者主观偏好影响，\n就算性能再提升，完全准确的转换嘛，\n基本不可能啦」"],["そして、と、いつになく饒舌な宮さんは続ける。[l]\n背中を擦るのもずっと続けておられます。","接着，与平时不同滔滔不绝的宫小姐继续说着。[l]\n搓背的动作也一直没停。"],["大丈夫かな……[l]\n僕の背中も含め。","不要紧吧……[l]\n包括我的背。"],["「これが仮に同言語圏なら通じ合えるか、と言うと、\nこれまた無理ですね。","「假设在同语言圈就能相互理解吗？这么说来，\n果然还是不行呢。"],["読解力の問題もありますが、結局の所言語自体が\nヒトが創ったルールですから、\nあくまで約束事、記号である言語というシステムでは\n伝達は難しいですよ。","虽然有阅读理解能力的问题，但终究语言本身\n是人类创造的规则，\n在作为约定俗成的符号体系的语言里，\n传达是很困难的。"],["チノとはよく話してますが、\nデジタルかアナログという比喩を使うんですけど。[l]\n例えばＣＤとレコードというですね……」","经常和千乃聊天，\n会用数字或模拟来打比方。[l]\n比如说CD和黑胶唱片之类的……」"],["何か熱が籠もってきたなあ。[l]\n擦る力も心なしか強く……","好像越说越激动了啊。[l]\n搓背的力道也不知不觉加重……"],["「文字言語を図像とみなすならば、\nんっ、\n意味としては一緒なのかもしれませんが、\nんむっ、","「若将文字语言视为图像的话，\n嗯、\n在意义上或许是相同的，\n嗯唔、"],["やはり言語というのは聴き手各自の解釈が違うくせに、\nんんっ、","但语言明明会因听者各自解读不同，\n嗯嗯、"],["連想されうる規定された意味というものがあるために\n非常に誤解しやすい、\nむぅ、","又存在可被联想的既定含义，\n所以极易产生误解，\n唔、"],["で、幅のある解釈の中でどれを選択するのか、」","于是，在宽泛的解读中该选择哪个呢，」"],["もう何言ってるかようわからないし、\n宮さん自身も解ってないんじゃ……[l]\n既に文章的に破綻……かどうかもあやふやだが。[l]\nチノ嬢の話みたいになってきた……","已经听不懂在说什么了，\n宫小姐自己也没搞明白吧……[l]\n连语句本身是否已经支离破碎…都说不清了。[l]\n变得像千乃小姐的说话了……"],["お、\n手が止まった。[l]\n疲れたか……","啊、\n手停了。[l]\n累了吗……"],["というかずっと僕ばっかりして貰ってて良いんだろうか。[l]\nと思うも束の間、\n宮さんの話はまだ続くらしい。[l]\n再び背中を擦る音と共に、宮さんは一呼吸置いて話し出した。","话说一直只给我搓真的好吗。[l]\n刚这么想着，\n宫小姐似乎还要继续讲。[l]\n随着搓背声再度响起，宫小姐深吸一口气说道："],["「なので、言語以外のモノで伝える、或いは理解できる事が、\n重要視されるのです。[l]\n文化圏間の差違をも超越する、根源的な理解です。","「因此，用语言以外的事物传达或理解，\n才更被重视。[l]\n这是能超越文化圈差异的根源性理解。"],["この場合は誤解というよりは見解の相違として、\n本意と違う場合は拒否されるだけです。","这种情况下与其说是误解，不如说是见解分歧，\n当与初衷不符时只需拒绝接受。"],["……うーん、[l]\nやっぱり説明が難しいですね。[l]\n矛盾してるように聞こえてしまうでしょ？[l]\nそもそも言葉で伝えようとする行為自体が矛盾してるですけど……」","……唔嗯、[l]\n果然很难说明白呢。[l]\n听起来很矛盾对吧？[l]\n本来想用语言传达的行为本身就自相矛盾啦……」"],["「いや、\nお話になってる内容をですね、\n論理的に解析するにはあまりにリアルタイムというか、","「不、\n您正在谈论的内容呢、\n要逻辑性解析的话实在太实时或者说、"],["それこそ文字で書いてあるのを読めば\nそう思えるかも知れないですが、\nこうやって聞いてるだけでは……","那还不如直接阅读文字记载\n或许还能产生这种想法、\n光是这样听着的话……"],["まあ僕もですね、\n宮さんの言ってること、\n何となく解ってるとは思うんですが」","嘛我也是呢、\n宫小姐说的话、\n总觉得似乎能明白又不太明白」"],["感覚的に、と言うならば、だが。[l]\nこの話題の流れ的に、幸い言葉でレスする必要はないようだから、\n主観的にそう感じているという意味で嘘は言ってない。[l]\nただ、正解かどうかは別だけど。","说是凭感觉的话、倒也没错。[l]\n从这个话题走向来看、幸好不需要用语言回应、\n从主观感受来说倒也不算撒谎。[l]\n只不过、是否正确就另当别论了。"],["「んむ、\nそれこそ解ったか解らないかを言葉で証明することは不可能ですが、\nそこはそれ、行動で示す、という証明が求められる訳ですね。","「嗯唔、\n正如您所说用语言证明是否理解是不可能的、\n所以才会要求通过行动来证明呢。"],["依頼主が望む仕事をするとか、\n所謂芸術系創作系の職種だと分かり易いですかね」","完成委托人期望的工作啊、\n或者说是艺术创作类职业会更容易理解吧」"],["……つまり大神とかだな。[l]\n商業仕事じゃないと思うけど、\n何かいっつもイベントで本だの創って売るとかどうとか。","……也就是说像大神那样吧。[l]\n虽然不算是商业工作、\n但总在各种活动上出书贩卖什么的。"],["「腹芸が通じるとか空気読めるとかもそう。[l]\n察するとか」","「心领神会或是读懂气氛也是同理。[l]\n所谓察言观色」"],["察する……","察言观色……"],["最近矢鱈とそれが出来る方々と出逢うんですが。","最近倒是经常遇到特别擅长这个的人呢。"],["「絵とか文字……つまり視覚的な要素の解釈が[l]\n最も分かり易く資質を判断出来るツールであるのかも知れませんねぇ。[l]\n玄ノ森で三春家と飯窪家が書を集めて来たのも、\nもしかするともしかする、かもですね。","「绘画或文字……也就是视觉元素的解读[l]\n或许才是最直观判断资质的工具吧。[l]\n玄之森的三春家和饭洼家收集典籍、\n说不定说不定、正是如此呢。"],["月狂跳は資料群ですから絵とか図も含まれますし、\n寧ろ文字情報が全く無くてそこから意味を\n汲まなければならないものも\n中にはありますですよ。","月狂跳的资料集也包含图画图表、\n甚至有些完全不含文字信息\n必须自行揣摩含义的\n内容也存在哦。"],["今日の式に関しては――\n先日言いました『歌は魔術の最たるもの』、\nという考え方の良い例かも。","关于今天的仪式――\n正如前几日所说『歌乃魔术之极致』、\n或许正是这种观念的绝佳例证。"],["音の方は視覚無しでも受容する事ができますしね。[l]\n所謂芸術と呼ばれる物は絵か音に関連する物が大半ですし、\nまあ言外にある何かしらを汲める資質、こそが」","声音无需视觉媒介就能被接受呢。[l]\n所谓艺术大多与绘画或声音相关、\n嘛说到底还是需要那种领会言外之意的资质呢」"],["そこまで言ってから、宮さんは手も口も動かすのを止めた。","说到这里、宫小姐突然停下了手和嘴的动作。"],["「？」","「？」"],["「………んっ、くふぅ、ぁん」","「………嗯呜、咳嗯、啊嗯」"],["「？？[l]\nど、どしました？」","「？？[l]\n怎、怎么了？」"],["「ぅえ゛くしゅ！！」","「呜噫啾！！」"],["「おわあ！！！！[l]\nっくりした！！！[l]\nだ、大丈夫ですか？」","「哇啊！！！！[l]\n吓死我了！！！[l]\n没、没事吧？」"],["く、","该、"],["嚔かい。[l]\nいきなり変な声だすから焦ったわ……[l]\nロケーションというかシチュエーションがあれなもんだから……[l]\n――いやいや、ホラー的と言う意味ですから！","不会是喷嚏吧。[l]\n突然发出怪声吓我一跳……[l]\n都怪这场景氛围太诡异了……[l]\n――啊不是、是说很有恐怖片效果啦！"],["「ふー、\nあ、ごめんです。","「呼――\n啊、抱歉。"],["何でしたっけ……[l]\n……、[l]\n……まあ、いいです。","刚才说到哪儿了……[l]\n……、[l]\n……算了、就这样吧。"],["結局のところはですね。[l]\n言わなきゃ判らないんでは、\n言ったところでやっぱり判らないのですよ。","归根结底呢。[l]\n不说出来就无法理解的事情、\n即使说出来也终究无法理解啊。"],["なので宮や知狡、まこくんママが感得した事、\nそれが真実あの式が伝えてる事と完全なるイコールかは別ですけどね、それを言葉で今説明することはできない、と言うのが結論です。","所以宫和知狡、小真妈妈感知到的事物、\n虽然不能断言与仪式传达的真相完全等同、但此刻确实无法用语言说明、这就是结论。"],["今まで喋ってきたような、\n限りなく近い喩え話は出来ますけど、\nそれこそ公案みたいになっちゃいますし、","虽然可以举出和至今为止所说的、\n无限接近的比喻、\n但那样反而会变得像公案一样晦涩、"],["ま、\nあの式に限らず、\n今回の諸々でまこくんが感得したもの、\n宮達と共有出来てると――信じてますよ」","嘛、\n不仅是那个仪式、\n这次各种事情中小真感受到的、\n我相信是和我们能够共享的――」"],["うーん。[l]\n何か煙に巻かれた気もするが……","唔嗯。[l]\n总觉得好像被糊弄过去了……"],["そもそもそれを毎年行う意図は――\nそれはまあ、宮さんの決めた事じゃないし、\n祭って大体よくわからない理由背景が由来や\n実行根拠だったりするしな。","说到底每年举行这个的意图是――\n那个啊，毕竟不是宫小姐决定的、\n祭祀大多都有搞不清来由的缘由背景、\n或是执行依据之类的啦。"],["ともあれ、\n言葉での説明は困難だ、という事を言葉で説明するのは非常に厄介、\nという事ですかなあ。","总之、\n用语言说明难以说明的事非常麻烦、\n就是这么回事吧。"],["「はあ、\nじゃ、なんで姫様ちゃんは僕にそれを……[l]\nあの式をみせようとしたんでしょう」","「哈啊、\n那，为什么姫様酱要对我……[l]\n想让我看那个仪式呢」"],["「三春が仕切って祭と併せて昔からやってるあれが、\n解る人間に伝えてるはずの解る何か、\nそれを、\nまこくんには解って貰えると思ったですかね」","「三春主办的和祭祀一起自古流传的那个、\n应该会传达给能理解之人某种可理解之物、\n那个、\n是觉得小真能理解才这么做的吧」"],["その根拠が全く解らないから唐突なんだけど……[l]\nそれこそ姫様ちゃんはその『根拠自体を』感得したとでもいうのだろうか。[l]\n彼女は特に発する言葉も少ないしなあ。","因为完全不明白依据才觉得突兀……[l]\n莫非姫様酱是感知到了那个『依据本身』吗。[l]\n她本来话就特别少呢。"],["「そう言う意味では双方に残念ですけど、\n中身に関しては、\n結局さっぱり解らなかったと言いますか、\nそれどころじゃない事が起きたと言いますか、","「从这个意义上说双方都很遗憾、\n关于内容、\n该说最终完全没搞明白、\n还是说发生了更离谱的事、"],["猫がらみの幻視とか幻聴とか、\n妙なものは最近やたらその、感得してるようなんで、\nいや、でも『あれ』は……」","猫相关的幻视啦幻听啦、\n最近莫名频繁感知到这类怪异、\n不，但『那个』是……」"],["「んむぅ。[l]\nまあまだ…全な……じゃ…いし、…図的に…避してるか……ね」","「嗯唔～[l]\n毕竟还…没完……全…吧，…意…回避着…呢」"],["「……やっぱり何か言ってません？」","「……果然没说什么吗？」"],["「えっ？[l]\n残念だなーって。[l]\nあ、兎に角例の猫、なるべく近寄らない方が――\n身の為です。うひひ」","「诶？[l]\n就是说好遗憾啊—。[l]\n啊、总之那只猫，尽量别靠近――\n为你好哦。呜嘻嘻」"],["「………まあ、[l]\nもう自分の五感に自信がなくなってますからね。","「………嘛、[l]\n反正已经对自己的五感没信心了。"],["言われるが儘に流されますよ。[l]\n伝承禁忌の類にも従いましょう。[l]\nそれよりも」","就照你说的做吧。[l]\n传承禁忌之类的也会遵守。[l]\n比起那些」"],["問題はその、\n『あれ』だ。","问题在于那个、\n『那个』啊。"],["最近頻繁に起こる幻視症状を併せ考えても、\nあのリアル体験はどうにも……","结合最近频繁出现的幻视症状、\n那个真实体验实在……」"],["一応、詳細に説明はしてみた。","姑且详细说明过了。"],["が、","但，"],["「まるで主観の話なんで信じて貰えるかどうか、\n最近はそれでなくても変な感じなんで、\nあれなあれであれなんですが」","「完全像主观感受所以不知能否被相信、\n最近就算没这些也觉得不对劲、\n就那个啦那个的」"],["「んんんんんん～～～\n――思ったより、」","「唔唔唔唔唔～～～\n――比想象的、」"],["「え、重症だと？」","「咦，很严重吗？」"],["「ん？[l]\nいや。[l]\nあいや、いえいえ。","「嗯？[l]\n不是。[l]\n啊不是，不对不对。"],["それは――…や…ぎるな、[l]\nいえ、んむ、うー、」","那个――…太…过了、[l]\n不，嗯唔，呜—、」"],["――宮達には及びもつかない体験ですね。","――是连宫她们都望尘莫及的体验呢。"],["と言った宮さんだが、\n様子が変だ。","虽然宫小姐这么说了、\n但样子很奇怪。"],["宮さんも怖くなったのかしらん。[l]\n何だかんだ言って、自分もそういう系の話は苦手だったか……","宫小姐是不是也开始害怕了呀。[l]\n说来说去，她自己其实也不擅长这类话题吧……"],["「まあ、\nそんなモノが実在するかどうかは別としてですね、\n体験自体はリアルだと思うわけですよ、\nそれで」","「那个，\n先不管这种东西是否真实存在，\n至少体验本身是很真实的，\n所以」"],["「ああ、それでかれおんの彼氏さんに」","「啊，所以卡蕾欧的男朋友就」"],["「そうです……って、[l]\n言いましたっけ彼奴の話？[l]\nどうも記憶があれなもんですから……","「没错……等等，[l]\n我有提过那家伙的事吗？[l]\n总觉得记忆有点混乱呢……"],["と、兎に角、大神は一応そういう『体質』らしいので、\n僕の症例と一緒かどうかは別として対処の心得みたいなものを\n聞いてみようかと……」","总之，大神好像确实有那种特殊『体质』，\n虽然不确定和我的症状是否相同，但我想请教些应对经验\n之类的……」"],["「んー、\n何かが視えたとしても、\nそれそのものから害を受けたわけではないのなら心配なくない？[l]\nなくなくない？","「嗯——\n就算真能看到什么，\n只要没受到实际伤害就不用担心吧？[l]\n不用担心吧？"],["まあ視えるだけならそういう症例も世界中にあるしぃ、\n体調がおかしいんだったら適度にお休みして貰いますけど、\n病院にも行きましたし、","单纯能看见的话这类案例全世界都有啦，\n要是身体不舒服就让他适当休息，\n医院也去过了，"],["うーん、特異体質が突如発現したのだとしたら、\nそれはまこくんの身体的個性として受け入れるしか\nないでしょうしねえー。","唔，如果说是突然觉醒的特殊体质，\n那也只能当作小真的身体特性\n来接受了吧——"],["その、かれおの彼氏さんみたいに。[l]\n生物という生物がみんな同じ受容器を持ち同じ視界を持ってる、\nと言う訳でもないですしね。","就像卡蕾欧的男朋友那样。[l]\n毕竟不是所有生物都拥有相同的感知器官和视野嘛。\n对吧。」"],["気にすることはないですよ、\n寧ろまこくんもそういう力に目覚めたと思えば\n良いんじゃないですか？[l]\nイカス！かっこいー！！主人公みたい！！いやっほう！！！」","不用太在意，\n不如想着小真也觉醒了这种能力\n不是更好吗？[l]\n超棒！超帅气！！像主角一样！！呜呼！！！」"],["「僕ぁこれでもそういう特権意識に浸るのはなるべく\n自粛するよう心掛けてるんですよ……[l]\n大体あの、あれやこれやが視えた所で何の利点が」","「我就算这样也尽量告诫自己\n不要沉溺于特权意识……[l]\n说到底就算能看见那些东西又有什么好处」"],["「んー？[l]\n人と違う視界を持つのは色々愉しいって、\nまこくんママから教育されてたんじゃないの？」","「咦——？[l]\n拥有与众不同视野很有趣啊，\n小真妈妈没这么教育过你吗？」"],["……いくら母さんと面識あるとは言え、[l]\nそんな事まで聞いてたのですか貴女は？[l]\n考えたくない事まで考えてしまいそうですよ。","……就算你认识我妈，[l]\n连这种事都知道吗？[l]\n我都要开始想些不该想的事了。"],["「それとこれでは次元が違う気もしますが……[l]\nまあ人は成長するものですし、後天的にスキルが増える事も\nあるんでしょうけど」","「而且这两件事性质不同吧……[l]\n不过人总会成长，后天获得新技能\n也是有可能的」"],["宮さんというか、飯窪本家がびっくり人間ばかり遣うものだから、\nそういう他人と違う能力とか資質に関して鷹揚になってるかも\n知れないが、","该说宫小姐还是饭洼本家呢，净是些让人吃惊的家伙，\n所以对异于常人的能力资质特别宽容\n也说不定，"],["当人にとっては流せるものでも……[l]\nあるのかなあ。[l]\n大神はどうなんだろう。","但当事人未必能轻易接受……[l]\n大概吧。[l]\n不知道大神怎么想。"],["「っていやその、視える件に関してはそうかもしれないですけど、\n金縛りの件がまだ、」","「呃、关于能看见这事或许是这样，\n但鬼压床的问题还——」"],["「そうそうまず判ったことが一つ、\n先刻の眼鏡女子ですっけ？[l]\nまこくんの隣りに居たのは三春家眷属のうち西部のトップ、\n――の家の者ですね」","「啊对了首先确认一点，\n刚才戴眼镜的女生是叫？[l]\n坐在小真旁边的是三春家眷属西部首席——\n的家族成员吧」"],["急に話が展開し、","话题突然跳跃，"],["「は、なんで判ったんです？」","「为、为什么知道这个？」"],["という問いには応えず、","对我的疑问置若罔闻，"],["「玉梓選律――か、んむう、\n多分そういう名前……と思うですが」","「玉梓选律――呃、嗯唔，\n大概是叫这个名字……应该」"],["と歯切れの悪い反応、というか独り言のようにごちた。[l]\n僕の話は中断、質問も華麗にスルーされたもよう。[l]\nこっちの声聞こえてないんかな？","支支吾吾的反应更像在自言自语。[l]\n我的叙述被打断，提问也被华丽无视。[l]\n该不会根本没听见我说话吧？"],["しかしこっちもそろそろ空転がとめどない。[l]\n話の腰を折り返す気力があるかと言えば、\nもう諾々と流されるのみ。","然而我这边也开始止不住地空转。[l]\n要说有没有打断话题的力气，\n现在只能随波逐流了。"],["「センリツせんりつ……[l]\nああ、狩屋がセンノジがどうとか言ってたのは…[l]\nその人、の事だったのかなぁそう言われると」","「选律senritsu……[l]\n啊，狩屋说的什么sen no ji...[l]\n指的就是那个人吧被你这么一说」"],["「んむ、\n今後三春関係者と接触多くなると思いますが、\n彼女も出来れば避けた方がいいです。[l]\n察しが――いい女と聞いてます」","「嗯唔、\n今后和三春相关人士接触会变多，\n但她最好能避开就避开。[l]\n直觉告诉我――是个厉害女人」"],["「そ、そうなんすか……[l]\nまあ、喋りもしてないのに見破られたし、\nそりゃ察しが良いんでしょうが……","「这、这样啊……[l]\n明明还没交谈就被看穿了，\n这直觉也太准了吧……"],["そうか、だから無部外者なのに中に……[l]\nいやつまり部外者じゃない、あーもうややこしいな。","难怪明明不是内部人员却能在……[l]\n不对应该说本来就是内部人员，啊好混乱。"],["そう言えば年も誤魔化してたようですけど。[l]\n見た目通りじゃないって――」","说起来年龄好像也糊弄过去了。[l]\n意思是外表和实际不符――」"],["「そんな事言ったんですか？[l]\n自分から？」","「她亲口这么说的？[l]\n自己提的？」"],["「え？[l]\nええ、ただまあ、別に普通の女子高生に視えましたけどねえ」","「诶？[l]\n啊，不过看起来就是个普通女高中生啦」"],["「当主だと名乗ったとか？」","「有自报当主身份吗？」"],["「いえ、そんな事は……[l]\n知狡さんみたいな例もありますから\n女性の容姿と年齢に関してはその、","「没，这种事……[l]\n毕竟有知狡阿姨这样的先例\n女性外貌和年龄这种事那个，"],["あ、いや何でもないです。[l]\n誤魔化してるったって精々２０代じゃないかなあ……[l]\n暗かったので何とも言えませんけど……","啊不当我没说。[l]\n就算糊弄顶多也就二十多岁吧……[l]\n当时太暗看不清……"],["声とか喋りから","从声音和谈吐"],["鑑みてもそんなでしたよ。[l]\nああ、逆に小中学生って線もありますか……[l]\nん？[l]\nその辺の情報も既知のものですか？」","来判断差不多是这样。[l]\n啊反过来说也可能是中小学生……[l]\n嗯？[l]\n这些情报也是已知范围吗？」"],["「……ふぬ？[l]\nお、おういえー。[l]\nかれおみたいに西國にも飯窪の手の者は配置されてますからね」","「……呼嗯？[l]\n噢、噢不是啦—[l]\n西国也有像卡蕾欧那样的饭洼派系人员啦」"],["「手の者て、悪の一味みたいな言い方ですが……」","「派系人员这种说法，简直像反派组织似的……」"],["「ともかく、これでまた三春関係者との接触がなされた訳ですねー。[l]\nまこくん連れてきて正解でした」","「总之，这下又和三春相关人员扯上关系了呢—[l]\n带小真来真是对了」"],["「はははは……[l]\nその状況が果たして吉と出るかどうなんだか、\nまあ役に立ててるなら良いんですけどね、\nそうでなきゃ僕としてもあまりに悲しいものが……」","「哈哈哈……[l]\n这种情况到底算吉兆还是凶兆，\n不过能派上用场就好，\n否则对我来说也太难过了……」"],["大体、ミッションコンプリートにはまだまだ遠い、\nんだろうしなあ。","说到底，离任务完成还差得远，\n大概吧。」"],["「んむーと、今日の時点","「嗯唔—，截止今天"],["迄でまこくんが接触したのはぁ、\n三春家の冬夏ちゃんとお母さん、\n綾目家の姫様ちゃん、\n狩屋家の克杖ちゃんとお母さん、","目前小真接触过的有啊，\n三春家的冬夏酱和她母亲，\n绫目家的姫様酱，\n狩屋家的克杖酱和她母亲，"],["永久家の卑尊ちゃん、\n奇士家の道具ちゃん、\n玉梓家の選律ちゃん、\nかな？」","永久家的卑尊酱、\n奇士家的道具酱、\n玉梓家的选律酱、\n对吧？」"],["「東國の三春系列の人間とは全部接触して……ますよね？[l]\n西國は確か三家だから……あれ、一個足りない？」","「东国三春系的人应该都接触过……了吧？[l]\n西国记得是三家……咦，少一个？」"],["「飯窪本家が知るところに依れば、\nあとは玖威家です」","「根据饭洼本家掌握的情报，\n剩下是玖威家」"],["「食い気？[l]\nああ、玖威家。[l]\n……逢ってませんねぇ」","「食欲（译注：ku ike）？[l]\n啊，是玖威家（译注：ku i ka）。[l]\n……还没见过呢」"],["「すれ違うくらいはしてるかもですけどね。[l]\n今日の式を滞りなく行ったという事は、\n祭の方も基本的には中止するつもりも無いでしょうからね、\nあとは日程が予定通りになるかどうか――","「可能只是擦肩而过而已。[l]\n今天的仪式能顺利进行这件事，\n说明祭祀那边基本上也没打算中止吧，\n剩下的就看日程能否按计划――"],["そうならば西國の眷属を早めにこっちに呼んでる\n可能性もありますから。[l]\nまこくんのようにね」","如果顺利的话可能会提前把西国的眷属叫过来\n也说不定。[l]\n就像小真那样呢」"],["そう、それで僕はあっさりと人生の路線変更させられたんですが。","是啊，所以我的人生路线才被轻易改变了。"],["「まあねえ……[l]\nあと逢ったのはきぃ――貴奴くらいですか……","「这个嘛……[l]\n另外见过的就只有小贵――贵奴了吧……"],["そう言えば彼奴、\n長久診療所でバイト？してるだけじゃなくて、[l]\nその奇士道具さんとも何か知り合いらしいんですが。[l]\n先日は言い忘れましたけど」","说起来那家伙，\n不仅在长久诊所打工？[l]\n好像和那位奇士道具小姐也有什么交情。[l]\n前几天忘记说了」"],["西國の人間とどうやって繋がりが出来るのか、\nまあ事情はあるんだろうけど、\n不自然とまでは言わずとも、","虽然不清楚西国的人是怎么搭上关系的，\n应该是有缘由的吧，\n虽说不上不自然，"],["うーん、こっち来てからあまりにも事が起こるというか、\n無節操なようでいて実は大きな括りで繋がってたりとかするから、\n変に作為的恣意的な気配を感じるんだよな。","但自从来了这边就接二连三发生事件，\n看似杂乱无章实则暗藏关联，\n总感觉有种刻意为之的做作感。"],["「西國……ぁ、ニ……シ……？[l]\nんむー、\n前も言いましたけど、\n字面に確かに覚えはあるんですが。","「西国……啊、西……？[l]\n嗯唔——\n之前也说过，\n对字面确实有印象。"],["やっぱりメモしないと忘れるですねぇ……[l]\n知狡……じゃ難しいか、かれおにでも確認してみます」","果然不记笔记就会忘记呢……[l]\n知狡……啊太难念了，还是找卡蕾欧确认吧」"],["「はぁ。[l]\nそれこそ別に被害を被った訳じゃないし、\n冬夏と渡りを付けてくれたのは彼奴ですしね。[l]\n障害になるような話でも無いとは思いますが」","「哈啊。[l]\n倒也不是说受到什么损害，\n毕竟帮忙和冬夏牵线的就是那家伙。[l]\n应该不至于成为障碍吧」"],["「ですかねぇ」","「是吧」"],["「あ、それよりですね……」","「啊对了……」"],["実は、","其实"],["先刻から、","从刚才开始"],["宮さんに言いたいことがあったのだけど……","有件事想对宫小姐说……"],["「んむ？[l]\nなぁに？」","「嗯唔？[l]\n什么事？」"],["僕は上半身を捻って宮さんの方を向いて言った。","我扭过上半身对着宫小姐说道。"],["「あんまりずっと背中ばっかり擦られても」","「一直只让您搓背的话」"],["「えっ――、前も……って事！？[l]\nん、んむー、\nそれは各方面からお叱りの言葉が……」","「诶――、前面也要……的意思！？[l]\n嗯、嗯唔——\n这会招来各方责难的说……」"],["「違いますっ！！[l]\n僕ばっかりして貰ったんじゃ悪いと思っただけですよ！[l]\n結構時間経ってるし！！」","「不是啦！！[l]\n只是觉得光让您服务我太不好意思了！[l]\n已经过了挺长时间了！！」"],["自発的に言うと触らせろと言ってるようで言い出し難かったから\n言わなかっただけです！","主动说出来就像在要求爱抚所以难以启齿\n只是没说出口而已！"],["うっ、言う言うばっかりだな……","呜、怎么说得我好像满脑子都是这种事……"],["「と、思ったら……お返しにお背中流すといってもその、[l]\n難しいですかね。[l]\n考えてみれば当たり前ですけど、水着の形状的に」","「既、既然这样……作为回礼帮您搓背虽然[l]\n有点困难呢。[l]\n仔细想想也是理所当然，泳装的结构限制」"],["「んむっ、\n折角のまこくんの好意を無にする宮ではありませんですよ！","「嗯唔——\n宫可不会辜负小真的好意哦！"],["じゃー上だけ半脱ぎなるので\n向こう向いて待っててください。","那就把上半身泳装脱掉\n请转过去稍等。"],["心配しなくてもバスタオルで前は隠しますから、\n遠慮することはないですよ♪」","不用担心会用浴巾遮住前面，\n不必客气哦♪」"],["いや、そのそれはいくら何でも。[l]\nこっちの装備はタオル一枚ですので色々と障害が。","不、这再怎么说也。[l]\n我这边装备只有一条毛巾实在诸多不便。"],["「いやいやあわわわわわわ」","「等等等等等等」"],["いきなり水着を肩紐から脱ぎかける宮さん。[l]\n僕は慌てて身体の向きを変えます！","宫小姐突然开始从肩带脱泳衣。[l]\n我慌忙转过身去！"],["「あ、タオルが脱衣場でした」","「啊、浴巾在更衣室」"],["びびびび吃驚させんといてください。","别别别别突然吓人啊。"],["ああもう、","啊啊真是的，"],["経験上、押せば引く、というのは判ってるんだが、","根据经验，推拉战术的道理我是懂的，"],["そっちから一方的に具体的な行為を始められたら、\nこっちは諾々と従わざるを得ないというか、","但要是对方单方面开始具体行为的话，\n这边就只能唯唯诺诺服从了，"],["「ままま、待ってますから、準備万端にしてきてください……」","「慢、慢慢来，我等着呢，请做好万全准备再来……」"],["今更押しに転じるにも、機を逸した感が否めないなあ……","现在才转守为攻，总觉得错失良机了啊……"],["「んぁんもう、\nまこくんてばやる気満々ですか☆\nそんなに……したいなんて」","「嗯啊真是的，\n小真真是干劲十足呢☆\n居然这么……想要吗」"],["………。","………。"],["――やっぱりこの手のハナシの応酬では先手を取るに限るなあ……","――果然这类话题交锋还是该抢占先机啊……"],["まあ僕の場合、イニシアチブを取るよりは、\n相手の流れに身を任せた方が性に合ってるのかもな……","不过对我来说，\n比起掌握主导权，或许更适合随波逐流吧……"],["と、宮さんが脱衣場から戻ってきたが、\n当然直視は無理ですよ。[l]\nなるべく視線を合わさないようにしつつ、\n宮さんが座るのを待つ。","这时宫小姐从更衣室回来了，\n当然没法直视啊。[l]\n尽量避开视线交汇，\n等待宫小姐坐下。"],["「はーい、じゃ、\nお願いしまぁーす」","「好——啦，那么，\n拜托你啦——」"],["そうだ、流されると言えば。","说到随波逐流。"],["「では失礼して……[l]\nそれで、明日成り行きで、\n先刻ちらっと話した、\n狩屋と姫……綾目の家の娘達の手伝いをすることに……」","「那就失礼了……[l]\n话说明天顺道，\n要帮之前提过的，\n狩屋和姬……绫目家的姑娘们干活……」"],["今回は何かしらの手がかりを得られるような\nイヴェントではないぽいし、\n確認取るとは言ったが勝手に了承の返事をしてしまい、\n怒られるかとも思ったが、","这次似乎不是能获得线索的\n那种事件，\n虽然说过要确认却擅自答应了，\n本以为会被骂，"],["「ほうほう。[l]\nま、いいんじゃないですか。[l]\n折角懐柔が順調にいってるんですから駄目押し的に恩を売るのも\nありでしょー。","「哦哦。[l]\n嘛，不是挺好的嘛。[l]\n难得怀柔政策进展顺利，趁势卖个人情\n也不错吧——。"],["どうせ制服とか返したりとかで接触の機会は今後もあるですしね。[l]\nその代わり、お守り――チョーカーは忘れずに装備していくこと。[l]\n有用な情報は","反正还要归还制服什么的今后还有接触机会。[l]\n不过护身符――项圈别忘了装备。[l]\n有用的情报"],["視逃さず聞き逃さずで」","要眼观六路耳听八方」"],["割とあっさり了承された。[l]\n冬夏は咬んでないはずだから、\nどんだけ根幹に関わる情報得られるかは解らないが……","意外爽快地同意了。[l]\n冬夏应该没咬钩，\n能获取多少核心情报还不好说……"],["そう言えば彼女の事も気になる事案ではあるんだよなあ。[l]\n今日のこと隠し通すかどうかとか……","说起来她的事也挺令人在意的。[l]\n今天的事能不能瞒住之类的……"],["煩悶としながら、宮さんの背中を洗う。[l]\n否、宮さんの背中を洗いながら煩悶とする。[l]\n宮さんの背中に意識が集中しないよう、\n且つ乱暴にならないように気を遣いつつ！","边烦恼边给宫小姐搓背。[l]\n不，是给宫小姐搓背时陷入烦恼。[l]\n既要避免注意力集中在宫小姐背上，\n又要注意动作不能太粗暴！"],["添い寝といい今といい何をしとるんだろう僕は。","陪睡也好现在也好我到底在干什么啊。"],["「あ。[l]\nあと、これも","「啊。[l]\n还有，这个"],["先","事"],["刻言いましたけど、\n僕の小さいときの記憶が何となくですが、\n思い出して来たっていうか、","刚才也说过了，\n我小时候的记忆好像隐约\n想起来了点，"],["ああええその、\nわざわざ報告する事じゃないし雑談として聞いて欲しいんですが、\nその、」","啊那个就是，\n也不是非要特地汇报就当闲聊听听就好，\n那个，」"],["……昔、僕ら、既に逢ってたりしませんか。","……我们以前，是不是见过面。"],["とは訊けない。[l]\n色んな意味で危険、訊けない。","问不出口。[l]\n无论从哪个角度看都太危险，问不出口。"],["「あのえーと、\nそうあれですよ、あれ、\nこの辺に海岸とかありましたっけ？","「那个——呃，\n就是那个啦，那个，\n这附近有海岸什么的吗？"],["砂浜の……[l]\n海水浴場ほどでかくなくていいんですが」","沙滩的……[l]\n不用像海水浴场那么大就行」"],["「……ん？[l]\n海岸。[l]\n結構離れた所になりますけど。[l]\nこの辺では……まあ、目の前にありますようにまだ河ですね。","「……嗯？[l]\n海岸。[l]\n离得还挺远的。[l]\n这附近……嘛，如您所见还是河流呢。"],["でも、小さいときでしたら、\nまこくんママとか知狡とかが車で連れてってる可能性はありますね。[l]\n――あ」","不过小时候的话，\n小真妈妈或是知狡开车带你去过的可能性倒是有的。[l]\n――啊」"],["先刻僕が思った事と大差ない内容だが、\n元より話題のすり替えの為だったので構わないはずだった、\nのに、","和我刚才想的差不多，\n本来就是为了转移话题所以无所谓才对，\n可是，"],["「ど、どうかしたんすか？」","「怎、怎么了吗？」"],["「他に憶えて――思い出した事はありますか？」","「还有其他记――想起来的事吗？」"],["ま、","诶，"],["真","难"],["逆","道"],["覚られましたか！？","被发现了吗！？"],["「う、うーん……いや、特に……」","「嗯、嗯嗯……没，特别……」"],["「そですか。[l]\nならいいです」","「这样啊。[l]\n那就好」"],["「あ――、\nそ、うですか。[l]\nはあ」","「啊――\n这、样啊。[l]\n哈啊」"],["何も無しか。","什么都没有吗。"],["それはそれで、\nいやその。[l]\n良いんだけど――","这样也好，\n啊不是。[l]\n虽然挺好的――"],["「じゃ、じゃあ大体今日の報告はこのような感じで……」","「那、那今天报告大概就这样……」"],["――まのところはね。","――目前来说呢。"],["「はい？[l]\n何すか？？」","「嗯？[l]\n怎么了？？」"],["「んっ？[l]\nなに？[l]\nまた何か聞こえた？」","「嗯？[l]\n什么？[l]\n又听到什么了吗？」"],["「………いえ、なにも」","「………没，没什么」"],["「うひひっ。[l]\nさて、では明日も大変ですね。","「呜嘻嘻。[l]\n好啦，明天也很忙呢。"],["約束の時間、朝早いんでしたっけ？[l]\nそろそろ背中、泡流して終わりにしましょうか。","约定时间是在清早来着？[l]\n差不多该冲掉背上的泡沫结束了吧。"],["まこくんは早く寝ないとですね。[l]\n宮はちょっと色々しなきゃで夜更かしですけどっ」","小真得早点睡呢。[l]\n宫还有些事必须熬夜处理啦」"],["「はいはい。[l]\nじゃ流しますよ……っと」","「好好。[l]\n那我冲水啦……哟」"],["シャワーで流せば良いんだろうけど、\n其処にあったし何となく桶に湯を溜めて、\n静かに泡を流す。","明明用花洒冲就行，\n但既然那儿有木桶就顺手盛了热水，\n静静冲去泡沫。"],["「まこくん」","「小真」"],["「は、すいません熱かったですか？」","「啊、抱歉水太烫了吗？」"],["「こんな日が、\nずっと続けばいいですね」","「这样的日子，\n能永远持续下去就好了呢」"],["「んあ゛っ。[l]\nなんの話ですよ」","「嗯啊！[l]\n说什么呢」"],["背中を向けたままなので表情は","因为背对着所以"],["窺い知れないが、\n口調は―――\nいや、やっぱり真面目なのか巫山戯てるのか解らん。[l]\nでもまあ、後者だろうな。どうせ。","看不见表情，\n但语气―――\n不，果然分不清是认真还是在开玩笑。[l]\n不过嘛，反正是后者吧。肯定。"],["「んむ？[l]\n希望的観測。[l]\nあ、そそ、例の紙片、ちょっと長めに預からして貰うかも。[l]\n最悪返さなくてもいいらしいですし……」","「嗯唔？[l]\n一厢情愿。[l]\n啊对，那张纸片可能要借我稍微久一点。[l]\n据说最坏情况不还也没关系……」"],["「うーん、というか、\n明日の面子は潜入の件知らない面子ですから、\n仮に返そうったって問題がありますけど」","「唔嗯，或者说，\n明天参与的成员不知道潜入行动，\n就算想还也有问题」"],["「あ、そか。[l]\nメモしないと駄目ですのー。","「啊，对哦。[l]\n必须记笔记呢ー。"],["――さ、あとは宮、シャワーさっと浴びたら出ますね－。[l]\nその間こっち視ちゃだめですよ。","――好，等宫快速冲个澡就出发啦－。[l]\n期间不许偷看这边哦。"],["そしたらあとは一人でごゆっくり。[l]\n……あ、一人になったからって」","那之后你就一个人慢慢享受吧。[l]\n……啊、就算变成一个人了」"],["「なんもしませんよ！[l]\nじゃないその、怖くもないですから！！[l]\nご心配なく！！」","「我什么都不会做的！[l]\n不是那个意思，我一点都不害怕！！[l]\n请不用担心！！」"],["無為に焦る僕を尻目に、\n宮さんはバスタオルを抑えつつ立ち上がった。[l]\n僕は座ったまま、思わず振り向く。","在我徒劳地焦躁时，\n宫小姐按着浴巾站了起来。[l]\n我坐着不自觉地转过头去。"],["「うひひ、\n感心感心。[l]\nあと半月とちょっと、頑張りましょう」","「嘿嘿，\n值得表扬值得表扬。[l]\n还有半个月多点，一起加油吧」"],["「解ってますよ。[l]\n終わったら、場合によっては色々責任取って貰いますよ、\nあの時言いましたけど。まじで。まじで」","「我知道的。[l]\n结束后，根据情况可能要你负起各种责任，\n那时候说过的。认真的。认真的」"],["「うひひひひひ☆\nその点はだいじょぶ♪\nどう転ぼうと、宮達は見捨てませんよ」","「嘿嘿嘿嘿☆\n这点完全没问题♪\n不管怎样，我们都不会抛弃你的」"],["「なんか微妙に引っ掛かりますけど、\nまあその」","「总觉得有点微妙地在意，\n不过那个」"],["じゃーーーーーーーー。","那么——————。"],["シャワーの流れる音で会話は途切れた。","淋浴的水声打断了对话。"],["「それなら……[l]\nいいんですがね……」","「那样的话……[l]\n倒也不错呢……」"],["なるべく宮さんの方を視ないようにしながら、僕は湯船に浸かった。","尽量不去看宫小姐那边，我泡进了浴缸。"],["「まこくーん、\nそっち視たまま聞いてくださいねぇー」","「小真——，\n看着这边听我说哦——」"],["「はい？」","「啊？」"],["「今こっち、なにも着てませんからぁー。[l]\nいいって言うまで絶対こっち視ないでくださいよぉー」","「现在这边、什么都没穿啦——。[l]\n在我同意前绝对不要看过来哦——」"],["「…うああーい、わかりましたぁー」","「…好——的，明白啦——」"],["――この後、\nよくある話のように、\n変なフェイントや悪戯もなく、","――之后，\n并没有像常见剧情那样，\n出现奇怪的假动作或恶作剧，"],["普通に脱衣場に戻った宮さんから声を掛けられて","只是平常地从更衣室回来的宫小姐打了招呼"],["漸く、\n僕は視線を戻す事が出来た。[l]\n首いてえって……","终于，\n我能把视线转回去了。[l]\n脖子好酸……"],["「じゃーねまこくん、\n風邪引かないようにー」","「拜拜啦小真，\n别感冒啦——」"],["「あいさー、そちらもお気をつけてー」","「好——的，你也要小心——」"],["戸が閉まる。","门关上了。"],["閑かになった。","安静了下来。"],["耳鳴りがするほど音がしない。","静得甚至能听见耳鸣。"],["田舎に旅行に行くと、まま体験出来るこの無音の世界。","去乡下旅行时，偶尔能体验到的这种无声世界。"],["音は魔法なあ……","声音真是魔法啊……"],["「――さて、」","「――那么，」"],["宮さんの真意はどうあれ、\n今日も今日とて流されるがまま、\n僕の一日は終わろうとしている。","无论宫小姐的真实意图如何，\n今天也随波逐流地，\n我的一天即将结束。"],["そうして流されて明日も強制イベント発動決定な訳で、\n湯船に身を沈めながら、\n疲弊した身体が少しでも恢復するよう","这样被推着走明天也注定要触发强制事件，\n把身体沉在浴缸里，\n为了让疲惫的身体稍微恢复些"],["弛","努"],["緩に","力放松"],["努める。","下来。"],["「僕のアタマじゃ、眼の前の事で手一杯だぁ……」","「以我的脑子，光是眼前的事就够忙的了……」"],["そう。[l]\n\n未来のことなど想像もつかない。[l]\n\nこんな日がずっと続く――[l]\n\nそれっていいことなのか、[l]\n\n………。","是啊。[l]\n\n未来的事根本无从想象。[l]\n\n这样的日子一直持续――[l]\n\n这到底是好事还是，[l]\n\n………。"],["うーーーーーーーん、[l]\n\nどーうだろうなーあ。","唔——————嗯，[l]\n\n到底会怎样呢——啊。"],["というか今思ったんですが……[l]\n図々しいかもしんないけど、\n最初からこの風呂場を使わせて貰えなかったんですかね？","话说现在突然想到……[l]\n可能有点厚脸皮，\n打从一开始就不能让我们用这个浴室吗？"],["いや、\nお手入れとか面倒そうではあるし、\n……一人になると雰囲気も何かホラーぽいし、[l]\nいいかやっぱり。","不过，\n打扫维护什么的看起来也挺麻烦，\n……独自待着氛围又莫名像恐怖片，[l]\n还是算了吧。"],["他にも何か、色々と聞き逃したというか、\n心に引っ掛かるものがある気がしてならない……[l]\nしかし、只でさえ空転脳の僕に、\n長風呂でちっとは飛んだとは言えアルコールがプラスされたんでは\nもう論理的な思考は困難だ。","总觉得还有其他各种事情漏听了，\n心里莫名在意得不行……[l]\n但对我这个本来就脑子空转的家伙来说，\n虽说泡长澡让脑子稍微飘了点再加上酒精作用，\n已经很难进行逻辑思考了。"],["まあ、思い出せない程の事ならきっと大したことではないんだろう。[l]\nどうせ僕みたいな奴ぁ寝れば忘れてしまうだろうし……[l]\n今にして思えば、報告の前にああ言う飲み食いってどうなんだ。","嘛，想不起来的事肯定也不重要吧。[l]\n反正像我这种人睡一觉就会忘光……[l]\n现在想想，汇报前那样大吃大喝真的好吗。"],["宮さんにしろ知狡さん……本家にしろ、[l]\n真面目なのか愉しんでるのか、優先順位が僕の基準とは違うのか、\n――兎に角僕は今此処に居るのだ。","无论是宫小姐还是知狡阿姨……或者本家那边，[l]\n到底是认真还是享乐，优先级都和我的标准不同，\n――总之我现在就在这里。"],["前に進むしかない。[l]\n未来のことなど想像がつかなくても、\nたとえ今は流され巻き込まれた","只能向前走了。[l]\n即使无法想象未来的事，\n哪怕现在是被推着卷着"],["路だとしても、\n僕は――[l]\n\n責任取っては貰えるようだしな。[l]\nどんな形でかは兎も角として、だ……","走的这条路，\n我――[l]\n\n好像也会有人替我负责。[l]\n具体形式就另当别论了……"],["そうさなあ、\n明日は早いけども一応寝る前に、大神と話してみるか……","是啊，\n虽然明天要早起还是睡前找大神聊聊吧……"],["@r@r@r体感時間で五分ほど浸かって後、僕は湯船を出た。","@r@r@r体感泡了五分钟后，我离开了浴缸。"]],"context":[["SC_M_024.ks/index/1/text"],["SC_M_024.ks/index/3/text"],["SC_M_024.ks/index/6/text"],["SC_M_024.ks/index/9/text"],["SC_M_024.ks/index/11/text"],["SC_M_024.ks/index/13/text"],["SC_M_024.ks/index/15/text"],["SC_M_024.ks/index/17/text"],["SC_M_024.ks/index/19/text"],["SC_M_024.ks/index/21/text"],["SC_M_024.ks/index/23/text"],["SC_M_024.ks/index/25/text"],["SC_M_024.ks/index/27/text"],["SC_M_024.ks/index/29/text"],["SC_M_024.ks/index/31/text"],["SC_M_024.ks/index/33/text"],["SC_M_024.ks/index/35/text"],["SC_M_024.ks/index/37/text"],["SC_M_024.ks/index/39/text"],["SC_M_024.ks/index/41/text"],["SC_M_024.ks/index/43/text"],["SC_M_024.ks/index/45/text"],["SC_M_024.ks/index/47/text"],["SC_M_024.ks/index/49/text"],["SC_M_024.ks/index/51/text"],["SC_M_024.ks/index/53/text"],["SC_M_024.ks/index/55/text"],["SC_M_024.ks/index/57/text"],["SC_M_024.ks/index/59/text"],["SC_M_024.ks/index/61/text"],["SC_M_024.ks/index/63/text"],["SC_M_024.ks/index/65/text"],["SC_M_024.ks/index/67/text"],["SC_M_024.ks/index/69/text"],["SC_M_024.ks/index/71/text"],["SC_M_024.ks/index/73/text"],["SC_M_024.ks/index/75/text"],["SC_M_024.ks/index/77/text"],["SC_M_024.ks/index/79/text"],["SC_M_024.ks/index/81/text"],["SC_M_024.ks/index/83/text"],["SC_M_024.ks/index/85/text"],["SC_M_024.ks/index/87/text"],["SC_M_024.ks/index/89/text"],["SC_M_024.ks/index/91/text"],["SC_M_024.ks/index/93/text"],["SC_M_024.ks/index/95/text"],["SC_M_024.ks/index/