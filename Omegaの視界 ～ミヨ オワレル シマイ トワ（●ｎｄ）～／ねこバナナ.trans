],["SC_M_006.ks/index/238/text"],["SC_M_006.ks/index/240/text"],["SC_M_006.ks/index/242/text"],["SC_M_006.ks/index/244/text"],["SC_M_006.ks/index/246/text"],["SC_M_006.ks/index/248/text"],["SC_M_006.ks/index/250/text"],["SC_M_006.ks/index/252/text"],["SC_M_006.ks/index/255/text"]],"tags":[],"parameters":[[{"start":153,"end":183}],[{"start":251,"end":264}],[{"start":270,"end":279}],[{"start":285,"end":300}],[{"start":337,"end":371}],[{"start":385,"end":424}],[{"start":458,"end":519}],[{"start":531,"end":561}],[{"start":575,"end":630}],[{"start":644,"end":681}],[{"start":747,"end":765}],[{"start":801,"end":813}],[{"start":851,"end":871}],[{"start":905,"end":921}],[{"start":987,"end":991}],[{"start":1027,"end":1063}],[{"start":1101,"end":1119}],[{"start":1156,"end":1193}],[{"start":1227,"end":1248}],[{"start":1254,"end":1277}],[{"start":1283,"end":1307}],[{"start":1373,"end":1390}],[{"start":1428,"end":1448}],[{"start":1460,"end":1479}],[{"start":1517,"end":1527}],[{"start":1564,"end":1570}],[{"start":1576,"end":1616}],[{"start":1682,"end":1713}],[{"start":1725,"end":1781}],[{"start":1815,"end":1848}],[{"start":1854,"end":1867}],[{"start":1879,"end":1897}],[{"start":1903,"end":1935}],[{"start":1941,"end":1956}],[{"start":1962,"end":1983}],[{"start":2020,"end":2051}],[{"start":2117,"end":2125}],[{"start":2131,"end":2172}],[{"start":2210,"end":2224}],[{"start":2261,"end":2282}],[{"start":2348,"end":2353},{"start":3697,"end":3702}],[{"start":2359,"end":2364}],[{"start":2401,"end":2416}],[{"start":2450,"end":2483}],[{"start":2489,"end":2501}],[{"start":2567,"end":2574}],[{"start":2611,"end":2622}],[{"start":2688,"end":2716}],[{"start":2754,"end":2771}],[{"start":2808,"end":2813}],[{"start":2819,"end":2838}],[{"start":2844,"end":2857}],[{"start":2923,"end":2933}],[{"start":2939,"end":2950}],[{"start":2986,"end":2992}],[{"start":3029,"end":3038}],[{"start":3044,"end":3080}],[{"start":3092,"end":3110}],[{"start":3116,"end":3127}],[{"start":3193,"end":3210}],[{"start":3248,"end":3267}],[{"start":3301,"end":3340}],[{"start":3430,"end":3457}],[{"start":3463,"end":3468}],[{"start":3480,"end":3518}],[{"start":3555,"end":3575}],[{"start":3609,"end":3629}],[{"start":3708,"end":3723}],[{"start":3761,"end":3787}],[{"start":3821,"end":3845}],[{"start":3911,"end":3929}],[{"start":3967,"end":3981}],[{"start":4071,"end":4090}],[{"start":4096,"end":4102}],[{"start":4330,"end":4332}],[{"start":4338,"end":4347}],[{"start":4353,"end":4364}],[{"start":4370,"end":4383}],[{"start":4389,"end":4393}],[{"start":4399,"end":4401}],[{"start":4407,"end":4409}],[{"start":4415,"end":4417}],[{"start":4423,"end":4425},{"start":4431,"end":4433},{"start":4439,"end":4441}],[{"start":4447,"end":4449}],[{"start":4455,"end":4458}],[{"start":4464,"end":4472}],[{"start":4486,"end":4492}],[{"start":4661,"end":4668}],[{"start":4733,"end":4739}],[{"start":4745,"end":4758}],[{"start":4772,"end":4794}],[{"start":4800,"end":4807}],[{"start":4813,"end":4823}],[{"start":4829,"end":4840}],[{"start":4854,"end":4884}],[{"start":4890,"end":4894}],[{"start":4900,"end":4902}],[{"start":4908,"end":4911}],[{"start":4917,"end":4920}],[{"start":4926,"end":4929}],[{"start":4935,"end":4940}],[{"start":4977,"end":4984}],[{"start":4990,"end":5001}],[{"start":5035,"end":5052}],[{"start":5058,"end":5086}],[{"start":5092,"end":5101}],[{"start":5115,"end":5135}],[{"start":5198,"end":5202}],[{"start":5208,"end":5218}],[{"start":5252,"end":5267}],[{"start":5281,"end":5304}],[{"start":5310,"end":5339}],[{"start":5353,"end":5362}],[{"start":5397,"end":5412}],[{"start":5418,"end":5424}],[{"start":5430,"end":5445}],[{"start":5479,"end":5487}],[{"start":5493,"end":5504}],[{"start":5538,"end":5544}],[{"start":5558,"end":5572}],[{"start":5578,"end":5594}],[{"start":5655,"end":5659}],[{"start":5716,"end":5726}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_006.ks","basename":"SC_M_006.ks","indexIds":{"茶屋の前のベンチに座っていると、\nきぃがやってきた。":0,"「おっはよう、まこちゃん。":1,"今日もいい天気さ。":2,"春の日差しになってきたのだわ」":3,"「おっはようというかこんちはというか、\n天気はいいな今日も。":4,"まだ僕的には肌寒いけど…\nともあれ新学期の始まりって感じはするかな…」":5,"中央あたりの感覚だと始業式入学式には桜、\nというイメージだが、\nここいらではまだ満開という訳にもいかない。":6,"何しろ梅雨が明けずに夏が終わることもある\nらしいし。":7,"今日は玄ノ森の高校の新年度始業式で、\n２年と３年がぞろぞろ登校しているのを、\n朝から見かける。":8,"きぃと同い年らしい三春冬夏は、\n今年度から新三年生の一人だそうだ。":9,"「今日はバイトも休んできたからさ、\n":10,"みんなでいい店行こうね。":11,"ま、冬夏は一緒じゃなくても構わないけど」":12,"おおい、それは本末転倒なのだわ…":13,"「なんてね。":14,"午前中で終わりだっていうからさ、\nみんなでお昼、丁度良いのだわ。":15,"他の学生共の来ない穴場教えたげるよ」":16,"「お前隣町から来てるのに、\n地元学生も知らないとこ知ってるのか？」":17,"不味いから客居ない、とかじゃないだろうな…":18,"安さと量が価値基準らしいし、ちょっと不安だぞ。":19,"不味い飯は知狡さんのでもうおなかいっぱいですよ？":20,"「舐めて貰っては困るなまこちゃん。":21,"食いに関してはこのきぃは妥協はしないよ。":22,"バイト先でも情報収集は欠かさないのさ。":23,"見てるがいいのだわ」":24,"「あ、そう…":25,"昨日も言ったけど、\n多少値が張っても構わないから、味のいいとこ頼むよ…」":26,"「ふええ、\n味の善し悪しなんて個人の主観でしかないさ。":27,"それぞれの価値観で、\nおんなじものでも１８０°評価は変わることもあるし、\n保証はできないのだわ」":28,"冬夏に食わせたら美味しいって言ってたけどね、\nと言うきぃ。":29,"ま、まあ、それを信じよう。":30,"にしてもどっかで聞いたような話だな。":31,"――ああ、知狡さんが一昨日、橋の上で似たようなことを言っていた。":32,"…流行ってんのか？流行語大賞？":33,"というかそれで初日に酷い目にあってまーす。":34,"「学校に直で僕らが行くと、\nやっぱおかしいんだろうな」":35,"「そりゃそうさ。":36,"余所者二人、若い男女が三春のお嬢様を待ちかまえてたら、\n怪しすぎなのだわ。":37,"わたしだけならまだしもねー」":38,"「『噂になると恥ずかしいし…』的状況か…」":39,"「ふええ？":40,"何それ？」":41,"「いや？なんでもないですよ？」":42,"大学入って知り合った頃、大神から借りたそっち系ゲームのネタでした。":43,"分かんないわな、そりゃ。":44,"「あ、やば！」":45,"「んあ？どうした？？」":46,"「…ごめんまこちゃん、\n携帯充電し忘れてたのさ。":47,"冬夏からの連絡受けられないのだわ」":48,"「おおい…":49,"あ、でも此処で待ってれば来るわけだろ？":50,"来たら謝りゃいいんでは？」":51,"「まあ、そうだけど…":52,"まこちゃんの携帯から電話…":53,"してみる？」":54,"「や、いきなりは…":55,"予定の時間まで待って、明らかに来ない時とかの\n最終手段にしよう。":56,"そこまで神経質になること…ないよな？":57,"冬夏さんそういう人？」":58,"「んや、だいじょぶだと思うのだわ。":59,"じゃそうしよう。あと３０分くらいだね」":60,"二人で昨日の公園に移動し、\n冬夏嬢の姿を探しながら待機することにした。":61,"ああ、まっ昼間になるとさすがにあったかい感じになるな。":62,"眠くなる…":63,"夕べはちょっと…目が冴えてしまったので、\n疲労が取れてないのだろう。":64,"「なあ、きぃ、ちょっとだけ寝ていいか？」":65,"いいつつ僕は既にベンチに横になり始める。":66,"知らないよ、冬夏が急に来ても。":67,"まあ来たら起こすさ、\n携帯一応貸しといて？」":68,"了解了解、と寝っ転がった体勢で貴奴に携帯を渡す。":69,"「じゃちょっとその辺まで見てくるさ。":70,"ゆっくり寝てるがいいのだわ」":71,"はーい…と言いつつ、春の陽気の中僕は…":72,"眠りに………":73,"夢。":74,"夢を見ていたのか。":75,"玄ノ森に居た頃の僕と、":76,"二つ歳下の少女がいる―――":77,"僕らは、":78,"紙、":79,"神、":80,"月、":81,"猫、":82,"猫？":83,"ねこ？":84,"ねこがどうした？":85,"ねころんで？":86,"「――ああ？」":87,"目が覚めた。":88,"が、\n様子が変だ。":89,"目の前に貴奴が居る、こっちを見て笑っている。":90,"いやそれより、":91,"この側頭部に感じる、":92,"柔らかい感触はなんだ。":93,"身体の右側を下にしていたので、\n左手で確認してみる。":94,"温かい、":95,"布、":96,"肉感、":97,"吐息、":98,"脈動、":99,"――まて。":100,"「うああ？？？":101,"ああああああ？？！！」":102,"これは膝枕というしろものだ！！！！":103,"だっ！だれかの太股を枕に、\n僕は寝てたぞ？？！！":104,"きぃでもない！！！":105,"おぼつかない動作で太股の主を見上げると、":106,"「ぷっ！":107,"――っははははは！」":108,"屈託無く笑い声を上げる少女が。":109,"春の陽光を照らし輝く、\n長きブロンド。":110,"左目はガーゼで覆われているが、\n残る右眼は蒼き瞳。":111,"制服に身を包んだ、":112,"「私の脚、寝心地良かったかな？":113,"まことさん。":114,"はじめまして、\n私が」":115,"「あっはははは！":116,"ごめんまこちゃん！！」":117,"あああああ。":118,"きぃの笑い声も遠く聞こえる。":119,"僕を膝枕していたこの少女こそが、":120,"@r@r":121,"「三春冬夏です」@l":122},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_006.ks","relPath":"/data/scenario/SC_M_006.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":123,"length":123,"percent":100},"cellInfo":[null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"t":"HU","v":1}],[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[118,0],"note":"完成"},"/data/scenario/SC_M_007.ks":{"data":[["「もう、いつまでもむつけてないでさ、\n機嫌なおして欲しいのだわ」","「真是的，别一直闹别扭啦，\n人家希望你能消消气嘛」"],["「そうだよまことさん。","「就是啊真言君。"],["あ。なんなら脚といわずもっといい感触のところ、\n思う存分さわってもらっても良いけど。","啊。不介意的话别光摸腿，还有更舒服的地方、\n想怎么摸都随你哦。"],["ねえ？どうする？」","呐？要试试吗？」"],["――まったく、\n面目ないというかなんというか。","――真是的、\n该说是丢人现眼还是什么呢。"],["立つ瀬がないというか。","或者说毫无立场可言。"],["完全に揶われてる。","完全被耍着玩。"],["初回の一撃で主導権は握られてしまった。","第一回合就被夺走了主导权。"],["端からこっちにはそんなもん無いわけだが、\nこんなとこにまできてまた女子に弄ばれる運命とは…","虽然我打从一开始就没这种东西、\n都到这种地步还要被女生戏弄的命运…"],["遊ばれるのは宮さんで馴れ――いや、十分だ。","被玩弄本该是宫小姐的专长――不、已经够了。"],["「もういいって…","「饶了我吧…"],["そういう逆セクハラはもう日常茶飯事なんだ…\nですよ僕は。","这种反向性骚扰已经是家常便饭了…\n对我来说。"],["これ以上女性不信の元を植え付けないでくれますか。","能不能别再加深我对女性的不信任感了。"],["それよりもちょっと、\nお話したいことがあるんですが――」","比起这个、\n有件事想和你们商量――」"],["「あー、\n丁寧語なんかやめてほしいな。","「啊—\n希望你别用敬语了。"],["年上なんだから。","毕竟你年纪更大。"],["きぃとも砕けて話してるんでしょ？」","明明和小贵说话时也很随意吧？」"],["「そうさまこちゃん、\nわたしと冬夏同い年だよ。","「就是啊真酱、\n我和冬夏是同岁哦。"],["これで冬夏にだけ他人行儀だったら\nわたしだけ酷い扱いなのだわ」","要是只对冬夏这么生分的话\n不就只有我受到冷遇了嘛」"],["格差社会の闇がこんな所にもあるのさ、\nと泣き真似をするきぃであった。","阶级社会的黑暗连这种地方都存在啊，\n小贵装模作样地假哭起来。"],["あのな…","我说啊…"],["「わかりまし…じゃない、\nあー、わかったよ。","「我明白…才怪，\n啊—，知道啦。"],["きぃ一人だけならともかく、\n僕は基本的に女性には丁寧語を使ってる日常なの。","光是小贵一个人还好说，\n我平时基本上对女性都会用敬语的。"],["切り替えが難しいんだよ」","切换起来很困难啦」"],["「ふふ、","「呵呵，"],["まあ私もね、\n家の中では良家の令嬢たれと強要されてるから。","其实我也是呢，\n在家里被强迫扮演大户人家千金。"],["気持ち分かるよ。","我懂这种心情。"],["よろしくてよお母様、なあんて喋ってるんだ。","整天得说着'母亲大人日安'这种话。"],["肩凝っちゃうよ？","肩膀都要僵掉了对吧？"],["じゃあせめて私たちだけでいるときは」","所以至少只有我们的时候」"],["素直な自分を出そうよ。","就做真实的自己吧。"],["と冬夏嬢が、顔を近づけてきて言った。","冬夏小姐说着把脸凑了过来。"],["青い瞳が一つ、金の髪の波うつ動きを伴い迫る――","碧蓝眼眸与金色波浪长发同时逼近――"],["「あ、ああ。","「啊、啊啊。"],["そうですか。","这样啊。"],["ま、僕の場合、もはや鯱張ってるほうが素なんです…\nなんだけどね。","不过对我来说，端着架子反而更自然…\n虽然是这样啦。"],["努力するよ。","我会努力的。"],["にしても」","话说回来」"],["きぃと同い年だったのな。","原来和小贵同岁啊。"],["とはいえ物腰はさすがに違う。","但待人接物确实不一样。"],["人をあしらうオーラというか、\n本人は嫌がるかもだが、先日会った冬夏嬢の母上殿、\nのぎかさんに通じるものがある。","该说是自带周旋气场吗，\n虽然本人可能会否认，但和前些天见过的冬夏小姐母亲、\n希香女士有相似之处。"],["宮さんとはまた別の感じ。","和宫小姐又是不同的类型。"],["「とにかく。","「总之。"],["ほぼ初対面の女子といきなりフランクに喋れるほどには、\n僕も若くもなければ老成もしてないって事。","我既没那么年轻能对初次见面的女生立刻熟络，\n也没老练到那种程度。"],["純粋に緊張してんです、だよ」","纯粹是紧张而已啦」"],["そう。","对了。"],["大体にして、今のこの状況は何。","说到底现在这是什么状况。"],["僕らは今公園のベンチに３人で座っているのだが、\n何故君らは僕を真ん中に据えるんですか。","我们三人现在坐在公园长椅上，\n为什么你们要把我夹在中间啊。"],["そうでなくてもあれだけ恥ずかしい紹介のされ方をし、\nむつける――むくれる、の意らしいが――わけではなく、\n単純に赤面してまともに顔を見られないというか\n喋ることができないでいたのだった。","即便没有那种情况 光是经历那么羞耻的介绍方式、\n倒也不至于闹别扭――据说这是方言说法――\n单纯是脸红到没法正眼看对方\n或者说不出话来了。"],["冬夏の…この容姿の件に関して気を遣うどころではない。","冬夏的…这副容貌让人根本无暇顾及礼节。"],["そういう意味では、\n普通に紹介されるよりは良かったのかもだが。","从这个角度来说，\n可能比普通介绍方式更好些。"],["「へーえ。","「嘿～"],["まことさん彼女さんとかいるのかな？","真言有女朋友之类的吗？"],["いいなーえろえろだ」","真好呀～色色的」"],["ざーんねん、","很～遗憾，"],["と言われても！","就算你这么说！"],["「や、え、えろって…","「才、才不是色色…"],["違うちがう！","不对搞错了！"],["てか女子が何言ってるデスカ！","话说女生在说什么啊！"],["僕ぁ彼女も居ないしエロでもない！」","我既没女朋友也不色！」"],["…いくら宮さんのセクハラには耐性があるとはいえ、\n（少なくとも外見上）年の頃が、\nより近い女子二人相手となると少々話が違う。","…就算对宫小姐的性骚扰有抗性，\n面对（至少外表）年龄更接近的\n两个女生还是另当别论。"],["ちょと刺激が強すぎます。","刺激有点太强烈了。"],["僕が旧態依然としてるだけなのか？","是我太老古板了吗？"],["今ってこんな世の中？","现在世道变成这样了？"],["「ふええ？","「呜诶？"],["じゃ誰にされてるのさ、セクハラ？","那到底谁在性骚扰谁啊，"],["大人の会話なのだわ」","这是成年人的话题哦」"],["「え？","「诶？"],["ああまあ、職場の上司とでも言おうかな…","啊这个嘛，算是职场上司吧…"],["そこにこれ以上引っ掛かんなくてもいいよきぃ。","小贵你不用再深究了。"],["そんなことよりも、冬夏さん、」","比起那个，冬夏小姐，」"],["「冬夏」","「冬夏」"],["「…うー、","「…唔——"],["冬夏。","冬夏。"],["いきなりで不躾なんだけども、\nその眼はどうしたの？","突然问可能有点冒昧，\n你的眼睛怎么了？"],["『ものもらい』かなにか？」","是长『麦粒肿』了吗？」"],["「あー。","「啊——"],["そうさ。","是啊。"],["私も聞いてないのだわ。","我也没听说呢。"],["どしたの」","怎么回事」"],["「ん？","「嗯？"],["ああ。","啊啊。"],["ま、","嘛，"],["そんなとこ。","就是那样啦。"],["気にしないで」","别在意」"],["あ、ちょっと歯切れ悪いな。","啊、回答得有点含糊呢。"],["いかな冬夏でもあまり触れて欲しくないとこだったか。","就连冬夏也有不太想被触及的话题吗。"],["話題転換に無難なネタのつもりだったんだけど…","我本来以为这是个安全的话题转换…"],["んー、まだ距離感掴めないなー。","唔——还是拿捏不好距离感啊——"],["うう、失態だった。","呜、失策了。"],["こちとら緊張もしてるし、空腹でも眠くもないのに、\n脳は空転してるのだ。","我这边既紧张，虽然不饿也不困，\n脑子却空转着。"],["少々気をしっかり持たねば。","得稍微打起精神才行。"],["ま、それより本題。","嘛、先说正事。"],["と彼女の方から話題の方向転換は為された。","而她主动扭转了话题方向。"],["きぃは『ふーん？』といった感じで、\n例のぎろりとした眼で冬夏を凝視していたが、\nそれ以上の追求はしなかった。","小贵露出『哦？』的表情，\n用那双标志性的锐利眼神凝视着冬夏，\n但没再继续追问。"],["「実は","「其实"],["卑","是关于"],["尊さんだけど」","卑尊小姐的事」"],["「あー。明日来るって聞いてるさ。","「啊。听说她明天要来。"],["それ伝えに冬夏ん家行ったのだわ」","我就是为传话才去冬夏家的」"],["「聞いたよ母様に。","「从母亲大人那儿听说了。"],["あの人、きぃのこといつまでたっても覚えないね。","那个人永远记不住小贵你呢。"],["初見みたいな反応したんでしょ？","反应就像初次见面对吧？"],["自分に得になる人間以外眼中にないんだ、あの人にとって。","对她来说没利用价值的人根本入不了眼。"],["まったく――」","真是――」"],["「いいよいいよ。","「没事没事。"],["覚えられても逆に厄介そうだしさ。","被记住反而更麻烦的样子。"],["気にしてないのだわ」","我不在意的」"],["ごめんね、と言いながら冬夏は話を続ける。","冬夏边道歉边继续说着。"],["ほぼ、僕を挟んで二人の会話になってるが、\nとりあえず要所で頷いたりしておく。","基本上变成她们俩隔着我的对话，\n我姑且在关键处点头附和。"],["…だから、\n言葉を発する度そんなに僕に密着せんで頂けますか。","…所以说，\n每次开口能不能别贴这么紧。"],["「実は今、あもう晴れたのかな？西の方、大雨なんだって。","「其实现在，啊雨停了吗？听说西边下大雨。"],["春の嵐だね。","是春天的暴风雨呢。"],["それで昨日新幹線とまったみたい。","所以昨天新干线好像停运了。"],["一日遅れるんだってさ。","据说要推迟一天。"],["つまり」","也就是说」"],["明日、土曜。","明天，周六。"],["「そう。","「对。"],["で、母様が直々に迎えに行くみたい。","然后母亲大人要亲自去接。"],["卑尊さんは中央で一日泊まって、\n迎え行って戻ってくるのは実際は日曜なんだ。","卑尊小姐所以会在中央住一晚，\n实际接到她回来要到周日了。"],["ふふ、ここ田舎だからね。","呵呵，毕竟这里是乡下呢。"],["まことさんも体験したと思うけど、移動時間かかるのね」","真言先生也体验过吧，移动很花时间」"],["「ああ、そりゃもう。","「啊，可不是嘛。"],["中央から朝に出発して、着いたの昼過ぎだったよ」","早上从中央出发，到这儿都过中午了」"],["飯を食う＋旅館までの行程を入れれば、\n完全に夕方だったけど。","算上吃饭+去旅馆的路程，\n完全就是傍晚了。"],["「母様も今回は珍しく自分で出向くんだよね。","「母亲大人这次难得亲自出马呢。"],["なんか私の眼の事で焦ってるみたいだけどね。","好像是为我眼睛的事着急。"],["あ、聞いてる？","啊、在听吗？"],["そう、卑尊さんは診療所の人で、\nそこはずっと主治医っていうか、\nうちの専属みたいになってるんだ。","对，卑尊小姐是诊所的人，\n那里一直算是我的主治医生，\n都快成我们家的专属医师了。"],["他の病院には私を診せたくないみたいでね、母様も。","母亲大人似乎也不想让我去其他医院看病呢。"],["その診療所が今、","那家诊所现在——"],["――ま、色々あって。","嘛，发生了很多事。"],["まだこんな痛々しい姿なわけ」","我还这副惨兮兮的模样」"],["そこでわたしバイトしてるのさ。","我在那儿打工来着。"],["言ったよまこちゃん」","跟真说过了哦」"],["聞いてます。","我在听。"],["そこがほぼ三春家専属で、今回死人が出たのもそこだと、\n宮さんから聞いている。","那里基本算是三春家专属，这次出现死者的也是那里，\n我从宫小姐那儿听说了。"],["一応知らぬ振りを装い、さも初耳のように反応しておく。","假装不知情，作出初次听闻的反应。"],["てか、仮にまともに診療所が稼動してても、\nそうそうすぐには全快しないでしょう。","话说就算诊所正常运转，\n也不可能这么快就痊愈吧。"],["「で。","「然后。"],["綾目とか狩屋の家にも用があるとかで、\nそれは出発前の話だけど、\n結構長めに母様は家空けるの。","说是还要去绫目和狩屋家办事，\n虽然是出发前的事了，\n母亲大人这次要离家挺久的。"],["他の家人とかは居るけど…」","虽然还有其他家人在…」"],["まあ多分大丈夫だね。","应该没问题吧。"],["と、冬夏は言った。","冬夏这么说道。"],["しばらく続きを待ったが、\n彼女は笑みを浮かべたまま会話はそこで途切れた。","等了片刻却没下文，\n她只是挂着笑容中断了对话。"],["…その自信の根拠は、特に説明してくれないんだな。","…这份自信的根据看来是不会特意说明了。"],["と、思い出した。","突然想起来。"],["知狡さんに、調査前に本家の用を済ませたいと言われてたっけ。","知狡阿姨说过想在调查前先处理本家的事来着。"],["丁度良いと言って良いのか、とりあえず、\nギリギリではあるが一日空くわけだ。","不知该不该说正好，总之，\n勉强算是空出一天时间。"],["この会談が終わったら即知狡さんに連絡しなくては。","会谈结束后得立刻联系知狡阿姨。"],["「なるほど。","「原来如此。"],["じゃあ大体はそういう感じか…","那大概情况就是这样…"],["詳しいことは――","详细内容――"],["何か食べながらにする？","要边吃边聊吗？"],["それとも人いないし此処の方がいいかな」","还是说这里没人更合适？」"],["「ちょっと待って、まことさん。","「稍等，真言先生。"],["まず携帯番号交換しよう」","先交换手机号码吧」"],["「あ、わたし持ったままだったね。","「啊，手机一直在我这儿呢。"],["はいまこちゃん。これ返すのさ。","给，小真。还你啦。"],["着信とか待ち受けとか何も見てないから","来电记录和待机画面我都没看"],["安心するのだわ」","尽管放心」"],["そうわざわざ断られると、\n逆に見られたと思わざるを得ないでしょうが、きぃ。","被这么郑重声明，\n反而会让人觉得被偷看了吧，小贵。"],["待ち受けなんてあれだぞおい。","待机画面那玩意儿很要命啊喂。"],["設定変えただけで…削除はしてなかったんだからな。","我只是改了设置…又没删除。"],["や、だってこの携帯借り物だし！","因、因为这手机是借来的啊！"],["決して変な意味で残してた訳じゃないですよ？","绝对不是故意留着奇怪的东西哦？"],["ま、まあ。","嘛、嘛。"],["ともあれ、実際あれが見られてたなら、\nきぃももっとドン引きしてるだろうから、\nここは信用しとくよ…","总之，如果真被看到了，\n小贵肯定会更嫌弃的，\n这次就相信你吧…"],["「あれ、つーか、さっききぃが冬夏に連絡してないの？","「咦，话说小贵没联系冬夏吗？"],["この携帯で」","用这部手机」"],["「ふえ？","「诶？"],["あ、そうなのさ。","啊，对哦。"],["履歴登録すればそれで済むのだわ」","存个通话记录就行啦」"],["そういえば。","说起来。"],["冬夏は知らない番号からでも、電話に出るタイプか…","冬夏是会接陌生来电的类型啊…"],["大神とはえらい違いだ。","和大神真是天壤之别。"],["「なるほどね。ありがとう。","「明白了。谢谢。"],["で、どうしようかな？きぃ」","那接下来怎么办？小贵」"],["「ん？平気なのさ。","「嗯？没关系啦。"],["どうせお客なんか人っ子一人いないのだわ。","反正店里半个客人都没有。"],["きぃをナめて貰っては困ると言ったはずだよ」","不是说好不能让你哄骗小贵嘛」"],["その辺のことも折り込み済みなのさ、\nと言ってるんだが…。","这些情况也都已经考虑进去了，\n虽然这么说着…。"],["それはおいほんとに美味い店なのか。","那家店真的有那么好吃吗。"],["「だってさ。","「因为啊。"],["ま、平日といえば平日だしね。","嘛，说是平日也确实是平日呢。"],["他の学生はね、久しぶりの再会だし。","其他学生嘛，毕竟是久别重逢。"],["みんなもっとプレイスポット的な所？に行ってるよ。","大家都去更像游乐场所的地方？了哦。"],["カラオケあーんどボウリング、お決まりコース」","卡拉OK还有保龄球，固定流程」"],["田舎だからね。","毕竟是乡下呢。"],["とまた笑う。","又笑了起来。"],["「んーまあ中央の方もそんなもんだけどね？","「嗯——不过中央地区也差不多啦？"],["僕も色んなとこ旅行したけどさ、\n要は情報入手の速度と頻度の環境が、\n整っているか否かだよ。","虽然我也去过很多地方旅行，\n关键在于信息获取的速度和频率的环境，\n是否完善而已。"],["中央と地方の違いは」","中央和地方的区别」"],["個人で能動的にアンテナを張る事は勿論肝要なわけだが、\n受動的に入ってくる領域の情報を受信出来るかどうかが、\n大きな差違だ。","个人主动架设天线固然重要，\n但能否接收到被动传入的领域信息，\n才是巨大差异所在。"],["と、大神はよく言っておりましたよ。","这是大神常挂嘴边的话哦。"],["「痛々しいローカル番組は中央にも同レベルのが山程あるし、\nだから田舎がどうとか気にしないでいいんでない？」","「惨不忍睹的地方节目在中央也有一大堆同水平的，\n所以乡下怎样都无所谓吧？」"],["別に気にしてないよ？","我倒没在意啦？"],["人多いところ嫌いだし」","本来就不喜欢人多的地方」"],["あ、そうですか。","啊，这样啊。"],["思わず僕の個人的趣向を語ってしまったじゃないですか。","不小心就暴露了我的个人喜好呢。"],["「行こう行こう。","「走吧走吧。"],["もう食べながらでいいさ。","边吃边聊也行啦。"],["そのためのぉ！お食事会合でしょおー？","这不就是为——此！准备的聚餐嘛——？"],["もうほらみてよ手が震えだしてるのだわ…」","你看你看手都开始发抖了啦…」"],["きぃがもうおかしなテンションになり、\n両手をこっちに突き出して来る。","小贵已经进入亢奋状态，\n把双手朝这边伸过来。"],["「おおう低血糖症かよ。","「哇哦低血糖发作吗。"],["じゃもう行こうか。","那就现在出发吧。"],["冬夏も、じゃ、宜しく」","冬夏也，请多指教」"],["「ただ、ま。","「不过嘛。"],["今のうち言って置くけど、\n私も詳しく全部知ってる訳じゃないよ？","趁现在先说清楚，\n我也不是所有细节都知道哦？"],["あの蔵に関しては……必要最低限の事しか教えられてないんだ。","关于那个仓库……只被告知了必要最低限度的事。"],["手引き役が出来るくらいで基本的にはきぃ達と一緒」","顶多当个向导 本质上和小贵他们没两样」"],["「まさにそこが大事だったんだからいいさ。","「关键部分清楚就够啦。"],["なんかあったとしても、\n逃げ足は速い方だから安心するのだわ」","真要出什么事，\n我逃跑速度可是很快的放心吧」"],["あのな、僕はどうなるよ。","喂喂，我怎么办啊。"],["「僕は――","「我――"],["…まあこうも急に話が進むとは思ってなかったから。","…没想到事情突然进展这么快。"],["今回特に成果がなくても、別に想定内だし。","就算这次没收获，也在预料之中。"],["だからあんまり責任も感じなくていいよ」","所以不用太有心理负担」"],["前半はともかく、これは勿論本心ではない。","前半段姑且不论，后半当然不是真心话。"],["ここでモノが見つかれば用事はほぼ済むのだし。","要是能找到东西就几乎大功告成了。"],["きぃにはまだ、「中が見たい」と言ってあるだけで、\n特定のモノを探している事も曖昧にしてある。","对小贵只说「想看看里面」，\n刻意模糊了寻找特定物品的事。"],["ん？","嗯？"],["と、いうより。","不对——"],["きぃも中が見たいから、こういう事態になったのだよな。","应该说是因为小贵也想看里面，才变成这种状况的吧。"],["彼女にも、目的があるということか？","她也有自己的目的？"],["それとも単なる好奇心か、或いは、\n僕と同じように何かを探している？","单纯是好奇心？还是说——\n和我一样在找什么东西？"],["…後者は考えすぎかなあ。","…后者可能想太多了。"],["と、冬夏がベンチから立ち上がった。","这时冬夏从长椅上站起来。"],["こちらを見ずに小さな声で、\n微かに呟いたのが聞こえた――","她没看这边，用很小的声音\n我听见她轻声呢喃――"],["ただとにかく――","总之无论如何――"],["私はヤソウのシュから逃れたいんだ――","我想逃离八相的诅咒――"],["そのためのハカイなら躊躇はしない。","为此即使是违背戒律也不会犹豫。"],["そう聞こえた。","听起来是这样的。"],["きぃがまたあの眼で、","小贵又用那种眼神，"],["じっと彼女を凝視していた。","直勾勾地盯着她。"]],"context":[["SC_M_007.ks/index/1/text"],["SC_M_007.ks/index/3/text"],["SC_M_007.ks/index/5/text"],["SC_M_007.ks/index/7/text"],["SC_M_007.ks/index/9/text"],["SC_M_007.ks/index/11/text"],["SC_M_007.ks/index/13/text"],["SC_M_007.ks/index/15/text"],["SC_M_007.ks/index/17/text"],["SC_M_007.ks/index/19/text"],["SC_M_007.ks/index/21/text"],["SC_M_007.ks/index/23/text"],["SC_M_007.ks/index/