:1476}],[{"start":1490,"end":1520}],[{"start":1526,"end":1550}],[{"start":1556,"end":1604}],[{"start":1618,"end":1643}],[{"start":1649,"end":1670}],[{"start":1684,"end":1694}],[{"start":1700,"end":1733}],[{"start":1739,"end":1775}],[{"start":1789,"end":1804}],[{"start":1810,"end":1820}],[{"start":1826,"end":1838}],[{"start":1844,"end":1869}],[{"start":1883,"end":1909}],[{"start":1915,"end":1968}],[{"start":1982,"end":2011}],[{"start":2017,"end":2043}],[{"start":2049,"end":2068}],[{"start":2082,"end":2120}],[{"start":2134,"end":2148}],[{"start":2154,"end":2173}],[{"start":2187,"end":2199}],[{"start":2205,"end":2232}],[{"start":2238,"end":2255}],[{"start":2269,"end":2283}],[{"start":2289,"end":2331}],[{"start":2345,"end":2348}],[{"start":2354,"end":2364}],[{"start":2370,"end":2382}],[{"start":2388,"end":2399}],[{"start":2405,"end":2418}],[{"start":2424,"end":2437}],[{"start":2451,"end":2546}],[{"start":2560,"end":2563}],[{"start":2569,"end":2577}],[{"start":2591,"end":2619}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_000.ks","basename":"SC_E_000.ks","indexIds":{"「今日はいつも以上に疲れたね。":0,"滑稽だったよ、お互いに」":1,"「はじめから単刀直入でもよかったのでしょうが。":2,"なにぶん突発的事象が起きたようで」":3,"「いいよ別に。":4,"もはや愉快さだけが至上だから。":5,"不確定要素の一つもないとね。":6,"せいぜい楽しくやるよ。":7,"で？」":8,"「これなのです。":9,"九相の封紙」":10,"「今はキミが使い手ということかな？":11,"『見えた』訳だ？　なるほど九相異羽か、\nキミにぴったりだね。":12,"それにしてもよく見つけたものだ」":13,"いずこかに『呼び水』でも現れたか？":14,"…まさかね。":15,"しかし、その都合の良さが『呼び水』の『呼び水』たる所以だ。":16,"件の突発的事象といい、あまりに事が起きている。":17,"出来損ないのプロットのようなこの状況はまさに『呼び水』の気配を感じさせる。":18,"―――気にはなるが、仮に真に『呼び水』ならば、\nそもそも手の打ちようはない。":19,"放置するのみだ。":20,"「恐縮です。":21,"ともあれ、これが見つかりましたので―――」":22,"「『狩り』の始まりか。":23,"ＷＣＬはチーム一隊送ってくる気なの？」":24,"「Ender:333がどうしても出たいと駄々を捏ねておりまして」":25,"「ふうん。":26,"でもま、とりあえず待機だね。":27,"場合によっては黙らせとかないと。全て無為になりかねないよ。":28,"例のEnderナンバーでしょ？　煩そうだったしなぁ。あの娘。":29,"兄様に釘刺しといてね。":30,"…そういえばノートも来る？　来てる？」":31,"「[ruby text=\"ル\"]Lu[ruby text=\"・リ\"]Leの赤の女王が動けば一石二鳥ですから。":32,"それでノート様筆頭にCovenの一部が来るようですが」":33,"Enderナンバーもそっちに回しとけば？":34,"あ、どっちにしてもWC_Sc:ThousandBrainsは来ないといけないか。":35,"結局一緒てことね。":36,"「我らが白様におきまして、\nこのような危惧は不要かとは存じますが…\n御健在であらせられますか？」":37,"「愉快なことになりそうならばね、\n万端と言って良いんじゃないかな。":38,"問題は彼さ。":39,"我が片割れたる『偽りの黒』、":40,"侍らすか、":41,"或いは喰うか、":42,"迷うところではあるね。":43,"彼自身はちょっと好きかもだからね。":44,"…兄様には内緒だよ」":45,"いずれにせよ、残る八相を揃えてからだけどね。":46,"「兄君様といえば、しきりにDeus ex machinaの顕現を望んでおられる模様でしたけど」":47,"「デウス？…んむ、そんなの現実化したら最悪の害悪じゃないの？":48,"あ、そうか、今回は有る意味それも『三重偉大』か。":49,"そんなもの期待して、どうなっても知らないよ…\n十二の悲劇が再来しないことを祈るのみだね」":50,"福音光輝十二の悲劇、あんなのは誰も望んではいまい。":51,"しかして『呼び水』が本当に絡んでいるなら…":52,"想像するだに笑える。":53,"兄様も自信がないのか。過剰なる悲をもってして喜劇に転ずるを望むか。":54,"君等よまずは視線を断て、\nもう降りようとて血みるまでは―――か。":55,"「キミは今回ここで留守番だね。":56,"出番が来たら呼ぶよ。":57,"巻き込まれても面倒だし。":58,"いざというときには封紙を確保しつつＷＣＬに戻って。":59,"くれぐれもLuLeの魔女どもには見つからないように。":60,"ほとんど残党はいるはずないけど、\n赤の女王が動けば、狩り逃した姉妹の残りが同調して動くかもだから。":61,"それはそれでアリなんだけど、キミでは対応できないだろうし。":62,"禅の協力を仰いで。単独行動慎んだほうがいいだろうね。":63,"残りはこの國に居るという噂もあったし」":64,"「…『つぇろる』の回収計画も目処が立ちつつあるという噂を聞きましたが―――」":65,"「それも今回の狩り次第かな。":66,"それともあのチームだけで動かすのかな。":67,"ま、いいよ。どっちでも。":68,"今更牧場を作ったところで美味なる肉など期待できないね。":69,"いまのとこ関与するつもりはないよ」":70,"さて、支度は整った―――か。":71,"あくまで遊び、つまらなければいつでも抜けるけど、\n今のところは、楽しめそう。":72,"さあ。":73,"八人姉妹の生き残り、":74,"赤の女王とその眷属ども。":75,"囚われし我が片割れを、":76,"彼奴らから取り戻す時かな。":77,"完成するか、魔眼の刺し手。":78,"角あるものの娘達、月に狂いて跳ねるもの、[l]\n我らが白き猫の[ruby text=\"わざ\"]業、それ見て笑え黒き犬、[l]\n皿や匙とて無かろうが、逃げるものらを狩りて喰え。":79,"では、":80,"遊戯を始めよう。":81,"\n　　　　　　　Omegaの瞳の祝福のあらんことを。":82},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_000.ks","relPath":"/data/scenario/SC_E_000.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":83,"length":83,"percent":100},"cacheResetOnChange":{},"cellInfo":[null,null,null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}]],"lastSelectedCell":[79,0],"note":"完成"},"/data/scenario/SC_E_001.ks":{"data":[["空腹の時と、[l]\n\n覚醒直後というのは、[l]\n\nリミットがゆるんでどうもいけない。","饥饿时分，[l]\n\n与刚觉醒之际，[l]\n\n限制松懈实在不妙。"],["\n脳が空転。[l]\n\nして。[l]\n\n自制が。","\n大脑空转。[l]\n\n导致。[l]\n\n自制力。"],["\n否、[l]\n\n判断の基準が、[l]\n\nより本能に忠実になって、[l]\n\n余計な、[l]\n\nヒトの作り上げた約款など些事に。[l]\n\nなる。","\n不，[l]\n\n判断基准，[l]\n\n变得更加忠实于本能，[l]\n\n多余的，[l]\n\n人类制定的规约皆成琐事。[l]\n\n如此。"],["\n思った事は即座に、[l]\n\n行動として顕現する、[l]\n\nフィルタなど作動してない、[l]\n\nホンネだ。[l]\n\n汚らしい。[l]\n\n僕は。[l]\n\n最低だ。","\n所思即刻，[l]\n\n化为行动显现，[l]\n\n过滤器完全失效，[l]\n\n全是真心话。[l]\n\n肮脏不堪。[l]\n\n我。[l]\n\n最差劲了。"],["\nコトが終わっても、[l]\n\nなんらかわらない、[l]\n\nくってしまった[l]\n\nいや[l]\n\nくうべくしてくった","\n即使事情结束，[l]\n\n也毫无改变，[l]\n\n已经吃掉了[l]\n\n不对[l]\n\n本就想吃才吃的"],["\nあのおんながぼくをそそのかしているのか[l]\n\nああ[l]\n\nのうがくうてんしてる","\n那个女人在怂恿我吗[l]\n\n啊啊[l]\n\n脑子空空如也"],["\nくうんだ[l]\n\nくい[l]\n\nクイ[l]\n\nクイがとまらない[l]\n\n喰いが[l]\n\n悔いが","\n好饿啊。[l]\n\n吃。[l]\n\n撕咬。[l]\n\n啃噬停不下来。[l]\n\n食欲。[l]\n\n悔恨感"],["\nこれは―――どうとも―――[l]\n\nまつりをまって―――[l]\n\n","\n这是―――无论如何―――[l]\n\n等到祭典时―――[l]\n\n"],["すべてを","将一切"]],"context":[["SC_E_001.ks/index/1/text"],["SC_E_001.ks/index/3/text"],["SC_E_001.ks/index/5/text"],["SC_E_001.ks/index/7/text"],["SC_E_001.ks/index/9/text"],["SC_E_001.ks/index/11/text"],["SC_E_001.ks/index/13/text"],["SC_E_001.ks/index/15/text"],["SC_E_001.ks/index/18/text"]],"tags":[],"parameters":[[{"start":115,"end":174}],[{"start":186,"end":229}],[{"start":241,"end":355}],[{"start":367,"end":499}],[{"start":511,"end":604}],[{"start":616,"end":678}],[{"start":690,"end":782}],[{"start":794,"end":844}],[{"start":889,"end":893}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_001.ks","basename":"SC_E_001.ks","indexIds":{"空腹の時と、[l]\n\n覚醒直後というのは、[l]\n\nリミットがゆるんでどうもいけない。":0,"\n脳が空転。[l]\n\nして。[l]\n\n自制が。":1,"\n否、[l]\n\n判断の基準が、[l]\n\nより本能に忠実になって、[l]\n\n余計な、[l]\n\nヒトの作り上げた約款など些事に。[l]\n\nなる。":2,"\n思った事は即座に、[l]\n\n行動として顕現する、[l]\n\nフィルタなど作動してない、[l]\n\nホンネだ。[l]\n\n汚らしい。[l]\n\n僕は。[l]\n\n最低だ。":3,"\nコトが終わっても、[l]\n\nなんらかわらない、[l]\n\nくってしまった[l]\n\nいや[l]\n\nくうべくしてくった":4,"\nあのおんながぼくをそそのかしているのか[l]\n\nああ[l]\n\nのうがくうてんしてる":5,"\nくうんだ[l]\n\nくい[l]\n\nクイ[l]\n\nクイがとまらない[l]\n\n喰いが[l]\n\n悔いが":6,"\nこれは―――どうとも―――[l]\n\nまつりをまって―――[l]\n\n":7,"すべてを":8},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_001.ks","relPath":"/data/scenario/SC_E_001.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":9,"length":9,"percent":100},"cellInfo":[null,null,null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[6,1],"note":"完成"},"/data/scenario/SC_E_002.ks":{"data":[["「あ、どうも、\nご無沙汰しとりますぅ。","「啊，您好\n久疏问候了。"],["…この國の言葉でよろしですか？」","…用这个国家的语言可以吗？」"],["「構わないよ。","「无所谓。"],["いつまで経っても嫌味な娘子だね。","你这小妮子还是这么讨人厌。"],["さっさと本題に入ろうじゃないの。","赶紧进入正题吧。"],["何やら厄介事があったって？」","听说出了什么麻烦事？」"],["「はぁ、本題いうても、\n元々は式に来て欲しいいうのが本題でしたから。","「哈，说是正题\n原本请您来参加仪式才是正题。"],["厄介事はあくまで突発的事故いうやつですぅ」","麻烦事纯属突发事故啦」"],["「だからいちいち揚げ足を取るんじゃないと\n言ってるんだよ。","「所以别老是鸡蛋里挑骨头\n我说过了。"],["どこの家の誰と誰が殺されたって？」","哪家的谁和谁被杀了？」"],["「二人とも東家ですけど。","「两位都是东家的人。"],["三と一の当主が。","三和一的当主。"],["あと七の当主が襲われましたが無事やそうですぅ。","还有七的当主遇袭但平安无事。"],["なんでも、傷口はぐっちゃぐちゃ、刃物とは到底思えない、\nいうなら熊にでも咬み殺されたような具合やったそうですよぅ」","据说伤口乱七八糟，完全不像是利器所致\n要说的话更像是被熊咬死的状态呢」"],["「６が何かしたということはないんだね？」","「6没做什么可疑举动吧？」"],["「そんなわけはない思いますけどぉ。","「我觉得不可能啦。"],["第一、■■ちゃんはどっぷりうちらの者ですし、\nまだツキノモノがきたばっかりのお子様ですぅ」","首先■■酱早就彻底是我们的人了\n还是个刚迎来凭附不久的小孩子呢」"],["「ふうん。","「哼嗯。"],["それにしても３がやられたんじゃ面倒だね。","不过3被杀确实很麻烦。"],["継承は？」","继承呢？」"],["「三には■■ちゃんがいてますし、\n一はもう、ちょっと前に済んでますなぁ。","「三呢有■■酱在\n一的话…前阵子已经处理好了。"],["七も問題はないですぅ。","七也没问题。"],["ただ、妊娠中やと聞いてますなぁ七の家は」","只是听说七那家的夫人正怀着孕呢」"],["「もう検査は？","「已经检测过了？"],["３が殺される前だったろうね？」","是在3被杀前吧？」"],["「難儀ですがまだやったそうですわぁ。","「虽然棘手但据说已经完成了。"],["■■ちゃんが本業も継ぎますんで問題はないですが、\nちょっと時間はかかってまうでしょうなぁ」","■■酱会继承主业所以没问题\n不过要花些时间吧」"],["「ふん。","「哼。"],["何から何まで厄介だね。","从头到尾都麻烦透顶。"],["７が動けるなら問題はないだろうけど、\n事態の進行を邪魔するこういった事象は\n大嫌いだよ」","只要7能行动就问题不大\n但这种妨碍事态发展的意外事件\n我最讨厌了」"],["「長年生きてはっても嫌なもんは嫌ですなぁ。","「活这么久还是会讨厌该讨厌的东西呢。"],["ま、今度の事は何とか処理して、\n早いとこ式を始めましょ。","总之这次的事会想办法处理\n尽快开始仪式吧。"],["二の■■ちゃんに早う会わせたいですよぅ。","想早点让二的■■酱见到您呢"],["びっくりしますよぉ」","肯定会大吃一惊哦」"],["「…あたしはそのために老体にむち打ってやってきたんだ。","「…我拖着这把老骨头过来就是为了这个。"],["今更無しとは言わせないよ。","事到如今别想说取消。"],["忌まわしき白の連中の眼を逃れるのも簡単じゃないんだからね。","躲避那些可憎白之众的耳目可不容易。"],["『八人姉妹』の再興に足る、それだけの価値があると、\nあんたが言ったからこうやってベロアも連れてきたさ。","既然你说值得为『八姐妹』复兴付出这样的代价\n我才特地把贝萝娅也带来。"],["それより７に早く犯人を追わせることだね」","现在更该让7尽快追查犯人」"],["「あはは、はぁ老体、ねえ。","「啊哈哈，说什么老骨头呢。"],["まぁ今代の娘達…殺された二人の跡継ぎも入れて、\n結構な案配ですよぉ。","不过这代的姑娘们…算上被杀两人的继承者\n阵容相当不错哦」"],["勿論このあたしも入れてですよぅ。","当然也包括我这个老太婆哟。"],["七の姉妹も、姉はダメでしたが妹の方がそらもう\n結構なもので――","七的姐妹里，姐姐虽然不行但妹妹可是相当\n出色呢――"],["再びアリスの血族の元に猫が集まる日も\n近いいうわけですなぁ。","猫咪们再次聚集到爱丽丝血族身边的日子\n想必也快到了吧。"],["そうすれば白の」","那样的话白之」"],["「ときに５の娘――」","「话说五的女儿――」"],["「？","「？"],["はぁ。","哈。"],["なんでしょ？」","什么事？」"],["「――あんた『ツェロル』に関して何か隠しておいでかぇ？」","「――你是不是藏着关于『赛萝洛』的事没说呀？」"],["「はぁ。","「哈。"],["『つぇろる』。","『赛萝洛』。"],["なんにもかくしてませんが」","我什么都没隐瞒哦」"],["「…あんたの言は極力吟味咀嚼してから判断したいもんだよ。","「…你的话我得反复琢磨才能判断。"],["『ツェロル』は我らの復興に重要な因子だ。","『赛萝洛』是我们复兴的重要因子。"],["あんたも知ってるとおりね。","这点你也清楚吧。"],["おかしなこと考えてると後々面倒なことになるよ。","要是动歪脑筋往后可有苦头吃。"],["正直に言うなら今のうちだ。","要坦白就趁现在。"],["どうなんだい。本当に何も隠してないのかぇ？」","怎么样。真的什么都没隐瞒吗？」"],["「どこかでそういうお話でも？」","「在哪儿听过这种传闻吗？」"],["「残りの『姉妹』達と『ツェロル』について\n本当に何も隠してないと？」","「关于其他『姐妹』和『赛萝洛』的事\n当真毫无隐瞒？」"],["「はぁ、なんにも」","「哈，完全没有」"],["「――まあいいさ。","「――也罢。"],["じゃそっちの準備は進めることだね。","那这边就继续准备了。"],["あたしらはしばらく休ませて貰うよ」","我们要稍微休息会儿」"],["「はぁ、わかりました。","「哈，明白了。"],["では、魔女殿。","那么，魔女大人。"],["さよぉならですぅ。","再见啦。"],["ベロアちゃんも」","贝萝娅也是」"],["「―――――――――」","「―――――――――」"],["「――――――」","「――――――」"],["「―――」","「―――」"],["「毎度のことながら小憎らしい娘さね。","「每次见面都让人火大的丫头。"],["魔眼の者で無ければとっくに始末してるところだよ」","要不是魔眼持有者早就处理掉了」"],["「あいつはうそつきだな、マスターミリアム。","「那家伙在说谎，主人米莉安姆。"],["うかつに耳を貸すと身を滅ぼすよ。","轻信会招致毁灭。"],["ほんとうはベロア来たくなかったよこの國」","其实贝萝娅根本不想来这个国家」"],["「わかってるよ。","「我知道。"],["これでもあの娘とは長い付き合いだからね。","毕竟和那孩子打交道很久了。"],["あんたには苦労を掛けてすまないけどね」","虽然给你添麻烦了，真是过意不去啊。」"],["「ほんとうにわかってるかい？","「真的明白吗？"],["それにあいつひとりが特別に扱われてるのは\n不当だな、マスターミリアム。","而且那家伙受到特殊对待\n太不公平了，主人米莉安姆。"],["会ったときから嫌いだよあの女」","从见面起就讨厌那女人」"],["「真のアリスの末裔を守り伝えるのがきゃつらに\n与えた役割さ。","「守护真祖爱丽丝的后裔本就是\n赋予她们的职责。"],["知ってるだろ。","你清楚的。"],["５はこの國では一番の魔眼の者だった。","5曾是国内最强的魔眼持有者。"],["しかし、\n下女には下女の分相応というものがあることを、\n忘れさせはしない」","但是，\n必须让下贱者记住自己\n应有的本分」"],["「マスターミリアムはアリスの一族のことになると\n視界がくもるのが危険だな。","「主人米莉安姆一牵扯到爱丽丝一族\n就会失去判断力，很危险。"],["それは相手が思い、決めること。","那本就是该由对方思考并决定的事"],["そもそもあいつがのさばってるのも、\n■■■■■の出来が悪かったせいだよ。","说到底那家伙能猖狂至今，\n都怪■■■■■不成器。"],["いい加減『LuLe』の呪縛から放たれたほうがいいな、\nマスターミリアム。","该早点从『LuLe』的束缚中解脱了，\n主人米莉安姆。"],["■■■■■はもう死んだ。","■■■■■早就死了。"],["よく似た子孫が生まれただけ。","只是诞生了相似的子孙。"],["…ベロアの肉も限界がちかいし無理は禁物だよ。","…贝萝娅的肉体也快到极限了别勉强。"],["こんなことをしなくても、\nベロアはベロアとマスターミリアムが心穏やかに暮らせれば\nそれでいいのに。","本不必做到这种地步，\n只要贝萝娅和主人米莉安姆能安稳生活\n就够了。"],["――聞こえてるかい、マスターミリアム？」","――听见了吗，主人米莉安姆？」"],["「ド―ミリア――もうすぐ…","「德―米莉亚――快要…"],["再び会えよう――」","再次相见――」"]],"context":[["SC_E_002.ks/index/1/text"],["SC_E_002.ks/index/3/text"],["SC_E_002.ks/index/5/text"],["SC_E_002.ks/index/7/text"],["SC_E_002.ks/index/9/text"],["SC_E_002.ks/index/11/text"],["SC_E_002.ks/index/13/text"],["SC_E_002.ks/index/15/text"],["SC_E_002.ks/index/17/text"],["SC_E_002.ks/index/19/text"],["SC_E_002.ks/index/21/text"],["SC_E_002.ks/index/23/text"],["SC_E_002.ks/index/25/text"],["SC_E_002.ks/index/27/text"],["SC_E_002.ks/index/29/text"],["SC_E_002.ks/index/31/text"],["SC_E_002.ks/index/33/text"],["SC_E_002.ks/index/35/text"],["SC_E_002.ks/index/37/text"],["SC_E_002.ks/index/39/text"],["SC_E_002.ks/index/41/text"],["SC_E_002.ks/index/43/text"],["SC_E_002.ks/index/45/text"],["SC_E_002.ks/index/47/text"],["SC_E_002.ks/index/49/text"],["SC_E_002.ks/index/51/text"],["SC_E_002.ks/index/53/text"],["SC_E_002.ks/index/55/text"],["SC_E_002.ks/index/57/text"],["SC_E_002.ks/index/59/text"],["SC_E_002.ks/index/61