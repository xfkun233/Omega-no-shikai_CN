94}],[{"start":15858,"end":15908}],[{"start":15940,"end":15945}],[{"start":16175,"end":16185}],[{"start":16209,"end":16271}],[{"start":16279,"end":16365}],[{"start":16373,"end":16427}],[{"start":16435,"end":16452}],[{"start":16513,"end":16559}],[{"start":16567,"end":16593}],[{"start":16625,"end":16657}],[{"start":16718,"end":16755}],[{"start":16763,"end":16816}],[{"start":16848,"end":16885}],[{"start":16909,"end":17004}],[{"start":17012,"end":17056}],[{"start":17064,"end":17113}],[{"start":17169,"end":17217}],[{"start":17278,"end":17302}],[{"start":17334,"end":17366}],[{"start":17432,"end":17465}],[{"start":17483,"end":17495}],[{"start":17503,"end":17540}],[{"start":17602,"end":17610}],[{"start":17642,"end":17649}],[{"start":17711,"end":17732}],[{"start":17764,"end":17773}],[{"start":17791,"end":17806}],[{"start":17814,"end":17816}],[{"start":17824,"end":17870}],[{"start":17878,"end":17945}],[{"start":18007,"end":18011}],[{"start":18020,"end":18021}],[{"start":18030,"end":18064}],[{"start":18088,"end":18163}],[{"start":18171,"end":18257}],[{"start":18265,"end":18308}],[{"start":18316,"end":18378}],[{"start":18386,"end":18446}],[{"start":18454,"end":18504}],[{"start":18536,"end":18603}],[{"start":18665,"end":18670}],[{"start":18694,"end":18751}],[{"start":18759,"end":18822}],[{"start":18830,"end":18857}],[{"start":18865,"end":18882}],[{"start":18913,"end":18933}],[{"start":18965,"end":19030}],[{"start":19092,"end":19106}],[{"start":19124,"end":19139}],[{"start":19201,"end":19214}],[{"start":19246,"end":19269}],[{"start":19277,"end":19324}],[{"start":19381,"end":19384}],[{"start":19392,"end":19421}],[{"start":19429,"end":19481}],[{"start":19489,"end":19527}],[{"start":19535,"end":19623}],[{"start":19631,"end":19677}],[{"start":19685,"end":19688}],[{"start":19720,"end":19798}],[{"start":19806,"end":19828}],[{"start":19836,"end":19904}],[{"start":19912,"end":19923}],[{"start":19934,"end":20012}],[{"start":20044,"end":20066}],[{"start":20084,"end":20094}],[{"start":20105,"end":20199}],[{"start":20231,"end":20298}],[{"start":20322,"end":20480}],[{"start":20590,"end":20631}],[{"start":20663,"end":20673}],[{"start":20719,"end":20761}],[{"start":20769,"end":20858}],[{"start":20866,"end":20930}],[{"start":20938,"end":20952}],[{"start":20960,"end":21021}],[{"start":21029,"end":21041}],[{"start":21073,"end":21079}],[{"start":21097,"end":21111}],[{"start":21119,"end":21133}],[{"start":21165,"end":21170}],[{"start":21188,"end":21196}],[{"start":21204,"end":21245}],[{"start":21253,"end":21262}],[{"start":21270,"end":21274}],[{"start":21282,"end":21332}],[{"start":21346,"end":21350}],[{"start":21410,"end":21424}],[{"start":21442,"end":21448}],[{"start":21480,"end":21507}],[{"start":21537,"end":21600}],[{"start":21618,"end":21630}],[{"start":21638,"end":21653}],[{"start":21661,"end":21696}],[{"start":21704,"end":21747}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_028.ks","basename":"SC_M_028.ks","indexIds":{"以前一階の土産屋部分には入ったことがあるので\n初見という訳ではなかったが、\n二階の語り部フロアには初めて入る。[l]\nこういう古民家系は、『ねこざんまい』とか本家とか、\n実生活に実際存在してた物だから、\nこう、格別日常と差異を見出しにくいというか、\n既視感がばりばりでよくわからなくなるんだなあ僕の場合。":0,"と言うか、食事処も二階にあるとは気付かなんだ。[l]\n只でさえ空転脳の所持者たる僕、飯窪真言、\n前回はその存在が分からなかったのですわ。[l]\n看板には民芸話の公演時間と料金しか書いてなかったし……[l]\n──否、よく見れば、それにも張り紙がしてあった。[l]\n今はそちらは中止してる、らしい。[l]\n忌中につき……か。":1,"しかし、祭は決行しようとしてるわけだ……":2,"人死にがあった正確な日時は僕も知らないが、\n祭りは月末だから、起きた日によってはぎりぎり忌明けしてる\nかも知れないが……[l]\n知狡さんが情報を仕入れた日イクォールだとすると、\n喪は四十九日ある訳で、\nまだ忌中の最中に祭を行うという事になる。":3,"こういう場合、\n神事仏事一般的にどっちを優先させるのかは知らないし、\n一般化しても仕方ないのだろうが、\nどうにも彼女達の祭りへの執念ともいえる態度は\n部外者から視れば不思議に思えなくもない。[l]\nそしてそれを見越してる本家、宮さん達。":4,"双方、一体何をしてるのか、否、したいのか。[l]\nその":5,"直":6,"中に駆り出された僕は、\nそれこそ一体、何をしてるんだろうかなあ。":7,"「話を担当する土地の古老にはね、\n多少出入りを遠慮してもらう事態……になったが故なのだよ。":8,"本来ならば祭の観光客を大量に捕まえられるタイミングなのだが\n致し方あるまいね。[l]\nまあ、当日辺りはどうなる…のかな？[l]\nそこまでは僕も関知してないのだなあ」":9,"その人達は三春の眷属というより、雇われのような距離感らしい。[l]\n長く歴史を持つ割に、実際の血縁者はそんなに居ないのだ。[l]\n少々不思議な事ではあるな……":10,"今朝の道具さんの話だと、三春の眷属──つまり東西併せた七家も、\n血縁集団同士ではないと言う事だし……[l]\n過去に三春という本家があり、\n分家に分かれたという訳ではないのだ。":11,"うーん、\nまあ、伝統、しかもカミサマがらみとあっては、\n個々の事情もあるし、さっき思ったように\n一般化など出来ないのだろう。":12,"長い歴史があるならば、\n逆にそれだけ変遷を経る期間があったという\n事で、その時々にしか分からない理由で何かがあったのかも知れず。":13,"「で、今ここを仕切ってるのは姫様君の姉、\n":14,"運君という訳だ。[l]\n勿論三春の家がバックアップはしてる筈だがね。":15,"まあ姫様君に負けず劣らず……否、姉だから順序は逆かもだが、[l]\n兎も角気の強いしっかりした女子だよ」":16,"「はあ……でも食事処は大丈夫なんですか？[l]\n従業員とか……」":17,"「だいじょぶですよー」":18,"「んだにゃあ。[l]\n腕のいい人がいるからにぇ」":19,"「少数精鋭なんですよー」":20,"「きーちゃと在夜っちの家はにゃな、\n昔からそうにゃん。[l]\nコスト削減にぇ」":21,"「少ない労力で大きな効果ですよねー、\nローコストハイリターンですよー」":22,"その言葉、":23,"遣い方合ってるのかな……[l]\nまあ、言ってることは分かるけど。":24,"うーん、\n……言っちゃ何だが、":25,"玄ノ森は観光地としてそれなりに人出はあっても、\n":26,"件の祭の時がメインだろうし、\nオフィス街でもないから年がら年中外食ランチの客が、\nという状況はあまりないのだろう。":27,"それこそ先日行ったあの定食屋とか、\n初日のドライブイン的ラーメン屋とか、\n学生か運搬業者さんの御用達の店というなら判るが、":28,"それらにしたって客層故に通学路か大通り沿いにある訳で、\n此処のように、明確な観光拠点の中の食堂では余程の事がないと\n店員を沢山抱える理由もなさそうではある。":29,"事実そういう理由かどうかは知らないが、\n……収容人数もそれほどのキャパじゃなさそうだし、[l]\nいずれ使う人間は少数でも事足りるのだろう。":30,"「ふうん……[l]\nメニューもそんなにヴァリエーションがない……[l]\nい、いや、厳選されたものばかりだしね！」":31,"「おー、\nこの芋団子とかおすすめなんですよー。[l]\n今日のコースに入ってたかな？」":32,"「ふむ、\nやっぱり最近の子は訛りがなくて少々物足りないなあ。":33,"メディアの力というのはだからこう、\n好みじゃないのだよ。[l]\n好きになれないね」":34,"「トモちゃんいっつも難しいこと言うから、\n在夜よくわかんないですよー」":35,"しかし、そう言う在夜ちゃんのイントネーション、\nやっぱり中央とはちょっと違うんだけど。":36,"アクセントの位置が、トモちゃんの『ト』じゃないってあんまり\n向こうじゃ聞かないパターンだなー。":37,"「そういえば価無ちゃはどうにゃんですの？[l]\nそれこそ、ばりっばりの西國訛り……」":38,"「あぁー、\nそうだねえ。[l]\n彼女は少々":39,"姦しい位のお喋りで……[l]\n『あれ』も久々に会って":40,"辟":41,"易してたがね」":42,"「あれ？へきえき？」":43,"「にゃにゃ、まだむずかしいにゃなー在夜っちには。[l]\nういもそういやまだ会ってにゃいけど──\n":44,"もう来てるんですに？」":45,"「おや、まだ会ってなかったか。[l]\nそうだね、\n僕は前入りしたけど彼女達は式の前日に到着した筈だから……[l]\nもう三春邸に滞在中だと思うよ」":46,"「カナ……ってどなた様？」":47,"「玖威価無、僕等西部の眷属、言ってなかったかな？[l]\nまだ小学生……中学生だったか。":48,"僕は向こうでも浮いた厄介者扱いなものでね、\n細事を把握できるほど密な交流をしてないのだよ。[l]\nすまないね」":49,"ああ、聞いてたような聞いてないような……[l]\n玖威家自体の事は勿論宮さん達からも聞いているが、\nしかし名前と年齢層は初耳だった気がする。[l]\n……そろそろ脳が空転もしてるしな！":50,"「まあ、この辺りの方言は目上とかに喋るには\nフランク過ぎる印象だしね……[l]\n西國辺りの強烈な主張を持った訛りとは違うし、\n僕とか初対面の相手にはなかなか使いにくい、よねえ？」":51,"まさに今朝、\nそういう話をしたのだ。[l]\n道具さんと。":52,"「んだっちゃ？\nとか、[l]\nんだべ？\nとか、":53,"よっぽど仲良い友達同士じゃないと\n出ないですねー」":54,"「んーだべなー」":55,"僕も出身地とは言え早々に中央に越した為、\nうっすら知ってる程度なのであった。[l]\n決して記憶力があれだからではない！":56,"そのうろ覚えの訛りでも、\n在夜ちゃんには通じたようだった。":57,"「んだ。[l]\nわかってっちゃ」":58,"「んだや、つかえんだっちゃ。[l]\nあんだなにす、わだしのまえではさっぱどしゃべんねのにっさ、\nやんだのすか、きらいなんだべ」":59,"「んだごといってねっちゃ、\nあに、あんだそんなむつけんすなぁー。[l]\n":60,"あっはははははっ。[l]\nすごいですねぇートモちゃんはー」":61,"いやいやいや、いつもは仰々しい喋り方で思わず忘れますけども、\n道具さん、貴女は確か西國の人ですよね……[l]\nそっちの訛りはおくびにも出さないのに一体何故。":62,"「気にしたらだめにゃぜ兄ぃ、\nペース乱されるだけにゃ……」":63,"「あ？[l]\nあ、ああ……」":64,"まあ、此奴も特殊な喋り方だけど……[l]\n今にして思えばそういや、\n以前視せられた大神のチャット人格とやらがこんなだった気が。":65,"アナクロ人間にはどうにもついていけない領域というか、\n端から視るとなかなかに奇異な光景だった覚えがある。[l]\n悪いとは言わないけど……\nリアルを知ってると違和感ばりばりなのは否めませんですよ。":66,"僕も元はこの辺の人間だとは言っても、\n本家の人間、知狡さん始め宮さんもチノ嬢も、\nそれこそ大神の彼女さんもあんな喋りだし、\nそもそも幼少期の記憶が──":67,"しろのしろ。[l]\n\nわれは──":68,"はっ。[l]\n何かフラッシュバックと言うか、\n気が遠くなった。[l]\n……お腹空いて更に脳が空転し出したか。":69,"朝飯はおにぎりで、途中土産物のバナナなんとか食したとは言え、\n身体の疲労に加え、……あの出来事で精神的に相当疲弊したし。":70,"「にしても姫様ちゃん、まだかな？」":71,"姫様ちゃんは到着するなり、\n準備があると言ってどこかに行ってしまった。":72,"狩屋は手伝うか":73,"在":74,"夜ちゃんの相手をするか迷った挙げ句、\n楽しみは後にとっとくとか言って、\n今そこで在夜ちゃんと遊んでる訳だが。":75,"ととととと、と様子を窺いに行きかけた在夜ちゃん、\n何かの気配を感じたのか途中で立ち止まり、\nこちらに向けて言った。":76,"「あーっ、":77,"姉":78,"様今くるですよー」":79,"「！！」":80,"「ふむ、待ちかねたね」":81,"「おお」":82,"在夜ちゃんが向かっていた先の、\n厨房というかスタッフオンリー的な扉が開き、\nそこから出てきた──":83,"ややや？":84,"──誰？":85,"「…お待たせしました」":86,"姫様ちゃん？":87,"あれ髪の毛が……":88,"──あ、ああ～ウィッグか！":89,"「いやしかし、これはこれは……」":90,"これは店員と言うかウェイトレス……なのかこれ。[l]\n言っちゃ悪いけど田舎の土産屋にしては、\nかなりアヴァンギャルドな制服だなあ。":91,"大神とかから聞いて情報だけは知ってる、\n中央の某電気街にあるというメイドなんとかの類？":92,"いや、特徴的な制服のファミレスは昔からあったと聞くが、\nまあいずれそういう店は、\nこっちが入るのに気後れするのだけど僕の場合。[l]\n大神からも一度誘われたけども固辞した過去もあるし。":93,"アナクロ人間にはどうにも……それは関係ないか……":94,"つーか、\nわざわざカツラまで装着するんだ……[l]\nすごいこだわりと言うか……[l]\n僕が女装させられたのにはこういう背景があったのかも知れないな。":95,"和装をベースに、前髪の揃ったおかっぱでロングのウィッグ、\nエプロンが無ければ所謂この國の\nトラディショナルドールといった風情。":96,"そうか、座敷童がモデルかな？[l]\n六母屋も妖怪推しで売ってるし、\n土地柄としては正しい判断かもなあ。":97,"──狩屋の眼福ってこれのことか。[l]\nそういや前に、しばらく視てないから視たいなーとかなんとか\n言ってたような。":98,"「にゃ～～ん、きーちゃぁちょぉぐっじょぶにゃんですけど！！[l]\n写メ撮っていい？いい？」":99,"ああ、やっぱそのようだな……[l]\n眼がハートになっとる。[l]\n只でさえ女子のツボはわからんのに此奴のは更に複雑だからなあ。":100,"いやいや、姫様ちゃんが可愛くないと言ってる訳じゃないけど。[l]\n主に女子に視られるその手のテンションがどうにも、\n理解に苦しむだけ。":101,"と、\nそこで姫様ちゃんは何か発声練習的な行動をし出した。":102,"「……ん、んんっ。[l]\nあ、あー。[l]\nごふっげふげふん」":103,"咳き込んだ。[l]\n気管にいったなあれ。":104,"だ、大丈夫か……[l]\n":105,"先":106,"刻の追跡が効いてるのか、\n否、単純に後片付けも肉体労働だった訳で、\n少々疲れが出てるのかしらん。":107,"お、立ち直った。":108,"「いらっしゃいよぐきたこど、\nゆっくりしてけさい～」":109,"うっ！[l]\n訛りは兎も角これは、\nえ、営業ヴォイスだ！":110,"流石にチノ嬢の声帯模写並のギャップはないけど、\n普段が普段だけに結構驚いた。":111,"しかし、すぐにいつもの調子に戻って続けた。[l]\n今のは決まり文句みたいなもんだったのかな。[l]\nコンビニの『いらっしゃいませこんにちわ～』的な？":112,"「今日は色々お手伝いいただきありがとうございました。[l]\nこれより御礼のお食事を振る舞いたく」":113,"ま、まあ、\n表情の方はまだ堅いね。[l]\nやっぱり劇的に変えるのは本人も恥ずいのかも。":114,"ウィッグつけてるんだし突き抜ければ良いと思うんだけど、\n……そこは我が身を思い起こしてしまい、[l]\nこれ以上は何とも言えぬ。":115,"「まあまあ姫様君、\n今日はお硬い挨拶は抜きにしようじゃないか。[l]\n肉体労働の後だし、君自身も大変だろう。[l]\n大丈夫、彼も気に入ってくれてるよ」":116,"「え？[l]\nあ、うん、似合ってるよ、\nいい感じっす」":117,"ちょぉぐっじょぶ！とも言おうとしたけど、[l]\n馬鹿にしてると思われても困るし止めておいた。[l]\n取り敢えず親指を立ててみせると、\n照れたのか、頬を赤らめて俯く姫様ちゃん。":118,"「真言さんは……」":119,"「？」":120,"「写メは……」":121,"「え？[l]\nあ、ああ、では折角だから……」":122,"じ、自分からっ？":123,"……ばしゃばしゃ写メ撮ってる狩屋を視てると、[l]\nなんかこう気が引けるというものだけども、\nこの場合、撮らない方が失礼ぽい流れになっとるし。":124,"携帯を向けると、\n何気にポージングをとる姫様ちゃん。[l]\nしかし、僕のシャッター音より\n狩屋のが数倍回多く鳴り響くのであった。":125,"僕を弄るでもなく突っかかるでもなく、\n黙々と撮影してる狩屋。[l]\nう、うーん。":126,"てかねえ、アナクロ人間には写メ撮る習慣がないんすよ。[l]\nレンズ向けるのもシャッター押すのにもいちいち抵抗が……[l]\nそれこそメディアでそう言う場面を客観的に視せられて、\nあれな印象植え付けられてるからかもだけど。":127,"大神あたりは、\n写真はがっつり専門機たるデジカメで撮るしね。":128,"取り敢えず、二、三枚撮らせていただきました。[l]\nすると微笑ましく見守っていた在夜ちゃんが、":129,"「よろしいですか皆様ー？[l]\nえとですねー、\n今日は貸し切りですからー。":130,"コースは姉様が考えましたけど、\n":131,"ゴエンリョなくお好きなものを言ってくださいねー」":132,"と言った。":133,"当然と言っては失礼だけども本格的に前菜やら主菜やらがどうの、\nというフルコースが元よりある訳ではないので、\nそれに相当するような感じを在りモノのメニューから\n姫様ちゃんが見繕ったという事らしい。":134,"デザート類は充実してそうだけどメインは何だろ？":135,"「にゃふぅー、堪能したにー。[l]\n":136,"ささ、ごっはんごっはん！」":137,"「まずは山菜でオードブルなのですよー」":138,"「あ、お茶も今のうちにくれるかい？」":139,"「畏まりました」":140,"ま、折角だし愉しみにしとくか。":141,"──にしても、":142,"交流が深くなればなるほど、\nやはり心のどこかで罪悪感が増していくのは否めない。[l]\nそうだ、なんで僕は、":143,"「どうぞ、粗茶ですが」":144,"「あ、ありがとう」":145,"姫様ちゃんが皆の前に湯飲みに注がれた良い香りの茶を\n配膳していく。[l]\n手伝う在夜ちゃん。":146,"あれ？[l]\n今何か僕は、\n……。":147,"一瞬浮かんだ基本的にして致命的な疑問は、\n今ので打ち消されてしまい、\n二度と思い出せなかった。":148,"僕の煩悶を余所に、\nあちらはあちらで何かしら面倒そうな気配の会話を\nしてる模様。":149,"「運君はやっぱり顔出さないか」":150,"「はい」":151,"「ここんとこ色々で忙しいのでー。[l]\n（ちょっと機嫌わるいんですよー）」":152,"「ふむ。[l]\nまあ、しっかり者ではあるが恥ずかしがり屋でも\nあるからなあ。[l]\nそっとしておくか」":153,"道具さんにしては殊勝な態度を示し、\n誰に向けてともなく":154,"「自分と自分以外、\nたった二人でも彼我が揃えば諍いも起こるか……」":155,"言ってることは至極普通の事だが、\n今この状況で具体的に何を指すかまでは当然僕に判る筈もなく、\n自分の記憶力に悶々とし":156,"乍らも、\n今は前菜を食すのみ。":157,"うーん、\n旅館のとも違う、何とも言えぬ素朴な味わい。":158,"「じゃ、御礼は言っておいて呉れ給え。[l]\n今日も美味いよこれは」":159,"「はぁーい、\n伝えときますよー」":160,"姫様ちゃんもそうだが、母親亡くした直後だろうに、\n健気というか、\n精神的にダメージを受けてる感じは微塵もないように\n視えるなあ。":161,"三春という大きなバックの庇護があるから心配していないのか、\n":162,"外":163,"見は明るく振る舞っても心で泣いてるのか、\n兎に角強い子達なのか、":164,"―― 人死になど意に介さない程に薄情、\nという線は無いと思いたいけど。":165,"まあ……運姉さんとやらは、[l]\nなんか顔出してもくれないようだし、色々あるのかも知れないな。":166,"「次はですねー、\nお吸い物ですよー、ええとですね……」":167,"何か具体的な名前を言われたけども、\n要は……まあその名の通りお吸い物で、[l]\nつみれか何かが具のあっさりめのものであった。":168,"何はともあれ、\n出されたものを有り難く戴きます。":169,"メインディッシュはいきなり定食みたい──量は流石にそれなりで、\nレディースセットみたいな──なのが出てきた。":170,"単体メニューとしては、\n山菜そばと鶏肉丼のセットらしいが、\n本来付いていたであろう味噌汁と漬け物は外されてたようだ。[l]\nまー、前菜とスープとかぶるしね……":171,"きぃあたりだったら全部単体時のボリュウムでも\n喰い尽くすんだろうが、僕的には丁度良い。[l]\nちなみに親子丼ではないが生卵が単品で添えてあった。[l]\n杉屋の愉快メニューのようでこれはこれで。":172,"何というか、\n食材の一個一個がいちいち美味いなあ。[l]\nやっぱり水からして違うとこうも変わるものか。":173,"水に関しては宮さんも最初から言ってたことだが、\n向こうで水道水自炊したってどうにもならんように、\n構成する素材が根源から違うんでは比較のしようもないね。":174,"食は生命の基本だものなあ、\n状況的に複雑な気分ではあるけれど、\nしっかと噛みしめましょう……":175,"あらかた全員がメインを食した頃に、\n例の芋団子とやらも出てきたが、\n形状としては餅に近く、かなり不思議な視た目＆味だった。":176,"や、旨いんだけど、あまり他にこういう食物を視たことないので、\n例えるのが難しいな。[l]\nそして最後に例の『ねこまたのしっぽ』が配られて、\n何茶か判らないが心地よい風味のあるお茶で締め。":177,"「ほんとは善哉とかにしたかったんですけどー、\n人数分はすこーし大変だったのでー。[l]\n手抜きですけどごめんなさいー」":178,"「あ、だいじょぶ気にしないで、\nというかこちらこそ色々とありがとうです。[l]\n十分戴きました」":179,"「……これ……」":180,"「？[l]\nあ、ああ、え？[l]\nくれるの？」":181,"未開封１５個入りの『ねこまたのしっぽ』を、\n土産として手渡された。":182,"「いえ……今後ともうちを宜しくお願いします」":183,"こうやってほのぼのとした":184,"遣り取りをしてると、\nどうしてもカウンター的に罪悪感が湧き上がってしまう。[l]\n冬夏に至っては、\n式の潜入からこっち秘密のままで何も言ってないし──\n……彼女達とも、まるで暫く会ってないような錯覚に陥るが、[l]\nそもそも知り合ってから数日しか経ってない仲なんだよな。[l]\nいや、きぃは昔会ってる──かも、という状況だが──としても、\n付き合いとしては短い期間であろう。":185,"それでもこうしておかしな具合に交流があったり、\n気に掛かったりするのは、\nやはり感情移入というか、接触の仕方が強烈すぎて、\nまるで長い付き合いの仲というか、\n昔から知ってる同士の間柄のような、\nうーん、それはこっちに来てから会う人会う人みんな\n強烈ではあるけども、[l]\n@r非日常的イヴェントの共有による錯覚なのかなあ。":186,"吊り橋の出会い……は違うか。[l]\n学生は文化祭後にカップル出来まくり的心情効果とでも言おうか……":187,"まあ、それは兎も角。[l]\n何度も言うようだが、僕等は決して敵対したい訳じゃないし、\n穏便に事が進むならそれに越したことはないのだから、[l]\n@r……":188,"刻忘れてしまった基本的な疑念、[l]\nそれが引き起こす不安、\n罪悪感が何故か頭を離れない。":189,"普段は空腹の脳空転の時に起こる、\n精神の安定を欠く状態が今、食後に起こるのは珍しい。[l]\n@r二律背反……[l]\n@rそんな言葉も頭をかすめるが、":190,"「どうしたね少年。[l]\n流石に疲れたかい？[l]\nそれとも眠いのかな？[l]\n食事の後は血が胃に行くしねえ」":191,"そう、\n結局僕の思考はそこまでで、\nあとは身体の欲求に勝てません。":192,"「うーん、そうかも知れませんけど、\n大丈夫です」":193,"程よく冷めたお茶を眠気覚ましに飲み干して、\n僕は気を立て直した。":194,"不安は消えていたが、\nチョーカーを巻いた首が熱い。":195,"そこからは、腹ごなしに若干の雑談──\n僕は流石に愛想振りまく程度で、\n突っ込んだ話は出来なかったけども──をしていると、":196,"柱に取り付けられていた古い振り子時計が丁度二時の鐘を打ち、\n切りが良い時間という事で解散する事になった。":197,"今夜には正式名称を『":198,"栖":199,"後":200,"奉":201,"仕』というらしい、\n今日の一連の後片付け、つまりどんと祭のような本祭儀が\n行われるらしいが、":202,"やはり僕が潜入……いや、手伝いだろうと参加出来るような\nものではないようだ。":203,"念のため訊いてはみたものの、":204,"「一応提案ですけど……[l]\nもしそちらさえ良ければ、\n片付けの本作業の方もですね、\nお手伝いは出来ますが」":205,"「おうあ、だめにゃよ」":206,"「……」":207,"「ふむ。[l]\nお心遣いは有り難いし、\n個人的には是非ともお願いしたいところなのだがね。":208,"やはりこれは……家の問題、プライベートな行事だからね。[l]\n気持ちだけ貰っておくよ」":209,"ということで矢張り駄目だった。[l]\n今日の収穫は、報告するには\n少々微妙な感じになってしまったなあ……[l]\n姫様ちゃんへの話もご期待に添えたかどうかだし……":210,"「ま、少年とはこれからも長い付き合いになりそうだからね、\n先も言った通り、我等の身内になることがあれば、\nいずれご助力を願う事もあるだろう。[l]\n諸々話せる事も増えるだろうが、」":211,"そこで道具さんは眼を瞑り視線を断った上で、":212,"「誰を選ぶかという問題もあるからね。[l]\nそこは是非慎重に選択をして貰いたいところだなあ」":213,"「ぶふっ」":214,"「げほっ、げほげほ」":215,"慌ててお茶を飲む。[l]\n自分だけが弄られてるなら兎も角、\n第三者が絡む話をされるとリアクションが難しい……":216,"その点宮さんは、たいがい自分を肴に話を振るから楽は楽だね。[l]\n幸い、姫様ちゃんも狩屋も格別反応しないので助かった。[l]\n流石身内、馴れてるのかしらん。":217,"在夜ちゃんは単に分かってない感じだが、それでよい。[l]\nそのまま純朴に育っていただきたいものよ……":218,"と、道具さんがある提案をしてきた。":219,"「ふむ、ともあれだ、\n日曜には恐らく──\n祭の実行の如何が決定されるだろう。":220,"君にも連絡してあげようと思うが、\n嫌かね？」":221,"「え？[l]\nあ、いえそこは是非、お手数でなければ……」":222,"「僕の番号は……これだね。[l]\n君のは後で克杖君から聞いておく。":223,"克杖君だね知ってるのは？[l]\nああそう。[l]\nそれこそ冬夏君にお願いしても良いのだが」":224,"「ああ、その辺はお任せします。[l]\nご迷惑にならない方法で……」":225,"正直、冬夏には色々黙ったままなので、\n若干気が引けるが、\nここで誰それが良いです、とはっきり指定すると……[l]\nまた色々と面倒なイジリが始まりそうだったので止した。":226,"提案自体は有益だし。[l]\n──まあ、ほぼやる方向で確定してるんだろうけどね……":227,"冬夏も眷属一派とは仲は良くないようだから、\n妥当な線で道具さん本人か狩屋からの連絡とみた。":228,"「じゃーですね、\n（そろそろ運姉様が怒りそうなので）\nおひらきにしましょうかー」":229,"「ふむ、\n僕もそろそろ用足しに行くかな」":230,"「あ、今日はほんとに御馳走様、\n大変に美味しかったです」":231,"「じゃーういは片付け手伝ってぇ、\n今晩は増血食にゃのうー」":232,"ごちそうさまでしたぁ～。":233,"皆が席を立って各自動き出すと、\n姫様ちゃんがとことこと寄ってきた。":234,"「……真言さん」":235,"「あ、なに？」":236,"「（あとで……二人きりでお話したいです）」":237,"「え、ええっ？！」":238,"思わず狩屋の様子を確認する僕。":239,"……":240,"幸か不幸か、奴は既に在夜ちゃんと後片付けに精を出しており、\nこちらには気付いてない。":241,"や、ま、まあ気にすることでもないんだけど、\n通例こういう場面では彼奴が面倒ごとを、と思ったからで、\n別に他意はないよ！":242,"「今すぐ":243,"何":244,"時とは言えませんが……[l]\n近いうちに必ず連絡しますから」":245,"情報収集の意味合いで今日は全く進展がなかった、\n否、道具さんから聞いてもいない大量の情報供給はあったとは言え、\nそういう感じだったし、":246,"僕も姫様ちゃんには、\nあの式に関してちゃんと話せてなかったしなあ。[l]\n大神からの忠告があるから、\nどこまで言えるかどうかという問題はあるにしろ、":247,"聞いている人間が限られる状況ならば、\n多少は込み入った話も出来るかも知れない。":248,"なので、\nこれは、\n言い方が悪いと言うか、姫様ちゃんには悪いかもだけど、\n渡りに船なのかも知れない。":249,"……よもや、[l]\nあまり自分で言うと自意識過剰臭いので言いたくはないが、\n告白される訳じゃないよねえ。":250,"おほほほほ。[l]\nうへへへへ。[l]\n──狩屋がどう誤解するかが面倒どころだけど。":251,"「えーと、\nまあその、\n取り敢えず大丈夫だと思う……から、[l]\nじゃあ都合の良い時にでも連絡くれればいいよ」":252,"「はいっ」":253,"周りを見回すと、\n道具さんは既に居らず、\n狩屋と在夜ちゃんも厨房の方に行ったらしく誰もいなかった。":254,"嵐の去った春の日の午後、\n異様な程の、静けさと澄み渡った空気を透過してくる光、\n五感が冴え渡るようなこの感じ。":255,"ああ、[l]\n思考が鋭敏化すると不安が生じる。":256,"だから僕はいつも脳を空転させて……":257,"「──とさん？[l]\n真言さん」":258,"「……え、[l]\nあ。ごめん。[l]\nぼーっとしてた、\nじゃ、じゃあ帰るよ、あんまり力になれなくて御免ね」":259,"「いえ、そうじゃなくて……」":260,"？[l]\nな、なんだ？":261,"「お土産……忘れもの……」":262,"「えっ。あっ！！[l]\nご、ごめん！！":263,"ほんっとに申し訳ない！！[l]\n失礼しました！！[l]\n有り難く戴きます！！」":264,"──。":265,"店の外に出ると、\n道具さんが車で出るところだった。":266,"見送りに降りてきた姫様ちゃんと僕に向かって\n手を振りながら、何処かに向かって車を走らせていった。":267,"騒がしい人、というと語弊があるな、\n場を引っかき回す人であったなあ。":268,"まあミコ……卑尊さんがあんな態度だったのも頷ける。[l]\nしかしきぃも大変な人に見込まれたものだ。[l]\n宮さんに振り回されっぱなしの僕が言うのもあれだけど……":269,"僕ぁ、\n最早、周囲の全てから振り回されてると\n言っていいんじゃないかしらん。":270,"さて、":271,"姫様ちゃんとは後でマンツーマンで話す機会が出来たとして、\n今後はどうしたものか。[l]\n道具さんから祭の開催に関しても情報は貰えそうだし……":272,"何にせよ宮さんにお伺いを立てる他ないかなあ。":273,"今し方歓待を受けたとはいえ、\n早起きに加え肉体労働、精神負担も大きかったし、\n今夜はがっつり休眠したい気分ではあるけど。":274,"疲れの度合いで言ったら":275,"件の式の時の方が何倍も\nしんどかったのだが、\n今日は単純にその日の分が加算されてるからかねえ。[l]\n式直後よりもぐったり感がある。":276,"「……取り敢えずこの土産でも献上しようっと」":277,"宮さんにはあげないと":278,"煩そうなので確定としても、\n是非知狡さんには日頃の感謝を込めて食して戴きたいところ。[l]\n地元民として珍しくも何ともないかも知れないけど、\nなんか最近元気ないし。":279,"「じゃあ帰るかぁ。[l]\nまるでこの嵐の後の静けさの中を……あれ？[l]\n嵐の前、だっけ。[l]\nまあいいや」":280,"独り言を言いつつ土産を小脇に抱えて、\n僕はこの、\n異常に透き通った空気と無慈悲な陽光の中、\n冷たい風に吹かれながら宿への帰路を歩き出した。[l]\n帰りは徒歩って、今考えると変な計画たててもうたな……[l]\nまあ腹ごなしになると思えば丁度良いか。[l]\n眠くなってたし。":281,"六母屋が視えてくると、[l]\n駐車場横の植え込みの石垣に人影が確認出来た。":282,"「（……おんや？）」":283,"その人影は、\nパーカーのフードを目深に被り、\n膝を抱えて座っている。":284,"どうやら女性のようだけど、\nでかいスポーツバッグを横に置いたままである。[l]\n宿泊者ならばチェックインすればいいと思うんだけど、\n──早く来すぎたとか？":285,"いや、幾ら知狡さんでも、\nそこまで融通利かない事はないよな……[l]\nまずあの人が受け付けする訳じゃないだろし、":286,"まさか、\n不審者…？":287,"宮さんの悪戯にしては……[l]\n身長がちっとある感じだし、\nあの人はもうちっと直接的でピーな事をするしな！":288,"ちょっと凝視しすぎたか、":289,"「……ぅっ」":290,"その人物がこちらに反応した。":291,"すると、ざっ。と立ち上がり。":292,"「おそい」":293,"あああ、あ、れ？":294,"僕の眼前まで早歩きでやってきて、\nぶわさっとフードを取り払ったその人物は、":295,"宮さんではなくて、":296,"ふふふ。":297,"そこには泣き笑いのように口を尖らせて、\nしかしガーゼを当ててない方の碧い眼には不敵な笑みを\n":298,"湛える、":299,"「おかえりなさい、真言さん」":300,"冬夏が居た。":301,"「とぁっ、と、う、\nた、たた、ただいもん……」":302,"「おっ。[l]\nじゃあおかいもん！ってなにそれ？[l]\n変なの、おもしろいね。[l]\nあっははははは」":303,"今日も事が起こりすぎる。":304,"まだ、終わらないっていうのか。":305,"現実感の無い事象が立て続けに起きて、[l]\n僕は目眩を覚えた。":306,"思わず後ろ手にお土産を隠してはみたけれど、[l]\n色々覚悟が必要、かもなあ……":307},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_028.ks","relPath":"/data/scenario/SC_M_028.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":308,"length":308,"percent":100},"cellInfo":[null,null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"t":"HU","v":1}],null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,[null,{"v":1}],null,[null,{"t":"HU","v":1}],null,null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,null,null,[null,{"t":"HU"}],null,null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],null,[null,{"t":"HU","v":1}],null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,null,[null,{"t":"HU","v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"t":"HU"}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[11,1],"note":"完成"},"/data/scenario/SC_M_029.ks":{"data":[["「……久しぶり。えへへ」","「……好久不见。嘿嘿」"],["「ああ、久しぶり……[l]\nって、なん、何で此処に、いやその、あれ？」","「啊、好久不见……[l]\n等等、为、为什么你会在这里、不是、那个？」"],["僕の眼の前に立ち、下から僕を見上げる冬夏。[l]\n小首をかしげ、僕の眼をじっと直視する。","站在我面前仰头望来的冬夏。[l]\n歪着脑袋，直勾勾盯着我的眼睛。"],["数秒後、","数秒后，"],["「あぁ～～～～～～～っ、もう！！！[l]\nがーーーーーー！！！！！[l]\nうんっ！！」","「啊～～～～～～～真是的！！！[l]\n嘎————！！！！！[l]\n嗯！！」"],["溜めを入れたと思ったら、\n突然ハイテンションで捲し立て始めた。","刚以为她在蓄力，\n突然就情绪高涨地连珠炮起来。"],["「寂しかったよぉ～ここんとこずっと！！[l]\n聞いてよもおっ、\n前言ったけどさ、気が重い出来事が\n次から次へと満載だったの！！","「人家超寂寞的啦～这段时间一直！！[l]\n听我说嘛真是的，\n之前也提过，烦心事\n接二连三堆成山啦！！"],["きら……苦手な親戚がわんさか来たりさ、[l]\nあーもうやだやだやだやだやだ！[l]\nストレスの塊！[l]\n今の私！！","讨厌……不擅应付的亲戚扎堆出现，[l]\n啊——烦死了烦死了烦死了烦死了！[l]\n我现在！！[l]\n就是压力集合体！！"],["きぃも具合悪くて電話しづらくて話し相手も\nいなかったのっ！！","小贵身体不舒服很难打电话连说话对象\n都没有啦！！"],["やることいっぱいあったし誰と話しても\n愚痴になりそうだから気は遣うしもう\nおかしくなるのもうねえあたたたた頭痛くなっちゃった、","要处理的事情一大堆和别人聊天\n又怕变成抱怨还得顾虑对方\n都快疯掉啦啊啊啊头好痛，"],["急に人と喋ったからかなあ、\nねえ真言さん聞いてる？[l]\nだっっっっっっれも話す相手いなかったんだから！","突然和人说话可能有点亢奋，\n喂真言君在听吗？[l]\n因·为·根·本·没·人·能·聊·天·啊！！"],["あ、こ、こういうとまるで私が友達いないみたいだけど、\nいいんだよ殆どの女子は会話がなりたたないし\n心配してくれるポーズばっかで興味本位なだけの\n態度なんてもううんざりだよーー！","啊、这、这样说搞得好像我没有朋友一样，\n不过没关系啦反正大部分女生都聊不起来\n要么摆出一副担心的样子要么只是出于好奇\n这种态度真是受够了——！"],["折角此処まで来たのに真言さんは居ないし\n何処に行ってたの？[l]\n愚痴聞いてそして同情してよもぅー！」","好不容易来到这里真言先生却不在\n你去哪里了啊？[l]\n快听我抱怨然后同情我嘛真是的——！」"],["「えっとーーーーーーー……[l]\nご、ご愁傷様……です」","「那个——————……[l]\n请、请节哀顺变……」"],["完全にのけぞって話を聞いてた僕が、\n頼りなさげに何とかそう口にすると、","完全后仰着听她说话的我，\n用不太可靠的语气勉强说出这句话后，"],["「じゃあさ、\n取り敢えず？」","「那这样，\n先暂时这样？」"],["両手をノーガード気味にだらんと垂らした。[l]\n眼、眼が据わってるのは何故なのでしょう。[l]\nすると、","她双手像放弃防御般软绵绵地垂下来。[l]\n眼、眼睛这么直勾勾的是怎么回事啊。[l]\n接着，"],["「ねえ、\n──慰めてっ」","「我说，\n──安慰我啦」"],["突然がばり、と、","突然哗啦一下，"],["「な、さ、あうあ？！[l]\nおわああっと！！！」","「等、等等啊呜啊？！[l]\n哇啊啊啊！！！」"],["抱き付かれた。[l]\n奇跡的に土産を落とさずに済んだものの、\n反動に対抗するためにこちらも思い切り抱き返す形になり、","被她抱住了。[l]\n虽然奇迹般没把伴手礼摔掉，\n但为了抵抗冲击力我也不得不使劲回抱住她，"],["結果、[l]\nう、こ、これって……[l]\nな、なんたるけしからん状況に……！","结果，[l]\n呜、这、这个……[l]\n这、这成何体统的状况……！"],["「……」","「……」"],["「……うな゛っっっ！！！」","「……呜哇啊啊啊！！！」"],["「！？！？」","「！？！？」"],["と、三秒もしないうちに、\n顔を真っ赤にしながら突き飛ばす様に身体を離し、","然后不到三秒，\n她就满脸通红地像推开般挣脱身体，"],["「さ、さすがにちょっとはしゃぎすぎたっ。[l]\nはぅあーもうやばいやばい。","「果、果然有点玩过头了。[l]\n哈呜啊——完了完了。"],["あ、ごめんね、\nちょっとテンションおかしいの。[l]\nあははっ」","啊、对不起，\n我有点情绪亢奋。[l]\n啊哈哈」"],["自分の顔をぱたぱたと手で","冬夏用手啪嗒啪嗒地"],["扇ぐ冬夏。[l]\n表情は既に、いつものさばさば顔になっていて、\n涙目に視えた右眼も、\n今視ると普通だった。","给自己扇风。[l]\n表情已经恢复成平常的爽朗模样，\n刚才看着泪汪汪的右眼，\n现在看也恢复如常了。"],["……流石に顔はまだ赤いけど……","……不过脸确实还红着……"],["「じ、自分が照れるくらいならやりなさんな、\n年頃のお嬢さんなんだから……[l]\nこういった事はだな……[l]\nその、なんというかちゃんとした相手にですね、」","「既、既然自己都会害羞就别这样啦，\n好歹是妙龄大小姐……[l]\n这种事情应该……[l]\n那个、怎么说呢要找正经对象才行，」"],["「ぷっ」","「噗」"],["「な、なんすか」","「怎、怎么」"],["「真言さん変わんないなーと思って。[l]\n癒し系？[l]\nなんかこう、好き、その感じ。うん」","「觉得真言先生真是一点没变呢。[l]\n治愈系？[l]\n就这种地方，喜欢。嗯」"],["「はあ、そりゃあよござんした……[l]\nよくわからんけども……」","「哈啊、那可真是太好了……[l]\n虽然不太明白……」"],["「そそそ、そういうねぇ、\n","「对对对、就是这种，\n"],["がっついてないとこ？[l]\n枯れてる感じ？[l]\n好き」","不会穷追猛打的感觉？[l]\n像枯木般沉稳？[l]\n喜欢」"],["きぃも前に馬鹿力で抱き付いてきたし、\n三春の蔵から帰るときに姫様ちゃんも抱き付いてきたし、\n僕は何かしらそういう事を促す要素でも？","之前小贵也用蛮力抱过来，\n从三春仓库回来时姫様也抱过来了，\n难道我身上有什么诱发这种行为的要素？"],["それとも玄ノ森では、\n外つ國のコミュニケーション文化が流行ってるとでも？","还是说在玄之森，\n流行起外国的交际文化了？"],["知らぬ間に色々弄られた事はあっても、\n宮さんにすら抱き付かれた事はないのに──\n……や、引き合いに出すことでもないんだけど。","虽然以前也被各种捉弄过，\n但连宫小姐都没抱过我——\n……啊、不过这事也不值得拿出来比较。"],["「だからそう、簡単に好きとか言うなって事なんだけども……[l]\n男子の側で誤解を招くでよ……」","「所以说啊，别那么轻易就把喜欢什么的挂在嘴边……[l]\n会让男生这边产生误会的啦……」"],["「え、何？[l]\n聞こえなかった。","「咦、什么？[l]\n没听清。"],["それに私が照れたのは変なテンション\nみせちゃったからで、\n抱き付き自体はノープロだよ？[l]\n膝枕してあげた仲でしょ。","再说我会害羞是因为是因为表现出了\n奇怪的亢奋状态啦，\n至于拥抱本身完全没问题哦？[l]\n我们可是连膝枕都做过的交情。"],["もっと色々しても良いって言ったしさー。[l]\nしてくれないけど真言さん」","之前也说过可以更进一步的嘛——[l]\n但是真言先生从来不肯主动呢」"],["「……。[l]\nどうやら、あなたも変わってないようで……[l]\nまあ、元気が出たなら何より、\nよかったよかったウフフアハハ」","「……。[l]\n看来你也一点都没变呢……[l]\n不过，能打起精神比什么都好，\n太好了太好了呜呼呼啊哈哈哈」"],["「あ、でも今思いっきり抱きしめてくれたから\nいいや。[l]\n人肌恋しかったんだー」","「啊、不过刚才被你用力抱住过了\n所以没关系了。[l]\n人家只是寂寞了嘛——」"],["ああそう……[l]\nというか、\nだからにゃんでここにいるんだ、","啊这样……[l]\n话说回来，\n所以为什么你会在这里，"],["いや、此処に宿泊してるって話は暗にとは言え\n確かにしたけれど……","不对，虽然确实隐约提过要在这里留宿\n但这也太突然了……"],["「え、わたし？[l]\n泊まることにしたから。[l]\nしばらく此処に。[l]\nお部屋、ご近所さんになるかもって事でよろしく」","「咦、我？[l]\n因为决定住下来啦。[l]\n暂时会待在这里。[l]\n房间就在隔壁，请多关照咯」"],["「は？[l]\nえ？ほんとに？[l]\nいや、その前に、なんでまた？？」","「哈？[l]\n诶？真的假的？[l]\n不是、在那之前，为什么突然？？」"],["「おっかえり～まこくん、","「欢迎回来～小真，"],["お！」","啊！」"],["「あっ！[l]\nた、ただいま戻りまして……」","「啊！[l]\n我、我回来了……」"],["なんつータイミングで！","这什么时机啊！"],["「あ？[l]\nだれ？[l]\nどちらさま？」","「嗯？[l]\n谁？[l]\n这位是？」"],["ど、どうしたらよいのでしょう！？[l]\n完全に知人だとはバレたのは間違いないけど……","该、该怎么办才好！？[l]\n虽然明显已经暴露是熟人了……"],["「まこくんの職場の上司でぇす♪」","「是小真的职场上司哟♪」"],["はや！[l]\n何の","好快！[l]\n毫无"],["躊","犹"],["躇いもなく僕等のそばまで来ると、\nこれまた何の躊躇いもなくそう言い放つ宮さん。","豫地就凑到我们身边，\n又毫无顾忌这么宣布的宫小姐。"],["ていうか反応がちょっと冷静というか、\n戸惑い無さ過ぎじゃないすか。[l]\n突発事象に馴れすぎというか？[l]\nそれともこれが女子の精神構造というやつかしらん。","倒不如说反应是不是太冷静了，\n完全不见慌乱啊。[l]\n是对突发状况太习以为常？[l]\n还是说这就是女生的精神构造呢。"],["「えーとその、前言ってた、\n……そういうこと、あはははは……[l]\nあれ、今日何かすることあったとか……」","「那个、之前说过的，\n……就是这么回事，啊哈哈哈……[l]\n咦、今天是不是有什么安排来着……」"],["「え？？[l]\nえっ？！[l]\nで、でもっ！？","「诶？？[l]\n什么？！[l]\n但、但是！？"],["……。[l]\n……。[l]\n","……。[l]\n……。[l]\n"],["どう視ても……ええ？！」","怎么看都……诶诶？！」"],["僕と宮さんの顔を交互に見返し、\n混乱する冬夏。[l]\n──分かる分かるぞ。","来回看着我和宫小姐的脸，\n陷入混乱的冬夏。[l]\n──我懂我超懂的。"],["「うひひっ☆」","「嘻嘿嘿☆」"],["舌をぺろりと出しウインクしてみせるけれども、\n有無を言わさぬオーラを発しているのも\n分かります。","虽然吐着舌头眨眼睛卖萌，\n但散发着不容反驳的气场\n这点我也很清楚。"],["「は、はあ……[l]\nあの、その、初めまして……」","「啊、啊……[l]\n那个、这个、初次见面……」"],["「『みため』に関しては詮索不要がお互いベストでしょ？","「关于『外表』还是别互相深究比较好吧？"],["さ、\n改めまして自己紹介、\n宮はまこくんの職場の上司で宮岡門王水といいます、\n玄ノ森には月末の祭を視に長期滞在旅行で来ましたぁ。","那、\n重新自我介绍一下、\n我是小真的职场上司宫冈门王水、\n来玄之森是为了观赏月末祭典长期旅行哒。"],["宮達二人でね」","我们两个人哦」"],["そうか、冬夏も……[l]\nだからなのか、\n妙に納得したように視える。[l]\nそれ以上深く考えるのは止したようだ。","这样啊，冬夏也……[l]\n所以才会、\n看起来莫名地接受了。[l]\n似乎不打算继续深入思考了。"],["宮さんも一応飯窪との関連は伏せる方向で\n話をしていくつもりらしい。[l]\nにしても、状況への順応が早いよなあ……","宫小姐似乎也打算暂时隐瞒和饭洼的关系\n来展开对话。[l]\n不过她对状况适应得还真快啊……"],["「わ、私は、み、……三春、冬夏です。[l]\n真言さんとは先日知り合って、\n色々聞いてます」","「我、我是、三、……三春冬夏。[l]\n和真言先生是前几天认识的、\n听说了不少事」"],["「こっちも色々と聞いてますよぉ。[l]\n","「这边也听说不少呢～[l]\n"],["六","是来六"],["母屋にお泊まりに来たですか？[l]\n","母屋住宿的吗？[l]\n"],["でも、失礼ですけど、三春と言えば……」","不过失礼问一句，说到三春家……」"],["「えー……っと、","「呃……那个、"],["その、\n私は確かに──地元、の人間ですけど、\n個人的な事情がありまして、\n確かに、泊まるつもりで来ました」","这个、\n我确实是──本地人没错、\n但有些个人原因、\n确实是打算来住宿的」"],["「んむ。[l]\n深い詮索はしませんよ。[l]\nぎぶあんどていくです！","「嗯哼。[l]\n不会深究的啦。[l]\nGive and take！"],["まー、\nご近所さんになったら宜しくですよ。[l]\nまこくんのことも色々と」","嘛～\n成为邻居就请多关照啦。[l]\n还有小真的各种事」"],["「こ、こちらこそ宜しくお願いします……」","「请、请多关照……」"],["「じゃ、まこくん、\nまだ宮は色々することあるので。[l]\n今は其方様とごゆっくり～。[l]\n","「那小真、\n宫还有事情要忙。[l]\n现在请和那位慢慢聊～[l]\n"],["また後でねー」","回头见咯」"],["宮さんはひらひらと手を振ってまた中に入っていった。","宫小姐轻飘飘地挥手又进了屋里。"],["静かになり、\n数秒惚けていた僕等二人だったが、\n我に返った冬夏が開口一番、","恢复安静后、\n发呆数秒的我们俩、\n回过神的冬夏开口第一句、"],["「……まこ、くん？[l]\nって呼ばれてる、ん、だ？」","「……小真？[l]\n她是这么叫你的？」"],["と突っ込んできた。","就突然吐槽。"],["「え、あ、その、まあそうね……」","「诶、啊、这个、算是吧……」"],["そして更に、\nぐっと顔を寄せて小声で、","接着又、\n猛地凑近压低声音、"],["「（前聞いたとき確か、\nセクハラ受けてるって話、聞いた覚えがあるんだけど。","「（之前听说的时候、\n好像有印象是遭遇性骚扰来着。"],["ねえ。[l]\n記憶違い？[l]\n真言さん）」","喂。[l]\n我记错了吗？[l]\n真言先生）」"],["「えあ、そのですね、セクハラと言いましても、\nプラトニックなと言いますか、あのその、\nあくまで言葉責め？の範疇で？」","「呃这个嘛，说是性骚扰、\n但更接近柏拉图式或者说、那个、\n仅限于言语骚扰？的范畴？」"],["「ふぅん……[l]\nまあ、面白そうなひとではあったけど……[l]\n","「哼嗯……[l]\n不过看起来是个有趣的人呢……[l]\n"],["にしても可愛らしい上司さんですのねぇー。[l]\n","但还真是可爱的上司小姐呀～[l]\n"],["そーか、あういうのが……ほほう……」","原来如此，那种类型……哦豁……」"],["ジト眼になったりニヤリ眼になったり忙しそうだが、\nそろそろ僕弄りも停めて頂きたい頃合いです。","她眼神时而死鱼眼时而坏笑忙个不停、\n差不多该停止捉弄我了吧。"],["「まぁた君等女子はそうやっておかしな方向に\n話を持ってこうとする……","「你们女生总爱把话题\n往奇怪的方向带……"],["はやく宿泊手続きした方がいいんじゃないの？[l]\n事情は僕も深く詮索はしないよ。[l]\n愚痴はまあ、聞くだけでいいなら聞くけどさ」","还是快点办住宿手续比较好吧？[l]\n具体情况我也不会深究啦。[l]\n抱怨嘛...要是只听不说的话我倒是可以奉陪」"],["道具さんから何となく事情、というか、\n冬夏がこういう行動をとる背景を今日聞いてるので、\n取り敢えず差し障りのない話題にすり替えてみる。","从道具小姐那里隐约听说了些内情——\n今天已经了解到冬夏采取这种行动的背景，\n总之先试着把话题转移到安全范围。"],["「あ、そだね。[l]\nちょっと行ってくる」","「啊对哦。[l]\n我去去就回」"],["「あーい」","「好~的」"],["──待てとも部屋に戻れとも、\n付いてきてとも言われなかったけども、\n何となく勝手に移動してはいけない気がして、\n僕はそこに立ち尽くしていた。[l]\n一応、ずっと僕を待ってたようだしなあ……","──既没说等等也没让我回房间，\n甚至没叫我跟着走，\n但总觉得擅自移动不太合适，\n我就这么呆站在原地。[l]\n毕竟看起来她一直在等我嘛……"],["にしても、\n女学生が一人、という状況で、旅館側はどう対応するのだろう。[l]\nましてや冬夏のことは地元民として知らない訳はない。[l]\n僕や宮さんなら兎も角、知らぬで誤魔化せるものではないだろう。[l]\n先刻の宮さんの態度を視る限り、\n泊める気は満々のようだったが、\n……知狡さんを説き伏せるつもりかなあ。","话说回来，\n单独一个女学生的情况下，旅馆会怎么处理呢。[l]\n更何况冬夏作为本地名人不可能不被认出来。[l]\n我和宫小姐姑且不论，装不认识是行不通的吧。[l]\n从刚才宫小姐的态度来看，\n倒是很有留宿的把握，\n……该不会打算说服知狡阿姨吧。"],["彼女が手の内に在るという状況は、\n考えようによってはかなりのチャンスではあるのだろうが、\n遣り方次第によっては深刻な亀裂を産みかねない。[l]\n例えば、\n三春の者をそれと知って宿泊させるのは、\n後々冬夏のおっかさんが探しに来たときに面倒そうとか、\n只でさえ未成年の彼女を果たして……","虽然能把她纳入掌控范围的情况，\n某种意义上可说是绝佳机会，\n但处理不当可能造成严重裂痕。[l]\n比如说——\n明知是三春家的人还允许留宿，\n等冬夏母亲日后找来时会很麻烦啦，\n更何况她本来就未成年……"],["……後は宮さんが変な弄り方をして怒らせるとか？","……话说之后宫小姐不会又乱开玩笑惹恼对方吧？"],["ふと視界の端で何かが激しく動いた。","忽然视野边缘有什么东西剧烈晃动。"],["視るとロビーの受付から、\n冬夏がこちらに向かって手を振ってる。","转头看见大厅柜台处，\n冬夏正朝这边用力挥手。"],["「まあ、一応有力者の娘だから？[l]\nちょっと手間取ったけど説得出来たよ。[l]\n母様が探しに来るまでは視て見ぬふりしてくれるってさ。","「毕竟是有头有脸人家的大小姐？[l]\n虽然费了点功夫但说服成功啦。[l]\n说好在母亲找来前会睁只眼闭只眼呢。"],["ほんとはこんな、\n母様みたいな真似したくはないんだけどねー、\nこっちもなりふり構ってらんないの。","其实这种——\n模仿母亲大人的做法我也不喜欢啦，\n但现在也顾不上体面了。"],["勿論此処に居ること秘密だよ？[l]\n……あの","当然我在这里的事要保密哦？[l]\n……那个"],["娘達にもね」","对她们也要保密」"],["さっすが、腐ってもお嬢様ですなあ。[l]\nと、言おうとして止めた。[l]\n色んな意味で禁句というか地雷な感じがする。","真不愧是，落魄了也还是大小姐呢。[l]\n正要说出口又咽了回去。[l]\n总觉得在各种意义上都是禁忌话题。"],["今考えていた事を考え併せると、\nまあ飯窪側も諸々の事情を込みで、\n従順に受け入れるポーズを取ってみせたんだろうなあ……","结合刚才的考虑，\n饭洼家应该也是综合各种因素后，\n才摆出顺从接受的姿态吧……"],["今のタイムラグの隙に、\n宮さんが受付にでも仕込んだのかな。","说不定是趁刚才的时间差，\n宫小姐在柜台做了什么手脚。"],["「……へえ、[l]\nまあ取り敢えず良かったね。[l]\nどれくらいになるかは兎も角、\nよろしく……」","「……嘿，[l]\n总之解决了就好。[l]\n能维持多久姑且不论，\n请多指教……」"],["「で、それ、何持ってんの？」","「所以，你拿着什么？」"],["「はっ！」","「啊！」"],["土産物！！","伴手礼！！"],["さっき宮さんに渡せばよかたよ！","刚才给宫小姐就好了！"],["「ああ、そのさっきの上司にね、\n好きそうな土産物があったから。[l]\n買ってきたのデス」","「啊，就是刚才那位上司，\n看到有合她喜好的土特产。[l]\n就买回来了desu」"],["「ふーん。[l]\nさっき渡せば良かったのにね」","「哼~嗯。[l]\n刚才给掉不就好了嘛」"],["全く以てその通り……","完全无法反驳……"],["あの娘達にも秘密、ていうのは勿論、\n姫様ちゃんと狩屋だろうから、\n今し方まで和気","对那群女孩保密当然是必须的，\n毕竟有姫様和狩屋在，\n要是被冬夏知道直到刚才还和她们"],["藹","和"],["々と過ごしてたと知られたら、","和睦睦地相处的话，"],["……。","……。"],["悪いことをしてる訳ではないんだけど、\n無駄に詳細を伝えて機嫌が悪くなられても互いにとって\n良いことないし、\nここは敢えてぼやかします。","虽然我们也没做什么坏事，\n但多余地透露细节惹冬夏不高兴的话对双方都\n没好处，\n这里就故意含糊其辞吧。"],["下手をすれば女装の件にまで\n言及しなければならなくなるしな！","搞不好连女装的事\n都得被翻出来说呢！"],["今後の冬夏との接触機会の増加に当たって、\n宮さん、くれぐれも僕にとっての地雷を踏まないよう頼みます。","考虑到今后和冬夏接触机会会增加，\n宫小姐，请务必别踩到我的地雷啊。"],["「ま、後でどうせ飯とか喰うだろうし、\n一旦僕も部屋に戻るよ」","「反正待会总要一起吃饭，\n我先回房间一趟」"],["「そっか、帰ってきたとこだったもんね」","「也是，你才刚回来嘛」"],["「うん」","「嗯」"],["「ね、真言さん」","「呐，真言先生」"],["「な、なに？」","「怎、怎么了？」"],["「今からすることある？[l]\nドライブいきたい。[l]\nだめ？[l]\n疲れてる？」","「现在有空吗？[l]\n想去兜风。[l]\n不行？[l]\n累了吗？」"],["「え？[l]\nえーと……」","「诶？[l]\n呃……」"],["携帯電話で時間を確認する。","用手机确认时间。"],["二時半。","两点半。"],["しかし、飯窪の関係者だと告白していない……\nというか隠してる現状では、[l]\n旅館の車を借りていく訳にもいかない…だろう。","但还没坦白和饭洼家的关系……\n不如说现在正隐瞒着，[l]\n也不好借旅馆的车…吧。"],["多少疲れてはいるけれど、\nまあ運転するくらいなら特に支障はないかな……[l]\n拒否する程の強固な理由もないし……","虽然确实有点累，\n不过开车应该没什么问题……[l]\n也没有强硬到必须拒绝的理由……"],["「免許はあるし、──上司との打ち合わせは夜だろうから、\nまあ構わないけど、\nレンタカー屋って近いっけ？」","「驾照是有的，──和上司的会议在晚上，\n倒无所谓，\n租车行离得近吗？」"],["「ちょっとだけあるけど。[l]\n歩きで１０分くらいかな」","「稍微有点距离。[l]\n步行十分钟左右吧」"],["「じゃあちょっと部屋に戻って、\n上司に一声かけてくるよ、\n冬夏も荷物置いてきたら？」","「那我回房间\n和上司打声招呼，\n冬夏也去放行李吧？」"],["「あ、行ってくれるんだ。[l]\nさんく！[l]\nじゃ、ロビーで待ってるね」","「啊，愿意陪我去啊。[l]\n三克油！[l]\n那我在大堂等你」"],["「荷物大丈夫？[l]\nなんか結構重そうだけど……」","「行李没问题吗？[l]\n看起来挺重的样子……」"],["「学校ふけると家に連絡いったりとか面倒だから、\n教科書とか持ってきたからっ。[l]\nだいじょぶ気にしないで、それより早く準備してきてぇ」","「翘课的话联系家里很麻烦，\n所以带了教科书什么的。[l]\n没事别在意，比起这个快点去准备啦」"],["「わ、わかった。[l]\n旅館の人が持ってくれるだろうしね……」","「好、好的。[l]\n反正旅馆的人会帮忙拿吧……」"],["くれないのかな……[l]\n高級ホテルでもなきゃ駄目か。[l]\n自分の時は完全に身内扱いだったから参考になりません。","难道不会吗……[l]\n除非是高级酒店才行？[l]\n我上次完全被当作家属对待所以没有参考价值。"],["ともあれ、\n部屋に戻り宮さんに事情を説明すると、\n格別何もなく許可はおりた。[l]\nチノ嬢も宮さんの部屋に居たので、\n今朝から言われてた用事をこなしてたのだろう。[l]\nまだすることあるって言ってたし。","总之，\n回房向宫小姐说明情况后，\n很顺利就获得了许可。[l]\n千乃小姐也在宫小姐房间，\n应该是在处理今早交代的工作吧。[l]\n她说过还有事要办。"],["まあ、その所為なのか若干リアクションが薄いというか、\n心ここにあらずというか、\nちょっと浅めの対応だったけど──[l]\nいや、そんな、寂しい訳じゃないんだけども、\nいつもがいつもだとちょっとだけ、\nちょっとだけ気になったのだ。","嘛，或许是因为这个缘故反应有点平淡，\n或者说心不在焉，\n应对得略显敷衍——[l]\n不、不是啦，倒也不是觉得寂寞，\n只是和平常的平常相比稍微、\n稍微有点在意。"],["手洗いに行きロビーへ向かうと、\n冬夏が既に待っていた。","洗完手走向大厅时，\n冬夏已经等在那里了。"],["冬夏の案内でレンタカー屋に向かう、徒歩で。","跟着冬夏的指引前往租车行，步行去的。"],["「あのさ、もうこっち来て何回かの夜過ごしたよね」","「那个啊，你来这边已经度过好几个晚上了吧」"],["「よ、よるを過ごす！？」","「度、度过夜晚！？」"],["「？」","「？」"],["「ん？あ、ああ、そう、そうね。[l]\n半月くらい経つのかな……[l]\nうわ、はええな……」","「嗯？啊、啊啊，是、是啊。[l]\n差不多有半个月了吧……[l]\n哇，好快啊……」"],["「こっちの夜ってさ、\n音が全くしないでしょ？」","「这边的夜晚啊，\n完全听不到声音对吧？」"],["「ああ、川沿いだけど部屋はそこそこ高い位置にあるしね、\n毎晩すんごい静かだよ」","「啊啊，虽然沿河但房间位置还挺高的，\n每天晚上都超级安静哦」"],["「天の川も視えるでしょ？」","「还能看见银河对吧？」"],["「まー、静かさの方は、\nもうすぐ蛙の鳴き声ですっごいうるさく\nなると思うけどね……[l]\nで、私も何回か西國とか行ったことあるんだけど」","「嘛~安静这方面，\n马上就会因为青蛙叫声变得\n超级吵闹了呢……[l]\n话说我也去过西国好几次」"],["「……うん」","「……嗯」"],["「山間部の方は行かなかったからわかんないけど。[l]\n夜になってもさ、\n空がぼんやり明るいんだね。[l]\n街の明かりを反射してるのかな？","「不过没去过山区所以不清楚。[l]\n但就算到了夜晚，\n天空还是朦朦胧胧亮着的。[l]\n是反射了城市的灯光吗？"],["星なんか全然視えなかった。[l]\n音が無くなる事もなかったし」","根本看不见星星。[l]\n声音也从来不会消失」"],["「中央も、最中央はそんなもんだよ、\n僕の居た……居るとこは中央圏でも田舎の方だし、[l]\n此処と大差なかったかも……[l]\nあ、だけど水は段違いに此処のが美味いけどね」","「中央地区的话，最中心地带就是那样啦，\n我住过……现在住的地方在中央圈也算乡下，[l]\n和这里可能没太大差别……[l]\n啊，不过这里的水质可是天壤之别的好喝哦」"],["「水？」","「水质？」"],["「うん、別物だなあ。[l]\n向こうの水飲んだことある？」","「嗯，完全不一样呢。[l]\n你喝过那边的水吗？」"],["「西國のは母様達に止められた」","「西国的被母亲她们禁止饮用」"],["「ははははは……」","「哈哈哈……」"],["と、レンタカー屋に着いた。[l]\n飛び込みだったが、\n平日の昼間に借りる人間は殆どいないようで、\nあっさりＯＫですよ。","说着就到了租车行。[l]\n虽然是临时起意，\n但工作日白天来租车的人似乎很少，\n很轻松就搞定了。"],["手続きを済ませ、\n店の外、結構離れた場所で待っていた冬夏を乗せる。","办完手续，\n让在店外相当远处等待的冬夏上车。"],["「一応七時くらいまでで取ったけど、\nま、そんなにかかんないよね？[l]\nあんまり遅いとあれだし」","「姑且预约到七点左右，\n不过应该花不了那么久吧？[l]\n太晚的话也不太方便」"],["「んーーたぶん」","「嗯——大概吧」"],["「で、どこいきましょうかね」","「那，要去哪里呢」"],["お嬢様、とは継がずにおく。","没把“大小姐”这个称呼说出口。"],["「海。[l]\nちょっとだけ遠いかな。[l]\n道の駅でいうとね、……」","「海边。[l]\n可能有点远。[l]\n按公路休息站来说的话……」"],["と、カーナビを設定し出す冬夏。","冬夏开始设置车载导航。"],["昨日風呂場で宮さんに訊いたけど、\n海岸、\n確かに結構遠いとか、僕が昔行ったことがあるかもとか──","昨天在浴室问过宫小姐，\n海岸，\n确实挺远的，可能和我小时候去过的是同一个——"],["そうだ、僕の小さい頃の記憶にあると","对了，在我幼年记忆中的"],["覚しき海岸……","那片海岸……"],["「はい、設定できたよ。[l]\nこれでもこういう事は遣り方知ってるんだから」","「好了，设置完成。[l]\n这种操作我还是知道方法的啦」"],["はっ、と気を取り直す僕。[l]\nそうか、印象としてはおつきの運転手とか居そうだもんな。[l]\n冬夏自身がこんな装置の操作なんてどうやって覚えるんだろ。","我猛地回过神来。[l]\n也是，印象中她应该配有专属司机之类的。[l]\n冬夏自己到底是怎么学会操作这种设备的啊。"],["「おあ、了解。[l]\nへえ、到着予定時刻一時間弱ね……[l]\n海水浴場というよりは松原なのか。[l]\nまさか泳ぎに行く訳じゃないよねえ？」","「哦啊，了解。[l]\n嘿~预计到达时间不到一小时呢……[l]\n与其说是海水浴场更像是松树林吧。[l]\n该不会真要去游泳吧？」"],["「そりゃーそうだよー。[l]\n四月だよ？[l]\n視てるのが好きなの、海。","「那当然不会啦。[l]\n现在可是四月耶？[l]\n我喜欢看着海。"],["あっ、水着姿が視たかったとか？[l]\nやらしー。[l]\n残念でした」","啊~难道是想看泳装造型？[l]\n好下流。[l]\n真遗憾呢」"],["「はいはい僕ぁドエロですよ。[l]\nなんとも残念じゃのうー」","「是是是我超下流啦。[l]\n真是遗憾得要死呢~」"],["「ごめんなさい拗ねないでください。[l]\nあのね、海が好きなのはね、\n自分がすごく小さく視えること」","「对不起别闹别扭嘛。[l]\n那个啊，我喜欢海是因为，\n会觉得自己特别渺小」"],["箱庭の広さを認識すること、\nつまり違う価値観の視点を得ること──","认识到箱庭的广阔，\n也就是获得不同价值观的视角——"],["それは母さんが僕に言っていたことだ。","这是妈妈告诉过我的事。"],["「山も好き。[l]\n山が好きなのは、\nあらゆるものが生きていて、\nその中に居ることが実感できること」","「也喜欢山。[l]\n喜欢山是因为，\n能感受到万物都在活着，\n自己确实置身其中的感觉」"],["山は常にあらゆる音、\nそれもイキモノの立てる音がするし、\n匂いも磯のように潮の香りだけではなく、\n果てしなく何かが混在している気配がする、\nとは僕も思う。","山里永远充斥着各种声响，\n而且都是活物发出的声音，\n气味也不像海边只有潮香，\n总觉得有无数种东西混杂在一起，\n这点我也深有同感。"],["本能が目覚めるような感覚が、勿論錯覚だろうけど、ある。[l]\nヒトの文化を離れれば、\nそこはあっさりと生き死にが混在したセカイというものが\n厳然として在って、\n植物ですら動くそこ、\n喰う喰われるの","虽然可能是错觉，但确实有种唤醒本能的感觉。[l]\n只要远离人类文化，\n那里就分明存在着\n生死交织的严酷世界，\n连植物都会活动的领域，\n弱肉强食的"],["場、生命のセカイがある。","生命世界。"],["ヒトは、\nそこから何としても逃げたかったのだろう、\n遙か過去にも水中から逃避し陸上にあがり、\n食物連鎖から逃避して、現在のポジションに至った。","人类啊，\n想必是无论如何都想逃离那里，\n远古时从水中逃往陆地，\n如今又逃离食物链到达现在的位置。"],["バランスを崩す事によって自滅する事自体が、\nバランスを取る事になる状況、\n完全なるが故に不完全さをも完璧に内包している、\nそれがセカイ、\nつまり最悪の箱庭。[l]\nこういう話は大神もよく言っていたし、\n僕も解らないでもない。","通过打破平衡来自我毁灭这件事本身，\n反而形成了维持平衡的状态，\n正因为完美才彻底包容了不完美，\n这就是世界，\n亦即最糟糕的箱庭。[l]\n这类话题大神也常说起，\n我倒也不是不能理解。"],["それに、旅行好きでアナクロ趣味な僕としては、\n情報のみが氾濫するあちらの世界よりも、\n眼の前の現実を体感する行為の方が魅力的である。","况且对于喜欢旅行又有复古癖好的我来说，\n比起信息泛滥的彼端世界，\n亲身感受眼前的现实才更吸引人。"],["冬夏の言から僕は、何となくそういった事を考えていた。","从冬夏的话里我隐约想到了这些。"],["「都会はキライだけど。[l]\nヒトがいっぱいいるの苦手なんだ。[l]\n虫とか動物は何考えてるかわかんないから、\n沢山いてもその量に驚くだけだけど……」","「虽然讨厌都市。[l]\n但更受不了人挤人的感觉。[l]\n虫子动物之类因为搞不懂在想什么，\n就算数量再多也只会惊讶而已……」"],["「まあねえ……」","「确实呢……」"],["「うちはね、\n──まあ、\nあんなだから、親戚というか、\n関係者がごっそり居るわけ。","「我家啊，\n——怎么说，\n就那种状况嘛，亲戚或者说，\n相关人员乌泱泱一大堆。"],["なんて言うのかなあ、気持ち悪いよ。","该怎么说呢，超恶心的。"],["表向き仲良く付き合ってるけど、\nほんとのところ打算まみれの繋がり、\nそれぞれがそれぞれの利権を考えて、\nなのに顔付き合わせればお互いに……","表面上和和气气来往，\n骨子里全是算计的关系，\n各自打着小算盘，\n碰面时却还要互相……」"],["あーあ、\n家族とか一族とか、\n血のつながりほどやっかいな事はないよ。[l]\n……お尻の青いコドモみたいと思ってる？","唉—唉，\n什么家族啊一族啊，\n没有比血缘关系更麻烦的东西了。[l]\n……觉得我像屁股发青的小屁孩吗？"],["いいけど。それでも。[l]\n真言さんとかきぃは好きだよ。[l]\n友達はさ、血縁でもないのに泣いたり笑ったりしてくれるから」","无所谓啦。即便如此。[l]\n我还是喜欢真言先生和小贵。[l]\n朋友啊，明明没有血缘关系却会为你哭为你笑」"],["今日、道具さんが言っていた通り……というわけか。[l]\n感情的になってきたのか、少々支離滅裂になってきてるし。","今天道具小姐说的话……原来是这个意思啊。[l]\n情绪上头了，说话都开始支离破碎了。"],["「血縁というだけで、\n泣いたり笑ったりしてくれるのが家族、\nという考えもあるけどね……」","「仅凭血缘关系，\n就会为你哭为你笑的就是家人，\n这种想法也是有的呢……」"],["「──そっか」","「──这样啊」"],["「関係性のカテゴライズじゃなくてさ、\n個々人の問題だと思うよ。[l]\n友達恋人だと思ってても打算満載の奴もいるだろうし、\n家族だろうと他人だろうと、その」","「不是关系分类的问题，\n我觉得是每个个体的问题。[l]\n就算是朋友恋人里也有满脑子算计的家伙，\n无论家人还是外人，那种」"],["「うん。[l]\n解るんだけどね。[l]\nでもま、\n私のところはそういうんじゃないんだぁ」","「嗯。[l]\n我明白的。[l]\n不过啊，\n我家的情况可不是那样啦」"],["「うーん」","「唔—嗯」"],["「やめやめ、この話。[l]\nあはは、言い出しっぺは私か、ごめん」","「打住打住，这个话题。[l]\n啊哈哈，始作俑者是我呢，抱歉」"],["その後、\n暫くは他愛のない話をしたり、\nカーナビの音声を気にしつつラジオを聞いたり、\nそれこそ景色を視たりして、\nドライブを堪能していた。[l]\n宮さんと車に乗るときはアニソンばっかだったし、\n昼間の道具さん達とのドライビングはある種の労働だったし、\nこういうのは結構新鮮かもなー。","那之后，\n我们聊了些无关紧要的话题，\n一边留意导航语音一边听着广播，\n或者干脆就看看风景，\n享受着兜风的乐趣。[l]\n和宫小姐乘车时放的全是动漫歌，\n白天和道具小姐她们开车简直像在打工，\n现在这样倒是挺新鲜的。"],["もうそろそろ到着地が近いか、という辺りで、\n冬夏が先刻の話題──家族が云々の直前まで──に\n再び触れた。","快到目的地的时候，\n冬夏又把话题拽回之前\n说到家人如何那里。"],["「でね、私。[l]\n海でも山でも、一人でこう、\nたまにだけど。[l]\n暗くなるまでずーっと座ってるんだ。","「其实我呢。[l]\n不管是海边还是山上，偶尔会\n一个人待着。[l]\n直到天黑都一直坐着。"],["自分がもし、\n言葉もなくて、\n思考の回路というものがなくて、\n生きてるものの存在をこう、","想象自己如果\n没有语言，\n没有思维回路，\n作为单纯靠『感知』"],["言葉や理屈じゃなく『感得』するだけのモノだと思って、\nつまり『自分がヒトじゃなかった』らどんな感じなんだろうと\n考えるのね」","而非言语道理来体会生命存在的生物，\n也就是『如果我不是人类』\n会是什么感觉」"],["「なーんか哲学的ですなあ……」","「真是够哲学的呢……」"],["「ま、ヒト以外のいきものが、\n生きてるって感じるのはどういう感じなのか、\n言葉のない存在が思考するってどんな感じなのか、\nそーいう事を考えちゃうわけ私って。","「就是会忍不住想，\n非人类的生物感受到生命是什么体验，\n没有语言的存在如何进行思考，\n我老想这种事。"],["ほら、普通はさ、何でも擬人化しちゃうじゃない？[l]\nニンゲンの論理や思考経路に即した理由付けとかしちゃってる\nよね、よく。[l]\n動物の行動に対して可愛いとか何とかさ」","你看，一般人总爱把什么都拟人化吧？[l]\n用人类的逻辑和思维模式\n去解释动物行为，[l]\n说什么好可爱之类的」"],["「本来は威嚇行動の筈の身振り手振りが、\n愛らしいニンゲンぽい行為として和やかに紹介されたりね。[l]\nまあ、実際違ってるかどうかすらも、\n本当は当人……当動物？にしかわかんないんだろうけど」","「本该是威吓的动作姿态，\n被当作可爱的人类化行为温馨介绍。[l]\n虽然实际上是不是威吓的动作，\n恐怕只有当事人……当事动物？才知道吧」"],["「まっねー。[l]\n兎に角ね、\n他人とは違う視点、視界が必要なんだ私にとって。","「确实—呢。[l]\n总之对我来说，\n需要与众不同的视角和视野。"],["でも、それが……私の心の別な部分とね、[l]\n……しづらい」","但这和……我内心的另一部分，[l]\n难以……」"],["ん？[l]\nそれは、\nかあさんの、","嗯？[l]\n那是\n妈妈的"],["「え？」","「诶？」"],["「んっ？[l]\nあ、別にたいしたことじゃないよ。[l]\nで、今から行くところはね、\n私が昔から──」","「嗯？[l]\n啊、其实也没什么大不了的。[l]\n然后呢、现在要去的地方啊\n是我从以前就──」"],["と、\n急に視界が開けた。[l]\n今までは断崖や木々で道路横の風景が分からなかったのだ。","正说着\n视野突然开阔了。[l]\n之前因为断崖和树木一直看不清路旁的景色。"],["冬夏の話に聞き入ってた事もあるが、\nそのすら声も耳鳴りと共に遠ざかる……","虽然也有在认真听冬夏说话\n但连她的声音都随着耳鸣渐渐远去……"],["あ──","啊──"],["この海岸、[l]\n堤防、[l]\n砂浜、[l]\nしろのしろ、","这片海岸[l]\n堤防[l]\n沙滩[l]\n纯白的白"],["「あ、れ？[l]\nここはもし、かして」","「啊咧？[l]\n这里该不会是"],["「","「"],["碁","碁"],["石","石"],["松","松"],["原、視えたよ」","原、看得到了哦」"],["「ごいし、まつばら……？」","「碁石、松原……？」"],["「私と、ある人との思い出の場所なんだ」","「这是我和某个人的回忆之地」"],["@r@r@r@r砂浜の両端は磯になっていて、\n波しぶきが立つ音が聞こえる。[l]\n冬夏が走る車の窓を開けると、\n潮風が吹き込んでくる。","@r@r@r@r沙滩两端都是礁石\n能听见浪花拍打的声音。[l]\n冬夏打开行驶中的车窗\n海风便灌了进来。"],["@r@r@r@r記憶の鍵を刺激するのは、\n音と匂いだと何かで読んだ。","@r@r@r@r记得在哪读过\n最能刺激记忆钥匙的是声音和气味。"],["@r@r@r@r脳が、空転じゃなく、\n何かが咬み合って猛烈に回転してるのがわかる。","@r@r@r@r大脑\n不是空转、能感觉到某种齿轮正在疯狂咬合运转。"],["@r@r@r@rまちがいない、[l]\n僕は此処を知ってる。","@r@r@r@r不会错的[l]\n我知道这个地方。"],["@r@r@r@r","@r@r@r@r"],["首が、[l]\n熱くなっていく。","脖颈[l]\n开始发烫。"]],"context":[["SC_M_029.ks/index/1/text"],["SC_M_029.ks/index/3/text"],["SC_M_029.ks/index/5/text"],["SC_M_029.ks/index/7/text"],["SC_M_029.ks/index/9/text"],["SC_M_029.ks/index/11/text"],["SC_M_029.ks/index/13/text"],["SC_M_029.ks/index/15/text"],["SC_M_029.ks/index/17/text"],["SC_M_029.ks/index/19/text"],["SC_M_029.ks/index/21/text"],["SC_M_029.ks/index/23/text"],["SC_M_029.ks/index/25/text"],["SC_M_029.ks/index/27/text"],["SC_M_029.ks/index/29/text"],["SC_M_029.ks/index/31/text"],["SC_M_029.ks/index/33/text"],["SC_M_029.ks/index/35/text"],["SC_M_029.ks/index/37/text"],["SC_M_029.ks/index/39/text"],["SC_M_029.ks/index/41/text"],["SC_M_029.ks/index/43/text"],["SC_M_029.ks/index/45/text","SC_M_029.ks/index/47/text"],["SC_M_029.ks/index/49/text"],["SC_M_029.ks/index/51/text"],["SC_M_029.ks/index/53/text"],["SC_M_029.ks/index/55/text"],["SC_M_029.ks/index/57/text"],["SC_M_029.ks/index/59/text"],["SC_M_029.ks/index/61/text"],["SC_M_029.ks/index/63/text"],["SC_M_029.ks/index/65/text"],["SC_M_029.ks/index/67/text"],["SC_M_029.ks/index/69/text"],["SC_M_029.ks/index/71/text"],["SC_M_029.ks/index/73/text"],["SC_M_029.ks/index/75/text"],["SC_M_029.ks/index/78/text"],["SC_M_029.ks/index/80/text"],["SC_M_029.ks/index/82/text"],["SC_M_029.ks/index