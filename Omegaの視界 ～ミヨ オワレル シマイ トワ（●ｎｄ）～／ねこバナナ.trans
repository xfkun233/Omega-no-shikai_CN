24/text"],["SC_M_072.ks/index/226/text"],["SC_M_072.ks/index/228/text"],["SC_M_072.ks/index/230/text"],["SC_M_072.ks/index/234/text"],["SC_M_072.ks/index/236/text"],["SC_M_072.ks/index/239/text"],["SC_M_072.ks/index/241/text"]],"tags":[],"parameters":[[{"start":208,"end":225}],[{"start":255,"end":260}],[{"start":291,"end":369}],[{"start":399,"end":457}],[{"start":488,"end":532}],[{"start":562,"end":657}],[{"start":688,"end":759}],[{"start":789,"end":906}],[{"start":937,"end":958}],[{"start":988,"end":1041}],[{"start":1072,"end":1119}],[{"start":1220,"end":1239}],[{"start":1287,"end":1423}],[{"start":1476,"end":1517}],[{"start":1548,"end":1695}],[{"start":1726,"end":1749}],[{"start":1780,"end":1852}],[{"start":1905,"end":1908}],[{"start":1939,"end":1964}],[{"start":1994,"end":2000}],[{"start":2053,"end":2125}],[{"start":2156,"end":2172}],[{"start":2202,"end":2208}],[{"start":2277,"end":2297}],[{"start":2356,"end":2383}],[{"start":2413,"end":2426}],[{"start":2483,"end":2537}],[{"start":2596,"end":2637}],[{"start":2647,"end":2668}],[{"start":2699,"end":2705}],[{"start":2736,"end":2767}],[{"start":2797,"end":2836}],[{"start":2867,"end":2914}],[{"start":2945,"end":3050}],[{"start":3109,"end":3153}],[{"start":3184,"end":3191}],[{"start":3250,"end":3300}],[{"start":3330,"end":3373}],[{"start":3404,"end":3471}],[{"start":3502,"end":3508}],[{"start":3538,"end":3558}],[{"start":3589,"end":3686}],[{"start":3745,"end":3817}],[{"start":3848,"end":3919}],[{"start":3949,"end":3991}],[{"start":4050,"end":4085}],[{"start":4116,"end":4140}],[{"start":4170,"end":4271}],[{"start":4302,"end":4349}],[{"start":4380,"end":4408}],[{"start":4439,"end":4473}],[{"start":4532,"end":4545}],[{"start":4575,"end":4583}],[{"start":4614,"end":4693}],[{"start":4724,"end":4742}],[{"start":4772,"end":4789}],[{"start":4846,"end":4917}],[{"start":4948,"end":4954}],[{"start":5013,"end":5149}],[{"start":5164,"end":5165}],[{"start":5175,"end":5196}],[{"start":5255,"end":5392}],[{"start":5423,"end":5512}],[{"start":5571,"end":5627}],[{"start":5658,"end":5694}],[{"start":5725,"end":5787}],[{"start":5817,"end":5877}],[{"start":5908,"end":5909}],[{"start":5919,"end":5978}],[{"start":6009,"end":6019}],[{"start":6050,"end":6053}],[{"start":6111,"end":6135}],[{"start":6165,"end":6168}],[{"start":6227,"end":6332}],[{"start":6391,"end":6396}],[{"start":6427,"end":6610}],[{"start":6620,"end":6684}],[{"start":6744,"end":6758}],[{"start":6834,"end":6892}],[{"start":6923,"end":6939}],[{"start":6969,"end":6974}],[{"start":6983,"end":6984}],[{"start":6993,"end":7037}],[{"start":7096,"end":7130}],[{"start":7161,"end":7207}],[{"start":7238,"end":7245}],[{"start":7303,"end":7307},{"start":8207,"end":8211}],[{"start":7387,"end":7391},{"start":8283,"end":8287}],[{"start":7425,"end":7429}],[{"start":7504,"end":7545}],[{"start":7604,"end":7636}],[{"start":7667,"end":7817}],[{"start":7848,"end":7856}],[{"start":7913,"end":8110}],[{"start":8141,"end":8151}],[{"start":8321,"end":8326}],[{"start":8372,"end":8377},{"start":8636,"end":8641},{"start":9511,"end":9516}],[{"start":8434,"end":8538}],[{"start":8548,"end":8577}],[{"start":8672,"end":8727}],[{"start":8812,"end":8823}],[{"start":8907,"end":8943}],[{"start":9004,"end":9008}],[{"start":9014,"end":9020}],[{"start":9028,"end":9034}],[{"start":9082,"end":9116}],[{"start":9147,"end":9154}],[{"start":9184,"end":9190}],[{"start":9243,"end":9350}],[{"start":9381,"end":9396}],[{"start":9426,"end":9437}],[{"start":9468,"end":9480}],[{"start":9547,"end":9561}],[{"start":9618,"end":9714}],[{"start":9728,"end":9729}],[{"start":9739,"end":9776}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_072.ks","basename":"SC_M_072.ks","indexIds":{"「……今更後悔もクソもないけどよ」":0,"「なんだ」":1,"「どんな事情があろうとも、\nこういうのは苦手……ってか、[l]\n尻の据わりが悪いっつーのか？[l]\nいや、事情はわかってんだけどさ」":2,"「まあな。[l]\nだが事情も事情、\nオトナの事情って奴だな。[l]\n込み込み覚悟の上だろう」":3,"「その深ぇ事情がなぁ……[l]\nGM様の言うことをどうこうってワケじゃないけど」":4,"「そうさな……[l]\nま、そうでなくても思い起こせば、\npatron（後ろ盾）が変わるなんて事は、\n永い事無かったからな。[l]\n落ち着かない気持ちは分かる」":5,"「そんな安穏とした感想で済むかよ。[l]\n……ああ、[l]\n●●になるってのは気分がよくねーなあ。[l]\n何よりも、」":6,"「今、必須フラグも立てない内に、\n……出喰わそうものなら、[l]\n全てはおじゃんだろうな。[l]\nさりとて旗を立てるは我々の役割じゃない。[l]\nまだ、\n大人しくしなければならない時なのに──」":7,"「Ironがまたぞろどっかに消えたってか」":8,"「いや、一応行き先も用件も承知してる、\n前のように失踪した訳じゃない。[l]\nただ、──」":9,"「……お嬢をこっちに放置したまんま──ってのぁ、[l]\n面倒な事になりそうだなあ……」":10,"だぁーーーーーーっくしゅっぅおあ！！！":11,"「ずずず……風邪っぽいなぁ、[l]\n急に寒くなったりこんな山ん中に連れてこられたり、\n……ストレスマックスくらったりで免疫系も弱まったかっ！[l]\n頭もぼーっとするっ、\nあああああああああ、\n考えんのめんどくせーーーーーーー！！！」":12,"「……お嬢、もう少し静かにクシャミしなって。[l]\nそれと独り言の方もよ」":13,"「かんがえっんのめんどきゅせーーーって、\n言ったろいま！！！[l]\nじでーーーっと黙ってたら気が狂う！！！[l]\n折角思う存分遊べると思ったのにっ、\nアイはどっかに行くし風邪引くし待機待機待機言われるしっ、\n結局前と何も変わんねーーーだろおおおが！！！」":14,"「……辛抱しなって、今が我慢の為所なんだから」":15,"「……こんな、[l]\nこんな、\nこんなうぜーおあずけ耐えれっかよ！？！[l]\n狂う、くるう、くるーーーーーーーーぅあ？」":16,"「？」":17,"「──。[l]\nなんかくる、くる、くるぞ」":18,"「なんだと」":19,"「！！！[l]\n旧式っ！[l]\n試作品っ！！[l]\n時代遅れっ！！！[l]\nそこのてめーだっ！！！！！！！！！」":20,"「ば、何で呼び止めるよっ──あ」":21,"「……うゎ」":22,"「──随分大きな声がしたと思ったら──」":23,"「や──べえぞ、やべぇよな？[l]\nおい──」":24,"「……あっ、お嬢、待──」":25,"「──あの時の、４人……１人いないな……[l]\nどっちにしてもつまりこれは、\n近くに、……」":26,"「っんだその格好はっ？！！[l]\n超だせーな！！！[l]\nちょっと":27,"面かせ！[l]\nこっち来い！！！」":28,"「……え？」":29,"「こ、いつ、\nほんとに出やがった、\nしかも、」":30,"「Ｗ－ＭＯｄｅ、だな、前とは違う……というよりも、[l]\n本来の──」":31,"「み、視りゃ分かる、\nでもありゃ、\nな、なんだあれぁ、あのＣＡＴ、知らねーぞ」":32,"「今更何しに此処に来たんだっ！！！[l]\nあのまま逃げ腐れてりゃーーー良かったのにっ、\nおめーが出張ると面白くないんだっ！！！[l]\n眼障りなんだよっ、\n邪魔なんだよっっ！！！」":33,"「……ああ、キミは……『後輩』…かな。[l]\nいや、量産型とでも言うべきか──」":34,"「あにっ？！」":35,"「……あちらさん、[l]\n完全に不機嫌だぞ、\nお嬢、刺激するな……って遅いかぁ……」":36,"「……これも何たらのシナリオ通りって奴かな、[l]\n腹括らんといかんぞこれは」":37,"「……それに体調も良くなさそうだし、[l]\n君こそ帰って寝てたら良いんじゃ、ないかな、\nそっちの２人、そう思わない？」":38,"「？！な、」":39,"「……そうできるものならそうしてるが、」":40,"「っざけんな！！！[l]\nこちとらここんとこフラストレーションまみれなんだよっ、\n憂さ晴らしだ！！！[l]\nおめーが相手しろ！！！[l]\nその義務があるっ！！！」":41,"「……。[l]\nそんなことより、\nあのひと──宮さんは？[l]\n貴女方が居るって事は、\nこの辺にいるんでしょう」":42,"「人の話をきけぇっ！！！[l]\nつーかしらねーよミルハの事なんざ！！！[l]\nボクらが何で此処に居るかわかってねーよーだな、」":43,"「お嬢！[l]\nそこまでだ。[l]\nそこの彼、久しいな、覚えてるぞ」":44,"「……それはどうも、[l]\nこちらもそちらのことは──色々と」":45,"「あっんで邪魔すんだっ！[l]\nもがっ」":46,"「そいつは恐縮。[l]\nで、いきなりですまんが、\nミルハは此処に居ない、[l]\n──否、此処に居るのだろうが、我々は無関係だ、\n詳細は知らない。[l]\nだから、」":47,"「このちっこいのの事は無視してくれっか。[l]\n最初の暴言は変わってあたしが謝るから」":48,"「今更もがっ、\n何をぐっ、\nボク等はっ」":49,"「なんで懲りねーかなこの御方はっ、\nあの２人も何だって──」":50,"「行って──良いのかな？」":51,"「ああ、そ──」":52,"「あっぷ、\n待てこら！！！[l]\nサクラもアルコもすっこんでろ！！！[l]\n待て旧式！！！[l]\nボクがてめーを今潰す！！！」":53,"「いっででで、暴れんな、無茶言うな」":54,"「お嬢はソロではどうしようも──」":55,"「……宮さん相手なら兎も角、[l]\n貴女方を無力化することは、簡単に出来るよ。[l]\n知ってる──[l]んでしょう、僕の事は」":56,"「…っな、」":57,"「しらねぇーーーーーーーよ！！！[l]\nそれにてめー、ボクが量産型だぁ？！！[l]\n量産型ってのは前例の悪しき部分を改良して出来る、\nより良きもの、デバッグ済み、完成型、\n即ち『正式』なんだっ！！！[l]\nラフな下描きで叩き台の、\n":58,"没":59,"書の分際ででけぇ口叩くんじゃねぇよ！！！」":60,"「うーん……[l]\n僕は貴女方じゃなく、\nあのひとに用があるだけなんだよ。[l]\n正直貴女方には興味無いし、\n……舞台裏や楽屋を覗くような気まずい真似も、[l]\n御免だ。[l]\nそっちの２人も、だから多くを語らないんだろうし」":61,"「Deus ex machina風情が殊勝なこと言うじゃねーかよ！[l]\nでもな、\nこっちも我慢の限界なんだっ！！！[l]\nどっちが上か教えたらぁ！！！」":62,"「で……でうすえ、きな？[l]\n──ああ、キカイジカケのカミか。[l]\nそうなら寧ろ幸いだ……」":63,"「この状況でわざわざ事を荒立てんなよっ、\nそもそもコイツは──」":64,"「テキだこいつはっ！！！[l]\n狩る！狩るんだっ、封じなくともいっくらでも！[l]\n叩きのめしたらぁ！！！」":65,"「お嬢！[l]\n先日も未定義相手にエラー起こしたというに、\n同じ轍を踏む気か、\nいい加減に──」":66,"「":67,"何もかんもアップデートしただろぉが！！！[l]\n丁度いい、アッパー版の実験台だっ、\nいいから離せ──」":68,"「敵とか味方とか、」":69,"「！」":70,"「上とか下とか、\nそういうのは君等も、」":71,"「…」":72,"「蔑むべき価値観じゃなかったっけ？[l]\n永い時間の末に宗旨替えでも……[l]\n否、違うか、\n君等は常に、\n何者に対しても上位に立ち続けるべく、\nそう在りたいのだから、」":73,"「あー？」":74,"「そもそも敵味方上下は関係ないんだね。[l]\n狩人と獲物、絶対的な立ち位置、\nそれを保持した前提での……[l]\nあとはスキかキライか、[l]\n──自己完結してる分には、\n僕も何も言うつもりは無いけれど、\n他者に対して我を通そうというのなら、[l]\n……まあ、何があったか知らないけれど、[l]\n僕も僕の":75,"側の覚悟を以て、応じるしかないよ。[l]\nどうあれ最初は──我を張り合うしかないんだろうしね。[l]\nただ──」":76,"みぃーーーーーーーーーん……":77,"「……今、僕は手心を加えられるような心境じゃ、[l]\nないよ。[l]\nそれでも、\nやるの？」":78,"「……ど、どうすんだ、この場合」":79,"「縛鎖も仮":80,"修":81,"繕したて、[l]\nアイも居ない、[l]\n選択の余地なんて本来ならば──」":82,"「……いーい覚悟じゃねーか、[l]\nすぐに後悔させてやら、」":83,"「放っておいてくれないなら、\n貴女方を止めるしかないんだけど、\nいいのかな」":84,"「ちょ、まっ」":85,"ばちん。":86,"「──」":87,"ぺたん。":88,"「──ってあ、[l]\n返事を聞く前だったのに……[l]\nミスった」":89,"「あっ？？！[l]\nおま、\nなっ、なにしやがっ」":90,"「ごめん、暴発しちゃった。[l]\nでもまあ……大した出力じゃなかったし、[l]\n廃になる程深刻じゃないかな、多分。[l]\nんー、\n封紙をしてる間はないから、\nＣＡＴは放っておくけど、\nもう邪魔しないでほしい、\nそして、\n言っておくけど」":91,"「──っ？！？」":92,"「苛ついてるのは、\nこっちも同じだって事──[l]\n他人の心なんか絶対に分かることはないけれど……[l]\nそれでも、\n想像する努力はした方がいいと、思うよ。[l]\n無知の知か……[l]\nあらゆるミカタを得た上で、\n多面を視てなお、貫かんとするならば、\n反作用の覚悟も必要故に、\n開き直るのも時と場合を選んだ方が──賢明だ」":93,"「あああ、ううう、」":94,"しーん……":95,"「………」":96,"「君も言ってたようにさ、\nタスク実行中に邪魔が入るのって、\nイヤだろ？[l]\n精神衛生上宜しくないし……[l]\n……ああ、でも、[l]\n君等の御陰で、\nいい緊張":97,"解しにはなったよ、\nその点は──[l]ありがとう」":98,"「──さて、\n何かが引っ掛かるけど……[l]\n兎に角、\nあのひとのところに行かなきゃ」":99,"みゅいーーーーーーん。":100,"「………、[l]\n………、[l]\n………っくしょうっ、」":101,"ざわ……":102,"ざわざわ……":103,"──がさり。":104,"「──おや、\nあれに行き逢ったのですか、\nどれ……」":105,"「──ぅ、あ」":106,"「──……」":107,"「………あれも慈悲深いこと、[l]\n眼眩まし程度で済ませていった上、\nＣＡＴも手つかず……[l]\nとは言え、\n当分は使い物にならないでしょうけれどね、\nほら、しゃんとなさい」":108,"「──っはっ、げほっ、がはっ」":109,"「──……うっ、ごほ」":110,"「……っ、の野郎、……」":111,"「……ぐ、ぐぅぅ、あああっ」":112,"「そうそう、[l]\n貴女は、[l]\n別ですよEnder。[l]\nああ、……そのような為体でも案ずる事はありません。[l]\nそのためのLinkableForm、\n":113,"台":114,"本通りに劇が進んでくれれば──\n出番はすぐに来てしまいますからね」":115},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_072.ks","relPath":"/data/scenario/SC_M_072.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":109,"length":116,"percent":93.96551724137932},"cellInfo":[]},"/data/scenario/SC_M_073.ks":{"data":[["どくん、[l]どくん、[l]どくん、","咚、[l]咚、[l]咚、"],["「……これぁまた……えらい有様だな……[l]\n血の臭いがすげぇったらねーやな、\n修羅場った直後か、\nかれおん置いてきて正解だな、\nもう少し早かったら巻き込ま──[l]あっ。[l]\nおい、[l]\nお嬢さん、[l]\n生きてるな？[l]\n大丈夫か？[l]\nおいっ」","「……这又是……够惨烈的啊……[l]\n血味儿冲得要命，\n刚经历修罗场吧，\n没带卡蕾欧来真是明智，\n再早点儿就要被卷进──[l]啊。[l]\n喂，[l]\n大小姐，[l]\n还活着吗？[l]\n没事吧？[l]\n喂」"],["「……あ……[l]れ？……まこ…[l]…さん……？」","「……啊……[l]咦？……真…[l]…先生……？」"],["「ああ、生きてはいる……が、[l]\nこれぁ酷いな、[l]\n取り敢えずは、[l]\n止血、それから、[l]\nおいっ、お嬢さん、[l]腕ぁ何処いった？[l]\nそれとも消失しちったか？」","「啊，还活着……但，[l]\n这可真够呛，[l]\n总之先，[l]\n止血，然后，[l]\n喂，大小姐，[l]胳膊去哪儿了？[l]\n还是说消失了？」"],["「……だ……れ？[l]……ま……じゃない……」","「……谁……[l]……不是……真……」"],["「しっかりしろ。[l]\n──しょうがねー、まず応急処置、\nそれから探すか、\n最悪、PHASE:3ばりばりで……おい、[l]\n死ぬなよ、今、助けたる。[l]\nああもう、いーくんってば相変わらず、\nすげぇタイミングで俺んとこにまでイベント起こしやがって」","「清醒点。[l]\n──没办法，先应急处理，\n之后再找，\n最坏情况，用PHASE:3硬撑……喂，[l]\n别死啊，这就救你。[l]\n啊真是的，饭那家伙还是老样子，\n偏偏在这种时候把事件触发到我这儿」"],["「……だ……れ……[l]がはっ、[l]ごぼっ、ごふぅ」","「……谁……[l]咳咳、[l]呕、呜咕」"],["「俺はいー……飯窪真言のダチの大神雪鳴っていう、[l]\nいい人ね。[l]\n味方です。[l]\n奴の事は知ってますな？」","「我是饭……饭洼真言的哥们大神雪鸣，[l]\n是个好人。[l]\n自己人。[l]\n知道那家伙吧？」"],["「……まこ……とさん……の？」","「……真……先生……的？」"],["「いーくんにあんたらの事は頼まれてっから、\n安心してくれていい──って、\n……お前さん、アヤメんちのだろ？[l]\n念のため訊くが、\n綾目……」","「饭那小子托我照顾你们，\n放心好了──话说，\n……你是阿娅梅那边的吧？[l]\n确认一下，\n绫目……」"],["「……き……さま……」","「……你……这……」"],["「貴様？[l]\nあー、姫様ちゃん。[l]\n知ってる装束じゃなかったから一瞬焦ったが、\nまあ、\n此処にいるって事は少なくとも関係者ではあるわな。[l]\nほれ、取り敢えず傷口は塞いだ」","「你这？[l]\n啊ー，是姫様啊。[l]\n衣服没见过差点吓到，\n不过，\n既然在这儿至少是相关人员吧。[l]\n喏，伤口暂时包好了」"],["「……ぅあ」","「……呜啊」"],["「もし腕がその辺転がってるんなら、\nうまいこと治しようもあるんでね。[l]\nまだ仮留めだ。[l]\n無茶は……まあ出来ねーと思うけど、[l]\n何しろ血が流れすぎてる」","「如果胳膊还在附近的话，\n说不定还能想办法接上。[l]\n现在只是临时固定。[l]\n乱来的话……虽然我觉得你也做不到，[l]\n总之失血实在太多了」"],["「ぜは、……っ、[l]ぜぇ、ぜぇ、[l]……ぜぇ……」","「哈啊、……呃、[l]哈啊、哈啊、[l]……哈啊……」"],["「無かった場合でもまあ……ちっとこちらに負担が、[l]\nあるけどなんとかしまさあ。[l]\nただ、いーくんへの手助け介入は、\n本気でしづらくなるかな……[l]\n余力残しとかねーとイザって時が怖いが……」","「就算找不到也……顶多是我这边要多费点，[l]\n功夫总能解决的。[l]\n只不过要是帮饭君介入的话，\n可能就真没余力了……[l]\n不留点后手的话关键时刻就糟了……」"],["「………？」",""],["「ま、でも、\nあんた等を助けられなかった方が、\nいーくんにとってはダメージでかかろうさ。[l]\nまずは現状でベストを尽くすのみってね、\nで、腕は？」","「嘛不过，\n要是没救成你们，\n对饭君来说打击会更大吧。[l]\n总之先尽力而为，\n所以，胳膊呢？」"],["「……わから[l]……ない……[l]\n遠くに……[l]放ったから……」","「……不[l]……知道……[l]\n扔到……[l]远处了……」"],["「放った？[l]\nどんな状況だよ……[l]\nまあ、でも探しゃみつかるかもか、\n時間無いからちっと急ぐぜ、\nじゃあ……お嬢さんは此処で、[l]\n何かあったら──難しいかも知れんが、\n大声で呼んでくれ」","「扔了？[l]\n这什么状况啊……[l]\n算了，找找说不定还在，\n时间紧迫得赶紧了，\n那……小姑娘你在这儿，[l]\n万一有事──虽然可能很困难，\n就大声喊我」"],["「……ぜっ、[l]……ぜっ、……」","「……呃、[l]……呃、……」"],["「無かったらすぐ戻るからな。[l]\n気を確り持てよ。[l]\n──さーて、\nいーくん、こういう時こそイベント起こし頼むぜ」","「找不到我马上回来。[l]\n给我撑住了。[l]\n──好了，\n饭君，这种时候就靠你触发事件了」"],["「……？」",""],["「こうなりゃ今更出し惜しみもナシかな……[l]\n……ん？[l]\n………すまん、[l]\n少しだけ、待ってくれるか」","「事到如今也没必要藏着掖着了……[l]\n……嗯？[l]\n………抱歉，[l]\n能稍微等我一下吗」"],["「多分、腕は大丈夫なんだが、\n厄介そうなのがちーっと、\n集まってるくさいんでさ。[l]\nすぐばらけるとは思うが──」","「胳膊应该没问题，\n但好像有些麻烦玩意儿，\n正在聚集过来的样子。[l]\n虽然估计很快会散──」"],["「ぜっ、はっ、\nこっちから……っ、[l]\n気配がっ、\nそれにっ、この臭い、\n血……っ？」","「呃、哈，\n这边……有、[l]\n动静、\n而且、这气味，\n血……？」"],["がさっ。","沙沙。"],["「……」",""],["しーーーーーーーーーん……","沙——————……"],["ざわっ……","窸窣……"],["「……狐か？狸か？[l]\nなンかケモノが居ンな。[l]\n血の臭いにでも惹かれて来たか」","「……狐狸？狸猫？[l]\n有什么畜生在这儿。[l]\n是被血腥味引来的吗」"],["「喰われちまわねェ内に、\nとっとと──」","「趁还没被啃，\n赶紧──」"],["「──っ、」","「──呃，」"],["ざざざっ！","唰啦啦！"],["「っ？！[l]\nび、びびらすんじゃね──あァっ？」","「？！[l]\n别、别吓人──啊？！」"],["がし、べりっ、[l]\n","嘎吱、噗叽，[l]\n"],["ずるずるずるずるずる……","窸窸窣窣窸窸窣窣……"],["「んだこいつッ？！[l]\nってくんじゃねェよ！！[l]\nくっそ、暗ェのに、」","「这啥玩意儿？！[l]\n别过来啊！！[l]\n该死，太暗了，」"],["「……ニぃッ」","「……嘻」"],["「黒くて小っせェ、ケダモンがっ、\nみえ辛ぇんだよったく、\n待てこら！！！！！！」","「又黑又小的畜生，\n根本看不清，\n给我站住！！！！！！」"],["ざっ！","唰！"],["「腕なら呉れてやっても構わねェが、\nそっちは俺んだ！！！[l]\nなんだってケダモノがアレをっ──\n……ちッ、」","「胳膊给你也无所谓，\n但那边是老子的！！！[l]\n凭什么让畜生碰那东西──\n……啧、」"],["ざわざわざわざわ……","沙沙沙沙……"],["ざわざわ……","嘈杂……"],["……ざっ。","……唰。"],["「……こっちに気回す余裕も無い程に、[l]\nそれぞれが切羽詰まってるみたいだが……[l]\nま、ともあれ助かった。[l]\nこれで再生の手間ぁ省けるわ」","「……看来谁都没余力注意这边，[l]\n全都自顾不暇啊……[l]\n嘛，总之得救了。[l]\n省得再费功夫再生」"],["どろり……","黏答答……"],["「……単に自死（アポトーシス）した割にゃ、[l]\n……ふむ……[l]\nハードウェアにしろソフトウェアにしろ、\n流れは次世代へと移行しつつあるってのか？[l]\n誰が仕組んでるかはともあれ、\n俺も少しは勉強しにゃならんな、\n元より傍流だからといって、\nこのままでは本流が──」","「……明明只是单纯自灭（Apoptosis）了，[l]\n……嗯……[l]\n无论硬件还是软件，\n都在向次世代过渡吗？[l]\n幕后黑手暂且不论，\n我也得恶补点知识了，\n虽说原本就是非主流，\n但再这样下去主流派会──」"],["「っと、\n考えてる場合ちゃうな、\nあの少女を救わねば」","「啊咧，\n现在不是想这个的时候，\n得救那个女孩才行」"],["「ぜっ、はっ、[l]\nく、あいつもカミを狙ってるのかっ、[l]\nミ、ミルハが近くに居る、[l]\nあまり悠長な事はしてられないのにっ、[l]\nめん、どうな、ことにっ」","「呼、哈、[l]\n靠、那家伙也在觊觎神明吗，[l]\n米、米尔哈就在附近，[l]\n根本没时间磨蹭了，[l]\n完、完蛋了、这下」"],["「──ロア、ベロアっ！」","「──萝娅，贝萝娅！」"],["「？！[l]\nマ、マスターミリアム！[l]\n何故来たの、\n駄目だよ、いけないよ、ミルハが、奴等が近くに」","「？！[l]\n主、主人米莉安姆！[l]\n为什么过来，\n不行啊不可以啊，米尔哈和那些家伙就在附近」"],["「！[l]\n……ならば尚のこと、[l]\n私自身が姿をみせねば。[l]\nあの妹に、知らしめねばなりません、\n我等の復活を」","「！[l]\n……那就更该，[l]\n由我亲自现身。[l]\n必须让那个妹妹知晓，\n我等复活之事」"],["「無茶だよ、\nベロアもこんな有様で、\n今のままじゃ奴等に","「太乱来了，\n贝萝娅都这副德行了，\n现在的我们怎么可能"],["敵う訳が──」","敌得过他们──」"],["「ナナが居るはず、\nあれがすっかり準備をしていることでしょう」","「名无应该在那里，\n想必她已做好万全准备」"],["「それでも、\nそんなのは駄目だよ、\nわざわざ危ない橋を渡る事はない──」","「即便如此，\n这样还是不行的，\n没必要特地去走独木桥──」"],["「……一時の感情に身を任すも、[l]\n固き意志、誇りを貫くも、\nいずれ愚かな独り善がり、\n行き着くは同じ場所……[l]\nではどちらが●●なのか──」","「……纵使一时感情用事，[l]\n抑或坚守钢铁意志与骄傲，\n终究都是愚蠢的自以为是，\n终点皆为同一处……[l]\n那么哪边才是●●呢──」"],["「…？」",""],["「それを知る意味でも、\n私はあれの前に姿をみせねばならない、\nしかとこの眼で、\nあれと相対した時に、\n……忘れ得ぬどれだけの想いが、[l]\n燻り続けた炎が消えていないかどうか、\n確かめることが、\n今の私にとってはこよなき糧と、なる筈」","「正是为了确认这点，\n我才必须现身于她面前，\n用这双眼睛，\n在与她相对之时，\n……确认那些无法忘却的思念，[l]\n确认那些闷烧至今的火焰是否仍未熄灭，\n对我而言，\n此刻这比任何食粮都更重要」"],["「でも、そうは言っても──\n……はっ、」","「可是、话虽这么说──\n……哈、」"],["「……思い出す、この、[l]\n身の毛立つと同時に湧き上がる、\n腹立つ思い──」","「……想起来了，这[l]\n令人毛骨悚然又翻涌而上的，\n愤怒之情──」"],["ぞぞ。","「……啊。」"],["「──ッの野郎、\n何処に消えやがった、\nただのケダモノじゃねえのかッ、一体、」","「──该死的混蛋，\n躲到哪里去了，\n不是普通的畜生吗、到底──」"],["「──っ、音っ！」","「──啧、声音！」"],["「？！[l]\nあぁっ、どうしたのさ。[l]\n今、綾目のカミを咥えたケダモノ追っかけて……ん、[l]\n誰だそれは」","「？！[l]\n啊啊、怎么回事啊。[l]\n刚才还追着叼走绫目头发的畜生……嗯、[l]\n那家伙是谁」"],["「これは価無君、\n玖威、価無だ。[l]\n君の──妹になるな」","「这位是价无君、\n玖威、价无。[l]\n算是你的──妹妹吧」"],["「……あぁーん？」","「……哈啊ー？」"],["「君が追ってるのは恐らくベロアだろう。[l]\n魔女ミリアムの猫だ。[l]\n今彼は八相の紙を回収している、\n君と同様に」","「你追的恐怕是贝萝娅吧。[l]\n魔女米莉安姆的猫。[l]\n现在他正在回收八相的纸张、\n和你一样」"],["「んだと？[l]\nじゃあ……そいつの、[l]\nクイのカミも、もうねェンだな？」","「啥？[l]\n那……那家伙的、[l]\n奎的头发、也已经没了吧？」"],["「そういうことだ。[l]\n僕のは無事だが、どうするか、\n君に今渡してしまうべきか」","「就是这么回事。[l]\n我的倒是没事、但该怎么办、\n现在该不该交给你呢」"],["「……らねぇなぁ、今のタイミングじゃ」","「……才不要咧、现在这节骨眼」"],["「……まあそうだろうな。[l]\nprot－ein自体は有用だろうが、\n作成に時間が掛かりすぎるだろうし──」","「……也是呢。[l]\nprot－ein本身应该有用、\n但制作太花时间了──」"],["「……あんた、どうしたのさ。[l]\nどうにも精彩を欠いてンな──って、\n言葉合ってるか？」","「……你怎么搞的。[l]\n总觉得没精打采的──喂、\n我说对了吗？」"],["「ああ、合ってる……よく勉強したな。[l]\nそれに、精彩を欠いてるのも事実……だろうな。[l]\n少々、自信喪失してるのかも知れないね。[l]\n僕としたことが、\n自分でも考えてもみなかった事だが」","「啊、说对了……很用功嘛。[l]\n而且、没精打采也是事实……吧。[l]\n说不定、我有点丧失自信了。[l]\n明明是我、\n连自己都没想到会这样」"],["「あんたらしくねェなあ。[l]\nそれより、\n何の用だよ、呼び止めてまでよ」","「真不像你啊。[l]\n比起这个、\n到底什么事、非要叫住我」"],["「──近くに、\n強力な存在……敵となり得るモノが来ている。[l]\n八相連中とは別の──先日君を襲った例の連中の、\n","「──附近有、\n强大的存在……可能成为敌人的东西来了。[l]\n和八相那帮人不同的──就是前几天袭击你的那群人的、\n"],["元","原"],["締だ」","首领」"],["「ぁあ？[l]\nああ。[l]\nその手の邪魔が入るなァ、\n判ってた事じゃなかったのか？」","「哈啊？[l]\n啊啊。[l]\n这种节骨眼来捣乱、\n不是早就知道会这样吗？」"],["「……何とも言えん。[l]\n僕のこの不調と関係あるかも知れないが……[l]\n何か想定以上の『悪い感じ』がするのだよ。[l]\n畏れるべき何かが……」","「……不好说。[l]\n可能和我这状态有关……[l]\n总觉得有种超出预期的『不祥预感』。[l]\n像是要遭遇什么可怕的东西……」"],["「……ほんとにらしくねえぞ。[l]\nそンで、俺におうちに帰れとでも言うのかよ？」","「……真的太不像你了。[l]\n所以、你是要我现在滚回家吗？」"],["「……いや、[l]\n……だが、重々気をつけろ。[l]\nお前まで失うのは、僕の本意じゃない」","「……不、[l]\n……但千万小心。[l]\n连你都失去、并非我的本意」"],["「……付き合いも長ェからな、[l]\n今は突っ込まねェよ。[l]\nあんたこそ、帰って寝るなりした方が良いんじゃねェか」","「……毕竟打交道这么久、[l]\n这次就不深究了。[l]\n倒是你、回去睡一觉比较好吧」"],["「音、」","「音、」"],["「ま、それは冗談としても、\nその、カナか？[l]\nそいつはちゃんと世話っつーか、\n介抱してやってくれよ。[l]\n俺の、」","「嘛、就算那是玩笑话，\n那个、是卡娜吗？[l]\n那家伙可得好好照顾或者说，\n给我看护好了。[l]\n那可是我的，"],["妹なんだろ。","妹妹啊。」"],["「……わかった」","「……明白了」"],["「じゃな、また後で、──かあさん」","「那就这样、待会见、──妈妈」"],["びょうっ。","咻。"],["「──どうにも、[l]\n調子が狂うな。[l]\n『彼』による何らかの影響かな……[l]\nいずれにしても、\n早い所吹っ切らねばならない。[l]\n僕のヤクは、\n僕の出る幕は、まだまだ先だからな──」","「──无论如何，[l]\n状态都很不对劲啊。[l]\n是『他』造成的某种影响吗……[l]\n总之，\n必须尽快摆脱这种状态。[l]\n我的任务，\n我登场的时候还远远未到──」"],["「おいっ、あったぜ、\nこれで万事解決──あ？[l]\n──おい、おいっ！[l]\n………、[l]\n………、[l]\n………。[l]\n……焦った、[l]\n気失ってるだけか。[l]\n……んや？[l]\n違う……のか？[l]\n","「喂、找到了，\n这下万事解决──啊？[l]\n──喂、喂！[l]\n………、[l]\n………、[l]\n………。[l]\n……慌了神，[l]\n只是晕过去了吗。[l]\n……嗯？[l]\n不对……吗？[l]\n"],["やべぇ、はやいとこ治療開始だ、[l]\n頼むぞ、","糟了、得赶快开始治疗，[l]\n拜托了，"],["保ってくれ、[l]\nあんたも、俺もっ──」","撑住啊，[l]\n你也是、我也是──」"]],"context":[["SC_M_073.ks/index/1/text","SC_M_073.ks/index/3/text","SC_M_073.ks/index/5/text"],["SC_M_073.ks/index/7/text"],["SC_M_073.ks/index/9/text"],["SC_M_073.ks/index/11/text"],["SC_M_073.ks/index/13/text"],["SC_M_073.ks/index/15/text"],["SC_M_073.ks/index/17/text"],["SC_M_073.ks/index/19/text"],["SC_M_073.ks/index/21/text"],["SC_M_073.ks/index/23/text"],["SC_M_073.ks/index/25/text"],["SC_M_073.ks/index/27/text"],["SC_M_073.ks/index/29/text"],["SC_M_073.ks/index/31/text"],["SC_M_073.ks/index/33/text"],["SC_M_073.ks/index/35/text"],["SC_M_073.ks/index/37/text"],["SC_M_073.ks/index/39/text"],["SC_M_073.ks/index/41/text"],["SC_M_073.ks/index/43/text"],["SC_M_073.ks/index/45/text"],["SC_M_073.ks/index/47/text"],["SC_M_073.ks/index/49/text","SC_M_073.ks/index/53/text"],["SC_M_073.ks/index/51/text"],["SC_M_073.ks/index/55/text"],["SC_M_073.ks/index/57/text"],["SC_M_073.ks/index/59/text"],["SC_M_073.ks/index/61/text","SC_M_073.ks/index/65/text","SC_M_073.ks/index/67/text","SC_M_073.ks/index/69/text","SC_M_073.ks/index/71/text","SC_M_073.ks/index/77/text"],["SC_M_073.ks/index/63/text","SC_M_073.ks/index/104/text"],["SC_M_073.ks/index/73/text"],["SC_M_073.ks/index/75/t