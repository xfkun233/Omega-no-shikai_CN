3789,"end":3794},{"start":3924,"end":3929},{"start":4350,"end":4355}],[{"start":618,"end":622}],[{"start":628,"end":681}],[{"start":689,"end":708}],[{"start":716,"end":749}],[{"start":755,"end":770}],[{"start":780,"end":812}],[{"start":889,"end":928}],[{"start":936,"end":1004}],[{"start":1012,"end":1050}],[{"start":1060,"end":1075}],[{"start":1087,"end":1097}],[{"start":1103,"end":1118},{"start":1124,"end":1139}],[{"start":1145,"end":1155}],[{"start":1165,"end":1302}],[{"start":1347,"end":1363}],[{"start":1399,"end":1404}],[{"start":1412,"end":1561}],[{"start":1571,"end":1587}],[{"start":1593,"end":1669}],[{"start":1675,"end":1701}],[{"start":1711,"end":1806}],[{"start":1818,"end":1825}],[{"start":1831,"end":1874}],[{"start":1880,"end":1902}],[{"start":1908,"end":1920}],[{"start":1926,"end":1943}],[{"start":1949,"end":1961}],[{"start":1967,"end":1985}],[{"start":1997,"end":2060}],[{"start":2068,"end":2103}],[{"start":2183,"end":2200}],[{"start":2226,"end":2263}],[{"start":2271,"end":2276}],[{"start":2309,"end":2318}],[{"start":2326,"end":2338}],[{"start":2346,"end":2357}],[{"start":2389,"end":2396}],[{"start":2422,"end":2472}],[{"start":2517,"end":2557}],[{"start":2583,"end":2633}],[{"start":2641,"end":2707}],[{"start":2715,"end":2766}],[{"start":2774,"end":2792}],[{"start":2824,"end":2829}],[{"start":2855,"end":2895}],[{"start":2903,"end":2955}],[{"start":2963,"end":2983}],[{"start":2991,"end":2995}],[{"start":3003,"end":3007}],[{"start":3015,"end":3044}],[{"start":3052,"end":3055}],[{"start":3063,"end":3071}],[{"start":3077,"end":3094}],[{"start":3185,"end":3193}],[{"start":3201,"end":3239}],[{"start":3249,"end":3271}],[{"start":3279,"end":3310}],[{"start":3340,"end":3346}],[{"start":3372,"end":3388}],[{"start":3396,"end":3402}],[{"start":3410,"end":3449}],[{"start":3457,"end":3462}],[{"start":3470,"end":3486}],[{"start":3524,"end":3545}],[{"start":3608,"end":3614}],[{"start":3640,"end":3675}],[{"start":3683,"end":3755}],[{"start":3820,"end":3856}],[{"start":3864,"end":3868}],[{"start":3955,"end":4004}],[{"start":4012,"end":4025}],[{"start":4033,"end":4074}],[{"start":4082,"end":4110}],[{"start":4118,"end":4155}],[{"start":4163,"end":4181}],[{"start":4191,"end":4209}],[{"start":4217,"end":4224}],[{"start":4234,"end":4252}],[{"start":4260,"end":4316}],[{"start":4381,"end":4385},{"start":4393,"end":4397}],[{"start":4405,"end":4410}],[{"start":4418,"end":4463}],[{"start":4471,"end":4475}],[{"start":4483,"end":4488}],[{"start":4520,"end":4531}],[{"start":4597,"end":4605}],[{"start":4611,"end":4631}],[{"start":4637,"end":4649}],[{"start":4655,"end":4665}],[{"start":4671,"end":4685}],[{"start":4691,"end":4703}],[{"start":4725,"end":4726}],[{"start":4736,"end":4750}],[{"start":4756,"end":4779}],[{"start":4785,"end":4798}],[{"start":4804,"end":4819}],[{"start":4825,"end":4837}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_053.ks","basename":"SC_M_053.ks","indexIds":{"気がつくと、\n\n僕は車に乗ってた。":0,"こんな状態で車を運転するなんて、\n危険極まりないから、\n途中、\n何度もコンビニや、\n大きな駐車場をみつけては、\n駐まりながら、\n気をしっかりと持ち直しながら、\nそうやって車を走らせ続けた。":1,"なるべく遠くに行きたかった。":2,"なのに、\nこんな時でも、\n身体も頭も防衛機構が働いて、\n知ってる道、知ってる場所、\n無意識に選んで。":3,"僕が此処に来たあの駅、路線、\nああ、あの山、\n冬夏達の、":4,"色んなものが、\n僕を締め付けて、\nどうせなら、\n知らないところに行きたい、\n知らないものを視たいのに、":5,"「………」":6,"僕は──":7,"\nほんとうのことなのか？[l]\nあのひとのいったことは。[l]\n悪戯じゃないのか？":8,"今更乍らにそう思う、\nでも……":9,"でも、ネコガミは確かに僕は視て、\nあのひとも、宮さんも──":10,"\n霧明……かあさん……":11,"僕はどうやら、\n知らないうちに何処かの駐車場で、眠った。":12,"眼が覚めると、\n夜は明けていた。[l]\n日付は変わっていない。":13,"夕べ逐電したのは何時だったのか、\nどっちにしろ運転席での無理な体勢での仮眠だったのだろう、\n節々が痛く、\n寒い。":14,"何かを食べなきゃ、と思ったけれど、\nこの町でヒトと会いたくなかった。":15,"此処が僕の為に仕組まれた舞台？":16,"──何かを忘れている":17,"\n──何かを忘れている":18,"\n全部偽り？":19,"ああ、その辺を歩いているヒトも、\n対向車の運転手も、\n談笑している主婦達も、\nまるで、\nねこの大集団かと錯覚して、\n……ああそれは、[l]\nあのとき読んだ本の、記憶の残滓なのかな……[l]\nあれはもう、いつのことだか、":20,"「みやさん……みや……さん……」":21,"声を出せ。":22,"自分の身体を、現実を実感して、\nチカラを入れろ。[l]\nつまり自覚するチカラ、\nセカイと向き合う意思。[l]\nしっかりと前を向き、\n問題に対処するんだ、\n逃げたところで解決はしない、\n自分から取り組むことが、\nたったひとつの冴えた──":23,"そうは思ってる、分かってるけど、":24,"\n泣き叫ぶ事で、興味を自分に向けたいんだ、\n僕を視てと、\n僕に構ってと、\n僕を愛してくれと、\nそう言いたいんだ、":25,"@rたぶん、かっこわるいけど、そんな、とこだ……":26,"だから、ほんとは泣き叫びたい、\nけど、\n何が理由か分からない、\n現状が把握できない、\n泣くのにさえ論拠を求める程には冷静な、\nそんな部分が確かにあり、":27,"──なぜなら、":28,"\n僕は宮さんが言ったことが本当だろうと、\n心の何処かで承知してるから、":29,"\n──だが、ミルハは●●されている、":30,"\n感情と理性が、":31,"\n──イーハが●●している":32,"\nそのアワイで、":33,"\n──イーハも●●されている":34,"結局、考えるのを放棄して、\n僕は再び車を走らせた。[l]\nガソリンが切れるまで、\n走ってみようかな……":35,"そんな事を考えながら、\nやっぱり視覚えのある風景に通り掛かる。":36,"「ここは……[l]\nああ」":37,"ここはあのときのあの場所、\n玄ノ森に来て冬夏を初めて視たあの、道、":38,"あのみち、":39,"黒い喪服の集団が、":40,"そう、あのときのように、":41,"……あのときのように？":42,"「……葬礼だ」":43,"あの時と同じように、\n黒い服に身を包んだ一団とすれ違う。[l]\n僕は眼が離せずに──":44,"「……！！！[l]\nとうかだ、\nとうか、\n冬夏っ！！！」":45,"……？[l]\n髪が短くなってるようだけど、\n視間違いようのない、\nあの金髪、":46,"それに、周りにいるのは、\n狩屋、多分狩屋、そして他の、道具さん卑尊さんのぎかさん\n……姫様ちゃん、は、視当たらない。":47,"ああ、あの眼鏡は多分式場で会った……玉梓選律、[l]\n他のもきっと、\n八相、の人間達、":48,"だから、あれは冬夏、そうに違いない！":49,"「冬夏っ」":50,"幸いにも後続車も居なかったので路肩に寄せ、\n停車して窓から身を乗り出す。":51,"狩屋が言ってた火曜まで待てと言うのは、\nこのことだったのか？[l]\nでも、誰かが死んだ？":52,"いや、それを考えるのはあとにさせてくれ、":53,"とうか、":54,"冬夏っ、":55,"何も考えずにその名を呼んだ。[l]\nつもりだった。":56,"でも、":57,"コエが、でない、":58,"それでも、彼女はこちらを向いて──":59,"振り向いた彼女。":60,"とうかの左眼は、\nあの時視た義眼ではなく、\n無事だった右眼と":61,"違わぬ、\n完全なるものとしてあった。":62,"そしてその、\n十全となった両眼で僕を視た──筈だった。":63,"「………？」":64,"僕を視て、\n眼が合って、":65,"それなのに。":66,"ぼくのことをしらないかのように、\nまるで知らないモノを視るかのように、":67,"首を傾げ、":68,"そのまま、何事もなかったように。":69,"振り向いて、\n葬列に戻っていった。":70,"「……え？」":71,"怒ってるとか、\n無視したとか、\nそういう感じじゃない。":72,"ほんとに、最初のあのときのように、\n僕を、赤の他人のように、\nただそこにいたひとにめをむけたにすぎない、\nそんな所作──":73,"なんの、ドッキリなんだ？[l]\n大がかりにも、ほどがある、だろ？":74,"そんな、":75,"他の誰も、あのひともあのひともあのひとも、\n僕を視ない。[l]\n気付いても居ない。":76,"だれもぼくを●らないのか？":77,"ああ、声が。[l]\nコエが、どうしても、出ない、\n出ないんだよ……":78,"……なんでだよ？[l]\n僕が、君等の敵だからか？":79,"そんなこと、君等は知らないんだろ？[l]\n宮さんはそう言ってたよ？":80,"僕は、君等の敵になんかなりたくない、":81,"だれのてきにもなりたくないんだよ──":82,"──てきは●●":83,"……彼女達の姿はもう遠くなっていた。":84,"車、移動させなきゃ、\nそんな常識的思考は、相変わらずアタマの何処かで常に、\n冷静に動き続けてる。":85,"………。":86,"あはは……":87,"今までの脳空転の僕が、\nまるで嘘みたいだな、\nたいした、進歩じゃないかよ。":88,"さぞや、":89,"さぞや……":90,"「……僕は、さい──」":91,"車を発進させた。":92,"@r彼女達が消えた方向は視なかった。":93,"@r海に走っていた、":94,"@rあの海岸に、":95,"@r海は自分の小ささを、":96,"@rだからあの海に。":97,"只":98,"管、冷静な自分に身を委ねて、":99,"@r感情を、あの海についてから、思う存分、":100,"@rぶちまけるために、":101,"@rだから、今は、冷静だ。":102,"@r──何かを忘れて":103},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_053.ks","relPath":"/data/scenario/SC_M_053.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":101,"length":104,"percent":97.11538461538461},"cellInfo":[]},"/data/scenario/SC_M_054.ks":{"data":[["さあ、何度目だろう、ここにたつのは。","来吧，这是第几次站在这里了？"],["子供の頃も、立ったのだろうか？[l]\nそのとき、君と会ってたのかな？[l]\n僕は。[l]\nそれを確認しようと、してたんだろ？[l]\nなのに、","小时候，也曾站在这儿吗？[l]\n那时候，是否遇见过你呢？[l]\n我。[l]\n是想确认这件事吧？[l]\n可是，"],["「………」",""],["そして、\n貴女はそんな頃から、ずっとずっと前から、\n僕を、知ってたんだ？[l]\n知っていて、","然后，\n你从那时候起，从很久很久以前，\n就认识我吗？[l]\n明明知道，"],["しっていて、","明明知道，"],["──知っていてしたことだ","──明知如此却还那么做"],["僕は、\n貴女が●●、なのに、●●なのに、\nそれだけだったのに、","我，\n你明明●●，明明●●，\n仅此而已，"],["なんでだよ、","为什么啊，"],["\n僕は、貴女が、もう、","\n我，你已经，"],["\n……",""],["いや、貴女はさいしょから、","不、你从一开始、"],["貴女は僕が、","你是我、"],["僕はっ、貴女が……っ、","我是、你是……、"],["だい、……っっっきらいだ、[l]\n嫌いだ、キライだ、貴女なんか、","最、……讨厌了、[l]\n讨厌、最讨厌、像你这样的、"],["DIE KILL-EYEだ、","DIE KILL-EYE啊、"],["あなた、なんか、","你这样的、"],["あんたなんか、","像你这样的、"],["み……さん、[l]\nあんた、なんかっ！","爱……小姐、[l]\n你这家伙、搞什么啊！"],["おまえなんか、","像你这种人、"],["おまえなんか！","像你这种人！"],["だい………………だっての………","大………………不了………"],["……………せて…る、………てやる……[l]\n……ちがう、そんな、ああ…[l]\nな、っんで、こんなに、わけわかんないのに、","……………让…你、………尝尝……[l]\n……不对、不是的、啊啊…[l]\n为、为什么、明明这么、莫名其妙、"],["たったひとつだけゆらがない、","唯独这个绝不动摇、"],["こんなにもイタイカンジョウが、","如此令人痛苦的感情、"],["……サイテイだ、サイテイだ……[l]\n…このアイは、[l]\nサイテイだ、……っ、","……最差劲了、最差劲了……[l]\n…这个爱、[l]\n最差劲了、……呃、"],["……サイテイの、アイだ──","……差劲透顶的、爱──"]],"context":[["SC_M_054.ks/index/1/text"],["SC_M_054.ks/index/3/text"],["SC_M_054.ks/index/5/text","SC_M_054.ks/index/13/text"],["SC_M_054.ks/index/7/text"],["SC_M_054.ks/index/9/text"],["SC_M_054.ks/index/11/text"],["SC_M_054.ks/index/15/text"],["SC_M_054.ks/index/17/text"],["SC_M_054.ks/index/19/text"],["SC_M_054.ks/index/21/text"],["SC_M_054.ks/index/23/text"],["SC_M_054.ks/index/25/text"],["SC_M_054.ks/index/27/text"],["SC_M_054.ks/index/29/text"],["SC_M_054.ks/index/31/text"],["SC_M_054.ks/index/33/text"],["SC_M_054.ks/index/35/text"],["SC_M_054.ks/index/37/text"],["SC_M_054.ks/index/39/text","SC_M_054.ks/index/41/text"],["SC_M_054.ks/index/43/text"],["SC_M_054.ks/index/45/text"],["SC_M_054.ks/index/47/text"],["SC_M_054.ks/index/49/text"],["SC_M_054.ks/index/51/text"],["SC_M_054.ks/index/53/text"],["SC_M_054.ks/index/55/text"]],"tags":[],"parameters":[[{"start":200,"end":218}],[{"start":226,"end":312}],[{"start":357,"end":362},{"start":537,"end":542}],[{"start":396,"end":454}],[{"start":462,"end":468}],[{"start":478,"end":490}],[{"start":576,"end":615}],[{"start":625,"end":631}],[{"start":637,"end":652}],[{"start":658,"end":665}],[{"start":675,"end":688}],[{"start":694,"end":700}],[{"start":706,"end":717}],[{"start":727,"end":763}],[{"start":769,"end":783}],[{"start":793,"end":801}],[{"start":807,"end":814}],[{"start":820,"end":843}],[{"start":853,"end":860},{"start":866,"end":873}],[{"start":879,"end":886}],[{"start":898,"end":913}],[{"start":927,"end":995}],[{"start":1001,"end":1015}],[{"start":1021,"end":1036}],[{"start":1046,"end":1094}],[{"start":1104,"end":1117}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_054.ks","basename":"SC_M_054.ks","indexIds":{"さあ、何度目だろう、ここにたつのは。":0,"子供の頃も、立ったのだろうか？[l]\nそのとき、君と会ってたのかな？[l]\n僕は。[l]\nそれを確認しようと、してたんだろ？[l]\nなのに、":1,"「………」":2,"そして、\n貴女はそんな頃から、ずっとずっと前から、\n僕を、知ってたんだ？[l]\n知っていて、":3,"しっていて、":4,"──知っていてしたことだ":5,"僕は、\n貴女が●●、なのに、●●なのに、\nそれだけだったのに、":6,"なんでだよ、":7,"\n僕は、貴女が、もう、":8,"\n……":9,"いや、貴女はさいしょから、":10,"貴女は僕が、":11,"僕はっ、貴女が……っ、":12,"だい、……っっっきらいだ、[l]\n嫌いだ、キライだ、貴女なんか、":13,"DIE KILL-EYEだ、":14,"あなた、なんか、":15,"あんたなんか、":16,"み……さん、[l]\nあんた、なんかっ！":17,"おまえなんか、":18,"おまえなんか！":19,"だい………………だっての………":20,"……………せて…る、………てやる……[l]\n……ちがう、そんな、ああ…[l]\nな、っんで、こんなに、わけわかんないのに、":21,"たったひとつだけゆらがない、":22,"こんなにもイタイカンジョウが、":23,"……サイテイだ、サイテイだ……[l]\n…このアイは、[l]\nサイテイだ、……っ、":24,"……サイテイの、アイだ──":25},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_054.ks","relPath":"/data/scenario/SC_M_054.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":24,"length":26,"percent":92.3076923076923},"cellInfo":[]},"/data/scenario/SC_M_055.ks":{"data":[["すべての音が明瞭にきこえてはいるけれど、\n","虽然所有声音都清晰可闻、\n"],["ただそれだけ。","仅此而已。"],["只管にざわついたあのときは過ぎ去って、\n","那个只顾喧嚣的时刻已然逝去、\n"],["今思考は停止してるようなものだ。","现在思考近乎停滞。"],["でもきっと眼の前の波と同じく、\n","但肯定和眼前的浪涛一样、\n"],["寄せては返すその波と同じく、\n","和那潮来潮去的浪涛一样、\n"],["再びこころは荒れたりさざめいたりするのだろう。","这颗心终将再次躁动或泛起涟漪吧。"],["今の僕は──否、昔からきっと僕は、\n","现在的我──不、恐怕从以前开始、\n"],["僕のこころは、\n","我的这颗心、\n"],["まるで両手に持った大きなベニヤ板の上のボーリング玉なんだ。","就像是双手捧着的大胶合板上放着的保龄球。"],["落とさない様にするには\n常に力を込めてバランスを取らねばならない。","要想不让它掉落\n就必须时刻用力保持平衡。"],["少しでも転がり出せば、止めるのは容易でない。","只要稍微滚动起来就很难停下。"],["そのままでは端から落ちる。","这样下去会从边缘滚落。"],["だから反作用的に別方向に傾けないといけない。","所以必须反方向倾斜来抵消。"],["そしてそれも行き過ぎては駄目だ。","但倾斜过度也不行。"],["繰り返し。","周而复始。"],["必死で腕を、身体を引き攣らせながら。","拼命绷紧手臂和身体。"],["何とか玉を落ち着けようとする。","设法让球稳定下来。"],["静かで安寧な状態は僕自身が静止するしかないのに、\n","想要安静祥和的状态除非我自己完全静止、\n"],["そうはいかない。","但这不可能。"],["セカイには僕だけが居る訳じゃないし、\n","世界并非只有我存在、\n"],["風も吹くし雨も降る。","会刮风也会下雨。"],["僕以外の要素が絶えず僕の板を、玉を揺るがす。","我以外的因素不断摇晃着我的板和球。"],["他のひとはきっと、バランスを取るのが巧いか、\n","其他人大概要么擅长保持平衡、\n"],["或いは板の端にストッパーがあるとか、\n玉自体が扱いやすい大きさ、重さ、\n","要么板的边缘有挡板、\n要么球本身大小重量容易掌控、\n"],["だったりするんだろうな。","之类的吧。"],["否、そうでなくても僕が特に、扱いが下手なんだ、\nそうなんだきっと。","不、就算不是这样也是我特别不擅长应付、\n肯定是这样。"],["どっちにしても、今の僕は、\n","无论如何、现在的我、\n"],["端から落ちた玉を拾い上げて、\n","只是捡起从边缘掉落的球、\n"],["板の上に置いただけなんだ。","重新放回板上而已。"],["だから屹度また揺れ出すんだ。転がり出すんだ。","所以肯定又会摇晃起来。滚动起来。"],["制御出来る程の力が戻らなきゃ、\nその重い玉はまたどんどん加速して──\n","若不能恢复足以控制的力量、\n那个沉重的球就会不断加速──\n"],["そう、\n","没错，\n"],["僕を一層苦しめる、というか、自己嫌悪に陥る理由（わけ）は、\n","让我更加痛苦、或者说陷入自我厌恶的理由是、\n"],["どうあれ今の僕にすら、\n","无论如何就连现在的我、\n"],["板も玉も存在してるという事なんだ。","板和球都依然存在这个事实。"],["「──腹もしっかり減る、トイレにも行ける、\n身体的欲求は何も、変わらない……」","「──肚子照样会饿、也能正常上厕所、\n生理需求毫无变化……」"],["そしてその事自体を認識し、\n自己嫌悪のようなざわざわした感情にぶちのめされる。","然后意识到这件事本身、\n就被这种躁动不安的自我厌恶感彻底击垮。"],["冷静な僕と、\n掻き乱された僕が、\n","冷静的我与、\n被扰乱的我、\n"],["不思議と同居している。","不可思议地共存着。"],["きっとこれは反動、\n自己防衛のこころのはたらき──\nあまりにも強烈な衝撃は逆に、\nそれを緩衝しようとする働きも強固に現れるんだろう、\n今は、\n全くの、\n","这一定是反作用力、\n心理上的自我防卫机制──\n过于强烈的冲击反而会、\n激发出更强大的缓冲作用吧、\n现在、\n完全是、\n"],["「……」",""],["今、この混沌故の冷静さがほんとうに納まったら、\n","此刻因这片混沌而生的冷静若真的沉淀下来、\n"],["沈殿して鎮静化したら、\n","等它沉降镇静之后、\n"],["恐らくその後に来るのは、\n改めての自己嫌悪か、その逆、つまり、\n","恐怕随之而来的会是、\n新一轮的自我厌恶或是相反的情绪也就是、\n"],["「貴女を……憎いと思うように……[l]\nなる…………のかな……」","「说不定会……变得……[l]\n开始憎恨你…………呢……」"],["貴女にはっきりと、攻撃、罵倒、されたのなら、\nそういう感情にもすんなりなれるのだろう、\n","若是被你明确地攻击、辱骂、\n或许就能坦然接受那种感情了吧、\n"],["いっそ貴女が、\n","倒不如说你要是、\n"],["僕をキライだと言っていて","直接说讨厌我"],["呉れていれば、\n","就好了、\n"],["だけど、\n","可是、\n"],["それすら、\n","就连这个念头、\n"],["だから、\n","所以\n"],["「………」",""],["思考はそこで止まる。","思考也在此停滞。"],["空転すらしない。","连空转都做不到。"],["動きようがない、足掻きようがない、\n","无从行动 无从挣扎、\n"],["理不尽に説教をされてる時のように、\n","就像被迫听无理说教时那样、\n"],["そして結局、\n冷静になったり、\nそれでいて未解決の問題がずっと存在を主張するから、\n乱れ、\n","最终、\n即便恢复冷静、\n未解决的问题仍会持续彰显存在感、\n于是紊乱、\n"],["でもロジカルな思考に逃げようとも行き詰まる、\n","连试图逃向逻辑思考都会碰壁、\n"],["──何かを忘れているから？","──是遗忘了什么吗？"],["いや、\n","不，\n"],["思考が止まるのは、\n","思考之所以停滞、\n"],["──自分で道を閉ざすからだ。","──是因为自己堵死了前路。"],["本来あるはずの選択肢、選ばざるを得ない道が厳然とあるのに、\n","明明存在着本该有的选项和不得不选的道路、\n"],["──こころの奥底では拒むのだが明文化出来ないから、\n","──心底抗拒却无法明言、\n"],["言い訳が出来なくて、\n","找不到借口、\n"],["──コトバを使おうとするならfrEEzEすることに、\n","──若试图组织语言就会陷入frEEzE、\n"],["望んでいるのに言えない本当のことがあるから、\n","正因为怀着无法说出口的真实愿望、\n"],["「……ちくしょう……」","「……可恶……」"],["フラストレーションはどうしたって、\n","挫折感无论如何、\n"],["イカリに変わっていく。","都会转化为焦躁。"],["怒りを思う事自体、\n八つ当たりだと分かってる、でも、\nそれを自制しようとする行為が更に、\n苛立ちや、苦しみや、そういった厭なものが、\n","明明知道动怒本身、\n就是迁怒 可是、\n试图克制这种行为反而会、\n让烦躁啦痛苦啦这类负面情绪、\n"],["──適度、あくまでも適度な範疇で、\n","──在适度  strictly适度的范围内、\n"],["発散しなければ、\n","若得不到宣泄、\n"],["──その程度の事は餌として扱えよう。","──这种程度的事就该当作饵料处理。"],["「……波が……振幅の差が……」","「……波浪的……振幅差……」"],["……明鏡止水なんて状況は、[l]\nそうそうないんだろう。","……所谓明镜止水的状态、[l]\n终究可遇不可求吧。"],["眼前の海は常に、\nざわめいて、\nどんなに静かって言っても波が無くなる事はない。","眼前的大海永远、\n喧嚣不止、\n再怎么平静也不可能彻底无波。"],["──雫の一滴が波紋を、\n","──一滴水珠就能激起涟漪、\n"],["でも僕は、\nそんなのは、\n嘘でも僕は、\n","可我、\n就算是、\n谎称自己也、\n"],["「………昇った分だけ落ちるくらいなら、[l]\nはじめから──」","「………既然爬多高就会摔多狠、[l]\n还不如从一开始──」"],["鏡面の如く凪いだ","想要凝视如镜面般平静的"],["水","水"],["面をのぞむのに──\n","面时──\n"],["──雫は波紋をもたらすもの。","──水珠本就是带来波纹的存在。"],["「………きらいだ……って言えたなら……」","「………要是能说出……讨厌你就好了……」"],["………。",""],["度を超えた痛み故か、\n何度も考えてるように単なる反動か、\n","或许是因为超越了限度的疼痛，\n又或者只是反复思考后的单纯反弹，\n"],["今の僕のなかは、\n","如今的我心中，\n"],["「……あんな、……くそ、……」","「……那种……该死的……」"],["くろいかんじょうがある。","盘踞着黑色感情。"],["それは反動として……つまり副作用として──[l]\n副作用という言葉がこの場合、\n合ってるのかどうか分からないけど、\n自分を護る為に、\nあのひとを悪者にしようとしてる、\nそんなかんじょうなんだと思う。","那作为反弹……也就是作为副作用──[l]\n虽然不确定「副作用」这个词，\n用在这种场合是否准确，\n但我觉得这是\n为了保护自己，\n试图将那个人妖魔化的情绪。"],["我ながら冷静に分析するけど、\nそう考えるって事は暗に、\n『本当はそうじゃない』、『あのひとは悪くない』と、\n思いたい事の顕れだろう。","虽然自认为是在冷静分析，\n但会产生这种想法本身就暗示着\n『其实并非如此』、『那个人没有错』，\n这不过是内心渴望的体现吧。"],["逆に言えば、\nそう思わずに居られないのは、\n","反过来说，\n之所以会不由自主这么想，\n"],["それが反動の所為なんかじゃなく、\n","不是因为什么反弹效应，\n"],["『本心から』あのひとを、\n","而是『发自心底』觉得那个人──\n"],["「………●●●だったら、どう、しよう……」","「………要是●●●的话，该怎么办……」"],["って、思うからで……","会产生这种念头……"],["そして再び僕は、\nざわざわして、\n締め付けるようなかんじょうの痛みに顔を","于是我又一次\n因心中翻腾的、\n绞紧般的感情疼痛而"],["顰めた。","扭曲了面容。"],["いま、ぼくのこころにある冷静でない部分は、\n","此刻我心中不冷静的部分，\n"],["これはきっと、\n","这一定、\n"],["やっぱり悲しみや何かというよりも。","终究不是悲伤之类的情绪，"],["怒りであり、\n","而是愤怒，\n"],["悔しさであり、\n","是懊悔，\n"],["……憎しみなのか。","……亦或是憎恨。"],["なぜ？","为什么？"],["なぜなんです。","为什么啊。"],["なんでですか。","为什么啊。"],["どうして。","为什么。"],["止まる思考が行き着く所はせいぜい、\nそのコトバ。","停滞的思绪最终所能抵达的，\n不过是这样的话语。"],["きっとただの反動なんだ、自己防衛なんだ、\n自己弁護の言い訳、屁理屈なんだ、\nそう思いたいけど──\n","肯定只是反弹罢了，是自我防卫，\n是自我辩护的借口，是歪理，\n虽然想这么认为──\n"],["「……あなたが、●●●だ……」","「……你才是，●●●……」"],["──自己を保つ為に他者を相対的に貶めること、\n","──为了维持自我而相对贬低他人，\n"],["じゃないと僕は、泣きたい、逃げたい、ただの、\n","若不这样做，我就只想哭泣、想逃避，\n"],["──絶対的位相を処するならそれもやむなし、自己完結なら、\n","──若以绝对相位来处理倒也无妨，若是自我完结便罢，\n"],["でもそれじゃ駄目なんだ、ヒトとして、\n","但这样是不行的，作为人，\n"],["──ヒト？","──人？"],["僕はヒトだって、\n","我是人什么的，\n"],["──その思考は無為だ。","──这种思考毫无意义。"],["「僕は、ひとが……ひとなんて……」","「我这种人……人类什么的……」"],["……僕は沢山の他人と接するのが怖かった。[l]\n友人以上に親しくするのには物凄く慎重だった。","……我曾非常害怕与众多他人接触。[l]\n对于发展比朋友更亲密的关系总是极度谨慎。"],["それは","这完全是因为"],["偏に他人に嫌われるのが怖かったからだ。[l]\n自分というものがあやふやで、\nいつも他人を評価（批評？）しながら、[l]\nつまり相対的に自分の","害怕被他人讨厌。[l]\n由于自我认知模糊不清，\n总在评价（批评？）他人的同时，[l]\n必须通过相对化来确认"],["位","整个"],["置というものを確認しなけりゃ、\n不安で不安でしょうがないから、\nだから、他人に自分の事を否定──嫌われたり、怒られたり、\n避けられたり無視されたりするのが怖くて、\n必要のない存在と思われるのが耐えられなくて、\n彼我の温度差を感じるのが","自己的处境，\n否则就会不安得无以复加，\n所以害怕被他人否定──被讨厌、被训斥、\n被回避或被无视，\n无法忍受被认为是不必要的存在，\n感受到彼此的温度差"],["堪らなく悲しくて、\n","就会悲伤得难以承受，\n"],["あんな思いをするのはイヤだから、\n","因为不愿再经历那种感受，\n"],["そんな仕打ちを受けるならいっそ最初からと、\n一定以上に親しくなるのを避けていたんだ。","要是会受到这种对待还不如从一开始就，\n我一直避免与人过度亲近。"],["近づけば近づく程、\n向こうを向かれた時の痛みが、\nあんな、──。[l]\n……そんな機会を自分から増やすなんて、[l]\n沢山の他人と知人友人になるなんて、\n","越是靠近，\n被转身相对时的痛楚，\n那样，──。[l]\n……主动增加这种机会什么的，[l]\n和众多陌生人成为熟人朋友什么的，\n"],["──疑うべき対象が許容量を超えてしまっては、\n","──当需要怀疑的对象超过承受极限时，\n"],["僕は、傷付きたくなかったんだよ。","我，只是不想受伤啊。"],["──面倒なだけで何の利点も無いからな。","──纯粹是麻烦又毫无益处罢了。"],["そして、\n","接着，\n"],["──はじめからそんなものいなければいいとおもったのだな\n","──从一开始就不该存在这种东西才对\n"],["それでも僕も処世術のようなものを小賢しく身につけて、\n一般的な範疇での社交性のようなものを纏いながら……[l]\n纏った気になりながら、\n","即便如此我也狡猾地学会了处世之术，\n披着普通程度的社交性外衣……[l]\n自以为披上了外衣，\n"],["──他人とのかかわりが時に重くなる\n","──与他人的羁绊有时会变得沉重\n"],["新たなコミュニティーに属すようなこともあったけれど、\n","虽然也曾加入过新的群体，\n"],["──自分を悪者にしてでも、他人を貶めてでも\n","──哪怕把自己变成恶人，哪怕贬低他人\n"],["重くなる、その視えない恐怖が、不安が、\n繋がり続けることに対しての、\nやがて来るわかれを予感して、\n","那份日益沉重的、无形的恐惧与不安，\n对于持续维系关系的，\n预感到终将到来的离别，\n"],["僕を見捨てないでと、\n","请不要抛弃我，\n"],["──ワレがひつようなのだろ\n","──是吾需要汝吧\n"],["心の底から、期待に添いたいのに、\n","明明打从心底想要回应期待，\n"],["──アレがそういったのだ\n","──是那东西这么说的\n"],["応えられなかったらどうしよう、どうしよう、\n","要是无法回应该怎么办，怎么办啊，\n"],["──だから\n","──所以\n"],["自らその繋がりを辞してきた。","我主动切断了那些联系。"],["──不用意な繋がりの網はアレらにとっても望まぬ所だった\n","──轻率的羁绊之网对它们而言亦非所愿\n"],["……でもそれは単に経験して成長するのを怠ってきたに過ぎなかった。","……但这不过是我怠于通过经历来成长罢了。"],["それなのに、僕もこんな、いいオトナになってしまった。","即便如此，我也变成了这样，像个像样的大人。"],["大人の麻疹は重症だって、\n今更、\n","听说成年后得麻疹会很严重，\n事到如今，\n"],["他の普通のヒト達はきっとこんなこと、\n何ともなく過ごせているんだろうし、\nきっと僕が悩んだり苦しんだりしてる事も、\nみんなが経験して、克服したり、やり過ごしたりしてる、\nただの日常なんだ。","其他普通人肯定对这种事，\n都能轻松应对吧，\n就连让我烦恼痛苦的事情，\n大家也都经历过，或克服，或熬过去了，\n不过是日常而已。"],["でも、そんな事すらも、\nいちいち","但是，就连这种事，\n都会"],["躓いて、痛がったり打ちのめされたりしてる、\n僕はそんな自分が、\n","屡屡绊倒，痛得打滚崩溃，\n这样的我，\n"],["──自分が●●●なのか？","──难道我是●●●吗？"],["たにんをうらやんで、\n卑下して、\n自信も何もなく流されていく事自体に心地よさすら感じて、\nそれでも、やっぱり悔しさや何かをしっかり抱えながら、\n屈折したそんな、\n","嫉妒着他人，\n自我贬低，\n连随波逐流失去自信的状态都感到惬意，\n即便如此，仍怀抱着不甘与其他情绪，\n如此扭曲的，\n"],["そんな僕でも、\nこの人になら近づきたいと思えたひとたち、\n大神や、\n……、","这样的我，\n也有想要主动靠近的人们，\n比如大神，\n……，"],["「み…や、さん」","「三…谷、小姐」"],["誰よりも他人との繋がりを欲している癖に、\n誰よりも他人を怖がって嫉妬して来た僕は、\n","明明比谁都渴望与他人的联系，\n却比谁都恐惧嫉妒着别人的我，\n"],["他人を、否、友人知人を、\n自分に都合の良い道具としか視ていなかったという、\n事なのかな？","难道一直把他人，不，把朋友熟人，\n都当成方便自己的道具来看待吗？\n是这样吗？"],["……その報いがこの有様か。","……这就是报应吧。"],["「……わからない……」","「……不明白……」"],["もういやだ、いやなのに、\n","已经够了，明明很抗拒，\n"],["──",""],["単","单"],["体で","靠"],["生くは不可能なんだよ\n","自己是活不下去的啊\n"],["冷静な部分が、\n","理性的部分在，\n"],["まだみちがあると、\nクダラナイ事で止まるなと、\n瑣事だ瑣事だ瑣事なんだよと、\n","还有路可走，\n别因无聊的事停下，\n琐事啊琐事啊都是琐事啊，\n"],["──事実だ\n","──这是事实\n"],["必死になって立て直そうとするその無意識的思考は、\n","拼命想要重整旗鼓的那份无意识思考，\n"],["──設問が誤な為に解法を模索するのは徒労だ\n","──因设问错误而寻求解法只是徒劳\n"],["どうしても、あのひとのことを、\n","无论如何都，关于那个人的事，\n"],["──本調子まであと何律か──\n","──距离正常状态还差几拍──\n"],["それとも僕はほんとうにあのひとが憎いのか。","还是说我其实真的恨那个人。"],["分からない……","不明白……"],["でも、\n","可是，\n"],["時は流れていく、容赦なく、\n","时间无情地流逝，\n"],["このままじっとしていても、たとえ僕が何もしなくても、\n","就算这样一动不动，即使我什么都不做，\n"],["僕があのひとを憎まない道を選んだとしても、\n","就算我选择不恨那个人的道路，\n"],["それはつまり、\n","那也就是说，\n"],["彼女達との──\n","与她们──\n"],["歪で","扭曲的"],["背","背"],["徳い出会いではあったけど、\n僕を受け入れてくれたあの、\n例えその理由が……その……であっても、[l]\n僕が●●●だからなんだとしても、\n","德般的相遇虽说是事实，\n但那个接纳了我的，\n哪怕那个理由是……那个……也罢，[l]\n哪怕是因为我是●●●的缘故，\n"],["それでも僕は、\n","即便如此我，\n"],["……それとも貴女を憎んだまま、[l]\n貴女のもとに居られるのかな。","……或者继续保持对你的恨意，[l]\n还能留在你身边吗。"],["彼女達の敵になってまで？","甚至不惜与她们为敌？"],["貴女が言ったように、\nこのまま僕がいなくなってしまえば楽なのかな。","就像你说过的，\n如果我就这样消失会不会更轻松。"],["僕がどうなろうと、\n","无论我变成怎样，\n"],["──ゴカイだ\n","──都是蜈蚣\n"],["誰も傷付くことはないんだろうし、\n","应该不会有人受伤吧，\n"],["──ゴカイだよ\n","──是蜈蚣啊\n"],["それならもう、\n","那样的话干脆，\n"],["──冷静に\n","──冷静地\n"],["かえりたい、かえりたい、かえりたい……","想回去想回去想回去……"],["──かんがえろ\n","──思考啊\n"],["そして、あなたが、いまはもう、ごめん、\n","然后，你现在已经，对不起，\n"],["──根源的なあやまりをしているみたいだから\n","──好像犯了根本性的错误\n"],["……。",""],["脳空転、\n","大脑空转，\n"],["というか、\n","或者说，\n"],["何度も同じ事を考えてるような気がする、\n","总觉得在反复思考同样的事，\n"],["思考がロックされてるのかスパイラルに陥ったのか、\n","不知是思考被锁定还是陷入了螺旋，\n"],["空腹時と寝起きは、ヒトと会話しないようにしよう、\n","空腹和刚睡醒时，尽量不要和人说话，\n"],["そう肝に銘じてるのに、\n","明明这么告诫过自己，\n"],["──いきろ\n","──活下去\n"],["やっぱりほら、\n","果然你看，\n"],["──いける\n","──能做到\n"],["なにがなにやら──\n","乱七八糟的──\n"],["「ああ、そうか……[l]\n空腹というか……腹……減ったなあ……」","「啊，对了……[l]\n说是空腹……肚子……好饿啊……」"],["空腹は覚えていたけれど、\n実際は此処に来てから何も食べてなかったんだ。","虽然记得空腹感，\n实际上来到这里后什么都没吃。"],["だからなのか、\n疲れて休みたいのに、\n眠気が来ない。[l]\n精神だけは尖って張り詰めて、\n思考ループに捉えられてるし、\n一種の興奮状態のようなざわざわしたこのかんじは、\n……だめだ。[l]\n実際今の今まで何を思考してたのかとか、\nそういったものまで乱暴にとっちらかって、\n","是因为这个吗，\n明明累得想休息，\n却毫无睡意。[l]\n只有精神尖锐地紧绷着，\n被思考循环困住，\n这种类似兴奋状态的躁动感，\n……不行了。[l]\n实际上直到刚才都在思考什么之类，\n连这些都被粗暴地搅乱，\n"],["脳空転と言うより思考暴走とでもいうべき状態で、\n","与其说是大脑空转不如说是思考暴走的状态，\n"],["感情自体が今もう、\n","现在连感情本身都，\n"],["「……と、にかく、」","「……总、总之，」"],["──何か食べるか。","──找点东西吃吧。"],["食べないと眠れない。","不吃东西就睡不着。"],["どんなに疲れてても、\nそれだけでは眠れない。[l]\n一晩寝ればいろいろなことをやり過ごせた僕でも、\nやっぱりお腹が空いてた時は寝られなかったものだ。","无论多累，\n光那样也睡不着。[l]\n就算是我这种睡一觉就能熬过各种事情的人，\n肚子饿的时候果然还是没法入睡。"],["時間を確かめようと、取り出した携帯電話、\n知らず知らず僕は、\n","为了确认时间掏出的手机，\n不知不觉间我，\n"],["アドレス帳を呼び出していた。","已经调出了通讯录。"],["あ……","啊……"],["い……","饭……"],["飯窪現実……","饭洼现实……"],["「母、さん……」","「妈、妈……」"],["選択して、\n","选中后，\n"],["「……うぅ、あ、あぁ……」","「……呜、啊、啊啊……」"],["絶望的な答えが返ってくるのが怖くて、\n","害怕听到绝望的回应，\n"],["どうしても発信ボタンを、押せない。","怎么也按不下通话键。"],["低血糖時だから、じゃないんだろう、\n動悸が、早鐘を打つような、\nどくどくと血流が頭の中を巡る、\nああからだが。","不是因为低血糖吧，\n心跳快得像打鼓，\n血液咕咚咕咚地在脑内循环，\n啊啊身体。"],["震え、\n","颤抖着，\n"],["──奮え\n","──颤栗\n"],["ゆらゆらと、\n","晃晃悠悠，\n"],["──フルエ\n","──FLUE\n"],["そして僕の眼から、\n","然后从我眼中，\n"],["──もう少しなんだよ\n","──还差一点啊\n"],["また溢れそうな、\n","又要溢出的，\n"],["──心配いらない\n","──不用担心\n"],["熱い、\n","炽热的，\n"],["──ワレは、","──吾乃，"],["「………はっ」","「………哈」"],["どれだけ忘我の状態だったのか、\n手の中の携帯電話が鳴っ、た。","不知失神了多久，\n手中的手机响、了。"],["「──タイミングよくイベント起きるか……[l]\nはは……………………[l]\n…………………………[l]\n………………………っ」","「──时机正好触发事件吗……[l]\n哈哈……………………[l]\n…………………………[l]\n………………………」"],["……もういい。","……够了。"],["──何かを忘れている\n","──忘记了什么\n"],["誰、だろう？","是谁，来着？"],["──何かを忘れて\n","──遗忘了什么\n"],["ああ、\n","啊啊，\n"],["──……ミ、…カミ？","──……MI、…KAMI？"],["狩屋……","狩屋……"],["──…ガミ？","──…GAMI？"],["そういえば、\n","说起来，\n"],["──もう少しで、何かを忘れ……","──再这样下去，就要忘记什么……"],["手が震えたので、","因为手在发抖，"],["その所為でボタンを二度押しなぞして通話切断しないようにと、","为了避免误触挂断键，"],["冷静なのかどうなのか微妙な思考を走らせながら、","带着不知算不算冷静的微妙思绪，"],["僕は慎重に電話に、[l]出た。","我小心翼翼地接起[l]电话。"]],"context":[["SC_M_055.ks/index/1/text"],["SC_M_055.ks/index/4/text"],["SC_M_055.ks/index/6/text"],["SC_M_055.ks/index/9/text"],["SC_M_055.ks/index/11/text"],["SC_M_055.ks/index/14/text"],["SC_M_055.ks/index/17/text"],["SC_M_055.ks/index/19/text"],["SC_M_055.ks/index/22/text"],["SC_M_055.ks/index/25/text"],["SC_M_055.ks/index/27/text"],["SC_M_055.ks/index/29/text"],["SC_M_055.ks/index/31/text"],["SC_M_055.ks/index/33/text"],["SC_M_055.ks/index/35/text"],["SC_M_055.ks/index/37/text","SC_M_055.ks/index/39/text"],["SC_M_055.ks/index/41/text"],["SC_M_055.ks/index/43/text"],["SC_M_055.ks/index/45/text"],["SC_M_055.ks/index/48/text"],["SC_M_055.ks/index/50/text"],["SC_M_055.ks/index/53/text"],["SC_M_055.ks/index/55/text"],["SC_M_055.ks/index/57/text"],["SC_M_055.ks/index/60/text"],["SC_M_055.ks/index/63/text"],["SC_M_055.ks/index/65/text"],["SC_M_055.ks/index/67/text"],["SC_M_055.ks/index/70/text"],["SC_M_055.ks/index/73/text"],["SC_M_055.ks/index/75/text"],["SC_M_055.ks/index/77/text"],["SC_M_055.ks/index/80/text","SC_M_055.ks/index/119/text"],["SC_M_055.ks/index/83/text"],["SC_M_055.ks/index/86/text"],["SC_M_055.ks/index/89/text"],["SC_M_055.ks/index/91/text"],["SC_M_055.ks/index/93/text"],["SC_M_055.ks/index/95/text"],["SC_M_055.ks/index/98/text"],["SC_M_055.ks/index/100/text"],["SC_M_055.ks/index/103/text"],["SC_M_055.ks/index/105/text"],["SC_M_055.ks/index/108/text"],["SC_M_055.ks/index/111/text"],["SC_M_055.ks/index/114/text"],["SC_M_055.ks/index/116/text"],["SC_M_055.ks/index/122/text"],["SC_M_055.ks/index/125/text"],["SC_M_055.ks/index/127/text"],["SC_M_055.ks/index/130/text"],["SC_M_055.ks/index/133/text"],["SC_M_055.ks/index/136/text"],["SC_M_055.ks/index/139/text","SC_M_055.ks/index/461/text"],["SC_M_055.ks/index/141/text"],["SC_M_055.ks/index/143/text"],["SC_M_055.ks/index/145/text"],["SC_M_055.ks/index/148/text"],["SC_M_055.ks/index/151/text"],["SC_M_055.ks/index/154/text"],["SC_M_055.ks/index/157/text"],["SC_M_055.ks/index/159/text"],["SC_M_055.ks/index/162/text"],["SC_M_055.ks/index/165/text"],["SC_M_055.ks/index/167/text"],["SC_M_055.ks/index/170/text"],["SC_M_055.ks/index/173/text"],["SC_M_055.ks/index/176/text"],["SC_M_055.ks/index/179/text"],["SC_M_055.ks/index/182/text"],["SC_M_055.ks/index/184/text"],["SC_M_055.ks/index/187/text"],["SC_M_055.ks/index/189/text"],["SC_M_055.ks/index/192/text"],["SC_M_055.ks/index/195/text"],["SC_M_055.ks/index/198/text"],["SC_M_055.ks/index/200/text"],["SC_M_055.ks/index/202/text"],["SC_M_055.ks/index/204/text"],["SC_M_055.ks/index/206/text"],["SC_M_055.ks/index/209/text"],["SC_M_055.ks/index/212/text"],["SC_M_055.ks/index/214/text"],["SC_M_055.ks/index/216/text"],["SC_M_055.ks/index/218/text"],["SC_M_055.ks/index/221/text"],["SC_M_055.ks/index/223/text"],["SC_M_055.ks/index/225/text","SC_M_055.ks/index/227/text","SC_M_055.ks/index/229/text","SC_M_055.ks/index/262/text","SC_M_055.ks/index/264/text","SC_M_055.ks/index/266/text","SC_M_055.ks/index/399/text","SC_M_055.ks/index/415/text"],["SC_M_055.ks/index/231/text"],["SC_M_055.ks/index/234/text"],["SC_M_055.ks/index/237/text"],["SC_M_055.ks/index/239/text"],["SC_M_055.ks/index/241/text"],["SC_M_055.ks/index/243/text"],["SC_M_055.ks/index/245/text"],["SC_M_055.ks/index/248/text"],["SC_M_055.ks/index/251/text"],["SC_M_055.ks/index/254/text"],["SC_M_055.ks/index/256/text"],["SC_M_055.ks/index/258/text"],["SC_M_055.ks/index/260/text"],["SC_M_055.ks/index/268/text"],["SC_M_055.ks/index/271/text"],["SC_M_055.ks/index/274/text"],["SC_M_055.ks/index/276/text"],["SC_M_055.ks/index/279/text"],["SC_M_055.ks/index/282/text"],["SC_M_055.ks/index/284/text"],["SC_M_055.ks/index/286/text"],["SC_M_055.ks/index/288/text"],["SC_M_055.ks/index/290/text"],["SC_M_055.ks/index/292/text"],["SC_M_055.ks/index/294/text"],["SC_M_055.ks/index/297/text"],["SC_M_055.ks/index/299/text"],["SC_M_055.ks/index/302/text"],["SC_M_055.ks/index/305/text"],["SC_M_055.ks/index/308/text"],["SC_M_055.ks/index/311/text"],["SC_M_055.ks/index/313/text"],["SC_M_055.ks/index/316/text"],["SC_M_055.ks/index/318/text"],["SC_M_055.ks/index/320/text"],["SC_M_055.ks/index/322/text"],["SC_M_055.ks/index/324/text"],["SC_M_055.ks/index/326/text"],["SC_M_055.ks/i