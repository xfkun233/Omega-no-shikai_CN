8}],[{"start":10653,"end":10707}],[{"start":10738,"end":10758}],[{"start":10793,"end":10799}],[{"start":10834,"end":10864}],[{"start":10876,"end":10953}],[{"start":10965,"end":10990}],[{"start":11025,"end":11046}],[{"start":11081,"end":11132}],[{"start":11144,"end":11178}],[{"start":11190,"end":11233}],[{"start":11294,"end":11300}],[{"start":11357,"end":11370}],[{"start":11405,"end":11446}],[{"start":11477,"end":11484}],[{"start":11520,"end":11537}],[{"start":11740,"end":11780}],[{"start":11842,"end":11849}],[{"start":11864,"end":11867}],[{"start":11878,"end":11893}],[{"start":11952,"end":11991}],[{"start":12029,"end":12092}],[{"start":12127,"end":12176}],[{"start":12231,"end":12248}],[{"start":12284,"end":12339}],[{"start":12347,"end":12393}],[{"start":12424,"end":12442}],[{"start":12454,"end":12468}],[{"start":12481,"end":12483},{"start":12564,"end":12566},{"start":12654,"end":12656}],[{"start":12496,"end":12499},{"start":12579,"end":12582},{"start":12669,"end":12672}],[{"start":12511,"end":12512}],[{"start":12523,"end":12551}],[{"start":12593,"end":12594}],[{"start":12605,"end":12606}],[{"start":12617,"end":12641}],[{"start":12683,"end":12684}],[{"start":12695,"end":12696}],[{"start":12708,"end":12713}],[{"start":12725,"end":12814}],[{"start":12850,"end":12875}],[{"start":12887,"end":12939}],[{"start":12998,"end":13045}],[{"start":13100,"end":13165}],[{"start":13200,"end":13205}],[{"start":13236,"end":13243}],[{"start":13255,"end":13339}],[{"start":13375,"end":13473}],[{"start":13485,"end":13546}],[{"start":13558,"end":13613}],[{"start":13672,"end":13762}],[{"start":13793,"end":13843}],[{"start":13906,"end":13950}],[{"start":13981,"end":14021}],[{"start":14033,"end":14107}],[{"start":14143,"end":14213}],[{"start":14248,"end":14275}],[{"start":14479,"end":14486}],[{"start":14550,"end":14587}],[{"start":14647,"end":14676}],[{"start":14688,"end":14738}],[{"start":14897,"end":14937}],[{"start":15000,"end":15037}],[{"start":15049,"end":15087}],[{"start":15122,"end":15149}],[{"start":15161,"end":15196}],[{"start":15207,"end":15209}],[{"start":15222,"end":15224}],[{"start":15235,"end":15236}],[{"start":15247,"end":15262}],[{"start":15274,"end":15308}],[{"start":15361,"end":15369}],[{"start":15383,"end":15385}],[{"start":15397,"end":15405}],[{"start":15462,"end":15484}],[{"start":15520,"end":15570}],[{"start":15582,"end":15643}],[{"start":15705,"end":15732}],[{"start":15791,"end":15828}],[{"start":15839,"end":15840}],[{"start":15851,"end":15893}],[{"start":15905,"end":15947}],[{"start":15982,"end":16053}],[{"start":16089,"end":16158}],[{"start":16193,"end":16224}],[{"start":16235,"end":16239}],[{"start":16250,"end":16251},{"start":16779,"end":16780}],[{"start":16263,"end":16265},{"start":16792,"end":16794}],[{"start":16278,"end":16287}],[{"start":16346,"end":16351}],[{"start":16387,"end":16392}],[{"start":16447,"end":16463}],[{"start":16498,"end":16559}],[{"start":16590,"end":16591}],[{"start":16602,"end":16627}],[{"start":16639,"end":16648}],[{"start":16659,"end":16665}],[{"start":16676,"end":16717}],[{"start":16729,"end":16735}],[{"start":16748,"end":16768}],[{"start":16807,"end":16811}],[{"start":16823,"end":16861}],[{"start":16920,"end":16939}],[{"start":16998,"end":17066}],[{"start":17078,"end":17085}],[{"start":17120,"end":17217}],[{"start":17280,"end":17366}],[{"start":17401,"end":17499}],[{"start":17511,"end":17560}],[{"start":17572,"end":17621}],[{"start":17657,"end":17663}],[{"start":17675,"end":17676}],[{"start":17687,"end":17698}],[{"start":17710,"end":17758}],[{"start":17793,"end":17818}],[{"start":17829,"end":17867}],[{"start":17902,"end":17952}],[{"start":17964,"end":18013}],[{"start":18098,"end":18141}],[{"start":18196,"end":18220}],[{"start":18279,"end":18303}],[{"start":18366,"end":18389}],[{"start":18400,"end":18446}],[{"start":18458,"end":18524}],[{"start":18555,"end":18584}],[{"start":18643,"end":18661}],[{"start":18720,"end":18742}],[{"start":18777,"end":18836}],[{"start":19013,"end":19064}],[{"start":19096,"end":19173}],[{"start":19185,"end":19193}],[{"start":19205,"end":19220}],[{"start":19232,"end":19290}],[{"start":19302,"end":19326}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_005.ks","basename":"SC_S_005.ks","indexIds":{"さて、\nいーくんが大学を辞して、\n北の地に出向いてから何日たったろう。":0,"まあ曜日だの何だの、\n時間感覚なんかとうの昔に無くした俺だから、\n大して意味は無いんだが。":1,"とは言えこの場合、\nイコール俺と彼女、かれおんとの出会いからの期間と\n重なるので、多少は思い入れあるかな。":2,"……そうか、思ったよりは経ってないんだな。[l]\n結構いったような気がしてたが、\nひと月経ってもいなかったか。[l]\n俺とかれおんの日々は濃密だけどな。":3,"今日は取り敢えず、新学期早々休講がわんさと発生したので、\n大変に困った。[l]\nＧＷもまだ先だっていうのに、\n教授ら何してるんだかな。":4,"専攻はともかく、偶然だろうがよりによって、\n俺の他学の選択授業が集中してそんなだって何でだ。[l]\nいじめじゃないかと思ったな。":5,"俺、在学中にしていーくんが自主退学したこの大学は、\n馬鹿みたいに敷地が広い為に、\n学棟間の移動をみんな自転車で行うのが常だ。":6,"一限目始まる前なんかはなかなか壮観なシーンを拝めるのだが、\nつまりは移動がすげえ面倒くさいという事だ。":7,"休講が教室やら実験室前まで行ってから判明しても大変に\nげんなりするだけで、\n非常に悲しい。":8,"同期生から情報もなかったし、\nまァそんな日もあらァな。[l]\n出席心配するのはもっと後なってからだろうし、\nいーくんの事を思えば多少の事は甘んじられるね。":9,"「とは言え、だ……[l]\nこれは面倒くさいスなあ……」":10,"二期以降に楽しようと一期目に結構単位とれるように\n組んだから６限までみっちりあるはずが、\n午前は３限、午後は６限のみという非常に半端な状況にある。":11,"「しょうがねえ、\nいつものとこか……[l]\nこんな時間からじゃ誰もいねえだろうけど」":12,"俺はアパートから一番遠い専攻の学棟群、その中のとある一棟から出て、山程駐輪してある自転車から己の愛車を選び出し、ある場所へと漕ぎ出した。":13,"俺といーくんが出会ったサークルのブースがある、\n文化系サークル棟だ。":14,"部室ってか、仕切のないワンフロアを、\n各サークルがロッカーやなんらで区分けしてるだけなので、\nそう呼ぶ方がしっくりくる。":15,"まあ文化系サークルとは言っても、\nどこの大学にもある漫研みたいなもんで、\n創作だけでなく研究と言う名の鑑賞も活動内容に入る。":16,"いーくんはサークルに在籍はしてたが、\n俺等の属するそっち系の人間だった訳でなく、":17,"ラノベだのでもない、新書だのハードカバーだの、\n文庫小説は海外翻訳モノだの、あとは●●事典といった資料系、\nそれもアングラネタ系から物理生物人文言語に至るまで、\n俺等受けするような表紙とは全く別次元の本を好んで読んでいた。":18,"そんないーくんが何でうちらのサークル来たのかは\nよくわからんが、":19,"何か入学後の勧誘時期に、ブースから流れてた歌（アニソン）が\n聞いたことがあるやつだったとかなんとか、\nなかなか珍しい理由だった気がする。":20,"結局一年で退学したが、\n俺以外とは馬も合って無かったようだから\n逆に良かったんじゃないか。[l]\n俺との出会いだけがフラグイベントだと思ってくれ。[l]\n俺にしたって、かれおんと出会ったのはいーくん経由だしな。":21,"と、まあ俺の周辺事情をあんまり掘り下げたところで\n無聊の慰めにはならないな。":22,"結局ブースのスケブに色々落書きしてるうちに、\n時間が来て行ったり来たり、":23,"大体今日はミーティングの日だから、\n６限終わってからまた此処なんだ。[l]\n日がな一日たむろってんな俺。":24,"という今日、\n諸々偶然の重なった大学での一日の締めくくり間際、":25,"サークルのミーティングが終わって棟を出ると、\n入り口にかれおんが立っていたのだった。":26,"みんなと適当に飯を喰った後誰かのアパート行って、\n春のイベント合わせの本の打ち合わせだのやりつつ、":27,"ゲームだの、先輩の持ってきたよく分からないマイナーな、\nかつしっかり新作のOVAだのを観せられたり……":28,"のはずだったんだが。[l]\n今日彼女と逢う約束は特に無い。":29,"「あ、雪鳴さん、[l]\n急な話なんですが。":30,"ちょっと知り合い……というか、[l]\n同僚……あいえ、同業者を紹介しても？」":31,"「おー。[l]\nいいすよ。[l]\nほんと急だけど。":32,"脈絡なしっすけど。[l]\nかれおんはそういう面白い女子だから\nノープロ。":33,"おｋ。[l]\nお気になさらず」":34,"今日は眼鏡じゃなくてコンタクトの日か、勿体ないのう。[l]\n……そもそも彼女は出会ったときから、\n携帯電話持ってなかった訳だが、未だ導入して頂けていない。":35,"基本的には、例のいーくんのバイト先の本屋の固定電話を\n借用しているらしい。":36,"故にこういった急用の場合、\n彼女が在宅中に思いついたのでは無い限り、\n公衆電話使うかこうしてアポ無しで直に来るしかない。":37,"最近はめっきり電話ボックス減ったし、\n俺がこの時間此処にいることは分かってるし、\nだから別にいい。":38,"「あうあ、怒ってますかっ。[l]\nそ、そのうちお詫びの埋め合わせを…」":39,"いや、怒ってるとしても、\n埋め合わせとかで詫びじゃなくて、\n単に携帯電話を導入さえしてくれれば早いんだが。":40,"「あーそう、[l]\nまあ、じゃあ後ろのお知り合いの方々には\n聞かせられないような事で是非。":41,"いや嘘だけどね。[l]\n別になんともおもってないす」":42,"携帯電話のない時代というのも間違いなく存在していた訳だから、\n当時を思えば生死に関わる問題という訳でもないが、\n……まあ、":43,"彼女に関しては格別『主義』があっての事じゃないようだし、\nリスクとリターンのバランスでみたとて、\nそんなに渋る理由も無いと思うんだが、\n単に面倒なのか、そっち系アレルギーなのか――":44,"近くにデジタル馬鹿でも居るのかね。[l]\n俺の所為じゃないのは確かだし、\n寧ろ俺の属するこっち側の人間としての素質は、全然有望なんだが。":45,"「はうっ、[l]\nそう言ってても絶対おかずが一品減ったり\nデザートの質が下がったりするですよ！？[l]\nかれお的にそれは厳しっ」":46,"「んな事ないっすよ被害妄想だって。[l]\nほれ、後ろの方々置いてけ堀にしてどうすんの。":47,"折角俺が諸事情を察して、色々突っ込まずに話を進めようと\nしてんのに」":48,"電気街裏通りとかの中古屋とかで、\nレアかつ格安なお宝見つけるのも得意だし、\nそういう":49,"才":50,"能持ちなのは確かだ。":51,"鼻が利く、という能力はあらゆる局面において、\n非常に有用なスキルであることは言うまでもない。":52,"結局、彼女はキャパシティ内での能力ポイント割り振りが、\nやや偏ってるんだろう。":53,"しかし、\n平均的に割り振った使えない汎用ユニットよりは、\n何かに特化した方が使い物になる、事が多い。[l]\n無論システム的にパーティープレイ前提の環境下においては、だが。":54,"そんで、他のスキル担当が後ろの方々、という事かな、\nこれは。":55,"「……何か引っかかりますけど[l]\n":56,"概 ねサンクスですっ。[l]\nみんな、こっちにかまーん」":57,"「都合の好い男とお呼びあれ、てスルーすか。[l]\nおあ」":58,"相変わらず思考と喋りの機構をリンクさせないでいるのは、\n当人には分かんないとはいえ良心が咎めるねー。":59,"気持ちが入ってないという事は断じてないが、\n一つの事に全注力してないのは確かだからな。[l]\nま、それはそれ。":60,"相手の事情を察する事が出来るのは、ヒトの徳というものだ。[l]\n察した上でそっとしとくか敢えて突っ込むかはまた別の問題、\n人品骨柄経験値がものをいう。":61,"ん。[l]\n使い方間違ってるか？[l]\nまあ、そんなことはどうでもいい。[l]\n取り敢えず現実に眼を向けますと、":62,"「（この國の人間じゃないな――）」":63,"「あー、\nまあ驚かれるのも無理はなっしんぐでして、\nそのですね」":64,"「いや、キャンパス内では割と見かけるから\n驚いてる訳じゃ……いや、":65,"やっぱ驚いたわ。[l]\nどうもどうも。[l]\nぐだふたぬーん」":66,"インターネットが無かった時代、\nＰＣがフロッピーでなんとかなってた時代、\nＤＶＤでなくＶＴだった時代、":67,"ＣＧは少ない色数でドット打ちしていた時代、\nＣＤでなくレコードだった時代、\nテレビがモノクロだった時代、":68,"その過渡期を見届けている者としては、\n感慨に耽って昔は良かった今は駄目だ、\nと思うこともないではない。":69,"いーくんと話した時は、\n昔と今、という括りでのカテゴライズ自体が認識として不具合が\nあるという方向になったか。":70,"確かに昔だろうと今だろうと、\n良いものは良いし駄目なモンは駄目だ。":71,"「ばんわーっ」":72,"「初めまして」":73,"「ども」":74,"「………（会釈）」":75,"ツールが":76,"端から用意されている世代は個人的に趣味が合わないから、積極的にかかずらりたいとは思わないが、":77,"年寄りが若造と折り合いが合わないのは\nいつの時代にもある不毛な価値観の相違ではある。[l]\n主観がどの世代に属するかだ。":78,"「あれ、\n喋りも堪能ですね。":79,"ども、\nこっちの彼氏してます、\n大神雪鳴です。":80,"ゆっきーとお呼び下さい。[l]\nや、もうどうとでもお好きなように」":81,"まあ、過渡期を戦った人等は、そのしんどさを解消すべく尽力して、結果、後代の奴等がそういう苦労を知らずに育つという、":82,"先代の思惑通りにはなったのではあるのだけれど、\nいわば、":83,"御":84,"緩環境育ちが出来上がる訳で、":85,"そんな本末転倒みたいな事は世界あらゆる局面で起きるのだから、\nどの世代であれ、先代からの受け継ぎを利用してる事には変わりなく、":86,"でないといちいちリセットされゼロからの出発になるから\n当たり前なんだが、":87,"先輩にやられたしごきが嫌だったからって、\n後輩を野放しにしといた所で何もならない。":88,"単なる甘やかしになってぐだぐだになるだけだった。[l]\nという場面も高校くらいの年頃には何度か視てきた。":89,"先代の知識や技術を使役するのは悪いことではないだろうが、\n改良にせよ何にせよ停滞ではない事が必須なのだから\n結局の所、":90,"先人達の遺物なり智慧を、\n上っ面だけを単に享受するだけの消費者となるか、\n改変改良を尊び新たに次世代への遺物の作り手となるかが、\n俺が興味を持てる存在かどうかという点だな。":91,"個人的な趣味で言えば\n『若いときの苦労は買ってでもしろ』\nというのは全く以て至言であり、":92,"若くして頭角を現すという存在は基本的には\n興味を持てない。":93,"ポテンシャルよりも、\n実地的に実時間を伴って蓄積された経験値の方が俺的には\nモノに価値を見出す基準に於ける優先事項だからで、\n世間や方面によっては勿論そうでない事もある。":94,"「あれこちら随分お若いお嬢さんじゃないすか。[l]\nかれおんと同僚って、ああ、どなたかの妹さん？」":95,"「あいえ、\nえん……のある":96,"娘でして！[l]\nナカマ、ふぇろう、ふれんど！」":97,"「あによもう、\nカレったらノリがへん！[l]\nボクらＷＣぃのなか」":98,"「御嬢、殿方の前ですよ」":99,"「彼？[l]\nえ、俺の事？」":100,"「あいえあ、わ、ワタシのことですっ。[l]\n仲間内ではカレと呼ばれていまスのよっ。[l]\nお、お手洗いも一緒に行く仲で」":101,"「ややこしくてゴメンナサイ」":102,"「むぅ」":103,"「いえいえお気になさらず。[l]\nカレ、カレね。カレカレ」":104,"満足というものをしてしまっては、\n生物は停滞し最悪滅することもあるという皮肉な世界さな。":105,"刺激刺激、闘い相争う事で存在は成長するという、\n良く言えば自由競争、切磋琢磨、\nだが、それを大っぴらに許容してしまっても成り立たない\nヒトの社会というものがある。":106,"本音と建て前は大事だ。":107,"いーくんから借りたＳＦ物にはよく、\n完全管理されたが故に平和だが予定調和で閉塞停滞した世界から、\n危険と争いがあるが未確定で活性化した世界への復活回帰をテーマにしたものが結構あったが、":108,"それを可なりとするのは問題だろうし、\n本音と建て前は大事だし、\n放っておいてもこの世はとかく生き難いのだ。":109,"敢えてしんどい方向に認識しなくても十分にしんどい。[l]\nだから、積極的な愉悦はなくとも、\nせめてストレスのない生き方が出来るように尽力するのが、\n俺の遣り方。":110,"その為には障害を時には腕力を以て排除するという\n物理的衝突が起こり得るという矛盾も、\nまあ勧善懲悪話並には発生する訳で、\nそれを極力一次的接触無しで行うべく仕込まれた――":111,"さて、彼女さんにもお友達にも悪いから、\nそろそろ思考と行動をリンクさせるか。":112,"人間は言ってる事とやってる事は違うらしいが、\n俺のこれは更にずれてるようだし。":113,"まー色々と入り組んだバックボーンがあるというか、\n特殊な身の上なんだよね俺は。":114,"「雪鳴さん？[l]\nどしました？」":115,"「あ、ごめ。[l]\nなんでも。[l]\n引き続き詳しく紹介よろ」":116,"「……なんか今日冷たくないですか？[l]\nご、ごほん、えーと、\nこちらから、":117,"みみみちゃん、\nアイさん、\nアルコさん、\nサクラさん、":118,"と、お呼び下さい。[l]\n仕事でこっちに来られまして、\nちょっとしばらく一緒にいることに\nなりましたのですよっ。":119,"真言さんのあの――バイト先の本屋、\n御存知でしたよね？":120,"滞在中はあそこにみんなで厄介になるのです。[l]\nで、ワタシもこの度色々とつるむ用事もありまして」":121,"「成る程ね。[l]\n諒解」":122,"「あ、\n勿論愛称ですヨ？[l]\n本名はその、視たとおり外語圏なのでですね、\n色々とその」":123,"「らじゃらじゃ、\nさっきから言ってっけど、\n俺ってば察し良いのがウリですから。":124,"みみみちゃん、アイさん、アルコさん、サクラさん、\nんで、かれおんがカレね」":125,"「ゆ、雪鳴さんが呼ぶときは\nかれおんでいいんですっ」":126,"みみみ＝元気ロリ娘。[l]\nアイ＝ツン眼鏡。[l]\nアルコ＝おっとり不思議ちゃん。[l]\nサクラ＝暴力女。":127,"ざっくりカテゴライズするとそんなとこか。[l]\nちなみにかれおんは……[l]\nいや、いいかそんな戯れは。":128,"カテゴリ設定自体も、同じこっち側の世界ですら世代で全く違うからなー。":129,"にしても彼女達――\nふーん。[l]\nこれは、\nＰＴ（パーティー）だったら担当はそれぞれ、":130,"切り札、援護支援、間接後衛、近接前衛……[l]\n違う、もっと入り組んでんな。[l]\n討伐よりか捕獲重視の――\nってそれはもういい。":131,"「えーとですネ、\n真言さんから聞いてるかもですが、":132,"ワタシはよく":133,"外つ":134,"國にですネ、\nええ――と、出張とか、主に書籍探しですけど、が多いので、\n自然とそういう人脈が出来ましてっっ。":135,"で、\n今回はみんなこうして一同に会する機会がありまして、\nえとその、":136,"ダイジョブです、この國の言葉はこの通り、\n慣用表現から現代若者言葉まで、\n超流暢ですからっ。":137,"――え、えと、それで、しばらくはご一緒出来る時間がその……」":138,"「さっきも聞いたよかれおん。[l]\nしどろもどろになりなさんな。[l]\nこの雪鳴さんを信じなさい。":139,"俺はまだボンクラ学生だけど、\nかれおんは社会人ですからね。":140,"限られたコミュの中だけじゃなく、\n色んな付き合いは大事にしないとね。[l]\n承知してます」":141,"「は、ハイ？」":142,"というかれおんの反応を優しく微笑み受け流して、\n俺は彼女等に改めて挨拶した。":143,"「ま、俺よりも付き合い長そうですし、\nこんな様はもう重々承知の上でしょうが、":144,"不肖ゆっきーの、更に":145,"不":146,"束":147,"者の彼女ですけど、どうか面倒みてやってください」":148,"「にぁはははは！[l]\nゆっきーおもしろいな！[l]\nさすがカレの彼だぉ！！」":149,"「え、おもしろいか？」":150,"「お前も御嬢のいうこといちいち気にするなよ」":151,"「お二人とも、\n失礼ですよ」":152,"「或る意味御嬢が一番……」":153,"「み、みんなが失礼ですっ！」":154,"「はははははは、\nおーけーおーけー、\nで、皆さんはこれから？[l]\nすぐお戻りに？」":155,"「そうです……ね？[l]\nカレ」":156,"「で、です」":157,"「ま、じゃ俺も用事あるし、\nあとは皆さんごゆるりと。":158,"かれおんは携帯電話持ってないから、\nこっちから連絡出来ない事には変わりないからなぁ。[l]\nま、そんなわけで常に受け身で慣れっこっスから。":159,"何かあったら連絡よろ。[l]\nいってら～」":160,"「ちょちょちょっとあっさりしすぎな気がっ」":161,"「おかずの心配も俺の愛も心配しなくていいから。[l]\nフレとかツレとかってのはそういうもんだ。":162,"常に眼に視える行動態度で顕されるとは限らんのよ、\nかれおん。":163,"ま、気にしない気にしない。[l]\n俺がかれおん愛してることには微塵も嘘はない」":164,"「へぇ……」":165,"「じゃあまた、機会あれば」":166,"「グッバイれでぃーす。[l]\nらう゛ゅーかれおん。[l]\nじゃね」":167,"「さようなら」":168,"「ゆっきーおつぅ！！またよろ！！」":169,"「てかさあんた、何であんな片言で喋ってんの？[l]\nそういうキャラ設定？":170,"「いえその、\n":171,"已むに":172,"已まれぬ事情がありまして……」":173,"「ああ……なんかチノだか店長だかが愉快な事件がどうとか\n言ってた奴か」":174,"「でなにあんた、\nご飯カレシに作って貰ってるんだ？[l]\n相変わらず本業以外のスキルは磨かないにも程があんな」":175,"「ああああれは、外食したときの話ですっ。[l]\n奢りですが上限額は雪鳴さん次第で毎回……」":176,"「宮殿と一緒の時と変わりないですね":177,"「ThousandBrainsは向こう付きね……[l]\n浮いてなきゃいいけど。遅いか。浮いてるな絶対。":178,"で、\nZenonは店で留守番しつつ待機で、\n対受動事象下の待機組はあとは、」":179,"「下賜されましたリストによりますと、":180,"WC_NK:AntLion、":181,"和　":182,"音 は":183,"白":184,"雨カゲロウ。[l]\nWC_NK:Beehive、":185,"八":186,"重":187,"洲うら。[l]\nWC_NK:-cide、":188,"水":189,"小":190,"月シカネ。":191,"対受動事象下、つまり後の始末は彼等の担当ですね。[l]\nThousandBrainsが向こう付きになったのは、\n人種的にはこの國に紛れても違和感が無いからですが」":192,"「キャラが濃すぎるだろ、\nそれ以前にさあ。":193,"中央のなんつたっけあの、\n若モンの街並みに混じるならともかくよ、\n玄ノ森っていやぁその」":194,"「それよりもなんで和名なんか考えてあるの。[l]\nどうみてもうちら邦人じゃないでしょ」":195,"「さっきの誰かみたいに愉快な言い訳でもするつもりだったんじゃないですか。[l]\n和名自体は単に面白がって作ったそうですが」":196,"「誰が？」":197,"「勿論店長が。":198,"今回のCovenに関しては、\n実際、使う機会もないと思ったんでしょう。[l]\nThousandBrainsといつもしてらっしゃる思考遊戯の範疇でしょう」":199,"「多少は店長だのKaleidoだのはそーする意味があるし、\n外見上違和感ねーから良いけどよ、\nThousandもまーいいや、\nあたしらまで結局使う羽目になったじゃねーかよ。":200,"セカンドネームまで和名つくってあって絶句したわ。[l]\nそこまでは使わずに済んだけど、\nヒヤヒヤだったろ。":201,"カレの彼がああいう……人間で良かったわ。[l]\nいい加減、面白いかどうかだけで物事決めるのはどうかと」":202,"「っあーあぁ、\n狩りたいなぁ……[l]\n狩りたいなぁ、狩りたいなぁ狩りたいなぁ狩りたいなぁっ！[l]\nあいつが失敗したときだけってそんなのつまんないぉ！！」":203,"「御嬢、\nどうか自重なさって下さい。[l]\n今回は我々はあくまでバックアップとして」":204,"「……御嬢は今日も今日とて、[l]\n相変わらずだねえ（あんたが甘やかすから！）」":205,"「店長も、この世はゲェム、愉快さだけが至上だと\n仰って居られたでしょう。":206,"獲物の中にもどうやらそういう主義のが\n居るようですし、どうもこの世界は好き嫌いが判断の基準と\nしてスタンダードなのかもしれませ――」":207,"「Ironあんた、Thousandに似てきたな……[l]\nそんな人間ばっかだとあたしみたいな真面目っ娘が\n浮いちゃうじゃん」":208,"「（Ironは元E.Sで改宗させたのは彼女だからね）」":209,"「くすんっ！」":210,"「ん？[l]\nどうした？[l]\nそのクシャミはどっちだ？」":211,"「いえ、んっんーっ。[l]\nああ今の、リアルだよ。":212,"たぶん、\n……向こうの連中がしてるかなワタシの噂でも。[l]\nどっちでもいいけどね」":213,"「そう言えば、\n黒の断片はともかく、\n赤の女王、今回狩れるかな」":214,"「あ？[l]\n姉妹の残りとツェロルが居る限り、\n来るだろ。":215,"雫が咬んでてそのイベントフラグだけ立たないってことぁ\nないだろーよ」":216,"「もう雫は確定なんだ？[l]\nツェロルの話も？":217,"ま、いいや。[l]\nWC_001:GM、このリスト上の和名だと":218,"真 ":219,"然 ":220,"名":221,"無が\n全て掌握済か……":222,"固有真名を持つ数少ない同胞にして\n司書長のお気に入りの女子」":223,"「長の愛でるは『":224,"妹 ":225,"君』だけですよ」":226,"「っえーー\nミートゥーだってばぁ！」":227,"「で？[l]\nKaleidoがわざわざ、\nあたしらをカレシに引き合わせたのは何でよ？":228,"命令あるまでの暇潰しって事はないだろ。[l]\nまさかとぁ思うけど、\n――只の自慢だったらぶっ飛ばすかんな」":229,"「え、ええと、\nやっぱりわかんなかったですか」":230,"「まあ、そう言うことを為せ得る存在が、\nもし意図的に隠蔽してきたら":231,"如":232,"何に魔眼といえど、\n余程PHASE:2強化をした猫の手助け無しにはなかなか。":233,"え、そういう存在の話なのか？[l]\nキミのフェンリロスが何か嗅ぎ付けたの？」":234,"「ワタシも彼の前でみせたことはないですし、\n自覚があるかどうかは分からないデスが……[l]\n彼、というか彼の……は恐らく――」":235,"「あれ、黒の９は持ってるだけなのか。[l]\nまー再統合するならそうだわな。[l]\nで、なんだっての。勿体つけなくていーよ」":236,"「ええと、ＷＣＬ収蔵のデータと照合しましても、どうやら、あの、":237,"Ｄの、『":238,"茶":239,"黒の":240,"首 』のようです」":241,"「なに？」":242,"「マジか」":243,"「黒の１０と同様の存在として？」":244,"「ですね。[l]\nヒトの肉を器に、まあ強制分割された訳ではないので、\n黒の１０と全く同様という事では――」":245,"「":246,"Ｄなんて……永久欠番、所在不明だったはずでしょう。":247,"ミアキスの、私達の":248,"Ｃじゃない、":249,"Ｄの顕現体、\nナナムシルorgの最初の出芽双体、ナナムシルaltの片割れ、":250,"つまり『黒の":251,"偽 』の兄弟とでも言うべき、\n『":252,"首 』。":253,"安定せず消失したとばかり――\nまさか黒の１０と共に此処に居たなんて」":254,"「アイはむずかしいことしってんねー！」":255,"「雫か。[l]\nこうなるとほぼ確定せざるを得ないな。[l]\n後世に於いて語られるまでは便宜上とするのが本来だが、雫の波紋":256,"畏るべしだな」":257,"「あのいえ、うーん……[l]\n一応ちらっとチノの方には匂わせた報告してあるんですが、\n向こうから呼び戻す訳にもいかなくてですね、\nそれでちょっと、みなにお目通しをと……」":258,"「１０も今は自覚無しなんだし、否、１０の肉の方だけかそれは。[l]\nオウトとやらもそうなんじゃねーのか？[l]\nカレはそもそも、それでカレに近づいたのか？」":259,"「いえ、まったくの偶然ですっ。[l]\n判ってたらチノにもまず確認させてマスよ！[l]\nほ、ほんとに打算じゃなくて、純粋に惹かれ合い？愛？[l]\nいえその、それは置いといテ！":260,"黒の９を検索した時にも……[l]\nあ、同じ土地でしたし、両者が近すぎたのかもっ……うーん。":261,"自覚に関してはワタシも何とも、\nただ一緒にいてそういう気配は、彼はおくびにも出さないデス」":262,"「あんたのお":263,"惚":264,"気はどーでもいいんだ。":265,"いずれにしろ、\nあたしらじゃわかんなかったわけだから、\nお目通しも無駄だったな」":266,"「Kaleidoのフェンリロスは理論上の存在だった":267,"Ｄ寄りにチューンされた特殊な……だからね。[l]\n相当『鼻が利く』」":268,"「い、いえそんな大層なものでは……[l]\nと、取り敢えず最終的な確認をしたかったのですが……":269,"仕方ないですね。[l]\n極めて曖昧な根拠ですが、\nこのまま宮店長に報告します……」":270,"「めんどうなことはわかんないぉ！[l]\nカレがそう思ったんならそうなんだぉ！」":271,"「御嬢は大変にsensibleであらせられます」":272,"「あんたの甘やかし、たまに皮肉に聞こえるな……」":273,"「ま、いいんじゃねーか。[l]\nただ、":274,"Ｄなんぞ今回のゲームに絡めたら、\n店長の現時点でのスキルキャパはオーバーするだろな。":275,"オウトはKaleidoがちゃんと手綱握っとくのが賢明だろーがな。[l]\nどうせ実戦闘になっても、事に当たるのはあたしらだし」":276,"「ですね。[l]\n私も御嬢のお世話で忙しいですし」":277,"「なんでもいいからご飯食べ行こうよ」":278,"「それーっ！[l]\nそれがいいぉ！」":279,"「あう、\nじゃじゃあ、『ねこざんまい』に取り敢えず……[l]\n電話あそこのしかワタシ使えないので……」":280,"「にてしても、\n懐かしいものを大量に視たな。[l]\nかれおんのナカマだから当然か……」":281,"視えた時はまだ、\n意識と言動は不一致だったんで、\n彼女等には俺が気付いたかどうかは伝わんなかったかな。[l]\nその方が善いかもな。":282,"そうかそうか……":283,"イーくん、\n頑張れよ。":284,"いかなプレイアァの資格者、語り部の視覚者とはいえ、\n出来ることはゲームの視界の司会だけじゃないはずだからな。":285,"頑張れ。[l]\nまた俺達が逢えるように。":286},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_005.ks","relPath":"/data/scenario/SC_S_005.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":287,"length":287,"percent":100},"cellInfo":[[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,