tart":31368,"end":31379}],[{"start":31409,"end":31417}],[{"start":31501,"end":31505}],[{"start":31561,"end":31579}],[{"start":31605,"end":31633}],[{"start":31641,"end":31646}],[{"start":31654,"end":31662}],[{"start":31670,"end":31683}],[{"start":31691,"end":31711}],[{"start":31719,"end":31722}],[{"start":31730,"end":31742}],[{"start":31750,"end":31758}],[{"start":31813,"end":31822}],[{"start":31852,"end":31879}],[{"start":31911,"end":31915}],[{"start":31941,"end":31947}],[{"start":31978,"end":32038}],[{"start":32068,"end":32073},{"start":32256,"end":32261}],[{"start":32104,"end":32147}],[{"start":32155,"end":32192}],[{"start":32200,"end":32226}],[{"start":32292,"end":32367}],[{"start":32395,"end":32402}],[{"start":32410,"end":32421}],[{"start":32429,"end":32436}],[{"start":32444,"end":32455}],[{"start":32463,"end":32469}],[{"start":32504,"end":32584}],[{"start":32678,"end":32736}],[{"start":32742,"end":32749}],[{"start":32759,"end":32760}],[{"start":32770,"end":32787}],[{"start":32797,"end":32805}],[{"start":32811,"end":32824}],[{"start":32830,"end":32846}],[{"start":32852,"end":32875}],[{"start":32881,"end":32896}],[{"start":32906,"end":32944}],[{"start":32950,"end":32971}],[{"start":32981,"end":32991}],[{"start":32997,"end":33014}],[{"start":33020,"end":33028}],[{"start":33034,"end":33045}],[{"start":33055,"end":33129}],[{"start":33135,"end":33164}],[{"start":33170,"end":33208}],[{"start":33259,"end":33304}],[{"start":33312,"end":33341}],[{"start":33367,"end":33395}],[{"start":33425,"end":33441}],[{"start":33473,"end":33478}],[{"start":33504,"end":33515}],[{"start":33523,"end":33532}],[{"start":33562,"end":33608}],[{"start":33640,"end":33695}],[{"start":33725,"end":33749}],[{"start":33781,"end":33787},{"start":33930,"end":33936}],[{"start":33817,"end":33868}],[{"start":33876,"end":33898}],[{"start":33966,"end":33991}],[{"start":34017,"end":34060}],[{"start":34068,"end":34110}],[{"start":34118,"end":34142}],[{"start":34174,"end":34196}],[{"start":34204,"end":34252}],[{"start":34278,"end":34284}],[{"start":34318,"end":34340}],[{"start":34348,"end":34407}],[{"start":34439,"end":34459}],[{"start":34467,"end":34509}],[{"start":34539,"end":34557}],[{"start":34565,"end":34600}],[{"start":34638,"end":34646}],[{"start":34652,"end":34729}],[{"start":34737,"end":34783}],[{"start":34789,"end":34839}],[{"start":34849,"end":34866}],[{"start":34872,"end":34901}],[{"start":34907,"end":34918}],[{"start":34924,"end":34931}],[{"start":34937,"end":34965}],[{"start":34977,"end":34988}],[{"start":34994,"end":35005}],[{"start":35011,"end":35031}],[{"start":35037,"end":35048}],[{"start":35058,"end":35065}],[{"start":35071,"end":35079}],[{"start":35085,"end":35099}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_047.ks","basename":"SC_M_047.ks","indexIds":{"@r昨日、\nえーと１７日の月曜。":0,"@rまだ本調子じゃなかったのか、\n冬夏と一緒の入浴が何かしら影響してたのか、\n一昨日のきぃとの快気祝いから戻ってから、\nどうも気分の悪いのが納まらず、\n僕は昨日一日、宮さんの了解を得て殆ど床についていたのだった。":1,"@rタイミング的に大変申し訳なかったが、\nここで":2,"拗らせて肝心の本番に響くよりは、\nと言うことで大事を取らせて貰ったのだけれど、\n正直心苦しい。":3,"@rしかして宮さんの方はと言えば、\n大して問題視していない御様子で、\nチノ嬢と仕事の話があるとかであんまり構ってくれなかった……[l]\nいや、構うってなによ。[l]\nや、僕がこんなになって忙しいのかもしんないし。[l]\n……どうでもいいやな。":4,"@r夜半、\n更に気分が悪くなって眼が覚めた。":5,"@r知狡さんに連絡すると何やらどたばたしてるようで、\nかなり深刻な顔をして僕の様子を視に来てくれたが、":6,"@rまあ、深刻なのはいつもの事だしなこのひとは。":7,"@rと思って苦笑いしつつ、\nそんななのに更に知狡さんは、\nビンとかでなく、錠剤を３粒はだかのまま持って来ていたり、\n何やらその慌てっ振りというか、\nそのギャップにまた吹いたりしたけど、\n錠剤は大変に効き目があったようで、\nすぐに気分は良くなった。":8,"@r気分が悪かったのであまり明瞭ではないが、\n錠剤もなんか漢方ちっくというか、\n手作りっぽかった気がするので、\n自家製の何か、自然薬みたいなのだったのかも知れない。":9,"@rこのまま今晩は大人しくして寝ていろ、\n絶対に起きてくるな。":10,"@rと強く念を押され、\nその真面目さにまた笑いつつ、\n眠りに落ちた。":11,"@rちなみに冬夏は普通に朝から学校行って、\nやっぱりこの宿に帰ってきたらしい。[l]\n祭が決定されたけども、\nまだ戻るつもりないのだろうかな……":12,"@r携帯電話を確認してみるが、\n今のところ姫様ちゃん達から連絡はない。":13,"で、今日。":14,"薬の御陰か、\n僕の体調不良は取り敢えず快復してる……と思う。":15,"前科があるから絶対に大丈夫とは言えないが、\n無理しなければ──混浴したりとか──、\n大丈夫であろうと思われた。":16,"前聞いてた通り、\n今日４月１８日は、\n冬夏達の学校の開校記念日とやらで休みらしく、":17,"心配して朝僕の部屋に来た冬夏は、\n僕の無事を確認するや否や、\nやや神妙な面持ちで、":18,"「今日、行きたい所あるんだけど、\nだめ？[l]\nむり？[l]\nあの、ちょっと話すだけでいいんだ。":19,"遊んだりとかそう言うんじゃないから……[l]\nあ、遊ぶ方が良いならそれでもいいけど……」":20,"と、ご提案。":21,"「んー、まあ、遊ぶのはあれとして、\n話すだけなら大丈夫でしょう、けども、\nどこかそういう、行きたい場所があるってことね？[l]\n前みたいに海とか寒いとこじゃ……」":22,"「ん、\n海じゃない。[l]\n逆、だね。":23,"山の中。だからその、[l]\n寒さはそれなりかも……だけど、[l]\n天気は？":24,"ん、晴れてるね。[l]\n多分だいじょぶ」":25,"窓の外を確認すると、\n確かに暖かそうな雰囲気ではあるね。[l]\n北の方とは言え４月も中旬だしな、\nそういう日もぼちぼち出始めるのう。":26,"「じゃあ、一応宮さんに訊いてみる。[l]\n……大体どの辺？[l]\n遠い？」":27,"「えっとね、\n一応、部分的に……なのかな？[l]\nうちの私有地なんだけど、神社」":28,"九抱山玄森神社。":29,"「……ぅあ。[l]\nもしかして祭の──」":30,"「そっか。[l]\n祭観光に来たんだったら知ってるよね。":31,"ん。[l]\nその神社。[l]\nだから、ちょっと遠い……かな。":32,"直線距離なら、碁石松原よりは近いと思うけど、\n坂道上るから。[l]\nあと、他校は普通に平日登校日だし」":33,"窓の外を眺めながら、\n何故か憂いの籠もった声、仕草でそう言う冬夏。":34,"これは、\nもしかして、\nいや、でも御神体の場所は冬夏も知らないって言ってたし、":35,"だが、祭儀の場所を前もって知っておけるのはチャンスか……[l]\n斎場の方は知ってるし、":36,"──ああ、":37,"そこまで思考して、\nあまりに打算的な自分が、ものすごく厭になった。":38,"当初の目的、今自分が此処に居る理由、\nそういうものを凌駕する程の、\n彼女等に対する感情移入、罪悪感、":39,"僕は、":40,"さいあくだ──":41,"「──いいよ、行こう。[l]\n話きくよ、そこで」":42,"「ほんと？[l]\nありがと、でも、\n……無理しないでね」":43,"「大丈夫、\nじゃ、宮さんに訊いてくるから、\n……ロビーで待つ？」":44,"「ん？[l]\nう、うん。[l]\nああああの、あのね朝御飯食べた？」":45,"「え、まだ。[l]\n出る前がいい？[l]\n出先にしようか？」":46,"「えええとね、\nあ、先連絡してきて、\nそれまでに考える……って電話で？[l]\n宮さまに確認て」":47,"「……うーん、[l]\n一応行ってくる、かな、\n冬夏もその方が時間できそうだし」":48,"「ん、\nあー、そ、そうだね、わかったー。[l]\n──、":49,"……じゃ、ロビーで待ってます。[l]\nそれまでに決めとくね。[l]\nあ、駄目って言われたら……？」":50,"「あ。[l]\n……や、[l]\n多分大丈夫じゃないかなあ……[l]\nばたばたはしてたけど何かあれば言ってくるだろうし」":51,"今回に関して言えば、\n仕事にも関係するかもだし……":52,"仕事……":53,"「訊いてくる。[l]\nじゃあまた後で」":54,"「まことさんっ、」":55,"「うあい？」":56,"「……あ、[l]\nん、\n呼んでみただけ。[l]\nあはは」":57,"「あはは……[l]\nあっはっはっは……」":58,"「ごめん。[l]\nいってらっしゃい。[l]\nロビーで待ってるね」":59,"「じゃ、\n鍵しないといけないから出ましょか」":60,"「はぁい」":61,"冬夏とエレベーターで別れ、\n僕は宮さんの部屋に向う。":62,"何故か、気もそぞろに、\n僕はエレベーターのボタンを意味無く連打した。":63,"「宮さん……[l]\n居ますか？」":64,"「おはようございます。[l]\nお身体の調子は良いようですね？[l]\n安心しました、薬がちゃんと効いたようで」":65,"「あ、おはようございます……[l]\nあの」":66,"「大変心苦しいのですが、\n昨晩から少々、大きな動きが──":67,"少々？大きな？[l]\nどっちでもいいんですが、\n敢えて言うなら大きな動きがありまして、\n今その処理に追われてます店長は。":68,"斯くいうワタシもヘルプしないといけませんでね。[l]\n取り敢えず現時点ではまだ、アナタにして貰える事もないですが──":69,"ああ、今チズルが来るでしょうから、\n話があるのでしたら彼女にお願いします。[l]\n仕事絡みでもプライベートでも、\n判断し対応出来ますのでご心配なく」":70,"「あ、……そうですか、[l]\nすみません邪魔して……」":71,"「……いえ。[l]\n店長が必ずアナタを必要とする事態になるでしょう。[l]\nそれまでは、\nそちらこそご自愛を。":72,"くれぐれも、\nTake care of yourself.":73,"では失礼します」":74,"「あ、\n……？[l]\n僕を必要と……？":75,"大きな動きって、何が、\nあ、知狡さん」":76,"「ああ、\nおはよう。[l]\n大丈夫か？[l]\n顔色は……良さそうだが」":77,"「御陰様でなんとか大丈夫です、\nええと今なにか、」":78,"「ん、まあな。[l]\nま、今はまだお前が気にすることはない。[l]\n何か用か？」":79,"「え？[l]\nあ、ああ、あの、":80,"今日学校が休みとかで、\n冬夏がその、\n例の山の例の神社に行きたいと──」":81,"「九抱山玄森神社──にか？[l]\n祭の実行が決まったと聞いているが、\n何か関係が、\nあるのか？」":82,"「よくは分かりませんが、\n話があるとか……":83,"僕としてはその、複雑ですが、\n……色んな意味で、複雑なんですが、[l]\nもしかしたらこれで、」":84,"「………。[l]\n連絡だけちゃんと取れるようにしろ。":85,"何かあったらすぐ──体調の事も含めてだぞ、\n連絡を寄越せ。[l]\n今私くらいしか動けないかも知れないが、\nすぐに迎えに行く」":86,"「分かりました……[l]\n基本的には話があるとかだそうなんで、\n何事もないとは思いますけど」":87,"「み──宮さん……は今手が離せない、[l]\nもう聞いたな？[l]\nだからその、\n無事に戻って来るんだ。必ず」":88,"「はははは、相変わらず深刻過ぎますって。[l]\nええ、それは勿論、ちゃんと帰ってきます。[l]\n何かあったら連絡しますから。":89,"じゃ、宮さんにも宜しく伝えてください。[l]\n行ってきます」":90,"「……気をつけてな」":91,"宮さんの顔くらい、視てから出掛けたかった。":92,"とかいうこととかじゃない筈だが！":93,"何となく、\nやはり落ち着かない。[l]\nそんな自分の心を振り切るように、\n僕は知狡さんに背を向けて、ロビーへと向かった。":94,"車中では、\n冬夏は何故か黙りがちで、\n先日の喋りまくりテンションとは明らかに、\n別人のように違って静かだった。":95,"時折言葉を発するも、\nすぐ会話が途切れて続かないというか、\n心ここにあらずな返答だったりで、\n前のドライブを知ってるだけに心配になる。":96,"何かあるなら言って欲しかったので、\n空気を敢えて読まずに突っ込んでみた。":97,"「あの……[l]\n今あんまし話さないけども、\n何か調子悪いとか？[l]\n話す事があるわけでしょ色々と？[l]\nこの車中で話さないって事は──」":98,"「ん、\nんー。[l]\nその、着いたら話す。":99,"あ、ごめん、\nそんなに静かだった私？[l]\nその話す事まとめてて頭いっぱいだー、\n……ごめん」":100,"「ああ、成る程ね……[l]\nまあ無理せずに──\nそうだ、何かラジオでもかける？":101,"すっかり頭から飛んでたけど、\n車にはカーステレオってもんが……」":102,"「……っぷはは。[l]\n真言さん、\nやっぱいいいなー真言さん。[l]\nいいなー……」":103,"格別狙ったとか気を遣った訳ではなくって、\n完全なる素だったんだけども、\nまあ喜んで……喜んで？、[l]\nくれたようで良かった良かった。":104,"「……なんだかさっぱり分からんけども、[l]\nまあ僕なんぞ笑われてなんぼよね……[l]\nそういうポジションだもんねもう」":105,"「ん？[l]\nっははははは！":106,"ま、そだよね。[l]\nあはははは！[l]\nかわいそ、あはははは！」":107,"「……なんだかさっぱり分からんけども」":108,"どれくらい走ったのか、\n冬夏に言われるがままに道を進み、\n看板に書かれた九抱山までの距離も１０㎞を切った頃、":109,"窓の外にはその威容を誇る──ある種の異様さをも不思議と感じる──かの山が、眼に視えて近くなっているのを確認出来る。":110,"玄ノ森に来た日に遠く視えていたあの山と、\n同じとは思えない程に、\n眼前に迫るこの霊峰霊山は──":111,"きっと先入観や気のせいだろうけれど、\n不気味なくらい、\n何かがいる、まさに生命の塊たるその、\n":112,"魁":113,"偉とでも言うべき圧倒的質量感、":114,"遠くから視たのでは只の輪郭だった筈の稜線が、\n樹木の一本一本が確認出来る程に近寄るだけで、":115,"景色とは風景とは、\nヒトの傲慢な主観に過ぎないと思い知らされる、\n全て書き割りなどではない、\n全てが自我持つものの集積──":116,"「まーことさーん？」":117,"「んなっ。げほごはっ。[l]\nご、ごめ、今ちょっと浸ってた……」":118,"「？」":119,"小首を傾げる冬夏。":120,"「いや、なんでもないす。[l]\nな、なんでございましょ」":121,"「ん？[l]\nあ、\nえーとね、\n駐車場、私達の専用だからすっごい分かりにくいんだけど。":122,"それで神社にも結構歩くから、\n何か飲み物とか買って行った方が良いかなって。[l]\n真言さんの体調もあるし……」":123,"「なるへそ」":124,"「で、そんなだからね、\n店も近くに全然無いから。[l]\n途中でコンビニ入った方がいいね」":125,"「あいよぅ。[l]\nじゃ、\nあああああれか、あそこに入るますっ」":126,"「あはは、\nどぞどぞ、入るますってくださいあははっ」":127,"これまたわざとじゃないんだが……[l]\nもういいです。":128,"駐車場に入りエンジンを切る。[l]\n何にしても愉しんでくれてるならそれに越した事は、":129,"………。":130,"ちらと視た冬夏の顔は、\nやはりどうにも憂いて視える、\n思い詰めてる、":131,"なんだろうか。":132,"指定の場所が件の神社だったので、\n祭、或いは御神体に関わる話なのか、\nとも思った訳だが、\n告白の返事とかを迫られるんだろか？":133,"当初の約束の、冬夏の誕生日まではまだだけども、\n待てなくなったか時が経って心変わりでもしたのか──":134,"「ん？[l]\nなぁに？」":135,"はっ。[l]\n思わず視詰めてた。[l]\n僕が我に返ると、冬夏も急に気付いたかのように顔を赤くし、\n慌てふためいて言った。":136,"「えっと、その、あはは。[l]\nあの、そのね。[l]\n私買ってくるけど。":137,"真言さん乗ってて良いよ？[l]\n何がいい？」":138,"と、\n今にも車降りる勢いに。":139,"「や、寧ろ僕が行くから冬夏乗っててよ。[l]\nこういうときくらい男子が……」":140,"「だぁかぁらぁ～、\n私にそういうのって無意味だし。[l]\nいーから何要るの。ほれ。言え。言いなさい」":141,"「……ええーと、[l]\nじゃあレモン的なビタミン的なペットボトル飲料と、\n１００円レベルの甘いもの……チョコでいいや、[l]\nあとレーション的な何か」":142,"「ええっ？えええっと、[l]\nれれれーしょん？？」":143,"「あ、ごめん、所謂、一日分のカロリーだの栄養をこれで！[l]\nみたいな固形食物……」":144,"商品名が出てこねえ……[l]\nレーションが出てなんでそっちが出ないか僕のアタマ。":145,"「ああーあ、\nああ、はい、はいはい。[l]\nあといい？」":146,"しかし冬夏は何かしら解答に行き当たったようで、\n１人納得の御様子。":147,"「うん、僕はそんなで……」":148,"「じゃ行ってくるね」":149,"「いってらー」":150,"「いてきまー」":151,"……空元気に視えてしょうがない……":152,"それともそれは僕の方なんだろうか。":153,"僕は──":154,"「僕は、":155,"体力とか、":156,"無い方だけど、":157,"それ抜きにしたって、":158,"え？":159,"冬夏、よく、":160,"スカートで、":161,"来ようと、":162,"思ったね、":163,"これ、":164,"道かいな？」":165,"斎場の方もあれだったが、\nこっちは更に野趣溢れる味わい。":166,"「まともな道もあるけど、\n平坦な分遠くなるんだよね。":167,"なんかね、\n大人数が一気に来られないようにとか、\nそういう配慮？[l]\n知らないけど。":168,"蔵の中とか、何気にそう言う警戒はしてるんだよね、\nうち昔から」":169,"何か荷物とか資材とか、\n絶対無理だと思う。[l]\n空輸でも無い限り、\n少なくとも文明の利器という奴はほぼ拒まれるんでないか。":170,"それなりの":171,"人":172,"足つかわにゃ到底、\nいや、専門でないから分からないけども、\nロープウェーとかケーブルカーも無いようだし、\nそういう意味じゃ距離も短いし斎場はまだ何とかなったけど……":173,"「まあ、\n馴れてるって言えば馴れてるけど、\n真言さん病み上がりだからじゃない？":174,"まだ寒いから、\n草とかそんなに酷くはないでしょ。":175,"これ夏場とかだと結構厳しい。[l]\n虫とかまむしとかわんさと出るよ」":176,"ああ、なんか、":177,"宮さんが、\n来る時の新幹線で、":178,"そんな事を、\n行ってたような、":179,"「病み上がり心配してる割に、":180,"そもそもこんな所に、":181,"連れて来たのは、":182,"何か、":183,"矛盾してない？」":184,"「んー、ごめんっ。[l]\n私で大丈夫だから男子なら平気と思ったんだよね。":185,"というかね、\nここ歩くのは体力というよりも、\nコツがいるんだと思う」":186,"まあ、\n靴が運動靴なだけで、\nスカートでも何とかなってるもんなあ、\n大体八相……三春の眷属達、そのお偉い方は殆どが女性──？":187,"と、":188,"急に楽になった。":189,"「あれ、\n急に、\n何か楽に」":190,"「所々、\n踊り場みたいに平らっぽくなるからね。[l]\nま、もう少し。[l]\n疲れたら言ってね」":191,"「御陰様で何とかだいじょぶそうだけど……[l]\n此処って野生動物出たりしないの？」":192,"先日の件を思い出し、\n……今まで忘れてたのが不思議だが、[l]\n急に怖くなり、\n訊いてみると、":193,"「季節的には……まあ大丈夫かな……[l]\n一応熊笛持ってるし、\nん、だいじょぶ」":194,"とのこと、\nここで僕が不安を煽る訳にもいかないし、\n確証は無けれども、\n地元民を信じよう……":195,"「あ、次穴の中入るから」":196,"「あな？！」":197,"「あー、\nだいじょぶ、観光鍾乳洞みたいに最低限の整備はされてるし。[l]\n関係者以外は入れないし……多分気付きもしない。":198,"入れば判るけど、まあ表行くよりずっと快適。[l]\n閉所恐怖症じゃなきゃね。[l]\n蔵、大丈夫だったし大丈夫だよね？」":199,"「うん……それは、だいじょうぶ……」":200,"「じゃあ、ここ今開けるね。[l]\n結界解かなきゃ」":201,"斎場の時の道具さんと同じ事を言い、\n斎場の時と同じようにそこに配備されていた『結界』を、\nごそごそ取り出した鍵らしきものを使って開けた。":202,"僕がまたも神妙にそれを視ていると、":203,"「んじゃ、こっち」":204,"と言いながら再び『結界』を閉じる。":205,"しばらく歩くと、\n突き当たりではなく、\nまたしても道の途中、\n真横の繁みに突然入っていく。":206,"汚い戸板のようなモノがいくつか無造作に立てかけ……いや、[l]\n放置されてるような、\n視た感じ不法投棄現場のような場所だったが、":207,"それを":208,"除けると、\n確かに小さな空間があった。":209,"中に入るとエアロックのような二重扉構造の小部屋で、\n奥と続く扉は確かに人工物だし、\nそこにも鎖と錠前の封印はなされている。[l]\n一見、危険立ち入り禁止、と視えなくもない。":210,"「先刻説明した通り、一応電気は通ってるはず。[l]\nライトは持ったけどね。[l]\n天井は低いところあるし、\n足下濡れてると思うから上下に気をつけて。":211,"基本的には立ったまま歩いていけるけど、\n分岐が無い訳じゃないから、\nちゃんとついてきてね」":212,"「りょ、了解……」":213,"一応、彼女等にしか知らされてない、\n現場へのショートカットなんだと。":214,"蔵の中といい、\n何だってこんな、\n何を隠そうとしてるのか、":215,"「だから、\nまともな道行くよりはずっと早くて楽なんだけど……[l]\nあ、あれ地底湖ね。[l]\nこっちは何か化石」":216,"「へ、へぇ～……」":217,"確かに何か水が真っ青に視える綺麗な地底湖？や、[l]\nよく分からない何かの化石やら、\n石筍やら鍾乳石やらある種の芸術的様相を呈した岩の壁など、":218,"それこそ観光地にすればそれなりのスポットになるであろうその穴を、あくまで通路として、":219,"緊張や疲れであまり覚えてないけど、\nともあれ、":220,"その後も僕等は、\n僕が一方的にひーひー言ったり励まされたりして、\nどんだけ時間が経ったものか、":221,"何とか目的地に着いた、ようだ。":222,"「お疲れさまー」":223,"「おつかれ……」":224,"「とりあえずちょっと休もう。[l]\nはい、これ」":225,"「さんくす……」":226,"山頂なのか中腹なのか、\n樹木が天蓋のように上空を覆っている為に、\n標高もよく分からない地点、":227,"そんななので、\n眼下を視下ろせる状況でもなし、\n達成感に乏しい登山であった。":228,"久々に地上に出たのに、\n音以外での差異をそれ程感じなかったのはその所為か。":229,"そりゃ、\n余所から視えない秘儀をするという意味では、\n非常に有用な地ではあろうが、":230,"まあなあ……[l]\n下手すれば当日、\n此処に再来せねばならないのか……":231,"罪悪感云々以前に、\n単純にしんどそう……[l]\nもし此処に御神体があれば、\n色々話は変わって来るのだが……":232,"蔵の中に無かったとは言え、\n幾らこの場所が、来るのに困難な道程とは言え、\nこんな所に無防備に置いてあるとは到底、":233,"「まことさん」":234,"「え？[l]\nあ、うん」":235,"「ここね、\n分かると思うけど、\n簡単には他のひとが来られないし、\n……うちの管理してるとこだし、":236,"ちなみにね、さい──祭の時は、\nもっと上の方で色々儀式があるけど、\nここは社があるだけ、中継地点」":237,"奥の院──というか、祭儀場は更に上か……":238,"「とはいっても、\nこの辺りでも既に余所の人は\n入ってはいけないコトになってるから、\n完全に２人きりになれるのね。":239,"だからここで話そうと思ったの。[l]\nごめんなさい、面倒かけて」":240,"「え？[l]\nいや、それは別に大丈夫だけども、\n２人きりって言うか、\nもっと楽な、他にそんな場所幾らでも」":241,"「私達──三春の家はね、\nその……普通じゃないの」":242,"「聞いてないし……って、[l]\nは？[l]\n普通じゃないってそれは、\nつまり実力者権力者って意味じゃ」":243,"「……まあ、[l]\nその原因っていうか理由っていうか由来っていうか……":244,"あは、\n私のこの姿がまず普通じゃないんだけどー。[l]\nあははは……」":245,"「……んー、」":246,"「えとね。[l]\n今から私、\nコクハクします。":247,"貴方に言わなきゃならないこと、\n秘密にしてたこと、\nしてほしいこと、":248,"もしそれで、\n貴方が私を拒絶するなら、」":249,"わたし、すべてをあきらめる。":250,"「えーと、\nそれって」":251,"「ん？[l]\nこないだの誕生日約束とは、\n実は別。[l]\n分っかりにくいよね、あはは。":252,"まーそのね、\n此処で拒否られても、\n真言さんちゃんと下まで送るから。":253,"置いてったりしないから安心して。[l]\n真言さんが──厭じゃなきゃ」":254,"「え……？」":255,"「私、会ったときから、\n何となく貴方はそうなんじゃないかって、\n感じてた。":256,"感得っていうの？[l]\nま、その、びびっときたってやつかなあ……[l]\n世の女の子がよく言うそれとも、ちょっと違うんだけど、\nいや、いっしょかな……」":257,"「………か、んとく…？」":258,"「蔵の中でさ、\nなんか真言さんもワカってたっぽいから、\nそれでやっぱりそうなのかな、とか思ったり」":259,"「……ワ、カル…？」":260,"「マガンシツはタイシツでもあるけど、\nセイシンコウゾウによるところも大きく無視出来ない、\n……んだって。":261,"真言さん、私の話よく聞いてくれたし、\nその、よくある幻想かもだけど、\n理解も、してくれてたかな、て……」":262,"「……ま、がんしつ……」":263,"「と、兎に角ね、\nほんとは確証もてるまで、\n黙ってようかと迷ってたんだけど──」":264,"「……な、なんの……だろ……？」":265,"「砂の城のこと、\nまだ思い出してないよね」":266,"「すなのしろ……シロノシロ？」":267,"「白の城、しろのしろ、\nシを忘れるな、\nMeMentoMori、\nM3EW。":268,"つくりませよみませEpitaph……」":269,"「え？[l]\nあ？[l]\nそれは、\n何処かで──」":270,"冬夏はにこり、と微笑んで、":271,"ミ・タサキャラタサキャラミャルタサキャラタサキャラメキャミャル、タサキャラコネタサキャラナサメコネカヤミャルタサナサ・ワ":272,"これは、\nあの謎言語──":273,"「出て来てミハル、\n──禁級読紙」":274,"「出て……？[l]\nキンキュウ……って」":275,"三春？[l]\n誰かが他に、此処に──":276,"「……っ痛」":277,"「……っ？！」":278,"@rなにかが、\nいる、":279,"\nそこになにかがいる、":280,"\nあたまに印象がながれてくる、":281,"\n繋がれ、":282,"我等が友人、":283,"恍惚もたらせ、":284,"\nＣ、":285,"\nＡ、":286,"\nＴ、":287,"\n──究極の美の体現、アイらしいけもの":288,"\n──このセカイを楽しくいきる手助けをしてくれるトモダチ":289,"\n──ね、こ、":290,"\nあ、":291,"\n首が、":292,"「……！」":293,"冬夏のそばに、":294,"\n僕にも、":295,"\nそこに、":296,"\nなにかがいる、":297,"\n首が熱い、":298,"\n心がさざめく……":299,"@r水は戻ら──":300,"「視える？[l]\nほんとは大黒も一緒なのが本当なんだって、\nでも、こないだ蔵の中でも私の知らないとこに移されてた。":301,"だから、\n今はこのこだけ」":302,"「オオクロ……ご、しんたい」":303,"「そう。[l]\nただね、\nほんとうは、\n全部で八つ、なの。":304,"大黒はその中のひとはしらに過ぎない。[l]\nネコガミは私達七家に伝わる八つのカミ」":305,"「……な、な」":306,"「きっと、視えるはずなんだ、真言さん、":307,"あのときのあのこなら、\nわたしとやくそくしたあのひとなら、\n……視えないはずないもん。":308,"ほら、やっぱり、」":309,"「ああ、こ、」":310,"\n首が熱い、熱い、熱い、こ、れ、は、":311,"\n神使乃八舞のあ、の、あれなのか、":312,"\n":313,"あのとき、":314,"視たような、":315,"やっぱりいるのか、":316,"\n視えてる、":317,"\n視える、":318,"「やっぱり、視えてる、んだね？」":319,"ヤッパリアナタダ。":320,"「…こっ、……こ、[l]\n視える、これは、」":321,"ヤッパリコノコカ。":322,"気のせいでもなんでもなかった、":323,"何かが視えていたんだ、今までも。":324,"それが、":325,"「これが、\nミハル……？」":326,"大神、\n@rお前に視えてるのも、\n@rこういうのなのか……？":327,"@rこんなものが、\n@rセカイに、":328,"「……良かったぁ。[l]\nわたし、……わたしっ」":329,"「あ、と、とうか、\nやっぱ」":330,"がしっ。":331,"冬夏が僕の腕を掴む。":332,"痛いくらいに強く、":333,"決して離すまいと僕のウデヲ、":334,"「お願いだから怖がらないで、\nお願いだから、逃げないで、\nお願いだからちゃんとこれを視て──」":335,"「だ、大丈夫、逃げようとかそんなじゃない、か、ら──」":336,"冬夏の手を包むように握り返して、\nそれを直視する。":337,"@r印象がまたなだれこんできて、":338,"\nこれハ、":339,"\nミハル、":340,"\nミハルモノ、":341,"\nヒメモテマモルモノ、":342,"\nそして、":343,"\nワレハイシキノカイ\nガゴトクスナワチカシャ、":344,"ム":345,"ク":346,"ロ":347,"アヤツルタマタルソンザイ、":348,"アイズタルヒキガネハウブメ":349,"「………とり、」":350,"「……とり？」":351,"「トリック……じゃない……よね？[l]\nこれは僕が何度か、\nおなじ、\nものを、」":352,"「視えてるよ、\n真言さん、\n私達はおなじものをみてる、\nそう、\nこれが、」":353,"@r　　　　　八相のネコガミ。":354,"「八相の……ねこがみ」":355,"冬夏がそこで貧血でも起こしたように倒れ込んだ。":356,"「冬夏っ！！」":357,"慌てて抱き留め支える。":358,"「えへへ……[l]\nちょっと疲れた」":359,"力なく笑うが、\n次の瞬間、\n力ががくっと抜けるのが分かる。[l]\nしっかりと抱いて支えるが、":360,"「あ……[l]\nん、\n大丈夫。[l]\nえへへへ、また抱きしめて貰っちゃった」":361,"「冗談はいいから、\n休もう、少し。[l]\nだ、大分僕も落ち着いた……から……":362,"何というか、\n思ったほど、\nあれ？[l]\n不思議じゃないっていうか、":363,"本の読み過ぎかも知れないけど、\nそういうのもアリか、って\n何か普通じゃないのを視る友人も１人いるしさ……」":364,"──取り敢えずは他人には言わない方が身の為じゃないか、と思うがな。":365,"しかし、\n向こうから言い出されては、\nこんなコクハクされてしまっては、":366,"それに、\n今は、\nとても、":367,"穏やかだ。":368,"安心……感というよりは、":369,"これが当然、とでも言うような、":370,"不思議な気持ち……":371,"それとも、単なる精神の防衛機構なのだろうか。":372,"「ほんと？[l]\n真言さん……\n順応早いね……さすが……":373,"私の見込んだひと、\nあのときのこ……だよね……」":374,"「正直、僕もはっきり思い出せてないから、\nごめん、断言は出来ないけど、\n視えてる、のは本当、だから。":375,"とりあえずこれで冬夏を拒絶したりはしない……[l]\n今までも多分何度か視てる……と思うし」":376,"「……ほんと？[l]\n他のは……まさか……あいつ」":377,"僕の最後の言葉で、急に険しくなる冬夏。[l]\n何か誤解をしてる、……否、してないにしても、[l]\nあまり良い空気ではない。":378,"「え、あ、いや、\nこんなはっきりしたのじゃなくて、\nそう、冬夏達のじゃないと思う、":379,"今まで経験として、へんなものが、視えてたりしたことが、\nあるってだけ、":380,"『あいつ』が誰かは知らないけども、そこは多分勘違いしてる」":381,"今までの経験っていうのが、\n極めて短期的であるという以外は概ねそのまま語ってるつもりだ。[l]\nあいつ……と、冬夏が言うからには、[l]\n恐らく──":382,"「あ……そうなんだ。[l]\nへー、\nじゃあ、やっぱり強いんだ、資質が。[l]\nきっと。":383,"もしあのときの男の子なら、\nん、頷けるんだけど。[l]\nまだそこははっきりしない訳ね？」":384,"「ま、まあそうなるね……[l]\nところで、そのミハル？ネコガミ？[l]\nって、一体何なの……っていう質問は、[l]\nしてもいいんだろか。":385,"あとやっぱり……他の……道具さん達も……？」":386,"そう、":387,"式の時に横にいたのは、":388,"……八相の西部仕切り、玉梓選律、とか言っていた。":389,"ということは恐らく、視えていた『あれ』も、":390,"そして、":391,"斎場に行く途中で、":392,"あんな事態になっても彼女達が平気だったのは、":393,"姫様ちゃんと狩屋も──":394,"という事なの……か？":395,"道具さん卑尊さん、":396,"後は、まだ会ってない、玖威の人間、":397,"七家に八つのカミ……":398,"御神体……オオクロ……":399,"「……一応、秘密ね。[l]\n私達だけの。[l]\n家の因習とかは気にしないけど、\nこんなの他の人に知れたら面倒。":400,"面倒はもう、この容姿で十分だから。[l]\nあ、宮さまになら、秘密守ってくれるって約束した上でなら、……いいよ。[l]\n多分あのひとも、ワカってくれる、くれてると、おもう」":401,"「わかった……」":402,"飯窪の仕事と直結してる以上、\nそれがどういう結果を招くかは、\n後で１人で考えねばならない。":403,"しかし、冬夏はそう言ってるけれど、\nそもそも信じるだろうかこんな話を。[l]\n大神ならまだしも、\nああ、宮さんも逆に喜びそうな話なのかもな……":404,"「火を知らないひとにのっての火、\n青銅器に対する鉄器、\n素手に対する重装備、\nそういうもの。":405,"他に対しての優位を保ち得る、\n……危険な、その気になれば……を……せる、[l]\n言うことは聞かないし、\n代償は求められるけど、":406,"それでも今のヒトの世の中でチカラを握るには十分なのかもね。[l]\n母様を視てればそれはわかる」":407,"本来、視える資質にはそういう凡俗さは伴わないのが常だって、\nトモさんは言ってたけど。":408,"そう冬夏は付け加えた。":409,"「ご先祖様が、\nあんまり出来が良くなかったって、\nそれでも三春が八相の頭領なのは──」":410,"ばさばさばさばさっ！":411,"「とりっ？！？！？！？！？！？！？！？！」":412,"たたたぶんと、ととと、鳥かなにかが！！！！！！！！":413,"「び、っくりしたぁ……」":414,"「っくりしたよねぇ……ぇあははは……[l]\n":415,"……あ、[l]\nじゃあね、":416,"やっぱり誕生日、お返事貰うときに、\nもっと色々話す。[l]\nあの海岸でね。[l]\nしろのしろの事も説明しやすいと思うし。":417,"あ……まあ、そのね、返事次第では気まずいかもだけど、[l]\n":418,"ん、私は気にしないよ？[l]\nその辺割り切れるからだいじょぶ、\n……多分」":419,"「……えーと、」":420,"「っていうかさ、\n単純に帰りの時間計算して、\nそろそろ戻らないといけないかなと。":421,"暗くなっちゃうし、\n明日一応学校だし」":422,"まあ、そうかも知らんけども、\nしかし、本番は確か夜な訳でしょ？[l]\n昼なのか？[l]\nどっちにしても構成員は女子だらけ……":423,"まあ、その、ネコガミのチカラ……でどうにかするんだろうか。[l]\nまだ具体的なチカラは分からないし、\nそれは誕生日に教えて貰うという話になった以上、\n何とも言えないが、":424,"にしても、":425,"飯窪家が探していたカミサマは、\n本家にしろ宮さんにしろ、\nそれがそういうものだと、\n知ってる……訳はないよな？":426,"単なる資料として、書痴としての興味、だよな？":427,"宮さん、知狡さん、母さん、……きぃ、":428,"これをこれとわかって探していたとしたら、":429,"がさっ。":430,"「ん？」":431,"「また……鳥？」":432,"違った。":433,"ひとだった。":434,"姿をみせたのは。":435,"「……お邪魔します」":436,"場の空気が、\n冬夏の":437,"纏う雰囲気が、":438,"変わった。":439,"一気に張り詰める。":440,"さっき鳥が飛び立ったのは、":441,"彼女が来たからだったのかそれとも──":442,"「キサマ…[l]\n何で、居るの。[l]\n克杖？[l]\nどうせ克杖も居るんでしょ？」":443,"「今日は私ひとりです。[l]\nあなたこそ何故此処に、とは問いません。[l]\n真言さんもいらっしゃるようですし」":444,"「……ふぅん珍しい。[l]\n今大事な時期でしょうに、\n２人揃ってないなんて、母様に怒られるんじゃないかしら。[l]\n真面目な貴女にとってあのひとの命令は絶対でしょうに」":445,"「今が大事な時期という自覚はおありなんですね」":446,"「あんた達にとってはって意味でね。[l]\n私には関係ない」":447,"「そうでしょうね。[l]\n克杖はそろそろ結果が分かるので置いてきました。[l]\n私もすぐ帰ります。卑尊さんのところに」":448,"冬夏が何故かそこで、開いている方だけだが──眼を剥いた。":449,"「……キサマ」":450,"「まだ、\nどっちかは分かりませんので、\n私が役に立てるかどうかは」":451,"なんだ？[l]\n何の話をしてるんだ？[l]\n狩屋の結果？":452,"だが、僕は黙って視てるしかない、\nとても入り込める空気じゃない──":453,"「………そろそろ結果が？」":454,"「こういうのは１０割言い切れませんので、\n私も目安、予定予測を聞いてるだけです。[l]\n貴女が家を空けてる間にも、\n時間も、事態も進んでるんです。":455,"全ては常に動いていて、\nその場に留まりたければその倍動かねばなりません。[l]\n全ては、\n全てはサイコウノ──」":456,"「わかんないこと話してんじゃないっ！！」":457,"──冬夏が激昂した。":458,"僕は硬直して、\n背筋を怖気が走る。[l]\n全身が冷や汗で濡れて気持ち悪い。":459,"姫様ちゃんも様子が変だ。[l]\nこんなにも冬夏を挑発……挑発にしか視えない、[l]\nそんな事をする":460,"娘なのか？":461,"相手が冬夏だからか？[l]\nだから冬夏は姫様ちゃんがきらいなのか？":462,"どっちが、\nどっちを、\nどう思ってこうなってるんだ？":463,"ああ、":464,"首が熱い。":465,"「冬夏さんは判らないんですか。[l]\nこの人がなんなのか、":466,"私達八相の":467,"少":468,"女が、\n何のために今まで居たのか、\n今、この時にこの場に揃うのは何故か──」":469,"このひと？":470,"「判るもんかっ！[l]\nあんたに視えるものなんか視たくもない！！[l]\nあんたが信じるものなんか信じたくもない！！":471,"知ったことか！！！[l]\n知らない！！！[l]\n知らないってば！！！":472,"あんたなんか、あんたなんか早く帰りなさい！！！[l]\n帰れ！！！」":473,"僕がなんだっていう？":474,"「そうですか。[l]\n統領の血を継がされながら、\n実のところは第二相の分際である貴女達三春には、\n所詮荷が勝ちすぎる事でした、ね」":475,"「そんな序列なんて知らないってば！[l]\nそんなものはどうだっていいんだ！[l]\nそんなのためになんでもするあんたたちとはちがう！！[l]\nこのひとは──」":476,"僕の方を振り向いて止まる、\n僕にも視えることを、\n姫様ちゃんに言いたくないのか。":477,"僕は、\n僕は、\n僕は、":478,"……僕は？":479,"「てっきり私は、\nこの人の事が判っていて近づいたのかと――\nやはり買い被りすぎというものでした」":480,"話し方は平坦で冷静だが、否、だからこそ、\n姫様ちゃんは明らかに挑発──\nつまり冬夏に対して悪意の籠もった言を吐き続ける。":481,"僕は、\nどちらの肩入れをするでもなく、\nただ":482,"只":483,"管に居たたまれなくなって、\n思わず声を発した。":484,"「ま、待ってくれ二人とも、とにかく落ち着いてくれ、\n何の話かさっぱりだけども、まず――」":485,"「前から話そうとしていたこと、\n丁度良いので今、話します。[l]\n克杖には後で話ますので」":486,"「え、は？」":487,"「なんのこと？」":488,"「真言さんからはトーノニオイがする」":489,"……？":490,"「……トオノ？」":491,"とうの？透の？遠野？":492,"──トーノ？":493,"冬夏も何事か把握できてないようだった。[l]\n僕も何のことかさっぱりわからない、\nそんな僕等を余所に、\n姫様ちゃんは淡々と続ける。":494,"「でも。[l]\n私達の様な魔眼の者というより、\nアヤメやミハルのような、そうですね、ベロアに\nとても近い」":495,"「……やめろ、キサマ。[l]\n黙れ。[l]\n意味分かんないし」":496,"「な…何を云ってるんだよ姫様ちゃん？」":497,"マガン？":498,"魔眼……か？":499,"アヤメ、とは恐らく綾目、彼女の家のネコガミ、":500,"だが、……ベロアとは？":501,"「あなたがねこのようにみえます」":502,"──。":503,"───？":504,"「な──んて言ったの？[l]\nよくわからな」":505,"「貴方はトーノイーハなんでしょう？」":506,"っ！":507,"首が、":508,"くすぶるように、":509,"熱くて、":510,"「違うんですか、いとしいひと──」":511,"それどころじゃ、":512,"「意味分かんないっ！！！もう、[l]\n喋るなって云ってるんだぁっ！！！！！！！！」":513,"のうがくうてんする、":514,"「冬夏ちゃん、\nもう少し話し方に気をつけないと駄目だよ、\n御嬢様なんだから」":515,"そ、の、台詞は──":516,"「………ぁ」":517,"「私が怒られる」":518,"「………っ、」":519,"「懐かしいですね。[l]\n昔はよくこうして──」":520,"「きー、ちゃ、ん？」":521,"それは、":522,"「？！」":523,"あのときだれがいたっけ？":524,"「冬夏さんもミハルに訊いてみるが善いのに。[l]\nこの人に惹かれる懐かしさがワカルはずなのに。[l]\n冬夏さんが、のぎかさんに黙ったままミハルをツいだのも知ってますよ。":525,"あのひとには言ってませんから安心してください。[l]\nあのひとは言わなければ気付かない程度の小物だもの。[l]\nそれに貴女だって、この」":526,"のぎかさん……冬夏の母さんに黙って……？":527,"「し、らないっ！[l]\n私は私の意志でまことさんを好きなの！！[l]\n私以外の何かの所為なんかじゃないっ！！！」":528,"冬夏を蔑むように眼を半眼にすると、\n僕の方を向いて姫様ちゃんが言う、":529,"「まことさん、このひとは何も分からないんです。[l]\n今ののぎかさんと同じようにご先祖が、\nとても低能であらせられたので」":530,"姫様ちゃんが僕のすぐ眼の前に立つ、":531,"そして、頸を、ぼくのくびを──":532,"「姫様ぁ！[l]\nうるさい！！[l]\nいいかげんにしろ！！！[l]\nまことさんから離れろ！！！」":533,"姫様ちゃんはゆるゆると僕の頸に両手を、":534,"「冬夏さんのいう『好き』がどれだけ脆弱なのか、\n本人も知ってて誤魔化してるのか、\n私の知る所ではありませんが、\nそれとあなたは無関係ですし」":535,"そして上目遣いに僕を視て、":536,"「まことさん、\nいま、わかりました、\n鈴が付けられていたのですね」":537,"と言うや、":538,"ぶつ。":539,"何かが千切れる音がして──":540,"「……ぅわああああああっ！！！」":541,"くすぶっていた、":542,"熱く、":543,"熱い、":544,"走馬燈のようなめまぐるしい感覚、\n怒濤のようになにかが、":545,"「んむ？」":546,"「……斬られた？」":547,"「prot-ein:Chokerが無効化……否、[l]\nハカイか？」":548,"「のようですね。[l]\nただ、あくまで緩衝器のようなものですし、\nChokerの失効自体は急を要する事態では\nありません、\n問題はそのシチュエーションで──」":549,"？？？":550,"？？！":551,"？！！":552,"！！！":553,"な、ば、":554,"やはり、姫様ちゃんも、":555,"「私もアヤメもほら、\n視えるでしょう。[l]\n私達は――\nあなた、のものです」":556,"このこもわたしもまことさんと、":557,"「ひとつになりたがってる――」":558,"何か言ってるのがきこえるが、\nもうそれどころではなくからだがあつくてたまらぬのだ":559,"「四重奏団とGWの件もあるし、\nいよいよ決めなきゃいけないか。[l]\nまあ、決めさせてあげてもいいが……」":560,"「一応準備その他に時間を要しますのでね、\n帰ってきたら":561,"暫くは……[l]\nそうですね、週明けを目処に、\nそれまでは」":562,"「カゴに入れておく、ね。[l]\n知狡にキリアケの準備急がせて」":563,"「……了解しました」":564,"「ああもう、\n兄様":565,"赦してくれるかなぁ？」":566,"「それは勿論、」":567,"ぱぁん。":568,"「、……これ以上何かしたら赦さない」":569,"眼を真っ赤にし、\n冬夏が姫様ちゃんの頬を張った。":570,"その音で、":571,"僕も我に返った。":572,"からだは……なんともない。":573,"あたまも、混乱はしてるがだいじょうぶだ。":574,"だが、":575,"宮さんから貰ったお守り、":576,"チョーカーが……":577,"「…ごめんなさい」":578,"「……………帰りなさい。[l]\n●●●●しが」":579,"「え？」":580,"何て言った？":581,"「分かりました。[l]\n言う通り帰ります。[l]\nでは冬夏御嬢様、\n最後にお伝えしておきますが」":582,"「………」":583,"「貴女自身が言った通り、\n貴女がどうなろうと正直私はどうでもいいんですけれど、":584,"真言さんの為にも、\n前言いましたけど、\n祭儀には出て貰う。":585,"祭儀１週間前までに戻らなければ……分かってますね？」":586,"「これ、最後通牒です。[l]\n逆に言えば何事も無くお戻りになれば、\n何の問題もありませんから。[l]\n勿論私もそれを望みます」":587,"最後通牒……？":588,"道具さんの言っていた、":589,"手荒な手段──":590,"まさか、ネコガミとは、":591,"アヤメとは、":592,"「まことさん、ではまたです。[l]\n克杖のことも──冬夏さんも、\n……まだ、なにも視えてないようなので。[l]\nよろしくおねがいします」":593,"@r姫様ちゃんはいつものように、\nはにかむかのように、恥じらうように、\n僕に向かってそう言って、":594,"@r冬夏を":595,"一":596,"瞥して、また山を独り降りていった。":597,"@r………、":598,"@r僕の為とはなんだ？":599,"@rトーノイーハとはなんだ？":600,"@r僕がネコガミを視られるのと関係がある？":601,"@r……動悸がまだ激しい。":602,"@r冬夏は、\n肩を上下させ、\n顔を覆ってしゃがみ込んだ。":603,"@r僕は千切れたチョーカーを拾い上げ、":604,"@r──何故だ。":605,"@r僕が感じているこの感情は、":606,"@r昂揚感？":607,"@rいや、なんだ？":608,"@r混乱はしているが、\nあってしかるべきマイナスの感情が、\n冬夏への同情すらも、\nいや、決して、何も感じない訳じゃない、":609,"しかし、\nどちらかといえば、\n昂揚ですら、":610,"そう、平坦だ、\nフラットなんだよ、\nこころがたいらなんだよ。":611,"「きっ……！[l]\nと、きっと、ショック状態なんだ、\nそうだ、そうだよな、":612,"おかしい、おかしい、こんなのは……[l]\n冬夏っ」":613,"声に出して自分に言い聞かせ、\n冬夏の元へ走った。":614,"「……くしょう、ちくしょう……」":615,"「冬夏、」":616,"──なにも言葉がない、":617,"なんていえばいい？":618,"「………ごめん。[l]\n最悪……最悪だよね、あんな姿、私、[l]\n最悪……」":619,"「大丈夫、気にしてない……[l]\nネコガミ……ミハル紹介されたよりは、[l]\n驚いたけど……」":620,"「……ぷっ、[l]\nあはは、あはは……」":621,"「……うん」":622,"「……やっぱ真言さんだ、ね……[l]\nん、それ、いいよ……[l]\n冗談でも本気でも……":623,"私にとっては、\nプラス要因、だもん」":624,"「私、こんな人間なの。[l]\nだから──」":625,"感極まる冬夏を視て、\n僕にもまだヒトを思いやる感情があることを確認するように、":626,"──そうでもしなけりゃこの奇妙な程冷静な感じが自分でも恐ろしいから、声をかけた。":627,"冬夏の独白を遮るように、\n彼女に言った。":628,"「いいよ、大丈夫、\n誰にだってある、":629,"表だって裏だって、\n僕にだって、\nだから、そんなことで冬夏を嫌ったりしないから」":630,"──ケレド、":631,"「……ん、[l]\nん、\nん。":632,"……ごめん。[l]\nだいじょぶ。[l]\nもうだいじょぶ。[l]\nこんなことで止まってらんない」":633,"「……何か、[l]\n食べようか。":634,"個人的な経験だけど、\nお腹が減ると、\n感情って簡単に揺らぐから……」":635,"「そだね。[l]\nうっし！！":636,"じゃ、\n買ったやつ食べよ。[l]\nはい！そうしよう！」":637,"@rそして、":638,"@r姫様ちゃんと帰路を一緒にはなりたくかろうな、\nというのを無言のうちに察して、\n僕等は此処でこのまま少しの間、時間を潰すことにした。":639,"@r２人とも、空回りした会話を続けて、\n……実際、実のある事、話す事は無かった。":640,"@rネコガミの事も、\n冬夏と姫様ちゃんの事も、\n姫様ちゃんが言っていた僕の事も。":641,"@r一瞬無言の間が出来たとき、":642,"@r隣り合って座っていた冬夏が僕の肩に顔を押しつけて、":643,"@r多分泣いてる。":644,"@rでも、":645,"@r僕は黙って身を任せるしか、任させるしかなかった。":646,"@rどんな言葉も、":647,"@rどんな行為も、":648,"@r僕から冬夏にすることはなかった。":649,"@rできなかった。":650,"@r僕は、":651,"\n早く、":652,"\n宮さんに、アイ──":653},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_047.ks","relPath":"/data/scenario/SC_M_047.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":636,"length":654,"percent":97.24770642201835},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[445,1]},"/data/scenario/SC_M_048.ks":{"data":[["@rもう一昨日の事だ。","@r那已经是前天的事了。"],["@r九抱山から宿に戻る頃にはすっかり陽は落ちていて、\n僕と冬夏はすぐ夕飯をとった。[l]\n帰りの道中では、\nお互いにまるで反動のように、\n極めて積極的に普通たらんとする意思が働き、\nそれはそれは痛々しい空間が構成されていたけれど、","@r从九抱山回到旅馆时太阳早已西沉、\n我和冬夏立刻吃了晚饭。[l]\n在回来的路上、\n我们就像条件反射般、\n拼命装作若无其事的样子、\n那场面简直令人窒息、"],["@rそれでも黙ってたり深刻になるよりはましだ。","@r但总比沉默或摆出苦大仇深的表情强。"],["@r知狡さんは帰ってきた僕に気付いてほっとしていたようだが、\n冬夏と一緒に居たために近寄っては来なかった。","@r知狡阿姨看到我回来似乎松了口气、\n但因为和冬夏在一起而没有靠近。"],["@r結局冬夏は、\nこの宿に戻ってきた訳で、\nまだ、\n家に戻るつもりはない。","@r说到底冬夏、\n之所以回到这个旅馆、\n就是还、\n没打算回家。"],["@rそれがどういうことかということも、\n僕は努めて考えないようにしてる。[l]\nきっと、きっとなんとかなるんだと、\nそう考えてる。","@r这意味着什么、\n我强迫自己不去深想。[l]\n一定，总会有办法的、\n我这样告诉自己。"],["@rあまりの疲労と空腹に、まず夕飯を優先させたが、\n兎に角宮さんと話がしたかった。[l]\nお守り──チョーカーの事もあったから。","@r由于过度疲劳和饥饿，我们优先解决了晚饭、\n但无论如何都想和宫小姐谈谈。[l]\n还有关于护身符──项圈的事。"],["@r夕飯後に冬夏と別れ、\n部屋に戻る振りをして宮さんの部屋へ向かうが、\n知狡さんに捕まった。[l]\n出発前にチノ嬢から聞いていた通り、\nまだばたばたしていて手が離せないという。[l]\nまずは僕等の無事に安堵してくれたが、\nチョーカーの事を伝えると一瞬困った顔をして、\nそれは宮さんに速やかに伝えると言った。[l]\nもう知っているかも知れないが、\nと、僕にはよく判らない事も言っていた。","@r晚饭后与冬夏分开、\n我假装回房实则前往宫小姐房间、\n却被知狡阿姨截住了。[l]\n正如出发前千乃小姐所说、\n她正忙得不可开交。[l]\n她首先为我们平安归来感到欣慰、\n但听到项圈的事时露出为难的表情、\n说会立刻转告宫小姐。[l]\n还说宫小姐可能已经知道了、\n之类让我摸不着头脑的话。"],["@r取り敢えずそれ以上どうすることも出来なそうだったし、\n冬夏の……ネコガミの事は宮さんにだけ話すつもりだったから、[l]\n大人しく部屋に戻った。","@r眼下似乎也做不了更多、\n况且关于冬夏……猫神的事我只打算告诉宫小姐、[l]\n便乖乖回房了。"],["@r",""],["暫くして、知狡さんが僕の部屋に来て、","不久后知狡阿姨来我房间、"],["@r明日から外出をしないよう、僕に言った。","@r通知我明天起禁止外出。"],["@r命令、という言い方が合ってるかどうか分からないけど、\n宮さんが知狡さんに伝えるに、\n連絡を寄越すまでそれは強制という事だった。","@r虽然不确定用'命令'这个词是否准确，\n但宫小姐传达给知狡阿姨的是，\n在接到进一步通知前这属于强制要求。"],["@rなので今、ずっと部屋だ。[l]\n宿の中は動けるが、\n勿論客室フロアを","@r所以现在只能一直待在房间里。[l]\n虽然能在旅馆内活动，\n但当然在客房楼层"],["彷","彷"],["徨いても仕方ないし、\n娯楽施設も大したものはない。","徘徊也无济于事，\n娱乐设施也没什么像样的。"],["@r理由は全く知らされてない。[l]\n僕が、『あのこと』を報告した後ならば、\nそれで仕事の目的は或る意味でかなり進んだ事になろうから、\n或いは祭まで不用意に動くな、という意味かとも思えたが、","@r完全没被告知缘由。[l]\n如果是在我汇报'那件事'之后，\n从某种意义上说工作目的已经推进了不少，\n或许意味着在祭典前不要轻举妄动，"],["@rあれから宮さんには全く会えていない。[l]\n繋ぎも取れない。[l]\n知狡さんとは話せるが、\nあくまで仲介の立場を崩してくれない。[l]\nあのひとに会わせてはくれなかった。","@r但自那以后就再没见过宫小姐。[l]\n也联系不上。[l]\n虽然能和知狡阿姨通话，\n但她始终不肯打破中间人立场。[l]\n没让我见到那个人。"],["@r部屋にずっと居るしかなかった。","@r只能一直待在房间里。"],["@rだから、\nお守りのチョーカーが無くなっても、\n外部刺激が極端に少なくなった現状では、\n何も変化した気がしない。","@r所以\n即使护身项圈不见了，\n在外部刺激极度匮乏的现状下，\n也没感觉有什么变化。"],["@rまるであのチョーカーが、\n実際効力を発揮してたような言い方だけど、\n宮さんから貰ったものだったから、\nそれにそういうのって結構気になるものだと思う。","@r虽然这么说好像\n那个项圈真有什么效果似的，\n但因为是宫小姐给的，\n这种细节还是会很在意吧。"],["@rそれはともかく、\n刺激が。","@r总之，\n刺激。"],["@r誰からも連絡もない。[l]\n知人がそもそも少ない。","@r没有任何人联系。[l]\n本来熟人就少。"],["@rこうなると、道具さんでも狩屋でも、\n話せる相手なら片っ端から話したい気分だったけれど、\nだが、あんな事の後では、\n姫様ちゃん……達には、[l]\nこちらから電話する、という選択肢は、\n僕に二の足を踏ませるに十分なものになってしまっていて、","@r这种时候，不管是道具小姐还是狩屋，\n真想逮着能说话的对象说个遍，\n但在那件事之后，\n姫様酱......她们那边，[l]\n主动打电话这个选项，\n已经让我踌躇到无法行动的程度，"],["@rもしや彼女達から、とも思ったりもしつつも、\n何も無いまま時間は過ぎた。","@r虽然也想过或许她们会联系我，\n但时间就在毫无动静中流逝了。"],["@rきぃに一度だけ電話してみたが、\n繋がらなかった。[l]\nそれきり電話はしてない。","@r试着给小贵打过一次电话，\n没接通。[l]\n之后就没再打了。"],["@r何か忘れている気がする。","@r总觉得忘了什么。"],["@rしかし空転……否、停止状態で何も、[l]\nどうこうしようという意欲が沸かない……","@r空转......不，停滞状态下根本[l]\n提不起劲做任何事......"],["@r今日は２０日、\n","@r今天是20号，\n"],["明","明"],["後","后"],["日の、\n@r……冬夏の誕生日までには、[l]\nこの状態から脱する事が叶うだろうか。","距离\n@r......冬夏生日之前，[l]\n能摆脱这种状态吗。"],["@r宮さんとはいつ話が出来るだろう。[l]\nせめてそれより前には──","@r什么时候才能和宫小姐谈上话呢。[l]\n至少在那之前——"],["@rそう考えながら、部屋で夕方までぼんやりしていたら、","@r这么想着在房间发呆到傍晚时，"],["「真言さん──」","「真言先生——」"],["「冬夏……？」","「冬夏......？」"],["「あの","「那个"],["娘、","妈妈们"],["また、","又"],["母様達、また、","我又"],["私、なにもできな──」","什么都做不到——」"],["「え？[l]\nどうし──」","「诶？[l]\n怎么了——」"],["下校して来たのだろう、\n部屋に現れた冬夏は、","应该是放学回来，\n出现在房间的冬夏"],["あたまをぶんぶんと横に振り、\nその場に蹲った。","用力摇着头，\n当场蹲了下去。"],["泣いていた、","在哭，"],["慟","恸"],["哭している、\n完全に自失して言葉にならない喘ぎ声を振り絞るように出し続ける冬夏、","在哭泣着，\n完全失神地持续发出不成言语的喘息声的冬夏，"],["どうして良いか分からず、","不知该如何是好，"],["僕は無言のまま手を貸して、立ち上がるよう促すと、","我沉默地伸出手，示意她站起来，"],["冬夏はよろよろとして、","冬夏摇摇晃晃地，"],["たちあがったそのときに、","就在起身的那一刻，"],["彼女の左眼をおおっていたそれがはずれた。","覆盖她左眼的东西脱落了。"],["そこには","那里"]],"context":[["SC_M_048.ks/index/1/text"],["SC_M_048.ks/index/3/text"],["SC_M_048.ks/index/5/text"],["SC_M_048.ks/index/7/text"],["SC_M_048.ks/index/9/text"],["SC_M_048.ks/index/11/text"],["SC_M_048.ks/index/13/text"],["SC_M_048.ks/index/15/text"],["SC_M_048.ks/index/17/text"],["SC_M_048.ks/index/19/text"],["SC_M_048.ks/index/22/text"],["SC_M_048.ks/index/24/text"],["SC_M_048.ks/index/26/text"],["SC_M_048.ks/index/28/text"],["SC_M_048.ks/index/30/text"],["SC_M_048.ks/index/32/text"],["SC_M_048.ks/index/34/text"],["SC_M_048.ks/index/36/text"],["SC_M_048.ks/index/38/text"],["SC_M_048.ks/index/40/text"],["SC_M_048.ks/index/42/text"],["SC_M_048.ks/index/44/text"],["SC_M_048.ks/index/46/text"],["SC_M_048.ks/index/48/text"],["SC_M_048.ks/index/50/text"],["SC_M_048.ks/index/52/text"],["SC_M_048.ks/index/54/text"],["SC_M_048.ks/index/56/text"],["SC_M_048.ks/index/58/text"],["SC_M_048.ks/index/61/text","SC_M_048.ks/index/63/text"],["SC_M_048.ks/index/65/text"],["SC_M_048.ks/index/67/text"],["SC_M_048.ks/index/69/text"],["SC_M_048.ks/index/71/text"],["SC_M_048.ks/index/73/text"],["SC_M_048.ks/index/75/text"],["SC_M_048.ks/index/77/text"],["SC_M_048.ks/index/79/text"],["SC_M_048.ks/index/81/text"],["SC_M_048.ks/index/83/text"],["SC_M_048.ks/index/85/text"],["SC_M_048.ks/index/87/text"],["SC_M_048.ks/index/89/text"],["SC_M_048.ks/index/91/text"],["SC_M_048.ks/index/93/text"],["SC_M_048.ks/index/95/text"],["SC_M_048.ks/index/97/text"],["SC_M_048.ks/index/99/text"],["SC_M_048.ks/index/101/text"],["SC_M_048.ks/index/103/text"],["SC_M_048.ks/index/105/text"],["SC_M_048.ks/index/107/text"],["SC_M_048.ks/index/109/text"]],"tags":[],"parameters":[[{"start":179,"end":192}],[{"start":198,"end":335}],[{"start":341,"end":366}],[{"start":382,"end":441}],[{"start":447,"end":498}],[{"start":510,"end":589}],[{"start":601,"end":675}],[{"start":689,"end":919}],[{"start":931,"end":1014}],[{"start":1026,"end":1026}],[{"start":1041,"end":1059}],[{"start":1065,"end":1088}],[{"start":1094,"end":1169}],[{"start":1183,"end":1229}],[{"start":1239,"end":1240}],[{"start":1249,"end":1278}],[{"start":1290,"end":1399}],[{"start":1411,"end":1516}],[{"start":1526,"end":1545}],[{"start":1557,"end":1628}],[{"start":1638,"end":1728}],[{"start":1740,"end":1761}],[{"start":1767,"end":1800}],[{"start":1812,"end":1954}],[{"start":1960,"end":2003}],[{"start":2017,"end":2069}],[{"start":2081,"end":2097}],[{"start":2109,"end":2157}],[{"start":2167,"end":2179}],[{"start":2192,"end":2193},{"start":2202,"end":2203}],[{"start":2213,"end":2214}],[{"start":2223,"end":2274}],[{"start":2288,"end":2328}],[{"start":2334,"end":2363}],[{"start":2441,"end":2449}],[{"start":2481,"end":2488}],[{"start":2518,"end":2521}],[{"start":2530,"end":2532}],[{"start":2538,"end":2541}],[{"start":2547,"end":2554}],[{"start":2560,"end":2571}],[{"start":2603,"end":2620}],[{"start":2646,"end":2672}],[{"start":2680,"end":2707}],[{"start":2715,"end":2721}],[{"start":2731,"end":2732}],[{"start":2742,"end":2786}],[{"start":2794,"end":2806}],[{"start":2812,"end":2836}],[{"start":2842,"end":2853}],[{"start":2861,"end":2873}],[{"start":2881,"end":2901}],[{"start":2933,"end":2937}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_048.ks","basename":"SC_M_048.ks","indexIds":{"@rもう一昨日の事だ。":0,"@r九抱山から宿に戻る頃にはすっかり陽は落ちていて、\n僕と冬夏はすぐ夕飯をとった。[l]\n帰りの道中では、\nお互いにまるで反動のように、\n極めて積極的に普通たらんとする意思が働き、\nそれはそれは痛々しい空間が構成されていたけれど、":1,"@rそれでも黙ってたり深刻になるよりはましだ。":2,"@r知狡さんは帰ってきた僕に気付いてほっとしていたようだが、\n冬夏と一緒に居たために近寄っては来なかった。":3,"@r結局冬夏は、\nこの宿に戻ってきた訳で、\nまだ、\n家に戻るつもりはない。":4,"@rそれがどういうことかということも、\n僕は努めて考えないようにしてる。[l]\nきっと、きっとなんとかなるんだと、\nそう考えてる。":5,"@rあまりの疲労と空腹に、まず夕飯を優先させたが、\n兎に角宮さんと話がしたかった。[l]\nお守り──チョーカーの事もあったから。":6,"@r夕飯後に冬夏と別れ、\n部屋に戻る振りをして宮さんの部屋へ向かうが、\n知狡さんに捕まった。[l]\n出発前にチノ嬢から聞いていた通り、\nまだばたばたしていて手が離せないという。[l]\nまずは僕等の無事に安堵してくれたが、\nチョーカーの事を伝えると一瞬困った顔をして、\nそれは宮さんに速やかに伝えると言った。[l]\nもう知っているかも知れないが、\nと、僕にはよく判らない事も言っていた。":7,"@r取り敢えずそれ以上どうすることも出来なそうだったし、\n冬夏の……ネコガミの事は宮さんにだけ話すつもりだったから、[l]\n大人しく部屋に戻った。":8,"@r":9,"暫くして、知狡さんが僕の部屋に来て、":10,"@r明日から外出をしないよう、僕に言った。":11,"@r命令、という言い方が合ってるかどうか分からないけど、\n宮さんが知狡さんに伝えるに、\n連絡を寄越すまでそれは強制という事だった。":12,"@rなので今、ずっと部屋だ。[l]\n宿の中は動けるが、\n勿論客室フロアを":13,"彷":14,"徨いても仕方ないし、\n娯楽施設も大したものはない。":15,"@r理由は全く知らされてない。[l]\n僕が、『あのこと』を報告した後ならば、\nそれで仕事の目的は或る意味でかなり進んだ事になろうから、\n或いは祭まで不用意に動くな、という意味かとも思えたが、":16,"@rあれから宮さんには全く会えていない。[l]\n繋ぎも取れない。[l]\n知狡さんとは話せるが、\nあくまで仲介の立場を崩してくれない。[l]\nあのひとに会わせてはくれなかった。":17,"@r部屋にずっと居るしかなかった。":18,"@rだから、\nお守りのチョーカーが無くなっても、\n外部刺激が極端に少なくなった現状では、\n何も変化した気がしない。":19,"@rまるであのチョーカーが、\n実際効力を発揮してたような言い方だけど、\n宮さんから貰ったものだったから、\nそれにそういうのって結構気になるものだと思う。":20,"@rそれはともかく、\n刺激が。":21,"@r誰からも連絡もない。[l]\n知人がそもそも少ない。":22,"@rこうなると、道具さんでも狩屋でも、\n話せる相手なら片っ端から話したい気分だったけれど、\nだが、あんな事の後では、\n姫様ちゃん……達には、[l]\nこちらから電話する、という選択肢は、\n僕に二の足を踏ませるに十分なものになってしまっていて、":23,"@rもしや彼女達から、とも思ったりもしつつも、\n何も無いまま時間は過ぎた。":24,"@rきぃに一度だけ電話してみたが、\n繋がらなかった。[l]\nそれきり電話はしてない。":25,"@r何か忘れている気がする。":26,"@rしかし空転……否、停止状態で何も、[l]\nどうこうしようという意欲が沸かない……":27,"@r今日は２０日、\n":28,"明":29,"後":30,"日の、\n@r……冬夏の誕生日までには、[l]\nこの状態から脱する事が叶うだろうか。":31,"@r宮さんとはいつ話が出来るだろう。[l]\nせめてそれより前には──":32,"@rそう考えながら、部屋で夕方までぼんやりしていたら、":33,"「真言さん──」":34,"「冬夏……？」":35,"「あの":36,"娘、":37,"また、":38,"母様達、また、":39,"私、なにもできな──」":40,"「え？[l]\nどうし──」":41,"下校して来たのだろう、\n部屋に現れた冬夏は、":42,"あたまをぶんぶんと横に振り、\nその場に蹲った。":43,"泣いていた、":44,"慟":45,"哭している、\n完全に自失して言葉にならない喘ぎ声を振り絞るように出し続ける冬夏、":46,"どうして良いか分からず、":47,"僕は無言のまま手を貸して、立ち上がるよう促すと、":48,"冬夏はよろよろとして、":49,"たちあがったそのときに、":50,"彼女の左眼をおおっていたそれがはずれた。":51,"そこには":52},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_048.ks","relPath":"/data/scenario/SC_M_048.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":52,"length":53,"percent":98.11320754716981},"cellInfo":[]},"/data/scenario/SC_M_049.ks":{"data":[["@r冬夏は言った。","@r冬夏说道。"],["@rこれ、\n\n道具さんのねこのチカラ。","@r这个，\n\n是道具小姐的猫之力。"],["\n\n\n\n\n──四ツトヤ、\n　　よにかまかきまず、\n　　ＣＡＴＧ、ＧＵＡＣ、ＣＭＹＫ、\n　　赤黒白青、明暗顕漠、\n　　つくれまじょのくすり──","\n\n\n\n\n──四津户屋、\n　　世间纷扰皆不顾、\n　　CATG、GUAC、CMYK、\n　　赤黑白青、明暗显漠、\n　　魔女调制的秘药──"],["\nほんとうは卑尊さんの、","\n其实是卑尊小姐的，"],["\n\n\n\n\n──三ツトヤ、\n　　みすばるよみがえれ、\n　　（ＴＴＡＧＧＧ）×∞？\n　　ＥＳ、\n　　つくれさいせいのめ──","\n\n\n\n\n──三津户谷、\n　　苏醒吧水楢、\n　　（TTAGGG）×∞？\n　　ES、\n　　创造再生之眼──"],["\nあの２人は、\n七つの中でもそういった方面を司るの。","\n那两个人，\n在七人中也掌管着那方面的力量。"],["\nでも、\n\nあの２人は、\n\nこわしたり、●●したりする方面を司る。","\n但是，\n\n那两个人，\n\n掌管着破坏和●●的方面。"],["\n\n\n\n\n──一ツトヤ、\n","\n\n\n\n\n──一津户谷、\n"],["\n──七ツトヤ、","\n──七津户谷、"],["\n大黒や玖威は、","\n大黑和玖威，"],["\n\n\n\n\n──八ツトヤ、\n","\n\n\n\n\n──八津户谷、\n"],["\n──六ツトヤ、","\n──六点夜、"],["\n玉梓は、","\n玉梓，"],["\n\n\n\n\n──五ツトヤ、","\n\n\n\n\n──五点夜、"],["\n\n三春は、","\n\n三春，"],["\n\n\n\n\n　　ふこのみにしてけっかいもるけっかい、\n　　カミシデグルリトマク、\n　　Ｅ＆Ｅ、ヒとメ、","\n\n\n\n\n　　不饮则已一饮千杯、\n　　神死轮回终焉、\n　　E＆E、阳与阴、"],["自","自"],["他","不"],["分かつちから、\n　　たもてぜったいりょういき──","分割之力，\n　　持绝对领域──"],["\nわたしね、\n\nわたしたちのいえには鉄の掟がある。","\n我呢，\n\n我们家有铁则。"],["@rそれ、……いえない、いえっ、ないよぅ、","@r那个，……不能说，没、没有啦，"],["\n冬夏は嗚咽する。\n\nわたしは自分の眼を●ったの。[l]\nそれでも、こうやって、……それが、わたしたちの、[l]\nネコガミの、","\n冬夏呜咽着。\n\n我●了自己的眼睛。[l]\n即便如此，像这样……那就是我们的，[l]\n猫神的，"],["だから、だけど、こんなチカラ、のために、","所以，但是，为了这样的力量，"],["\n\n\nごめん。","\n\n\n对不起。"],["@rいいよ、説明しなくても。","@r没关系，不用解释。"],["@r眼前にあるものを拒絶するには及ばない。[l]\n恣意的な欺瞞を信用はしないけれど、\n僕等は同じものを視てるじゃないか。[l]\n大神だってきっと、","@r不必拒绝眼前所见。[l]\n虽然不会相信任意的欺骗，\n但我们看到的不是同样的东西吗？[l]\n大神也一定，"],["\n……？",""],["@rそれは、これら視えるもの、","@r那是，这些可见之物，"],["ＣＡＴのちからのはなし、","关于CAT的力量，"],["\nｃｏＭＭａｎｄＭｅｎｔ？",""],["@r鉄の掟？","@r铁则？"],["@rトーカ？","@r冬夏？"],["@r",""],["なぜ、ないてるの？","为什么，在哭？"],["「冬夏？[l]\nなにがあった？」","「冬夏？[l]\n发生了什么？」"],["長い軟禁状態で","在长期的软禁状态下"],["半ば麻痺していた僕の思考が、\n","近乎麻痹的我的思考，\n"],["漸く動き出した。","终于开始运转。"],["いや、ま、まだ空転してる。","不、还、还在空转。"],["「冬夏、\n冬夏、大丈夫？","「冬夏、\n冬夏、没事吧？"],["こ、こっちにきて、\n落ち着こう、\nまずは」","过、过来这边、\n先冷静下来、\n总之」"],["冬夏の声がやっと現実のものとして聞こえる、\n僕は今まで一体何してた？[l]\n何を考えていた？","冬夏的声音终于作为现实传入耳中、\n我到底在干什么？[l]\n在想些什么？"],["「……ごめん、ごめんなさい、[l]\nぃえない……いまは……ごめんなさい……」","「……对不起、真的很抱歉、[l]\n说不出口……现在……对不起……」"],["「う、ああ、それならそれでいい、\nその、眼のことも僕は気にしてない、\nだからまずこっちで座って──」","「啊、嗯、那样也行、\n那个、眼睛的事我也不介意、\n所以先过来坐下──」"],["「どうしたら……いいのか……わかんない……[l]\nごめん、こんな……とこ……みせたく……ないから……[l]\nきょうは……ごめんなさい……","「该怎么做……才好……不知道……[l]\n对不起、这种……样子……不想被……看到……[l]\n今天……对不起……"],["だから、\nぜったい……誕生日に……あそこで……[l]\nあの砂浜で……」","所以、\n绝对……要在生日那天……在那里……[l]\n那片沙滩上……」"],["「わかった、約束する、\n何かあったらすぐ呼んでくれればいいから、\nだから、」","「知道了、我答应你、\n有事随时叫我就行、\n所以、」"],["「……ありが……と、[l]\nまことさん……ア……イ……」","「……谢……谢、[l]\n真言先生……爱……」"],["「……あっ……」","「……啊……」"],["──冬夏は落ちた眼帯を拾って、\n足早にこの場から立ち去った。","──冬夏捡起掉落的眼罩、\n快步离开了现场。"],["「……とうか」","「……冬夏」"],["僕は数分、其処に立ち尽くしてた。","我在原地呆立了几分钟。"],["そして、\n僕の鈍磨した精神が、ようよう空転（アイドリング）を終え、\n混乱と激しい後悔が押し寄せる。","然后、\n我迟钝的精神终于停止空转（idling）、\n混乱与强烈的后悔席卷而来。"],["「何があった……？[l]\n学校……？","「发生了什么……？[l]\n学校……？"],["アヤメ、カリヤ……[l]\nテツノオキテ……[l]\n僕は……」","阿娅梅、卡利亚……[l]\n铁之掟……[l]\n我……」"],["僕は、\nなにをしてる？","我、\n在做什么？"],["「宮さんっ！！！」","「宫小姐！！！」"],["こんな、ときに、\nなぜ、","这种、时候、\n为什么、"],["「会えないんだよっ！！！」","「见不到你啊！！！」"],["声が、","声音、"],["話が、","话语、"],["僕はもう！！！","我已经！！！"],["どうしたらっ、──、","该怎么办、──、"],["………。",""],["少し冷静になろう。","稍微冷静下吧。"],["駄目元で、知狡さんを介さずに宮さんの番号に電話してみる。","死马当活马医，绕过知狡直接打宫小姐的电话试试。"],["「………」",""],["数回呼び出し音が鳴った後、\n留守番電話サービスへの切り替えアナウンスが流れた。","几声呼叫音后、\n转入了语音信箱服务。"],["一旦切って数秒間を置いて、\nリダイヤルする。","挂断后等了几秒、\n重拨。"],["同じ声が流れる。","同样的提示音响起。"],["──もう一度だけ、\n間を置いて掛け直した。","──最后再试一次、\n隔段时间重新拨打。"],["……僕は無言で通話を切る。","……我默默挂断了通话。"],["冬夏……は今は声を掛けられないだろう。[l]\nそっとしておくことしか、できない……[l]\n僕なんかじゃ……なにも……できない……","现在……没法联系冬夏吧。[l]\n只能……让她独处……[l]\n像我这种人……什么都……做不到……"],["「みやさん……」","「宫小姐……」"],["貴女が僕を此処に連れてきた、\n貴女がいたから僕はここにいる、","是你带我来到这里的、\n因为有你在所以我才会在这里、"],["そして彼女達に会った、\nいろんなことがおきて、\nいろんなことをあなたに、\nあなたにはなさなきゃいけないのに、","然后与她们相遇了，\n发生了各种各样的事，\n有好多话想对你说，\n必须告诉你才行，"],["「なんで……はなせないんだよぉ……」","「为什么……说不出口啊……」"],["──ＹＥｒｅｃｔ",""],["「ぼくはもうおかしくなりそうだ──」","「我快要疯掉了——」"],["ああ。","啊啊。"],["今日も過ぎていく、あえないまま。","今天也这样过去，没能相见。"],["──ＹＥｌｅｃｔ",""],["──ＹＥｌｅｃｔｒｉｃｉｔｙ",""],["なぜ、僕のアイてをしてくれない、","为什么，不肯当我的爱，"],["猥が歪がＹが、","猥亵扭曲Y，"],["僕の中でこんなにも荒ぶるのに、","在我心中如此肆虐，"],["だから僕を視て、","所以看着我吧，"],["お願いだから僕を、","求求你看着我，"],["──Ｅ　Ｙ　Ｅ　Ｅ　Ｘ　Ｅ──",""]],"context":[["SC_M_049.ks/index/1/text"],["SC_M_049.ks/index/3/text"],["SC_M_049.ks/index/5/text"],["SC_M_049.ks/index/7/text"],["SC_M_049.ks/index/9/text"],["SC_M_049.ks/index/11/text"],["SC_M_049.ks/index/13/text"],["SC_M_049.ks/index/15/text"],["SC_M_049.ks/index/18/text"],["SC_M_049.ks/index/20/text"],["SC_M_049.ks/index/22/text"],["SC_M_049.ks/index/25/text"],["SC_M_049.ks/index/27/text"],["SC_M_049.ks/index/29/text"],["SC_M_049.ks/index/31/text"],["SC_M_049.ks/index/33/text"],["SC_M_049.ks/index/35/text"],["SC_M_049.ks/index/37/text"],["SC_M_049.ks/index/39/text"],["SC_M_049.ks/index/41/text"],["SC_M_049.ks/index/43/text"],["SC_M_049.ks/index/45/text"],["SC_M_049.ks/index/47/text"],["SC_M_049.ks/index/49/text"],["SC_M_049.ks/index/51/text"],["SC_M_049.ks/index/53/text"],["SC_M_049.ks/index/55/text"],["SC_M_049.ks/index/57/text"],["SC_M_049.ks/index/59/text"],["SC_M_049.ks/index/61/text"],["SC_M_049.ks/index/63/text"],["SC_M_049.ks/index/65/text"],["SC_M_049.ks/index/67/text"],["SC_M_049.ks/index/70/text"]