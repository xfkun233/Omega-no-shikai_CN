56,"end":1557}],[{"start":1566,"end":1577}],[{"start":1607,"end":1619}],[{"start":1628,"end":1629}],[{"start":1638,"end":1669}],[{"start":1682,"end":1716}],[{"start":1779,"end":1824}],[{"start":1838,"end":1945}],[{"start":1952,"end":2111}],[{"start":2118,"end":2155}],[{"start":2162,"end":2287}],[{"start":2298,"end":2309}],[{"start":2316,"end":2437}],[{"start":2444,"end":2663}],[{"start":2698,"end":2715}],[{"start":2765,"end":2801}],[{"start":2810,"end":2811}],[{"start":2820,"end":2830}],[{"start":2891,"end":3253}],[{"start":3264,"end":3417}],[{"start":3424,"end":3451}],[{"start":3462,"end":3498}],[{"start":3573,"end":3594}],[{"start":3607,"end":3608}],[{"start":3617,"end":3618}],[{"start":3627,"end":3641}],[{"start":3671,"end":3737}],[{"start":3768,"end":3833}],[{"start":3842,"end":3959}],[{"start":3989,"end":4055}],[{"start":4116,"end":4124}],[{"start":4134,"end":4135}],[{"start":4144,"end":4283}],[{"start":4308,"end":4366}],[{"start":4438,"end":4447}],[{"start":4483,"end":4562}],[{"start":4612,"end":4641}],[{"start":4702,"end":4761}],[{"start":4770,"end":4772}],[{"start":4781,"end":4783}],[{"start":4792,"end":4819}],[{"start":4858,"end":4923}],[{"start":4999,"end":5012}],[{"start":5025,"end":5026}],[{"start":5035,"end":5036}],[{"start":5045,"end":5046}],[{"start":5055,"end":5056}],[{"start":5065,"end":5066}],[{"start":5075,"end":5120}],[{"start":5154,"end":5182}],[{"start":5188,"end":5266}],[{"start":5305,"end":5319}],[{"start":5330,"end":5342}],[{"start":5353,"end":5364}],[{"start":5375,"end":5381}],[{"start":5392,"end":5401}],[{"start":5477,"end":5530}],[{"start":5561,"end":5582}],[{"start":5661,"end":5666}],[{"start":5699,"end":5704},{"start":5734,"end":5739}],[{"start":5770,"end":5780}],[{"start":5810,"end":5829}],[{"start":5855,"end":5862}],[{"start":5895,"end":5905}],[{"start":5931,"end":5945}],[{"start":5978,"end":5989}],[{"start":6018,"end":6033}],[{"start":6064,"end":6088}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_055.ks","basename":"SC_E_055.ks","indexIds":{"ちくしょーが、\nやっぱりだめだ、\n忘れられるかあんなこと！！！":0,"「いらいらいらいらいらいらするっ！」":1,"例えば、\n　":2,"何でも":3,"彼でも新しければ良いというものでもないよ。[l]\n　新機軸……という名目で打ち出される諸々のコトガラ、[l]\n　あるだろう。[l]\n　『真に新機軸』なのか、つまりそれまで全く思いも寄らなかった、[l]\n　それ以前よりもベターなものなのか、は、[l]\n　まあ、即座には判断出来ないんだろうが、[l]\n":4,"単に、今までも発案されていたものの、[l]\n　検討の上で既にいただけないモノとして廃棄されてきた案だとしたら？":5,"今まで世に出なかったのには相応の理由があるとしたら？":6,"やってみなければわからない、[l]\n　それはそうだけどね。[l]\n　先人の":7,"智":8,"慧をわざわざ軽んじる事もないかな。[l]\n　とは言え、[l]\n　時は移ろうものだからね。[l]\n　無論、以前は相応しくなかった環境が、[l]\n　今ならば合致、有用たり得るコトガラへと変化することは、[l]\n　あるだろう。":9,"いずれ愉快に掻き回す覚悟でないなら、[l]\n　検討考察は必要だろうさ。":10,"だったらどう、しろって！":11,"「アイっ！！！[l]\nいるのいないのどっちよ！？！」":12,"「っさいなあ、\n折角全員で大人しくさせたと思ったら、\nすぐこの有様かよ、\nアイもとっとと相手してやって……[l]\nんぁ？[l]\nおよ？[l]\n……居ないなぁそう言えば。[l]\nあっれー、\nいつからだ？」":13,"「ん？[l]\nああ、お嬢が落ち着いてからは、\n私も部屋に籠もってたからな……[l]\n居ないのか？」":14,"「あー、どうだろな。[l]\nそんな大仰なもンじゃないだろけどな。[l]\n姿を視てないってだけだから。[l]\nただお嬢が探してるってことぁ、\n呼び掛けの届かんトコにはいるんだろうが」":15,"「それは……場合によっては大仰にもなる話じゃないのか？」":16,"「今更餓鬼じゃあるまいし、\nあいつがどこほっつき歩こうと普通の事だろうが。[l]\n":17,"先":18,"刻も常態に視えたがな」":19,"「どうも来る前から様子は":20,"怪":21,"訝しかったが、\n……真逆なあ、[l]\n今更この":22,"時機でお嬢に愛想が尽きた訳でもあるまいし、\nいや、だが……」":23,"何故後発がそうやって『新発見』の勘違いをするのか、[l]\n　というと、[l]\n　":24,"偏に、[l]\n　失敗策や廃案はなかなか記録……否、[l]\n　記録はされるかも知れないけれどね、[l]\n　恥ずべきモノとして封印糊塗されてしまって、[l]\n　他人に開帳され難いからだ。":25,"それには他にも副作用があってね、[l]\n　要するに、[l]\n　正解に到までに通った筈の、[l]\n　膨大な失敗、ミス、試行錯誤、廃棄された別の選択などなど、[l]\n　それらが秘される事により、[l]\n　まるで一発で正解の解答に至ったように錯覚される、[l]\n　という事だ。":26,"まあ、今言ったようなのは、[l]\n　ある著名人の受け売りだけどね。":27,"この星は奇跡の惑星とか、よく言うだろう。[l]\n　こんな条件、確率、都合のいいのはそうそう無いのだろう。[l]\n　無いのだろうが、[l]\n　都合の悪かった所に発生した生命が『当たり』たるこの惑星を[l]\n　いいなあ、と":28,"羨む訳ではないだろう。":29,"だって当たりではなかった場合は、[l]\n　そう考える主体も存在しないのだからね。[l]\n　当たりたる環境に発生したのは逆に当然でもあって、[l]\n　当たりだから、当たりなんだよ。[l]\n　ふふ、ややこしいがね。":30,"当たりの環境に成るために、[l]\n　数々の条件を次々クリアしたような錯覚、[l]\n　あらゆる試練を突破したような被選択的優越感、[l]\n　精子の受精の話であるとか、[l]\n　ある種の詭弁だと僕は思うが──[l]\n　『外れていたかもしれない存在』があるという前提での考え方だろうからね、[l]\n　要するに、[l]\n　普通の事を普通でなく思わせる為の、[l]\n　つまり、詭弁さ。":31,"それでボクのはどうだっていうの、\n":32,"「いねーの？！[l]\nいんの？！[l]\nどっちだろーと即":33,"返":34,"事しろっての！！！」":35,"起きてしまった時点でその事象単体においては確率は１０割だろう。[l]\n　籤の個数と引く人数が同数で、ハズレ無しなら、[l]\n　かならずその一回で当たりは出るよね。[l]\n　『被抽選者それぞれに人格があって、[l]\n　その中で己が当たりになる確率』は、[l]\n　あるだろうし低いのだろうがね。[l]\n　レアを落とす確率を上げる為に、[l]\n　効率プレイに走る気持ちも充分に……ああ、[l]\n　それは別の話だけど。[l]\n　[l]\n　まあ、とは言え、[l]\n　勿論全員が被抽選者で無い場合も、空籤がある場合もあるからね、[l]\n　その場合は抽選は一回一回行われるから\n　当たりが出ない時も当然ある。[l]\n　ただ、\n":36,"空籤アリ、の場合でも、人格がなければ元より無いのと一緒だし、[l]\n　被抽選者としての、個としての主体の話ならば、[l]\n　選ばれたり、[l]\n　当たりに当該する確率は確かに低いものとして存在するし、[l]\n　結局皆それに一喜一憂するというのも理解しないではないのだけどね。":37,"そういった意味で、呼び水たる月の雫というのは、[l]\n":38,"んむ？[l]\n　話が見事に逸れたな。[l]\n　えーと……":39,"「あんだよ、ほんとに居ないぽいな。[l]\n":40,"化":41,"粧":42,"室……って訳でもないよな？」":43,"「さあ、どうだろうな。[l]\nこのところの変調が体調からのものならば、\n籠もってる可能性はあるが──調べてくるか？」":44,"「まあ、そこまでは……いーんじゃないか、あとで。[l]\nお嬢が鎮まってくれさえすりゃ──\nつーかいい加減、マジでお":45,"守りに疲れたんじゃないのか。[l]\n先刻の宥め賺し作業がトドメだったりしてな。[l]\nんで案外、ここにきて堪忍袋の緒が切れたとかよ……[l]\nま、[l]\n逆にそっとしといてやんのがいーんじゃねーのかな」":46,"「……あれがそんなふうなつくりとは思えんが……[l]\nまあ、そうだな……[l]\n変調を来してはいたようだからな……」":47,"定番には定番たる":48,"所":49,"以がある。[l]\n　相対的──つまり他者という基準ありきの、[l]\n　単なる逸脱、個性の履き違えは論外としても、[l]\n　かといって記号をその意味でなく形象でのみなぞるのもまた、[l]\n　同等に冴えないがね。[l]\n　だから、[l]\n　":50,"彼でも、[l]\n　新しければ良いというものでもないのさ。[l]\n　あ、品質状態としてのそれは別だよ。":51,"「んなんだ！！！」":52,"ボクのIgは！[l]\n失敗した前の遣り方を教訓に、[l]\n改めて良しとされた冴えた遣り方じゃないのか！[l]\n書式が違ったくらいで、\n":53,"「んでだ！！！[l]\nあんなカビの生えた旧来の、」":54,"ただまあ、量産型の完成度とは別にね、[l]\n　プロトタイプとしての、[l]\n　ピーキーでありながら且つ":55,"融通":56,"のき":57,"きやすさと言うのも、[l]\n　時には有用で、\n":58,"遣い手にもＣＡＴにも──こっちにも向こうにも──過度の負担を与える事無く、\narchivingに特化したボクのテトなら、\n":59,"「ちくしょう！！！[l]\n":60,"魔":61,"眼":62,"の":63,"刺":64,"し":65,"手なんか！！！[l]\n単なるハカいしぃだろぉが！！！[l]\ngest──」":66,"いやだ！！！[l]\nいやだいやだい・や・だ！！！":67,"昔言われた事なんか、[l]\n何でいまごろ、[l]\n思い出したくもないのに、[l]\nいわれたときはなんともおもわなかったのに、[l]\n":68,"Scaning Error\n":69,"フォーマットが違います\n":70,"処理を実行出来ません\n":71,"できません\n":72,"はじめからやりな\n":73,"「出掛けるっ！！！[l]\nアイはみつけたら叱る！！！[l]\nすぐ帰るから心配無用っ！！！」":74,"「あ？[l]\nあー、おい、ちょ、」":75,"だん！！！":76,"「………」":77,"「……いいんかな？」":78,"「……上に報告だけでもすべきかな……」":79,"とぅるるるる。":80,"「お、噂をすればだ」":81,"とぅるるる、\nピッ。":82,"「はい、あんでしょか」":83,"「Ironは居ますか其処に？」":84,"「あー、その事でちょっとごたごたありまして──」":85},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_055.ks","relPath":"/data/scenario/SC_E_055.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":84,"length":86,"percent":97.67441860465115},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[12,1]},"/data/scenario/SC_E_056.ks":{"data":[["──すべてはさいこうで\n","——一切都是最棒的\n"],["……きー、","……叽——、"],["八",""],["倍、[l]やばい……とまんない……","倍、[l]糟了……停不下来……"],["──あのひととひとつになる\n","——和那个人合为一体\n"],["んっ……","嗯……"],["ふ、[l]ふぁあ、[l]くふん！","呼、[l]哈啊、[l]嗯哼！"],["いっ、[l]……いた…っ","噫、[l]……好痛…"],["くっ……[l]ふはふっ、[l]いやぁ…っ","呜……[l]哈啊哈、[l]不要啊…"],["だ、[l]めっ……！","不、[l]行了……！"],["──いっしょになりたい、\n","——想要合二为一、\n"],["いたいイタイ痛い痛い、[l]痛いっ\n","好痛好痛好痛好痛、[l]痛啊\n"],["声、[l]が、[l]でちゃう……っ、[l]だ、[l]め、[l]っ……[l]！[l]\nいっ、[l]つくぅっ\n","声音、[l]要、[l]漏出来了……、[l]不、[l]行、[l]……[l]！[l]\n噫、[l]去了呜\n"],["──もう限界、はやくいきたい、\n","——已经到极限了、想要快点去、\n"],["だめだよ……だめ、[l]だよお、[l]きーちゃ、","不行啦……不行、[l]真的不行、[l]小姬、"],["──●●●\n",""],["「（……ぁ、[l]はぁ、[l]はぁ、[l]はぁ、[l]っん、[l]\nはぁ………[l]はぁ………[l]は……[l]ぁ……）」","「（……啊、[l]哈啊、[l]哈啊、[l]哈啊、[l]嗯、[l]\n哈啊………[l]哈啊………[l]哈……[l]啊……）」"],["あ、[l]\nなんか、[l]\n","啊、[l]\n总觉得、[l]\n"],["ワかった、[l]かんじ、\n","好舒服、[l]的感觉、\n"],["きーちゃ、[l]これで、[l]いいのね？","小姬、[l]这样、[l]就可以了吧？"],["えんりょ、[l]も、[l]いらないの？","不用、[l]再、[l]忍耐了吗？"],["──私達は　み　ん　な　あのひとのものだから\n","──我们都是　那　个　人　的　所　有　物\n"],["──みんなで……たすく……","──大家一起……互相拯救……"],["「……すー………[l]くー………」","「……呼………[l]嘘………」"]],"context":[["SC_E_056.ks/index/1/text"],["SC_E_056.ks/index/4/text"],["SC_E_056.ks/index/6/text"],["SC_E_056.ks/index/8/text"],["SC_E_056.ks/index/10/text"],["SC_E_056.ks/index/13/text"],["SC_E_056.ks/index/15/text"],["SC_E_056.ks/index/17/text"],["SC_E_056.ks/index/19/text"],["SC_E_056.ks/index/21/text"],["SC_E_056.ks/index/23/text"],["SC_E_056.ks/index/26/text"],["SC_E_056.ks/index/29/text"],["SC_E_056.ks/index/32/text"],["SC_E_056.ks/index/35/text"],["SC_E_056.ks/index/37/text"],["SC_E_056.ks/index/40/text"],["SC_E_056.ks/index/42/text"],["SC_E_056.ks/index/45/text"],["SC_E_056.ks/index/48/text"],["SC_E_056.ks/index/50/text"],["SC_E_056.ks/index/52/text"],["SC_E_056.ks/index/55/text"],["SC_E_056.ks/index/57/text"]],"tags":[],"parameters":[[{"start":141,"end":153}],[{"start":163,"end":168}],[{"start":183,"end":184}],[{"start":194,"end":211}],[{"start":217,"end":231}],[{"start":241,"end":245}],[{"start":251,"end":267}],[{"start":273,"end":285}],[{"start":291,"end":311}],[{"start":317,"end":327}],[{"start":333,"end":346}],[{"start":356,"end":374}],[{"start":384,"end":441}],[{"start":451,"end":467}],[{"start":477,"end":501}],[{"start":507,"end":513}],[{"start":573,"end":638}],[{"start":674,"end":692}],[{"start":702,"end":715}],[{"start":725,"end":745}],[{"start":751,"end":770}],[{"start":776,"end":799}],[{"start":809,"end":822}],[{"start":869,"end":886}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_056.ks","basename":"SC_E_056.ks","indexIds":{"──すべてはさいこうで\n":0,"……きー、":1,"八":2,"倍、[l]やばい……とまんない……":3,"──あのひととひとつになる\n":4,"んっ……":5,"ふ、[l]ふぁあ、[l]くふん！":6,"いっ、[l]……いた…っ":7,"くっ……[l]ふはふっ、[l]いやぁ…っ":8,"だ、[l]めっ……！":9,"──いっしょになりたい、\n":10,"いたいイタイ痛い痛い、[l]痛いっ\n":11,"声、[l]が、[l]でちゃう……っ、[l]だ、[l]め、[l]っ……[l]！[l]\nいっ、[l]つくぅっ\n":12,"──もう限界、はやくいきたい、\n":13,"だめだよ……だめ、[l]だよお、[l]きーちゃ、":14,"──●●●\n":15,"「（……ぁ、[l]はぁ、[l]はぁ、[l]はぁ、[l]っん、[l]\nはぁ………[l]はぁ………[l]は……[l]ぁ……）」":16,"あ、[l]\nなんか、[l]\n":17,"ワかった、[l]かんじ、\n":18,"きーちゃ、[l]これで、[l]いいのね？":19,"えんりょ、[l]も、[l]いらないの？":20,"──私達は　み　ん　な　あのひとのものだから\n":21,"──みんなで……たすく……":22,"「……すー………[l]くー………」":23},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_056.ks","relPath":"/data/scenario/SC_E_056.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":22,"length":24,"percent":91.66666666666666},"cellInfo":[]},"/data/scenario/SC_E_057.ks":{"data":[["……ごきげんよう、[l]\n001:GMナンバー。[l]\nそれとそのＣＡＴ。","……贵安、[l]\n001:GM编号。[l]\n以及其CAT。"],["「済みませんね、わざわざ呼び立ててしまって。[l]\nあの方には疎まれてますから、\nみだりにうごくは慎まなければならず、\nお手間を取らせてしまいました。[l]\n……","「真抱歉呢，特意把您叫来。[l]\n因为那位大人很讨厌我、\n必须谨言慎行、\n给您添麻烦了。[l]\n……"],["直","直"],["接会うのは何時振りでしたか」","接见面是时隔多久了呢」"],["どうだったでしょうか。[l]\n時の意義は忘れて久しいかも──知れません。[l]\n私も未だ道半ば、未熟者ですけれど。[l]\nそれより何の──御用でしょうか。","感觉如何呢。[l]\n或许早已忘记时间的意义──也说不定。[l]\n虽然我也仍在半途，尚不成熟。[l]\n比起这个有何──贵干呢。"],["「あの方の仕切りはどうです？[l]\n初めから、\n","「那位大人的安排如何？[l]\n从一开始、\n"],["熟れていないが故の稚拙さをも、\n無作為さへと転換しようという──\n突発的","就将因不成熟导致的拙劣、\n转化为随机性──\n突"],["予想外事象を愉しもうという趣向だったとは言え、\n","发意外事件来取乐的构思虽好、\n"],["端から視ていて、\n矢張り大変に心許なく視ていられない──\nといったようなことはありませんか。[l]\nええ、\n私はあの方を","但旁观时、\n果然还是令人不安到看不下去──\n您没有这样的感觉吗。[l]\n是的、\n我想为那位大人"],["補","提"],["助して差し上げたい。[l]\nあの方を愉しませたいのですよ」","供协助。[l]\n想让那位大人享受乐趣啊」"],["……当人に断り無き手助けは時に、[l]\n","……未经本人同意的帮助有时、[l]\n"],["矜","会伤"],["恃を傷付けるのではありませんか。[l]\n特にあの方はそう言った事に、\n……いえ、どうでしたかね……[l]\nそもそも左様な基準などお持ちでなかったでしたか……","及自尊不是吗。[l]\n尤其那位大人对这种行为、\n……不，您觉得呢……[l]\n说到底她本就没有这类准则吧……"],["「そうですね、\n私が疎まれているのは確かですから、\nそちらの基準に当て嵌められて叱責はされるかも知れませんね。[l]\nですから、あの方に気取られぬよう、\nあの方の思考の上から裏から、\n事を進める要がある」","「确实呢、\n我被她厌恶是事实、\n或许会因不符合标准而受她斥责。[l]\n所以必须在不惊动她的前提下、\n从她思维的表面与背面、\n推进计划」"],["そうやって何時も隠密裡に事をなそうとするから、\nあの方も貴女を疎むんではないでしょうか。[l]\nそれとも、","正因为总是这样暗中行事、\n那位大人才会讨厌您吧。[l]\n还是说、"],["「案じてくれるのは嬉しいですよ。[l]\nでもこれが私の──アイのかたちです」","「您的关心让我很开心。[l]\n但这就是我的──爱的形态」"],["……本意なのですか、[l]\n貴女のその在り方は、\nまるで尻拭い、\n否、自己●●……[l]\n誰が得を、するというのです。[l]\n誰が悦ぶと、","……这是真心话吗、[l]\n您这样的存在方式、\n简直像在擦屁股、\n不，自我●●……[l]\n究竟谁能、从中获益。[l]\n谁会感到、高兴、"],["「ああ……[l]\n貴女のあれに対する忠誠心とはその根が、\n違いましたね。[l]\nまあ──そこは今は置いておきましょう。[l]\n語るべきでないものもあります」","「啊啊……[l]\n你对那件事的忠诚心根源，\n是不同的呢。[l]\n嘛──这点暂且不提。[l]\n也有些不该说的事」"],["……私の……[l]\n違う……？","……我的……[l]\n不同……？"],["「もう解っているのでしょう。[l]\nでも、まだ、そのままで結構です。[l]\n先がまだ浮動なのですよ」","「你应该已经明白了。[l]\n不过，保持现状就好。[l]\n前方还存在变数哦」"],["……ああ、[l]\nあの……すみません……[l]\n目眩が、します。","……啊啊，[l]\n那个……抱歉……[l]\n有点，头晕。"],["「構いませんよ、どうぞ、楽にしてください」","「没关系，请放轻松」"],["………。[l]\nあの方を、\n●●●なのですか？","………。[l]\n那位大人，\n是●●●吗？"],["「ああ、……そうかも知れません。[l]\nいえ、私はあの方を愛しているのですけど。[l]\n今この場でどう繕おうと詮無い事ですが、\n紛う事なき事実ですよ。[l]\nＸの●●とでも言いましょうか……[l]\nアイする事とアイガンすることは似て非なるものですからね。[l]\n私はエゴなアイで対象を歪ませ堕落させるどこぞの阿呆のような事をしたいわけではない。[l]\n自分への慰めや自己満足や愛情の押付で服を着せたいわけでもない。[l]\nアイするとは互いを高め合いたいとおもうこと、\n心を鬼にすることこそが肝要なのです」","「啊啊……或许是吧。[l]\n不，我是爱着那位大人的。[l]\n虽然现在粉饰也无济于事，\n但这是毋庸置疑的事实哦。[l]\n说是X的●●也不为过……[l]\n因为爱与爱慕看似相近实则不同。[l]\n我不想做那种用自私的爱扭曲对象、使其堕落的蠢事。[l]\n也不想用自我安慰或强加的爱意来粉饰。[l]\n所谓爱是想要互相提升，\n关键时刻必须狠下心来」"],["そしてその為に、\n無関係なモノをも巻き込み乍らですか？","而为此，\n就要牵连无关之人吗？"],["お嬢のあの荒れようを視ましたか？","看到小姐那副狂乱模样了吗？"],["いえ、矛盾しています、\n001:GMナンバー、\n貴女が愛してるのは、\nその対象とは、","不，这很矛盾，\n001:GM编号，\n你所爱的，\n那个对象，"],["「愛憎とは紙一重、\nいえ、表裏一体……巧く言えませんね、[l]\n●●ですよ、ダーカ」","「爱恨只在一线之间，\n不，是表里一体……很难形容呢，[l]\n是●●啊，达尔卡」"],["……何故その名で呼ぶのです。","……为何用那个名字称呼我。"],["「ああ、失礼」","「啊啊，失礼」"],["いえ、\n……いえ、ああ、それも、これも、[l]\n要するに、\n執着、","不，\n……不，啊啊，那些，这些，[l]\n说到底，\n都是执念，"],["「そう、ですね。[l]\nスキもキライも、\nいずれも在る一つ事に対して関心をって向き合っているのですから\n同じことです。[l]\n愛でるも蔑むも、\n興味があればこそ。[l]\n興味の無い対象は憎むことも──まさに、その価値すらも無い、\nという事ですから。[l]\nなので、あの方にとって私がどうあるのか、\nその逆もまた、\n相手にされてるだけ今の私にとっては意味のあることですよ」","「没错呢。[l]\n喜欢也好讨厌也罢，\n都是对同一事物投注的关注\n本质相同。[l]\n珍视或蔑视，\n皆因有兴趣使然。[l]\n对无兴趣的对象连憎恶都──根本不值得，\n就是这么回事。[l]\n所以那位大人如何看待我，\n反之亦然，\n能被在意对现在的我而言就有意义」"],["それは──そうかも知れませんが、\n貴女の意思とは、","或许──是这样，\n但你的意愿，"],["真","真"],["心とは、矛盾して──","与内心存在矛盾──"],["「矛盾というものは本来的に存在しない、\n存在したならした時点で、\n矛盾はないのです、\nヒトのつくった構造論理にそぐわぬだけのこと。[l]\n『思考』の中でのみ矛盾は存在するし、\nつまりは『コトバ』という","「矛盾本就不存在，\n若认为存在，\n便无矛盾，\n只是不符合人类建构的逻辑。[l]\n唯有在『思考』中矛盾才存在，\n也就是『语言』这类"],["道","道"],["具の副産物。[l]\n私やそれを取り巻くもの、ヒトの意思持つモノで在る以上──\n言で伝えるには限界がある。[l]\n不確定性や量子論のように曖昧さや確率論でしか語れないものは\nありますが、\nそれにしたところで我々或いは全生命がそれらを識っていなければ、\n存在していけない道理でもありません。[l]\n私達は自分がどんなモノか分からずとも生まれ、生き、死んで行く。[l]\n気がつけば、\nただ、\n生まれ、在るだけ。[l]\n我々は発明も発見も主体視座次第のモノだと気付き難い、\n自分以外の視界が在るとは想像し難い」","器具的副产品。[l]\n既然我和围绕它的事物、拥有人类意志的存在──\n用言语传达是有极限的。[l]\n就像不确定性和量子论那样只能用模糊性和概率论来描述的事物\n确实存在，\n但即便如此，若我们或所有生命体都无法认知它们，\n也没有道理就无法存在。[l]\n我们即使不明白自己是什么也会出生、生存、死去。[l]\n回过神来时，\n仅仅只是，\n诞生，存在着。[l]\n我们很难意识到发明和发现都取决于主体视角，\n难以想象自己以外的视野存在」"],["その在り方に一石を投じて波紋を呼んだのが、\nかつての……月の雫と、[l]\nきいて──いますが。","对这种存在方式投下石子激起涟漪的，\n是曾经的……月之泪与，[l]\n听说──是这样。"],["「私はまだその頃存在すらしていないですから、\n伝え聞く程度の事しか知りませんがね。[l]\nとは言え当時からの者は最早我等の中にもほんの一握り、\nあの方々すらも私とそう違わないですし──\nまあそれはいいでしょう。","「我那时甚至还不存在，\n所以只知道些传闻程度的事罢了。[l]\n话虽如此，从那时留存至今的人在我们之中也屈指可数，\n就连那些大人物和我也没多大差别──\n嘛这暂且不提。"],["コトバが、書き記され定着したもの、書。[l]\n文字という絵、図形によって魔方陣は描かれて、\nコトバを口に、呪文を唱える事による","语言，被书写固定的东西，书。[l]\n用名为文字的图画、图形描绘出魔法阵，\n将语言诉诸于口，通过吟唱咒文"],["媒","媒"],["質の振動、\nそれら全てが内包された呪術、","质的振动，\n这些全部包含在内的咒术，"],["つまりは歌。","也就是歌。"],["我々は","我们是"],["書","书"],["画","画"],["物の蒐集者であり、\n詠み手即ち、\n歌い手奏者でもある。[l]\nみ、くいつなぎかきくわえよみうたうものたちその、わ──」","物的收集者，\n咏唱者亦即，\n歌者与奏者。[l]\n看、咬衔连接吟咏歌唱之物其、我──」"],["……それが、一体、何だというのです、今更、[l]\n何が、\n何をお話したいのですか、\nわざわざ私を喚んだ理由はなんです、","……那、到底、算什么啊，事到如今，[l]\n什么、\n你想说什么，\n特意叫我来是为什么，"],["001:GMナンバー……！","001:GM编号……！"],["「貴女のその苛立ち──落ち着かぬ心根の原因を教えましょう」","「你那焦躁──让我告诉你心神不宁的根源吧」"],["………？",""],["「",""],["遊","妓"],["戯は──\n","把戏──\n"],["嵩を増やす為やその実働時間を延ばしたいがため、\n運営主催側による枷をはめる遣り方があります。[l]\n本来はゼロでしかないのに、\nマイナスからスタートさせることによってプラスと思わせる、\nギャップを利用した錯誤を恣意的に与える事による、\n言わば冴えているようでその実──ああ、\n誤解無きよう言っておきますが、\nそれ自体その程度の事は誰しもが、\n少なからずしている事でしょうし一見楽でもありましょう、\n特に、飽く迄『余暇の娯楽』でしかないものに、\n真摯に向き合う──いえ、\n過剰な入れ込みをなす態度は必ずしも讃えられる事ではなく、\nその人数も少ないことでしょう。[l]\n当然乍ら其処には価値観美意識の差異が横たわり、\nそれぞれの立ち位置による意図は互いに通じる方が希有です。[l]\nですから、\n各々が弁えていさえすれば、\n間に問題が生じなければ、\n互いに理解し合う必要などないのですが、\nただ、我々は●●●●●●●」","为了增加规模或延长实际运行时间，\n有运营方主动施加枷锁的做法。[l]\n本应只是零，\n却通过从负数开始让人误以为是正数，\n刻意利用认知偏差制造错觉，\n看似聪明实则──啊啊，\n为避免误会先说清楚，\n这种事本身谁都多少\n会做点吧看起来也轻松，\n尤其对终究只是『闲暇娱乐』的东西，\n认真对待──不，\n过度投入的态度未必值得称赞，\n这么做的人也少。[l]\n当然其中横亘着价值观审美观的差异，\n各自立场导致的意图很少能相互理解。[l]\n所以，\n只要各自心里有数，\n只要不产生问题，\n本不需要互相理解，\n只是，我们是●●●●●●●」"],["だから、貴女は、一体何を言いたい、何を言って、","所以，你到底想说什么，在说什么，"],["………、",""],["………なんだ？","………什么？"],["きこえない──","听不见──"],["「あの方の言ですから知っているでしょう。[l]\nゲームにはその経緯とモチベーションから２種類あるという、」","「既然是那位大人的话你应该知道吧。[l]\n游戏根据其缘由和动机分为两种，」"],["そう、単純な遊戯たる『●●』をするにも、\n　●と、オワレル者が必要だ。","没错，即便是进行名为『●●』的简单游戏，\n　也需要●与被支配者。"],["「私はGMです。[l]\n『娯楽遊戯に","「我是GM。[l]\n负责创造并主持"],["して勝負競技』を造りあげ、\n取り仕切るのが役。[l]\nですから──」","『娱乐游戏与竞技对决』\n这就是我的职责。[l]\n所以──」"],["……わ、たしになにを、しろと、","……要、要我、做、什么、"],["「まず伝えましょう。[l]\n姉妹に外れたあの、\n貴女の大切な『ガロー・ツェロ・ルー』、\nエンドルがしっかりと保護していましたよ。[l]\n詳しき事は後で教えましょう。[l]\n先に、\n貴女には貴女の、","「首先告诉你吧。[l]\n那个脱离姐妹的、\n你珍视的『嘉洛・塞萝・露』、\nEnder已经妥善保护起来了。[l]\n详情容后再禀。[l]\n现在、\n你有你自己的、"],["怨ずるコトがある」","怨恨要解决」"],["……？",""],["ルー……？[l]\nツェロル？","露……？[l]\n赛萝洛？"],["あのこが、","那个孩子、"],["まさか、そんな、それに、","怎么可能、那样的事、而且、"],["エンドル……まで……？","连Ender……都……？"],["「強制改宗は解かれます──\n真の名と共に思い出されよ、\n『ダーカ・イァンナ・ルー』、\nLunati","「强制改宗即将解除──\n与真名一同觉醒吧、\n『达卡・伊安娜・洛』、\nLunati"],["c=Leapの八人姉妹がひとり。[l]\n貴女の朋は、[l]\nｖ☆、","c=Leap的八姐妹之一。[l]\n你的朋友是、[l]\nv☆、"],["墜とされし星、[l]\n装甲板にして拘束具を纏い、[l]\nそのカタキをもって姫を守る","陨落之星、[l]\n身披装甲亦是枷锁、[l]\n以仇敌之血守护公主"],["愧","愧"],["死の五芒星は","死亡五芒星化作"],["巨いなる箒にして、[l]\n大いなる","巨大扫帚、[l]\n引领"],["蜂","蜂群"],["起の","崛起"],["魁。[l]\n蒼白き","之魁。[l]\n卸下苍白的"],["軛を外し深紅のコウシンを、\n長姉ミリアムとケルベ＝ロアは待っています、\nLunatic=Leap、そのサイコウのための──」","轭锁深红之狂信、\n长姐米莉安姆与凯尔贝＝萝亚正在等待、\nLunatic=Leap，为了那至高时刻──」"],["ばかな、\nわたし、\nなぜ、","荒唐、\n我、\n为什么、"],["「──それが貴女のヤクです」","「──这就是你的使命」"],["なんて、こと、","开什么、玩笑、"],["………。",""],["あなたが、","原来你、"],["……………のですね？","……………就是？"],["「落ち着くまでは、暫し間があるでしょうから──\n詳細は追って伝えましょう。[l]\nそれに、そうですね、\n今はまだ伏せておいで。[l]\n然るべき時が来るまでは。[l]\nそして、\n然るべ","「在冷静下来前还有些时间──\n具体事宜稍后传达。[l]\n另外、是啊、\n现在还请继续蛰伏。[l]\n直到时机成熟之日。[l]\n然后、\n当命定"],["きその日が来たら、\nその時は」","之日来临、\n那时」"],["Enderをその名の相応しきアリカタに[l]\n\n\n　　四重奏団を本来の姿に[l]\n\n\n　　シのジュウに装弾を[l]\n\n\n　　ねがえれば──","让Ender回归名号应有的姿态[l]\n\n\n　　使四重奏团重归本源[l]\n\n\n　　为死之枪填装子弹[l]\n\n\n　　若能实现──"],["「……●い、だと──？」","「……●饭，是说──？」"],["目眩に襲われながら、\nわたしがそう言うと、","在眩晕侵袭的同时，\n当我这么说时，"],["彼女と彼女のＣＡＴは、","她与她的CAT，"],["ああ、","啊啊，"],["その口角をゆっくりと引き上げて、","那嘴角缓缓上扬，"],["ワ──","哇──"]],"context":[["SC_E_057.ks/index/1/text"],["SC_E_057.ks/index/3/text"],["SC_E_057.ks/index/5/text"],["SC_E_057.ks/index/7/text"],["SC_E_057.ks/index/9/text"],["SC_E_057.ks/index/11/text"],["SC_E_057.ks/index/14/text"],["SC_E_057.ks/index/16/text"],["SC_E_057.ks/index/19/text"],["SC_E_057.ks/index/21/text"],["SC_E_057.ks/index/23/text"],["SC_E_057.ks/index/25/text"],["SC_E_057.ks/index/28/text"],["SC_E_057.ks/index/30/text"],["SC_E_057.ks/index/32/text"],["SC_E_057.ks/index/34/text"],["SC_E_057.ks/i