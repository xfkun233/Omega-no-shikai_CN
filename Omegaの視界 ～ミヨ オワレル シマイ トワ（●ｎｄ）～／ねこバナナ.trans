":8883,"end":8884}],[{"start":8894,"end":8895}],[{"start":8904,"end":9032}],[{"start":9058,"end":9090}],[{"start":9096,"end":9514}],[{"start":9520,"end":9530}],[{"start":9563,"end":9661}],[{"start":9687,"end":9723}],[{"start":9729,"end":9733}],[{"start":9743,"end":9804}],[{"start":9833,"end":9951}],[{"start":9977,"end":10019}],[{"start":10048,"end":10132}],[{"start":10196,"end":10202}],[{"start":10228,"end":10239}],[{"start":10255,"end":10287}],[{"start":10308,"end":10472}],[{"start":10501,"end":10594}],[{"start":10620,"end":10817}],[{"start":10847,"end":11006}],[{"start":11035,"end":11087}],[{"start":11117,"end":11260}],[{"start":11286,"end":11329}],[{"start":11335,"end":11370}],[{"start":11376,"end":11405}],[{"start":11434,"end":11652}],[{"start":11661,"end":11662}],[{"start":11671,"end":11782}],[{"start":11808,"end":11833}],[{"start":11839,"end":11853}],[{"start":11883,"end":12023}],[{"start":12052,"end":12093}],[{"start":12119,"end":12297}],[{"start":12327,"end":12414}],[{"start":12443,"end":12457}],[{"start":12487,"end":12503}],[{"start":12529,"end":12575}],[{"start":12581,"end":12666}],[{"start":12672,"end":12752}],[{"start":12782,"end":12853}],[{"start":12882,"end":12960}],[{"start":12994,"end":13020}],[{"start":13065,"end":13095}],[{"start":13124,"end":13198}],[{"start":13224,"end":13351}],[{"start":13357,"end":13368}],[{"start":13378,"end":13419}],[{"start":13425,"end":13458}],[{"start":13464,"end":13569}],[{"start":13575,"end":13642}],[{"start":13648,"end":13712}],[{"start":13723,"end":13760}],[{"start":13766,"end":13845}],[{"start":13855,"end":13877}],[{"start":13932,"end":13980}],[{"start":14010,"end":14081}],[{"start":14111,"end":14121}],[{"start":14174,"end":14264}],[{"start":14270,"end":14305}],[{"start":14311,"end":14411}],[{"start":14440,"end":14554}],[{"start":14584,"end":14595}],[{"start":14624,"end":14828}],[{"start":14881,"end":14887}],[{"start":14944,"end":14983}],[{"start":15017,"end":15057}],[{"start":15063,"end":15108}],[{"start":15118,"end":15200}],[{"start":15206,"end":15209}],[{"start":15219,"end":15366}],[{"start":15380,"end":15381}],[{"start":15391,"end":15402}],[{"start":15408,"end":15413}],[{"start":15445,"end":15530}],[{"start":15602,"end":15607}],[{"start":15654,"end":15673}],[{"start":15679,"end":15704}],[{"start":15734,"end":15808}],[{"start":15838,"end":15874}],[{"start":15904,"end":15926}],[{"start":15952,"end":15968}],[{"start":15974,"end":16045}],[{"start":16055,"end":16077}],[{"start":16083,"end":16088}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_033.ks","basename":"SC_S_033.ks","indexIds":{"遅れた新幹線から列車乗り継ぎ終えて、\n玄ノ森駅に着いた頃にゃ結局、\nとうに銀行の窓口業務は終了している時間。":0,"まだ真っ暗でこそ無いが、\nちんたらしてたら速攻で闇に包まれるだろう。[l]\n何しろ、":1,"「街灯も":2,"疎ら、\n店もろくすっぽねーんだな……[l]\n駅前ですらこんなか……」":3,"向こうから来たばっかだから相対的な感覚だろうけど。":4,"「えと、確か中心街は寧ろ、\n駅前から離れた別の通りに、\nなるそうデス」":5,"「成る程ね。[l]\nまー別に観光しに来た訳じゃないし、\nとっとと動きましょか」":6,"と言っても……[l]\n足の確保はせにゃあ、\n闇雲に動いたって詮方ない。[l]\n迂闊にかれおんのあれを使うのは危険にすぎるし、\n俺自身をモロに出すのも厳しい。":7,"あんだかな、\n予定通りに着いてさえいれば、\nおよそのアタリから何とか出来る時間もあっただろうが、":8,"──ん、\nなんだ。[l]\n居るな。":9,"これは、":10,"「……おや、[l]\n向こうさんの方からお出迎え……か？[l]\n気付かれてたんかな？」":11,"「ハイ？[l]\n……っあおっ！」":12,"「おや。[l]\nこれは奇遇……いや、[l]\nそれ以前の問題でしょうか。[l]\n……いえ、正直、[l]\nどちらでもいいんですがね。[l]\n久しぶり、カレ」":13,"「あ、あわ、あの、す、す、」":14,"「……どうも、お初にお眼にかかります。[l]\nこの":15,"女":16,"性の彼氏やらしてもらってます、\n大神っていうモンですが」":17,"思ったより小さいな実物は。[l]\nというかコスプレかこれ。[l]\n中央とか大都市ならまだしも、\nちーっとばかし、浮いてないか。[l]\nそれともそのへんも防壁か何か張ってるのかな、\nよもや踏み絵的な意味合い……否、[l]\nそれぁ考えすぎだぁな。[l]\nそれに声が何というか、\nなんつーの？":18,"所":19,"謂声優くさいつーか？":20,"と、\n俺の印象批評……言葉合ってるかはさておき、[l]\nその心の内を知ってか知らずか\n眼前の女性、蒼白穿の遣い手にして、\nかれおんの直上らしき女性は、挨拶を返してきた。":21,"「ああ、……アナタが。[l]\nこれはまた──いえ、\n申し訳ありません、挨拶が遅れました。[l]\n伺っております、\nどうぞ宜しく。[l]\n千野チノがワタシの名前です」":22,"「いえいえ、お気になさらずこちらこそ、\n話は聞いてますし、\nえー、その、\nそちらも色々御存知のようですし？[l]\n流石は、そっちの方はお強い──という事で宜しいか？」":23,"俺としては悪意も敵意も無いが、\n向こうも、今この瞬間そうだとは限らねー。[l]\n前情報やらその他諸々から総合的に、\n恐らくは問題無いだろうと判断してるのと、\nまあ結局は、\n隠しても無駄だからこうしてるだけで……ああ、[l]\nまあ、腹芸は使いまくってる訳だが、\n何にせよ意思は伝えねば話が進まない。[l]\nだから諸事情鑑みて、多少大胆にいかせてもらった。[l]\nかれおんは気が気でないようだけどな……[l]\nまーまー、俺だって無根拠じゃないんだよ、\n多分大丈夫って言ったろ。多分て。[l]\nそんなにびびんなって……って何か別の理由？":24,"「は、あわわ……あうあう」":25,"……まあいいや。":26,"「ああ、その点に関しましては申し訳ありませんが、\n買い被りですね」":27,"「？」":28,"「言うなれば今のこれは気分転換の類の結果です、\n宵の散策中だったのですよ、ワタシは。[l]\n最近調子が芳しくありませんでね、\n少しばかりリフレッシュしようと外を歩いておりました」":29,"「はあ、それはまた、ど偉い確率で……」":30,"……。[l]\nまあ、……そういうこったな。[l]\n上司殿も当然そこは認識してるだろうが、\nいーくんにせよ当事者にせよ、\n自覚の有無は関係ねーし、\nさっすが主人公、イベント起こすなあ。[l]\nバッドＥＤフラグイベじゃないことを祈るぜよ。":31,"「カレ、何してるんです」":32,"「へっ、\nあああ、あの、\nあっ、その、御調子の方が、」":33,"「ワタシは貴女を責めるつもりはありません。[l]\n視て分からないですか」":34,"「……だ、大丈夫なんですか……？」":35,"「心配ありがとう。[l]\n問題はない……というよりも、[l]\nああ、どちらの件に対する心配ですかね？[l]\nまあどっちでもいいですがね。[l]\n少なくともワタシの方から、このことをあの方に進言する、\nつもりはありません」":36,"「……」":37,"俺の前でそれを言う？":38,"あのゲーム大好き萌店長が、\nネタバレ嫌いだからって理由か？":39,"もしそういう事なら、\n俺もかれおんも一連の流れの渦中に、\n突発的事象因子……つまりは、[l]\nあれへの面白ネタとして組み込もうって事になるから、\nむっともしようが、":40,"まあしかし、どうやらそればっかでもないのか？[l]\n揺れている……感じがする。[l]\n何となく感じてはいたが、\nあれらの中枢よりは":41,"此":42,"方寄りの心的構造のようだし、\nかれおんと似通ってる部分も、あ、順番逆か。[l]\nさっすがかれおんの上司、\n中枢上位の割りにはＤに近しい……否、[l]\n上位だからか？[l]\nま、いずれにしても、\n少なくとも問われるまでは黙っててくれるって事だわさ。":43,"それとま、一応突っ込んどくか。":44,"「何にしてもあまり驚いた感じじゃ、\nありませんね？[l]\nホントに偶然です？」":45,"「通常ならば、\n視た眼で判断すると足をすくわれますよと、\nお返しする所ですがね。[l]\nまあ──ご覧の通りの風体ですので。[l]\n正確に説明するならば、\n一瞬驚愕し、すぐさまある節に思い当たり、\nあとはそれに即した振る舞いをしているつもりでして、\n驚いたように視えぬのも然り、\n而してそう断言するには、\n……いえ、まあ、どっちでもいいんですがね。[l]\nいずれ今この邂逅の瞬間まで、\nアナタ達の事は一切合切、思いも寄りませんでした。[l]\nそれは本当ですよ。[l]\n何しろそこの不肖の部下には、\n……正確には弟子と言った方が表現的には近い、[l]\nああ、まあどちらでもいいです。[l]\nえー、なんでしたかね、\n──ですからね、\nばれていた訳ではありませんよ。[l]\nええ、この邂逅は、\n偶然……です、かね。[l]\n済みませんね、先にお話した通り、\n少々体調精神ともに状態が芳しくない──いえ、\n十全ではないようです。[l]\nしかと伝えられてないようでしても容赦を願えれば」":46,"「ああ、いえ、\nお察しします、問題ありません。[l]\nであれば、\nこのような立ち話長話、良いんですか？[l]\nあれでしたら──」":47,"取り敢えずかれおんは最前から、\n俺の後ろに隠れるようにしているが、\nそれは俺がそういう位置取りをしたからで、\n今の彼女は単に、話に入って来れない不器用な女子なだけだ。[l]\nなるたけ二人が話さずに済むようにそうしてるから当たり前。[l]\nまあ、向こうさんもやっぱ気は遣ってくれてるらしいし、\n色んな意味でこの出会いは僥倖の気配がする。[l]\n思ってた以上に、":48,"遙かに話の通じる人だった。":49,"「ああ……そうですね」":50,"彼女は":51,"一":52,"時視上げるような仕草をし、\n言った。":53,"「あるでしょうからね、此処で話すは色々障りが。[l]\n幾ら":54,"人":55,"足が":56,"疎らとはいえ、\n……しかし、そちらもそう時間はないのでしょう。[l]\n何処かで落ち着くような真似をしても始まらないのでは？」":57,"「あー……[l]\nまあ、そうすね。[l]\nでは、\n単刀直入に一つだけ伺いたい事がありまして。[l]\n彼の行方、御存知ないですか」":58,"「！」":59,"まあ、或る程度は賭だが、\nやっぱこのひと『いいヒト』だぜ。[l]\nかれおん、もう少し信用してあげなって……[l]\n出来ない理由があるならしゃあないが、\nいずれにせよ、\n何とかなる、そういう雰囲気を視出した。[l]\n無論、最悪の場合は最終手段に出るしかないが、\n色んな意味で避けて通りたい方法だわな。":60,"「カレ？[l]\nああ、彼。[l]\n残念ながら今は放置してまして、\n然るべき時が来れば否応無しに探し出すのですが──\n大変心苦しいのですがね、\n現時点では把握していないのですよ。[l]\n祭の前日までは、\n考える時間を与えようとの上意がありまして。[l]\nああ、……後でカレにそう伝えてくれますか。[l]\n今はて、て……」":61,"「テンパって？」":62,"「ああ、ありがとうございます。[l]\nテンパってるようですのでね、\nまあ、内部事情なのでアナタは気にしなくて結構ですよ。[l]\nそうですね、\n逆に言えば上が動くには猶予が少なくとも、\n数日ある、\nと言うことですのでね、\nとはいってもアナタも今は地道に動くしかないでしょうから。[l]\n早めの起動を推奨します」":63,"「……おおあ」":64,"「情けないことにワタシは申し上げた通り、\nやや本調子ではないようでして。[l]\nあまり余計な事象にかまける余裕が正直無いのです。[l]\nですから、\n色々、思う所もありますのでね、\nアナタさえ宜しければ、\n今は互いに不干渉、視て視ぬふりが肝要ですかね。[l]\n今のワタシの処理能力には少々厳しい懸案……懸案？[l]\nまあ、どうでもよろしい、\nともあれ、\n今回のような事象は元来制御出来るか出来ないのかという、」":65,"「ええ、はあ」":66,"──月の雫の？":67,"「彼自身の問題に加え、\nただでさえ我々のトップは●●●ですのでね。[l]\nどうなるかはまるで保証出来兼ねますが」":68,"……どうやら思った以上にいける口じゃんな。":69,"「……まあ、察してくださってありがたいことです。[l]\n……えー、もしや、以前──」":70,"「『会う機会があったと思しき当時』、\n既にワタシは今の位置でしたが、\nprojectそのものに深く関与はしていませんがね。[l]\nしかしアナタの方も『あの四人』は既知、\n識っていたのではないですか。[l]\nまあ":71,"屹":72,"度、それと同程度ですよこちらもね。[l]\nいずれにせよ、\nこういったカタチで会うのは初めてでしょう」":73,"「？？、？？？」":74,"「なるほどねぇ……[l]\nおっと、」":75,"会社員は兎も角、\n部活で遅いらしい学生達の帰宅時間にあたりそうなのか、\n人の気配が濃密になり出した。":76,"「じゃあ、俺等、野暮用があるんで、\nこっちとしてもなるべく":77,"干":78,"渉はしないつもりですが、\n此処には──友人の力になりに来たもんですから。[l]\nその障碍になるようなモンとは、或る程度……ま、[l]\nチノさんは『関係ない』でしょうけどね？[l]\nあはははは」":79,"「……もっと早くに、そして深く知り合うべきでしたかね。[l]\nカレとももっと話すべきでした」":80,"「いやぁ～……[l]\nま、これから幾らでも、\nいえ、\nあまり変な事をいうと彼女さんに誤解されますんでアレですけど。[l]\nま、仲良くやっていけますよ、\n今後とも」":81,"「……ああ、[l]\n車、レンタルするのでしょう。[l]\n案内しますよ。[l]\n今の時間だと応対を望めないかもしれませんが、\n場合によってはワタシが口利きしましょう。[l]\nこちらです。[l]\nカレ」":82,"「はぅっ、はい？！」":83,"「もっと落ち着きなさい。[l]\nしっかり彼氏さんのお役に立つように」":84,"返事を待たず、\nすーーーーっ……と、[l]\n滑るように歩き出すチノさん。[l]\n俺等はついて行く。":85,"歩きながら、彼女は独り言のように呟く。":86,"全体への貢献と調和を望むことは、[l]\n　必ずしもシュの存続にとってプラスではない、[l]\n　両者が拮抗或いは行ったり来たり、[l]\n　生物はそのミに既に備えている恒常性をもってして、[l]\n　その場に留まる為に走り続ける、[l]\n　停滞は存在しないと同義、[l]\n　Asleep, with still hands……という訳にはいかない。[l]\n　手を取り合って……行けるのならばどんなに良かったか、[l]\n　しかしどうにもこのセカイは最悪の箱庭──":87,"「──なのでね、\nそうですね……[l]\nどちらかに振り切れさえしなければ、\n":88,"啀み合おうが争う事になろうが、\nヴァリエーションとして両者が同時に在るのが、」":89,"「──健全な在り方なんでしょうよ。[l]\n俺もそう思います。[l]\nイヤな事ですがね。[l]\n":90,"チ":91,"カ":92,"ラ":93,"な":94,"き":95,"も":96,"のにとっては大変に厳しい":97,"仕":98,"様です。[l]\nいずれ言えそうなのは、\nヒトがどう思い考えようと、\n競争原理というものが……[l]\nライバルにせよ天敵にせよ、\nそうですね相争う事が、能力にしろ技術にしろ、\n存在者の在り方に進化……或いは変化を":99,"齎してきた、[l]\nという歴史的事実ですかね。[l]\n残念乍ら」":100,"……一応、[l]\n長々レスポンスしてみたけど、\n我ながらそんな場合なんだろか。[l]\nかれおんは俺を挟んでこの人の反対側について歩いている。[l]\nちらと両方の様子を窺うが、\nチノさんの方は害意敵意の有無以前に、\n揺れている感もさることながら、\n心":101,"焉に在らず感も":102,"益":103,"益──ああ、\n人のことは言えんのだが。":104,"何にしろ、[l]\n会話を合わせてはみたものの結局何が、\n言いたいんだろかな？":105,"と思って次の句を待ってたんだが、\n何故だか向こうさん黙ったまま、\n気まずい間が出来てしまったので、":106,"合ってるかどうか分かりませんが、[l]\nと前置きして場繋ぎの会話を始めた。":107,"「結局、\n主体たる存在が二個以上あるからには、\nどんな形であれ、\n両者間に争いを含む":108,"関":109,"わ":110,"り":111,"合":112,"いが形成されるのは、\nまー必定でしょうよ。[l]\nそれにあれですね、\n抗体ってのは抗原なくしては作れないもんだし、\n無菌状態で生き抜くのでも無い限り、\n早めに免疫はつくらないとねえ、\nオトナになってからじゃ」":113,"遅い、というか、\n場合によっては致命的な結果になり得る。":114,"事実病気じゃなかろうと、\n普段の生活における対人対物対事他諸々関係、\n若い頃に免疫力を培っておかないと、\nなまじオトナという立ち位置の所為でそのデメリットが倍加され、\n自他共に損害迷惑を被る。[l]\nそういう意味じゃ餓鬼ん時の学校なんてのは、\n学んだ学問的要素が事実役に立つとかではなくて、\n彼処での生活を余儀なくされること自体を含め、\n彼処で体験させられるそのものが、\n予防接種のようなもんなんだわな。[l]\nその後世間に独り放り出される前に、\n少しでも衝撃をマシにしてやろうという、\nありがたい心遣いだ。[l]\n逆に言えば、\n抗原たり得ない、緩い培地で培養された温室育ちがどうなるか、\n世間は分かってる筈なのに、\n過保護なのか自分達だけの利を求めた結果か、\n……そっから先はまあ言わぬが花じゃね。":115,"などと思っていると、":116,"「……テンテキが、要りますか。[l]\nどうあっても。[l]\nコウゲンあってのコウタイ、\nゼロからプラスは、マイナスよりも困難か──\nああ、いえ、なんでもありません」":117,"やっと話出したと思ったら、\nまた独り言のような具合でよく判らん。":118,"しかし、":119,"一瞬、自嘲気味に嗤ったように……思えた。[l]\nマスクしてっから雰囲気だけど。[l]\nそして彼女は続ける。":120,"「とまれ──[l]\nいずれ疑問を感じているとは言っても、\n我等のトップたるあの方とも、\n袂を分かつつもりもありませんでね、\nただ、[l]\nもし●の所為ならば、[l]\nアナタ達を……いえ、」":121,"そこでげほっ、と咳き込む仕草をし、\n此方も言いましょう単刀直入に、と言った。":122,"「チズルが余計な事……いえ、[l]\n己を弁えない愚挙に出るよりは、\nアナタ達に盤上に乗って貰った方が、\n色々な面に於いて無難だと判断しています」":123,"「……？！」":124,"俺等二人が黙ってると、":125,"ワタシが直で動くのはルートも結果も或る意味で、\n先が──":126,"そこまで言って、\n再度咳き込むチノさん。[l]\n体調が悪いというよりは、\n奥歯に物が挟まったような、\n言いづらいことなのか、\n単に思考→実際口にするの変換整理がついてないのか、\nいずれ伝えたい事とはあまり関係のない項だったようで、\nそれはどっちでも良いんですが、と続けた。":127,"「そう言った打算も、あるのですよ。[l]\nワタシには。[l]\n疑問に思っていたようなので、\n過不足の程度はあれど説明を加えました。[l]\n軽蔑しますか？」":128,"単刀直入というか、\n本題の件名だけずばっと言っては呉れたようだが、\n背景その他の説明を、\n少なくとも口にはしていない……してるんかな今ので？[l]\nまあ、\n全部ワかれというにはちっと、常人には厳しいだろうな。[l]\nそこはそれ、\n色々、\n察した上での口上だろーからな向こうさんも。[l]\nなので、\n俺も言葉を返す。":129,"「単刀直入、結構だと思いますよ？[l]\nま、それとは別問題で、\n俺は兎も角、大事な部下を……なんつーんすかね、[l]\nそういう風に視れるんだとしたら、\nそれぁー俺の心証も害されますけどね。[l]\n今回のその件についちゃぁ要するに、\n俺に対する絶対的信頼と受け止めますよ」":130,"「………まあ、[l]\n………、[l]\n……どっちでも、どうとでも取って頂いて結構ですが」":131,"「まーなるたけ余計な事はしないつもりスけどね。[l]\nそれに、そっちの思惑はどうあれ俺は、\nこいつとあいつ、\n相手が誰であろうと絶対に害させませんよ。[l]\nそういう意味で、その信用は裏切らない──つもりです。[l]\n俺個人の意思としてはスけど」":132,"関わらせない、という選択肢込みでな。[l]\n向こうさん次第の部分もあるしのう。":133,"……てか、やっぱ戦闘状態有り得る事態か……[l]\nきついなあ。":134,"あー、そういえば、\nっつーかチズルって誰だっけな？":135,"「………信頼、否、期待というのは、[l]\n暗に脅迫しているとも言えましょう。[l]\nかといって、\n無条件の信用をする程アナタを識っている訳でもないですし、\nですからこれは、\nあとは、\n………。[l]\n我等の上は予測の範疇や予定調和的な縛りを越えた突発的事象を、\n大変に好むという事もありますけれど、\nそこを敢えてワタシがどうこう手を講じるなどとは、\n大変に":136,"烏":137,"滸がましいのですが、\n………、[l]\n………、[l]\nワタシの、判断は、\n………、[l]\nこちらのトップの為になる行為と断じました。[l]\n今、\nいろいろな、意味で」":138,"覚悟は決めました、\nと小さく彼女は言った。":139,"……ん～～、まあ、あれだな、":140,"「んなに深刻ならなくて済む──と思いますよ。[l]\n俺等は勿論、\nそちらさんの敵になりに来たのじゃないし、\nそれに多分、彼奴自身が、何とかします。[l]\nその、そちらのトップの件に関してもス。[l]\nま、俺はフォローに徹するという奴で……」":141,"「……ええ……[l]\nああ、\nチズルにも……べきか、それとも……」":142,"聞こえてるのかいないのか、\n独り言のように呟き、\nまた沈黙状態に突入したので、\n……ってか遠いな目的地までよぅ、[l]\nそれにチズルって誰だっけな？[l]\nってそれはさておき、\n間を持たすために俺が再度口を開く。[l]\nかれおんはもうだんまり決め込んじまってるし、\n早く着かないもんかしらん。":143,"「と言うわけで今回のめこぼしに関しましては、\n大変ありがたく謝辞を述べさせて頂き、\n不言実行をもってお返しできればと、\nそういう所存でおります所存で」":144,"「……あははははははははは」":145,"「……？[l]\n……？」":146,"初見の印象からは少し想像し難い、\n柔和且つ快活な声で、\n突然彼女が笑い出す。":147,"俺の２度言いに受けたのか、\n他の理由故かは兎も角、\nやっぱこの人にしては珍しい反応だったんだろう、\n様子を確認するに若干引いてる感のあるかれおん。":148,"ま、そこはそれだ、\n奇矯な叫び声出された訳でもなし、\n鬱々と仏頂面で居られるよりはいい。[l]\nああ……この人はマスクだからあれだけど。":149,"「まあ、\nいずれ貴女にはまた、\nきっちり挨拶に伺いますよ。[l]\n嫁の上司には色々そん後もお世話になるでしょうし──」":150,"「……わかりました。[l]\nこれですっきりした、……ん？吹っ切れた？[l]\n……まあ、ええ。そんな、[l]\n──気がします。それと」":151,"こちらも、\n末永いお付き合いを期待します──":152,"「はい？はい？[l]\nハッ、\nよ、よめ……」":153,"「ああ、言った舌の根の乾かぬうちに引き留めるが如き長話、\nすみませんでしたね。[l]\nさて、頃合い良く目的の場は、ああ、あれですね」":154,"錯乱しそうになったかれおんの思考を断ち切るが如く、\n瞬時に場を仕切るチノさん。[l]\nま、かれおんには後でじっくり説明する要があるっつーか、\nこの人も含めて三者面談、\n色々相談も出来そうなんで、\n良かった良かった。":155,"そっちの件はさておき、":156,"取り敢えず俺等の我を通しに行くという、\nこっちの件もどうにかしにゃならん。":157,"世界の淘汰構造に則り、\n責を負う覚悟をもって臨まんとかや。":158,"通らぬものは通らぬ。[l]\n通るものは通る。[l]\nが、\n通そうと動かぬ限りは、\n舞台にすら上がれない。[l]\n事を成さんとするならば、\n我を通さんとするならば。":159,"自分の方からは動かずに手をこまぬいたまま、\n諾々と在るだけで、\n闘わずして決着がつけられればどんなに楽で平和だろうか。":160,"しかし、\nコトバを遣うヒトですら、\n容易に不和の道を選択しうるように、\n組まれてあるこの基本構造下では、":161,"Asleep, with still hands……という訳にはいかない。":162,"まあ詮方ないやな、\nセカイが俺等を止めるまでは動くさ。[l]\n俺等の選択が拒否されるまでは、\nセカイが俺等を止める選択をするまでは──":163,"それも、\n察して貰えてることだろう。":164,"「ではどうぞ。[l]\n不慮の場合に備え、\n手続きが済むまでは此処で待ちましょう」":165,"「あ、どうもっす。[l]\n……なーかれおんさん。[l]\nだからそんなに鯱張んなくていいんだって。[l]\n行こうぜほれ」":166,"「はっあわわあわわ」":167,"こけつまろびつ俺についてくるかれおん。[l]\nチノさんは視ないフリをしてどこか遠くに顔を向けた。[l]\n俺もふと遠景に視軸を向けたが、\nもう結構暗いなあ……":168,"何はともあれ、\n危惧は杞憂に終わりなんとか車はレンタルできた。":169,"外で待っていたチノさんに礼を述べ、\n俺は既に店の係の人に案内されかけてたが、\nいよいよチノさんがかれおんを呼び止めた。[l]\n……まあ色々察して俺は店員さんについてくとしよう。":170,"「──それよりもカレ、\nもし何処かでアイかお嬢を視たら、\n教えなさい。[l]\n接触はしないで結構ですのでね。[l]\nただし、貴女のあれは控えた方がいいでしょう、\n特にフハイが全動した後は」":171,"「え、……と、つまり」":172,"「要するに、\nそこまでして検索の要は無い、という事です。[l]\n余程の事が無い限りは、\n常駐以下程度に抑えた方が無難でしょう。[l]\n検索すべきモノがそうそうあるとは、\n現段階では思えませんが、\n先の二人の様子が気に掛かるというのも、ありますしね。[l]\nあの方ならまだしも、\nお嬢を刺激するのは宜しくないでしょう。[l]\nそれと──」":173,"「……はっ」":174,"「……ＧＷに気をつけなさい。[l]\n野放しで此の地に居るようですから」":175,"もし何かあれば、対応もやむなし──\n或いはその彼が守ってくれるでしょう。":176,"この劇は、[l]\n今、急の段階に差し掛かっています。[l]\nあの日まであと":177,"僅か、[l]\nアナタのもう一つは、triggerであり９。[l]\n此度の劇で、その両方に立ち会うも或る意味では当然だったかも、\n知れません。":178,"ただ、":179,"我々の一部が思っているような、\n蓋然、必然、\n物語としての結構性などというものは、\n『deus ex machina』には意の外、\nというよりも、\nだからこその『キカイジカケのカミ』ですよ。[l]\nそして司書長はそれの顕現を望んでいます。[l]\n":180,"努":181,"々忘れることなきよう。":182,"……では、":183,"久し振りに逢えて良かった。[l]\nワタシは所用ありますのでね、\nそろそろ戻ります。[l]\n彼に宜しく。[l]\nOmegaの瞳の祝福あれ──":184,"「………」":185,"俺が戻ると、既にチノさんは居なかった。":186,"……ＧＷ？[l]\n……デウスエクスマキナ？":187,"「まーいいか、\n早速行こうか、\n……腹減ってる？[l]\n出来れば奴をみっけてから、\n一緒に喰うのがベストだけんども」":188,"「へっ？[l]\nあ、いえ、大丈夫デス、あ、でもお手洗いだけ……」":189,"「へいへい、\nじゃ、此処にいるから」":190,"取り敢えずは、\n海岸か。":191,"イーくんかどうかは兎も角、\n何か引っ掛かるあの、\n未だ識らずの何かがあるらしき、\nよくわからんが１３番目があるらしき、":192,"あの海岸、\n彼処に、\n多分。":193,"……多分。":194},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_033.ks","relPath":"/data/scenario/SC_S_033.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":187,"length":195,"percent":95.8974358974359},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[113,1]},"/data/scenario/SC_S_034.ks":{"data":[["いいくぼまことさまへ","致井洼真言大人"],["まこちゃん、[l]\n手紙で書くのも変だけどさ、[l]\n久し振りなのだわ。","小真，[l]\n虽然写信有点怪，[l]\n真是好久不见啦。"],["体調崩してばっかでごめん。","老生病真是对不起。"],["ほんとはもっと","其实本来还想"],["話したり、[l]\n遊びたいんだけどさ、[l]\nうちは忙しいから。[l]\n前言ったっけ？[l]\n忘れたのだわ。","想和你说话、[l]\n也想和你一起玩、[l]\n但我家太忙了。[l]\n之前说过吧？[l]\n我忘记了呢。"],["冬夏がそのぶん、相手してくれてると思うけど。[l]\nあのこ、いいこよね。","不过冬夏应该替我陪着你。[l]\n那孩子，是个好孩子呢。"],["あの時も、子供の時も、","那时候也是，小时候也是、"],["（中略）","（中略）"],["あのね、[l]\n書こうかどうか、迷ったんだけど、[l]\n友達だから、[l]\nやっぱ伝えなきゃと思って、","那个啊、[l]\n犹豫过要不要写下来、[l]\n因为是朋友、[l]\n果然还是觉得必须告诉你、"],["頭悪いから、[l]\nうまくは言えないけど、[l]\n私、●●になっちゃったのかも知れない、[l]\nうん、[l]\n言ったところでどうなるもんでもないんだけどさ、[l]\nまこちゃんには伝えとこうと思って、[l]\nだってさ、[l]\n祭が終わったら、きっとお互い、","我脑子笨、[l]\n可能说不清楚、[l]\n我大概变成●●了、[l]\n嗯、[l]\n虽然说出来也改变不了什么、[l]\n但觉得应该让真知道、[l]\n因为啊、[l]\n祭典结束后，我们肯定、"],["私も思い出した……というか、[l]\n道具さんから言われて思い出したの、","我也想起来了……应该说、[l]\n是道具告诉我的、"],["冬夏と、[l]\n私と、まこちゃんとの、[l]\n思い出の宝物。","和冬夏、[l]\n和真、[l]\n回忆的宝物。"],["その場所に、[l]\n目印を、[l]\nあの時、私とうめなおした場所にね、[l]\n目印つけといたから。[l]\nこういう、","在那个地方、[l]\n做了记号、[l]\n就是当时我和梅修复的地方、[l]\n我留了记号。[l]\n这样的、"],["そこに、[l]\n今のまこちゃんがほしいものが、[l]\nあるよ。[l]\n道具さんがそう言ってたけど、[l]\nうん、私も、そう思うのだわ。[l]\nだから、[l]\nさがしてみて？[l]\n３人の宝物だけど、[l]\n私には、意味がないものだからさ。","那里有、[l]\n现在真想要的东西、[l]\n就在那里。[l]\n虽然这是道具说的、[l]\n嗯，我也这么觉得呢。[l]\n所以、[l]\n去找找看？[l]\n虽然是三个人的宝物、[l]\n但对我已经没意义了。"],["あ、覚えてるっけ？[l]\nあの時彼処に、道具さんもいたのをさ。[l]\nあの人ウソばっかいうから、[l]\nまこちゃんに何て言ってるかわかんないけど。","啊，你还记得吗？[l]\n那时候道具也在那里哦。[l]\n那人总爱说谎、[l]\n不知道她对真说了什么。"],["……この話もしたんだっけか？[l]\nだめだ、ほんとに私、[l]\nそういうの覚えてるの苦手なのだわ。[l]\nでも、[l]\nまこちゃんと一緒で楽しかったっていう事は、[l]\n覚えてるから。","……这事也说过了吗？[l]\n不行，我真的、[l]\n最不擅长记这些事了。[l]\n但是、[l]\n和真在一起很开心这件事、[l]\n我一直记得。"],["私、[l]\nまこちゃん達にあの時会えて、[l]\n本当に救われたよ。[l]\n今も穏やかにいられる部分をもてるのは、[l]\nうーん、説明しようとするとこんがらがるけど、[l]\n私、ほんとうは他人とも仲良くいたいのよね。[l]\n争いごとって嫌いなのさ。[l]\nでも、[l]\nどうしてもヤなことってあるわさ、[l]\nヤなひともいるしさ、[l]\nそういうとき、[l]\nどうしても、","我、[l]\n那时候能遇见真、[l]\n真的得救了。[l]\n现在还能保持平静的部分原因、[l]\n唔，解释起来会乱糟糟的、[l]\n其实我也想和别人好好相处。[l]\n最讨厌争吵了。[l]\n但是、[l]\n总会有讨厌的事、[l]\n也有讨厌的人、[l]\n这种时候、[l]\n无论如何、"],["それとは別の本心がね、最近、[l]\nまこちゃんと再会してから、[l]\n抑えらんないのだわ。[l]\n何かムジュンしてる？[l]\n気にしないでね、頭悪いから私。","除此之外的真实想法呢，最近，[l]\n和真酱重逢之后，[l]\n就压抑不住了呢。[l]\n是不是有点矛盾？[l]\n别在意啦，毕竟我脑子不好使。"],["とにかくね、[l]\n私なんかじゃ、[l]\nだからね、","总之呢，[l]\n像我这样的人，[l]\n所以啊，"],["あーあー、もうね、[l]\n頭悪いからさ、[l]\n何書きたいのかもわかんないけどさ、[l]\n話せば早いんだろうけど、[l]\n祭忙しくて、[l]\nでも祭終わったら、きっと、[l]\nああ、さっきも書いたねこれ。","啊啊，真是的，[l]\n毕竟我笨嘛，[l]\n虽然也不知道自己想写些什么，[l]\n直接说出来可能更快吧，[l]\n祭典太忙了，[l]\n但等祭典结束后，一定，[l]\n啊，这个刚才也写过呢。"],["頭悪いからさ私。","因为我脑子不好使啦。"],["こんななのだわ。","就是这么回事呢。"],["だから、[l]\n何か間違ったこと、しようとしてたら、[l]\nバカって叱って、止めてほしいよ。[l]\nそうでないと私バカだからさ、[l]\nいけないことをしそうでイヤなのだわ。[l]\n早くちゃんとしたひとになりたい。","所以，[l]\n如果我要做什么错事的话，[l]\n希望你能骂我笨蛋，阻止我。[l]\n不然以我的蠢脑子，[l]\n可能会做出不该做的事，好讨厌这样。[l]\n好想快点变成靠谱的人。"],["それかね、","或者说呢，"],["まこちゃんが、冬夏ともし、[l]\n……いや、[l]やっぱ言わないわ。[l]えへへ。","如果真酱和冬夏，[l]\n……算了，[l]还是不说了。[l]嘿嘿。"],["あのこもちゃんと守ってあげてね、[l]\n強がってるけど甘えん坊だし、[l]\n私と違って感情ストレートに出すとこあるしさ、[l]\nいっぱいおごってもらったし、[l]\n私が冬夏にできること、[l]\nうーん、あの家から出せるたすけができるなら、[l]\nせーいっぱいがんばってみるつもり。","那孩子也请好好保护她，[l]\n虽然逞强但其实很爱撒娇，[l]\n和我不一样会直接表达感情，[l]\n还经常请我吃饭，[l]\n我能为冬夏做的事，[l]\n嗯…如果能帮她离开那个家，[l]\n我会拼尽全力试试看。"],["私はそんな二人をみられれば、[l]\nまこちゃんたちふたりならばさ、[l]\nそれなら許せると思うのだわ。","只要能看着那样的两个人，[l]\n如果是真酱你们俩的话，[l]\n我觉得这样就能原谅自己了。"],["まあでもそこは最後の意地だからさ。[l]\n冬夏にはひみつ。","不过那是我最后的倔强啦。[l]\n要对冬夏保密哦。"],["あとはあれだわ、[l]\n他にも色々言いたいこともあったけどさ、","还有就是啊，[l]\n虽然还有其他很多想说的话，"],["やっぱ、墓場まで持っていくのだわ。[l]\nそのほうがかっこいいし？[l]\nひみつは大事よね。[l]\nミステリアスってやつ？","果然还是带进坟墓吧。[l]\n这样比较帅吧？[l]\n秘密是很重要的呢。[l]\n所谓神秘感？"],["じゃあ、[l]\n祭終わっても、[l]\nずっと友達でいれたらいいね。","那么，[l]\n就算祭典结束了，[l]\n也能一直做朋友就好了。"],["いろいろたすけてくれてありがとう。[l]\nいろいろおいしかったです。[l]\nまこちゃん、だいすきなのだわ。","谢谢你帮我这么多。[l]\n你请的每顿饭都很好吃。[l]\n最喜欢真酱了呢。"],["長文失礼しました、かしこ。[l]\n＜でいいのかな？勉強したけどよくわからないのだわ","写了这么长抱歉啦，此致。[l]\n＜这样写对吗？虽然学过但不太懂呢"],["西石貴奴より","西石贵奴"],["（裏面に非常に気付き難く付記）","（在背面极难察觉处附笔）"],["そして音　より[l]\nまこちゃんをアイせる存在に、","另 音 笔[l]\n想成为能让真酱"],["なりたいの[l]\nごめんね","爱上的人[l]\n对不起"]],"context":[["SC_S_034.ks/index/1/text"],["SC_S_034.ks/index/3/text"],["SC_S_034.ks/index/5/text"],["SC_S_034.ks/index/7/text"],["SC_S_034.ks/index/9/text"],["SC_S_034.ks/index/11/text"],["SC_S_034.ks/index/13/text"],["SC_S_034.ks/index/15/text","SC_S_034.ks/index/19/text","SC_S_034.ks/index/23/text","SC_S_034.ks/index/31/text","SC_S_034.ks/index/41/text"],["SC_S_034.ks/index/17/text"],["SC_S_034.ks/index/21/text"],["SC_S_034.ks/index/25/text"],["SC_S_034.ks/index/27/text"],["SC_S_034.ks/index/29/text"],["SC_S_034.ks/index/33/text"],["SC_S_034.ks/index/35/text"],["SC_S_034.ks/index/37/text"],["SC_S_034.ks/index/39/text"],["SC_S_034.ks/index/43/text"],["SC_S_034.ks/index/45/text"],["SC_S_034.ks/index/47/text"],["SC_S_034.ks/index/49/text"],["SC_S_034.ks/index/51/text"],["SC_S_034.ks/index/53/text"],["SC_S_034.ks/index/55/text"],["SC_S_034.ks/index/57/text"],["SC_S_034.ks/index/59/text"],["SC_S_034.ks/index/61/text"],["SC_S_034.ks/index/63/text"],["SC_S_034.ks/index/65/text"],["SC_S_034.ks/index/67/text"],["SC_S_034.ks/index/69/text"],["SC_S_034.ks/index/71/text"],["SC_S_034.ks/index/73/text"],["SC_S_034.ks/index/75/text"],["SC_S_034.ks/index/77/text"],["SC_S_034.ks/index/79/text"],["SC_S_034.ks/index/81/text"]],"tags":[],"parameters":[[{"start":150,"end":160}],[{"start":170,"end":214}],[{"start":220,"end":233}],[{"start":239,"end":246}],[{"start":257,"end":327}],[{"start":333,"end":373}],[{"start":379,"end":390}],[{"start":400,"end":404},{"start":483,"end":487},{"start":664,"end":668},{"start":877,"end":881},{"start":1494,"end":1498}],[{"start":412,"end":475}],[{"start":499,"end":654}],[{"start":678,"end":717}],[{"start":727,"end":765}],[{"start":771,"end":845}],[{"start":889,"end":1040}],[{"start":1046,"end":1131}],[{"start":1137,"end":1249}],[{"start":1255,"end":1484}],[{"start":1506,"end":1600}],[{"start":1606,"end":1640}],[{"start":1650,"end":1776}],[{"start":1782,"end":1790}],[{"start":1796,"end":1804}],[{"start":1810,"end":1936}],[{"start":1942,"end":1947}],[{"start":1957,"end":2002}],[{"start":2008,"end":2172}],[{"start":2178,"end":2237}],[{"start":2243,"end":2276}],[{"start":2282,"end":2317}],[{"start":2327,"end":2400}],[{"start":2406,"end":2447}],[{"start":2453,"end":2514}],[{"start":2520,"end":2565}],[{"start":2591,"end":2597}],[{"start":2629,"end":2644}],[{"start":2654,"end":2683}],[{"start":2693,"end":2710}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_034.ks","basename":"SC_S_034.ks","indexIds":{"いいくぼまことさまへ":0,"まこちゃん、[l]\n手紙で書くのも変だけどさ、[l]\n久し振りなのだわ。":1,"体調崩してばっかでごめん。":2,"ほんとはもっと":3,"話したり、[l]\n遊びたいんだけどさ、[l]\nうちは忙しいから。[l]\n前言ったっけ？[l]\n忘れたのだわ。":4,"冬夏がそのぶん、相手してくれてると思うけど。[l]\nあのこ、いいこよね。":5,"あの時も、子供の時も、":6,"（中略）":7,"あのね、[l]\n書こうかどうか、迷ったんだけど、[l]\n友達だから、[l]\nやっぱ伝えなきゃと思って、":8,"頭悪いから、[l]\nうまくは言えないけど、[l]\n私、●●になっちゃったのかも知れない、[l]\nうん、[l]\n言ったところでどうなるもんでもないんだけどさ、[l]\nまこちゃんには伝えとこうと思って、[l]\nだってさ、[l]\n祭が終わったら、きっとお互い、":9,"私も思い出した……というか、[l]\n道具さんから言われて思い出したの、":10,"冬夏と、[l]\n私と、まこちゃんとの、[l]\n思い出の宝物。":11,"その場所に、[l]\n目印を、[l]\nあの時、私とうめなおした場所にね、[l]\n目印つけといたから。[l]\nこういう、":12,"そこに、[l]\n今のまこちゃんがほしいものが、[l]\nあるよ。[l]\n道具さんがそう言ってたけど、[l]\nうん、私も、そう思うのだわ。[l]\nだから、[l]\nさがしてみて？[l]\n３人の宝物だけど、[l]\n私には、意味がないものだからさ。":13,"あ、覚えてるっけ？[l]\nあの時彼処に、道具さんもいたのをさ。[l]\nあの人ウソばっかいうから、[l]\nまこちゃんに何て言ってるかわかんないけど。":14,"……この話もしたんだっけか？[l]\nだめだ、ほんとに私、[l]\nそういうの覚えてるの苦手なのだわ。[l]\nでも、[l]\nまこちゃんと一緒で楽しかったっていう事は、[l]\n覚えてるから。":15,"私、[l]\nまこちゃん達にあの時会えて、[l]\n本当に救われたよ。[l]\n今も穏やかにいられる部分をもてるのは、[l]\nうーん、説明しようとするとこんがらがるけど、[l]\n私、ほんとうは他人とも仲良くいたいのよね。[l]\n争いごとって嫌いなのさ。[l]\nでも、[l]\nどうしてもヤなことってあるわさ、[l]\nヤなひともいるしさ、[l]\nそういうとき、[l]\nどうしても、":16,"それとは別の本心がね、最近、[l]\nまこちゃんと再会してから、[l]\n抑えらんないのだわ。[l]\n何かムジュンしてる？[l]\n気にしないでね、頭悪いから私。":17,"とにかくね、[l]\n私なんかじゃ、[l]\nだからね、":18,"あーあー、もうね、[l]\n頭悪いからさ、[l]\n何書きたいのかもわかんないけどさ、[l]\n話せば早いんだろうけど、[l]\n祭忙しくて、[l]\nでも祭終わったら、きっと、[l]\nああ、さっきも書いたねこれ。":19,"頭悪いからさ私。":20,"こんななのだわ。":21,"だから、[l]\n何か間違ったこと、しようとしてたら、[l]\nバカって叱って、止めてほしいよ。[l]\nそうでないと私バカだからさ、[l]\nいけないことをしそうでイヤなのだわ。[l]\n早くちゃんとしたひとになりたい。":22,"それかね、":23,"まこちゃんが、冬夏ともし、[l]\n……いや、[l]やっぱ言わないわ。[l]えへへ。":24,"あのこもちゃんと守ってあげてね、[l]\n強がってるけど甘えん坊だし、[l]\n私と違って感情ストレートに出すとこあるしさ、[l]\nいっぱいおごってもらったし、[l]\n私が冬夏にできること、[l]\nうーん、あの家から出せるたすけができるなら、[l]\nせーいっぱいがんばってみるつもり。":25,"私はそんな二人をみられれば、[l]\nまこちゃんたちふたりならばさ、[l]\nそれなら許せると思うのだわ。":26,"まあでもそこは最後の意地だからさ。[l]\n冬夏にはひみつ。":27,"あとはあれだわ、[l]\n他にも色々言いたいこともあったけどさ、":28,"やっぱ、墓場まで持っていくのだわ。[l]\nそのほうがかっこいいし？[l]\nひみつは大事よね。[l]\nミステリアスってやつ？":29,"じゃあ、[l]\n祭終わっても、[l]\nずっと友達でいれたらいいね。":30,"いろいろたすけてくれてありがとう。[l]\nいろいろおいしかったです。[l]\nまこちゃん、だいすきなのだわ。":31,"長文失礼しました、かしこ。[l]\n＜でいいのかな？勉強したけどよくわからないのだわ":32,"西石貴奴より":33,"（裏面に非常に気付き難く付記）":34,"そして音　より[l]\nまこちゃんをアイせる存在に、":35,"なりたいの[l]\nごめんね":36},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_034.ks","relPath":"/data/scenario/SC_S_034.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":37,"length":37,"percent":100},"cellInfo":[]},"/data/scenario/SC_S_035.ks":{"data":[["ひっさしぶりに来ちゃった、\n此処のお祭り。","时隔好久又来参加\n这里的祭典了。"],["やっぱ懐かしいわぁ、\n色々変わってるけど……[l]\n寂れ具合も場所場所ってとこかしら。[l]\n開発がそれなりに進んだとこもあるしねー、\nま、時は刻まれ続けてるんですもの、\nあったり前よね。","果然还是好怀念啊，\n虽然有些地方变了样……[l]\n萧条程度也因地而异吧。[l]\n有些区域的开发倒是挺顺利的——\n嘛，时间总在不断流逝，\n这也是理所当然的呢。"],["人出も結構増えてんのかなぁ……[l]\nこないだの大雪には焦ったけど、\nこの分じゃ旅館も大入りかしらね。[l]\nどこ泊まろうかしらん、\n最悪の場合はえーと……","人流量好像也增加了不少……[l]\n虽然前阵子的大雪让人手忙脚乱，\n看这架势旅馆也会爆满吧。[l]\n该住哪里好呢，\n最坏的情况就...呃......"],["あっ、\n出店ってどの辺よ？","啊、\n小吃摊在哪个方位来着？"],["やっば、記憶飛んでるわ。[l]\nてか人と車でみとおしが、","糟糕，完全想不起来了。[l]\n而且被人群和车辆挡住视线，"],["おわ、祭り囃子超近い。","哇，祭典乐声近在咫尺。"],["──やっぱ音楽は生音生ライブよね、\n太鼓に笛、\nこの身体の芯に響く感じ？[l]\nテンション上がるっつーの！[l]\nリズムだけでトランス入れるっつーの！","——果然音乐还是要现场原声演出啊，\n太鼓与笛子，\n这种震颤骨髓的感觉？[l]\n让人超级亢奋啊！[l]\n光靠节奏就能进入恍惚状态啊！"],["音階楽器とか出来る前から、\nヒトは音楽に慣れ親しんで来たんだもんね、\n生命の根源を揺さぶる何かが、\nあんのよね。","在音阶乐器出现之前，\n人类就早已与音乐相伴而生了，\n有种撼动生命根源的力量，\n就存在于此呢。"],["……ウタは魔法か。","……歌谣即是魔法。"],["よっくわかってるわよ、●●ちゃん。","我很清楚的哦，●●酱。"],["えーとそれよか、どっちに行けば──","呃比起那个，该往哪边走——"]],"context":[["SC_S_035.ks/index/1/text"],["SC_S_035.ks/index/3/text"],["SC_S_035.ks/index/5/text"],["SC_S_035.ks/index/7/text"],["SC_S_035.ks/index/9/text"],["SC_S_035.ks/index/11/text"],["SC_S_035.ks/index/13/text"],["SC_S_035.ks/index/15/text"],["SC_S_035.ks/index/17/text"],["SC_S_035.ks/index/19/text"],["SC_S_035.ks/index/21/text"]],"tags":[],"parameters":[[{"start":146,"end":171}],[{"start":177,"end":291}],[{"start":297,"end":391}],[{"start":397,"end":414}],[{"start":420,"end":452}],[{"start":462,"end":473}],[{"start":479,"end":570}],[{"start":576,"end":644}],[{"start":650,"end":659}],[{"start":665,"end":682}],[{"start":688,"end":705}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_S_035.ks","basename":"SC_S_035.ks","indexIds":{"ひっさしぶりに来ちゃった、\n此処のお祭り。":0,"やっぱ懐かしいわぁ、\n色々変わってるけど……[l]\n寂れ具合も場所場所ってとこかしら。[l]\n開発がそれなりに進んだとこもあるしねー、\nま、時は刻まれ続けてるんですもの、\nあったり前よね。":1,"人出も結構増えてんのかなぁ……[l]\nこないだの大雪には焦ったけど、\nこの分じゃ旅館も大入りかしらね。[l]\nどこ泊まろうかしらん、\n最悪の場合はえーと……":2,"あっ、\n出店ってどの辺よ？":3,"やっば、記憶飛んでるわ。[l]\nてか人と車でみとおしが、":4,"おわ、祭り囃子超近い。":5,"──やっぱ音楽は生音生ライブよね、\n太鼓に笛、\nこの身体の芯に響く感じ？[l]\nテンション上がるっつーの！[l]\nリズムだけでトランス入れるっつーの！":6,"音階楽器とか出来る前から、\nヒトは音楽に慣れ親しんで来たんだもんね、\n生命の根源を揺さぶる何かが、\nあんのよね。":7,"……ウタは魔法か。":8,"よっくわかってるわよ、●●ちゃん。":9,"えーとそれよか、どっちに行けば──":10},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_S_035.ks","relPath":"/data/scenario/SC_S_035.ks",