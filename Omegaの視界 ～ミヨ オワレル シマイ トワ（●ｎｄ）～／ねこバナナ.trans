start":2005,"end":2141}],[{"start":2155,"end":2212}],[{"start":2226,"end":2357}],[{"start":2421,"end":2553}],[{"start":2569,"end":2793}],[{"start":2809,"end":2853}],[{"start":2893,"end":2919}],[{"start":2958,"end":3014}],[{"start":3046,"end":3076}],[{"start":3090,"end":3148}],[{"start":3187,"end":3271}],[{"start":3311,"end":3424}],[{"start":3456,"end":3491}],[{"start":3507,"end":3557}],[{"start":3641,"end":3702}],[{"start":3716,"end":3815}],[{"start":3829,"end":3927}],[{"start":4000,"end":4025}],[{"start":4039,"end":4098}],[{"start":4112,"end":4177}],[{"start":4193,"end":4268}],[{"start":4282,"end":4342,"contextStr":"SC_M_003.ks/index/85/text","translation":""}],[{"start":4356,"end":4470}],[{"start":4486,"end":4549}],[{"start":4561,"end":4603}],[{"start":4709,"end":4756}],[{"start":4800,"end":4801}],[{"start":4813,"end":4814}],[{"start":4825,"end":4826}],[{"start":4838,"end":4886}],[{"start":4902,"end":5031}],[{"start":5071,"end":5144}],[{"start":5176,"end":5233}],[{"start":5247,"end":5285}],[{"start":5299,"end":5341}],[{"start":5381,"end":5447}],[{"start":5459,"end":5501}],[{"start":5541,"end":5602}],[{"start":5677,"end":5748}],[{"start":5760,"end":5811}],[{"start":5843,"end":5902}],[{"start":5914,"end":5939}],[{"start":6014,"end":6073}],[{"start":6085,"end":6141}],[{"start":6173,"end":6228}],[{"start":6268,"end":6349}],[{"start":6361,"end":6418}],[{"start":6450,"end":6521}],[{"start":6533,"end":6608}],[{"start":6620,"end":6684}],[{"start":6724,"end":6793}],[{"start":6805,"end":6856}],[{"start":6868,"end":6941}],[{"start":6953,"end":7005}],[{"start":7080,"end":7122}],[{"start":7162,"end":7180}],[{"start":7255,"end":7335}],[{"start":7367,"end":7618}],[{"start":7658,"end":7696}],[{"start":7728,"end":7779}],[{"start":7854,"end":7875}],[{"start":7907,"end":7947}],[{"start":8022,"end":8063}],[{"start":8103,"end":8171}],[{"start":8246,"end":8293}],[{"start":8333,"end":8368}],[{"start":8400,"end":8564}],[{"start":8639,"end":8720}],[{"start":8752,"end":8912}],[{"start":8991,"end":9222}],[{"start":9234,"end":9367}],[{"start":9383,"end":9459}],[{"start":9531,"end":9593}],[{"start":9625,"end":9727}],[{"start":9767,"end":9836}],[{"start":9848,"end":9881}],[{"start":9920,"end":9990}],[{"start":10022,"end":10080}],[{"start":10094,"end":10138}],[{"start":10152,"end":10226}],[{"start":10240,"end":10327}],[{"start":10343,"end":10415}],[{"start":10429,"end":10531}],[{"start":10545,"end":10576}],[{"start":10590,"end":10665}],[{"start":10679,"end":10758}],[{"start":10840,"end":10973}],[{"start":10987,"end":11076}],[{"start":11090,"end":11158}],[{"start":11228,"end":11256}],[{"start":11268,"end":11323}],[{"start":11355,"end":11360}],[{"start":11376,"end":11538}],[{"start":11550,"end":11573}],[{"start":11589,"end":11751}],[{"start":11765,"end":11790}],[{"start":11830,"end":11844}],[{"start":11860,"end":11969}],[{"start":11985,"end":12047}],[{"start":12089,"end":12092}],[{"start":12108,"end":12189}],[{"start":12203,"end":12268}],[{"start":12282,"end":12363}],[{"start":12377,"end":12384}],[{"start":12398,"end":12447}],[{"start":12461,"end":12510}],[{"start":12565,"end":12569}],[{"start":12583,"end":12627}],[{"start":12676,"end":12829}],[{"start":12845,"end":12874}],[{"start":12914,"end":12944}],[{"start":12959,"end":12960}],[{"start":12972,"end":12973}],[{"start":12985,"end":12986}],[{"start":12997,"end":13060}],[{"start":13092,"end":13129}],[{"start":13143,"end":13164}],[{"start":13178,"end":13228}],[{"start":13242,"end":13299}],[{"start":13313,"end":13371}],[{"start":13383,"end":13422}],[{"start":13436,"end":13460}],[{"start":13498,"end":13567}],[{"start":13581,"end":13625}],[{"start":13681,"end":13724}],[{"start":13769,"end":13940}],[{"start":14006,"end":14081}],[{"start":14113,"end":14302}],[{"start":14346,"end":14480}],[{"start":14494,"end":14556}],[{"start":14570,"end":14672}],[{"start":14725,"end":14820}],[{"start":14834,"end":14863}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_003.ks","basename":"SC_M_003.ks","indexIds":{"寒い。":0,"ホームに降りた時点で相当の冷気を感じる。[l]\n明らかに空気が違う。[l]\n澄んでいる。":1,"天候こそ今日は曇っていて、いいロケーションとは言い難いが、\nそれでも関東とは比較にならない。[l]\n遠方の景色が異常にクリアに見える。視線が抜ける。":2,"一際特徴的な山が":3,"九":4,"抱":5,"山で、\nあの麓が":6,"玄":7,"ノ":8,"森だ。":9,"呼吸してみても、空気が美味い。[l]\n都会の大通りでは深呼吸もままならないのに。[l]\nそうだ、記憶では水もさぞ美味かったはずだ。[l]\n飯以前に水が相当違ってた。[l]\n昼飯も抜いたことだし、さぞかし食事は堪能できることだろう。[l]\n都会の利便性とこれら、僕ならこっちを取るんだがなあ。[l]\n状況さえ許してくれればだが。":10,"にしても、":11,"「寒っ！[l]\n宮さんの脚見てると余計に！」":12,"上半身こそ上着を羽織ってるが、\n下はいつものミニのプリーツなうえに\n宮さん生足なんだもんな。":13,"女子はファッションの為ならば恐ろしき忍耐力を発揮するものだが、\n喜ぶ御仁もおられようが、\nこういう状況では端から見てると鳥肌立つな。":14,"まったくさすが北の地、４月上旬ではまだまだ寒い。[l]\n関東から来た所為で余計に温度差を感じてる部分もあるだろうが、\n上着を持ってこなかったのは失敗だったかもだ。[l]\nある程度想定はしていたんだが、ちょっと想像以上だった。":15,"「スケベですね。[l]\n見ないでください。":16,"それよりここ、乗り換え猶予はタイトなんです。[l]\n本数少なくて乗り損ねたら何時間も待つんですから、\n早く移動しましょう」":17,"持ってきた時刻表のメモを確認すると、\n確かに殆ど数分しか間がない。[l]\n宮さんの分の荷物も持って、\n別のホームへとダッシュする。[l]\n吐く息もまだ白いもんだ。":18,"前もって言われていたことではあるが、\n僕の携帯では、電波が入らなくなるらしい。[l]\n大手の旧普及型のがぎりぎり入るくらい。\n一応確認してみたが、\n…ああ、思いっきり圏外になってる。[l]\n結局緊急時には宮さんのを借りるということになっている。[l]\nいいんだ、どうせ掛けて来る相手も居ないことだし。[l]\n大神にも伝えてあるしな。":19,"１３年ぶりとなる玄ノ森はまだここからローカル線＋バスで一時間、\nまだここから全然遠いし、\n今の時点で懐かしさがこみ上げてくる、ということもない。[l]\n水の美味いのは覚えてるというのも、我が身ながら現金なことだ。[l]\n速読も得意だし、視覚記憶にはそれなりだと思ってたのだが、\n実際はそうでもないのかな。[l]\n単に成長につれ身につけたのか。":20,"乗り換えのローカル線のホームに着き、\nすでに停車中の列車に急ぎ乗り込む。[l]\nもはや列車もパンタグラフのある『電車』ではなく、\nディーゼルでしかも３車両しかないものになっている。[l]\nドアは押しボタンで降りる時は自分で開けねばならない。":21,"バスの方が余程近代的乗り物に見えるようなこの車両、\n平日昼間ということで、その閑散さたるや一際感じられる。":22,"ただ宮さんが言うには、サラリーマンこそ居ないが、\n登下校の時間帯は中高生の足としてそれなりに混雑するそうだ。[l]\nそもそも学校が、どう考えたってどこの家からも遠いのだ。[l]\n人口密度、家屋の建ってる密度が低いんだから当たり前なんだが。":23,"列車が走っている最中、窓の外をなんとなしに見ていた。[l]\n田圃の日陰の所には、いつ降ったものなのか、\nまだ雪が溶け残っている所もある。[l]\nふと思いついて、今一度九抱山を見ると、\n山頂や山肌にはやはり雪が相当残っているのだった。":24,"何かしら記憶の中の景色と照合しないかどうかと思っていたのだが、\nどうやら僕の脳には全く残存していないようだ。[l]\n失礼な言い方になるが、\nまさかこんな山中で、景色の側が変化したということは考えにくい。[l]\n第一、見える風景は、すべからく時の刻みをその場にたたえたままとしか思えない状態だ。[l]\n地形変化とて多少はあろうが、僕の視るモノ、その範囲全てにおいて、記憶との差違は起こすほどのことはないだろう。":25,"と思って、\n一応本家とも以前から交流のあるらしい、\n宮さんに訊いてみる。":26,"「宮さん、ここって、\n昔からこんなでした？」":27,"「んむ？[l]\nそうですね。[l]\n宮が知ってる間では、\nずいぶん変わりもしましたねー」":28,"おや。[l]\n色々思ってみたのに実際はそんなものか。":29,"とはいえ宮さんの『知ってる間』が、\n一体どのくらいの期間かは知れたものではないが、\nいくらなんでも…":30,"「まこくんは知狡のとこからあまり\n出歩かなかったと聞いてますよ。[l]\n変わっても変わって無くても、\nこの辺はわからないんじゃないですかねー？」":31,"「あ？[l]\nあー、そうでしたっけ？[l]\nあ、ああ、そうかも。[l]\nそうだ、うん旅館の建物とかは覚えてますね…[l]\nそうか、なんかずっと知狡さんとあそこで\n遊んでた覚えはあります」":32,"理由は覚えてないけど、\n確かに殆どあの敷地から出た記憶はない。":33,"と、『玄ノ森』と書かれたプレートが見えた。[l]\n次の駅で降りるのだ。僕の思考は中断された。":34,"無人駅かと思ったが、\nホームに車両が入ってくると奥から\n駅員さんが現れて、ようやく改札として機能しだした。":35,"壁からなにから、木造やトタンであって、\nそれが半朽し錆び付き、ヒト、自然、いろいろなモノの混じり合った匂いが。[l]\nまるで映画かドラマのロケーションでしか見たことが無いような景色。":36,"子供の頃は確かに此処にいたはずなんだが、\nとてもそうは思えない程の異国感がある。[l]\n埃で殆ど透過性の無くなったうえに、ひび割れてガムテープで補修してある硝子戸を開け、駅を出た。":37,"植物の、緑色。[l]\n花の花弁、様々な色。":38,"人工物が煤けて色褪せて見えるのとは対照的に。[l]\n自然物の色彩の、彩度が違う。[l]\n街とはまるで。":39,"そして音だ、\nもはや鳥の声と虫などの声、\n近くを流れている川の音しかしない。[l]\nここが―――玄ノ森だ。":40,"昔はどうだったか知らないが、\n駅前は寂れていて、\n今は本家や六母屋旅館のあるあたりに繁華の中枢がある。[l]\nそれは覚えてる。":41,"知狡さんや旅館辺りの事は、\nもはや僕に残された欠片のような唯一の記憶、\nただし食に関することを除く、だ。":42,"いや、それすらも知狡さんところの旅館に由来してる可能性はある。[l]\nま、行けば分かるさ。[l]\nやっと僕も懐かしがれるというものだ。[l]\n今までは謂われのない薄情感（なんだそれ）に苛まれていたからな。":43,"駅を出る。[l]\nするとびしっと、\nこの田舎の風景からは完全に浮いているスーツ姿の凛とした女性が僕らを見つけ、":44,"かつかつと（そう思えただけで、実際には草の生えた砂利道をじゃりじゃりと）歩いて来た。":45,"「お疲れ、久しぶりだな。[l]\nすこし痩せたか？[l]\n宮さん、ご苦労様です」":46,"飯":47,"窪":48,"知":49,"狡さん。[l]\n僕の母の姉、つまり伯母であり、\n玄ノ森の飯窪本家の現当主である。":50,"そんな知狡さんでも、なぜかかれお嬢のように、\n宮さんに敬語で接してるというのはどういう事情なんだ。[l]\nそれ以前に、この二人が直接話してるのは初めてみるかも知れない。[l]\nが、とにかく今は伯母との再会を喜べと僕の身体は言っている。":51,"「うわー、お久しぶりですただいまです、\nわざわざお出迎え済みません。[l]\nおひとりですか？[l]\n本家の人たちは他は？」":52,"懐かしさに自然と僕の顔も綻んでしまう。[l]\n若いなー相変わらず。[l]\n若いというか童顔なのか。":53,"母さんは年相応で、事あるごとに「姉さんのお陰で損してる」と愚痴るほどである。":54,"だいたいこの姉妹、外見も中身も似てないのだ。[l]\n特に中身は真逆に等しい。":55,"「今日は私が出ると言って、\n旅館任せてきたからな。[l]\n今はオフシーズンだが祭前の準備でそれなりに人手が居るんだ。":56,"まあ祭といっても…事情は聞いてるな？[l]\n何にしても良く来た、歓迎するよ」":57,"「そんな、それこそトップの人間がこんなことしてて\n良いんですか？[l]\n僕らのが怒られるんじゃないですか」":58,"「馬鹿言え、折角可愛い甥が久しぶりに戻ってくるというから、\n無理を言って来たんだぞ。[l]\n心配無用だ、みんな待ち侘びてるよ。":59,"そうだ、昼食はもう摂ったのか？[l]\n旅館まで待てないなら、近場の良い店に連れて行ってやるが」":60,"そういえば昼食と言われて、急に空腹感が出てきたな。[l]\n時計を確認したところ、\n…もう二時近いのか。":61,"それは腹も減る。というか喰ってないんだから当然だ。":62,"「わざわざお弁当我慢してきましたから。[l]\nこっちで食べますよ。[l]\nやぱり水が違いますからねー。":63,"旅館のごはんは夜の楽しみにとっておいて、\nとりあえずは店に行きましょう。[l]\nまこくんいい？」":64,"僕と同じような感想を述べて、宮さんは僕に確認してきた。[l]\nそうだよな、やっぱり水が違うんだよなー。":65,"「そうすね、全く異議なしです。[l]\n知狡さんのおすすめだったらどこでも美味いでしょう。[l]\n一人暮らし始めてからは特にろくなもの食べてないし。":66,"母親の有難味も今になって身に染みてますよ。[l]\n宮さん連れてってくれるのは安いチェーン店とかばっかだし」":67,"素直な気持ちを言えば、\n腹が減っていれば何を食べたって美味いと感じるだろうし、\nとにかく空転するこの脳味噌に糖分を補給したい、":68,"というのが正直な話であるが、\nさすがに口にはしない。[l]\n空転する我が脳髄でも、そのくらいの配慮をする程度には動いてくれてるようだ。":69,"多少の皮肉や冗句も交える余裕も何とか残っている。[l]\nんむ、と睨む宮さんをやり過ごし、\n知狡さんに笑いかけた。":70,"「あんな妹の料理でも恋しくなるものかな。あれの料理たるや…[l]\n…はは、まあいい。[l]\nさ、本家の者には説明してある。":71,"ひとまず本家に着いたら皆に挨拶だけでもしておいてくれ。[l]\n親父殿は懐かしがっているからな。":72,"真言が気にしないなら、そのまま本家で寝泊まりしても問題ないが、\n旅館に部屋はとってあるから、\nそっちで寝泊まりして貰って構わない。":73,"好きな方を選んでくれ。その場合勿論二人は別々の部屋だ。[l]\nま、宮さんは残念かも知れませんが」":74,"「いいです。[l]\n毎晩遊びに行きますもんね。[l]\n温泉て混浴？」":75,"「混浴風呂は露天に。水着着用ですが」":76,"「よしゃ、うひひ、\nスク水持ってきた甲斐がありますね。[l]\nどうせ祭まで客も少ないんでしょうから、\n当分まこくんと二人で楽しみまーす」":77,"いやな感じに仕返しか、宮さん。[l]\nスク水って大神語録で聞いた記憶があるが、\n…スクール水着？[l]\n……何持ってきてんだ。というか持ってたんだ宮さん。[l]\n真実見た目通りの女子学生なら変じゃないけどさあ…[l]\nいやまずそんなことより早く飯に行きましょうよ。[l]\nて、つい数日前もなんか似たようなことがあった気がするし…[l]\n何かと僕は食事に行くのを邪魔されてるな。[l]\n僕だけが食えない状況にされてる訳ではないだけマシだが。":78,"「あ、あのね…[l]\nほら、だって僕海パンなんか持ってきてないし…」":79,"もう抵抗も弱々しいものだ。[l]\nだから僕は、とにかく空腹になると脳も空転し出すんだってばさ。":80,"「案ずるな、\nロビーの売店にある」":81,"は？[l]\nいや、知狡さん、そこはまじめに反応戴かなくて結構なんですが…":82,"「んむぅ、まこくん乗り気じゃないなー。[l]\n宮の脚あんなに見てた癖にぃ」":83,"「み、宮さんこそ、\n僕に見て欲しいんですか欲しくないんですかはっきりして下さい。[l]\nスケベ呼ばわりしといて何を今更」":84,"「さあどうでしょうね？[l]\nいつの時代も男子はその辺判ってくれないですねぇ。[l]\n":85,"んむ、知狡、戯言はここまで。[l]\nさっさとご飯行きましょう」":86,"…いつの時代も女子はその辺教えてくれないからねぇ。[l]\n特に宮さんのテンションの遷移の読めなさっぷりたるや、\nまさに猫の目のようというやつだし。[l]\nそこいらの男子たる僕あたりでは到底判るわけもない。[l]\nともあれさっさとご飯に行くのにはまるで異論はないから、\n黙って付いていく僕。":87,"「真言が海産物苦手というのも覚えている。案ずるな。[l]\nこの辺りは…見れば判るがどちらかといえば山の幸だ。[l]\nさ、あのハイヤーに乗ってくれ」":88,"ハイヤーというか、\nま、田舎だからタクシーとほぼイコールの黒い車が、\n駅前ロータリー（と呼ぶのも気が引けるが）に待機していた。[l]\nしかし、ハイヤー…[l]\nたまたま僕が半端にアナクロだから知っていた単語だけれど、\nふつう僕らあたりの年代だと、既にハッカ並に通じない言葉ですよ？":89,"近くに来てみると、確かにタクシーとは違う、\n艶加減、黒さ。[l]\nちょっとだけだがブルジョアぽい気分になる。[l]\n知狡さんも、僕の食の嗜好よく覚えてるな…[l]\nと一瞬思ったが、\n最近、何かの時に母さんが電話でそういう会話をしていたのを思い出した。[l]\nそれでか。[l]\n詳細に言えば、僕は魚や海老、蟹は食べられるが、\n海草と貝類、ウニ等が大の苦手なのだ。[l]\n主に匂いと食感が原因。":90,"当然だが世間が下す高級度合いの評価などまるで無関係であって、寿司屋では割と安上がりに済ませられる訳である。[l]\n前、北海道の海鮮丼屋に入ったとき、\n僕は何も食べられるものがなくて大変だった。[l]\nという話をしてたんだったか母さんは、確か。":91,"ちなみに山菜は大好物なので、\nこれから行くところも、旅館の食事も期待できるだろう。[l]\nそしてようやく僕ら三人はハイヤーに乗り込んだ。":92,"「かれおったらまた連絡なしでうちにきて、\n大変でしたよっ。[l]\n知狡もちゃんとあの娘再教育しといて下さい」":93,"知狡さんは運転手さんに行き先を告げ、助手席へと収まる。[l]\n運転席の真後ろに宮さん、助手席の後ろに僕という席順である。[l]\n車が走り出すなり、宮さんはかれお嬢に対する苦言を呈していた。":94,"「すみません。[l]\n彼女の歪みもなかなか強固な部類でしてね。[l]\n有用な特質的能力の由来にも関わるだけに矯正もし難い。":95,"私らとしてはそこを買った訳で、\n…なかなか難しい問題です」":96,"「んむぅ、いちいち真面目に返さなくていいですっ。[l]\n愚痴です愚痴。[l]\nまー、かれおは今回よくやってくれましたけどぉ」":97,"特質的能力って、何かの漫画みたいな言い方だな知狡さん。[l]\n例の目的の本を探し出すってやつなんだろうけど。":98,"ま、人間得手不得手なんて、有限の力をどのスキルに振り分けるか次第、みたいな所もあるしな。":99,"最近よくテレビに出てる作家の本に、\n他人より優れた能力を発揮してる人間は、およそ何かしら欠落や不足している部分を持つものだと書いてあったが、":100,"サヴァンを例に出すまでもなく、\nヒトは足りない部分を補完すべくチカラを働かせるものなのだろう。[l]\n小難しい理屈を出さずとも、当然といえば当然の事ではある。":101,"先日のわずかな邂逅でも、かれお嬢にはスキルの偏りがあろうことは容易に想像できる。[l]\nま、だから『あの』大神とも合ったのかも知れない。":102,"それいうとそんな奴が大学唯一の友人だった僕自身は\nいったいどうなのかと自問しかけたが、\n自分のことなんて判らないし、判ったところで、\nその瞬間から僕が別物に変わるわけもないもんね。":103,"と心中で勝手適当に居直りつつ、\n僕は車窓を眺めていた。":104,"それにしても相変わらずこの人達の関係性が判らない。[l]\n使われてる立場のはずの宮さんの方が、どうみても上位に振る舞ってるように見えるよなあ。":105,"かれお嬢はまだしも、本家当主の知狡さんとのやりとりもこんなだし…[l]\nそれとも単に、\n我が侭娘と人間のできている女性、という見方でいいのか？":106,"………。[l]\nうーん。[l]\n大学入ってからは、乗用車には専ら運転手として乗っていたので、\n視点がいつもと違い落ち着かない。[l]\nさらに、中心地に近づいてきたのか、段々町並みの様相が変化してきた。[l]\n建物が増えてくる。":107,"今住んでいるところも関東圏とはいえ田舎の部類だが、\n玄ノ森のあたりまでくると、\nやはり空気や自然の感じは言うまでもなく、\n建物の高さが決定的に違う。低い。":108,"だから今の僕には、\n大気の透明度も相まって、距離感が狂った感じにみえる。[l]\nう、そんなことを考えてると酔い…そうだ…":109,"「あれ、まこくん顔色悪っ。[l]\n酔ったですか？":110,"いつもはドライバーですもんねー、\n久しぶりに後部座席乗ったからかなー。[l]\n…だいじょぶ？」":111,"さすさす。":112,"宮さんが背中をさすってくれる。[l]\n非常に有難くはあるのだが、\n知狡さんの手前もあるしこの状況は非常に恥ずかしいものがある。[l]\nいかんいかん。[l]\n僕は宮さんに礼を言ってさすりを辞退して深呼吸をする。[l]\n宮さんは心配そうに、首を傾げながら「ん？」と僕の顔を覗き込んだので、":113,"大丈夫です、と親指をグッと立てて彼女に示した。":114,"その後、酔いに対抗すべく車内で僕はテンションを上げ、\n普段より相当喋りまくった。[l]\nそろそろ旅館も近づき、記憶にあるものも出てきた事もあり、\nそういったものを見るたびに大はしゃぎしていた。[l]\nしかし、空腹も重なって脳の空転も最高潮だ。[l]\nちょっとやばいかも…と思い始める。":115,"そのとき、\n視界に黒衣の集団が映り込んだ。":116,"ああ、\n喪服なのだ。":117,"道路の、向かって左側の歩道を歩く彼ら。[l]\n進行方向が同じなので後ろ姿しか見えない。[l]\nあっという間に横を通り過ぎようとする僕らの車。[l]\nその刹那、その集団の中に一際目立つ存在を視た。":118,"少女なのか御婦人なのか、\n漆黒のドレスに包まれた女性が居たのだ。[l]\nその流れるように風に靡く、長い髪が。":119,"金色。":120,"光線の具合とか、光の反射ではなかった。[l]\n茶髪とかいうレベルでもない。[l]\n染めているのででもない限り、\n所謂あれはブロンドである。":121,"ここが田舎の山中だからといって、\n髪を染めてはいけないことはないし、\n外国人がいていけないということもないのだが。":122,"周囲の人々が極普通であるが故にか、\n先入観のせいか、僕の空転脳がそう思わせたのか、\n激しい違和感を感じ、\n思わずすれ違いざまに横を向く僕。":123,"目が合う―――":124,"顔立ちは日本人だが、髪色はやはりブロンド、\n怪我なのか病気なのか、左目には眼帯をしていた。":125,"そして僕を視る右目は、青。[l]\n深き青だ。[l]\nあれは、\n…？[l]\n":126,"っ痛ぅ！":127,"一瞬頭痛が走り、激しく眩暈がする。[l]\n酔った状態で急激に脳が稼働したせいか。":128,"が、それも瞬時の事で、僕らと黒衣の人々の距離はたちまち離れていく。[l]\n振り向いてまで確認するのは憚られたので、\n僕はしばし呆然とするしかなかった。[l]\n酔いは治まったようだが、何かを喋る気分ではなくなっていた。[l]\n悪い気分という訳ではないが、酷く冷めた感触がする。":129,"知狡さんが、何かを察してくれたのか、無言の僕に話しかける。":130,"「ああ、今。見たか？[l]\n彼女が三春家のご息女、\n":131,"三":132,"春":133,"冬":134,"夏さんだ。[l]\nあの御容姿は生まれつきだそうだよ。[l]\nここでは有名だが…ま、あまり触れないのが礼儀だな」":135,"言いたくはないが有力者の娘でもあるしな、と\n知狡さんは付け加えた。":136,"まさに、触らぬカミに何とやら、という奴か。":137,"酔いは引いても、空腹自体は当然まだ続いているわけで、\n僕の空転脳はお寒い駄洒落を紡ぎだした。":138,"喋る元気が無くなっていたのは、この場合幸いと言わざるを得まい。[l]\n口をついて顕現することは避けられた。":139,"いずれにしろ、彼女が、今回の目的たる三春家の人間ということらしい。[l]\n今後接触する可能性は高いのだろう。":140,"その時は――\n…その時だ。[l]\n今はとにかく腹を満たしたい。":141,"難しい事を思考できる状況ではもはやないんだって。":142,"「状況が状況だったから今日まで出来なかったようだが、\n密葬？　とでもいうのかな。[l]\n三春と系列の家の者だけが参加する。":143,"宿に到着して落ち着いてから詳細は説明するよ…っと、[l]\n着いたぞ、待たせたな」":144,"またややこしい話題になりかけるかと思ったが、\nやっと食事処に着いたようだった。":145,"車が入っていったのは、\nいかにも長距離運転手さん御用達といった感じの、\n広い駐車場とそれに似つかわしくない、小さな店構え。[l]\n………。[l]\nラーメン屋じゃんよ。[l]\nや、いいけどさあ。それでも。[l]\nでもあの言いぶりだと、\nもう少し違うものを期待してしまうでしょう、知狡さん。":146,"「何か言いたそうだな？[l]\nお前、ラーメンを見くびってはいかん。[l]\n美味いんだぞ、ここは。[l]\n特に山菜の入った――」":147,"店に入りながら熱弁を振るう知狡さん。[l]\nいや、僕もラーメン馬鹿にしてるつもりはないですし。[l]\nただ遠出先で紹介されるとは予想外だっただけです。[l]\n宮さんは…特に疑問を抱いてる風ではなかった。[l]\nもう既知の事だったのかも知れないが。[l]\n僕は席につき、知狡さんの勧めるがままのものを頼んでからは\nぐったりしていた。":148,"『空腹は最高の調味料』とは、\n料理人さんに対しては非常に失礼な言葉だと思うので、\n出来れば万全の状態にての評価を下したかったが、\n今日は仕方ない。[l]\nうん。美味かった。[l]\nしばらく滞在するのだから、また機会はあるだろう。":149,"ん、そうか、長期滞在者にとっては、\n下手にちゃんとしてる高い店よりは、\nこういった店を知っていた方が有用だ。":150,"そこまでの深慮があったとは、さすが知狡さん。[l]\nずっと旅館でご馳走になるわけにもいかないし。[l]\n宮さんはどうするつもりか知らないが、\n僕だけでも遠慮というものをしておこう。":151,"ああ、空腹による脳の空転が収まったと思ったら、\n血が胃に行って、これまた思考能力が低下中だ。[l]\n本家にまず挨拶に行くそうだが、\n旅館に着いたら速攻寝させて貰おう。":152,"…今後の事はとりあえず、今日は宮さんの目を盗んで。[l]\n":153},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_003.ks","relPath":"/data/scenario/SC_M_003.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":154,"length":154,"percent":100},"cellInfo":[null,null,null,[null,{"v":1}],[null,{"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"t":"HU"}],null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[56,2],"note":"完成"},"/data/scenario/SC_M_004.ks":{"data":[["局地的な疲労に誘発された突発的な睡眠は、\n少なくとも僕の場合は五分やそこらで事足りてしまうようで、","这种局部疲劳诱发的突发性睡眠，\n对我来说五分钟就够恢复了，"],["ラーメン屋から本家までの車中のうたた寝だけで、\n僕は覚醒してしまった。[l]\n大体その後本家で挨拶とかしてれば\nもう眠気なんか飛んでまうわ。","在从拉面店回本家的车上小憩片刻后，\n我就完全清醒了。[l]\n反正之后在本家寒暄时\n睡意肯定早就飞走了。"],["さて今は…だいたい五時か。[l]\n北の地でこの季節では、まだ陽もそんなに長くないのか\n結構暗くなってきてる。","现在大概…五点吧。[l]\n北方这季节天黑得早，\n外面已经挺暗了。"],["街明かりというものが単純に少ないのもあるんだろうが、\nその御陰で、星空は相当すごいのだ。","街灯本来就不多也是原因，\n但托这个福，星空特别壮观。"],["真冬時なんか気持ち悪いくらいに星だらけの空を眺望できる。[l]\nここじゃない北の地に旅行に行ったときはそれはもう、\n総毛立ちしたものだ。[l]\n西南だと田舎でもあまりそういう経験したことないんだが。","寒冬时节能看到满天星斗到瘆人的程度。[l]\n以前去更北边旅行时，\n那景象真是让人寒毛直竖。[l]\n西南乡下倒是没见过这么夸张的星空。"],["ああ、月がもう見えるな。","啊，月亮已经出来了。"],["「なんか、月の模様って猫に見えません？[l]\n兎の餅つきとかでなく」","「你们不觉得月亮纹路像猫吗？[l]\n而不是什么捣年糕的兔子」"],["僕は前から思っていた事を口にした。","我说出了长久以来的想法。"],["「んむ？[l]\nなんですか突然」","「嗯？[l]\n突然说这个干嘛」"],["「いや、深い意味はないんですがね…[l]\n僕はよく『ねこざんまい』から夜間自転車で帰りますから、\n月はしょっちゅう見てるんです。[l]\nそのうちそういう風に見えて来ちゃって」","「没什么深意啦…[l]\n我经常晚上从『猫三昧』骑单车回家，\n总盯着月亮看。[l]\n看着看着就觉得像猫脸了」"],["ま、今日は満月でもなければ、まだ明るい内だし、\n説明が難しい。","不过今天既不是满月，天色也还亮，\n很难说明白。"],["「猫。猫ねえ。[l]\nいいですねえ。猫。[l]\n古来、世界各地で月ともそれなりに関係は深いですしね。[l]\n諺とかでもね」","「猫啊。猫不错。[l]\n真好呢，猫。[l]\n自古以来世界各地都和月亮颇有渊源。[l]\n谚语里也常出现呢」"],["「ですねえ。[l]\nだから無意識的に据わりがいいと思ったのかも知れませんが。[l]\nま、戯言です。[l]\n聞き流してください」","「是啊。[l]\n可能潜意识里就觉得这种联想很自然吧。[l]\n算了，当我胡言乱语。[l]\n别放在心上」"],["「真言は猫好きなのか？[l]\n覚えてるかどうか知らないが、\n玄ノ森は猫に縁深き土地だぞ。","「真言喜欢猫吗？[l]\n不知道你还记不记得，\n玄之森可是和猫缘分很深的地方。"],["本、即ち紙をかじる鼠を退治する益獣として\n大事にされてきたからな」","作为啃食书本的老鼠的天敌，\n它们一直备受重视」"],["ああ、そういう話もあったですか。[l]\n昔、養蚕絡みでそういう話があったのを何かの本で\n読んだ気がします。","啊，好像是有这种说法。[l]\n记得在哪本书上看过，\n以前养蚕业兴盛时就有相关记载。"],["玄ノ森で特別そういう扱いだったかは、\n仰せの通り記憶にないけど。","不过玄之森是否特别重视猫，\n如您所说确实没印象了。"],["「だってまこくん、\n『ねこざんまい』の側の山に神社があるでしょう。[l]\nあれもその関係ですよ」","「因为小真，\n『猫三昧』旁边的山上不是有座神社嘛。[l]\n那个也是这层关系哦」"],["「そこまでは知らないですって、\n僕あそこに通ってまだ一年ですもん。[l]\nそんな神社あった事すら初耳ですよ…[l]\nおああーっ！」","「这我倒不知道，\n我才去那边一年而已。[l]\n连有这种神社都是头回听说…[l]\n哇啊啊！」"],["思わず奇声を上げてしまったが、\nそれもやんぬるかな、\n目の前にとうとう知狡さんの旅館『六母屋』が\n見えてきたからである。[l]\n今までとは違い、ここは記憶が鮮明に呼び起こされた為だ。","不禁发出怪叫，\n但这也是情有可原，\n因为眼前终于出现了知狡阿姨的旅馆『六母屋』，\n的缘故。[l]\n和之前不同，这里的记忆被鲜明地唤醒了。"],["それにしてもうわー全く変わってないな！[l]\nちょっとテンション上がる！[l]\nなつかし！！","不过话说回来哇啊完全没变嘛！[l]\n有点小激动！[l]\n好怀念！！"],["「んむう、びっくりするでしょまこくん。[l]\nまあいいです。[l]\n到着～ぅ」","「嗯哼，吓到了吧小真。[l]\n算了无所谓。[l]\n到站～啦」"],["「お疲れ、二人とも。[l]\n入り口で停めるから降りてロビーで待っててくれるか。[l]\n車庫入れしてくる」","「辛苦了，两位。[l]\n我在门口停车，你们先下车去大堂等着吧。[l]\n我去车库停好车就来」"],["「ん」","「嗯」"],["「わかりましたーっ」","「知道啦——」"],["外観こそ記憶にあるが、従業員さん達は勿論別だ。[l]\nが、僕は彼らには見覚えはないのに、\n向こうは僕の幼少時を知ってるふうの人も\n何人かいたようで、\nそして当然向こうは事情を知らされているようなので、\nロビーでとりあえず歓待された。[l]\nしかしこちらとしては、申し訳ないが彼らを全く存じ上げないのだった。[l]\nとにかく荷物をあらかた預けてソファーで知狡さんを待つ僕ら。","外观虽与记忆吻合，员工们自然都是生面孔。[l]\n可明明我对他们毫无印象，\n对方却有好几个人似乎\n记得我小时候的模样，\n而且显然他们已被告知内情，\n便在大堂受到了热情招待。[l]\n但恕我直言，实在对他们毫无记忆。[l]\n总之寄存完行李，我们坐在沙发上等知狡阿姨。"],["「改めてお疲れ、そしてようこそ。[l]\n早速部屋に案内しよう。[l]\n別々のな」","「再次说声辛苦，欢迎光临。[l]\n这就带你们去房间。[l]\n分开的两间」"],["「それはもういいですよ…[l]\n当然でしょ」","「这就不用强调啦…[l]\n不是理所当然嘛」"],["歩き出す知狡さんについて僕らも動き出す。[l]\n階上に上がるのだろう、エレベーターに乗り込んだ。[l]\n「閉」を押しながら宮さんがごねる。","随着知狡阿姨迈步，我们也跟上。[l]\n看来要上楼，便走进电梯。[l]\n按下「关门」键时宫小姐嘟囔着。"],["「んむーっ？！[l]\nつれないなあっ！[l]\n","「唔嗯——？！[l]\n好冷淡啊！[l]\n"],["くそ、お風呂は絶対一緒に入ったる、うひひ」","可恶，洗澡绝对要一起洗，嘿嘿」"],["「何の意地ですか…[l]\n人を助平呼ばわりしたくせに…」","「这什么胜负欲…[l]\n明明刚才还说别人是色鬼…」"],["しかもスク水とやら着用でだろ。[l]\n大神あたりは泣いて喜びそうなシチュエーションだけど。","而且还要穿什么死库水对吧。[l]\n要是大神在场怕是要感动哭的场景。"],["「まあ風呂の方は混浴と銘打ってる以上、\n私には抑止できる理由がないからな…」","「不过既然浴室标榜混浴，\n我也没有阻止的理由就是了…」"],["「はいはい分かりました。[l]\nじっくり見てやらあ、スク水とやらをぉ」","「好啦好啦知道啦。[l]\n我会好好欣赏你那套死库水的啦～」"],["「うお、開き直ったにゃ？[l]\n","「呜哇，破罐子破摔了喵？[l]\n"],["うひひ、とっぷり誘惑したるぜぇ」","嘿嘿，看我用尽全力诱惑你哟」"],["だから何の意地だ…","所以到底在较什么劲…"],["「露天だから声にも気を付けてくださいよ、宮さん。[l]\n警備は万全ですが、こちらから外に漏れ聞こえることは」","「因为是露天温泉所以宫小姐请注意音量，[l]\n虽然安保周全，但声音传出去就…」"],["知狡さんもどういう心配の仕方だ…[l]\nこの人も真面目が過ぎて、ある意味言動がギャグと化してるし。[l]\nと、彼女がある部屋の前で立ち止まった。","知狡阿姨这担心的方向也…[l]\n这人也是认真过头，言行反而变得像搞笑段子。[l]\n这时她在某间房前停步。"],["「さ、ここだな。[l]\n真言の部屋は。[l]\nエレベーターすぐ近くだから覚えやすかろう。[l]\n自販機もあるが…すまないが勿論有料、自腹で頼む」","「来，就是这儿。[l]\n真言的房间。[l]\n离电梯很近应该好记。[l]\n虽然有自动贩卖机…抱歉当然要自费哦」"],["「勿論です…ってか水とか茶ばっか飲むつもりですけどね。[l]\nこっちの水は美味いんで。[l]\nええと部屋番号…じゃなくて名前か。[l]\n…うあ？『火車』？」","「当然啦…不过我只打算喝喝水或茶什么的。[l]\n这边的水可好喝了。[l]\n呃房间号码…不对是名字啊。[l]\n…呜哇？『火车』？」"],["え、えらい物騒な名前でないか？[l]\nひのくるま？[l]\nや、まてよ。[l]\nどっかで見た字面だぞ。","喂、这名字听起来超危险的吧？[l]\n火之车？[l]\n等、等等。[l]\n这字眼在哪儿见过啊。"],["「『かしゃ』、だな」","「是叫『饿者』吧」"],["「妖怪ですよ妖怪。[l]\n玄ノ森に限らずにこの地方、\n民俗学系の観光資源で売ってるし観光客にも通りが良いのです。[l]\nマニア垂涎。[l]\n宿泊部屋の名前がオール妖怪の旅館『六母屋』！」","「是妖怪呀妖怪。[l]\n不光玄之森这一带，\n民俗学类的观光资源很受欢迎游客也容易接受。[l]\n让爱好者垂涎。[l]\n所有客房都用妖怪命名的旅馆『六母屋』！」"],["………。[l]\nや、やはりそうか。[l]\n幼少時は宿泊部屋なんか来なかったし、\n字が読めなかったから…","………。[l]\n果、果然是这样。[l]\n小时候没来过住宿区，\n又不识字所以…"],["と、いうことは…","那、这么说来…"],["「あ、あっちの部屋は\n『姥が火』で、\nこっちが『鳴家』…」","「啊、那边房间是\n『姥火』，\n这边是『鸣家』…」"],["「同じフロアには\n『生霊』『死霊』『幽霊』もありますな」","「同楼层还有\n『生灵』『死灵』『幽灵』呢」"],["「どっかの階には『邪魅』とか『おとろし』とかあるんだ？[l]\nおっかないよ…」","「某层还有叫『邪魅』或『妖物』的家伙？[l]\n超吓人的…」"],["「ちゃんと『日の出』とか、最上階に『宝船』とかもありますよ？」","「也有正经的『日出』，顶楼还有『宝船』呢？」"],["「さっき真言が猫好きだと分かったし、偶然だが丁度いいだろう。[l]\n生憎一階の『猫又』は埋まってるんだ。人気があってな」","「刚才发现真言喜欢猫，虽然偶然但正合适吧。[l]\n可惜一楼的『猫又』住满了。人气太高啦」"],["それはちょっと無理がありませんか…[l]\n大体そこまで好きと言った覚えはないです…","这安排是不是有点勉强…[l]\n我应该没说过喜欢到那种程度…"],["「『五徳猫』も最上階ですからねー」","「『五德猫』也在顶楼呢ー」"],["単に人気がない部屋が空いてたんでしょ…","纯粹是没人气的房间空着吧…"],["「いや真言、物好きな人種は結構全国にいるんだ。[l]\n『逢魔時』なんかを指定でくる客もいるんだからな」","「哎呀真言，猎奇爱好者全国各地都有啦。[l]\n还有专门指定要『逢魔时』的客人呢」"],["「…まあ僕もお二人と話が通じてる時点で物好きの一人ですけど。[l]\nいいですよわかりました…[l]\n――部屋に絵が飾ってあるとかないですよね？」","「…不过我能和二位正常交流也算猎奇派了。[l]\n好啦知道啦…[l]\n――房间里该不会挂着画吧？」"],["「先代含め昔からやりたかったらしいが、\nいろんな問題があってそれは無い。[l]\n安心するがいい」","「包括前任在内早就想这么干，\n但各种原因没能实现。[l]\n尽管放心」"],["やろうとはしたんだ…『姑獲鳥』とか夜怖そうだな…","居然尝试过…『姑获鸟』什么的晚上会吓死人吧…"],["「はいはいまこくん、次は宮の部屋にご案内ーっ。[l]\n","「好啦好啦真酱，接下来带你去看宫的房间ー。[l]\n"],["いつでも来られるように覚えてくださいよ？うひひ。","要记住位置随时能来哦？嘿嘿。"],["『白沢』でしたね？」","『白泽』对吧？」"],["「そうです。[l]\n結構上の階で」","「没错。[l]\n在挺高的楼层」"],["………。[l]\n僕みたいな人間にとっては部屋番号よりも、\nこっちのほうが嫌でも覚えはするだろうな、覚えは…","………。[l]\n对我这种人来说比起房号，\n这种命名方式就算不情愿，大概也会记住吧，会记住…"],["旅館とはいえ結構高層なこの建物だが、\n部屋の内装自体は『和』でばりばりなので、\n上層に行くほど景色との違和感が出る。[l]\n今いるこの『白沢』もそうだ。","虽说是旅馆但楼层颇高，\n房间内部倒是纯和风，\n越高越觉得和窗外景色不搭。[l]\n现在这个『白泽』房也是。"],["「おおー、\nもう暗いからあんまりよくわかんないですが、\n晴れた昼間なんかすごそうですね、展望が。[l]\nすごい変な気分ですけど内装とのギャップで」","「哇哦ー\n天黑看不太清楚，\n不过晴天白天的观景应该超棒吧。[l]\n虽然和室内装潢反差太大感觉超诡异」"],["返事がなかったので振り向いてみると、\n宮さんはうろうろと畳の上を歩き回りながら\n何事かつぶやいていた。","没得到回应转头看去，\n见宫小姐正踩着榻榻米来回踱步\n念念有词说着什么。"],["「猫、猫は洋の東西を問わず怪しきものとされてきた。[l]\n人の死体にかかずらう所作のせいで、\n死、葬儀には昔から関連づけられる。[l]\n瞳孔の拡縮は満ち欠けに喩えられて月にも関係が深い。","「猫、猫是不分东西方都被视为诡异的存在。[l]\n因为会摆弄人类尸体的习性，\n自古以来就与死亡、葬礼相关联。[l]\n瞳孔的缩放被比作月相盈亏，与月亮也渊源深厚。"],["養蚕の守護。[l]\n猫の女神。[l]\n猫の王。","养蚕业的守护者。[l]\n猫之女神。[l]\n猫之王。"],["魔女の使い魔。[l]\n九つの魂を持つ。[l]\n善き白き猫、不吉な黒き猫。","魔女的使魔。[l]\n拥有九条命。[l]\n吉祥的白猫，不祥的黑猫。"],["猫は――いいですねぇ」","猫啊――真是美妙呢」"],["と、突然僕に振ってきた。","突然把话题抛给了我。"],["「はい？　あ、前半よく聞こえなかったんですが、[l]\nもういいですって僕の猫好きの話は。[l]\nというかだからそんな格別好きなわけではないし。","「啊？前半段没听清，[l]\n不过关于我喜欢猫的话题可以结束了。[l]\n或者说我也没特别喜欢到那种程度。"],["まあ…いいはいいと思いますよ。[l]\n僕は犬よりは猫派ですから」","嘛...确实还算喜欢吧。[l]\n毕竟比起狗我算是猫派」"],["「蠱物としても太古から特別な扱いされてる、って話ですよ。[l]\n世界的、普遍的な規模でね」","「是说作为蛊物从远古时代就受到特殊对待，[l]\n在世界范围内都具有普遍性呢」"],["みやーおぅと、猫っぽく手招きして見せる宮さん。[l]\nああ、この人なんか今更ながら猫っぽいな。[l]\n典型的な猫顔（？）だし。[l]\n自分のことを宮宮いうもんだから尚更だ。","宫小姐发出喵呜声，像猫一样朝我招手。[l]\n啊，这人现在看起来莫名像猫。[l]\n典型的猫颜（？）。[l]\n加上她总自称宫宫（miyamiya）就更像了。"],["「干支からはあぶれてますけどね。[l]\n架空動物が入ってるのに」","「虽然没被列入十二生肖。[l]\n明明连虚构动物都入选了呢」"],["「んむー？[l]\n","「嗯喵～？[l]\n"],["うひひ、竜も鼠も猫に狩られる運命ですよーだ。","嘻嘻，龙和老鼠都是会被猫狩猎的命运哟～"],["なんてね」","开玩笑啦」"],["窓の桟にぽふっと腰掛けて、こちらを見る。","她轻巧地坐上窗框，朝这边望来。"],["「さっきの『火車』で思い出したのでちょっと思索に\n耽ってみました。[l]\nさて今後の事ですが。[l]\n","「刚才的『火车』让我想起些事情，\n稍微沉思了一会儿。[l]\n关于后续安排，[l]\n"],["お酒が入ると面倒なのでご飯の前に軽く話しておきます」","趁还没喝酒先简单说明下，免得喝醉后麻烦」"],["この場合、宮さんではなく僕の飲酒だ。[l]\n宮さんも、もしかするともう飲める齢かも知れないが、\n少なくとも僕の前でそういうことをしたことはない。","这里指的是我喝酒的情况。[l]\n宫小姐说不定已到饮酒年龄，\n但至少从未在我面前喝过。"],["以前「宮は飲めないんですぅ」と言われたことがあるも、[l]\nどっちの意味かわからんし。[l]\nちなみに僕は四月の生まれなので、先日ようやく、\n法的に飲酒を許される身となった。","虽然以前说过「宫不能喝酒啦」，[l]\n不知具体指哪种意思。[l]\n顺带我是四月生日，前几天刚达到\n法定允许饮酒的年龄。"],["ま、しかしあれだ、この前の大神とかれお嬢との飲み会が\nあったように、今までもたまーに、口を湿らす程度にね。[l]\nあはは。","不过像上次和大神、卡蕾欧小姐的酒会，\n其实之前也偶尔会小酌几口啦。[l]\n啊哈哈。"],["ちなみに僕は全く強くない。下戸も下戸。\nハイになるのが楽しいだけ。","顺带一提我酒量极差，属于一杯倒。\n只是喜欢微醺的感觉。"],["「ああ、はい。[l]\nまず例の三春家とやらに？」","「啊，好的。[l]\n先处理那个三春家的事？」"],["「んー…、[l]\nそれはやってはみますがほぼ無駄でしょうね。[l]\n葬式はしたようですから捜査に一段落はついたかも\nしれませんが事件が解決したのではないですし、\nもみ消しにかかるにしても祭がいつになるかは、\n現状不明です。[l]\nなので」","「嗯…[l]\n虽然会尝试但估计白费功夫。[l]\n葬礼似乎办完了，调查可能告一段落，\n但事件本身并未解决，\n就算要掩盖，祭祀何时举行\n目前仍是未知数。[l]\n所以」"],["「ええ。[l]\nだらだら観光してきてね☆と？」","「诶。[l]\n意思是让我悠闲地观光回来吗☆？」"],["「んむう残念。[l]\nまこくんにはお仕事を与えましょう」","「嗯喵～遗憾。[l]\n要给小真安排工作哦」"],["うえ。[l]\nお仕事、嫌な言葉ですこと。[l]\nまあ無為に過ごして気の引ける日々を過ごすよりは\nましか。","呜诶。[l]\n工作，真是讨厌的词。[l]\n不过总比无所事事良心不安地度日\n强些吧。"],["「前に説明しましたが、\n『","「之前解释过，\n『"],["月 ","月 "],["狂 ","狂 "],["跳 』とは飯窪が探してるある特定の資料群の総称ですが」","跳 』是指饭洼正在寻找的某类特定资料的总称」"],["そう聞いている。[l]\n今回のそもそもがそれなのだ。","听说是这样。[l]\n这次的事情原本就是为此。"],["「具体的に言います。[l]\n蠱物としての猫に関する伝承、文献、それこそ洋の東西問わず。","「具体来说。[l]\n关于作为蛊物的猫的传说、文献，甚至不分东西方。"],["古代においては『猫の女神』、\n中世西洋では『魔女の猫』として、\n東洋、特にこの辺りの國では伝承上『猫鬼』と呼ばれる魔猫。","在古代被称为『猫之女神』，\n在中世纪西方则是『魔女之猫』，\n在东方，特别是这一带的国家传说中被称为『猫鬼』的魔猫。"],["屍を操り九つの生命を持つ死に近しい存在。[l]\nそういった伝説伝承の類の記述や図像を飯窪は集めていて、\nそれを宮達は『月狂跳』と呼びます」","操纵尸体、拥有九条命的接近死亡的存在。[l]\n饭洼一直在收集记载这类传说的描述和图鉴，\n而我们称之为『月狂跳』」"],["猫鬼とは、メジャーではないが確かに昔本で見た覚えがある。[l]\nそういった系の話だったかどうかは微妙だが。","猫鬼，虽然不算主流但确实记得曾在古籍里见过。[l]\n至于是不是同类故事就不好说了。"],["他はそっち系ではまあ普遍のネタではあるが、\n羅列されると確かに猫というのはなかなかにオカルトめいた扱いには事欠かないのだな。","其他方面倒算是这类题材的普遍设定，\n但被这么罗列出来，猫这种生物确实从不缺乏神秘学色彩啊。"],["しっかし飯窪本家、なにゆえそんな事をしてるんだ。[l]\n本好きだけでなく、猫も大好きだというのか。[l]\nそしてどこをどういじるとそれが『月狂跳』という呼び名になる？","不过饭洼本家为啥要搞这种事？[l]\n不仅爱书成痴，难道还痴迷猫咪吗？[l]\n而且究竟要怎样捣鼓才会变成『月狂跳』这种称呼？"],["と、まだ宮さんの説明は続いていた。[l]\nはいはい思考中断。面倒くさいことはしないんだ僕は。","正当我这么想着，宫小姐的说明仍在继续。[l]\n好好好停止思考。麻烦事我可不想掺和。"],["「ここ玄ノ森は書蔵守というくらいでしたから、\n昔から鼠対策に猫は珍重されていて…という話は\nさっき知狡がしていた通りです。","「玄之森这地方既然被称为书藏守，\n自古就因防鼠而珍视猫类...这类说法\n刚才知狡已经提过了。"],["その手の資料足り得るものが祭の他にもあるとは\n思いませんか？","您不觉得除了祭祀之外，\n应该还有其他相关文献留存吗？"],["飯窪がこの地に落ち着いたのは三春ほどは古くない\nですし、取りこぼしや三春の『隠し』がどこかに\nある可能性は、十分とはいえませんがあります」","饭洼家在此地扎根不如三春家久远\n说不定会有遗漏，或是三春家有所‘隐瞒’的情况，\n这种可能性虽说不能说完全存在，但也是有的。”」"],["「分かりましたよ。[l]\nどうせ知狡さんの僕に対する援助の名目と一緒でしょ。[l]\n只で飯は食わせないが、やらせることはガキの使い――」","「明白了。[l]\n反正和知狡阿姨给我援助的借口一样吧。[l]\n不会让我白吃饭，但派活时就把我当跑腿小鬼――」"],["「うひひ、折角宮が真面目に盛り上げようと思ったのにー。[l]\n","「呜嘻嘻，难得人家那么认真想活跃气氛呢～[l]\n"],["事実を言っちゃ興ざめですよぅ」","被你说穿真相多扫兴呀～」"],["別段問題ないけどさ。[l]\n大学まで辞めてまでここに来て、\n何もしないでいる方がよほどプレッシャーだよ。","倒也没什么问题。[l]\n毕竟我连大学都退了跑来这儿，\n要是整天无所事事反而压力更大。"],["「でもあながちあり得ない話ではないですから。[l]\nそれと玄ノ森の――有力者の家々、\n","「不过这种可能性确实存在。[l]\n另外对玄之森的――权贵家族，\n"],["つまりくだんの三春の系列にはそれなりに気を遣ってください。","也就是那个三春家的派系还请多加留意。"],["女子だらけの家系で華やかではありますが、\nこんな小さな町でトップに睨まれると面倒ですからね。[l]\n努々心してください」","虽然全是女性的家族看起来很华丽，\n但在这种小镇被顶层势力盯上会很麻烦。[l]\n请务必谨记于心」"],["「おっかないですなあ。[l]\nま、気を付けます。[l]\nそうかー女子だらけ、ねえ…」","「真可怕啊。[l]\n行，我会注意。[l]\n原来全是女性啊...」"],["さっきのブロンド少女を筆頭に、という訳か。[l]\nそういや飯窪も、直系の男子である僕はレアだそうだし、\n…なんか水にへんなもんでも混じってんじゃないのか、[l]\nこの辺て。","以刚才那个金发少女为首是吧。[l]\n说起来饭洼家也是，据说像我这样的直系男性很罕见，\n...该不会是水里掺了什么奇怪的东西，[l]\n在这一带。"],["美味いのに。","明明很好喝的说。"],["それこそ猫の呪いとかだったら嫌だな。[l]\n『三毛猫の雄』の話もあるしな。[l]\nあれは遺伝の関係か何かだったと思うが、\nああ、そういう物理的な原因も考えられるか。","要真是猫的诅咒之类就恶心了。[l]\n毕竟还有『三花猫的雄猫』的传说呢（译注：三花猫多为雌性，雄性极为罕见）。[l]\n记得是遗传学原因什么的，\n啊，这么说物理因素也要考虑吗。"],["と、また思索に入りかけた僕の耳に宮さんの声が届く。[l]\n毎度の事ながら僕はあっさり思考中断する。","正当我又要陷入沉思时，宫小姐的声音传入耳中。[l]\n和往常一样，我立刻中断了思考。"],["「まーまー、真面目に調査しようと思ってたら、\nはじめからかれおに頼んでますからっ。[l]\nまこくんは気負わずお仕事してください。[l]\n祭の日程が確定するまではさしあたってそれで。[l]\nあとね…」","「好啦好啦，要是真想认真调查的话，\n从一开始就会拜托卡蕾欧啦。[l]\n小真不用太有压力，轻松工作就好。[l]\n在祭典日程确定前暂时先这样。[l]\n还有啊...」"],["「はい、なんでしょ？」","「嗯，什么事？」"],["「そういった訳で、しばらくは昼間、宮とまこくん別行動です。[l]\n宮もちょっとすることがあるんで。[l]\n夕飯は六母屋で食べるしそれからはここ、『白沢』に居ますから、\n何かしら進展あったら、んむ、","「是这样，接下来一段时间的白天，宫和真仔要分开行动哦。[l]\n宫也有些事情要处理。[l]\n晚饭在六母屋吃，之后会待在这里的『白泽』，\n如果有什么进展的话，嗯，"],["無くても夜なら来て構いません」","就算没有进展晚上也可以过来」"],["「じゃ、今日は僕軽く散歩でもしてきますよ。[l]\nもう暗いですけど、その辺の河川敷うろつくだけなんで。[l]\n昼間は座りっぱなしで足腰固まっちゃって」","「那今天我就随便散个步吧。[l]\n虽然天已经黑了，不过也就是在附近的河堤晃晃。[l]\n白天一直坐著腿都僵了」"],["「あ、じゃ今のうちに携帯。これです。[l]\n滞在中はこれで。[l]\n宮とか旅館とか、主要な番号はメモリーに入れときましたから」","「啊，趁现在把手机给你。这个。[l]\n这段期间就用这个。[l]\n宫和旅馆之类的主要号码都已经存进去了」"],["「ああ、ありがとうございます」","「啊啊，谢谢您」"],["最近の過剰とも言えるスタイリッシュさなどとは無縁の\n旧世代の機種だったが、最新機種のサービス内容では、\n逆にここでは使えないのだから仕方ない。","这台与近年过度追求时尚的风气无缘的\n旧世代机种，但反过来说最新机种的服务内容\n在这里反而用不了，所以也没办法。"],["どうせ借り物だし、誰に色気を振りまくでもないし、\nまるで問題はない。[l]\n素直に受け取った。","反正只是借来的，又不需要撩谁，\n完全没问题。[l]\n我老实收下了。"],["「寂しくなって電話してきても、さっきの通り昼間は相手できるか\nわかんないですけど、泣かないでねまこくん？[l]\n","「就算寂寞打来电话，白天能不能接就像刚才说的\n我也不知道，不过别哭喔真？[l]\n"],["夜には会えるから」","晚上就能见面了」"],["メールと写メくらいは使えるそうだし、\nいざという時にはメールしてくださいという宮さん。","据说至少能传邮件和照片，\n宫小姐说紧急时就发邮件。"],["「はいはい。[l]\nせいぜい気張りますよ。[l]\nじゃあ宮さん、行ってきます」","「好啦好啦。[l]\n我会尽量加油的。[l]\n那宫小姐，我出发了」"],["「んむ、いってらっさーい」","「嗯，路上小心ー」"],["部屋を出て、なにげに携帯を開いてみると、","走出房间，随手打开手机一看，"],["「………」","「………」"],["宮さんの体操着＋ブルマ姿の写真が待ち受け画面に設定されていた。","待机画面被设成了宫小姐体操服配运动短裤的照片。"],["僕は黙って待ち受けをデフォルトに設定し直し、\nロビーへ向かった。","我默默把待机画面重置为预设，\n往大厅走去。"],["当然だがやっぱ寒いわ。[l]\n真冬だったらどれだけ下がるのか、ここの気温。[l]\n…うう、３０分くらい歩いたら戻ろう。","当然还是很冷啊。[l]\n要是隆冬时分这里的气温会降到多低呢。[l]\n…呜，走个三十分钟就回去吧。"],["１０分もすると、\n来るときにも見た大きめの橋があったので、\n歩道の欄干に寄りかかり遠くを見渡した。","走了约十分钟，\n看到来时也见过的那座大桥，\n便靠在人行道的栏杆上眺望远方。"],["ほとんどシルエットでわからないが、\n昼間の曇りは晴れたらしく、夕焼けが美しい。[l]\nもう少しすれば、満天の星空が拝めるのだろう。","虽然几乎只剩轮廓看不清楚，\n但白天的阴云似乎散了，晚霞很美。[l]\n再过不久就能看到满天星空了吧。"],["と、そこに人影があった。","这时，那里出现了人影。"],["「…真言か」","「…真言吗」"],["先ほどまでとは違い、ラフな服に何故かエプロン姿の知狡さんが、\nそこに立っていたのだった。","和刚才不同，穿著休闲服却不知为何围著围裙的知狡阿姨\n正站在那里。"],["「知狡さんでしたか、びっくりしましたよ。[l]\n…半袖すげえ寒そうなんですが」","「原来是知狡阿姨，吓我一跳。[l]\n…穿短袖看起来超冷的」"],["「ん？[l]\nもう春だぞ。この程度どうということはない。[l]\nそれに、今日の夕餉には私も一品くらい振る舞おうと\n思ってな。[l]\nちょっとばかり奮闘したのさ。[l]\nそれでちょっとクールダウンしに来た」","「嗯？[l]\n已经春天了。这点程度不算什么。[l]\n再说，今天的晚饭我也想\n至少做一道菜。[l]\n所以稍微努力了一下。[l]\n现在是来稍微冷静一下」"],["さらっと言うが、地元民でもそれはどうなの。[l]\n山には雪とか残ってるのに。[l]\nそれはさておきへえ、知狡さんが。料理。[l]\n母さんの場合は、慣れ親しんだとはいえ決して美味い部類では\nなかったが、果たして姉たる知狡さんはどうなのか。","说得轻松，但当地人这样也未免。[l]\n山上都还有积雪呢。[l]\n先不说这个，嘿，知狡阿姨下厨。[l]\n母亲做的菜虽然吃惯了，但绝对算不上好吃，\n不知道身为姐姐的知狡阿姨手艺如何。"],["「へえ、楽しみですね。[l]\n奮闘って表現が若干気になりますけど」","「嘿，真令人期待。[l]\n不过『努力』这说法让人有点在意」"],["あはは、と笑う僕を、\nいつもの真面目なままの視線で知狡さんが\n見ている。[l]\nそして、","我哈哈笑著，\n知狡阿姨用一如既往认真的目光\n看著我。[l]\n然后，"],["「なあ、真言」","「喂，真言」"],["と幾分張りつめたトーンで僕の名を呼んだ。","她用略显紧绷的语调呼唤我的名字。"],["「この世界に――ヒトの世に生きるのは、\nなかなかに面倒なことだと思う」","「活在这个世界上――人类的世界里，\n我觉得是件相当麻烦的事」"],["は？[l]\nい、いきなり深淵なテーマですか？[l]\n…ど、どう反応していいのか分からない。","哈？[l]\n突、突然就探讨这么深刻的主题吗？[l]\n…完、完全不知道该怎么回应。"],["「…物事もなるようにしかならん。[l]\nだがそれでも、\n諾々と流されるに任せるか抗うか、\n想うのは個人個人だ。","「…事情只会按它该发展的方向发展。[l]\n但即便如此，\n是随波逐流还是奋起反抗，\n这取决于每个人的想法。"],["お前がいかなる価値を以て世界を視るか、\nそれ次第だ。[l]\n同時に全ての他人が各々の眼を以て世界を視ているとしてもだ」","你以怎样的价值观看待这个世界，\n全在于你自己。[l]\n即使所有其他人也都用各自的眼睛观察着这个世界」"],["「…何かあったんですか？[l]\n知狡さん…」","「…发生什么事了吗？[l]\n知狡阿姨…」"],["あからさまに逃げだが、そう言ってみた。","明显是在转移话题，但我还是这么问了。"],["「…ふ。[l]\n何でもないさ。[l]\n少々愚痴ってみただけだ。","「…呵。[l]\n没什么大不了的。[l]\n只是稍微发发牢骚罢了。"],["さ、夕飯にしよう。[l]\n明日からは旅館モノではなく普段の食事になるからな。[l]\n今宵のうちに存分に堪能しておけ」","来，吃晚饭吧。[l]\n从明天开始就不是旅馆料理而是普通伙食了。[l]\n今晚就尽情享受吧」"],["「は、はあ…」","「好、好的…」"],["結局知狡さんの真意は分からずじまいだったが、\n追求しても始まらない。[l]\n気にはなるが、本人がシーンシフトしたんだからそれに従う事にする。[l]\nそう、そろそろ僕もまた腹が減って、\n脳が空転しだしてしまうし。[l]\n星が見え出した空を見ながら、僕ら二人は旅館へ戻った。","最终也没能明白知狡阿姨的真实意图，\n但继续追问也无济于事。[l]\n虽然在意，不过既然本人切换了话题，我也就顺势而为。[l]\n况且，我也差不多饿得\n脑子开始空转了。[l]\n望着繁星初现的夜空，我们二人回到了旅馆。"],["夕餉は豪華で、普通に客として頼んだらいくらかかるのか\n怖くなるくらい大変に美味だった。[l]\nたった一つの点を除いては。[l]\nなんという料理名かももはや意味はない。記憶にもない。[l]\n詳しい描写は避けるが（筆舌に尽くし難しともいう）、\n知狡さんがわざわざ奮闘して作ってくれた一品、\nそれこそがまさに究極の汚点、\nあやうくすべてを台無しにしかけた恐ろしき代物だったのだ。","晚餐丰盛得令人害怕——若以普通客人身份点单\n不知要花多少钱——美味得惊人。[l]\n除了一点之外。[l]\n那道菜叫什么名字已经不重要了。连记忆都不愿留存。[l]\n虽避免详细描述（或者说难以言表），\n但知狡阿姨特意奋力烹制的那道菜，\n正是堪称终极的污点，\n差点毁掉整场宴席的恐怖存在。"],["旅館の人間だ、という先入観が、\n致命的な錯覚を僕に与えていたらしい。[l]\n普通、宿泊場の料理は料理人がつくるもんだ。","对旅馆人员先入为主的观念，\n似乎让我产生了致命的错觉。[l]\n按理说住宿场所的料理本该由专业厨师制作。"],["知狡さんみたいなトップの役職の人間が手がけることなんかそうそうないんだ。","像知狡阿姨这样的高层人员亲自下厨实属罕见。"],["気付くのが遅かった！[l]\n母さんの料理を上から見るような発言するもんだから、\nてっきり違うのかと思ったら、\n結局似たもの姉妹じゃないかよ。","发现得太迟了！[l]\n都怪我说出看不起老妈厨艺的言论，\n还以为会有所不同，\n结果你们姐妹根本半斤八两嘛。"],["いや、食えるだけ母さんのがマシだ。[l]\nこのことは宮さんすらも知らなかったらしく、\n僕ら二人は悶絶しつづけ、残りの料理でなんとか\n相殺しようと必死に喰いまくったのだった。","不，老妈的至少还能吃。[l]\n看来连宫小姐都不知道这事，\n我们二人持续痛苦挣扎，拼命用其他菜肴\n试图抵消那恐怖滋味。"],["「ちゃんと味見はしたぞ…」","「我有好好试过味道的…」"],["「その事実の方が問題ありますよ…」","「这才是问题所在吧…」"],["「んむぅーっ、もうっ知狡は今後一切料理禁止！[l]\nもし旅館でこれだしたら営業に関わりますよ。[l]\n禁止禁止！知狡はエプロン禁止ーっ！！」","「唔嗯——！以后绝对禁止知狡下厨！[l]\n要是在旅馆端出这种东西会直接影响营业的。[l]\n禁止禁止！知狡永久禁止系围裙！！」"],["「申し訳有りません…」","「非常抱歉…」"],["今夜は美味い料理と温泉、と思っていたが、\nこういった訳で風呂はお預けになったとさ。[l]\n","原以为今夜能享受美食与温泉，\n但因为这个插曲，泡澡计划只好搁浅。[l]\n"]],"context":[["SC_M_004.ks/index/1/text"],["SC_M_004.ks/index/3/text"],["SC_M_004.ks/index/5/text"],["SC_M_004.ks/index/7/text"],["SC_M_004.ks/index/9/text"],["SC_M_004.ks/index/11/text"],["SC_M_004.ks/index/13/text"],["SC_M_004.ks/index/15/text"],["SC_M_004.ks/index/17/text"],["SC_M_004.ks/index/19/text"],["SC_M_004.ks/index/21/text"],["SC_M_004.ks/index/23/text"],["SC_M_004.ks/index/25/text"],["SC_M_004.ks/index/27/text"],["SC_M_004.ks/index/29/text"],["SC_M_004.ks/index/31/text"],["SC_M_004.ks/index/33/text"],["SC_M_004.ks/index/35/text"],["SC_M_004.ks/index/37/text"],["SC_M_004.ks/index/39/text"],["SC_M_004.ks/index/41/text"],["SC_M_004.ks/index/43/text"],["SC_M_004.ks/index/45/text"],["SC_M_004.ks/index/47/text"],["SC_M_004.ks/index/49/text"],["SC_M_004.ks/index/51/text"],["SC_M_004.ks/index/53/text"],["SC_M_004.ks/index/55/text"],["SC_M_004.ks/index/57/text"],["SC_M_004.ks/index/59/text"],["SC_M_004.ks/index/62/text"],["SC_M_004.ks/index/64/text"],["SC_M_004.ks/index/66/text"],["SC_M_004.ks/index/68/text"],["SC_M_004.ks/index/70/text"],["SC_M_004.ks/index/72/text"],["SC_M_004.ks/index/75/text"],["SC_M_004.ks/index/77/text"],["SC_M_004.ks/index/79/text"],["SC_M_004.ks/index/81/text"],["SC_M_004.ks/index/83/text"],["SC_M_004.ks/index/85/text"],["SC_M_004.ks/index/87/text"],["SC_M_004.ks/index/89/text"],["SC_M_004.ks/index/91/text"],["SC_M_004.ks/index/93/text"],["SC_M_004.ks/index/95/text"],["SC_M_004.ks/index/97/text"],["SC_M_004.ks/index/99/text"],["SC_M_004.ks/index/101/text"],["SC_M_004.ks/index/103/text"],["SC_M_004.ks/index/105/text"],["SC_M_004.ks/index/107/text"],["SC_M_004.ks/index/109/text"],["SC_M_004.ks/index/111/text"],["SC_M_004.ks/index/113/text"],["SC_M_004.ks/index/115/text"],["SC_M_004.ks/index/117/text"],["SC_M_004.ks/index/119/text"],["SC_M_004.ks/index/121/text"],["SC_M_00