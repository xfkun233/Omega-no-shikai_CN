t":3673,"end":3719}],[{"start":3727,"end":3753}],[{"start":3787,"end":3805}],[{"start":3849,"end":3854}],[{"start":3915,"end":3919}],[{"start":3927,"end":3952}],[{"start":3984,"end":3987}],[{"start":4059,"end":4070}],[{"start":4106,"end":4114}],[{"start":4120,"end":4130}],[{"start":4138,"end":4155}],[{"start":4163,"end":4174}],[{"start":4218,"end":4233}],[{"start":4269,"end":4272}],[{"start":4278,"end":4310}],[{"start":4316,"end":4338}],[{"start":4382,"end":4434}],[{"start":4494,"end":4504}],[{"start":4510,"end":4510}],[{"start":4524,"end":4525}],[{"start":4534,"end":4619}],[{"start":4627,"end":4644}],[{"start":4652,"end":4654}],[{"start":4663,"end":4676}],[{"start":4684,"end":4691}],[{"start":4701,"end":4706}],[{"start":4714,"end":4731}],[{"start":4739,"end":4770}],[{"start":4778,"end":4847}],[{"start":4855,"end":4872}],[{"start":4918,"end":4947}],[{"start":4983,"end":5002}],[{"start":5046,"end":5139}],[{"start":5175,"end":5179}],[{"start":5187,"end":5200}],[{"start":5208,"end":5245}],[{"start":5253,"end":5277}],[{"start":5283,"end":5317}],[{"start":5325,"end":5395}],[{"start":5403,"end":5451}],[{"start":5459,"end":5510}],[{"start":5518,"end":5522}],[{"start":5566,"end":5638}],[{"start":5674,"end":5680}],[{"start":5729,"end":5764}],[{"start":5772,"end":5780}],[{"start":5788,"end":5804}],[{"start":5833,"end":5847}],[{"start":5855,"end":5876}],[{"start":5884,"end":5891}],[{"start":5899,"end":5901}],[{"start":5909,"end":5916}],[{"start":5924,"end":5962}],[{"start":6035,"end":6038}],[{"start":6046,"end":6051}],[{"start":6069,"end":6071}],[{"start":6079,"end":6084}],[{"start":6153,"end":6254}],[{"start":6290,"end":6306}],[{"start":6385,"end":6420}],[{"start":6486,"end":6499}],[{"start":6507,"end":6524}],[{"start":6568,"end":6653}],[{"start":6689,"end":6784}],[{"start":6856,"end":6924}],[{"start":6932,"end":6962}],[{"start":6970,"end":7030}],[{"start":7066,"end":7137}],[{"start":7181,"end":7274}],[{"start":7282,"end":7343}],[{"start":7379,"end":7387}],[{"start":7395,"end":7399}],[{"start":7405,"end":7407}],[{"start":7465,"end":7468}],[{"start":7546,"end":7576}],[{"start":7607,"end":7695}],[{"start":7726,"end":7767}],[{"start":7798,"end":7858}],[{"start":7889,"end":7946}],[{"start":7977,"end":8008}],[{"start":8016,"end":8074}],[{"start":8145,"end":8179}],[{"start":8187,"end":8208}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_040.ks","basename":"SC_E_040.ks","indexIds":{"どうしよう。":0,"真言さん、電話出てくれないかな……[l]\nそろそろ、掛けてみようかな……":1,"あの日の内に、もっかい会っとけば良かったな。[l]\nていうか、別に明日にこだわんなきゃ、\nなんで私、\n混乱してて、\nあの娘等も『私に手出し出来ない』と思ってたのに、\nあんな事言ってくるなんて、\n『今回は特別な祭儀』なの？":2,"全員が揃うから？":3,"あの……が来てるから？":4,"禁級を強要してまで八枚を動かすなんて、\n私の知ってる限りじゃ……":5,"何だっていうんだ。[l]\n今年は、\n色んな事が一斉に起こりすぎて、":6,"……ん、":7,"生まれた瞬間から私は、":8,"それでも、\nあの日、あのひとたちと出会って、\nそしてこの春、":9,"きっとあのときの。[l]\n約束通りまた会えたんだと思ってた。":10,"はは、\nあのひとすっかり健忘さんになってたけど、":11,"明日、来てくれれば全部はっきりする、\nと思ってた。":12,"でも、\nどこだろ……[l]\nコドモの頃につくったものなんか、\nミハルで探すのはまだ、だめ、\n……あの娘等をやり過ごさなきゃ、[l]\n明日まで、真言さんが来るまで、\n力残しとかなきゃ、":13,"あー、何で考え無しにココまで来ちゃったかな。[l]\nよくよく考えれば、\n人前の方が、\nあの娘等だって動きにくいハズなのに、":14,"──ミスった。":15,"あんな事があって混乱してた。":16,"軽挙妄動ってやつだよ。":17,"あーもう、\nメンタルダメージおっきいと、だめだ……[l]\nすぐこんな、ばかなことしちゃうよ、\nどうしよう、\n血の気が引くってこのことだよ、":18,"ばか、\nわたし、\nなにやってんの？":19,"どうしよう、":20,"覆水盆に返らず、覆水盆に返らず、水は戻らず、\nみずはもどらず……":21,"帰ったほうが、いいのかな……":22,"家に帰っても、正面きってぶつかるよりは、\nいや、でも、\n真言さんには絶対に会わなきゃ、\n会って、私の全部を、………、[l]\nそれでも拒否られたら、\nそのときはもうわたし、\n……え？":23,"「……うそ、なんで」":24,"………。":25,"来、た。":26,"「……き、さま」":27,"でも独り……？[l]\n克杖は居ない？[l]\nこないだといいあの娘おかしい、":28,"そんなことより、\nなんで？[l]\nなんで私の居場所が、":29,"幾ら私がめだつからって、\n……乙種防火壁に反応した？[l]\nそんなはず、":30,"とにかく、ミハルの『":31,"深シ":32,"斎":33,"木』を──":34,"ざっ。":35,"「……」":36,"ざっざっ。":37,"「………」":38,"……禁級じゃ、[l]\n乙種ならまだしも甲種レベルの":39,"視":40,"業は、\nそんなに長くは保たない、\nそれに、しまった……場所が悪すぎ、[l]\n暗くたって砂浜、足跡も簡単にばれる、\n只でさえあの":41,"娘のは、\n……ちくしょう、何とか、何とか持ち堪えて…！":42,"「……に…る………ょ…？」":43,"──何か、言ってる、\n私に話してる……？[l]\nまさか、\n視えてる？[l]\nそんな、\nあの娘が此処に来る前から『深シ斎木』はつかってる、\nいくら禁級だからって甲種視業がそんな簡単に、":44,"「いるんですよね？[l]\n冬夏さん。[l]\nああ、返事はしなくても構いません、\nそんなお手間取らせません」":45,"……ブラフだ、判る筈無い……":46,"「貴女の考える事くらいワカります。[l]\n私達はおなじものを視てるんだから」":47,"ワカルはずない……":48,"そんな訳ない……":49,"「此処は私と貴女、そしてあのひと、\nそしてあのひとの場所、\nシを忘れるな、\n全てはサイコウのため、全てはサイコウのサイコウの……」":50,"……？":51,"「ああ、さっきは嘘を吐きました。[l]\n貴女の考える事なんて毛程も分かりません」":52,"……今度は挑発？":53,"誰がのるもんか……":54,"「ミハルが貴女と共に在ったから──\nミハルがいなければ、\n逆に判らなかった……かも知れません。":55,"いまのわたしには九番を除きすべて、\n感得、できて、ます、\nだって、ワタシタチは」":56,"すべからくあのひとの":57,"夢":58,"黒。":59,"……なに？":60,"「あのひとがここにもどってきた。[l]\nトーノイーハが、\nながらくうしなわれたわたしたちのちゅうしんが、":61,"わかたれたそうしつをうめるときが、\n":62,"統べて":63,"再":64,"興のときがきた──」":65,"何の話よ？[l]\n何の話か知らないけど、\n幾ら何でもおかしい、\n姫様はいつだっておかしいけどこれは度が過ぎてる、":66,"何かが違う、\nこわい……よぉ、だめ、震えないで、私の身体、":67,"「無駄、です、無駄、無駄無駄、":68,"貴女がごときチカラでは、\n第二位ミハルごときのチカラでは、":69,"タダの禁級程度の外法では、\nわたし第一位アヤメ特禁級常駐甲種に、届く訳ナイでしょう？":70,"幸いにも、\nひとめは、\nないので、」":71,"え？[l]\nきえっ、──あ？":72,"「ここ？」":73,"なっ？！":74,"やっぱり視えて──\n\n\n\n":75,"ざく。":76,"「カミか──残念です」":77,"あ、ぶなかった、":78,"@rな、なんで。":79,"ミハルの『深シ斎木』が動いてない？":80,"それとも当てずっぽう？":81,"「でも、これで確定……ですよ」":82,"いや、":83,"\n凌駕された……？[l]\nでも、視えてはいない、":84,"だから、\n感得なんだ、きっと、でも、":85,"「ひとしくあのひとのからだだもの、\nミハルもアヤメぇ、もぉ、\nおぅあ、にゃあ、ふしゃう」":86,"何か変、もしかして、":87,"@r":88,"先":89,"刻『わたし』って言った……？[l]\nわたし第一位アヤメって？[l]\nアヤメを主格に？[l]\nそれとも言葉のアヤ？[l]\nそうじゃないなら、":90,"『神蝕』されてるのか、それでか──":91,"あの":92,"娘、\nなんてこと、":93,"特禁級常駐の、":94,"歪みが──":95,"トモさんっ、\nこんなことに":96,"私達のあのカミに反応さえしなければ、\nとりあえずは……":97,"というより、こいつ、私を、\n●●す気か？[l]\nまるで手加減なんかしてなかった、\n捕獲しようとかいう感じじゃない、":98,"ど、どういうつもりでこんな真似っ、":99,"「では聞こえてるでしょうので、\n説明致します──」":100,"……ちっ、ば、馬鹿にして……ぇっ！！！":101,"「卑尊さんに少々頑張って頂けるそうなので、\n多少手荒でも構わないと言われてきたんです……[l]\n●や●の一本くらいなら、\n構わないと……[l]\nなので、」":102,"……え？":103,"うそ、そこまで、なんで？！":104,"何よ、何があるって言うのよ、\n私にも、祭儀にも、何でそんなにっ！！":105,"最悪、最悪だ、真言さん、どうしよう、どうしよう、":106,"動いたらばれる、動いたらばれる、でも、\nこのこ絶対する気だ、":107,"逃げなきゃもう、\nむりだよ、わたし、ん、だめ、\nまけちゃだめ、\nかたなきゃ、こんなの、\nかってすすまなきゃ、":108,"でも、\nこんなの、\nこんなのぅ、\nどうしたらいいの、白旗あげればいいの？":109,"それともこのまま、えぅあう、\nどうしようどうしようどうしよう、\nあ、だめ、だめぇ、こ、":110,"こ、こ、":111,"「手加減はしませんが──\n安心してください、\n聞こえてたでしょうが……卑尊さんが全部なおしてくれます。[l]\nだから、」":112,"御覚悟を……":113,"どこ？！[l]\n視えないっ、\n避けられるわけないよっ、":114,"なんで、あのこ、":115,"克杖の限解も受けてるあんなの、\n":116,"真性読神甲種視業でも無理っ、":117,"もう、\nだめだ、\nわたし、":118,"まことさん──":119,"た、":120,"いや、いやだ、":121,"やだよ、\nこわいよぉっ、\nこわいっ、\nこわいっ！！！":122,"ざく、":123,"ばきぼき、":124,"斬。":125,"ぶしゃっ、":126,"「ぃっぁあああああああああああああああああああ\nあああああああああああああああああああああああ\nあああああああ！！！！！！！！！！！！！！！！[l]\n！！！！！！！！！！！！！」":127,"が、が、が、がああああああああ、":128,"「……そこにいたの……[l]\n視ぃつけた、冬夏ちゃん、あれ？」":129,"とさっ、ごろごろご、ろ……":130,"どくどくどくどくどくどくどくどく。":131,"「……ええと、[l]\nその●はちゃんと持っていくから。[l]\nあっちで卑尊さんに繋げてもらってください。[l]\nそれまで……●んじゃ駄目だよ……」":132,"が、はっ、\nいたぁ、痛い、痛い、痛い、いたあ、い、よお、\nぎっ、ぎぎぎぎぎぎぎぎぎあああががが、\nちっくしょお、ちくしょおおお、ちくしょおおおおおお！！！！！！！！！":133,"「もう、治すまで歩けないね、でも丁度良かった、\nそれでもう、逃げられないから、\nああ、痛そう、いたいよね、ごめんなさい、":134,"ちょっと遠いけど……[l]\n大丈夫、心配しないで……":135,"限解されてルカら、くルマより速くツケルヨ、\nスグラクニナレルヨ、\nダイジナダイジナドレミリアノオオオオ」":136,"く、ああ、\nこ、きさま、あああ？？？[l]\nやっぱりよ、うすが、おかし、いいいいいいいたああああいいいいいいい！！！！！！！！":137,"「……じゃあ、かえろうね。ミハルも……一緒にね。[l]\nでは行こう、冬夏ちゃん、\nこののうなしのかすが。[l]\nあんたのアイもかくごもほらみろぜいじゃくなんだよ。":138,"……誰かに視られても困るので、[l]\n『深シ斎木』お願い出来ますか？[l]\n幸い禁級餌は、ほら、大量に、」":139,"ああもう、むり、":140,"むり──":141,"──":142,"──。":143,"「き、きーちゃ、あ？[l]\nと、冬夏ちゃ、こっ、！」":144,"「……気を失って……しまった……から……[l]\nなるべく……急いで……きたけど……[l]\n途中……フカシ……してないから……[l]\nどう……なのか……」":145,"「そ、そうじゃなくて、\nこ、こんな、大怪我、え、\nこれ●？●？！」":146,"「……怪我？[l]\nああ……お仕置き……だから……はやく……[l]\nナガヒサ……さんそう……さんそ……」":147,"「えあ、う、きーちゃが……の？[l]\nと、兎に角行こう、卑尊さん！？[l]\n卑尊さぁーん！！！！」":148,"「……がはっ、[l]\n……冬夏ちゃん……たすかるよ……":149,"よかった……ねぇ、[l]\n御嬢様……はやく……ひとつにならないと……[l]\nもうておく……れに……」":150,"「兄ぃに、これは、\n兄ぃと話さなきゃ、\n会わなきゃ、":151,"きーちゃが、\n冬夏ちゃが……──」":152},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_040.ks","relPath":"/data/scenario/SC_E_040.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":146,"length":153,"percent":95.42483660130719},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[147,0]},"/data/scenario/SC_E_041.ks":{"data":[["「ちょ、っと？！[l]\nなに、どうしたのよ！！[l]\nどういうこと？！」","「等、等一下？！[l]\n怎么回事、怎么了啊！！[l]\n这是什么情况？！」"],["「……がふっ……」","「……咕噗……」"],["「わたしもわかんないんですけどっ、\n冬夏ちゃをまずは、\nそれと、\nきーちゃの『神触』がっ、」","「我也不知道怎么回事但是、\n总之先处理冬夏酱、\n还有、\n小姬的『神触』也、」"],["「克杖……[l]\n私は……なんでもない……から……[l]\nすこし……やすめば……」","「克杖……[l]\n我……没事的……[l]\n稍微……休息下……」"],["「『神触』……？[l]\nちょっと、まさか、\n……と、兎に角、[l]\nなんとかしなきゃ……","「『神触』……？[l]\n等等、难道、\n……总、总而言之、[l]\n必须想办法……"],["まずは冬夏さんね、\nああ克杖、いっそいでトモ連れてきて、\nとてもじゃないけど私も禁級だけじゃ、\nこんな……」","先处理冬夏小姐吧、\n啊啊克杖、赶快把友也带过来、\n光靠我一个人的禁级实在、\n这种……」"],["「にゃ、はいっ！[l]\nきーちゃの事もなんとかお願いしますっ」","「喵、是！[l]\n小姬的事也拜托您想办法了」"],["「それもトモ次第ね、はやくっ」","「那也要看友也了、快点」"],["「……ふぅ……はぁ……ふぅ……」","「……呼……哈……呼……」"],["「事情は今し方克杖君から聞いた、んだ、が。[l]\nさて、\nああー……これは、また、[l]\n派手にしでかしたなあ姫様君。","「情况刚刚从克杖君那里听说了、但是。[l]\n那么、\n啊啊……这又是、[l]\n闹得够夸张啊姫様君。"],["ちゃんと視られずに来たのかい？[l]\nそれにしてもこれは、\n僕も甲種禁級、他よりはマシとは言え──\nああ、ミコは大変だねこれは」","没被好好看着就来了吗？[l]\n即便如此这也、\n我也是甲种禁级，虽说比其他强些──\n啊啊，卑尊可真是够呛呢」"],["「軽口はいいから取り敢えず、\nフォローお願い、\n祭儀本番もあるのにもう、\nどうするのよ……」","「闲话少说总之先、\n拜托善后、\n祭典正日都快到了、\n要怎么办啦……」"],["「フツウの病院にでも担ぎ込むかい？[l]\nともあれ全部修復済むまでは御母堂には視せない方が得策だな、\n騒がれたんでは堪らない」","「要往普通医院送吗？[l]\n总之在全部修复前别让老夫人看见比较妥当、\n闹起来可吃不消」"],["ずっとミハルも持ってたのに、\n気付かん能無しには黙ってて貰おう。","明明一直带着米哈尔、\n对察觉不到的无能之辈就保持沉默吧。"],["「まずは斬られた●か、\nそして、左眼、\nふむ、髪の毛は──」","「首先是被斩的●、\n然后、左眼、\n嗯哼、头发的话──」"],["「ああ、はあ、それはこちらで何とかしますよぅ」","「啊啊、哈啊、那部分我们会想办法的哟」"],["「え？[l]\nあらいらしたんですか？[l]\n今御覧の通り、の有様で──」","「咦？[l]\n已经来过了吗？[l]\n如您所见、这副模样──」"],["「ああいえ、\n生やす伸ばすは無理ですし、\n卑尊ちゃんにもこれ以上負担はかけたくないですしねぃ、\nいっそ綺麗に切り揃えるいうことですよぅ。","「啊不是、\n再生延长是不可能的、\n也不想给卑尊酱增加更多负担呢、\n索性修剪整齐这样哟。"],["おやおやまあまあ、\n丁度、この感じはねえ」","哎呀呀嘛嘛、\n正好、这种氛围呢」"],["「……成程、御老体は実際に視ておいでか。[l]\n三春の始祖、ドレミリア・リデルですね？」","「……原来如此，老夫人实际见过啊。[l]\n三春的始祖，德蕾米莉娅・利德尔对吧？」"],["「御老体て、そんな言い方傷付くなぁっ。[l]\nまあそういうことです。[l]\nほんに、\nそっくりですなぁ──」","「说什么老夫人，这种称呼好伤人呀。[l]\n嘛就是这么回事。[l]\n真的、\n简直一模一样呢──」"],["「ふむ、\n……ふむ」","「嗯哼、\n……嗯哼」"],["「何ぼーっとしてるのよ早く、私始めるわよ、\nじゃあ、身繕いは修復後に、\n取り敢えずここは私とトモで」","「发什么呆呢快点、我要开始了、\n那么、仪容等修复后再弄、\n总之这里交给我和智」"],["「はいはい。[l]\nにしても、\nあのお方も喜びはるんと違いますか、","「好好好。[l]\n话说回来、\n那位大人也会高兴吧虽然不同、"],["こん度のハレに、こんな\nたまたまねぇ、こん祭儀用にて、\n装束のほうもようけ似せられるでしょ、\nなんせ今回は総出で……」","这次晴明祭居然、\n真巧呢、正好祭典用、\n装束也能仿制不少吧、\n毕竟这次全员出动……」"],["「済みませんが、あちらで──」","「抱歉请到那边──」"],["「あらら。[l]\n終わったら呼んでくださいねぇ。[l]\n仕上げはうちがやりますよって──\nでは、克杖ちゃん、行きましょか」","「哎呀呀。[l]\n结束后请叫我哟。[l]\n收尾工作由我们来──\n那么、克杖酱、走吧」"],["「……えあ、[l]\nあの、きーちゃ、は……」","「……啊、[l]\n那个、小姬她……」"],["「んー、\nどないしましょうかねぃ……[l]\nま、本人がだいじょぶ言うとってもこれは……」","「唔─、\n该怎么办呢……[l]\n嘛、虽说本人说不要紧但这样……」"],["「少し……寝る……布団まで……よろしく……」","「稍微……睡会……到被窝……拜托……」"],["「わ、わかった、\nでもほんとに、」","「明、明白了、\n但真的、」"],["「大丈夫……あとで……食事だけ……お願い……」","「没关系……之后……只要准备……饭菜……」"],["「う、うん、ほんとに、何かあったらすぐ言ってよ？」","「嗯、嗯、真的、有事要立刻说哦？」"],["「ほいだら、\n克杖ちゃんは姫様ちゃんをたのんますね。","「那就、\n克杖酱就拜托姫様酱啦。"],["まあ仮に……視られとっても、[l]\nこん暗さですし、\n精精が怪談の噂が──今の時分ですとウチュウジンか何かですか？","就算被……看见、[l]\n这么昏暗、\n顶多传出怪谈流言──这年头该说是宇宙人什么的吗？"],["あんなんになるくらいでしょうけどね。[l]\nま、最悪タマズサでいじれますよって、\nそこは構わんでしょ。[l]\n価無ちゃんにもベロアちゃんたちのおもり、してて貰わなねぇ。","虽然会变成那样吧。[l]\n嘛，最坏情况用塔玛祖莎也能搞定，\n这点倒不用担心。[l]\n价无酱也得帮忙照看贝萝娅她们呢。"],["ああ、\nそんうち葬儀の準備もせなあきませんな。[l]\nそれも準備しときましょ。","啊，\n这期间还得准备葬礼才行。[l]\n那些也先准备好吧。"],["ほな、呼ばれるまで待ちますよって、\nみなさん重畳な結果をよろしうたのみます」","那就等被召唤前先等着，\n诸位请静候佳音」"],["「……じゃあ、[l]\nいくわよ。[l]\nバックアップ任せるからね」","「……那，[l]\n我走了。[l]\n备份就拜托啦」"],["「分かってるよ。[l]\nこれで終わりじゃないのだからね、\n特に君は、","「知道啦。[l]\n这还不是结束呢，\n特别是你，"],["呉","吴"],["呉も無理はするなよ。","吴也别太勉强。"],["但し、これも、次も大事な施術だ。[l]\nどちらも過失無きよう」","不过这次和下次都是重要手术。[l]\n两者都务必零失误」"],["「無茶言ってくれるわ……」","「净说强人所难的话……」"]],"context":[["SC_E_041.ks/index/1/text"],["SC_E_041.ks/index/3/text"],["SC_E_041.ks/index/5/text"],["SC_E_041.ks/index/7/text"],["SC_E_041.ks/index/9/text"],["SC_E_041.ks/index/11/text"],["SC_E_041.ks/index/13/text"],["SC_E_041.ks/index/15/text"],["SC_E_041.ks/index/17/text"],["SC_E_041.ks/index/19/text"],["SC_E_041.ks/index/21/text"],["SC_E_041.ks/index/23/text"],["SC_E_041.ks/index/25/text"],["SC_E_041.ks/index/27/text"],["SC_E_041.ks/index/29/text"],["SC_E_041.ks/index/31/text"],["SC_E_041.ks/index/33/text"],["SC_E_041.ks/index/35/text"],["SC_E_041.ks/index/37/text"],["SC_E_041.ks/index/39/text"],["SC_E_041.ks/index/41/text"],["SC_E_041.ks/index/43/text"],["SC_E_041.ks/index/45/text"],["SC_E_041.ks/index/47/text"],["SC_E_041.ks/index/49/text"],["SC_E_041.ks/index/51/text"],["SC_E_041.ks/index/53/text"],["SC_E_041.ks/index/55/text"],["SC_E_041.ks/index/57/text"],["SC_E_041.ks/index/59/text"],["SC_E_041.ks/index/61/text"],["SC_E_041.ks/index/63/text"],["SC_E_041.ks/index/65/text"],["SC_E_041.ks/index/67/text"],["SC_E_041.ks/index/69/text"],["SC_E_041.ks/index/71/text"],["SC_E_041.ks/index/73/text"],["SC_E_041.ks/index/75/text"],["SC_E_041.ks/index/77/text"],["SC_E_041.ks/index/79/text"],["SC_E_041.ks/index/81/text"],["SC_E_041.ks/index/83/text"],["SC_E_041.ks/index/85/text"],["SC_E_041.ks/index/87/text"]],"tags":[],"parameters":[[{"start":191,"end":235}],[{"start":266,"end":275}],[{"start":306,"end":364}],[{"start":395,"end":444}],[{"start":475,"end":531}],[{"start":539,"end":605}],[{"start":636,"end":671}],[{"start":702,"end":717}],[{"start":748,"end":764}],[{"start":909,"end":980}],[{"start":988,"end":1064}],[{"start":1095,"end":1153}],[{"start":1185,"end":1256}],[{"start":1282,"end":1318}],[{"start":1350,"end":1388}],[{"start":1416,"end":1439}],[{"start":1470,"end":1514}],[{"start":1542,"end":1622}],[{"start":1630,"end":1655}],[{"start":1687,"end":1735}],[{"start":1763,"end":1829}],[{"start":1861,"end":1875}],[{"start":1906,"end":1964}],[{"start":1992,"end":2033}],[{"start":2041,"end":2112}],[{"start":2143,"end":2158}],[{"start":2186,"end":2259}],[{"start":2290,"end":2316}],[{"start":2344,"end":2396}],[{"start":2427,"end":2449}],[{"start":2480,"end":2501}],[{"start":2532,"end":2555}],[{"start":2586,"end":2611}],[{"start":2639,"end":2669}],[{"start":2677,"end":2742}],[{"start":2750,"end":2846}],[{"start":2854,"end":2901}],[{"start":2930,"end":2972}],[{"start":3142,"end":3183}],[{"start":3215,"end":3257}],[{"start":3267,"end":3268}],[{"start":3278,"end":3288}],[{"start":3296,"end":3331}],[{"start":3362,"end":3375}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_041.ks","basename":"SC_E_041.ks","indexIds":{"「ちょ、っと？！[l]\nなに、どうしたのよ！！[l]\nどういうこと？！」":0,"「……がふっ……」":1,"「わたしもわかんないんですけどっ、\n冬夏ちゃをまずは、\nそれと、\nきーちゃの『神触』がっ、」":2,"「克杖……[l]\n私は……なんでもない……から……[l]\nすこし……やすめば……」":3,"「『神触』……？[l]\nちょっと、まさか、\n……と、兎に角、[l]\nなんとかしなきゃ……":4,"まずは冬夏さんね、\nああ克杖、いっそいでトモ連れてきて、\nとてもじゃないけど私も禁級だけじゃ、\nこんな……」":5,"「にゃ、はいっ！[l]\nきーちゃの事もなんとかお願いしますっ」":6,"「それもトモ次第ね、はやくっ」":7,"「……ふぅ……はぁ……ふぅ……」":8,"「事情は今し方克杖君から聞いた、んだ、が。[l]\nさて、\nああー……これは、また、[l]\n派手にしでかしたなあ姫様君。":9,"ちゃんと視られずに来たのかい？[l]\nそれにしてもこれは、\n僕も甲種禁級、他よりはマシとは言え──\nああ、ミコは大変だねこれは」":10,"「軽口はいいから取り敢えず、\nフォローお願い、\n祭儀本番もあるのにもう、\nどうするのよ……」":11,"「フツウの病院にでも担ぎ込むかい？[l]\nともあれ全部修復済むまでは御母堂には視せない方が得策だな、\n騒がれたんでは堪らない」":12,"ずっとミハルも持ってたのに、\n気付かん能無しには黙ってて貰おう。":13,"「まずは斬られた●か、\nそして、左眼、\nふむ、髪の毛は──」":14,"「ああ、はあ、それはこちらで何とかしますよぅ」":15,"「え？[l]\nあらいらしたんですか？[l]\n今御覧の通り、の有様で──」":16,"「ああいえ、\n生やす伸ばすは無理ですし、\n卑尊ちゃんにもこれ以上負担はかけたくないですしねぃ、\nいっそ綺麗に切り揃えるいうことですよぅ。":17,"おやおやまあまあ、\n丁度、この感じはねえ」":18,"「……成程、御老体は実際に視ておいでか。[l]\n三春の始祖、ドレミリア・リデルですね？」":19,"「御老体て、そんな言い方傷付くなぁっ。[l]\nまあそういうことです。[l]\nほんに、\nそっくりですなぁ──」":20,"「ふむ、\n……ふむ」":21,"「何ぼーっとしてるのよ早く、私始めるわよ、\nじゃあ、身繕いは修復後に、\n取り敢えずここは私とトモで」":22,"「はいはい。[l]\nにしても、\nあのお方も喜びはるんと違いますか、":23,"こん度のハレに、こんな\nたまたまねぇ、こん祭儀用にて、\n装束のほうもようけ似せられるでしょ、\nなんせ今回は総出で……」":24,"「済みませんが、あちらで──」":25,"「あらら。[l]\n終わったら呼んでくださいねぇ。[l]\n仕上げはうちがやりますよって──\nでは、克杖ちゃん、行きましょか」":26,"「……えあ、[l]\nあの、きーちゃ、は……」":27,"「んー、\nどないしましょうかねぃ……[l]\nま、本人がだいじょぶ言うとってもこれは……」":28,"「少し……寝る……布団まで……よろしく……」":29,"「わ、わかった、\nでもほんとに、」":30,"「大丈夫……あとで……食事だけ……お願い……」":31,"「う、うん、ほんとに、何かあったらすぐ言ってよ？」":32,"「ほいだら、\n克杖ちゃんは姫様ちゃんをたのんますね。":33,"まあ仮に……視られとっても、[l]\nこん暗さですし、\n精精が怪談の噂が──今の時分ですとウチュウジンか何かですか？":34,"あんなんになるくらいでしょうけどね。[l]\nま、最悪タマズサでいじれますよって、\nそこは構わんでしょ。[l]\n価無ちゃんにもベロアちゃんたちのおもり、してて貰わなねぇ。":35,"ああ、\nそんうち葬儀の準備もせなあきませんな。[l]\nそれも準備しときましょ。":36,"ほな、呼ばれるまで待ちますよって、\nみなさん重畳な結果をよろしうたのみます」":37,"「……じゃあ、[l]\nいくわよ。[l]\nバックアップ任せるからね」":38,"「分かってるよ。[l]\nこれで終わりじゃないのだからね、\n特に君は、":39,"呉":40,"呉も無理はするなよ。":41,"但し、これも、次も大事な施術だ。[l]\nどちらも過失無きよう」":42,"「無茶言ってくれるわ……」":43},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_041.ks","relPath":"/data/scenario/SC_E_041.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":44,"length":44,"percent":100},"cellInfo":[],"cacheResetOnChange":{},"lastSelectedCell":[35,0]},"/data/scenario/SC_E_042.ks":{"data":[["ゲームの心得、\n\n飽くまでボクの持論……否、好みだけどね。","游戏心得，\n\n终究只是我的个人见解……不，该说是偏好罢了。"],["@rゲームにはその経緯とモチベーションから２種類ある、\nと言える。","@r游戏从其成因与动机可分为两类，\n可以这么说。"],["ああ、今からキミにカタるのは、\nゲームの理論じゃない、\nあれはまた別の話だし、\nボク等のようなのが興味を持つには少々無粋で無意味な領域だからね。[l]\nモノゴトを論理的に思考するのは遊戯としては愉快だが、\n普遍的な理論として行動原理に据え","啊，现在要和你讲的，\n不是游戏理论，\n那是另一码事，\n对我们这类人来说属于既无趣又无意义的领域。[l]\n用逻辑思考事物作为游戏固然愉快，\n但将其奉为普遍真理来指导行动"],["声","声"],["高","高"],["居","居"],["丈","丈"],["高に振る舞うのは、\n好みじゃないなあ。","趾高气扬的做派，\n我可不喜欢。"],["そういったモノは常に目安や大義名分以上のモノには成り難い場合が多いから……[l]\nそれで間に合う社会で生きるなら構わないがね、\nま、どんな時でも場合によりけり、\nケースバイケースだと言うことも常に念頭に置いてくれよ。","这类东西往往难以超越基准或大义名分……[l]\n在将就度日的社会里倒也无妨，\n嘛，任何时候都要具体问题具体分析，\n这点还望时刻牢记。"],["さて話を戻そう。","言归正传。"],["@r２種類とは、\n\n通常生活で蓄積したストレスの発散、\n\nとしての側面に偏重したものと、もう一つは、\n\n自らに課題を課してそれをクリアする喜びを得る、\n\nという側面に偏重したものだね。","@r所谓两类，\n\n一是侧重宣泄日常生活积累的压力，\n\n另一种则是\n\n通过给自己设定课题并攻克来获得喜悦，\n\n更侧重这方面的类型。"],["その性格上、前者は主に、\n\n破壊、\n\nの疑似体験或いはそのもの、そうでなくても、\n要するに日常からの逃避による抑圧解放と愉悦獲得だから、\n課題をクリアという側面──\nつまり低い確率を狙うったり、\n遂行に一定以上の技術が必要だったり、\n累積が必ずしもイコール実績とならないものだったり、\n思い通りに動かないものを操ったりする行為──\nは、\n単にストレスを溜めるもの、つまり厭な日常と重なる訳だ。","本质上前者主要是\n\n破坏\n\n的模拟体验或实际行为，再不济也是\n通过逃避日常来释放压抑获取快感，\n而攻克课题这方面——\n比如追求低概率事件，\n或需要一定技术才能完成，\n或积累未必等于成果，\n又或是操控不听话的东西这类行为——\n只会\n徒增压力，本质上与讨厌的日常无异。"],["ストレスを発散するためにしている遊戯によって\nストレスを加えられたのでは本末転倒。","为减压而进行的游戏\n反而增压就本末倒置了。"],["@rこれは、ゲームというものの占める位置が、\n当人にとって通常生活よりも低くされてる場合だね。[l]\nゲェムをする為に生きてる訳じゃないから、\n当然、下位が上位を脅かす……苛苛する行為で日常を[l]\n騒がせたくはない。","@r这种情况说明\n游戏在当事人心中地位低于日常生活。[l]\n毕竟人不是为玩游戏而活，\n自然不愿让低位事物干扰…侵扰高位事物[l]\n打破日常平静。"],["逃避は楽になる為にするものだからだ。[l]\n手に余る事象を扱うことは忌避されて、\n或いは、\n程よく自分が何かを成し遂げていれているという錯覚を、\n無意識的に得る事が出来るルールや構造を求められる訳だよ。","因为逃避是为了让自己轻松些。[l]\n人们会回避处理超出能力范围的事情，\n或者说，\n会无意识地追求那些能让自己产生\n『恰到好处地完成了某事』错觉的规则和结构。"],["@r後者は、\n難題であるほど愉しいという考え方。","@r后者则是\n越困难越快乐的想法。"],["つまり、\n課題をクリアした時の幸福感を得るために、\nその過程自体は辛くとも構わないという構造だね。[l]\n寧ろ、辛い程、厳しい程、\nそれを成し遂げた自分、というものに浸れる分、\n好ましいという訳だ。[l]\n誰にでも出来るものをクリアしても仕方がないんだ。[l]\n自分だけがそれを出来る、という錯覚を得る事が重んじられる。[l]\n自ずと求道的な姿勢になるから、\nストレス解消とはほど遠いね。[l]\nまあ、そういう目的でしてるからには、\nストレスもない場合もあるかも知れないけれど。","也就是说，\n为了获得攻克难题时的幸福感，\n即使过程本身痛苦也无所谓的结构。[l]\n不如说越是痛苦、越是严苛，\n就越能沉浸于『做到了的自己』之中，\n因此反而更受欢迎。[l]\n完成谁都能做到的事毫无意义。[l]\n重要的是获得『只有自己能做到』的错觉。[l]\n自然而然就会形成求道者般的姿态，\n与缓解压力相去甚远呢。[l]\n不过既然是以此为目的，\n或许有时根本不存在压力。"],["要するに、\n前者と明らかに違うのは、\nゲームの占める位置が割合上位にあり、\n行為そのものに加圧や快感の両方があろうと、\nそれ自体をするためにしているが故に苦ではない、\nという構造だということ。","总之，\n与前者明显不同的是，\n游戏在后者心中占据较高地位，\n即便行为本身兼具压力与快感，\n正因为是为此而做所以不觉痛苦，\n这就是它的结构。"],["@rちょっとややこしいかな。","@r是不是有点绕？"],["簡単にまとめよう。","简单总结下吧。"],["@r前者は、\n現状のプレイアァの心的状況に、\n絶対値的にプラスを与えて愉悦を得る行為で、","@r前者是\n通过给玩家当前心理状态\n添加绝对值上的正反馈来获得愉悦；"],["\n後者は、\n自発的に相対値的なマイナスを与えた上で、\nそれをゼロ","\n后者则是\n主动施加相对值上的负反馈后，\n将其归零"],["乃","乃"],["至プラスに持っていきその落差で愉悦を得る行為だ。","至正值，利用落差获取愉悦的行为。"],["@r簡単だろ？","@r很简单吧？"],["実際の所、仕込みの労力としては、\nあくまで私見だが後者のが実は楽だろうね。[l]\n食事を美味しくするために、直前まで空腹にしておくようなものだよ。[l]\nどちらかというと生理現象に訴えてる感が否めなくてね、\nヒトによっては安易な方法と視ることもあるだろうな。[l]\n次の悦楽の為に、敢えて抑圧、ストレスを与えておく訳だからね、","实际上就设计成本而言，\n个人认为后者反而更省力。[l]\n就像为了让饭菜更美味而提前保持饥饿感。[l]\n某种程度上这难免让人觉得是在利用生理本能，\n可能有人会视其为取巧之法。[l]\n毕竟这是为了下次愉悦而刻意施加压抑与压力，"],["正確にはプラスになっていないと言う意味でそして、\nその相対的マイナスのうちに遊戯を投げ出す者が出かねないという意味で、\n……例えば操作性の有益な機能を遊戯が進むまで取得出来ない、[l]\n不利や不如意であることを強制することによって\n取得時に大きなプラスにみせかける、\nと言った風な、\n根源的な所での機能的制限と試練との違いに対する見解の差、等色々、\nとかね、\nキミならワカルねこの例えは？[l]\nまあそんなだからね、\nボクの趣味的見地から正直な所を言うならば、\nキミにはあまり推奨しない遣り方だけれど、","严格来说并未产生实质增益，\n且在相对负值阶段可能出现弃坑玩家——\n……比如将便利操作功能[l]\n强制设定为游戏进度解锁，\n通过制造不利条件\n来让获取时显得更具价值，\n诸如此类根本性功能限制与试炼的认知差异等等，\n还有啊，\n这个比喻你应该懂吧？[l]\n正因如此，\n从我的趣味立场说句实话，\n虽然不太推荐你采用这种方式，"],["さてボクがハッキリとどちらのタイプなのか、\nという質問があるならば、\nその時々によって選択的である、としか言えないよ。","但若问我自己究竟属于哪类，\n只能说\n会根据情况选择性切换。"],["なぜなら、\nボクは自分自身の美意識に忠実に基づいた蒐集者であって、\n逃避の為の遊戯と課題の解決により愉悦を得る行為は\n端から別のカテゴリにあり、\n二者択一項ではないからね。","毕竟，\n我是忠于自身美学准则的收藏家，\n逃避式游戏与攻克难题获得愉悦\n本就分属不同类别，\n并非二选一的命题。"],["当然すぎて言うまでもないが、\nセカイにはどちらか一方なんて単純な縦割りが出来る事は\n少ないよ。[l]\nスキかキライかの別だけがそこにある。[l]\n簡易早急的かつ便宜的に相手を判断する為に、\n統計的経験的に流布している印象のカテゴリに\n相手を仮置きしておく、という筈だった行為が、\n印象イコール『そうである筈』に替わっているようだが。[l]\nその仮カテゴリから外れると、\n『期待はずれ』と非難されることは殊の外多いようだね。[l]\n相対的な物の視方も時と場合によりけりなんだけどね。[l]\n拙速を尊ぶ場合以外は単なる遊戯の一環としての約款の\n一形態にしかならないのだが──","当然到无需赘言，\n世界很少能简单地划分为\n非此即彼的。[l]\n那里只存在喜欢或讨厌的区别。[l]\n为了快速简便地判断对方，\n本该是将对方暂时归类于\n统计经验中广泛流传的印象类别，\n但印象似乎已等同于『理应如此』了。[l]\n一旦偏离这个临时类别，\n被指责为『辜负期待』的情况似乎格外多呢。[l]\n不过看待事物的相对性也因时因地而异。[l]\n除了崇尚速战速决的情况外，\n这不过是游戏规则的一种形式——"],["ThousandBrainsあたりはその辺、\n敢えてその他者の持つ印象に即して行動しようという\n愉快な癖があるけどね。","像ThousandBrains那类人，\n反倒会故意根据他人印象来行动，\n有种有趣的癖好呢。"],["ああ、話が逸れたね。","啊，扯远了。"],["@rただ最後に先の二例の後者はね、\nそれを目的とする者以外にはプレイすることすらままならない、\nという事はある、というのは含み置いた方がいいかもね。","@r不过最后要补充的是，\n对于不以那为目的的人来说，\n甚至连进行这种游戏都很困难。"],["まあ、ボクらは","反正我们"],["他","不"],["者のために","会为了"],["遊","妓"],["戯を","他人"],["拵えたりは\nしないから……[l]\nんむ？[l]\n勿論、最優先事項はキミだよ。[l]\nキミの為のオハナシを、\n夜伽話をカタりきかせたいと思ってるんだ。[l]\nそれは一つの遊戯でもある。[l]\n愉悦を得る、\nキミの為の遊戯だ。[l]\n相対的で愚にも付かないＰの価値など意に介す必要もない、\nボクらの視定めた絶対的価値に基づく愉しいものを。[l]\n邪魔にはムクイが与えられる、\nその殲滅行為すらも手慰みとしてならば溜飲を下げる一助となろう。","而精心\n设计游戏……[l]\n嗯？[l]\n当然，最优先事项是你。[l]\n想给你讲述\n专属于你的枕边故事。[l]\n那也是一种游戏。[l]\n获取愉悦的、\n专属于你的游戏。[l]\n无需在意相对且毫无价值的P的价值，\n只需享受我们认定的绝对价值带来的快乐。[l]\n妨碍者会由无垢处理，\n就连歼灭行为若作为消遣也能让人痛快。"],["そう、一度は失敗したキミへの──、\n\n兄としてキミに出来る最上のものをね。","没错，对曾经失败过的你——\n\n作为兄长能给予的最高馈赠。"],["愛しのクララ、\n\nボクの最愛の●。","亲爱的克拉拉，\n\n我最爱的●。"],["そのためには、\n\nそう、単純な遊戯たる『鬼事』をするにも、\n鬼と、追われる者が必要だ。","为此，\n\n就连进行简单的『捉鬼游戏』，\n也需要鬼和被抓捕者。"],["そして、\n\n王の封印は──","而\n\n王的封印——"]],"context":[["SC_E_042.ks/index/1/text"],["SC_E_042.ks/index/3/text"],["SC_E_042.ks/index/5/text"],["SC_E_042.ks/index/7/text"],["SC_E_042.ks/index/9/text"],["SC_E_042.ks/index/11/text"],["SC_E_042.ks/index/13/text"],["SC_E_042.ks/index/15/text"],["SC_E_042.ks/index/17/text"],["SC_E_042.ks/index/19/text"],["SC_E_042.ks/index/21/text"],["SC_E_042.ks/index/23/text"],["SC_E_042.ks/index/25/text"],["SC_E_042.ks/index/27/text"],["SC_E_042.ks/index/29/text"],["SC_E_042.ks/index/31/text"],["SC_E_042.ks/index/33/text"],["SC_E_042.ks/index/35/text"],["SC_E_042.ks/index/37/text"],["SC_E_042.ks/index/39/text"],["SC_E_042.ks/index/41/text"],["SC_E_042.ks/index/43/text"],["SC_E_042.ks/index/45/text"],["SC_E_042.ks/index/47/text"],["SC_E_042.ks/index/49/text"],["SC_E_042.ks/index/51/text"],["SC_E_042.ks/index/53/text"],["SC_E_042.ks/index/55/text"],["SC_E_042.ks/index/57/text"],["SC_E_042.ks/index/59/text"],["SC_E_042.ks/index/61/text"],["SC_E_042.ks/index/63/text"],["SC_E_042.ks/index/65/text"],["SC_E_042.ks/index/67/text"],["SC_E_042.ks/index/69/text"],["SC_E_042.ks/index/71/text"],["SC_E_042.ks/index/73/text"],["SC_E_042.ks/index/75/text"],["SC_E_042.ks/index/77/text"],["SC_E_042.ks/index/79/text"],["SC_E_042.ks/index/81/text"],["SC_E_042.ks/index/83/text"],["SC_E_042.ks/index/85/text"]],"tags":[],"parameters":[[{"start":171,"end":208}],[{"start":214,"end":253}],[{"start":267,"end":406}],[{"start":416,"end":417}],[{"start":427,"end":428}],[{"start":437,"end":438}],[{"start":448,"end":449}],[{"start":459,"end":484}],[{"start":498,"end":618}],[{"start":632,"end":640}],[{"start":646,"end":772}],[{"start":784,"end":1028}],[{"start":1042,"end":1087}],[{"start":1093,"end":1220}],[{"start":1234,"end":1351}],[{"start":1357,"end":1387}],[{"start":1401,"end":1684}],[{"start":1698,"end":1814}],[{"start":1820,"end":1836}],[{"start":1850,"end":1859}],[{"start":1865,"end":1919}],[{"start":1925,"end":1969}],[{"start":1979,"end":1980}],[{"start":1989,"end":2013}],[{"start":2019,"end":2028}],[{"start":2042,"end":2225}],[{"start":2239,"end":2534}],[{"start":2548,"end":2615}],[{"start":2629,"end":2731}],[{"start":2747,"end":3080}],[{"start":3096,"end":3163}],[{"start":3175,"end":3185}],[{"start":3191,"end":3275}],[{"start":3291,"end":3298}],[{"start":3307,"end":3308}],[{"start":3317,"end":3322}],[{"start":3332,"end":3333}],[{"start":3342,"end":3344}],[{"start":3355,"end":3620}],[{"start":3636,"end":3681}],[{"start":3693,"end":3718}],[{"start":3728,"end":3783}],[{"start":3795,"end":3816}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_042.ks","basename":"SC_E_042.ks","indexIds":{"ゲームの心得、\n\n飽くまでボクの持論……否、好みだけどね。":0,"@rゲームにはその経緯とモチベーションから２種類ある、\nと言える。":1,"ああ、今からキミにカタるのは、\nゲームの理論じゃない、\nあれはまた別の話だし、\nボク等のようなのが興味を持つには少々無粋で無意味な領域だからね。[l]\nモノゴトを論理的に思考するのは遊戯としては愉快だが、\n普遍的な理論として行動原理に据え":2,"声":3,"高":4,"居":5,"丈":6,"高に振る舞うのは、\n好みじゃないなあ。":7,"そういったモノは常に目安や大義名分以上のモノには成り難い場合が多いから……[l]\nそれで間に合う社会で生きるなら構わないがね、\nま、どんな時でも場合によりけり、\nケースバイケースだと言うことも常に念頭に置いてくれよ。":8,"さて話を戻そう。":9,"@r２種類とは、\n\n通常生活で蓄積したストレスの発散、\n\nとしての側面に偏重したものと、もう一つは、\n\n自らに課題を課してそれをクリアする喜びを得る、\n\nという側面に偏重したものだね。":10,"その性格上、前者は主に、\n\n破壊、\n\nの疑似体験或いはそのもの、そうでなくても、\n要するに日常からの逃避による抑圧解放と愉悦獲得だから、\n課題をクリアという側面──\nつまり低い確率を狙うったり、\n遂行に一定以上の技術が必要だったり、\n累積が必ずしもイコール実績とならないものだったり、\n思い通りに動かないものを操ったりする行為──\nは、\n単にストレスを溜めるもの、つまり厭な日常と重なる訳だ。":11,"ストレスを発散するためにしている遊戯によって\nストレスを加えられたのでは本末転倒。":12,"@rこれは、ゲームというものの占める位置が、\n当人にとって通常生活よりも低くされてる場合だね。[l]\nゲェムをする為に生きてる訳じゃないから、\n当然、下位が上位を脅かす……苛苛する行為で日常を[l]\n騒がせたくはない。":13,"逃避は楽になる為にするものだからだ。[l]\n手に余る事象を扱うことは忌避されて、\n或いは、\n程よく自分が何かを成し遂げていれているという錯覚を、\n無意識的に得る事が出来るルールや構造を求められる訳だよ。":14,"@r後者は、\n難題であるほど愉しいという考え方。":15,"つまり、\n課題をクリアした時の幸福感を得るために、\nその過程自体は辛くとも構わないという構造だね。[l]\n寧ろ、辛い程、厳しい程、\nそれを成し遂げた自分、というものに浸れる分、\n好ましいという訳だ。[l]\n誰にでも出来るものをクリアしても仕方がないんだ。[l]\n自分だけがそれを出来る、という錯覚を得る事が重んじられる。[l]\n自ずと求道的な姿勢になるから、\nストレス解消とはほど遠いね。[l]\nまあ、そういう目的でしてるからには、\nストレスもない場合もあるかも知れないけれど。":16,"要するに、\n前者と明らかに違うのは、\nゲームの占める位置が割合上位にあり、\n行為そのものに加圧や快感の両方があろうと、\nそれ自体をするためにしているが故に苦ではない、\nという構造だということ。":17,"@rちょっとややこしいかな。":18,"簡単にまとめよう。":19,"@r前者は、\n現状のプレイアァの心的状況に、\n絶対値的にプラスを与えて愉悦を得る行為で、":20,"\n後者は、\n自発的に相対値的なマイナスを与えた上で、\nそれをゼロ":21,"乃":22,"至プラスに持っていきその落差で愉悦を得る行為だ。":23,"@r簡単だろ？":24,"実際の所、仕込みの労力としては、\nあくまで私見だが後者のが実は楽だろうね。[l]\n食事を美味しくするために、直前まで空腹にしておくようなものだよ。[l]\nどちらかというと生理現象に訴えてる感が否めなくてね、\nヒトによっては安易な方法と視ることもあるだろうな。[l]\n次の悦楽の為に、敢えて抑圧、ストレスを与えておく訳だからね、":25,"正確にはプラスになっていないと言う意味でそして、\nその相対的マイナスのうちに遊戯を投げ出す者が出かねないという意味で、\n……例えば操作性の有益な機能を遊戯が進むまで取得出来ない、[l]\n不利や不如意であることを強制することによって\n取得時に大きなプラスにみせかける、\nと言った風な、\n根源的な所での機能的制限と試練との違いに対する見解の差、等色々、\nとかね、\nキミならワカルねこの例えは？[l]\nまあそんなだからね、\nボクの趣味的見地から正直な所を言うならば、\nキミにはあまり推奨しない遣り方だけれど、":26,"さてボクがハッキリとどちらのタイプなのか、\nという質問があるならば、\nその時々によって選択的である、としか言えないよ。":27,"なぜなら、\nボクは自分自身の美意識に忠実に基づいた蒐集者であって、\n逃避の為の遊戯と課題の解決により愉悦を得る行為は\n端から別のカテゴリにあり、\n二者択一項ではないからね。":28,"当然すぎて言うまでもないが、\nセカイにはどちらか一方なんて単純な縦割りが出来る事は\n少ないよ。[l]\nスキかキライかの別だけがそこにある。[l]\n簡易早急的かつ便宜的に相手を判断する為に、\n統計的経験的に流布している印象のカテゴリに\n相手を仮置きしておく、という筈だった行為が、\n印象イコール『そうである筈』に替わっているようだが。[l]\nその仮カテゴリから外れると、\n『期待はずれ』と非難されることは殊の外多いようだね。[l]\n相対的な物の視方も時と場合によりけりなんだけどね。[l]\n拙速を尊ぶ場合以外は単なる遊戯の一環としての約款の\n一形態にしかならないのだが──":29,"ThousandBrainsあたりはその辺、\n敢えてその他者の持つ印象に即して行動しようという\n愉快な癖があるけどね。":30,"ああ、話が逸れたね。":31,"@rただ最後に先の二例の後者はね、\nそれを目的とする者以外にはプレイすることすらままならない、\nという事はある、というのは含み置いた方がいいかもね。":32,"まあ、ボクらは":33,"他":34,"者のために":35,"遊":36,"戯を":37,"拵えたりは\nしないから……[l]\nんむ？[l]\n勿論、最優先事項はキミだよ。[l]\nキミの為のオハナシを、\n夜伽話をカタりきかせたいと思ってるんだ。[l]\nそれは一つの遊戯でもある。[l]\n愉悦を得る、\nキミの為の遊戯だ。[l]\n相対的で愚にも付かないＰの価値など意に介す必要もない、\nボクらの視定めた絶対的価値に基づく愉しいものを。[l]\n邪魔にはムクイが与えられる、\nその殲滅行為すらも手慰みとしてならば溜飲を下げる一助となろう。":38,"そう、一度は失敗したキミへの──、\n\n兄としてキミに出来る最上のものをね。":39,"愛しのクララ、\n\nボクの最愛の●。":40,"そのためには、\n\nそう、単純な遊戯たる『鬼事』をするにも、\n鬼と、追われる者が必要だ。":41,"そして、\n\n王の封印は──":42},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_042.ks","relPath":"/data/scenario/SC_E_042.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":43,"length":43,"percent":100},"cellInfo":[],"cacheResetOnChange":{},"lastSelectedCell":[38,0]},"/data/scenario/SC_E_043.ks":{"data":[["価値観をはかる物差しは同じ形をしているが、\n当てる角度やら何やらが人それぞれな所為で、\n大層な軋轢が生じるのは周知の事と思う。","衡量价值观的标尺形状相同，\n但因使用角度等人人各异，\n产生巨大摩擦是众所周知的。"],["ヒトは自分と違う価値観を許容し難いものであって、\nしかも、\n自分がスキなものを悪く言われるよりは、\n自分がキライなものを他人が褒め称えている状況に耐えられない、\nという傾向にある。[l]\n理由は色々あるが、それは自分で思索してみるといい。","人很难容忍与自己相左的价值观，\n而且\n比起自己喜欢的东西被贬低，\n更无法忍受讨厌的东西被他人赞美，\n这是普遍倾向。[l]\n原因有很多，最好自己思考。"],["そうだなあ、放っておける筈のどうでもいい事象に関しても、\n誰かがそれを是と唱えると、\n相対的な位置から反作用的に思考して、\n自然と自然とアンチit的に自分の中でカテゴライズされてしまうような。","比如说，即使对本可置之不理的琐事，\n一旦有人表示认同，\n就会从相对立场产生反向思考，\n自然而然在内心将其归类为反对对象。"],["\n或いは、稚拙な過去の自分と重なって視えるからかも知れないね。[l]\n自分の愚挙を再度視せつけられる事ほど羞恥を煽るものはないから。","\n或许也因为看到了与幼稚过去的自己重叠的影子。[l]\n没有比被迫重温自己蠢行更煽动羞耻的了。"],["そういう感情も有意ではあるけれど、\nまあ、心にしまっておくがいいね。","这类情感虽有意义，\n不过还是埋在心里为好。"],["すべてはさいこうのために、愉しい視界を得るために、\nいろんなミカタをたくさんミにつけておくのがいいよ。[l]\n","一切都是为了最棒，为了获得愉悦的视野，\n最好多多掌握各种视角哦。[l]\n"],["殊、\n配備されてしまった情報網によって、\n恣意的にせよ稚拙な当人の責任にせよ、\n画一化のバイアスがかけられた当節に於いては、\n絶対的にも相対的にも非常に有用だから。","尤其，\n由于已被部署的情报网，\n无论是出于主观故意还是本人拙劣的责任，\n在当下这个被强加统一化偏见的时代里，\n无论从绝对还是相对角度都极为有用。"],["そうだね、\n果たしてスキということも自分の意志なのか、\nそれとも『そう言われているからそう』なのか、\nそういう事に疑問すら持たない凡俗……[l]\nま、それで事足りるならそれで幸せだろうけど、\nボク等は違うだろ？","是啊，\n到底喜欢这件事是出于自己的意志，\n还是因为『被这么说了才这样』，\n连这种事都毫不怀疑的庸人……[l]\n嘛，如果这样就能满足倒也算幸福，\n但我们不一样对吧？"],["かといって、そう言われていないものばかりを好むといった\n反（アンチ）や間隙（ニッチ）というのも違うからね。[l]\nそれは単なる天の邪鬼だし、\n他人の基準というものあってこその相対的な判断だからだ。","话虽如此，专门喜欢那些不被主流认可的东西\n这种反叛（anti）或小众（niche）行为也不对哦。[l]\n那只是单纯的唱反调，\n毕竟要有他人的标准才能做出相对判断。"],["誰もやらないことをするのは英断だとは一概に云えない、\n当然だね？[l]\n今まで誰もやらなかったのには理由がある──事もあるし、\n皆がやっているのは正解──の１つだからという事もある。[l]\nそれを単に天の邪鬼的にアウトローを気取った所で、\n正解を選ばないのは単なる愚挙だろ？[l]\n解法や到達点、つまり正解は１つとは限らないが、\n正解と誤解の間には、歴然とした絶対差があるのだ。[l]\nこれは塞翁失馬の論理とは別枠で考えていいだろうね。","不能武断地说做没人做过的事就是英明决策，\n很理所当然吧？[l]\n至今没人做过可能是有原因的——有时候是这样，\n而大家都在做的可能正是正确答案——的其中一种。[l]\n就算装模作样地以叛逆者自居，\n不选择正确答案不就是纯粹的蠢行吗？[l]\n解决方法和终点——即正确答案未必唯一，\n但正确与误解之间存在绝对的差距。[l]\n这和塞翁失马的逻辑应该分开考虑。"],["ある方の言葉を借りるなら、\n脱他律的規範と無戒は違うということだね。","借用某位的话来说，\n就是摆脱他律规范与无戒是不同的概念。"],["戒めが無い──自由であるという事は、\n自らに枷を課すも自由という事であって、\n遮二無二束縛を脱しようとする事とは別だろう。","没有戒律——所谓自由，\n也包含给自己戴上枷锁的自由，\n和盲目挣脱束缚是两回事。"],["自我が確固たるものならば、\n揺らぐことも少なくなる。[l]\nその為の意識構造の資質が、我等のそれだから。[l]\n凡俗の価値観とは全く無関係に、\nつまり相対的な価値ではなく絶対的な基準をはかる規矩準縄即ちシキを、\nもってセカイを視るのが我等だからね。[l]\nＰという脆弱なる相対価値及び本質とは無関係の場にしか興味のない者、\n発する側も受くる側も同様だ。[l]\n虎の巻の実在を信ずる者には……まあ言わないでおこうか。[l]\nDon't trust under ナントカ、って言葉もあるしね。[l]\nそう言うことさ。","若自我足够坚定，\n动摇就会减少。[l]\n因为我们具备为此而生的意识结构资质。[l]\n与庸俗的价值观完全无关，\n即以规矩准绳——亦即绝对基准的SHIKI，\n而非相对价值来观察世界，这就是我们。[l]\n对P这种脆弱的相对价值及本质无关的领域才有兴趣的人，\n无论是传播方还是接收方都半斤八两。[l]\n至于相信秘传书真实存在的人……还是不说为妙。[l]\n毕竟有句话叫Don't trust under 某某嘛。[l]\n就是这么回事。"],["そして、\n実演は兎も角、オトもヨめない者は軽蔑だよ。[l]\n勘違いしている者とはなるべく関わらない事だ。[l]\n気持ち悪いだけだからね。[l]\nボクが隠遁せざるを得ないのはそこに起因してるんだが──\nま、キミは強いから。[l]\n接触することがあろうがなかろうが、\nそんなものらは毛程も気にかけないでくれると思うよ。[l]\n言葉が無くともワカルものが、我等が欲するもの。[l]\n言説の外側にして感得せしもの、\nハコの中に在るもの。","还有，\n实际演示另当别论，连音律都把握不了的家伙最令人不齿。[l]\n要尽量避免和那些自以为是的人接触。[l]\n只会让人觉得恶心罢了。[l]\n我不得不隐居就是源于这个——\n不过你很强。[l]\n无论是否接触，\n我想你根本不会把那种人放在眼里吧。[l]\n无需言语也能理解之物，才是我们渴求的。[l]\n超越言说而感知到的，\n存在于箱中之物。"],["真実？[l]\n否、そういう観念じゃないよ。[l]\nわかってるくせに。あははは。[l]\n思考する主体が無ければ真も偽もない、\n存在が在るのみに如何なる観測で定義するかがシキだもの。[l]\n始祖も言っていたらしいね。[l]\nこういう思考形式ってのは物理的に継承され得るのかな？[l]\nんむー、単に環境かなあ。","真实？[l]\n不，不是那种概念啦。[l]\n明明心知肚明。哈哈哈。[l]\n没有思考主体就无所谓真假，\n存在本身如何被观测定义才是SHIKI。[l]\n始祖似乎也说过呢。[l]\n这种思考模式能通过物理方式继承吗？[l]\n嗯——或许单纯是环境使然？"],["いずれ言葉は不自由なものだから、\n囚われる事ないように。[l]\nボク等の様に、遊戯に用いる分には大変に面白い素材だけどね。","毕竟语言终究是种不自由的东西，\n别被它束缚了。[l]\n像我们这样用于游戏的话，倒是非常有趣的素材呢。"],["最強の魔法たるは歌だよ。[l]\n言葉はその構成要素であって全体じゃない。[l]\n最近は発するも受くるも及第でないのが多いが──","最强的魔法当属歌声。[l]\n语言只是其构成要素而非全部。[l]\n最近无论是表达者还是接收者多半都不及格——"],["ま、\nそれこそスキかキライか。[l]\nそう言う意味では残念な風潮ではあるよ。[l]\n幾ら対可能性に対して大量のパターンが必要とは言え、\n今の時代は若干偏向の気があるかなあ。[l]\n最悪の箱庭たるセカイのそこが最悪たる","嘛，\n这本身就看个人喜好了。[l]\n从这个意义上说确实是令人遗憾的风潮。[l]\n虽说应对可能性确实需要大量模式，\n但这个时代总觉得有些偏颇呢。[l]\n作为最恶劣箱庭的世界之所以最恶劣"],["所","的"],["以\nだから致し方ない。","以\n所以也是无可奈何。"],["その中から選択的に自身が望むものを","从中选择性获取自己想要的"],["視","视"],["取るのが我等、\nあのSHOBもそこを視誤っているようだが、\n補って余りある何かが彼女にまとわりついているがゆえ、\n今のところはあの場所を固辞出来てるみたいだね。","正是我们的做法，\n那个SHOB似乎也看错了这点，\n不过她身上缠绕着某种足以弥补缺陷的东西，\n所以目前还能固守在那个位置吧。"],["『そのために』走り続けるか、\nそれとも別の場所へと進むのかは、\n彼女次第か。[l]\nいずれにしても立ち止まることは赦されていない。[l]\nそんな彼女を憐れむか蔑むかは、キミ自身の話。","『为此』继续奔跑，\n还是转向其他方向，\n就看她自己了。[l]\n无论如何都不被允许停下脚步。[l]\n怜悯还是蔑视那样的她，取决于你自己。"],["遊戯に限らずセカイは闘争し合うべく御膳立てがされている……[l]\nなんて最悪なんだろうね。[l]\n","不仅是游戏，整个世界都被安排成相互争斗的格局……[l]\n真是糟糕透顶呢。[l]\n"],["各","各"],["各が","各"],["銘","铭"],["銘に、\n生き残る為に全力を尽くすということが、\nどういうことになるのか、\nもしセカイを創りしものにヒトの言う意思というものがあったなら、\nそれはさぞや──","铭\n为了生存而拼尽全力这件事，\n究竟意味着什么，\n如果创造世界者拥有所谓人类意志的话，\n想必会——"],["さて、","话说，"],["\n猫はその愛らしさと","\n猫凭借其可爱"],["狡","狡"],["知を以てヒトを下僕たらしめた。","黠与智慧将人类驯化为奴仆。"],["@r自分達の望むものを、己の全てを以てして、\n而して物理的労力を極力避けんが為にヒトを魅了することによってなさんとする、\n逆家畜手法とも言うべき賢き遣り方だ。[l]\n己が種をヒトの家畜化とすることにより保存する遣り方よりは、\n愉しいと思わないか？","@r将自己渴望之物，用尽自身全部手段，\n同时为最大限度避免体力劳动而通过魅惑人类达成目的，\n堪称逆向驯化的高明手法。[l]\n比起将本族作为人类家畜来保存的方式，\n不觉得这样更有趣吗？"],["ヒトでもね、Ｘの殆どが体得している、\nおそらくはたったひとつの冴えたやりかただ。","人类中X的大多数也掌握着，\n恐怕是唯一精妙的手段。"],["@r我等がCATはどうだろうね？","@r我们的CAT又如何呢？"],["Connecter,\nAlterEgo,\nTrance,",""],["\nアイ is destructiveとも何かで言っていたように、\n激しく、愛撫と言うにはあまりにも犠牲や痛みを伴うが、\nその先には──","\n记得有说法称爱 is destructive，\n激烈到称爱抚都太过勉强，伴随着牺牲与痛苦，\n但在那之后——"],["\nんむ？[l]\nそろそろ眠くなったかな。","\n嗯？[l]\n好像有点困了。"],["おやすみ、心ゆくまで。","晚安，愿你心满意足。"],["\n\nそうだ、","\n\n对了，"],["\n言い忘れたけど……もう眠ってしまったかな。","\n有句话忘了说……已经睡着了吗。"],["RolePlayingGame（役を演じる遊戯）には、","RolePlayingGame（扮演角色的游戏）中，"],["\n最強の装備、最後の切り札、","\n最强装备、终极杀手锏，"],["\nがツキものなんだ。","\n都是附赠品。"],["いずれにしても、","总之，"],["\nゲームをあそぶには、プレイアァと敵が必要で──","\n玩游戏需要玩家和敌人——"]],"context":[["SC_E_043.ks/index/1/text"],["SC_E_043.ks/index/3/text"],["SC_E_043.ks/index/5/text"],["SC_E_043.ks/index/7/text"],["SC_E_043.ks/index/9/text"],["SC_E_043.ks/index/11/text"],["SC_E_043.ks/index/14/text"],["SC_E_043.ks/index/16/text"],["SC_E_043.ks/index/18/text"],["SC_E_043.ks/index/20/text"],["SC_E_043.ks/index/22/text"],["SC_E_043.ks/index/24/text"],["SC_E_043.ks/index/26/text"],["SC_E_043.ks/index/28/text"],["SC_E_043.ks/index/30/text"],["SC_E_043.ks/index/32/text"],["SC_E_043.ks/index/34/text"],["SC_E_043.ks/index/36/text"],["SC_E_043.ks/index/38/text"],["SC_E_043.ks/index/40/text"],["SC_E_043.ks/index/42/text"],["SC_E_043.ks/index/44/text"],["SC_E_043.ks/index/46/text"],["SC_E_043.ks/index/48/text"],["SC_E_043.ks/index/50/text"],["SC_E_043.ks/index/53/text"],["SC_E_043.ks/index/55/text"],["SC_E_043.ks/index/57/text"],["SC_E_043.ks/index/59/text"],["SC_E_043.ks/index/61/text"],["SC_E_043.ks/index/63/text"],["SC_E_043.ks/index/65/text"],["SC_E_043.ks/index/67/text"],["SC_E_043.ks/index/69/text"],["SC_E_043.ks/index/71/text"],["SC_E_043.ks/index/73/text"],["SC_E_043.ks/index/75/text"],["SC_E_043.ks/index/77/text"],["SC_E_043.ks/index/79/text"],["SC_E_043.ks/index/81/text"],["SC_E_043.ks/index/83/text"],["SC_E_043.ks/index/85/text"],["SC_E_043.ks/index/87/text"],["SC_E_043.ks/index/89/text"],["SC_E_043.ks/index/91/text"],["SC_E_043.ks/index/93/text"],["SC_E_043.ks/index/95/text"]],"tags":[],"parameters":[[{"start":153,"end":224}],[{"start":236,"end":375}],[{"start":385,"end":493}],[{"start":499,"end":573}],[{"start":585,"end":623}],[{"start":633,"end":692}],[{"start":706,"end":804}],[{"start":816,"end":941}],[{"start":951,"end":1061}],[{"start":1071,"end":1321}],[{"start":1331,"end":1369}],[{"start":1379,"end":1448}],[{"start":1460,"end":1756}],[{"start":1768,"end":2022}],[{"start":2032,"end":2212}],[{"start":2224,"end":2293}],[{"start":2305,"end":2376}],[{"start":2386,"end":2514}],[{"start":2523,"end":2524}],[{"start":2534,"end":2549}],[{"start":2557,"end":2574}],[{"start":2583,"end":2584}],[{"start":2593,"end":2685}],[{"start":2693,"end":2800}],[{"start":2810,"end":2863}],[{"start":2877,"end":2878}],[{"start":2888,"end":2890}],[{"start":2900,"end":2901}],[{"start":2911,"end":3004}],[{"start":3014,"end":3017}],[{"start":3023,"end":3037}],[{"start":3047,"end":3048}],[{"start":3057,"end":3072}],[{"start":3078,"end":3219}],[{"start":3231,"end":3275}],[{"start":3281,"end":3299}],[{"start":3311,"end":3347}],[{"start":3353,"end":3432}],[{"start":3438,"end":3466}],[{"start":3474,"end":3485}],[{"start":3491,"end":3505}],[{"start":3511,"end":3537}],[{"start":3549,"end":3576}],[{"start":3582,"end":3600}],[{"start":3606,"end":3620}],[{"start":3630,"end":3638}],[{"start":3644,"end":3672}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_043.ks","basename":"SC_E_043.ks","indexIds":{"価値観をはかる物差しは同じ形をしているが、\n当てる角度やら何やらが人それぞれな所為で、\n大層な軋轢が生じるのは周知の事と思う。":0,"ヒトは自分と違う価値観を許容し難いものであって、\nしかも、\n自分がスキなものを悪く言われるよりは、\n自分がキライなものを他人が褒め称えている状況に耐えられない、\nという傾向にある。[l]\n理由は色々あるが、それは自分で思索してみるといい。":1,"そうだなあ、放っておける筈のどうでもいい事象に関しても、\n誰かがそれを是と唱えると、\n相対的な位置から反作用的に思考して、\n自然と自然とアンチit的に自分の中でカテゴライズされてしまうような。":2,"\n或いは、稚拙な過去の自分と重なって視えるからかも知れないね。[l]\n自分の愚挙を再度視せつけられる事ほど羞恥を煽るものはないから。":3,"そういう感情も有意ではあるけれど、\nまあ、心にしまっておくがいいね。":4,"すべてはさいこうのために、愉しい視界を得るために、\nいろんなミカタをたくさんミにつけておくのがいいよ。[l]\n":5,"殊、\n配備されてしまった情報網によって、\n恣意的にせよ稚拙な当人の責任にせよ、\n画一化のバイアスがかけられた当節に於いては、\n絶対的にも相対的にも非常に有用だから。":6,"そうだね、\n果たしてスキということも自分の意志なのか、\nそれとも『そう言われているからそう』なのか、\nそういう事に疑問すら持たない凡俗……[l]\nま、それで事足りるならそれで幸せだろうけど、\nボク等は違うだろ？":7,"かといって、そう言われていないものばかりを好むといった\n反（アンチ）や間隙（ニッチ）というのも違うからね。[l]\nそれは単なる天の邪鬼だし、\n他人の基準というものあってこその相対的な判断だからだ。":8,"誰もやらないことをするのは英断だとは一概に云えない、\n当然だね？[l]\n今まで誰もやらなかったのには理由がある──事もあるし、\n皆がやっているのは正解──の１つだからという事もある。[l]\nそれを単に天の邪鬼的にアウトローを気取った所で、\n正解を選ばないのは単なる愚挙だろ？[l]\n解法や到達点、つまり正解は１つとは限らないが、\n正解と誤解の間には、歴然とした絶対差があるのだ。[l]\nこれは塞翁失馬の論理とは別枠で考えていいだろうね。":9,"ある方の言葉を借りるなら、\n脱他律的規範と無戒は違うということだね。":10,"戒めが無い──自由であるという事は、\n自らに枷を課すも自由という事であって、\n遮二無二束縛を脱しようとする事とは別だろう。":11,"自我が確固たるものならば、\n揺らぐことも少なくなる。[l]\nその為の意識構造の資質が、我等のそれだから。[l]\n凡俗の価値観とは全く無関係に、\nつまり相対的な価値ではなく絶対的な基準をはかる規矩準縄即ちシキを、\nもってセカイを視るのが我等だからね。[l]\nＰという脆弱なる相対価値及び本質とは無関係の場にしか興味のない者、\n発する側も受くる側も同様だ。[l]\n虎の巻の実在を信ずる者には……まあ言わないでおこうか。[l]\nDon't trust under ナントカ、って言葉もあるしね。[l]\nそう言うことさ。":12,"そして、\n実演は兎も角、オトもヨめない者は軽蔑だよ。[l]\n勘違いしている者とはなるべく関わらない事だ。[l]\n気持ち悪いだけだからね。[l]\nボクが隠遁せざるを得ないのはそこに起因してるんだが──\nま、キミは強いから。[l]\n接触することがあろうがなかろうが、\nそんなものらは毛程も気にかけないでくれると思うよ。[l]\n言葉が無くともワカルものが、我等が欲するもの。[l]\n言説の外側にして感得せしもの、\nハコの中に在るもの。":13,"真実？[l]\n否、そういう観念じゃないよ。[l]\nわかってるくせに。あははは。[l]\n思考する主体が無ければ真も偽もない、\n存在が在るのみに如何なる観測で定義するかがシキだもの。[l]\n始祖も言っていたらしいね。[l]\nこういう思考形式ってのは物理的に継承され得るのかな？[l]\nんむー、単に環境かなあ。":14,"いずれ言葉は不自由なものだから、\n囚われる事ないように。[l]\nボク等の様に、遊戯に用いる分には大変に面白い素材だけどね。":15,"最強の魔法たるは歌だよ。[l]\n言葉はその構成要素であって全体じゃない。[l]\n最近は発するも受くるも及第でないのが多いが──":16,"ま、\nそれこそスキかキライか。[l]\nそう言う意味では残念な風潮ではあるよ。[l]\n幾ら対可能性に対して大量のパターンが必要とは言え、\n今の時代は若干偏向の気があるかなあ。[l]\n最悪の箱庭たるセカイのそこが最悪たる":17,"所":18,"以\nだから致し方ない。":19,"その中から選択的に自身が望むものを":20,"視":21,"取るのが我等、\nあのSHOBもそこを視誤っているようだが、\n補って余りある何かが彼女にまとわりついているがゆえ、\n今のところはあの場所を固辞出来てるみたいだね。":22,"『そのために』走り続けるか、\nそれとも別の場所へと進むのかは、\n彼女次第か。[l]\nいずれにしても立ち止まることは赦されていない。[l]\nそんな彼女を憐れむか蔑むかは、キミ自身の話。":23,"遊戯に限らずセカイは闘争し合うべく御膳立てがされている……[l]\nなんて最悪なんだろうね。[l]\n":24,"各":25,"各が":26,"銘":27,"銘に、\n生き残る為に全力を尽くすということが、\nどういうことになるのか、\nもしセカイを創りしものにヒトの言う意思というものがあったなら、\nそれはさぞや──":28,"さて、":29,"\n猫はその愛らしさと":30,"狡":31,"知を以てヒトを下僕たらしめた。":32,"@r自分達の望むものを、己の全てを以てして、\n而して物理的労力を極力避けんが為にヒトを魅了することによってなさんとする、\n逆家畜手法とも言うべき賢き遣り方だ。[l]\n己が種をヒトの家畜化とすることにより保存する遣り方よりは、\n愉しいと思わないか？":33,"ヒトでもね、Ｘの殆どが体得している、\nおそらくはたったひとつの冴えたやりかただ。":34,"@r我等がCATはどうだろうね？":35,"Connecter,\nAlterEgo,\nTrance,":36,"\nアイ is destructiveとも何かで言っていたように、\n激しく、愛撫と言うにはあまりにも犠牲や痛みを伴うが、\nその先には──":37,"\nんむ？[l]\nそろそろ眠くなったかな。":38,"おやすみ、心ゆくまで。":39,"\n\nそうだ、":40,"\n言い忘れたけど……もう眠ってしまったかな。":41,"RolePlayingGame（役を演じる遊戯）には、":42,"\n最強の装備、最後の切り札、":43,"\nがツキものなんだ。":44,"いずれにしても、":45,"\nゲームをあそぶには、プレイアァと敵が必要で──":46},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_043.ks","relPath":"/data/scenario/SC_E_043.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":46,"length":47,"percent":97.87234042553192},"cellInfo":[]},"/data/scenario/SC_E_044.ks":{"data":[["「僕が聞いていて思ったのは──\n種痘というのは基本的に予防法ですよね？[l]\nワクチンと血清……療法でしたっけ、[l]\nそれは確か違うものだと認識してましたが……」","「我听着就在想——\n种痘基本是预防法对吧？[l]\n疫苗和血清……算是疗法来着，[l]\n我确实记得这两者不同」"],["「ふむ、まあ語義やら何やら細かな定義や専門非専門的使用場、\n慣例的表現、諸条件が背景にあることを鑑み且つ踏まえて、\n大雑把にそう括ってもさしたる問題はなかろうね。[l]\nないけれどもね、\nいつもの通りのメタファー、\nその他狂歌仕立てやら駄洒落見立てその他諸々、\n込みでの話だな。[l]\n少年には今更言うまでもない事だが」","「唔，暂且抛开语义之类细枝末节的定义和专业非专业的使用场景，\n考虑到背后存在的惯例表达和各种条件背景，\n粗略这么概括应该问题不大吧。[l]\n虽然也不是完全没有问题啦，\n还是老一套的隐喻手法，\n加上那些狂歌式的俏皮话、双关语之类的玩意儿，\n总之是包含这些要素的讨论呢。[l]\n虽然对少年来说现在讲这个还为时过早」"],["「先生にそう仕込まれましたからね…」","「因为被老师这么教导过了啊…」"],["「キミにその素質ありと視たから、だよ。[l]\n黙っていたって少年は遅かれ早かれそういった人格形成を\n自ずと成していったろうけどね。[l]\nそしてそう、少年の考えている通りだ。[l]\n免疫系というのは組織にとって重要なシステムだ。[l]\n現状はその新しきコウタイ、そのコウセイ、シンコウ中でもある。[l]\n──ところで、種痘、予防接種というのは、\n人為的意図的に行われるものでね。[l]\n自然界に於いては、\nそれこそ手加減無しの実戦を、\n身を以て経験、広義の学習をした上で克服、\n場合によってはそれで脱落していくものなのだが──」","「是我看出你具备这样的资质才这么做的。[l]\n就算我不说，少年迟早也会自然而然\n形成那样的人格吧。[l]\n而且正如少年所想的那样。[l]\n免疫系统对组织而言是至关重要的体系。[l]\n目前正处于那个新抗体、其构造尚在进化中的阶段。[l]\n──话说回来，种痘、预防接种这类行为，\n都是人为刻意进行的。[l]\n在自然界中，\n那可是毫无保留的实战，\n必须亲身经历广义的学习后才能克服，\n有时候甚至会因此被淘汰──」"],["「ええ。[l]\nでも、\n先生の言いたいのはそういう事じゃないんでしょ」","「嗯。[l]\n但是，\n老师想说的不是这个吧」"],["「ふむ。[l]\nまあ、その発言自体が意図の理解と受け止めるよ。[l]\n僕もキミに命令をしたい訳ではないからね。[l]\nとは言え期待もしない人間に対して僕は興味を全く、」","「唔。[l]\n也罢，我就把这句话当作你理解了我的意图。[l]\n毕竟我也不想对你下命令。[l]\n不过对于完全不抱期待的人，我可是半点兴趣都──」"],["「………」",""],["「持たないからね。[l]\n答えが既に用意してあるような『期待』をしないだけさ」","「不会有的。[l]\n只是不对那种答案早已准备好的『期待』抱希望而已」"],["「僕は先生に教えを受けた子供ですから。[l]\nまあ、その──」","「我可是受教于老师的孩子啊。[l]\n呃，那个──」"],["「そうだね、先刻の話と無理矢理関連させるなら、\n学習というのは大事だな。[l]\nこれも広義の種痘と言えなくもない。[l]\nそれそのものよりも、それを如何に次代に役立てるかが肝要だ。[l]\n若き時代の苦や労は、\n将来的に襲い来るそれに対する免疫を得る為に甘んじて受ける物なのだ、\nという事を理解していれば、\n如何なるモノゴトも滋養たり得る。[l]\n眼前の益や気持ちよさだけを追求していては到達できない、\nコドモには分からない愉悦の為の下準備、\n而して免疫というのはおしなべてコドモの時に造らねば\n厄介だというジレンマを抱えてもいるのだなあ。[l]\nオトナのハシカは重篤になるものだ、勿論病症に限らずね。[l]\n症状そのものだけでなく、時に荒療治にもなれば、\nその過程でも他人に迷惑が及んだりする──\n全く厄介な……ああ、何でもないよ、ふふ」","「是啊，如果硬要联系刚才的话题，\n学习确实很重要呢。[l]\n这也可以说是广义的种痘。[l]\n比起事物本身，如何让它造福下一代才是关键。[l]\n年轻时的苦难，\n是为了获得将来应对更大苦难的免疫力而甘愿承受的，\n只要明白这一点，\n任何事物都能成为养分。[l]\n若只追求眼前利益和快感，就永远无法体会到\n孩子们无法理解的、为了愉悦而做的准备，\n而且免疫力这东西基本上必须在孩童时期培养，\n否则就会陷入棘手的矛盾中啊。[l]\n成年人的麻疹会恶化得很严重，当然不限于病症本身。[l]\n不仅症状本身更严重，有时需要猛药治疗，\n过程中还会给旁人添麻烦──\n真是麻烦……啊，没什么，呵呵」"],["「つまりその、『それ』が種痘の意味だったのだとしたら、\n少し遅かったってことですか、その、それ…対象にとっては」","「也就是说，如果那个『它』就是种痘的意义，\n对那个、那个对象来说就有点太迟了吧」"],["「まあ、手遅れでは無かったのだがね、\n如何せん過保護に過ぎた……というか、\n偏向教育ではあったのだろう。[l]\nその過程に於いて大仰な喜、否、悲劇かな。[l]\n僕の善く知るニンゲンも多数割を食う事になった」","「嘛，倒也不算太晚，\n只不过保护过度了……或者说，\n算是偏向性教育吧。[l]\n过程中还闹出过夸张的喜...不，悲剧呢。[l]\n我熟知的不少人类都吃了苦头」"],["その辺の、『具体的な実際の人間、相関関係』は、\n未だ先生からも切れ切れにしか聞いてない。","关于那些『具体的实际人物及其关联性』，\n到现在老师也只是断断续续提过几句。"],["「だからねえ、\nそう、出来れば若い、コドモの内に、\n他の意思というものを沢山に視ておいた方が、\n思考の滋養になるのだよ。[l]\nそういう意味でも今のキミの立場は有益と覚えておき給え。[l]\n将来酒宴の席での肴になるだけじゃあないのだよ。[l]\n最も、それが大いに役立つ事象や場もあろうがね。[l]\nいずれまだ早い。[l]\n早いが、眼前の欲や表層だけ視たときに覚える無意味さに、\n惑わされてはならぬのだ。[l]\n先程も言ったように、あらゆるコトはクえるのだからね」","「所以说啊，\n没错，如果可能的话趁年轻、还是小孩的时候，\n多见识些他人的想法，\n对思维成长很有帮助哦。[l]\n从这个意义上来说，你现在的处境也是有益的，要记住这点。[l]\n可不只是为了将来在酒桌上当谈资而已。[l]\n当然，有些场合和情况确实能派上大用场就是了。[l]\n不过现在说这些还太早。[l]\n虽然早，但绝不能因为眼前欲望或表面现象带来的虚无感，\n就迷失方向啊。[l]\n就像刚才说的，所有事情终会迎来结局的」"],["「喰ってミにする──ですね。[l]\n御陰様で好き嫌い無く給食も食べてますよ僕。[l]\n体調だってすごく良いし」","「吃掉试试——是吧。[l]\n托您的福我现在完全不挑食连营养餐都吃得下。[l]\n身体状态也特别好呢」"],["「結構だね。[l]\nま、キミも既に身を以て知っているかも知れないが、\n若き幼き頃の種痘が苦痛であった者達が、\nその苦を苦としか受け取れず、\n情けか愛情のつもりか自分の後代に対しそれを免除するという、\n至極有り難迷惑な処置をした挙げ句結果誰もが重篤な症状に、\nしかもパンデミックに──\n分かるね？[l]\n抗体は抗原無くしては作れない、\n無菌で育てられたモノは外界に出れば瞬く間に淘汰されるのにね。[l]\n必要な滋養やワクチンと、無意味或いは過剰分のまるでシボウのようなモノとの、\n単純な区別もつかなかった者達の罪業だな。[l]\nしかしてその病症の","「很不错嘛。[l]\n不过，或许你也亲身体会到了，\n那些把幼时接种疫苗的痛苦\n仅仅当作痛苦来承受的人，\n出于怜悯或自以为是的爱而对后代免除接种，\n结果这种极其令人困扰的处理方式让所有人都出现重症，\n甚至引发大流行——\n明白吗？[l]\n没有抗原就产生不了抗体，\n无菌环境养大的生物放到外界瞬间就会被淘汰啊。[l]\n连必要营养与疫苗、和无用或过量到近乎虐待的东西都\n分不清的那些人造的孽。[l]\n而这种病症"],["質の悪い点は、\nそういう環境を作り上げた先代どもではなく、\n後代に顕れるという所だ。[l]\nそして更に、その悪環境が結局は先代どもに跳ね返る形で、\nまあ、あの有様だ。[l]\nそのような状態になることを望んでシたのならまさに効果的、\n","最恶劣之处在于，\n问题不会显现在营造那种环境的前辈身上，\n而会报应在后代。[l]\n进而那个恶劣环境最终会反噬前辈们，\n嘛，就是那副惨状。[l]\n如果本意就是想制造那种状态倒确实有效，\n"],["覿","直"],["面も覿面だった訳だがね。[l]\nそんな訳で──誰の利にもならぬ事くらいも","面效果也立竿见影呢。[l]\n正因如此——连这种对谁都没好处的事都"],["視","视"],["越せない、\nしかしながら上下問わず蔓延るそのマジョリティーのチカラ、\nそれが存在する事は事実、\n社会性と構造、言葉は無形なるものに有形と等価、\n或いはそれ以上の価値を付随させるという、\n想像力豊かな人類は、\nアリもしないモノに振り回される希有な存在となった。[l]\nそれがヒトのヒトたる所以と言ってしまえば聞こえは良いがね、\n人の世は中々切ないモノなのだよ」","无法跨越，\n但无论上下层都蔓延的那种多数派力量，\n其存在确是事实，\n社会性与结构、语言会给无形之物赋予与有形等同、\n甚至更高的价值，\n想象力丰富的人类就这样成了\n会被不存在之物摆布的稀有物种。[l]\n要说这就是人之所以为人倒挺好听，\n人世间可真是充满无奈啊」"],["「僕等からしてみれば自業自得……というところですけど。[l]\n……て、これはあの話とは違いますね？」","「从我们角度看算是自作自受……不过。[l]\n……呃，这和刚才说的不是一回事吧？」"],["よく判らないけど、多分一般論というやつを語ってるのだろう。[l]\n先生は、よく話の中身が行ったり来たりする。[l]\n愉しくもあるけど、そういうものと思って聞いてないと混乱してしまう。","不太明白，大概是在讲某种普遍理论。[l]\n老师总爱把话题跳来跳去。[l]\n虽然有趣，但不用流动思维去听就会混乱。"],["「結局、建前と本音を使い分けできない、\n或いは使う本人も混同してしまって居る場合も今や多数だが、\nそれに加え、受け取る側もそれらの区別を付けられぬ、\nそういう世になってしまった所に僕等の悲しみがあるのだな。[l]\nま、\n敷衍するならば、\n全てはコトバによる明文化、の所為だよ。[l]\n本来的に割り切ることの出来ないこのセカイでは、\nコトバを真理を指し示す道具として使用すると\n","「说到底，如今越来越多人分不清场面话和真心话、\n甚至自己都混淆了，\n再加上接收方也无法区分，\n这就是我们所处的可悲世道啊。[l]\n嘛，\n要展开说的话，\n全怪语言文字的具象化。[l]\n在这个本质上无法非黑即白的世界里，\n若把语言当作指向真理的道具来使用，\n"],["不具","就会产"],["合が生じるのだ。[l]\n","生错位。[l]\n"],["殊この國では中々多言語と接する機会が無いからね。[l]\nコトバで全てを伝えられると錯覚する事が多くなるのだよ。[l]\nとは言え社会の中でコミュニケーションをとる場合は、\nまあお約束として通ずる範囲で有用に使役するがいいがね。[l]\nその場合は逆に、言わねば通じぬ解らぬ事もあるしね、\nそれでいて言わずとも解れというのは酷なのだ。[l]\n場や相によってはそういう立ち位置もある、という事だ。[l]\nわかりにくいだろうけどね。[l]\nそれがわかるということは老獪になる、という事でもあるが、\n知っていて使い分ける分には有益だよ？[l]\n無知の知、の前提で、敢えての……ふむ。[l]\nその辺りはおいおいだね。[l]\nそう言うわけで、\n故に、君等のような人材はね、\n僕等と同じものをミ、愉しめるだろう」","毕竟在这个国家很少有机会接触多语言呢。[l]\n人们常常会误以为用语言就能传达一切。[l]\n虽说在社会中进行交流时，\n只要在约定俗成的范围内有效运用就行。[l]\n但反过来说，有些事不说就无法理解，\n而要求别人不说也能懂就太苛刻了。[l]\n这意味着根据场合和对象，存在这样的立场。[l]\n虽然可能很难理解吧。[l]\n能理解这点说明你变得老练了，\n只要懂得区分使用就是有益的哦？[l]\n在\"无知之知\"的前提下，刻意...嗯。[l]\n这些就慢慢体会吧。[l]\n综上所述，\n因此像你们这样的人才，\n应该也能和我们品味相同的\"mi\"吧」"],["「だと良いですけど……[l]\nまあ、先生の話はいつも愉しく聞いてますよ、僕」","「但愿如此...[l]\n不过老师说的话我总是听得很开心呢，我」"],["「大変結構だ。[l]\nそうだな、\n良薬口に苦し、若い頃の苦労は買ってでもしろ、\n昔のヒトのコトバは聞く物だよ。[l]\n","「那很好。[l]\n是啊，\n良药苦口，年轻时要自找苦吃，\n古人的话值得倾听。[l]\n"],["俚","俚"],["諺という物は、\n流れた実時間に準ずる個人に収まらぬ大量の経験に即したもの、\nなのだからね。[l]\n空想ごとや理に適わぬ戯言であったならとっくに時が淘汰している。[l]\nつまり、」","所谓谚语，\n是源于漫长岁月中超出个人范畴的大量经验，\n就是这么回事。[l]\n若是空想或不合常理的妄言，早就会被时间淘汰。[l]\n也就是说，」"],["愉しいことは愉しいんだけど……","开心的事固然开心..."],["「──今は情報伝達速度が速すぎてね、\n……理由はそれだけではないが、」","「──如今信息传递速度太快了，\n...虽然原因不止于此，」"],["時と場合によるんだよな……[l]\n今は人待ちだし、\n携帯電話の電池も切れるかも知れないと思うと気が気じゃない。[l]\n料金はまあ、先生持ちだけど。","要看时间和场合啊...[l]\n现在在等人，\n想到手机可能会没电就坐立不安。[l]\n话费嘛，反正老师会付。"],["「──そう、新たな刺激を求め続ける、\nだが忘れないように、\nぐるぐると円環を描くだけの見せかけの変化に陥らぬよう。[l]\n我等がミも体現している、つまりは螺旋を……[l]\nおや。[l]\n話が逸れているか？[l]\nすまないね。[l]\n思考の統御がどうもなあ、まだ本調子じゃないんだなぁ。[l]\n少々アソビが過ぎたようでね、\n年寄りには堪える──」","「──没错，要不断追求新刺激，\n但别忘了，\n不要陷入只是画圆般的虚假变化中。[l]\n我们体现的\"mi\"正是螺旋...[l]\n哎呀。[l]\n是不是跑题了？[l]\n抱歉啊。[l]\n思维控制还不太...没在最佳状态呢。[l]\n似乎玩得有点过头，\n对老人家来说太吃力──」"],["「……え、先生が？[l]\n冗談でしょう」","「...诶，老师您？[l]\n开玩笑的吧」"],["「ふふ、僕とてヒトだからね。[l]\nそれにしても──\n休む事自体にも節度ってのは要るのだな。[l]\n俗に","「呵呵，我也是人啊。[l]\n话说回来──\n连休息本身也需要节制呢。[l]\n俗话"],["鈍るというこの感覚はどうにも……」","说这种迟钝感实在..."],["「それでアイドリングでしたっけ？[l]\n準備運動は大事ですよね」","「所以是叫怠速运转来着？[l]\n准备运动很重要呢」"],["「ふむ、ま、\n僕も行為行為にインターバルは敢えて入れる様にしているのだが……[l]\nヒトは慣れると効率化を求めるものなのだよ。[l]\nルーチン化されてオートメーションされた回路を使ってしまう。[l]\nだから可能な限りの行為は新鮮な刺激として受け入れられる様に、\nて事だがね。[l]\n音楽でも何でも、\n感動したり好みのものはヘヴィーローテーションしてしまいがちだが、\n慣れとは恐ろしくてね、どんなものでもアキがきてしまう。[l]\n治療の為の薬品などに対してですら耐性が出来る訳で──」","「嗯，这个嘛，\n我也有意在各动作间加入间隔...[l]\n人一旦习惯就会追求效率。[l]\n会使用那些已经流程化自动化的回路。[l]\n所以要让所有行为尽可能作为新鲜刺激被接受，\n就是这么回事。[l]\n音乐也好什么也好，\n感动或喜欢的东西容易单曲循环，\n但习惯很可怕，任何东西都会腻。[l]\n就连治疗药物也会产生抗药性──」"],["「でもマクロ処理みたいなのは有益なんじゃ？[l]\nいつまでも同じ処理能力じゃ、つよ……成長するにしても問題が」","「可是像宏处理那样的不是很有益吗？[l]\n永远保持相同的处理能力的话，强……就算要成长也会有问题」"],["「反応速度を速めるのとは少々違うからね。[l]\nそもそも行う側の意思として行為の目的が違う。[l]\n楽に効率化を求めて構わぬ部分と、\n愉悦としてとっておきたい煩雑な部分というのがあるのさ、\n少なくとも僕にとってはね。[l]\nま、それはそれとして、だ。[l]\n先程の話に戻ると……」","「这和加快反应速度有点不同呢。[l]\n从根本上说行为主体的目的就不同。[l]\n有些部分可以追求轻松高效，\n也有些繁琐的部分是想要保留作为愉悦的，\n至少对我来说是这样。[l]\n嘛，那个暂且不论。[l]\n回到刚才的话题……」"],["「え、どの話でしたっけ、\nああ、思い出しました」","「诶、是哪个话题来着，\n啊、想起来了」"],["「当然の事だが抗原の方にはその自覚は無いしね。[l]\nだからどんでん返しが起こったとしても、\nいずれの側にとっての、かをリアルタイムに認識するのは、\n当事者同士にとっても困難かも知れないね。[l]\n或いは至極単純なのかも知れない」","「当然抗原方是没有这种自觉的。[l]\n所以就算发生剧情反转，\n要实时认清这究竟对哪一方有利，\n可能对当事人双方都很困难吧。[l]\n或者说可能极其单纯」"],["……思い出したとは言ったけど、[l]\n思ったより先生の話、飛んでた。[l]\n正直に言って、\n僕がちゃんとコトバ的に理解出来てるかは微妙だ。[l]\nでも、先生との会話っていうのはかなりの割合でこうなるし、\n何よりも、言語だけ、上辺だけのカイシャクは望まれてない。[l]\nだから、僕もいつものようにする。","……虽然说了想起来了，[l]\n但老师的话比想象中更跳跃。[l]\n老实说，\n我是否在语言层面真正理解很微妙。[l]\n不过和老师的对话大半都是这样，\n最重要的是，并不期待仅停留在语言和表面的解释。[l]\n所以我也像往常一样。"],["「アナフィラキシー……のような場合もあるだろう。[l]\nいずれ親切心というのは大変にデリケートな事柄……かな。[l]\n単純な『ゲーム』なら、\nネタバレ無しの行き当たりばったりでも、\nつまり初見であるが故の愉しみを重視しても良かろうが、\nスタンドアローンなら兎も角も昨今の──\nどっちがマナーとして正しいか、は果てない議論となるだろうな。[l]\n或いはこれこそ単純な話でもあるんだがね」","「像过敏性休克……这种情况也是有的吧。[l]\n终究善意是非常微妙的事情……呢。[l]\n单纯的『游戏』的话，\n就算没有剧透随性而为，\n也就是重视初见时的乐趣也无妨，\n单机版暂且不论近年来的──\n哪种才是正确礼仪，会变成无止境的争论吧。[l]\n或者说这本身也是很单纯的事呢」"],["「好きか嫌いか、ですよね。[l]\nまして娯楽に於いて価値観の過剰な同系統化は誰も得しないと」","「是喜欢还是讨厌的问题对吧。[l]\n更何况娱乐中价值观过度同质化对谁都没好处」"],["「先刻も言ったかな、\n情報伝達の広域化かつ高速化がね、\n個人的には好みでは無かったんだが。[l]\n結局は席巻してしまったようだなあ。[l]\n場の特質が失われて久しい。[l]\n単なる均一化に貢献しているに過ぎない機構は、\n常々如何なものかと思うがね。[l]\n誰もが同じ方向を向くこの状況は大変に危険だなあ。[l]\n急所、弱点を自分で造るようなもの──ヒトでいうなら\n中枢、脳──だな。[l]\nうがった視方をするならば、\nその脳、要するに意思決定機構の位置にならんと欲するナニモノかの意思も、\n少なからず在るのかも知れないがね。[l]\n自分がゼンタイを掌握、操作している、と思い込める","「刚才也说过吧，\n信息传播的广域化和高速化啊，\n我个人是不太喜欢的。[l]\n结果还是席卷而来了呢。[l]\n早已失去场所特质很久了。[l]\n只是助长均质化的机构，\n我时常觉得不太妥当呢。[l]\n所有人都朝向同一方向的状况非常危险啊。[l]\n就像是自己制造要害和弱点──对人类来说\n就是中枢、大脑──呢。[l]\n用刁钻的角度来看，\n或许也存在某种存在渴望占据那个大脑、也就是决策机构位置的意志，\n虽然可能为数不少呢。[l]\n误以为自己能掌控、操作"],["位","整个"],["置というのはあるだろう。[l]\n錯覚に過ぎない事が多かろうけれど、そういう欲求というのは在るものだからな。[l]\nその位置に居座らんとする者に、\nみあうだけの器があれば有益な場合もあるのだろうけれど──\nそれにね、\n一般に高次と視なされる生物は凡そ自力独力での再生能力に乏しいが、\n構造の複雑化は勿論、機能を分担し専門化したからだろう。[l]\n与えられた事しかしない、出来ないというのは、\nグンタイ内では重宝すべき特性だが、」","体系的情况是有的吧。[l]\n虽然多半只是错觉，但这类欲望确实是存在的。[l]\n对于想要占据那个位置的存在，\n如果具备相称的器量或许也有益处──\n而且啊，\n通常被视为高等的生物大多缺乏自力再生的能力，\n这应该是因为结构复杂化和功能分工专业化吧。[l]\n只会做、只能做被赋予的事情，\n在军队内部是值得珍视的特性，」"],["……確かに先生は本調子じゃないみたいだ。[l]\n饒舌なのはいつものことだけど、\n話題の振り幅というか、転換の仕方が、\nいつもよりもとりとめがなさすぎる気がする。[l]\nもしかして、\n","……确实老师好像不在状态。[l]\n虽然话多是一贯的，\n但话题的跨度或者说转换方式，\n感觉比平时更加散漫。[l]\n说不定，\n"],["機嫌が良いのか。","心情不错嘛。"],["「ま、ヒトの手の介入で多少は融通も利くようになったようだが、\n生物に限らず構造は単純である方がタフな事も多いんだがね。[l]\nとは言え結局は『生きて居さえいればいい』のか、\nそうではないのか、\nその価値観次第ではあるけどね。[l]\n極論すれば、\n生まれてない状態が最強なのかという話にもなる、\n将棋は一手も指してない状態が最強の布陣とも聞くし──\nそもそもこの星の生命の多様性は、\n","「嘛，通过人类干预多少变得灵活了些，\n不过不仅是生物，结构简单的东西往往更耐用啊。[l]\n但说到底只要『还活着就行』呢，\n还是说并非如此，\n这取决于价值观啦。[l]\n极端来说，\n甚至会讨论未出生的状态是否最强，\n听说将棋一子未落时的阵型也是最强的——\n本来这颗星球的生命多样性，\n"],["偏に『どれかが生き残れば良い』という\n至上命題があったからと想像するのは容易だろう。[l]\n一党独裁体勢は閉じたセカイでは有効な事もあるかも知れないが、」","纯粹是因为『只要有任何一种能存活就好』\n这种至上命题才形成的吧，很容易想象吧。[l]\n一党专政体制在封闭世界里或许有时会有效，」"],["「──ん、どうやら来たようです。[l]\nごめんなさい、\n先生、また後で。ありがとうございました」","「——嗯，好像来了。[l]\n抱歉，\n老师，待会儿再聊。谢谢您」"],["「おや、もうそんな時間か。[l]\n悪かったね。[l]\n無聊の慰めになったことを祈るよ。[l]\nではまた。お疲れ様」","「哎呀，都这个点了。[l]\n不好意思啊。[l]\n希望这能慰藉你的无聊。[l]\n那回见。辛苦了」"],["「……なにこれ。真っ暗じゃん。[l]\n時間早すぎた？[l]\n何よもう、もっとゆっくり来れば良かったーあ。","「……什么啊。乌漆嘛黑的。[l]\n来得太早了？[l]\n真是的，慢慢来就好了嘛——啊。"],["──おあ！びっくりしたぁ、何よ、人居るんじゃない、[l]\n黙ってないでよね気付いてたンならさあ。[l]\nなんで電気つけないのよ？」","——哇啊！吓死人了，搞什么嘛，原来有人啊，[l]\n别不出声啊既然发现了就吱个声啦。[l]\n干嘛不开灯？」"],["「──ええと、\n僕の家じゃないので勝手に設備をいじるのは気が引けたから……[l]\nそれに……まあ、[l]\n僕が来たときはまだ明るかったので気にしてませんでした」","「——那个，\n因为不是我家所以不好意思随便动设备……[l]\n而且……呃，[l]\n我来的时候天还亮着就没在意」"],["「ふーん？[l]\nったってあんた今これカーテン閉めてるし意味無いじゃん。[l]\n暗いわよ。[l]\n眼悪くなるわよ」","「哼——？[l]\n可你现在拉着窗帘不也没意义嘛。[l]\n好暗啊。[l]\n眼睛会坏掉的哦」"],["「えーと、ご覧の通り眼鏡……」","「呃，如您所见我戴眼镜……」"],["「あー？[l]\nいちいち素直じゃないつーか、\nまあいいけど。[l]\nそれよかあんた、\n今誰かと話してなかった？[l]\n他のメンツもう来てんの？」","「哈啊？[l]\n每句话都不老实该怎么说，\n算了无所谓。[l]\n比起这个你啊，\n刚才是不是在和谁说话？[l]\n其他人都已经到了？」"],["「いえ？[l]\n僕ひとりですが。[l]\nああ、携帯電話で話してたんです」","「没有？[l]\n就我一个人。[l]\n啊，是在用手机通话」"],["「あそう。[l]\nあんまこういう時に、\n関係ないニンゲンと話さない方がいいかもね。[l]\nわっかんでしょそんくらいは」","「这样啊。[l]\n这种时候最好别和\n无关的人类交谈啦。[l]\n这点道理总该懂吧」"],["「はあ、それはまあ……[l]\nところでお姉さんが、タ●●ト●●さん、ですよね？」","「哈啊，那个倒是……[l]\n话说姐姐是塔●●特●●小姐对吧？」"],["「そうだよ」","「没错哦」"],["「僕が誰かは聞かずにそんな──話してもいいんですか？[l]\nいや、僕は断じて怪しい者じゃないですけど、\n何の疑問もなく僕を『そう』だと思ってるみたいだから」","「不问我是谁就那样——可以吗？[l]\n虽然我绝对不是可疑人物，\n但你好像毫无疑虑就认定我是『那样』呢」"],["「だってこの場所指定されてそこに来たらあんたが\n居たんじゃん。[l]\nそこらの喫茶店じゃないんだから居た人間は『そう』なんじゃん？[l]\nそう考えるのがフツーでしょ？[l]\nあ、でも名前くらいは聞いとくか。[l]\n男子のメンツは２人よね確か。[l]\nだからぁ、\nあー待て待て、当てるわよ私。[l]\nえーと、\nカ、カ●●●コなんとか？じゃない？[l]\nね」","「因为被指定了这个地点过来就看到你\n在这里嘛。[l]\n又不是随便哪家咖啡店，出现在这里的人不就是『那个』吗？[l]\n这么想才正常吧？[l]\n啊，不过还是该问问名字。[l]\n男生代表记得是两个人来着。[l]\n所以说啊，\n啊等等等等，我能猜中的啦。[l]\n呃——\n卡、卡●●●什么的对吧？[l]\n呐」"],["別に感得したとか、そういうのじゃないんだ。[l]\nふぅん。","倒不是靠什么特殊能力感应到的。[l]\n哼嗯。"],["「えー、\n大変申し上げにくいんですけど\n僕はフ●フ●●●のほうです。[l]\nご期待に添えず済みませんが」","「那个——\n虽然很难启齿\n我是弗●弗●●●那边的。[l]\n很抱歉辜负了您的期待」"],["「……あっ…そう。[l]\nなによあやまんないでよそれ、\n嫌味のつもり？[l]\n私のことバカだと思ってる？」","「……啊…这样。[l]\n干嘛要道歉啦那种事，\n是在讽刺我吗？[l]\n觉得我是笨蛋？」"],["「いえ、そんなつもり全然ないですよ、\n初対面の相手に喧嘩売る程の近接戦闘系に視えますか？[l]\nか弱い子供ですよ、視ての通り。[l]\nあっちの方もサポ専寄りですし」","「不，完全没有这个意思，\n您看我像会跟初次见面的人找茬的近战系吗？[l]\n如您所见只是个柔弱的孩子。[l]\n那边那位也更偏向辅助专精」"],["「……ま、[l]\n視る限り聴く限り？[l]\nあんたもそこらの只の頭でっかちなガキとは違うっぽだし？[l]\nそもそも契約者だもんね？[l]\n宜しく、良く視りゃ可愛いじゃん。眼鏡男子」","「……嘛，[l]\n从所见所闻来看？[l]\n你也不像那些只会死读书的小鬼吧？[l]\n毕竟是契约者嘛？[l]\n多好啊，仔细看还挺可爱的嘛。眼镜男」"],["「……",""],["揶わないでください。[l]\n兎に角、こちらこそ宜しくお願いします。[l]\nただその、契約者っていうのはちょっと……[l]\n語義に違和感を感じますけど……」","请别捉弄我了。[l]\n总之，这边才要请您多关照。[l]\n只是那个，契约者这个说法有点……[l]\n语义上让人不太舒服……」"],["「何よ。知らないの？[l]\nじゃあ他にいっくらでも元ネタあるから好きなの選ぶ？」","「怎么啦。不知道吗？[l]\n那还有其他很多梗可以选哦要挑喜欢的吗？」"],["「元ネタっていうか……[l]\nいえ、そういうのはあのひとの決める事だし……[l]\nそれよりあれのほうは？[l]\n確か結構レアな──」","「与其说是梗……[l]\n不，这种事应该由那个人来决定……[l]\n比起这个那边那个是？[l]\n记得是相当稀有的——」"],["「私？[l]\n私のはすっごいわよ。ヒトガタよヒトガタ。[l]\nやっぱ折角キャラメイキングとかカスタマイズ出来るなら美青年よね？[l]\nマッチョはキモいからヤだけど。[l]\nオンゲじゃコス装備につぎこむのが主義だから私。[l]\n課金装備整えるのに私がどんだけ気張ってっか知ってる？[l]\nコス写真集とかさぁ、\n身体はってんのこれでも。[l]\n『","「我？[l]\n我的可是超厉害哦。人形哦人形。[l]\n果然难得能角色定制的话还是要美青年吧？[l]\n肌肉男太恶心了不要。[l]\n网游里我的主义是把钱砸在时装上。[l]\n知道我为了凑齐氪金装备有多拼命吗？[l]\n角色写真集之类的啊，\n这副身体可是实打实的。[l]\n『"],["Br",""],["own",""],["Bl",""],["ack』みたいな大手とかじゃないから小遣い程度だけどね、\n……同人知ってる？」","ack』那种大公司的话零花钱级别就够了，\n……知道同人吗？」"],["「え、は、同人……？」","「诶、啊、同人……？」"],["「あーいいよ別に。[l]\n知ってたら逆にコワイ。[l]\nオコサマはおっきくなるまで知らない方が良いわ。[l]\nん、それとも私が今の内に仕込んどこうか……[l]\n後で私のブログでも視なさいよ。[l]\nアド教えたげる。[l]\nんふふ、あんたにはちーっと刺激が強いかもだけど♪」","「啊——算了无所谓。[l]\n知道的话反而可怕。[l]\n小朋友还是长大前不知道比较好。[l]\n嗯，要不我现在就给你启蒙一下……[l]\n等会去看看我的博客啦。[l]\n地址会告诉你的。[l]\n呵呵呵，对你来说可能有点刺激哦♪」"],["「はあ、何だかよく分かりませんが、\n楽しみにしてます」","「哈啊，虽然不太明白，\n我会期待的」"],["……先生とは違う意味で、[l]\nとりとめがないというか、\n同級生の女子にはあんまりいないタイプだ。[l]\n同人がどうとか言うには確かに、\n僕も含めてまだ早い年代らしいし、\nその予備軍は結構居るけれど。","……和老师不同意义上的[l]\n该说是漫无边际吧，\n在同班女生中算是相当罕见的类型。[l]\n要谈论同人什么的确实，\n包括我在内都还太年轻，\n不过预备军倒是挺多的。"],["僕も『普通』と比べれば『そっち』寄りだとは思うけど、\nどっぷりの連中と話が合うと思ったことはない。[l]\n興味の対象の一部がそちらにあるだけ、\n特に『そっち』側は『普通』にとって、\n興味が無いどころか●●の対象になりがちだから、\n少しでも針が振れてる僕を視ると、\n丸々『そっち』側だと思い込むんだろうけど、\nモノゴトは縦割りで綺麗に収まるものじゃないし、\nカテゴライズは酒の肴には丁度良いけどそれだけだ、\nと僕は教わってる。[l]\n閉じたセカイに居ると其処の王になりたがる事になる、\nたとえ崇められずともミカタを増やす方が──","虽然我觉得和『普通人』相比自己更偏向『那边』，\n但从不认为能和深度宅聊得来。[l]\n只是兴趣范围有一部分涉及那边，\n尤其对『普通人』来说『那边』，\n不仅毫无兴趣甚至容易成为●●对象，\n所以看到稍微偏宅的我，\n就会完全认定是『那边』的人吧，\n但事情本就不能简单划分，\n分类法当下酒菜刚好不过如此，\n这是别人教我的道理。[l]\n待在封闭世界里就会想成为那里的王，\n就算不被崇拜也要增加同伴──"],["「──なんだっけな……」","「──刚才想说啥来着……」"],["「……？[l]\nま、あれよね。[l]\nわっかんないわよね正直。[l]\n最近のガキってみんなそんなの？[l]\n自分でもテレビの視過ぎかと思ってたけど、\nいるのねほんとに。[l]\nで、あんたのは？サポ専って？」","「……？[l]\n嘛，就是那个啦。[l]\n说实话完全听不懂呢。[l]\n最近的小鬼都这样吗？[l]\n我还以为是自己电视看太多了，\n原来真存在这种人啊。[l]\n那你呢？是那种供养专业户？」"],["「え、はあ、\nでも確かそっちのも、\nレアではあるけどサポなんじゃ？[l]\n確かそのはずですよ」","「诶、啊、\n不过我记得那边的\n虽然是稀有属性但其实是辅助型吧？[l]\n我记得应该是这样」"],["「え、そうなの？[l]\n剣みたいな武器デフォで装備してたよ。[l]\nなんか●●●しい形してたけど」","「咦、真的吗？[l]\n明明默认装备着剑之类的武器。[l]\n虽然形状有点●●●」"],["「……あの、[l]\nちゃんとマニュアル読みましたか？[l]\nチュートリアルだってあったでしょう」","「……那个，[l]\n你有好好看说明书吗？[l]\n明明也有新手教程的」"],["「私読まないわよそんなの。[l]\n時間の無駄じゃん。[l]\nやりながら覚える系なの私。[l]\nそれにこれって、\n本能でどうのこうのとかじゃんね？[l]\n理屈がどーたらの前にさァ素質でしょ自分らの？[l]\nったらいいじゃん」","「我才不看那种东西。[l]\n太浪费时间了。[l]\n我是实战学习派的。[l]\n而且这个啊，\n不就是靠本能之类的吗？[l]\n在讲道理之前看的是天赋吧我们？[l]\n不就行啦」"],["「それこそ時間はこれから有り余る程出来るのに……」","「明明今后有的是时间……」"],["「いいのよ私はいっつもキャラ買いする系だし\n","「没关系啦我向来是看角色买的\n"],["先","不"],["刻も言ったでしょ、\nみため重視系なんだから私」","刻也说过的，\n我是外观至上派嘛」"],["要素が先で構造は二の次系……ってやつかな。","要素优先结构其次……大概这种感觉。"],["っていうか前後の脈絡が全然ないし。[l]\n先生で慣れすぎて、こういうのも普通に受け入れてしまうのも、\n問題ある気がする。","不如说前后文完全没关联。[l]\n因为老师的关系太习惯了，连这种都能坦然接受，\n感觉也有问题。"],["「あんたオタっぽくはあるけど私とかと違う系よね。[l]\n今はまだかあイィけどさぁ、\n変な育ち方しないでよね。[l]\nああ、それこそそれだ、\nそのままの歳でいればいいじゃん」","「你虽然有点宅但和我不是同类型呢。[l]\n现在还好说，\n可别长歪了啊。[l]\n啊对，就是这个，\n保持现在这个年纪不就好了」"],["「いえ、その、\n僕はどちらかというと早く大人になりたいくらいで──」","「不、那个，\n我反而想快点长大成人──」"],["素質がどうこうという話で言えば、\nこの人も此処に呼ばれてきた以上、\nリンク出来る……以外にも理由があるのだろう。","要说天赋什么的话，\n这个人会被叫来这里，\n除了能建立链接……应该还有其他理由。"],["同じ思考経路の人間で固まっても、\n集団としては疲弊し腐るばかり\nその場に留まるのにさえ全力で走らねばならない、\nあのひとの……何と言ってたかな、[l]\nそれも先生がいつも話す事だから、\nてことは、もう一人の男子……[l]\nそっちは体育会系らしいけど、\n説明が微妙だったから違うのかも知れない……[l]\nも、そういうことなのかな。","即便聚集同种思考路径的人，\n群体也只会不断衰竭腐朽\n甚至需要拼尽全力才能停留在原地，\n那个人说的……叫什么来着，[l]\n毕竟这也是老师常挂嘴边的事，\n也就是说另一个男生……[l]\n虽然听说那边是体育系类型，\n但解释得含糊不清可能并非如此……[l]\n或、或许就是这么回事吧。"],["そもそも防衛機構というのは、\n失敗や最悪の事態が『起きる』事を前提として想定するものだ。[l]\n『完全に防ぐ』事を前提としてしまってはあまり意味がない、\nというかそんなシステム構築出来るわけがない。","说到底防御机制这种东西，\n本就是基于『会发生』失败或最坏事态的前提而设立的。[l]\n若以『完全防范』为前提就毫无意义，\n不如说根本不可能构建这种系统。"],["先生は僕に教えた。","老师教导过我。"],["モノゴトを考察するに、\n　","在思考事物时，\n　"],["殊、禁則や規則というものに関してのそれは、\n　何故駄目なのか、\n　ではなく、\n　許可していたらどうなるか、\n　を考えた方が、そうでないよりは少しだけ良い。[l]\n　禁止や抑圧に異を唱える者は多いが、\n　要するにそれは建前を建前として捉えられぬという事。","特别是关于禁令与规则这类东西，\n　不该纠结于为何不可，\n　而应该思考\n　若允许会怎样，\n　这样总比死钻牛角尖稍强些。[l]\n　质疑禁令与压迫者虽众，\n　说白了不过是无法将场面话当作场面话罢了。"],["建前は、コトバに囚われた我等ニンゲンにとっては、\n　避けては通れない障害たり得る。[l]\n　建前は建前と知れ。[l]\n　『お約束』のようなものだ。[l]\n　言質を取って真面目に考察してはならぬ時があると心得よ。[l]\n　有視界者とは","对我们这些被语言束缚的人类而言，\n　场面话可能成为无法回避的障碍。[l]\n　须知场面话终归是场面话。[l]\n　就像『固定套路』一样。[l]\n　要明白有些时候不可揪住话柄认真分析。[l]\n　所谓有视界者"],["弁えている者の事でもある。","亦是明事理之人。"],["確固たる自我や思考経路を持ちつつも、\n　同時にフレキシブルであること。[l]\n　その為に有用な在り方、\n　それは対話の中で要らぬ自己主張はしないこと。[l]\n　","既要保有坚定的自我与思考路径，\n　又需同时保持灵活性。[l]\n　为此最有益的姿态，\n　便是在对话中避免无谓的自我主张。[l]\n　"],["自","自"],["己","自身"],["完","若已"],["結ならばよいが、\n　同意を求めたり意見を伺うのは負たる行為。[l]\n　『相談』は構わないが、\n　『確認の為の答の用意された愚問』はいただけない。[l]\n　自己の変移を恐るるならば、そもそも他人に語ってはならぬ。[l]\n　カイシャクの押し付けは軋轢を生む。[l]\n　観想。[l]\n　敢えて知らしめる必要なし。[l]\n　取捨選択はこちらがすること、\n　相手の思考は滋養として、ミになるものは自ずと吸収され、\n　受け入れられないものは当然排出される。[l]\n　その経緯を逐一『滋養』そのものに対して説明することはない。[l]\n　議論を戦わす事は、\n　『愉悦』の為、\n　或いは『コミュニケーションの一環』として必要である場合以外は、\n　──無為だ。[l]\n　相手が『同類』なら尚のこと、\n　『魔眼質者』は個を貫きつつ、共鳴はすれども干渉には傾倒せず、\n　お互い様ではあるけれど、相手を丸ごと飲み込んで、\n　揺るぐ事なき自我に順応性と対応性を纏いてあれと。","臻至完整倒无妨，\n　但求取认同或征求意见实乃累赘之举。[l]\n　『商讨』尚可接受，\n　『为确认而准备标准答案的蠢问题』则敬谢不敏。[l]\n　若畏惧自我蜕变，起初就不该向他人倾吐。[l]\n　强加辩解只会滋生龃龉。[l]\n　静观。[l]\n　无需刻意告知。[l]\n　取舍选择由我方定夺，\n　对方的思想作为养分，有益之物自会被吸收，\n　无法接纳之物当然会被排出。[l]\n　不必向『养分』本身逐一解释这个过程。[l]\n　展开辩论\n　若非为了\n　『愉悦』或作为『交流环节』的必要部分，\n　──便是徒劳。[l]\n　若对方是『同类』则更甚，\n　『魔眼质者』既要坚守自我，虽会共鸣却不沉溺于干涉，\n　虽说是彼此彼此，但将对方全盘吞下后，\n　要让那不可撼动的自我披上适应性与应变力。"],["いずれ自己と異なるモノは仮想敵、疑似外敵として利用するにあたり、\n　有用だ。","终有一日当需将异己之物当作假想敌与伪外敌利用时，\n　这般特质极为有用。"],["変化し続ける、走り続けるもの、\n　反作用の檻枷からの脱却、\n　ただただ、スキかキライか──\n　しかして視るものでもある、我々。[l]\n　その道程の友たるＣＡＴ。","持续变化、永不停歇之物，\n　挣脱反作用的桎梏，\n　仅仅取决于喜欢或讨厌──\n　然而我们亦是凝视者。[l]\n　在这旅途中的同伴CAT。"],["いずれ色んな","迟早要获得各种"],["方を得るにはこういうのもアリだろう。","手段的话，这种方式也未尝不可吧。"],["僕等は決して他者に無関心な訳じゃない、\n価値の有無に対して揺るぎなき物差しを持ってるだけだ。[l]\nおよそ世間のそれとは合いようがない、ただそれだけ。[l]\n先生の言うように、……少し違うかも知れないけど、[l]\n説明する義理もないし。[l]\n何かに選ばれたなんて、それこそ世俗的な感想は持ってない。[l]\nものごとの選択基準に、『迎合』というものがないだけだ。[l]\n少ないけど、是と思ったモノが世間と合うことだってある、\n世間世俗と違うべくあろうとしてそれを非とする事はない。[l]\nただ、そういう是が殊の外に少ないだけだ。","我们绝非对他人漠不关心，\n只是对价值有无持有不可动摇的衡量标准。[l]\n与世间普遍标准大抵格格不入，仅此而已。[l]\n虽然和老师说的……可能有些出入，[l]\n但也没义务解释。[l]\n被什么选中之类的世俗感想根本不存在。[l]\n只不过在选择标准里没有『迎合』这个概念。[l]\n虽少，但也会有与世俗相合的心仪之物，\n不必刻意标新立异来否定世俗。[l]\n只是这种心仪之物格外稀少罢了。"],["勿論、多様な価値観、思考回路と出逢う必要はある。[l]\n滋養が無ければ自家発電のみでの成長には限界がある。[l]\nそれでも、根腐れしないバランスの視極めは必要だ。[l]\nそもそも他者との接触は、\n未熟な僕にとってはまだなかなか……難しい。[l]\n冷静に学ぶにはまだ経験が足りない。[l]\nそれこそレベル上げには苦難が伴うんだろうけど。","当然，必须接触多样的价值观与思维方式。[l]\n若缺乏养分，仅靠自我发电的成长终有极限。[l]\n即便如此，仍需把握避免根基腐烂的平衡点。[l]\n说到底与他人接触，\n对不成熟的我来说还是相当……困难。[l]\n要冷静学习还欠缺经验。[l]\n虽说升级路上必然伴随苦难。"],["そしてただ１箇所を","还有仅凭"],["論って全人格を否定するのも乱暴、\n要不要や打算思い入れ等々の各要因によって清濁併せ呑むも必要、\nか……[l]\n本当のところを言えば、\nこのセカイのものごとも、\n出来ればすっぱりと割り切れて欲しいんだけど。[l]\nそうでないと理屈で分かってはいるけれど、\n教わりもしたけれど、\n本心では思ってる、\n０か１かで振り分けられたらどんなに楽で美しいだろう。","单点争论就否定整个人格也太粗暴，\n需根据必要性、算计、情感等因素兼容并蓄，\n吧……[l]\n说实话，\n这个世界的事物，\n真希望能干脆利落地一刀两断。[l]\n虽然理智上明白做不到，\n也被教导过，\n但心底还是觉得，\n要是能用0或1来划分该多轻松美妙。"],["そういう思考もまだ僕が子供だからかな……","这种想法可能也说明我还是孩子吧……"],["「……早く大人になりたいんです」","「……真想快点变成大人」"],["「んあ？[l]\n何で強調すんの。[l]\nエロい話？」","「嗯啊？[l]\n干嘛突然强调。[l]\n色色的话题？」"],["「……えろくはないですよ」","「……才不是色色的事」"],["要するに、あなたのような人でも、\n僕にとって成長する糧にはなるってことです。","总之就算是您这样的人，\n也能成为我成长的养分。"],["……ああ、こうやってムキになるから、[l]\nまだコドモだってのに。","……啊，会这样较真，[l]\n果然还是小鬼呢。"],["「こんにちわー、どなたかいらっしゃいますー？[l]\nお邪魔しますよー」","「有人吗——？[l]\n打扰啦——」"],["「え、\nあ、びっくりしたぁ。[l]\n暗いからわかんないんだってばだから。[l]\nもう外も暗いじゃん、電気点けようって。[l]\nスイッチどこかわっかんないんだけどっ。[l]\nあ？[l]\nあー、\nえーと、？」","「咦，\n啊、吓死人了。[l]\n都说了太暗了看不清嘛。[l]\n外面都黑了，该开灯啦。[l]\n找不到开关在哪啦——[l]\n哈？[l]\n啊——，\n呃——？」"],["「こんにちわ初めまして、ア●●ア●●と言うんですー。[l]\nよろしくですー」","「你好初次见面，我叫阿●●阿●●——。[l]\n请多关照——」"],["「あ、どうも、こんにちは」","「啊你好」"],["「あー、あんたがそうなんだ。[l]\nよろしく。[l]\n視たところ私より……」","「啊、原来就是你啊。[l]\n请多指教。[l]\n看起来比我……」"],["「下に視えます？下に視えます？[l]\nえへへー。[l]\nちと嬉しいかもです。[l]\nえーと、\n今日って帰りにみんなでご飯とかになるですかね？」","「觉得我小？觉得我小？[l]\n嘿嘿——。[l]\n有点开心呢。[l]\n那个——，\n今天大家放学后要一起吃饭吗？」"],["「へ？なんで？」","「诶？为啥？」"],["「へ？[l]\nうーん、そのテンションでずっぱりそう言われましても……[l]\nえーとその、あれ？[l]\nと言いますか初対面の相手にしてそのリアクション、\n理解に苦しみますが～。[l]\n怒ってるんですか？[l]\n何ででしょう？[l]\n私何かしてしまいましたでしょか？」","「诶？[l]\n唔～用这种高涨的情绪突然这么说……[l]\n那个、咦？[l]\n或者说初次见面就这种反应，\n实在让人难以理解呢～[l]\n你在生气吗？[l]\n为什么呢？[l]\n我做了什么不该做的事吗？」"],["「え、いや、僕に振られましても」","「啊、不、你问我我也……」"],["……こっちのひとはこっちのひとで、[l]\nまた難儀な感じだなあ。","……这边这位也是老样子，[l]\n感觉又是个难搞的主儿啊。"],["「発言の意図がわっかんなかっただけだし。[l]\n怒ってないし。[l]\nてかあんたのそのキャラも初対面に対してする系じゃなくない？[l]\nなーんかさぁ……、──」","「只是没get到你说话的意图。[l]\n没在生气。[l]\n话说你这人设对初次见面的人来说也太超规格了吧？[l]\n总觉得啊……──」"],["「（……女の空気読まなさってにゃーほんとに武器だな）」","「（……这妹子不会读空气的程度简直堪称武器了）」"],["「（……脅かさないでくださいよ。[l]\nお兄さんがカ●●●コ●●さん？[l]\nいつのまに来たんですか。[l]\nなんでそんなコソコソしてるんです）」","「（……别吓人啊。[l]\n老哥是卡●●●可●●？[l]\n什么时候来的啊。[l]\n干嘛这么鬼鬼祟祟的）」"],["「（ん、まーな。[l]\n此処入る前からあの二人の気配は感じたからさ、\n気後れしたっつーか、\n苦手なんだよ、同年代の女って。[l]\n……まあ、それこそ実年齢なんかわかんにぇけど）」","「（嗯，这个嘛～[l]\n进这儿之前就感觉到那俩人的气息了，\n该说是怂了还是，\n实在不擅长应付同龄女生啊。[l]\n……虽然实际年龄什么的根本看不出来就是了）」"],["上下ともジャージっていう着こなしの割に、\nやっぱり単純な体育会系という訳ではないみたいだ。[l]\n寧ろ……[l]\nもしかすると勉強も運動も出来る優等生タイプかも。[l]\nでも、学校指定ジャージだったとしたら、\nもしもの時に身元が簡単に割られるだろうけど。[l]\nそれとも『敢えて』かな。[l]\nミスリードの為のフェイク？","虽然上下都穿着运动服，\n但看来并不是单纯的体育系类型。[l]\n倒不如说……[l]\n说不定是学习运动全能的优等生类型。[l]\n不过如果是校服的话，\n万一出事很容易被查到身份吧。[l]\n还是说『故意为之』呢。[l]\n为了误导而做的伪装？"],["「（あ？[l]\nああ、これな。[l]\n普段着だけど。[l]\n学校のじゃにぇよ。普通に市販されてるやつな。[l]\n公私のケジメとか、お袋がその辺","「（啊？[l]\n哦这个啊。[l]\n只是便服啦。[l]\n不是学校的。普通市售款。[l]\n公私分明什么的，我家老妈"],["煩くてさ。[l]\nその割にぁ普通の服あんま買ってくんなくてな、\nちっさい頃から。[l]\n俺も別に楽だしいいけど、\nいちいち着替えはしっかりさせられてる……[l]\nってことで納得してくれるか）」","在这方面特别啰嗦。[l]\n但反而很少给我买普通衣服，\n从小就这样。[l]\n我倒觉得方便无所谓，\n不过每次换装都会被严格监督……[l]\n这样解释你能接受吗）」"],["……僕は何も言ってないけど。[l]\nそんな分かりやすい眼で視てたのかな？[l]\nまあ、\n僕はこういうヒトはキライじゃない。[l]\nクラスの連中と話すよりは愉しそう。","……我明明什么都没说。[l]\n原来我的眼神这么容易读懂吗？[l]\n不过，\n我倒不讨厌这种人。[l]\n比和班上那群人聊天有意思多了。"],["「（……へぇ……[l]\nああ、僕はフ●フ●●●で、みたままのコドモです。[l]\nあの二人は、）」","「（……嘿……[l]\n啊，我是弗●弗●●●，如你所见是个小鬼。[l]\n那两位是，）」"],["「（ああ、知ってるよ。[l]\nア●●とはまぁ、一応知らにぇ間柄じゃないんだ実は。[l]\nあ、でも向こうはこっちをあんま知らにぇだろけどな。[l]\n俺はお袋から色々聞いてんだよ。[l]\nま、今言ったけど女子は苦手だし、\nこれでも人見知り激しいんだ俺。[l]\nじゃからこっちから言い出すつもりは今んトコにぇー。[l]\nそれよりあのト●●って奴、\n大丈夫か？[l]\n自尊心つーかその）」","「（啊，知道啦。[l]\n和亚●●嘛，其实也不算完全不认识的关系。[l]\n啊不过那边应该不太认得我就是了。[l]\n我从老妈那儿听过不少。[l]\n不过刚才也说了不擅长应付女生，\n而且我其实超级怕生的。[l]\n所以目前没打算主动搭话。[l]\n倒是那个托●●，\n没问题吗？[l]\n自尊心什么的）」"],["「（ええ、若干、帝王学を学んだ系のヒトと言いますか、\nまさにその自尊心、プライドが高い人のようで。[l]\n自分で会話や場を仕切れないと不満なタイプみたいですね。[l]\nあっちの人にはそのつもりは無いんでしょうが、\n……ト●●さんみたいな人種は、[l]\nあれ系同士で","「（嗯，算是稍微学过帝王学的那类人吧，\n正是那种自尊心、优越感特别强的类型。[l]\n好像对无法掌控对话和场面就会不满的那种人呢。[l]\n虽然对那边的人应该没这种想法——\n……但像托●●先生这类人种，[l]\n同类型的家伙们"],["一",""],["所に集まるとろくな事がないんです。[l]\n無駄な不快感を覚えさせられて）」","聚在一起准没好事。[l]\n只会让人平白感到不快）」"],["単に世間話として振った話題に過敏に反応して怒るし。[l]\n発言者は意図してないから、謝るにしても何をどう謝ったらいいか、\n分からない。[l]\nつまり対応に困る。行き詰まる。[l]\n人によっては逆に怒り返す事もある。[l]\n無視したらしたで、それが火に油を注ぐ事だってあるだろう。[l]\n先にキレた方は一方的にコミュニケーションを断絶して、\nますます事態は意味不明だ。[l]\n俗に地雷を踏むというやつ？[l]\nよくわからない。違うかも知れない。[l]\nとにもかくにも不愉快だ。[l]\nコトバが全てじゃないけれど、\nそういう事態が起きても何とか『話せば分かる』ように、\n複雑に言語系を発達させてきたのが僕等ヒトじゃないのか？","就连普通闲聊的话题都会过度敏感地生气。[l]\n发言者本无恶意，就算想道歉也不知道该为哪部分、如何道歉，\n完全搞不懂。[l]\n总之很难应对。陷入僵局。[l]\n有些人甚至会反过来发火。[l]\n要是选择无视，反而可能火上浇油。[l]\n先爆发的那方会单方面切断交流，\n事态越发莫名其妙。[l]\n俗称踩地雷的情况？[l]\n不太确定。或许也不一样。[l]\n总之令人不愉快。[l]\n虽然语言不是万能的，\n但人类不正是为了在发生冲突时能『通过沟通解决』，\n才进化出这么复杂的语言系统吗？」"],["「（……はーん。[l]\nそんな奴もいるんだな。[l]\n聞いてたのとはちょっと違うくにぇーか？[l]\nそんな俗っぽいやつは、）」","「（……哈啊[l]\n原来还有这种家伙啊。[l]\n和听说的情况有点出入吧？[l]\n这么俗气的家伙，）」"],["「ト●●さんは『リンクしたて』ですよね？[l]\nＡＡもしてないでしょうし、\nこう視えても私の方がお姉さんですねー。[l]\nとは言ってもですね、そんなに差はないでしょうけどー」","「托●●先生是『刚链接』对吧？[l]\n连AA都没做，\n别看这样我其实更年长哦～[l]\n不过话说回来，年龄差也没那么大就是了～」"],["「じゃあ別にお姉さんぶるのも意味なしってことじゃんね。[l]\nあたしらにそんなねんこ、ねん、ねんこうじょれつ？[l]\nそう年功序列よ。[l]\nそんなの無意味でしょ。[l]\n","「那摆年长架子就没意义了吧。[l]\n我们之间又没什么年、年、年功序列？[l]\n对就是年功序列。[l]\n这种东西毫无意义啦。[l]\n"],["拘るなら実年齢言いなさいってば」","要在意就直接说实际年龄啊」"],["「えー、私末っ子だったんですよー、\n妹に憧れがあるんですよー」","「诶～我可是家里老幺～\n一直很向往有妹妹呢～」"],["「は？[l]\n知らないって。[l]\n質問にも答えてないじゃん。[l]\nいきなり零距離コミュニケーションてかいきなりあんたの性癖語られても」","「哈？[l]\n谁问你这个了。[l]\n根本答非所问啊。[l]\n突然零距离沟通什么的突然听你讲性癖很困扰」"],["「えー、えー、\n仲良くするに越したことはないですよねー？[l]\n仲間じゃないですかー」","「诶～诶～\n搞好关系总没错吧～？[l]\n我们不是同伴吗～」"],["「いあ、そのさ、だから」","「不是，所以说」"],["「（あんだけ言われたら普通察して引くもんじゃにぇーのか？[l]\n俺なら耐えられん。[l]\nそれともどうしても主導権握りてぇのか両方ともが？）」","「（被说到这份上正常人该识趣退开了吧？[l]\n换我绝对忍不了。[l]\n还是说两边都非要争主导权不可？）」"],["「（まあ、さっき自分で言ってたじゃないですか、\n空気読まないっていうか、\n女のひとって相手の話を聞いてるかどうか、\n分かんなく視える程食い違った中身同士でも、\n会話というかコミュニケーションは成立してますからね。[l]\n相手のコトバは聞いてない可能性はありますね。[l]\n自分の言いたい事は主張しますが、\n大抵相手の声は『音』としてしか認識してないんじゃないですか）」","「（哎呀，刚才自己不也说了嘛，\n不是不会读空气，\n女性这种生物啊，就算双方内容南辕北辙到\n明显不在一个频道，\n也能维持着名为对话的沟通呢。[l]\n很可能根本没在听对方说话。[l]\n虽然会坚持表达自己想说的，\n但多半只把对方声音当作『噪音』来认知吧）」"],["女性というのは、\nよく精神面において男性を──時に肉体も──凌駕している、\nと表現される事があるけど、\nそれは単に他者というモノを自己領域に入れない……つまり、[l]\n話を聞かないし相手に感情移入をするといった想像力が無いからじゃないか、\nと思いたくなる、\nこういうのを視ると。","常有人说女性\n在精神层面——有时连肉体也是——远胜男性，\n但这种现象或许只是\n因为她们根本不让他人进入自我领域……也就是说，[l]\n既不听人说话，也缺乏对他人共情的想象力，\n看到这种场面时\n不禁会这么想。"],["自己投影は大得意の癖に。","明明最擅长自我投射。"],["まあ、感情移入とか、そんな余裕は生存に必要ないからだろうし、\n無駄に過剰な想像力はそれこそ身を滅ぼす。[l]\n男性が弱いと目されるのも結局、\n無駄なる事に心血注ぐオコサマが多いからだろう。","嘛，感情代入之类的，那种余裕对生存来说本就不必要吧，\n过度浪费的想象力反而会招致毁灭。[l]\n男性被视为弱势群体说到底，\n还不是因为把心血浪费在无用之事的大少爷太多了。"],["……こんな事口にしたら、[l]\n先生に、\nそれは両方が両方に存在するよ、縦割りの思考は愉快でないなあ、\nとか怒られる、きっと。","……要是把这种话说出口，[l]\n肯定会被老师、\n「这两种特质双方都具备啦，割裂的思维方式真让人不快」、\n这样训斥的吧。"],["どっちにしても、\n男女のどっちが好いとか悪いとかじゃないが、\n互いに解り合うには、隔たりが在りすぎると思う。[l]\nオトナは一体どうやって円滑なコミュニケーションを\n取ってるんだろうか。","无论如何，\n倒不是说男女孰优孰劣，\n但彼此间想要相互理解，隔阂实在太多了。[l]\n大人们究竟是如何做到\n顺畅交流的呢。"],["まあ、それはあとで先生とでも論議しよう。","算了，这个还是留待之后和老师讨论吧。"],["「（取り敢えず殴り合いに発展しなければ放っておいても、\nあれが女子同士の会話ってものかも知れないですよ。[l]\nコドモだから分かりませんけど）」","「（只要不演变成互殴就放着不管吧、\n说不定那就是女生之间的交流方式呢。[l]\n毕竟是小孩子所以搞不懂啦）」"],["「（……物理的に脳構造からして違うって言うからなあ、[l]\n俺には理解できにぇ……[l]\n男でもあんなの居ない訳じゃないけど……[l]\n……しゃあーにぇーなあ、[l]\n助けに入んなきゃか……）」","「（……据说生理上脑部构造就不同啊，[l]\n俺实在理解不了……[l]\n虽然男性里也不是没那种人……[l]\n……真特么够呛，[l]\n不上去帮忙不行吗……）」"],["ヒトが良いのかそんな事を呟くのが聞こえた。[l]\n言っちゃ悪いけど、どうにも珍しい人種と思う。","似乎听见某个老好人正嘀咕着这种事。[l]\n说句不好听的，总觉得是相当稀有的品种。"],["「（僕も人のことは言えませんが、\n他人を否定する事で自己を保とうとする人は、\n話もろくに聞いてくれないと思いますが……ああ、[l]\nそもそもそんな直接的なヘルプじゃないってことですか？）」","「（虽然我也没资格说别人，\n但通过否定他人来维持自我的人，\n根本不会好好听人说话吧……啊、[l]\n莫非本来就不是那么直接的帮助方式？）」"],["大体、あのト●●ってひと自身も、\n初対面の僕に零距離……というか露骨にミクダしてきた気がするけど。[l]\n仕切りたがりは、その態度の高低はどうあれ先手を打とうとするから、\nだからやっぱりあのひとに先越されたと思ったのかな。[l]\n場の主導権を握ろうとする争いって、\nコドモの僕等のセカイでも結構起きる事だし。[l]\nほんとうに面倒なんだ、あれは。[l]\n視ていて分かり易すぎて、気分が悪くなる。[l]\n閉じたセカイでそんなことをしたところで──\n","说到底，那个叫ト●●的家伙自己，\n初次见面就和我零距离……或者说明显想和我ミクダ的感觉。[l]\n爱掌控局面的人无论态度高低都会抢先出手，\n所以果然还是觉得被那家伙抢先了吧。[l]\n这种争夺主导权的斗争，\n在我们小孩子的世界里也经常发生呢。[l]\n真是麻烦死了，那种事。[l]\n看着都觉得太明显了，让人反胃。[l]\n在封闭的世界里做这种事──\n"],["……あ、","……啊、"],["「こんー」","「喂——」"],["……コ●キ●コに、","……往●鸡●里，"],["……コ●カ●コ。","……往●鸡●外。"],["「──あ、こ、こんちわ」","「——啊、你、你好」"],["「どうも──」","「请多指教——」"],["カ●●●さんが仲裁しようと動くまさにその際、\n新しく二人、此処に入ってきた人影があった。","就在鸡●●●先生正要上前调解的瞬间，\n又有两个新的人影踏入了此处。"],["僕は先生から聞いて特に詳しく知ってる、\nその二人は、いや、片方だけだったか、\n","我从老师那里听说过详细情报，\n那两人，不、应该说是其中一人，\n"],["あの人から下賜されたＮＥＷＳとは別に、\n先生達が開発に携わったというＡＷＥ、\nあのスロタラスモルトを基本に設計された、\n『","除了那个人赐予的NEWS之外，\n正是老师们参与开发的AWE、\n以那个斯洛塔拉斯莫尔特为基础设计的、\n『"],["人殺","杀人"],["油烟","油烟"],["地獄』とかいうのを持つ、\n且つ唯一の遣い手だったっけか。[l]\n僕も実際会うのは初めてだ、先生の──\n","地狱』的、\n且唯一的使用者来着。[l]\n我也是第一次见到真人，老师的——\n"],["「こんちゃ。[l]\nあ？[l]\nそこの男子、いつの間に居たのよ。[l]\n挨拶しないでシカトってなに？[l]\n男同士で固まっちゃってさぁ、そっちなの？」","「嗨。[l]\n啊？[l]\n那边的男生什么时候在这儿的。[l]\n不打招呼装没看见算怎么回事？[l]\n你们男的扎堆搞小团体是吧？」"],["「あ？！」","「啊？！」"],["「こんにちわーよろしくですー」","「你好呀请多关照啦」"],["「あーぇあ、あ、ああ、\nどうも……」","「啊—呃啊、啊、啊啊、\n你好……」"],["「………、[l]\nえー、あっ、そうだ、\nあんたがそんであれね？[l]\nカ●●●？[l]\nそうよね？[l]\nで、あんた達。[l]\nコ●、\nってことはつまりシマイよね？[l]\nあんた達二人」","「………、[l]\n呃—、啊、对了、\n你就是那个啥对吧？[l]\n卡●●●？[l]\n对吧？[l]\n然后、你们俩。[l]\n是●、\n那意思就是死●对吧？[l]\n你们两个人」"],["「んふぇ？[l]\nあー、\nそうだよ。[l]\n視ての通り、」","「唔诶？[l]\n啊—、\n没错哦。[l]\n如你所见、」"],["「……？！」",""],["「似てないけどさ。[l]\nわたしは父親似でこっちは母親似なんだわ。[l]\nだからま、こんなかんじ」","「虽然长得不像。[l]\n我像爸爸这边像妈妈啦。[l]\n所以嘛、就这样」"],["「わ、わざわざ説明することじゃない……[l]\nないでしょ？[l]\nえ、えーとあなたがタ●●さんでそっちが……」","「这、这没必要特意说明吧……[l]\n对吧？[l]\n呃、呃—那个你是塔●●小姐那边是……」"],["「ア●●ア●●ですー。[l]\nコ●さんですよね？[l]\n宜しくですー」","「阿●●阿●●啦—。[l]\n是●小姐对吧？[l]\n请多关照—」"],["「あ」","「啊」"],["──ん？[l]\n全員が揃ったのかどうか、\n確認しようとしたら、","──嗯？[l]\n是否全员到齐了、\n正想确认时、"],["「……主宰者がいらっしゃったようですね」","「……看来主持人已经到了呢」"],["「！」",""],["今その場に集まった僕等が全員向こうを視た。[l]\n二人のおんなのひとがゆっくりと姿を現したのだった。","此刻聚集在此的我们齐刷刷看向那边。[l]\n两名女性缓缓现出了身影。"],["「（うっわ、マジのばりばりの金髪碧眼じゃん）」","「（哇靠、真的纯金发碧眼诶）」"],["「……」",""],["「（いよいよホントにマンガみたいゲームみたいよね？[l]\nいるんだあんなのマジに）」","「（越来越像漫画游戏了对吧？[l]\n现实中居然真有这种人）」"],["ト●●が小声で煩く言ってる以外は、\n割とみんな落ち着いている。[l]\n既に視知っているかのようだ。[l]\n……僕の横にいたコ●●だけは、[l]\n少し眼が据わってると言うか、妙に緊張したように視えるけど、\nそういえば女子が苦手とか言ってたもんな。","除了●●在小声聒噪之外、\n大家倒都挺镇定。[l]\n仿佛早已熟知一般。[l]\n……只有我旁边的●●、[l]\n眼神有点发直或者说显得异常紧张、\n说起来他确实说过不擅长应付女生来着。"],["「揃ったようですね？[l]\n皆様御機嫌よう。[l]\n私が、」","「看来都到齐了呢？[l]\n各位日安。[l]\n我是、」"],["──あれが、","──那就是、"],["結","结"],["目みりあ、ってひとだな。","目米莉亚、那个人吧。"],["「──です。[l]\n今日はお越し頂いて本当に嬉しい──\nとても悦ばしい日です。[l]\n事情は既にお知らせしたので御存知とは思いますが──」","「──是也。[l]\n今日承蒙光临实在欣喜──\n是个令人愉悦的日子。[l]\n想必各位已获知相关事宜──」"],["……僕等にＣＡＴを与えた真の魔女。[l]\nそしてその横に居るのは──","……赐予我们CAT的真正魔女。[l]\n而她身旁的是──"],["「説明して差し上げて、\n","「就由我来说明、\n"],["刀","刀"],["祢」","祢」"],["「（やっぱコトバぺらぺらなんだ、\nっっごい、刀祢もそーだったけど……）」","「（果然说话超流利、\n超厉害、刀祢也是这样的……）」"],["「既に皆様とは顔を合わせていますので紹介は略します。[l]\nさて、あなたがたは、\n来るべき『Ｗ","「既已与各位打过照面就省略介绍了。[l]\n那么、诸位、\n为迎接即将到来的『W"],["の使徒』を殲滅する為集められた人材。[l]\nあなたたちにはその資質、チカラ、\nがあるとミトメられました。[l]\n参画の意思についても確認済みですね？[l]\nあなたがたには自由意思が与えられ、その上で此処に集うを選んだ。[l]\nですからもう、その覚悟アリとミなします。[l]\nもう降りることは許可出来ません」","为歼灭『使徒』而集结的人才。[l]\n你们具备那份资质、力量、\n被认定为拥有这些。[l]\n参与意向也已确认完毕了吧？[l]\n你们被赋予自由意志，在此基础上选择聚集于此。[l]\n因此已默认你们做好觉悟了。[l]\n不允许中途退出」"],["そう、僕等は遊戯を始めるんだ。[l]\n","没错，我们要开始游戏了。[l]\n"],["選択肢は『","选项是『"],["は","是"],["い』を選んだんだ。[l]\n他の皆にも動揺は全然無い。[l]\n……まあ、若干一名浮き足立ってるひとはいるようだけど。[l]\nにしても、揃った、って言ってたけど、\n他にも名前があったような覚えがある……[l]\nあまり知りすぎてる風を態度に出したくなかったので、\nわざとうろ覚えにしてたのが災いした。[l]\n今この場では全く思い出せない。","选择了饭'。[l]\n其他人也完全没有动摇。[l]\n……不过，似乎有一名成员略显不安。[l]\n即便如此，说是全员到齐了，\n却隐约记得还有其他名字……[l]\n因不想表现得过于了解情况，\n刻意保持模糊记忆反而弄巧成拙。[l]\n此刻完全回忆不起来。"],["その間にも刀祢はまた暫く話をしていたけど、\n余り集中出来なかった。","期间刀祢又说了些话，\n但我没能集中精神听。"],["すると刀祢が最後に言った。","接着刀祢最后说道："],["「そしてもうひとつ、宮岡早苗を、」","「还有一人，宫冈早苗，」"],["……誰だって？[l]\n事前の話には出てなかった名前のような気がするけど……[l]\nまあ、後で確認する機会はあるだろう。[l]\n先生にでも聞くという手もあるし。[l]\nさっきからの件も結局はそうするしかなさそう。[l]\n全然思い出せない。","……谁啊？[l]\n印象中事前说明里没出现过这个名字……[l]\n算了，之后总有机会确认。[l]\n也可以向老师打听。[l]\n刚才那件事最终也只能这么处理。[l]\n完全想不起来。"],["「かつて起きたあの因、\n喜ばしくも忌まわしいあのとき以来の──」","「自那起因缘起始、\n可庆可憎的那时以来──」"],["「（……先生の言っていたあのことか。[l]\n確か今から──）」","「（……老师提过的那件事吧。[l]\n大概距今──）」"],["遡ることどれほどだと言ってたっけ──","具体要追溯多少年来着──"]],"context":[["SC_E_044.ks/index/1/text"],["SC_E_044.ks/index/3/text"],["SC_E_044.ks/index/5/text"],["SC_E_044.ks/index/7/text"],["SC_E_044.ks/index/9/text"],["SC_E_044.ks/index/11/text"],["SC_E_044.ks/index/13/text","SC_E_044.ks/index/363/text"],["SC_E_044.ks/index/15/text"],["SC_E_044.ks/index/17/text"],["SC_E_044.ks/index/19/text"],["SC_E_044.ks/index/21/text"],["SC_E_044.ks/index/23/text"],["SC_E_044.ks/index/25/text"],["SC_E_044.ks/index/27/text"],["SC_E_044.ks/index/29/text"],["SC_E_044.ks/index/31/text"],["SC_E_044.ks/index/33/t