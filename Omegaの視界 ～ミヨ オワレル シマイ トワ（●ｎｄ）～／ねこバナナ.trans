,null,[null,{"v":1}],null,null,null,[null,{"t":"HU"}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,null,[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"t":"HU","v":1}],[null,{"v":1}],[null,{"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"t":"HU"}],[null,{"t":"HU","v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,null,null,[null,{"t":"HU"}],null,null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,[null,{"t":"HU"}],null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[638,0],"note":"完成"},"/data/scenario/SC_M_012.ks":{"data":[["闇の中に思考のみがあり","黑暗中仅存思考"],["恐らく脳髄といういち器官が、","或许正是被称为脑髓的这个器官、"],["特殊に活性したときに生じる反応の","在特殊活性化时产生的反应"],["その反応そのものであって","那反应本身"],["我は言語を知るので","因我知晓语言"],["言語にて構成されるのだが","故以语言构成"],["脳も","脑亦"],["眼も","眼亦"],["側も","侧亦"],["泌も","泌亦"],["口も","口亦"],["精も","精亦"],["骨も肉も","骨亦肉亦"],["依代も","依代亦"],["はねも","羽亦"],["あぽとすもねくろすも","凋亡亦坏死亦"],["分かたれ奪われて。","皆被分割夺去。"],["カミにホウじられた。","被纸封缄。"],["九つの魂。","九缕魂。"],["猫魂。","猫魂。"],["自律回路。","自律回路。"],["我は有機なり、","我为有机、"],["我は幽鬼なり、","我为幽鬼、"],["我は誘起なり。","我为诱因。"],["骸に憑きて動かすもの。","凭附骸骨使之动者。"],["Electricity。","Electricity。"],["飯食（イーハ）。","饭食（伊哈）。"],["すなわち第十相。","亦即第十相。"],["肉の檻枷の虜囚。","血肉牢笼的囚徒。"],["ぱら・みあきす・めいる。","para・Miacis・male。"],["無楽の病。","无乐之病。"],["ＮＡＩ。","ＮＡＩ。"],["ななむしる。","七虫蚀。"],["アリスの詩。","爱丽丝的诗。"],["病死手。","病死手。"],["此岸たる黒、","此岸之黑，"],["彼岸たる白。","彼岸之白。"],["甘き声が響く。","甘美声音回荡。"],["ああ懐かしい。","啊啊真怀念。"],["其処に居たの。","你曾在那里。"],["漸く逢えたな。","终于见到了呢。"],["おぎやあああ。","呜咦啊啊啊。"],["おわああああ。","呜哇啊啊啊。"],["まこくん。","小真。"],["がまんしてる？","在忍着吗？"],["んむー。","嗯唔——"],["のうがくうてんですか。","是起作用了吗。"],["さあ。","来吧。"],["しんでみますか？","要死一次看看吗？"],["てきは●●。","敌人是●●。"],["よるはみかた。","夜晚是同伴。"],["おめがのひとみ。","双瞳之眼。"],["きこえますかとらいのしきが？","能听见吗，那渡来之式？"],["ないんらいう゛ず。","恐为虚无矣."],["さんさんさん。","三三三。"],["いいくぼまこと。イーハ。","饭洼真言。伊哈。"],["「――はっ。","「――哈！"],["……宮さ？の声が？？","……宫小姐？的声音？？"],["…おわあああ？！」","…呜哇啊啊？！」"],["一瞬驚くも、身体は俊敏に反応できず。","虽瞬间惊醒，身体却未能敏捷反应。"],["眠りの中なのか覚醒したのかも曖昧なまま、\nただ宮さんの声が聞こえ続ける。","分不清是仍在梦中还是已经清醒，\n只持续听见宫小姐的声音。"],["「んむ。","「嗯唔。"],["目が覚めましたね。","醒来了呢。"],["気分どうですかまこくん？","感觉怎么样啊小真？"],["大丈夫？」","没事吧？」"],["覗き込むようにこちらを見下ろす宮さんがいた。","宫小姐正俯身窥探般望着这边。"],["ああ、目覚める直前のはやっぱり宮さんの声か。","啊，醒来前听到的果然是宫小姐的声音。"],["夢と融合してた…。","和梦境融合了…"],["って、あれ。","话说，那个。"],["今みていた、\n夢らしきものの記憶は瞬時に消え失せたようで、\n………。","刚才看到的\n疑似梦境的记忆似乎瞬间消失了，\n………。"],["全く思い出せません。","完全想不起来。"],["それよりもまず目前のリアルに対処しよう、\n思わず後頭部をまさぐり、ただの枕であることを確認する。","比起那个先应对眼前的现实吧，\n下意识摸索后脑勺，确认只是普通枕头。"],["「何してるんですかまこくん？」","「在干什么呢小真？」"],["「え？あ、\nいやなんでも。","「诶？啊，\n没什么。"],["ちょっとしたトラウマです」","有点心理阴影」"],["念のためだ。","以防万一。"],["そうそう何度も女子におちょくられては悲しすぎる。","要是总被女生戏弄也太惨了。"],["決して期待していた訳ではない。","绝不是有所期待。"],["…残念、とは思ってないから。","…才没觉得遗憾呢。"],["念のため。","以防万一。"],["そんな余裕無いです。","根本没那闲心。"],["まだ上体も起こ…せないな。","连上半身都还…起不来啊。"],["「知狡とチノは後で来ますけど。","「知狡和千乃待会儿会来。"],["宮がまこくんのお世話をしてあげてたんです。","是宫在照顾小真哦。"],["がっつり寝顔は見させて貰いました。","你的睡相我可是看光光啦。"],["…うひひ、\nあとで鏡みてみてね♪」","…嘿嘿，\n等会儿记得照镜子哟♪」"],["「あのね…","「那个啊…"],["あなたは修学旅行中の男子ですか。","你是修学旅行的男生吗。"],["ああもう、人が寝てる間に何したんですか～…」","啊啊真是的，趁人睡觉时干了什么呀～…」"],["「額に文字なんてベタいことはしてませんよーだ」","「才没做在额头写字那种老套事啦」"],["「逆に怖いんですけど…","「反而更可怕了好吗…"],["てかそれ以前にこの状況は一体どういう事、なんでしょう。","话说这到底什么情况，为什么会这样。"],["えーと、確か？本家に行ったはずですよね僕は？」","呃，我记得？应该是去了本家对吧？」"],["「んむ？","「嗯唔？"],["覚えてない？","不记得了？"],["頭打ったかな？」","撞到头了吗？」"],["額に手を当てこちらの眼を覗き込むように近づいてくる。","将手贴在额头上，像要窥探这边眼睛般靠近过来。"],["思わず視線を逸らしてしまう。","不由得移开了视线。"],["近い近い近い…","太近太近太近了…"],["近いって宮さん。","太近了宫小姐。"],["「いやいやいや、\nちょっと寝起きで混乱してるだけ、です多分。","「不不不，\n只是刚睡醒有点混乱而已，大概。"],["最近変な夢ばっかりでして…","最近老是做奇怪的梦…"],["旅疲れですかねえ……","可能是旅途劳顿吧……"],["ああええと、何があったんだったか………」","啊啊那个，发生什么事来着………」"],["そうか。","这样啊。"],["家宝のなんとかまめって仮面を視ていたらば、\n突然倒れてしまったのだった。","看着家传的什么豆面具时，\n突然就晕过去了。"],["「お昼ご飯は、残念ですが一緒は無理ぽかったので、\n先に宮だけ摂りました。","「午饭的话，遗憾没法一起吃，\n宫已经先吃过了。"],["まこくんお腹はどう？","小真肚子怎么样？"],["何か食べられそう？」","能吃得下东西吗？」"],["「ええと、ん？","「那个，嗯？"],["今何時です？」","现在几点了？」"],["「昼の二時でーす」","「下午两点哟ー」"],["「うあ！？","「呜哇！？"],["僕どんだけ寝込んでたんだ…","我到底睡了多久…"],["ああ、時間知ったら急に飢餓感が襲ってきました…」","啊，知道时间后突然觉得好饿…」"],["「うひひ、\nそんだけ食欲あるなら心配要らないようですね。","「唔嘻嘻，\n这么有食欲看来不用担心了呢。"],["安心しました。","放心了。"],["取り敢えず、おにぎり、茶漬けは用意してありますけど。","总之准备了饭团和茶泡饭。"],["パンがお好みならそれでも」","想吃面包的话也有哦」"],["「あーえーと、","「啊ー那个，"],["じゃお茶漬けで…梅でお願いします」","那就茶泡饭…要梅干的」"],["「はぁい♪","「好ー的♪"],["あ・な・た」","亲・爱・的」"],["「止めて下さいって…」","「请别这样…」"],["「うひひひひひっ。","「唔嘻嘻嘻嘻。"],["まこくん揶うの面白いにゃあ。","捉弄小真真好玩喵。"],["ん、それはさておき、今持ってきますね。","嗯，总之现在去拿过来。"],["待ってて下さい」","请稍等」"],["にゃあってまた、どこぞの女子みたいな真似を…","又喵来喵去的，学哪里的女生啊…"],["揶うっていやあ、猫は鼠だの土竜だの、\n捕まえても直ぐには殺さずいたぶるっつーもんね…","说什么捉弄，猫抓老鼠啊鼹鼠啊，\n逮到后都不会立刻弄死而是慢慢玩弄吧…"],["………。","………。"],["いたぶられてる獲物なのか僕は。","我难道是被玩弄的猎物吗。"],["ん？","嗯？"],["いたぶられてるというか嬲られてる？","与其说被玩弄不如说被调戏？"],["どっちでもいいですが。","都无所谓啦。"],["あーもう色んな人の口癖に感染しちょる。","啊ー真是被各种人的口头禅传染了。"],["己が希薄だとすぐ他人色に染まっちゃうんだなあこれが。","自我薄弱就容易被他人影响呢原来如此。"],["反省しよ…","得反省下…"],["――にしても。","――话说回来。"],["「こちとらー明日は大変だってのに、\n世は静かだなあ……」","「明明咱们明天有大事要办，\n世间倒是很平静啊……」"],["耳鳴り聞こえる程に静かだ。","静得能听见耳鸣。"],["『ねこざんまい』も山近くで静閑だったが、\n此処いら辺の静けさはその比じゃない。","虽然『猫三昧』靠近山区也很安静，\n但这一带的寂静程度根本没法比。"],["部屋の防音性も高いし…","房间隔音也很好…"],["って、あ？","等等，咦？"],["此処誰の部屋だ？","这是谁的房间？"],["僕の部屋じゃないな。僕の部屋はもちっと川の音とかが…","不是我房间。我房间应该能听到河水声…"],["「あ？","「啊？"],["此処宮さんの部屋か…おいおい……」","这里是宫小姐的房间吗…喂喂……」"],["何で僕の部屋に寝かせてくれないんだよ…","为什么不让我睡自己房间啊…"],["此処は階も上だし、運ぶだけ無駄な労力要ったろうに…","这层楼还更高，搬上来肯定费了不少劲吧…"],["大体、自分の部屋に帰る僕の足労はどうなる。","话说回来，我自己回房间的脚程怎么算。"],["…う、まさか宮さん使用中の布団とかじゃないよなこれ。","…呜，这该不会是宫小姐正在用的被褥吧。"],["旅館だしあんま関係ないか。","反正是旅馆应该没关系。"],["「うーんしかし…」","「唔ー不过…」"],["一体何があったのか。","到底发生了什么。"],["無難に考えれば、やっぱ空腹と緊張か。","稳妥考虑的话，果然还是饥饿和紧张吧。"],["或いは前日の女子まみれで疲れてたか。","或者是前天被女生们折腾累了。"],["はたまた閉塞空間で一瞬でも恐慌状態に陥ったか。","又或者是在封闭空间里一瞬间陷入了恐慌状态。"],["閉所恐怖症ではないと思ってたんだけどなあ…","虽然我自认为没有幽闭恐惧症来着…"],["向こうのアパートも本棚でぎちぎちの狭いとこで\n生活してた訳だし…","之前住的公寓也是被书架塞得满满当当的狭小空间\n生活过来的说…"],["「（まこくーん。","「（小真～"],["入るよぉー）」","要进来咯～）」"],["こつこつ、という音と共に扉の外から声がした。","伴随着咚咚的声响，门外传来声音。"],["「はぁーい」","「好～的」"],["上体を何とか起こす。","勉强支起上半身。"],["おっ……と、まだ頭に鈍痛が走るな…","呜哇……不行，脑袋还在隐隐作痛…"],["ふうぅ…","呼唔…"],["「お待たせぇ～」","「久等啦～」"],["「あ、ありがとうございますー」","「啊，谢谢您ー」"],["お盆の上に、丼一杯分のご飯にラップ掛けたものと\n魔法瓶に空の茶碗に湯飲み二つ、そして箸に茶漬けの素が載ってる。","托盘上放着盖了保鲜膜的满满一碗饭\n还有保温瓶、空茶碗、两个茶杯，以及搭配茶泡饭料的筷子。"],["卓袱台の上に置き、宮さんは寝てる僕の横に\nちょこんと座った。","将餐盘放在矮桌上后，宫小姐在我躺着的被褥边\n轻轻坐了下来。"],["「好きなくらい適当によそってください。","「按你喜欢的量随便盛吧。"],["あ、飲み物","啊，饮料"],["白","变成"],["湯になっちゃいますね」","白开水呢」"],["「あーいいですいいです、","「啊—不用了不用了，"],["調子戻ったら普通に何か買って飲みますから…」","等状态恢复了我会自己去买喝的…」"],["「一応ご飯はチンして来たので、\n時間経つと冷めますよ。","「姑且把饭热过了，\n放着会凉掉的。"],["お茶漬けだから関係ないかもですが。","不过茶泡饭的话可能无所谓吧。"],["まあ無理しないで下さい。","总之别勉强。"],["よそってあげましょうか？」","要我帮你盛吗？」"],["「…ええと、いいですかねお願いしても」","「…那个，可以麻烦您吗」"],["「はい、ちょっと待ってて下さい」","「好，稍等一下哦」"],["優しくそう言って宮さんは卓袱台へ。","宫小姐温柔地说着走向矮桌。"],["ちょっとまだ本調子じゃなくて、\n思わず甘えてしまったが…失敗したかなあ…","因为身体还没完全恢复，\n不自觉就撒娇了…是不是失策了啊…"],["静かな部屋に、こう二人きりというのは、\n…照れる。","寂静的房间里就我们两个人，\n…好难为情。"],["というより、こっちが床に伏せている状態が、\nまるで幼き日の、\n風邪をひいて寝込んでいる自分、\nそして看病してくれる母さん、","或者说像这样趴在被褥上的状态，\n简直像是小时候\n感冒卧床的自己\n和照顾我的妈妈"],["のような何とも言えないこそばゆさがもう身悶えしたい程に今、僕を襲っていますよ。","那种难以言喻的羞臊感现在正让我恨不得打个地洞钻进去。"],["今はあんな母さんでも、昔は――","虽然现在的妈妈是那样，但以前说不定――"],["まあ、過去記憶が超曖昧な僕が言っても説得力無いけど。","嘛，由记忆超级模糊的我来说也没什么说服力就是了。"],["メディアに埋め込まれた後付記憶かもしれないしな、\n温かい母親像なんて。","说不定还是被媒体植入的后设记忆\n那种温暖的母亲形象呢。"],["と、独り空想に耽ったところでこの状況は。","就在我沉浸于胡思乱想时。"],["静けさが相まって、間が持たない。","这份寂静让时间更难熬了。"],["無音であるが故に、余計な思索を妨げるものもない。","正因为无声，才更无法阻止多余的思绪。"],["おかしな事を考えてしまうわけではないが、\nつまり、照れるしかないというか。","倒也不是在想什么奇怪的事，\n总之就是难为情得要命。"],["看病という状況て、\n常日頃顔を合わせてる者同士の場合は、\n普段の関係性とは違う側面の表出に他ならず、\n否、側面というよりステージの階層の差か、\n仮面の内側が視られてしまう恥ずかしさが半端じゃない。","所谓看护这种状况，\n对于日常见面的人来说\n无非是展现出与平时不同的一面\n不，与其说是侧面不如说是舞台层级的差异\n面具之下的部分被窥见的羞耻感简直要命。"],["人ん家に泊まるのが苦手な人っているけども、\nそういう理由かもなあ。","有些人很不擅长在别人家留宿，\n说不定就是这个原因呢。"],["そして、\n静けさの中に宮さんと二人って、\nシチュエーションはあんまり変わらないはずなのに、\nバイトしてるときとはやっぱり違う。","而且\n和宫小姐独处在寂静中\n虽然情境应该没太大变化\n但和打工时果然不一样。"],["上体起きてるとは言っても、布団に入ってるのがあれなのかな…","虽说撑起了上半身，但躺在被窝里果然还是…"],["『横になる』という行為、状況自体、無防備そのものだし。","『躺卧』这个行为本身，就是毫无防备的状态。"],["「さ、できましたよぉ。","「来，准备好啦～"],["召・し・上・が・れ・♪」","请·用·餐·♪」"],["「…なんか宮さんここんとこハイぽいですよね…","「…宫小姐最近是不是有点亢奋啊…"],["木","是"],["天","闻了"],["蓼でも嗅いだんですか」","木天蓼吗」"],["なんでわかったの？」","你怎么知道的？」"],["「や、\n冗談はいいです、\nどっこいしょ、どうも、頂きます」","「哎呀，\n玩笑就免了，\n嘿咻，多谢，我开动了」"],["ようよう鈍痛も収まってきたので、\n布団から出て卓袱台に向かう。","隐隐作痛也渐渐平息，\n钻出被窝走向矮脚餐桌。"],["そこで己が身をふと確認するが、\n…さすがに勝手に着替えさせられては居なかったか。","这时突然确认自己身体，\n…看来倒没被擅自换过衣服。"],["ふーやれやれ。","呼——真是的。"],["「窓開けて良いすかね」","「能开窗吗」"],["「どぞ」","「请便」"],["上方階なのでか、風が強めに吹き込む。","或许是高层缘故，风呼呼地灌进来。"],["茶漬けみたいな、摂食にあたり必要以上に音の出る食物、\n粛々とした雰囲気の中食べられませんからな！","像茶泡饭这类进食时会发出很大声响的食物，\n在肃穆气氛里可没法吃啊！"],["「宮も","「宫也"],["湯だけお付き合いしますね」","就只陪您喝点热汤吧」"],["と言って、宮さんは湯飲みに湯を注いだ。","说着，宫小姐往茶杯里倒入热水。"],["ずずずー…","滋溜滋溜——"],["外界の音を細く聴きつ、しばらく二人の湯を啜る音が\n部屋に響いていた。","细听着外界微响，两人啜饮热汤的声音\n在房间里回荡。"],["なんだこの状況。","这什么状况。"],["思わず二人で笑い合うのであった。","不禁相视而笑。"],["食事が済むと、","用餐完毕后，"],["「さ、大事をとらないと。","「好了，得保重身体。"],["明日のこともありますし。","明天还有事呢。"],["寝て下さい寝て下さい。","快睡吧快睡吧。"],["そう、こっちのほうがかーあいいねえ、うひひ」","对对，这样才乖嘛～嘿嘿」"],["せっつかれ、思わずまた布団に入ってしまう僕。","被催促着，我不由自主又钻回被窝。"],["喰ってすぐ寝ると…じゃなく、","吃完就睡会…啊不是，"],["「あのねだから、」","「那个所以说，」"],["――額に手を当てられた。","――额头突然被按住。"],["駄目だって…","不行啦…"],["そういうのが、\nその手の冷たさが、\n恥ずかしすぎる……","这种举动，\n那只手的冰凉触感，\n太羞人了……"],["「にひひ」","「嘻嘿嘿」"],["「………」","「………」"],["「あまり心配かけないでね」","「别让人太担心呀」"],["「………はあ」","「………哈啊」"],["「じゃ片づけてきます」","「那我去收拾了」"],["すっくと立ち上がる宮さん。","宫小姐飒爽起身。"],["すると今まで全く意識してなかったのだが、\n空腹が満たされた所為か、復調してきた所為か、\n宮さんの脚。","这时才突然注意到——\n不知是吃饱的缘故，还是身体好转的关系，\n宫小姐的腿。"],["何か、突然眼に入ってきた。","莫名突兀地闯入视野。"],["えー、ちょっと無防備なのではないでしょうか。","呃、这有点太没防备了吧。"],["「あの…初日の件もあるし、","「那个…毕竟有初日那件事，"],["あまりこう言うのも何ですが、\n僕がこう寝てる体勢なのにですね、","虽然这么说不太合适，\n我现在这样躺着的情况下，"],["そうその、僕の周りをスカートでうろうろしない方が\n良いんではないですかね…」","您穿着裙子在我周围晃来晃去\n是不是有点…」"],["すると不思議そうに振り向く。","她闻言困惑地转过头。"],["「もしかして」","「难道说」"],["「はい？」","「啊？」"],["「宮で変な想像してたりして？","「在想象什么下流画面？"],["大丈夫ですよぉ。","放心啦～"],["今はちゃんとほら」","现在可是好好穿着哦你看」"],["「…っ！うや！！なにを…","「…！呜哇！！干什么…"],["……あのそれ、ちゃんととかそういう問題？」","……这算哪门子的好好穿！？」"],["捲るな捲るな。","别掀别掀。"],["宮さんがスカートたくし上げると、\n下にはえーとこれ、ブルマですか。を、穿いておられた。","宫小姐掀起裙摆后，\n下面穿着呃、这是运动短裤吧。"],["あの写メで穿いてたやつだな…","就是那张照片里穿的…"],["初日はさんざ人をスケベ呼ばわりしたろうに。","明明初日时还骂别人色狼来着。"],["もっと所作は貞淑に貞淑に。","举止要更端庄更端庄些。"],["「女子のエロは何基準なのかさっぱりわからんですよ…」","「完全搞不懂女生的色气标准是什么啊…」"],["「ま、今のは気付け代わりです。","「嘛，刚才就当是提神费吧。"],["今日はきっと旅疲れが出たんでしょうね。","今天肯定是旅途劳累发作了吧。"],["そろそろ真面目に調子戻してもらわないと、\n明日がありますから。","再不赶紧认真恢复状态的话，\n明天还有正事呢。"],["眼の保養にもなったでしょお？","眼睛也享受到福利了吧？"],["サービスサービス」","特别服务特别服务」"],["まあその一瞬どきっとはしましたが…","虽然那一瞬间确实心跳加速了…"],["結局アナタは僕を寝かしたいのか起こしたいのか。","说到底你是想让我睡还是想让我醒啊。"],["「…向こうさんにも同じこと言いましたけどね、\n宮さんのセクハラで僕は女性不信気味になってるんですから…","「…虽然对那位也是这么说的，\n宫小姐的性骚扰害我都快对女性产生信任危机了…"],["もう少し妥当な距離で僕と接してくださいませんか」","能不能请您用更妥当的距离和我相处」"],["「んむー？","「嗯唔～？"],["これでも距離置いてますよ。","这已经是在保持距离了哦。"],["もっと近づいて欲しいのかな？」","难道是希望我更靠近些？」"],["「毎度宮さんとの会話は止めどきが難しいですね、","「每次和宫小姐对话都很难把握结束时机呢，"],["あはは。","啊哈哈。"],["はいもう結構です部屋に帰ります僕」","好了够了我要回房间了」"],["布団から出て、身支度を整える。","从被窝里爬出来整理衣着。"],["実際もうそろそろ帰った方が良いだろう。","实际上也确实该回去了。"],["それこそ食事した所為か復調もして来ていたし。","托吃饭的福体力也恢复了不少。"],["というかそれ故に今度は本意気で眠くなりつつあった。","或者说正因为如此现在反而开始真心犯困了。"],["此処でマジ寝したらほんとに洒落にならない。","要是在这里真睡着可就真不好笑了。"],["色んな意味で。","各种意义上都是。"],["「あぁん、ちょっと待ってくださいよお。","「啊——请稍等一下嘛。"],["これ片付けてくるまでで良いですからぁ」","等我收拾完这些就好啦」"],["「はいはい、ってああ、\n御陰様でもう大分調子戻りましたから、\n僕片付けますよ自分で」","「好好好，话说啊，\n托您的福已经恢复得差不多了，\n我自己来收拾就行」"],["「もーっ、そんなに怒んないで下さい。","「真是的，别这么生气嘛。"],["じゃあ今晩は宮は用事あるので、\nまた、夕飯一緒に食べられません。","那今晚宫还有事情要办，\n又不能一起吃晚饭了。"],["残念ですが別々です。","虽然遗憾但只能分开吃。"],["明日はまこくん、いよいよ三春のとこに潜入ですし、\nまたしばらく一緒になれないかもです」","明天小真就要正式潜入三春那边了，\n可能又有段时间见不到了」"],["「怒ってませんよ別に。","「没在生气啦。"],["で、はいそうですね」","嗯，是这样呢」"],["「なのでまこくん。","「所以小真。"],["今日は宮がおまじないをしてあげます。","今天宫要给你施个魔法。"],["…ちょっとこっち来て目瞑って」","…过来这边闭上眼睛」"],["基本警戒したまま僕は、","保持着基本警戒的我，"],["仕方ないので宮さんに近づき眼を閉じた。","无奈地靠近宫小姐闭上了眼睛。"],["何するのよ…","到底要干嘛啊…"],["向かい合い、","在相向而立、"],["いつの間にか窓が閉められて音がしないこの部屋で、","窗户不知何时已关上的静谧房间里，"],["すると宮さんの手が僕の首にかけられ、","宫小姐的手突然环上我的脖颈，"],["首に、","在颈间、"],["ひやりと。","凉丝丝地。"],["擽るような。","痒酥酥地。"],["冷たい指が絡まった。","缠绕上冰冷的手指。"],["「………？」","「………？」"],["「うひひ。","「呜嘿嘿。"],["期待しちゃいましたか？","是不是期待了什么？"],["残念でした。","很遗憾。"],["超健全なプレゼント、\nお守りです。","是超级健全的礼物、\n护身符哦。"],["もう眼開けても良いですよ」","可以睁开眼睛了」"],["首に何かが巻かれている。","脖子上被戴上了什么东西。"],["が、首なので視えない。","但因为是脖子所以看不见。"],["眼を開けようが閉じてようが関係ないじゃん。","睁眼闭眼根本没区别吧。"],["「あ、鏡は自分のお部屋でね」","「啊，镜子请回自己房间看」"],["はいはい。","好啦好啦。"],["そういや先刻、何やら顔を確認しろと…","说起来刚才还说要确认脸部什么的…"],["「じゃまこくん、\n明日は頑張って。","「那小真、\n明天要加油哦。"],["そのチョーカー、外しちゃ駄目ですよ」","那个项圈绝对不能摘下来」"],["チョーカーなのなこれは。","原来是项圈啊这东西。"],["と、手をひらひら振って僕を部屋から出す。","说着便挥手把我赶出了房间。"],["やっぱりいつもの様に、\n自分からはあっさりと打ち切る宮さんであった。","果然还是和往常一样，\n宫小姐干脆利落地自己切断了话题。"],["良いけど別に。","无所谓啦。"],["閉じた扉。","紧闭的门扉。"],["部屋の前に暫し立ち止まり、","在房门前稍作停留，"],["「…愛してます」","「…我爱你」"],["呟いた。","轻声说道。"],["今回は何も無しか。","这次什么都没发生吗。"],["ってかリアクションないとこれじゃ単なる一方的な告白じゃないかよ。","话说没反应的话这不就成单方面告白了吗！"],["違う違う。","不对不对。"],["そんなんじゃないって。","不是这样的。"],["恥ずかしいなあもう！","太羞耻了啊真是的！"],["帰るます！","我回去啦！"],["言語も変！！","连说话都语无伦次！！"],["茶漬けの食器とかを洗い場に返却したりと\n後片付けも終わり、","把茶泡饭的餐具归还到洗碗池\n收拾完毕后，"],["晩飯は今日も件のラーメン屋かな…","晚饭今天也去那家拉面店吧…"],["と思いつつ部屋に戻った。","这么想着回到房间。"],["早速洗面所の鏡を視ると、首に巻いてあったのは――","立刻看向洗手间的镜子，发现脖子上戴着――"],["鈴の絵が描いてあるチョーカーだった。","画着铃铛图案的项圈。"],["いつも宮さんが着けてるのと同じ。","和宫小姐平时戴的同款。"],["そういや先刻は宮さん着けてなかったな。","说起来刚才宫小姐没戴着呢。"],["…まさか現物付与じゃないだろうな。","…该不会是把实物直接给我了吧。"],["と視線を顔の方に移していくとだ、","当视线移到脸上时，"],["「………うあ。","「………呜哇。"],["…………うああ」","…………呜哇哇」"],["おいおい先刻これで人前うろうろしてたのか僕は…","喂喂我刚才就顶着这个在人群里晃悠吗…"],["額に文字ならぬ――","额头上不是文字而是――"],["唇を押し付けた跡が。","被嘴唇狠狠亲过的痕迹。"],["「あの人ぁ…","「那个人啊…"],["ほんっと意味不明だわ……」","真是完全搞不懂呢……」"],["この晩この後はもうあまりよく覚えてない。","这晚之后的事记不太清了。"],["知狡さんは来てくれたがチノ嬢は用事だとかで来ず、\nその流れで知狡さんと飯を喰い、明日の為の準備をし、\n風呂に入って速攻寝たのだった。","知狡阿姨来了但千乃小姐说有事先走，\n顺势和知狡阿姨吃了饭，为明天做准备，\n洗完澡倒头就睡。"],["と、朝になっていた。","转眼已是清晨。"],["時間が跳んだようだった。","时间仿佛跳过了般。"]],"context":[["SC_M_012.ks/index/1