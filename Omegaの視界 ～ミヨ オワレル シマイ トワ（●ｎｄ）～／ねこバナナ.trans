"start":39096,"end":39157}],[{"start":39165,"end":39184}],[{"start":39248,"end":39254}],[{"start":39286,"end":39296}],[{"start":39314,"end":39343}],[{"start":39351,"end":39361}],[{"start":39371,"end":39372}],[{"start":39381,"end":39391}],[{"start":39399,"end":39423}],[{"start":39587,"end":39602}],[{"start":39610,"end":39634}],[{"start":39666,"end":39682}],[{"start":39700,"end":39763}],[{"start":39771,"end":39795}],[{"start":39827,"end":39867}],[{"start":39891,"end":39934}],[{"start":39944,"end":39945}],[{"start":39955,"end":39974}],[{"start":39985,"end":39987}],[{"start":39998,"end":40041}],[{"start":40049,"end":40075}],[{"start":40107,"end":40130}],[{"start":40161,"end":40168}],[{"start":40199,"end":40205}],[{"start":40229,"end":40284}],[{"start":40347,"end":40353}],[{"start":40371,"end":40418}],[{"start":40450,"end":40467}],[{"start":40517,"end":40554}],[{"start":40575,"end":40583}],[{"start":40591,"end":40609}],[{"start":40641,"end":40662}],[{"start":40686,"end":40697}],[{"start":40711,"end":40741}],[{"start":40760,"end":40810}],[{"start":40818,"end":40887}],[{"start":40919,"end":40937}],[{"start":40955,"end":41023}],[{"start":41031,"end":41097}],[{"start":41129,"end":41165}],[{"start":41189,"end":41201}],[{"start":41211,"end":41255}],[{"start":41263,"end":41303}],[{"start":41311,"end":41366}],[{"start":41398,"end":41424}],[{"start":41435,"end":41453}],[{"start":41496,"end":41523}],[{"start":41531,"end":41570}],[{"start":41634,"end":41646}],[{"start":41709,"end":41730}],[{"start":41792,"end":41814}],[{"start":41877,"end":41886}],[{"start":41928,"end":41941}],[{"start":42012,"end":42089}],[{"start":42152,"end":42168}],[{"start":42230,"end":42251}],[{"start":42289,"end":42306}],[{"start":42330,"end":42344}],[{"start":42352,"end":42443}],[{"start":42451,"end":42488}],[{"start":42498,"end":42504}],[{"start":42510,"end":42521}],[{"start":42543,"end":42551}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_026.ks","basename":"SC_M_026.ks","indexIds":{"クリーニングを頼んだ経験なんか殆どないから、\n知狡さんが無理してくれたのか、\nそもそもそう言うものなのか判断は出来ないが、":0,"狩屋達に逢いに出掛ける前に、\n借り物の制服は返せる状態になっていた。":1,"知狡さんはお返しものとか持たせようとしてくれたけど、\n……まあ、それは何か違うと思ったので\n適当に誤魔化して準備をする。":2,"しかし知狡さん、顔色はあまり良くないようだったなあ。[l]\nやっぱり無理したのかなあ……[l]\nこないだからずっと調子悪そうだし、\nなんとか都合つけてゆっくり休んで貰いたいものだ。":3,"「さて、一応作業しやすい服にしとくか……[l]\n荷物かさばらしてまで持ってきた甲斐もあるというもの」":4,"元より仰々しい仕事させられると思ってたから、\nそれなりの準備をして来たのに、\n女装だのなんだのをすることはあっても\n大体、祭の日程は予定通りに行われたとしても月末な訳で――":5,"「……いかん、冷静に現状を認識しすぎると絶望してしまう」":6,"多少は柳に風と受け流すと言うか、\n知らぬが仏の境地と言うか、\nうーん今一現状を的確に表現出来る言い回しが浮かばないが、\n鷹揚な度量で臨まないと遣り切れない。":7,"どんだけ煩悶しようとも、\n今となっては乗りかかった船、賽は投げれらた、覆水盆に返らず、\n毒を食らわば皿まで、":8,"えー、\n…まあ、なんだ。[l]\n要するに後に引くには遅すぎるという事だ。":9,"バックは一族全体だし、\n今更復学も……ないなあ……[l]\n宮さんの言を信じて今後の人生にも期待しましょう。":10,"夕べ狩屋から来たメールによると、\n９：００集合で昼までの作業、\n昼食は姫様ちゃん家にて向こう持ちで喰わしてくれる、\nという事だった。":11,"旅行は好きだけど、\n知人の家で食事するのは慣れてないから何かこう、\n緊張する……というか、":12,"望む望まぬは別として本当はそんな":13,"長":14,"閑な状況じゃ\nないのだよな。[l]\n後ろめたさだけが":15,"募る。[l]\n後ろめたいと言えば。":16,"「朝飯朝飯……[l]\nうーん、コンビニじゃないおにぎりなんて久々だなー」":17,"こんな急なスケジュールにも関わらず、\n知狡さんは前もって知ってたかのように\n制服の準備のみならず、更にこの朝食まで\n（無論、人に頼んでではあるが）用意してくれていたのだった。":18,"世の母親であればそういう物かも知れないが、\n知狡さんは未だ独身だし、\nうちの母さんは何とも適当だったから、\n余計に先読みされた感が強く思えるのかも。":19,"そういう気遣いが知狡さんの負担になってるような気がして、\nこっちもプレッシャー、後ろめたさに":20,"苛まれるなんだけど……":21,"その点母さんは、\n放任じゃなかったにせよ地味に豪快と言うべきか、\n少なくとも知狡さんとは全く微塵も似ていない。":22,"まあ御陰で、深刻な性格というよりは\n幸か不幸か、そういうのに反発して真逆の性格になったりは\nしなかったんだよなあ。":23,"吉と出るか凶と出るか\n流石に後ろめたい感すら持たないような人間にはならないようにしたいものであることよ。":24,"車は旅館のハイヤーは勿論、\n軽自動車も荷物の運搬には不向きだったので、\n狩屋の家からバンを借りる事になっている。":25,"日に数回のバスを利用して近場のバス停に移動、奴の家の近くにて待ち合わせだ。":26,"中央の方じゃバスは道路状況の所為か何か知らないけど、\n滅多矢鱈とダイヤが不安定だったものだが、\nこっちはどうなんだろ。[l]\n逆に地域の重要な足として、規則正しく運行してるんだろか。":27,"「……ああ、失礼眠いので」":28,"皿を戻したりする為、\n部屋に戻らずロビーの長椅子でおにぎりに":29,"囓りついてると、\n目の前を目の下の隈を一層濃くしたチノ嬢が通りかかった。[l]\n彼女は目を合わせた途端に挨拶もせずそう言った。":30,"「宮店長は夜行性でしてねどちらかというと。[l]\ntensionが高まるのが夜、というべきですか。[l]\n世に言われてますでしょう、よるはみかた、敵は何とやら。":31,"ん？[l]\n無いか。[l]\nまあどちらでもいいんですがね、":32,"今日はワタシも少々脳がidlingを必要、\nと言いますか、\n対応が奇矯になるかも知れませんで、\nどうかお含み置き下されば幸いですが」":33,"奇矯……[l]\nそれはいつもの事の様な気がしますが……":34,"「禅が店長の言い付けた録画番組を盤に焼いて送ってくるのですが、\nまめに消化しないといけませんでね。[l]\n宮店長は可能な限り多忙なる合間を縫ってそれを為す訳ですが、\nやはり限界というものがあるので。":35,"溜まった分をいちどきに消化せねばならない場合があるのです。[l]\n丁度昨夜はワタシもご":36,"相":37,"伴に預かりまして」":38,"お茶を飲んで、":39,"漸く会話可能になった僕は、":40,"「はあ……[l]\n僕は多少旅行慣れしてるんで、\n地方による番組視聴の可不可とかはもう……[l]\nだだ流しで本ばっかり読んでますし」":41,"と返答した。[l]\nもう会話の入りが怪訝しかった事自体は、\nいつもの事とスルーする。":42,"「宮店長は珍しく今日は寝坊です。[l]\n平時なら多少の夜更かしも平気なのですがね。[l]\nどうにも色々と……お疲れのようで……":43,"ごほっ……ゴホッ。[l]\n失礼。[l]\n貴方への挨拶を代弁せよとのお申し付けを昨夜の内に」":44,"「はあ、\nいやその僭越ながら申し上げますればですね、\nそれは社交辞令というか言葉の綾か何かだったんじゃ……」":45,"大体にしてその、\n貴女自身も大変にお疲れのように見受けられますが……":46,"「いえ、ご心配なさらず。":47,"書き置きをお渡しするでも良かったのでしょうが、\n昨夜、正確には本日早朝ですが、\nその時の宮店長の心持ちとしては\nその手段を是とはなさらなかったようでしてね」":48,"「うーん……[l]\nそれはご愁傷様で……[l]\nあのひともなんだかなあ」":49,"「言語野を刺激するに、\n脳内のみで――例えば読書や耳からのみの言語情報だけよりは\n実際に発声して会話するのがより良き方法ではある、\n話し手にも聴き手にも、という事ですがね。":50,"音は魔法という与太話は既にお聞きになってますね？[l]\nああ、申し訳ない、\nやはりどうも睡眠不足のようで、":51,"話題が取り留めのない方向に暴走していますこれはどうも\n宜しくないななにかいいものを":52,"喰したいところ\n或いは木天蓼木天蓼などを持ちまして」":53,"「や、いつも通りだと思います……[l]\nあいえ、\nと、兎に角お気になさらず、ご無理もなさらずで……":54,"まあメールよりは電話とかで直に会話する方が多少は\n伝わりが良いですしね！[l]\n僕はアナクロ趣味ですし解りますけど、\nまああれですね、宮さん本人が寝てるんでは……」":55,"あのひとに振り回されるのはこの":56,"女":57,"性も一緒だったか。":58,"「手段の選択肢がある現在に於いてはケースバイケースが\n良いでしょうけどね。[l]\n特に貴方位の年代の異性同士ではデリケェトな問題と\nなる事":59,"屡":60,"屡と聞き及びますが」":61,"「うーん……[l]\n年代も、時代もですかなあ。":62,"個人差あるでしょうし――って、\nすみませんそんな話より、\nお疲れでしたらほんとに休んだほうが」":63,"しかしそこでチノ嬢はゆらぁりと体勢を立て直して、\n眼を":64,"瞬かせて続けた。":65,"「では店長の挨拶を代わって述べさせて頂きます。":66,"『まこくん、今日もごめんねっ。[l]\n宮はもう少しすることあるから、\n一人ででも頑張ってくださいっ！":67,"愛してるなら出来るね？[l]\n何をって、言わなくても判ってる癖に☆\nうひひ♪\nじゃ、よろしくです～。いてら～。』":68,"以上です」":69,"………。":70,"「――あの……[l]\n声帯模写がその、":71,"吃":72,"驚するほど\n御上手ですね……」":73,"マスクしてるし、\n音声レコーダーか何か再生したんじゃないかという疑念も\nあったが、\nいやいや、この人が発声してたよ…まじで……":74,"「ま、まあ兎に角僕はやることやってきますので、\n宮さん起きたら――あとチノさんの都合良ければ、\n宜しくお伝えください。[l]\n……まあ、チノさんもちゃんと休んだ方がいいですよ」":75,"「解っています、\n『僕も愛してる』と伝えておきましょう。[l]\n真心を店長に。貴方のね」":76,"「……何の話ですか。[l]\nそれじゃあついでに花束をお願いしますよ。[l]\nでは改めまして、\n今日もお勤め行って参りますっ」":77,"「察するまでもなく通じて頂けるのは":78,"好き素質です。[l]\n時間取らせて申し訳ありませんでした。[l]\n夢見も宜しいようで何より。":79,"ん？悪かったのかな？[l]\n申し訳ないがどちらでもいいんですがね。":80,"では、宮店長の祝福あれ。[l]\nGood Luck。[l]\nミ・キャミャルキャラモロコネコナメタサキャラ\nタサコネタサメミャラメンカヤコネキャ・ワ」":81,"あいあい。[l]\nみゃんみゃんなんたら。":82,"改めて部屋に戻り、準備をして外に出る。":83,"道路は":84,"其":85,"処":86,"彼":87,"処、木の枝やら葉っぱだのが散乱し、\n嵐の爪痕が未だ残る痛々しい状況であった。":88,"天気の方は正に台風一過、只でさえ綺麗な田舎の大気を、\n必要以上に洗い流したらしく今日はおっそろしく見通しの良い\n晴天である。[l]\n昨夕の日暮れも良いが、こういう抜ける青空も勿論心に染み入るね。":89,"夕べのあれやこれやで湯冷め湯中りするかと思ったが、\n滋養に特化した夕飯が結果功を奏したのか、\nはたまた日頃の行いが良いのか、\n今日は至って元気な僕であった。":90,"大神との身のない話でも、多少は足しになったものか。[l]\n――今朝の知狡さんやチノ嬢を視てると、\nしっかりせねばという思いにもなるしなあ。":91,"問題は相変わらず進行形というか、\n不明の事項に関しては不明としておくしか無い以上、\n自分以外が絡む事象に関してはやれることにも限界がある訳だが、\nともあれ全力を尽くすのみか。":92,"とは言え、現状目的と手段がどうもこう、\n流されるままというか、\nそれでも何故か収穫があるというか、\nゲームをしてる感というか、":93,"大神あたりが何か":94,"一":95,"家":96,"言ありそうな感じの、\nフラグの為のフラグがどうとか……":97,"穴のある不出来な脚本……[l]\nシナリオ……[l]\nしろのしろ……":98,"「おあ！」":99,"水たまり踏んだ！":100,"靴ごと足が水没することをこの辺では確か\nかっぽぐった、と言うらしいが誰から情報だったかな……[l]\nきぃだったかしらん。":101,"取り敢えず、水たまりは思った程深くなく、\nそこまでの惨劇には至らずに済んだ。[l]\nただ少々泥っ気の強い箇所だった故激しく滑り、\n大変に驚いた次第。":102,"まあそれよりも、":103,"「姫様ちゃんに……狩屋なあ……」":104,"調査対象を効果的に調査するならば、\n確かに敵対状態にあるよりは親密度上げた方が\nはるかに効率的ではある。[l]\nあるのだが、":105,"最終的に信頼を裏切ることが前提というか、\nたとえ隠し":106,"果せたとしても、\n罪悪感に苛まれることになるのだろう。":107,"今回の一連のそもそも、\n三春の御神体の確認、\n『月狂跳』なのかどうか――":108,"『家の秘密』はそうそう":109,"容":110,"易く":111,"詳らかには出来ない。[l]\n懐柔するという案は理に適っているが、":112,"先日から憶えている背徳感は拭えない。":113,"感情移入は公平な立場を崩し、\n正確な判断を鈍らせるぞ。":114,"ん？[l]\n誰かから聞いた言葉だったかな。":115,"――大体、飯窪本家の趣味好奇心を満たす為と言う割には、\nあまりに迂遠で大仰な事になってるのは何故だ。":116,"殆どノリに近い形であるにも関わらず、\n僕という一個人の人生にとっては大きな岐路を\n客観的且つ相対的に視てくだらない事を真剣に愉しむのはまるで\nゲェムだ。":117,"ゲェムの駒と言うか劇の役者と言うか、[l]\n不出来な脚本、":118,"裏でもっと何か得体の知れない事が蠢いているんではないか、\nという夢想をしたとて罰は当たるまい。":119,"実際、おかしな能力が発現しているし、\n流されてるなりの事態の進展はあるのだけれど、\nただ、\nどういう結末が――":120,"不出来な脚本？":121,"唐突に、[l]\nDeus ex machinaという言葉があるのを思い出す。":122,"確か劇に於いて、":123,"「あ、\nあれか」":124,"――と、錆びたバス停の看板が視えた。[l]\n時刻表はスカスカで、判ってることだが一本逃すと次までがきつい。[l]\nほぼジャストに着いてしまったから少々心配だなあ……":125,"ふぁおん。":126,"バスのクラクションにしては軽めの音が鳴った。":127,"振り向くと、其処にはバスではなく、":128,"「お早う少年。又逢ったね」":129,"「え、ええと、確かその」":130,"助手席の窓を開けてこちらに向かって手を挙げている、":131,"「":132,"奇":133,"士":134,"道":135,"具だよ少年。[l]\n乗っていかないか」":136,"銀髪に":137,"咥え煙草……かどうかは先日の事があるので解らないが、[l]\nどちらかというと男性的な立ち振る舞いをするあの、\n特異な女性――西國の三春関係者の一人の、\nキサムラドウトモ……さんが車を横付けしていたのだった。":138,"大きめのワゴン車……というかバンっていうのか、[l]\n誤解を恐れずに言うならやはりちと男性的な車種に乗っていて、\n電気工事の車の様に少々汚れや凹みが目立つ車だった。":139,"普通の國産車で右ハンドル故、\n左の歩道を歩いていた僕に話しかけるのは\n少々面倒そうだ。":140,"……あれ、[l]\nつい今まで何か別の事を思考していなかったか僕は。[l]\nまあいいか。[l]\n重要事ならば思い出すだろう。":141,"「少年と言いますかもう二十歳とちょいですが……[l]\nええと僕ぁ用事がありまして、\n今丁度バスをですね……」":142,"「ああ、事情は諒解してるよ。[l]\nちょっと手隙になったので僕も手伝おうと思ってね。[l]\nああ、これは僕の持ち車だから気にすることはない」":143,"「え？[l]\nいやその、はい？」":144,"カミサマ、\n今日も初っ端から巻き込んで来ますかい？[l]\n流されろと仰いますかい？":145,"そんなこちらの煩悶なぞ当然何処吹く風、\n道具さんは薄ら笑いのまま続ける。":146,"「こっちに来た時用に預かって貰ってるんだが、\n手入れはしてくれてないのでこんな有様だ。":147,"ま、逆に気が楽だろう？[l]\nぶつけようがどうしようが構わないよ、\n用さえ足せればね。[l]\nよいしょ」":148,"ロック機構が古いのか、手動で助手席のロックを外す\n道具さん。":149,"「で、僕自身そうそう車は運転しない生活なものだから、\n少年、君に運転は任せようと思うがどうだろう。":150,"元々そういう話だったようだし、\nでないとわざわざ出てきて貰った意義も\n薄まってしまうだろうからね。[l]\nそれともそういう考え方は好みではないかな」":151,"「あいえ、大丈夫です。[l]\nじゃあ、お邪魔します……」":152,"大丈夫だけど、会って二回目の人に言われるという事に\n関しては微妙なラインだが……[l]\n何を今更ではあるけれど。":153,"運転席側に廻ろうとすると、\n運転交代は狩屋達と合流してからと言われた。[l]\n助手席に乗り込む。":154,"「結構。[l]\nにしても、\n若人が謙遜すると年長者に対して嫌味にしかならぬよ。":155,"この國に於いて若くして元服するは遠き昔、\n今や幾つになっても幼児が如き若輩凡俗、\n肉の成熟速度と脳味噌の研磨環境が往事とは違うにしても、\nこれでは誰の為にもならないのだがなあ。":156,"イヤイヤ、キミがそういう存在だとは言わないがね？[l]\nまあそうだな、年長からすれば君辺りとは、\n少年と呼んで差し支えない程の歴然たる差がある、という事だ。[l]\n気にすることはないよ」":157,"「確かに昨今、二十歳くらいじゃお子様かも知れませんけど、\n呼ばれる身としてはやっぱり違和感ありますよ……[l]\nそ、それにしてもやっぱり全然":158,"訛り無いですねえ、\n――西國の方なんですよね？」":159,"何だって僕は彼女等と世間話をしてるのだろう。[l]\nや、今や宮さん側からもそういう繋がりを強化する事を求められてはいるのだが……":160,"やっぱりどうも変な感じだなあ。[l]\nあれ、先刻もそういった事を深刻に悩んでいたような記憶が。":161,"しかしもう曖昧です。[l]\n状況も生生流転とでも言いましょうか、\n＋αの事象がいきなり起きた時点で僕のキャパを超えているさ。":162,"「ミコは余程僕に":163,"揶われるのが厭だったのかねえ……[l]\n彼女もすっかり中央弁になってしまったが、\n僕に関しては元よりこうなのだ。":164,"親が変わった人間でね。[l]\nあの地でこの喋りを貫くのはこれで結構至難の業なのだよ」":165,"「はあ、まあ、\nそうでしょうねえ」":166,"旅行で何度か行ったけども、\n西國の方言はかなり強固な我を持っていて、\n僕も滞在中は喋りが伝染ってしまう程だった。":167,"と思っていたら、同じような事を言われた。":168,"「君も一見してどうにも流されるタイプのようだがなあ。[l]\nそうでなくてもこの辺りの方言はやや脆弱の気味があるだろうね。":169,"もう少し北の地方になるとかなり固まって来るが、\nこの辺ではまだ相手の喋りに引き摺られてしまう傾向は大きい。":170,"だからこそ他方言の中で聞くミコのあれは愉快だったのに……":171,"ま、君の思うとおり、\n西國の場合は我が強くて他方言の中に於いても\nそうそう流されはしない\n……その荷物、後ろに置いたらどうだね」":172,"紙袋に入れていた制服を\n無意識的にぎっちり抱えていた僕をちら":173,"視して、\n道具さんが顎をしゃくった。":174,"「ああ、例の制服か。[l]\n聞いてるよ。[l]\n結構な似合い振りだったとか……[l]\nところで式と言えば、冬夏君とはあれから会ったかい？」":175,"「え？[l]\nいえ、道具さんとお会いしてからは会ってないですね。[l]\n連絡も特には……」":176,"そこで道具さんは声のボリュウムを落として、\nこちらに身を寄せて言った。[l]\nちょ、運転怖いですがな。":177,"そう、冬夏との問題も棚上げしたままだ。[l]\n黙っていればいいんだろうけど……[l]\nそれも色んな意味で引っ掛かるし……":178,"「そうか、\nいや、僕もまだ逢えないのだよ。[l]\n昨日もえらい深夜のご帰宅だったとか。[l]\n克杖君は兎も角、姫様君は大変だったろうな」":179,"「はいっ？[l]\nそ、それはどういう」":180,"否、大袈裟な話では無いよ。[l]\nそもそも式前日も、練習やら準備やらで帰宅したのは\n深夜だったそうだし。[l]\nただ昨日は……、":181,"後片付けは今正に僕等が向かっている訳だし、\n打ち上げする程仲の良い友人でも居るのかな？[l]\n御母堂その他が寝静まるまで戻らなかったとさ。":182,"姫様君の報告によれば、\n『永久に帰りたく無さそう』だったそうだが、\n彼女は学校には友人が少ないだろうからね。[l]\n少々不自然ではあるな」":183,"「はあ、\nまあ無事に帰宅はしたんですね？[l]\n心配は要らないと……」":184,"「まあね。[l]\n姫様君はそういう役だからずっと付き合っていたそうだが、\n今日の事もあるから克杖君は不本意ながら別行動だった。[l]\n君への連絡も言い付かったろうからね」":185,"にしても姫様ちゃん達、お目付役ってほんとなんだな……":186,"「冬夏、何か理由があったんですかねえ……[l]\n年頃の女子だし気をつけて欲しいところですが」":187,"「ふむ。[l]\nそうだな。[l]\n今後逢う事があれば君からも是非言って呉れ給え。":188,"理由……は、そうだね、[l]\n僕等が此処に来た事だろう」":189,"「え、\n僕…等ですか」":190,"「ん？[l]\nああ、此処で言う僕等とは、\n僕、奇士道具を含む西部の三春眷属者を指す。[l]\n少年の所為じゃ無いよ安心し給え。":191,"君も祭を愉しみにわざわざ":192,"月も前から\n此処に滞在してるのだから、\n多少は聞き及んでいると思うが、」":193,"ここに至って":194,"漸く僕から身体を離し、\n運転席のシートに深々と身を沈める道具さん。[l]\nそして前方を見据えたまま続けた。":195,"「三春の眷属……東西から七つの家の者が[l]\n祭の為に此処に集まる。[l]\n西國の関係者、僕を始めとして他数名が既に玄ノ森に来てるよ。":196,"僕はミコの所に転がり込んだがね、\n大方の人間は当然、三春邸に宿泊するのだな。":197,"正直、冬夏君は親戚づきあいが苦手なタイプとでも言おうか、\n自己で構築した訳でもない関係の人間に愛想を振って接するのが\n苦痛とでも言おうか、\n僕も本人ではないから想像に過ぎないがね。":198,"君も親類は居るだろう？」":199,"「はっ。[l]\nま、まあそうですね、人並みには……」":200,"一応飯窪のことは伏せてるのであやふやな返答になるが、\n幸い怪しまれることは無かった……と思う。":201,"「君の所がどうかは知らないが、\n僕の知る限り血縁というのは本当に面倒臭いものでねえ。":202,"まあ三春の……眷属の繋がりは必ずしも親類縁者ではないのだが、[l]\nそれでも我々は余所から視れば特権的な":203,"括りの集団、\nと思われてる訳で、":204,"実際我々同士の付き合いも、\n一般の親戚づきあいとそうそう異なるものでもない」":205,"「ええ」":206,"「これが今で言う企業体や何か――\n単純な利害関係のみでの繋がりだったら寧ろ楽だったのだろうが、\n我々は少々……複雑、否、単純なのかな。":207,"精査すれば血縁の繋がりも出るには出るかも知れないが、\n基本的には――":208,"つまらないかね？[l]\nこういう話は」":209,"「はっ？":210,"はあいや、その大丈夫ではあるのですが、こう、\n余所の人間に語るにしては込み入ってると言いますか、\n他人様のお家事情を嬉々として聞くような人間ではないつもり\nなもので、気が引けてると言いましょうか……」":211,"「あっははは、\n君は中々愉快だ。[l]\n君自身の物語の主人公たり得んと思ったらもう少しは\n":212,"自":213,"我を強く持つが賢明だとは思うがね。":214,"僕は君みたいなのが好きさ。":215,"まあ、そう言った訳でね、\n少年は僕等の身内みたいなものなのに、\n何も御存知ではないようだから。[l]\n少々手を貸したくなったのだ。":216,"前も言っただろう。[l]\nそういう行為が好きなんだ」":217,"流され巻き込まれ型の人間だっていう自覚は\n確かにあるけど。":218,"周りが自我の強い人間だと、\nそれに負けじと対抗しうる人格になるか、\n完全に身を委ねる脆弱な人格になるかどっちかな感じ？":219,"そんで僕は後者という事だが。[l]\n宮さんに逢わずとも、\n母さんも結構な振り回し型の人種だからなあ……":220,"いやそれは置いといて。":221,"説明自体は任務上有り難いけど、\n何でこの人に、身内みたいって言われるんだろ？[l]\n前の時は卑尊さんに対しての方便かと思ってたんだが……":222,"きぃもこうやって強引に援助されたのかな。":223,"「至極単純に言ってしまえば、":224,"冬夏君は御母堂とも、\n玄ノ森の眷属とも、\n僕等西の者共とも、\n反りが合わないのだ。":225,"いつもは自宅の部屋に籠もれば良いが、\n一同に会する今回の様な場合は――\nま、実際、これ以上は止めておこうか。":226,"そうだねえ、君が若しも……[l]\n彼女等の誰かと":227,"契ることにあれば或いは事態は変わるかも\n知れぬがね。[l]\nそれこそ本当の身内となるならば」":228,"「かかか揶わないでください」":229,"僕の周りには愉快さが信条の人ばかり集まるのか。[l]\n物理的な実害も許容してる様な場合はちと用心を要するが、\nこの人はどっちなんだろうなあ。":230,"大神はその点割と、己の領分を":231,"弁えていたと言うか、\n妙にきっちりと自他の線引きしてたな。[l]\nあっち方面の人種はそういう人結構多いらしいけど。":232,"――宮さん視てる分には何とも言えないが。[l]\n結局男子と女子の差違なのかなあ。":233,"それより冬夏、\n彼女が何かに付け家の事を疎んでいたのは事実のようだし、\n如何に僕でも数日の付き合いで其れは知れる。[l]\nしかし理由は道具さんの説明でも判らずじまいだった。":234,"血縁の面倒――":235,"まあ、現実は言わずもがな、\n色んな犯罪小説でも動機の最たるものとして\nよく扱われる題材であるから、\n想像理解は出来ぬまでも納得は出来る。":236,"「ははは、ま、そう言う訳で冬夏君の話だがね。[l]\n彼女はそう、だから、\n嫌われている訳ではなくて、\n畏れられているというべきかな。":237,"御母堂の時とは別の、色々な意味に於いて近寄りがたい空気を\n":238,"纏っておいでだからね」":239,"「うーーーーん、\nまあ、僕は気さくな彼女ばっかり視せられたもので、\n何とも言えませんけど、\nそう言うもんなんですかねぇ……」":240,"「君の心意気を察してこれだけ言わせて貰おう、\n君は優しいな、少年」":241,"道具さんがしみじみと言った。":242,"優しい……[l]\n臆病で狡いだけだ。[l]\n唐突な話のシフトだったが、\n僕は内心思わずそう反応していた。":243,"「だが、現実世界はそういう察しの良い者だけで\n構成されてる訳じゃない。":244,"或る人の言葉を借りれば、\nこの世は最悪の箱庭だそうだしね。":245,"文明持つヒトにとっては、\n許可事項が多きことは善きことではないし、\nこの星での生命活動とは他者を喰い、繋ぐ事だ」":246,"食いつなぐ？[l]\nいや、イントネーションというかアクセントが違ってたか。":247,"大体それでは文意がおかしい……が、[l]\n一体何の話なのだろう？[l]\nと、道具さんもその僕の疑念を察したらしく、\nすぐさま軌道修正を行う。":248,"「や、少々横道に過ぎる話だな。[l]\nまあ冬夏君もそういうイヤナコトの中に、\n幼くして身を置いていたのだな。":249,"この地に於いて彼女の家というのは特殊な意味を持つから、\n周囲には取り入りたい人間も居るのだろうが、\n冬夏くん自身は取り巻きみたいなのを毛嫌いするからね。":250,"ま、君も彼女に気に入られたのなら是非、\n親しい仲であって欲しいものだが。[l]\n僕はまだそんなに嫌われてはいない方だと思うがね、\n中々本心を語ってくれないのは一緒だから」":251,"「でもきぃ……貴奴とは」":252,"「ふむ。[l]\n馬が合ってるようだね。":253,"西石君とは僕が仲を取り持った……とでも言おうかな。[l]\n":254,"偶":255,"々そういうエンがあってね。[l]\n御母堂には良い顔をされないので秘密にしておいてくれ給えよ」":256,"「ええ、それはまあ――\nえと、結構古い付き合いなんですっけ？」":257,"「西石君も中々複雑な家庭の事情の持ち主なのだよ。":258,"僕は西國と玄ノ森を行き来する都合上、\n東西関わらず個人的な付き合いのある知人が居るのでね、\nその中のとある":259,"伝":260,"手で西石君とはかなり前から縁があるのだ。[l]\nその縁あって僕も力添えをする事になったんだが……[l]\nそもそもの始めは――\n否、それはあまり他人様に言うことじゃないね。[l]\n僕はともかく西石君が」":261,"「ああ、それはもう、いいですいいです、\n聞かないでおきます。[l]\nところで元気ですか？彼奴は」":262,"「ふむ、\n西石君はあの日辺りからちょっと体調を崩していてね、\nミコにも言って休ませてるんだ。":263,"勿論有休扱いにさせてるよ。[l]\n後で見舞いに行く事になっているのだよ」":264,"「長久診療所でですか？[l]\nあれだったら僕も見舞いに行きますかねえ、\nこっち来てからは世話になってますし……」":265,"「いや、彼処はミコが厭がったので住家の方だよ。[l]\n隣町のね。[l]\nなので気持ちだけ伝えておくよ。[l]\n視られたくない部分もあるだろうし」":266,"うーん、\n思ったよりも重い背景を持ってるのだろうかなあ。":267,"昔に":268,"遭ってたとしても、\nそんな小さい頃じゃ大人の事情も分からんだろうし……":269,"ただ、未だに本当にきぃが、\n幼少期に遊んだ相手なのかどうかは本人の言しか確たるものがない。":270,"僕の曖昧な記憶は最近、微妙に再生しつつあるし、\nもしかしたら――\n確実にそうと言える日が来るかも知れない、近いうちに。":271,"勿論、それは彼奴じゃないという、\n不気味な結果をもたらす可能性も在るわけだが。":272,"「じゃあ宜しく伝えてくださいますか、\n後でまた飯でも奢ると」":273,"「ん、了解したよ」":274,"「まあ彼奴の話に関しては、\n僕も聞いてたかも知れないんですが、\nどうも記憶力に難ありでして……」":275,"「ふむ、まあそうであってもきっと君の所為ではないな。[l]\nで、何の話だったかな？[l]\n婿入りの話か。":276,"冬夏君はそういう訳で少々敷居は高いなあ……[l]\nどうしてもと言うならば止めはしないが、\nお薦めは姫様君か、意外なところで……克杖君？[l]\nあとはまだお子様か或いは……だしねえ……」":277,"「あの、そういう話でも無かったような気が……」":278,"「ん？[l]\nそうだったかね」":279,"「いえ、いいんですけどね……[l]\n話題の一方的なフリとか脱線には馴れてますし。[l]\nそういう人達との付き合いには事欠かないんです僕」":280,"そう":281,"零すと、":282,"「ははは、そう怒りなさんな。[l]\n類は友を呼ぶ、という格言があるだろう、\nあれはなかなかに含蓄のある一文だよ。":283,"況してや僕らのような……には色々あるのだな。":284,"だからね、\n君が招いてるんだなあ、そういう人間をきっとね。[l]\n好い傾向だよ」":285,"何の事やら……と思う":286,"間に、[l]\n道具さんは突然声量を戻して、":287,"「さて、次の停車場だろう。[l]\n待ち合わせ場所は」":288,"と仰った。":289,"突然現実的な話題にシフトした所為か一瞬、\n眼の前が真っ白になる。[l]\n慌てて再思考する……のだが、":290,"「えーと……[l]\nそう…でしたっけかね？」":291,"本来バスに乗っていればそこで降りた筈のバス停が多分それだが、\n車内アナウンスを当てにしていたのでよく分からない。":292,"「ほら、\n克杖君達が彼処に来てるね」":293,"眼を凝らすまでもなく、\n其処には、\nジャージ姿の姫様ちゃんと狩屋が居た。[l]\nおそろいじゃないのでどっちかが私服なのかも知れない。":294,"近くにあった広場に車を停める。[l]\nあの二人は、僕が一人でバスで来ると思っている":295,"筈で、\n少々驚かすことになるだろう。":296,"……携帯で連絡すりゃ良かったのか。[l]\n否、普通に考えて道具さんが既に説明してると思うが――":297,"「やややや、お早う。[l]\n今日は良い天気で良かったねえ」":298,"「うあっ、トモさん！？[l]\nな、なんでいる……いらっしゃるんですか。[l]\nであ、兄ぃと一緒！？[l]\nにゃにゃにゃにゃにゃにゃんで？」":299,"――説明は為されてなかったようだった。[l]\nあ、あれっ。[l]\n最初の話だと一応計画的な行為めかしてた気がしたんだが……":300,"「僕が手伝うと知っていたら、\n克杖君は彼の召喚を渋る理由を見出してしまうだろう？":301,"それは姫様君にとって、\n引いては君自身の不都合となりかねないのだろうしね、\nまあ":302,"佳いじゃないか、単純に労働力が増えたと思い給え」":303,"「え、えぐう……そ、う、あ、[l]\nじゃ、じゃあ、たまたま一緒になったとかじゃにゃいん……」":304,"要するに狩屋に気を遣っての事後承諾、いやさ既成事実として\n参加したかったという事か。[l]\n確かに狩屋はその辺面倒な心持ちだろうけども、\nそこまでする事かしらん。":305,"と、眉をひそめっぱなしの狩屋と眼が合う。":306,"「ああ、お早う……[l]\nそういう事でまあ、ほら、\n時間は早く着いた……よな？[l]\nバスが来る前に拾われてさ……」":307,"「にゃっ、\nそ、そらそうにゃけど。[l]\nだってういら今バスを待ってたんにゃからな」":308,"ぶおーーーん。":309,"丁度そこに白ベースに赤ラインの、古ぼけた車両、\nつまりはこの辺の路線バスがやってきた。":310,"僕等が其処に溜まっていたので一瞬乗車口が開きかけたが、\n道具さんが手をひらひらと振ると、\nドライバーさん諒解したのかそのまま通過する。":311,"それをぼーと見送っていたら、":312,"……おや？[l]\n姫様ちゃん何処に行った？":313,"「お早うございます」":314,"「おあ！[l]\nお、お早う、\nごめん、ちょっと吃驚した……[l]\nいつの間に後ろに――」":315,"「……驚かそうと思って」":316,"「……はぁ、あははは、そうなんだ……[l]\nそれはまた、\nん？」":317,"彼女のお茶目さ加減にリアクションする前に、\nふと眼に入ったものがある。":318,"今まで長袖の制服姿しか視てないから気付かなかったのか。[l]\n下はスパッツ、上は半袖ジャージの様な出で立ちだったので\n非常に目立つその――":319,"「あれ、姫様ちゃん、腕怪我してる？[l]\n大丈夫？」":320,"両腕に包帯……にしてはガーゼっぽくない感じの\n白布らしきものを[l]\nぐるぐるに巻いていた。":321,"「いえ……これは、」":322,"「にゃーーっ、ファッションにゃんねぇーー、\nげうふ、げふげふ、\n":323,"ご、ごめ、":324,"咽せ……おえふっ」":325,"僕等のマンツーマンの会話が気に入らんかったのかも\n知れないが、\nいきなり会話に割り込もうとするから……":326,"道具さんが狩屋の背をさするが姫様ちゃんはそれを見守るのみ。[l]\nまあ、頑張りなされ……":327,"「あ、そうなんだ。[l]\nごめん、そういうの":328,"疎くてさ……[l]\nまあ何でもないならそれでいいんだけど」":329,"「心配してくれてありがとうございます。[l]\nすべてはさいこうです」":330,"……？[l]\nどういう意味でしょう。":331,"「あーっと少年、\nそんなに克杖君の脚に見入っちゃいかんよ。[l]\n全く以て男子というのはブルマ好きだねえ」":332,"「！？」":333,"「！！」":334,"そこで、\n姫様ちゃんの言葉を噛み砕く間もなく、\n道具さんがシャレにならない洒落を投下したのです。":335,"「う、うにゃっ！[l]\n":336,"エロ！ばか！へんたい！[l]\nみんじゃねーーー！！」":337,"「や！[l]\nちが！[l]\nは？！":338,"何おいってるんですか！！[l]\nどどど道具さんもうそいわない！！」":339,"しかもこれはデジャ－ビュでしょうか。[l]\n何か前にも同じような事が。":340,"「……克杖」":341,"「えっ！[l]\n":342,"ずずずずず狡くにゃいってばっ！！[l]\n狙ってにゃいし！！[l]\nなにも！！」":343,"「うーん御機嫌だねぇ姫様君。[l]\nそれではまず学校に行こうか。[l]\n折角早めに集合出来たのだし」":344,"無駄に昏迷の様相を呈し、且つその度を深めつつあったその場は、\nその状況を作り出した発起人によって、\nしかもそのどれをも解決せぬまま、\n次の状況へと遷移させられようとしていた。":345,"まあ、\nどれもがどうでもいい事象だったけど、":346,"「………」":347,"姫様ちゃんの眼だけが怖いんだもの……":348,"ああ、[l]\n天気はすごく良いのだがねえ。":349,"昨日の時点で狩屋が準備をしてたようなので、\n積み込み自体はすぐ終わった。":350,"その狩屋から前に説明を受けた通り、\nやはり神事に使用したものは儀礼的に処理するのが常らしく、\nそれ専用の処理場に運ぶのが今回の仕事だ。":351,"その儀礼的処理にまで僕が関わる事になるかどうかは\nまだ聞いてないが、":352,"一応三春の私有地内になるし、\n祭儀に関した場所ともなる訳で、\n若しかすればあの蔵の中のように何らかの情報が\n得られる可能性はある。":353,"ただ、\n面子的に僕ぁ、積極的に探索に身を入れられる自信は無いなあ……":354,"と、どこかに携帯電話を掛けていた道具さんが戻ってきた。":355,"「ふむ、\nお待たせしたね。[l]\nでは、改めて運転宜しくお願いするよ。":356,"さ、これ、キーだ。[l]\n今時の洒落た機能などない、\n完全なる手動のみの対応だから気をつけてくれ給え」":357,"「あ、どうもです。[l]\nインキーも有り得る訳ですね……」":358,"「多少は自分で気を遣わないとね。[l]\n脳髄は使い続けるに超したことはない。[l]\n":359,"なんでもかんでもフォローされてる状況が良いとは限らない……":360,"しかしながら『恣意的に設定された不便』もやはり宜しくない。[l]\n":361,"バランスが肝要だね」":362,"大神にだったか宮さんにだったか、\nゲェムの話題でそういう話を聞かされたのを\n思い出した。":363,"その時は喩えが具体的すぎてよく分からなかったけど……[l]\n単純な理屈としてなら解る。[l]\nまあ道具さんが言うのは実生活に伴う話で、\n娯楽の有り":364,"様とはまた話のステージが違うんだろうが。":365,"「おーい兄ぃ、トモさん、\n早くいこうにぇー」":366,"狩屋に急かされて、\n僕等二人は車に乗り込んだ。":367,"配置は、\nドライバー僕、助手席に道具さん、\n後部座席に姫様ちゃんと狩屋である。[l]\n道具さんが案内をしてくれるらしい。":368,"彼女にしてみれば当然、勝手知ったる何とやらなんだろうし、\nこの辺だと機械のカーナビ、地図が入ってない以前に、\n行き先が私有地の山ん中だっつーの。":369,"「じゃあ、出発しまーす……」":370,"後ろに荷物が載った為に少々慣性の強くなった車を\n慎重に運転する。":371,"多少ボロくて持ち主がぶっつけを気にしてないとはいえ、\n流石にそれに甘んじることは出来ない。[l]\n気は遣う。":372,"兎にも角にもまず用件を一個一個片付けよう。":373,"「ああ、制服その袋の中。[l]\nちゃんとクリーニングしたから心配ご無用、\nまあその、ありがとう」":374,"言い出しっぺは僕でない為に御礼を言うのも何か筋違いな\n空気だったが、\n会話ってそんなものだよね。":375,"「いえ、とんでもないです。[l]\n今後も何かあればまた」":376,"いや、だからどうにも筋が違う気がするけど。[l]\n今後って言われても、\n少なくとも女装は二度と無い……事を祈ります。":377,"「ああ、ういは色んな意味であんまし思い出したくにゃいわ……」":378,"「……ずるい」":379,"「はっ！！[l]\nや、そのっ、\n":380,"あれ？[l]\nきーちゃはそういえば、視て……にゃいんだっけ」":381,"「……近くでじっくりとは……」":382,"「ま、まあそんなたいしたものでは……」":383,"宮さんが撮った写真は存在するけど、\n……そこまでせんでもええよなあ。[l]\n基本的に僕にとっては恥ずべきモノであるし……":384,"「まあまあ、\nそもそも姫様君が、\n彼に感想を聞きたいというのが趣旨だろう？」":385,"「？[l]\n……そんなことまでういら、言ったっけ？」":386,"「ん？[l]\n君達はあの人に話したんだろう。[l]\n西部の面々はこうみえて仲がよいのだよ？」":387,"「ああ……」":388,"何の話かよく分からないが、\n別に僕が入るべき会話でも無さそうだったので\n運転に集中する。":389,"旅先でレンタカーを使う事はままあるが、\nいつもと違う車の運転は未だに緊張するのだ。":390,"「と言うわけで、\nまあ、しばらくは道なりだ。[l]\n姫様君に話てやって呉れ給え。":391,"ちなみに僕は……概容は把握してるが、[l]\n実際的には参加したことがないのでね」":392,"「え？[l]\nあ、ああ、そうですなあ……」":393,"結局、感得がどうのに関しては先日から考察してる通りで、\n仕方がないので、\n頭からぼやかしながら話してみる。":394,"「なんだっけな、\nまず、あの式場に入ったら、\n隣りに眼鏡を掛けた":395,"怪":396,"訝しな女子が居て、":397,"何か僕の正体を見破った上で見逃そう、\nみたいなよく解らないことを」":398,"一応宮さんの情報を補強する為の意味も込みで\nそういう訊き方をしてみる。[l]\n勿論、何も知らない風を装う。":399,"「その人……」":400,"「え、知ってるの？」":401,"我ながら白々しいけども一応そういうリアクションをする。[l]\n道具さんは……横目で窺う限り、[l]\n半笑いでずっと窓の外を視ておられるが、\nまあ見抜かれたという事もないだろう。":402,"……ないよな。[l]\n最近察する人が多くてどうにも疑心暗鬼になるなあ。":403,"「選律さん」":404,"「えあ……[l]\nき、きーちゃ？[l]\nああ、ええと、\n前ちらっと……言ったような言ってないような、":405,"説明が遅れたけど、\nあれが選の字って言って、\nその……説明がむずかしいから割愛するにゃが、":406,"ういも居るのは知ってたけど、\nまさか兄ぃの隣りに居たとは知らにゃかった、\n兄ぃが帰ってからわかったんにゃのよね」":407,"「選律さんは私達『":408,"八":409,"相』の西國仕切です」":410,"成る程、基本的には宮さん情報と合致するのか。[l]\n只、狩屋が言い渋る理由背景が解らないけど、\n声を出さぬまでも狼狽しているのが伝わる。":411,"口":412,"外":413,"御":414,"法":415,"度な重要事項だと言う事だろうか？[l]\n確かに聞いたことのない――":416,"ん？[l]\nヤソウ？":417,"何処かで聞いた……ような？":418,"「大丈夫、\n真言さんだから」":419,"「……いあ、その」":420,"八の相と表すが、\n実際に三春とその眷属たる我等は七つの家なのだなぁ」":421,"「……！[l]\nと、トモさんまで――」":422,"狩屋がやはり息を":423,"呑む。[l]\n此奴の気持ちも解ると言うか。":424,"僕が思うのもなんだけど、\nどうにもこの人達は口が軽すぎるというか、\nそれほど重要事だと思ってないのか、\n僕の存在など歯牙にも掛けてないのか。":425,"後者にしては、\n姫様ちゃんあたりは特に積極的な情報開示をしてくるので\n何とも言えないが、":426,"冬夏の事もあるし彼女達の中にも保守革新の派閥があるのは\nどうやら間違いはないようではある。":427,"でも、[l]\n僕だからと言うのはどういう意味だろう。":428,"姫様ちゃんまで僕の記憶力に高を括っているのか、\nそれとも、[l]\n本当に『僕が僕だから』情報を開示しているとしたら、\n……。[l]\n道具さんが、僕を評して『身内のようなもの』と言うのも\n気にかかる。":429,"飯窪本家と三春家が同じ土地、\nこの玄ノ森に本拠を置いてるという事、\n両家ともに書籍蒐集及び、\n何故か手の込んだ建造物を所持している事、":430,"バックボーンとしての共通点は確かに存在しているが、\nしかし僕が飯窪の者とは言ってない筈のこの状況下で、\n他に何かしら僕を同類と見なす要素があるとしたら、":431,"それは一体何だと言うんだ。":432,"それは式で何かを感得する筈と、姫様ちゃんが思い込んだ素養と\n同義なのか。":433,"僕の鈍麻してる筈の記憶力が、どうにも最近は活性化してるようで、\nもう一つ思い出した事がある。":434,"その選律――西國仕切という女子が、\n僕を見逃す理由として言ったのが、\n同類同業の":435,"誼で……という事。":436,"僕は最初これを、\n本来部外者禁制の式に潜入している者同士という風に捉えていたが、":437,"彼女自身は当事者も当事者――まあ、生徒ではないにしろ――\nである事が、宮さん情報だけでなくて、\n姫様ちゃんの言から証明された、のだ。":438,"と言うことは、[l]\n何を以てして、僕を同類と呼んだんだ？":439,"「おぉいー少年、\n信号赤いぞぅ」":440,"「おあ！[l]\nす、すみませんっ」":441,"慌ててブレーキを踏む。[l]\nし、知らないうちに交差点に差し掛かっていた。":442,"「うあにゃ！[l]\n":443,"あ、あ、兄ぃぼーとしてんな！！[l]\n田舎だと思って甘く視てんにゃよ！！[l]\n只でさえ後部座席は酔う……":444,"うぐっ」":445,"「ば、田舎だからとかそんなつもりじゃないっての……[l]\nちょっとぼーっとしてただけだ」":446,"「ぼーとはしてんにゃろが！！[l]\nしゃんとしとけばか！！」":447,"「まあまあ、\nこの辺りの信号機はまだ古い型で、\nこの晴天下では視えづらいしね。":448,"とは言え他人を乗せている以上は馬鹿とは言わずまでも、\n次から気をつけてくれ給え」":449,"やっぱり記憶力が多少活性化しても、\n事象の並列処理はまだ難しいようだ。[l]\n素直に謝る。":450,"「わ、わるうござんした……」":451,"……あんまり素直に聞こえないかこれ。":452,"で、運転に集中する。":453,"而して、人間完全に無心になるには結構な労力が必要で、\n故に黙っていても勝手に思考は為されていくのであった。":454,"「真言さん頑張って」":455,"「は、はい……」":456,"妙なプレッシャーを背に感じながら、\n安全運転を心掛けつつ思索する。":457,"僕は数字勘定が苦手なのであんまり意識してなかったが、\nカウントすると、":458,"三春、\n綾目、\n狩屋、":459,"奇士、\n永久、\nええと、":460,"玉梓、\n玖威、\n……うん、把握してるのはこの七つだ、その筈だ。":461,"道具さんも後ろの二人と合流前の会話で七家と言ってたし。[l]\n――言ってる側から結構面倒な思考をしてしまった。[l]\n取り敢えず直線で何もなさそうだったからだが……":462,"まあ、冠してる名称――この場合屋号か何かかも知れないが、\nその数字と実際の戸数が違ってても、\nうーん、そういう事もあるのか、という程度だろうけど……":463,"この國に於いて、数える魔術は結構あやふやというか、\n数字を冠する事が大事なのであって実際にその数が在るかどうかは、\n若干ルーズな例が多いよね。[l]\n何とか百景とか百物語とか……":464,"この情報、宮さんから既に聞いてるっけ？[l]\nいや、そんな記憶はない。[l]\n僕の場合は当てにならないが、まあ、\nこれも一つの収穫として後で報告しよう。":465,"しかし、ヤソウ？[l]\n何処で聞いたんだっけ？":466,"「……にしてもにゃね、[l]\n選の字もタマ……":467,"や、その、\n何もなかったって……[l]\nだったらその、あんまりこう、\n言うのはきけ――」":468,"「？？？」":469,"「にゃ、そ、その……」":470,"「私の……が第イ…」":471,"「う…うあ」":472,"「ニ…もゴ…もきづけなくても」":473,"何か後部座席で話してるようだが、\nちょっとエンジン音が煩くて聴き取れない。[l]\nま、毎度の微笑ましい遣り取りだろう。":474,"助手席の道具さんは聞こえてるのかいないのか、\n":475,"窘めっぽい言を後ろの二人に向けて発した。":476,"「まあ、彼はもう……身内のようなものだけれどね、[l]\n姫様君はもう少し":477,"深":478,"慮":479,"遠":480,"謀した上で行動発言した方が\n":481,"佳いと思うよ。[l]\n怖い人達も居る事だし――」":482,"怖い人達？":483,"まあ物騒だっていうから……という建前で僕がこうして出張って来てる訳なのだが。[l]\nそれとも別口かしらん。[l]\n冬夏のおっかさんも怖いしなあ……":484,"「愉快さが信条の僕とは言え、否、だからこそかな、\n大胆さと小胆さのバランスを考える事が肝要と心得ている訳でね」":485,"と、今度は僕の方を視て言う。":486,"「まあ、何事に於いても需要と供給、本音と建て前、\n親の心子知らず、":487,"製":488,"作":489,"者 ":490,"使":491,"用":492,"者間の壁、\n温度差にしろ立場上から生じる方向性の違いにしろ、\n双方の均衡をとる中和点を随時探していないといけないのだな。":493,"そこに関して言うなら、\nその場に留まりたくば走り続ける事、だよ。":494,"いずれにせよこの完全過ぎるが故に\n出来損ないに視えるゲェムが如き\nこのセカイに生まれたからには、":495,"君にも大いにその人生を謳歌して欲しいものだし、\nその為の援助は惜しまないつもりだよ？」":496,"「はあ、\nなんと言ったら良いんでしょうか……[l]\n御陰様で今の時点で十二分に波瀾万丈ですし僕は、\nあはははは……」":497,"「だろうねえ、\n君はそういう役を振られているようであるから」":498,"「あはははは……」":499,"乾いた笑いを振りまいてみる。[l]\n後ろの二人は、\n道具さんの言った言葉を気にしたものか少々静かなままだ。":500,"……まるで道具さんの言葉を肯定してるみたいで、[l]\nこちらとしましては少々滅入るんですが。":501,"「早速その援助の一環として遅まきながら補足するとだね、\n選律君というのはまあ、\n姫様君が言ったように西國の方の人間。":502,"知っての通り僕も西國の出なものでね、\n彼女とも密でこそないが、近しい付き合いなのだよ。":503,"多少言動は":504,"訝しく視えるかも知れないが、\n――ん？[l]\n姫様君どうしたね？」":505,"いきなり道具さんが振り向いた。[l]\n静かと思っていたのは僕だけで、\nどうやら何かしらのリアクションがあったのかも知れない。[l]\nすると、エンジン音に掻き消されそうな声が聞こえた。":506,"「話が……」":507,"「ああ、長い上に横滑りしてるか。[l]\n御免御免。":508,"さて少年よ。[l]\nそういう訳で君の隣りに居たのは僕等の身内だ。[l]\nそれで」":509,"僕に対するフォローという訳ではなかったのね。[l]\nまあそれは、そうね……[l]\nそしてそんな唐突に話振られても。":510,"「そ、そうすなあ……、[l]\nその後ですか……[l]\nええと」":511,"どうするか、\n『あのこと』を言うべきかどうか――":512,"運転しながらであったり、\nいつも以上に思考を巡らした所為なのか、\nまた例の首が熱くなる感覚がうっすらと、":513,"そして脳裏に甦る彼奴の言葉が、[l]\n――取り敢えずは他人には言わない方が身の為じゃないか、\nと思うがな――":514,"「……ああ、う～～～ん、[l]\nその、姫様ちゃんには悪いんだけど……」":515,"金縛りにあったとか変なモノをみた事は伏せつつ、\n当たり障りのない感想しか得られなかったと伝えた。":516,"冬夏の前では結構そういう素振りを見せてるかも知れないが、\nどうにも後部座席の二人とは馬が合わないようだし、\n話は伝わってない……と思うけど。":517,"「も、勿論感謝はしてるし諸々は秘密にするけどね……」":518,"「………そう、ですか……」":519,"「ほら、やっぱりにゃんね？[l]\nきーちゃ、何かのまちがいにゃって……」":520,"「まあねえ、敢えて姫様君の肩を持つ発言をさせて貰うなら、\n感得すべきコトは言葉での伝達が不能であるが故に『そう』なのだ。[l]\nきっと彼は解ってるよ」":521,"――はっ、\nまさか僕の身に起きたコトを見抜かれてる？[l]\nそれとも単に言葉通り、姫様ちゃんへの肩入れ……というか、[l]\n慰めの言なのか。":522,"一般論としての意見なのか、\nあの式に於いての具体的な話なのかが判然としないので、\n気になるというかこちとらもうドキドキものなんですけど……":523,"後ろは振り向けないし\nバックミラーには狩屋の顔しか映ってないので\n姫様ちゃんの表情は分からないが、":524,"「……そう、ですよね」":525,"「にゃうあ……」":526,"狩屋のリアクションと併せ考えるに、\nどうやら喜色を浮かべているようだ。[l]\nつまりは、\n……どっちなんだ？":527,"「解ってます」":528,"「成る程ねぇ……[l]\nそうか君は、」":529,"「んにゃ！！」":530,"「……！」":531,"「……ん？[l]\nああ、御免」":532,"「？」":533,"何かを言い掛けた道具さんは、\n突如僕に向けて謝る。[l]\n後部座席の二人組も何故か焦っていると言うことは……":534,"「今の路を右だった。[l]\nＵターンからの軌道修正を願うよ」":535,"「ああ、な、何事かと……[l]\n了解しました」":536,"や、しかし、道具さんの言葉の続きは何だというんだろう。[l]\nしかし追求するにはあまりに……":537,"空気的に僕が突っ込むと藪蛇な気配がすごいするし、\n兎に角Ｕターンをする事にする。[l]\n幸い車は殆ど居ないので、あっさり軌道修正は出来た。":538,"「そうだ、少年忘れていたよ。[l]\nそうだったそうだった」":539,"言われるが儘に横道――どうも此処から上り坂で、\n本格的に山道に入るようだったが――に入った途端、\nそう言って彼女が後方を向いた。":540,"え、まさか":541,"先":542,"刻の続き……":543,"「姫様君、其処にあるそれ取ってくれるかね？[l]\nそう、それそれ、どうも有り難う」":544,"道具さんは後ろから何やら包装紙に包まれた箱を受け取って、\nビリビリとそれを破りだした。":545,"横目でちらと視るに、[l]\nどうみてもよくあるお菓子の土産物……だなあ。":546,"「で、これ、つまんで呉れ給え。[l]\n視たとおり土産物で、\n姫様君の所から持って来たんだがね。":547,"すっかり忘れていた、あははは。[l]\nん？":548,"そんな眼で視なくても、\nちゃんと在夜君に断ってきたから大丈夫だよ姫様君。[l]\n運君には黙って来たがね」":549,"やっぱそうか。[l]\n――って、会話の続き思い出したんじゃないんかい。[l]\nこの":550,"性は":551,"刻からどうも思わせぶりで……":552,"というかこっちが自意識過剰になってるだけかもだが、\n精神揺さぶられるなあ。[l]\n色んな意味でのダメージが蓄積していく……":553,"「――ああ、お土産屋もしてたんだっけ。[l]\n僕も結構旅行してるんで、\n視た目も味もちょっと変わってるくらいのだと\nワクワクしますねぇ～」":554,"反動という訳でもないが、\n無駄にノってみる。[l]\n言ってることは事実だけど。":555,"杉屋の新メニュー体験と同じく、\n微妙であればあるほど愉しくなるね。[l]\nシモというか卑猥系は個人的にあれだけど……":556,"「なんていうんです？」":557,"「えーと、これはなんて名前、『ねこバナナ』？[l]\n『ねこまたのしっぽ』か。ほう」":558,"「なんで最初バナナというワードが……[l]\n味がそうなんですか？」":559,"一つばかり取り出して僕の視界の隅っこに掲げてくれたそれは、":560,"乾燥剤＋ビニール包装で、\nカステラ的生地の……\nぱっと視じゃ分かんないが何かしらの造型をした、[l]\n平たく言えば人形焼き的なものだった。":561,"中に何らかの餡が入ってるかどうかは見た目と名前からでは\n解らないが、\nバナナという単語が出たのがもし味由来ならば、\n中央の方の土産にそういう感じのがあったな……":562,"姫様ちゃんが説明したそうなオーラを発している気がしたが、\n道具さんが先手を取って話を始めた。":563,"「君も『そっち方面』には詳しそうに見受けられるから\n解ってくれると思うが。[l]\n怪異なす":564,"尾":565,"割れしけものの類だね。":566,"単独なのか相互関与して発生したものかまでは、\n残念、興味がないので調べたことは無いがね。":567,"年経りし猫は尾が二又に別れて云々、\n九尾の狐しかり、そもそも九尾の猫鞭というものもあるが、\n八つの玉を孕ませた犬、は話が違うか。":568,"あとは七つの頭を持つ獣、エトセトラエトセトラ。[l]\nまあ数える魔法というのは在るからね、\n普通でない状態を説明するに非常に有効な演出ともなるし……":569,"ああ、猫は九つの魂を持つとか、\n君が興味を持ちそうな外つ國の":570,"諺があるねえ。":571,"で、これは此処の土地柄に併せたそう言う系の話に、\nバナナの房を尻尾に見立て、味の方にそれを反映させて創られた\nという経緯かな？[l]\n僕も詳しくは知らないが」":572,"『そっち』って、土産知識じゃなくて\n妖怪とか『そっち』の方か。[l]\n姫様ちゃんも僕をそういう眼で視てるし、\n寧ろそっちから情報で、かしらん。":573,"「まあ興味深くはありますが、\n結局そのあ、味とか風味の方は……」":574,"「ん？[l]\nああ御免、味に関しては自身で判断して貰うしかないな。[l]\nでは……」":575,"運転中に開封するのは少々難儀であるので、\n道具さんが袋を破り、いざ食べさせてくれようとした瞬間、\n後ろから小さな手が伸びてきて手首をがっしと掴んだ。[l]\n僕のではなく、道具さんの。":576,"「お、おっと……驚くなぁ。[l]\nどうしたのかね」":577,"「私が……」":578,"「ああ、そういう事か。[l]\n":579,"君も随分アグレッシヴになったなあ。[l]\n":580,"理由は分からぬでもないが、\n――克杖君が妬いてるようだが」":581,"「んぬっ……[l]\n":582,"う、ういのことはほっといてください」":583,"「……克杖もそのうちわかってくれるはずで」":584,"「おうあ……」":585,"「ま、まあまあ皆さん穏便に……」":586,"こういうのを何とかの鞘当てと呼んでしまってよいものかどうか、\n何にしても僕自身がどうこう出来る問題じゃないんだけども……":587,"と、僕の座席の肩越しから、\n開封されたその菓子を持つ手が伸びてきた。":588,"「あ～ん、を……してください……」":589,"「あ、あ～んて……」":590,"あ、あのぅ、\n普通の言い回しがあるでしょう、姫様ちゃん。[l]\n宮さんにだってされたことないですよ。":591,"「んむ、あぃがおぅ、おむ、うむ」":592,"今までの言動とかお約束として横の御方が冷やかしてくるのかと\n思ったが、狩屋への遠慮なんだか、趣味じゃないのか、\n黙して成り行きを見守るのみだった。[l]\nや、勿論冷やかして欲しかった訳ではない。":593,"「んー、んむ、うん」":594,"フォルムの詳細は確認できなかったが、\nちらっと視た限りでは名の通り猫から大きな尻尾が\nバナナみたいに何房か出てる感じで、":595,"カステラ風生地にバナナ風味のカスタードを\n":596,"餡として包んである、\n":597,"所":598,"謂土産物によくあるやつだった。":599,"「んまいけど…微妙に口の中の水分もってかれるねえ……」":600,"「ああ、御免。[l]\nそっちの方は用意してないんだなあ」":601,"「克杖」":602,"「えあ、にゃ、にゃいよなにも……」":603,"「……すみません」":604,"「や、その、大丈夫だって、\n気にしないで」":605,"「や、悪かったね。[l]\n今日の用事が済んだ後、姫様君の所で食事だっていうのでね、\nあまり水分を取らない方が……":606,"ああ、僕だけなのかも知れないが、水分を過剰に摂ると食欲が減退してしまうから」":607,"「まあ、嵩張りますからねえ胃の中で……[l]\nどっちにしてもその、ホントに大丈夫だから姫様ちゃん」":608,"「そうですか……では、後程家で……その」":609,"「ああ、うん、期待してます……」":610,"「ううううういも愉しみにゃよーきーちゃぁ～」":611,"「お、例の制服かね。[l]\nいいねえ、僕も久しぶりに視るなぁ。[l]\n西の面々にはそういうのは無いからね」":612,"何とか和やかになった雰囲気の中、\n既に山道も舗装が終わり、\n完全な砂利道に入っていた。":613,"左右は完全に杉の人工林といった感じで、家屋は最早見当たらず、\nガードレールも大きなカーブ以外には無くなってきてる。":614,"ので、前方に注意をしてたつもりだった。":615,"だぁん！！！":616,"「っっ！！！？？？」":617,"通常走行時には有り得ない音がし、同時に車体に衝撃が走った。":618,"ワンテンポ遅れたが、":619,"咄":620,"嗟にブレーキを踏む。":621,"車はエンストし、瞬時にして異様な静寂に包まれる。":622,"暫く全員が静止して様子を伺う。":623,"が、[l]\n取り敢えずは何も起こらない。":624,"「な、何か踏んだ……のか、な？」":625,"動物か何かを轢いたわけではないと思う。[l]\n前方は視ていた。[l]\n山道、砂利道には何も……居なかった筈だ。":626,"だから何かを轢いたとすれば横から飛び出てきたか、":627,"「パンク……ですかね？[l]\nパンクって経験無いからわかんないけど……」":628,"幾ら本人が多少のアレは構わないと言っていたとは言え、\n三春関係者の車をちょっと":629,"疵":630,"物にしてしまった\nという状況は":631,"甚だ":632,"芳しくないなあ。[l]\nパンク修理なんて、自分では自転車ですらしたことないし。":633,"ちょっと降りてみようとすると、道具さんに止められた。":634,"「これはキンキュウを要する事態かも知れないね」":635,"「え？それは」":636,"「………！」":637,"何故か後部座席の二人は反応した。[l]\n緊急を要する事態？[l]\nと、道具さんがドアを開けた。":638,"「しー……」":639,"こちらに対し静かにするよう促し彼女自身が外に出て、\n車体の下から上から確認していると、":640,"「ほう。[l]\n上からか」":641,"ぐるるるるるるるるるうっるるうるるるあうあああああ！！！！！！！！[l]\n":642,"！！！！！！！！":643,"おと、いや、[l]\nこえ！？":644,"「……っ？！[l]\n道具さん？！」":645,"大音響に聞こえたが、\n":646,"閑か＋びびってたからかも知れない。[l]\n或いはこの":647,"性が単に動じない性格なのか、\n道具さんは今のコエにもあまり反応を示さないまま、周囲を視回す。":648,"僕はと言えば、\n全身総毛立ち、動悸が速まるのが解る。[l]\n一瞬思考停止したが、\n慌てて、それでも道具さんを呼ぶ。":649,"「――は、早く中に戻って下さい！！」":650,"しかし彼女は表情を変えずに……[l]\n寧ろうっすらと笑みを浮かべているようにも視える顔で、\nそのまま周囲を視渡し続ける。":651,"いくら愉快イヴェント大好きったって、\nこの状況不明で、身の危険を感じ得る場合は別……じゃないのか？[l]\nこの人は。":652,"「………。[l]\n静かに。[l]\n僕なら心配要らないよ」":653,"やはり単に、極度に冷静な":654,"性質なのか。[l]\nにしても、\nこ、こんな事がつい最近もあったような……":655,"――そう、三春の蔵の中だ。[l]\nしかし、あの時のとは違う、違うと思う。":656,"前のは盛りのついた猫みたいな、\nヒトの声のようではあっても獣じみた感じだったけど、\n今のは――":657,"「どうやら生物、大きめで、\n――『けもの』の":658,"類のようだよ、\nお二人さん」":659,"と、言った。[l]\n視線は僕を通り越している。":660,"つまり、\n二人とは姫様ちゃんと狩屋？[l]\n何故彼女達だけに。":661,"「真言さん、其処にいて」":662,"「えあ、きーちゃ？[l]\nまさか」":663,"「様子を視てくる。[l]\n来て克杖」":664,"「いっ！？[l]\n":665,"幾らにゃんでもこの状況で」":666,"若しかすると若しかするかな。[l]\nいや、何とも言えないか。[l]\nまあ用心に超したことはない、\nいずれキンキュウ事態のようだね」":667,"「そんな、――兄ぃはどうするん」":668,"「真言さんは絶対に車から出ないで。[l]\n":669,"道具さん、真言さんをお願いします」":670,"と、道具さんの方を視て言う。":671,"返事を差し挟む間もなく彼女達の話は進む。[l]\nな、何が起きた、否、起きてる？[l]\nそして彼女達のその、\n想定されていた事態に対処するかのような態度は何だ？":672,"姫様ちゃんのその、\n普段からは想像の出来ない、冷たいが確たる意志の":673,"隠った眼が、":674,"僕をより一層、[l]\n":675,"どきりとさせた。":676},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_026.ks","relPath":"/data/scenario/SC_M_026.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":677,"length":677,"percent":100},"cellInfo":[null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"t":"HU","v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"t":"HU","v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v"