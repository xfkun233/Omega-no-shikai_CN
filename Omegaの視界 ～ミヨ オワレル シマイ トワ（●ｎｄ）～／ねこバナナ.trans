t":14516,"end":14516}],[{"start":14572,"end":14582}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_009.ks","basename":"SC_M_009.ks","indexIds":{"「どうし…おわあ？！":0,"吃":1,"驚し…たあぁ？":2,"おうえ？？」":3,"冬夏の視線の先、僕の袖を引いた何者かを視んと振り向くと、":4,"「あ、れ、れ？」":5,"「ちょとまったきーちゃ…って、あ、":6,"あは、あはは、":7,"あはははは…":8,"どうもこんちゃ……」":9,"「あ、え、キサマ？":10,"何これどういうことカツエ？":11,"君等なにしてんの？」":12,"冬夏と同じ制服を着た女子二名が、\n一人は僕をじっと見つめ…というか睨んでるようにしか見えないが、\nとにかく袖を掴んだままで居り、\nもう一人は、ばつの悪そうな苦笑いを浮かべて冬夏に弁明している。":13,"「やその、あたしにもわかんにゃいんですけど\nあはは…":14,"なんかきーちゃが冬夏ちゃをみるなりいきなり…」":15,"同じ学校の生徒というだけでなく、\nどうやら冬夏の知り合いらしい。":16,"にしてもキサマってなに？":17,"貴様てことか？ちょっとイントネーション違ってたけども。":18,"「……ふうん？":19,"でも見る限り、私というよりこの…」":20,"困惑しきりの僕よりは、\nこの新たな登場人物を見知っているだけ\n事態が分かっているらしい冬夏だが、\nそれでも堅く険しい表情のまま僕を指す。":21,"「…んに…は」":22,"「……あい？」":23,"突然僕の袖を持ったままのその娘が何かを言った。":24,"しかし聞こえない。":25,"「こん！":26,"…にちは」":27,"「ああう、":28,"あ、こ、こんにちわ……」":29,"僕を睨んだり眼を逸らしたり、\n忙しなく視線が泳ぎつつ、\nただ全体的に不機嫌そうなオーラを発しながらその娘が…\nこれは挨拶でいいのか？してきた。":30,"きーちゃと呼ばれていた気がするが、\nよく分からない。":31,"きぃと語感かぶっとるし、ややこしいな。":32,"というかあなたがたはどなた？":33,"冬夏さん、一体これはどういう事でしょう？？":34,"そろそろ説明していただけると有り難いんですが。":35,"と至極当然の要求をしようとした矢先、\nもう一人のちっさいのが叫んだ。":36,"「にゃ？！":37,"きーちゃどうした！":38,"んあ？あれ？":39,"ていうかあんた誰よ」":40,"おぉいおまえ、今まで気付かなかったのかぁー。":41,"「んんー？":42,"みない顔だな？":43,"うちの生徒でもにゃいだろー。":44,"何の用でここにいるのょ」":45,"「ああ？」":46,"…こいつ。":47,"礼儀がなってないとか以前に、\n悪意敵意剥き出しじゃねえかよ。":48,"僕が何かしたか？":49,"それ以前に初対面の人間によくそこまででかい態度とれるな。":50,"きぃですら最初は丁寧語だったぞ。":51,"「どこの誰かは知らないけどな、\nそもそも僕は高校生じゃない。":52,"もう成人間近の歴とした社会人だ。":53,"おま…きみは、趣味で着てるんでも無い限り、\nどう見たって中高生だろうが」":54,"「は！なにそれ。":55,"だから敬えって？":56,"年上だったら偉ぶっていいとでも\n思ってんにゃか？」":57,"「は！じゃねえよ。":58,"それと無礼を働く事はまるきり無関係だろよ。":59,"そういうこと言ってるんじゃないんだ僕は。":60,"最低限の礼儀ってもんがあるだろ」":61,"「説教にゃか？":62,"怖い人から言われたらそんな反論してないだろー。":63,"目下と思って差別して、無礼はあんたの方にゃさ」":64,"「指をさすな指を！」":65,"いかん、血が胃に行ってる所為か、いつもの空転脳に…":66,"寝起きと空腹満腹時には判断力が著しく低下するから、\n只でさえとても臨戦態勢とは言えない状況なのに、\nよりによってこいつは一番厭なタイプが。":67,"理詰めなのか屁理屈なのか、\nはたまた現実主義者なのか、\n理論的に反論するには破綻しており、\n感情的に対抗するには全く以てやりにくい。":68,"女子とは口論するもんじゃない…":69,"腕力でどうこうするつもりも勿論ないけど。":70,"てかそれこそ差別だって突っ込まれる。":71,"「なんなら拳で白黒つけてもいいにゃさ。":72,"遠慮しなくていいぞー。":73,"ほれほれ」":74,"…思った側からこの女…。":75,"ぐ、しかしさすがに手は出しませんよ。":76,"つーかそこまで挑発されると逆に冷めるわい。":77,"――まあ、そうでなくても目立つことはしたくない。":78,"自慢じゃないが、腕っ節もからきしだしな。":79,"「あのー君等、":80,"互いに紹介せずされず、\nそこまで喋りあえるなら逆に気が合ってるのかなー？":81,"と、思う訳にもいかないからさ、\nまことさんとりあえず紹介させて。":82,"ほんとに殴り合いになったら…いや、\n一方的な暴行になりかねないしこの娘の場合」":83,"はい？":84,"それは僕のヘタレ具合とは関係なしにと言うことか？":85,"冬夏が見た目で既に僕を見縊ってるんで無い限り、\n対象の力量を度外視しても尚、":86,"このちっさい小生意気な娘が相手をボコボコに出来るという\n前提があるが故の発言ということになるんですが。":87,"…まさかねぇ。":88,"……ですよねぇ。":89,"それともう一人は放置ですか。":90,"僕の袖はもう放してくれてるが、こいつ同様説明がまだだけど。":91,"「あー？":92,"なんだ冬夏ちゃの知り合いにゃんか。":93,"珍しいにゃあ」":94,"「克杖がもう少し常識人だったら私も楽なんだけどね…":95,"えーとねまことさん、":96,"まずこの":97,"娘、彼女はまあ、\n私の処と…家ぐるみの付き合いがあって、\nこんな田舎だとほとんど親戚みたいなものだよ。":98,"狩":99,"屋":100,"克":101,"杖。":102,"同じ学校の後輩で一個下。":103,"中学からずっと陸上部」":104,"陸上競技という括りよりは、\n身体技能全般に秀でているらしい。":105,"しかも、\n喋りはこんなだが学業の方もそこそこだという。":106,"…やっぱり厭なキャラだな。":107,"人によってはコンプレックスを衝かれるタイプだろう。":108,"そして『よろしく』の挨拶一つも無いのなこいつは。":109,"「で、こっちが、\nまた家ぐるみの…あの公園の近くの土産屋あったでしょう。":110,"『":111,"嘉":112,"多":113,"里":114,"辺":115,"茶":116,"屋』。":117,"あそこ綾目という家なんだけど、そこの":118,"娘。":119,"綾":120,"目":121,"姫":122,"様。":123,"克杖とは同級生で３人姉妹。":124,"ちょっと訳有りで万年帰宅部。":125,"きぃから聞いてるかもだけど、\nまあ色々あって、\n最近はちょっとうちと出入りというか、行き来頻繁にあったりしたんだけど」":126,"…例の死人が出たという件か。":127,"そもそも最初に此処に来た時に、\n喪服の行列が――そこで冬夏を視たのだが――あったのは、\nそういう事なのか？":128,"きぃのバイト先の診療所の方も関係あるんだろうが。":129,"と、紹介を受けた彼女、\n綾目姫様…キサマって名前なんだな…ちゃんが、\nこっちへの視線を固定したまま会釈をした。":130,"なので三白眼でばりばりガン付けられてるみたいなんですが…":131,"「で、二人とも。":132,"こちらまことさん。":133,"旅行で此処に来たんだって。":134,"きぃ、貴奴は知ってるね？":135,"永久の処でバイトしてるあの――そう。":136,"の、幼馴染みで昔玄ノ森に居たことあるそうだけど」":137,"「…どうも初めまして、真言です。":138,"健忘症なものでね、あんまり覚えてないから、\n一旅行者として考えて貰って結構だよ」":139,"何気に卑屈になってしまう僕であったが、\nいかなアドレナリン大放出の最悪の出会い方でも、\n女子に囲まれるとこんなだ。":140,"宮さんの仕込みが効いてるねえ…":141,"単純に、こんなにも女子だらけという状況に馴れてない所為もあるが。":142,"三春の系列も飯窪も直系男子が殆ど居ないようだが、\nそれにしても実際ここまで女子にまみれることになるとは…":143,"と、またこの狩屋とかいう女子が毒づいた。":144,"「は。":145,"いかにもな顔してんにゃおまえ。":146,"ケンボーショーだなんて上等なもんじゃにぇーだろー。":147,"ただののーたりんめ」":148,"こいつ…":149,"にしても何だって僕にこうも楯突くんだこいつは。":150,"いちいち怒るのも馬鹿臭い（というか腕力で敵わない）ので、\n放置を決め込んでやる。へへーん。ガキめ。":151,"と思っていたら、\n冬夏が諫めるより早く、\nもう一人の女子がそいつ――狩屋の腕を掴んで振り向かせた。":152,"「克杖」":153,"「にゃあ？」":154,"「ちゃんと挨拶して」":155,"「え。":156,"こいつに？」":157,"「『こいつ』じゃない。":158,"真言さん」":159,"「うぇえーなんでよー。":160,"きーちゃおかしいにぇー今日ー。":161,"なんでこんな、や…つ……」":162,"「ひぁ」":163,"姫様ちゃんが狩屋をそれはそれは恐ろしい眼で睨んだ。":164,"声は小さいし哀願している…のかも知れないが、\n何か禍々しいオーラが視えそうでこわいですぼく…":165,"「う・あ…":166,"ごめ…」":167,"実際狩屋も異常な怯え方をし出している。":168,"他称暴力女子がここまでびびるとは、\n綾目ちゃん…":169,"まさかフィジカルで狩屋を上回ってるんじゃないだろうな…":170,"眼が怖いからにしては狩屋のこの反応、尋常じゃないぞ……":171,"「で・でもあ、そうそうもうあたし行っちゃうし？":172,"この場はさらばでおけーでだめ？にゃ？」":173,"「駄目です」":174,"「………や・やだなもー！？":175,"じょうだんだってば！":176,"ね！！":177,"真言おにーさん！":178,"よろしくしてくださいにゃん♪♪」":179,"思いっきり余所行き猫撫で声を出す狩屋。":180,"宮さんかお前は。":181,"にゃん♪♪":182,"とか止めい。":183,"冬夏も心なしか先刻から態度が冷ややかだぞ。":184,"ん？":185,"こいつら現れてからずっとかも。":186,"「まあ良いけどな…\nこっちもちょっとリミット外れてたし。":187,"よく分からないけどとにかくいろいろ悪かった、よろしく」":188,"三春の系列といざこざ起こしたらまずいのだ、\nということを今更ながら思い出し、\n実は僕の心中は非常に焦っていたのだった。":189,"血の気も引いてるし冷や汗モノだ、実際のところ。":190,"穏便に済ませそうで良かったよ。":191,"あぶねえあぶねえ…":192,"「許してください」":193,"「えあ…？":194,"なななにを？」":195,"「克杖が失礼しました」":196,"「う、うんそれは別に…":197,"君が謝ることでもない、ですし……」":198,"もう僕には争う気も毛頭ない、ですし……":199,"「私達を嫌わないでください」":200,"「にゃ！？":201,"きーちゃ？！」":202,"「あ、それはもう、勿論デスヨ？":203,"だからそんなに気にしないで…」":204,"「めんどくさいなー握手でもしたら？」":205,"やっぱりテンション低めの反応というか、\n放っておかれたせいか少々不機嫌そうな冬夏。":206,"姫様ちゃんの爆弾発言はスルーですか。":207,"…いや、どうやらほんとに上の空というか、\n興味無さげだし、聞き逃したもよう。":208,"それか、\n姫様ちゃんいつもそういう言動をする人かだな。":209,"「は？":210,"いえあ、でもにゃあ…":211,"うー、しょがない冬夏ちゃがいうならば…」":212,"狩屋は、冬夏と姫様ちゃんを気にしつつ困り顔で":213,"僕に手を出しかけて――":214,"「にゃう？」":215,"「うあ？」":216,"「克杖は男嫌いなんです」":217,"と、すごい勢いで僕と狩屋の間に入る姫様ちゃん。":218,"狩屋の方を視ずに喋ってますがほんとですかそれ。":219,"「きーちゃ、\nそこまでしにゃくても…」":220,"男嫌いて、だからって百合めいてる訳じゃないんだろうが…":221,"てかこいつ自身は握手しかけてたのに、\nこいつの台詞じゃないが何故姫様ちゃんが、\nそこまでして止めるだよ。":222,"貴女方二人が百合の仲だってことですか。":223,"あーだから僕に対して邪険だったのか狩屋。":224,"そんな妄念に襲われながらふと冬夏を視ると、\n姫様ちゃん達を視る眼が険しかった。":225,"面子を潰されたような状況だから仕方ないかもだが、\nひょっとして…":226,"――嫉妬か？":227,"なんてなー。":228,"………いや、いいです…":229,"「え・と、どうしよう冬夏ちゃ？」":230,"「ん？":231,"適当言っただけだから気にしなくていいよ」":232,"狩屋、板挟みか。":233,"三春の娘たる冬夏に気を遣うのは分かるが、\n姫様ちゃんとはやはり…":234,"リリーの仲ですか？":235,"結局ここまで否定してねえぞお前。":236,"にしても冬夏、ちと冷たすぎやしないか。":237,"まあ身近な人間が故のしがらみもあるだろうし、\n自発的に発生した友情でも無い限り、\n単なる家同士の繋がりなぞ煩わしい事のが多いしな。":238,"只でさえ冬夏は家とは仲が悪いそうだから、\n連なる他家の人間とも色々あるんだろうが。":239,"「えー、んっんー。":240,"じゃもういいですか。":241,"私はまことさんと寄るところあるから。":242,"君等はどうぞお先に。":243,"まことさん大丈夫ですか時間？」":244,"口調が、やや冷たく他人行儀になった冬夏が\nそう言ったのを契機に、":245,"各々が我に返ったような顔をする。":246,"寄る処あるなんて聞いてない…が、\n言外に何かを察して僕も黙っていた。":247,"目配せも何も、合図の類が一切無いだけに、\n恐らく真剣に何かを隠蔽していると思われ、\n茶化すのも躊躇われたからだ。":248,"「にゃ！":249,"わかりました！":250,"いこうきーちゃ。":251,"うちらも用事…あるしさー！♪」":252,"「また逢えますか？」":253,"「って、きーちゃぁ！":254,"にゃに言ってるーっ！！？":255,"そんなキャラ違うしょっ！！！」":256,"冬夏の言を聞いて、\n一旦緊張からの解放モードに入ったはずの狩屋が、\n姫様ちゃんに真っ向シカトされた上、\n彼女から僕に向かって発せられた微妙な台詞でまた混乱状態に。":257,"というか僕も混乱せざるを得ないぞそんな言い方されたら。":258,"ど、どういう意味でしょうカ…":259,"「え…っとぉう…":260,"まあしばらく滞在する予定だから、\nもしかしたらまた逢うこともあるか…もねぇ…？":261,"…そういうことじゃなくて？」":262,"「また逢えたら幸せです。":263,"お名残惜しいですが冬夏さんが…\nああ仰っておられるので。":264,"それでは。":265,"御身体お気をつけて」":266,"――うーん…":267,"輪を掛けて微妙なレス……":268,"何のつもりにゃのやら…":269,"冬夏に対しても微妙に当て付けてるように\n聞こえるしさ…":270,"「にゃおぅ？！":271,"ま・まってきーちゃ！！":272,"…あはは、\nじゃ、また冬夏ちゃ、と、":273,"真言…":274,"兄ぃ」":275,"言うだけ言って結局僕にとっては謎のまま、\nすたすた、というには若干猫背気味に、\nこの場から立ち去る姫様ちゃん。":276,"と、追う狩屋。":277,"こいつからの呼び名、真言兄ぃになるのか…":278,"今後も本当に彼女らに逢うことあればの話だけど。":279,"まあ、多分何度も逢うことになる気がするわ…":280,"いつもの勘てやつですか先生？\nはははそうだよ！":281,"閑話休題。":282,"…なんかよくわからないままにまた事態が進行していったが、\nまあ狩屋が百合女子だとしても、\nどうやら片想いぽいということは察せられた。":283,"そんなことが判明しても何にもならんな……":284,"呆然というよりも寧ろ半ば悄然と見送る僕であった。":285,"程なく狩屋と姫様ちゃんが視界から消える。":286,"僕と冬夏、二人だけになった途端、":287,"「（あのさまことさん）」":288,"がっ、と僕の肩を掴み、顔を寄せてひそひそ声で\n冬夏が囁いてきた。":289,"「（あの":290,"娘達の前では、\nその、例の件隠しといてね。":291,"あの娘ら、":292,"母様から言われて私のお目付役みたいな\nもんだからさ。":293,"私がおいたするとすぐチクるんだよ）」":294,"近いって近いって。":295,"飯後の、例の消臭兼ねた香水の芳香が鼻孔をくすぐる。":296,"宮さんはあんまりそういうのしないので、\n僕もその方面はまだ免疫が薄いのだった。":297,"ほんとに君等、\nもう少し男子との接触に抵抗持った方が…というか、\nなんていうの、出し惜しみしといた方が良いんじゃないか。":298,"「（特に姫様は鬼真面目で融通利かないから）」":299,"へえ…":300,"眼も怖かったしな…":301,"あの娘、最初はおどおどしてた印象だったが、\n何気に芯は強いようだったし、冬夏のいうのも真なのだろう。":302,"思いこみ激しそうなのがちょっとあれだけど。":303,"「（今日はちょっと態度おかしかった）」":304,"「（？）」":305,"更に声が小さくなったので良く聞き取れなかったが、\n思わず小声で聞き返した僕の疑問はスルーされた。":306,"まあ、伝えようとした事柄なら言い直すだろうし、\nどうでも良いことなんだろう。":307,"「（まことさんも眼付けられたみたいだし、\n気を付けた方がいいよ。あはは。":308,"精々殺されないようにね。":309,"女の情念蛇体と化すか、ああ恐ろしおそろし…）」":310,"そして冬夏は、\nやさぐれ気味ではあるが笑みも交えつつ囁く。":311,"どうやら彼女のテンション低下は、\n状況的に置いてけぼりだった所為でもなく、\n機嫌が悪かったというより、\n彼女らが苦手だったからのようだ。":312,"しかもお目付役ときたか。":313,"確かに計画の支障たり得る存在。":314,"彼女も神経質になってたという事だろうか。":315,"まあ、そうでなくてもあんな濃いキャラのコンビに\n近くをウロウロされたら大層疲れそうだけど…":316,"どっちにしろ、\nいつもの…とは言っても知り合って間もないし\nどんなのが常態かは分からないが、":317,"あっけらかんとした冬夏に戻って良かった。":318,"――ところで、":319,"もうそろそろ身体離してくれても結構ですよ？":320,"「さて、まあもう少しだけ、\nほんとに付き合ってくれる？":321,"時間、半端に余っちゃって。":322,"きぃももう行っちゃったし。":323,"歩きながら適当に会話でもしようよ」":324,"ようやく僕から離れ、通常の声のボリュウムで喋り出す。":325,"「ああうん。":326,"いいけど。":327,"二人だけの処なんか、\n人に視られて恥ずかしいとかはないの？」":328,"「勿論恥ずかしいから、\n人目に付かない場所選んで行く。":329,"あはははは！」":330,"怒んないでね、と付け加えられた。":331,"まあそれは構わないが、\n人気の無い処に二人切りで行くのもどうかと思う。":332,"余程警戒されてないんだな僕は。":333,"「これ、言わないでね」":334,"「ん？」":335,"そこで突然冬夏がトーンを下げた。":336,"@r":337,"「私あの娘きらいなんだ」":338},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_009.ks","relPath":"/data/scenario/SC_M_009.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":339,"length":339,"percent":100},"cellInfo":[null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],[null,{"t":"HU","v":1}],null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"t":"HU"}],[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1}],[null,{"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[48,0],"note":"已完成"},"/data/scenario/SC_M_010.ks":{"data":[["帰りは店を出た時点でバラバラになった。","回程时刚出店门，大家就各自分开了。"],["一人帰り途、血が下に降りてしまった空転脳味噌で\n思索が走る。","独自走在归途，因血液下行而空转的脑浆里\n思绪奔涌。"],["よくよく考えると、\n御神体の事を知ってる人間は、\n地元民ですらそうそういないという話じゃなかったか。","仔细想想，\n知道御神体存在的人，\n就连本地居民也没几个听说过吧？"],["こないだは深読みしたが、\n三春の蔵を見たがる人間は、御神体が目当てではない\nという事になるので、","上次可能想得太复杂了，\n那些想看三春家仓库的人，目标或许根本不是御神体\n这么看来，"],["冬夏の母親の、僕に対するあしらいが手慣れてたのも、\n常にそういう連中に晒されていたというよりも、\n単に本人の性格があんなだというだけかも知れない。","冬夏母亲对待我的熟稔态度，\n与其说是经常应付这类人，\n可能单纯只是她本人性格使然。"],["手慣れていたというよりも、過敏な反応というべきかも知れない。","或者说那并非游刃有余，而是过度敏感的反应。"],["もし後者ならば、\nまさにあの蔵がビンゴか或いは、","如果是后者的话，\n那个仓库说不定正中红心又或者，"],["…単に僕の先入観からそうみえたか。","…只是我的先入为主产生的错觉。"],["あとは宮さんの情報が本当でない場合かなあ。","再不然就是宫小姐的情报有误吧。"],["まさかわざわざ嘘を言ってるってことは…無いとは言い切れないが、\n可能性は低いだろう。","虽说应该不至于特地撒谎…但也不能完全排除，\n可能性很低就是了。"],["――まあ何を考えたところで、想像の域を出ることはないのだ。","――不过想得再多终究也只是臆测。"],["僕の主観しかそこにはない。","那里只是我的主观感受而已。"],["誰かの意見を聞いたわけでも勿論当人に聞いたわけでもない。","既没征求过他人意见，当然更没问过本人。"],["推論めいたことはしているが、根拠は薄弱すぎる。","虽然做着类似推理的事，但依据实在太薄弱。"],["考えることは大事だが、\n自分の脳内だけで結論出そうったって無理があるし切りがない。","思考固然重要，\n但光靠自己的脑内会议既不合理也没完没了。"],["結局、実際に動かないとどうにもならないのだ。","说到底不实际行动终究无济于事。"],["自分で管理掌握できる行動以外に関しては、\n何をしたって何を考えたって想像にすぎないんだし、\nなにがどうってもう腹もふくれてあたまがうごかないんです。","对于超出自己掌控范围的事情，\n无论做什么想什么都是空想，\n而且现在肚子撑得脑子都转不动了。"],["北の地とはいえ今日は小春日和、\n集合したときは多少まだ肌寒かったが今はもうそれなりの陽気。","虽说是北方之地今天却赶上了小阳春般暖和的天气，\n集合时还有些凉意现在却已相当温暖。"],["帰ったら昼寝したい程である。","让人想回去睡个午觉。"],["旅館が見えてきた。","旅馆已经映入眼帘。"],["――結局、誰にもまだ僕の名字を伝えてはいない。","――结果到现在还没告诉任何人我的姓氏。"],["大学からこっち、対人関係に於いてはむしろ\n名字しか知らない事の方が多くあるのだが、\n幸いその辺は特に気にされていないのだろうか、\n今のところ曖昧なままでも話は進んでいる。","自从上大学以来 在人际关系方面\n反倒更多是只知道姓氏的状态、\n所幸大家似乎并不特别在意这点、\n目前即使含糊其辞也能继续交流。"],["まあ、きぃがもし真に昔馴染みで、\n子供だった当時に僕の名字を知っており、かつ、\nその記憶を正確に保持している場合、\nこの予防線は全く無駄になるのだが。","不过 如果小贵真是真小时候的玩伴、\n孩童时期就知道我的姓氏 并且、\n至今还准确记得那段记忆的话、\n这番预防措施就完全白费了。」"],["しかして何故かきぃは、知狡さんの旅館『六母屋』を\n知っているにも関わらず、\n僕との関連性には気付いていないようだった。","然而不知为何小贵虽然知道知狡的旅馆『六母屋』，\n却似乎没有察觉到\n这与我之间的关联性。"],["敢えて言うこともないと黙っているのかも知れないが。","或者只是觉得没什么非要特意说的才保持沉默。"],["それとも記憶の変容か、欠落か。","又或者是记忆发生了扭曲，出现了缺失。"],["とは言っても下手にほじくり返すと藪蛇だし、\n冬夏の前で変なこと言い出さない事を祈ろう…","话虽如此随便深挖的话可能会自找麻烦，\n但愿别在冬夏面前说出什么奇怪的事吧…"],["さても今日はたまたま冬夏、\n狩屋達に紹介する際に僕の名字を知らない状況に関しては\nスルーしてくれた――いくらなんでも\n恣意的ではないだろう――が、","话说今天碰巧冬夏，\n在向狩屋他们介绍时没注意到我不知道姓氏的情况\n就这么放过去了――再怎么说\n也不该是故意的吧――不过，"],["部分的にでも本当の事を言うか、\n徹底的に嘘で塗り固めるかは検討しなければならないだろう。","是部分地说出真相，\n还是用彻头彻尾的谎言蒙混过去，必须好好考虑一下。"],["今晩会えれば宮さんにでも相談しとくか。忘れなければ。","今晚要是能见到宫小姐的话就找她商量下吧。如果没忘记的话。"],["今日は初対面が多くて疲れた…","今天初次见面的人太多好累…"],["しかも女子ばっかり何人も…","而且连续好几个都是女孩子…"],["だが、どうにも単純に喜べないのが、\n偶然なのか蓋然なのか、\nすべからく三春家に関わる者達だったということだ。","但不知为何就是没法单纯地高兴起来，\n不知是偶然还是必然，\n这些人全都与三春家有所牵连。"],["調査を進めるにあたり、これが吉と出るか凶と出るか。","在继续调查的过程中，这究竟会带来吉兆还是凶兆。"],["ああ、面倒なことは厭なんだけどなー。","啊啊，虽然我超讨厌麻烦事啊—。"],["嘘もあまり巧くないし僕は…","撒谎也不太擅长呢我…"],["旅館に着いた。","到达了旅馆。"],["「――そうか」","「――这样啊」"],["丁度知狡さんが居たので、\n早速事の成り行きを話した。","正好知狡阿姨在场，\n立刻把事情经过告诉了她。"],["「では明日にでも迎えを寄越させよう。","「那么就明天派人来接您吧。"],["ついさっき…母殿の知人が本家の家に来たから、\n私と、そのもう一人で案内する。","刚刚…母亲大人的熟人来到本家宅邸了，\n由我和那个熟人负责带路。"],["母殿、ああお前の祖母だな。","母亲大人，啊就是你的祖母。"],["都合で立ち会えないから」","因为事务安排无法到场」"],["「わかりました」","「明白了」"],["「あと、\nその三春の…人達、\nお前に何か妙な反応したりはなかったか？」","「另外，\n那些三春家的…人，\n对你有没有什么奇怪反应？」"],["「へ？」","「诶？」"],["初っ端から冬夏に、宮さんばりに逆セクハラされたとか、\nそういうくだりは秘しておいたので焦る。","从见面起就被冬夏像宫小姐那样反向性骚扰之类的发展，\n因为隐瞒了这种情节所以很慌。"],["姫様ちゃんの態度にしてもまあ自意識過剰を覚悟で言えば、","就算要说姫様酱的态度，虽然做好被说自作多情的觉悟，"],["何かしら好意は感じたけども…","确实能感觉到某种好意就是了…"],["本人がはっきり口にしたわけでもないし、\n第一知狡さんにわざわざ報告する事柄ではない。","本人也没有明确说出口，\n首先也不是需要特意向知狡阿姨汇报的事情。"],["と、思ったんだが。","虽然我是这么想的。"],["ピンポイントで質問されてしもうた。","结果被精准提问了。"],["「漫画かこれは、ってくらいモテモテ状態でした、","「简直像漫画情节一样受欢迎的状态，"],["とかそういう事ですか」","就是这类事情吗」"],["「ほう。","「哦。"],["そんな風だったか」","原来是这种状况吗」"],["や、また真面目に取られても…","啊、你又这么当真..."],["「成る程…」","「原来如此…」"],["あの、納得しないでくださーい。","那个、请不要就这样接受啊—。"],["「ん？","「嗯？"],["いや、\n彼女達も視る眼があると思ってな。","不、\n我觉得她们也是很有眼光的。"],["そうかそうか…」","这样啊这样啊…」"],["顔が笑ってないよ知狡さん。","你的脸可没在笑哦知狡阿姨。"],["なんで『やっぱり』みたいな表情なんです。","为什么露出『果然如此』的表情啊。"],["そもそも質問の意図は何だったのか。","说到底你提问的意图是什么。"],["「そろそろお前も年頃だしな…","「毕竟你也到年纪了…"],["一応訊いてみただけだ」","只是姑且问问罢了」"],["「そういうのは女子にして下さいよ…","「这种事请对女生做吧…"],["男子は３０からが勝負だって母さんも言ってます。","老妈都说男人三十才刚开始呢。"],["第一、母さん曰く、み…」","再说了，老妈说过，女…」"],["…いや、やめとこう。","…算了，还是不说了。"],["色んな意味で今ここでこの人相手に言うことではない。","从各种意义上现在都不该和这个人讨论这个。"],["「まさかお前、\n宮さんを狙ってるのか！？","「难道你小子\n在打宫小姐的主意！？"],["それはまた危険な…」","那可真是危险…」"],["折角途中で止めたのに、\n知狡さん空気読まずに超反応。","明明好不容易中途打住的，\n知狡阿姨完全不会看气氛超激动。"],["「や、や、ちょっとちが！」","「才、才不是那样！」"],["「","「"],["現","现"],["実、己が子に恐ろしい事を吹き込んだな…","实、你给孩子灌输了多可怕的思想啊…"],["真言、お前」","真言，你这家伙」"],["「や、だから戯れ言ですって！！","「所、所以说只是玩笑话啦！！"],["とにかく相手が誰だろうと、\n今積極的に女子とそういう関係性をどうこうという気は\nないです！！」","总之不管对方是谁，\n我现在完全没有要\n和女生发展那种关系的意思！！」"],["大神とかれお嬢の話が此処に来る直前あったが、\n別に羨ましくなどない！","虽然之前提到过大神和卡蕾欧小姐的事，\n但我才不羡慕呢！"],["誤解されても困るので述べておくが、\n勿論男子好きだからでもないし！","为避免误会先说清楚，\n当然也不是因为喜欢男人！"],["宮さんの逆セクハラの御陰で、\n残念ながらと言おうか、\nあまり女子との関係性に有難味が薄いというか？","托宫小姐反向性骚扰的福，\n该说遗憾还是什么，\n（我）和女性的关系可以说没什么值得庆幸的地方吧？"],["不自由してないっつーか？","或者说根本不缺女人？"],["もう受け身体質に仕込まれちゃってる？","已经被调教成被动体质了？"],["そうでなきゃ、冬夏にも姫様ちゃんにも、健全男子として\nもっと大反応…というと語弊があるな、\nえーとそう、貪欲に対応してただろう。","不然的话，对冬夏和姫様，作为健全男子\n应该会有更大反应…这么说可能不太准确，\n呃…那个，应该会更贪婪地回应才对。"],["狩屋はねえな。きぃは…微妙。","狩屋不算。小贵的话…有点微妙。"],["………なんてな。","………之类的。"],["あーもう、","啊真是的，"],["考えてたら虚しくなってきたわ…","越想越空虚了…"],["Ｍか僕は。","我该不会是M吧。"],["「宮さんの事はとにかくまあ、\n三春の面々に関しては、嫌われるよりは好いだろうな。","「宫小姐的事就先放一边，\n三春家那群人，总比被讨厌要强吧。"],["とは言え程々にな。深入りはするなよ」","不过也要适可而止。别陷太深」"],["だからいちいち深刻にならんで下さい。","所以别每件事都这么较真。"],["ただ実際、どうも最近、\n『積極接触大好き女子』との遭遇率が高すぎな感はあるんだ。","但确实最近总觉得\n遇到『超爱主动接触的女生』频率高得离谱。"],["最近というかこっち来てから、というべきか。","说是最近，不如说是来这边之后。"],["モテ期到来？","桃花运爆发？"],["宮さんはあんなですからカウントしませんよ。","宫小姐那种不算数的。"],["もう宮さんと逢ってから約一年、\nあの人は一次的接触こそしてこないが、\n言葉責めだの、妙なお預けだの、","和宫小姐相遇都一年了，\n那人虽然不会直接肢体接触，\n但又是言语挑逗又是吊人胃口，"],["只でさえ年齢その他正体が曖昧なのに\n間接的に迂遠な方法でメンタルから責めてくるからなあ。","本来年龄身份就够暧昧了\n还用各种迂回方式精神施压啊。"],["…そういう言葉遣うからＭな気分になるのか。","…就是因为这种说法才会觉得自己像M吧。"],["んなことはどうでもいい。","这种事怎样都无所谓。"],["さっきから変な思考ループに入ってるなあ。","从刚才开始思维就陷入奇怪循环了。"],["空腹な訳でもないのに脳空転か。","明明不饿却大脑空转。"],["「勿論ですよ。","「当然啦。"],["でも向こうから深入りしてきたらその限りじゃ\nないですけどね、なあんてアハハハハハ」","不过要是对方主动纠缠的话\n就另当别论啦，啊哈哈哈」"],["「…ああ、","「…啊啊，"],["その場合は、","那种情况下，"],["――どうしたものか……」","――该如何是好……」"],["「あう…","「啊呜…"],["冗談ですから……","开玩笑的啦……"],["ご心配なさらなくてもそんな甲斐性ないですから…","您放心我根本没那个胆子…"],["『彼女いない歴＝年齢』ですよ僕は…」","『单身年数=实际年龄』说的就是我…」"],["成るときは成る、という\n結局のところ面倒なのが嫌いな性格が災いしてか、\n告白したこともされたことも無い。","该成的时候自然会成，\n说到底或许是嫌麻烦的性格害了自己，\n既没告白过也没被告白过。"],["だからそういう意味では今の宮さんとの、\n精神的にせよ肉体的にせよ、この距離感は\n心地好いものではあるんだ。","所以从这个意义上来说，现在和宫小姐之间，\n无论是精神上还是肉体上，这种距离感\n确实让人很舒服。"],["一方的な感情だけれど。","虽然只是我单方面的感情。"],["それはともあれ、\nまあ彼女達の過剰なタッチングも、\n今時の女子の風潮なんじゃないの、と思ってるくらいだし、","总之，\n她们那些过度的肢体接触，\n我权当是如今女孩子的流行风气，"],["或いは、僕に危険性を感じてないからしているんだろうし、ま、そういう所見で言えば深入りされようも無いというものだ。","又或者是因为觉得我对她们没有危险性吧，嗯，从这个角度来看应该也不会发展得太深入。"],["…ちと悲しい推論だが。","…虽然这个推论有点可悲。"],["それとも宮さんを見てるからそう見えるのか。","还是说因为看着宫小姐才会这么想？"],["ちなみに飯窪","顺带一提饭洼"],["実とは母さんの名である。","现实是母亲的名字。"],["本家を出たとはいえ、我が家も婿を迎える形を採っており、\n姓は本家と同じく飯窪。","虽已离开本家，但我家也是招赘的形式，\n姓氏和本家一样是饭洼。"],["父さんの旧姓は聞いたことない。","父亲的旧姓从没听说过。"],["子供に何にもパーソナルデータ教えてくれなかったんだうちは。","我家父母压根没告诉过孩子任何个人信息。"],["両親共に誕生日、未だにはっきり知らないもんな。","连双亲的生日至今都不清楚呢。"],["「――そうか。","「――这样啊。"],["それ故にフラストレーションが…という場合も\nあるがそうでは無いんだな？","因此产生的挫败感…这种情况\n也是有的但并非如此吗？"],["それは、なによりだ…","那真是再好不过了…"],["それにしてもいや、だが…現実が」","不过话说回来…现实她」"],["そうこうしてる間に知狡さん、\n何とか納得してくれたようだが、\n母さんがどうかしましたか。","就在这期间知狡阿姨，\n总算被说服了的样子，\n母亲出什么事了吗。"],["「真言。","「真言。"],["私は――","我――"],["君の母さんが羨ましい」","很羡慕你母亲」"],["「は？","「哈？"],["母さんが？」","我母亲？」"],["「私は自分の価値観が信じられずに、\n他人が作った大きな流れにその責任を委ねた女だ。","「我是个无法相信自己价值观、\n只能将责任托付给他人造就的巨大洪流的女人（译注：其实就是随波逐流的意思）。"],["常に揺らぎ、自分以外の視線を気にして生きてきた」","总是摇摆不定，活在他人眼光里」"],["妹はまるで違った。","妹妹却完全不同。"],["お前を生んだのがあれというのも、\n今にして思えば当然だったのかも知れないな。","生下你的那个人，\n现在想来或许也是理所当然吧。"],["そう言った知狡さんの顔が、\n僕からは見えない。","说这话时知狡阿姨的表情，\n我看不见。"],["一体どうしたのか――","到底怎么了――"],["「ま、また何か変なモードに入ってますよ知狡さん。","「嘛、您又进入什么奇怪模式了知狡阿姨。"],["僕、置いてけぼり状態なんですが…」","我被晾在一边完全跟不上啊…」"],["「真言。お前には…","「真言。对你来说…"],["いや、それこそ他人がどうこう言う問題じゃないな。","不，这本来就不是外人能插嘴的事。"],["すまない。初日の時といい、\n――私の悪い癖だ。","抱歉。第一天那时也是，\n――这就是我的坏毛病。"],["許してくれ」","原谅我吧」"],["「ほ、ほんとですよ。","「真、真是的。"],["話振るだけ振っといて放置なんて、\n知狡さんも女子ですなあー。","开了话头就扔下不管，\n知狡阿姨也很有女生范儿呢～"],["あははは」","啊哈哈哈」"],["「初日の」","「第一天」"],["「はは…は、はい」","「哈…哈、是」"],["「あの橋の上での話を、\nもし思い出すことがあったら、\n必要なその時によく考えてみてほしい。","「关于那座桥上说的话，\n如果哪天想起来了，\n希望你在必要的时候好好思考。"],["それだけだ」","就这些」"],["じゃあ明日は宜しく頼む、\nと言って知狡さんはその場を去った。","那明天见，\n说完知狡阿姨便离开了。"],["…前からこういう人だったかなあ…","…她以前是这样的人来着吗…"],["どこまで真面目に受け取ったらいいのやら……","到底该认真听到什么程度才好……"],["宿から車を借りて、\nといっても例のハイヤーではなく、\n知狡さん（もしかして宮さん？）が\n用意させていたらしいやや古色ばんだ軽だが、","从旅馆借了辆车，\n虽说是车但并非那辆豪华轿车，\n知狡阿姨（或许是宫小姐？）\n准备的似乎是辆略显陈旧的轻型车，"],["道の確認も兼ねて、初日に行ったラーメン屋へ\n一人向かい、夕食を摂った。","顺带确认路线，朝着首日去过的拉面店\n独自前往，吃了晚饭。"],["アニソンの流れない車を運転するのも久々だ。","好久没开不播放动漫歌曲的车了。"],["昼飯があんな量だったので少々逡巡したのだが、\n今日は色々あったし、ちとエネルギー補充の要を\n感じたのです僕ぁ。","由于午饭吃了那么多量稍微有些犹豫，\n但今天发生了不少事，总觉得需要\n补充点能量啊我。"],["食が細るとメンタルにくるしな！","食欲不振会影响精神状态啊！"],["夜、宮さんに逢うかも知れないし。","晚上说不定能遇见宫小姐。"],["さて杉屋での僕の通例に準じて、\nまずメニューの中でも？な物を優先して注文。","那么按照我在杉屋的惯例，\n优先点菜单上标着问号的菜品。"],["初回は知狡さんのオススメを、\n言っちゃ悪いけど選ばざるを得なかったので、\nその時から気になってたこの\n『黒胡麻味噌チーズトマトラーメン』で行きます！","第一次来不得不选择\n虽然这么说不太好但知狡阿姨推荐的，\n所以这次就选从那时起就惦记着的\n『黑芝麻味增芝士番茄拉面』吧！"],["赤黒白い！","红黑白相间！"],["なんだこれ。","这啥玩意儿。"],["ネーミングもそのままじゃねえか。","连命名都这么直白。"],["素材羅列って。","纯粹是食材堆砌嘛。"],["僕はソロで外食は殆どしないが、\nその際も、待ち時間に店の暇本読んだりはしないのだ。","我几乎从不独自外出就餐，\n即便偶尔外食，等待时也不会看店里的闲书。"],["端から視ると頭抱えて悩んで見える様な姿勢で軽く寝てますよ。","用旁人看来就像抱着脑袋发愁的姿势小憩。"],["まあ瞑想？違うけど。","算是冥想？虽然不太准确。"],["自分の部屋だと飯時に本は必ず読みながらだが、\n余所ではしないのが信条。","在自己房间吃饭时必定边吃边看书，\n但在外绝不这么做是原则。"],["漫画など、途中から読んだり、食事終わったら中断して帰らねばならないのが耐えられないからだ。","因为无法忍受漫画读到中途，或是吃完饭就得中断剧情回家。"],["大抵は外食なんて大神と行くので、\n奴とのだべりで時間は過ぎる。","毕竟外出吃饭基本都是和大神一起，\n和那家伙闲扯就能打发时间。"],["という訳で今此処でも、\nメニューや、謎のチラシみたいな定期発行小冊子を熟読したり、\n半寝りしたりして待っていた。","所以现在在这里也是，\n要么细读菜单和谜之传单般的定期小册子，\n要么半睡半醒地等待。"],["入店した時はまだ疎らだった客が、\nその後時間帯もあって混んできたようで、\nやや待ち時間が掛かったがいよいよ品が来た。","进店时客人还寥寥无几，\n后来可能因为时段关系渐渐拥挤，\n稍等片刻后餐点终于上桌。"],["おおう赤黒白い！","呜哇红黑白相间！"],["臭いが微妙過ぎだ！！","这气味微妙过头了！！"],["じゃーいただきます！！！","那么——开动咯！！！"],["………。","………。"],["…まあ杉屋でもそうだけど、\n一見イロモノ風だけど、普通に食べられちゃうんだよな。","...不过杉屋也这样，\n看着像猎奇料理其实意外地能吃。"],["不味くもないが旨くも無い感じ？","不算难吃但也不美味的感觉？"],["単に素材が個々に味を主張しているが、即ち、\nハーモニーになってない替わりに不協和音でもない、","纯粹是各种食材在各自彰显味道，换句话说，\n虽未形成和谐共鸣但也不至于不协调，"],["各々を順番に口に入れればこうなるかな、と。","按顺序挨个品尝大概就是如此吧。"],["ある程度ネタのつもりでこっちも挑んでるんだが。","某种程度上我也是抱着尝鲜心态来的。"],["勝手な言い分で申し訳ないけども、やや肩透かしの感否めず。","虽然这么说很失礼，但确实有点扫兴。"],["金取る以上は店側も無茶できないんだろうけどなー。","毕竟店家收了钱也不敢太乱来吧。"],["かといって昼間のあの店みたく、\n単純に量があるだけの方がネタになるっていうのもどうだ。","不过像白天那家店那样，\n单纯靠分量博眼球也挺微妙。"],["ま、うーんなるほど、ということで。","嗯，原来如此，大概就这样。"],["ごちそうさまでした。","多谢款待。"],["また来ます。","还会再来的。"],["次は普通にメジャー所の品目で戴きたい。","下次要点常规热门菜品。"],["そっちは美味いんだから半端なメニューつくんなきゃいいのにな。","既然那些很好吃就别搞半吊子菜单嘛。"],["いや、試行錯誤し精進しようという意志や良しと視るべきかな。","不过或许该肯定他们勇于尝试精益求精的态度？"],["それとも、僕の味覚が変なのか。うーん。","还是说我的味觉有问题呢。唔。"],["帰り道、案の定というか、\n少々いや結構な時間、道に迷ってしまい、\n帰ってきたときは午後九時過ぎだった。","回程时不出所料，\n花了相当长时间迷路，\n回到旅馆已过晚上九点。"],["知狡さんも不在だったので、\n車のキーだけフロントに言って返却し、自販機で烏龍茶を買う。","知狡阿姨也不在，\n只把车钥匙交给前台归还，买了罐乌龙茶。"],["一応自分の部屋に戻る前に、宮さんの部屋の前まで行くことにする。","决定在回自己房间前，先去趟宫小姐门前。"],["わざわざ携帯で連絡するのもあれだし、\nそうした時点で逢う確約を取り付ける行為になってしまってる気がして気が引けたのだ。","特意用手机联系也有些那个，\n感觉这样一来就成了要约定见面的行为，反而让我有些退缩。"],["寝てたら起こす事にもなるし、\n居たら居たで、という程度のつもりで。","要是睡着了还得把人吵醒，\n就算醒着也顶多就是打个招呼的程度。"],["とは言え自分の部屋と違う方向に向かったということは、\n僕にとっては道すがらの行為では無くなってしまっている訳で、\n何だか無駄に緊張するな。","不过既然朝自己房间相反方向走，\n对我来说这已经不能算是顺路而为了，\n不知怎的莫名紧张起来了。"],["――着いてみると、\n今夜は宮さんはもう寝ていたのか、","――到达后发现，\n今晚宫小姐似乎已经睡了，"],["入り口には\n『就寝中』のプレートが下げてあり、\n中からも動く気配は無かった。","门口\n挂着『就寝中』的牌子，\n里面也没有任何动静。"],["このプレート手製だな…","这牌子是手工做的吧…"],["わざわざ何してるんだあの人は。","那人到底在瞎折腾什么啊。"],["どっちにしても先刻も考えた通り、\nこう意思表示されてる処を押してまで\n逢おうと思う程の理由も無ければ間柄でもなし、","无论如何正如刚才所想，\n既然对方都明确表示到这个份上，\n既没有非见不可的理由也不是那种关系，"],["宮さんといえども歴とした女子、\n本人はああ言ってたが、そうそう夜に足繁く部屋に通う訳にもいかない。","虽说宫小姐也是正经女孩子，\n尽管她本人那么说，但总在晚上频繁去她房间也不合适。"],["先刻考えてた相談事は後にしよ。覚えてたら。","之前考虑的商量事项还是改天吧。如果还记得的话。"],["まあどっちにしろ今夜は僕の独り相撲、肩透かしで済んだようだ。","总之今晚算是白紧张一场，扑了个空。"],["部屋に戻ることにする。","决定回自己房间。"],["「………（おやすみ、なさい、っと）」","「………（晚安，吧，嗯）」"],["この所、目の前にずっと居たせいで、\nちょっと会えないだけでなんというかこう、\n変な喪失感…いやいや、そんな大げさなもんじゃない、ちょっと、","最近因为一直待在眼前的缘故，\n只是稍微见不到就莫名觉得，\n有种奇怪的失落感…不不没这么夸张，只是，"],["ちょっとだけだ、","只是有一点点，"],["寂しい気がしたものだから。","觉得寂寞而已。"],["入り口の前で、小さくおやすみの挨拶だけして、\n自分の部屋に戻った。","在房门前小声说完晚安，\n便回到了自己房间。"],["…なんだろうな、この感じは。","…这种心情究竟是怎么回事。"],["先刻の知狡さんとの会話で変に意識したり、\n昼間テンション上がってた反動もあるんだろうけど。","既有刚才和知狡阿姨对话后产生的微妙意识，\n也有白天情绪高涨后的反作用吧。"],["いかんいかん、ちょっと気を抜くと切ねえ気分に襲われる。","不行不行，稍不留神就会被忧郁情绪袭击。"],["いわば『吊り橋の出会い』とでも言おうか、\n身体状況と精神状態のリンクのすり替えとでも言おうか、","该说是『吊桥效应』呢，\n还是该说身体状况和精神状态的错位呢，"],["要するに勘違いだとしても、\n今から寝ようってときにこういう気分は非常に、\nなんかなあ。","总之就算是错觉，\n在即将入睡时产生这种心情实在是非常，\n该怎么说呢。"],["落ち着かないなあ。","静不下心来啊。"],["と、部屋に戻って電気をつけた瞬間、","正当我回到房间开灯的瞬间，"],["携帯が着信振動し死ぬほど焦る。","手机来电震动吓得我半死。"],["メールきた。…宮さんから。","来邮件了。…宫小姐发的。"],["タイミング良すぎだろ、\nと思って件名見ると、","这时机也太巧了吧，\n正想着看向邮件标题，"],["『おやすみ、先に寝ちゃってごめんね♪』","『晚安，我先睡了对不起哦♪』"],["だと。","这么写着。"],["メールしてきてる時点で寝てねーんじゃねえか、\nというツッコミも忘れ、\nあーもう嬉しがってんじゃないよ僕。","既然能发邮件不就说明根本没睡吗，\n连吐槽都忘了，\n啊—我可没有在暗自高兴啊。"],["く、くそう。","可、可恶。"],["なんか見透かされた感じが嫌だ。","这种被看穿的感觉真讨厌。"],["てか気付いてたな宮さん？","话说宫小姐你早就发现了吧？"],["それともどっかからか見てるのか？","还是从哪儿偷看着呢？"],["こええな、僕の居ない間にカメラとか仕掛けたんじゃないだろうな…","好可怕，该不会趁我不在装了摄像头吧…"],["しかもなんか画像も付けてきよった…","居然还附了张图片…"],["ぐ、それは見ないでおいてやる！","呜、这张我才不看呢！"],["ともあれ寝ます！","总之睡觉！"],["幸か不幸か変なモヤモヤ感は吹っ飛びましたので！","所幸不幸的是那些乱七八糟的情绪都飞走了！"],["あー今日はもう一日中、最後まで女子に振り回されて終了だよ。","啊—今天一整天到最后都被女孩子耍得团团转呢。"],["なんだって女子てのはこうなんだろうな。","为什么女孩子都是这样啊。"],["男子は弱いねえ…","男人真是弱啊…"],["己を顧みて一頻り嘆いたところで。","自我反省地感叹了一番后。"],["明日も用事出来たことだし、いざ就寝！","反正明天也有事要做，这就睡觉！"],["お疲れ！！","辛苦啦！！"]],"context":[["SC_M_010.ks/index/1/text"],["SC_M_010.ks/index/3/text"],["SC_M_010.ks/index/5/text"],["SC_M_010.ks/index/7/text"],["SC_M_010.ks/index/9/text"],["SC_M_010.ks/index/11/text"],["SC_M_010.ks/index/13/text"],["SC_M_010.ks/index/15/text"],["SC_M_010.ks/index/17/text"],["SC_M_010.ks/index/19/text"],["SC_M_010.ks/index/21/text"],["SC_M_010.ks/index/23/text"],["SC_M_010.ks/index/25/text"],["SC_M_010.ks/index/27/text"],["SC_M_010.ks/index/29/text"],["SC_M_010.ks/index/31/text"],["SC_M_010.ks/index/33/text"],["SC_M_010.ks/index/35/text"],["SC_M_010.ks/index/37/text"],["SC_M_010.ks/index/39/text"],["SC_M_010.ks/index/41/text"],["SC_M_010.ks/index/43/text"],["SC_M_010.ks/index/45/text"],["SC_M_010.ks/index/47/text"],["SC_M_010.ks/index/49/text"],["SC_M_010.ks/index/51/text"],["SC_M_010.ks/index/53/text"],["SC_M_010.ks/index/55/text"],["SC_M_010.ks/index/57/text"],["SC_M_010.ks/index/59/text"],["SC_M_010.ks/index/61/text"],["SC_M_010.ks/index/63/text"],["SC_M_010.ks/index/65/text"],["SC_M_010.ks/index/67/text"],["SC_M_010.ks/index/69/text"],["SC_M_010.ks/index/71/text"],["SC_M_010.ks/index/73/text"],["SC_M_010.ks/index/75/text"],["SC_M_010.ks/index/77/text"],["SC_M_010.ks/index/79/text"],["SC_M_010.ks/index/81/text"],["SC_M_010.ks/index/83/text"],["SC_M_010.ks/index/85/text"],["SC_M_010.ks/index/87/text"],["SC_M_010.ks/index/89/text"],["SC_M_010.ks/index/91/text"],["SC_M_010.ks/index/93/text"],["SC_M_010.ks/index/95/text"],["SC_M_010.ks/index/97/text"],["SC_M_010.ks/index/99/text"],["SC_M_010.ks/index/101/text"],["SC_M_010.ks/index/103/text"],["SC_M_010.ks/index/105/text"],["SC_M_010.ks/index/107/text"],["SC_M_010.ks/index/109/text"],["SC_M_010.ks/index/111/text"],["SC_M_010.ks/index/113/text"],["SC_M_010.ks/index/115/text"],["SC_M_010.ks/index/117/text"],["SC_M_010.ks/index/119/text"],["SC_M_010.ks/index/121/text"],["SC_M_010.ks/index/123/text"],["SC_M_010.ks/index/125/text"],["SC_M_010.ks/index/127/text"],["SC_M_010.ks/index/129/text"],["SC_M_010.ks/index/131/text"],["SC_M_010.ks/index/133/text"],["SC_M_010.ks/index/135/text"],["SC_M_010.ks/index/137/text"],["SC_M_010.ks/index/139/text"],["SC_M_010.ks/index/141/text"],["SC_M_010.ks/index/143/text"],["SC_M_010.ks/index/145/text"],["SC_M_010.ks/index/147/text"],["SC_M_010.ks/index/149/text"],["SC_M_010.ks/index/151/text"],["SC_M_010.ks/index/153/text"],["SC_M_010.ks/index/155/text","SC_M_010.ks/index/247/text"],["SC_M_010.ks/index/157/text"],["SC_M_010.ks/index/159/text"],["SC_M_010.ks/index/161/text"],["SC_M_010.ks/index/163/text"],["SC_M_010.ks/index/165/text"],["SC_M_010.ks/index/167/text"],["SC_M_010.ks/index/169/text"],["SC_M_010.ks/index/171/text"],["SC_M_010.ks/index/173/text"],["SC_M_010.ks/index/175/text"],["SC_M_010.ks/index/177/text"],["SC_M_010.ks/index/179/text"],["SC_M_010.ks/index/181/text"],["SC_M_010.ks/index/183/text"],["SC_M_010.ks/index/185/text"],["SC_M_010.ks/index/187/text"],["SC_M_010.ks/index/189/text"],["SC_M_010.ks/index/191/text"],["SC_M_010.ks/index/193/text"],["SC_M_010.ks/index/195/text"],["SC_M_010.ks/index/197/text"],["SC_M_010.ks/index/199/text"],["SC_M_010.ks/index/201/text"],["SC_M_010.ks/index/203/text"],["SC_M_010.ks/index/205/text"],["SC_M_010.ks/index/207/text"],["SC_M_010.ks/index/209/text"],["SC_M_010.ks/index/211/text"],["SC_M_010.ks/index/213/text"],["SC_M_010.ks/index/215/text"],["SC_M_010.ks/index/217/text"],["SC_M_010.ks/index/219/text"],["SC_M_010.ks/index/221/text"],["SC_M_010.ks/index/223/text"],["SC_M_010.ks/index/225/text"],["SC_M_010.ks/index/227/text"],["SC_M_010.ks/index/229/text"],["SC_M_010.ks/index/231/text"],["SC_M_010.ks/index/233/text"],["SC_M_010.ks/index/235/text"],["SC_M_010.ks/index/237/text"],["SC_M_010.ks/index/239/text"],["SC_M_010.ks/index/241/text"],["SC_M_010.ks/index/243/text"],["SC_M_010.ks/index/245/text"],["SC_M_010.ks/index/249/text"],["SC_M_010.ks/index/251/text"],["SC_M_010.ks/index/253/text"],["SC_M_010.ks/index/255/text"],["SC_M_010.ks/index/257/text"],["SC_M_010.ks/index/259/text"],["SC_M_010.ks/index/261/text"],["SC_M_010.ks/index/263/text"],["SC_M_010.ks/index/265/text"],["SC_M_010.ks/index/267/text"],["SC_M_010.ks/index/269/text"],["SC_M_010.ks/index/271/text"],["SC_M_010.ks/index/273/text"],["SC_M_010.ks/index/275/text"],["SC_M_010.ks/index/277/text"],["SC_M_010.ks/index/279/text"],["SC_M_010.ks/index/281/text"],["SC_M_010.ks/index/283/text"],["SC_M_010.ks/index/285/text"],["SC_M_010.ks/index/287/text"],["SC_M_010.ks/index/289/text"],["SC_M_010.ks/index/291/text"],["SC_M_010.ks/index/293/text"],["SC_M_010.ks/index/295/text"],["SC_M_010.ks/index/297/text"],["SC_M_010.ks/index/299/text"],["SC_M_010.ks/index/301/text"],["SC_M_010.ks/index/303/text"],["SC_M_010.ks/index/305/text"],["SC_M_010.ks/index/307/text"],["SC_M_010.ks/index/309/text"],["SC_M_010.ks/index/311/text"],["SC_M_010.ks/index/313/text"],["SC_M_010.ks/index/315/text"],["SC_M_010.ks/index/317/text"],["SC_M_010.ks/index/319/text"],["SC_M_010.ks/index/321/text"],["SC_M_010.ks/index/323/text"],["SC_M_010.ks/index/325/text"],["SC_M_010.ks/index/327/text"],["SC_M_010.ks/index/329/text"],["SC_M_010.ks/index/331/text"],["SC_M_010.ks/index/333/text"],["SC_M_010.ks/index/335/text"],["SC_M_010.ks/index/337/text"],["SC_M_010.ks/index/339/text"],["SC_M_010.ks/index/341/text"],["SC_M_010.ks/index/343/text"],["SC_M_010.ks/index/345/text"],["SC_M_010.ks/index/347/text"],["SC_M_010.ks/index/349/text"],["SC_M_010.ks/index/351/text"],["SC_M_010.ks/index/353/text"],["SC_M_010.ks/index/355/text"],["SC_M_010.ks/index/357/text"],["SC_M_010.ks/index/359/text"],["SC_M_010.ks/index/361/text"],["SC_M_010.ks/index/363/text"],["SC_M_010.ks/index/365/text"],["SC_M_010.ks/index/367/text"],["SC_M_010.ks/index/369/text","SC_M_010.ks/index/371/text"],["SC_M_010.ks/index/373/text"],["SC_M_010.ks/index/375/text"],["SC_M_010.ks/index/377/text"],["SC_M_010.ks/index/379/text"],["SC_M_010.ks/index/381/text"],["SC_M_010.ks/index/383/text"],["SC_M_010.ks/index/385/text"],["SC_M_010.ks/index/387/text"],["SC_M_010.ks/index/389/text"],["SC_M_010.ks/index/391/text"],["SC_M_010.ks/index/393/text"],["SC_M_010.ks/index/395/text"],["SC_M_010.ks/index/397/text"],["SC_M_010.ks/index/399/text"],["SC_M_010.ks/index/401/text"],["SC_M_010.ks/index/403/text"],["SC_M_010.ks/index/405/text"],["SC_M_010.ks/index/407/text"],["SC_M_010.ks/index/409/text"],["SC_M_010.ks/index/411/text"],["SC_M_010.ks/index/413/text"],["SC_M_010.ks/index/415/text"],["SC_M_010.ks/index/417/text"],["SC_M_010.ks/index/419/text"],["SC_M_010.ks/index/421/text"],["SC_M_010.ks/index/423/text"],["SC_M_010.ks/index/425/text"],["SC_M_010.ks/index/427/text"],["SC_M_010.ks/index/429/text"],["SC_M_010.ks/index/431/text"],["SC_M_010.ks/index/433/text"],["SC_M_010.ks/index/435/text"],["SC_M_010.ks/index/437/text"],["SC_M_010.ks/index/439/text"],["SC_M_010.ks/index/441/text"],["SC_M_010.ks/index/443/text"],["SC_M_010.ks/index/445/text"],["SC_M_010.ks/index/447/text"],["SC_M_010.ks/index/449/text"],["SC_M_010.ks/index/451/text"],["SC_M_010.ks/index/453/text"],["SC_M_010.ks/index/455/text"],["SC_M_010.ks/index/457/text"],["SC_M_010.ks/index/459/text"],["SC_M_010.ks/index/461/text"],["SC_M_010.ks/index/463/text"],["SC_M_010.ks/index/465/text"],["SC_M_010.ks/index/467/text"],["SC_M_010.ks/index/469/text"],["SC_M_010.ks/index/471/text"],["SC_M_010.ks/index/473/text"],["SC_M_010.ks/index/475/text"],["SC_M_010.ks/index/477/text"],["SC_M_010.ks/index/479/text"],["SC_M_010.ks/index/481/text"],["SC_M_010.ks/index/483/text"],["SC_M_010.ks/index/485/text"],["SC_M_010.ks/index/487/text"],["SC_M_010.ks/index/489/text"],["SC_M_010.ks/index/491/text"],["SC_M_010.ks/index/493/text"],["SC_M_010.ks/index/495/text"],["SC_M_010.ks/index/497/text"]],"tags":[],"parameters":[[{"start":147,"end":166}],[{"start":172,"end":206}],[{"start":224,"end":282}],[{"start":296,"end":352}],[{"start":366,"end":447}],[{"start":461,"end":491}],[{"start":497,"end":525}],[{"start":531,"end":548}],[{"start":562,"end":583}],[{"start":589,"end":635}],[{"start":649,"end":678}],[{"start":684,"end":697}],[{"start":703,"end":731}],[{"start":737,"end":760}],[{"start":774,"end":819}],[{"start":825,"end":847}],[{"start":861,"end":943}],[{"start":957,"end":1006}],[{"start":1012,"end":1026}],[{"start":1076,"end":1085}],[{"start":1103,"end":1126}],[{"start":1140,"end":1237}],[{"start":1251,"end":1338}],[{"start":1352,"end":1419}],[{"start":1433,"end":1458}],[{"start":1464,"end":1479}],[{"start":1493,"end":1540}],[{"start":1554,"end":1639}],[{"start":1653,"end":1701}],[{"start":1707,"end":1733}],[{"start":174