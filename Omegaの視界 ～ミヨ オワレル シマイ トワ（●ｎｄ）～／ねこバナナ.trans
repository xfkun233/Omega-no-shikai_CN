ndex/266/text"],["SC_M_001.ks/index/268/text"],["SC_M_001.ks/index/270/text"],["SC_M_001.ks/index/272/text"],["SC_M_001.ks/index/274/text"],["SC_M_001.ks/index/276/text"],["SC_M_001.ks/index/278/text"],["SC_M_001.ks/index/280/text"],["SC_M_001.ks/index/282/text"],["SC_M_001.ks/index/284/text"],["SC_M_001.ks/index/286/text"],["SC_M_001.ks/index/288/text"],["SC_M_001.ks/index/290/text"],["SC_M_001.ks/index/292/text"],["SC_M_001.ks/index/294/text"],["SC_M_001.ks/index/296/text"],["SC_M_001.ks/index/298/text"],["SC_M_001.ks/index/300/text"],["SC_M_001.ks/index/302/text"],["SC_M_001.ks/index/304/text"],["SC_M_001.ks/index/306/text"],["SC_M_001.ks/index/308/text"]],"tags":[],"parameters":[[{"start":128,"end":143}],[{"start":177,"end":190}],[{"start":206,"end":262}],[{"start":302,"end":325}],[{"start":359,"end":367}],[{"start":400,"end":439}],[{"start":479,"end":517}],[{"start":592,"end":645}],[{"start":685,"end":703}],[{"start":778,"end":801}],[{"start":835,"end":909}],[{"start":991,"end":1004}],[{"start":1044,"end":1061}],[{"start":1094,"end":1109}],[{"start":1143,"end":1233}],[{"start":1298,"end":1321}],[{"start":1361,"end":1416}],[{"start":1520,"end":1575}],[{"start":1693,"end":1712}],[{"start":1746,"end":1768}],[{"start":1784,"end":1894}],[{"start":1910,"end":2001}],[{"start":2017,"end":2077}],[{"start":2093,"end":2160}],[{"start":2176,"end":2210}],[{"start":2226,"end":2293}],[{"start":2368,"end":2422}],[{"start":2492,"end":2511}],[{"start":2586,"end":2622}],[{"start":2657,"end":2677}],[{"start":2751,"end":2789}],[{"start":2805,"end":2850}],[{"start":2866,"end":2915}],[{"start":2931,"end":2987}],[{"start":3003,"end":3042}],[{"start":3058,"end":3117}],[{"start":3133,"end":3223}],[{"start":3239,"end":3286}],[{"start":3326,"end":3362}],[{"start":3437,"end":3549}],[{"start":3583,"end":3652}],[{"start":3668,"end":3707}],[{"start":3747,"end":3781}],[{"start":3797,"end":3840}],[{"start":3915,"end":3987}],[{"start":4003,"end":4065}],[{"start":4081,"end":4172}],[{"start":4212,"end":4260}],[{"start":4335,"end":4429}],[{"start":4463,"end":4493}],[{"start":4533,"end":4596}],[{"start":4630,"end":4656}],[{"start":4731,"end":4796}],[{"start":4830,"end":4907}],[{"start":4921,"end":4947}],[{"start":5049,"end":5117}],[{"start":5151,"end":5169}],[{"start":5242,"end":5274}],[{"start":5290,"end":5326}],[{"start":5342,"end":5376}],[{"start":5416,"end":5485}],[{"start":5519,"end":5586}],[{"start":5659,"end":5696}],[{"start":5739,"end":5779}],[{"start":5812,"end":5827}],[{"start":5861,"end":5898}],[{"start":5914,"end":5981}],[{"start":6021,"end":6082}],[{"start":6116,"end":6170}],[{"start":6245,"end":6278}],[{"start":6294,"end":6344}],[{"start":6417,"end":6464}],[{"start":6539,"end":6610}],[{"start":6683,"end":6750}],[{"start":6786,"end":6837}],[{"start":6853,"end":6919}],[{"start":6959,"end":7025}],[{"start":7039,"end":7061}],[{"start":7168,"end":7272}],[{"start":7288,"end":7372}],[{"start":7388,"end":7478}],[{"start":7494,"end":7549}],[{"start":7565,"end":7616}],[{"start":7632,"end":7674}],[{"start":7738,"end":7771}],[{"start":7814,"end":7857}],[{"start":7891,"end":7926}],[{"start":7942,"end":8002}],[{"start":8018,"end":8112}],[{"start":8152,"end":8205}],[{"start":8276,"end":8343}],[{"start":8407,"end":8476}],[{"start":8510,"end":8538}],[{"start":8554,"end":8615}],[{"start":8631,"end":8655}],[{"start":8723,"end":8779}],[{"start":8846,"end":8914}],[{"start":8985,"end":9055}],[{"start":9071,"end":9122}],[{"start":9162,"end":9230}],[{"start":9301,"end":9339}],[{"start":9403,"end":9424}],[{"start":9481,"end":9486}],[{"start":9502,"end":9559}],[{"start":9575,"end":9641}],[{"start":9657,"end":9710}],[{"start":9726,"end":9756}],[{"start":9813,"end":9869}],[{"start":9885,"end":9953}],[{"start":9969,"end":10044}],[{"start":10060,"end":10142}],[{"start":10158,"end":10237}],[{"start":10277,"end":10321}],[{"start":10337,"end":10391}],[{"start":10407,"end":10448}],[{"start":10464,"end":10536}],[{"start":10552,"end":10629}],[{"start":10645,"end":10680}],[{"start":10787,"end":10815}],[{"start":10890,"end":10958}],[{"start":11031,"end":11107}],[{"start":11141,"end":11195}],[{"start":11211,"end":11275}],[{"start":11291,"end":11369}],[{"start":11385,"end":11427}],[{"start":11443,"end":11529}],[{"start":11665,"end":11742}],[{"start":11780,"end":11810}],[{"start":11844,"end":11892}],[{"start":11908,"end":11959}],[{"start":11975,"end":12085}],[{"start":12101,"end":12151}],[{"start":12167,"end":12249}],[{"start":12396,"end":12530}],[{"start":12569,"end":12687}],[{"start":12727,"end":12779}],[{"start":12817,"end":12868}],[{"start":12902,"end":12993}],[{"start":13009,"end":13023}],[{"start":13063,"end":13103}],[{"start":13176,"end":13198}],[{"start":13273,"end":13325}],[{"start":13341,"end":13383}],[{"start":13423,"end":13437}],[{"start":13471,"end":13556}],[{"start":13594,"end":13605}],[{"start":13639,"end":13649}],[{"start":13689,"end":13694}],[{"start":13728,"end":13762}],[{"start":13778,"end":13856}],[{"start":13941,"end":13967}],[{"start":13983,"end":14087}],[{"start":14189,"end":14240}],[{"start":14256,"end":14373}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_001.ks","basename":"SC_M_001.ks","indexIds":{"「すみませんーっ。あのぉーっ」":0,"顔を見合わせる僕と宮さん。":1,"コンコン。[l]\nその人物―――声からすると女性のようだ―――は、\n再び入り口の引き戸を叩いた。":2,"「…誰すかね。宮さん、知り合い来る予定でも？」":3,"それともまさか。":4,"「もう閉まっちゃいましたぁーっ？[l]\n店長ーっ。　居ませんかぁーっ」":5,"「ちょ、ちょっと、宮さん。[l]\nなんかお客さんっぽいんですけど！」":6,"「んむー？[l]\nなんでお客なんか来るんですかねぇ？[l]\nあーもう店仕舞でご飯なのに…」":7,"「と、と、とりあえず僕出てきますね」":8,"「…んー？　あっ！　まこくん待ってください！」":9,"入り口の引き戸を開けると、\nそこには僕と同じくらいの年格好にして背丈を持った女性が、\n手をグーに振りかざしながら声をあげ続けていた。":10,"「私ぃーっ、ＷＣぃー……」":11,"「お待たせし…は？　だぶりゅー？」":12,"「…い？　あっ……？　はっ！」":13,"互いに目が合い、一瞬間が空いた。[l]\n客なのだから見知らぬ人間なのは当然なんだが、\n耳に入った言葉があまりに意表をついたものだったせいだ。[l]\nきっと。":14,"「あ、あのぉ、お手洗いをー、お借りしたくてっ」":15,"「あ、あ？　ああ、お手洗い、お手洗いのＷＣね。[l]\nええーと少々お待ち下さいよ、\n宮さん！」":16,"「もうっ、聞こえてましたっ。[l]\nお客様、いらっしゃいませ。[l]\nお手洗いは、外のその…」":17,"「あーっ、お久しぶりですミーぃ店長！」":18,"奥から宮さんが靴を履きながら出てきたとたん、":19,"そのお客は、宮さんを指さし、そして持っていたでかい旅行用トランクをがったんと落としながら両手を組み、顔の左右にぶんぶん振り回した後、駆け寄ったかと思いきや手を握りしめながらぐいんぐいんと宮さんの手を一緒に上下させた。":20,"なんでいちいち描写しているかというと、\n彼女のその一連が、まるで漫画やドラマのベタを地でいくような\nまさしくテンプレ、定型文のごとくあまりにわざとらしく見えたからだ。":21,"ちょっと白々しいが、印象としてはまあ『面白女子』と言って差し支え無しか。[l]\n服装もちょっとばかり突飛系だし。":22,"フェイスペイント？とでもいうのか？をしていて…[l]おそらくタトゥーではないだろうが、大学でも芸専あたりには居そうな感じの女性だ。":23,"や、あくまでも、ファッション音痴の僕のへぼ引き出しの中での話だけど。":24,"いや、しかし初対面相手にいきなりそこまで思う僕もあれだな…ちょっと疲れてるのかな…[l]\nうーん、飯前だからだろうと思いたい。":25,"「…っとやっぱり。[l]\n相変わらず考え無しですね、\n直しなさいと言ったでしょう？　かれお」":26,"「はあ…、大変に、…ソーリーです……」":27,"「…まあ良いです。[l]\nはやくＷＣに行くが良いですよ。ＷＣに」":28,"「ううっ…、ではお借りいたしますぅーっ」":29,"ぼーっと思索に入っていた僕を余所に、\n二人の話は進行していたようだ。":30,"それにしても宮さんの知り合いには悪いが、\n漫画に出てくる似非外国人みたいな人だな…":31,"さっきからの印象として面白要素とは別に、\n何かのステロタイプ、作り物みたいな行動に感じる。":32,"あまり今までの友人知人には居なかったタイプではあるが、\n世に全く居ないという訳でもないし、気にしすぎか。":33,"どうもあれだ、空腹の所為か変な方向に思考が飛ぶ。[l]\nいかんいかん。":34,"あ、今にして思えば、不可抗力だったとは言え、\n妙齢の女子にあのような事を言わせたのはちょっと無遠慮だったかも。":35,"咄嗟のことだったが、男子に対してなかなか言い難い事項だったろうに。[l]\n昔それで大変に気まずい思いをした（宮さんではない、念のため）僕としてはちょっとばかり心が重い。":36,"とはいえ今回は僕がどうこう出来た事ではないし、\nとりあえず宮さんに色々訊くことにした。":37,"「なんだ、結局知り合いじゃないですか。[l]\n近所の人ですか？」":38,"「いえ、全然遠くです。[l]\nと、いうより、いっつもふらふらしてて、\n一カ所に定住しないんですよ。[l]\nここ十数年近くは会ってもいなかったんです。[l]\n日本に居ない事もしょっちゅうですし」":39,"あの喋りはそれでか？[l]\nさっきから感じていたのはそのせいなのか？[l]\nいやしかし、あれはあまりにキャラっぽくないか？":40,"コントか漫画でしか見たことないぞ。[l]\n日本人が考える外国人じゃん…":41,"「ふーん…[l]\nでも何か用があって来たんじゃないんですか？":42,"まさか本当に、偶然トイレ借りに来た家がここだった、\nってわけじゃないでしょう」":43,"「かれおはもう呆れる程ゆるゆるなんです。[l]\n昔っから無思慮無計画、困った女子ですね。[l]\nだから全国放浪したりするんです。":44,"２、３日前から得体の知れない番号から何度も電話が\n掛かってきてですね、おそるおそる出てみたら\nかれおでした。":45,"前聞いた番号と全然違うから分からなかったですよ。[l]\nその時も『そのうち行く』としか聞いてないですし、\nまさか今日来るなんて、全くもう…準備も何もしてないですよ…」":46,"「はあ…よく分かりませんが大変ですなあ……[l]\nああ、というか飯、飯どうしましょう？」":47,"「しょうがないので連れて行きたいんですが\n駄目ですか？[l]\nかれおの用件は道行きで聞きます。[l]\nまずはカレーが最優先！[l]\nかれおよりカレーです！」":48,"え、ギャグなのか？[l]\nわ、笑った方が良いのかな…":49,"「まあ、そのかれおさん？　かれおさんが良いというなら僕は気にしませんが…[l]\n何で来たんだろ？　バス？　タクシー？」":50,"とりあえず笑いはスルーだ。無難な話題に振り替えよう。":51,"「どうせ泊まる気で来てますから、\n帰りの事は気にしなくていいです。[l]\nそうかー、禅に準備させとかなきゃだなー」":52,"そこに、かれお嬢が持参のでかいトランクを持ち直して戻ってきた。[l]\nキャリー形式でないようだが、つまり車移動時以外は持ち運んで来たということだ。":53,"背もあるし、結構、力あるんだな…と何となしに思った。":54,"「ふーっ、どうも、さ、さんくすでした。[l]\nミー…ぃ店長、改めましてご無沙汰です、[l]\n雨山かれお只今参りましたっ」":55,"そこでぐりっと身体ごと僕の方を向き、":56,"「そちらの男子さんも改めまして\nナイストゥーミーチュー！":57,"私、ミぃ店長の古い知り合いであります、\n雨山かれおと申しますっ。":58,"これからもよくして下さいねっ。[l]\nプリーズヘルプミー！」":59,"「あ、どうも初めましてこちらこそ…（へるぷみー…？）[l]\nここでバイトしてます、飯窪真言でス。[l]\n今後とも宜しく…」":60,"怪しい挨拶をなさった。[l]\n思わず胡乱に返答をしてしまう僕だったが、\nその瞬間彼女のテンションのギアがまた上がった。":61,"「あぁあーっ、貴方が！[l]\nお話は伺ってます、そうですか貴方が！":62,"私、ミぃ店長の古い知り合いであります、\n雨山かれおと申しますっ。[l]\n":63,"これからもよくして下さいねっ」":64,"い、いや、二度言われても。[l]\nてか宮さん僕の事を話してたのか。":65,"どういう風に伝わってるのやら、なんか気になる\n反応なんですけど…[l]\n『そうですか貴方が！』って、何を聞いたんだ…？":66,"「ええと、何を伺ったのかは判りませんが、\n僕がその、飯窪真言です。[l]\nこちらこそ宜しくしてください…」":67,"僕も二度言うしかないがな。[l]\n何だこのあれな感じは。[l]\n宮さんどうにかしてください。":68,"「挨拶は良いですよ、\nそれよりご飯行きますけど来ますよね？":69,"かれおが来なくても宮達は行きますけどね？[l]\nそのときはかれおに留守番お願いしますけど？」":70,"「いいぇ、行きます行きますっ。[l]\nはっ、もしかして奢っていただけるのでしょうかっ」":71,"「…ゴゴイチですから構いませんですけどね。[l]\nあ、でもでもトッピング二品までですよ。[l]\n勿論普通盛りより上は却下です」":72,"「はいっ勿論承知の上です！[l]\nでは参りましょうか皆様！[l]\n飯窪様、会ったばかりで恐縮ですが、どうかよしなにっ」":73,"二品も付けたら結構豪華だと思うんだが、\n…リミット無ければいつもはもっと付けてるということか？":74,"もしそうなら、成る程背も腕力もどうやら伊達ではないらしい。[l]\n現状身近な女子が宮さんだっただけに、ちょっと新鮮ではある。":75,"「ああ、どうぞおかまいなく…[l]\nあと、『様』はちょっと…[l]\n僕ぁもう宮さん専属ドライバーみたいなもんなんで…":76,"車中で宮さんと詳しい話でもなさってください」":77,"さて、春先とはいえ四月前だから、まだ日はそんなに長くない。[l]\n五時六時ともなれば結構暗くなる。[l]\nライトを点灯し、大通りへ向かうべく、\n僕たちの車は細く入り組んだ路地を走った。":78,"カーステレオには宮さんの古今東西アニソン撰集が入っていて\nいつも非常に恥ずかしいのだが（僕はアニメは観ないのだが\n宮さんのこれの所為で知識だけはある）、":79,"古い知り合いならばその辺りは了承済みだろう。[l]\nむしろこのキャラならば大いに乗って歌い出してもおかしくない。[l]\nが、今のところ有り難いことにそれは無かった。":80,"状況が状況なので、いつもは助手席に座る宮さんも、\n今日は後部に二人で座ってしばらく何か話し込んでいた。":81,"僕は運転に集中しており、そして何となく聞き耳たてるのも\n憚られたので、内容は殆ど判らなかった。":82,"ある程度走った所で、二人の話が一段落着いたのか、\nかれお嬢が話しかけてきた。":83,"「聞いたところによりますと、\n私の方が２つほど年上ですね。":84,"全くもってお恥ずかしい限りです。[l]\nどうにも落ち着きがないと叱られますっ」":85,"ということは２２、３歳というところ。[l]\nまあ予想の範疇か。":86,"大学の同期生は学生ということもあり、[l]（浪人経験者を除き）まだまだ高校あがり、あまり大人の女性という感覚ではないが、":87,"このひとは背も高く、コートを着込んでいたのでスタイルこそよく分からないが綺麗な大人の女性と言っても良いんではないだろうか。[l]\n…黙っていて且つファッションを変えればだけど。":88,"「でも宮さんとも古い知り合いなんですよね？[l]\nつまりは…子供の頃から宮さんが面倒みてらした？」":89,"「言葉のアヤです。[l]\nせいぜい５、６年くらいの付き合いですよ。[l]\nそんな、宮がすごい年寄りみたいに聞こえる～」":90,"「ま、真言さん、店長に歳の事は禁句ですっ。[l]\n私の言い方が悪いせいで誤解を与えてしまったようで\nベリーソーリーですっ」":91,"焦るかれお嬢。[l]\nそうか、やはり禁句なのか。":92,"…どこまでホントか分からないが、[l]\nいよいよ以て宮さんの歳わからないな…[l]\n本気で怖くなってきた…":93,"今後もやはりこの話題には触れずの姿勢継続決定だ。":94,"「そんなことよりかれおは今晩どうするですよ？[l]\nホテルなんか店からも遠いし、とってないんでしょう？」":95,"「私は、今晩はミぃ店長の所に泊まるつもりで\n来てますがっ。お泊まりセットはトランクに常備ですから[l]\nノープレですっ」":96,"「やっぱりね…[l]\n夕方来た時点でもうしょうがないですけどね。[l]\n一日空けるのでちゃんと日取り決めてと言ったでしょう。":97,"準備は禅にさせますけど。[l]\nだいたい急いで行かないと、\nカレー屋さんが学生共で…」":98,"「あーも少しです宮さん。[l]\nお、空いてるぽいな。ああ、空いてる空いてる！[l]\n良かったですね、ナイスタイミングす」":99,"「はいかれお！罰です。[l]\n奥の禁煙席確保して！さあ行くのです！」":100,"「ぐっ！あ、あいさー！失礼、真言さんっ！」":101,"ばたんっ！":102,"言うなり彼女、\nまだ駐車途中で動いてる車から、ドアを開けて降りていった。[l]\nあ、あぶねえって！":103,"彼女自身もそうだけど、どっかにドアぶつけたらどうするんだ。[l]\nと、宮さんを見るも、\n…特にノーリアクションかよ。":104,"茶飯事なのか、この二人にとっては。[l]\nそして見る間に店内に入り、店員に案内されていくかれお嬢。":105,"まあ、もういいか。[l]\n早く飯を喰って落ち着こう。":106,"僕らが入店してからは、続々と学生らしき若者の団体が入ってきて、タイミングとしては本当にギリギリだったようだ。":107,"宮さんは先刻から、学生どもをまるで目の敵のように言っているが、学生に限らず、集団になり気が大きくなってる人間連中を見るのが嫌らしい。":108,"つまり飲み屋なんかはまず絶対無理なんだろうが、\nこの外見の御陰でまず門前払いになるだろうし、\n僕の知る限りそんな状況は見たことがない。":109,"ここのメニューにアルコールは無いが、\n若いエネルギーのテンションは侮れない、とは宮さんの談。[l]\nそれは僕も新歓で色々経験したので頷いた話だった。":110,"ま、今日はそういった客層でもないようだから、\nさっさと食事をして早々に残る用事を済ませよう。[l]\n僕はテーブルにあったメニューを手に取った。":111,"「あー…、新メニューなあ…[l]\n杉屋の豚丼なら出るたび挑戦してるんですけどね…":112,"カレーは冒険しないなあ、そういえば…っと[l]\nというわけで、\n僕はきしめんとサラダ単品で」":113,"宮さんは最前からの宣言どおりに、よく分からない新メニューに\n決めたようだ。":114,"宮さんの着る服は大抵白が多いのだが、そのせいか、\nカレーに限らず汁を飛ばさないように食うことに関しては\n神業の持ち主なのだった。":115,"そうでもなければ、\nあんな服でカレー好きではいられないのかもな。[l]\n何しろ前掛けみたいなナプキンも使わないのだから\n恐れ入る。":116,"と、手渡したメニューを凝視していたかれお嬢が\n宮さんに言った。":117,"「チキンカツとっ、\n……納豆トッピングの並でっ」":118,"「半端に健康志向みたいな真似を…[l]\n前みたいにビーフ＆チキンじゃないんですか？[l]\n体型維持もむつかしいお年頃？」":119,"「いやいやいやそういうことではなくテ！[l]\n値段に気を遣ったのですっ！[l]\nご覧の通り変わらずナイスバディーですからっ！　私はっ！」":120,"着ていたコートを丁度脱ぎかけていたのだが、\nその動作を引き継ぐ形で前を開き、胸部を突き出すかれお嬢。":121,"出会いの振る舞いのインパクトの方が強烈だったので\nあまり気付かなかったが、意識してみると、\n…ああ結構大きいな。":122,"宮さんと比較するのはあまりに酷というものだ。[l]\n胸部の大小のみをもってしてバディーのナイスさを断じるのも\n考えものだと僕は思っているが、":123,"彼女は腰もしっかり細く臀部もしっかりしていて、同期の連中あたりには受けがいいだろう。":124,"僕はどちらかというと胸部を含めスレンダー系が好みなのだが、…と僕はこんな所で何を考えているのだろう。[l]\n空腹時の脳髄の空転具合というのは斯くも恐ろしき物なりか。":125,"「どうせ宮はお子様体型です。[l]\n当て付けですか。嫌味ですか。むかつきますね。[l]\nそんなに気を遣いたいならサラダだけ頼むがいいです」":126,"「うあ、待った！うえいと！せめてオンタマかコロッケがーっ…」":127,"本当にこの人たちの力関係はどうなっているんだろうか。[l]\nいや、力関係は明らかなのだ。":128,"知人としか聞いていないが、これは上下関係にある仲であろう。[l]\nしかも宮さんのが上位の、だ。":129,"宮さんの年齢が不明なだけに想像がしにくい、\nというか想像の幅が有りすぎてわかりにくさ倍増だ。[l]\n食べながらそれとなく聞いてみようか。[l]\n齢に関する事項に触れないようにしなきゃいけないけど。":130,"結局、かれお嬢はサラダ単品は免れはしたが、\n一番安上がりな組み合わせにさせられたようだった。":131,"途中宮さんの携帯が鳴って一時席を離れたりもしたが、\n各々が食事をし、それなりに僕の脳も落ち着きを取り戻した頃に、\nそれとなく二人の関係を訊ねてみた。":132,"「あー、私はですね、飯窪本家様とは別に、\nミぃ店長個人がご指定の本を探索及び買い付けをしたり、\nそれと勿論、本家の命を受けて雑用をこなしております。[l]\nあ、禅にはお会いになりました？[l]\n彼の同僚とお考えになって下されば結構です」":133,"「あまりに古い本とか稀覯本とか、\nネットでも手に入らないものが多いので、全国は勿論、海外まで\n出回って貰ってるんす。[l]\nそういう能力は卓越してますから。彼女。[l]\nその分他の能力が劣ってますけどね」":134,"「…（宮さんひどいな）へえ、雨山さんも飯窪絡みの人ですか。[l]\nもしかして玄ノ森のご出身…？」":135,"「いえ、そうではないでス。生まれは関西です。[l]\n玄ノ森には何度か行ったことはありますがっ」":136,"そうなのか。[l]\n全く関西弁の匂いはしない、というより、\nおかしな外国人みたいな匂いはするのだが、\nそれも結局海外を渡り歩いているというその仕事ゆえなのか。":137,"と先刻も思ったことを考えた。":138,"「では今回いらしたのもそのお仕事ですか？[l]\n宮さんに頼まれた本を…」":139,"「そ、それがっ。[l]\nミぃ店長？」":140,"「えーとねまこくん、\n少々込み入った話になりそうだから、\nあとは帰ってからにしましょう。":141,"まこくんにも関係ある話。[l]\n残りの買い物は今日はキャンセル、ごめんねっ」":142,"「はい？あ、わかりました…」":143,"代わりにここは奢りですっ、\nと言って宮さんは伝票持ってレジに行ってしまった。[l]\nかれお嬢は顔の前で手を合わせ、\n『ごちそうさま』のポーズをし、":144,"「さ、行きましょうっ」":145,"と身支度を開始する。":146,"「………」":147,"なんだか妙な展開でないか？[l]\n僕にも関係ある話って何だ。":148,"なんか面倒そうだな…と思うまもなく、[l]\n空くのを待っていたらしい次の客が早々にテーブルに来たので、\n僕は急いで二人の後を追って店を出た。":149,"帰り道は既に真っ暗で、\n僕は少々憂鬱だった。":150,"アパートまではこの車を使えないので、\nこの闇の中、自転車で帰らなければならないからだ。[l]\nまさかかれお嬢と一緒に泊まらせてくれとは言えないだろう。[l]\nいろんな意味であり得ない。":151,"で、店に着くなり、宮さんはかれお嬢から書類封筒のような\nものを受け取り早々に奥に入っていった。":152,"僕は何故かかれお嬢から「少々お待ちを」と説明を受け、[l]\n応接間の畳の上で彼女と茶を飲みながら待つことになった。[l]\n茶とはいっても煎れるような上等なものではなくて、\n冷蔵庫に入っていたペットボトルのだが。":153},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_001.ks","relPath":"/data/scenario/SC_M_001.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":154,"length":154,"percent":100},"cacheResetOnChange":{},"cellInfo":[[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"t":"HU","v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}]],"lastSelectedCell":[153,1],"note":"完成"},"/data/scenario/SC_M_002.ks":{"data":[["数分後。","数分钟后。"],["「あのですね、宮と飯窪の本家が長年探していた本があるんです。[l]\n…本というか、ちょっと微妙なモノで、書籍というか何というか、[l]宮達は通称『","「事情是这样的，宫和饭洼本家多年来在找一本书。[l]\n…说是书可能有点微妙，算是书籍类吧，[l]我们通称为『"],["月 ","月 "],["狂 ","狂 "],["跳 』と呼んでるんですけど。","跳』。"],["それが一部分にしろ、一冊の本にしろ、本家が求めている、[l]ある特定の資料に相当する一群をそう呼んでるんですけどね。","不管是其中一部分还是整本书，只要是本家寻求的，[l]特定某类资料都这么称呼。」"],["今までも色々調べて貰ったんですが、\n今回断片、一枚の紙片がですね、ようやく入手できたんですね。[l]\nかれおが今回来たのはそういう訳です。[l]\n日が今日とは聞いてませんでしたけど」","虽然之前也麻烦你帮忙调查过各种事情，\n但这次终于成功获取到了碎片，一张纸片呢。[l]\n卡蕾欧这次过来就是这个原因。[l]\n虽然没听说具体是今天」"],["そこでぎろりとかれお嬢を見る宮さん。","宫小姐用锐利的目光打量着卡蕾欧小姐。"],["「そうですっ。[l]\n先ほど車内で話したのですが、実は見つけたのはこの近辺でしてっ。[l]\nまさに灯台もと暗しっ！」","「没错。[l]\n刚才在车里说过，其实发现地点就在这附近。[l]\n真是灯下黑啊！」"],["誤魔化し気味にハイテンションなかれお嬢。","卡蕾欧小姐用蒙混过关的语气高喊着。"],["「ん。昔から飯窪が書を集めていたのも元はと言えば『","「嗯。要说饭洼家自古收集文献的初衷，其实都是为了『"],["跳 』の為なんすけどね。[l]\nま、そういう訳でそれなりに調査はしてあるんですけど、\nえっと、これ見てください」","跳 』呢。[l]\n嘛，总之我们姑且做过一些调查，\n呃，请看这个」"],["宮さんはそこで、奥から持ってきたらしい分厚いバインダーを開いて見せた。","宫小姐说着翻开从里屋拿来的厚重活页夹。"],["「分かります？見えますか？」","「能看懂吗？看得见吗？」"],["「おおっ、私も初見ですっ！…おや？」","「哇哦，我也是第一次见！…咦？」"],["カラーコピーなのかプリントアウトされた写真かは\n分からないが、よく分からない古文書とでも言うべきか、","不知是彩色复印件还是打印的照片，\n上面似乎是某种难以辨认的古代文书，"],["所謂昔の日本の妖怪絵巻の一部分のような、\n僕にはとうてい読めない文字（らしきもの）と、\n何を描いたものやらおかしな化け物のような絵が描いてあるものだった。","像是日本古时候妖怪绘卷的一部分，\n画着我看不懂的文字（疑似）\n以及不知描绘何物的怪异妖怪图案。"],["しかし明らかに鉛筆で描かれていて、\n確実に近代のものだろう。[l]\n案の定、宮さんが言った。","但明显是用铅笔绘制的，\n肯定是近代的东西。[l]\n果然，宫小姐开口道："],["「","「这是模仿位于"],["玄","玄"],["ノ","之"],["森にある神社のご神体、『紙様』を模写したモノです。[l]\n飯窪本家から入手したメモなんですが、\nこれを描いた人間は故人でこれ以上の情報は分かりません。[l]\n他に何も残さずに逝ってしまったので」","森的神社的御神体『纸大人』的临摹品。[l]\n虽然是从饭洼本家得到的笔记，\n但绘制者已故，无法获取更多信息了。[l]\n那人没留下其他资料就去世了」"],["森には三春家が神官を務める、\n","森林里有三春家担任神官的\n"],["九","九"],["抱山玄森神社というのがあって、\nそこのご神体、ということらしい。[l]\n山の事は覚えていたが、神社の名前に聞き覚えはなかった。[l]\n僕が居たのは幼少期でもあり、そういったことに興味はなかったし、\nほとんど記憶に無かったのは仕方ないだろう。","抱山玄森神社，\n据说就是那里的御神体。[l]\n我对山有印象，却不记得神社名字。[l]\n毕竟我那时还小，对这类事没兴趣，\n记不清也很正常。"],["「カミサマ？[l]\n神様がご神体ってそのままじゃないすか。[l]\nそれにイントネーションが変ですよ宮さん。[l]\n神様はカミサマでしょう」","「KAMISAMA？[l]\n御神体直接叫神大人不是很正常吗。[l]\n而且宫小姐你的发音好奇怪。[l]\n神大人就该读成KAMISAMA吧」"],["「あのねまこくん。[l]\nカミはカミでも、ペーパーの紙と書くのです。[l]\nあそこのご神体は紙なんです。[l]\n玄ノ森が書蔵で有名なのも伊達じゃないってことですかね。[l]\nそしてこれがかれおが見つけた『月狂跳』です。[l]\n描いてある文字や絵こそ違いますが、―――所謂デザイン、レイアウトですね。[l]\nそれがほぼ同じ、ほらこことこことかです」","「听好了小真。[l]\n虽然是KAMI，但写作纸张的纸字。[l]\n那儿的御神体是纸做的。[l]\n看来玄之森以藏书闻名并非虚传呢。[l]\n这就是卡蕾欧找到的《月狂跳》。[l]\n虽然文字图案不同，——该说是设计布局吧。[l]\n几乎一模一样，你看这里这里」"],["先ほどのメモと同じような、よく分からない妖怪の様な絵と、\n読めない文字が記されていたが、[l]\n描かれている要素が異なるだけで、確かに構成はほとんど一緒と言ってよかった。[l]\n図鑑とかの別々の２ページ分とでも言えばいいのか。[l]\n宮さんが特に教えてくれなかったので、何が『月狂跳』たるものかは分からなかったが。","和刚才的笔记一样画着看不懂的妖怪图案\n与无法辨认的文字，[l]\n只是具体内容不同，整体结构确实如出一辙。[l]\n好比图鉴里不同的两页。[l]\n不过宫小姐没具体说明何为《月狂跳》。"],["「ああ、ほんとすね。うん…[l]\nつまり？」","「啊，确实呢。嗯…[l]\n所以呢？」"],["「今までは単なるご神体だと思っていたこの『紙様』、\nこれも『月狂跳』の要素を持ってる可能性があるということですね。[l]\nこのメモに描かれてあること自体にはその要素は無いようなので、\n放置していたんでしょうけど、\n今回かれおが持ってきたものと比較する限り、\n両者が共に、ある『月狂跳』足り得る書物の断片と推測はできますし、調べる価値はあるでしょ？」","「以往只当是普通御神体的『纸大人』，\n现在看来也可能具备《月狂跳》的特征。[l]\n虽然这份笔记本身看不出相关要素，\n可能因此被搁置了，\n但对比卡蕾欧带来的物品，\n可以推测两者都是某本《月狂跳》书籍的残页，值得调查吧？」"],["まあ、それはそうだ。[l]\nそもそも『紙様』とやらがこのメモに描かれた…[l]\nつまり一ページ（？）分で全て、とは限らない訳で。[l]\nと、宮さんが表情を変えて、やや困った風に話を続けた。","嘛，确实如此。[l]\n说到底『纸大人』这东西被画在这张便条上…[l]\n也就是说一页（？）未必能容纳全部内容。[l]\n说着，宫小姐神色一变，略显困扰地继续道。"],["「ところがちょっとした障害があるですよ。[l]\nこのご神体、祭の時に神事で使われるらしいんですが、\nそれまでは場所から何から一切が秘されてるんです。[l]\n単純に神社に奉られてるんではないようですね。[l]\nそして、一般には決して開陳しないのです。[l]\nその祭は、神事そのものは三春とその系列の家、\n詳しくは後で教えますが、[l]\n彼らのみで行われて、他者が見ることはできないんです。[l]\n","「不过有个小障碍呢。[l]\n这件神体似乎会在祭典神事时使用，\n但在此之前连存放地点都是绝对保密的。[l]\n看来并非简单地供奉在神社里。[l]\n而且原则上绝不对外公开。[l]\n那个祭典的神事环节，由三春家及其派系家族——\n详情稍后说明——[l]\n独自操办，外人根本无缘得见。[l]\n"],["抱山って山があるですけど、そこの山頂でですね。[l]\nそこにある時、偶然居合わせた人間が、\nさっきのメモを描いたのです。[l]\nだから秘密ですよ？見つかったら多分…怒られますね」","有座叫九抱山的山，就在那山顶上。[l]\n当时偶然在场的人，\n画下了刚才那张便条。[l]\n所以是秘密哦？要是被发现的话…肯定会挨骂吧」"],["「偶然ねぇ…[l]\nまさか宮さん、飯窪の誰かがわざとそんなことしたんじゃないでしょうね？[l]\n…描いた人はもう亡くなってるって…まさか？」","「偶然啊…[l]\n该不会宫小姐，是饭洼家的人故意这么干的吧？[l]\n…听说画的人已经去世了…难道？」"],["「んむ？[l]\nいやいやそんなじゃないですよ？[l]\nというかあのメモに関して、\n詳しい経緯は宮は知らないのです」","「嗯唔？[l]\n不不没那回事啦？[l]\n倒不如说关于那张便条，\n宫也不清楚具体来龙去脉」"],["「じゃあそんなじゃないと断言できないんじゃないすか…[l]\nま、まあいいや。[l]\nそうそうそういった事は起こらないと信じましょう。[l]\nでも、何にしても三春の人達に聞くとか、\n普通に頼めば済む話じゃないんですか？」","「那不就无法断言绝对没这回事吗…[l]\n嘛、算了算了。[l]\n就当这种事不会发生好了。[l]\n不过无论如何，去问问三春家的人，\n正常请求不就能解决吗？」"],["「ま、それも試しますけど。[l]\n信仰に関わるものですし望みは薄いですね。","「嘛，也会尝试啦。[l]\n但涉及信仰问题希望渺茫呢。"],["祭や神社の事にしたって、\nここまで知ることが出来たのも、飯窪が古くから\n三春と書の蒐集を通じて、多少ですが深い交流があったからです。","就连祭典和神社的情报，\n能打听到这些也是因为饭洼家\n长期通过古籍收集与三春家有些深度往来。"],["その頃も当然ご神体の実物は見せて貰ってないでしょうけどね。[l]\n玄ノ森の住人ですら、この話知らないはずですよ。","当然那时候也没能亲眼见到神体实物就是了。[l]\n连玄之森的居民都不该知道这事哦。"],["いずれ","迟早"],["知","会"],["狡は嫌がるでしょうねー。[l]\n飯窪としては三春と変な摩擦を起こしたくないでしょうし」","惹狡先生生气的吧ー。[l]\n饭洼家也不想和三春家产生摩擦」"],["はあ、面倒くさいことですなあ。","哈啊，真是麻烦事啊。"],["日本人…とも限らないが気質というか、[l]\n人間のある側面では美点でもあるのだろうが、\n信仰心が実務にもブレーキをかける、というのも\nなかなか考え物の場合もあるわけだ。","日本人…虽不限于此但这种特质，[l]\n作为人性的一面或许也算美德，\n但信仰心给实务踩刹车的情况，\n有时也相当令人头疼呢。"],["田舎だと特にはっきりと影響ありそうだし、\n","在乡下这种影响尤其明显，\n"],["狡さん真面目だから、\nその辺りは慎重にもなるだろう。","加上知狡阿姨为人认真，\n这方面自然会格外谨慎。"],["「さてですね。というわけで宮は今度の件で、[l]\n玄ノ森に行って来なきゃなのですが。","「那么。因此宫这次得去趟[l]\n玄之森才行。"],["ただ、さっきから言ってる通り、三春が素直に見せてくれるとは\n思えないんで」","不过正如刚才所说，不认为三春家会爽快答应\n给我们看呢」"],["「あ、行くんですか。[l]\nで、はい、でも見せてくれないだろうと」","「啊，要去啊。[l]\n然后，嗯，但估计不会给看是吧」"],["「…うひひ」","「…嘻嘻」"],["な、なんすかその笑みは。","这、这笑容几个意思。"],["「…その神事に忍び込んででも確認せよ、[l]\nという本家の要請も実はあるんです」","「…其实本家还下了死命令：哪怕潜入神事也要确认[l]\n清楚」"],["「うえ？！[l]\nまじすか！！[l]\nだ、だめでしょそんなの！」","「诶？！[l]\n真假啊！！[l]\n不、不能这么干吧！」"],["「でもですね実際、モノを盗ろうというんではないですから。[l]\n要は中身が分かれば良いんですし。","「不过实际上并非要偷东西啦。[l]\n关键是弄清内容就行。"],["そのあと、知り得たことを世に開陳する訳でもないし、\n黙ってれば分からないす。","之后也不会把情报公诸于世，\n保持沉默就不会暴露啦。"],["本家長年の悲願とはいえ、単なる知的好奇心の充足、それだけっ。[l]\n全く書痴とは罪作りな人種ですね～」","虽说这是本家多年的夙愿，但单纯只是满足求知欲而已，仅此而已。[l]\n真是的～书痴这种生物可真是罪孽深重呢～」"],["「ですね～ってまたそんな簡単に！[l]\nそもそも宮さんそんなスパイじみた事出来るんですか？[l]\nいや、それ以前に、するつもりなんですか？」","「'真是的～'别又说得这么轻巧！[l]\n说到底宫小姐你真能干这种间谍似的勾当吗？[l]\n不，在那之前，你真有这打算吗？」"],["「だって単にご神体覗き見るだけですよ。[l]\n安置場所がわからないので神事の最中になりますけどね。[l]\nどういう風に扱われるかにもよりますが―――\nまあその辺に隠れて望遠鏡とか暗視カメラでさくっと」","「因为只是偷看神体而已嘛。[l]\n只不过不清楚供奉位置，得趁神事期间动手就是了。[l]\n具体要看他们怎么处置―――\n总之猫在附近用望远镜或夜视相机咔嚓搞定」"],["「そんな機材あるんかい！[l]\n…言うからにはあるんでしょうね、本家のバックアップも[l]\nお有りのようだし…」","「哪来这种设备啊！[l]\n...既然敢说应该是有吧，毕竟本家也会支援[l]\n看样子资源很充足呢…」"],["「で、祭は四月末日、丁度一ヶ月後くらいですか。[l]\nそのころに知狡のとこにでも滞在して調査するですよ。[l]\nその時は連休も近いですしまこくんも連れて、\n帰省がてら祭見物でもしてもらおうかなーっ」","「祭典在四月末，差不多一个月后吧。[l]\n到时候借住在知狡那边调查就行。[l]\n正好临近连休，把真仔也捎上，\n让他以回乡名义顺道参观祭典好了ー」"],["「と、思ってたんですが」","「本来是这么打算的」"],["「？」","「？」"],["「んお？」","「嗯哦？」"],["かれお嬢と一緒になって身構える僕。[l]\nなんだ。これ以上さらに何か予期せぬ事態があるというんだな。[l]\n面倒そうだなあ…","我和卡蕾欧小姐同时绷紧身子。[l]\n怎么。看来还有更出乎意料的状况啊。[l]\n感觉会很麻烦啊…"],["まて、そもそも最初から、\n僕に関係する話だって言ってなかったか？","等等，打从一开始，\n你不是说这事和我有关吗？」"],["「さっきご飯の途中、知狡から電話が来てたんです。[l]\nそしたら、つい最近、先日ですね、玄ノ森で割と大きな事件が\nあったらしくて―――」","「刚才吃饭时知狡来了电话。[l]\n说是前几天玄之森出了件挺大的\n案子―――」"],["「事件？なんすか？[l]\n崖崩れでも起きて通行がままならないとか？[l]\nそれとも熊が出たとか…」","「案子？啥情况？[l]\n山体滑坡导致道路瘫痪？[l]\n还是说有熊出没…」"],["「―――あまり大きな声では言えません。[l]\n…人為的に行われたと思しき、[l]\n人死にが数件あったそうです」","「―――不便大声宣扬。[l]\n...疑似人为造成的[l]\n数起命案」"],["「ひっ！人死に！！」","「噫！命案！！」"],["なんだって？[l]\n人為的に為された、つまり殺人事件か？[l]\nしかも数件だ？","你说什么？[l]\n人为所致，也就是说杀人事件？[l]\n还不止一起？"],["「よっ…予想の範囲外…でスね…？[l]\nミぃ店長…」","「这…这超出预期…了是吧…？[l]\n宫店长…」"],["何を予想してたというのだ、かれお嬢。","你原本预期的是什么啊，卡蕾欧小姐。"],["「三春に連なる家の者だったので、\n圧力が掛かって表に情報は出ないのですよ。[l]\n…あそこはそういう土地、そういう家、[l]\n罷り通る状況があるです。[l]\n覚えて置いてください。[l]\n知狡は飯窪本家の者なので有る程度事情を知り得たようですけど」","「由于死者是三春相关家族成员，\n上面施压封锁了消息。[l]\n...那地方就是这样的土地，这样的家族，[l]\n有权势者横行无忌。[l]\n请记住这点。[l]\n知狡作为饭洼本家成员似乎能接触到部分内情」"],["とある田舎、謎の祭の伝わる土地（そう、しかも玄ノ森は\n温泉郷でもあるのだ）で、連続殺人発生かよ。[l]\n長いサブタイトルが付くような二時間ドラマか。[l]\nちょっと移動すればあの辺の海岸は断崖だらけだし。[l]\nはたまた大神がよくやるようなゲームかなにかか。[l]\nあいつからよくそういうの聞くぞ。[l]\nいやいや、笑い事ではない。[l]\nというより僕がどう関わらされるのかが問題だ。","某个乡下，传承着神秘祭典的土地（对了，玄之森\n还是温泉乡呢）居然发生连环杀人案。[l]\n难道是那种带着超长副标题的两小时电视剧吗。[l]\n稍微走几步就是悬崖密布的海岸。[l]\n该不会是大神常玩的那种游戏吧？[l]\n那家伙总提这类事情。[l]\n不不，这可开不得玩笑。[l]\n不如说我会被怎么卷进去才是问题。"],["「詳しくは分からないし、\n聞こえる部分の真偽も疑って掛かる必要はありますが、\n死因はあまり普通ではないようでした。","「详细情况不明，\n听到的消息也需要质疑真伪，\n但死因似乎不太寻常。"],["益々表沙汰にはならないですね。三春家とその眷属はその辺徹底してますから。[l]\nただ祭がスケジュール通り行われるかどうか微妙な感じになったので…」","更不可能公开了。三春家及其眷属对这类事向来处理得很彻底。[l]\n只是祭典能否按原计划举行变得微妙了…」"],["「え？ええ、それで」","「啊？啊，所以」"],["もうあまり頭がついていってないので、\n生返事になってしまう。[l]\nそれでなんなんだ？","脑子已经跟不上节奏，\n只能机械性应答。[l]\n所以到底怎样？"],["「つまりはですね、","「简而言之呢，"],["調査はおそらく祭の日に限られる、[l]\nでも祭の日程が怪しくなってきたので、\n延期や早まった場合に備えて、前後長期的に滞在しておきたくて…","调查大概仅限于祭典当天、[l]\n但祭典日程变得可疑起来、\n为防备延期或提前的情况，想长期驻留前后时段…"],["その間中まこくんにもしっかり側に居て欲しいわけです。[l]\n状況が状況ですし、ボディガード兼スパイ助手も兼ねてもらえれば最高だにゃっ♪」","这段时间也希望小真能好好待在身边呢。[l]\n鉴于现状如此，能兼任保镖和间谍助手就最棒了喵♪」"],["「ソーリーです真言さんっ。[l]\n私は所用がありましてご一緒できないのでありますっ」","「抱歉啦真言同学。[l]\n我因故无法同行是也」"],["突然よそ行きの声で小首を傾げる宮さん。[l]\nそして顔の前で手を合わせ僕に謝るかれお嬢。[l]\n数秒後、段々話が脳に浸透し、\nようやく反応。[l]\n…ちょっとまて！！","突然用敬语歪着脑袋的宫小姐。[l]\n以及在面前双手合十向我道歉的卡蕾欧小姐。[l]\n数秒后，对话内容逐渐渗入大脑、\n终于反应过来。[l]\n…等等！！"],["「ばっ、みっ、あ、雨山さん、誤解しないでくださいよ！[l]\n宮さんも何を突然！」","「等、等等、雨山小姐请别误会！[l]\n宫小姐你也太突然了吧！」"],["「んむ、今回は別にミステリやドラマみたいに、\nその事件を解決しに行くわけじゃないですし。[l]\n『月狂跳』が示す要素さえ蒐集できれば、飯窪は満足なんです。[l]\nそれが宮達の目的。[l]\n警察絡むような事は…[l]\n極力しませんし是非協力して欲しいです」","「嗯哼，这次并非像推理剧那样、\n要去解决什么事件啦。[l]\n只要能收集到《月狂跳》所揭示的要素，饭洼家就满足了。[l]\n这就是宫们的目的。[l]\n牵扯警方的事…[l]\n会尽量避免还请务必协助」"],["「いやそれはそれとしてちょ、ちょっと待った！[l]\n僕大学あるんスけど！[l]\n春休みもう終わるし駄目ですって！！","「不是这个问题稍、稍等一下！[l]\n我还要上大学啊！[l]\n春假都快结束了真的不行啦！！"],["そのそういう事なら祭の日程決まったらその時呼んでくれればいいでしょうよ！","这种事等祭典日期定了再叫我不就好了吗！」"],["「ま。[l]\n一部は冗談として、\n宮、夜目は利くんですが、\n暗いのは苦手なんですぅ。[l]\nあとやっぱり一人じゃなかなか難しい作業もありまして。[l]\nさっき言った機材とかも、運搬係してくれると嬉しいっす。","「嘛。[l]\n部分算是玩笑话、\n宫虽然夜视能力不错、\n但很怕黑呢。[l]\n而且有些工作独自完成确实困难。[l]\n刚才说的器材也需要搬运帮手呢。"],["あ、先に言っておきますが、\n本家の人間はあそこでは顔が割れてるし、祭で忙しくて使えないのですよ。","啊事先声明、\n本家的人在那边脸太熟，祭典期间又忙得抽不开身。"],["書き入れ時ですからね、知狡達にとっては。[l]\nだからお願いですってばぁ。[l]\nあ、臨時ボーナス、＋いろいろ宮がサービスしますよぉ♪」","这可是旺季啊，对知狡他们来说。[l]\n所以都说了拜托啦。[l]\n啊，临时奖金，＋宫还会提供各种福利哦♪"],["くねくねする宮さんだったが、\nいろんな意味でこれは僕とて籠絡される状況ではない。[l]\n拳をぶんぶん振り上げて反論を続ける。","虽然宫小姐扭来扭去地撒娇、\n但从各种意义上这都不是能让我就范的状况。[l]\n我挥舞着拳头继续反驳。"],["「駄目だってー！！[l]\n今日はまだ２年目始まる直前、祭当日にしたってほとんど五月ドアタマですよ？","「都说不行啦！！[l]\n现在才第二学年刚开始，就算祭典当天也几乎是五月初啊？"],["前後一ヶ月って、中間試験と被ってる！[l]\n一年のスタートからそんな無茶な！」","前后一个月会撞上期中考试的！[l]\n学年刚开始就这么乱来！」"],["「あ、前から思ってたんですけど、もう学校辞めたらどうですかまこくん。[l]\n","「啊其实一直想说了，小真不如干脆退学吧。[l]\n"],["そうですねそれで行きましょう、良い機会です」","就这么定了，正好是个机会」"],["はいー！？","哈啊ー！？"],["「あっははは、な、なにを突然！[l]\n前からって何ですか！[l]\nというか飛躍しすぎですって宮さん！[l]\nきょ、協力したいのはやまやまですが何もそこまでしなくても！」","「啊哈哈、突、突然说什么呢！[l]\n什么叫一直想说啊！[l]\n这跨度也太大了吧宫小姐！[l]\n虽、虽然很想帮忙但也不至于这样！」"],["思わず笑ってしまいました。[l]\nかれお嬢、気の毒そうというより羨ましそうな目で何故\n僕を見るんですかしら。","不禁笑出了声。[l]\n卡蕾欧小姐用看似同情实则羡慕的眼神\n盯着我瞧什么呢。"],["「まあ、まこくんもどうせ就職の為のあれでしょ？[l]\nどうせもう先は（うちに）決まってるんですから、\n今更モラトリアム堪能しなくてもいいですよね。[l]\n早めに社会に貢献して世のみんなに褒めて貰いましょー」","「反正小真上学也就是为了就业吧？[l]\n反正前途（我们家）早就定好了、\n现在也没必要享受延迟偿债期啦。[l]\n早点为社会做贡献接受世人夸奖吧ー」"],["考えようによっては説得力があるが、\nいやいや待て！[l]\nいくら何でも突飛に過ぎる！！","换个角度想还挺有说服力、\n不不慢着！[l]\n再怎么说也太离谱了！！"],["「だからそれは誤解をあれ、あれです、かっ、母さんが何と言うか！」","「所以说这是误会那个、妈妈会怎么说啊！」"],["「電話してみます？」","「要打电话试试吗？」"],["そうだ、ここで母さんからも話してもらおう。[l]\n携帯のメモリーから家を検索、電話。","对了，让妈妈来说服她们吧。[l]\n从手机通讯录里搜索家里号码，拨打。"],["しばしのあいだ。","短暂的时光。"],["喧","喧"],["々","闹、"],["囂","嘈"],["々。[l]\n","杂。"],["侃","理"],["諤","直"],["々。","气壮。"],["会話終了。回線切断。","会话结束。线路切断。"],["おいおいおいおい、学費が浮く方を優先されたぞ…[l]\n母さんまで「あたしも前から思ってた」ってどういうことだ。[l]\nえ、ていうか退学すれば戻ってくるんだったか？　学費って？[l]\nこないよな？逆に損だろ？あれ？","喂喂喂喂，优先选了能省学费的方案啊…[l]\n连老妈都说「我早就这么想了」这算怎么回事。[l]\n咦，话说退学的话学费会退吗？学费怎么说？[l]\n不会退吧？反而亏大了吧？啊咧？"],["「どうでしたぁ？」","「怎么样呀～？」"],["……。[l]\n悠然と微笑みながら宮さんが訊いてきた。[l]\n…まさか申し合わせてたのか？","……。[l]\n宫小姐带着从容的微笑询问道。[l]\n…难道你们串通好了？"],["いや、母さんは人から頼まれたって\nそんな計算行動できる人じゃない。[l]\nということは天然でだ。あの返答は。","不，老妈她就算被人拜托\n也不是会算计行动的类型。[l]\n也就是说那是天然反应。那个回答。"],["なんたることだ。[l]\n……。[l]\n…仕方なく僕は宮さんに力無く応えた。","太离谱了。[l]\n……。[l]\n…无可奈何的我虚弱地回应宫小姐。"],["「宮さん及び本家への協力が最優先事項だと…」","「以配合宫小姐及本家为最优先事项…」"],["そう、未来の嫁への投資がどうとか意味不明な事までしゃべくったが、そこはスルーしたし宮さんにも告げなかった。","没错，虽然她还说了什么对未来媳妇的投资之类莫名其妙的话，但那部分我直接无视了也没告诉宫小姐。"],["どういう意味だ。[l]\n商売しない本屋を趣味で作る飯窪の、分家とはいえ飯窪は飯窪。[l]\n流石に世間一般でいうまともな理屈を持たないらしい。","什么意思啊。[l]\n开不赚钱的书店当兴趣的饭洼家，就算是分家也终究姓饭洼。[l]\n看来确实不具备世俗意义上的正常逻辑。"],["僕とか知狡さんが真面目なのは特例なのか？[l]\nそれとも僕らも実はそうなのか？[l]\nう、それはいやだ。[l]\nいやだが…","难道我和知狡阿姨才是特例的正常人？[l]\n还是说其实我们也…？[l]\n呜，那样的话太糟了。[l]\n虽然很糟…"],["いいや、もう。[l]\n世知辛い時代だ。[l]\n大学出た所で何が保証されているでもない。","算了，就这样吧。[l]\n这世道真不容易。[l]\n就算大学毕业也没什么保障。"],["母や宮さんの思惑に乗るのは癪ではあるが、\nこれが僕の将来の為の布石だと思おう。","虽然被老妈和宫小姐算计很不爽，\n就当这是为我的未来铺路吧。"],["一年だけでも大学生と言うモノを体験できただけでも良しとするか。[l]\n元々面倒なことは嫌いな質なんだ、僕。","好歹也体验过一年大学生活了。[l]\n我本来就是个怕麻烦的人。"],["この場合どっちが面倒なのかは、もうそれこそ考えるのも面倒だ。[l]\nああ、これもまた飯窪の血の一端なのか。[l]\n逃れ得ぬ血の呪縛、嫌なモノだ、全く…","现在这种情况哪边更麻烦，连想都觉得麻烦。[l]\n啊，这也是饭洼家血脉使然吗。[l]\n无法逃脱的血脉诅咒，真是讨厌啊…"],["「その代わり、\n本当に責任取って貰いますよ。[l]\n僕の将来に。うぅ～…」","「作为交换，\n你们可得负起责任啊。[l]\n对我的未来。呜～…」"],["女子二人の前で半泣きになる僕。[l]\nだからかれお嬢、何故僕を羨ましそうに見るんですカ。","在两位女生面前半哭的我。[l]\n所以卡蕾欧小姐，为什么用羡慕的眼神看我啊。"],["「おーるおっけーでっす。[l]\nまこくんの将来は宮達が完全ふぉろー！ばっくあっぷ！[l]\nじゃ、学校の諸手続はしておくように禅とまこくんママに\n言っておきますから。[l]\n出発は五日後で。準備よろしくです。[l]\n荷物はそうですね、\n滞在中の色々は知狡のとこで大体は足りると思うので、\nそれは留意してください。[l]\nただ、まこくんがいた頃と状況はほとんど変わってませんから、\n何か街でないと買えないようなものはこちらで用意した\n方がいいです。","「All～OK哒～[l]\n小真的未来就由我们全权follow！Backup！[l]\n那学校的手续我会让禅和小真的妈妈\n提前办好的。[l]\n五天后出发。请做好准备。[l]\n行李的话呢，\n日常用品在知狡那边基本都能凑齐，\n这点请注意。[l]\n不过小真离开后状况几乎没变化，\n所以城里才买得到的东西还是我们这边\n先准备好比较妥当。"],["あとテレビ、キー局の系列はほとんど入りはしますが、\nこっちで予約録画はしておいたほうが。宮はしていきますよ。[l]\n携帯電話はどこの使ってますか？","另外电视，虽然能收到主要电视台，\n但预约录像功能还是得提前设置。宫会弄好的。[l]\n手机用的是哪家运营商？"],["あ、電波入らないですね。仕方ない、急用の時は宮のを。[l]\n免許はちゃんと持参してください、車がないときついでしょうね。[l]\n車自体は本家ので。マニュアル車しかないですが問題ないでした？","啊，信号覆盖不到呢。没办法，急事就用宫的手机吧。[l]\n驾照请务必带上，没车会很不方便。[l]\n车就用本家的。只有手动挡没问题吧？"],["なら良いです。[l]\n当たり前ですがバイトも当分休止ですね。[l]\n","那就好。[l]\n当然打工也要暂停一段时间。[l]\n"],["ま、今後は正従業員ですしねっ。うひひ」","嘛～反正马上就是正式员工啦。嘿嘿」"],["こうして僕は、\n全く無茶な展開によってではあるが、\n縁故の地でもある、玄ノ森に行くことになったのだった。","就这样我、\n虽然是通过完全乱来的方式、\n决定前往也算有缘分的玄之森了。"],["漫画や小説ではよくある巻き込まれ型主人公を、\n地で行ってしまってる気がする…","漫画小说里常见的被卷入型主人公、\n感觉我正亲身实践着…"],["現実にも、いや現実だからこそ、義理や人情故に断り切れないという場面があるのだなあ。あはは…[l]\nまさに不条理な決断。[l]\n今回は違う気がするけど…","现实中也有、不如说正因为是现实，才会存在碍于情面无法拒绝的情况啊。哈哈…[l]\n真是荒谬的决定。[l]\n总觉得这次不太一样…"],["結局、帰りは真っ暗の中自転車をこいでアパートまで帰った。[l]\nビタミンＡが足りてないのか、心の有り様なのか、\nいつも以上に視界は真っ暗だった。","结果回来时还是摸黑踩着自行车回到公寓。[l]\n不知是缺乏维生素A还是心理作用、\n视野比平时更加漆黑。"],["田舎で良いもん食えればいいな…そして明るい視界が取り戻せますように…[l]\nああ、明日からは、もう旅の準備をしなければならない。[l]\nさて、友達にはなんて説明したものか。","在乡下能吃到好东西就好了…但愿能重见光明…[l]\n啊、从明天开始就得准备旅行了。[l]\n话说、该怎么和朋友解释呢。"],["…そうか、友達なんて呼べるのは結局一年在学してたった一人、[l]\n大神だけだったか。そう思うとちょっと悲しいものがあるな。","…对了、所谓朋友说到底入学一年也只有一个人、[l]\n就大神而已吧。这么想有点伤感啊。"],["いいや、奴にはあとでメールか電話しとこう。[l]\n今日はもう寝る。[l]\n寝るったら寝る！","算了、回头给那家伙发邮件或打电话吧。[l]\n今天先睡了。[l]\n说睡就睡！"],["就寝して数分後、携帯の着メロで起こされた。[l]\n着信は、ああ、大神雪鳴。","入睡几分钟后、被手机铃声吵醒。[l]\n来电显示是、啊、大神雪鸣。"],["…しょうがない。この際説明するか…","…没办法。趁这机会说明吧…"],["奴の用件は他愛のないものだったので、\n会話の大半は僕の置かれた状況の説明となった。","虽然那家伙说的都是些无关紧要的事、\n但对话大半变成对我现状的说明。"],["驚かれたり呆れられたりした後、\n結局奴にも納得していただいた。","在惊讶和无语之后、\n总算也让那家伙接受了。"],["戻ってきたら飲もうぜ、と話を締め電話を切り時計を見ると、\n既に相当深夜を回っている。結構な時間喋っていたらしい。","约好回来喝酒后挂断电话、看时间、\n早已深更半夜。似乎聊了相当久。"],["…ふて寝も満足に出来そうにない。[l]\n全く今日は―――いや、とっくに日も変わってしまった―――\n昨日は酷い日だった。","…连怄气睡觉都睡不安稳了。[l]\n今天真是——不对、早就过了零点——\n昨天真是糟糕的一天。"],["何とか眠ると、宮さんが夢に出て、\n何故か僕はすごく彼女に愛おしさを感じていたけども。","勉强入睡后、宫小姐出现在梦里、\n不知为何对她产生了强烈的怜爱之情。"],["今までも夢に異性が出ると、そういう感じになったこともあったので、特に後を引くことはなかった。","以前梦到异性时也有过类似感觉、所以没特别在意。"],["ただ、少しやさぐれていた心が、\nやや安寧を取り戻したような気がして、\n明日からは、多少は前向きに彼女に協力しようと思いながら。","只是原本有些自暴自弃的心、\n似乎稍微恢复了平静、\n想着从明天开始要积极协助她。"],["再び無へと意識は落ちていった。","意识再次沉入虚无。"]],"context":[["SC_M_002.ks/index/1/text"],["SC_M_002.ks/index/3/text"],["SC_M_002.ks/index/5/text","SC_M_002.ks/index/23/text"],["SC_M_002.ks/index/7/text","SC_M_002.ks/index/25/text"],["SC_M_002.ks/index/9/text"],["SC_M_002.ks/index/11/text"],["SC_M_002.ks/index/13/text"],["SC_M_002.ks/index/15/text"],["SC_M_002.ks/index/17/text"],["SC_M_002.ks/index/19/text"],["SC_M_002.ks/index/21/text"],["SC_M_002.ks/index/27/text"],["SC_M_002.ks/index/29/text"],["SC_M_002.ks/index/31/text"],["SC_M_002.ks/index/33/text"],["SC_M_002.ks/index/35/text"],["SC_M_002.ks/index/37/text"],["SC_M_002.ks/index/39/text"],["SC_M_002.ks/index/41/text"],["SC_M_002.ks/index/43/text","SC_M_002.ks/index/49/text"],["SC_M_002.ks/index/45/text","SC_M_002.ks/index/51/text"],["SC_M_002.ks/index/47/text"],["SC_M_002.ks/index/53/text"],["SC_M_002.ks/index/56/text","SC_M_002.ks/index/75/text"],["SC_M_002.ks/index/58/text"],["SC_M_002.ks/index/60/text"],["SC_M_002.ks/index/62/text"],["SC_M_002.ks/index/64/text"],["SC_M_002.ks/index/66/text"],["SC_M_002.ks/index/68/text"],["SC_M_002.ks/index/70/text"],["SC_M_002.ks/index/72/text"],["SC_M_002.ks/index/77/text"],["SC_M_002.ks/index/79/text"],["SC_M_002.ks/index/81/text"],["SC_M_002.ks/index/83/text"],["SC_M_002.ks/index/85/text"],["SC_M_002.ks/index/87/text"],["