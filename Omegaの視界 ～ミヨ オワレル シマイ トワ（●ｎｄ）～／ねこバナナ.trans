64}],[{"start":27272,"end":27337}],[{"start":27369,"end":27465}],[{"start":27491,"end":27495}],[{"start":27503,"end":27527}],[{"start":27535,"end":27545}],[{"start":27576,"end":27603}],[{"start":27611,"end":27671}],[{"start":27679,"end":27719}],[{"start":27751,"end":27789}],[{"start":27815,"end":27819}],[{"start":27827,"end":27832}],[{"start":27841,"end":27844}],[{"start":27875,"end":27905}],[{"start":27919,"end":27920}],[{"start":27930,"end":27941}],[{"start":27973,"end":28043}],[{"start":28074,"end":28098}],[{"start":28130,"end":28161}],[{"start":28176,"end":28178}],[{"start":28187,"end":28214}],[{"start":28245,"end":28315}],[{"start":28341,"end":28355}],[{"start":28387,"end":28442}],[{"start":28473,"end":28526}],[{"start":28534,"end":28587}],[{"start":28619,"end":28660}],[{"start":28691,"end":28758}],[{"start":28766,"end":28832}],[{"start":28862,"end":28887}],[{"start":28899,"end":28968}],[{"start":28994,"end":29035}],[{"start":29043,"end":29080}],[{"start":29088,"end":29141}],[{"start":29173,"end":29198}],[{"start":29229,"end":29252}],[{"start":29260,"end":29317}],[{"start":29343,"end":29385}],[{"start":29393,"end":29464}],[{"start":29496,"end":29521}],[{"start":29553,"end":29601}],[{"start":29627,"end":29733}],[{"start":29763,"end":29777}],[{"start":29809,"end":29837}],[{"start":29865,"end":29902}],[{"start":29984,"end":30028}],[{"start":30036,"end":30106}],[{"start":30114,"end":30155}],[{"start":30186,"end":30231}],[{"start":30257,"end":30300}],[{"start":30394,"end":30423}],[{"start":30453,"end":30490}],[{"start":30522,"end":30540}],[{"start":30566,"end":30608}],[{"start":30616,"end":30679}],[{"start":30687,"end":30739}],[{"start":30747,"end":30789}],[{"start":30797,"end":30840}],[{"start":30900,"end":30923}],[{"start":30985,"end":31059}],[{"start":31067,"end":31201}],[{"start":31209,"end":31291}],[{"start":31299,"end":31316}],[{"start":31324,"end":31349}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_044.ks","basename":"SC_M_044.ks","indexIds":{"夕御飯は、\n病み上がりの僕に配慮したのかややあっさりめのメニューで、\n":0,"饂":1,"飩 ":2,"蕎":3,"麦 ":4,"入":5,"麺と言った、\n和風麺系をメインに、油軽めのおかずとサラダといった風に構成。":6,"構成っていうか要するに、\n":7,"件のヴァイキング方式の食堂に来てるだけ。[l]\nただ何故か冬夏と宮さんまでが、\n僕と同じものを選んでるけど……":8,"冬夏はまあなんだかんだ言って、\n体型維持とか気にしてという意味もあるかもね、\nお年頃の女子だしね。":9,"バナナと茶漬けで多少は腹に入っていたとはいえ、\nほぼ丸１日食べてなかった僕は、\n無茶しない程度ではあるものの普通にそれらを食し、\n心身ともにほぼ全快したもよう。":10,"うーむ、\nやはり風邪の治りかけとは違う感じである事を実感する。":11,"病み上がりにしては食欲が普通過ぎる。":12,"僕だけかも知れないけど、\n今までは風邪程度でも結構食欲減退するので、\n今回は余程完璧に治ったのか、或いは病気じゃなかったか、":13,"真":14,"逆きぃの変な影響があるとか……[l]\n彼奴は彼奴でそれこそ今日はバリバリだったそうだし……":15,"そのきぃの見舞いに行った……既に昨日の事か、冬夏は、[l]\n終始僕の横で気遣ってくれてた。":16,"人事不省中に色々世話になってた事や、\nこの後、仕事の話で一緒に居られないという後ろめたさも手伝って、\n僕も宮さんの視線を気にしながら、\n彼女に積極的に対応していた……ような気がする。":17,"──あらゆることがうしろめたいくせに──":18,"久々に人と愉しく喋った気がして、\n夕食は皆で穏和に過ごせたと思う。[l]\n意味なく昂揚して、普段よりよく喋った。":19,"久々に言語野が刺激されたってことかな……[l]\n１度だけ携帯をチェックしてみたが、\n姫様ちゃんからの着信は未だ無かった。":20,"食事があらかた終わり、\n冬夏には今から仕事がある旨伝え、\n謝ると、":21,"「んー、残念だけど、分かったー。[l]\nあ、きぃがね、\nもう大丈夫そう。[l]\n真言さんにも御礼言いたいって、":22,"今度私と一緒に会えない？[l]\nまあ、\n御礼言いに行って逆に、\nまた何か奢らなきゃならなくなるかもだけどね、\nあはは」":23,"と提案された。":24,"「つーかまさにそこが目的じゃないのそれ、\n会うに":25,"託けてってさあ、\n全く彼奴ぁしょうがないな……別に良いけどさ」":26,"「ん、\nきぃは何かちゃんと御礼も用意してるみたいよ？」":27,"「へぇえ？[l]\n無理しなくていいのに……":28,"そんなの用意するくらいなら自分の食い":29,"扶":30,"持に\n回してくれた方がこっちも安心出来るんだけどな……[l]\nはっ、まさか」":31,"「お金で買えない価値のモノかもねー。[l]\nなぁーんでしょうねえ、\n肩叩き券とかかしらーあ」":32,"いや、なんでそんな眼で僕を！[l]\n別に邪な事を想像したりはしてません！":33,"「……まあ、[l]\nなんでもいいや。[l]\nケースバイケースで……」":34,"「で、どうしよ？[l]\n行ける？[l]\n行けない？」":35,"うーん、\nここで姫様ちゃん達の事を":36,"慮るのも、\n複雑な面倒が起こりそうだし、\nそもそも向こうの話もいつ来るか分からないし……":37,"という事で、\nやはりこのお方の指示を仰ぎます。":38,"「えーと……どうですかね？[l]\nあの、宮さん」":39,"「んむー？[l]\n構わないんじゃないですか。[l]\nあ、でもまあ今夜の報告次第で。[l]\n基本的にはだいじょぶでしょ」":40,"食後のお茶をすすっていた宮さんは、\nこちらを一瞬だけちらりと視て、あっさりそう応えた。":41,"「あ、そうですか、\n……だってさ」":42,"「あそ、じゃ、問題無ければ明日とかで良い？[l]\n日曜だし。[l]\nきぃには私から連絡しとくね。[l]\nあ、移動手段は……」":43,"「ああ、レンタカーあるし大丈夫、\n場所教えてくれれば」":44,"「………んと、[l]\nあ、どうぞどうぞ、お二人はごゆるりと～\nちと離席しまー」":45,"「はい？」":46,"「らじゃー」":47,"宮さんは昨日……じゃないもうその前だ、いい加減ややこしいな、[l]\nと、同じように、何処かへ立ち去った。":48,"また電話か何かか？[l]\n前回もどうだったか覚えてないけど……[l]\n普通にお手洗いかね。":49,"……だからいちいち詮索する事じゃないっての。[l]\n気にしすぎだ僕って。":50,"「………」":51,"何故かこっちをじーと視てる冬夏と眼が合った。":52,"「……な、なんでしょう？」":53,"「ん、\n手強いなーって」":54,"「はい？[l]\n何が？」":55,"「それはですね、」":56,"「のわ！！！！！」":57,"「……いや、説明は無粋ですねあまりにも。[l]\n私からは止しておきましょう。":58,"今店長に電話を取り次ぎに来まして──\n":59,"取り次ぎ？[l]\nとりつぎ……何か違うか……[l]\n":60,"まあ、どっちでもいいんですがそこは。":61,"ああ、":62,"此":63,"方初めてですね？[l]\n挨拶をしておこうと思い":64,"罷り越した次第です」":65,"僕等２人の死角から現れたチノ嬢が、\nいつもの口調でそう言った。[l]\n勿論、":66,"形":67,"貌もいつもの通りである。":68,"「ああああれ？[l]\n宮さんなら今さっき……[l]\nあ、そもそも宮さんの離席それが理由ですか？[l]\nというか、あれ、冬夏初めてだっけ？」":69,"冬夏はまだ動揺してるようで僕を視て、\n首をぶんぶん横に振った。[l]\nあ、あれ、そうだったか。":70,"「え、えーと、\nどうも、えー、\nえ、店長って？ことは？」":71,"「お察しの通り、\nこちらとは同僚です。[l]\nとは言えこちらが店長の下に来ましたのもつい最近、\nワタシもそれまで外つ國に居ましたのでね、":72,"同僚と言っても、\n必要以上に親密な訳でも支障がある程に険悪な訳でもありませんのでね、\n":73,"どうか御心配なく。[l]\nさて」":74,"ごほごほ、と、\nどこまで本気か判らない咳き込み方をして、\nチノ嬢は改めて冬夏に向き直った。":75,"「貴女の事は店長から伺っておりますので、\nこちらの自己紹介をさせて頂きますとね、\nワタシ、\n千野チノと申します。":76,"秘書……否、":77,"処":78,"務か？[l]\n敢えて言うなら──ああ、\n申し訳ありません、\n":79,"どっちでもいいんです」":80,"「は、あ……千野、さん？」":81,"やっぱ冬夏はこういうキャラに弱いか……":82,"と、チノ嬢は服の裾をつまんで、\n所謂『お姫様会釈』とでも言うべきあのポージングをし、\n冬夏を更に萎縮させる結果に。":83,"「……におきましてはご機嫌麗しう、[l]\n今宵は":84,"御":85,"拝":86,"謁":87,"賜りたく、\nという奴ですかね」":88,"「わ、たし、そんなんじゃ──」":89,"チノ嬢が何と言ったのか聞こえなかったが、\n冬夏も多分それどころじゃない。[l]\n否、オジョウサマ扱いに対してはあまり良い気分じゃない筈だから、\nもしかして気を悪くした──？":90,"察しが良いのが売りのチノ嬢にしては……[l]\nそれとも何か意味があるのか、\n別の意図なのかやっぱり他意はないのか──":91,"「まあ、そこはどっちでも。[l]\n問題無いですね？そうですね？」":92,"「──は、い」":93,"あれ？[l]\n僕の心配を":94,"余":95,"所に、\n特に問題無い事になってるな。":96,"「敢えて察しない事が功を奏する事も無きにしも非ず、\n役割としてそういうキャラが要される場も無きにしも非ず、\nそれがワタシかどうか、今ココなのかは別ですが、":97,"ま、\nそれはどっちでもいいんです。":98,"ともあれ何かありましたらね、\n今後ともよしなに。[l]\nでは。今戻ってくるでしょう店長も」":99,"「ああ、はあ、よしなに……」":100,"「お、お疲れ様です……」":101,"いつものようにすーっと立ち去っていくチノ嬢。":102,"「おまたー」":103,"入れ違いに戻ってくる宮さん。":104,"「お、おかいもんー」":105,"まだ困惑中らしい冬夏が迎える。[l]\nと言っても僕とて思考が明晰だった訳でなく、\n単にうかうかと状況に流されていただけです。":106,"「あ、あれ、今チノさんが電話がどうとか……」":107,"宮さんの椅子を引いてあげながら言うと、":108,"「んむ？[l]\nそうですよ。[l]\nそれで離席してたです。[l]\n最近お仕事が忙しくって……」":109,"え？[l]\nそれにしちゃ入れ替わりのタイミングが良過ぎやしないか？[l]\nてか宮さんの離席唐突だったじゃんよ。[l]\n報告来てから移動したとかじゃなかったでしょ？":110,"……まさかチノ嬢が僕等の死角からジェスチャーとか手招き的に合図してた？[l]\nだったらその後、わざわざ僕等に姿を現したんじゃ二度手間では……":111,"それと、\n仕事って、僕が辺りをうろうろする以外の内容、だよな？[l]\n何してるんだろ？":112,"どうせ本家絡みなんだろうけど、\nそっちの仕事は振ってくれないんだなあ。":113,"そういう中身なんだろうけど、\n忙しいて言うくらいなら少しは頼ってくれてもいいんでないかなあ……":114,"「状況が流動的でして。[l]\nまこくんにも苦労をかけてます、\n駄目な上司でごめんね、\nよよよ」":115,"「泣かした！」":116,"「は？！」":117,"冬夏、或る意味立ち直り早いな！":118,"「はうあ、ここで乗っかられても結構困る……」":119,"「あれ？」":120,"あれ？[l]\n宮さんそれ割と":121,"切ねぇ反応！[l]\nでも、\nここぞとばかりに僕も華麗にスルーしたい所存。":122,"「じゃ、その件はそこまで！以上！[l]\n僕は風呂に入ります！」":123,"「んむ、\nここは致し方なし、さあお行き！」":124,"「あれ？[l]\nあれれ？？」":125,"「ではおつかれでした！！」":126,"と移動しかけた僕の手首を、":127,"「──ちょいとお待ち？」":128,"がっしと掴む冬夏。":129,"「明日のきぃとの約束の事とかをぉー、\n調整しなきゃいけないでしょーう？[l]\nねえ？[l]\nウフフフ本気じゃないんだよね？":130,"折角話に乗っかろうとした私を、\nその私ひとり置いて行こうとしたのはね？[l]\nそうよね？":131,"このままじゃ私超恥ずいひとだもん、\nそんな非道いことするなんて、\nねえ私の誤解だもんね？[l]\n":132,"お二人さん？」":133,"………無言の圧力というよりも、[l]\n実質僕を椅子に座らそうとするチカラが腕に込められています。":134,"恥ずい行為をよくする割に、\nその反動も激しい冬夏さん、\n照れ隠しも入ってるからだと思いますが眼が血走ってます。":135,"……掴むチカラもそろそろ、結構鬼気迫ってきてます。":136,"「そ、そうす、こんな、ねえ、\n冗句っすよねえ？[l]\nねえ宮さん？」":137,"「……まあこの後ミーティングあるとは言え、[l]\n丸１日寝てた訳だし、\n何もしないでは今晩の寝付きも悪そうですしねぇ。":138,"も少しだけここで談笑してくのも良いかもですね、\nおほほほほ、\n":139,"あ、じゃあまこくん、改めてお茶でもみんなの分を」":140,"「あーい了解です少々お待ちを～」":141,"ずっと僕の手首を握ってた冬夏が、\nそこで":142,"漸くその手を離してくれまして、\n僕はドリンクのエリアへ向かおうとしてふと気付き、":143,"「えっと、温かいのと冷たいのどっちが……」":144,"「冷たいので」":145,"「は、らじゃー、わかりました」":146,"まさに猫舌？[l]\n関係ないか……":147,"立ち去る瞬間、\nうっすらと、\n二人のつぶやきがそれぞれ聞こえかけたが──":148,"流石…っても……の裔、……が強いというか何というか──":149,"…らいなあ……ったく……せつけないでよ……──":150,"どっちもよく判らなかったし、\n二人とも互いに気にしてないようだったので、\nそのまま放置してお茶を取りに向かった。":151,"四角のお盆に３つ冷えウーロン入り湯飲みを乗っけて、\n戻って来ると一体何の話をしてたものか、":152,"「":153,"先":154,"刻私テンパってさ、\n食べれる食べられるって言ったじゃない？[l]\nら抜き言葉ってさ、\nあれだよね、":155,"私":156,"等的にはさ、\n受動態の『られる』との差別化しようとして、\n自然に使い分けてたつもりなんだと思うんだけど。":157,"食べられるだとさ、\nライオンとかに食べられるぅ～って感じが、\nするでしょ？":158,"ガクジュツ的にどうかは知らないけど、\n使ってる当人としてはそんな感じ」":159,"と、\n":160,"俄にはよく判らない話題を唐突に振られた。":161,"「あ、お茶ありがとうです。[l]\n前にちょっとだけ調べたら、\n割と前から使用例はあったようですので、":162,"所":163,"謂若者の言葉の乱れと、\n一蹴してしまっていい問題とも限らないようですが」":164,"「何の話ですか二人して。[l]\nほい、冬夏」":165,"「ありがとー。[l]\nんとね、\nトラディションについて」":166,"「は？」":167,"traditionのこと？":168,"「伝統、しきたりですね」":169,"「や、し、知ってますよ。[l]\n何だってそんな話」":170,"彼女にとってそれって結構、\nデリケートな話題じゃないのかな。[l]\nそれとも冬夏から切り出したんだろうか。":171,"「大体伝統とかいうものはですね、\n秘されるモノだし、\n変化も……時に進化すらせず、":172,"ただただ継承し伝えられるから伝統なんですよ、\n基本的にはね。[l]\n時代にそぐわないとかもあるでしょうけどね、\n変えてしまっては意味はないんです。[l]\nあ、保守とか革新とか言うつもりは毛頭無いですよ。[l]\n……冬夏さん、ついてきてます？」":173,"「……たぶん。なんとか」":174,"僕も席に着く。[l]\n何やらチノ嬢ばりにカタリ出しそうな気配が──\nこの場合……に限らずだけども、":175,"果たして語りなのか":176,"騙りなのか……[l]\nそれが問題だ。[l]\nいや、どうでもいいか。[l]\nただの雑談だわな。":177,"「モノによっては秘されているという事実自体に、\n意味がある場合もありますしね。[l]\n古今伝授がどうとかという以前に、ほら、\n女子のはぁともね？":178,"男子にとっては知らぬが花、\n知った瞬間に……意味を成さないならまだしも、[l]\n幻滅したり、マイナス面が発生する事項もあるわけです。":179,"一子相伝とか、\nほんとに何かを伝授されてるとは限らない訳で。":180,"『お前が継承者』、\nという資格を与える為の":181,"約":182,"款、\n建前である可能性もあるのですよ。":183,"それを対外的に行う事で、そうだと示す、\n言わばポーズですね」":184,"内容的にも何か、\n真綿で首を絞めるような、\n遠回しに何か彼女を責めてるようにも聞こえるが、":185,"どこまで自覚的なんだか、\nそこまでは宮さんの顔からは読み取れない。":186,"……元より僕に人の顔色読むスキルは無いけども。[l]\n察するだの何だのは、\nそれこそ完全にチノ嬢の領域ですね。":187,"第一、\n基本的には何を言ってるのかよく分からんですよ。":188,"「秘されてる事に意味があるのは分かります、\nでもそのためにシキタリをつくって……[l]\n無自覚に……当人の了解も得ず……その」":189,"「んむー、\n言いたい事は何となく、\nただそれは少し話題のステージが違うというか、\n毛色の違う、矛先の違う話ですかねぇ」":190,"口を挟む空気でもなし、\n取り敢えず僕は黙って茶をすすった。":191,"その音に紛れて話題が変わったのか、\n連続した話なのか僕には判別つきかねたまま、\n宮さんはかたり続ける。":192,"「個人的意見ですけど、\nルールというのは、\n建前だし大義名分ですよ。":193,"当然の如くヒトがつくったものだし、\n場所時代で変動もしますしね、\n現状、殆ど真理実利に則ったルールというものはない……[l]\nと思いますけどねー」":194,"「そう言う事はなんかチノさんが前言ってたなぁ……」":195,"「んむ？[l]\nそですか。[l]\n大義名分というのは、\nもう文字通りだし面倒なので説明は省略！」":196,"と椅子に座ったまま背伸びをする宮さん。":197,"ここいらでお開きかと思いきや、\nしかし、話はまだ続くらしかった。":198,"「ルール……んむ、[l]\nルールはですね、":199,"禁忌のように、\n『ある事象が起きないように予防線を張る』\nという設計思想である事が多いので、":200,"しなければならない、\nよりは、\nしてはいけない、\nが多い感覚がないですか？":201,"これは『何故してはいけないのか』、\nと言う背景には、\nしてはいけない具体的な理由よりも、\nしたら":202,"拙い事がある故である事が割とあってですね。":203,"今さっき言ったように予防線、\nつまり闇雲に禁止してる訳ではないのですけれど、":204,"そこが忘れられると、\n『建前として語られる禁止している理由』そのものに違和感を感じて、\nルール自体を糾弾しかねないんですね。":205,"ところが、説明したようにですね、\n『そこ』に難癖を付けても、\n実は見当外れである事が多いです、ルール作成した側から視れば。":206,"しかしてヒトはルールの成り立ちを忘れる事もありまして、\n後代その意義が失われた時、糾弾に応じて改変される事もあり得る訳ですが、":207,"今いった成立事情の場合、且つ、\nその表出させたくなかった":208,"拙い事象がまだ生きている場合は、\n少々ややこしい事が起こる……事もあるという訳ですなー」":209,"な、長いですなー。[l]\n流石に口が渇いたか、\n宮さんは一気に茶をあおった。[l]\n冬夏は……神妙な顔をして黙って聞いていたようだ。":210,"「まままま、冬夏さんもそんな顔しないで、\nあくまで個人的見解として聞いてくださいよ？[l]\nちょっと話は違うかもですが、」":211,"そこで宮さんは何故か僕の方をちらっと視て、\nほくそ笑むような顔をしてから、\n話を再開する。":212,"「例えば本とかＤＶＤとかフィギュアとか──\n観賞用保存用予備用等々と、\n複数個おんなじモノを買う人間にとってはですね、":213,"揃ってる状態、処女地であることの、\nつまり完全に揃っている事の意味の為に、\n永久に、決して中身を視る事のない閉じられたハコにも、\n価値をみいだせている訳ですね。":214,"ハコにはハコとしての存在価値がある、\nとあるお方も仰っておられたようにですね、\nそこには実利的……読むとか観るとか遊ぶとか……[l]\nそう言った価値とは別の話な訳で、":215,"あ、\n勘違いしないで欲しいですが、\n実利的価値を認めないではないのです。[l]\nだからこそ観賞用というのがあるですからね。":216,"ただ、そうでない、\n『そこに一揃いある』という価値、\n『全てが揃ってる美しさ』、\nそう言った価値をみいだして、\n尚且つ、実際金銭を支払うものがいるという事実も知ってますね？":217,"だからですね、\n開けないなんて勿体ないとか、\n余ってるなら他人に譲った方が、とか、\nそういう次元の話じゃないですよ、わかるでしょぉ？":218,"なので、\n『こうした方が有意義だ』、\n『こうした方が無駄がない』、\nというアドバイスは、":219,"あくまでケースによりますけど、\n見当違いも甚だしい訳ですよね？":220,"なので、先程の話に戻りますが、\n伝統に対してですね、\nいかにそれが無意味そうで無駄の極致に視えても、\nそこは責め所が違う気がしますよね。":221,"ほら、\nこの國に限らず、\n祭、祭儀というものがあるでしょ？":222,"あれ、テレビでネタになるくらい、\n突拍子もないのも中にはあるわけじゃないですか。":223,"成り立ちには深淵な意味があったかも知れませんが、\n否、無くてもですね、\nそれを守り、\n継承し、":224,"続けていく事に意味があるが故に行っている行為に関しては、\n外部からの言葉、届くかどうか疑問である場合が多そうですけど。[l]\n論点がずれてるので平行線になるんでしょうね。":225,"あ、そうですね、\n要するに、伝統って、モノによるでしょうが、\n極端に言えば、\n約束事を守るゲーム、とでも言いましょうか。":226,"制約やお約束を破らずに行為を成す事に価値を見出す遣り方、\nという場合もあるんですかね。つまり。[l]\nと話してきてはみたものの、何事もこう、\n一概には言えませんからね、":227,"先刻言った通り、\n宮の、宮達の個人的見解という奴で、\n流し聞いてくれればいいのです」":228,"宮達って、あと誰？[l]\nこんだけ長広舌もふるってるし、その背景には、\n……チノ嬢か。":229,"如何にもあのひとの話そうな中身だし……[l]\nというか、まさか、\nこの会話全部チノ嬢の声帯模写じゃないだろうな。":230,"腹話術的な。[l]\n一応その辺視回したが、\n……流石に違うか。[l]\n居なかった。":231,"「──まあ、そういった訳で、\n伝統を守るべき意味、\nそれはあるひとにとってはあるし、\nないひとにとってはないんです。":232,"成立事情から維持の意思、\n運用の目的から価値観の決定的な相違、\nそこに妥協点は無いんです。":233,"だから、\n伝統行事とかそういうのに参加、加入したければ、\n理不尽に視えようと、\nそのルールには従わねばならないんです。":234,"問題は、\n冬夏さんの言ったように、\n意思とは別にその伝統に組み込まれた場合ですね。[l]\n世襲とか」":235,"冬夏が一瞬、\n身体を強張らせたような気がした。[l]\n長い話を座りっぱなしで聞いてたから、\n単に身体がびくっと":236,"痙":237,"攣したのかも知れないけど……":238,"「と、言うだけ言っておいて何ですが、\n宮でもその辺どう解決したらいいかは中々、\n考えが及びません。":239,"うひひ、そもそも、\n今話してた事の大半が、\n兄様の受け売りでして」":240,"え、お兄様がいらした？[l]\n初耳な気がするんですが……":241,"へえー、兄妹いたんだ。[l]\nそりゃあ全く知らなんだ。[l]\nさっきの宮『達』の『達』って、\n或いはその事かしら。":242,"それ以前に、":243,"長い！！":244,"「んむ？[l]\nそろそろいいお時間かな？[l]\n済みませんね長々と」":245,"口に出して言った訳じゃないが、\nどうやら宮さん自身もそう思っていたらしく、\n話を切り上げた御様子。[l]\n今夜はお開きかな？":246,"「……あ、いえ、[l]\n知り合いに同じくらい長くてややこしい話するひと、\n居るから……[l]\nあ、別に悪いって言ってる訳じゃないんでその」":247,"「うひひ、分かってますよぉ。[l]\nじゃ、ちゃちゃっとお二人さん、\n本題の方を。":248,"そしたらまこくんお風呂行って、\nその後お仕事の打ち合わせということで」":249,"「はぁ、分かりました」":250,"「んー、\n真言さん、\n流石に今晩、お風呂一緒は無理よね？」":251,"「え？！[l]\nあ、いや、その、\nは？！」":252,"「ん、\n明日のきぃとの事も、\nついでにそこで話し合おうかなーとか、\n思ったんだけど。":253,"前は一緒にお風呂入れなかったし」":254,"「え、いずれご一緒するって話でしたっけ……？」":255,"マタアトデネとは言ってた気がするけど……[l]\nよもやそう言う意味とは思いませんですがな。":256,"「あによ、\n迷ってないでいってくればいいじゃん、\n":257,"いってきなよーまこくぅん」":258,"「ん、\nそーしよう。[l]\n":259,"準備してきまーす♪」":260,"「えええええーーー？！[l]\nちょ、ま、」":261,"ってくれる筈も無く、冬夏はさっさと席を立ち、":262,"「真言さんの部屋に行くから部屋で待っててー」":263,"と言って食堂をつついーっと出て行ってしまった。":264,"……宮さん、[l]\nどうしてくれるよ。":265,"「ほんとに大胆だなぁ冬夏さんてば。[l]\nまこくん愛されてるーぅ」":266,"白々しく言いながら僕の脇腹をつつかれても、\nその、\nどうにもならんだろ。":267,"「あのですね……[l]\nえ？[l]\nほんとに行ってこいと？」":268,"「だって冬夏さんはもう動いちゃってますが。[l]\n賽は投げられた、覆水盆に返らず、\n毒を食らわば皿まで、えーと、":269,"ま、女子の側が拒否ってないんなら別にねえ、\nまこくんが遠慮する事ぁないでしょぉ？[l]\nえー、据え膳喰わぬは何とかかんとか……」":270,"「……僕がそんなキャラに視えます？」":271,"「んむー、ノーコメント」":272,"何故ここでどっちつかず？":273,"「まこくんは水着持ってるし、\n冬夏さんもこないだ買ったから問題なっしんぐです」":274,"「問題はそこじゃない気が……」":275,"「んむー、\n女子がああまで言ってきたのに、\n逆に失礼とか思ったりはしないんだ？":276,"私って魅力ないのねよよよ、\nとか泣かれても良いんだ？":277,"義理でも社交辞令でも何でも良いですから、\n相手を気遣う事を考えないとねー、\n女子相手なら尚更、ですことよ？」":278,"だから貴女に言われても、\n今ひとつああそうですかと素直に納得し難いのよね。":279,"「ぼ、僕は本心と本心のぶつかり合いをモットーとしてます！":280,"しょ、しょうがないんでじゃあ行ってきますけど、\n……う、打ち合わせの時も、[l]\n入浴時に関しての詳しい報告しませんからね。[l]\nじゃ覚悟は決めましたんで……さっくり逝って参ります……」":281,"「…なんかひっかかりますけど、[l]\nお風呂上がったら宮の部屋に集合ー。[l]\n必要な物あったら持参して来てくださいな。[l]\nんじゃー、いっ、てらっしゃ～い」":282,"何そのイントネーション。":283,"宮さんはもうちょっと茶をすするとか言ってその場に残り、\n僕は冬夏が来る前に部屋へと戻ることにした。":284,"はあ、気が重い……っていうのも失礼だけんども、[l]\nその、\nあの夜のあの意思表示があったその後に、\n二人で風呂って言うのは、":285,"どういう空気になるよ？":286,"いっそ宮さんも込みで３人ならまだ──":287,"「……いかんいかん、[l]\n………。[l]\n……いかんいかん」":288,"僕は無心で部屋へ向かった。":289,"「ふひーー、\nこれぁ、\n気持ちいいったらないなあ」":290,"風呂から上がり脱衣場から出ると、\n心地よい冷気でさっぱりした気分に包まれる。":291,"結論から言うと、\n明日の時間と場所だけこっち２人で仮に決めて、\nあとは冬夏が風呂上がってからきぃに連絡、\n確認してから改めて最終決定案を僕に伝える、":292,"という何か二度手間的な事を──否、\nまさに二度手間三度手間な中間処理をするという事で、\n調整は終了した。":293,"冬夏も一体何がしたかったんだか……って、[l]\nはい、約束通り入浴時の詳しい描写は無し！[l]\n不純異性交遊禁止！":294,"いやだから何もないですって。[l]\nほんとうです。":295,"まあ、実際それどころではなく、\n姫様ちゃんとバッティングしたらどうすべえ……":296,"とか懸念もあったけども、\nこればっかりは、\n向こうの都合次第なのでどうすることも出来ぬ。":297,"開校記念日の休日とかに来るかもしんないし、\n……冬夏もその日何かしたがるかもしんないけど、":298,"うーん、\nそういう人間関係は苦手だなあ……[l]\n単に人付き合いが少なすぎて経験値が無いとも言う……":299,"それはさておき、\n格別資料とかもないので、\n冬夏を部屋に送った後、連絡後でくれるという約束をして、\n宮さんの部屋に向かった。":300,"先日の夜の記憶があったので、\n何となく気後れしながらノックすると、":301,"「おっかえりなさ～い。[l]\nどうぞご遠慮なく～」":302,"「……またチノさんですか？[l]\n──ほれ、やっぱり」":303,"いつもと違う格好──当たり前っちゃ当たり前だが──の、\nチノ嬢が入り口で出迎えてくだすった。[l]\nただやっぱりマスクはしてるんだけども。[l]\nということで当然、先程のは彼女の声帯模写です。":304,"「毎度ご苦労様です……」":305,"「いえいえこの程度。[l]\n御陰様で最近羽目を外す機会が多くて愉快ですよ。[l]\nではどうぞ」":306,"部屋の中に入ると、\n宮さんが手をひらひら振って出迎えてくれた。[l]\nチノ嬢は隣に居ますのでと言って、\n襖の向こうに行って、ご丁寧に襖もがっつりお閉めになる。":307,"僕が座に着くと宮さんが口を開いた。":308,"「さて！[l]\n……なんか久々ですね。":309,"ちょっとこっちもばたばたしてまして。[l]\n色々放置してて済みませんでした。[l]\n──何か、待ちきれなくて切ない想いをさせちゃってたみたいで」":310,"「……細かいニュアンスの差異は兎も角、[l]\nそこは否定しませんよ。":311,"何気に僕ぁ、\nすっかり貴女にいいように調律されてるんですから。[l]\n下僕の身にもなってください」":312,"「うひひ、\n自覚が出て来たようで何よりですね。[l]\nじゃあ早速御主人様に報告なさい」":313,"……いかん、[l]\nこれは思ったより悪くな……":314,"いや！[l]\nちが！！[l]\nそんなはず！！！":315,"げふんげふん。":316,"「まず、\n……何でしたっけ？":317,"ああ、あの蔵の話からですか？[l]\nそもそもあの紙どうでした？[l]\n役に立ってますんでしょうか」":318,"「そですね。[l]\nだいぶ調べは進んでます。":319,"それであの蔵の中、\n前の時は詳しく聞かずに話切り上げちゃったんですが、\n何か、報告するに値する、\nおかしな出来事ありませんでしたか？」":320,"「あの……中でですか？[l]\nええーと、\n最近妙に記憶の巡りが良いんで、\nちょっと待ってくださいよ……」":321,"道中、\nここ最近言ってるような、\nおかしなものを視た気がする。":322,"蔵自体が、\n隠し部屋があったりと、飯窪本家の地下と構造が近しかった。":323,"インクや墨のにおいがあまりせず、\n古書が集められた空間にしては違和感があった。":324,"冬夏の言から推測して、\n其処には本来、御神体が在ったはずなのに、\n冬夏も知らないうちに移動されていたかも知れない。":325,"そういった事を、\n今までの僕にしては驚異的な記憶の蘇りによって、\n簡略にまとめながら説明、報告していく。":326,"逐一ふむふむ頷く宮さん。":327,"そして、":328,"不気味……否、奇妙な鳴き声がした。":329,"あの事を口にすると、":330,"「それは何か……獣のような？[l]\nそれともヒトのような？」":331,"と、他と比べてやや大きめのリアクションが返ってきた。":332,"「そうですね、発情期の猫のような、\nヒトみたいな、何とも判別付きかねる声、或いは音でしたね。":333,"冬夏の知る限りじゃ家でも飼ってないそうですから、\n猫だとすれば野良猫、\n違うとしても":334,"逆ＵＭＡ的な何かってことは、あ」":335,"「？」":336,"「その謎動物で思い出した。[l]\nスナトノホウシの……[l]\nあの神使八乃舞の後片付けの手伝いの報告まだでしたね？」":337,"「んむ、そでしたね。[l]\nあの時はまこくんが冬夏さん同伴で戻って来たのですっかり……":338,"ではえーと、\nそのスナトノホウシの手伝いの報告をおし！」":339,"思い出したようにそんな物言いしなくても……":340,"「分かりました御主人様。[l]\nええと」":341,"「あっ！！」":342,"「なっ、なんですか？！」":343,"「御嬢様の方が良いかなあ。[l]\nまこくんも執事の方が良くない？[l]\nよくよくない？":344,"ぁあっ、そだ！！[l]\nいっそメイドて言う方向もアリか……[l]\nチノをメイド長としてみっちり教育を……うひひひひ」":345,"女装ネタはもうええちゅうねん。":346,"「……いっそ下僕で、[l]\nもう潔ぎよくそれでお願いします」":347,"「あーによー。[l]\nそんな事言われたらこっちも遠慮出来なくなっちゃうし？[l]\n":348,"迂":349,"闊なことは言わぬが吉ですよー」":350,"「……どうせ執事でもメイドでも、[l]\nこの場合大して立場が変わらないかと」":351,"「どーゆー意味です？[l]\nあー、宮をそー視てるんだまこくんてば？":352,"てか、\nこないだの夜這いといいさっきのお風呂といい、\n宮の知らない内に、\n冬夏さんに言い寄られたりしてたんじゃないのかな？":353,"あの":354,"娘ってば結構大胆だし、\n視たところ完全にまこくんに気があるぞと、\nそういうオーラばりばり出してましたけど」":355,"「えあ？！[l]\n夜這いなんてされてないです！！[l]\nいやまあ、\nいろいろお話はしたですけど……":356,"やややや、\n寧ろ貴女が焚き付けたんじゃないんか、って思ってましたが」":357,"「まままま、まー、まー。[l]\n別にね、宮にね、遠慮なんかしなくっても良いのよ？":358,"いっちゃっても良いのよ？[l]\nえっ、いくって言ってもほら、\nまこくんてばっ、なに言わそうとしてるですかもうー」":359,"「……なんか":360,"漸くいつも通りの貴女を[l]\n視られた気がしますよ。":361,"僕を":362,"弄ろうとする意図がぶれてないだけで、\n言ってる内容が完全に支離滅裂です。[l]\n本題にいきましょうよ本題に」":363,"「んむーっ、\n台本ある訳じゃあるまいし、\nリアル会話がそうそう破綻無く成立してる":364,"例なんて無いですよ！":365,"あ、こないだ貰ったお土産、\nまだ開けてないので。[l]\n食べましょうか」":366,"「土産、ああ、ねこしっぽ何とかですか」":367,"もはやこれは休憩モードですね、\nはいはい開けますよ……ってどこだ？[l]\n冷蔵庫？":368,"「そですー。[l]\n勝手に持って来ちゃってたですが。[l]\n駄目だったかな？」":369,"「いえそんなこと、\n全く問題無いです」":370,"「うひひ、優しいね」":371,"んむ、そんなだから──":372,"「んむ？[l]\nいあいあ何も？」":373,"「あーそうすか。[l]\n最近じゃもう貴女の幻視幻聴やら、\n記憶の侵蝕やらが始まってましてね。[l]\nもう何が現実で何が妄想なんだか……」":374,"「うを？！[l]\n":375,"おおう、そそそ、そーか、\nそんなにかー……[l]\nどうしたもんかな」":376,"えーとどれだどれだ、\nあ、これか。":377,"……一応、酒の類は無いな。[l]\nあったら怖ぇけど……[l]\nって、いま何か言ってたか？":378,"「はい？[l]\n度々申し訳ありませんが、\n包装紙剥いでたんでぜんっぜん聞こえないんすけど。":379,"兎も角、今持っていきますっ……て、[l]\n茶請けだけじゃ駄目っすよねぇ、\nお茶とかどうしますか？」":380,"「んむ、コーヒーくらいは宮が直々に入れたげましょう。[l]\n折角の下僕のお仕事奪うのも気が引けますが、\n":381,"有り難く戴くがいいですようひひ♪」":382,"「……砂糖と別の何かをベタに間違ったりしないでくださいよ」":383,"「んむっ。[l]\nそんな甘味調節なんてセルフでやるでしょ当然でしょぉ？[l]\n味の趣味なんて完璧、人それぞれですもぉん。[l]\nそこの自主性を侵害する女子に視えますぅ？」":384,"……なんかやっぱり、[l]\nそういう台詞を貴女に言われると納得が行かないと言うか、\n素直に『そうは視えません』、とは言い難いなにかが。":385,"「ふんだ。[l]\nいーですよ。[l]\n":386,"まこくんどうせ冬夏さんが居るから宮はどうでもよくなったんだぁー。[l]\nいじいじいじいじいじいじ」":387,"「拗ねないでくださいって……":388,"まだ冬夏には何もその、返事的な事は言ってないし、\n大体、ここんとこ、\nそっけなかったのはそっちでしょうが、\nその、あ？」":389,"「……にひひ」":390,"何をどうとは判らねども、\nどうも墓穴を掘った気分に！":391,"あくまで気分ですよ、だって墓穴を掘るって事は、\nこの場合は……":392,"「にひひひひ♪」":393,"「なんすかその笑いは。[l]\n……ああもうとっとと続きしますよ。[l]\nはいこれ、じゃコーヒーお願いしますからっ」":394,"「はぁーい旦那様♪\nちょっと待ってねー」":395,"今度はそっちがメイド？":396,"──なんだろう。[l]\n少し前までは、こういう距離が当たり前だったような、\nいや、そんなに知り合ってから長い訳でも無かろうに、":397,"でも、\nこんなやりとりでも、\nちょっとの間でも出来なかったときは、\n何故か、":398,"……まあ、なんだってそうだろう。そうだよな。[l]\n別にあのひとに限った訳じゃ──":399,"「──で、本題です。[l]\nスナトノホウシに向かう途中、\nあの彼女等の斎場とかいう私有地だったかな？":400,"その山道の中でですね、\nでっかい獣らしきものが車の上にどすっと」":401,"「……んむ？[l]\nケモノ？？」":402,"コーヒーカップを２つ持って来た宮さんが自分と僕の前に\nそれを置きながら疑問符を投げかけた。":403,"「結局何だか分からなかったんですが、\n少なくともヒトかそれ以上の重量を持ったものが、\n車の天井に落ちてきて、それで」":404,"「視なかったんですか？」":405,"土産物を食べ始めた僕に対し、\n詰問するように宮さんが言う。":406,"「や、だって僕運転してましたから。[l]\n突然上がだんって鳴って、\nすぐそれもどっかに飛んでったらしく居なくなったんですよ。[l]\nそしたら」":407,"「綾目と狩屋が追跡でも？[l]\n奇士もかな？」":408,"「は？[l]\nあ、いえ、ほんとにそうです、\n奇士……道具さんは僕と車に居ましたが、[l]\n２人はそれを追いに出て行きました。":409,"それがよくわからんのですが、\nあの２人は、『その為』に居るとかなんとか──」":410,"「………２人は無事に戻って来た？[l]\nでしょうね」":411,"「え？[l]\nええ、逃げられたとかで、\nその後は普通にその斎場まで、\n何事もなく。":412,"僕は心配でしたが、\n彼女等にとっては何か当然みたいな振る舞いしてたので、\nそんなに深刻じゃないのかと、それに」":413,"「それに？」":414,"「ほんとかどうか疑問に思う点が無いでも無いですが、\nこれもつい":415,"刻眼が醒めた直後の話ですけど、":416,"奇士道具さんからリーク情報で、\n月末の祭は、\n予定通り行われると。":417,"その理由が、その時遭遇したケモノがどうやら熊とか何とかで、\nその死骸があげられたからだって言うんですね。[l]\n実際狩ったのかな？[l]\nそこまでは聞いてなかったような」":418,"「……んむ。[l]\nなるほどね……同行したまこくんにそれを言うか……[l]\nどういう了見だろうな……？」":419,"「……？[l]\n宮さん？」":420,"「んむ？[l]\nなんでもないですよぉ。[l]\nそか、なるほどなるほど」":421,"……？":422,"祭がどうあれ強行されるだろうと言ってたのは、\n確か宮さんじゃなかった？[l]\n別のひとだっけか？":423,"「んむ、\nじゃあそろそろ覚悟決めて貰おうかなあ」":424,"そだな、現状いくつか選択肢があるから……":425,"まだ完全ではない、\n僕の記憶領域の曖昧な働きを余所に、\n宮さんは確かに今そう言った。":426,"「はあ。[l]\nいくつか」":427,"幸か不幸か、順調に仲良く……というか交流は深まってるけれど、[l]\n肝心の所には今ひとつ近づいてないというか、":428,"その、蔵の紙の調査は進んでるようだが、\n最も対象に近いはずの冬夏でも分からない以上、\n最早祭の当日、祭儀に潜入以外ないんではなかろうか。":429,"「まあ、今日話を聞いて、あ、蔵の中とかのです、\n大体視えては来てるんですけどね。":430,"んむー、\n一番愉快そうなのはぁ、\n冬夏さんを完全に懐柔……てゆうか、[l]\nまあ":431,"娶っちゃえば一発で解決？":432,"あ、ちがうか、婿入りしなきゃ駄目だ。[l]\n三春真言、ＭＭ……ぷひひっ、":433,"……ってごめごめ、[l]\nまこくんの気持ちってものもあるしねー。[l]\nわかってるってば、そんな眼で視ないでよぉ」":434,"「いや別に僕おかしな眼で視た覚えはないですが……[l]\n僕のよりも冬夏の気持ち考えてあげてください、\nあんな事さしたり、\n彼女も家庭の事情で色々悩んでるんですから……」":435,"それに、":436,"貴女は僕の気持ちなんか、全然わかってないですよ。":437,"全然わかってない……":438,"「んむー、\nまこくんってばお真面目さんだなぁ。":439,"ま、実際、今ばたばたしてますのはね、\n『こっち側』の事情が少々動いてまして、\nそっちの調整なんですよね。":440,"だから取り敢えずまこくんは明日西石さんとやら……[l]\n……ニシイシ？」":441,"「え？[l]\nああ、そうです、きぃの快気祝いの名目で飯奢ってきたり」":442,"………？":443,"なんだこの":444,"間は？":445,"「………きぃ、[l]\nをつけて行ってきてね？[l]\n":446,"呉":447,"呉も油断しないように」":448,"「油断て……[l]\nまあ、確かに油断したら飯代だけで幾ら飛ぶか分かんないですけど、\n無い袖は振れないという奴でそこは何とか」":449,"「そんなに食べるひと？[l]\n女子で？」":450,"「言ってませんでしたっけ。[l]\nそうですよ。[l]\n":451,"今日":452,"日珍しくないでしょ、\n女子の大喰いなんて……」":453,"「それもそうですねぇ。[l]\nんむ。[l]\n──じゃ、色々詳細が決定していくのは多分、\n週明け以降になると思うので」":454,"今日はゆっくりお休みなさい。":455,"「……今からでも僕、[l]\n部屋に戻りましょうか？[l]\n何か調子も戻って来たし……その……」":456,"「いーのいーの、\n上司として部下の体調の経過観察をですね、\nん？[l]\n体調管理？":457,"まーどっちでもいいですね。[l]\nそういうことで。[l]\n良いですよ、今晩は泊まってって」":458,"「普通の会社でもそんな管理はしないような気が、\nしないでもないですが……」":459,"「女子が今夜は泊まってって言ってるんだからぁ、\n大人しく泊まってけばいいんです。[l]\n将来ほんと苦労するよまこくん。":460,"あ、丁度胃に物が入ったところで、\n風邪薬も念のため、はい。[l]\nもう歯磨いた？[l]\nお布団は……チノ？」":461,"「用意は出来てます。[l]\n今問われるより":462,"遡ること……否、[l]\n止しましょう具体的な時間経過を言うのは。[l]\nそれよりワタシもその土産物のお相伴にあずかりたく」":463,"いきなり宮さんが隣室に声を掛けると、\n音もなく襖が開きチノ嬢がそう言った。":464,"そ、そう言えば\nい、居たんでしたね？[l]\nずっとそこに。":465,"土産をまず所望するとは、\n結構お腹が空いてたのか……[l]\nそんなに話し込んでたのか僕等。":466,"「あっと、寝る前に冬夏に明日の確認取らねばですよ」":467,"「んむ、\n冬夏さんが寝ちゃう前にどぞ。":468,"まあこの部屋で寝るとは──\n言わない方が良いでしょうねえ流石に。[l]\n宮も彼女に申し訳ないしー」":469,"今更何を……というよりですね、[l]\n僕だって自分から言う気は毛頭無いです。":470,"貰った風邪薬を飲む。[l]\nチノ嬢は自分でコーヒーをいれ、\n例の土産を食そうとして、\nふと気付いたようにこちらを視た。":471,"「──ああ、\nマスクの下、視たいですか？」":472,"「へ？[l]\nああ、いえ、そんな、\n特に、というか、積極的に視たいとまでは……」":473,"まあ、そのまま視てれば、\n食べる時外すであろうマスクの下は視られたんだろうが、\n今言ったようにそこまで気になってる訳じゃないし……[l]\n何よりもその、何か視てはいけないものの気がする……":474,"「そうですか……それは残念」":475,"「あ、じゃあ僕は冬夏に連絡してきますのでごゆっくり……」":476,"視ないでいるのも不自然で疲れそうなので、\n部屋から出ることにした。":477,"──電話したら冬夏はもうかなり眠そうだったが、\n明日の予定については確認出来た。":478,"その眠気の御陰か、今夜は会話もあっさり切り上げられて、\n若干の、若干のだが、肩すかし感を覚えつつ、\n部屋に戻……ろうとして、":479,"一応チノ嬢が食べ終わってそうな頃合いを見計らう為、\n５分ほどうろうろする。":480,"「おかいもんー、\nもういつでも寝られるよぉー。[l]\n歯磨き忘れずにねー」":481,"部屋に戻るとそう言われた。[l]\n幸いチノ嬢は既に食し終え、マスクも再装着済。":482,"「歯ブラシとか、\nこの部屋でも僕の分残ってます？」":483,"「問題は無いです。[l]\nワタシは自分の部屋より確保してますので」":484,"「わかりました……では準備しますー」":485,"時間を稼いだ所為か、風邪薬が良い具合に効き始めて、\nすぐにも眠れるモードに。":486,"或る意味幸いだろう、\nこの状況で眼が冴えるよりはいい。[l]\n……コーヒーの後で薬ってよくよく考えるとどうだ。":487,"歯磨きを終え用を足し、\n２人に就寝の挨拶をする頃には、\nもうすっかり朦朧としだしていた。":488,"ぎりぎりに保った理性で、\n明日の約束の時間に間に合う目覚ましアラームを設定、":489,"かつ２人にその了解を得、\n布団に入ると、\n宮さんが電気を消してくれた。":490,"「では……[l]\nおやすみなさい……」":491,"\n心地よい浮遊感と共に、[l]\n\n眠りへ落ち行く意識のはしっこに、[l]\n\n何かことばがきこえていたような、":492,"\n──ね、\n\nまこくんは私の下で働けるの、嬉しい？[l]\n\n今のこういう感じって嬉しい？[l]\n\n私のこと●●？[l]\n\nほんとうに、●●？●●？●●●●？[l]\n\n偽りナく──？":493,"\nぼくは、[l]\n\nへんじをすることもままならず、[l]\n\n\nみやさんのこえに……まさかチノ……てことはないよな……":494,"\n\nつつまれて……":495,"\n\n\nあんし……てねむ……":496},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_044.ks","relPath":"/data/scenario/SC_M_044.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":492,"length":497,"percent":98.99396378269618},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[352,1]},"/data/scenario/SC_M_045.ks":{"data":[["結局貴女は、\n@r──こちらをどう想ってる。","说到底你，\n@r──究竟怎么看待这边。"],["何とも思ってないなら、\n@r──良い迷惑だ。","如果完全不在意的话，\n@r──真是够麻烦的。"],["揶いやリップサービスや社交辞令なんか要らない、\n@r──そんなものは、","客套话场面话社交辞令统统不需要，\n@r──那些东西，"],["こっちが傷付こうが何だろうが、気を遣わないで、本心を、\n@r──誰も得をしないぞ。","就算这边会受伤也无所谓，别顾虑了，把真心话，\n@r──谁都不会好过的。"],["そして興味がないならもう構わないでください。\n@r──間怠っこい真似をするな。","要是没兴趣就别再管我了。\n@r──别做令人烦躁的事。"],["待たせたり、気を持たせないでくれ。\n@r──中途半端な距離感は余計な喪失感を煽るに過ぎない。","别让我等待，别给我期待。\n@r──半吊子的距离感只会徒增失落。"],["下手に箱をつくると、埋まらない空白が余計に僕を苛むから、\n@r──十割必要な者に対しては二割も九割も等しく無意味だからな。","擅自划定界限的话，无法填补的空白会加倍折磨我，\n@r──对于需要百分之百的人而言，两成和九成都同样毫无意义。"],["越えられない一線が、破れない壁が、あらゆる障害がニクくなる、\n@r──気遣いが自身に恩着せがましい感情を生み、","越不过的界线，打不破的墙，所有障碍都变得可憎，\n@r──顾虑反而会让自己产生施恩般的傲慢情绪，"],["それくらいならハコなんて、\n@r──其方も此方も、互いに負の感情をぶつけ合う結果になるぞ。","要是那样还不如干脆，\n@r──彼此都会向对方倾泻负面感情。"],["そんなもの最初から要らなかったのに、\n@r──要らぬ気遣いは無用、所詮傷付け合わずに済むほど","这种东西从一开始就不需要，\n@r──多余的顾虑毫无意义，反正只要不互相伤害"],["温いセカイでも無かろうが。","这冷漠的世界也不会变温暖。"],["でないとハコごと無かった事にする為に、\n@r──妥協点を模索するなぞ有り得ない。","否则为了把界限当作不存在，\n@r──根本不可能寻找什么折中点。"],["トモダチの距離感では辛すぎるから、届かないものを近くで視るのは辛いだけだから、\n@r──零か百か、","朋友的距离感太痛苦了，看着触不可及的东西近在眼前只会更痛苦，\n@r──零或一百，"],["白が如き足らぬは","像白纸般的不足是"],["有","在"],["耶","耶"],["無","无"],["耶。","耶。"],["貴女を忘れる為に『キラウ』事になる、それだけは、\n@r──だから、","为了忘记你可能会『杀掉』，只有这件事，\n@r──所以，"],["だから、\n@r──早く、","所以，\n@r──快点，"],["早く、\n@rせめて、せめて、","快点，\n@r至少，至少，"],["「………てください」","「………拜托了」"],["めざめると、\n@r涙が。","醒来时，\n@r泪水。"],["どうやら、\n@r泣いていたようだ。","看来，\n@r似乎哭过了。"],["夢を視ていた。","做了个梦。"],["とても、\n@r厭な夢だったきがした。","总觉得，\n@r做了非常讨厌的梦。"],["とても、\n@r気分が悪い。","感觉，\n@r非常难受。"],["とても、\n\n悲しくてまた世界が涙で歪んだ。","觉得，\n\n悲伤得整个世界又因泪水而扭曲。"],["なんて、\n\n\n\n荒ぶる","多么，\n\n\n\n狂暴"],["猥なのだろう。","下流啊。"],["\n\n……なんだそれは？","\n\n……什么啊这是？"],["「……気持ち悪」","「……好恶心」"],["布団から出て思い出した、此処は宮さんの部屋。","钻出被窝才想起这里是宫小姐的房间。"],["そっと襖を開けると、\nチノ嬢は既に居ないようだったが、\n宮さんらしき人影が毛布にくるまって寝ていたので、\n起こさないように部屋を出る。","轻轻拉开纸门，\n千乃小姐似乎已经不在，\n但有个像是宫小姐的人影裹着毛毯在睡，\n便轻手轻脚离开房间。"],["携帯電話を確認すると、\n丁度アラーム鳴動する２分前だったので慌てて解除し、\n自分の部屋に戻った。","查看手机，\n正好是闹铃响前的两分钟慌忙取消，\n回到了自己房间。"],["何だろう、","怎么回事，"],["何か、","为什么，"],["何でこんなに、","为什么这么，"],["気持ちが悪いんだろう。","难受呢。"],["何でだ……","为什么啊……"]],"context":[["SC_M_045.ks/index/1/text"],["SC_M_045.ks/index/3/text"],["SC_M_045.ks/index/5/text"],["SC_M_045.ks/index/7/text"],["SC_M_045.ks/index/9/text"],["SC_M_045.ks/index/11/text"],["SC_M_045.ks/index/13/text"],["SC_M_045.ks/index/15/text"],["SC_M_045.ks/index/17/text"],["SC_M_045.ks/index/19/text"],["SC_M_045.ks/index/21/text"],["SC_M_045.ks/index/23/text"],["SC_M_045.ks/index/25/text"],["SC_M_045.ks/index/27/text"],["SC_M_045.ks/index/29/text"],["SC_M_045.ks/index/31/text"],["SC_M_045.ks/index/33/text"],["SC_M_045.ks/index/35/text"],["SC_M_045.ks/index/37/text"],["SC_M_045.ks/index/39/text"],["SC_M_045.ks/index/41/text"],["SC_M_045.ks/index/43/text"],["SC_M_045.ks/index/45/text"],["SC_M_045.ks/index/47/text"],["SC_M_045.ks/index/49/text"],["SC_M_045.ks/index/51/text"],["SC_M_045.ks/index/53/text"],["SC_M_045.ks/index/55/text"],["SC_M_045.ks/index/57/text"],["SC_M_045.ks/index/59/text"],["SC_M_045.ks/index/61/text"],["SC_M_045.ks/index/63/text"],["SC_M_045.ks/index/65/text"],["SC_M_045.ks/index/67/text"],["SC_M_045.ks/index/69/text"],["SC_M_045.ks/index/71/text"],["SC_M_045.ks/index/73/text"],["SC_M_045.ks/index/75/text"],["SC_M_045.ks/index/77/text"],["SC_M_045.ks/index/79/text"]],"tags":[],"parameters":[[{"start":155,"end":183}],[{"start":191,"end":219}],[{"start":238,"end":279}],[{"start":287,"end":334}],[{"start":342,"end":387}],[{"start":397,"end":449}],[{"start":459,"end":526}],[{"start":536,"end":597}],[{"start":605,"end":656}],[{"start":664,"end":716}],[{"start":726,"end":739}],[{"start":747,"end":793}],[{"start":801,"end":856}],[{"start":867,"end":875}],[{"start":885,"end":886}],[{"start":895,"end":896}],[{"start":906,"end":907}],[{"start":916,"end":918}],[{"start":926,"end":965}],[{"start":973,"end":991}],[{"start":999,"end":1019}],[{"start":1095,"end":1105}],[{"start":1137,"end":1155}],[{"start":1163,"end":1186}],[{"start":1194,"end":1201}],[{"start":1209,"end":1233}],[{"start":1241,"end":1260}],[{"start":1268,"end":1297}],[{"start":1305,"end":1332}],[{"start":1342,"end":1349}],[{"start":1357,"end":1376}],[{"start":1421,"end":1429}],[{"start":1486,"end":1508}],[{"start":1516,"end":1595}],[{"start":1603,"end":1659}],[{"start":1667,"end":1672}],[{"start":1680,"end":1683}],[{"start":1691,"end":1698}],[{"start":1706,"end":1717}],[{"start":1725,"end":1730}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_045.ks","basename":"SC_M_045.ks","indexIds":{"結局貴女は、\n@r──こちらをどう想ってる。":0,"何とも思ってないなら、\n@r──良い迷惑だ。":1,"揶いやリップサービスや社交辞令なんか要らない、\n@r──そんなものは、":2,"こっちが傷付こうが何だろうが、気を遣わないで、本心を、\n@r──誰も得をしないぞ。":3,"そして興味がないならもう構わないでください。\n@r──間怠っこい真似をするな。":4,"待たせたり、気を持たせないでくれ。\n@r──中途半端な距離感は余計な喪失感を煽るに過ぎない。":5,"下手に箱をつくると、埋まらない空白が余計に僕を苛むから、\n@r──十割必要な者に対しては二割も九割も等しく無意味だからな。":6,"越えられない一線が、破れない壁が、あらゆる障害がニクくなる、\n@r──気遣いが自身に恩着せがましい感情を生み、":7,"それくらいならハコなんて、\n@r──其方も此方も、互いに負の感情をぶつけ合う結果になるぞ。":8,"そんなもの最初から要らなかったのに、\n@r──要らぬ気遣いは無用、所詮傷付け合わずに済むほど":9,"温いセカイでも無かろうが。":10,"でないとハコごと無かった事にする為に、\n@r──妥協点を模索するなぞ有り得ない。":11,"トモダチの距離感では辛すぎるから、届かないものを近くで視るのは辛いだけだから、\n@r──零か百か、":12,"白が如き足らぬは":13,"有":14,"耶":15,"無":16,"耶。":17,"貴女を忘れる為に『キラウ』事になる、それだけは、\n@r──だから、":18,"だから、\n@r──早く、":19,"早く、\n@rせめて、せめて、":20,"「………てください」":21,"めざめると、\n@r涙が。":22,"どうやら、\n@r泣いていたようだ。":23,"夢を視ていた。":24,"とても、\n@r厭な夢だったきがした。":25,"とても、\n@r気分が悪い。":26,"とても、\n\n悲しくてまた世界が涙で歪んだ。":27,"なんて、\n\n\n\n荒ぶる":28,"猥なのだろう。":29,"\n\n……なんだそれは？":30,"「……気持ち悪」":31,"布団から出て思い出した、此処は宮さんの部屋。":32,"そっと襖を開けると、\nチノ嬢は既に居ないようだったが、\n宮さんらしき人影が毛布にくるまって寝ていたので、\n起こさないように部屋を出る。":33,"携帯電話を確認すると、\n丁度アラーム鳴動する２分前だったので慌てて解除し、\n自分の部屋に戻った。":34,"何だろう、":35,"何か、":36,"何でこんなに、":37,"気持ちが悪いんだろう。":38,"何でだ……":39},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_045.ks","relPath":"/data/scenario/SC_M_045.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":40,"length":40,"percent":100},"cellInfo":[]},"/data/scenario/SC_M_046.ks":{"data":[["「ふぇぇ、何かすごいひっさしぶりだねぇまこちゃん。[l]\n色々心配かけて悪かったのだわ、\n元気だった？」","「呜呜、好久不见了呢真酱。[l]\n让你担心了真对不起呢，\n最近还好吗？」"],["「いや、\nどっちかっていうと僕の方が体調崩しまくりだからな……[l]\nこないだも点滴とか世話になったし」","「没，\n倒不如说我这段时间老是生病……[l]\n前几天还挂了点滴被人照顾呢」"],["「真言さんたら一昨日倒れて丸１日寝てたんだから……って、[l]\n","「真言前天晕倒睡了整整一天呢……啊，[l]\n"],["言ったか私。","我说过这事了吗。"],["まあそんなだからね、\n寧ろきぃの方が元気よね、\n食欲もすっかりいつもの通りだし」","总之就是这样啦，\n反倒是小贵你更精神呢，\n食欲也完全恢复平常了」"],["「食は全ての基本っすよ","「饮食是万事的根基"],["姉さん！[l]\n","姐姐！[l]\n"],["まあ何にしてもほんと、\nお見舞いの品もありがたく戴きましたので、\n","不过不管怎样，\n慰问品我就心怀感激地收下啦，\n"],["ありがとうねまこちゃん」","谢谢你呢真酱」"],["「……まあ、今回も色々持ってきてるんだけどな。[l]\n足りるかどうか分からんけど……」","「……其实这次也带了不少东西来。[l]\n不知道够不够呢……」"],["きぃの家……というか部屋か、を、[l]\n直に訪れるのは矢張り","说是去小贵家……不如说是房间吧，[l]\n直接造访果然还是"],["憚られるという事で、\n恐らく近くなんだと思うが、\n軽食屋か喫茶店かという風情の小さな店で落ち合った僕等。","有所顾忌，\n虽然应该离得很近了，\n我们最终约在一家像是小吃店或咖啡厅的小店碰头。"],["車での道行きにきぃへの土産を大量に買い込んで、\nそれこそこの店がガラ空きだったから良い様なものの、","开车来的路上买了大量送给小贵的礼物，\n幸亏这家店空荡荡的才没惹人注目，"],["ちょっと引かれるかも、くらいの量を、\n冬夏と一緒に持ってきたのだが、\nきぃは苦もなく受け取ったのであった。","但这份量还是可能\n会让人侧目呢，我和冬夏\n一起搬来的东西，小贵却轻松接了过去。"],["それは食欲の為せる","这究竟是食欲催生的"],["業なのか、\nバイトで","神力，\n还是打工"],["培った腕力なのか。","练就的臂力呢。"],["いずれ僕等は呆れ半分に感心しつつ、\nこの店でも食事を奢る訳です。","我们半是傻眼半是佩服地，\n决定在这家店请她吃饭。"],["「ここってよく来るの？」","「常来这儿吗？」"],["「んー、\nあんまり来ないけどさ、\n","「嗯——\n不常来呢，\n"],["前一回来た時にすっごい美味しかったのだわ。","但上次来的时候超级好吃哦。"],["なのに客少ないんだよねぇ……[l]\nだからわたしの味覚の問題あるかもだけど」","可客人却好少啊……[l]\n说不定是我的味觉有问题呢」"],["「ふーん。[l]\nそれって道具さんと来たってこと？」","「哦——[l]\n是和道具小姐一起来的吗？」"],["「……多分そうかなあ。[l]\n値段は……ふつう？[l]\n","「……大概吧。[l]\n价格嘛……普通？[l]\n"],["格別安くはないのだわ。[l]\nだからわたしが自分から１人だけでは来ないと思う」","也不算特别便宜呢。[l]\n所以我自己一个人的话应该不会来」"],["「ま、早く頼もか。[l]\n朝御飯抜いてきたんだから私達」","「好啦快点菜吧。[l]\n我们都没吃早饭呢」"],["そう、何となくきぃに合わそう……と思ったわけでもないが、[l]\nこっちも腹減らしてみるかという話で、","说是要配合小贵的时间……倒也不是这个意思，[l]\n不过我们也正好饿着肚子，"],["僕は運転する関係上、\nちょっとビタミン飲料飲んだけれど、\n基本ご飯らしいご飯は食べずに来たのだった。","虽然我因为要开车，\n喝了点维生素饮料，\n但正经饭是没吃就来了。"],["「うぇっへっへっへ」","「嘿嘿嘿嘿」"],["４人がけのテーブル席、\nソファ側にきぃとお土産の荷物、\n椅子側に僕と冬夏が並んで座ってたのだが、\n突如きぃが僕等を見比べて気味悪く笑った。","四人座的餐桌，\n沙发那边坐着小贵和礼物堆，\n我和冬夏并排坐在椅子这侧，\n小贵突然打量着我们发出诡异的笑声。"],["「……何その笑い？」","「……这笑声什么意思？」"],["「冬夏ったらさ、\nまこちゃんと会ってから","「冬夏你啊，\n见到真酱之后"],["大","大"],["分砕けてきてるんだわ。[l]\n言葉遣いとかわたしと居る時よりかなりゆるゆる。","整个人都松懈了呢。[l]\n说话方式比和我在一起时随意多了。"],["話し方なんかすっかり、ねえ？[l]\n","简直完全变了个人对吧？[l]\n"],["わたしじゃ心の囲いは壊せなかったかぁ～。[l]\n","我啊～就是没法打破心里的围墙呢～。[l]\n"],["あーもー妬けるねこれ！あっついあっつい」","啊～真是的！好嫉妒好嫉妒！热死了热死了」"],["「いっ！[l]\n家に！！[l]\n帰ってないからちょっとそんなかんじなんだってば！！[l]\nあ、ほら、真言さんが困るでしょそんな今言ったら」","「呜！[l]\n家里！！[l]\n因为没回去所以现在就是这种感觉啦！！[l]\n啊、你看、真言先生会为难的吧这种时候说出来」"],["「押したいのか遠慮したいのか良い感じに慌ててるねえー。[l]\nもう色々言ったりしたりしてるんだしょー？","「是想推倒还是想矜持啊慌得恰到好处呢ー。[l]\n已经各种说过做过了吧ー？"],["にしてもなー、まこちゃんと会わせる前はさ、\n幾らさばさばったってまだ全然つんけんだったんだねェ？","不过啊—、在让你见真之前呢、\n不管装得多爽快其实还是超级冷淡的对吧～？"],["それともあれさ、\n二人っきりだと出せる本当の私ってやつだわ？」","或者说那个啦、\n独处时才能展现真正的我之类的？」"],["「いぃーっから！[l]\nそそそそういう話題わ！！","「才不是ー啦！[l]\n这这这这种话题！！"],["あ、あんたそんなふうに思ってたの？！[l]\nほら、お土産あげないわよ！！！[l]\n","啊、你原来是这么想的吗？！[l]\n听着、伴手礼不给你了哦！！！[l]\n"],["返して貰うわよ！！！！」","要让你还回来哦！！！！」"],["「は、それは困るのさ。[l]\n……がっつり大人しくするのだわ」","「那、那可不行啊。[l]\n……我会老老实实的啦」"],["強制力なんて無いだろうに、効果覿面だなあ……","明明没有强制力却效果拔群啊……"],["「それより、きぃも真言さんに御礼あるんじゃなかった？」","「比起那个、小贵不是该向真言先生道谢吗？」"],["「んー、\n帰り際に渡すつもりなのさ。","「嗯ー、\n打算临走时给的啦。"],["今だとちょっと間が悪いというか──\n","现在时机有点尴尬──\n"],["あ、別に冬夏の恋路を邪魔するもんじゃないから\n心配は無用なのだわ」","啊、并不是要妨碍冬夏的恋爱啦\n不用担心哦」"],["「……だぁっからっ、……それもういいっての」","「……所以说啊、……这个话题可以结束了啦」"],["「まあまあ喧嘩はお","「好啦好啦吵架就"],["止めなさい。[l]\nきぃも別に気を遣わなくていいんだけど、\nそんなに」","到此为止。[l]\n小贵也不用太顾虑的、\n那么」"],["「ふぇえ、まあ、お察しの通りろくな物はないんでさ、\n感謝の手紙的な？[l]\n後で１人になったら読んで欲しいのだわ。[l]\nああ、冬夏ってば、だからラブレターとかじゃないからさ」","「呜诶、那个、如你所料不是什么正经东西啦、\n感谢信之类的？[l]\n希望之后独处时再看啦。[l]\n啊啊、冬夏你听好、不是情书什么的啦」"],["「……あぁーあ、そっか、お土産、いらないんだ？」","「……啊啊、这样啊、伴手礼、不要了？」"],["「ふええっ！[l]\nも、もう言いませんごめんなさいお土産ください冬夏さまぁん」","「呜诶诶！[l]\n我、我错啦再也不说了求您给伴手礼冬夏大人～」"],["先程から君等は一体何してるのかね……","从刚才起你们到底在搞什么……"],["そんなこんなで、\n良い時間になったにも関わらず客の来ないこの店、\n存分に食べ、話し、笑い、","就这样、\n尽管已到客流高峰却无人光顾的这家店、\n让我们尽情吃喝、畅谈、欢笑、"],["数日前までの疑念をすっかり忘れるくらいの、","甚至忘却了数日前的疑虑、"],["愉しい時間を過ごした。","度过了一段愉快时光。"],["疑念ついでに、\n今朝って、すごい寝覚めが悪かった気がするんだけど……","说到疑虑、\n今早起床时、总觉得心情特别糟糕……"],["何故かはもう覚えてない。[l]\nまあわざわざ嫌な気分を思い出すこともないので、\nそのまま放置です。","但原因已经想不起来了。[l]\n反正也没必要特意回忆不愉快的事、\n就随它去吧。"],["客が居ないとは言え何も頼まずに長居は失礼……","虽说没客人但久坐不点单也很失礼……"],["否、きぃの分を相当頼みはしたんだけれど、\n兎も角、そこそこの時間が経ったので店を出るも、\nきぃの荷物を","不、其实点了相当多小贵那份、\n总之、过了适当时间后我们离开店铺、\n考虑到"],["鑑みて一旦適当な場所まで送る事にし、\n３人で車に乗り込む。","小贵的行李决定先送到合适的地方、\n三人坐进了车里。"],["「なんか、\nほんとに私達って、\n小さい時さぁ、揃って会ってるんじゃないかなー。","「总觉得、\n我们几个啊、\n小时候说不定就见过面呢ー。"],["最近知り合ったにしてはさ、\n馴染み方が違うよね、あはははは」","说是最近才认识的话、\n这熟络程度也太反常了、啊哈哈哈哈」"],["冬夏が助手席に乗り込みながら、\n心底嬉しそうにそう言った。","冬夏钻进副驾驶时、\n打心底开心地这么说道。"],["そんな事言うとまたきぃがいらぬツッコミするんじゃ、\nと思ったが、\n先程の釘刺しが効いてるのか無言のきぃ。","说这种话小贵又要多嘴吐槽了吧，\n虽然这么想着，\n但可能是刚才的警告奏效了，小贵保持着沉默。"],["「まあ、\n一応、まだ確証無いまでも、\nその可能性があるわけだよねぇ、\n僕等それぞれに？","「不过，\n就算还没有确凿证据，\n这种可能性也是存在的吧，\n对我们每个人来说？"],["全員がどうかはまあ少なくとも僕の記憶には……[l]\nや、当てにならんけどさ」","至于所有人是否都...至少在我的记忆里——[l]\n啊、虽然这也不靠谱啦」"],["「──きっと、\n……そうさ。[l]\nそうだわ」","「——肯定，\n……是这样。[l]\n没错呢」"],["「なに、しんみりしてる？[l]\n病み上がりには染み入る話だったかしら」","「怎么，突然伤感起来了？[l]\n对刚病愈的人来说太戳心窝了吗」"],["「……ん、[l]\nそう、かもね。[l]\n何か涙腺が」","「……嗯，[l]\n或许、是吧。[l]\n眼泪有点止不住」"],["そう言って鼻をすするきぃ。[l]\nミラーで確認すると、確かに眼が赤くなってるかも。","小贵吸着鼻子说道。[l]\n从后视镜看去，她眼睛确实有点发红。"],["「わたしってこんなだから、\nひととのこういう付き合いとかさ、憬れ強いっていうか、\nそういうのに飢えてるんだぁ。","「我就是这种人，\n特别渴望这种与人深交的感觉，\n对这种关系饥渴得要命。"],["ほんとに……嬉しいよ２人にまた……」","真的……好开心能再见到你们俩……」"],["「幾ら腹へりキャラだからって、\nなんでもかんでもそんな飢えなくてもさ、\nああごめんごめん、\n泣かないでぇ～」","「就算要维持吃货人设，\n也不用什么都这么饥渴吧，\n啊抱歉抱歉，\n别哭啦～」"],["冬夏は後部座席に身を乗り出し頭を撫でる。","冬夏探身到后座抚摸她的头。"],["「ええはなしや……そうか……？」","「真是好故事呢……对吧……？」"],["１人ボケツッコミをしながらエンジンをかける僕。[l]\nまあ僕まで話に乗っかって変に深刻な空気にするのも、\n余計に","我一边自说自话地吐槽一边发动引擎。[l]\n要是我也跟着煽情把气氛搞得太沉重，\n反而"],["居た","更"],["堪れない気がして……","让人待不下去……"],["「……たし、満たされなくて、何しても、[l]\nわたしどれがほんとの自分か分かんなくなるしさぁ、\nその、いろいろ仕事もしてるとさぁ……」","「……而且，得不到满足的话，做什么都，[l]\n我会分不清哪个才是真正的自己，\n那个，做各种工作的时候也是啦……」"],["「ああもう泣かない泣かない、\nだぁいじょうぶ、\nいっぱい食べれば少なくともお腹は満たされる！","「啊好了别哭别哭，\n没～问题的，\n只要吃饱肚子至少能获得满足感！"],["あは、\nね？[l]\nお土産もいっぱいあるし、","啊哈，\n对吧？[l]\n伴手礼也买了很多，"],["私も真言さんも、\nきぃのトモダチなんだからさ、\nそんなになる前にさ、\n遠慮しないで色々言ってくれれば良いよー。","我和真言先生，\n都是小贵的朋友嘛，\n在你变成那样之前，\n不用客气尽管和我们说就好啦～"],["よね？[l]\n真言さん」","对吧？[l]\n真言先生」"],["「えあ、おおう、もっ、勿論。[l]\n可能な範囲でなら飯くらい奢るし……」","「啊、哦哦，当、当然。[l]\n力所能及的话请顿饭不成问题……」"],["なんか本格的に空気が微妙になりそう？","怎么感觉气氛真的要变得微妙了？"],["「……ふぇえ。[l]\n２人とも、\nほんとに……ありがとう……ぐず、ございまず……」","「……呜诶。[l]\n你们两个，\n真的……谢谢……呜咕、非常感谢……」"],["あうあ、\nこここういうシチュエーションには馴れてないので、\n無駄に焦る……かと思いきや、[l]\n自己防衛機構が働いたのか、やけに冷静になっていく僕。","啊呜啊，\n因为不习惯这种场面，\n正想着要慌得手足无措——[l]\n或许是自我保护机制启动，我反而异常冷静下来。"],["その甲斐あってか、\n来しなに買って手つかずだった缶コーヒーが、\nドリンクホルダーに差しっぱなしだったのを思い出し、\n黙ってそれを後ろに手渡す。","或许是这招有效，\n突然想起之前买的没开封罐装咖啡，\n还插在饮料架里，\n便默默递到后座。"],["「……あう、いいの？」","「……啊呜，可以吗？」"],["「おお。いいよお」","「哦哦。可以哟」"],["「いだだぎまず……」","「非非非常感谢……」"],["「んとに、すっかり感激屋になっちゃって、\n体調も崩してみるもんよねー」","「真的、完全变成爱哭鬼了，\n连身体都搞垮了呢ー」"],["「それはどうだろうなあ……[l]\nまあいいや、じゃ出発するよ？[l]\n場所分からんから教えてくれい」","「这倒说不好呢……[l]\n算了不管啦，那出发咯？[l]\n地方不认识所以给我指路呗」"],["「……ふぇ、ええとね、[l]\n駐車場を左折で出てぇ、\n次の信号までまっずぐ」","「……欸、那个啊，[l]\n从停车场左转出去后，\n直走到下个红绿灯」"],["……ぱっと視た感じ、信号なんか視えねえぞ？","……粗略扫了眼，根本看不见红绿灯啊？"],["「……きぃ、お前結構な距離今日歩いてきた？」","「……小贵、你今天走了相当远的路吧？」"],["「……お腹いっぱい食べられるように、[l]\nえへへへへへへぇ」","「……为了能吃饱肚子，[l]\n嘿嘿嘿嘿嘿嘿嘿」"],["まじかい。[l]\nてか復活早いな。[l]\n湿っぽくされるよりは良いけど……","真假啊。[l]\n话说恢复得真快。[l]\n虽然比哭哭啼啼要好……"],["「やっぱそなんだ。[l]\n昨日と全然違うよねここ？[l]\nあんまり来ないから勘違いかなーって思ってたけど、\nほんとに遠かったんだね」","「果然是这样呢。[l]\n和昨天完全不一样对吧这里？[l]\n因为不常来还以为是搞错了，\n原来真的超远啊」"],["「まああれなら、\n土産喰ってても良いしな……[l]\n道さえちゃんと教えてくれりゃ」","「嘛那种程度的话，\n吃伴手礼也没关系啦……[l]\n只要好好指路就行」"],["「おけおけ、\nいあ、食べるのも我慢するさ。[l]\nじっくり長く愉しまねば勿体ないのだ……」","「OKOK，\n不、不吃也会忍住的。[l]\n必须细细品味才不算浪费……」"],["わ、","话、"],["と続け、ないんだ。[l]\n別にええけど……","虽这么说，其实没有啦。[l]\n倒也无所谓……"],["ともあれ数分も走ると、信号のある交差点が出て来た。","总之开了几分钟后，出现了有信号灯的十字路口。"],["「それをー、右折なのだわー」","「在那里ー、要右转的说ー」"],["曲がると、\n大きめではあるが、\nテナント募集の張り紙のある空き店舗の駐車場が、\n先方に視える。","转弯后，\n虽然规模挺大，\n但贴着招租告示的空店铺停车场，\n出现在前方。"],["「そこの駐車場お願いしまーす」","「请停到那个停车场ー」"],["「らじゃー。[l]\nよっしょと……」","「了解ー。[l]\n好嘞……」"],["「ふすー……ふすー……」","「呼咻……呼咻……」"],["冬夏、静かと思ったら寝てたのかい。","冬夏，还以为很安静原来睡着了吗。"],["「お、\n冬夏寝てるうちにこれ渡す」","「啊、\n趁冬夏睡着把这个给她」"],["ああ、\nなんか手紙とかいう。","啊啊、\n好像是信什么的。"],["「別に冬夏に気遣う内容じゃないけど……[l]\nなんとなくさ。[l]\nま、どっちにしろ１人の時に読むのだわ。[l]\n色々こう、差し障りのない時に」","「虽然不是需要避着冬夏的内容……[l]\n就是莫名觉得。[l]\n嘛，反正要一个人时候看啦。[l]\n在各种不会造成妨碍的时候」"],["「分かったって。[l]\nま、さっきも言ったけど僕等に対しては遠慮しなさんな。","「知道啦。[l]\n嘛、刚才也说过对我们不用客气。"],["僕も友人少ないし、\n……コドモの頃からのトモダチ、なんだよな？[l]\n僕等はさ」","我朋友也少，\n……是从小玩到大的朋友、对吧？[l]\n我们啊」"],["そう信じたいよ、という願望……なのか、[l]\n念を押すように僕は思わずそう言っていた。","想要这么相信的愿望……或许是，[l]\n为确认而忍不住说出口的话语。"],["「……そうだよ。[l]\nわたしたちは、\nわたしはまこちゃんが、\nはじめての」","「……没错哟。[l]\n我们呢，\n我是小真、\n第一个」"],["「んーああー、寝てた！私？[l]\n","「嗯ー啊ー、睡着了！我？[l]\n"],["あうあう。[l]\nえ、ここどこ？」","啊呜啊呜。[l]\n咦、这是哪儿？」"],["「お、おはよう冬夏さん。[l]\n目的地周辺です、お疲れ様でした」","「早、早安冬夏。[l]\n已经到目的地周边了，辛苦您了」"],["何となくそうしなければならない気がして、\n気付かれないよう手紙をポケットにさっと仕舞う。","总觉得必须这么做，\n为了不被发现，迅速把信塞进口袋。"],["「そういえば道具さんから聞いたけど、\n祭は予定通りやるって？」","「对了听道具小姐说，\n祭典会按计划举行吗？」"],["「……そうなんだ。[l]\n私は知らない」","「……是啊。[l]\n我不清楚」"],["「ああ、僕も聞いたよ、\n一応僕も目的はそれだから、\n良かったと言えば良かったんだけど──」","「啊，我也听说了，\n毕竟我的目标也是这个，\n要说顺利也确实挺顺利的──」"],["「……そっか、[l]\n真言さんそもそも……」","「……这样啊，[l]\n真言先生本来……」"],["「うちには帰んない？」","「不回家吗？」"],["「……ん。[l]\nまだ、」","「……嗯。[l]\n还不行，」"],["──せめて誕生日までは、","──至少等到生日那天之前，"],["「道具さんも言ってたけど、\n祭までには大人しく戻った方が良いってさ。[l]\nわたしも……今回に限ってはそう思う」","「虽然道具小姐也说过，\n最好在祭典前乖乖回去。[l]\n我也……唯独这次是这么想的」"],["「……んー」","「……嗯──」"],["うっ、空気が、","呜、这气氛、"],["「ま、まあ、こんなこと言うのも何だけども、\n今早急に決めることもないよ、\n少なくとも","「嘛、嘛、虽然这么说有点那个，\n现在没必要急着决定啦，\n至少"],["姫」","姬"],["様ちゃん達が強制連行とやらに打って出ないうちは、","大人她们还没采取强制手段之前，"],["ん？[l]\nそれじゃ駄目か、\nと思ってる内に。","嗯？[l]\n这样不行吗，\n正这么想着。"],["「よしゃー！[l]\nこれでしばらくは保つ！！」","「太好啦！[l]\n这样就能维持一阵子了！！」"],["がっさがっさと土産の袋を車から降ろすきぃ。","小贵哗啦哗啦地从车上卸下伴手礼的袋子。"],["「というわけで、\n決めるのは冬夏だわ。","「所以说啊，\n决定权在冬夏手里。"],["わたしも難しいことはわからん！！[l]\n思うままにいってみるがよろしいかと？！","我也不懂复杂的事！！[l]\n想到什么就说什么可以吗？！"],["どんな未来が待っていようと、\n覚悟の上で！自己責任でお願いします！！」","不管未来等着我们的是什么，\n都做好觉悟了！后果自负！！」"],["「……はは、[l]\n……ん、ごめん」","「……哈哈，[l]\n……嗯，抱歉」"],["「んじゃ、\nほんとは家まで送ってあげたいけど……」","「那啥，\n其实想送你到家门口来着……」"],["何とか空気は大丈夫そうだが、\n我ながら危うく地雷を踏みそうになってた？[l]\nもしかして。[l]\nという意識のもと誤魔化し誤魔化し、無難な事を言う。","气氛总算稳住了，\n但自己差点踩雷？[l]\n说不定。[l]\n怀着这样的念头打哈哈，说着稳妥的话。"],["「いいのいいの、\n自分で言ったことだしさ。[l]\n……ねえおふたりさん」","「没事没事，\n毕竟是我自己提的。[l]\n……喂你们两位」"],["「？」",""],["神妙になる僕等。","突然正经起来的我们。"],["「わたしたち、\nずっと、\n友達だよね？」","「我们\n永远\n都是朋友对吧？」"],["「そら、まあ、」","「那、那个嘛，」"],["それはどうかなあ、なぁーんちゃって♪","这可说不准呢，开玩笑的啦♪"],["と茶化すのも頭をよぎったが。","虽然脑海里闪过这样打岔的念头。"],["「ほんとの親友はそんなの口で確認しなくても！[l]\nねえ？」","「真正的挚友根本不需要口头确认！[l]\n对吧？」"],["「……時と場合によるんだわ。","「……要看时间和场合。"],["でも、\nありがと、\nほんとに愉しかった。[l]\nまた……遊んでね」","但是，\n谢谢，\n真的很开心。[l]\n下次……再一起玩」"],["「お前の場合は飯奢るのがメインだろうけどな……」","「你这家伙主要就是来蹭饭的吧……」"],["「私も愉しかったよー。[l]\nまた、家にも行くから。お土産持って」","「我也很开心啦。[l]\n下次还会去你家的。会带伴手礼」"],["「うん……じゃ、２人とも気をつけて帰るといいのだわ」","「嗯……那，你们两个回去路上小心」"],["「……なんか映画とか漫画とかの、[l]\n死亡フラグ立ったキャラみたいな空気出すなって。[l]\nちゃんと喰って寝とけよ、\n病み上がりなんだから」","「……怎么搞得像电影漫画里[l]\n那种插满死亡flag的角色似的。[l]\n记得好好吃饭睡觉啊，\n毕竟病才刚好」"],["「死亡ふらぐ？」","「死亡腐辣菇？」"],["「あはは、まこちゃんよりは元気さ。[l]\n","「啊哈哈，可比真酱精神多啦。[l]\n"],["じゃ、ほんとにありがとね。[l]\nまた──今度ね」","那就真的谢谢你啦。[l]\n下次——再约」"],["「おうー。お疲れー。[l]\nまたなー」","「噢——辛苦啦。[l]\n回见」"],["「ばいばいー。[l]\n","「拜拜——[l]\n"],["……死亡ふらぐって何？」","……死亡腐辣菇是啥？」"],["大量の土産……食材を抱えて、[l]\nきぃは帰って行った。[l]\n足取りは──しっかりしてるな。","抱着大量伴手礼……食材，[l]\n小贵回去了。[l]\n脚步——倒是挺稳当。"],["一応視えなくなるまで視送りつつ、\nその間、冬夏に死亡フラグ云々の説明をし。","姑且目送到看不见为止，\n期间给冬夏解释了死亡flag什么的。"],["「成る程ねー……[l]\nあるあるネタみたいな事かな」","「原来如此……[l]\n就是那种常见套路吧」"],["そんなどうでもいい話をしつつ、\n宿に戻った。","一边聊着这些无关紧要的话题，\n一边回到了旅馆。"],["夕方の朱が、何故か心を締め付けて、\n僕は今朝の気持ち悪さを思い出した。","傍晚的霞光不知为何让人心头一紧，\n我想起了今早的恶心感。"],["……運転手だし車酔いじゃないよな……","……我可是司机又不是晕车……"],["一度思い出してしまった不快感は、","一旦回想起来的不适感，"],["何故か後を引く──","莫名挥之不去——"]],"context":[["SC_M_046.ks/index/1/text"],["SC_M_046.ks/index/3/text"],["SC_M_046.ks/index/5/text"],["SC_M_046.ks/index/8/text"],["SC_M_046.ks/index/10/text"],["SC_M_046.ks/index/12/text"],["SC_M_046.ks/index/14/text"],["SC_M_046.ks/index/17/text"],["SC_M_046.ks/index/20/text"],["SC_M_046.ks/index/22/text"],["SC_M_046.ks/index/24/text"],["SC_M_046.ks/index/26/text"],["SC_M_046.ks/index/28/text"],["SC_M_046.ks/index/30/text"],["SC_M_046.ks/index/32/text"],["SC_M_046.ks/index/34/text"],["SC_M_046.ks/index/36/text"],["SC_M_046.ks/index/38/text"],["SC_M_046.ks/index/40/text"],["SC_M_046.ks/index/42/text"],["SC_M_046.ks/index/45/text"],["SC_M_046.ks/index/47/text"],["SC_M_046.ks/index/49/text"],["SC_M_046.ks/index/51/text"],["SC_M_046.ks/index/54/text"],["SC_M_046.ks/index/56/text"],["SC_M_046.ks/index/58/text"],["SC_M_046.ks/index/60/text"],["SC_M_046.ks/index/62/text"],["SC_M_046.ks/index/64/text"],["SC_M_046.ks/index/66/text"],["SC_M_046.ks/index/68/text"],["SC_M_046.ks/index/70/text"],["SC_M_046.ks/index/72/text"],["SC_M_046.ks/index/74/text"],["SC_M_046.ks/index/77/text"],["SC_M_046.ks/index/80/text"],["SC_M_046.ks/index/82/text"],["SC_M_046.ks/index/84/text"],["SC_M_046.ks/index/86/text"],["SC_M_046.ks/index/88/text"],["SC_M_046.ks/index/90/text"],["SC_M_046.ks/index/92/text"],["SC_M_046.ks/index/95/text"],["SC_M_046.ks/index/97/text"],["SC_M_046.ks/index/99/text"],["SC_M_046.ks/index/101/text"],["SC_M_046.ks/index/103/text"],["SC_M_046.ks/index/105/text"],["SC_M_046.ks/index/108/text"],["SC_M_046.ks/index/110/text"],["SC_M_046.ks/index/112/text"],["SC_M_046.ks/index/114/text"],["SC_M_046.ks/index/116/text"],["SC_M_046.ks/index/118/text"],["SC_M_046.ks/index/120/text"],["SC_M_046.ks/index/122/text"],["SC_M_046.ks/index/124/text"],["SC_M_046.ks/index/126/text"],["SC_M_046.ks/index/128/text"],["SC_M_046.ks/index/130/text"],["SC_M_046.ks/index/132/text"],["SC_M_046.ks/index/134/text"],["SC_M_046.ks/index/136/text"],["SC_M_046.ks/index/138/text"],["SC_M_046.ks/index/140/text"],["SC_M_046.ks/index/142/text"],["SC_M_046.ks/index/144/text"],["SC_M_046.ks/index/146/text"],["SC_M_046.ks/index/148/text"],["SC_M_046.ks/index/150/text"],["SC_M_046.ks/index/152/text"],["SC_M_046.ks/index/154/text"],["SC_M_046.ks/index/156/text"],["SC_M_046.ks/index/158/text"],["SC_M_046.ks/index/160/text"],["SC_M_046.ks/index/162/text"],["SC_M_046.ks/index/164/text"],["SC_M_046.ks/index/166/text"],["SC_M_046.ks/index/168/text"],["SC_M_046.ks/index/170/text"],["SC_M_046.ks/index/172/text"],["SC_M_046.ks/index/174/text"],["SC_M_046.ks/index/176/text"],["SC_M_046.ks/index/178/text"],["SC_M_046.ks/index/180/text"],["SC_M_046.ks/index/182/text"],["SC_M_046.ks/index/184/text"],["SC_M_046.ks/index/186/text"],["SC_M_046.ks/index/188/text"],["SC_M_046.ks/index/190/text"],["SC_M_046.ks/index/192/text"],["SC_M_046.ks/index/194/text"],["SC_M_046.ks/index/196/text"],["SC_M_046.ks/index/198/text"],["SC_M_046.ks/index/200/text"],["SC_M_046.ks/index/202/text"],["SC_M_046.ks/index/204/text"],["SC_M_046.ks/index/206/text"],["SC_M_046.ks/index/208/text"],["SC_M_046.ks/index/210/text"],["SC_M_046.ks/index/212/text"],["SC_M_046.ks/index/214/text"],["SC_M_046.ks/index/216/text"],["SC_M_046.ks/index/218/text"],["SC_M_046.ks/index/220/text"],["SC_M_046.ks/index/222/text"],["SC_M_046.ks/index/224/text"],["SC_M_046.ks/index/226/text"],["SC_M_046.ks/index/228/text"],["SC_M_046.ks/index/230/text"],["SC_M_046.ks/index/232/text"],["SC_M_046.ks/index/234/text"],["SC_M_046.ks/index/236/text"],["SC_M_046.ks/index/238/text"],["SC_M_046.ks/index/240/text"],["SC_M_046.ks/index/242/text"],["SC_M_046.ks/index/244/text"],["SC_M_046.ks/index/246/text"],["SC_M_046.ks/index/248/text"],["SC_M_046.ks/index/250/text"],["SC_M_046.ks/index/252/text"],["SC_M_046.ks/index/254/text"],["SC_M_046.ks/index/257/text"],["SC_M_046.ks/index/259/text"],["SC_M_046.ks/index/261/text"],["SC_M_046.ks/index/263/text"],["SC_M_046.ks/index/265/text"],["SC_M_046.ks/index