,"确认"]],"context":[["tok/99/type/StringLiteral/pos/457","tok/146/type/StringLiteral/pos/631","tok/227/type/StringLiteral/pos/904"],["tok/690/type/StringLiteral/pos/2013"],["tok/803/type/StringLiteral/pos/2300"],["tok/947/type/StringLiteral/pos/2622"],["tok/1033/type/StringLiteral/pos/2824"],["tok/1283/type/StringLiteral/pos/3547"]],"tags":[],"parameters":[[{"start":457,"end":468,"leftHand":{"type":"","context":["typeof","global","Window","mainWindow","cursorDefault"]}},{"start":631,"end":642,"leftHand":{"type":"","context":["typeof","global","Window","mainWindow","cursorPointed"]}},{"start":904,"end":915,"leftHand":{"type":"","context":["typeof","this","cursorDefault"]}}],[{"start":2013,"end":2017,"leftHand":{"type":"assignment","context":["yesButton","caption"]}}],[{"start":2300,"end":2305,"leftHand":{"type":"assignment","context":["noButton","caption"]}}],[{"start":2622,"end":2631,"leftHand":{"type":"functionArgs","context":["if",0,"ev","type"]}}],[{"start":2824,"end":2835,"leftHand":{"type":"functionArgs","context":["if",0,"ev","type"]}}],[{"start":3547,"end":3551,"leftHand":{"type":"functionArgs","context":["function","askYesNo",1,"caption"]}}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"YesNoDialog.tjs","basename":"YesNoDialog.tjs","indexIds":{"undefined":0,"はい":1,"いいえ":2,"onClick":3,"onKeyDown":4,"確認":5},"extension":".tjs","lineBreak":"\n","path":"/data/system/YesNoDialog.tjs","relPath":"/data/system/YesNoDialog.tjs","type":"","originalFormat":"KAG's .tjs File","dirname":"/data/system","indexIsBuilt":false,"progress":{"translated":6,"length":6,"percent":100},"cellInfo":[[null,{"t":"HU"}],null,null,[null,{"t":"HU"}],[null,{"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[5,0]},"/data/scenario/SC_S_012.ks":{"originalFormat":"Autogenerated TRANS obj","type":"","basename":"SC_S_012.ks","filename":"SC_S_012.ks","path":"/data/scenario/SC_S_012.ks","relPath":"/data/scenario/SC_S_012.ks","data":[[";SubT『●●●を●●●ます（ゴカイ）』\n@playbgm storage=sunasiro_short.ogg loop=no\n@mes_no\n@clickskip enabled=flase\n@img_bg_trans img=vis078\n@staffrollinit\n@font size=25\n@staffrolltext x=100 y=600 text=\"●●●を●●●ます（ゴカイ）\"\n@font size=18\n@staffrolltext x=100 y=80 text=\"妹よ、お前ならどうする。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"否、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"お前は既にその結論を出したんだ。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"だから。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"彼は今、此処に、在る。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"旗は立てられ、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"場（ステージ）は既解（きかい）へと、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"確実に事が進んでいる。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"妹よ、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"母殿はお前を異端だと、\"\n@staffrolltext x=100 y=40 text=\"服（まつろ）わぬ者だと、\"\n@staffrolltext x=100 y=40 text=\"そう思っていたようだが、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"結局彼を産んだのはお前だ。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"具足の仕込みにも従順に従った。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"そう、\"\n@staffrolltext x=100 y=40 text=\"自由奔放であるようで、\"\n@staffrolltext x=100 y=40 text=\"お前は実のところ我等に反駁（はんばく）していた訳じゃない。\"\n@staffrolltext x=100 y=40 text=\"ただ、遣り方が、道筋が、違っただけだ。\"\n@staffrolltext x=100 y=40 text=\"と思う。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"個にして全、全にして個、\"\n@staffrolltext x=100 y=40 text=\"矛盾を無矛盾的に受け入れる、\"\n@staffrolltext x=100 y=40 text=\"ただそこに在るという事、\"\n@staffrolltext x=100 y=40 text=\"完全なるアリカタ。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"実際には精確な理論と\"\n@staffrolltext x=100 y=40 text=\"しかしヒト、いや世界を含め、\"\n@staffrolltext x=100 y=40 text=\"不完全なぶれをも完全に盛り込んだ完全さだ。\"\n@staffrolltext x=100 y=40 text=\"理想値というものを構想することは出来るが\"\n@staffrolltext x=100 y=40 text=\"実践するのは限りなく不可能に近い。\"\n@staffrolltext x=100 y=40 text=\"そして何よりも、\"\n@staffrolltext x=100 y=40 text=\"ヒトが世界のシキを理解出来ずとも、\"\n@staffrolltext x=100 y=40 text=\"セカイもヒトも在るという事実、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"ただそこに在るという事を無自覚的に自覚し享受する事が、\"\n@staffrolltext x=100 y=40 text=\"最も楽で健全なアリカタであろう。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"お前は彼を寄越した。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"――何を視ているんだ。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"緋色の川のその流れから\"\n@staffrolltext x=100 y=40 text=\"抜け出る事は出来ないと、\"\n@staffrolltext x=100 y=40 text=\"逆らい這い上がれないと、\"\n@staffrolltext x=100 y=40 text=\"再び身を沈め流されようと思ったのか？\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"カミの望むまま、\"\n@staffrolltext x=100 y=40 text=\"我が子を人柱に――？\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"最も其れを求めない者に、\"\n@staffrolltext x=100 y=40 text=\"しかして他の誰もが求める其れが与えられ、\"\n@staffrolltext x=100 y=40 text=\"そしてそれがよりにもよって\"\n@staffrolltext x=100 y=40 text=\"縁ある者同士に於（お）いて起きる事多し――\"\n@staffrolltext x=100 y=40 text=\"まさに神の悪戯、欲心検知畏るべし……\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"飯窪の長姉たる私にミタマが宿ることはなかった。\"\n@staffrolltext x=100 y=40 text=\"私は自分の存在意義をそれ以外で獲得せざるを得なかった。\"\n@staffrolltext x=100 y=40 text=\"しかし現実、\"\n@staffrolltext x=100 y=40 text=\"お前を妬ましく思った事など一度もない。\"\n@staffrolltext x=100 y=40 text=\"今の己の意味は自分で成したものだし、\"\n@staffrolltext x=100 y=40 text=\"元来人間に『生きる価値』というものは無い。\"\n@staffrolltext x=100 y=40 text=\"単に\"\n@staffrolltext x=100 y=40 text=\"ただ、そう、自分自身が不甲斐なく、新たな価値を纏（まと）うには、\"\n@staffrolltext x=100 y=40 text=\"なかなかな時間を要したというだけだ。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"だから、\"\n@staffrolltext x=100 y=40 text=\"あの子の価値を、\"\n@staffrolltext x=100 y=40 text=\"存在意義を、\"\n@staffrolltext x=100 y=40 text=\"単なる送り手の器、プレイアァの眼としてにするには\"\n@staffrolltext x=100 y=40 text=\"あまりにも──\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"感情移入をしているのは確かだ。\"\n@staffrolltext x=100 y=40 text=\"あらゆる生命が単なる機構（システム）の反応だとしても、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"……否、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"お前には分かったのか。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"そうか。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"それとも、\"\n@staffrolltext x=100 y=40 text=\"信じているのか。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"未だ子を成したことのない私では想像しか出来ないが、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"親とはそういうモノなのか。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"それすらもこの肉の構造に仕組まれた反応に過ぎないと、\"\n@staffrolltext x=100 y=40 text=\"我等の同胞は言うだろうが――\"\n@staffrolltext x=100 y=40 text=\"世がすべてそれで成り立っているのなら、\"\n@staffrolltext x=100 y=40 text=\"そのようなものにだって価値は、\"\n@staffrolltext x=100 y=40 text=\"その中で生きるものにとっては意味はある。\"\n@staffrolltext x=100 y=40 text=\"全てが不毛ならば──\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"最強の白の夫に偽りの黒をと言ったそうだが、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"最強の白を繋ぎとめている歪んだ愛、\"\n@staffrolltext x=100 y=40 text=\"切れぬ鎖から、\"\n@staffrolltext x=100 y=40 text=\"彼女自身をも解放させようとしているのか。\"\n@staffrolltext x=100 y=40 text=\"彼女が最強たるのはその存在は元より、\"\n@staffrolltext x=100 y=40 text=\"あの方に愛されているが故だ。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"スキかキライかが運営法則の根底にあるこのセカイで、\"\n@staffrolltext x=100 y=40 text=\"我等にとってイドラとも言えるその位置から、\"\n@staffrolltext x=100 y=40 text=\"健全たるアリカタへの……\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"やはり、雫を確信したのか。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"逃げるのではなく、直面する事で事態を打破する、\"\n@staffrolltext x=100 y=40 text=\"単純にして、たった一つの、最も冴えた遣り方だ。\"\n@staffrolltext x=100 y=40 text=\"覚悟さえ在ればそれが。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"私に出来る事は何だ、現実。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"只只（ただただ）、只管（ひたすら）信じていれば良いというのか。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"月の雫、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"此方（こちら）側では露の異称か――。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"朝には消えるものならば、\"\n@staffrolltext x=100 y=40 text=\"夜がまた始まらん事を。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"白きたまの慈悲よ在れ、\"\n@staffrolltext x=100 y=40 text=\"白玉楼中（はくぎょくろうちゅう）のモノとならぬを祈る、\"\n@staffrolltext x=100 y=40 text=\"鬼一口に喰われぬことを祈る――\"\n\n@staffrollstart height=2000 time=35000\n@wait time=105000\n@staffrolluninit\n\n@img_bg_trans img=img_bg_b\n\n@clickskip enabled=true\n\n@mes_no\n@img_bg_trans img=sub_M029END\n@waitclick\n\n@eval exp=\"sf.SC_S_012=1\"\n@jump storage=\"SC_E_026.ks\"\n",";SubT『●●●を●●●ます（ゴカイ）』\n@playbgm storage=sunasiro_short.ogg loop=no\n@mes_no\n@clickskip enabled=flase\n@img_bg_trans img=vis078\n@staffrollinit\n@font size=25\n@staffrolltext x=100 y=600 text=\"●●●を●●●ます（ゴカイ）\"\n@font size=18\n@staffrolltext x=100 y=80 text=\"妹妹啊，换作是你会怎么做\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"不、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"你其实已经得出结论了吧。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"所以啊。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"正因如此。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"旗帜已然竖起、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"舞台正朝着 “既定的结局”、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"一切都在确凿无疑地推进着。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"妹妹啊、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"母亲大人似乎一直把你视作异端、\"\n@staffrolltext x=100 y=40 text=\"看作不顺从之人、\"\n@staffrolltext x=100 y=40 text=\"但到头来、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"生下他的人却是你。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"就连具足的穿戴准备也顺从地照做了。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"是啊、\"\n@staffrolltext x=100 y=40 text=\"你看似自由奔放、\"\n@staffrolltext x=100 y=40 text=\"但实际上并非在反对我们。\"\n@staffrolltext x=100 y=40 text=\"只是，做法不同，路径不同罢了。\"\n@staffrolltext x=100 y=40 text=\"我认为。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"作为个体却又是全体，作为全体却又是个体，\"\n@staffrolltext x=100 y=40 text=\"无矛盾地接纳矛盾，\"\n@staffrolltext x=100 y=40 text=\"仅仅是存在于那里这件事，\"\n@staffrolltext x=100 y=40 text=\"便是完全的存在形态。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"实际上，精确的理论\"\n@staffrolltext x=100 y=40 text=\" 然而，包括人、不，包括整个世界在内、\"\n@staffrolltext x=100 y=40 text=\"是一种将不完美的偏差也全然容纳其中的完美。\"\n@staffrolltext x=100 y=40 text=\"能够构想出所谓的理想值\"\n@staffrolltext x=100 y=40 text=\"但要将其付诸实践，却近乎是无限不可能的事情。\"\n@staffrolltext x=100 y=40 text=\"而且最重要的是，\"\n@staffrolltext x=100 y=40 text=\"即便人类无法理解世界的法则，\"\n@staffrolltext x=100 y=40 text=\"世界与人类依然存在这一事实，\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"以及不自觉地意识到并享受 “仅仅存在于当下” 这件事，\"\n@staffrolltext x=100 y=40 text=\"或许就是最轻松且健全的存在方式吧。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"你把他送过来了。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"――在想什么。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"是觉得无法从那条绯色河流的洪流中脱身\"\n@staffrolltext x=100 y=40 text=\"无法反抗、无法攀爬而上、\"\n@staffrolltext x=100 y=40 text=\"于是便想再次沉下身去、\"\n@staffrolltext x=100 y=40 text=\"任其漂流吗？\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"遵照神的意愿、\"\n@staffrolltext x=100 y=40 text=\"要将自己的孩子作为人柱――？\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"对于最不渴求它的人，\"\n@staffrolltext x=100 y=40 text=\"赋予了其他人都渴求的它、\"\n@staffrolltext x=100 y=40 text=\"这样的事偏偏还经常\"\n@staffrolltext x=100 y=40 text=\"发生在有缘分的人之间――\"\n@staffrolltext x=100 y=40 text=\"这的确是神的恶作剧，对欲望的考验真令人敬畏啊……\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"身为饭洼家长姐的我从未寄宿过御灵。\"\n@staffrolltext x=100 y=40 text=\"我不得不从除此之外的事物中去寻找自己的存在意义。\"\n@staffrolltext x=100 y=40 text=\"然而现实、\"\n@staffrolltext x=100 y=40 text=\"我从未有过哪怕一丝嫉妒你的念头。\"\n@staffrolltext x=100 y=40 text=\"如今自我的意义，是我自己亲手创造的、\"\n@staffrolltext x=100 y=40 text=\"原本人类就不存在所谓的『生存价值』。\"\n@staffrolltext x=100 y=40 text=\"只是\"\n@staffrolltext x=100 y=40 text=\"没错，只因自身不争气，要想赋予自己新的价值、\"\n@staffrolltext x=100 y=40 text=\"着实花了相当长的时间罢了。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"所以啊，\"\n@staffrolltext x=100 y=40 text=\"要将那孩子的价值、\"\n@staffrolltext x=100 y=40 text=\"存在的意义，\"\n@staffrolltext x=100 y=40 text=\"仅仅当作传递者的容器、玩家的视角，\"\n@staffrolltext x=100 y=40 text=\"这实在是太————\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"确实，我产生了共情。\"\n@staffrolltext x=100 y=40 text=\"即便说世间所有生命都不过是系统的反应、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"……不、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"你明白吗。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"是这样啊。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"还是说、\"\n@staffrolltext x=100 y=40 text=\"你是相信着什么吗。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"从未养育过孩子的我对此只能想象而已、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"父母原本就是这样的存在吗。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"即便说那一切都不过是这具肉体构造中被设定好的反应、\"\n@staffrolltext x=100 y=40 text=\"我等的同胞大概也会如此主张吧――\"\n@staffrolltext x=100 y=40 text=\"但如果这世间万物皆由此构成、\"\n@staffrolltext x=100 y=40 text=\"那么即便是这样的东西也自有其价值、\"\n@staffrolltext x=100 y=40 text=\"对于活在其中的生命而言亦有其意义。\"\n@staffrolltext x=100 y=40 text=\"若是一切皆为虚无──\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"据说对最强之白之夫说了虚伪之黑、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"束缚着最强的白色的扭曲的爱、\"\n@staffrolltext x=100 y=40 text=\"从那无法斩断的锁链、\"\n@staffrolltext x=100 y=40 text=\"是在试图连她自己也一同解放吗。\"\n@staffrolltext x=100 y=40 text=\"她之所以是最强其存在本身自不必说、\"\n@staffrolltext x=100 y=40 text=\"更是因为她被那位所爱着。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"在这个 “喜欢” 或 “厌恶” 构成运行法则根基的世界里、\"\n@staffrolltext x=100 y=40 text=\"从于我们而言堪称偶像的那位置上、\"\n@staffrolltext x=100 y=40 text=\"向着健全的应有之态……\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"果然你是对雫确信无疑了吗。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"不是逃避，而是通过直面问题来打破局面、\"\n@staffrolltext x=100 y=40 text=\"这是一种单纯、唯一且最为透彻的做法。\"\n@staffrolltext x=100 y=40 text=\"只要有觉悟就能做到。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"我能做到的事情究竟是什么，现实。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"难道说，只需一味地、执拗地相信就好吗。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"月之雫、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"在吾等这里它或许只是露水的别称――。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"若是清晨便会消逝之物、\"\n@staffrolltext x=100 y=40 text=\"愿黑夜不再重来。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"白玉之灵的慈悲啊请降临、\"\n@staffrolltext x=100 y=40 text=\"祈愿不成为白玉楼中的魂灵、\"\n@staffrolltext x=100 y=40 text=\"祈愿不被恶鬼一口吞噬――\"\n\n@staffrollstart height=2000 time=35000\n@wait time=105000\n@staffrolluninit\n\n@img_bg_trans img=img_bg_b\n\n@clickskip enabled=true\n\n@mes_no\n@img_bg_trans img=sub_M029END\n@waitclick\n\n@eval exp=\"sf.SC_S_012=1\"\n@jump storage=\"SC_E_026.ks\"\n"]],"context":[],"tags":[],"extension":".ks","dirname":"/data/scenario","progress":{"translated":1,"length":1,"percent":100},"indexIds":{";SubT『●●●を●●●ます（ゴカイ）』\n@playbgm storage=sunasiro_short.ogg loop=no\n@mes_no\n@clickskip enabled=flase\n@img_bg_trans img=vis078\n@staffrollinit\n@font size=25\n@staffrolltext x=100 y=600 text=\"●●●を●●●ます（ゴカイ）\"\n@font size=18\n@staffrolltext x=100 y=80 text=\"妹よ、お前ならどうする。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"否、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"お前は既にその結論を出したんだ。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"だから。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"彼は今、此処に、在る。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"旗は立てられ、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"場（ステージ）は既解（きかい）へと、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"確実に事が進んでいる。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"妹よ、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"母殿はお前を異端だと、\"\n@staffrolltext x=100 y=40 text=\"服（まつろ）わぬ者だと、\"\n@staffrolltext x=100 y=40 text=\"そう思っていたようだが、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"結局彼を産んだのはお前だ。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"具足の仕込みにも従順に従った。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"そう、\"\n@staffrolltext x=100 y=40 text=\"自由奔放であるようで、\"\n@staffrolltext x=100 y=40 text=\"お前は実のところ我等に反駁（はんばく）していた訳じゃない。\"\n@staffrolltext x=100 y=40 text=\"ただ、遣り方が、道筋が、違っただけだ。\"\n@staffrolltext x=100 y=40 text=\"と思う。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"個にして全、全にして個、\"\n@staffrolltext x=100 y=40 text=\"矛盾を無矛盾的に受け入れる、\"\n@staffrolltext x=100 y=40 text=\"ただそこに在るという事、\"\n@staffrolltext x=100 y=40 text=\"完全なるアリカタ。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"実際には精確な理論と\"\n@staffrolltext x=100 y=40 text=\"しかしヒト、いや世界を含め、\"\n@staffrolltext x=100 y=40 text=\"不完全なぶれをも完全に盛り込んだ完全さだ。\"\n@staffrolltext x=100 y=40 text=\"理想値というものを構想することは出来るが\"\n@staffrolltext x=100 y=40 text=\"実践するのは限りなく不可能に近い。\"\n@staffrolltext x=100 y=40 text=\"そして何よりも、\"\n@staffrolltext x=100 y=40 text=\"ヒトが世界のシキを理解出来ずとも、\"\n@staffrolltext x=100 y=40 text=\"セカイもヒトも在るという事実、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"ただそこに在るという事を無自覚的に自覚し享受する事が、\"\n@staffrolltext x=100 y=40 text=\"最も楽で健全なアリカタであろう。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"お前は彼を寄越した。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"――何を視ているんだ。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"緋色の川のその流れから\"\n@staffrolltext x=100 y=40 text=\"抜け出る事は出来ないと、\"\n@staffrolltext x=100 y=40 text=\"逆らい這い上がれないと、\"\n@staffrolltext x=100 y=40 text=\"再び身を沈め流されようと思ったのか？\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"カミの望むまま、\"\n@staffrolltext x=100 y=40 text=\"我が子を人柱に――？\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"最も其れを求めない者に、\"\n@staffrolltext x=100 y=40 text=\"しかして他の誰もが求める其れが与えられ、\"\n@staffrolltext x=100 y=40 text=\"そしてそれがよりにもよって\"\n@staffrolltext x=100 y=40 text=\"縁ある者同士に於（お）いて起きる事多し――\"\n@staffrolltext x=100 y=40 text=\"まさに神の悪戯、欲心検知畏るべし……\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"飯窪の長姉たる私にミタマが宿ることはなかった。\"\n@staffrolltext x=100 y=40 text=\"私は自分の存在意義をそれ以外で獲得せざるを得なかった。\"\n@staffrolltext x=100 y=40 text=\"しかし現実、\"\n@staffrolltext x=100 y=40 text=\"お前を妬ましく思った事など一度もない。\"\n@staffrolltext x=100 y=40 text=\"今の己の意味は自分で成したものだし、\"\n@staffrolltext x=100 y=40 text=\"元来人間に『生きる価値』というものは無い。\"\n@staffrolltext x=100 y=40 text=\"単に\"\n@staffrolltext x=100 y=40 text=\"ただ、そう、自分自身が不甲斐なく、新たな価値を纏（まと）うには、\"\n@staffrolltext x=100 y=40 text=\"なかなかな時間を要したというだけだ。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"だから、\"\n@staffrolltext x=100 y=40 text=\"あの子の価値を、\"\n@staffrolltext x=100 y=40 text=\"存在意義を、\"\n@staffrolltext x=100 y=40 text=\"単なる送り手の器、プレイアァの眼としてにするには\"\n@staffrolltext x=100 y=40 text=\"あまりにも──\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"感情移入をしているのは確かだ。\"\n@staffrolltext x=100 y=40 text=\"あらゆる生命が単なる機構（システム）の反応だとしても、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"……否、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"お前には分かったのか。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"そうか。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"それとも、\"\n@staffrolltext x=100 y=40 text=\"信じているのか。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"未だ子を成したことのない私では想像しか出来ないが、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"親とはそういうモノなのか。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"それすらもこの肉の構造に仕組まれた反応に過ぎないと、\"\n@staffrolltext x=100 y=40 text=\"我等の同胞は言うだろうが――\"\n@staffrolltext x=100 y=40 text=\"世がすべてそれで成り立っているのなら、\"\n@staffrolltext x=100 y=40 text=\"そのようなものにだって価値は、\"\n@staffrolltext x=100 y=40 text=\"その中で生きるものにとっては意味はある。\"\n@staffrolltext x=100 y=40 text=\"全てが不毛ならば──\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"最強の白の夫に偽りの黒をと言ったそうだが、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"最強の白を繋ぎとめている歪んだ愛、\"\n@staffrolltext x=100 y=40 text=\"切れぬ鎖から、\"\n@staffrolltext x=100 y=40 text=\"彼女自身をも解放させようとしているのか。\"\n@staffrolltext x=100 y=40 text=\"彼女が最強たるのはその存在は元より、\"\n@staffrolltext x=100 y=40 text=\"あの方に愛されているが故だ。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"スキかキライかが運営法則の根底にあるこのセカイで、\"\n@staffrolltext x=100 y=40 text=\"我等にとってイドラとも言えるその位置から、\"\n@staffrolltext x=100 y=40 text=\"健全たるアリカタへの……\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"やはり、雫を確信したのか。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"逃げるのではなく、直面する事で事態を打破する、\"\n@staffrolltext x=100 y=40 text=\"単純にして、たった一つの、最も冴えた遣り方だ。\"\n@staffrolltext x=100 y=40 text=\"覚悟さえ在ればそれが。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"私に出来る事は何だ、現実。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"只只（ただただ）、只管（ひたすら）信じていれば良いというのか。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"月の雫、\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"此方（こちら）側では露の異称か――。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"朝には消えるものならば、\"\n@staffrolltext x=100 y=40 text=\"夜がまた始まらん事を。\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"白きたまの慈悲よ在れ、\"\n@staffrolltext x=100 y=40 text=\"白玉楼中（はくぎょくろうちゅう）のモノとならぬを祈る、\"\n@staffrolltext x=100 y=40 text=\"鬼一口に喰われぬことを祈る――\"\n\n@staffrollstart height=2000 time=35000\n@wait time=105000\n@staffrolluninit\n\n@img_bg_trans img=img_bg_b\n\n@clickskip enabled=true\n\n@mes_no\n@img_bg_trans img=sub_M029END\n@waitclick\n\n@eval exp=\"sf.SC_S_012=1\"\n@jump storage=\"SC_E_026.ks\"\n":0},"indexIsBuilt":false,"cacheResetOnChange":{},"cellInfo":[[{"t":"HU"},{"t":"HU","v":1}]],"lastSelectedCell":[0,1],"parameters":[],"note":"完成"},"/data/scenario/first.ks":{"originalFormat":"Autogenerated TRANS obj","type":"","basename":"first.ks","filename":"first.ks","path":"/data/scenario/first.ks","relPath":"/data/scenario/first.ks","data":[["@loadplugin module=wuvorbis.dll\n@call storage=\"SC_CONF_01.ks\"\n@call storage=\"gvolume.ks\"\n@gvolmenu name=\"BGM\" control=\"bgm\"\n@gvolmenu name=\"効果音(&S)\" control=\"0,1\"\n@call storage=staffroll.ks\n*start|タイトル\n@cm\n@stopbgm\n@img_cha_r_free\n@img_cha_c_free\n@img_cha_l_free\n@layopt layer=3 visible=false\n@layopt layer=4 visible=false\n@layopt layer=5 visible=false\n@layopt layer=6 visible=false\n@layopt layer=7 visible=false\n@layopt layer=message1 visible=false\n@layopt layer=message0 visible=false\n\n;テストパラメタ------------------------------------\n;@eval exp=\"sf.flag=1\"\n;@eval exp=\"sf.end=1\"\n;@startanchor\n;@jump storage=\"first_miyo.ks\"\n;------------------------------------\n\n;オープニングロゴ----------------------\n@img_bg img=\"img_bg_b\"\n@img_bg_trans img=\"img_logo\"\n@wait time=100\n@img_bg_trans img=\"img_bg_b\"\n\n*logo|タイトル\n@startanchor\n@cm\n@image layer=base storage=img_bg_b page=fore\n@mes_all\n@nowait\n\n@locate x=-10 y=150\n@button graphic=m_img_01 storage=\"first_shiki.ks\"\n@locate x=-10 y=450\n@button graphic=m_img_05 storage=\"first_shiki_t.ks\"\n\n@locate x=190 y=150\n@button graphic=m_img_02 storage=\"first_aki.ks\"\n\n@locate x=385 y=150\n@button graphic=m_img_03 storage=\"first_zan.ks\"\n\n@locate x=580 y=150\n@button graphic=m_img_04 storage=\"first_miyo.ks\"\n\n@s\n","@loadplugin module=wuvorbis.dll\n@call storage=\"SC_CONF_01.ks\"\n@call storage=\"gvolume.ks\"\n@gvolmenu name=\"BGM\" control=\"bgm\"\n@gvolmenu name=\"効果音(&S)\" control=\"0,1\"\n@call storage=staffroll.ks\n*start|タイトル\n@cm\n@stopbgm\n@img_cha_r_free\n@img_cha_c_free\n@img_cha_l_free\n@layopt layer=3 visible=false\n@layopt layer=4 visible=false\n@layopt layer=5 visible=false\n@layopt layer=6 visible=false\n@layopt layer=7 visible=false\n@layopt layer=message1 visible=false\n@layopt layer=message0 visible=false\n\n;テストパラメタ------------------------------------\n;@eval exp=\"sf.flag=1\"\n;@eval exp=\"sf.end=1\"\n;@startanchor\n;@jump storage=\"first_miyo.ks\"\n;------------------------------------\n\n;オープニングロゴ----------------------\n@img_bg img=\"img_bg_b\"\n@img_bg_trans img=\"img_logo\"\n@wait time=100\n@img_bg_trans img=\"img_bg_b\"\n\n*logo|タイトル\n@startanchor\n@cm\n@image layer=base storage=img_bg_b page=fore\n@mes_all\n@nowait\n\n@locate x=-10 y=150\n@button graphic=m_img_01 storage=\"first_shiki.ks\"\n@locate x=-10 y=450\n@button graphic=m_img_05 storage=\"first_shiki_t.ks\"\n\n@locate x=190 y=150\n@button graphic=m_img_02 storage=\"first_aki.ks\"\n\n@locate x=385 y=150\n@button graphic=m_img_03 storage=\"first_zan.ks\"\n\n@locate x=580 y=150\n@button graphic=m_img_04 storage=\"first_miyo.ks\"\n\n@s\n"]],"context":[],"tags":[],"extension":".ks","dirname":"/data/scenario","progress":{"translated":1,"length":1,"percent":100},"indexIds":{"@loadplugin module=wuvorbis.dll\n@call storage=\"SC_CONF_01.ks\"\n@call storage=\"gvolume.ks\"\n@gvolmenu name=\"BGM\" control=\"bgm\"\n@gvolmenu name=\"効果音(&S)\" control=\"0,1\"\n@call storage=staffroll.ks\n*start|タイトル\n@cm\n@stopbgm\n@img_cha_r_free\n@img_cha_c_free\n@img_cha_l_free\n@layopt layer=3 visible=false\n@layopt layer=4 visible=false\n@layopt layer=5 visible=false\n@layopt layer=6 visible=false\n@layopt layer=7 visible=false\n@layopt layer=message1 visible=false\n@layopt layer=message0 visible=false\n\n;テストパラメタ------------------------------------\n;@eval exp=\"sf.flag=1\"\n;@eval exp=\"sf.end=1\"\n;@startanchor\n;@jump storage=\"first_miyo.ks\"\n;------------------------------------\n\n;オープニングロゴ----------------------\n@img_bg img=\"img_bg_b\"\n@img_bg_trans img=\"img_logo\"\n@wait time=100\n@img_bg_trans img=\"img_bg_b\"\n\n*logo|タイトル\n@startanchor\n@cm\n@image layer=base storage=img_bg_b page=fore\n@mes_all\n@nowait\n\n@locate x=-10 y=150\n@button graphic=m_img_01 storage=\"first_shiki.ks\"\n@locate x=-10 y=450\n@button graphic=m_img_05 storage=\"first_shiki_t.ks\"\n\n@locate x=190 y=150\n@button graphic=m_img_02 storage=\"first_aki.ks\"\n\n@locate x=385 y=150\n@button graphic=m_img_03 storage=\"first_zan.ks\"\n\n@locate x=580 y=150\n@button graphic=m_img_04 storage=\"first_miyo.ks\"\n\n@s\n":0},"indexIsBuilt":false,"cacheResetOnChange":{},"cellInfo":[[{"t":"HU"},{"t":"HU","v":1}]],"lastSelectedCell":[0,1],"parameters":[]},"/data/scenario/SC_M_018E001.ks":{"originalFormat":"Autogenerated TRANS obj","type":"","basename":"SC_M_018E001.ks","filename":"SC_M_018E001.ks","path":"/data/scenario/SC_M_018E001.ks","relPath":"/data/scenario/SC_M_018E001.ks","data":[["@staffrollinit\n@font size=20\n@staffrolltext x=100 y=600 text=\"ErwinS_ﾉ［∑:3orΣX3］\"\n@font size=18\n@staffrolltext x=100 y=80 text=\"（詳細未伝）\"\n@staffrolltext x=100 y=40 text=\"どんなに不味そうでも、\"\n@staffrolltext x=100 y=40 text=\"どんなに実際不味くても、\"\n@staffrolltext x=100 y=40 text=\"その身に、血肉に、なるのならば、\"\n@staffrolltext x=100 y=40 text=\"喰う他は無いよな。\"\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"どんなにそれを軽蔑していても、\"\n@staffrolltext x=100 y=40 text=\"どんなに胸糞の悪く趣味の合わないものでも、\"\n@staffrolltext x=100 y=40 text=\"そこから汲めるものが己を高め血肉となるものならば、\"\n@staffrolltext x=100 y=40 text=\"喰う他は無いよ。\"\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"植物と俗に称される生物においては…\"\n@staffrolltext x=100 y=40 text=\"まあここでは言うまい。\"\n@staffrolltext x=100 y=40 text=\"彼等も当然イキモノであって景色では無いと認識さえしていれば。\"\n@staffrolltext x=100 y=40 text=\"喰うというのは、\"\n@staffrolltext x=100 y=40 text=\"消化器系を備えたモノ達が他者の養を取り込み、\"\n@staffrolltext x=100 y=40 text=\"そいつを終わらせ自分が永らえる行為だが、\"\n@staffrolltext x=100 y=40 text=\"最悪なのはすべからくすべてにそういうコードが仕込まれて、\"\n@staffrolltext x=100 y=40 text=\"そういう命令が下されている事だな。\"\n@staffrolltext x=100 y=40 text=\"もし上位意志というモノが真実あるならば\"\n@staffrolltext x=100 y=40 text=\"（全てをヒトに置き換えて考えるのは愚かしいがな。\"\n@staffrolltext x=100 y=40 text=\"己が事として比喩を与え思考しないと\"\n@staffrolltext x=100 y=40 text=\"まるで把握が出来ないのが常なのだから仕方がない。\"\n@staffrolltext x=100 y=40 text=\"ただそれを比喩と取れない事が問題なのだ。\"\n@staffrolltext x=100 y=40 text=\"１という数字概念も時間という相の相対目盛機構も、\"\n@staffrolltext x=100 y=40 text=\"すべからく単なる見立てやモノゴトを他者に伝える為の\"\n@staffrolltext x=100 y=40 text=\"共通認識を作り出すためのお約束だ）\"\n@staffrolltext x=100 y=40 text=\"それは全ての生命と云われる存在にこう言ったのだ、\"\n@staffrolltext x=100 y=40 text=\"『アナタだけは必ず勝ち生き残れ、何をおいても』\"\n@staffrolltext x=100 y=40 text=\"競技の出場者全てに、残酷にして矛盾なる祝福を与えたもうたのだよ。\"\n\n@img_bg_trans img=sub_M018E001\n\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"（中略）\"\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"エネルギーの変換機構、\"\n@staffrolltext x=100 y=40 text=\"微細な最小構造ですら、他者の養無くしてはただの無機だ、\"\n@staffrolltext x=100 y=40 text=\"電気の通らないキカイ、シガイ。\"\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"（中略）\"\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"だからお前達、猫と魔眼の同胞は、\"\n@staffrolltext x=100 y=40 text=\"喰うこととは学ぶ事と知れ、\"\n@staffrolltext x=100 y=40 text=\"普通に蝕す分には不要なものは排泄されるのだ、\"\n@staffrolltext x=100 y=40 text=\"喰ってから取捨選択は為されるのだ、\"\n@staffrolltext x=100 y=40 text=\"分解しマテリアルと化し再構成する、\"\n@staffrolltext x=100 y=40 text=\"肉の成長、知の学習、\"\n@staffrolltext x=100 y=40 text=\"丸呑みは愚かな行為だと知れ、\"\n@staffrolltext x=100 y=40 text=\"噛み砕き己が解釈を再構成すること、\"\n@staffrolltext x=100 y=40 text=\"考えろ、考えろ、考えろ。\"\n@staffrolltext x=100 y=40 text=\"感じるモノもコトも必要だ。\"\n@staffrolltext x=100 y=40 text=\"理論は発見スルモノではなく気付くだけだと自覚したまえ。\"\n@staffrolltext x=100 y=40 text=\"我は個の幸福の為にお前達に猫を遣わしめた。\"\n@staffrolltext x=100 y=40 text=\"生命の本質のように視えるものとは、\"\n@staffrolltext x=100 y=40 text=\"エネルギーの変換機構、世界を視る眼としての存在、\"\n@staffrolltext x=100 y=40 text=\"認識の為の構造物、観測者、\"\n@staffrolltext x=100 y=40 text=\"それらの役を続ける為に相争いながら誰かが此処に居続けなければならない\"\n@staffrolltext x=100 y=40 text=\"最悪の箱庭へと放たれた我等全ての存在物の残酷な祝命を慰める友を\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"箱の中身は開けるまでは判らない、最後に希望が？\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"否、\"\n@staffrolltext x=100 y=40 text=\"箱の中に私は猫を視たから。\"\n@staffrollstart height=1500 time=45000\n@wait time=100000\n@staffrolluninit\n\n@img_bg_trans img=sub_M018E002\n\n@wait time=3000\n\n@img_bg_trans img=sub_M018E003\n\n@wl\n\n;subT『鬼憑きに気付く』\n@sub_title img=\"sub_E012\"\n@name_no ;　名前欄消去\n@img_bg_trans img=img_bg_20\n\n@name_kisama ;【姫様】\n「………何も？」[pc]\n\n@name_katsue ;【克杖】\n「え。[r]\nわ…わかんにゃい…です……」[pc]\n\n@name_kisama ;【姫様】\n「ひとつになりたい」[pc]\n\n@name_katsue ;【克杖】\n「…！？」[pc]\n\n@name_kisama ;【姫様】\n「そう言ってる、アヤメが」[pc]\n\n@name_no ;　名前欄消去\n@mes_no\n@img_bg_trans img=sub_M018E004\n@waitclick\n\n@clickskip enabled=true\n\n@eval exp=\"sf.end=1\"\n\n\n@jump storage=\"first_shiki.ks\"\n\n","@staffrollinit\n@font size=20\n@staffrolltext x=100 y=600 text=\"ErwinS_ﾉ［∑:3orΣX3］\"\n@font size=18\n@staffrolltext x=100 y=80 text=\"（詳細未伝）\"\n@staffrolltext x=100 y=40 text=\"どんなに不味そうでも、\"\n@staffrolltext x=100 y=40 text=\"どんなに実際不味くても、\"\n@staffrolltext x=100 y=40 text=\"その身に、血肉に、なるのならば、\"\n@staffrolltext x=100 y=40 text=\"喰う他は無いよな。\"\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"どんなにそれを軽蔑していても、\"\n@staffrolltext x=100 y=40 text=\"どんなに胸糞の悪く趣味の合わないものでも、\"\n@staffrolltext x=100 y=40 text=\"そこから汲めるものが己を高め血肉となるものならば、\"\n@staffrolltext x=100 y=40 text=\"喰う他は無いよ。\"\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"植物と俗に称される生物においては…\"\n@staffrolltext x=100 y=40 text=\"まあここでは言うまい。\"\n@staffrolltext x=100 y=40 text=\"彼等も当然イキモノであって景色では無いと認識さえしていれば。\"\n@staffrolltext x=100 y=40 text=\"喰うというのは、\"\n@staffrolltext x=100 y=40 text=\"消化器系を備えたモノ達が他者の養を取り込み、\"\n@staffrolltext x=100 y=40 text=\"そいつを終わらせ自分が永らえる行為だが、\"\n@staffrolltext x=100 y=40 text=\"最悪なのはすべからくすべてにそういうコードが仕込まれて、\"\n@staffrolltext x=100 y=40 text=\"そういう命令が下されている事だな。\"\n@staffrolltext x=100 y=40 text=\"もし上位意志というモノが真実あるならば\"\n@staffrolltext x=100 y=40 text=\"（全てをヒトに置き換えて考えるのは愚かしいがな。\"\n@staffrolltext x=100 y=40 text=\"己が事として比喩を与え思考しないと\"\n@staffrolltext x=100 y=40 text=\"まるで把握が出来ないのが常なのだから仕方がない。\"\n@staffrolltext x=100 y=40 text=\"ただそれを比喩と取れない事が問題なのだ。\"\n@staffrolltext x=100 y=40 text=\"１という数字概念も時間という相の相対目盛機構も、\"\n@staffrolltext x=100 y=40 text=\"すべからく単なる見立てやモノゴトを他者に伝える為の\"\n@staffrolltext x=100 y=40 text=\"共通認識を作り出すためのお約束だ）\"\n@staffrolltext x=100 y=40 text=\"それは全ての生命と云われる存在にこう言ったのだ、\"\n@staffrolltext x=100 y=40 text=\"『アナタだけは必ず勝ち生き残れ、何をおいても』\"\n@staffrolltext x=100 y=40 text=\"競技の出場者全てに、残酷にして矛盾なる祝福を与えたもうたのだよ。\"\n\n@img_bg_trans img=sub_M018E001\n\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"（中略）\"\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"エネルギーの変換機構、\"\n@staffrolltext x=100 y=40 text=\"微細な最小構造ですら、他者の養無くしてはただの無機だ、\"\n@staffrolltext x=100 y=40 text=\"電気の通らないキカイ、シガイ。\"\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"（中略）\"\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"だからお前達、猫と魔眼の同胞は、\"\n@staffrolltext x=100 y=40 text=\"喰うこととは学ぶ事と知れ、\"\n@staffrolltext x=100 y=40 text=\"普通に蝕す分には不要なものは排泄されるのだ、\"\n@staffrolltext x=100 y=40 text=\"喰ってから取捨選択は為されるのだ、\"\n@staffrolltext x=100 y=40 text=\"分解しマテリアルと化し再構成する、\"\n@staffrolltext x=100 y=40 text=\"肉の成長、知の学習、\"\n@staffrolltext x=100 y=40 text=\"丸呑みは愚かな行為だと知れ、\"\n@staffrolltext x=100 y=40 text=\"噛み砕き己が解釈を再構成すること、\"\n@staffrolltext x=100 y=40 text=\"考えろ、考えろ、考えろ。\"\n@staffrolltext x=100 y=40 text=\"感じるモノもコトも必要だ。\"\n@staffrolltext x=100 y=40 text=\"理論は発見スルモノではなく気付くだけだと自覚したまえ。\"\n@staffrolltext x=100 y=40 text=\"我は個の幸福の為にお前達に猫を遣わしめた。\"\n@staffrolltext x=100 y=40 text=\"生命の本質のように視えるものとは、\"\n@staffrolltext x=100 y=40 text=\"エネルギーの変換機構、世界を視る眼としての存在、\"\n@staffrolltext x=100 y=40 text=\"認識の為の構造物、観測者、\"\n@staffrolltext x=100 y=40 text=\"それらの役を続ける為に相争いながら誰かが此処に居続けなければならない\"\n@staffrolltext x=100 y=40 text=\"最悪の箱庭へと放たれた我等全ての存在物の残酷な祝命を慰める友を\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"箱の中身は開けるまでは判らない、最後に希望が？\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"否、\"\n@staffrolltext x=100 y=40 text=\"箱の中に私は猫を視たから。\"\n@staffrollstart height=1500 time=45000\n@wait time=100000\n@staffrolluninit\n\n@img_bg_trans img=sub_M018E002\n\n@wait time=3000\n\n@img_bg_trans img=sub_M018E003\n\n@wl\n\n;subT『鬼憑きに気付く』\n@sub_title img=\"sub_E012\"\n@name_no ;　名前欄消去\n@img_bg_trans img=img_bg_20\n\n@name_kisama ;【姫様】\n「………什么都？」[pc]\n\n@name_katsue ;【克杖】\n「哎。[r]\n我…我不明白…啦……」[pc]\n\n@name_kisama ;【姫様】\n「想要合为一体」[pc]\n\n@name_katsue ;【克杖】\n「…！？」[pc]\n\n@name_kisama ;【姫様】\n「阿梅娅是这么说的」[pc]\n\n@name_no ;　名前欄消去\n@mes_no\n@img_bg_trans img=sub_M018E004\n@waitclick\n\n@clickskip enabled=true\n\n@eval exp=\"sf.end=1\"\n\n\n@jump storage=\"first_shiki.ks\"\n\n"]],"context":[],"tags":[],"extension":".ks","dirname":"/data/scenario","progress":{"translated":1,"length":1,"percent":100},"indexIds":{"@staffrollinit\n@font size=20\n@staffrolltext x=100 y=600 text=\"ErwinS_ﾉ［∑:3orΣX3］\"\n@font size=18\n@staffrolltext x=100 y=80 text=\"（詳細未伝）\"\n@staffrolltext x=100 y=40 text=\"どんなに不味そうでも、\"\n@staffrolltext x=100 y=40 text=\"どんなに実際不味くても、\"\n@staffrolltext x=100 y=40 text=\"その身に、血肉に、なるのならば、\"\n@staffrolltext x=100 y=40 text=\"喰う他は無いよな。\"\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"どんなにそれを軽蔑していても、\"\n@staffrolltext x=100 y=40 text=\"どんなに胸糞の悪く趣味の合わないものでも、\"\n@staffrolltext x=100 y=40 text=\"そこから汲めるものが己を高め血肉となるものならば、\"\n@staffrolltext x=100 y=40 text=\"喰う他は無いよ。\"\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"植物と俗に称される生物においては…\"\n@staffrolltext x=100 y=40 text=\"まあここでは言うまい。\"\n@staffrolltext x=100 y=40 text=\"彼等も当然イキモノであって景色では無いと認識さえしていれば。\"\n@staffrolltext x=100 y=40 text=\"喰うというのは、\"\n@staffrolltext x=100 y=40 text=\"消化器系を備えたモノ達が他者の養を取り込み、\"\n@staffrolltext x=100 y=40 text=\"そいつを終わらせ自分が永らえる行為だが、\"\n@staffrolltext x=100 y=40 text=\"最悪なのはすべからくすべてにそういうコードが仕込まれて、\"\n@staffrolltext x=100 y=40 text=\"そういう命令が下されている事だな。\"\n@staffrolltext x=100 y=40 text=\"もし上位意志というモノが真実あるならば\"\n@staffrolltext x=100 y=40 text=\"（全てをヒトに置き換えて考えるのは愚かしいがな。\"\n@staffrolltext x=100 y=40 text=\"己が事として比喩を与え思考しないと\"\n@staffrolltext x=100 y=40 text=\"まるで把握が出来ないのが常なのだから仕方がない。\"\n@staffrolltext x=100 y=40 text=\"ただそれを比喩と取れない事が問題なのだ。\"\n@staffrolltext x=100 y=40 text=\"１という数字概念も時間という相の相対目盛機構も、\"\n@staffrolltext x=100 y=40 text=\"すべからく単なる見立てやモノゴトを他者に伝える為の\"\n@staffrolltext x=100 y=40 text=\"共通認識を作り出すためのお約束だ）\"\n@staffrolltext x=100 y=40 text=\"それは全ての生命と云われる存在にこう言ったのだ、\"\n@staffrolltext x=100 y=40 text=\"『アナタだけは必ず勝ち生き残れ、何をおいても』\"\n@staffrolltext x=100 y=40 text=\"競技の出場者全てに、残酷にして矛盾なる祝福を与えたもうたのだよ。\"\n\n@img_bg_trans img=sub_M018E001\n\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"（中略）\"\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"エネルギーの変換機構、\"\n@staffrolltext x=100 y=40 text=\"微細な最小構造ですら、他者の養無くしてはただの無機だ、\"\n@staffrolltext x=100 y=40 text=\"電気の通らないキカイ、シガイ。\"\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"（中略）\"\n@staffrolltext x=100 y=40 text=\"\"\n@staffrolltext x=100 y=40 text=\"だからお前達、猫と魔眼の同胞は、\"\n@staffrolltext x=100 y=40 text=\"喰うこととは学ぶ事と知れ、\"\n@staffrolltext x=100 y=40 text=\"普通に蝕す分には不要なものは排泄されるのだ、\"\n@staffrolltext x=100 y=40 text=\"喰ってから取捨選択は為されるのだ、\"\n@staffrolltext x=100 y=40 text=\"分解しマテリアルと化し再構成する、\"\n@staffrolltext x=100 y=40 text=\"肉の成長、知の学習、\"\n@staffrolltext x=100 y=40 text=\"丸呑みは愚かな行為だと知れ、\"\n@staffrolltext x=100 y=40 text=\"噛み砕き己が解釈を再構成すること、\"\n@staffrolltext x=100 y=40 text=\"考えろ、考えろ、考えろ。\"\n@staffrolltext x=100 y=40 text=\"感じるモノもコトも必要だ。\"\n@staffrolltext x=100 y=40 text=\"理論は発見スルモノではなく気付くだけだと自覚したまえ。\"\n@staffrolltext x=100 y=40 text=\"我は個の幸福の為にお前達に猫を遣わしめた。\"\n@staffrolltext x=100 y=40 text=\"生命の本質のように視えるものとは、\"\n@staffrolltext x=100 y=40 text=\"エネルギーの変換機構、世界を視る眼としての存在、\"\n@staffrolltext x=100 y=40 text=\"認識の為の構造物、観測者、\"\n@staffrolltext x=100 y=40 text=\"それらの役を続ける為に相争いながら誰かが此処に居続けなければならない\"\n@staffrolltext x=100 y=40 text=\"最悪の箱庭へと放たれた我等全ての存在物の残酷な祝命を慰める友を\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"箱の中身は開けるまでは判らない、最後に希望が？\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"　\"\n@staffrolltext x=100 y=40 text=\"否、\"\n@staffrolltext x=100 y=40 text=\"箱の中に私は猫を視たから。\"\n@staffrollstart height=1500 time=45000\n@wait time=100000\n@staffrolluninit\n\n@img_bg_trans img=sub_M018E002\n\n@wait time=3000\n\n@img_bg_trans img=sub_M018E003\n\n@wl\n\n;subT『鬼憑きに気付く』\n@sub_title img=\"sub_E012\"\n@name_no ;　名前欄消去\n@img_bg_trans img=img_bg_20\n\n@name_kisama ;【姫様】\n「………何も？」[pc]\n\n@name_