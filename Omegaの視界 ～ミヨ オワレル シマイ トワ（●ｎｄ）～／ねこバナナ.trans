"start":22371,"end":22387}],[{"start":22418,"end":22439}],[{"start":22471,"end":22499}],[{"start":22517,"end":22523}],[{"start":22531,"end":22564}],[{"start":22596,"end":22622}],[{"start":22640,"end":22650}],[{"start":22682,"end":22700}],[{"start":22731,"end":22764}],[{"start":22796,"end":22807}],[{"start":22838,"end":22866}],[{"start":22874,"end":22920}],[{"start":22928,"end":22974}],[{"start":23006,"end":23032}],[{"start":23050,"end":23104}],[{"start":23135,"end":23141}],[{"start":23173,"end":23190}],[{"start":23221,"end":23245}],[{"start":23277,"end":23299}],[{"start":23317,"end":23331}],[{"start":23342,"end":23414}],[{"start":23445,"end":23525}],[{"start":23557,"end":23617}],[{"start":23648,"end":23675}],[{"start":23683,"end":23732}],[{"start":23740,"end":23779}],[{"start":23811,"end":23863}],[{"start":23881,"end":23942}],[{"start":23973,"end":24014}],[{"start":24046,"end":24112}],[{"start":24143,"end":24189}],[{"start":24221,"end":24248}],[{"start":24266,"end":24277}],[{"start":24285,"end":24303}],[{"start":24335,"end":24360}],[{"start":24378,"end":24409}],[{"start":24440,"end":24470}],[{"start":24502,"end":24507}],[{"start":24538,"end":24590}],[{"start":24622,"end":24639}],[{"start":24657,"end":24697}],[{"start":24705,"end":24727}],[{"start":24738,"end":24775}],[{"start":24806,"end":24832}],[{"start":24864,"end":24882}],[{"start":24900,"end":24906}],[{"start":24938,"end":24945}],[{"start":25000,"end":25014}],[{"start":25022,"end":25047}],[{"start":25055,"end":25063}],[{"start":25095,"end":25102}],[{"start":25120,"end":25172}],[{"start":25180,"end":25243}],[{"start":25252,"end":25253}],[{"start":25263,"end":25265}],[{"start":25275,"end":25279}],[{"start":25311,"end":25334}],[{"start":25362,"end":25452}],[{"start":25460,"end":25491}],[{"start":25499,"end":25565}],[{"start":25573,"end":25639}],[{"start":25647,"end":25769}],[{"start":25777,"end":25878}],[{"start":25886,"end":25963}],[{"start":25971,"end":26024}],[{"start":26034,"end":26101}],[{"start":26109,"end":26146}],[{"start":26152,"end":26187}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_024.ks","basename":"SC_M_024.ks","indexIds":{"夕飯は大層豪勢なご馳走だった……と言いたいところだが、[l]\n『精のつく』と言った場合は必ずしも量だの旨さだのとは\nイコールで繋がらない訳で、\n大層…ではあったが、至極身体に良さそうなものが並ぶ、[l]\n舟盛りだの肉満載だ何だのといったイメージとは、\n若干異なる夕飯であった。":0,"決して不味くはないし、疲弊した肉体には染み入る料理の数々。[l]\n":1,"全き下戸であって、\n":2,"未だ飲み慣れぬ酒も少々":3,"乍ら":4,"嗜みつつ\n大変宜しい感じの夕餉だったのだが、\n贅沢を言えば味が薄めだので少々物足りなさ感が残ったくらいか。":5,"まあ初日の知狡さんの『あれ』を思えば……[l]\nで、結局何だかんだと言いくるめられて、\n報告は本気で混浴しながらと言う事態になったとさ。":6,"うーん、混浴も二日目以来か？[l]\nって、恋人夫婦じゃあるまいし、\n普通はそう何度も一緒に入らないんだろうが。":7,"しかして、今日は何故か屋内風呂であるらしい。[l]\n嵐の後だし露天はまだ入れないのかな。":8,"で、連れてこられたこの風呂は。":9,"こっちに来てから使ってた、従業員用らしい浴室とはまた更に別の、\n普通の家庭にあるようなユニットバスを少し……いや、[l]\n結構大きめにした内装だった。":10,"浴槽もでかく、金持趣味じゃ無い限り、\n複数人同時入浴が前提の設計であることは間違いない。[l]\n脱衣場も変に広いしなあ。":11,"中央に間仕切りのようにロッカーが置かれていて、\n宮さんと僕はそれを挟んで着替え……というか脱衣準備。":12,"ただ、あんまり使ってないからか、\n蛍光灯が古びてるらしく明かりが妙な具合だ。[l]\nにしても一体誰用の風呂なんだろ？":13,"「大昔はこっちがお客用の温泉だったですよ。[l]\nまだ小さかった頃ですね。[l]\n位置的には半分地下みたいな感じです。":14,"旅館自体を大きくするときに、\n記念というか趣味というか、こういう時の為にと言うか？":15,"うひひ、\n壊さないで改装する形で残しておいたです」":16,"準備出来たらしく、\nロッカーの向こうから現れた宮さんは、\n例によって紺色の水着だったようだが、":17,"繁":18,"繁と視るわけにはいかないので\nなるべく視線を逸らせつ喋りつ、早々に浴室に入った。":19,"「へえ……[l]\nだから浴室いやにでかいんすか。":20,"湯船もなんかでかいし、\n照明も暗くて前元号時代みたいな空気ですけど。":21,"その所為か、ちょっと怖いですね……[l]\n音もすごい静かつーか、\n古い映画みたいで」":22,"何でそんな昔を知ってるかは訊かない約束であろう。[l]\nま、宮さんも本家の人づてに事情聞いたのかも知れないしな！":23,"「露天はまだ使えないし、\nいつもの浴室じゃ二人でゆっくりできないですしね。[l]\n此処なら静かも静か、変な声出しても\n誰にも聞こえませんようひひ☆」":24,"「だれがなにゆえへんなこえを……」":25,"変な声は兎も角、\nえーと、こちらはと言えば、\n今日はその、ノーガードというか、\nタオル一枚巻きのみです。":26,"朝から色々あったので、\n本来はゆっくり身体を休めたい訳で、\nそもそも風呂で報告とは急な話だったであるとか、":27,"宮さんが\n『疲れてるなら何も履かない方が！締め付け良くないです！』":28,"と強く勧めてきたとかそう言った諸々の、\n話の流れ的にそうなったと言うか、\n拒否する余力も無かったと言うか、":29,"酒が入ってどうでも良くなってたと言うか、\n別に疚しい事をする訳じゃないしと言うか、":30,"今日はテンションがおかしいんだね。[l]\nそう、朝から色々あったから無理もないですがな。":31,"まあ如何に疚しい感情が無かろうと、\n流石に宮さんがバスタオル一枚って訳にはいかないので、\n向こう様には水着着て貰った。":32,"そこに関しては本人も渋ることなくあっさり提案は通ったので\n良かった良かった。":33,"「そ、そう言えば、その水着、\n前のとは違いますね？」":34,"ちらっと視た感じ初回のとは何かが違う。[l]\n色は同じに視えたけど……":35,"「んむ？[l]\n今日のはですねぇ、\nこれはいわゆる競泳用スク水。":36,"ほら、前のみたいにここに穴がないし、\n生地の質も違いますよ」":37,"下腹部の布を":38,"抓んだり引っ張ったりしてるらしく、\nぺしぺし音がする。[l]\nが、決してそちらは視ません！":39,"「あぁーあ、\nなんか大神がスク水と言えば旧型以外認めねぇとかどうとか……[l]\n前の奴が旧型？」":40,"「そうです。[l]\nまースク水のフォルムに関しては色々派閥もあるので……[l]\n宮は旧型かつ白のがお気に入りですけど」":41,"「白い奴なんかあるんですか？[l]\n僕のそちら系知識も、大神とか宮さんの所為で偏って来てますが、\nまあ深入りしないようにしますよ……」":42,"「うひひ、\n深入りしようったってそう簡単には入れないのがアチラ側の世界ですけどね」":43,"「難儀ですなあ……[l]\nではそろそろ今日の色々、報告致します……」":44,"「はぁーい。":45,"じゃ、\nお背中流しますから腰降ろしてください。[l]\n『ながら』で報告の方どうぞー」":46,"ぽしゅぽしゅぽしゅ。":47,"宮さんの手がスポンジを泡立たせる音が静かな浴室に響く。":48,"所":49,"謂お風呂用の腰掛けに背中を向けて座ると、\n宮さんがうんしょと後ろにスタンバイする。":50,"蛇口を使う関係もあり壁面の鏡とは平行に並んだので、\nまあ僕の前面が視られる事はない。[l]\nそうでなくても、お湯は張ってあったので\n浴室は湯気でモヤってたし。":51,"とりあえずは一安心である。[l]\nなにが一安心かは……[l]\nまあ、皆まで言わすな。":52,"「ええと背中の方はどうぞお構いなく、\n御無理のない程度でお願いします……」":53,"あの時以来、\nチョーカーは外すなと言われていたが、\n例外的に入浴時は外している。":54,"それ以外は寝るときも駄目だとさ。[l]\nお守りってのはそういう物だと……まあ、そうかなあ。":55,"縁起物ってのは故に縁起物なのであって、\nただ、最近首が熱くなるのはこれの所為な気もするけど……[l]\n皮膚に接触物があると局地的に意識が向くからなあ。":56,"何か格別良い素材なのか、ずっと身につけてる割には\nいやに無臭を保ってるので困りはしないが。[l]\nや、とは言っても外した時には除菌消臭処理してますよ？":57,"「ああ、\n大変に好い感じです……[l]\nありがとうございます」":58,"宮さんの擦りテクニックは、\n今日疲弊しまくった僕には、先の料理のように心地良い。[l]\nここのところ怒濤の連続イベントでしんどかったし、\nしばしこの快楽に身を委ねても罰は当たるまい。":59,"……何か誤解を招きそうな表現だな。":60,"おかしな方向へと思考が空転しないよう、\n邪念を振り払おうと、ふと目の前の壁を視る。":61,"鏡のある壁と垂直な位置関係となる眼前の壁には、\n大きな窓があるのだった。":62,"昔は外が望めたらしい大きな窓からは、\nこれまたかつては吹き抜けの中庭だったらしい空間が視える。":63,"今は物置みたいに、何かでかい桶みたいなもの等々が積んである。[l]\n只でさえ暗い照明なので、無灯のそっち側は混沌としていて、\n更に前時代的不安感を煽る不気味な":64,"佇まいだった。":65,"そんな僕の視線を察したのか、":66,"「昔はよくこの窓にカエルが張り付いてたりしてですね……」":67,"と宮さんが言った。":68,"だから何で知ってるんです、と言わせたいんかい。":69,"「明かりに惹かれて超でけえ蛾が来たりですかね……」":70,"取り敢えず迎合しつつスルーしました。":71,"「来ますねーでっかい蛾。[l]\n":72,"樟":73,"蚕みたいなの。[l]\nこれが西部だと":74,"守":75,"宮がまたそこらじゅうに出るですよ。[l]\n":76,"蝙":77,"蝠とか」":78,"「西部は旅行で数回泊まりがけしましたけど、\nそんな山奥行ったことないですからねえ。[l]\n……宮さん西部にも詳しいんですか？」":79,"「んむっ、別に山奥じゃなくて、街中の塀にいますよ、守宮。[l]\n詳しいと言いますか、西部に関してはかれおというソースがありますので」":80,"「ソース？お好みの？[l]\nあ、情報の出所という意味で。[l]\n西國の話だしややこしいったらないですな……」":81,"そうか、かれお嬢、西部出身て言ってたっけ。[l]\n喋りがああだから全然印象ないけど……":82,"「さて、\nではそろそろ、\n真面目な話しましょうか」":83,"発汗でアルコールも多少飛んだのか、\nやや":84,"明":85,"瞭してきた意識を集中して僕は、\n宮さんに説明を始めた。":86,"「午前中の例のあの式ですが、\nまず入るなり――」":87,"見破られた。[l]\n隣にいた謎の眼鏡女子は、\n自分も不法侵入者である事を告白し、\n同類の":88,"誼で僕を見逃してくれたらしいが……":89,"「なるほど……[l]\n不思議ですねー」":90,"「ええ、\nやけにニッコニコしてたというか、\nもしほんとに部外者なら、\n場慣れしてたというか肝が据わってたというか。":91,"途中は鼻歌まじりでしたし、\nやっぱり何度も潜入してるかもですね。[l]\n僕らと同じように三春の御神体とか祭とかの秘密を探ってるんでしょうか」":92,"「手引きしてくれた子とは関連性なかたですか？」":93,"「……うーーん、[l]\n狩屋、とですよね？":94,"………。[l]\n………。[l]\nああ、そう言えば僕がそこから出る時、\n狩屋に手を振ってた――ように視えました。":95,"ただ彼奴は気付いてませんでしたからそこはなんとも……[l]\nあとは、そうですね……[l]\n今にして思えば何か言葉のイントネーションが不自然というか、\n若干":96,"態とらしい感じが――した、ようなしないような」":97,"「なるる。[l]\nお互い詮索無用ということで、何かされた訳では無いんですね？[l]\n何となく諒解しました。":98,"んむ――\nん、取り敢えずその眼鏡さんは後程にしましょう。[l]\nどぞ、続けてください」":99,"背中を向けてるので宮さんの表情は伺えないが、\n兎に角報告を続ける。":100,"「で、前言った喋る猫……喋るのは妄想かもですが……":101,"そいつかどうかは当然判らなかったんで、\n関係あるかどうかはアレですけど、\n猫を抱いた黒ずくめの――\nえーと初日に冬夏が着てたような奴ですね。":102,"鍔の広い帽子も被ってて。[l]\nそういう人影が会場に、\n………[l]\n――あれ？」":103,"「んむ？」":104,"「え、ええと、\nあの暗い場内で何故そう認識出来たのか解らないんですが、\nうーん、何でですかね？":105,"と、兎に角その会場に居た、と『判りました』。[l]\n猫を抱いた黒ずくめの人物が」":106,"「『判りました』？」":107,"「ん、んー……[l]\n改めて追求されると根拠は弱いですねえ……[l]\nおっかしいな、何でそう『判った』んだ？」":108,"「思ったではなくて判ったですか？」":109,"「え？[l]\n今僕そう言いました？」":110,"「ん、\nいえ。[l]\n大丈夫です。":111,"まこくんのことは信じてますよ！[l]\nどうぞ続けてください？」":112,"「はあ、\nまあこの件に関しては、\n今言ったように根拠は薄弱でして……":113,"何で気になったのかと言われれば、\n喋る猫自体が幻視であるかも知れないという\n心許ない根拠ではありますが、":114,"宮さんは近づかない方が善いと言ってましたし、\n何か心に引っ掛かってた、という感じですかね……」":115,"「なるー……[l]\n向こうからは気付かれなかったんですね？[l]\n式に夢中だったか……それとも」":116,"「はい？[l]\nえ、まあ、多分ですが。":117,"入場時に若干目を引いたかもですが、\nその後特に、接触があったりした訳では無いです」":118,"「で、\n一匹野良が紛れ込んで来たとかじゃなく、\n誰かに抱かれてた訳ですね？[l]\nその……猫は」":119,"「ええと、僕の見立てが本当なら、ですが……[l]\n何か引っ掛かります？」":120,"「なるる。[l]\nなるるです。":121,"いえ、玄ノ森には猫が多いので。[l]\nどっちだろう、と思っただけです。[l]\nこないだまこくんが視たのは、人に呼ばれてどっかに行ったんですよね？」":122,"「そうですね。[l]\nあ、飼い猫だってことですか？":123,"まあ呼んでたのは子供の声だったようですから\n何とも言えませんけど。[l]\n子供はそういうの何にでも声かけそうですしねえ」":124,"「色と顔が判ればなぁ……」":125,"「はい？[l]\n済みません聞こえませんでした」":126,"「んむ？[l]\n何にも言ってないですよ？」":127,"あれ？[l]\nおかしいな。":128,"「既に候…は限…なく…まってる…ら……[l]\n…ぼ確…だ……」":129,"「え？」":130,"「………」":131,"「どしたの？」":132,"「何か言いませんでした？」":133,"「言ってないですよぉー。[l]\nやだまこくん、\n幻聴ぶり返し？[l]\nそれとも季節外れの……」":134,"「ややややめてくださいよ。[l]\nどっちもやですよ」":135,"「うひひ、\n怖がりですなぁー。[l]\nま、こないだ喋る猫に近づくなと言ったですが、\n玄ノ森はほら、知狡も言いましたけど猫が大事にされてますから」":136,"「から？」":137,"「『月狂跳』にそういう内容のもあるですね。[l]\n人語を解する猫の……禁忌？」":138,"「うえあっ。[l]\n怖い系の伝承すか」":139,"蠱物としての伝承が世界的にあるし、\nこの國じゃ特にそう言う面が色濃くあると思うが、\n玄ノ森がそういう風潮の強い地域とは――記憶にないなあ。[l]\n僕の場合はそれがまた当てにならないんだが。":140,"「書蔵守の頃の伝承にしろ、\n":141,"件の祭や秘儀御神体にしろ、\nまあ今日の式にしろですね、\nこの町では猫に関する禁忌は":142,"其":143,"処":144,"彼":145,"処に」":146,"え？[l]\nあの式も、か？[l]\n猫絡みなのか？":147,"それよりそんな事まで宮さん何故……":148,"「あれ、そうか、知ってるんでしたっけ。[l]\n母さんも知狡さんも体験してるって……":149,"そういやあの変な言語にも、解読すると呪われるとかいう":150,"謂れがあるとか言ってた……[l]\nでもあれのどこに猫関係の要素が」":151,"「感得した者にとって、\nそれは不自然ではないのですが、\n……説明は難しいと言いますか不能と言いますか」":152,"「あの言語がみゃんみゃん言ってて猫っぽい、てのは解りますけど。":153,"音に対する印象であって、意味に関しては理解は勿論、\n感想すらマトモに思いつかないですよ。[l]\nその、言葉もそうですがね、あの式は一体なんだっていうんです？」":154,"それを知る事が僕自身の\n――飯窪家や宮さんは知ってるようなので――\n目的の一つの筈だった訳だが、\nここに来て完全に匙を投げました。":155,"「結局は、ですから感得した事があの式の全てです」":156,"えあっ。":157,"「それは大悟とか":158,"頓":159,"悟とか禅の話みたいなですか？[l]\n":160,"不 ":161,"立 ":162,"文":163,"字？以心伝心とかの？」":164,"「んむ－、\n要するに、言わなくてもわかるでしょ？[l]\nという、『感覚を共有できる事自体』が大事なのです。":165,"ヒト以外の事はここでは横に置いておきますよ。[l]\n言葉というのはそれこそ文化圏それぞれで異なる訳で、\nコミュニケーションの手段としては極めて曖昧なのです。":166,"この國は島國だから気付きにくいですが、\n多言語間で解釈の差違が増幅されることは度々あるでしょう？":167,"翻訳ソフトって知ってます？[l]\nバラエティでネタになるくらい誤訳…というか、[l]\n直訳しただけだとしても意味は相当に変わってしまいます。":168,"意訳にしたって訳者の趣味嗜好ですからね、\nどんなに性能が上がっても、完全に正確な変換はまあ、\nほぼ無理ですよね」":169,"そして、と、いつになく饒舌な宮さんは続ける。[l]\n背中を擦るのもずっと続けておられます。":170,"大丈夫かな……[l]\n僕の背中も含め。":171,"「これが仮に同言語圏なら通じ合えるか、と言うと、\nこれまた無理ですね。":172,"読解力の問題もありますが、結局の所言語自体が\nヒトが創ったルールですから、\nあくまで約束事、記号である言語というシステムでは\n伝達は難しいですよ。":173,"チノとはよく話してますが、\nデジタルかアナログという比喩を使うんですけど。[l]\n例えばＣＤとレコードというですね……」":174,"何か熱が籠もってきたなあ。[l]\n擦る力も心なしか強く……":175,"「文字言語を図像とみなすならば、\nんっ、\n意味としては一緒なのかもしれませんが、\nんむっ、":176,"やはり言語というのは聴き手各自の解釈が違うくせに、\nんんっ、":177,"連想されうる規定された意味というものがあるために\n非常に誤解しやすい、\nむぅ、":178,"で、幅のある解釈の中でどれを選択するのか、」":179,"もう何言ってるかようわからないし、\n宮さん自身も解ってないんじゃ……[l]\n既に文章的に破綻……かどうかもあやふやだが。[l]\nチノ嬢の話みたいになってきた……":180,"お、\n手が止まった。[l]\n疲れたか……":181,"というかずっと僕ばっかりして貰ってて良いんだろうか。[l]\nと思うも束の間、\n宮さんの話はまだ続くらしい。[l]\n再び背中を擦る音と共に、宮さんは一呼吸置いて話し出した。":182,"「なので、言語以外のモノで伝える、或いは理解できる事が、\n重要視されるのです。[l]\n文化圏間の差違をも超越する、根源的な理解です。":183,"この場合は誤解というよりは見解の相違として、\n本意と違う場合は拒否されるだけです。":184,"……うーん、[l]\nやっぱり説明が難しいですね。[l]\n矛盾してるように聞こえてしまうでしょ？[l]\nそもそも言葉で伝えようとする行為自体が矛盾してるですけど……」":185,"「いや、\nお話になってる内容をですね、\n論理的に解析するにはあまりにリアルタイムというか、":186,"それこそ文字で書いてあるのを読めば\nそう思えるかも知れないですが、\nこうやって聞いてるだけでは……":187,"まあ僕もですね、\n宮さんの言ってること、\n何となく解ってるとは思うんですが」":188,"感覚的に、と言うならば、だが。[l]\nこの話題の流れ的に、幸い言葉でレスする必要はないようだから、\n主観的にそう感じているという意味で嘘は言ってない。[l]\nただ、正解かどうかは別だけど。":189,"「んむ、\nそれこそ解ったか解らないかを言葉で証明することは不可能ですが、\nそこはそれ、行動で示す、という証明が求められる訳ですね。":190,"依頼主が望む仕事をするとか、\n所謂芸術系創作系の職種だと分かり易いですかね」":191,"……つまり大神とかだな。[l]\n商業仕事じゃないと思うけど、\n何かいっつもイベントで本だの創って売るとかどうとか。":192,"「腹芸が通じるとか空気読めるとかもそう。[l]\n察するとか」":193,"察する……":194,"最近矢鱈とそれが出来る方々と出逢うんですが。":195,"「絵とか文字……つまり視覚的な要素の解釈が[l]\n最も分かり易く資質を判断出来るツールであるのかも知れませんねぇ。[l]\n玄ノ森で三春家と飯窪家が書を集めて来たのも、\nもしかするともしかする、かもですね。":196,"月狂跳は資料群ですから絵とか図も含まれますし、\n寧ろ文字情報が全く無くてそこから意味を\n汲まなければならないものも\n中にはありますですよ。":197,"今日の式に関しては――\n先日言いました『歌は魔術の最たるもの』、\nという考え方の良い例かも。":198,"音の方は視覚無しでも受容する事ができますしね。[l]\n所謂芸術と呼ばれる物は絵か音に関連する物が大半ですし、\nまあ言外にある何かしらを汲める資質、こそが」":199,"そこまで言ってから、宮さんは手も口も動かすのを止めた。":200,"「？」":201,"「………んっ、くふぅ、ぁん」":202,"「？？[l]\nど、どしました？」":203,"「ぅえ゛くしゅ！！」":204,"「おわあ！！！！[l]\nっくりした！！！[l]\nだ、大丈夫ですか？」":205,"く、":206,"嚔かい。[l]\nいきなり変な声だすから焦ったわ……[l]\nロケーションというかシチュエーションがあれなもんだから……[l]\n――いやいや、ホラー的と言う意味ですから！":207,"「ふー、\nあ、ごめんです。":208,"何でしたっけ……[l]\n……、[l]\n……まあ、いいです。":209,"結局のところはですね。[l]\n言わなきゃ判らないんでは、\n言ったところでやっぱり判らないのですよ。":210,"なので宮や知狡、まこくんママが感得した事、\nそれが真実あの式が伝えてる事と完全なるイコールかは別ですけどね、それを言葉で今説明することはできない、と言うのが結論です。":211,"今まで喋ってきたような、\n限りなく近い喩え話は出来ますけど、\nそれこそ公案みたいになっちゃいますし、":212,"ま、\nあの式に限らず、\n今回の諸々でまこくんが感得したもの、\n宮達と共有出来てると――信じてますよ」":213,"うーん。[l]\n何か煙に巻かれた気もするが……":214,"そもそもそれを毎年行う意図は――\nそれはまあ、宮さんの決めた事じゃないし、\n祭って大体よくわからない理由背景が由来や\n実行根拠だったりするしな。":215,"ともあれ、\n言葉での説明は困難だ、という事を言葉で説明するのは非常に厄介、\nという事ですかなあ。":216,"「はあ、\nじゃ、なんで姫様ちゃんは僕にそれを……[l]\nあの式をみせようとしたんでしょう」":217,"「三春が仕切って祭と併せて昔からやってるあれが、\n解る人間に伝えてるはずの解る何か、\nそれを、\nまこくんには解って貰えると思ったですかね」":218,"その根拠が全く解らないから唐突なんだけど……[l]\nそれこそ姫様ちゃんはその『根拠自体を』感得したとでもいうのだろうか。[l]\n彼女は特に発する言葉も少ないしなあ。":219,"「そう言う意味では双方に残念ですけど、\n中身に関しては、\n結局さっぱり解らなかったと言いますか、\nそれどころじゃない事が起きたと言いますか、":220,"猫がらみの幻視とか幻聴とか、\n妙なものは最近やたらその、感得してるようなんで、\nいや、でも『あれ』は……」":221,"「んむぅ。[l]\nまあまだ…全な……じゃ…いし、…図的に…避してるか……ね」":222,"「……やっぱり何か言ってません？」":223,"「えっ？[l]\n残念だなーって。[l]\nあ、兎に角例の猫、なるべく近寄らない方が――\n身の為です。うひひ」":224,"「………まあ、[l]\nもう自分の五感に自信がなくなってますからね。":225,"言われるが儘に流されますよ。[l]\n伝承禁忌の類にも従いましょう。[l]\nそれよりも」":226,"問題はその、\n『あれ』だ。":227,"最近頻繁に起こる幻視症状を併せ考えても、\nあのリアル体験はどうにも……":228,"一応、詳細に説明はしてみた。":229,"が、":230,"「まるで主観の話なんで信じて貰えるかどうか、\n最近はそれでなくても変な感じなんで、\nあれなあれであれなんですが」":231,"「んんんんんん～～～\n――思ったより、」":232,"「え、重症だと？」":233,"「ん？[l]\nいや。[l]\nあいや、いえいえ。":234,"それは――…や…ぎるな、[l]\nいえ、んむ、うー、」":235,"――宮達には及びもつかない体験ですね。":236,"と言った宮さんだが、\n様子が変だ。":237,"宮さんも怖くなったのかしらん。[l]\n何だかんだ言って、自分もそういう系の話は苦手だったか……":238,"「まあ、\nそんなモノが実在するかどうかは別としてですね、\n体験自体はリアルだと思うわけですよ、\nそれで」":239,"「ああ、それでかれおんの彼氏さんに」":240,"「そうです……って、[l]\n言いましたっけ彼奴の話？[l]\nどうも記憶があれなもんですから……":241,"と、兎に角、大神は一応そういう『体質』らしいので、\n僕の症例と一緒かどうかは別として対処の心得みたいなものを\n聞いてみようかと……」":242,"「んー、\n何かが視えたとしても、\nそれそのものから害を受けたわけではないのなら心配なくない？[l]\nなくなくない？":243,"まあ視えるだけならそういう症例も世界中にあるしぃ、\n体調がおかしいんだったら適度にお休みして貰いますけど、\n病院にも行きましたし、":244,"うーん、特異体質が突如発現したのだとしたら、\nそれはまこくんの身体的個性として受け入れるしか\nないでしょうしねえー。":245,"その、かれおの彼氏さんみたいに。[l]\n生物という生物がみんな同じ受容器を持ち同じ視界を持ってる、\nと言う訳でもないですしね。":246,"気にすることはないですよ、\n寧ろまこくんもそういう力に目覚めたと思えば\n良いんじゃないですか？[l]\nイカス！かっこいー！！主人公みたい！！いやっほう！！！」":247,"「僕ぁこれでもそういう特権意識に浸るのはなるべく\n自粛するよう心掛けてるんですよ……[l]\n大体あの、あれやこれやが視えた所で何の利点が」":248,"「んー？[l]\n人と違う視界を持つのは色々愉しいって、\nまこくんママから教育されてたんじゃないの？」":249,"……いくら母さんと面識あるとは言え、[l]\nそんな事まで聞いてたのですか貴女は？[l]\n考えたくない事まで考えてしまいそうですよ。":250,"「それとこれでは次元が違う気もしますが……[l]\nまあ人は成長するものですし、後天的にスキルが増える事も\nあるんでしょうけど」":251,"宮さんというか、飯窪本家がびっくり人間ばかり遣うものだから、\nそういう他人と違う能力とか資質に関して鷹揚になってるかも\n知れないが、":252,"当人にとっては流せるものでも……[l]\nあるのかなあ。[l]\n大神はどうなんだろう。":253,"「っていやその、視える件に関してはそうかもしれないですけど、\n金縛りの件がまだ、」":254,"「そうそうまず判ったことが一つ、\n先刻の眼鏡女子ですっけ？[l]\nまこくんの隣りに居たのは三春家眷属のうち西部のトップ、\n――の家の者ですね」":255,"急に話が展開し、":256,"「は、なんで判ったんです？」":257,"という問いには応えず、":258,"「玉梓選律――か、んむう、\n多分そういう名前……と思うですが」":259,"と歯切れの悪い反応、というか独り言のようにごちた。[l]\n僕の話は中断、質問も華麗にスルーされたもよう。[l]\nこっちの声聞こえてないんかな？":260,"しかしこっちもそろそろ空転がとめどない。[l]\n話の腰を折り返す気力があるかと言えば、\nもう諾々と流されるのみ。":261,"「センリツせんりつ……[l]\nああ、狩屋がセンノジがどうとか言ってたのは…[l]\nその人、の事だったのかなぁそう言われると」":262,"「んむ、\n今後三春関係者と接触多くなると思いますが、\n彼女も出来れば避けた方がいいです。[l]\n察しが――いい女と聞いてます」":263,"「そ、そうなんすか……[l]\nまあ、喋りもしてないのに見破られたし、\nそりゃ察しが良いんでしょうが……":264,"そうか、だから無部外者なのに中に……[l]\nいやつまり部外者じゃない、あーもうややこしいな。":265,"そう言えば年も誤魔化してたようですけど。[l]\n見た目通りじゃないって――」":266,"「そんな事言ったんですか？[l]\n自分から？」":267,"「え？[l]\nええ、ただまあ、別に普通の女子高生に視えましたけどねえ」":268,"「当主だと名乗ったとか？」":269,"「いえ、そんな事は……[l]\n知狡さんみたいな例もありますから\n女性の容姿と年齢に関してはその、":270,"あ、いや何でもないです。[l]\n誤魔化してるったって精々２０代じゃないかなあ……[l]\n暗かったので何とも言えませんけど……":271,"声とか喋りから":272,"鑑みてもそんなでしたよ。[l]\nああ、逆に小中学生って線もありますか……[l]\nん？[l]\nその辺の情報も既知のものですか？」":273,"「……ふぬ？[l]\nお、おういえー。[l]\nかれおみたいに西國にも飯窪の手の者は配置されてますからね」":274,"「手の者て、悪の一味みたいな言い方ですが……」":275,"「ともかく、これでまた三春関係者との接触がなされた訳ですねー。[l]\nまこくん連れてきて正解でした」":276,"「はははは……[l]\nその状況が果たして吉と出るかどうなんだか、\nまあ役に立ててるなら良いんですけどね、\nそうでなきゃ僕としてもあまりに悲しいものが……」":277,"大体、ミッションコンプリートにはまだまだ遠い、\nんだろうしなあ。":278,"「んむーと、今日の時点":279,"迄でまこくんが接触したのはぁ、\n三春家の冬夏ちゃんとお母さん、\n綾目家の姫様ちゃん、\n狩屋家の克杖ちゃんとお母さん、":280,"永久家の卑尊ちゃん、\n奇士家の道具ちゃん、\n玉梓家の選律ちゃん、\nかな？」":281,"「東國の三春系列の人間とは全部接触して……ますよね？[l]\n西國は確か三家だから……あれ、一個足りない？」":282,"「飯窪本家が知るところに依れば、\nあとは玖威家です」":283,"「食い気？[l]\nああ、玖威家。[l]\n……逢ってませんねぇ」":284,"「すれ違うくらいはしてるかもですけどね。[l]\n今日の式を滞りなく行ったという事は、\n祭の方も基本的には中止するつもりも無いでしょうからね、\nあとは日程が予定通りになるかどうか――":285,"そうならば西國の眷属を早めにこっちに呼んでる\n可能性もありますから。[l]\nまこくんのようにね」":286,"そう、それで僕はあっさりと人生の路線変更させられたんですが。":287,"「まあねえ……[l]\nあと逢ったのはきぃ――貴奴くらいですか……":288,"そう言えば彼奴、\n長久診療所でバイト？してるだけじゃなくて、[l]\nその奇士道具さんとも何か知り合いらしいんですが。[l]\n先日は言い忘れましたけど」":289,"西國の人間とどうやって繋がりが出来るのか、\nまあ事情はあるんだろうけど、\n不自然とまでは言わずとも、":290,"うーん、こっち来てからあまりにも事が起こるというか、\n無節操なようでいて実は大きな括りで繋がってたりとかするから、\n変に作為的恣意的な気配を感じるんだよな。":291,"「西國……ぁ、ニ……シ……？[l]\nんむー、\n前も言いましたけど、\n字面に確かに覚えはあるんですが。":292,"やっぱりメモしないと忘れるですねぇ……[l]\n知狡……じゃ難しいか、かれおにでも確認してみます」":293,"「はぁ。[l]\nそれこそ別に被害を被った訳じゃないし、\n冬夏と渡りを付けてくれたのは彼奴ですしね。[l]\n障害になるような話でも無いとは思いますが」":294,"「ですかねぇ」":295,"「あ、それよりですね……」":296,"実は、":297,"先刻から、":298,"宮さんに言いたいことがあったのだけど……":299,"「んむ？[l]\nなぁに？」":300,"僕は上半身を捻って宮さんの方を向いて言った。":301,"「あんまりずっと背中ばっかり擦られても」":302,"「えっ――、前も……って事！？[l]\nん、んむー、\nそれは各方面からお叱りの言葉が……」":303,"「違いますっ！！[l]\n僕ばっかりして貰ったんじゃ悪いと思っただけですよ！[l]\n結構時間経ってるし！！」":304,"自発的に言うと触らせろと言ってるようで言い出し難かったから\n言わなかっただけです！":305,"うっ、言う言うばっかりだな……":306,"「と、思ったら……お返しにお背中流すといってもその、[l]\n難しいですかね。[l]\n考えてみれば当たり前ですけど、水着の形状的に」":307,"「んむっ、\n折角のまこくんの好意を無にする宮ではありませんですよ！":308,"じゃー上だけ半脱ぎなるので\n向こう向いて待っててください。":309,"心配しなくてもバスタオルで前は隠しますから、\n遠慮することはないですよ♪」":310,"いや、そのそれはいくら何でも。[l]\nこっちの装備はタオル一枚ですので色々と障害が。":311,"「いやいやあわわわわわわ」":312,"いきなり水着を肩紐から脱ぎかける宮さん。[l]\n僕は慌てて身体の向きを変えます！":313,"「あ、タオルが脱衣場でした」":314,"びびびび吃驚させんといてください。":315,"ああもう、":316,"経験上、押せば引く、というのは判ってるんだが、":317,"そっちから一方的に具体的な行為を始められたら、\nこっちは諾々と従わざるを得ないというか、":318,"「ままま、待ってますから、準備万端にしてきてください……」":319,"今更押しに転じるにも、機を逸した感が否めないなあ……":320,"「んぁんもう、\nまこくんてばやる気満々ですか☆\nそんなに……したいなんて」":321,"………。":322,"――やっぱりこの手のハナシの応酬では先手を取るに限るなあ……":323,"まあ僕の場合、イニシアチブを取るよりは、\n相手の流れに身を任せた方が性に合ってるのかもな……":324,"と、宮さんが脱衣場から戻ってきたが、\n当然直視は無理ですよ。[l]\nなるべく視線を合わさないようにしつつ、\n宮さんが座るのを待つ。":325,"「はーい、じゃ、\nお願いしまぁーす」":326,"そうだ、流されると言えば。":327,"「では失礼して……[l]\nそれで、明日成り行きで、\n先刻ちらっと話した、\n狩屋と姫……綾目の家の娘達の手伝いをすることに……」":328,"今回は何かしらの手がかりを得られるような\nイヴェントではないぽいし、\n確認取るとは言ったが勝手に了承の返事をしてしまい、\n怒られるかとも思ったが、":329,"「ほうほう。[l]\nま、いいんじゃないですか。[l]\n折角懐柔が順調にいってるんですから駄目押し的に恩を売るのも\nありでしょー。":330,"どうせ制服とか返したりとかで接触の機会は今後もあるですしね。[l]\nその代わり、お守り――チョーカーは忘れずに装備していくこと。[l]\n有用な情報は":331,"視逃さず聞き逃さずで」":332,"割とあっさり了承された。[l]\n冬夏は咬んでないはずだから、\nどんだけ根幹に関わる情報得られるかは解らないが……":333,"そう言えば彼女の事も気になる事案ではあるんだよなあ。[l]\n今日のこと隠し通すかどうかとか……":334,"煩悶としながら、宮さんの背中を洗う。[l]\n否、宮さんの背中を洗いながら煩悶とする。[l]\n宮さんの背中に意識が集中しないよう、\n且つ乱暴にならないように気を遣いつつ！":335,"添い寝といい今といい何をしとるんだろう僕は。":336,"「あ。[l]\nあと、これも":337,"先":338,"刻言いましたけど、\n僕の小さいときの記憶が何となくですが、\n思い出して来たっていうか、":339,"ああええその、\nわざわざ報告する事じゃないし雑談として聞いて欲しいんですが、\nその、」":340,"……昔、僕ら、既に逢ってたりしませんか。":341,"とは訊けない。[l]\n色んな意味で危険、訊けない。":342,"「あのえーと、\nそうあれですよ、あれ、\nこの辺に海岸とかありましたっけ？":343,"砂浜の……[l]\n海水浴場ほどでかくなくていいんですが」":344,"「……ん？[l]\n海岸。[l]\n結構離れた所になりますけど。[l]\nこの辺では……まあ、目の前にありますようにまだ河ですね。":345,"でも、小さいときでしたら、\nまこくんママとか知狡とかが車で連れてってる可能性はありますね。[l]\n――あ」":346,"先刻僕が思った事と大差ない内容だが、\n元より話題のすり替えの為だったので構わないはずだった、\nのに、":347,"「ど、どうかしたんすか？」":348,"「他に憶えて――思い出した事はありますか？」":349,"ま、":350,"真":351,"逆":352,"覚られましたか！？":353,"「う、うーん……いや、特に……」":354,"「そですか。[l]\nならいいです」":355,"「あ――、\nそ、うですか。[l]\nはあ」":356,"何も無しか。":357,"それはそれで、\nいやその。[l]\n良いんだけど――":358,"「じゃ、じゃあ大体今日の報告はこのような感じで……」":359,"――まのところはね。":360,"「はい？[l]\n何すか？？」":361,"「んっ？[l]\nなに？[l]\nまた何か聞こえた？」":362,"「………いえ、なにも」":363,"「うひひっ。[l]\nさて、では明日も大変ですね。":364,"約束の時間、朝早いんでしたっけ？[l]\nそろそろ背中、泡流して終わりにしましょうか。":365,"まこくんは早く寝ないとですね。[l]\n宮はちょっと色々しなきゃで夜更かしですけどっ」":366,"「はいはい。[l]\nじゃ流しますよ……っと」":367,"シャワーで流せば良いんだろうけど、\n其処にあったし何となく桶に湯を溜めて、\n静かに泡を流す。":368,"「まこくん」":369,"「は、すいません熱かったですか？」":370,"「こんな日が、\nずっと続けばいいですね」":371,"「んあ゛っ。[l]\nなんの話ですよ」":372,"背中を向けたままなので表情は":373,"窺い知れないが、\n口調は―――\nいや、やっぱり真面目なのか巫山戯てるのか解らん。[l]\nでもまあ、後者だろうな。どうせ。":374,"「んむ？[l]\n希望的観測。[l]\nあ、そそ、例の紙片、ちょっと長めに預からして貰うかも。[l]\n最悪返さなくてもいいらしいですし……」":375,"「うーん、というか、\n明日の面子は潜入の件知らない面子ですから、\n仮に返そうったって問題がありますけど」":376,"「あ、そか。[l]\nメモしないと駄目ですのー。":377,"――さ、あとは宮、シャワーさっと浴びたら出ますね－。[l]\nその間こっち視ちゃだめですよ。":378,"そしたらあとは一人でごゆっくり。[l]\n……あ、一人になったからって」":379,"「なんもしませんよ！[l]\nじゃないその、怖くもないですから！！[l]\nご心配なく！！」":380,"無為に焦る僕を尻目に、\n宮さんはバスタオルを抑えつつ立ち上がった。[l]\n僕は座ったまま、思わず振り向く。":381,"「うひひ、\n感心感心。[l]\nあと半月とちょっと、頑張りましょう」":382,"「解ってますよ。[l]\n終わったら、場合によっては色々責任取って貰いますよ、\nあの時言いましたけど。まじで。まじで」":383,"「うひひひひひ☆\nその点はだいじょぶ♪\nどう転ぼうと、宮達は見捨てませんよ」":384,"「なんか微妙に引っ掛かりますけど、\nまあその」":385,"じゃーーーーーーーー。":386,"シャワーの流れる音で会話は途切れた。":387,"「それなら……[l]\nいいんですがね……」":388,"なるべく宮さんの方を視ないようにしながら、僕は湯船に浸かった。":389,"「まこくーん、\nそっち視たまま聞いてくださいねぇー」":390,"「はい？」":391,"「今こっち、なにも着てませんからぁー。[l]\nいいって言うまで絶対こっち視ないでくださいよぉー」":392,"「…うああーい、わかりましたぁー」":393,"――この後、\nよくある話のように、\n変なフェイントや悪戯もなく、":394,"普通に脱衣場に戻った宮さんから声を掛けられて":395,"漸く、\n僕は視線を戻す事が出来た。[l]\n首いてえって……":396,"「じゃーねまこくん、\n風邪引かないようにー」":397,"「あいさー、そちらもお気をつけてー」":398,"戸が閉まる。":399,"閑かになった。":400,"耳鳴りがするほど音がしない。":401,"田舎に旅行に行くと、まま体験出来るこの無音の世界。":402,"音は魔法なあ……":403,"「――さて、」":404,"宮さんの真意はどうあれ、\n今日も今日とて流されるがまま、\n僕の一日は終わろうとしている。":405,"そうして流されて明日も強制イベント発動決定な訳で、\n湯船に身を沈めながら、\n疲弊した身体が少しでも恢復するよう":406,"弛":407,"緩に":408,"努める。":409,"「僕のアタマじゃ、眼の前の事で手一杯だぁ……」":410,"そう。[l]\n\n未来のことなど想像もつかない。[l]\n\nこんな日がずっと続く――[l]\n\nそれっていいことなのか、[l]\n\n………。":411,"うーーーーーーーん、[l]\n\nどーうだろうなーあ。":412,"というか今思ったんですが……[l]\n図々しいかもしんないけど、\n最初からこの風呂場を使わせて貰えなかったんですかね？":413,"いや、\nお手入れとか面倒そうではあるし、\n……一人になると雰囲気も何かホラーぽいし、[l]\nいいかやっぱり。":414,"他にも何か、色々と聞き逃したというか、\n心に引っ掛かるものがある気がしてならない……[l]\nしかし、只でさえ空転脳の僕に、\n長風呂でちっとは飛んだとは言えアルコールがプラスされたんでは\nもう論理的な思考は困難だ。":415,"まあ、思い出せない程の事ならきっと大したことではないんだろう。[l]\nどうせ僕みたいな奴ぁ寝れば忘れてしまうだろうし……[l]\n今にして思えば、報告の前にああ言う飲み食いってどうなんだ。":416,"宮さんにしろ知狡さん……本家にしろ、[l]\n真面目なのか愉しんでるのか、優先順位が僕の基準とは違うのか、\n――兎に角僕は今此処に居るのだ。":417,"前に進むしかない。[l]\n未来のことなど想像がつかなくても、\nたとえ今は流され巻き込まれた":418,"路だとしても、\n僕は――[l]\n\n責任取っては貰えるようだしな。[l]\nどんな形でかは兎も角として、だ……":419,"そうさなあ、\n明日は早いけども一応寝る前に、大神と話してみるか……":420,"@r@r@r体感時間で五分ほど浸かって後、僕は湯船を出た。":421},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_024.ks","relPath":"/data/scenario/SC_M_024.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":422,"length":422,"percent":100},"cellInfo":[null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"t":"HU","v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"t":"HU","v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"t":"HU","v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[411,1],"note":"完成"},"/data/scenario/SC_M_025.ks":{"data":[["夢を視ていた。","做了个梦。"],["経験上、夢という自覚を得た瞬間に覚醒するものだが、[l]\n\n今は、[l]\n\nこれは現実じゃないという自覚を持ったまま、[l]\n\n眼前の光景を受け入れているという、[l]\n\nいつもの脳空転に負けず劣らずよくわからない状況に甘んじている。","按经验来说意识到是梦的瞬间就会醒，[l]\n\n但现在，[l]\n\n明明清楚知道这不是现实，[l]\n\n却坦然接受着眼前的光景，[l]\n\n甘愿处于这种与平日脑空转同样莫名其妙的状况中。"],["あれ？[l]\n\n今何月何日だ？[l]\n\n何年の？[l]\n\n………。[l]\n\n………。","咦？[l]\n\n现在几月几号来着？[l]\n\n哪一年？[l]\n\n………。[l]\n\n………。"],["学校にもいかず会社に出勤するでもなく、\nテレビを日がな一日鑑賞するでもなく、の\n生活してると曜日感覚とか日付の感覚が","既不上学也不上班，\n成天也不看电视的生活，\n会让星期几和日期的概念"],["覚","渐"],["束","渐"],["無く\nなってくるんだよな……[l]\n只でさえ記憶力の残念な僕では、\nそのうち今朝喰った飯も思い出せなくなるのは時間の問題だ……","模\n糊啊……[l]\n更何况记忆力本就糟糕的我，\n迟早连今早吃的什么菜都会想不起来……"],["夢の中で考えるにしては無駄に論理的な内容だ。[l]\n\n夢の中で自覚的に僕はこどもだったので余計に滑稽だが、[l]\n\n混沌を混沌としてそのまま享受している現状では、[l]\n\n――まあどうでもいいか。","作为梦中的思考未免太有逻辑了。[l]\n\n在梦里我清醒地意识到自己是个小孩，这就更显得滑稽了，[l]\n\n但既然现在甘愿享受混沌本身，[l]\n\n――嘛无所谓了。"],["微","浅层"],["睡みの中では枷が外れる分、\n自由で突飛な発想が出来ると何かの番組で――[l]\n\nツかれて身体の方の抑えが効かなくなると\nよく視えるようになるんだよ、[l]\n\nいーくんよ。[l]\n\nああ大神の台詞が。","睡眠中枷锁解开时，\n就能天马行空思考――某节目说过[l]\n\n身体束缚完全消失的话\n会看得更清楚哦，[l]\n\n饭君。[l]\n\n啊这是大神的台词。"],["@r我も","@r吾"],["軛さえ完全に外れれば●●の●●●、[l]\n\n●の●●●の身体が揃うならば、[l]\n\nん？[l]\n\nなんだっけ？","若能彻底挣脱枷锁●●的●●●，[l]\n\n●的●●●身体集齐的话，[l]\n\n嗯？[l]\n\n刚才说什么来着？"],["そう言っている夢の中の僕の眼の高さは低いし、\n視える自分の","说着这话的梦中我的视线高度很低，\n能看到的自己的"],["掌も小さく、[l]\n\n子供だ。[l]\n\n殆ど忘れていた小さい頃の僕だ。[l]\n\n海にいる。[l]\n\n砂浜。","手掌也很小，[l]\n\n是个孩子。[l]\n\n几乎忘却的小时候的我。[l]\n\n在海边。[l]\n\n沙滩。"],["一緒に遊ぶ女の子も小さいし、\n僕を●●ちゃんと呼んで――[l]\n\n思い込みや長じてからのメディア的な刷り込みなのか、[l]\n\n夢の中でまでセピアの色調で、[l]\n\nでもその女の子、●と●の●が●●●。","一起玩耍的女孩也很娇小，\n称呼我为●●酱――[l]\n\n不知是固有观念还是长大后媒体灌输的影响，[l]\n\n连在梦里都是泛黄的色调，[l]\n\n但那女孩，●和●的●是●●●。"],["それから逢う事はなかったから、\n今まで思いを馳せる事もなかった。[l]\nそもそも僕の記憶があまりに脆弱で――[l]\n\n二個下の。","之后便再未相逢，\n至今也不曾追忆过。[l]\n说到底我的记忆本就脆弱不堪――[l]\n\n小我两岁的。"],["しろのしろをつくろうか。[l]\n\n大きくなったらどんな？[l]\n\nうひひ。[l]\n\n返して貰うよ。[l]\n\nほんとうの――[l]\n\nきぃいいいいいいいいいいいいいん。","要补完纯白的纯白吗。[l]\n\n长大后会变成怎样？[l]\n\n嘻嘻。[l]\n\n会让你还回来的。[l]\n\n真正的――[l]\n\n嘶嘶—————————嘶嘶————————— 。"],["耳鳴りのようなどん詰まりのような感覚が、[l]\n\nいや、空転した脳が、\n無理矢理正常に回転しようとして、\nすっかり再生を受け付けなかった幼少期の記憶、\nそれの回想をなしているのか、[l]\n\nやはり所謂通常の夢であるように、\n脈絡無くわやくちゃに断片が想起されてるだけなのか、[l]\n\n………。","耳鸣般的堵塞感，[l]\n\n不，空转的大脑，\n强行想要正常运转，\n完全无法重构的童年记忆，\n是在进行回忆吗，[l]\n\n果然如同所谓普通的梦，\n只是毫无脉络地浮现零碎片段而已，[l]\n\n………。"],["なんか途中で宮さんが嗤ってなかったか。[l]\n\n我ながら毒されるにも程がある……[l]\n\n寝る前の大神との会話が","话说中途宫小姐是不是在偷笑啊。[l]\n\n连自己都觉得这毒性未免太强……[l]\n\n睡前和大神的对话"],["契","成了契"],["機になったのか、[l]\n\nあの式のあの何かが関係してるのか、[l]\n\n……風呂で何かあったようななかったような、","机吗，[l]\n\n还是那个仪式里的某些东西在作祟，[l]\n\n……浴室里好像发生过什么又好像没有，"],["いずれにせよ、\n基本的に浮かんできた記憶は未だ断片でしかなく、\n整合性があるかないか、その判断すらも\n混濁も思い込みや置き換えも恐らくあるのだろうし、[l]\n\nとりあえず、\n今この湧き上がってくる情景、\nいやにリアリティのあるこれ、は、","总之，\n基本浮现的记忆都还只是片段，\n是否存在连贯性，甚至连这个判断\n恐怕也混杂着臆测与篡改吧，[l]\n\n暂且，\n此刻涌现的这番情景，\n异常真实的这个，是，"],["お姉ちゃん？[l]\n\n現実か？[l]\n\nあのさ、わたし、[l]\n\nいきなり何の話だ。[l]\n\n男の子がさ。[l]\n\n……な、に？","姐姐？[l]\n\n现实吗？[l]\n\n那个啊，我，[l]\n\n突然说什么呢。[l]\n\n男孩子啦。[l]\n\n……什、么？"],["そのうち一回戻るけど、\n母様と親父殿にはその……[l]\n\nま、待て、本当なのか？[l]\n間違いないのか？[l]\n冗談ならば度が過ぎるぞ？","虽然迟早会回去一次，\n但母亲大人和父亲大人那边那什么……[l]\n\n等、等等，这是真的吗？[l]\n没弄错吗？[l]\n开玩笑也该有个限度啊？"],["喧嘩別れした訳じゃないけどさぁ……[l]\nお姉ちゃんの事もあるからほんとは、[l]\n\n私の事は気にするなと言ったろう。[l]\nそうか、お前が、イ――[l]\n\nみやちゃんにはもう言ったから、\n近くなったら、\n二人で行くよ。","虽然也不是吵架分开的啦……[l]\n因为姐姐的事其实本来，[l]\n\n我说过别在意我的吧。[l]\n这样啊，原来是你，伊――[l]\n\n已经和宫酱说过了，\n等时机近了，\n两个人一起去。"],["………。[l]\n\n………。[l]\n\n聞いたことがあるようなないような、[l]\n\n誰かの会話。","………。[l]\n\n………。[l]\n\n似曾相识又陌生的，[l]\n\n某个人的对话。"],["機械と水の振動が作り出す洗濯機の低い重低音のような\n思考停止気味の","机械与水振动产生的洗衣机般低沉重低音\n近乎停止思考的"],["温い","温暖"],["揺","摇"],["蕩うままに、\n注意を向けるでもなく耳に入ってくるそれを[l]\n\nそもそもこれは夢なのだし――","荡着的状态里，\n既未刻意关注也自然传入耳中的[l]\n\n反正这不过是场梦――"],["@r@r","@r@r"],["みやちゃん、\nなにたべる？[l]\nわたしはね、このカツサンドだなぁー。[l]\n車内で食べ物の匂いとか駄目派だっけ？","小宫，\n要吃什么？[l]\n我呢，就选这个炸猪排三明治啦～[l]\n你好像是反对在车里闻食物派？"],["@r@rんむー？[l]\n今更気にしませんよ。[l]\n宮は向こうに着くまで我慢します。[l]\n折角、久しぶりの玄ノ森ですからね。[l]\nこっちの水にはとっくの昔に慣れましたけど、\n旨いと思えるようになった訳ではないですし。[l]\n堪能すべくお腹は空かせておきます","@r@r嗯唔——？[l]\n现在才不在意呢。[l]\n宫会忍到抵达目的地为止。[l]\n毕竟难得回到久违的玄之森嘛。[l]\n虽然早就习惯这边的水质了，\n但也没到觉得好喝的地步。[l]\n是为了尽情享用美食所以得先让肚子饿着"],["@r@rあーそう……[l]\nでもだね、お姉ちゃんの料理は期待しない方がいいよ……[l]\nいや、着いたらすぐ言っておかなきゃ、わたしから。[l]\n手を出すなって","@r@r啊这样啊……[l]\n不过啊，姐姐做的菜还是别期待比较好……[l]\n不对，到了之后我得马上先说，由我来。[l]\n「别插手」之类的"],["@r@r？[l]\n\n@r@rいやいやいや、その、気にしないでっ。[l]\nじゃーわたしだけこれ食べるね。[l]\n真言の分も食べとかないと","@r@r？[l]\n\n@r@r不不不，那个，请别在意。[l]\n那～我就自己吃这个啦。[l]\n得把真言那份也吃掉才行"],["@r@r名前もう決めたですか。[l]\nまあ、流石に……仮でも違う名前じゃないと……[l]\nなるほど、まこと、\nまこくんね……[l]\nうひひ、どんな子ですかねー","@r@r连名字都决定好了吗。[l]\n嘛，果然……就算是临时的，也得给个不一样的名字才行……[l]\n原来如此，真言，\n小真呢……[l]\n嘿嘿，会是什么样的孩子呢～"],["@r@r@r","@r@r@r"],["ばしゅ","啪咻"],["@r@r例のお祭りの月に生まれるとなると\nちょっと慌ただしいねえ","@r@r如果出生在例大祭的月份\n会有点手忙脚乱呢"],["@r@r@rばしゅ","@r@r@r啪咻"],["@r@rお姉ちゃんはああだから、\n役目が無かったとしてもちゃんと……だろうけど、[l]\nまあ、わたし的には","@r@r因为姐姐是那样的人，\n就算没有职责也会好好……虽然是这样，[l]\n不过以我来说"],["@rうむ？[l]\n\n我の肉は","@r唔？[l]\n\n吾之血肉"],["何","在"],["処や[l]\n\n永き眠りであったか[l]\n\n既に覚醒めてはいたが[l]\n\nまだ機ではない[l]\n\n誰だ？","何处[l]\n\n乃长眠之所[l]\n\n虽已觉醒[l]\n\n时机未至[l]\n\n何人？"],["汝我の夢か？[l]\n\n嗚呼彼の時の契の果か[l]\n\n九相が揃うたか否軛が未だかせられている[l]\n\n我が肉なれば[l]\n\n我は","汝乃吾之梦否？[l]\n\n呜呼彼时契约之果报[l]\n\n九相齐聚与否尚不可知，然枷锁犹在[l]\n\n既是吾之血肉[l]\n\n吾"],["如","如"],["様にも[l]\n\n禁断のミたる紅玉が如き瞳の白の[l]\n\n青白き我のメが[l]\n\n","那般[l]\n\n禁断的真实，如红玉之瞳中白[l]\n\n苍白吾之目[l]\n\n"],["ＰＰＰ──。","ＰＰＰ──。"],["「――んが。[l]\nおうあ？」","「――嗯嘎。[l]\n噢啊？」"],["あれ、……目覚まし？","咦，……闹钟？"],["「スヌーズ解除……、と、[l]\nあ！」","「贪睡解除……，呃，[l]\n啊！」"],["ええとああそうだ、\n今日も早くから色々だった。","呃呃啊啊对了，\n今天也是从早就忙个不停。"],["にしてももの凄い変な夢視てた、ような気がするんだが、\n全然覚えてないんだよなあ。","不过总觉得做了个超级奇怪的梦，\n但完全想不起来内容啊。"],["夢ってそういうもんだけど。","虽然梦就是这样的东西。"],["どうも、[l]\n昔の、[l]\n子供の頃の感覚、だったような気もするけど、","总觉得[l]\n像是[l]\n回到了小时候的感觉，"],["夢は必ずしも忘れていた記憶とイコールという訳でもなし、[l]\n早いとこ準備しよう。","但梦未必等同于被遗忘的记忆，[l]\n还是早点准备吧。"],[null,null,null,null,null]],"context":[["SC_M_025.ks/index/1/text"],["SC_M_025.ks/index/3/text"],["SC_M_025.ks/index/5/text"],["SC_M_025.ks/index/7/text"],["SC_M_025.ks/index/9/text"],["SC_M_025.ks/index/11/text"],["SC_M_025.ks/index/13/text"],["SC_M_025.ks/index/15/text"],["SC_M_025.ks/index/17/text"],["SC_M_025.ks/index/19/text"],["SC_M_025.ks/index/21/text"],["SC_M_025.ks/index/23/text"],["SC_M_025.ks/index/25/text"],["SC_M_025.ks/index/27/text"],["SC_M_025.ks/index/29/text"],["SC_M_025.ks/index/31/text"],["SC_M_025.ks/index/33/text"],["SC_M_025.ks/index/35/text"],["SC_M_025.ks/index/37/text"],["SC_M_025.ks/index/39/text"],["SC_M_025.ks/index/41/text"],["SC_M_025.ks/index/43/text"],["SC_M_025.ks/index/45/text"],["SC_M_025.ks/index/47/text"],["SC_M_025.ks/index/49/text"],["SC_M_025.ks/index/51/text"],["SC_M_025.ks/index/53/text"],["SC_M_025.ks/index/55/text"],["SC_M_025.ks/index/57/text"],["SC_M_025.ks/index/59/text"],["SC_M_025.ks/index/61/text"],["SC_M_025.ks/index/64/text"],["SC_M_025.ks/index/66/text"],["SC_M_025.ks/index/68/text"],["SC_M_025.ks/index/70/text"],["SC_M_025.ks/index/72/text"],["SC_M_025.ks/index/74/text"],["SC_M_025.ks/index/77/text"],["SC_M_025.ks/index/79/text"],["SC_M_025.ks/index/81/text","SC_M_025.ks/index/85/text"],["SC_M_025.ks/index/83/text"],["SC_M_025.ks/index/87/text"],["SC_M_025.ks/index/89/text","SC_M_025.ks/index/97/text"],["SC_M_025.ks/index/91/text"],["SC_M_025.ks/index/93/text"],["SC_M_025.ks/index/95/text"],["SC_M_025.ks/index/99/text"],["SC_M_025.ks/index/102/text"],["SC_M_025.ks/index/104/text"],["SC_M_025.ks/index/106/text"],["SC_M_025.ks/index/108/text"],["SC_M_025.ks/index/110/text"],["SC_M_025.ks/index/112/text"],["SC_M_025.ks/index/114/text"],["SC_M_025.ks/index/116/text"],["SC_M_025.ks/index/118/text"]],"tags":[],"parameters":[[{"start":154,"end":161}],[{"start":169,"end":318}],[{"start":326,"end":400}],[{"start":408,"end":474}],[{"start":484,"end":485}],[{"start":495,"end":496}],[{"start":505,"end":580}],[{"start":588,"end":710}],[{"start":728,"end":729}],[{"start":738,"end":869}],[{"start":877,"end":883}],[{"start":894,"end":973}],[{"start":1009,"end":1042}],[{"start":1054,"end":1139}],[{"start":1147,"end":1275}],[{"start":1283,"end":1363}],[{"start":1395,"end":1518}],[{"start":1557,"end":1743}],[{"start":1753,"end":1825}],[{"start":1835,"end":1836}],[{"start":1846,"end":1918}],[{"start":1928,"end":2074}],[{"start":2108,"end":2212}],[{"start":2220,"end":2308}],[{"start":2318,"end":2460}],[{"start":2468,"end":2538}],[{"start":2552,"end":2589}],[{"start":2599,"end":2601}],[{"start":2610,"end":2611}],[{"start":2621,"end":2679}],[{"start":2685,"end":2689}],[{"start":2721,"end":2790}],[{"start":2798,"end":2956}],[{"start":2964,"end":3059}],[{"start":3065,"end":3154}],[{"start":3160,"end":3259}],[{"start":3265,"end":3273}],[{"start":3299,"end":3302}],[{"start":3308,"end":3348}],[{"start":3354,"end":3369},{"start":3446,"end":3461}],[{"start":3375,"end":3440}],[{"start":3494,"end":3518}],[{"start":3528,"end":3529},{"start":3745,"end":3746}],[{"start":3538,"end":3621}],[{"start":3631,"end":3726}],[{"start":3735,"end":3736}],[{"start":3756,"end":3814}],[{"start":3845,"end":3851}],[{"start":3942,"end":3961}],[{"start":3979,"end":3989}],[{"start":4021,"end":4044}],[{"start":4062,"end":4089}],[{"start":4097,"end":4141}],[{"start":4149,"end":4162}],[{"start":4170,"end":4214}],[{"start":4222,"end":4267}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_025.ks","basename":"SC_M_025.ks","indexIds":{"夢を視ていた。":0,"経験上、夢という自覚を得た瞬間に覚醒するものだが、[l]\n\n今は、[l]\n\nこれは現実じゃないという自覚を持ったまま、[l]\n\n眼前の光景を受け入れているという、[l]\n\nいつもの脳空転に負けず劣らずよくわからない状況に甘んじている。":1,"あれ？[l]\n\n今何月何日だ？[l]\n\n何年の？[l]\n\n………。[l]\n\n………。":2,"学校にもいかず会社に出勤するでもなく、\nテレビを日がな一日鑑賞するでもなく、の\n生活してると曜日感覚とか日付の感覚が":3,"覚":4,"束":5,"無く\nなってくるんだよな……[l]\n只でさえ記憶力の残念な僕では、\nそのうち今朝喰った飯も思い出せなくなるのは時間の問題だ……":6,"夢の中で考えるにしては無駄に論理的な内容だ。[l]\n\n夢の中で自覚的に僕はこどもだったので余計に滑稽だが、[l]\n\n混沌を混沌としてそのまま享受している現状では、[l]\n\n――まあどうでもいいか。":7,"微":8,"睡みの中では枷が外れる分、\n自由で突飛な発想が出来ると何かの番組で――[l]\n\nツかれて身体の方の抑えが効かなくなると\nよく視えるようになるんだよ、[l]\n\nいーくんよ。[l]\n\nああ大神の台詞が。":9,"@r我も":10,"軛さえ完全に外れれば●●の●●●、[l]\n\n●の●●●の身体が揃うならば、[l]\n\nん？[l]\n\nなんだっけ？":11,"そう言っている夢の中の僕の眼の高さは低いし、\n視える自分の":12,"掌も小さく、[l]\n\n子供だ。[l]\n\n殆ど忘れていた小さい頃の僕だ。[l]\n\n海にいる。[l]\n\n砂浜。":13,"一緒に遊ぶ女の子も小さいし、\n僕を●●ちゃんと呼んで――[l]\n\n思い込みや長じてからのメディア的な刷り込みなのか、[l]\n\n夢の中でまでセピアの色調で、[l]\n\nでもその女の子、●と●の●が●●●。":14,"それから逢う事はなかったから、\n今まで思いを馳せる事もなかった。[l]\nそもそも僕の記憶があまりに脆弱で――[l]\n\n二個下の。":15,"しろのしろをつくろうか。[l]\n\n大きくなったらどんな？[l]\n\nうひひ。[l]\n\n返して貰うよ。[l]\n\nほんとうの――[l]\n\nきぃいいいいいいいいいいいいいん。":16,"耳鳴りのようなどん詰まりのような感覚が、[l]\n\nいや、空転した脳が、\n無理矢理正常に回転しようとして、\nすっかり再生を受け付けなかった幼少期の記憶、\nそれの回想をなしているのか、[l]\n\nやはり所謂通常の夢であるように、\n脈絡無くわやくちゃに断片が想起されてるだけなのか、[l]\n\n………。":17,"なんか途中で宮さんが嗤ってなかったか。[l]\n\n我ながら毒されるにも程がある……[l]\n\n寝る前の大神との会話が":18,"契":19,"機になったのか、[l]\n\nあの式のあの何かが関係してるのか、[l]\n\n……風呂で何かあったようななかったような、":20,"いずれにせよ、\n基本的に浮かんできた記憶は未だ断片でしかなく、\n整合性があるかないか、その判断すらも\n混濁も思い込みや置き換えも恐らくあるのだろうし、[l]\n\nとりあえず、\n今この湧き上がってくる情景、\nいやにリアリティのあるこれ、は、":21,"お姉ちゃん？[l]\n\n現実か？[l]\n\nあのさ、わたし、[l]\n\nいきなり何の話だ。[l]\n\n男の子がさ。[l]\n\n……な、に？":22,"そのうち一回戻るけど、\n母様と親父殿にはその……[l]\n\nま、待て、本当なのか？[l]\n間違いないのか？[l]\n冗談ならば度が過ぎるぞ？":23,"喧嘩別れした訳じゃないけどさぁ……[l]\nお姉ちゃんの事もあるからほんとは、[l]\n\n私の事は気にするなと言ったろう。[l]\nそうか、お前が、イ――[l]\n\nみやちゃんにはもう言ったから、\n近くなったら、\n二人で行くよ。":24,"………。[l]\n\n………。[l]\n\n聞いたことがあるようなないような、[l]\n\n誰かの会話。":25,"機械と水の振動が作り出す洗濯機の低い重低音のような\n思考停止気味の":26,"温い":27,"揺":28,"蕩うままに、\n注意を向けるでもなく耳に入ってくるそれを[l]\n\nそもそもこれは夢なのだし――":29,"@r@r":30,"みやちゃん、\nなにたべる？[l]\nわたしはね、このカツサンドだなぁー。[l]\n車内で食べ物の匂いとか駄目派だっけ？":31,"@r@rんむー？[l]\n今更気にしませんよ。[l]\n宮は向こうに着くまで我慢します。[l]\n折角、久しぶりの玄ノ森ですからね。[l]\nこっちの水にはとっくの昔に慣れましたけど、\n旨いと思えるようになった訳ではないですし。[l]\n堪能すべくお腹は空かせておきます":32,"@r@rあーそう……[l]\nでもだね、お姉ちゃんの料理は期待しない方がいいよ……[l]\nいや、着いたらすぐ言っておかなきゃ、わたしから。[l]\n手を出すなって":33,"@r@r？[l]\n\n@r@rいやいやいや、その、気にしないでっ。[l]\nじゃーわたしだけこれ食べるね。[l]\n真言の分も食べとかないと":34,"@r@r名前もう決めたですか。[l]\nまあ、流石に……仮でも違う名前じゃないと……[l]\nなるほど、まこと、\nまこくんね……[l]\nうひひ、どんな子ですかねー":35,"@r@r@r":36,"ばしゅ":37,"@r@r例のお祭りの月に生まれるとなると\nちょっと慌ただしいねえ":38,"@r@r@rばしゅ":39,"@r@rお姉ちゃんはああだから、\n役目が無かったとしてもちゃんと……だろうけど、[l]\nまあ、わたし的には":40,"@rうむ？[l]\n\n我の肉は":41,"何":42,"処や[l]\n\n永き眠りであったか[l]\n\n既に覚醒めてはいたが[l]\n\nまだ機ではない[l]\n\n誰だ？":43,"汝我の夢か？[l]\n\n嗚呼彼の時の契の果か[l]\n\n九相が揃うたか否軛が未だかせられている[l]\n\n我が肉なれば[l]\n\n我は":44,"如":45,"様にも[l]\n\n禁断のミたる紅玉が如き瞳の白の[l]\n\n青白き我のメが[l]\n\n":46,"ＰＰＰ──。":47,"「――んが。[l]\nおうあ？」":48,"あれ、……目覚まし？":49,"「スヌーズ解除……、と、[l]\nあ！」":50,"ええとああそうだ、\n今日も早くから色々だった。":51,"にしてももの凄い変な夢視てた、ような気がするんだが、\n全然覚えてないんだよなあ。":52,"夢ってそういうもんだけど。":53,"どうも、[l]\n昔の、[l]\n子供の頃の感覚、だったような気もするけど、":54,"夢は必ずしも忘れていた記憶とイコールという訳でもなし、[l]\n早いとこ準備しよう。":55},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_025.ks","relPath":"/data/scenario/SC_M_025.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":true,"progress":{"translated":56,"length":56,"percent":100},"cellInfo":[[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"t":"HU","v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[13,1],"note":"完成"},"/data/scenario/SC_M_026.ks":{"data":[["クリーニングを頼んだ経験なんか殆どないから、\n知狡さんが無理してくれたのか、\nそもそもそう言うものなのか判断は出来ないが、","我几乎没什么送洗衣服的经验，\n不知是知狡阿姨硬撑着帮忙，\n还是本来就这样也说不准，"],["狩屋達に逢いに出掛ける前に、\n借り物の制服は返せる状態になっていた。","不过在去见狩屋他们之前，\n借来的制服已经能归还了。"],["知狡さんはお返しものとか持たせようとしてくれたけど、\n……まあ、それは何か違うと思ったので\n適当に誤魔化して準備をする。","知狡阿姨虽然想让我带些回礼，\n……但总觉得不太对劲\n就随便糊弄着准备了。"],["しかし知狡さん、顔色はあまり良くないようだったなあ。[l]\nやっぱり無理したのかなあ……[l]\nこないだからずっと調子悪そうだし、\nなんとか都合つけてゆっくり休んで貰いたいものだ。","不过知狡阿姨脸色看起来不太好呢。[l]\n果然是勉强自己了吧……[l]\n最近一直状态不佳的样子，\n真想设法让她好好休息。"],["「さて、一応作業しやすい服にしとくか……[l]\n荷物かさばらしてまで持ってきた甲斐もあるというもの」","「好了 先换上方便干活的衣服吧……[l]\n特意带这么多行李来也算值了」"],["元より仰々しい仕事させられると思ってたから、\nそれなりの準備をして来たのに、\n女装だのなんだのをすることはあっても\n大体、祭の日程は予定通りに行われたとしても月末な訳で――","本来就觉得会被安排夸张的工作，\n所以做了相应准备，\n虽说可能要女装什么的\n但祭典日程就算按计划也要到月底才――"],["「……いかん、冷静に現状を認識しすぎると絶望してしまう」","「……不行 太清醒认识现状会绝望的」"],["多少は柳に風と受け流すと言うか、\n知らぬが仏の境地と言うか、\nうーん今一現状を的確に表現出来る言い回しが浮かばないが、\n鷹揚な度量で臨まないと遣り切れない。","该说是随波逐流呢，\n还是不知为福呢，\n嗯—现在想不出准确形容现状的说法，\n总之必须豁达面对。"],["どんだけ煩悶しようとも、\n今となっては乗りかかった船、賽は投げれらた、覆水盆に返らず、\n毒を食らわば皿まで、","不管多么烦恼，\n现在已是骑虎难下 木已成舟 覆水难收，\n一不做二不休，"],["えー、\n…まあ、なんだ。[l]\n要するに後に引くには遅すぎるという事だ。","呃—\n…嘛 怎么说。[l]\n总之就是为时已晚。"],["バックは一族全体だし、\n今更復学も……ないなあ……[l]\n宮さんの言を信じて今後の人生にも期待しましょう。","背后还牵扯整个家族，\n现在想复学也……没戏了……[l]\n还是相信宫小姐的话期待今后人生吧。"],["夕べ狩屋から来たメールによると、\n９：００集合で昼までの作業、\n昼食は姫様ちゃん家にて向こう持ちで喰わしてくれる、\nという事だった。","昨晚狩屋发邮件说，\n9点集合工作到中午，\n午饭由姫様家招待，\n这么安排的。"],["旅行は好きだけど、\n知人の家で食事するのは慣れてないから何かこう、\n緊張する……というか、","虽然喜欢旅行，\n但在熟人家吃饭还是不太习惯，\n有点紧张……或者说，"],["望む望まぬは別として本当はそんな","不管愿不愿意 实际"],["長","上"],["閑な状況じゃ\nないのだよな。[l]\n後ろめたさだけが","根本不是什么\n悠闲状况啊。[l]\n只有愧疚感"],["募る。[l]\n後ろめたいと言えば。","不断膨胀。[l]\n说到愧疚。"],["「朝飯朝飯……[l]\nうーん、コンビニじゃないおにぎりなんて久々だなー」","「早饭早饭……[l]\n唔—好久没吃便利店之外的饭团了—」"],["こんな急なスケジュールにも関わらず、\n知狡さんは前もって知ってたかのように\n制服の準備のみならず、更にこの朝食まで\n（無論、人に頼んでではあるが）用意してくれていたのだった。","尽管行程这么突然，\n知狡阿姨却像早有预料般\n不仅准备了制服 连这份早餐\n（当然 是托人准备的）也都备好了。"],["世の母親であればそういう物かも知れないが、\n知狡さんは未だ独身だし、\nうちの母さんは何とも適当だったから、\n余計に先読みされた感が強く思えるのかも。","世间母亲或许都这样，\n但知狡阿姨还是单身，\n加上我妈特别随性，\n所以更觉得她预判得太准了吧。"],["そういう気遣いが知狡さんの負担になってるような気がして、\nこっちもプレッシャー、後ろめたさに","这种体贴让我觉得成了知狡阿姨的负担，\n我也因此感到压力与愧疚"],["苛まれるなんだけど……","备受煎熬……"],["その点母さんは、\n放任じゃなかったにせよ地味に豪快と言うべきか、\n少なくとも知狡さんとは全く微塵も似ていない。","至于我老妈，\n虽非放任但该说是低调豪爽吧，\n至少和知狡阿姨没有半点相似之处。"],["まあ御陰で、深刻な性格というよりは\n幸か不幸か、そういうのに反発して真逆の性格になったりは\nしなかったんだよなあ。","不过托她的福，比起形成什么阴郁的性格\n该说幸运还是不幸，我倒也没有因为反感这些，\n就变得性格截然相反。"],["吉と出るか凶と出るか\n流石に後ろめたい感すら持たないような人間にはならないようにしたいものであることよ。","是福是祸\n至少希望别成为连愧疚感都没有的人啊。"],["車は旅館のハイヤーは勿論、\n軽自動車も荷物の運搬には不向きだったので、\n狩屋の家からバンを借りる事になっている。","旅馆的包车自不必说，\n轻型车也不适合搬运行李，\n所以决定从狩屋家借辆面包车。"],["日に数回のバスを利用して近場のバス停に移動、奴の家の近くにて待ち合わせだ。","坐每天几班的巴士到附近车站，在那家伙家附近集合。"],["中央の方じゃバスは道路状況の所為か何か知らないけど、\n滅多矢鱈とダイヤが不安定だったものだが、\nこっちはどうなんだろ。[l]\n逆に地域の重要な足として、規則正しく運行してるんだろか。","中央地区的巴士不知是因为路况还是什么，\n班次总是乱七八糟不稳定，\n这边不知怎样。[l]\n反倒可能作为地区重要交通工具规律运行吧。"],["「……ああ、失礼眠いので」","「……啊抱歉我太困了」"],["皿を戻したりする為、\n部屋に戻らずロビーの長椅子でおにぎりに","为归还餐盘\n没回房而在大堂长椅啃饭团时，"],["囓りついてると、\n目の前を目の下の隈を一層濃くしたチノ嬢が通りかかった。[l]\n彼女は目を合わせた途端に挨拶もせずそう言った。","黑眼圈更重的千乃小姐\n从面前经过。[l]\n她刚对上视线就突然开口："],["「宮店長は夜行性でしてねどちらかというと。[l]\ntensionが高まるのが夜、というべきですか。[l]\n世に言われてますでしょう、よるはみかた、敵は何とやら。","「宫店长是夜行性该说[l]\n夜晚才会high起来吗。[l]\n常言道夜晚是盟友敌人啥的。"],["ん？[l]\n無いか。[l]\nまあどちらでもいいんですがね、","咦？[l]\n没听过？[l]\n嘛怎样都好，"],["今日はワタシも少々脳がidlingを必要、\nと言いますか、\n対応が奇矯になるかも知れませんで、\nどうかお含み置き下されば幸いですが」","今天我脑子也需要idling\n或者说\n可能会言行怪异\n还请多包涵」"],["奇矯……[l]\nそれはいつもの事の様な気がしますが……","怪异……[l]\n感觉是常态了……"],["「禅が店長の言い付けた録画番組を盤に焼いて送ってくるのですが、\nまめに消化しないといけませんでね。[l]\n宮店長は可能な限り多忙なる合間を縫ってそれを為す訳ですが、\nやはり限界というものがあるので。","「禅把店长指定的录播节目刻盘寄来，\n必须勤快消化。[l]\n宫店长会尽量抽空处理，\n但毕竟能力有限。"],["溜まった分をいちどきに消化せねばならない場合があるのです。[l]\n丁度昨夜はワタシもご","有时不得不一次性清囤货。[l]\n昨晚我也"],["相","陪"],["伴に預かりまして」","伴着通宵」"],["お茶を飲んで、","喝了口茶"],["漸く会話可能になった僕は、","终于能对话的我"],["「はあ……[l]\n僕は多少旅行慣れしてるんで、\n地方による番組視聴の可不可とかはもう……[l]\nだだ流しで本ばっかり読んでますし」","「哈……[l]\n我旅行惯了\n地方台能否收看早就……[l]\n都是开着当背景音看书」"],["と返答した。[l]\nもう会話の入りが怪訝しかった事自体は、\nいつもの事とスルーする。","回答道。[l]\n对话开头莫名奇妙\n也习惯性无视了。"],["「宮店長は珍しく今日は寝坊です。[l]\n平時なら多少の夜更かしも平気なのですがね。[l]\nどうにも色々と……お疲れのようで……","「宫店长难得睡过头。[l]\n平时熬夜也没事的。[l]\n似乎各种……操劳过度……"],["ごほっ……ゴホッ。[l]\n失礼。[l]\n貴方への挨拶を代弁せよとのお申し付けを昨夜の内に」","咳……咳咳。[l]\n失礼。[l]\n昨夜奉命代她向您问好」"],["「はあ、\nいやその僭越ながら申し上げますればですね、\nそれは社交辞令というか言葉の綾か何かだったんじゃ……」","「哈，\n恕我僭越直言\n那应该是客套话或修辞吧……」"],["大体にしてその、\n貴女自身も大変にお疲れのように見受けられますが……","说到底\n您本人看起来也相当疲惫……」"],["「いえ、ご心配なさらず。","「不，请不必担心。"],["書き置きをお渡しするでも良かったのでしょうが、\n昨夜、正確には本日早朝ですが、\nその時の宮店長の心持ちとしては\nその手段を是とはなさらなかったようでしてね」","其实留张字条给您也未尝不可，\n但昨夜——准确说是今晨早些时候——\n宫店长当时的心境\n似乎并不认可这种处理方式呢」"],["「うーん……[l]\nそれはご愁傷様で……[l]\nあのひともなんだかなあ」","「唔……[l]\n那可真是令人同情……[l]\n那个人也真是的」"],["「言語野を刺激するに、\n脳内のみで――例えば読書や耳からのみの言語情報だけよりは\n実際に発声して会話するのがより良き方法ではある、\n話し手にも聴き手にも、という事ですがね。","「从刺激语言中枢的角度，\n比起仅靠脑内活动——例如阅读或单纯接收听觉语言信息——\n实际发声对话对双方而言，\n都是更优的方式呢。"],["音は魔法という与太話は既にお聞きになってますね？[l]\nああ、申し訳ない、\nやはりどうも睡眠不足のようで、","您已听闻过'声音即魔法'这类无稽之谈了吧？[l]\n啊，失礼了，\n果然还是睡眠不足的缘故，"],["話題が取り留めのない方向に暴走していますこれはどうも\n宜しくないななにかいいものを","话题不知不觉就偏离到不着边际的方向\n这可不太妙得找点"],["喰したいところ\n或いは木天蓼木天蓼などを持ちまして」","能提神的东西\n比如木天蓼之类的」"],["「や、いつも通りだと思います……[l]\nあいえ、\nと、兎に角お気になさらず、ご無理もなさらずで……","「呀，我觉得和平时没两样……[l]\n啊不，\n总、总之请别在意，也别太勉强自己……"],["まあメールよりは電話とかで直に会話する方が多少は\n伝わりが良いですしね！[l]\n僕はアナクロ趣味ですし解りますけど、\nまああれですね、宮さん本人が寝てるんでは……」","不过比起邮件，直接打电话交谈确实\n更能传达心意呢！[l]\n虽然我这人守旧能理解，\n但宫小姐本人还在睡的话……」"],["あのひとに振り回されるのはこの","被那个人牵着鼻子走，"],["女","这位女"],["性も一緒だったか。","性当时也和我一样吧。"],["「手段の選択肢がある現在に於いてはケースバイケースが\n良いでしょうけどね。[l]\n特に貴方位の年代の異性同士ではデリケェトな問題と\nなる事","「在拥有多种沟通手段的当下，\n因事制宜或许更好。[l]\n特别是您这个年代的异性之间，\n常会演变成"],["屡","相当"],["屡と聞き及びますが」","敏感的问题呢」"],["「うーん……[l]\n年代も、時代もですかなあ。","「嗯……[l]\n是年代差异，还是时代差异呢。"],["個人差あるでしょうし――って、\nすみませんそんな話より、\nお疲れでしたらほんとに休んだほうが」","个体差异也存在――啊，\n抱歉比起这个，\n您要是累了真的该休息」"],["しかしそこでチノ嬢はゆらぁりと体勢を立て直して、\n眼を","但千乃小姐此时晃悠悠地直起身，\n眨了眨"],["瞬かせて続けた。","眼睛继续道。"],["「では店長の挨拶を代わって述べさせて頂きます。","「那么请允许我代为传达店长的问候。"],["『まこくん、今日もごめんねっ。[l]\n宮はもう少しすることあるから、\n一人ででも頑張ってくださいっ！","『小真，今天也对不起啦。[l]\n宫还有事情要处理，\n就算一个人也要加油哦！"],["愛してるなら出来るね？[l]\n何をって、言わなくても判ってる癖に☆\nうひひ♪\nじゃ、よろしくです～。いてら～。』","爱我的话就能做到吧？[l]\n做什么？明明不说也懂的嘛☆\n嘿嘿♪\n那就拜托啦～走咯～。』"],["以上です」","以上」"],["………。","………。"],["「――あの……[l]\n声帯模写がその、","「――那个……[l]\n声带模仿"],["吃","令人震"],["驚するほど\n御上手ですね……」","惊的精准呢\n您也太擅长了吧……」"],["マスクしてるし、\n音声レコーダーか何か再生したんじゃないかという疑念も\nあったが、\nいやいや、この人が発声してたよ…まじで……","虽然戴着口罩，\n甚至让人怀疑是不是播放了录音设备，\n不过，\n不不，确实是本人在发声…真的…"],["「ま、まあ兎に角僕はやることやってきますので、\n宮さん起きたら――あとチノさんの都合良ければ、\n宜しくお伝えください。[l]\n……まあ、チノさんもちゃんと休んだ方がいいですよ」","「总、总之我会做好分内事，\n等宫小姐醒了――另外千乃小姐方便的话，\n请代为转达。[l]\n……话说千乃小姐也该好好休息才是」"],["「解っています、\n『僕も愛してる』と伝えておきましょう。[l]\n真心を店長に。貴方のね」","「我知道的，\n『我也爱你』会帮你传达的。[l]\n把真心献给店长。你的那份」"],["「……何の話ですか。[l]\nそれじゃあついでに花束をお願いしますよ。[l]\nでは改めまして、\n今日もお勤め行って参りますっ」","「……在说什么呢。[l]\n那顺便麻烦你准备花束吧。[l]\n那么重新说一次，\n今天也要去认真工作啦」"],["「察するまでもなく通じて頂けるのは","「不需要揣测就能心意相通"],["好き素質です。[l]\n時間取らせて申し訳ありませんでした。[l]\n夢見も宜しいようで何より。","是种令人喜欢的特质。[l]\n占用您时间实在抱歉。[l]\n看来做梦也是好事呢。"],["ん？悪かったのかな？[l]\n申し訳ないがどちらでもいいんですがね。","嗯？难道我说错话了？[l]\n虽然抱歉但其实怎样都无所谓啦。"],["では、宮店長の祝福あれ。[l]\nGood Luck。[l]\nミ・キャミャルキャラモロコネコナメタサキャラ\nタサコネタサメミャラメンカヤコネキャ・ワ」","那么，愿宫店长保佑你。[l]\nGood Luck。[l]\nmi・kya mya ru kya ra mo ro ko ne ko na me ta sa kya ra\nta sa ko ne ta sa me mya ra me n ka ya ko ne kya・wa」"],["あいあい。[l]\nみゃんみゃんなんたら。","哎哎。[l]\n喵喵什么的。"],["改めて部屋に戻り、準備をして外に出る。","重新回到房间，做好准备后出门。"],["道路は","道路上"],["其","这"],["処","里"],["彼","那"],["処、木の枝やら葉っぱだのが散乱し、\n嵐の爪痕が未だ残る痛々しい状況であった。","都散落着树枝和树叶，\n风暴的伤痕仍残留着，呈现触目惊心的景象。"],["天気の方は正に台風一過、只でさえ綺麗な田舎の大気を、\n必要以上に洗い流したらしく今日はおっそろしく見通しの良い\n晴天である。[l]\n昨夕の日暮れも良いが、こういう抜ける青空も勿論心に染み入るね。","天气方面正是台风过境后，仿佛把本就干净的乡下空气\n过度洗涤般，今天是能见度好得吓人的\n晴天。[l]\n昨天傍晚的夕阳虽美，但这样通透的蓝天当然也沁人心脾呢。"],["夕べのあれやこれやで湯冷め湯中りするかと思ったが、\n滋養に特化した夕飯が結果功を奏したのか、\nはたまた日頃の行いが良いのか、\n今日は至って元気な僕であった。","本以为昨晚那些事会导致泡澡着凉，\n但特制滋补晚餐似乎起了效果，\n又或是平日积德行善之故，\n今天的我格外精神。"],["大神との身のない話でも、多少は足しになったものか。[l]\n――今朝の知狡さんやチノ嬢を視てると、\nしっかりせねばという思いにもなるしなあ。","和大神那些没营养的对话，多少也算有点帮助吧。[l]\n――看到今早的知狡阿姨和千乃小姐后，\n更觉得必须振作起来才行啊。"],["問題は相変わらず進行形というか、\n不明の事項に関しては不明としておくしか無い以上、\n自分以外が絡む事象に関してはやれることにも限界がある訳だが、\nともあれ全力を尽くすのみか。","问题依然处于进行时态，\n既然不明事项只能保持不明，\n涉及他人的事态终究能力有限，\n总之唯有全力以赴了吧。"],["とは言え、現状目的と手段がどうもこう、\n流されるままというか、\nそれでも何故か収穫があるというか、\nゲームをしてる感というか、","话虽如此，现状的目标和手段总觉得\n像随波逐流般，\n却又莫名有所收获，\n像在玩游戏的感觉，"],["大神あたりが何か","总觉得大神他们好像有自己的"],["一","一"],["家","套"],["言ありそうな感じの、\nフラグの為のフラグがどうとか……","说法，\n为了立flag而立的flag怎样怎样……"],["穴のある不出来な脚本……[l]\nシナリオ……[l]\nしろのしろ……","漏洞百出的拙劣剧本……[l]\n剧情……[l]\n白中之白……"],["「おあ！」","「哎呀！」"],["水たまり踏んだ！","踩到水坑了！"],["靴ごと足が水没することをこの辺では確か\nかっぽぐった、と言うらしいが誰から情報だったかな……[l]\nきぃだったかしらん。","在这边连鞋带脚浸透的情况好像叫\n『卡泼咕』来着…是谁告诉我的呢……[l]\n是小贵吧。"],["取り敢えず、水たまりは思った程深くなく、\nそこまでの惨劇には至らずに済んだ。[l]\nただ少々泥っ気の強い箇所だった故激しく滑り、\n大変に驚いた次第。","所幸水坑没想象中深，\n没酿成更惨烈的悲剧。[l]\n只是泥浆特别滑溜，\n吓得我不轻。"],["まあそれよりも、","不过比起那个，"],["「姫様ちゃんに……狩屋なあ……」","「姫様酱……狩屋啊……」"],["調査対象を効果的に調査するならば、\n確かに敵対状態にあるよりは親密度上げた方が\nはるかに効率的ではある。[l]\nあるのだが、","要有效调查目标对象的话，\n确实比起敌对状态，提升亲密度\n会高效得多。[l]\n话是这么说……"],["最終的に信頼を裏切ることが前提というか、\nたとえ隠し","说到底本就是以最终背叛信任为前提的，\n即便能隐瞒"],["果せたとしても、\n罪悪感に苛まれることになるのだろう。","成功，\n也终究会被罪恶感折磨吧。"],["今回の一連のそもそも、\n三春の御神体の確認、\n『月狂跳』なのかどうか――","这次事件的起因，\n三春御神体的确认，\n是否属于『月狂跳』――"],["『家の秘密』はそうそう","『家族秘密』可不是这么"],["容","轻"],["易く","易"],["詳らかには出来ない。[l]\n懐柔するという案は理に適っているが、","就能和盘托出的。[l]\n怀柔政策虽合乎逻辑，"],["先日から憶えている背徳感は拭えない。","但连日来的背德感始终挥之不去。"],["感情移入は公平な立場を崩し、\n正確な判断を鈍らせるぞ。","共情会破坏中立立场，\n让精准判断变得迟钝。"],["ん？[l]\n誰かから聞いた言葉だったかな。","嗯？[l]\n这话像是听谁说过。"],["――大体、飯窪本家の趣味好奇心を満たす為と言う割には、\nあまりに迂遠で大仰な事になってるのは何故だ。","――说是为了满足饭洼本家的猎奇心，\n可为何搞得如此迂回夸张？"],["殆どノリに近い形であるにも関わらず、\n僕という一個人の人生にとっては大きな岐路を\n客観的且つ相対的に視てくだらない事を真剣に愉しむのはまるで\nゲェムだ。","明明近乎儿戏的事，\n对我个人人生而言却是重大分歧\n认真享受这种客观上相对无聊的事，简直像场\n游戏。"],["ゲェムの駒と言うか劇の役者と言うか、[l]\n不出来な脚本、","说是游戏棋子还是戏剧演员呢，[l]\n拙劣的剧本，"],["裏でもっと何か得体の知れない事が蠢いているんではないか、\nという夢想をしたとて罰は当たるまい。","背地里该不会有什么更不可名状的东西在蠕动吧，\n就算做这种妄想也不会遭报应。"],["実際、おかしな能力が発現しているし、\n流されてるなりの事態の進展はあるのだけれど、\nただ、\nどういう結末が――","实际上已有异常能力显现，\n随波逐流中事态也确实在推进，\n只是，\n会迎来怎样的结局――"],["不出来な脚本？","拙劣的剧本？"],["唐突に、[l]\nDeus ex machinaという言葉があるのを思い出す。","突然想起[l]\n有个词叫Deus ex machina。"],["確か劇に於いて、","记得在戏剧里，"],["「あ、\nあれか」","「啊，\n那个啊」"],["――と、錆びたバス停の看板が視えた。[l]\n時刻表はスカスカで、判ってることだが一本逃すと次までがきつい。[l]\nほぼジャストに着いてしまったから少々心配だなあ……","――锈蚀的公交站牌映入眼帘。[l]\n时刻表稀稀拉拉，错过一班就要苦等很久。[l]\n因为到得太准时反而有点担心……"],["ふぁおん。","叭呜。"],["バスのクラクションにしては軽めの音が鳴った。","响起比普通汽车喇叭更轻快的鸣笛声。"],["振り向くと、其処にはバスではなく、","回头发现那里停着的不是公交，"],["「お早う少年。又逢ったね」","「早啊少年。又见面了」"],["「え、ええと、確かその」","「呃、那个，您好像是」"],["助手席の窓を開けてこちらに向かって手を挙げている、","副驾驶摇下车窗向我挥手，"],["「","「是"],["奇","奇"],["士","士"],["道","道"],["具だよ少年。[l]\n乗っていかないか」","具哦少年。[l]\n要搭便车吗」"],["銀髪に","银发配"],["咥え煙草……かどうかは先日の事があるので解らないが、[l]\nどちらかというと男性的な立ち振る舞いをするあの、\n特異な女性――西國の三春関係者の一人の、\nキサムラドウトモ……さんが車を横付けしていたのだった。","叼烟……鉴于前车之鉴不确定是否真烟，[l]\n举手投足更偏男性化的那位\n特异女性――西国三春相关者之一，\n奇士道具……小姐正将车靠边。"],["大きめのワゴン車……というかバンっていうのか、[l]\n誤解を恐れずに言うならやはりちと男性的な車種に乗っていて、\n電気工事の車の様に少々汚れや凹みが目立つ車だった。","大型旅行车……或者说厢式货车，[l]\n直白来讲确实偏男性向的车款，\n像电工车般带着明显污渍和凹痕。"],["普通の國産車で右ハンドル故、\n左の歩道を歩いていた僕に話しかけるのは\n少々面倒そうだ。","因为是普通的国产车，又是右舵，\n对走在左侧人行道的我搭话\n显得有点费劲。"],["……あれ、[l]\nつい今まで何か別の事を思考していなかったか僕は。[l]\nまあいいか。[l]\n重要事ならば思い出すだろう。","……咦，[l]\n我刚才是不是在思考别的事情？[l]\n算了。[l]\n重要的事总会想起来。"],["「少年と言いますかもう二十歳とちょいですが……[l]\nええと僕ぁ用事がありまして、\n今丁度バスをですね……」","「说是少年嘛其实已经二十出头了……[l]\n那个我有点事要办，\n现在正好在等巴士……」"],["「ああ、事情は諒解してるよ。[l]\nちょっと手隙になったので僕も手伝おうと思ってね。[l]\nああ、これは僕の持ち車だから気にすることはない」","「啊，情况我理解的。[l]\n刚好有空就想着来帮把手。[l]\n啊对了这是我私人用车不必在意」"],["「え？[l]\nいやその、はい？」","「咦？[l]\n不是那个，啊？」"],["カミサマ、\n今日も初っ端から巻き込んで来ますかい？[l]\n流されろと仰いますかい？","神明大人，\n今天也一上来就要把我卷进去吗？[l]\n是要我随波逐流的意思吗？"],["そんなこちらの煩悶なぞ当然何処吹く風、\n道具さんは薄ら笑いのまま続ける。","我这边的烦恼自然如耳边风，\n道具小姐维持着浅笑继续说道。"],["「こっちに来た時用に預かって貰ってるんだが、\n手入れはしてくれてないのでこんな有様だ。","「当初为来这边准备的代管车，\n但没人保养就成这副德行了。"],["ま、逆に気が楽だろう？[l]\nぶつけようがどうしようが構わないよ、\n用さえ足せればね。[l]\nよいしょ」","嘛，反而轻松对吧？[l]\n撞了刮了都无所谓，\n能派上用场就行。[l]\n嘿咻」"],["ロック機構が古いのか、手動で助手席のロックを外す\n道具さん。","或许是锁具老旧，手动解开了副驾驶锁的\n道具小姐。"],["「で、僕自身そうそう車は運転しない生活なものだから、\n少年、君に運転は任せようと思うがどうだろう。","「况且我平时也不怎么开车，\n少年——想拜托你驾驶，你觉得呢？"],["元々そういう話だったようだし、\nでないとわざわざ出てきて貰った意義も\n薄まってしまうだろうからね。[l]\nそれともそういう考え方は好みではないかな」","本来也是这个安排，\n不然特意请你过来的意义\n也会打折扣吧。[l]\n或者说你不喜欢这种考量方式？」"],["「あいえ、大丈夫です。[l]\nじゃあ、お邪魔します……」","「不、没问题的。[l]\n那就打扰了……」"],["大丈夫だけど、会って二回目の人に言われるという事に\n関しては微妙なラインだが……[l]\n何を今更ではあるけれど。","虽然没问题，但被只见第二面的人这么说\n确实有点微妙……[l]\n虽然现在说这个有点晚。"],["運転席側に廻ろうとすると、\n運転交代は狩屋達と合流してからと言われた。[l]\n助手席に乗り込む。","正要绕向驾驶座时，\n被告知换手驾驶要等与狩屋他们汇合后。[l]\n坐进了副驾驶。"],["「結構。[l]\nにしても、\n若人が謙遜すると年長者に対して嫌味にしかならぬよ。","「不错。[l]\n不过话说回来，\n年轻人过度谦逊对年长者反而像讽刺呢。"],["この國に於いて若くして元服するは遠き昔、\n今や幾つになっても幼児が如き若輩凡俗、\n肉の成熟速度と脳味噌の研磨環境が往事とは違うにしても、\nこれでは誰の為にもならないのだがなあ。","这国家古时虽盛行少年元服之礼，\n如今却尽是长不大的庸碌之辈，\n纵使肉体成熟速度与脑髓锤炼的环境今非昔比，\n这般模样终究成不了气候啊。"],["イヤイヤ、キミがそういう存在だとは言わないがね？[l]\nまあそうだな、年長からすれば君辺りとは、\n少年と呼んで差し支えない程の歴然たる差がある、という事だ。[l]\n気にすることはないよ」","哎哎，倒不是说你也如此？[l]\n不过确实，从年长者角度看，\n称你为少年亦无妨的显著差距是存在的。[l]\n不必放在心上」"],["「確かに昨今、二十歳くらいじゃお子様かも知れませんけど、\n呼ばれる身としてはやっぱり違和感ありますよ……[l]\nそ、それにしてもやっぱり全然","「确实近来二十岁可能还算小孩子，\n但被这么称呼果然还是别扭……[l]\n话、话说回来您真的完全"],["訛り無いですねえ、\n――西國の方なんですよね？」","没有口音呢，\n――是西国人士吧？」"],["何だって僕は彼女等と世間話をしてるのだろう。[l]\nや、今や宮さん側からもそういう繋がりを強化する事を求められてはいるのだが……","为什么我会和她们闲聊起来啊。[l]\n不，虽说现在宫小姐那边也要求加强这类联系……"],["やっぱりどうも変な感じだなあ。[l]\nあれ、先刻もそういった事を深刻に悩んでいたような記憶が。","果然还是觉得怪怪的。[l]\n咦，刚才好像也在为这种事烦恼来着。"],["しかしもう曖昧です。[l]\n状況も生生流転とでも言いましょうか、\n＋αの事象がいきなり起きた時点で僕のキャパを超えているさ。","但已经记不清了。[l]\n该说境遇瞬息万变吗，\n当突发状况超出我承受范围时。"],["「ミコは余程僕に","「看来卑尊是特别"],["揶われるのが厭だったのかねえ……[l]\n彼女もすっかり中央弁になってしまったが、\n僕に関しては元よりこうなのだ。","讨厌被我调侃吧……[l]\n虽然她也完全改用中央腔了，\n但我原本就是这样。"],["親が変わった人間でね。[l]\nあの地でこの喋りを貫くのはこれで結構至難の業なのだよ」","家父是个怪人。[l]\n在那种地方坚持这种说话方式可相当不容易」"],["「はあ、まあ、\nそうでしょうねえ」","「哈啊，嘛啊，\n确实是这样呢」"],["旅行で何度か行ったけども、\n西國の方言はかなり強固な我を持っていて、\n僕も滞在中は喋りが伝染ってしまう程だった。","虽然旅行时去过几次，\n西国的方言有着相当顽固的自我坚持，\n连我暂住期间说话方式都被传染了。"],["と思っていたら、同じような事を言われた。","正这么想着，就被说了类似的话。"],["「君も一見してどうにも流されるタイプのようだがなあ。[l]\nそうでなくてもこの辺りの方言はやや脆弱の気味があるだろうね。","「你看起来也是容易随波逐流的类型呢。[l]\n就算不是这样，这附近的方言也略显脆弱吧。"],["もう少し北の地方になるとかなり固まって来るが、\nこの辺ではまだ相手の喋りに引き摺られてしまう傾向は大きい。","再往北些的地区就会变得相当顽固，\n但这附近还是很容易被对方的说话方式带跑。」"],["だからこそ他方言の中で聞くミコのあれは愉快だったのに……","所以当初在其他方言里听到卑尊的腔调才那么有趣……"],["ま、君の思うとおり、\n西國の場合は我が強くて他方言の中に於いても\nそうそう流されはしない\n……その荷物、後ろに置いたらどうだね」","嘛，正如你所想，\n西国的方言自我意识很强，\n不会轻易被带偏\n……那个行李，放到后面如何？」"],["紙袋に入れていた制服を\n無意識的にぎっちり抱えていた僕をちら","我无意识地\n紧紧抱着装制服的纸袋，"],["視して、\n道具さんが顎をしゃくった。","被瞥见后，\n道具小姐抬了抬下巴。"],["「ああ、例の制服か。[l]\n聞いてるよ。[l]\n結構な似合い振りだったとか……[l]\nところで式と言えば、冬夏君とはあれから会ったかい？」","「啊，是那套制服啊。[l]\n我听说了。[l]\n据说相当合身来着……[l]\n说到仪式，之后见过冬夏君吗？」"],["「え？[l]\nいえ、道具さんとお会いしてからは会ってないですね。[l]\n連絡も特には……」","「诶？[l]\n不，自从见过道具小姐后就再没遇到了。[l]\n也没有特别联系……」"],["そこで道具さんは声のボリュウムを落として、\nこちらに身を寄せて言った。[l]\nちょ、運転怖いですがな。","这时道具小姐压低音量，\n凑过来低语。[l]\n喂、这样开车很危险啊。"],["そう、冬夏との問題も棚上げしたままだ。[l]\n黙っていればいいんだろうけど……[l]\nそれも色んな意味で引っ掛かるし……","是了，和冬夏的问题也还悬而未决。[l]\n保持沉默就行了吧……[l]\n但各方面都让人在意……"],["「そうか、\nいや、僕もまだ逢えないのだよ。[l]\n昨日もえらい深夜のご帰宅だったとか。[l]\n克杖君は兎も角、姫様君は大変だったろうな」","「这样啊，\n不，我也还没见到她。[l]\n听说昨天也是深更半夜才回家。[l]\n克杖君暂且不论，姫様君怕是够呛吧」"],["「はいっ？[l]\nそ、それはどういう」","「哎？[l]\n这、这是什么意思」"],["否、大袈裟な話では無いよ。[l]\nそもそも式前日も、練習やら準備やらで帰宅したのは\n深夜だったそうだし。[l]\nただ昨日は……、","不，并非夸张。[l]\n本来仪式前一天就因为练习准备什么的，\n据说回家就很晚了。[l]\n但昨天……"],["後片付けは今正に僕等が向かっている訳だし、\n打ち上げする程仲の良い友人でも居るのかな？[l]\n御母堂その他が寝静まるまで戻らなかったとさ。","毕竟收尾工作现在才要由我们去做，\n难道还有关系好到要开庆功宴的朋友？[l]\n直到夫人他们都睡下才回来。"],["姫様君の報告によれば、\n『永久に帰りたく無さそう』だったそうだが、\n彼女は学校には友人が少ないだろうからね。[l]\n少々不自然ではあるな」","据姫様君报告，\n『似乎永远都不想回来了』，\n但她在学校朋友应该不多吧。[l]\n多少有些不自然呢」"],["「はあ、\nまあ無事に帰宅はしたんですね？[l]\n心配は要らないと……」","「哈啊，\n总之平安回来了就好？[l]\n不用担心……」"],["「まあね。[l]\n姫様君はそういう役だからずっと付き合っていたそうだが、\n今日の事もあるから克杖君は不本意ながら別行動だった。[l]\n君への連絡も言い付かったろうからね」","「嘛。[l]\n听说姫様君因为职责所在一直陪着，\n但今天有事克杖君不得不分头行动。[l]\n应该也交代过要联系你吧」"],["にしても姫様ちゃん達、お目付役ってほんとなんだな……","不过姫様她们还真有监视者这回事啊……"],["「冬夏、何か理由があったんですかねえ……[l]\n年頃の女子だし気をつけて欲しいところですが」","「冬夏，是有什么原因吧……[l]\n毕竟是青春期女生，希望她能多注意」"],["「ふむ。[l]\nそうだな。[l]\n今後逢う事があれば君からも是非言って呉れ給え。","「嗯。[l]\n是啊。[l]\n下次见到时务必也帮我说说。"],["理由……は、そうだね、[l]\n僕等が此処に来た事だろう」","原因……嘛，[l]\n应该就是我们来到这里的缘故吧」"],["「え、\n僕…等ですか」","「呃、\n我…们吗」"],["「ん？[l]\nああ、此処で言う僕等とは、\n僕、奇士道具を含む西部の三春眷属者を指す。[l]\n少年の所為じゃ無いよ安心し給え。","「嗯？[l]\n啊，这里说的我们是指，\n我、包括奇士道具在内的西部三春眷属者。[l]\n不是少年的错啦放心好了。"],["君も祭を愉しみにわざわざ","你也是为祭典特意"],["月も前から\n此処に滞在してるのだから、\n多少は聞き及んでいると思うが、」","提前一个月就\n住在这里的吧，\n多少应该有所耳闻吧，」"],["ここに至って","说到这儿"],["漸く僕から身体を離し、\n運転席のシートに深々と身を沈める道具さん。[l]\nそして前方を見据えたまま続けた。","终于从我身上离开，\n深深陷进驾驶座座椅的道具小姐。[l]\n然后目视前方继续说道。"],["「三春の眷属……東西から七つの家の者が[l]\n祭の為に此処に集まる。[l]\n西國の関係者、僕を始めとして他数名が既に玄ノ森に来てるよ。","「三春的眷属……东西两方七个家族的人[l]\n为祭典聚集于此。[l]\n西国相关人员，以我为首已有数人抵达玄之森。"],["僕はミコの所に転がり込んだがね、\n大方の人間は当然、三春邸に宿泊するのだな。","我虽寄居在卑尊那里，\n但大多数人自然住在三春宅邸。"],["正直、冬夏君は親戚づきあいが苦手なタイプとでも言おうか、\n自己で構築した訳でもない関係の人間に愛想を振って接するのが\n苦痛とでも言おうか、\n僕も本人ではないから想像に過ぎないがね。","说实话，冬夏君属于不擅长应付亲戚的类型，\n对非自主构建的人际关系强颜欢笑\n堪称痛苦，\n不过毕竟不是本人只是揣测啦。"],["君も親類は居るだろう？」","你也有亲戚吧？」"],["「はっ。[l]\nま、まあそうですね、人並みには……」","「啊。[l]\n嘛、算是吧，和普通人差不多……」"],["一応飯窪のことは伏せてるのであやふやな返答になるが、\n幸い怪しまれることは無かった……と思う。","毕竟隐瞒了饭洼家的事所以回答含糊，\n所幸似乎没被怀疑……大概。"],["「君の所がどうかは知らないが、\n僕の知る限り血縁というのは本当に面倒臭いものでねえ。","「你家情况我不清楚，\n但据我所知血缘关系真是麻烦透顶。"],["まあ三春の……眷属の繋がりは必ずしも親類縁者ではないのだが、[l]\nそれでも我々は余所から視れば特権的な","虽说三春的……所谓眷属的关联未必就都是亲戚，[l]\n但在外人眼里我们终究是享有特权的"],["括りの集団、\nと思われてる訳で、","小团体，\n被这么认为的，"],["実際我々同士の付き合いも、\n一般の親戚づきあいとそうそう異なるものでもない」","实际上我们之间的交往，\n和普通亲戚往来也没多大差别」"],["「ええ」","「是啊」"],["「これが今で言う企業体や何か――\n単純な利害関係のみでの繋がりだったら寧ろ楽だったのだろうが、\n我々は少々……複雑、否、単純なのかな。","「换成现在说的企业体之类――\n若单纯是利害关系反而轻松，\n但我们稍微……复杂，不，或许该说单纯？"],["精査すれば血縁の繋がりも出るには出るかも知れないが、\n基本的には――","细究起来或许能找出血缘联系，\n但基本上――"],["つまらないかね？[l]\nこういう話は」","很无聊吧？[l]\n这种话题」"],["「はっ？","「诶？"],["はあいや、その大丈夫ではあるのですが、こう、\n余所の人間に語るにしては込み入ってると言いますか、\n他人様のお家事情を嬉々として聞くような人間ではないつもり\nなもので、気が引けてると言いましょうか……」","啊不那个倒没关系，就是，\n对外人讲这些未免太深入了吧，\n我自认不是那种会兴冲冲打听别人家事的\n人，该说有点惶恐……」"],["「あっははは、\n君は中々愉快だ。[l]\n君自身の物語の主人公たり得んと思ったらもう少しは\n","「啊哈哈哈，\n你挺有意思的。[l]\n不过我觉得若想成为自己故事的主角，还是该更有\n"],["自","主"],["我を強く持つが賢明だとは思うがね。","见些才行。"],["僕は君みたいなのが好きさ。","我就喜欢你这样的。"],["まあ、そう言った訳でね、\n少年は僕等の身内みたいなものなのに、\n何も御存知ではないようだから。[l]\n少々手を貸したくなったのだ。","总之呢，\n少年就像是我们的自家人一样，\n却好像一无所知。[l]\n所以想帮把手。"],["前も言っただろう。[l]\nそういう行為が好きなんだ」","之前也说过的吧。[l]\n我就是喜欢这种多管闲事」"],["流され巻き込まれ型の人間だっていう自覚は\n確かにあるけど。","虽然确实有自觉\n自己属于随波逐流型的人。"],["周りが自我の強い人間だと、\nそれに負けじと対抗しうる人格になるか、\n完全に身を委ねる脆弱な人格になるかどっちかな感じ？","周围若尽是些自我强烈之人，\n要么会成长为能与之抗衡的人格，\n要么就会沦为彻底委身于人的脆弱人格吧？"],["そんで僕は後者という事だが。[l]\n宮さんに逢わずとも、\n母さんも結構な振り回し型の人種だからなあ……","而我属于后者就是了。[l]\n就算没遇见宫小姐，\n老妈本身也是相当擅长摆布人的类型啊……"],["いやそれは置いといて。","啊这个暂且不提。"],["説明自体は任務上有り難いけど、\n何でこの人に、身内みたいって言われるんだろ？[l]\n前の時は卑尊さんに対しての方便かと思ってたんだが……","说明本身对任务很有帮助，\n但为什么会被这人说成像家人呢？[l]\n上次还以为是对卑尊小姐的说辞……"],["きぃもこうやって強引に援助されたのかな。","小贵也是被这样强行援助的吗。"],["「至極単純に言ってしまえば、","「若要用最直白的话来说，"],["冬夏君は御母堂とも、\n玄ノ森の眷属とも、\n僕等西の者共とも、\n反りが合わないのだ。","冬夏君与她母亲也好，\n与玄之森的眷属也好，\n与我们这些西方来客也好，\n全都水火不容。"],["いつもは自宅の部屋に籠もれば良いが、\n一同に会する今回の様な場合は――\nま、実際、これ以上は止めておこうか。","平日窝在自己房间倒无妨，\n但像这次需要全体齐聚的场合――\n嘛，实际情况还是到此打住吧。"],["そうだねえ、君が若しも……[l]\n彼女等の誰かと","对了对了，你若当真……[l]\n与她们其中哪位"],["契ることにあれば或いは事態は変わるかも\n知れぬがね。[l]\nそれこそ本当の身内となるならば」","缔结契约的话，局面或许会不同\n也未可知。[l]\n毕竟那才算是真正的家人」"],["「かかか揶わないでください」","「请请请不要戏弄我」"],["僕の周りには愉快さが信条の人ばかり集まるのか。[l]\n物理的な実害も許容してる様な場合はちと用心を要するが、\nこの人はどっちなんだろうなあ。","我身边怎么净是些以戏谑为信条的家伙。[l]\n若连物理伤害都容许的情况就需稍加警惕，\n不知这人属于哪种呢。"],["大神はその点割と、己の領分を","大神在这方面倒是很"],["弁えていたと言うか、\n妙にきっちりと自他の線引きしてたな。[l]\nあっち方面の人種はそういう人結構多いらしいけど。","恪守本分，\n异常严格地划清着彼此界限。[l]\n不过那类人似乎大多如此。"],["――宮さん視てる分には何とも言えないが。[l]\n結局男子と女子の差違なのかなあ。","――但看宫小姐就不好说了。[l]\n终究是男女差异吗。"],["それより冬夏、\n彼女が何かに付け家の事を疎んでいたのは事実のようだし、\n如何に僕でも数日の付き合いで其れは知れる。[l]\nしかし理由は道具さんの説明でも判らずじまいだった。","比起这个，冬夏，\n她确实对家里事事都透着疏离，\n即便是我相处数日也能察觉。[l]\n但缘由直到道具小姐说明时仍未能明了。"],["血縁の面倒――","血缘关系的麻烦――"],["まあ、現実は言わずもがな、\n色んな犯罪小説でも動機の最たるものとして\nよく扱われる題材であるから、\n想像理解は出来ぬまでも納得は出来る。","嘛，现实自不必说，\n就连犯罪小说里也常作为\n典型动机题材，\n纵难理解也能接受。"],["「ははは、ま、そう言う訳で冬夏君の話だがね。[l]\n彼女はそう、だから、\n嫌われている訳ではなくて、\n畏れられているというべきかな。","「哈哈哈，总之关于冬夏君的情况，[l]\n她那个，该说\n并非遭人厌恶，\n而是令人畏惧才对吧。"],["御母堂の時とは別の、色々な意味に於いて近寄りがたい空気を\n","与她母亲不同意义上的、各种难以接近的气场\n"],["纏っておいでだからね」","萦绕周身啊」"],["「うーーーーん、\nまあ、僕は気さくな彼女ばっかり視せられたもので、\n何とも言えませんけど、\nそう言うもんなんですかねぇ……」","「唔————\n不过我只见过她随和的模样，\n实在不好评价，\n原来还有这面啊……」"],["「君の心意気を察してこれだけ言わせて貰おう、\n君は優しいな、少年」","「看在你这份心意上破例多说几句，\n你很温柔呢，少年」"],["道具さんがしみじみと言った。","道具小姐感慨道。"],["優しい……[l]\n臆病で狡いだけだ。[l]\n唐突な話のシフトだったが、\n僕は内心思わずそう反応していた。","温柔……[l]\n不过是胆小又狡猾罢了。[l]\n话题虽转得突兀，\n我心底却不由自主如此反应。"],["「だが、現実世界はそういう察しの良い者だけで\n構成されてる訳じゃない。","「但现实世界并非全由\n这般善解人意者构成。"],["或る人の言葉を借りれば、\nこの世は最悪の箱庭だそうだしね。","借用某人的话说，\n这世间可是最糟糕的箱庭呢。」"],["文明持つヒトにとっては、\n許可事項が多きことは善きことではないし、\nこの星での生命活動とは他者を喰い、繋ぐ事だ」","对于拥有文明的人类来说，\n许可事项过多并非好事，\n在这颗星球上的生命活动就是吞噬他人、维系彼此」"],["食いつなぐ？[l]\nいや、イントネーションというかアクセントが違ってたか。","勉强糊口？[l]\n不，该说是语调还是重音搞错了。"],["大体それでは文意がおかしい……が、[l]\n一体何の話なのだろう？[l]\nと、道具さんもその僕の疑念を察したらしく、\nすぐさま軌道修正を行う。","这样句意根本说不通……不过，[l]\n到底在讨论什么话题呢？[l]\n见状，道具小姐似乎也察觉到了我的疑惑，\n立刻进行了话题修正。"],["「や、少々横道に過ぎる話だな。[l]\nまあ冬夏君もそういうイヤナコトの中に、\n幼くして身を置いていたのだな。","「哎呀，说得有点跑题了。[l]\n不过冬夏君也是从小就被迫\n置身于这类讨厌的事情中呢。"],["この地に於いて彼女の家というのは特殊な意味を持つから、\n周囲には取り入りたい人間も居るのだろうが、\n冬夏くん自身は取り巻きみたいなのを毛嫌いするからね。","在这片土地上她家具有特殊意义，\n周围肯定不乏想要攀附的人，\n但冬夏本人非常讨厌那些趋炎附势的家伙。"],["ま、君も彼女に気に入られたのなら是非、\n親しい仲であって欲しいものだが。[l]\n僕はまだそんなに嫌われてはいない方だと思うがね、\n中々本心を語ってくれないのは一緒だから」","嘛，既然你也获得了她的青睐，\n希望你们能成为亲密伙伴吧。[l]\n虽然我觉得自己还不算被她讨厌，\n但她同样不肯对我敞开心扉呢」"],["「でもきぃ……貴奴とは」","「但小贵……贵奴她」"],["「ふむ。[l]\n馬が合ってるようだね。","「嗯。[l]\n看来挺合得来的嘛。"],["西石君とは僕が仲を取り持った……とでも言おうかな。[l]\n","可以说是我撮合了西石……这么形容也行吧。[l]\n"],["偶","偶"],["々そういうエンがあってね。[l]\n御母堂には良い顔をされないので秘密にしておいてくれ給えよ」","尔会有这种缘分呢。[l]\n因为这事不会被她母亲看好所以还请帮我保密哦」"],["「ええ、それはまあ――\nえと、結構古い付き合いなんですっけ？」","「啊，那个嘛――\n呃，你们是老交情来着？」"],["「西石君も中々複雑な家庭の事情の持ち主なのだよ。","「西石君的家庭情况也相当复杂。"],["僕は西國と玄ノ森を行き来する都合上、\n東西関わらず個人的な付き合いのある知人が居るのでね、\nその中のとある","我因经常往返西国与玄之森，\n在东西两地都有些私交甚笃的熟人，\n其中某位"],["伝","传"],["手で西石君とはかなり前から縁があるのだ。[l]\nその縁あって僕も力添えをする事になったんだが……[l]\nそもそもの始めは――\n否、それはあまり他人様に言うことじゃないね。[l]\n僕はともかく西石君が」","话人很早前就与西石君有渊源。[l]\n因为这层关系我也提供了些帮助……[l]\n不过事情的起因――\n不，这个不便对外人细说。[l]\n暂且不论我，西石君她」"],["「ああ、それはもう、いいですいいです、\n聞かないでおきます。[l]\nところで元気ですか？彼奴は」","「啊好了好了，\n我不多问了。[l]\n话说她现在身体还好吗？」"],["「ふむ、\n西石君はあの日辺りからちょっと体調を崩していてね、\nミコにも言って休ませてるんだ。","「这个嘛，\n西石君从那天起就有些不适，\n我让卑尊给她放假了。"],["勿論有休扱いにさせてるよ。[l]\n後で見舞いに行く事になっているのだよ」","当然算带薪休假。[l]\n待会儿准备去探望她」"],["「長久診療所でですか？[l]\nあれだったら僕も見舞いに行きますかねえ、\nこっち来てからは世話になってますし……」","「在长久诊所吗？[l]\n那我也去探望下吧，\n来这边后受她不少照顾……」"],["「いや、彼処はミコが厭がったので住家の方だよ。[l]\n隣町のね。[l]\nなので気持ちだけ伝えておくよ。[l]\n視られたくない部分もあるだろうし」","「不，卑尊讨厌那里所以是在她住处。[l]\n邻镇的。[l]\n心意我会代为传达。[l]\n有些部分她可能不愿示人」"],["うーん、\n思ったよりも重い背景を持ってるのだろうかなあ。","唔——\n看来背景比想象中更沉重啊。"],["昔に","即便"],["遭ってたとしても、\nそんな小さい頃じゃ大人の事情も分からんだろうし……","曾经遭遇过什么，\n那么小的年纪也理解不了成人世界的复杂吧……"],["ただ、未だに本当にきぃが、\n幼少期に遊んだ相手なのかどうかは本人の言しか確たるものがない。","只是关于小贵是否真\n是童年玩伴，目前只有她本人的说法能作证。"],["僕の曖昧な記憶は最近、微妙に再生しつつあるし、\nもしかしたら――\n確実にそうと言える日が来るかも知れない、近いうちに。","我模糊的记忆最近正微妙地复苏，\n说不定――\n很快就能明确断言了，就在不远的将来。"],["勿論、それは彼奴じゃないという、\n不気味な結果をもたらす可能性も在るわけだが。","当然、那也可能意味着并非那家伙、\n会导致令人毛骨悚然的结果。"],["「じゃあ宜しく伝えてくださいますか、\n後でまた飯でも奢ると」","「那麻烦您帮忙转达一下、\n改天我请吃饭」"],["「ん、了解したよ」","「嗯，明白了」"],["「まあ彼奴の話に関しては、\n僕も聞いてたかも知れないんですが、\nどうも記憶力に難ありでして……」","「关于那家伙的事、\n我可能也听说过、\n但记性实在不太好……」"],["「ふむ、まあそうであってもきっと君の所為ではないな。[l]\nで、何の話だったかな？[l]\n婿入りの話か。","「嗯，即便如此肯定也不是你的错。[l]\n对了，刚才说到哪儿了？[l]\n入赘的事吗。"],["冬夏君はそういう訳で少々敷居は高いなあ……[l]\nどうしてもと言うならば止めはしないが、\nお薦めは姫様君か、意外なところで……克杖君？[l]\nあとはまだお子様か或いは……だしねえ……」","冬夏君的情况门槛有点高啊……[l]\n若你执意如此我也不阻拦、\n推荐人选要么是姫様君、要么意外地……克杖君？[l]\n剩下的不是小孩就是……呃……」"],["「あの、そういう話でも無かったような気が……」","「那个…好像本来不是在说这个……」"],["「ん？[l]\nそうだったかね」","「嗯？[l]\n是这样吗」"],["「いえ、いいんですけどね……[l]\n話題の一方的なフリとか脱線には馴れてますし。[l]\nそういう人達との付き合いには事欠かないんです僕」","「不，没关系……[l]\n我早就习惯话题被单方面带偏了。[l]\n身边从来不缺这种人」"],["そう","刚一"],["零すと、","说出这话、"],["「ははは、そう怒りなさんな。[l]\n類は友を呼ぶ、という格言があるだろう、\nあれはなかなかに含蓄のある一文だよ。","「哈哈哈，别这么生气。[l]\n不是有句谚语叫物以类聚吗、\n这话可是意味深长啊。"],["況してや僕らのような……には色々あるのだな。","尤其像我们这样的……总有许多故事。"],["だからね、\n君が招いてるんだなあ、そういう人間をきっとね。[l]\n好い傾向だよ」","所以呢、\n肯定是你自己招来的、那些同类。[l]\n是好事哦」"],["何の事やら……と思う","完全不明所以……正想着"],["間に、[l]\n道具さんは突然声量を戻して、","时、[l]\n道具小姐突然提高音量、"],["「さて、次の停車場だろう。[l]\n待ち合わせ場所は」","「好了，下一站吧。[l]\n碰头地点是？」"],["と仰った。","她说道。"],["突然現実的な話題にシフトした所為か一瞬、\n眼の前が真っ白になる。[l]\n慌てて再思考する……のだが、","突然切换到现实话题的冲击、\n让眼前瞬间发白。[l]\n慌忙重新思考……然而、"],["「えーと……[l]\nそう…でしたっけかね？」","「呃……[l]\n是…这里来着？」"],["本来バスに乗っていればそこで降りた筈のバス停が多分それだが、\n車内アナウンスを当てにしていたのでよく分からない。","原本乘巴士该下车的站台大概就是那个、\n但因依赖车内广播所以不太确定。"],["「ほら、\n克杖君達が彼処に来てるね」","「快看、\n克杖君她们在那边」"],["眼を凝らすまでもなく、\n其処には、\nジャージ姿の姫様ちゃんと狩屋が居た。[l]\nおそろいじゃないのでどっちかが私服なのかも知れない。","无需定睛细看、\n那里站着\n穿运动服的姫様酱和狩屋。[l]\n并非情侣装，可能其中一人穿的是便服。"],["近くにあった広場に車を停める。[l]\nあの二人は、僕が一人でバスで来ると思っている","把车停在附近的广场。[l]\n想必那两人以为"],["筈で、\n少々驚かすことになるだろう。","我是独自乘巴士来、\n这下要让她们吃惊了。"],["……携帯で連絡すりゃ良かったのか。[l]\n否、普通に考えて道具さんが既に説明してると思うが――","……该用手机联络的。[l]\n不，按理说道具小姐应该解释过了――"],["「やややや、お早う。[l]\n今日は良い天気で良かったねえ」","「呀呀呀呀，早上好。[l]\n今天天气真不错呢」"],["「うあっ、トモさん！？[l]\nな、なんでいる……いらっしゃるんですか。[l]\nであ、兄ぃと一緒！？[l]\nにゃにゃにゃにゃにゃにゃんで？」","「哇啊，道具小姐！？[l]\n为、为什么……会在这里。[l]\n难、难道和哥哥一起！？[l]\n喵喵喵喵喵为什么？」"],["――説明は為されてなかったようだった。[l]\nあ、あれっ。[l]\n最初の話だと一応計画的な行為めかしてた気がしたんだが……","――看来并未被告知。[l]\n啊，咦。[l]\n最初的说法听起来像是计划好的行为来着……"],["「僕が手伝うと知っていたら、\n克杖君は彼の召喚を渋る理由を見出してしまうだろう？","「若知道我在帮忙，\n克杖君就会找到拒绝召唤他的理由吧？」"],["それは姫様君にとって、\n引いては君自身の不都合となりかねないのだろうしね、\nまあ","那对姫様君来说、\n进而对你自身而言，搞不好反而会变成你自己的麻烦呢、\n嘛"],["佳いじゃないか、単純に労働力が増えたと思い給え」","不是挺好的嘛、单纯就当劳动力增加了呗」"],["「え、えぐう……そ、う、あ、[l]\nじゃ、じゃあ、たまたま一緒になったとかじゃにゃいん……」","「呜、呜咕……是、是、啊、[l]\n那、那该不会是碰巧遇到之类的喵……」"],["要するに狩屋に気を遣っての事後承諾、いやさ既成事実として\n参加したかったという事か。[l]\n確かに狩屋はその辺面倒な心持ちだろうけども、\nそこまでする事かしらん。","说白了就是顾虑到狩屋才事后追认的、不、应该说是既成事实\n其实就是你自己想参加吧。[l]\n确实狩屋在这方面会有点难搞、\n但至于做到这种地步吗。"],["と、眉をひそめっぱなしの狩屋と眼が合う。","说着、与始终皱着眉头的狩屋对上了视线。"],["「ああ、お早う……[l]\nそういう事でまあ、ほら、\n時間は早く着いた……よな？[l]\nバスが来る前に拾われてさ……」","「啊、早安……[l]\n就是这么回事啦、你看、\n时间还早得很……对吧？[l]\n在巴士来之前就被逮到了……」"],["「にゃっ、\nそ、そらそうにゃけど。[l]\nだってういら今バスを待ってたんにゃからな」","「喵、\n确、确实是这样喵。[l]\n因为咱刚才确实在等巴士喵」"],["ぶおーーーん。","哔呜————。"],["丁度そこに白ベースに赤ラインの、古ぼけた車両、\nつまりはこの辺の路線バスがやってきた。","正好这时一辆白底红条的、破旧车辆、\n也就是这附近的线路巴士到站了。"],["僕等が其処に溜まっていたので一瞬乗車口が開きかけたが、\n道具さんが手をひらひらと振ると、\nドライバーさん諒解したのかそのまま通過する。","因为我们堵在那里，车门差点就要打开了，\n道具小姐轻轻挥了挥手，\n司机先生似乎理解了就直接开过去了。"],["それをぼーと見送っていたら、","正呆呆目送着车子，"],["……おや？[l]\n姫様ちゃん何処に行った？","……咦？[l]\n姫様去哪了？"],["「お早うございます」","「早上好」"],["「おあ！[l]\nお、お早う、\nごめん、ちょっと吃驚した……[l]\nいつの間に後ろに――」","「啊！[l]\n早、早上好，\n抱歉，有点被吓到了……[l]\n什么时候跑到后面――」"],["「……驚かそうと思って」","「……本想吓唬你的」"],["「……はぁ、あははは、そうなんだ……[l]\nそれはまた、\nん？」","「……哈，啊哈哈，这样啊……[l]\n这可真是，\n嗯？」"],["彼女のお茶目さ加減にリアクションする前に、\nふと眼に入ったものがある。","还没能对她俏皮的行为做出反应，\n突然瞥见了什么。"],["今まで長袖の制服姿しか視てないから気付かなかったのか。[l]\n下はスパッツ、上は半袖ジャージの様な出で立ちだったので\n非常に目立つその――","之前只看过她穿长袖制服的样子所以没注意到吧。[l]\n下面是紧身裤，上面是类似半袖运动服的打扮\n格外显眼的那个――"],["「あれ、姫様ちゃん、腕怪我してる？[l]\n大丈夫？」","「哎呀，姫様，你手腕受伤了吗？[l]\n不要紧吧？」"],["両腕に包帯……にしてはガーゼっぽくない感じの\n白布らしきものを[l]\nぐるぐるに巻いていた。","双臂缠着绷带……但看起来不像是纱布\n更像是[l]\n裹着白布条。"],["「いえ……これは、」","「不是……这个，」"],["「にゃーーっ、ファッションにゃんねぇーー、\nげうふ、げふげふ、\n","「喵呜——这是时尚啦喵——\n咳咳、咳咳咳、\n"],["ご、ごめ、","对、对不起、"],["咽せ……おえふっ」","呛到……呕噗」"],["僕等のマンツーマンの会話が気に入らんかったのかも\n知れないが、\nいきなり会話に割り込もうとするから……","或许是不满我们俩的单独对话\n吧、\n突然就想插话结果……"],["道具さんが狩屋の背をさするが姫様ちゃんはそれを見守るのみ。[l]\nまあ、頑張りなされ……","道具小姐拍着狩屋的背，姫様只是静静看着。[l]\n嘛，加油吧……"],["「あ、そうなんだ。[l]\nごめん、そういうの","「啊，这样啊。[l]\n抱歉，我对这类事"],["疎くてさ……[l]\nまあ何でもないならそれでいいんだけど」","不太懂……[l]\n不过既然没事就好啦」"],["「心配してくれてありがとうございます。[l]\nすべてはさいこうです」","「谢谢你的关心。[l]\n一切都很完美」"],["……？[l]\nどういう意味でしょう。","……？[l]\n这是什么意思呢。"],["「あーっと少年、\nそんなに克杖君の脚に見入っちゃいかんよ。[l]\n全く以て男子というのはブルマ好きだねえ」","「啊—喂少年，\n别那么盯着克杖的腿看啦。[l]\n男人果然都喜欢运动短裤呢」"],["「！？」","「！？」"],["「！！」","「！！」"],["そこで、\n姫様ちゃんの言葉を噛み砕く間もなく、\n道具さんがシャレにならない洒落を投下したのです。","就在这时，\n还没等消化完姫様的话，\n道具就抛出了个要命的冷笑话。"],["「う、うにゃっ！[l]\n","「呜、呜喵！[l]\n"],["エロ！ばか！へんたい！[l]\nみんじゃねーーー！！」","色狼！笨蛋！变态！[l]\n去死啦———！！」"],["「や！[l]\nちが！[l]\nは？！","「才！[l]\n没有！[l]\n哈？！"],["何おいってるんですか！！[l]\nどどど道具さんもうそいわない！！」","您在说什么啊！！[l]\n道道道具小姐别胡说八道！！」"],["しかもこれはデジャ－ビュでしょうか。[l]\n何か前にも同じような事が。","而且这算是既视感吗。[l]\n总觉得之前也发生过类似的事。"],["「……克杖」","「……克杖」"],["「えっ！[l]\n","「诶！[l]\n"],["ずずずずず狡くにゃいってばっ！！[l]\n狙ってにゃいし！！[l]\nなにも！！」","才才才才没有耍诈喵！！[l]\n又不是故意的喵！！[l]\n什么都没有啦！！」"],["「うーん御機嫌だねぇ姫様君。[l]\nそれではまず学校に行こうか。[l]\n折角早めに集合出来たのだし」","「唔—心情不错嘛姫様君。[l]\n那我们先去学校吧。[l]\n难得能提前集合」"],["無駄に昏迷の様相を呈し、且つその度を深めつつあったその場は、\nその状況を作り出した発起人によって、\nしかもそのどれをも解決せぬまま、\n次の状況へと遷移させられようとしていた。","这场毫无意义的混乱局面正不断加剧，\n却被始作俑者\n在未解决任何问题的情况下，\n强行推进到下一阶段。"],["まあ、\nどれもがどうでもいい事象だったけど、","不过，\n虽然都是些无关紧要的小事，"],["「………」","「………」"],["姫様ちゃんの眼だけが怖いんだもの……","但姫様的眼神真的好可怕……"],["ああ、[l]\n天気はすごく良いのだがねえ。","啊，[l]\n虽然天气是超级好呢。"],["昨日の時点で狩屋が準備をしてたようなので、\n積み込み自体はすぐ終わった。","因为狩屋昨天就做好了准备，\n装车工作很快就完成了。"],["その狩屋から前に説明を受けた通り、\nやはり神事に使用したものは儀礼的に処理するのが常らしく、\nそれ専用の処理場に運ぶのが今回の仕事だ。","正如之前狩屋说明的那样，\n用于神事的物品照例都要进行仪礼处理，\n这次的工作就是将它们运往专用处理场。"],["その儀礼的処理にまで僕が関わる事になるかどうかは\nまだ聞いてないが、","至于我是否需要参与后续仪礼处理\n还没听说，"],["一応三春の私有地内になるし、\n祭儀に関した場所ともなる訳で、\n若しかすればあの蔵の中のように何らかの情報が\n得られる可能性はある。","不过那是在三春私有地内，\n也算是与祭祀相关的场所，\n说不定能像在那个仓库里一样\n获取某些情报。"],["ただ、\n面子的に僕ぁ、積極的に探索に身を入れられる自信は無いなあ……","只是，\n面子上来说...我实在没信心能积极展开调查啊……"],["と、どこかに携帯電話を掛けていた道具さんが戻ってきた。","正想着，刚才去某处打电话的道具回来了。"],["「ふむ、\nお待たせしたね。[l]\nでは、改めて運転宜しくお願いするよ。","「嗯，\n久等了。[l]\n那就重新拜托你开车啦。"],["さ、これ、キーだ。[l]\n今時の洒落た機能などない、\n完全なる手動のみの対応だから気をつけてくれ給え」","来，这是钥匙。[l]\n没有现代那些花哨功能，\n纯粹手动操作所以要小心喔」"],["「あ、どうもです。[l]\nインキーも有り得る訳ですね……」","「啊，好的。[l]\n居然还有这种原始钥匙啊……」"],["「多少は自分で気を遣わないとね。[l]\n脳髄は使い続けるに超したことはない。[l]\n","「多少要自己动动脑子。[l]\n持续用脑总没坏处。[l]\n"],["なんでもかんでもフォローされてる状況が良いとは限らない……","并非所有事都被关照就是好事……"],["しかしながら『恣意的に設定された不便』もやはり宜しくない。[l]\n","但『刻意设置的不便』也确实不妥。[l]\n"],["バランスが肝要だね」","关键在于平衡呢」"],["大神にだったか宮さんにだったか、\nゲェムの話題でそういう話を聞かされたのを\n思い出した。","想起不知是大神还是宫小姐，\n在讨论游戏话题时\n说过类似的话。"],["その時は喩えが具体的すぎてよく分からなかったけど……[l]\n単純な理屈としてなら解る。[l]\nまあ道具さんが言うのは実生活に伴う話で、\n娯楽の有り","虽然当时比喻太具体了没太搞懂……[l]\n单纯作为道理的话还是能理解的。[l]\n不过道具小姐说的是现实生活中的事，\n娱乐的存"],["様とはまた話のステージが違うんだろうが。","在和姫様讨论时层面又不同了吧。"],["「おーい兄ぃ、トモさん、\n早くいこうにぇー」","「喂——老哥、道具姐、\n快点走啦～」"],["狩屋に急かされて、\n僕等二人は車に乗り込んだ。","被狩屋催促着，\n我们俩上了车。"],["配置は、\nドライバー僕、助手席に道具さん、\n後部座席に姫様ちゃんと狩屋である。[l]\n道具さんが案内をしてくれるらしい。","座位安排是，\n我当司机，道具小姐坐副驾，\n后座是小姬和狩屋。[l]\n似乎由道具小姐负责指路。"],["彼女にしてみれば当然、勝手知ったる何とやらなんだろうし、\nこの辺だと機械のカーナビ、地図が入ってない以前に、\n行き先が私有地の山ん中だっつーの。","对她来说想必是轻车熟路吧，\n这地方的汽车导航根本连地图都没录入，\n何况目的地还是私有山地呢。"],["「じゃあ、出発しまーす……」","「那么，出发咯……」"],["後ろに荷物が載った為に少々慣性の強くなった車を\n慎重に運転する。","由于后车厢装了行李导致惯性稍强，\n我谨慎地驾驶着。"],["多少ボロくて持ち主がぶっつけを気にしてないとはいえ、\n流石にそれに甘んじることは出来ない。[l]\n気は遣う。","虽说这破车本来就不怕磕碰，\n但也不能太乱来。[l]\n得小心点。"],["兎にも角にもまず用件を一個一個片付けよう。","总之先一件件处理正事吧。"],["「ああ、制服その袋の中。[l]\nちゃんとクリーニングしたから心配ご無用、\nまあその、ありがとう」","「啊，制服在那个袋子里。[l]\n已经干洗过了不用担心，\n呃，那个，谢谢」"],["言い出しっぺは僕でない為に御礼を言うのも何か筋違いな\n空気だったが、\n会話ってそんなものだよね。","因为不是我提议的所以道谢总觉得有点怪，\n但气氛就是这样，\n对话嘛不都这样。"],["「いえ、とんでもないです。[l]\n今後も何かあればまた」","「不，您太客气了。[l]\n以后有事随时吩咐」"],["いや、だからどうにも筋が違う気がするけど。[l]\n今後って言われても、\n少なくとも女装は二度と無い……事を祈ります。","不是，总觉得哪里不太对劲啊。[l]\n虽说提到以后，\n至少女装是再也不会...希望如此。"],["「ああ、ういは色んな意味であんまし思い出したくにゃいわ……」","「啊啊，那段往事从各种意义上都不想回忆起来喵……」"],["「……ずるい」","「……狡猾」"],["「はっ！！[l]\nや、そのっ、\n","「啊！？[l]\n不、那个，\n"],["あれ？[l]\nきーちゃはそういえば、視て……にゃいんだっけ」","咦？[l]\n说起来小姬应该没看到……喵？」"],["「……近くでじっくりとは……」","「……近距离仔细看的话……」"],["「ま、まあそんなたいしたものでは……」","「嘛、反正也没什么大不了……」"],["宮さんが撮った写真は存在するけど、\n……そこまでせんでもええよなあ。[l]\n基本的に僕にとっては恥ずべきモノであるし……","虽然宫桑拍的照片是存在的，\n……倒也不必做到那份上吧。[l]\n本质上对我来说也是黑历史……"],["「まあまあ、\nそもそも姫様君が、\n彼に感想を聞きたいというのが趣旨だろう？」","「好啦好啦，\n本来姫様君\n就是想听他的感想才对吧？」"],["「？[l]\n……そんなことまでういら、言ったっけ？」","「？[l]\n……我连这种事都说了吗？」"],["「ん？[l]\n君達はあの人に話したんだろう。[l]\n西部の面々はこうみえて仲がよいのだよ？」","「嗯？[l]\n你们不是和那位说了嘛。[l]\n西部众人看着这样其实关系很好哦？」"],["「ああ……」","「啊啊……」"],["何の話かよく分からないが、\n別に僕が入るべき会話でも無さそうだったので\n運転に集中する。","虽然搞不清状况，\n但似乎没我插话的余地，\n便专心开车。"],["旅先でレンタカーを使う事はままあるが、\nいつもと違う車の運転は未だに緊張するのだ。","虽常租车旅行，\n开不熟悉的车还是会紧张。"],["「と言うわけで、\nまあ、しばらくは道なりだ。[l]\n姫様君に話てやって呉れ給え。","「总之，\n接下来沿路直走就行。[l]\n姫様君你来说吧。"],["ちなみに僕は……概容は把握してるが、[l]\n実際的には参加したことがないのでね」","顺带一提我……虽然知道大概，[l]\n但实际没参与过呢」"],["「え？[l]\nあ、ああ、そうですなあ……」","「咦？[l]\n啊、啊啊、是这样呢……」"],["結局、感得がどうのに関しては先日から考察してる通りで、\n仕方がないので、\n頭からぼやかしながら話してみる。","说到底关于感得什么的正如前几天考察的那样，\n实在没办法，\n就边模糊记忆边试着说说看吧。"],["「なんだっけな、\nまず、あの式場に入ったら、\n隣りに眼鏡を掛けた","「说来是啥来着，\n首先进了那个会场后，\n旁边坐着个戴眼镜的"],["怪","很"],["訝しな女子が居て、","可疑女生，"],["何か僕の正体を見破った上で見逃そう、\nみたいなよく解らないことを」","像是看穿了我的真面目又打算放我一马，\n说了些莫名其妙的话」"],["一応宮さんの情報を補強する為の意味も込みで\nそういう訊き方をしてみる。[l]\n勿論、何も知らない風を装う。","为了补充宫小姐的情报\n我故意用这种问法试探。[l]\n当然要装作一无所知的样子。"],["「その人……」","「那个人……」"],["「え、知ってるの？」","「咦，你认识？」"],["我ながら白々しいけども一応そういうリアクションをする。[l]\n道具さんは……横目で窺う限り、[l]\n半笑いでずっと窓の外を視ておられるが、\nまあ見抜かれたという事もないだろう。","虽然自己都觉得假惺惺但还是配合着做出反应。[l]\n道具小姐……从偷瞄的情况看，[l]\n一直挂着似笑非笑的表情望着窗外，\n不过应该没被识破吧。"],["……ないよな。[l]\n最近察する人が多くてどうにも疑心暗鬼になるなあ。","……应该没有吧。[l]\n最近察觉的人太多搞得我都疑神疑鬼了。"],["「選律さん」","「选律大人」"],["「えあ……[l]\nき、きーちゃ？[l]\nああ、ええと、\n前ちらっと……言ったような言ってないような、","「呃啊……[l]\n姬、小姬？[l]\n啊，那个，\n之前好像提过又好像没提……"],["説明が遅れたけど、\nあれが選の字って言って、\nその……説明がむずかしいから割愛するにゃが、","虽然说明迟了，\n那个字念『选』，\n因为……解释起来太复杂就省略喵，"],["ういも居るのは知ってたけど、\nまさか兄ぃの隣りに居たとは知らにゃかった、\n兄ぃが帰ってからわかったんにゃのよね」","虽然知道她也在，\n没想到居然待在哥哥身边喵，\n是哥哥回来后才发现的喵」"],["「選律さんは私達『","「选律小姐是我们『"],["八","八"],["相』の西國仕切です」","相』在西国的负责人」"],["成る程、基本的には宮さん情報と合致するのか。[l]\n只、狩屋が言い渋る理由背景が解らないけど、\n声を出さぬまでも狼狽しているのが伝わる。","原来如此，基本上和宫小姐的情报吻合。[l]\n只是不明白狩屋欲言又止的背景，\n能感受到她不出声的狼狈。"],["口","这么说来是禁"],["外","止"],["御","外"],["法","传"],["度な重要事項だと言う事だろうか？[l]\n確かに聞いたことのない――","的重要事项吗？[l]\n确实闻所未闻――"],["ん？[l]\nヤソウ？","嗯？[l]\n八相？"],["何処かで聞いた……ような？","好像在哪听过……？"],["「大丈夫、\n真言さんだから」","「没关系，\n因为是真言先生」"],["「……いあ、その」","「……不、那个」"],["八の相と表すが、\n実際に三春とその眷属たる我等は七つの家なのだなぁ」","虽写作八相，\n实际三春及其眷属我等只有七家呢」"],["「……！[l]\nと、トモさんまで――」","「……！[l]\n连、连道具小姐都――」"],["狩屋がやはり息を","狩屋果然倒吸"],["呑む。[l]\n此奴の気持ちも解ると言うか。","一口凉气。[l]\n这家伙的心情我也能理解。"],["僕が思うのもなんだけど、\nどうにもこの人達は口が軽すぎるというか、\nそれほど重要事だと思ってないのか、\n僕の存在など歯牙にも掛けてないのか。","虽然由我来说有点那啥，\n总觉得这些人嘴太松了，\n要么是觉得不算多重要的事，\n要么根本没把我放在眼里。"],["後者にしては、\n姫様ちゃんあたりは特に積極的な情報開示をしてくるので\n何とも言えないが、","要说后者的话，\n姫様她们又特别积极地透露情报\n所以不好断言，"],["冬夏の事もあるし彼女達の中にも保守革新の派閥があるのは\nどうやら間違いはないようではある。","考虑到冬夏的事她们内部应该也存在保守革新派系\n这点看来是没错的。"],["でも、[l]\n僕だからと言うのはどういう意味だろう。","可是、[l]\n说因为是我到底是什么意思呢。"],["姫様ちゃんまで僕の記憶力に高を括っているのか、\nそれとも、[l]\n本当に『僕が僕だから』情報を開示しているとしたら、\n……。[l]\n道具さんが、僕を評して『身内のようなもの』と言うのも\n気にかかる。","连姫様都对我的记忆力抱有期待吗、\n还是说、[l]\n如果真的在『因为是我』的前提下披露情报的话、\n……。[l]\n道具小姐评价我说『像是自己人』这件事\n也让我在意。"],["飯窪本家と三春家が同じ土地、\nこの玄ノ森に本拠を置いてるという事、\n両家ともに書籍蒐集及び、\n何故か手の込んだ建造物を所持している事、","饭洼本家与三春家在同一片土地、\n将这座玄之森作为根据地这件事、\n两家都热衷于书籍收藏及、\n不知为何拥有构造复杂的建筑物这件事、"],["バックボーンとしての共通点は確かに存在しているが、\nしかし僕が飯窪の者とは言ってない筈のこの状況下で、\n他に何かしら僕を同類と見なす要素があるとしたら、","作为背景的共通点确实存在、\n但在明明没说过我是饭洼家的人的现状下、\n如果还存在其他将我视为同类的要素、"],["それは一体何だと言うんだ。","那究竟会是什么呢。"],["それは式で何かを感得する筈と、姫様ちゃんが思い込んだ素養と\n同義なのか。","这与姫様坚信我该通过式术感知到某些东西的资质\n是相同的概念吗。"],["僕の鈍麻してる筈の記憶力が、どうにも最近は活性化してるようで、\nもう一つ思い出した事がある。","我本该迟钝的记忆力最近似乎莫名活跃起来、\n又想起一件事。"],["その選律――西國仕切という女子が、\n僕を見逃す理由として言ったのが、\n同類同業の","那位选律――自称西国管事的女子、\n她放过我的理由是、\n同业同道的"],["誼で……という事。","情分……这么说的。"],["僕は最初これを、\n本来部外者禁制の式に潜入している者同士という風に捉えていたが、","我最初理解为、\n这是指同为潜入本该禁止外人参加的式术之人、"],["彼女自身は当事者も当事者――まあ、生徒ではないにしろ――\nである事が、宮さん情報だけでなくて、\n姫様ちゃんの言から証明された、のだ。","但她本人就是当事人中的当事人――虽说不算学生――\n这件事不仅通过宫小姐的情报、\n也从姫様的话中得到证实。"],["と言うことは、[l]\n何を以てして、僕を同類と呼んだんだ？","也就是说、[l]\n她究竟凭什么称我为同类？"],["「おぉいー少年、\n信号赤いぞぅ」","「喂喂ー少年、\n红灯了哟」"],["「おあ！[l]\nす、すみませんっ」","「哇啊！[l]\n对、对不起！」"],["慌ててブレーキを踏む。[l]\nし、知らないうちに交差点に差し掛かっていた。","慌忙踩下刹车。[l]\n不、不知不觉竟已开到十字路口。"],["「うあにゃ！[l]\n","「呜喵！[l]\n"],["あ、あ、兄ぃぼーとしてんな！！[l]\n田舎だと思って甘く視てんにゃよ！！[l]\n只でさえ後部座席は酔う……","啊、啊、哥哥发什么呆啊！！[l]\n别因为是乡下就小看这里喵！！[l]\n光是后座就已经够晕车了……"],["うぐっ」","呕」"],["「ば、田舎だからとかそんなつもりじゃないっての……[l]\nちょっとぼーっとしてただけだ」","「才、才不是因为乡下什么的……[l]\n只是稍微走神了」"],["「ぼーとはしてんにゃろが！！[l]\nしゃんとしとけばか！！」","「走神个大头鬼！！[l]\n给我打起精神来！！」"],["「まあまあ、\nこの辺りの信号機はまだ古い型で、\nこの晴天下では視えづらいしね。","「好啦好啦、\n这一带的信号灯还是老型号、\n晴天反光下确实不容易看清。"],["とは言え他人を乗せている以上は馬鹿とは言わずまでも、\n次から気をつけてくれ給え」","不过既然载着别人，就算不说笨蛋这种话、\n下次也请务必注意」"],["やっぱり記憶力が多少活性化しても、\n事象の並列処理はまだ難しいようだ。[l]\n素直に謝る。","看来就算记忆力有所提升、\n要并行处理事件还是很难。[l]\n老实道歉。"],["「わ、わるうござんした……」","「非、非常抱歉……」"],["……あんまり素直に聞こえないかこれ。","……听起来好像不够诚恳啊这样。"],["で、運転に集中する。","于是集中精神驾驶。"],["而して、人間完全に無心になるには結構な労力が必要で、\n故に黙っていても勝手に思考は為されていくのであった。","然而人类要完全放空头脑需要相当费力、\n所以即便沉默着思考也会擅自继续。"],["「真言さん頑張って」","「真言同学加油」"],["「は、はい……」","「好、好的……」"],["妙なプレッシャーを背に感じながら、\n安全運転を心掛けつつ思索する。","背负着奇妙的压力、\n边谨慎驾驶边继续思索。"],["僕は数字勘定が苦手なのであんまり意識してなかったが、\nカウントすると、","我因为不擅长数字计算所以一直没太留意，\n但数了数，"],["三春、\n綾目、\n狩屋、","三春、\n绫目、\n狩屋、"],["奇士、\n永久、\nええと、","奇士、\n永久、\n呃、"],["玉梓、\n玖威、\n……うん、把握してるのはこの七つだ、その筈だ。","玉梓、\n玖威、\n……嗯，目前掌握的就这七家，应该没错。"],["道具さんも後ろの二人と合流前の会話で七家と言ってたし。[l]\n――言ってる側から結構面倒な思考をしてしまった。[l]\n取り敢えず直線で何もなさそうだったからだが……","道具小姐之前和后排两人汇合时也提到过七家。[l]\n――说着说着就陷入了相当麻烦的思考。[l]\n总之因为前方看起来是直线道路……"],["まあ、冠してる名称――この場合屋号か何かかも知れないが、\nその数字と実際の戸数が違ってても、\nうーん、そういう事もあるのか、という程度だろうけど……","不过啊，这些冠名――说不定是商号之类的，\n就算实际户数和数字对不上，\n唔，也就觉得'原来还有这种事'的程度吧……"],["この國に於いて、数える魔術は結構あやふやというか、\n数字を冠する事が大事なのであって実際にその数が在るかどうかは、\n若干ルーズな例が多いよね。[l]\n何とか百景とか百物語とか……","在这个国家，涉及数字的魔术都挺含糊的，\n重点在于冠以数字这件事而非实际数量，\n这种宽松的例子还挺多的。[l]\n比如某某百景啦百物语啦……"],["この情報、宮さんから既に聞いてるっけ？[l]\nいや、そんな記憶はない。[l]\n僕の場合は当てにならないが、まあ、\nこれも一つの収穫として後で報告しよう。","这条情报是不是已经从宫小姐那里听说过了？[l]\n不，没这个印象。[l]\n虽然我的记忆靠不住，不过嘛，\n这也算个收获待会儿汇报吧。"],["しかし、ヤソウ？[l]\n何処で聞いたんだっけ？","话说回来，八相？[l]\n是在哪儿听过来着？"],["「……にしてもにゃね、[l]\n選の字もタマ……","「……话说回来喵，[l]\n选律也是玉……"],["や、その、\n何もなかったって……[l]\nだったらその、あんまりこう、\n言うのはきけ――」","啊、那个、\n要是啥都没发生的话……[l]\n那就别这样、那个、\n说出来太危――」"],["「？？？」","「？？？」"],["「にゃ、そ、その……」","「喵、那、那个……」"],["「私の……が第イ…」","「我的……是第一…」"],["「う…うあ」","「呜…呜啊」"],["「ニ…もゴ…もきづけなくても」","「二…五…都没注意到的话」"],["何か後部座席で話してるようだが、\nちょっとエンジン音が煩くて聴き取れない。[l]\nま、毎度の微笑ましい遣り取りだろう。","后排似乎在交谈什么，\n但引擎声太吵听不清楚。[l]\n反、反正又是日常的温馨互动吧。"],["助手席の道具さんは聞こえてるのかいないのか、\n","副驾驶的道具小姐不知是否听见了，\n"],["窘めっぽい言を後ろの二人に向けて発した。","对着后排两人说了句像是劝阻的话。"],["「まあ、彼はもう……身内のようなものだけれどね、[l]\n姫様君はもう少し","「虽说他已经算是……自家人了，[l]\n但姫様君还是该多些"],["深","深"],["慮","谋"],["遠","远"],["謀した上で行動発言した方が\n","虑之后再行动发言比较\n"],["佳いと思うよ。[l]\n怖い人達も居る事だし――」","妥当哦。[l]\n毕竟还有可怕的人在呢――」"],["怖い人達？","可怕的人？"],["まあ物騒だっていうから……という建前で僕がこうして出張って来てる訳なのだが。[l]\nそれとも別口かしらん。[l]\n冬夏のおっかさんも怖いしなあ……","虽说以'局势危险'为由才把我派来出差……[l]\n还是说另有所指？[l]\n冬夏她老妈也挺可怕的……"],["「愉快さが信条の僕とは言え、否、だからこそかな、\n大胆さと小胆さのバランスを考える事が肝要と心得ている訳でね」","「虽说我的信条是追求愉悦，不、正因如此，\n才更要把握好胆大与怯懦的平衡呢」"],["と、今度は僕の方を視て言う。","说着这次把视线转向我。"],["「まあ、何事に於いても需要と供給、本音と建て前、\n親の心子知らず、","「凡事都讲究供需关系、真心与场面话，\n父母心子女不知，"],["製","制"],["作","作"],["者 ","者 "],["使","与使"],["用","用"],["者間の壁、\n温度差にしろ立場上から生じる方向性の違いにしろ、\n双方の均衡をとる中和点を随時探していないといけないのだな。","者间之间的隔阂，\n无论是温度差还是立场导致的方向性差异，\n都必须随时寻找维持双方平衡的中和点啊。"],["そこに関して言うなら、\nその場に留まりたくば走り続ける事、だよ。","若要说这个的话，\n想停留在原地就必须不断奔跑，对吧。"],["いずれにせよこの完全過ぎるが故に\n出来損ないに視えるゲェムが如き\nこのセカイに生まれたからには、","总之正因为这过于完美\n反倒显得像残次品般的GAME\n既然诞生在这个世界里，"],["君にも大いにその人生を謳歌して欲しいものだし、\nその為の援助は惜しまないつもりだよ？」","也希望你能尽情享受人生，\n为此我会不遗余力提供援助哦？"],["「はあ、\nなんと言ったら良いんでしょうか……[l]\n御陰様で今の時点で十二分に波瀾万丈ですし僕は、\nあはははは……」","「哈啊，\n该怎么说才好呢……[l]\n托您的福现阶段已经足够波澜壮阔了，\n啊哈哈哈……」"],["「だろうねえ、\n君はそういう役を振られているようであるから」","「也是呢，\n你似乎被分配到了这样的角色」"],["「あはははは……」","「啊哈哈哈……」"],["乾いた笑いを振りまいてみる。[l]\n後ろの二人は、\n道具さんの言った言葉を気にしたものか少々静かなままだ。","干笑着试图活跃气氛。[l]\n后排的两人，\n或许是在意道具小姐说的话，至今仍保持着沉默。"],["……まるで道具さんの言葉を肯定してるみたいで、[l]\nこちらとしましては少々滅入るんですが。","……简直像在肯定道具小姐的发言，[l]\n从我们这边看来实在有点消沉呢。"],["「早速その援助の一環として遅まきながら補足するとだね、\n選律君というのはまあ、\n姫様君が言ったように西國の方の人間。","「作为援助的一环虽然有点迟，补充说明下，\n选律君嘛，\n就像姫様说的那样是西国人士。"],["知っての通り僕も西國の出なものでね、\n彼女とも密でこそないが、近しい付き合いなのだよ。","如你所知我也是西国出身，\n和她虽不算亲密但交情不错。"],["多少言動は","可能有些言行"],["訝しく視えるかも知れないが、\n――ん？[l]\n姫様君どうしたね？」","会显得可疑——\n――嗯？[l]\n姫様君怎么了？」"],["いきなり道具さんが振り向いた。[l]\n静かと思っていたのは僕だけで、\nどうやら何かしらのリアクションがあったのかも知れない。[l]\nすると、エンジン音に掻き消されそうな声が聞こえた。","道具小姐突然转过头来。[l]\n以为安静的只有我，\n看来她们可能做出了某些反应。[l]\n这时，听见快要被引擎声淹没的细语："],["「話が……」","「话题……」"],["「ああ、長い上に横滑りしてるか。[l]\n御免御免。","「啊，又长又偏离重点了呢。[l]\n抱歉抱歉。"],["さて少年よ。[l]\nそういう訳で君の隣りに居たのは僕等の身内だ。[l]\nそれで」","那么少年。[l]\n总之坐在你旁边的是我们自家人。[l]\n所以」"],["僕に対するフォローという訳ではなかったのね。[l]\nまあそれは、そうね……[l]\nそしてそんな唐突に話振られても。","原来并不是在帮我打圆场啊。[l]\n嘛，确实如此……[l]\n突然被这么问也。"],["「そ、そうすなあ……、[l]\nその後ですか……[l]\nええと」","「那、那个……[l]\n之后的事吗……[l]\n呃」"],["どうするか、\n『あのこと』を言うべきかどうか――","该怎么办，\n是否该说出『那件事』――"],["運転しながらであったり、\nいつも以上に思考を巡らした所為なのか、\nまた例の首が熱くなる感覚がうっすらと、","或许因为正在开车，\n又或是比平时思考得更深入，\n那种颈部发热的感觉又隐隐浮现，"],["そして脳裏に甦る彼奴の言葉が、[l]\n――取り敢えずは他人には言わない方が身の為じゃないか、\nと思うがな――","同时脑海中复苏的那家伙的话语，[l]\n――暂时别告诉别人比较安全，\n我是这么想的――"],["「……ああ、う～～～ん、[l]\nその、姫様ちゃんには悪いんだけど……」","「……啊，唔～～～[l]\n那个、对姫様酱虽然很抱歉……」"],["金縛りにあったとか変なモノをみた事は伏せつつ、\n当たり障りのない感想しか得られなかったと伝えた。","隐瞒了鬼压床和看见怪事的情况，\n只传达了无关痛痒的感想。"],["冬夏の前では結構そういう素振りを見せてるかも知れないが、\nどうにも後部座席の二人とは馬が合わないようだし、\n話は伝わってない……と思うけど。","在冬夏面前可能经常表现出这种态度，\n但和后座两人实在合不来，\n话应该没传达到……大概。"],["「も、勿論感謝はしてるし諸々は秘密にするけどね……」","「当、当然很感谢也会保守秘密的……」"],["「………そう、ですか……」","「………这样、啊……」"],["「ほら、やっぱりにゃんね？[l]\nきーちゃ、何かのまちがいにゃって……」","「你看，果然是这样喵？[l]\n小姬，这一定是搞错了喵……」"],["「まあねえ、敢えて姫様君の肩を持つ発言をさせて貰うなら、\n感得すべきコトは言葉での伝達が不能であるが故に『そう』なのだ。[l]\nきっと彼は解ってるよ」","「嘛~要是非让我站在姫様君这边说话的话，\n该领悟的事正因为无法用语言传达才会『那样』。[l]\n他肯定明白的」"],["――はっ、\nまさか僕の身に起きたコトを見抜かれてる？[l]\nそれとも単に言葉通り、姫様ちゃんへの肩入れ……というか、[l]\n慰めの言なのか。","――哈，\n难道看穿了我身上发生的事？[l]\n还是单纯字面意思的偏袒姫様酱……或者说，[l]\n只是安慰的话呢。"],["一般論としての意見なのか、\nあの式に於いての具体的な話なのかが判然としないので、\n気になるというかこちとらもうドキドキものなんですけど……","分不清这是普遍性的意见，\n还是针对那个仪式的具体发言，\n让人在意到心脏砰砰跳啊……"],["後ろは振り向けないし\nバックミラーには狩屋の顔しか映ってないので\n姫様ちゃんの表情は分からないが、","又不能回头看\n后视镜里只映着狩屋的脸\n所以看不到姫様酱的表情，"],["「……そう、ですよね」","「……是、这样呢」"],["「にゃうあ……」","「喵呜啊……」"],["狩屋のリアクションと併せ考えるに、\nどうやら喜色を浮かべているようだ。[l]\nつまりは、\n……どっちなんだ？","结合狩屋的反应来看，\n她似乎露出了欣喜的神色。[l]\n也就是说，\n……到底是哪种？"],["「解ってます」","「我明白的」"],["「成る程ねぇ……[l]\nそうか君は、」","「原来如此……[l]\n这么说你，」"],["「んにゃ！！」","「喵嗯！！」"],["「……！」","「……！」"],["「……ん？[l]\nああ、御免」","「……嗯？[l]\n啊，抱歉」"],["「？」","「？」"],["何かを言い掛けた道具さんは、\n突如僕に向けて謝る。[l]\n後部座席の二人組も何故か焦っていると言うことは……","正要说什么的道具小姐，\n突然向我道歉。[l]\n后座两人组莫名慌张的样子……"],["「今の路を右だった。[l]\nＵターンからの軌道修正を願うよ」","「刚才该右转的。[l]\n掉头后请修正路线」"],["「ああ、な、何事かと……[l]\n了解しました」","「啊、好、还以为怎么了……[l]\n明白了」"],["や、しかし、道具さんの言葉の続きは何だというんだろう。[l]\nしかし追求するにはあまりに……","不、不过，道具小姐原本想说什么呢。[l]\n但追问的话总觉得……"],["空気的に僕が突っ込むと藪蛇な気配がすごいするし、\n兎に角Ｕターンをする事にする。[l]\n幸い車は殆ど居ないので、あっさり軌道修正は出来た。","气氛上我插嘴会惹麻烦的预感超强烈，\n总之先掉头了。[l]\n幸好几乎没有车辆，轻松完成了路线修正。"],["「そうだ、少年忘れていたよ。[l]\nそうだったそうだった」","「对了少年我忘了。[l]\n是这样是这样」"],["言われるが儘に横道――どうも此処から上り坂で、\n本格的に山道に入るようだったが――に入った途端、\nそう言って彼女が後方を向いた。","顺着她的话拐进岔路――从这里开始上坡，\n似乎正式进入山路时――\n她突然转头向后这么说。"],["え、まさか","诶难道"],["先","是"],["刻の続き……","要接着刚才的话题……"],["「姫様君、其処にあるそれ取ってくれるかね？[l]\nそう、それそれ、どうも有り難う」","「姫様君，能把那边那个递给我吗？[l]\n对对就是那个，非常感谢」"],["道具さんは後ろから何やら包装紙に包まれた箱を受け取って、\nビリビリとそれを破りだした。","道具小姐从后面接过用包装纸包着的盒子，\n哗啦哗啦地拆了起来。"],["横目でちらと視るに、[l]\nどうみてもよくあるお菓子の土産物……だなあ。","用余光瞥见，[l]\n怎么看都是普通的点心伴手礼……吧。"],["「で、これ、つまんで呉れ給え。[l]\n視たとおり土産物で、\n姫様君の所から持って来たんだがね。","「来，这个请用。[l]\n如你所见是土特产，\n从姫様君那里拿来的。"],["すっかり忘れていた、あははは。[l]\nん？","完全忘记了呢，啊哈哈。[l]\n嗯？"],["そんな眼で視なくても、\nちゃんと在夜君に断ってきたから大丈夫だよ姫様君。[l]\n運君には黙って来たがね」","不用那种眼神看我，\n我有好好和在夜君打过招呼哦姫様君。[l]\n不过瞒着运君就是了」"],["やっぱそうか。[l]\n――って、会話の続き思い出したんじゃないんかい。[l]\nこの","果然如此。[l]\n――喂，这不是根本没想起刚才的话题吗。[l]\n这个"],["性は","性"],["刻からどうも思わせぶりで……","从刚才起就总觉得有点意味深长……"],["というかこっちが自意識過剰になってるだけかもだが、\n精神揺さぶられるなあ。[l]\n色んな意味でのダメージが蓄積していく……","或者说可能只是我自己过度敏感了，\n但精神确实被搅得七上八下啊。[l]\n各种意义上的伤害在不断累积……"],["「――ああ、お土産屋もしてたんだっけ。[l]\n僕も結構旅行してるんで、\n視た目も味もちょっと変わってるくらいのだと\nワクワクしますねぇ～」","「――啊对了，你家还兼营土特产店。[l]\n因为我经常旅行，\n所以看到造型和味道都别具一格的\n就会特别兴奋呢～」"],["反動という訳でもないが、\n無駄にノってみる。[l]\n言ってることは事実だけど。","倒也不是为了对抗什么，\n故意表现得格外起劲。[l]\n虽然说的都是事实。"],["杉屋の新メニュー体験と同じく、\n微妙であればあるほど愉しくなるね。[l]\nシモというか卑猥系は個人的にあれだけど……","和体验杉屋的新菜单一样，\n越是微妙就越有趣呢。[l]\n下流或者说猥琐系我个人虽然不太接受……"],["「なんていうんです？」","「这个叫什么来着？」"],["「えーと、これはなんて名前、『ねこバナナ』？[l]\n『ねこまたのしっぽ』か。ほう」","「呃，这个叫什么名字，『猫香蕉』？[l]\n『猫叉尾』啊。嚯」"],["「なんで最初バナナというワードが……[l]\n味がそうなんですか？」","「为什么一开始会冒出香蕉这个词……[l]\n是因为味道像吗？」"],["一つばかり取り出して僕の視界の隅っこに掲げてくれたそれは、","她从中取出一件举到我视野角落的那个东西，"],["乾燥剤＋ビニール包装で、\nカステラ的生地の……\nぱっと視じゃ分かんないが何かしらの造型をした、[l]\n平たく言えば人形焼き的なものだった。","干燥剂+塑料包装里\n装着长崎蛋糕质地的……\n乍看分辨不出但确实做了某种造型的，[l]\n说白了就是类似人形烧的糕点。"],["中に何らかの餡が入ってるかどうかは見た目と名前からでは\n解らないが、\nバナナという単語が出たのがもし味由来ならば、\n中央の方の土産にそういう感じのがあったな……","从外观和名字无法判断\n里面是否包着馅料，\n如果香蕉这个词是源于味道的话，\n中央区土特产里好像有那种类型……"],["姫様ちゃんが説明したそうなオーラを発している気がしたが、\n道具さんが先手を取って話を始めた。","虽然感觉姫様正要解释，\n但道具小姐抢先开了口。"],["「君も『そっち方面』には詳しそうに見受けられるから\n解ってくれると思うが。[l]\n怪異なす","「看你似乎对『那个领域』也很了解的样子\n应该能明白吧。[l]\n像是那种长着怪异"],["尾","分叉尾巴"],["割れしけものの類だね。","的东西呢。"],["単独なのか相互関与して発生したものかまでは、\n残念、興味がないので調べたことは無いがね。","至于究竟是独立存在还是相互影响产生的，\n抱歉，我没兴趣所以没调查过。"],["年経りし猫は尾が二又に別れて云々、\n九尾の狐しかり、そもそも九尾の猫鞭というものもあるが、\n八つの玉を孕ませた犬、は話が違うか。","年深日久的猫尾巴会分叉云云，\n九尾狐也罢，本来还有九尾猫鞭的说法，\n不过怀了八颗玉的狗就另当别论了。"],["あとは七つの頭を持つ獣、エトセトラエトセトラ。[l]\nまあ数える魔法というのは在るからね、\n普通でない状態を説明するに非常に有効な演出ともなるし……","另外还有七头兽，诸如此类。[l]\n毕竟存在着数数的魔法，\n用来描述异常状态是非常有效的表现手法……"],["ああ、猫は九つの魂を持つとか、\n君が興味を持ちそうな外つ國の","啊，像是猫有九条命之类的，\n国外也有一些你可能会感兴趣的"],["諺があるねえ。","这类谚语呢。"],["で、これは此処の土地柄に併せたそう言う系の話に、\nバナナの房を尻尾に見立て、味の方にそれを反映させて創られた\nという経緯かな？[l]\n僕も詳しくは知らないが」","所以这是结合当地风土特色，\n把香蕉串比作尾巴，在味道上也体现这点创作出来的\n大概是这么个由来吧？[l]\n具体我也不太清楚」"],["『そっち』って、土産知識じゃなくて\n妖怪とか『そっち』の方か。[l]\n姫様ちゃんも僕をそういう眼で視てるし、\n寧ろそっちから情報で、かしらん。","『那个』指的该不会是妖怪之类\n而非土特产知识吧。[l]\n姫様看我的眼神也是那种意味，\n说不定情报来源反而是那边呢。"],["「まあ興味深くはありますが、\n結局そのあ、味とか風味の方は……」","「虽然挺有意思的，\n不过说到底那个，味道和风味方面……」"],["「ん？[l]\nああ御免、味に関しては自身で判断して貰うしかないな。[l]\nでは……」","「嗯？[l]\n啊抱歉，味道只能请你自己判断了。[l]\n那么……」"],["運転中に開封するのは少々難儀であるので、\n道具さんが袋を破り、いざ食べさせてくれようとした瞬間、\n後ろから小さな手が伸びてきて手首をがっしと掴んだ。[l]\n僕のではなく、道具さんの。","由于行车时拆包装有点困难，\n当道具小姐撕开袋子准备喂我吃的瞬间，\n一只小手从后方伸来牢牢抓住了手腕。[l]\n不是我的，是道具小姐的。"],["「お、おっと……驚くなぁ。[l]\nどうしたのかね」","「哦、哦呀……别吓到啊。[l]\n怎么回事？」"],["「私が……」","「我来……」"],["「ああ、そういう事か。[l]\n","「啊，是这么回事啊。[l]\n"],["君も随分アグレッシヴになったなあ。[l]\n","你也变得相当主动了呢。[l]\n"],["理由は分からぬでもないが、\n――克杖君が妬いてるようだが」","虽然不明白理由，\n――克杖君好像在吃醋哦」"],["「んぬっ……[l]\n","「唔嗯……[l]\n"],["う、ういのことはほっといてください」","请、请别管我的事」"],["「……克杖もそのうちわかってくれるはずで」","「……克杖迟早会明白的」"],["「おうあ……」","「呜啊……」"],["「ま、まあまあ皆さん穏便に……」","「嘛、嘛嘛大家都冷静点……」"],["こういうのを何とかの鞘当てと呼んでしまってよいものかどうか、\n何にしても僕自身がどうこう出来る問題じゃないんだけども……","这种情况该不该称之为某种争风吃醋，\n总之也不是我能插手的问题就是了……"],["と、僕の座席の肩越しから、\n開封されたその菓子を持つ手が伸びてきた。","这时，从我座位的肩后，\n伸来一只拿着已拆封点心的手。"],["「あ～ん、を……してください……」","「啊～嗯，请……张嘴……」"],["「あ、あ～んて……」","「啊、啊～嗯什么的……」"],["あ、あのぅ、\n普通の言い回しがあるでしょう、姫様ちゃん。[l]\n宮さんにだってされたことないですよ。","那、那个，\n有更普通的说法吧，姫様酱。[l]\n连宫小姐都没对我这样过哦。"],["「んむ、あぃがおぅ、おむ、うむ」","「嗯呣、啊呜、唔、嗯」"],["今までの言動とかお約束として横の御方が冷やかしてくるのかと\n思ったが、狩屋への遠慮なんだか、趣味じゃないのか、\n黙して成り行きを見守るのみだった。[l]\nや、勿論冷やかして欲しかった訳ではない。","本以为旁边这位会像往常那样起哄，\n但不知是顾忌狩屋还是没兴趣，\n只是沉默地旁观着事态发展。[l]\n当、当然也不是希望被起哄。"],["「んー、んむ、うん」","「嗯～、嗯呣、嗯」"],["フォルムの詳細は確認できなかったが、\nちらっと視た限りでは名の通り猫から大きな尻尾が\nバナナみたいに何房か出てる感じで、","虽未能确认具体造型，\n但瞥见确实如品名所述——从猫身伸出香蕉般\n分几簇的大尾巴造型，"],["カステラ風生地にバナナ風味のカスタードを\n","用蛋糕坯包裹香蕉风味卡仕达酱\n"],["餡として包んである、\n","作为馅料，\n"],["所","算"],["謂土産物によくあるやつだった。","是典型的地方特产。"],["「んまいけど…微妙に口の中の水分もってかれるねえ……」","「好吃是好吃…但微妙地会吸走口腔水分呢……」"],["「ああ、御免。[l]\nそっちの方は用意してないんだなあ」","「啊，抱歉。[l]\n那边没准备饮品呢」"],["「克杖」","「克杖」"],["「えあ、にゃ、にゃいよなにも……」","「诶啊、喵、我也没有……」"],["「……すみません」","「……对不起」"],["「や、その、大丈夫だって、\n気にしないで」","「不、那个、真的没关系，\n别在意」"],["「や、悪かったね。[l]\n今日の用事が済んだ後、姫様君の所で食事だっていうのでね、\nあまり水分を取らない方が……","「呀、是我不好。[l]\n因为今天办完事后要去姫様君那里吃饭，\n所以最好别喝太多水……"],["ああ、僕だけなのかも知れないが、水分を過剰に摂ると食欲が減退してしまうから」","啊，可能只是我个人体质，水分摄入过多会降低食欲」"],["「まあ、嵩張りますからねえ胃の中で……[l]\nどっちにしてもその、ホントに大丈夫だから姫様ちゃん」","「毕竟在胃里会胀大……[l]\n总之那个、真的没关系啦姫様酱」"],["「そうですか……では、後程家で……その」","「这样吗……那么，待会儿在家里……那个」"],["「ああ、うん、期待してます……」","「啊，嗯，我很期待……」"],["「ううううういも愉しみにゃよーきーちゃぁ～」","「呜呜呜呜我也超期待喵～小姬～」"],["「お、例の制服かね。[l]\nいいねえ、僕も久しぶりに視るなぁ。[l]\n西の面々にはそういうのは無いからね」","「哦，是那套制服啊。[l]\n真不错，我也好久没见了。[l]\n西边那群人可没这种行头呢」"],["何とか和やかになった雰囲気の中、\n既に山道も舗装が終わり、\n完全な砂利道に入っていた。","在这勉强恢复和睦的气氛中，\n山路已结束铺装路段，\n完全进入了碎石路。"],["左右は完全に杉の人工林といった感じで、家屋は最早見当たらず、\nガードレールも大きなカーブ以外には無くなってきてる。","两侧全是人造杉木林，民居早已消失不见，\n护栏也除了大弯道外基本没有了。"],["ので、前方に注意をしてたつもりだった。","因此本应更注意前方。"],["だぁん！！！","咚！！！"],["「っっ！！！？？？」","「呃！！！？？？」"],["通常走行時には有り得ない音がし、同時に車体に衝撃が走った。","正常行驶时不可能出现的巨响伴随着车身剧烈震动。"],["ワンテンポ遅れたが、","虽然慢了一拍，"],["咄","但还"],["嗟にブレーキを踏む。","是立刻踩下刹车。"],["車はエンストし、瞬時にして異様な静寂に包まれる。","车子熄火了，瞬间被异常的寂静包围。"],["暫く全員が静止して様子を伺う。","所有人静止片刻观察情况。"],["が、[l]\n取り敢えずは何も起こらない。","但[l]\n暂时什么都没发生。"],["「な、何か踏んだ……のか、な？」","「该、该不会是压到……什么了吧？」"],["動物か何かを轢いたわけではないと思う。[l]\n前方は視ていた。[l]\n山道、砂利道には何も……居なかった筈だ。","应该不是碾过动物之类的。[l]\n前方我一直看着。[l]\n山路、砂石路上应该……什么都没有。"],["だから何かを轢いたとすれば横から飛び出てきたか、","所以如果真压到什么，那只能是从侧面突然窜出来的，"],["「パンク……ですかね？[l]\nパンクって経験無いからわかんないけど……」","「爆胎……了吧？[l]\n没爆过胎所以不太确定……」"],["幾ら本人が多少のアレは構わないと言っていたとは言え、\n三春関係者の車をちょっと","虽说当事人表示稍微弄坏点也无所谓，\n但把三春相关人士的车"],["疵","弄伤"],["物にしてしまった\nという状況は","搞坏\n这种状况"],["甚だ","实在"],["芳しくないなあ。[l]\nパンク修理なんて、自分では自転車ですらしたことないし。","不太妙啊。[l]\n补胎什么的，我连自行车都没自己补过。"],["ちょっと降りてみようとすると、道具さんに止められた。","正要下车查看时，被道具小姐拦住。"],["「これはキンキュウを要する事態かも知れないね」","「这可能需要紧急应对」"],["「え？それは」","「诶？那是」"],["「………！」","「………！」"],["何故か後部座席の二人は反応した。[l]\n緊急を要する事態？[l]\nと、道具さんがドアを開けた。","后排两人不知为何有了反应。[l]\n需要紧急应对的状况？[l]\n只见道具小姐打开了车门。"],["「しー……」","「嘘——……」"],["こちらに対し静かにするよう促し彼女自身が外に出て、\n車体の下から上から確認していると、","她示意我们保持安静，自己下车后\n绕着车体上下检查，"],["「ほう。[l]\n上からか」","「嚯。[l]\n是从上面」"],["ぐるるるるるるるるるうっるるうるるるあうあああああ！！！！！！！！[l]\n","咕呜呜呜呜呜呜呜嗷嗷嗷啊啊啊啊！！！！！！！！[l]\n"],["！！！！！！！！","！！！！！！！！"],["おと、いや、[l]\nこえ！？","声、不对，[l]\n声音！？"],["「……っ？！[l]\n道具さん？！」","「……？！[l]\n道具小姐！？」"],["大音響に聞こえたが、\n","听起来像是巨响，\n"],["閑か＋びびってたからかも知れない。[l]\n或いはこの","也可能是因为太安静＋被吓到。[l]\n要么就是"],["性が単に動じない性格なのか、\n道具さんは今のコエにもあまり反応を示さないまま、周囲を視回す。","这人天生冷静的性格，\n道具小姐对刚才的声音没什么反应，继续环视四周。"],["僕はと言えば、\n全身総毛立ち、動悸が速まるのが解る。[l]\n一瞬思考停止したが、\n慌てて、それでも道具さんを呼ぶ。","至于我，\n能感觉到浑身汗毛倒竖，心跳加速。[l]\n虽然大脑空白了一瞬，\n还是慌忙呼唤道具小姐。"],["「――は、早く中に戻って下さい！！」","「――请、请快回到车里！！」"],["しかし彼女は表情を変えずに……[l]\n寧ろうっすらと笑みを浮かべているようにも視える顔で、\nそのまま周囲を視渡し続ける。","但她面不改色……[l]\n甚至隐约带着微笑的表情，\n继续扫视周围。"],["いくら愉快イヴェント大好きったって、\nこの状況不明で、身の危険を感じ得る場合は別……じゃないのか？[l]\nこの人は。","就算再喜欢刺激事件，\n这种不明状况下感到人身危险时总该另当别论……不是吗？[l]\n这个人。"],["「………。[l]\n静かに。[l]\n僕なら心配要らないよ」","「………。[l]\n安静。[l]\n我没事的」"],["やはり単に、極度に冷静な","果然只是极度冷静的"],["性質なのか。[l]\nにしても、\nこ、こんな事がつい最近もあったような……","性格使然。[l]\n即便如此，\n这、这种事好像最近也发生过……"],["――そう、三春の蔵の中だ。[l]\nしかし、あの時のとは違う、違うと思う。","――对，就在三春的仓库里。[l]\n但和那时不同，应该不同。"],["前のは盛りのついた猫みたいな、\nヒトの声のようではあっても獣じみた感じだったけど、\n今のは――","上次像是发情期的猫那种，\n虽像人声但更接近野兽的感觉，\n这次――"],["「どうやら生物、大きめで、\n――『けもの』の","「似乎是生物，体型较大，\n――像『怪物』"],["類のようだよ、\nお二人さん」","之类的东西呢，\n两位」"],["と、言った。[l]\n視線は僕を通り越している。","这么说道。[l]\n视线穿过了我的身体。"],["つまり、\n二人とは姫様ちゃんと狩屋？[l]\n何故彼女達だけに。","也就是说，\n两位是指姫様和狩屋？[l]\n为什么只有她们。"],["「真言さん、其処にいて」","「真言先生，请待在原地」"],["「えあ、きーちゃ？[l]\nまさか」","「诶啊、小姬？[l]\n不会吧」"],["「様子を視てくる。[l]\n来て克杖」","「我去查看情况。[l]\n跟我来克杖」"],["「いっ！？[l]\n","「咦！？[l]\n"],["幾らにゃんでもこの状況で」","就算是我这种菜鸟也看得出形势不妙」"],["若しかすると若しかするかな。[l]\nいや、何とも言えないか。[l]\nまあ用心に超したことはない、\nいずれキンキュウ事態のようだね」","说不定说不定呢。[l]\n不、或许不该妄下定论。[l]\n总之小心驶得万年船，\n看起来终究是紧急事态呢」"],["「そんな、――兄ぃはどうするん」","「怎么会、――哥哥怎么办」"],["「真言さんは絶対に車から出ないで。[l]\n","「真言先生绝对不要下车。[l]\n"],["道具さん、真言さんをお願いします」","道具小姐，拜托你照顾真言先生」"],["と、道具さんの方を視て言う。","说着看向道具小姐。"],["返事を差し挟む間もなく彼女達の話は進む。[l]\nな、何が起きた、否、起きてる？[l]\nそして彼女達のその、\n想定されていた事態に対処するかのような態度は何だ？","不等插话她们的对话就继续推进。[l]\n发、发生了什么，不、正在发生什么？[l]\n而且她们那种，\n仿佛早有预案的应对态度是怎么回事？"],["姫様ちゃんのその、\n普段からは想像の出来ない、冷たいが確たる意志の","姫様那双眼、\n藏着与平日判若两人的、冰冷而坚定的"],["隠った眼が、","的意志，"],["僕をより一層、[l]\n","让我更加[l]\n"],["どきりとさせた。","心头一颤。"]],"context":[["SC_M_026.ks/index/1/text"],["SC_M_026.ks/index/3/text"],["SC_M_026.ks/index/5/text"],["SC_M_026.ks/index/7/text"],["SC_M_026.ks/index/9/text"],["SC_M_026.ks/index/11/text"],["SC_M_026.ks/index/13/text"],["SC_M_026.ks/index/15/text"],["SC_M_026.ks/index/17/text"],["SC_M_026.ks/index/19/text"],["SC_M_026.ks/index/21/text"],["SC_M_026.ks/index/23/text"],["SC_M_026.ks/index/25/text"],["SC_M_026.ks/index/27/text"],["SC_M_026.ks/index/29/text"],["SC_M_026.ks/index/31/text"],["SC_M_026.ks/index/33/text"],["SC_M_026.ks/index/35/text"],["SC_M_026.ks/index/37/text"],["SC_M_026.ks/index/39/text"],["SC_M_026.ks/index/41/text"],["SC_M_026.ks/index/43/text"],["SC_M_026.ks/index/45/text"],["SC_M_026.ks/index/47/text"],["SC_M_026.ks/index/49/text"],["SC_M_026.ks/index/51/text"],["SC_M_026.ks/index/53/text"],["SC_M_026.ks/index/55/text"],["SC_M_026.ks/index/57/text"],["SC_M_026.ks/index/59/text"],["SC_M_026.ks/index/61/text"],["SC_M_026.ks/index/63/text"],["SC_M_026.ks/index/65/text"],["SC_M_026.ks/index/67/text"],["SC_M_026.ks/index/69/text"],["SC_M_026.ks/index/71/text"],["SC_M_026.ks/index/73/text"],["SC_M_026.ks/index/75/text"],["SC_M_026.ks/index/77/text"],["SC_M_026.ks/index/79/text"],["SC_M_026.ks/index/81/text"],["SC_M_026.ks/index/83/text"],["SC_M_026.ks/index/85/text"],["SC_M_026.ks/index/87/text"],["SC_M_026.ks/index/89/text"],["SC_M_026.ks/index/91/text"],["SC_M_026.ks/index/93/text"],["SC_M_026.ks/index/95/text"],["SC_M_026.ks/index/97/text"],["SC_M_026.ks/index/99/text"],["SC_M_026.ks/index/101/text"],["SC_M_026.ks/index/103/text"],["SC_M_026.ks/index/105/text"],["SC_M_026.ks/index/107/text"],["SC_M_026.ks/index/109/text"],["SC_M_026.ks/index/111/text"],["SC_M_026.ks/index/113/text"],["SC_M_026.ks/index/115/text","SC_M_026.ks/index/1134/text","SC_M_026.ks/index/1351/text"],["SC_M_026.ks/index/117/text"],["SC_M_026.ks/index/119/text"],["SC_M_026.ks/index/121/text"],["SC_M_026.ks/index/123/text"],["SC_M_026.ks/index/125/text"],["SC_M_026.ks/index/127/text"],["SC_M_026.ks/index/129/text"],["SC_M_026.ks/index/131/text"],["SC_M_026.ks/index/133/text"],["SC_M_026.ks/index/135/text"],["SC_M_026.ks/index/137/text"],["SC_M_026.ks/index/139/text"],["SC_M_026.ks/index/141/text"],["SC_M_026.ks/index/143/text"],["SC_M_026.ks/index/145/text"],["SC_M_026.ks/index/147/text"],["SC_M_026.ks/index/149/text"],["SC_M_026.ks/index/151/text"],["SC_M_026.ks/index/153/text"],["SC_M_026.ks/index/155/text"],["SC_M_026.ks/index/157/text"],["SC_M_026.ks/index/159/text"],["SC_M_026.ks/index/161/text"],["SC_M_026.ks/index/163/text"],["SC_M_026.ks/index/165/text"],["SC_M_026.ks/index/167/text"],["SC_M_026.ks/index/169/text"],["SC_M_026.ks/index/171/text"],["SC_M_026.ks/index/173/text"],["SC_M_026.ks/index/175/text"],["SC_M_026.ks/index/177/text"],["SC_M_026.ks/index/179/text"],["SC_M_026.ks/index/181/text"],["SC_M_026.ks/index/183/text"],["SC_M_026.ks/index/185/text"],["SC_M_026.ks/index/187/text"],["SC_M_026.ks/index/189/text"],["SC_M_026.ks/index/191/text","SC_M_026.ks/index/389/text","SC_M_026.ks/index/413/text"],["SC_M_026.ks/index/193/text"],["SC_M_026.ks/index/195/text"],["SC_M_026.ks/index/197/text"],["SC_M_026.ks/index/199/text"],["SC_M_026.ks/index/201/text"],["SC_M_026.ks/index/203/text"],["SC_M_026.ks/index/205/text"],["SC_M_026.ks/index/207/text"],["SC_M_026.ks/index/209/text"],["SC_M_026.ks/index/211/text"],["SC_M_026.ks/index/213/text"],["SC_M_026.ks/index/215/text"],["SC_M_026.ks/index/217/text"],["SC_M_026.ks/index/219/text"],["SC_M_026.ks/index/221/text"],["SC_M_026.ks/index/223/text"],["SC_M_026.ks/index/225/text"],["SC_M_026.ks/index/227/text"],["SC_M_026.ks/index/229/text"],["SC_M_026.ks/index/231/text"],["SC_M_026.ks/index/233/text"],["SC_M_026.ks/index/235/text"],["SC_M_026.ks/index/237/text"],["SC_M_026.ks/index/239/text"],["SC_M_026.ks/index/241/text"],["SC_M_026.ks/index/243/text"],["SC_M_026.ks/index/245/text"],["SC_M_026.ks/index/247/text"],["SC_M_026.ks/index/249/text"],["SC_M_026.ks/index/251/text"],["SC_M_026.ks/index/253/text"],["SC_M_026.ks/index/255/text"],["SC_M_026.ks/index/257/text"],["SC_M_026.ks/index/259/text"],["SC_M_026.ks/index/261/text"],["SC_M_026.ks/index/263/text"],["SC_M_026.ks/index/265/text","SC_M_026.ks/index/363/text","SC_M_026.ks/index/860/text","SC_M_026.ks/index/1392/text"],["SC_M_026.ks/index/267/text"],["SC_M_026.ks