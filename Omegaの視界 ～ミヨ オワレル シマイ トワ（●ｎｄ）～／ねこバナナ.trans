ks/index/143/text"],["SC_E_017.ks/index/145/text"],["SC_E_017.ks/index/147/text"],["SC_E_017.ks/index/149/text"],["SC_E_017.ks/index/157/text"],["SC_E_017.ks/index/159/text"],["SC_E_017.ks/index/169/text"],["SC_E_017.ks/index/171/text"],["SC_E_017.ks/index/173/text"],["SC_E_017.ks/index/175/text"],["SC_E_017.ks/index/177/text"],["SC_E_017.ks/index/179/text"],["SC_E_017.ks/index/181/text"],["SC_E_017.ks/index/183/text"],["SC_E_017.ks/index/185/text"],["SC_E_017.ks/index/187/text"]],"tags":[],"parameters":[[{"start":107,"end":187}],[{"start":218,"end":232}],[{"start":240,"end":254}],[{"start":264,"end":265}],[{"start":275,"end":311}],[{"start":324,"end":325}],[{"start":334,"end":369}],[{"start":377,"end":496}],[{"start":504,"end":559}],[{"start":569,"end":570}],[{"start":580,"end":632}],[{"start":640,"end":784}],[{"start":792,"end":806}],[{"start":815,"end":1024}],[{"start":1039,"end":1105}],[{"start":1113,"end":1322}],[{"start":1330,"end":1412}],[{"start":1420,"end":1506}],[{"start":1514,"end":1630}],[{"start":1638,"end":1792}],[{"start":1800,"end":1951}],[{"start":1959,"end":2070}],[{"start":2078,"end":2191}],[{"start":2199,"end":2251}],[{"start":2259,"end":2308}],[{"start":2316,"end":2425}],[{"start":2433,"end":2439}],[{"start":2449,"end":2463}],[{"start":2471,"end":2492}],[{"start":2500,"end":2670}],[{"start":2678,"end":2703}],[{"start":2711,"end":2782}],[{"start":2790,"end":2795}],[{"start":2803,"end":2945}],[{"start":2953,"end":2954}],[{"start":2964,"end":2965}],[{"start":2974,"end":2980}],[{"start":2988,"end":3113}],[{"start":3121,"end":3257}],[{"start":3265,"end":3295}],[{"start":3303,"end":3430}],[{"start":3438,"end":3484}],[{"start":3492,"end":3589}],[{"start":3597,"end":3604}],[{"start":3612,"end":3710}],[{"start":3718,"end":3730}],[{"start":3738,"end":3833}],[{"start":3841,"end":3932}],[{"start":3940,"end":4071}],[{"start":4077,"end":4096},{"start":4747,"end":4766},{"start":6046,"end":6065},{"start":6171,"end":6190},{"start":6196,"end":6215}],[{"start":4104,"end":4224}],[{"start":4233,"end":4243}],[{"start":4251,"end":4392}],[{"start":4400,"end":4514}],[{"start":4522,"end":4713}],[{"start":4719,"end":4741},{"start":6018,"end":6040},{"start":6143,"end":6165}],[{"start":4772,"end":4789},{"start":6071,"end":6088},{"start":6221,"end":6238}],[{"start":4797,"end":4861}],[{"start":4871,"end":4949}],[{"start":4957,"end":5011}],[{"start":5019,"end":5116}],[{"start":5124,"end":5220}],[{"start":5228,"end":5267}],[{"start":5275,"end":5296}],[{"start":5304,"end":5333}],[{"start":5342,"end":5343}],[{"start":5353,"end":5371}],[{"start":5379,"end":5527}],[{"start":5535,"end":5542}],[{"start":5550,"end":5675}],[{"start":5683,"end":5812}],[{"start":5820,"end":5869}],[{"start":5877,"end":6012}],[{"start":6096,"end":6104}],[{"start":6112,"end":6137}],[{"start":6246,"end":6327}],[{"start":6335,"end":6496}],[{"start":6504,"end":6558}],[{"start":6566,"end":6643}],[{"start":6649,"end":6673}],[{"start":6681,"end":6826}],[{"start":6855,"end":6914}],[{"start":6922,"end":6928}],[{"start":6936,"end":6975}],[{"start":6981,"end":7013}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_017.ks","basename":"SC_E_017.ks","indexIds":{"@r@r@rＷＣＬ所蔵、単純資料類\nインストールウィザード準備中である●●年前の会話録\n一部暗号化未解読\n不鮮明部位多々有り":0,"「久しぶり……になるかな？」":1,"「………[l]\n直接":2,"相":3,"見えるのは初かも知れぬが。[l]\nいずれ今は只のヒトだ。[l]\n":4,"其":5,"方が白のミルハだな？[l]\nあの異端者の●にして●たる最強の」":6,"「……君はヒト前でもそんな喋りしてるのかい？[l]\n『只のヒト』はその肉年齢でそんな口調で会話したりしないよ。[l]\n寝過ぎたようだね。[l]\n言語もこの國に帰化したようだけど。[l]\nそれはそれで好都合」":7,"「さて、何の用だ。[l]\nあの異端者の同調者が其処彼処に視えるのは知っている。[l]\nこの肉を":8,"悉":9,"皆まともに動かせるまで、\n少々年月を要したが、その間我の周りには\n紙封の遣い手ばかりが」":10,"「其処彼処も何も、\n君がかつて奪った骸はそもそも我々の眷属だよ。[l]\n当然今もその肉の元の属性に従って貰って、\n子孫一族我々の仲間。[l]\n君は私達の勢力圏の真っ只中に居るんだからね。[l]\n庇護されてると言ってもいい。[l]\n当然だよ。":11,"さて。[l]\n理論上":12,"Ｄのように代々継承されるのはＹ経由なのに、\n君はどうしたことかその辺りで重大なバグ、或いはエラーが起きたようでね。[l]\n君の存在は消えては居ないが、顕在化するのはシステム上無理だった。[l]\n殆ど修復は不可能だったんだよ。[l]\nソフトウェアというよりもハードウェアの問題で、\nかといってフォーマットしては意味がない。[l]\n全体を丸ごとムーヴは出来るようだったが、\n":13,"走らせる事はどうしても出来ない。[l]\nまあ、手を加えてどうにか出来る程には、\n誰もシステムを解っていた訳じゃない。":14,"しかしそれ故に、\n取り敢えずは保留として君を内在させたまま代を重ねる事にしたんだ。[l]\nいずれ解決出来る方策が見つかるかも知れなかったし、\n黒のイツワの１０を失うなんてあまりに惜しかったしね。[l]\nだから随分と待ったよ。[l]\n君が顕れるまでには相当の年月が掛かった。[l]\nと言うより半ば諦めていた……と言ったら君の肉の方の血筋に[l]\n申し訳ないけどね。":15,"結局我々は待つ事以外してなかったけど、\nこうやって今、\n君と私は会話が出来ているという訳。[l]\n何とか彼女達の役目も果たされたという訳だ」":16,"「『ばぐ』とは何だ？[l]\n何を言っているのか判りづらいな其方は。[l]\n話も長い。[l]\nまあ良いだろう。[l]\n我の片割れはどうした？」":17,"「んむ？[l]\n君が眠りにつくより前に行方知れずになったままだよ。[l]\nでも、案外近くにいるかもね……何しろ君は、[l]\n──否、その話は後回し、というより確信に迫る話なんだな。[l]\n追々話すよ。":18,"さて、\n元より敵同士だったのはもう……[l]\n遙か過去の事だし、\nそもそも私達は一つだろう。[l]\n争う理由は最早ない──と言っても良いかな。[l]\nそれよりも、\n今の君じゃ君の『元の肉』を関知するには厳しいかい？[l]\n『今の肉』も魔眼質なのかな？」":19,"「先に言った通りだ、\nまともに動かせるようになったのはつい近頃だからな。[l]\nそれどころではなかったのだ。[l]\n我の肉……既に分かたれた挙げ句にカミにホウじられたのだぞ。[l]\n其方等が持って行ったのだろう。[l]\nだからこそ我を十全の名で呼ばぬのだろうが」":20,"「まあ、十全だろうと十相だろうと名前なんていいじゃないか。[l]\n範疇錯誤というやつ？[l]\n而してイツワと呼ぶにはあまりに今の君は足りなすぎてるからね。[l]\nかといって正確に呼ぶのも面倒だし……":21,"というかね、君は誤解してるよ。[l]\n我々は君の肉、そう、９枚を回収してない。[l]\nその辺りの事情は徐々に説明する。[l]\nで、\nその十全への再統合を手伝おう、\nという話なんだけどね」":22,"「──只ではあるまい？[l]\n今更虫のよい話だからな。[l]\n何が条件なのか言うてみよ」":23,"「私達の──兄様の力になってほしい、\n平たく言えば仲間にならないか、ということなんだけど」":24,"「仲間？[l]\n軍門に降れというのか。[l]\nLu=Leと未だに争っておるのか？[l]\n八人や『ＷＥ』の殆どは其方等に制圧されたのだろうが。[l]\n今更我の力を要するとは如何なる相手か」":25,"「一番面倒な":26,"女が残ってるんだねぇこれが」":27,"「……其方より面倒な女が居るとは思えぬが」":28,"「失礼な事を言うね。[l]\nLu=Leの殆どは確かにもういないけど、\n──覚えてるかな？[l]\n『八人姉妹』の長姉ミリアム・シュブ、その他数名、\nツェロルと共に未だ行方不明……違うか。[l]\n正確には、\n関係者とその居場所は掌握してる。[l]\nミリアム本人だけは未だに行方を掴めない」":29,"「『ＷＥ』の第一位にしてかの猫ベロアが健在なのか」":30,"「まあそんなところかな。[l]\nフェンリロスはまだ使えないし。[l]\n実働してもベロアの結界を突破出来るかどうかは分からない」":31,"「それで」":32,"「ま、実際ミリアムは後回しでも一向に構わないんだよね。[l]\nで、そのミリアムの関係者というのが、\n君の断片を遣ってる連中。[l]\nそう、我々じゃなくて其奴等が君の残りを持っていった張本人だよ。[l]\nカミ自体はミリアムじゃなくて其奴等の管理下だから」":33,"「":34,"何":35,"処に居るか」":36,"「『此処』さ。[l]\n君の子孫が延々と根付いた『此処』に、\n顔付き合わせて永い間ずっとね。[l]\n無論彼女達は知らない、と思うよ。[l]\n自分達は他とは違うという証拠を持ち得た彼女達は、\n……ま、それはいいや。":37,"ミリアムは用心深いから結構な縛りを与えてたようだけど、\nこちらも監視を兼ねて、君の奪ったあの『魔眼の刺し手』の身体の子孫、\nつまり今の君の属する一族『●●』が君を産むまで、\n準備をしながら待っていた。[l]\n此処はまさに我々の箱庭という訳」":38,"「それは御苦労な事だな。[l]\n９枚全てが此処に？」":39,"「否、PHASE:9だけはまだ見つかっておらず、\n彼女達の管理下にもない。[l]\nただ、それこそフェンリロスが稼働すれば見つかるとは思うよ。[l]\n今や彼女達は９は探すつもりはないようだし。[l]\n昔はどうか知らないけど」":40,"「詰まるところ我は統合されて、\n其方等の傘下に入りミリアム等を駆逐すればよいのか？」":41,"「まあそうだねぇ……[l]\n実際のところ兄様の本心は私にも分からないけど──\n取り敢えず興味があるのは、\n君が『呼び水たる月の雫』の資質なのかどうか、\nってこと」":42,"「月の雫だ？」":43,"「本来ならば君が再臨する可能性は恐ろしく低かったのは、\n否、ほぼ不可能だった筈なのは、\n先刻言った通り。[l]\n起きる確率が限りなく零に近い事象が起きたとき、そこには──」":44,"「始祖達の時のようにか」":45,"「そういう事。[l]\n我等ねこが降ろされた時のように、\n君が再び受肉してこの世に顕現したとは、\nまさに、\n『呼び水たる月の雫』の再臨ではないかと兄様は言った。":46,"とは言え『雫』は後代の者達が過去を振り返ってそう\n評するものだし、\n渦中の者が判ずる事が出来るものかどうかは……[l]\n兄様にも何か考えがあるようだけどぉ──":47,"ま、例えそうでなかろうと、\n君が私達の傘下に入れば\nとても納まりが好いと思うんだよ。[l]\n白と黒の（不明瞭）、\n本来対のパラミアキス、メイルとフィーメイルの受肉せし姿。[l]\n今なら君も、ヒトの肉を持つし丁度良いだろう」":48,"@r@r@r（不鮮明部位）":49,"「んむ、\n出来うるだけ穏便にしたいんだけど。[l]\nもし素直に願いを聞いてくれないならば、\n仕方ないね。[l]\nこちらにはペイルホワイトがあるし、\nいざとなればテトライの遣い手たるEnderナンバーも":50,"活きの良いのが居る。":51,"強制改宗にしろ完全に紙封するにしろ、\n悪いけど我等の管理下からは逃れられないよ。[l]\nそう言う意味で選択肢は無いに等しいんだけど……[l]\nどう考えても君には、\n断るメリットは無いと思うなあ。[l]\nだからこれは善意の交渉と思って欲しいね」":52,"「我とて馬鹿ではない。[l]\n今更固執する何があるでもなし、\n敢えていうならばその『本来の肉』を我が手に戻す事が意義。[l]\nそれを取り戻させるのが其方等であろうと、\n最早Lu=Leは（不明瞭）」":53,"「大体、君は生まれ出る事が出来たとは言え、\n本来ならば有り得ないと言わざるを得ない極めて希有な状態なんだ\nからね。[l]\nPHASE:10をその肉からまた移動させれるかどうかは甚だ不安だ。[l]\nそれに、今更以前の身に戻ってもしょうがないだろ？[l]\nま、ARCHIVEに保存はしておいてあげるよ。[l]\nいずれツェロルが（不明瞭）」":54,"@r@r@r（暫く不鮮明のまま）":55,"@r@r@r（再可聴）":56,"「まあ良かろう。[l]\n其方の言に従おうか。[l]\n流れのままに身を委ねる、それで佳い。[l]\nこの肉の":57,"質でもある。[l]\nしかし充電は必要だ。[l]\n起こすのは９が見つかってからにするがいい。[l]\n未だ見つかっていないのだったな？」":58,"「その通り。[l]\n君が顕在化するまでは、\n９の探索は優先度が低かったと言うのもあるけど……":59,"今フェンリロスを使えるメンバーは\n一人被親和候補の女子が居るけど、\n本契約及び更新作業には時がかかる。[l]\nああ、その候補者が生まれたのも、\nつい最近だからね。":60,"ほら、どうしても『月の雫』のバイアスを考えてしまうのさ。[l]\nいずれ本格的に探索を開始するのは数年先になるよ。[l]\nそれまでは精々愉しみに、\n箱庭を創っておこうか」":61,"「其方等の悪い癖だな。[l]\n愉悦を信条にしていてはいずれ道を過つぞ」":62,"「んむー？[l]\n寧ろ逆でしょお」":63,"「個としてはそれで善いかも知れぬが……[l]\n──":64,"斯":65,"様な会話は無意味だな。止すとしよう」":66,"「話は済みましたかね？[l]\nでは細工が要るのですよ、\n貴方が奴等のscanに引っ掛からないように色々と。[l]\nfirewallか、人為的且つ目覚まし付きのtorporか……[l]\n加えて仕込みもしなければならない、\nその日が来た時に即戦力になれるよう」":67,"「すきゃん？」":68,"「十全でいうPHASE:5に特化した諸々の……[l]\nまあそれはどうでもいいんですが。[l]\n彼女等にしてみれば保険と防衛と維持強化を兼ねた\nritesとでも言いましょうかね。[l]\n貴方が休眠中も延々としてましたよ」":69,"「まあ、そこは今の君の肉の母親の言うとおり、\n暫くは此処から離れて暮らして貰う事で当面回避は出来るだろう。[l]\nと言うより、君は現状、一時的に本家に逗留してるという形だしね。[l]\nいずれ仕込みが終わったら向こうに戻って貰うでしょ」":70,"「さすればどれが（不明瞭）[l]\n我自身か？[l]\n我とは別に仮初めの（不明瞭）」":71,"「取り敢えず今までの記憶が無いままproxyを新規で立てても\n不自然だろうから、現状までの（不明瞭）を継続しつつ、[l]\n@r（不鮮明部位）[l]\n@r君の相対したあの刺し手のテトライ零号をpromptとして、[l]\n（不明瞭）」":72,"「ドレミリア？」":73,"「？[l]\nああ、\nいや、あれは」":74,"「じゃあ、あとは任せた。[l]\n私もしばらく付き合うけど、\nあんまり此処に居るのも良くないし。[l]\nある程度の目処が立ったらお先するね」":75,"「私も残りのCovenに諸々通達しなければならないので。[l]\n人員としてどれを駆り出すか……[l]\n001:GMナンバーたるあの方がどの段階で介入──いえ、\nご助力？[l]\n貴女にとってはどちらか分かりませんがねワタシには。[l]\n兎に角動かれるのかどうかは戻ってから確認します」":76,"「あの女が知らない訳ないからもう動いてるでしょ。[l]\n用があれば言ってくるだろうしスルーしとけば」":77,"「その辺りはそつなく進めておきますが。[l]\nでは、ワタシも行きますよ。[l]\nご自愛を、白のミルハ、\nOmegaの瞳の祝福あれ」":78,"@r@r@r（数分の間の後、独り言）":79,"「さて、メモしておかないと忘れそうだなあ。[l]\nまああの女が事細かく記録はしてるんだろうけど……[l]\nま、多少は自分でも忘れといた方がぁ、\nいざ本番の時に新鮮で面白いかもっ。[l]\n久々の大きな娯楽だから愉しまねば。[l]\nうひひ、期待してるよ」":80,"@r@r@r（更に十数分のブランクの後、\n最後に記録されていたもの、\n男女二人の幼児の声）":81,"「だぁれ？」":82,"「ぼく？[l]\nぼくは、[l]\nいー、[l]\nいー、」":83,"@r@r@r@r@r@r（ファイル終了）":84},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_017.ks","relPath":"/data/scenario/SC_E_017.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":85,"length":85,"percent":100},"cellInfo":[[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"t":"HU","v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[83,3],"note":"完成"},"/data/scenario/SC_E_018.ks":{"data":[["四番目のＤへ[l]\n@r注：邦訳途上にて、表記表現に不明、曖昧な点多々あり\n　　精細を望むならば原書を参照のこと","致第四位的D[l]\n@r注：日译过程中存在多处表述不明及暧昧之处\n　　欲知详情请参阅原典"],["@r　　Ｅ凹：Ｙ誕生にて、\n　　オウのゲェム（Game\"O\"）の為に用意\n　　\"R\"or\"W\"の振り分け、\n　　次世代upgrade（※例のLinkableForm）のテスト、\n　　青写真の為に資料として\n@r　　真贋不明点は魔眼者の質を以て感得するのが最良、不立文字\n@r　　prot-eins『●●』は黙殺すること\n@r　　Re-combinant_は続行せよ\n@r　　箏及び音の管理も手抜かること無きよう","@r　　E凹：于Y诞生时，\n　　为了王的游戏（Game\"O\"）而准备\n　　\"R\"or\"W\"的分配，\n　　次世代upgrade（※例如LinkableForm）的测试，\n　　作为蓝图的资料\n@r　　真伪难辨处宜以魔眼者资质感知，不立文字\n@r　　prot-eins『●●』应予以无视\n@r　　Re-combinant_须继续推进\n@r　　琴及音律管理亦不可懈怠"],["--------\n我等が始祖アリスの、魔にして真たる眼の加護あらんことを、\nOmegaの瞳の祝福あれ。[l]\n\n始祖は猫を愛し、\n四海を視界に納めんが為、\n","--------\n愿我等蒙受始祖爱丽丝那既是魔眼亦是真眼的加护，\n愿Omega之瞳赐福。[l]\n\n始祖钟爱猫，\n为将四海纳入视野，\n"],["己が意志を為す為の、\n最良の","为践行己志，\n欲求得"],["同","最"],["伴","优秀的"],["者を得ようとなさった。","同伴。"],["@r始祖アリスには答えが視えていたが、\n凡俗は正に盲目の者かの如く。[l]\n\nアリスとその眷属らは。[l]\n視、感得することが出来る者、\n紅き灯火ともる箱持ち、\n","@r始祖爱丽丝早已洞悉答案，\n凡俗之辈却如盲人般懵懂。[l]\n\n爱丽丝与其眷属们。[l]\n能窥见、感知到真相之人，\n手持猩红灯火之箱者，\n"],["途 ","未"],["過 たず、\n","曾途径，\n"],["言の","纵使"],["葉無くとも揺らぐことなき資。[l]\n喰うを式となし、","无言亦不动摇之资质。[l]\n以吞噬为仪式，"],["現を渡る最強のちから。","穿梭于现世的最强之力。"],["@rその。[l]\n\n始祖の視界に映るものに、\nミを与え","@r那个。[l]\n\n为始祖的视野中映现之物，\n给予mi"],["可","使"],["触のものとしようと試みた。[l]\nそのミは、\nかの愛し猫だったのだろうか。","其变为可触碰之物。[l]\n那个mi，\n或许就是那只爱猫吧。"],["@rつまりは後代に『魔女の猫』と呼び習わされるもの、[l]\n始祖曰く、\nこの世に於いて、欲望に忠実でありながら、\n最も美しく優雅、\n月の如き満ち欠ける瞳を持つもの、[l]\n我等の愛するに相応しい動物、\nねこ。","@r亦即后世所称『魔女之猫』，[l]\n始祖有言，\n此世之物虽忠于欲望，\n却最美最优雅，\n拥有如月般盈亏变幻的瞳孔，[l]\n配得上我等宠爱的动物，\n猫。"],["@rハコの中には――[l]\n\n●●か奇跡か――ひとくみの完璧なねこ。[l]\nパラミアキス＝メイル、\nパラミアキス＝フィーメイル。","@r箱中乃是――[l]\n\n●●或奇迹――一组完美的猫。[l]\n帕拉米亚基斯＝雄性，\n帕拉米亚基斯＝雌性。"],["@rアリスはまずパラミアキスメイルを喚び降ろした。[l]\n\n月の雫は其れを為し得るための呼び水。[l]\n\n後代になりそう呼称される事となる、\n触媒にして渦の中心。[l]\n故に『だれがそれなのか』は","@r爱丽丝首先召来了帕拉米亚基斯雄性。[l]\n\n月之雫正是为此准备的引子。[l]\n\n后世如此称呼的，\n既是触媒亦是漩涡中心。[l]\n故而『究竟是谁』"],["今","至"],["以て不明。","今不明。"],["@r初めにパラミアキス＝メイルが応じた。[l]\n\nそれはアリスの飼猫に受肉す。[l]\n即ち、ナナムシル（Non=Amuse=Ill？或いは七蝕龍か）org、\n最初のねこ。","@r最初回应的是帕拉米亚基斯＝雄性。[l]\n\n它附身于爱丽丝的宠物猫。[l]\n亦即，纳纳姆希尔（Non=Amuse=Ill？或是七蚀龙）org，\n最初的猫。"],["@rアリスと契り、\n始祖の眷属に受け継がれる同伴者となったそのねこ、\nナナムシルは、\n--------","@r与爱丽丝缔结契约，\n成为始祖眷属一脉相承的同行者之猫，\n纳纳姆希尔，\n--------"],["@r注：以下走り書き、未整理、真偽は度外視で構わない","@r注：以下为潦草记录，未整理，真伪不必深究"],["@r@r○最初のねこナナムシルorg\n　ナナムシルの何代目かのユーザーだった魔女\n　ツェロル・アナザーを侵蝕、暴走状態に。\n　WCL（の前身）の関与があった可能性有り。\n　最初の出芽体は双生で、ナナムシルorgに最も近い\n　能力継承をしている模様。\n　それ以降は無軌道に増殖、ツェロルのヒトとしての自我は\n　既に崩壊している。\n　増殖するねこにもPHASE:10はない。\n　以降増殖するねこは同胞の魔女に下賜される。","@r@r○最初的猫纳纳姆希尔org\n　曾是纳纳姆希尔某一代使用者的魔女\n　赛萝洛・Another被侵蚀并陷入暴走状态。\n　疑有WCL（的前身）组织介入。\n　最初出芽体为双生子，最接近纳纳姆希尔org\n　似乎继承了核心能力。\n　此后便开始无序增殖，赛萝洛作为人的自我\n　已然崩坏。\n　增殖出的猫身上不存在PHASE:10。\n　此后增殖的猫会被赐予同为魔女的同伴。"],["@r@r○ナナムシルalt＝黒のイツワ\n（出芽双体のもう一方『茶黒のオウト』はＤへ調整中消失）\n　ツェロルの正常な自我を受け継いでおりヒトの自律意志があるが、\n　メンタリティとしてはパラミアキスの性質が色濃く顕現し\n　♂である。\n　※未詳。真贋不明","@r@r○纳纳姆希尔alt＝黑之伊兹瓦\n（出芽双体另一『茶黑之欧托』于向D的调整中消失）\n　继承了赛萝洛的正常自我意识，拥有人类的自主意志，\n　但精神层面却显著显现帕拉米亚基斯特质\n　且为♂。\n　※详情不明。真伪未辨"],["@r@r○ナナムシルcat＝素晴らしき８匹（Wonderful=Eight）\n　イツワより８体のみ出芽。出芽する度に肉体外見がヒトに近づき\n　（侵蝕部の排出だったか？）、\n　イツワの最終的な姿はほぼヒトであった。\n　イツワはねことしての能力に加え真のPHASE:10をも持つ。\n　８匹はケルベ＝ロアのみ試験的にヒトの手による\n　PHASE:10を実装\n　※未詳。真贋不明\n　８体を下賜され「八人姉妹」誕生。","@r@r○纳纳姆希尔cat＝绝妙的8只（Wonderful=Eight）\n　伊兹瓦仅出芽产生8体。每次出芽后肉体外观就更接近人类\n　（是侵蚀部分的排出吗？），\n　伊兹瓦的最终形态几乎与人类无异。\n　伊兹瓦除具备猫的能力外还拥有真正的PHASE:10。\n　8只中仅有凯尔贝＝萝亚被试验性地通过人类的手段\n　植入了PHASE:10\n　※详情不明。真伪未辨\n　获赐8体后「八姐妹」诞生。"],["@r@r○ツェロル\n　八人姉妹の行方不明中の誰かが持ち出したと思われる\n　Kaleido含めScが検索中\n　※既知の通り●●●","@r@r○赛萝洛\n　推测是被八姐妹中某位失踪者带出\n　包括Kaleido在内的Sc正在搜索中\n　※如已知●●●"],["@r○WCLによる","@r○根据WCL记载"],["大","大"],["封時のLu=Leの８匹及び八人姉妹、\n今劇に於ける現状\n　・ケルベ＝ロア\n　　（ミリアム・シュブ）―――ねこと共に逃亡中\n　・ガルガル\n　　（エンドル・ファ）―――不正操作されている模様。\n　　　ねこは不明。八相の庇護下にある鍋島竹争か？","封印时的Lu=Le的8只及八姐妹，\n当前剧中的现状\n　・凯尔贝＝萝亚\n　　（米莉安姆・舒布）―――正与猫一同逃亡\n　・加尔加尔\n　　（恩朵露・法）―――疑似遭到不正操作。\n　　　猫下落不明。是否在八相庇护下的锅岛竹争处？"],["@r　・ハスマリム\n　　（オズマ・イース）―――WC傘下に改宗済、今Covenに参加\n　・マラキタルシシム\n　　（ダーカ・イァンナ）―――WC傘下に改宗済、今Covenに参加\n　・デュナム\n　　（ヴィヴ・アヴァ）―――不明（死亡？）ねこは回収済\n　・プロン\n　　（イサリー）―――不明（死亡？）ねこは回収済\n　・アルク＝ベー\n　　（ヨルド・モネ）―――WC傘下に改宗済、今Covenに参加\n　・ベール\n　　（ドレミリア・リデル）―――三春の始祖、\n　　　ねこ含め既に死亡しているが、イーハの誕生にやや遅れて、","@r　・哈斯马利姆\n　　（奥兹玛・伊斯）―――已改宗至WC麾下，现加入Coven\n　・马拉基塔尔希希姆\n　　（达卡・伊安娜）―――已改宗至WC麾下，现加入Coven\n　・迪尤纳姆\n　　（薇芙・艾娃）―――下落不明（死亡？）猫已回收\n　・普洛恩\n　　（伊萨莉）―――下落不明（死亡？）猫已回收\n　・阿尔克＝贝\n　　（约尔德・莫奈）―――已改宗至WC麾下，现加入Coven\n　・贝尔\n　　（德蕾米莉娅・利德尔）―――三春的始祖，\n　　　包括猫在内早已死亡，但比伊哈的诞生稍晚一些，"],["@r@r（作成中にて以下略）","@r@r（制作中以下略）"]],"context":[["SC_E_018.ks/index/1/text"],["SC_E_018.ks/index/3/text"],["SC_E_018.ks/index/5/text"],["SC_E_018.ks/index/8/text"],["SC_E_018.ks/index/10/text"],["SC_E_018.ks/index/12/text"],["SC_E_018.ks/index/14/text"],["SC_E_018.ks/index/16/text"],["SC_E_018.ks/index/19/text"],["SC_E_018.ks/index/21/text"],["SC_E_018.ks/index/24/text"],["SC_E_018.ks/index/26/text"],["SC_E_018.ks/index/28/text"],["SC_E_018.ks/index/30/text"],["SC_E_018.ks/index/32/text"],["SC_E_018.ks/index/34/text"],["SC_E_018.ks/index/36/text"],["SC_E_018.ks/index/38/text"],["SC_E_018.ks/index/40/text"],["SC_E_018.ks/index/42/text"],["SC_E_018.ks/index/44/text"],["SC_E_018.ks/index/46/text"],["SC_E_018.ks/index/48/text"],["SC_E_018.ks/index/50/text"],["SC_E_018.ks/index/52/text"],["SC_E_018.ks/index/54/text"],["SC_E_018.ks/index/56/text"],["SC_E_018.ks/index/58/text"],["SC_E_018.ks/index/60/text"],["SC_E_018.ks/index/62/text"],["SC_E_018.ks/index/64/text"],["SC_E_018.ks/index/66/text"],["SC_E_018.ks/index/68/text"]],"tags":[],"parameters":[[{"start":164,"end":230}],[{"start":254,"end":501}],[{"start":528,"end":626}],[{"start":640,"end":658}],[{"start":668,"end":669}],[{"start":678,"end":679}],[{"start":689,"end":700}],[{"start":706,"end":809}],[{"start":823,"end":825}],[{"start":836,"end":842}],[{"start":856,"end":858}],[{"start":867,"end":897}],[{"start":908,"end":919}],[{"start":925,"end":966}],[{"start":975,"end":976}],[{"start":987,"end":1032}],[{"start":1038,"end":1168}],[{"start":1174,"end":1256}],[{"start":1262,"end":1386}],[{"start":1396,"end":1397}],[{"start":1407,"end":1412}],[{"start":1418,"end":1521}],[{"start":1527,"end":1592}],[{"start":1602,"end":1630}],[{"start":1654,"end":1902}],[{"start":1908,"end":2056}],[{"start":2062,"end":2301}],[{"start":2307,"end":2386}],[{"start":2396,"end":2407}],[{"start":2417,"end":2418}],[{"start":2428,"end":2571}],[{"start":2577,"end":2881}],[{"start":2908,"end":2926}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_018.ks","basename":"SC_E_018.ks","indexIds":{"四番目のＤへ[l]\n@r注：邦訳途上にて、表記表現に不明、曖昧な点多々あり\n　　精細を望むならば原書を参照のこと":0,"@r　　Ｅ凹：Ｙ誕生にて、\n　　オウのゲェム（Game\"O\"）の為に用意\n　　\"R\"or\"W\"の振り分け、\n　　次世代upgrade（※例のLinkableForm）のテスト、\n　　青写真の為に資料として\n@r　　真贋不明点は魔眼者の質を以て感得するのが最良、不立文字\n@r　　prot-eins『●●』は黙殺すること\n@r　　Re-combinant_は続行せよ\n@r　　箏及び音の管理も手抜かること無きよう":1,"--------\n我等が始祖アリスの、魔にして真たる眼の加護あらんことを、\nOmegaの瞳の祝福あれ。[l]\n\n始祖は猫を愛し、\n四海を視界に納めんが為、\n":2,"己が意志を為す為の、\n最良の":3,"同":4,"伴":5,"者を得ようとなさった。":6,"@r始祖アリスには答えが視えていたが、\n凡俗は正に盲目の者かの如く。[l]\n\nアリスとその眷属らは。[l]\n視、感得することが出来る者、\n紅き灯火ともる箱持ち、\n":7,"途 ":8,"過 たず、\n":9,"言の":10,"葉無くとも揺らぐことなき資。[l]\n喰うを式となし、":11,"現を渡る最強のちから。":12,"@rその。[l]\n\n始祖の視界に映るものに、\nミを与え":13,"可":14,"触のものとしようと試みた。[l]\nそのミは、\nかの愛し猫だったのだろうか。":15,"@rつまりは後代に『魔女の猫』と呼び習わされるもの、[l]\n始祖曰く、\nこの世に於いて、欲望に忠実でありながら、\n最も美しく優雅、\n月の如き満ち欠ける瞳を持つもの、[l]\n我等の愛するに相応しい動物、\nねこ。":16,"@rハコの中には――[l]\n\n●●か奇跡か――ひとくみの完璧なねこ。[l]\nパラミアキス＝メイル、\nパラミアキス＝フィーメイル。":17,"@rアリスはまずパラミアキスメイルを喚び降ろした。[l]\n\n月の雫は其れを為し得るための呼び水。[l]\n\n後代になりそう呼称される事となる、\n触媒にして渦の中心。[l]\n故に『だれがそれなのか』は":18,"今":19,"以て不明。":20,"@r初めにパラミアキス＝メイルが応じた。[l]\n\nそれはアリスの飼猫に受肉す。[l]\n即ち、ナナムシル（Non=Amuse=Ill？或いは七蝕龍か）org、\n最初のねこ。":21,"@rアリスと契り、\n始祖の眷属に受け継がれる同伴者となったそのねこ、\nナナムシルは、\n--------":22,"@r注：以下走り書き、未整理、真偽は度外視で構わない":23,"@r@r○最初のねこナナムシルorg\n　ナナムシルの何代目かのユーザーだった魔女\n　ツェロル・アナザーを侵蝕、暴走状態に。\n　WCL（の前身）の関与があった可能性有り。\n　最初の出芽体は双生で、ナナムシルorgに最も近い\n　能力継承をしている模様。\n　それ以降は無軌道に増殖、ツェロルのヒトとしての自我は\n　既に崩壊している。\n　増殖するねこにもPHASE:10はない。\n　以降増殖するねこは同胞の魔女に下賜される。":24,"@r@r○ナナムシルalt＝黒のイツワ\n（出芽双体のもう一方『茶黒のオウト』はＤへ調整中消失）\n　ツェロルの正常な自我を受け継いでおりヒトの自律意志があるが、\n　メンタリティとしてはパラミアキスの性質が色濃く顕現し\n　♂である。\n　※未詳。真贋不明":25,"@r@r○ナナムシルcat＝素晴らしき８匹（Wonderful=Eight）\n　イツワより８体のみ出芽。出芽する度に肉体外見がヒトに近づき\n　（侵蝕部の排出だったか？）、\n　イツワの最終的な姿はほぼヒトであった。\n　イツワはねことしての能力に加え真のPHASE:10をも持つ。\n　８匹はケルベ＝ロアのみ試験的にヒトの手による\n　PHASE:10を実装\n　※未詳。真贋不明\n　８体を下賜され「八人姉妹」誕生。":26,"@r@r○ツェロル\n　八人姉妹の行方不明中の誰かが持ち出したと思われる\n　Kaleido含めScが検索中\n　※既知の通り●●●":27,"@r○WCLによる":28,"大":29,"封時のLu=Leの８匹及び八人姉妹、\n今劇に於ける現状\n　・ケルベ＝ロア\n　　（ミリアム・シュブ）―――ねこと共に逃亡中\n　・ガルガル\n　　（エンドル・ファ）―――不正操作されている模様。\n　　　ねこは不明。八相の庇護下にある鍋島竹争か？":30,"@r　・ハスマリム\n　　（オズマ・イース）―――WC傘下に改宗済、今Covenに参加\n　・マラキタルシシム\n　　（ダーカ・イァンナ）―――WC傘下に改宗済、今Covenに参加\n　・デュナム\n　　（ヴィヴ・アヴァ）―――不明（死亡？）ねこは回収済\n　・プロン\n　　（イサリー）―――不明（死亡？）ねこは回収済\n　・アルク＝ベー\n　　（ヨルド・モネ）―――WC傘下に改宗済、今Covenに参加\n　・ベール\n　　（ドレミリア・リデル）―――三春の始祖、\n　　　ねこ含め既に死亡しているが、イーハの誕生にやや遅れて、":31,"@r@r（作成中にて以下略）":32},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_018.ks","relPath":"/data/scenario/SC_E_018.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":33,"length":33,"percent":100},"cellInfo":[[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[24,0],"note":"完成"},"/data/scenario/SC_E_019.ks":{"data":[["八人の姉妹がおりまして、\n捕まり、寝返り、逃げ去り、\n一人一人と居なくなり、\n今では――[l]\n\n……さあ、どうなったでしょうか。","曾有八位姐妹，\n被捕，叛变，逃亡，\n一个接一个地消失，\n如今――[l]\n\n……来猜猜看变成怎样了吧。"],["さて、『八人姉妹』の生き残りさん、\n鍋島竹争。いや、エンドル。[l]\nガルガルの遣い手エンドル・ファそれが、[l]\n\n貴女の名。","那么，『八姐妹』的幸存者，\n锅岛竹争。不，是恩朵露。[l]\n加尔加尔的使役者恩朵露・法，[l]\n\n那便是你的名字。"],["貴女もどうやら不正操作を受けている。","看来你也遭到了不正操作。"],["貴女が世話を命じられたその『モノ』が何かは憶えてますか？[l]\nそうパストラリーの猫、『ツェロルの悪夢』と呼ばれた猫の萌芽。[l]\n未だ眠り続ける睡眠者、\n貴女を不正操作した者は、\n貴女達姉妹の同胞にその存在を隠匿しています。","还记得奉命照看的那个『东西』是什么吗？[l]\n没错就是帕斯托拉里的猫，被称为『赛萝洛的噩梦』的猫之萌芽。[l]\n至今仍在沉睡的入眠者，\n对你实施不正操作之人，\n向你们姐妹的同胞隐瞒了其存在。"],["何を言われているかも解りませんか。","连别人在说什么都听不懂吗。"],["――理解力が戻るにはまだ時間が掛かりそうですね。[l]\nガルガル……も無事とは言い難いようですが、\n流石は『ＷＥ』か。[l]\n貴女を老いから遠ざけてはくれたようです。[l]\nこれだけ長期間の不正操作、それをあれが出来るとは思えないので、\nどうやら『単純な』記憶障害も原因となっているかも知れません。","――看来恢复理解力还需要时间呢。[l]\n加尔加尔……也难以说是安然无恙，\n真不愧是『WE』啊。[l]\n似乎让你远离了衰老。[l]\n如此长时间的不正操作，真没想到那家伙能做到，\n或许『单纯的』记忆障碍也是原因之一。"],["しかしどうやらそれの修復までは為してはくれなかった――\n否、貴女はそれを命じることすら思いつかなかったのでしょうが。[l]\n猫にとっては貴女が生きてさえいれば『餌』は確保できる訳ですから、貴女のアタマの中の事情など瑣事と判断したのでしょう。","但看来它并未修复到那种程度――\n不，或许是您连下令让它修复都没能想到吧。[l]\n对猫而言只要你活着就能确保『食物』，想必判断你脑内的状况不过是琐事吧。"],["だが一歩間違えば貴女を侵蝕しつくして、\nそこのそれと同じ末路を辿る……いえ、[l]\nまだツェロルは終わった訳ではありませんがね。[l]\nいずれにしても貴女と貴女のガルガルが、\n何とかそこのそれを眠らせていたのは確かでしょう。[l]\n『彼女の肉じゃない方』が目覚める事があればやはり貴女も無事では済まない。","但若一步走错就会将你彻底侵蚀，\n落得和那边那个相同的下场……不，[l]\n应该说赛萝洛的结局还未真正到来。[l]\n无论如何你和你的加尔加尔，\n确实设法让那边那个陷入了沉睡。[l]\n若『她非肉体的那部分』苏醒过来，你也难逃厄运。"],["さて時間はもう少しあるので。[l]\n操作の解除――いえ上書きか――をしながら、\n少しばかり理解の手助けをしましょう。","现在还有些时间。[l]\n在解除操控――不、是覆盖期间――\n就让我帮你理清头绪吧。"],["始まりはアリスの祖たる女性が、猫に比される使い魔、\nすなわち『魔女の猫』を調伏した事。[l]\n月の雫という触媒存在（カタリシス）が居たとも、\n彼女自身がそうだったとも言われますが、\nそれは余り固執すべき事項ではありません。","起始于爱丽丝先祖那位女性，降伏了那只被比作猫的使魔，\n亦即所谓『魔女之猫』的事件。[l]\n虽传说存在名为月之雫的触媒（Catalysis），\n也有说法称她本人就是触媒，\n但这并非需要执着考据的重点。"],["結果として我々、そして猫が居る、それでよいのです。[l]\nいずれ資質を持ったもの──我々は魔眼質と呼び習わしますが──\nそれが我々、そして貴女です。[l]\n魔『眼』質とは言いますがGlamSightとは少々違う。[l]\n視覚能力に限った資質ではありませんからね。[l]\nあくまで便宜的な呼称です。","结果就是我们与猫共存于世，这就足够了。[l]\n具备资质者——我们称之为魔眼质——\n即是我们，也是你。[l]\n虽称为魔『眼』质却与GlamSight（译注：这不是我们型月的妖精眼吗，下次使用记得标明出处）略有不同。[l]\n这并非仅限于视觉能力的资质。[l]\n终究只是个便利的称呼罢了。"],["話が逸れましたか。[l]\n\nそう言うわけで、\n猫と契れた以上、\n貴女も紛れもない魔眼質の女。","话题跑偏了呢。[l]\n\n总之，\n既然与猫缔结契约，\n你便是毋庸置疑的魔眼质女性。"],["それも、\nLu=Leの導き手たる、\n『八人姉妹』の第二位。[l]\nＷＥのガルガル、その遣い手エンドル・ファ。","更是\n作为Lu=Le的引导者，\n『八姐妹』的第二席。[l]\nWE的加尔加尔，其使役者恩朵露・法。"],["貴女も『八人姉妹』が一人ならそれなりの資質を有した者としての\n自覚、覚悟がおありでしょう。","你既是『八姐妹』成员，\n想必早已具备相应资质者的自觉与觉悟吧。。"],["不安ですか、再びセカイと接続するのは。[l]\nその不安の因すらも、最早判じれない、それは仕方ないですね。","在害怕吗，即将重新连接世界这件事。[l]\n连恐惧的根源都已无法辨识，这也无可奈何。"],["猫や眼の『よすが』が判然としていない今の貴女では、\nその資質は単に恐怖不安の源、\n即ち極端な想像力に過ぎない。[l]\nあらゆることに眼をつぶることも、\n鈍感に些事を受け流すことも困難。","如今连猫与眼的『凭依』都模糊不清的你，\n这份资质只会成为恐惧的源头，\n亦即极端的想象力罢了。[l]\n既无法对一切视而不见，\n也难以迟钝地忽略琐事。"],["まして不正操作をされた不安定さは更に、\n不安を励起し貴女を苦しめていた筈です。[l]\n不安からの脱却は時に自己消去への渇望へとなりうる。","更何况处于遭受不正操作的不稳定状态，\n更会激发不安折磨着你。[l]\n摆脱不安有时会演变成对自我抹消的渴望。"],["不正操作によってそれは、幸運にも阻害されたようですが、\n欲求との狭間に起きる軋轢は貴女を","所幸不正操作抑制了这种倾向，\n但欲望与现实的夹缝中产生的冲突"],["苛み","仍在"],["蝕んだのでしょう。","蚕食着你。"],["いずれ貴女の所為ではないですが、[l]\n──まだ、\n不安なのですか。","虽非你本意所致，[l]\n——还在\n害怕吗？"],["安心を得る方法は、\n大別して二つ、[l]\n不安の対象を視極めて真正面から対峙するか、\n眼を瞑り耳を塞ぎ、徹底的に逃避するかです。","获取安心的方式，\n大体分为两种，[l]\n要么认清恐惧源头正面应对，\n要么闭目塞耳彻底逃避。"],["前者は更に岐路があります。[l]\nそう、\n原因と同化して馴染む事で安寧を得るのか、\n原因を拒否して排する事で安寧を得るのかです。","前者还存在分歧。[l]\n没错，\n是与恐惧同化来获取安宁，\n还是通过排斥恐惧来获得安宁。"],["いずれも貴女がセカイをどのように視るかです、\nエンドル。","这都取决于你如何看待世界，\n恩朵露。"],["猫はそのための『よすが』。[l]\n今の貴女には、言葉では解らないでしょうが。[l]\nどうあれ我々はセカイの構成要素であり、\n接続を拒否することなど出来ないのですからね。","猫正是为此存在的『凭依』。[l]\n现在的你，恐怕难以理解这番话吧。[l]\n毕竟我们本就是世界的构成要素，\n根本不可能拒绝连接啊。"],["そういう意味では自己とセカイを分離して考える事自体が\nナンセンスなのですが。[l]\n肉と意識ではステージもカテゴリも違いますから、[l]\n……こういうことが言外で解っているのが、\n我々『魔女』なのです。","从这个意义上说 将自我与世界分离思考这件事本身\n是荒谬的。[l]\n肉体与意识所处的层面和范畴都不同，[l]\n……能在在不言自明中理解这些事的，\n正是我等『魔女』。"],["そう、我々。[l]\n私は貴女の敵ではありませんよ。","没错，我等。[l]\n我并非你的敌人。"],["なんでしたら別の姉妹と会わせてもよいのですよ。[l]\nダーカ・イァンナの名を思い出せますか？[l]\nその猫マラキタルシシムは？[l]\nそうですか。[l]\n貴女の状況は思ったより難儀なようですね。","若你愿意 也可以安排你与其他姐妹相见。[l]\n还记得达卡・伊安娜的名字吗？[l]\n那只叫马拉基塔尔希希姆的猫呢？[l]\n这样啊。[l]\n你的状况比预想的更棘手呢。"],["――彼女は今や貴女方の天敵たるテトライの守護者です。[l]\nダーカは兎も角、テトルジャトートリスの遣い手は\n今の貴女に会わせたら嬉々としてその力を振るうでしょうね。[l]\n彼女は『失敗に終わった魔眼の刺し手の正統なる別の遣り方』\nによって造られたEnder。[l]\n最も新しいEnderであるが故に実戦を経験してはいませんが、","――她现在已成为你们天敌般的存在 Tetorai的守护者。[l]\n达卡暂且不论 若是让泰托尔贾托托利斯的操纵者\n见到现在的你 定会欢天喜地施展力量吧。[l]\n她是『以失败告终的魔眼杀手正统替代方案』\n制造出的Ender。[l]\n虽因是最新型Ender而缺乏实战经验，"],["……どうしました？[l]\nドレミリア・リデル？[l]\nそう。[l]\nミリアム・シュブ。[l]\nそうです。[l]\n大分恢復が進んできたようですね。[l]\n彼女達自体の事は憶えていたようですが、\n別れてから後の去就は把握していなかったのでしょう。","……怎么了？[l]\n德蕾米莉娅・利德尔？[l]\n对。[l]\n米莉安姆・舒布。[l]\n正是。[l]\n看来恢复得相当顺利呢。[l]\n虽然还记得她们本身的事，\n但应该不清楚分别后的去向吧。"],["貴女とそこのそれを確保して不正操作していた者は、\nつまりは、","把你和那边那个搞到手并进行不正操作的家伙，\n说到底，"],["……どうしました？[l]\nベールはもう……其処に居ませんが、[l]\nミリアムとその猫ケルベ＝ロアは健在です。","……怎么了？[l]\n贝尔已经……不在那里了，[l]\n不过米莉安姆和她的猫凯尔贝＝萝亚都安然无恙。"],["──今日は少し休みましょうか。","──今天先休息吧。"],["まだ焦ることはない。[l]\n貴女にも役は与えられますが、\n出番とその舞台は今少し先となりましょう。","还不用着急。[l]\n虽然也会给你分配角色，\n但登场时机和舞台还要再等些时日。"],["益か、厄か、それとも――\n貴女次第です。","是福是祸 亦或是――\n全取决于你。"],["──。","──。"],["『ＷＥ』にも未だ遣う価値がある。","『WE』仍有利用价值。"],["勿論イツワの断片にも、それにツェロルのboot\n或いはＲｅsetupにも。","当然伊兹瓦的碎片也是 还有赛萝洛的boot\n或是Resetup也是。"],["\"R\"or\"W\"の振り分け、ゲェムには●と●が必要。","\"R\"or\"W\"的区分 游戏需要●与●。"],["すべては●●のため、[l]\n\nアキかけたシキのアイも、次への良き礎となる。","一切都是为了●●，[l]\n\n即使是有些许不足的四季之眼 也会成为通往未来的基石。"],["あの方の願い、●●●のより完全なる存在への昇華。[l]\n\n","那位大人的愿望 是朝着比●●●更完美的存在升华。[l]\n\n"],["既","已然"],["解にして","领悟却"],["自","又自我"],["欠たカミも顕れる筈。[l]\n\n序にして結となるか。[l]\n\n私は全てを、[l]\n\nあの方の願うままに。","残缺之神亦当显现。[l]\n\n是序章亦或终章。[l]\n\n我愿将一切，[l]\n\n奉献于那位大人所愿。"],["それが、[l]\n\n001:GM、[l]\n\n司書長の代行者の責。","此乃，[l]\n\n001:GM，[l]\n\n司书长的代行者之责。"],["@r@r@r@r@r@r","@r@r@r@r@r@r"],["個","逐个"],["殺して、のぞみましょう。","杀死 试试看吧。"]],"context":[["SC_E_019.ks/index/1/text"],["SC_E_019.ks/index/3/text"],["SC_E_019.ks/index/5/text"],["SC_E_019.ks/index/7/text"],["SC_E_019.ks/index/9/text"],["SC_E_019.ks/index/11/text"],["SC_E_019.ks/index/13/text"],["SC_E_019.ks/index/15/text"],["SC_E_019.ks/index/17/text"],["SC_E_019.ks/index/19/text"],["SC_E_019.ks/index/21/text"],["SC_E_019.ks/index/23/text"],["SC_E_019.ks/index/25/text"],["SC_E_019.ks/index/27/text"],["SC_E_019.ks/index/29/text"],["SC_E_019.ks/index/31/text"],["SC_E_019.ks/index/33/text"],["SC_E_019.ks/index/35/text"],["SC_E_019.ks/index/37/text"],["SC_E_019.ks/index/39/text"],["SC_E_019.ks/index/41/text"],["SC_E_019.ks/index/43/text"],["SC_E_019.ks/index/45/text"],["SC_E_019.ks/index/47/text"],["SC_E_019.ks/index/49/text"],["SC_E_019.ks/index/51/text"],["SC_E_019.ks/index/53/text"],["SC_E_019.ks/index/55/text"],["SC_E_019.ks/index/57/text"],["SC_E_019.ks/index/59/text"],["SC_E_019.ks/index/61/text"],["SC_E_019.ks/index/63/text"],["SC_E_019.ks/index/65/text"],["SC_E_019.ks/index/67/text"],["SC_E_019.ks/index/69/text"],["SC_E_019.ks/index/71/text","SC_E_019.ks/index/73/text","SC_E_019.ks/index/75/text"],["SC_E_019.ks/index/77/text"],["SC_E_019.ks/index/79/text"],["SC_E_019.ks/index/81/text"],["SC_E_019.ks/index/83/text"],["SC_E_019.ks/index/85/text"],["SC_E_019.ks/index/88/text"],["SC_E_019.ks/index/90/text"],["SC_E_019.ks/index/92/text"],["SC_E_019.ks/index/94/text"],["SC_E_019.ks/index/96/text"],["SC_E_019.ks/index/98/text"],["SC_E_019.ks/index/101/text"],["SC_E_019.ks/index/103/text"]],"tags":[],"parameters":[[{"start":145,"end":228}],[{"start":264,"end":342}],[{"start":350,"end":368}],[{"start":400,"end":529}],[{"start":537,"end":554}],[{"start":562,"end":731}],[{"start":739,"end":869}],[{"start":877,"end":1049}],[{"start":1057,"end":1123}],[{"start":1131,"end":1258}],[{"start":1266,"end":1434}],[{"start":1442,"end":1502}],[{"start":1510,"end":1576}],[{"start":1584,"end":1633}],[{"start":1641,"end":1697}],[{"start":1705,"end":1813}],[{"start":1821,"end":1897}],[{"start":1905,"end":1953}],[{"start":1964,"end":1966}],[{"start":1977,"end":1986}],[{"start":1994,"end":2036}],[{"start":2044,"end":2120}],[{"start":2128,"end":2204}],[{"start":2212,"end":2244}],[{"start":2252,"end":2348}],[{"start":2356,"end":2473}],[{"start":2481,"end":2510}],[{"start":2518,"end":2631}],[{"start":2639,"end":2822}],[{"start":2830,"end":2979}],[{"start":2987,"end":3021}],[{"start":3029,"end":3091}],[{"start":3099,"end":3114}],[{"start":3122,"end":3179}],[{"start":3187,"end":3211}],[{"start":3270,"end":3273},{"start":3281,"end":3284},{"start":3292,"end":3295}],[{"start":3303,"end":3319}],[{"start":3327,"end":3368}],[{"start":3376,"end":3402}],[{"start":3410,"end":3453}],[{"start":3461,"end":3492}],[{"start":3505,"end":3506}],[{"start":3516,"end":3520}],[{"start":3529,"end":3530}],[{"start":3540,"end":3609}],[{"start":3617,"end":3660}],[{"start":3666,"end":3686}],[{"start":3699,"end":3700}],[{"start":3710,"end":3722}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_019.ks","basename":"SC_E_019.ks","indexIds":{"八人の姉妹がおりまして、\n捕まり、寝返り、逃げ去り、\n一人一人と居なくなり、\n今では――[l]\n\n……さあ、どうなったでしょうか。":0,"さて、『八人姉妹』の生き残りさん、\n鍋島竹争。いや、エンドル。[l]\nガルガルの遣い手エンドル・ファそれが、[l]\n\n貴女の名。":1,"貴女もどうやら不正操作を受けている。":2,"貴女が世話を命じられたその『モノ』が何かは憶えてますか？[l]\nそうパストラリーの猫、『ツェロルの悪夢』と呼ばれた猫の萌芽。[l]\n未だ眠り続ける睡眠者、\n貴女を不正操作した者は、\n貴女達姉妹の同胞にその存在を隠匿しています。":3,"何を言われているかも解りませんか。":4,"――理解力が戻るにはまだ時間が掛かりそうですね。[l]\nガルガル……も無事とは言い難いようですが、\n流石は『ＷＥ』か。[l]\n貴女を老いから遠ざけてはくれたようです。[l]\nこれだけ長期間の不正操作、それをあれが出来るとは思えないので、\nどうやら『単純な』記憶障害も原因となっているかも知れません。":5,"しかしどうやらそれの修復までは為してはくれなかった――\n否、貴女はそれを命じることすら思いつかなかったのでしょうが。[l]\n猫にとっては貴女が生きてさえいれば『餌』は確保できる訳ですから、貴女のアタマの中の事情など瑣事と判断したのでしょう。":6,"だが一歩間違えば貴女を侵蝕しつくして、\nそこのそれと同じ末路を辿る……いえ、[l]\nまだツェロルは終わった訳ではありませんがね。[l]\nいずれにしても貴女と貴女のガルガルが、\n何とかそこのそれを眠らせていたのは確かでしょう。[l]\n『彼女の肉じゃない方』が目覚める事があればやはり貴女も無事では済まない。":7,"さて時間はもう少しあるので。[l]\n操作の解除――いえ上書きか――をしながら、\n少しばかり理解の手助けをしましょう。":8,"始まりはアリスの祖たる女性が、猫に比される使い魔、\nすなわち『魔女の猫』を調伏した事。[l]\n月の雫という触媒存在（カタリシス）が居たとも、\n彼女自身がそうだったとも言われますが、\nそれは余り固執すべき事項ではありません。":9,"結果として我々、そして猫が居る、それでよいのです。[l]\nいずれ資質を持ったもの──我々は魔眼質と呼び習わしますが──\nそれが我々、そして貴女です。[l]\n魔『眼』質とは言いますがGlamSightとは少々違う。[l]\n視覚能力に限った資質ではありませんからね。[l]\nあくまで便宜的な呼称です。":10,"話が逸れましたか。[l]\n\nそう言うわけで、\n猫と契れた以上、\n貴女も紛れもない魔眼質の女。":11,"それも、\nLu=Leの導き手たる、\n『八人姉妹』の第二位。[l]\nＷＥのガルガル、その遣い手エンドル・ファ。":12,"貴女も『八人姉妹』が一人ならそれなりの資質を有した者としての\n自覚、覚悟がおありでしょう。":13,"不安ですか、再びセカイと接続するのは。[l]\nその不安の因すらも、最早判じれない、それは仕方ないですね。":14,"猫や眼の『よすが』が判然としていない今の貴女では、\nその資質は単に恐怖不安の源、\n即ち極端な想像力に過ぎない。[l]\nあらゆることに眼をつぶることも、\n鈍感に些事を受け流すことも困難。":15,"まして不正操作をされた不安定さは更に、\n不安を励起し貴女を苦しめていた筈です。[l]\n不安からの脱却は時に自己消去への渇望へとなりうる。":16,"不正操作によってそれは、幸運にも阻害されたようですが、\n欲求との狭間に起きる軋轢は貴女を":17,"苛み":18,"蝕んだのでしょう。":19,"いずれ貴女の所為ではないですが、[l]\n──まだ、\n不安なのですか。":20,"安心を得る方法は、\n大別して二つ、[l]\n不安の対象を視極めて真正面から対峙するか、\n眼を瞑り耳を塞ぎ、徹底的に逃避するかです。":21,"前者は更に岐路があります。[l]\nそう、\n原因と同化して馴染む事で安寧を得るのか、\n原因を拒否して排する事で安寧を得るのかです。":22,"いずれも貴女がセカイをどのように視るかです、\nエンドル。":23,"猫はそのための『よすが』。[l]\n今の貴女には、言葉では解らないでしょうが。[l]\nどうあれ我々はセカイの構成要素であり、\n接続を拒否することなど出来ないのですからね。":24,"そういう意味では自己とセカイを分離して考える事自体が\nナンセンスなのですが。[l]\n肉と意識ではステージもカテゴリも違いますから、[l]\n……こういうことが言外で解っているのが、\n我々『魔女』なのです。":25,"そう、我々。[l]\n私は貴女の敵ではありませんよ。":26,"なんでしたら別の姉妹と会わせてもよいのですよ。[l]\nダーカ・イァンナの名を思い出せますか？[l]\nその猫マラキタルシシムは？[l]\nそうですか。[l]\n貴女の状況は思ったより難儀なようですね。":27,"――彼女は今や貴女方の天敵たるテトライの守護者です。[l]\nダーカは兎も角、テトルジャトートリスの遣い手は\n今の貴女に会わせたら嬉々としてその力を振るうでしょうね。[l]\n彼女は『失敗に終わった魔眼の刺し手の正統なる別の遣り方』\nによって造られたEnder。[l]\n最も新しいEnderであるが故に実戦を経験してはいませんが、":28,"……どうしました？[l]\nドレミリア・リデル？[l]\nそう。[l]\nミリアム・シュブ。[l]\nそうです。[l]\n大分恢復が進んできたようですね。[l]\n彼女達自体の事は憶えていたようですが、\n別れてから後の去就は把握していなかったのでしょう。":29,"貴女とそこのそれを確保して不正操作していた者は、\nつまりは、":30,"……どうしました？[l]\nベールはもう……其処に居ませんが、[l]\nミリアムとその猫ケルベ＝ロアは健在です。":31,"──今日は少し休みましょうか。":32,"まだ焦ることはない。[l]\n貴女にも役は与えられますが、\n出番とその舞台は今少し先となりましょう。":33,"益か、厄か、それとも――\n貴女次第です。":34,"──。":35,"『ＷＥ』にも未だ遣う価値がある。":36,"勿論イツワの断片にも、それにツェロルのboot\n或いはＲｅsetupにも。":37,"\"R\"or\"W\"の振り分け、ゲェムには●と●が必要。":38,"すべては●●のため、[l]\n\nアキかけたシキのアイも、次への良き礎となる。":39,"あの方の願い、●●●のより完全なる存在への昇華。[l]\n\n":40,"既":41,"解にして":42,"自":43,"欠たカミも顕れる筈。[l]\n\n序にして結となるか。[l]\n\n私は全てを、[l]\n\nあの方の願うままに。":44,"それが、[l]\n\n001:GM、[l]\n\n司書長の代行者の責。":45,"@r@r@r@r@r@r":46,"個":47,"殺して、のぞみましょう。":48},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_019.ks","relPath":"/data/scenario/SC_E_019.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":49,"length":49,"percent":100},"cellInfo":[null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,null,null,null,[null,{"t":"HU"}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[27,1],"note":"完成"},"/data/scenario/SC_E_020.ks":{"data":[["「どうも」","「你好」"],["「道具じゃないの。[l]\n此方に来てから何日経ったかしらね？[l]\nようやく挨拶に来るとは大した御身分だこと」","「这不是道具嘛。[l]\n来这边多少天了才想起来打招呼？[l]\n摆这么大架子可真是了不起」"],["「やだなあ、\n僕も少々疲れてたり色々することがありましたのでね。[l]\n例のあれも急を要したので大変で」","「别这么说嘛，\n我也有些疲惫 还有各种事情要处理。[l]\n那件事也很紧急 实在忙不过来」"],["「それは感謝してるわ。[l]\n卑尊が使えるようになるまでは保つのね？」","「这倒要谢谢你。[l]\n能维持到卑尊恢复使用对吧？」"],["「それはもう」","「没问题的」"],["「ならいいわ。[l]\n……ふう、貴女の言動にいちいち目くじら立ててたら\n疲れるだけね。[l]\n卑尊の所に今も居るのね？」","「那就好。[l]\n……呼，要是对你的言行一一斤斤计较的话\n只会让自己疲惫呢。[l]\n你现在还待在卑尊那里吗？」"],["「ま、御陰様で漸く落ち着けましたのでね。[l]\n改めて挨拶に罷り越した次第ですよ。","「嘛，托您的福总算能安顿下来了。[l]\n这才专程前来重新问候。"],["ついでに言えば、\n流石に老人達の溜まり場に連日引き籠もっても居られないですしね。","顺带一提，\n毕竟整天泡在老头子们的聚集地也实在待不下去呢。"],["更にそうですねぇ、\n西國の空気との落差は中々に心乱される要因なのかな？[l]\nま、要は気晴らしなのですよ」","还有就是呢，\n和西国空气的落差或许相当扰乱心神？[l]\n嘛，说白了就当是散心罢了」"],["「自分から向こうに寝泊まりすると言いだしておいて何を今更。[l]\nで、どうするの？[l]\nこっちに来るのなら用意させますよ」","「自己主动提出要住那边现在又说这种话。[l]\n所以，怎么办？[l]\n要过来的话我让人准备」"],["「あーっあっあっ、\nお気遣いご無用で。","「啊——啊啊啊，\n不必费心。"],["そう、\n勿論この僕が自分で言いだした事です。[l]\nですからね、単なる気晴らしですよ。","对，\n当然这是我自己提出的事。[l]\n所以嘛，纯粹就当是散心啦。"],["ところで御息女は――\nご不在ですか？」","话说令爱――\n不在吗？」"],["「……そう、今居ないわ」","「……嗯，现在不在」"],["「選さんと価無ちゃんも？[l]\nあのお方とベロちゃんも視てないですがね。[l]\n僕だけ単独で来たもので動向を存じ上げなくて」","「选小姐和价无酱也是？[l]\n那位和贝洛酱也没见到。[l]\n我就一个人过来的所以不清楚动向」"],["「私が全員の動向を逐一把握してる訳じゃないわよ。[l]\n継承途中だったから私からも離れてしまったままだし\n前のようには行かないわ。[l]\n本当にあの娘にも困ったものなのよ。","「我也不会掌握所有人的一举一动。[l]\n继承中途就离开我身边再没回来\n没法像从前那样了。[l]\n那丫头真是让人头疼呢。"],["……ところで道具さん、[l]\n冬夏の事で思い出したわ。","……话说道具小姐，[l]\n提到冬夏想起来了。"],["あの貴奴とか何とかいう娘、\n貴女が後ろ盾になってると聞いたけど。[l]\n何かしら『私達』にとって有益な行為なのかしら」","那个叫什么贵奴的丫头，\n听说你在背后支持她？[l]\n莫非对我们有什么益处不成」"],["「ああ、西石君。[l]\n西石、ニシイシ……","「啊，西石君。[l]\n西石，Nishiishi……"],["ふふふ、\n当主、\n聞き覚えありませんか」","呵呵，\n当主，\n可有印象？」"],["「ニシイシ……？[l]\n何の事？」","「Nishiishi……？[l]\n什么意思？」"],["「宗家ともなると一眷属の婿殿の旧姓ごときは\n憶えておいでではないですか。","「宗家之尊竟不记得区区眷属女婿的旧姓\n也是理所当然。"],["いやいや、仕方のない事です。[l]\n玖威と永久の婿達は確か兄弟でしたね？[l]\n違いましたかね」","不不，无可厚非。[l]\n玖威和永久的女婿们似乎是兄弟？[l]\n难道不是吗」"],["「そういった事は選律さんが全て仕切ってるでしょう。[l]\n私は……覚えがないわ」","「这些事都是选律小姐在打理吧。[l]\n我……没印象」"],["「それは、そうなんですがね。[l]\nえーと確か、彼等も西石姓だったでしょう。[l]\n西石兄弟、どっちがどっちだったか、\n名前は何と言ったかなあ……","「话虽如此。[l]\n嗯—记得他们也是姓西石。[l]\n西石兄弟，谁是谁来着，\n名字叫什么呢……"],["──あいえ勿論、\n偶然でしょうけどね。[l]\nとは言え、縁はあるかも知れませんがね。","──啊不当然，\n应该只是巧合。[l]\n不过说不定真有关联呢。"],["西石君……貴奴君と遭ったときに思ったのですよ。[l]\nこれだけ狭い世間の中に同一姓が存在したというのは\n何かしらの」","西石君……遇见贵奴君时就在想。[l]\n这狭小世间存在同姓之人\n或许意味着」"],["「ああもういいわ止めなさい！[l]\nくだらない話で誤魔化さないで頂戴。[l]\nこちらは問題が今山積みなの。","「够了快住口！[l]\n别用无聊话题搪塞我。[l]\n这边现在问题堆积如山呢。"],["その娘にかかずらってる暇があるの？ないの？[l]\n今更資質の持ち主を引き入れると言っても、\n初めから席はないのよ」","你还有空管那姑娘的闲事？没有吧？[l]\n事到如今再说要招揽有资质的人，\n打从一开始就没位子啦」"],["「くだらないねえ……[l]\n全く仰る通りです\n貴女――達にとっては、これから起きる事の方が\n大事も大事、一大事でしょうからね。","「真无聊啊……[l]\n您说得完全正确\n对你们――而言，接下来要发生的事\n才是重中之重、头等大事吧。"],["僕の言う事などくだらない瑣事にすぎません。[l]\nさ、どうぞ無視なさってくださいよ。","我说的不过是些无聊琐事罢了。[l]\n来，请尽管无视我吧。"],["御息女の動向を知るが第一です。[l]\nまあ、西石君にも訊いてみますよ」","首要任务是掌握令爱的动向。[l]\n嘛，我也会问问西石君的」"],["「貴女に何を言っても無駄でしょうけど、\n私の頭を痛くさせる事だけはしないで頂戴。[l]\n今回は特別なのよ」","「虽然对你说什么都是白费口舌，\n但至少别给我添头疼。[l]\n这次可是特殊情况哦」"],["「重々承知しております。[l]\n祭儀を恙なく執り行う為の努力は惜しみませんよ。[l]\nまあ、多少は独断専行してしまうかも知れませんが……」","「我十分明白。[l]\n为顺利举行祭仪必将不遗余力。[l]\n不过嘛，或许会有些独断专行呢……」"],["「度を過ぎたらあの方が黙ってないわよ。[l]\nそう言う意味では心配はしてませんけれどね」","「要是过火了那位可不会坐视不理。[l]\n这方面我倒是不担心呢」"],["「そう、全くその通り。[l]\n僕もまだやりたい事がありますのでね。","「对，正是如此。[l]\n毕竟我也有想做的事。"],["あの方は怖いですから──\n軽挙妄動はくれぐれも慎みますよ」","那位实在太可怕了──\n定会谨言慎行避免轻举妄动」"],["「じゃあもう大人しくしてらっしゃい。[l]\n私はもう中に戻るわよ」","「那就请乖乖待着吧。[l]\n我要回里面去了」"],["「ええ、それでは」","「好的，那么」"],["──。","──。"],["「まあ、あの方が怖いのは本当だけれど、\n慎むのは……","「虽说那位确实可怕，\n但说要收敛……"],["嘘なのですがねぇ。","其实是骗人的啦。"],["愉悦が僕の信条、\nあの後援者の事情もあることだし──","愉悦即是我的信条，\n再加上那位资助者的情况──"],["なー、なー、なー、なー……[l]\nなー、なー、なななななな」","呐─呐─呐─呐─……[l]\n呐─呐─呐呐呐呐呐呐」"]],"context":[["SC_E_020.ks/index/1/text"],["SC_E_020.ks/index/3/text"],["SC_E_020.ks/index/5/text"],["SC_E_020.ks/index/7/text"],["SC_E_020.ks/index/9/text"],["SC_E_020.ks/index/11/text"],["SC_E_020.ks/index/13/text"],["SC_E_020.ks/index/15/text"],["SC_E_020.ks/index/17/text"],["SC_E_020.ks/index/19/text"],["SC_E_020.ks/index/21/text"],["SC_E_020.ks/index/23/text"],["SC_E_020.ks/index/25/text"],["SC_E_020.ks/index/27/text"],["SC_E_020.ks/index/29/text"],["SC_E_020.ks/index/31/text"],["SC_E_020.ks/index/33/text"],["SC_E_020.ks/index/35/text"],["SC_E_020.ks/index/37/text"],["SC_E_020.ks/index/39/text"],["SC_E_020.ks/index/41/text"],["SC_E_020.ks/index/43/text"],["SC_E_020.ks/index/45/text"],["SC_E_020.ks/index/47/text"],["SC_E_020.ks/index/49/text"],["SC_E_020.ks/index/51/text"],["SC_E_020.ks/index/53/text"],["SC_E_020.ks/index/55/text"],["SC_E_020.ks/index/57/text"],["SC_E_020.ks/index/59/text"],["SC_E_020.ks/index/61/text"],["SC_E_020.ks/index/63/text"],["SC_E_020.ks/index/65/text"],["SC_E_020.ks/index/67/text"],["SC_E_020.ks/index/69/text"],["SC_E_020.ks/index/71/text"],["SC_E_020.ks/index/73/text"],["SC_E_020.ks/index/75/text"],["SC_E_020.ks/index/77/text"],["SC_E_020.ks/index/79/text","SC_E_020.ks/index/81/text","SC_E_020.ks/index/83/text"],["SC_E_020.ks/index/85/text"],["SC_E_020.ks/index/87/text"],["SC_E_020.ks/index/89/text"],["SC_E_020.ks/index/91/text"]],"tags":[],"parameters":[[{"start":235,"end":240}],[{"start":272,"end":335}],[{"start":367,"end":427}],[{"start":459,"end":498}],[{"start":530,"end":537}],[{"start":569,"end":641}],[{"start":673,"end":718}],[{"start":726,"end":770}],[{"start":778,"end":839}],[{"start":871,"end":941}],[{"start":973,"end":996}],[{"start":1004,"end":1055}],[{"start":1063,"end":1086}],[{"start":1118,"end":1130}],[{"start":1162,"end":1232}],[{"start":1264,"end":1362}],[{"start":1370,"end":1401}],[{"start":1409,"end":1476}],[{"start":1508,"end":1533}],[{"start":1541,"end":1569}],[{"start":1601,"end":1622}],[{"start":1654,"end":1694}],[{"start":1702,"end":1758}],[{"start":1790,"end":1834}],[{"start":1866,"end":1951}],[{"start":1959,"end":2009}],[{"start":2017,"end":2083}],[{"start":2115,"end":2176}],[{"start":2184,"end":2249}],[{"start":2281,"end":2356}],[{"start":2364,"end":2410}],[{"start":2418,"end":2457}],[{"start":2489,"end":2550}],[{"start":2582,"end":2659}],[{"start":2691,"end":2739}],[{"start":2771,"end":2808}],[{"start":2816,"end":2849}],[{"start":2887,"end":2924}],[{"start":2956,"end":2965}],[{"start":3069,"end":3072},{"start":3080,"end":3083},{"start":3091,"end":3094}],[{"start":3155,"end":3185}],[{"start":3223,"end":3232}],[{"start":3240,"end":3270}],[{"start":3276,"end":3310}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_020.ks","basename":"SC_E_020.ks","indexIds":{"「どうも」":0,"「道具じゃないの。[l]\n此方に来てから何日経ったかしらね？[l]\nようやく挨拶に来るとは大した御身分だこと」":1,"「やだなあ、\n僕も少々疲れてたり色々することがありましたのでね。[l]\n例のあれも急を要したので大変で」":2,"「それは感謝してるわ。[l]\n卑尊が使えるようになるまでは保つのね？」":3,"「それはもう」":4,"「ならいいわ。[l]\n……ふう、貴女の言動にいちいち目くじら立ててたら\n疲れるだけね。[l]\n卑尊の所に今も居るのね？」":5,"「ま、御陰様で漸く落ち着けましたのでね。[l]\n改めて挨拶に罷り越した次第ですよ。":6,"ついでに言えば、\n流石に老人達の溜まり場に連日引き籠もっても居られないですしね。":7,"更にそうですねぇ、\n西國の空気との落差は中々に心乱される要因なのかな？[l]\nま、要は気晴らしなのですよ」":8,"「自分から向こうに寝泊まりすると言いだしておいて何を今更。[l]\nで、どうするの？[l]\nこっちに来るのなら用意させますよ」":9,"「あーっあっあっ、\nお気遣いご無用で。":10,"そう、\n勿論この僕が自分で言いだした事です。[l]\nですからね、単なる気晴らしですよ。":11,"ところで御息女は――\nご不在ですか？」":12,"「……そう、今居ないわ」":13,"「選さんと価無ちゃんも？[l]\nあのお方とベロちゃんも視てないですがね。[l]\n僕だけ単独で来たもので動向を存じ上げなくて」":14,"「私が全員の動向を逐一把握してる訳じゃないわよ。[l]\n継承途中だったから私からも離れてしまったままだし\n前のようには行かないわ。[l]\n本当にあの娘にも困ったものなのよ。":15,"……ところで道具さん、[l]\n冬夏の事で思い出したわ。":16,"あの貴奴とか何とかいう娘、\n貴女が後ろ盾になってると聞いたけど。[l]\n何かしら『私達』にとって有益な行為なのかしら」":17,"「ああ、西石君。[l]\n西石、ニシイシ……":18,"ふふふ、\n当主、\n聞き覚えありませんか」":19,"「ニシイシ……？[l]\n何の事？」":20,"「宗家ともなると一眷属の婿殿の旧姓ごときは\n憶えておいでではないですか。":21,"いやいや、仕方のない事です。[l]\n玖威と永久の婿達は確か兄弟でしたね？[l]\n違いましたかね」":22,"「そういった事は選律さんが全て仕切ってるでしょう。[l]\n私は……覚えがないわ」":23,"「それは、そうなんですがね。[l]\nえーと確か、彼等も西石姓だったでしょう。[l]\n西石兄弟、どっちがどっちだったか、\n名前は何と言ったかなあ……":24,"──あいえ勿論、\n偶然でしょうけどね。[l]\nとは言え、縁はあるかも知れませんがね。":25,"西石君……貴奴君と遭ったときに思ったのですよ。[l]\nこれだけ狭い世間の中に同一姓が存在したというのは\n何かしらの」":26,"「ああもういいわ止めなさい！[l]\nくだらない話で誤魔化さないで頂戴。[l]\nこちらは問題が今山積みなの。":27,"その娘にかかずらってる暇があるの？ないの？[l]\n今更資質の持ち主を引き入れると言っても、\n初めから席はないのよ」":28,"「くだらないねえ……[l]\n全く仰る通りです\n貴女――達にとっては、これから起きる事の方が\n大事も大事、一大事でしょうからね。":29,"僕の言う事などくだらない瑣事にすぎません。[l]\nさ、どうぞ無視なさってくださいよ。":30,"御息女の動向を知るが第一です。[l]\nまあ、西石君にも訊いてみますよ」":31,"「貴女に何を言っても無駄でしょうけど、\n私の頭を痛くさせる事だけはしないで頂戴。[l]\n今回は特別なのよ」":32,"「重々承知しております。[l]\n祭儀を恙なく執り行う為の努力は惜しみませんよ。[l]\nまあ、多少は独断専行してしまうかも知れませんが……」":33,"「度を過ぎたらあの方が黙ってないわよ。[l]\nそう言う意味では心配はしてませんけれどね」":34,"「そう、全くその通り。[l]\n僕もまだやりたい事がありますのでね。":35,"あの方は怖いですから──\n軽挙妄動はくれぐれも慎みますよ」":36,"「じゃあもう大人しくしてらっしゃい。[l]\n私はもう中に戻るわよ」":37,"「ええ、それでは」":38,"──。":39,"「まあ、あの方が怖いのは本当だけれど、\n慎むのは……":40,"嘘なのですがねぇ。":41,"愉悦が僕の信条、\nあの後援者の事情もあることだし──":42,"なー、なー、なー、なー……[l]\nなー、なー、なななななな」":43},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_020.ks","relPath":"/data/scenario/SC_E_020.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":44,"length":44,"percent":100},"cellInfo":[[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"t":"HU","v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[1,1],"note":"完成"},"/data/scenario/SC_E_021.ks":{"data":[["●【その一端、","●【其之一隅，"],["讃","赞"],["頌】[l]\n\n貴女に","颂】[l]\n\n愿效犬马之劳，定当较之侍奉于您身侧之人"],["傅くものよりかしこみたてまつるさん。[l]\n\nミてる月のみならず三日月をも侍らさん、[l]\n\nその立ち振る舞いにおいてはまっこと愛くるしく、[l]\n\n","更为虔诚敬奉。[l]\n\n非但满月连新月亦尽心随侍在侧，[l]\n\n其举止行动着实惹人怜爱，[l]\n\n"],["於","虎"],["菟","啸"],["啼く歩く夜の","声声"],["朋、[l]\n\n瞳は月に比されらるも","踽踽夜行，[l]\n\n双眸亦如被比作明月"],["然り。","一般。"],["声に於いては人心を惑乱せしあの麗しき妹君、[l]\n\n即ちその声は","以声音魅惑人心的那位美丽妹妹，[l]\n\n即其声乃"],["唆","唆使"],["魅","魅惑"],["宣。[l]\n\n我等が従うべきもの白のみるは。[l]\n\n輝ける愛しき","宣告。[l]\n\n我等应当追随的纯白之视。[l]\n\n光辉可爱的"],["白","白"],["透","透"],["女。","女。"],["始祖のハコの騙るを引くに、[l]\n\n肉を","始祖之匣诱骗牵引下，[l]\n\n身披"],["纏うて","血肉"],["降り","降临"],["顕れる、\nＭとＷの狭間に咬むるるＥ、\n３に","显现，\n咬噬M与W狭缝间的E，\n以3为"],["彩られ、\n","彩饰，\n"],["四","四"],["隈に在る、\n","隐于角落，\n"],["ωの四海。","ω之四海。"],["Cat、\nDog、\nEmbryo、\nFetus、\nGnosis、\nAnt、\nBee、\n:F、\n:S、\n:N、","Cat、\nDog、\nEmbryo、\nFetus、\nGnosis、\nAnt、\nBee、\n:F、\n:S、\n:N、"],["完全が故に不完全をも完璧に内包する\n最悪の箱庭で、\n謳おうぞ、母鳥の唄、百鬼絵の黄泉。[l]\nメに布を、月の王の亡くならば、\n我等が友は望みを満たす","因完美故将不完美也完美包容\n在最恶劣的箱庭中，\n放声高唱吧，母鸟之歌，百鬼绘的黄泉。[l]\n若为眼眸缠上布帛，若月之王已然逝去，\n吾辈当为友人，成全其心愿，"],["輔が為。[l]\n\n我等は白猫愛す。[l]\n\n","为其辅佐。[l]\n\n吾等爱白猫。[l]\n\n"],["白の","白之"],["讃。[l]\n\nミ・キャミャルキャラモロコネコナメタサキャラ\nタサコネタサメミャラメンカヤコネキャ・ワ。","赞。[l]\n\nmì · kya mya ru kya ra mo ro ko ne ko na me ta sa kya ra\nta sa ko ne ta sa me mya ra men ka ya ko ne kya · wa。"],["●【その一端、犬が","●【其之一端，犬曾"],["負うたこと】[l]\n\n俺は直接その場で視た訳ではないが、\n後々判ってきた事は、\n俺等Ｐメイル由来とは根本から違うあれ、[l]\n\n白のミルハ。","背负之事】[l]\n\n我虽未亲临现场目睹，\n后来知晓的是，\n那与吾等P-mail根源相异之物，[l]\n\n白之米尔哈。"],["最強にして最凶のねこ。[l]\nあらゆるものを喰う。[l]\n使えるものは","最强亦最凶之猫。[l]\n吞噬万物。[l]\n可用之物"],["己がミにする。[l]\n不要なものやキライなものは排出する。[l]\n物理的な破壊をせずとも喰えるという（不全の６はこれが出来ない）、\n始祖の教えそのものの体現物。","皆化为己之实。[l]\n无用或厌恶之物则排出体外。[l]\n无需物理破坏即可吞噬（残缺的6做不到这点），\n正是始祖教义之化身。"],["要するに、\n狩猟者。","简而言之，\n狩猎者。"],["輝ける愛しき白透女。[l]\n全ての色を反射する最強の白たる存在。[l]\n狩猟者。","闪耀可爱的白透女。[l]\n反射一切色彩的最强之白。[l]\n狩猎者。"],["戰さ","战"],["場にては絶対なるもの、\n否、戰いですら無い。[l]\n一方的な殲滅。","场上绝对的存在，\n不，甚至称不上战斗。[l]\n单方面的歼灭。"],["しかも、[l]\n\n必ずしも効率的ではない行動を執る。[l]\n愉悦を優先し、無為とも思える過程を選択すること間々ある。","而且，[l]\n\n常采取未必高效的行动。[l]\n屡屡优先愉悦，选择看似无意义的过程。"],["あの兄への盲従を貫いてるようにも視えるが、[l]\n\n他者たる俺には想像しか出来ない。[l]\n真意は知れない。","看似始终盲从那位兄长，[l]\n\n但作为旁观者的我只能猜测。[l]\n真实意图不得而知。"],["魔眼の刺し手を従えるも、そは愛玩が為だろう。[l]\n今は……まだか、そろそろなのか。[l]\n魔眼の刺し手はあくまで効率化、或いは保険だったはずで、\nミルハにとっては●●も●●●●も●●●●●●●と\n思われる。[l]\nあの兄の、道楽かまたは","虽统御魔眼杀手，不过是为宠爱罢了。[l]\n现在……是为时尚早，还是时机已至。[l]\n魔眼杀手本应是为了提升效率，或是作为保障存在的，\n对米尔哈而言●●与●●●●都是●●●●●●●\n似乎是如此。[l]\n那位兄长，是出于消遣还是源于"],["蒐","收"],["集","藏"],["者的な","家般的"],["拘りか、\n白と黒の並ぶ美しさに眼目を置いたのかも知れないが、\n俺も彼等の掌中にあったなら面倒な事になっていただろう。","执念，\n也可能着眼于黑白交织之美，\n要是我也落入他们的掌控之中，恐怕会陷入麻烦的境地吧。"],["誰かが著した本にあったが、\n狩りには凶暴な喜びがある。[l]\n獲物を前に血の","如某人所著书中所言，\n狩猎蕴含凶暴的欢愉。[l]\n面对猎物时"],["滾りを抑えることは難しい。","难以抑制血脉偾张。"],["特にあれは、獲物に止めを刺すまでいたぶると言う、\nまさに、まるで、[l]\n\n今のところは大人しい。","尤其那一位，据说会折磨猎物至最后一刻，\n简直，宛如，[l]\n\n目前还算温顺。"],["チの活用に至るには少々、[l]\n\n甘やかされすぎたか。[l]\n\n猫の王は何をする？[l]\n\n千尋の谷へと突き落とすことはあるのか？","chi的运用还稍显不足，[l]\n\n是因为过于娇惯了吗？[l]\n\n猫之王会做什么？[l]\n\n会将其推入千寻深谷之中吗？"],["あの妹の為に全てを狂わせたあの兄が、[l]\n\nそんな、[l]\n\n？[l]\n\nあ。","那个为了妹妹不惜颠覆一切的哥哥，[l]\n\n那样的，[l]\n\n？[l]\n\n啊。"],["●【その一端、夜伽話】[l]\n\nあるところに、ある兄妹がいました。[l]\n\n（中略）[l]\n\n黒ねこは兄妹の敵でした。[l]\n\nなので兄妹はきりふだを差し向けました。[l]\n\n黒ねこは必死にたたかいましたが、[l]\n\nたましいのぬけたそのからだを、\n９つに裂かれてしまいました。","●【其片段·夜谈】[l]\n\n从前有一对兄妹。[l]\n\n（中略）[l]\n\n黑猫是兄妹的敌人。[l]\n\n于是兄妹拿出了斩魔符。[l]\n\n黑猫虽拼命抵抗，[l]\n\n灵魂出窍的躯体，\n被撕成了九份。"],["ひとつには両の手、その爪を。[l]\n\n　ぶきが折られてしまいました。[l]\n\nふたつには皮と眼を。[l]\n\n　みを守るものがなくなってしまいました。[l]\n\nみっつには●●●を。","其一是双手与利爪。[l]\n\n　武器已被折断。[l]\n\n其二是皮毛与眼睛。[l]\n\n　失去了护身之物。[l]\n\n其三是●●●。"],["@r（中略）[l]\n\n最後のひとつ[l]\n\n相手のムクロを仮借することにしました。[l]\n\nねこの１０番目はそういうものだからです。[l]\n\nねこはムクロを操ると、[l]\n\n（中略）[l]\n\n９枚のカミは誰かが持っていってしまい。","@r（中略）[l]\n\n最后一份[l]\n\n决定借用对方的尸骸。[l]\n\n因为猫的第十份本该如此。[l]\n\n当猫操纵尸骸时，[l]\n\n（中略）[l]\n\n九枚碎片已被他人取走。"],["黒ねこの１０番目が操るムクロはその後、\n飯守女と子を成して、[l]\n\n……[l]\n\n……[l]\n\nそしてだれもいなくなりました","黑猫第十份操纵的尸骸后来，\n与饭守女诞下子嗣，[l]\n\n……[l]\n\n……[l]\n\n而后再无一物留存"]],"context":[["SC_E_021.ks/index/1/text"],["SC_E_021.ks/index/3/text"],["SC_E_021.ks/index/5/text"],["SC_E_021.ks/index/7/text"],["SC_E_021.ks/index/10/text"],["SC_E_021.ks/index/12/text"],["SC_E_021.ks/index/14/text"],["SC_E_021.ks/index/16/text"],["SC_E_021.ks/index/18/text"],["SC_E_021.ks/index/20/text"],["SC_E_021.ks/index/22/text"],["SC_E_021.ks/index/24/text"],["SC_E_021.ks/index/26/text"],["SC_E_021.ks/index/28/text"],["SC_E_021.ks/index/30/text"],["SC_E_021.ks/index/32/text"],["SC_E_021.ks/index/34/text"],["SC_E_021.ks/index/36/text"],["SC_E_021.ks/index/38/text"],["SC_E_021.ks/index/40/text"],["SC_E_021.ks/index/42/text"],["SC_E_021.ks/index/45/text"],["SC_E_021.ks/index/47/text"],["SC_E_021.ks/index/50/text"],["SC_E_021.ks/index/52/text"],["SC_E_021.ks/index/54/text"],["SC_E_021.ks/index/56/text"],["SC_E_021.ks/index/59/text"],["SC_E_021.ks/index/61/text"],["SC_E_021.ks/index/63/text"],["SC_E_021.ks/index/65/text"],["SC_E_021.ks/index/67/text"],["SC_E_021.ks/index/69/text"],["SC_E_021.ks/index/71/text"],["SC_E_021.ks/index/73/text"],["SC_E_021.ks/index/75/text"],["SC_E_021.ks/index/77/text"],["SC_E_021.ks/index/79/text"],["SC_E_021.ks/index/81/text"],["SC_E_021.ks/index/83/text"],["SC_E_021.ks/index/85/text"],["SC_E_021.ks/index/87/text"],["SC_E_021.ks/index/89/text"],["SC_E_021.ks/index/91/text"],["SC_E_021.ks/index/93/text"],["SC_E_021.ks/index/95/text"],["SC_E_021.ks/index/97/text"],["SC_E_021.ks/index/99/text"],["SC_E_021.ks/index/101/text"],["SC_E_021.ks/index/103/text"],["SC_E_021.ks/index/105/text"],["SC_E_021.ks/index/107/text"],["SC_E_021.ks/index/109/text"]],"tags":[],"parameters":[[{"start":149,"end":156}],[{"start":166,"end":167}],[{"start":178,"end":196}],[{"start":207,"end":300}],[{"start":315,"end":316}],[{"start":325,"end":326}],[{"start":335,"end":341}],[{"start":351,"end":376}],[{"start":386,"end":389}],[{"start":399,"end":439}],[{"start":448,"end":449}],[{"start":458,"end":459}],[{"start":469,"end":518}],[{"start":528,"end":529}],[{"start":539,"end":540}],[{"start":549,"end":551}],[{"start":561,"end":589}],[{"start":599,"end":602}],[{"start":611,"end":613}],[{"start":624,"end":653}],[{"start":664,"end":669}],[{"start":682,"end":683}],[{"start":693,"end":699}],[{"start":714,"end":719}],[{"start":727,"end":817}],[{"start":825,"end":915}],[{"start":926,"end":958}],[{"start":975,"end":977}],[{"start":987,"end":1050}],[{"start":1064,"end":1073}],[{"start":1082,"end":1176}],[{"start":1184,"end":1227}],[{"start":1237,"end":1329}],[{"start":1337,"end":1351}],[{"start":1359,"end":1407}],[{"start":1425,"end":1427}],[{"start":1436,"end":1477}],[{"start":1485,"end":1555}],[{"start":1563,"end":1629}],[{"start":1637,"end":1776}],[{"start":1785,"end":1786}],[{"start":1796,"end":1797}],[{"start":1807,"end":1810}],[{"start":1821,"end":1887}],[{"start":1895,"end":1941}],[{"start":1951,"end":1964}],[{"start":1972,"end":2033}],[{"start":2041,"end":2130}],[{"start":2138,"end":2202}],[{"start":2216,"end":2407}],[{"start":2417,"end":2538}],[{"start":2544,"end":2703}],[{"start":2711,"end":2796}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_E_021.ks","basename":"SC_E_021.ks","indexIds":{"●【その一端、":0,"讃":1,"頌】[l]\n\n貴女に":2,"傅くものよりかしこみたてまつるさん。[l]\n\nミてる月のみならず三日月をも侍らさん、[l]\n\nその立ち振る舞いにおいてはまっこと愛くるしく、[l]\n\n":3,"於":4,"菟":5,"啼く歩く夜の":6,"朋、[l]\n\n瞳は月に比されらるも":7,"然り。":8,"声に於いては人心を惑乱せしあの麗しき妹君、[l]\n\n即ちその声は":9,"唆":10,"魅":11,"宣。[l]\n\n我等が従うべきもの白のみるは。[l]\n\n輝ける愛しき":12,"白":13,"透":14,"女。":15,"始祖のハコの騙るを引くに、[l]\n\n肉を":16,"纏うて":17,"降り":18,"顕れる、\nＭとＷの狭間に咬むるるＥ、\n３に":19,"彩られ、\n":20,"四":21,"隈に在る、\n":22,"ωの四海。":23,"Cat、\nDog、\nEmbryo、\nFetus、\nGnosis、\nAnt、\nBee、\n:F、\n:S、\n:N、":24,"完全が故に不完全をも完璧に内包する\n最悪の箱庭で、\n謳おうぞ、母鳥の唄、百鬼絵の黄泉。[l]\nメに布を、月の王の亡くならば、\n我等が友は望みを満たす":25,"輔が為。[l]\n\n我等は白猫愛す。[l]\n\n":26,"白の":27,"讃。[l]\n\nミ・キャミャルキャラモロコネコナメタサキャラ\nタサコネタサメミャラメンカヤコネキャ・ワ。":28,"●【その一端、犬が":29,"負うたこと】[l]\n\n俺は直接その場で視た訳ではないが、\n後々判ってきた事は、\n俺等Ｐメイル由来とは根本から違うあれ、[l]\n\n白のミルハ。":30,"最強にして最凶のねこ。[l]\nあらゆるものを喰う。[l]\n使えるものは":31,"己がミにする。[l]\n不要なものやキライなものは排出する。[l]\n物理的な破壊をせずとも喰えるという（不全の６はこれが出来ない）、\n始祖の教えそのものの体現物。":32,"要するに、\n狩猟者。":33,"輝ける愛しき白透女。[l]\n全ての色を反射する最強の白たる存在。[l]\n狩猟者。":34,"戰さ":35,"場にては絶対なるもの、\n否、戰いですら無い。[l]\n一方的な殲滅。":36,"しかも、[l]\n\n必ずしも効率的ではない行動を執る。[l]\n愉悦を優先し、無為とも思える過程を選択すること間々ある。":37,"あの兄への盲従を貫いてるようにも視えるが、[l]\n\n他者たる俺には想像しか出来ない。[l]\n真意は知れない。":38,"魔眼の刺し手を従えるも、そは愛玩が為だろう。[l]\n今は……まだか、そろそろなのか。[l]\n魔眼の刺し手はあくまで効率化、或いは保険だったはずで、\nミルハにとっては●●も●●●●も●●●●●●●と\n思われる。[l]\nあの兄の、道楽かまたは":39,"蒐":40,"集":41,"者的な":42,"拘りか、\n白と黒の並ぶ美しさに眼目を置いたのかも知れないが、\n俺も彼等の掌中にあったなら面倒な事になっていただろう。":43,"誰かが著した本にあったが、\n狩りには凶暴な喜びがある。[l]\n獲物を前に血の":44,"滾りを抑えることは難しい。":45,"特にあれは、獲物に止めを刺すまでいたぶると言う、\nまさに、まるで、[l]\n\n今のところは大人しい。":46,"チの活用に至るには少々、[l]\n\n甘やかされすぎたか。[l]\n\n猫の王は何をする？[l]\n\n千尋の谷へと突き落とすことはあるのか？":47,"あの妹の為に全てを狂わせたあの兄が、[l]\n\nそんな、[l]\n\n？[l]\n\nあ。":48,"●【その一端、夜伽話】[l]\n\nあるところに、ある兄妹がいました。[l]\n\n（中略）[l]\n\n黒ねこは兄妹の敵でした。[l]\n\nなので兄妹はきりふだを差し向けました。[l]\n\n黒ねこは必死にたたかいましたが、[l]\n\nたましいのぬけたそのからだを、\n９つに裂かれてしまいました。":49,"ひとつには両の手、その爪を。[l]\n\n　ぶきが折られてしまいました。[l]\n\nふたつには皮と眼を。[l]\n\n　みを守るものがなくなってしまいました。[l]\n\nみっつには●●●を。":50,"@r（中略）[l]\n\n最後のひとつ[l]\n\n相手のムクロを仮借することにしました。[l]\n\nねこの１０番目はそういうものだからです。[l]\n\nねこはムクロを操ると、[l]\n\n（中略）[l]\n\n９枚のカミは誰かが持っていってしまい。":51,"黒ねこの１０番目が操るムクロはその後、\n飯守女と子を成して、[l]\n\n……[l]\n\n……[l]\n\nそしてだれもいなくなりました":52},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_E_021.ks","relPath":"/data/scenario/SC_E_021.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":53,"length":53,"percent":100},"cellInfo":[null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"t":"HU","v":1}],[null,{"t":"HU","v":1}],[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[47,0],"note":"完成"},"/data/scenario/SC_E_022.ks":{"data":[["「今夜はまた御愉しみでしたか。[l]\n更新確認もなさったのでしょう？","「今夜也尽兴了吗。[l]\n想必也确认过更新了吧？"],["あれの進行がやや","那个的进展有点太"],["自","自"],["動","然"],["的に過ぎるのが多少気になる所ですが、\nまあ","了有些令人在意，\n不过"],["手","毕竟那家伙不会按套路"],["引通りには行かないのがあれですしね。","出牌呢。"],["今更どっちでもよいですけれど。[l]\n場合によっては早々に組み入れるんでしたか？」","事到如今怎样都无所谓了。[l]\n根据情况或许会提前纳入计划？」"],["「ん－、\nいい加減のらりくらりと","「嗯——\n想随便敷衍着糊弄过去"],["躱すにはフィールドが近すぎたね。[l]\n向こうからこんなに寄ってくるとは思わなかったから……","可这片区域还是太近了啊。[l]\n没想到对方会贴到这种程度……"],["適宜対応というよりは行き当たりばったりだ。[l]\n決められたプロットをなぞるよりは愉快だけど、\n――あの女の意見なんかは知ったことではないけどね。","与其说是随机应变不如说是手忙脚乱。[l]\n虽然比起照着既定的剧情走要有趣得多，\n――不过那个女人的意见关我屁事。"],["兄様や●●には怒られるかな。[l]\n今日も何度かイこうかどうか迷ったんだけど……」","兄长大人和●●可能会生气吧。[l]\n今天也犹豫了好几次要不要去来着……」"],["「流石に準備が無さ過ぎですね。[l]\n獲物の方も未だ赤の女王含め不確定要素が散見してますし、\n残りのCovenの件もある。","「到底还是准备太不足了。[l]\n猎物那边包括赤之女王在内仍有许多不确定因素，\n还有剩余Coven的事。"],["彼に対して――少々スキが増してるんじゃないですか？[l]\n如何にセーブしてあるとは言えあまりに直接的な刺激は\n","对他而言――破绽是不是多了点？[l]\n虽说有save但过于直接的刺激可是会引发\n"],["励","强烈反应"],["起を引き起こしますよ。","的。"],["まあ方針転換された今、早めに戦力とするも良しかと。[l]\nどちらでも、ワタシが決めることではありませんが、\n知らさぬままに事を進めるには向こうの接触が\n積極的過ぎるでしょうね。","不过既然方针已变，尽早将其收为战力也不错。[l]\n无论哪种，都不是我能决定的，\n想暗中推进的话对方接触\n未免太积极了些。"],["どの彼を引くにせよいずれ歪みが生まれる訳で、\n多角的な意味合いで限界が来る前にフラグの起動はするが吉です。[l]\nさて、Kaleidoが報告をしてきたそうで。[l]\nこちらにも先立って仮報告が来てましたが」","无论引导哪个他都会产生扭曲，\n从多角度考量最好在极限到来前启动flag。[l]\n对了，听说Kaleido提交了报告。[l]\n我们这边也提前收到了临时报告」"],["「ああ、連絡来たよ。[l]\nあんまりメインのシナリオルートには\n絡まないイヴェントだとかなんとか……","「啊，联系来了。[l]\n说是不会太涉及主线剧情路线\n的事件之类的……"],["言いたいことは解ったけど、\n実際問題として私のキャパをオーバーしそうだから\nこっちに介入させないようにするってさ。","想表达的意思我明白了，\n但实际问题在于这会超出我的能力范围\n所以让我别插手这边的事。"],["Kaleidoに言われると馬鹿にされてる気になるけどね、\n今話してた通り、既にプロットを離れた劇になってるこれに対して、\n私が仕切りとして経験浅いのは事実だ、\n甘んじて聞き入れるとするよ」","被Kaleido这么说总感觉像被小瞧了，\n不过正如刚才所说，面对这个已经脱离原定剧本的剧情，\n我作为负责人确实经验尚浅，\n就老老实实接受吧」"],["「何事も経験ですね。[l]\n経験は黄金なりですよ。[l]\nん？[l]\n無いでしたかねそんな格言は。","「凡事都是经验呢。[l]\n经验可是黄金啊。[l]\n嗯？[l]\n好像没这句谚语来着？"],["まあどっちでもいいです。[l]\nええ、なんですか、Kaleidoは？","嘛无所谓啦。[l]\n对了，Kaleido那边怎么说？"],["残りの連中と合流し首実検した上で、\n結果未確定要素はあるがフェンリロスを信ずるならば、\nあの、あれのあれであるところのあれだと」","说是和其他人汇合确认过后，\n虽然存在不确定因素但只要相信芬里洛斯的话，\n那个...就是那个那个的...那个来着」"],["「そう、あれのあれたるあれだよ。[l]\nうん、フェンリロス……検索能力に関しては今のところに於いて、[l]\n当代きっての猫だからね。","「对，就是那个所谓的那个。[l]\n嗯，芬里洛斯...就搜索能力而言目前[l]\n可是当代顶尖的猫呢。"],["信じない理由は無いなぁ。[l]\n彼女自身も言っていたけど、\n寧ろ、","没有理由不相信啊。[l]\n她自己也曾说过，\n倒不如说，"],["彼の近辺に居た事も、九相異羽が在ったあの土地に居た事も、\nご都合主義と言うよりは『雫』の『雫』たる所以とも言える、\nと言う意味では、喜ばしいことではあるね」","无论是曾在他身边待过，还是曾身处存在九相异羽的那片土地，\n与其说是巧合不如说是体现『雫』之所以为『雫』的特质，\n从这个意义上说倒是值得高兴的事」"],["「彼女の親和性も得難い逸材ではありますし、\n今回のゲェムには絡まないという前提で、\n親交は一層深めてもらいたい所です。","「她那份亲和力也是难得的人才，\n既然前提是不参与这次游戏，\n希望能进一步加深交情。"],["hybridizeがどうなるか、\n場合に依っては貴女に有益な事となるかも知れませんね。[l]\nまあそれはいずれの話で。","hybridize会如何发展，\n说不定在某些情况下对你也有益处。[l]\n不过这都是后话了。"],["まずはこれですね。[l]\n待機組含め全員が『ね","先处理这个吧。[l]\n包括待机组在内全员似乎都被安排到『"],["こざん","猫之"],["まい』に配置された\nようなので改めましてCovenのリストです。","团』了\n所以重新确认下Coven名单。"],["何しろ今回は","毕竟这次"],["和 ","和 "],["名が\n全員に割り振られていますので。[l]\n既に使用してる者に関してはそれで継続しています」","名（译注：日式名字）\n都分配给了所有人。[l]\n已经在使用的成员就继续沿用」"],["「ああ、面白がって","「啊，一时兴起"],["名なんか付けちゃって悪かったね。","乱取名真是抱歉啦。"],["兄様はこの國の文化がお気に入りだからどうしてもね。[l]\n私の現居住地たる手前もあるけどさ勿論。[l]\nこういう設定作り込むのは燃えるんだよ」","兄长大人实在太喜欢这个国家的文化了。[l]\n虽然也有我现在居住地的原因啦。[l]\n这种设定搞起来很带感嘛」"],["「どうぞお構いなく。[l]\n私も好きでこの役やっていますので。","「请别在意。[l]\n我也是自愿担任这个角色的。"],["とは言え、\n精査が要るかも知れませんがね『","不过话说回来，\n可能需要仔细核查下『"],["茶","茶"],["黒の首』に関しては。","黑之首』的情况。"],["フェンリロスでは検索走査はできても同定は難しく、\nまして適切な処置施行するスキルはそれ程――\nああ、今更貴女には言うまでもない事ですが。[l]\n手が空いたら私のペイルホワイトで審問しましょうか」","芬里洛斯虽然能进行搜索扫描但难以精确定位，\n更何况实施适当处理的技能也没那么――\n啊，现在对你说这些倒是多余了。[l]\n等有空就用我的佩尔怀特来审问吧」"],["「んむ、\n先刻も言ったけどね、\n絡ませないのならそれで良いんじゃないかな？[l]\n向こうでせいぜい宜しくやってて貰うさ、\nKaleidoがなんとかするって言ってるし」","「嗯唔，\n刚才也说过了，\n不让他们参与的话这样不就好了？[l]\n就让那边自己好好处理吧，\n反正Kaleido说了会想办法的」"],["「彼女の猫ではなくて彼女自身の裁量によるのは、\nワタシ個人には不安も残りますがね。[l]\n雄雌間の機微には疎いもので。","「不是她的猫而是她本人的判断，\n我个人还是有些不安呢。[l]\n对男女之间的微妙之处实在不太了解。"],["及びもつかない自信の裏付けやバックボーンが\n在るのかも知れませんが、\n最悪Enderにはそこで鬱憤を晴らして貰うという手も\nありますか。","或许背后有着难以企及的自信依据和靠山\n也说不定，\n最坏情况下让Ender在那里发泄怨气\n也是个办法吧。"],["ええ、貴女がそう仰るならどっちでもいいんですがね。[l]\n――さて、ご自身で作成なさったのですから\n周知の事とは思いますが。","嗯，既然您这么说那怎样都无所谓啦。[l]\n――话说，既然是您亲自制作的\n想必是众所周知的事了。"],["メモを取らないと物事をお忘れになる貴女の為に、\nどうぞ、これですね。[l]\n誤記等無いかご確認を。[l]\n御眼をお通し下さい」","为了容易忘事的您，\n请收下这个。[l]\n请确认是否有误记等情况。[l]\n请您过目」"],["WC_001:GM\n真然名無（ましかりなな）\nジャバンダスウォナッチア[l]\n\nWC_Sc&TO:ThousandBrains\n千野チノ\nペイルホワイト[l]\n\nWC_Sc:KaleidoScope\n雨山かれお\nフェンリロス[l]\n\nWC_B:Ender:333\n尾張（おわり）みみみ\nテトルジャトートリス（Ig:TYPE･E）","WC_001:GM\n真然名无（ましかりなな）\n贾班达斯沃纳奇亚[l]\n\nWC_Sc&TO:ThousandBrains\n千野千乃\n佩尔怀特[l]\n\nWC_Sc:KaleidoScope\n雨山卡蕾欧\n芬里洛斯[l]\n\nWC_B:Ender:333\n尾张（おわり）咪咪咪\n泰托尔贾托托利斯（Ig:TYPE･E）"],["WC_STG:Iron\n愛染（あいぜん）アイ\nｖ☆（ヴァーチュラクドスター）[l]\n\nWC_HTG:Call=R=W\n酒井（さかい）アルコ\nババッカナーリャガー[l]\n\nWC_MP:Shackle\n木加（こが）サクラ\nフロシルク[l]\n\nWC_CTL:Zenon\n五六禅（ごろくぜん）\nペンパラミータ","WC_STG:Iron\n爱染（あいぜん）亚衣\nv☆（Vāchūrakdostā）[l]\n\nWC_HTG:Call=R=W\n酒井（さかい）阿露子\n巴巴卡纳里亚加[l]\n\nWC_MP:Shackle\n木加（こが）樱\n弗洛希尔克[l]\n\nWC_CTL:Zenon\n五六禅（ごろくぜん）\n彭波罗米塔"],["WC_NK:AntLion\n白雨（はくう）カゲロウ\nコモンマイトサス[l]\n\nWC_NK:Beehive\n八重洲（やえす）うら\nライヒェンカチェ[l]\n\nWC_NK:-cide\n水小月（みおづき）シカネ\nスロタラスモルト[l]\n\nWC_ESS:BoobyAce\n灰野（かいの）ささこ\nヨォクリサリス","WC_NK:AntLion\n白雨蜉蝣\n科蒙迈特萨斯[l]\n\nWC_NK:Beehive\n八重洲卯良\n莱兴卡切[l]\n\nWC_NK:-cide\n水小月鹿音\n斯洛塔拉斯莫尔特[l]\n\nWC_ESS:BoobyAce\n灰野纱纱子\n约库利萨里斯"],["「と言う訳で、誤記というよりは変更の事後承諾ですが、\n今回は私TOも兼任してます。[l]\nん？逆か。[l]\nSc兼任ですね。","「因此，与其说是误记不如说是事后认可变更，\n这次我也兼任了TO。[l]\n嗯？反了。[l]\n是兼任Sc啦。"],["どっちでもいいですが。[l]\nちゃんと伝わってなかったようで申し訳在りません」","不过怎样都无所谓。[l]\n没能传达清楚实在抱歉」"],["「本来メインのScのはずだったKaleidoScopeが\n特例になったからね。[l]\nしょうがないよ。[l]\nまあ言うとおりどっちでもいいことさ。","「本该是主Sc的KaleidoScope\n成了特例嘛。[l]\n没办法呀。[l]\n反正就像你说的怎样都行啦。"],["んむ、それにしても――\nEnderナンバーも元ESも揃い踏みか……[l]\n贅沢な面子、というよりは出し惜しみのしようが無いという\n台所事情かな？","嗯，不过话说回来――\n连Ender编号和前ES成员都齐聚一堂……[l]\n与其说是豪华阵容，不如说是\n家底掏空了吧？"],["今回は手を抜ける劇でも無いし、\n別に悪いと言うつもりは無いけど」","这次可不是能偷工减料的剧目，\n虽然我并没有说这不好的意思」"],["「ああ、加えて言いますがね。[l]\nメモと言えば、Kaleidoが愚痴ってましたよ。[l]\n幸い内容は明確に記憶していますので今此処で\n再現させていただきます。","「啊，顺便补充一句。[l]\n说到备忘录，Kaleido可是抱怨了不少。[l]\n幸好内容我记得很清楚，现在就在这里\n给您复述一遍。"],["『これ以上事を連結させると――店長切れてしまいますでしょ。[l]\n只でさえメモを取らないと駄目なのに、\nそうですよ。私のPHASE:9だって\n名前覚えてくれないじゃないですか。","『要是再把事情串联下去――店长会发飙的吧。[l]\n本来不记备忘录就不行，\n就是啊。连我的PHASE:9\n都不肯记住名字呢。"],["異","是异"],["羽ですよ。憑羽だのコトワだのは通称蔑称その他諸々ですっ。』[l]\n以上は彼女の言い","羽哦。什么凭羽啊言羽啊都是通称蔑称之类的啦。』[l]\n以上就是她的"],["分でした」","原话」"],["「解ったって。[l]\nコ・ト・ハ・ネ、ね。[l]\nPHASE:9、ＷＷ。","「知道啦。[l]\n异·羽，对吧。[l]\nPHASE:9，WW。"],["その話で言うなら、\nヤソウだろうとハッソウだろうと\nどっちが正しいって事もないのになあ。","要这么说的话，\n野蔷薇也好八蔷薇也罢\n本来就没有哪个是正确的嘛。"],["キミのペイルホワイトだって\n●●が視れば『蒼白穿』とかになるんだろう？","就连你的佩尔怀特\n●●看了也会变成『苍白穿』之类的吧？"],["訳者が絡んだ時点で本質そのものじゃないし\n感得する以外の何物も単なる便宜上の仮名に過ぎないものに\n拘泥してもしょうがないじゃないか。","既然有译者介入就已经偏离本质了\n除了感知之外的其他称呼都不过是权宜之名的东西\n纠结这些又有什么用呢。"],["だったら文字列そのものに図像的意味合いをヨめるのが良いのに、その解釈の揺らぎを愉しめないなんて魔眼質の者としてどうだろう」","还不如享受字符串本身蕴含的意象呢，连这种解读的摇摆都无法享受的话还算什么魔眼持有者」"],["「コトハネに関しては店長がズボラなだけですっ」","「言羽这个叫法纯粹是店长太懒啦」"],["「もういいよキミのそのimpersonationも。[l]\n相変わらず気味悪いくらい似てるしっ。","「够了够了你这模仿秀。[l]\n还是老样子恶心人的像呢。」"],["それにKaleido、\n私のPHASE:9って、\nあの","而且Kaleido，\n我的PHASE:9啊，\n那个"],["娘だってすっかりその気じゃないか」","丫头不也完全是那种心思吗」"],["「彼女と親和してるのは事実ですし、\n現状他の者を捜すのは現実的ではないですからね。","「她和那个存在亲和是事实，\n现阶段找其他人也不现实。"],["猫を二体遣うだけのキャパは持ってますし――\nいずれ書き換え組み換えによって一本化が出来るかも知れず、\nそうなれば虎に翼を与える事も可能かと」","我倒是能同时驱使两只猫――\n说不定哪天通过改写重组就能统一，\n那样的话给老虎添翼也是有可能的」"],["「まあ今や我々も新規の人員を捜すのは困難だって事だな。[l]\n如何に魔眼を持とうとも、\nウタをヨめない連中ばかりになって悲しい限りだよ。","「看来我们现在也很难招募新人了。[l]\n就算持有魔眼，\n净是些无法咏唱的家伙真是悲哀啊。"],["歌は対人用実践魔術の究極だっていうのに、\n被術者側の","明明歌曲是对人实战魔术的极致，\n受术者那边的"],["鈍","迟"],["麻が過ぎてまるで耐性１００％じゃないか……","钝得简直像100%抗性……"],["狙いがそもそも違うにしても、あれらも毎年ご苦労な事だね。[l]\nま、故に彼にも期待がかかるって訳だ。","虽说目标本来就不对，那些家伙每年也够辛苦的。[l]\n嘛，所以才会对他有所期待吧。"],["さて、\n――Kaleido達が言うにはどうやら雫である事はいよいよ確定\nとみて良いのか。[l]\n","话说，\n――按Kaleido他们的说法，看来雫的身份终于能确定\n了吧。[l]\n"],["Ｄまでがこういう形で此の時、此の場に揃ったんじゃあね……」","D级全员以这种形式在此刻此地齐聚的话……」"],["「我々も始祖のように稀少事象の立会人に成り得るかと。","「我们或许也能像始祖那样成为稀有事件的见证人。"],["過去の雫を調べる限り、paradigm shiftを起こしはすれども\nそれが是か非かは――\nまあどちらでもいいんですがね。[l]\nいずれ――」","根据对过往雫的研究，虽然会引发范式转移\n但这是对是错――\n嘛怎样都无所谓啦。[l]\n反正――」"],["「たとえ単なるchaosになろうと、\n兄様が言うようにDeus ex machinaが顕現するならばまあ、\n一応の収束はしてくれるんだろうが、","「即便最终只是chaos，\n只要像兄长说的那样有Deus ex machina显现的话，\n姑且能迎来某种程度的收场吧，"],["それに期待するのはあまり賢い手ではないからなぁ。[l]\nとは言え不正操作","不过指望这个可不太明智呢。[l]\n话虽如此违规操作"],["紛いの手は――」","这种掺假手段――」"],["「そもそもが","「说到底"],["遊","游"],["戯、娯楽なれば。[l]\n貴女のお好きにするが好いかと。[l]\nご面倒であれば円卓を返すが如く、\n彼の時の様に殲滅衝動に任せるのも一興」","戏，娱乐而已。[l]\n随您喜好便好。[l]\n若嫌麻烦便如归还圆桌般，\n像彼时那般任凭歼灭冲动亦不失为一乐」"],["「今度の事は兄様の言い付けだからそうも出来ないよ。[l]\n……まあ、泣き付けば大目に見てくれるとは思うけどっ」","「这次的事既是兄长大人吩咐就不好这么办啦。[l]\n……不过哭诉的话应该会被网开一面吧」"],["「そう言えば司書長は、今回の和名に関して何か仰られていたとか」","「说起来司书长对本次和名之事可有指示？」"],["「んむ？[l]\nああ、ちょっとだけ褒められた……というか愉しんで","「嗯唔？[l]\n啊、稍微被夸奖了……或者说被津津有味地"],["呉れた[l]\nってさ。","品味了[l]\n呢。"],["兄様も結局この國の、\n使役する國語が単一な割には外来語を自國語に\nローカライズし混在使用する事には慣れている、","兄长大人终究还是中意这个国度\n明明是个以单一国语为官方用语的国家却惯于将外来语本土化\n混杂交织使用的"],["という特異な状況故に色んな言葉遊びが可能だっていう、\nカオスな感じが好みなんだって。","这般特异情境催生的种种文字游戏，\n说是喜欢这种混沌感呢。"],["まあ確かにアルファベータ２６数ではアナグラム、\n踏韻遣うにしてもなかなかね、\n兄様お気に入りのあの妖怪絵図のように多重に意味を込める\n事は難しいかもなあ。","确实仅靠26个字母玩变位词\n或押韵总归受限，\n像兄长钟爱的那幅妖怪图鉴般多重隐喻\n恐怕难以实现吧。"],["見立てる事が肝要なんだよ、愉しむにはね。[l]\nモティーフが一個だけなんて短絡的に過ぎる、\n常に多重に意味が掛かってないとさ。","联想力才是关键呢，要享乐的话。[l]\n单一动机太过直白，\n须得始终贯穿多重含义才行。"],["まあ、\n私と兄様の趣味だけどっ。[l]\nキミも同類だろ？","当然，\n这是我和兄长大人的癖好啦。[l]\n你也是同类吧？"],["大体魔眼質ってのはそういう連想連結が出来る資質と被るはず\nなんだがな。[l]\nそういう意味でこの國にはまだ可能性が……[l]\n時代や世代的にすっかり向かなくなってる節もあるけどね。","魔眼资质本该与这类联想连结的素质重合\n才对。[l]\n就此意义而言这个国度尚存可能……[l]\n不过，也有些地方已经完全跟不上时代和世代的潮流了啊。"],["残念な事だよね。[l]\n先刻のウタの件にしてもそうだけど……」","真是遗憾呢。[l]\n方才歌词之事亦是如此……」"],["「我々はこうして嗜好品を味わうが如く\n思考の上での遊戯も出来ますが、\nKaleidoは実地で『あの』面々を『あの』名で紹介する羽目に\nなったと憤慨してましたがね」","「我等品味嗜好品时\n亦能进行思维游戏，\n不过Kaleido正因被迫用『那个』名字实地介绍『那群』人\n而愤慨不已呢」"],["「あー、\n","「啊——\n"],["真","真"],["逆身内以外に名乗る機会が在るとは思わなかったからな…","没想到会有向非己方者报上名号的机会…"],["これも雫の影響と思えばほら、不可避な事故の一つや二つ――\n…にしても、自分で仕込んでおいて何だけどね、[l]\n一体どんな言い訳したんだろうな。[l]\n結局苦しい誤魔化ししたのかな？","若视为雫的影响倒也罢了，这种不可避免的事故――\n…虽说是自己埋下的祸根，[l]\n到底编了什么借口呢。[l]\n最后勉强搪塞过去了吗？"],["Kaleidoだから逆に大目に見て貰えたかもね。[l]\n","或许正因是Kaleido反而被宽恕了吧。[l]\n"],["Ｄが従順で助かったという訳か。[l]\n我等が","看来D的温顺帮了大忙呢。[l]\n与我等"],["Ｃとは大違い、故に愉悦の極みたる我等……」","C大相径庭，故而抵达愉悦极致的我等……」"],["「そういった意味でも彼女はＤを籠絡出来ると想定して\n進言してきたのでしょうがね。","「她也是料定能笼络D\n才来进言的吧。"],["さて、先程の続きですが。[l]\n","那么继续方才话题。[l]\n"],["殊この國の文化に於きましては、\n見立て、駄洒落、狂歌絵、語呂合わせ、","尤其此国文化之中，\n比拟、谐音、狂歌绘、双关语，"],["そういったいわば卑俗的と称されがちな根拠において\n成り立った成句や行事祭日、祭祀祭儀の類が\n多く在るわけですから、","诸如此类常被贬为粗俗的根基上\n孕育的惯用语与节庆祭祀，\n可谓层出不穷，"],["何を以てして何を境目に高尚たる成立経緯若しくは起源とみなすか、\n語源やモチーフがそもそもimitative magic的な経緯が根底に\nあるのなら、或いはcontagious magic的に推移する理論は、","究竟以何标准界定高尚的由来或起源，\n若词源动机本就基于模仿巫术的脉络，\n或接触巫术衍生的理论，"],["原始的であるが故に脳生理学的にも多少説明出来ると考えるのも\n","因其原始性反倒能从脑生理学角度解释，\n"],["強ち大きなズレではないかも知れませんね。","或许未必算太大偏差吧。"],["いずれにせよ由来に何を視るかは、\nそれこそこの國で云う『","归根结底如何看待渊源，\n恰如这国度所谓『"],["粋』の領域、\n例によって各人の好みということですかね。","粹』之境界，\n终究还是各人喜好的问题呢。"],["思索自体を愉しむのがワタシの愉しみ方ですから\nどっちでもいいんですが。[l]\n多くをカタれども無粋にならぬよう心掛けるが肝要です」","享受思考本身正是我的乐趣所在\n哪边都无所谓啦。[l]\n「虽道尽千言仍须谨记避免流于庸俗最为要紧」"],["「与えられた材料で余白を想像するのが\nゲェムってね。[l]\n私も兄様に仕込まれたから勿論そういうのは歓迎できるよ。[l]\n遊戯はやはり余暇活動の一種だからね。","「用给定的材料去想象留白部分\n就是Game哦。[l]\n我也是被兄长大人调教过的所以当然欢迎这种玩法。[l]\n游戏终究只是闲暇活动的一种嘛。"],["予定調和だろうと裏切りだろうと、\n辛い眼前の現状からの逃避先、気分転換としての機能が在る程度は\nないと本末転倒だと思うけど。","无论是按部就班还是意外反转，\n作为逃避痛苦现实的去处、转换心情的功能性总该\n具备些才行否则就本末倒置了。"],["とは言え無論単なる一義的では思索のしがいもないからね。[l]\nその為のこの箱庭な訳だし。","不过话说回来若只是单线剧情也缺乏思考价值呢。[l]\n所以才需要这座箱庭呀。"],["え、思索以外の部分？[l]\n問題提起とそれの解決もゲェムの一種には違いないけど、\n反復と穴埋めもゲェムとしての欲求を充足たり得る要素なんだ\nよね、私……というか兄様の場合」","呃、思考以外的部分？[l]\n提出问题并解决它确实也算是一种游戏，\n但重复和填空也能满足作为游戏的欲望要素\n对吧，我……或者说哥哥的情况」"],["「さて、では我々のゲェムはどうなりますかね。[l]\nNote殿は『次のゲェム』を","「那么，我们的游戏会变成怎样呢。[l]\nNote大人正在"],["計 ","筹 "],["画されているとか、\nその司書長の命で」","划『下一场游戏』，\n据说是那位司书长的命令」"],["「兄様の？[l]\nいや、次、って何だ。[l]\n兄様が私に関係無い事をするか？[l]\nそれとも私にも秘密なのか？","「兄长大人？[l]\n等下，『下一场』是什么意思。[l]\n兄长大人会做与我无关的事吗？[l]\n还是说连我也要瞒着？"],["噂とか洩れ聞こえたとかじゃないんだね？[l]\nあの女が最近動いてるのはそれなのか？」","既非谣传也不是道听途说？[l]\n那个女人最近行动就是因为这个？」"],["「ワタシの網に掛かった情報ではありますが、\n出所が司書長ソースなだけにどこまで客観的事実か、\n不正操作が入ったのかは何とも言えませんね。","「虽说是落入我情报网的消息，\n但既然来源是司书长，究竟有多少客观事实，\n是否存在篡改操作都难以断言呢。"],["そういう意味で巷説と変わりませんが。[l]\n貴女の耳に入れるか否か迷いましたが――\nこうして今云ってしまいましたので今更ですが。","从这个意义上讲与市井传闻无异。[l]\n本犹豫是否要告诉你――\n既然现在已说出口就没办法啦。"],["Note殿の動きに関しては何とも。[l]\n御存知の通り彼女はワタシの遙か以前より籍を置く\n001:GMナンバーです。[l]\n司書長の代行者たる者の御心を窺い知るなどとても」","关于Note大人的动向实在难以揣测。[l]\n如您所知她早在远古时代就拥有\n001:GM编号的资格。[l]\n想要揣度司书长代行者的圣意根本」"],["「……常に","「……总是"],["言の上を行こうとすると切りがないね、[l]\n最終的には馬鹿って言った奴が馬鹿！[l]\nのパラドックスに陥る虚しさが――","纠结言语表象就没完没了了，[l]\n最后只会陷入说别人傻瓜的自己才是傻瓜！[l]\n这种悖论的虚无中――"],["ま、\n兄様の為す事は無条件で受け入れるのがその猫たる最強の白の\n立場だし役割だし特性だし信条だし身上だし心情だしっ。[l]\n今は為すべき事を成す、それからだね。","嘛，\n无条件接受兄长大人所作所为正是身为最强之白的猫的\n立场也是职责也是特性也是信条也是本质也是心情也是啦。[l]\n现在先完成应做之事，之后再说吧。"],["だけど……[l]\nNoteが単体で動いてる訳じゃない可能性か……[l]\nしかも独断でないとしたら――んむ……」","不过……[l]\nNote单独行动的可能性吗……[l]\n若并非独断专行的话――唔……」"],["「まあ、\nどっちでもいいですが。ワタシは。[l]\nもしもの時は貴女につきますよご心配なさらずとも」","「哎呀，\n怎样都好啦。对我来说。[l]\n万一出事我会站在你这边的请放心」"],["「え。そんな大層な事になるかな。[l]\n代行者なんて良いモノなものか。[l]\nあの女は","「咦。会闹到那种地步吗。[l]\n代行者算什么好东西。[l]\n那个女人"],["烏","恬"],["滸がましくも兄様の","不知耻地以兄长大人"],["側","侧"],["女気取りだ\nからね、\n兄様の――そう、私の","室自居\n呢，\n兄长大人的――没错，我"],["厭う事など出来る訳が――」","怎么可能会去厌恶――」"],["「しかしながら致し方なきことですか、\n彼女の存在自体を","「但终究无可奈何吧，\n即便打心底里厌恶她的存在"],["厭うても未だ消すこと叶わずは。[l]\nワタシは彼女に役職上の関心以外に感想を持ちませんが、\n機械の如き、執着なしが故の覚悟は学ぶところ多しですよ。","却也无法将其抹杀。[l]\n我对她除职务上的兴趣外别无感想，\n但像机器般毫无执着的觉悟确实值得学习呢。"],["ですから","所以"],["若しやとも思うのですが。[l]\n三分の一を率いて堕するものか、\n命じられて必要悪となるものか――」","我甚至在想——[l]\n是率领三分之一坠落呢，\n还是奉命成为必要之恶呢――」"],["「……もうこれくらいにしようか、[l]\nあの女の話は。[l]\n何の話だっけ？」","「……差不多该结束这个话题了，[l]\n关于那个女人。[l]\n刚才说到哪儿了？」"],["「世間を見る限り正義は畏怖であり邪は甘美なのですがね。","「就世间所见，正义令人畏惧而邪恶甘之如饴。"],["この國における地獄も、\n在る側面では究極の善の顕れのはずですが、\n土俗の諸々が根底に在る所為か、\n裁判長もその獄卒も、悪鬼羅刹と変わらない。","这个国家的地狱，\n在某个层面上本应是至善的体现，\n但因底层充斥着各种土俗信仰，\n审判长和狱卒都与恶鬼罗刹无异。"],["さて規範基準を設けたという条件下では、\n正邪とは規範を逸脱したか否かのみで判別は出来るのでしょうが、\n規範自体の是非は問わずという制限ありきですしね。","在设定规范标准的前提下，\n正邪只能通过是否偏离规范来判断，\n但前提是不追究规范本身的合理性。"],["律された世界と奔放な世界のいずれが望まれるのか――\n天使も悪魔ももはや語るまでもない混乱、\nまあヒトがヒトの間で通用させるべく作り上げた通念が\n擬人化存在なのは当然として、","被律法约束的世界与放纵的世界孰优孰劣――\n天使恶魔都难以说清的混乱中，\n人类为彼此沟通构建的概念\n被人格化也是理所当然，"],["まあ文化を題材とした話題にて本質と由来と現状の使用法の差違を語った所で、さしたる意味もないですがその建前を根拠に騙る訳には参りませんで、器たる肉に準ずるものと知れと\n始祖の言にもあります。","即便讨论文化题材中本质、起源与现状的差异，以这种表面理由自欺也不行，须知器皿终归依附于肉体\n始祖也曾说过。"],["思考の原理はさておいて、\n実際我等ヒトの身にて想像出来るのは、\n完全なる律であるが故にあらゆる奔放さも含むという\n最悪の箱庭たるこの世界ですかね。","暂且不论思维原理，\n实际以人类之身能想象的，\n只有这个包含所有放纵的绝对律法\n所构成的最恶劣箱庭世界吧。"],["是","此"],["又始祖のカタり","亦如始祖"],["給うた通りです。[l]\nまあ、ヒトの肉が要に応じて練り上げた意思伝達機構の一環たる言語が全てを表せるモノではない以上、\nruleの外側ではどうでもいいものなのですが」","所言。[l]\n毕竟人类肉体为需求构建的语言传达机制，本就不能表达全部事物，\n在rule之外都无关紧要」"],["「そう、\nセカイはスキかキライか、\n","「没错，\n世界无非喜欢或讨厌，\n"],["殊に我等に於いては、\n覚悟と責を以て闘うのみだ、ね。","尤其对我们而言，\n唯有带着觉悟与责任战斗。"],["――ところでホントにそんな話だったかい？[l]\nまあいいや、いつもの事だ。","――不过刚才真是聊的这些吗？[l]\n算了，反正日常如此。"],["にしても……[l]\n元より我等に『シカイシャホン』がある訳ではないにしろ、\n一筋縄では行きかねる要素も散見し出してるね。[l]\n彼にも色々として貰う日はやはり思ったよりも早くなるか――","即便如此……[l]\n虽说我们本就没有『思考者本位』，\n但已能看到不少棘手因素了。[l]\n让他出手的日子恐怕比预期更早――"],["お、\nさて、もう夜も明けるのか。[l]\n今日も","哦，\n天快亮了啊。[l]\n今夜"],["夜","也"],["伽を有難う。","感谢相伴。"],["ペイルホワイトにも宜しく、\nちゃんとお休みよ」","代我向佩尔怀特问好，\n好好休息」"],["「仰せの","「谨遵"],["儘に。[l]\n白と黒の揃うは近し――\n赤の女王と眷属も劇の舞台に立つでしょう。","吩咐。[l]\n黑白齐聚之日将近――\n赤之女王与眷属也将登上舞台。"],["では一つ、辞する前に。[l]\n自分以外は全て他者です。自分ではない。[l]\n貴女には、……何でしたか、釈迦に説法？[l]\nかもですが。","临别前容我说一句。[l]\n除自己外皆是他者。非我。[l]\n对您说这些……算班门弄斧？[l]\n或许吧。"],["どっちでもいいですがね。[l]\nご自愛を、白のミルハ、\nOmegaの瞳の祝福あれ」","都无所谓了。[l]\n请保重，纯白的米尔哈，\n愿Omega之瞳赐福」"],["「あ、そうそう。[l]\nこっちも最後に。[l]\nやっぱりメモしないと忘れるなぁ……[l]\nあのね、やっぱりケルベ＝ロアが来てるようだよ」","「啊，对了。[l]\n这边也最后说一句。[l]\n果然不记下来就会忘记呢……[l]\n那个啊，果然凯尔贝＝萝亚好像来了哦」"],["「例の？[l]\nつまり」","「那个？[l]\n也就是说」"],["「九割九分、\n赤の女王も来てるってことだね。[l]\n今回の祭儀は彼女等にとっても特殊という事か。","「九成九，\n赤之女王也来了呢。[l]\n这次的祭仪对她们而言也很特殊吧。"],["それよりケルベ＝ロア、\n擬似とは言え流石はPHASE:10実装型の八人姉妹のねこ、\n肉としても黒に近しい『ＷＥ（素晴らしき８匹）』\nのことだけはあるか。","比起那个，凯尔贝＝萝亚，\n虽说是拟似态但不愧是PHASE:10实装型的八姐妹之猫，\n作为肉体也接近黑色的『WE（绝妙的8只）』\n确实名不虚传呢。"],["って、感心してる場合じゃないんだけど。[l]\n彼にも気付きかけたようだから、\nCovenの何人かは早めに召集した方がいいかも。","虽然现在不是感慨的时候。[l]\n因为他似乎也察觉到了，\n或许该提前召集部分Coven成员。"],["人選は任せるからさ、\n綻びないよう宜しく。","人选就交给你了，\n请确保万无一失。"],["何か他にも忘れてるコトあったような気もするけど――\nじゃ、今度こそ、お疲れ。[l]\nOmegaの瞳の祝福あれ」","总觉得还有其他忘记的事――\n那这次真的辛苦了。[l]\n愿Omega之瞳赐福」"]],"context":[["SC_E_022.ks/index/1/text"],["SC_E_022.ks/index/3/text"],["SC_E_022.ks/index/5/text"],["SC_E_022.ks/index/7/text"],["SC_E_022.ks/index/9/text"],["SC_E_022.ks/index/11/text"],["SC_E_022.ks/index/13/text"],["SC_E_022.ks/index/15/text"],["SC_E_022.ks/index/17/text"],["SC_E_022.ks/index/19/text"],["SC_E_022.ks/index/21/text"],["SC_E_022.ks/index/23/text"],["SC_E_022.ks/index/25/text"],["SC_E_022.ks/index/27/text"],["SC_E_022.ks/index/30/text"],["SC_E_022.ks/index/32/text"],["SC_E_022.ks/index/34/text"],["SC_E_022.ks/index/36/text"],["SC_E_022.ks/index/38/text"],["SC_E_022.ks/index/40/text"],["SC_E_022.ks/index/42/text"],["SC_E_022.ks/index/44/text"],["SC_E_022.ks/index/46/text"],["SC_E_022.ks/index/48/text"],["SC_E_022.ks/index/50/text"],["SC_E_022.ks/index/52/text"],["SC_E_022.ks/index/54/text"],["SC_E_022.ks/index/56/text"],["SC_E_022.ks/index/58/text"],["SC_E_022.ks/index/60/text"],["SC_E_022.ks/index/62/text"],["SC_E_022.ks/index/64/text"],["SC_E_022.ks/index/66/text"],["SC_E_022.ks/index/68/text","SC_E_022.ks/index/74/text"],["SC_E_022.ks/index/70/text"],["SC_E_022.ks/index/72/text"],["SC_E_022.ks/index/76/text"],["SC_E_022.ks/index/78/text"],["SC_E_022.ks/index/80/text"],["SC_E_022.ks/index/82/text"],["SC_E_022.ks/index/84/text"],["SC_E_022.ks/index/86/text"],["SC_E_022.ks/index/88/text"],["SC_E_022.ks/index/90/text"],["SC_E_022.ks/index/92/text"],["SC_E_022.ks/index/94/text"],["SC_E_022.ks/index/96/text"],["SC_E_022.ks/index/98/text"],["SC_E_022.ks/index/100/text"],["SC_E_022.ks/index/102/text"],["SC_E_022.ks/index/104/text"],["SC_E_022.ks/index/106/text"],["SC_E_022.ks/index/108/text"],["SC_E_022.ks/index/110/text"],["SC_E_022.ks/index/112/text"],["SC_E_022.ks/index/114/text"],["SC_E_022.ks/index/116/text"],["SC_E_022.ks/index/118/text"],["SC_E_022.ks/index/120/text"],["SC_E_022.ks/index/122/text"],["SC_E_022.ks/index/124/text"],["SC_E_022.ks/index/126/text"],["SC_E_022.ks/index/128/text"],["SC_E_022.ks/index/130/text"],["SC_E_022.ks/index/132/text"],["SC_E_022.ks/index/134/text"],["SC_E_022.ks/index/136/text"],["SC_E_022.ks/index/138/text"],["SC_E_022.ks/index/140/text"],["SC_E_022.ks/index/142/text"],["SC_E_022.ks/index/144/text"],["SC_E_022.ks/inde