":7659,"end":7723}],[{"start":7755,"end":7802}],[{"start":7816,"end":7906}],[{"start":7920,"end":7943}],[{"start":8059,"end":8119}],[{"start":8133,"end":8174}],[{"start":8188,"end":8247}],[{"start":8261,"end":8323}],[{"start":8360,"end":8369}],[{"start":8401,"end":8419}],[{"start":8433,"end":8523}],[{"start":8537,"end":8608}],[{"start":8622,"end":8680}],[{"start":8742,"end":8770}],[{"start":8802,"end":8823}],[{"start":8834,"end":8835}],[{"start":8846,"end":8850}],[{"start":8864,"end":8896}],[{"start":8934,"end":8942}],[{"start":8976,"end":9015}],[{"start":9027,"end":9062}],[{"start":9074,"end":9120}],[{"start":9152,"end":9198}],[{"start":9236,"end":9247}],[{"start":9279,"end":9297}],[{"start":9331,"end":9363}],[{"start":9376,"end":9388}],[{"start":9400,"end":9430}],[{"start":9462,"end":9538}],[{"start":9552,"end":9586}],[{"start":9600,"end":9628}],[{"start":9662,"end":9722}],[{"start":9754,"end":9783}],[{"start":9797,"end":9834}],[{"start":9872,"end":9895}],[{"start":9927,"end":10001}],[{"start":10039,"end":10094}],[{"start":10128,"end":10149}],[{"start":10161,"end":10222}],[{"start":10254,"end":10321}],[{"start":10335,"end":10406}],[{"start":10420,"end":10484}],[{"start":10518,"end":10532}],[{"start":10564,"end":10631}],[{"start":10669,"end":10678}],[{"start":10710,"end":10750}],[{"start":10764,"end":10772}],[{"start":10784,"end":10836}],[{"start":10850,"end":10900}],[{"start":10920,"end":10978}],[{"start":11095,"end":11101}],[{"start":11133,"end":11145}],[{"start":11159,"end":11164}],[{"start":11224,"end":11244}],[{"start":11304,"end":11316}],[{"start":11344,"end":11367}],[{"start":11401,"end":11447}],[{"start":11479,"end":11504}],[{"start":11518,"end":11548}],[{"start":11562,"end":11613}],[{"start":11647,"end":11693}],[{"start":11725,"end":11806}],[{"start":11820,"end":11854}],[{"start":11905,"end":11961}],[{"start":11975,"end":12000}],[{"start":12014,"end":12038}],[{"start":12050,"end":12072}],[{"start":12116,"end":12131}],[{"start":12145,"end":12181}],[{"start":12195,"end":12229}],[{"start":12243,"end":12285}],[{"start":12299,"end":12342}],[{"start":12461,"end":12472}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_018.ks","basename":"SC_M_018.ks","indexIds":{"帰ってくると宮さんは居なかった。":0,"まあ、まだ昼だし本当は別行動の時間帯だから仕方ないのだが、\nやはり独りではどうにも落ち着かない。":1,"知狡さんも居ないようだ、\nチノ嬢は去就不明、\n冬夏達は学校、\n大神も多分そう、":2,"きぃは仕事中、\n姫様ちゃんと狩屋は放課後に会う約束があるが…[l]\n………話が出来る相手が誰も、居ない。":3,"独りでいると主観思考のみが研ぎ澄まされて、\n恐怖心が無為に増大してしまう。[l]\n思考に歯止めが利かなくなる。":4,"言の葉にして外部へ発散しないと、\n澱になって溜ってしまう。[l]\n客観思考主と触れたい。":5,"厭だ。[l]\n独りは厭だ。[l]\n誰か。[l]\n誰か……":6,"宮さん──":7,"「というですね、\nシリアスな不安感に襲われていた昨日がまるで、\n嘘のようです」":8,"今この瞬間の方が余程有り得ない。":9,"「んむー、喋んないで下さい。[l]\nよっと」":10,"携帯のカメラじゃなく、\n普通のデジカメでばっしゃばっしゃ僕を撮る宮さん。":11,"「あくまで個人的な用途のみに限りますよ宮さん…」":12,"「判ってますてば。[l]\n人に見せるなんてそんな勿体無いことしませんよー」":13,"そうは仰ってもですね、この姿を視られずに済む知人なんて、\nもはや大神と母さんくらいのものだから、\n…いや、その二人にこそこの":14,"様は最も視られたくない。":15,"そういう意味では幸いだけどさ……[l]\n知狡さんなんか、母さんの面影でも見出しちゃったか、\n変に熱の籠もった眼で視るし。":16,"結局僕はあれから、いつもの脳空転を落ち着けるのと同様に、\n喰って寝る、で何とか夜に宮さん達が来るまで乗り切ったのだった。":17,"精神状態は脳内物質のバランスに左右される訳で、\n大概の不安感には栄養と休養を与えれば鎮まるというのが僕の経験則である。":18,"放課後の時間には何とか気を持ち直し、\n姫様ちゃんと狩屋との待ち合わせに赴き、\n制服一式を借り受け当日の手筈を打ち合わせた。":19,"しかし宿に戻っても宮さんは夜まで戻らず、\n完全には拭い去れずにいた不安感と共にまんじりともせず長い時間を独り過ごしていたのに、":20,"ふっと戻ってきた宮さんは僕の話を聞くより前に、\n傍らに在った制服に眼が行ったらしく。":21,"診療所での話はともかく、\n猫の幻覚幻聴の話にはやや深刻に反応した宮さんだったが、\nもはや彼女の興味はそこじゃなくなっていた。":22,"わざわざ一晩かけてカメラだかメイクだか、\n何か色々準備をしてたようで、\n………日が明ければこの有様という訳である。":23,"明日また朝から改めて準備するんだぜ…":24,"「いあーまこくん、\n立派な女子高生ですよ全然違和感ないですよ。":25,"流石に体操着とかは…残念ながら無理かもですが、[l]\n":26,"本気趣味になんないように気をつけないと\nいけませんね、うひひひひ」":27,"「ないですないです…[l]\nそれはないです……」":28,"こういう時はきっちり宮さん暇を取るというか、\n居て欲しい時には居ない癖になあ…":29,"「んむー、何ですかー、\nもうちょっとこう、かあいく喋ってくださいよー。":30,"裏声出さなくたってまこくんの声質なら、\nそれっぽく出せそうですよ女子声」":31,"いくら黒のストッキング着用とは言っても、\n成人男子の脛の無駄毛は処理しなければ布地から\nはみ出るわはみ出るわ、":32,"ガムテで抜いた方が良いだとか、剃った方が好いだとか、\nさんざ宮さん達に玩具にされました。":33,"下着まで本物の女物渡されそうになったので、\nそれは断固拒否し、胸には仕方ないので詰め物を装着。":34,"貧乳で押切ればいいんじゃないのかなあ…と思ったが、[l]\n自分でも見た目バランス的に違和感を感じたので仕方なく。":35,"顔の毛は薄い方だからそんなに大変ではなかったが、知狡さんまでが軽く化粧はした方が良いだろうと張り切りだし、全く名称も知らない道具で色々されるが侭の数時間。":36,"ウィッグは姫様ちゃんが言った通り何とか準備して来た物で、\n当然着け方なんか分からないので宮さんに身を委ねっ放しである。":37,"着方が分かんないと言えば、女子と男子ってボタンが左右逆なのな。[l]\nこの制服はブラウスタイプじゃないからまだマシだが、\nそれでもボタン掛け外しの時、すごい違和感あるんですが…":38,"そして眼鏡、これをどうするかは最後まで迷ったが、\nコンタクトを急場で用立てることは出来そうに無かったので、\n会場に入るまでは外していく事にした。":39,"「こんにちは、\n飯岡、真魅です♪\n…でどうですか」":40,"「んむぁー！[l]\nなになになにー！[l]\nこんな才能あったんですねーまこくんわ！":41,"かあいいかあいい♪\n女子だよ女子！」":42,"「才能っていうのかなこれは…[l]\n持って生まれた肉体の資質でしょ……":43,"僕だって今やってみるまで知りませんでしたよ\nこんな能力」":44,"試しにやけくそで裏声…というか女子声ってこんな感じ？という[l]\n演技をして見た所どうやら好反応のもよう。":45,"元から声は高い方だから、\nそうでないよりは脈あるとは思ったけど…[l]\nというか、内耳じゃ客観的にどう聞こえてるか\n判んないんですけど。":46,"宮さんに":47,"担がれてるだけだったら嫌だなあ……[l]\n大丈夫かほんとに。[l]\n実際に声出し必至の場面に直面したらと思うと怖ろしいな…":48,"「セクシーヴォイスっ！[l]\n身体検査でもされなきゃもう大丈夫ですねっ！[l]\n":49,"何だおーもっと早く気付いてればな～っ」":50,"飯岡真魅は勿論偽名だ。[l]\n単純に僕と宮さんの名前を混ぜただけ。[l]\nこの女子声共々、使わずに済む事を祈るのみだ。":51,"「あ、そうでした。[l]\n猫の話ですが」":52,"「はい？[l]\nねこ？[l]\nあ、僕の白昼夢の話ですか」":53,"「もしおんなじ猫をまた視掛けたら、\nなるべく相手にせずにその場を離れた方が善いです」":54,"宮さんは、急にテンションを切り替えてそう言い放ち、\n僕が胡乱に返事をするのを視ながら、":55,"「明日もがんばってくださいね」":56,"と微笑いながら、この格好のままの僕を置いて部屋から出て行った。":57,"いつもの事だ。[l]\nいつもの。[l]\n僕は制服を着替え、メイクその他を解除してしばらく茫洋としていた。":58,"外を視ると、まだ昼間だというのに昨日に引き続き黒雲が広がっていて、ともすれば再び不安感に襲われそうになった僕は、\n急ぎ食事に出かけた。":59,"もう正午過ぎだった。":60,"点滴打ったとは言え、\nここ数日間は緊張を強いられる日々が続いた為、\nこの日の午後は只管休養し、特に誰に会うでもなく過ごして演劇の日を迎えた。":61,"さて結局良い様に弄られて、\n幸か不幸か不安感自体は雲散霧消してしまったが、\n実際の天気は暗雲立ち込めたままだ。":62,"天気予報によると雨が降るかも知れないが、\n此処は山の中だし、知狡さん曰く当てにはならないらしい。[l]\nまあでも、降るっぽいなこれは…":63,"宮さんは既に居なかったので知狡さんとチノ嬢との\n三人で朝食を摂り、女子生徒への変装を準備した。":64,"冬夏や姫様ちゃんの通う高校は、\nかつて知狡さんが通った高校でもある。":65,"あそこまで歩いて行くのは流石に恥ずかしすぎるというか、\n時間的に目立ってしまう事もあり、\n知狡さんに車で途中までは送って貰った。[l]\n忙しいところ誠に恐縮です…":66,"ここ数日間の怒涛の…いや、巻き込まれたり[l]\n弄られまくった展開の御蔭で、\n疲労感とは別の部分で多少の度胸が付いたと言うか、":67,"変な意味で肝が据わってきたと言うか、\nこの頃には僕はすっかりその気になっていた。":68,"いや、そっちの趣味に目覚めたという意味ではない、断じて。[l]\n単に覚悟を決めたという意味合いだ。":69,"「さて、狩屋がちゃんと居るかどうか…」":70,"時間的には示し合わせたとおりだったので、\n知狡さんに礼を言い車を降りた。":71,"校門からは離れた位置で降りたが、待ち合わせ自体は校門である。[l]\n女子らしい所作を意識しながら、其処を目指して歩き出す。":72,"古びた建物とは言え懐かしいなー高校の校舎なんて。[l]\n大学は学校と言ってもビルみたいな感じだし、\n敷地も広くてもはや学校という感覚では無かった。":73,"と、校門の陰から狩屋が顔を出した。[l]\n何だかんだ言いながら此奴は几帳面なのか、\n時間ぴったりじゃん。[l]\nまあ、実際は文武両道の才女だそうだからな…":74,"「おーーっす…[l]\nて、あ、にゃんかあれだな、\nくく、思ったより違和感にゃいな！」":75,"「おはようございます先輩っ。[l]\n新入生の、飯岡真魅です♪」":76,"試しに可愛く小首を傾げてやった。":77,"「……！？[l]\nあ、あにぃ…[l]\nいあ、その、にゃにそれ…":78,"引くとかより前に素直にすごいわ……」":79,"あ、そうなの…[l]\n漸く実感できたよ。[l]\nしかし喜ぶべき事なんだろうかこれは……":80,"「姫様先輩は居ないんですね？」":81,"「や、あのにぇ、ういらだけの時はいいって兄ぃ…[l]\nなまじその似合ってると、\nこっち変な気分ににゃるだろ……":82,"きーちゃはこないだ言った通り忙しいの。[l]\n演者側だからにぇ。":83,"──ほら、ちゃっちゃと来にゃよ、真魅ちゃ。[l]\nもう前説終わって今から会場暗くなるから」":84,"演技なのか僕のこの格好に対する心境の変化の所為か、\nしっかと手を引かれて体育館に連れ込まれる。":85,"「そういや一昨日言い忘れたけどな、\nお前の母さんに会ったぞ」":86,"「…あー聞いたにゃわ。[l]\n兄ぃにゃんだってういらと絡んでくるかな」":87,"「僕だって気にしてんだそこは。[l]\nまあ何だ、弟か妹出来るわけだな、\n目出度い事で」":88,"「………まあ妹かな、妹…」":89,"「えーお前、身内までそんな眼で…」":90,"「違うよ、そんなのじゃない」":91,"突然陰鬱な口調になり狩屋が言った。[l]\n平時があんなだから、ちょっと真面目な口調になると\nそう聞こえるだけかもだが、":92,"「あ、ああ、悪い」":93,"眼が笑ってなかった。[l]\n真剣で張り詰めた空気を発していた。[l]\nおよそ僕が今まで視ていた狩屋とは思えない。":94,"「じゃ、帰りにまた来るにゃわ。[l]\n心配すんにゃって、\nちゃんと面倒見ないとあたしきーちゃに怒られるんだから」":95,"僕の謝罪はほとんど耳に入っていないようだったが、\n次の瞬間にはいつも通りの此奴だった。":96,"宮さんと一緒で、唐突なテンションの切り替えって奴かな…[l]\nいや、明らかに地雷を踏んだときのリアクションだったと思う。[l]\nが、当然理由を追求する事も出来ない。":97,"何事も無かったように狩屋は僕の手を引いて行く。":98,"暗い中扉が開いたら、光が入って注目されてしまうのでは、\nと思ったが、どうやらまだ照明は落としていないようだった。":99,"近くに居た何人かがこちらを振り向いたのみで、\n何とか静かに入る事が出来た。":100,"狩屋も伴っていたし、特に露骨に不審がられる事はなかったようだ。[l]\n流石は三春の関係者の一員…としておこう。":101,"じゃ、あそこの眼鏡の隣な、\nと言い、並べられて既に生徒で埋まっている\nパイプ椅子の最後列の最左端を指差した。":102,"「これ持ってって」":103,"折畳パイプ椅子を克杖から手渡された。":104,"一応遣り取りを他の人間に見せ付ける事で、\n何とか説得力を付与しようという意味合いか、\nやや克杖の所作が仰々しい。[l]\nまあここは素直に有難く思っておこう。":105,"なるべく静かに申し訳なさそうに、\nそして再び出来るだけ女子ぽい動作を心掛けながら、\n克杖の言った眼鏡の女子の隣に椅子を開いた。":106,"座りながら視線を合わせないようにしつつ、\nその娘に軽く会釈をすると、\nこちらを軽く覗き込むようにし、":107,"「（んーっ？[l]\n君っ…？…あ、そういう事）」":108,"私と一緒ねっ、とその女子は小声でにっこりと":109,"微":110,"笑った。":111,"な、なんですか？[l]\n何か勝手に納得なされてますが……":112,"「（あ、あの）」":113,"「（君ってそういう趣味っ？[l]\nそれとも…どうしても観たくなった人？":114,"私もね、忍び込みなんだよっ。[l]\nどうやったかは秘密だねぃ。":115,"あは、これも秘密だけど見た目通りの歳じゃないよぅ。[l]\nおおっと喋り過ぎだよぅ）」":116,"その女子は小声のまま、\n早口なのかおっとりなのか微妙な感じで一人僕に話し掛けてきた。":117,"「（えっ……とぉ…）」":118,"一応女子声でリアクションしてみるが…":119,"「（私から視たらバレバレだけどっ。[l]\nまあ同類同業の":120,"誼で黙っててあげるよぅ。":121,"その代わり私の事も黙っててよねっ？[l]\nあはっ）」":122,"早々にバレたのは仕方ないが、\n立場的には共犯というか正に同類という事で、\n不問にしてくれるというのはまあ\n不幸中の幸いというか、":123,"いやそれもこの娘が信用のおける人間ならという\n前提でだけど…":124,"──何でバレたんだろ？[l]\nいや、女装でなく。":125,"「（察するのがぁ、\n得意なんだよねっ。[l]\nあは。[l]\n君はちょっと…何か視え辛いけどっ）」":126,"察するのが？[l]\nどっかで聞いたぞ。その台詞は。":127,"……チノ嬢か？[l]\nそう言えば今もこの娘、僕が何も言わずとも──":128,"「（あう、いや、その、\nあははは…）」":129,"周囲がさんざめいている所為か、\nこの女子の語り口調や声質がそうなのか、\nうまい具合に紛れて他人には詳細など殆ど聞こえていないようだ。":130,"「（え、えっとう、\nそんなに此処入るの簡単だった？[l]\nぼ…私それなりに苦労したんだけど）」":131,"「（あは、\n私ってば特別だからっ。":132,"ま、良いでしょぅ細かいことはね？[l]\nお互い名前も訊きっこ無しでねっ？[l]\nその方が二人の為だねっ）」":133,"ああそうですか。[l]\nまあそれは別に構わない。[l]\nてか、僕がしんどかったのは異性装という付加条件があったからか。":134,"でも何だ特別ってのは。[l]\nん？[l]\n先日姫様ちゃんが誰だかが来るって言ってた気がするが。[l]\n何て言ったかな…":135,"その誰かが来るから安心だとか…[l]\nいかん、全く覚えてない……[l]\nいや、確か…セン、センリ……センの字──":136,"「（もう、詮索不要だよぅ）」":137,"きぃのように眼をまん丸にしてこちらを凝視するこの女子。[l]\n口元は絵に描いたような笑顔で、眉は困ったように八の字にしながら。":138,"「（う、うん…）」":139,"とにかく大人しく黙っている事にした。[l]\n何となく周囲を見回してみる。":140,"この学校、校舎は":141,"旧いままだが、\n体育館はいやに立派なのだ。[l]\n演劇の機密性を保つためかも知れないな。":142,"ワックスの匂いというか、アリーナの匂いが\n僕は好きだったので、\n何というか郷愁が……":143,"郷愁？[l]\n子供の頃の記憶？[l]\nあ？[l]\n何だ？[l]\n僕が子供の時の──？":144,"「…っ！？」":145,"突然、\n光った。":146,"そして、\n":147,"ごおおおおおおおぉぉぉぉぉぉん。[l]\n":148,"とつ、とつ、とつとつ、\n":149,"ととととと、ざざざざざあざざあざああああああ。":150,"「（あはっ？[l]\nきたよ雷雨きたぁっ。[l]\nこれは雰囲気ばっちだねぃ）」":151,"空気が一気に湿り、\n会場がやや騒つき出す。":152,"生徒らしき声で注意のアナウンスが流れ、\n──静まる。":153,"体育館の屋根を打つ雨音、\n時折混じる雷の音、そして風の音が、\n厳粛に…耳に流れて来る。":154,"「（あはっ。[l]\nほら、始まるよぅ。[l]\nさあさ、しっかと御覧あれぃ）」":155,"体育館の遮光カーテンは全て閉じられているので、\n完全にライトが落とされるとほぼ真っ暗闇だ。[l]\n期待か不安か、いよいよざわめきが止まる新入生達。":156,"教員も先輩達も執行部らしき面々も、\n見回すと、と、あれ？":157,"まるであのときの冬夏の喪服のような、\n全身黒尽くめの小さな人影が、\n体育館の外周二階部分に居た。":158,"何かを抱いている、\n抱いている其れは猫だ。":159,"それは解かった。[l]\n何故此処に猫が。":160,"と、袖を引かれた。[l]\n振り向く。":161,"──……しきのはじまりだよぅ。":162,"隣の謎の少女が呟いて、\n同時に冬夏がスポットライトに照らされた。":163,"無國籍風の、視た事の無い衣装に身を包んだ、\n金色の髪の少女。":164,"片眼の眼帯は衣装で意匠的に隠されて、\n残る一つの碧眼が、周囲を射竦めていく。":165,"バックに聖歌隊の如き一団が浮かび、[l]\nあの言葉がコーラスとなって響きだす。":166,"ミ・カヤミャルカヤ──":167},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_018.ks","relPath":"/data/scenario/SC_M_018.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":168,"length":168,"percent":100},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[151,0],"note":"完成"},"/data/scenario/SC_M_019.ks":{"data":[["時間感覚は無くなっていた。","时间感已然消失。"],["歌が始まってからいったいどれくらいたったのか、\n館内の時計も、暗くて判別出来ない。","自歌声响起究竟过了多久、\n馆内时钟也因黑暗无法辨认。"],["だから、\n永いのか、\n短いのか、","所以、\n是漫长、\n还是短暂、"],["――終わってない以上、\n現時点でそれを判ずる事がそもそも見当違いなんだけど。","――既然尚未结束、\n此刻纠结这个本就搞错重点。"],["初見なので、余程分かり易い『起承転結』が無い限り、\n進行度合いがどれくらいかなど知る由もない。","初次体验下、除非有特别明显的『起承转结』、\n否则根本无从判断进度几何。"],["「……」","「……」"],["僕も全く何でこんな格好で、\nこんな場所まで入り込んで、\nいったい何してるんだろう。","我也完全不明白为何这副打扮、\n为何潜入这种地方、\n究竟在做什么。"],["と、今更冷めて自己分析などしてはいけない。","但事到如今不该冷静下来自我分析。"],["鏡をずっと視てると気持ち悪くなるように、\n己を客観視する事が、\n良い方向に働く場合とそうでない場合がある。","就像盯着镜子太久会不适那样、\n客观审视自己这件事、\n有时带来好处有时适得其反。"],["僕はもう……色々覚悟して此処に来たのだから、[l]\n眼前の事物に集中するのだ。そうなのだ。","既然我已……做好觉悟来到这里、[l]\n就该专注眼前事物。没错。"],["全ての元凶は宮さん……とは言うまい。[l]\n宮さんとはまた別の謎の根元、綾目姫様ちゃん。[l]\n彼女の ","虽说一切元凶是宫小姐……倒也不尽然。[l]\n不同于宫小姐的另一谜团根源、绫目姫様。[l]\n她的 "],["唆 し――というか\nよく分からない押しの強さが今の状況を作り上げた一因であるのも\n間違いなく、\nうーん、彼女が本家の目的たる三春関係の人間である事を\nさっ引いても、\n個人として謎だよなあ。","教唆――或者说\n不明就里的强势也是造就现状的原因之一\n这点毋庸置疑、\n唔嗯、即便扣除她作为本家目标的三春相关人员这层身份、\n单纯作为个体、\n也足够神秘啊。"],["謎。","神秘。"],["謎とは、\n事象を受け取る当人にとっての理解不能な事柄であって、\nテストとかゲームとか推理モノの創作物とかじゃない限り、\n当然出題者……いや、そのもの自体は別に他人を\n騙そうとか思ってる訳じゃないのだ。","所谓谜团，\n对接收现象的当事人而言是无法理解的事物，\n除非是考试或游戏或推理类创作之类，\n当然出题者……不，其本身并非刻意要\n欺骗他人。"],["から、姫様ちゃんにしたってそうなんだろうが、\nその行為の","所以姫様酱应该也是如此，\n但对于想知道"],["所","其"],["以のなんたるかを知りたいこっちに\n説明が無いからには、さっきみたいにどうカッコつけたって\n謎は謎だよ。[l]\n答えが割り切れるものとは限らないのが世の常だが、\n少しは説明してくれてもいいよなー。[l]\n……訊けない僕が悪いのかねえ……","行为背后缘由的我来说\n既然没有解释，再怎么装腔作势\n谜终究是谜。[l]\n世间常态就是答案未必能简单明了，\n但稍微解释下也好啊——[l]\n……是我问不出口的错吗……"],["で、謎ついでにいうならば、\n僕の幻覚？をも侵蝕しつつあるこの謎言語。[l]\nこの謎言語が全編に散りばめられたこの不思議な歌劇、\nというか解る言語が一切ありません。[l]\n洋画とかなら、役者の演技にしろ舞台背景にしろ、\nシチュエーションが視えるから、\n吹き替えや字幕なくても在る程度は想像もつくんだが、\nこれは訳もなにもない、他言語域でのミュージカルかオペラといった風で、歌と音楽では、感情の傾向とかいった曖昧なものしか、\nむーん。","说到谜团，\n这个连我的幻觉？都在侵蚀的谜之语言。[l]\n这部通篇散布着谜之语言的奇异歌剧，\n或者说根本没有任何能听懂的语言。[l]\n若是外国电影，凭演员表演或舞台布景，\n至少能看到情境，\n就算没配音字幕也能想象个大概，\n但这既无翻译也无其他语言元素，像是异域音乐剧或歌剧，仅能通过歌声与乐声捕捉到\n唔——"],["僕ぁ宮さんの車内アニソンが好きな訳じゃないが、\nクラシックと演歌民謡がはっきりって苦手なんだよな。[l]\n民俗音楽系とか、先日宮さんが言ってたように、\n儀式的要素のある、トランス状態への入り口みたいな、\n……トランスってジャンルもあったか？[l]\nよくわかんないんだ僕。が、そういうのを好んで聴く。[l]\nまあ、それはそれだ。[l]\nこの歌劇の場合は色々と","我倒不是喜欢宫小姐车里的动漫歌，\n但古典乐和演歌民谣实在吃不消啊。[l]\n民俗音乐这类，就像前几天宫小姐说的，\n带有仪式感、宛如进入恍惚状态的入口般，\n……话说‘恍惚’（译注：trance，迷幻音乐）本身不也是一种音乐类型吗？[l]\n我不太懂，却莫名爱听这种。[l]\n罢了，这另当别论。[l]\n这部歌剧混杂了"],["混","各"],["淆していて、\nキライじゃない、のは確かだ。[l]\n取り敢えずあの狩屋が言うには、\nこれの内容は感得するものだというんだが……","种元素，\n确实不讨厌。[l]\n总之据那个狩屋所说，\n内容需要靠心领神会……"],["それが主目的なのに、\n悪いけど、\n今のところよくわからないというのが正直なところだなあ……[l]\n不思議だとか、神秘的とか、\n凡庸な感想はあるけれど、\nそれをわざわざ……とも思えないし、[l]\nそもそも感得ってえらい主観的な話だからな。[l]\nそうと言われた訳ではないが、\n感得と言うからには理屈で考えちゃいけないような\n気もするし、おもうがままに何かを感じようとは思うんだけど。","可这明明是主要目的，\n抱歉，\n目前实在摸不着头脑……[l]\n虽觉得神奇或玄妙，\n但只有这种平庸感想，\n也不值得特地……况且[l]\n心领神会本就是极主观的事。[l]\n虽没人明说，\n既说要心领神会就不该用理性思考，\n我也试着放任自己去感受了。"],["まあ見知った女子が異装をして演舞してるという事自体に\nどうも気がいって、\nへんなむず痒さには襲われています。[l]\n大神に言わせれば、僕はギャップに弱いというか、\nあんまり奴は使いたがらなかったがギャップ萌えというやつ？[l]\nいずれそれこそお祭りとかコスプレやら制服にしろ、\n非日常をロールプレイするというシチュエーションには\n何かしら","不过看着熟识女孩穿着奇装异服起舞，\n注意力总被吸引，\n涌起阵阵难耐的躁动。[l]\n按大神的说法，我容易吃反差萌这套，\n虽然那家伙不爱用这词——所谓反差萌？[l]\n说到底无论是祭典、cosplay还是制服，\n在扮演非日常角色的情境里，\n总能感受到某种让人"],["昂","亢"],["揚する要素を\n感じる事があるのは確かに否めません。","奋的元素，\n这点确实无法否认。"],["――宮さんまさかそういう所で僕の足下みてるつもりか？[l]\nどっちかというとあの人の影響があってこそ……いやいやいや。[l]\n宮さんが今回のに同意したのは……宮さんなりの意図があったようだしなあ。[l]\nと己の様を振り返ってげんなりする僕。[l]\n言い出しっぺは姫様ちゃんだけどな……[l]\n場内が暗いのと知らない人の前だから何とか耐えてるが、\nそうでなかったらとてもじゃないが――","――宫小姐该不会在暗中观察我这弱点吧？[l]\n不如说正是受那人影响才……不不不。[l]\n宫小姐这次会同意……看来有她自己的打算。[l]\n回想起自己这副样子不禁泄气的我。[l]\n虽然提议人是姫様酱啦……[l]\n多亏场内昏暗且都是生人才勉强忍住，\n否则绝对会――"],["「……、？」","「……、？」"],["「……♪」","「……♪」"],["て、隣りに座る、\n","啊，邻座那位，\n"],["件の何かしら察しの良い女子はすっかりご機嫌というか、\n聞こえない程度の鼻歌というかハミングをしとるのだった。[l]\n若干ハモってるな。[l]\n音感良いのか、初見じゃないのか、\nただの偶然か……そんくらい出来る奴なら山程居るし、[l]\nそういえば先刻の態度は、何かしら訳知りな感じだった――","那个察觉力不错的女生完全是一副心情大好的样子，\n正哼着几乎听不见的小调或者说是在哼唱。[l]\n稍微有点和声呢。[l]\n是音感好呢，还是并非初次听到，\n亦或只是偶然……能做到这种程度的人要多少有多少，[l]\n说起来刚才的态度，总给人一种知晓内情的感觉――"],["「――？」","「――？」"],["（み、\nぉろこなもろこねきゃなさつこねきゃなさつこねきゃみゃる、\nきゃみゃろろきゃきゃみゃるつかやこねきょろかやこねきょろ、わ。）","（mi、\no ro ko na mo ro ko ne kya na sa tsu ko ne kya na sa tsu ko ne kya mya ru、\nkya mya ro ro kya kya mya ru tsu ka ya ko ne kyo ro ka ya ko ne kyo ro、wa。）"],["「……？、……？？」","「……？、……？？」"],["聞こえている歌に違う音が、否――\n声？[l]\n声が混じってきた。","听到的歌声里混入了不同的音调，不――\n声音？[l]\n有声音混进来了。"],["しかも、これは、\n謎言語、そして――\n明らかに別音源の声――","而且，这是，\n谜之语言，然后――\n明显来自不同音源的声音――"],["極めて近くから、耳元で囁かれてるように、","就像是从极近处、在耳边低语般，"],["思わず左右を見回そうとするが、","下意识想要环顾左右，"],["……動かない。","……却动弹不得。"],["瞬きも出来ない。[l]\nい、否、出来るんだが、自分の意志とリンクしてない、ぞ？[l]\n舞台の方向を視たまま、僕の身体は凍り付いたように\n動かない、じゃなく動かせない。","连眨眼都做不到。[l]\n不、不对，能做到，但和我的意志脱节了，啊？[l]\n我的身体如同冻结般维持着望向舞台的姿态\n不是不动，而是无法动弹。"],["――正確には意志通りに動かないと言うべきか、\n弛緩でも硬直でもない。[l]\n何とかの穴って洋画があったがそれみたいな感覚と\nいうか、\n強制操作されてるというか、","――准确说是无法按意志行动，\n既非松弛也非僵硬。[l]\n有点像某部叫《XX之穴》的外国电影里的感觉\n或者说，\n像是被强制操控着，"],["なんて考えてる場合か、\nどどどどどどどどどどうしよう！！！？？？","现在哪是想这些的时候，\n怎怎怎怎怎怎么办！！！？？？"],["動かないまま式が終わったらこの格好ではいやだとか、\nいや不法侵入がまず先かとかばれると色々問題が！","要是仪式结束还保持这个姿势就糟了，\n不对非法入侵才是首要问题会被发现各种麻烦！"],["どこまでが冷静な問題認識なのか焦ってる僕の、\n――肉体はこんなだからあくまで脳内がひたすら\nテンパってるだけなんだが、","在焦灼中已分不清哪些是冷静的判断，\n――肉体既然这样只能靠大脑拼命\n陷入混乱罢了，"],["そんな状況には無関係に、\n再度声が聞こえた。","但与此状况无关地，\n又听到了那个声音。"],["（雷、カミナリ。）","（雷者，神鸣也。）"],["（たまあずさのつかわし、\nかむながらにさかごと。）","（玉梓之遣，\n喰食之逆。）"],["（つながるひも、じぐざぐじくさく、\nあやつりにんぎょう不正操作。）","（连结之绳，歪扭缠绕，\n操纵人偶，不正操作。）"],["な、何だ…って？？","什、什么啊…这是？？"],["てか、今度はわかるぞ？[l]\n明かに僕らの使用言語だ……","话说这次能听懂哦？[l]\n明显是我们使用的语言……"],["脈絡とか意味は不明だが、\n言ってる言葉は判る。","虽然脉络和意义不明，\n但说的词句能明白。"],["と、取り敢えず焦るのはお預けにし、\n眼前の別問題に注力して冷静になろう。","总、总之先放下焦虑，\n集中应对眼前的新问题保持冷静。"],["瞬間的に現実逃避することは、\n生命危機に対して変性意識状態に陥ることにより困難を打破するための本能だし！","瞬间现实逃避这种行为，\n本就是面对生命危机时通过陷入变性意识状态来突破困境的本能！"],["言ってる側から混乱してる気がするけど、\n緊急時にロジカルを求めたところで益少なしだ。[l]\n誰かが聞いてる訳じゃ無いけどまあいいです。","虽然说着说着自己都觉得混乱了，\n紧急时刻追求逻辑性毫无益处。[l]\n反正没人听见就这样吧。"],["くだらない思考走らせると、\nまあ落ち着くのには良いかもだ。[l]\n取り敢えず多少はマシになった。","放任无聊的思绪狂奔，\n倒也算是个冷静下来的好方法。[l]\n总之稍微镇定些了。"],["この数日、伊達に怒濤の連続謎イベント体験してた訳じゃないんだぜ、僕だって。","这几天我可没白经历连续不断的谜之事件啊。"],["宮さんの仕込みが効いてるね！[l]\nはは……","宫小姐的特训见效了呢！[l]\n哈哈……"],["――さて。","――那么。"],["「（……♪）」","「（……♪）」"],["隣りのあの女子は相変わらず鼻歌を続けている。[l]\n僕以外の者には、特に何事も起きてないのだろうか？","隔壁那个女生依然在继续哼歌。[l]\n对其他人而言什么都没发生吗？"],["もし同じ様な状況が起きていたら、\n当然物理的なリアクションはとれず、","如果他们也遭遇同样状况，\n当然无法做出物理反应，"],["端からじゃ\n分かんないんだけど。","从这边\n根本搞不懂啊。"],["ただ隣りの女子がこうであるからには、\n少なくとも行動の自由を妨げられる様子は無いようだし、\n……くそ、他の生徒がどうなってるのかが知りたい……","不过既然隔壁女生是这种状态，\n至少看起来行动自由没受限制，\n……该死，好想知道其他学生怎么样了……"],["僕の煩悶とは無関係に、\n謎の声は響き続ける。","与我的烦恼无关，\n谜之声持续回荡着。"],["それは冬夏が舞う舞台、歌と相まって、\nしかして調和というよりは、\n奇妙なモアレのような目眩感を僕に与えていた。[l]\n不協和音ではないが据わりの悪い――","那声音与冬夏起舞的舞台、歌声交织，\n但与其说是和谐，\n倒更像奇妙的摩尔纹般令我眩晕。[l]\n虽非不谐和音却令人不适――"],["（憑き村或いは月村と呼び習わしめるショウケラノムラ、\nミハルモノのムレ、\nショウキラノムレ、ショクラノモリ、","（那是被称为‘凭村’或‘月村’的精蝼蛄之村、\n守望者的群集、\n精鬼们的群集、書蔵守、"],["クロノムレクロノモリ、砕き山を抱く黒の森、\n祭儀をもって我等は忘れまじ。）","黑之群玄之森，环抱着破碎山峦的黑森林，\n以祭仪之名我等誓不忘却。）"],["くろのもり？[l]\nそれ以外の言葉も、単語として認識は出来なくもない、\nが、\nそれだけだ。","黑之森？[l]\n其他词语也并非完全无法作为单词理解，\n但\n仅此而已。"],["総体としての意味はさっぱり判らない。[l]\nそれに、\nこの聞こえてくる声というかオトは、少々早口で抑揚が薄いのだ。","整体含义完全不明。[l]\n而且，\n这传来的声音或者说声响，语速偏快且缺乏抑扬。"],["一昔前の映画やテレビに出てくるような、\nレトロな近未来風機械音声のように不自然で一本調子だ。[l]\n現在の現実の合成音声の方が余程自然に聞こえるだろう。","就像老电影电视里\n那种复古近未来风格的机械音般生硬单调。[l]\n如今现实的合成音听起来反而自然得多。"],["（聖なるかな正なるかな凄なるかな昔居まし今忌まし後来たり、\n刀自御名どれみりあ・りでる、三春、オクロをヨリマシに、","（圣哉正哉伟哉昔在现忌将来临，\n刀自御名德蕾米莉娅・利德尔，以三春，大黑为凭，"],["翅を獲た","获翅之"],["蟻","蚁"],["子、\n","子，\n"],["蜂となりて我等月に跳ねるもの、\nツキノモノのちぎりにてむすばれた猫遣い。）","化蜂跃月者，\n与月之物缔契的猫使。）"],["三春？[l]\nオ、クロ？[l]\nそれは――","三春？[l]\n大、黑？[l]\n那是――"],["（神の嫁は紙を読み、咬みて黄泉送る火の車、\nみつはのめ。","（神之新娘读纸文，啮而送黄泉的火之车，\n三叶之芽。"],["御","御"],["眼は","眼"],["有","有"],["也","也"],["無","无"],["也。[l]\nしろおにのものなればなんとしょう。）","也。[l]\n既为白鬼之物当如何。）"],["みつはのめ？[l]\nしろ……のもの？","三叶之芽？[l]\n白……之物？"],["（律を選ずる我が命をきけ。）","（聆听择选律令的吾之命。）"],["（ワレは醍醐、大悟、第五。）","（吾乃醍醐，大悟，第五。）"],["う゛うううううぅぅぅぅぅうううぅぅぅ――ん。","呜啊啊啊啊啊啊啊啊啊啊啊――嗯。"],["相変わらず身体の自由が利かないので平静を装ってるように\n視えるかもだが、\nもし両手が自由ならば耳を塞いでいるような、\n激しめの耳鳴り、否、","因为身体依旧动弹不得只能强装镇定\n可能看起来像吧，\n要是双手自由恐怕早就捂住耳朵了，\n剧烈的耳鸣，不，"],["高周波なんだか重低音なんだか、\nまるでハードディスクや冷却ファン、高速ドライブが鳴り出したような、要するに電子機器系の騒音のような……[l]\n神経をざわつかす厭なオトが頭に響く。","不知是高频还是重低音，\n简直像硬盘散热扇高速驱动器齐鸣，总之就是电子设备般的……[l]\n刺激神经的讨厌声响在脑中回荡。"],["（――韻律走査中。）","（――韵律扫描中。）"],["（――因律操作中。）","（――因律操作中。）"],["な、なんだって？[l]\nいんりつそうさ、ちゅう？","什、什么？[l]\n因律操作、中？"],["（","（"],["於","伴随於"],["菟の音に","菟之音，咏唱"],["祝","祝"],["詞乗りて。）","词。）"],["………。[l]\nオトかコエか、響くのはその繰り返しになった。","………。[l]\n声响或声音，反复回荡着这些内容。"],["しばらく様子を見る。","先观察一会儿情况。"],["体感的に２、３分、\nそれに注意を払ったが、\n特に変化は無い。","体感大概两三分钟，\n虽然集中了注意力，\n但没什么特别的变化。"],["身体の方も進展はなく、ただ","身体方面也没有进展，只是"],["只","一个劲地"],["管に舞台を視ている。","注视着舞台。"],["も、もしかするといつの間にか寝てしまって、\n夢でも視てるんじゃ……","或、或许不知不觉就睡着了，\n正在做梦也说不定……"],["しかし、実経験から言って、夢の中で自覚を持ったら大抵\nその時点で夢からは醒めるはず。[l]\nしかしどうやら……","但根据实际经验来说，在梦里意识到自己在做梦的话，通常\n那一刻就该醒过来了。[l]\n但看样子……"],["「………」","「………」"],["そうはならないようだ。[l]\n取り巻く状況に変化はない。[l]\nや、わかってたことだけどな……","似乎并不会这样。[l]\n周围的情况没有变化。[l]\n嘛、虽然早就知道了……"],["――そ、それはとにかく、この感覚は","――总、总之这种感觉"],["怪","很"],["訝しい。[l]\nいや、怪訝しいったらそれは、ここ数日間ずっと怪訝しいわけだが、\nこの音に限って案ずるに、\n何というか、\n漫画や小説ではよく描写される、\n脳に直接語りかけられてるというか、\nサラウンドのように音が回り込んで予想外の所から聴こえてる\nというか……[l]\nそれこそ金縛りの時のように、\n耳鳴りのような、\n鼓膜と聴神経ではない受容器で聴いてるような異常な感覚、","可疑。[l]\n不，要说可疑的话，这几天一直都挺可疑的，\n唯独对这个声音特别在意，\n该怎么说呢，\n就像漫画小说里常描写的那种，\n仿佛直接在大脑里对话，\n或者声音像环绕音效一样从意想不到的方向传来\n之类的……[l]\n简直就像鬼压床时，\n耳鸣那样的，\n不是通过鼓膜和听神经而是用别的感官接收声音的异常感觉，"],["ああ、視覚に続いて聴覚も――いや、\n猫が喋ってる幻覚にも襲われたし、\n妄想だろうがなんだろうがもう、\nだいぶツかれてるのだろうか……[l]\n診療所の処置でももう間に合わないくらいの\n辛労だったのかなあ今度の一連は。","啊，继视觉之后听觉也――不对，\n之前还出现过猫说话的幻觉，\n不管是妄想还是什么，\n我该不会已经精神崩溃了吧……[l]\n这次一连串的事情，\n难道是连诊所治疗都来不及缓解的过度劳累？"],["典型的な巻き込まれ型主人公じゃないかよ、\nと此処に来る前は思ったが、\nあの時は単なる喩えとして思っただけだ。","这不就是典型的被卷入型主角吗，\n来这儿之前我还这么想过，\n但当时只是当作一个比喻。"],["巻き込まれるどころか、\n虚構のような出来事が僕の身に怒濤のように起きていく。[l]\nこれじゃあまるで、","岂止是被卷入，\n虚构般的事件正以排山倒海之势发生在我身上。[l]\n这样简直就像，"],["……否。[l]\nそうではない場合の、\nおそろしい想像。","……不。[l]\n如果不是这样的话，\n那想象更可怕。"],["僕の身を襲うこれらの出来事が、\n全て、\n幻覚でもなんでもなく、","发生在我身上的这些事，\n全部，\n既不是幻觉也不是别的什么，"],["………。","………。"],["何が現実でそうでないかの境界など、\n思考の主体自身が知る事は永劫に無いんだろうが、","虽然思考主体永远无法知道，\n什么是现实什么不是的界限在哪里，"],["故に今僕が思考する事が、\n主観的観測事象だけが、\n僕にとっての事実とするならば、","因此现在我思考的事情，\n只有主观观测到的现象，\n如果这些对我而言就是事实的话，"],["そんなばかな。[l]\nそんなのは、\nそんなのじゃ、","太荒谬了。[l]\n这种事情，\n这种情况，"],["まるで、\n御伽話か何かで、\nファンタジーじゃあるまいし、\nまるっきりゲームの登場人――","简直就像，\n童话故事什么的，\n又不是奇幻作品，\n完全就是游戏里的登场人――"],["………？","………？"],["なんだ。","什么啊。"],["何かがいる？","有什么东西在？"],["首が、熱い。","脖子，好烫。"],["と、\n唐突にそれが顕れた。","接着，\n那东西突然显现了。"],["「！？」","「！？」"],["後ろ首筋に戦慄が走った。[l]\n当然恐怖だ。[l]\nあの蔵の中のように総毛立ち、\n怖気をふるったような粟立つ感じを感じた、","后颈窜过一阵战栗。[l]\n当然会感到恐怖。[l]\n就像在那个仓库里一样浑身汗毛倒竖，\n本该体验到那种吓得发抖的起鸡皮疙瘩感，"],["はずだった。","本该是这样的。"],["しかし、やはりさっきから身体が硬直して――いる。[l]\n声も出ない、否、出せないんだ。","但身体从刚才开始就僵硬得――[l]\n发不出声音，不，是没法发出声音。"],["だがそんな事にはお構いなしに、\n厳然として眼前に『それ』がいる。","可那东西根本不管这些，\n堂而皇之地出现在眼前『那东西』就在那里。"],["な、な、な、\nなんだよ…っ、これは……！","什、什、什、\n什么啊…这、这是……！"],["実体があるようには視えないが、\nある、いる、そこに、\n『それ』が。","虽然看起来不像有实体，\n但确实存在，就在那里，\n『那东西』。"],["眼もいかれて、耳もおかしくて、\nや、やっぱり眼もどうにかなったのかよ！？[l]\n全てが幻か、さもなきゃ、なきゃあ、","眼睛也坏了，耳朵也出问题了，\n难、难道连眼睛也出毛病了吗！？[l]\n一切都是幻觉吗，如果不是的话，如果不是的话，"],["そうだ、\n流石にここまで来ると、","没错，\n事到如今，"],["小難しい理屈なんか関係ない！","那些复杂的道理根本无关紧要！"],["いる、\n今そこに少なくとも、\n眼に視える何かがいる！[l]\n意識もはっきりしてるし脳空転もしていない！","存在，\n至少现在那里，\n有能用眼睛看到的什么东西！[l]\n意识也很清醒大脑也没有当机！"],["いつまでたってもそいつは消えないで\nそこにいるんだ！","不管过去多久那家伙都不会消失\n就在那里啊！"],["ああ、もう、\nこの状況のどの要素に焦ったらいいのか混乱するって！[l]\n上演してる『これ』に関係してるのか？","啊啊，真是的，\n完全搞不懂该为这种情况的哪个要素着急啊！[l]\n和正在上演的『这个』有关系吗？"],["もしそうならば姫様ちゃん、知ってて僕を呼んだのか？[l]\nそれとも偶々なのか？","如果是这样的话姫様，是知道会这样才叫我来的吗？[l]\n还是说只是偶然？"],["幸か不幸か身体の方は至って平静……というか、[l]\n意のままに動かないのが或る意味救いではある、が……","幸或不幸身体倒是异常平静……或者说，[l]\n无法随心所欲动弹在某种意义上也算得救了，但……"],["視界のど真ん中に『それ』がいる。[l]\n首が、熱い。","视野正中央存在着『那东西』。[l]\n脖子，好烫。"],["どうしても身体は意のままにならない。","身体无论如何都不听使唤。"],["相変わらず、\n呼吸は僕の意志とは無関係に","一如既往，\n与我的意志无关，"],["恙 ","呼吸毫无阻碍地"],["無く行われていく。","持续着。"],["身体操作の主導権が無いというか、\n他者に取って代わられたような、と言った方が正確な感じだろうか。","与其说是失去了身体操控权，\n不如说更准确的感觉像是被他人取代了。"],["何しろ眼は開いているし、\n呼吸も脈拍も平常、\n汗もかいてなければ震えもない。","毕竟眼睛是睁着的，\n呼吸和脉搏都很平稳，\n既没出汗也没发抖。"],["いやそんな冷静に分析してる場合とちがう。","不对现在不是冷静分析的时候。"],["それ、よりも……ッ、[l]\n突如顕れた『それ』だ、\nなんなんだ、これ……","比起那个……呃，[l]\n突然出现的『那东西』，\n到底是什么啊，这……"],["端的に表現するなら、一つ目で、一本脚の、\n種から根っこが出たてのような、\nいわば『お花』を漫画的表現にしたような、\n巻いた","简单来说就是，独眼单脚的，\n像刚破土而出的种子根系般的，\n可以说是把『花』用漫画表现手法呈现出来的，\n卷曲的"],["蔓のような髭のようなものもある、","藤蔓般的须状物也有，"],["猫？","猫？"],["いや、それより、こんな……モノが、[l]\n居る――なん、\nいくら最近変なものが視えるとはいえ――","不，比起那个，这样的……东西，[l]\n居然存在着――开什么（玩笑），\n就算最近能看到奇怪的东西也――"],["どうしても受け入れろというのか、\nこんな現……","非要我接受不可吗，\n这种现（实）……"],["熱、\n首が熱いのだが、\n未だ身体の自由は戻ってくれない。[l]\n他人から視ればやはり完全に普段通りなのだろうが…","好烫，\n脖子好烫，\n身体还是动弹不得。[l]\n在旁人眼里我大概完全和平时没两样吧…"],["そして、猫だ、\nこれは猫なんだと、","然后，是猫，\n这绝对是猫，"],["どうしても頭が認識する。[l]\n最近はどうも猫が頭に浮かぶ、にしてもだ。[l]\n明らかに既知生物の","无论如何大脑都这么认定。[l]\n虽说最近脑海里总浮现猫的影子——[l]\n但眼前这明显不属于"],["形","已知生物的"],["態じゃないこれを、\n何故猫と、","形态，\n为何会当作猫，"],["まさ、か、\nこれが、姫様ちゃん達の言う、\n感得すべきモノ、なの、か？","开、玩笑、\n难道这就是姫様她们所说的\n需要感知的东西吗？"],["ううううう。","呜呜呜呜。"],["そ、そんな、こと、が、\n思考が麻痺、するよう、だ、\nこ、れは、\n空転、する脳、","这、种、事、\n思考仿佛麻痹了般\n这、是\n空转的大脑"],["―。","―。"],["――。","――。"],["―――。","―――。"],["（ぜえええれんふりいいいでん）","（Seelen frieden）（译注：此处为德语，意为灵魂的平静）"],["（○）","（○）"],["は？","哈？"],["あ、おおう。[l]\n何か一瞬気付けのような感覚を覚え、\nどうやら思考麻痺は収まった……ようだ。","啊、噢。[l]\n突然有种恢复意识的错觉，\n看来思维麻痹似乎停止了……"],["が、肉体的には何ら改善への進展はみられない。[l]\n何かおかしな言葉が聞こえた――\nこの場合は脳内に、という意味だが、\nような気がしたが、\nもはやどこがリアルでどこが妄念なのかが曖昧な僕にとって、\nまるで夢の中での出来事を視る、その夢見る主体のように、\n何故か全てが結構性のある事象として受け入れられていく。","但肉体状态毫无改善迹象。[l]\n似乎听见了奇怪的语句――\n准确说是在脑内响起的，\n虽然不太确定，\n对于早已分不清现实与妄念的我而言，\n就像在梦境中旁观事件发展的主体般，\n莫名将所有现象都当作合理存在接受。"],["その言葉きっかけで意識がはっきりとしたような、\nそうでもないような……そう感じる根拠として、\nそこだけ声が違う……この場合言葉が合ってるかどうか\n定かではないが、いわば別人の声、\nそれも何か聞き覚えのあるような声だったが故に、\nしかし誰かまでがいまいち――\nそして最後に言葉ではない、\n是認の意志を感じて、\n妙な安堵感が、","那句话让意识似乎清醒了些，\n又好像没有……作为依据的是，\n唯独那段声音不同……不确定用词是否准确，\n但就像是另一个人的嗓音，\n偏偏又带着似曾相识的熟悉感，\n却想不起究竟是谁――\n最后传来的并非语言，\n而是认同的意志，\n诡异的安心感，"],["と、眼前の方の状況に変化が生じて、\n僕の思考は中断された。","与此同时眼前状况突变，\n我的思考被迫中断。"],["視界が前方に固定された為に、左右広域を確認は出来ない。[l]\nが、幸いにというか、僕の座っていた位置がほぼ最後列のために、\n暗いが、大半の生徒は視認出来る。","因视野固定在前方，无法确认左右两侧。[l]\n不过幸运的是——或者说多亏坐在最后排，\n虽昏暗，但能看清大部分学生。"],["状況に変化が生じたというより、\n僕に、周囲を認識出来る余裕が生まれたと言った方が\n良いかも知れないんだが。","与其说是状况发生变化，\n不如说我终于有余裕\n观察周围了。"],["暗い会場内、\nそこには沢山の小さな『それ』が、いた。","昏暗的会场里，\n布满无数细小的『它们』。"],["恐らく会場内の全員の前にいる。[l]\n舞台の上の、演者にもだ。[l]\n冬夏の前にも――\nく、眼を凝らす事もままならぬ身がもどかしいなあっ。","恐怕每名与会者面前都有。[l]\n舞台上的表演者也是。[l]\n冬夏面前也有――\n可恶，连聚焦视线都做不到的身体太憋屈了！"],["すると、僕の眼の前にいる奴も含め、\n一斉に小さいそれらが、\n互いに細かい――例の髭のような極細の繊維のようなものを延ばし、\n連結し出した。","这时包括我面前那只在内，\n所有小型个体突然\n彼此伸出纤细的――那些胡须般的超细纤维，\n开始相互连接。"],["き、きもちわる……","恶、恶心……"],["もはや、幻覚幻視がどうとかいうレベルじゃない。","这已经超出幻觉幻视的范畴了。"],["大神の言う『視える』がどういう感じか知らないが、\n兎に角、僕もどうやら、\n『何かが視えてる』ようだ。","虽不知大神所说的『看得见』具体指什么，\n总之我现在似乎\n也『看见了什么』。"],["周囲が暗い所為もあるかも知れないが、\n余計にそれらが際だって、おえ……","或许因为环境昏暗，\n反而更凸显出那些东西了，喂……"],["と、オトの方にも変化が生じた。","与此同时听觉也产生变化。"],["――制御系閉鎖式手順諒解……","――控制系封闭式程序理解……"],["――ミル　　　　　　　　ハ、\n　　　　ア　　ヤメ　ミ　ハ\n　　ル　　ナ　　ガ　ヒ　　サ\n　　　　キサ　ム　　ラ　　タ\n　　　マ　ズ　　サ　クイ\n　　　　カ　　　リヤオ　オ\n　　　　ク　ロ　コ　トハ\n　　　　　ネ　イイ　ハ、\n　　　イ　ツ　　　　　　　ワ。","――mi ru　　　　　　　　ha、\n　　　　a　　ya me　mi　ha\n　　ru　　na　　ga　hi　　sa\n　　　　ki sa　mu　　ra　　ta\n　　　ma　zu　　sa　ku i\n　　　　ka　　　ri ya o　o\n　　　　ku　ro　ko　to ha\n　　　　　ne　i i　ha、\n　　　i　tsu　　　　　　　wa。"],["――白一二三四五六七八九十黒。","――白一二三四五六七八九十黑。"],["――カミはわれとアリ。","――神与我同在。"],["――世は全て事も無し。","――世间万物皆虚无。"],["――なぁぁぁぁぁう゛。","――呐啊啊啊啊啊呜。"],["――３、ω、Σ、Ｍ、Ｅ、Ｗ、了。","――3、ω、Σ、M、E、W、了。"],["解る単語とそうでないのがごたまぜに聞こえ、\nもう完全に混乱し意味など把握できない。","能听懂的词和听不懂的词混杂在一起，\n已经完全混乱到无法理解其中含义。"],["リョウ、のオトの後、\n突如例の振動音モドキが止まり、\n心なしか『それら』も一斉に制止したように視えた。","在洪亮的声响之后，\n那种诡异的振动声突然停止，\n总觉得『那些东西』也同时静止了下来。"],["すると、","这时，"],["明","虽"],["瞭とは確認出来ないが、\n舞台の上のやつ、冬夏のも含む『それら』から始まり、\n最前列右端から順に『それ』が次々に一つにまとまって――\nその度に徐々に大きくなっていく。","然无法明确确认，\n但从舞台上的家伙——包括冬夏在内的『那些东西』开始，\n最前排右端依次将『那个』逐个融合――\n每次融合都逐渐变得更大。"],["このままだと……席の順序からいって僕の位置に来るまでには、[l]\n相当統合が進んでることになるなこれは……","照这样下去……按座位顺序轮到我的位置时，[l]\n恐怕已经完成相当程度的整合了吧……"],["く、来るぞ……ッ！","要、要来了……！"],["びゅっ！","咻！"],["と音がしそうなくらいの速度で、\n結構な大きさになった『それ』が\n眼の前を横にスライドしていったかと思うと、\n眼前にいた『それ』が姿を消した。","快到几乎能听见破风声的速度，\n已经变得相当庞大的『那个』\n刚从眼前横向滑过，\n面前的『那个』就消失了。"],["隣の女子にも恐らく居たのだろうが、\nそいつも吸収していったのだろうか。","邻座女生身边应该也有，\n难道连那个也被吸收了吗。"],["『そいつら』に気を取られていて気付かなかったが、\nまだ、彼女は鼻歌を続けてたらしい。[l]\nやっぱり、視えてないってことか、他の人には。","因为注意力被『那些家伙』吸引没注意到，\n她似乎还在继续哼着歌。[l]\n果然其他人是看不见的吧。"],["「……・ワ――」","「……・wa――」"],["あ、あれ？[l]\n舞台の照明が落とされて、\n幕も下りてきた。","啊、啊咧？[l]\n舞台的灯光暗了下来，\n幕布也开始降下。"],["シキは終わり――か。","仪式结束了――吗。"],["周りはまだ静かなままだ。","四周依然保持着寂静。"],["――あまりにも、\nタイミングが合いすぎている。よな、これは。","――这时机，\n未免太巧合了。对吧。"],["とても、\n無関係とは思えないが……[l]\nしかし……","实在\n很难认为毫无关联……[l]\n但是……"],["ううん、この一連の事は、\n姫様ちゃん達なら解るのだろうか。","唔嗯，这一连串事件，\n姫様她们应该能明白吧。"],["もしこれが彼女等の祭やらに関連しており、\nみせたかったモノがこれだとして――","如果这与她们的祭祀之类有关，\n想展示的东西就是这个的话――"],["そう、蔵の件もあれば、\nそもそも本家の目的、\nそして僕の視界がおかしくなってきていること、","再加上仓库那件事，\n本家的目的本身，\n以及我的视野开始变得怪异，"],["どうも事が起こりすぎている。","总觉得事情接二连三发生。"],["宮さんにも相談すべきだろうなあ。[l]\n僕に今回の事を勧めた時点で、少なくとも何を僕が得る事になるかは知ってるはずだし、","也该找宫小姐商量下了。[l]\n既然是她建议我参与这次事件，至少该知道我从中能得到什么，"],["……まさか『あれ』らの事を知ってるとは思えないから、[l]\nそれならそれで、本当は何を知らしめたかったのかは\n確認出来るだろう。","……虽然不认为她会知道『那些东西』的事，[l]\n但借此机会应该能确认\n她真正想让我知道什么。"],["終わった今となっては、\nどっちかというと『あれら』しか印象にないし、\nいわんとしていた事の方が気になる。","事到如今，\n印象深刻的反而只有『那些东西』，\n更在意她原本想表达什么。"],["或いは、\n大神に電話してみるか。","或者、\n给大神打个电话吧。"],["彼","不管"],["奴の『視える』のがどんななのか、\nモノにしろ視え方にしろ、\n多少は得るものがあるかも知れない。[l]\n久々に話もしたいしな。","是那家伙『能看见』的东西本身，\n还是他看待事物的方式，\n说不定都能获得些线索。[l]\n也挺久没和他聊天了。"],["あと、冬夏には知られずに済んでる事を祈るのみだ。[l]\nあらゆる意味で。","还有就是祈祷冬夏没察觉到这事吧。[l]\n从各种意义上来说都是。"],["兎に角、\n歌劇は終わってしまった。","总之，\n歌剧已经落幕了。"],["照明もまだ点かないし、アナウンスもないし、\n誰も一言も喋らないし、\nしーんと静まりかえったままだが。","灯光还没亮起，广播也没有动静，\n没人说一句话，\n现场依旧鸦雀无声。"],["二幕構成とかじゃないよな、これ。","该不会还有第二幕吧。"],["うーん、\n取り敢えず、この式に参加した事によって、\n変な体験をしたことは間違いなく確かだ。","唔——\n至少可以确定的是，\n参加这场仪式后确实经历了诡异事件。"],["劇の内容を感得というのとはちょっと違ってるけど、\nそこはどうなんだろうなあ。[l]\n宮さん大神だけじゃなく、勿論姫様ちゃん達にも当たることに\nなるだろう。","虽然和领悟戏剧内涵不太一样，\n这部分到底算什么呢。[l]\n不仅是大神先生，当然也要向姫様她们\n打听情况。"],["彼女達に誘われてこうなった訳だし、触れない訳にはいかない。[l]\nこの制服も返さなきゃならないし、\n話をするに当たっては注意を払わなければならなそうだが、\n兎に角後半は殆ど舞台どころじゃな――","毕竟是受她们邀请才来的，不可能避而不谈。[l]\n制服也得归还，\n谈话时恐怕要格外小心，\n总之后半段根本算不上舞台表演――"],["そうだ、変な体験をした、じゃなくしてる、んだ。[l]\nと、取り敢えず、身体の問題が、まだ現在進行中……","对了，不是经历了诡异事件，是正在经历。[l]\n眼下身体异常还在持续中……"],["「（ちょ、兄ぃ）」","「（喂、老哥）」"],["「……っっ！！[l]\nび、\n（吃驚したぁ……お、あ、おおう）」","「……！！[l]\n呜、\n（吓死我了……哦、啊、呜哇）」"],["かかか、狩屋か。","喂喂喂、是狩屋啊。"],["と、あれ？","等等，咦？"],["「（あ、あいうえお、アメンボアカイナ……おおう）」","「（啊、啊咿呜诶哦（译注：日语五十音前五个），水黾、赤海兔……呜哇）」"],["意識と運動神経がようやく連動したようだ。[l]\nま、まだ慣れてないのと、\n本気吃驚した所為でやや大きめの声を出してしまった。","意识和运动神经总算同步了。[l]\n只、只是还不习惯，\n加上受惊过度声音有点大。"],["何とか男子声とは気付かれないレヴェルを保つ努力はした！[l]\n任務遂行に熱心というか、女装とばれるのがいやだからです。","我可是拼命维持在不会被认作男声的程度！[l]\n与其说是任务心切，不如说实在不想暴露女装。"],["兎に角身体の主導権は取り戻せたらしい。","好歹夺回了身体控制权。"],["『あれ』が消えた所為なのか、\nやはり全てが夢で、\n狩屋の御陰でそれから醒めたのかは判然としないが……[l]\n否、後者はない、と思う。","不知是因为『那个』消失了，\n还是说一切都是梦境，\n又或是多亏狩屋才清醒过来……[l]\n不，应该不是最后那种。"],["「（もう終わりにゃえ。[l]\n兄ぃまさか寝てたんじゃにゃいだろうな？）」","「（该结束了吧喵。[l]\n老哥你该不会睡着了吧喵？）」"],["「（そ、そんなことない……とおもう、[l]\nてかむしろそうだったらどんだけ）」","「（才、才没有……大概，[l]\n倒不如说真那样的话也太扯了）」"],["「（しっ。[l]\n少しだまれ。そんな暇にゃいから）」","「（嘘。[l]\n闭嘴。没空说这些喵）」"],["明るくなる前に脱出した方がそりゃいいだろうけど、\n隣の女子は……","趁亮灯前溜走确实比较好，\n但隔壁的女生……"],["狩屋は一瞬そっちを視て、\nあ、という表情をしたがすぐ僕の方に視線を戻し、\n手を取って僕を立たせた。","狩屋瞥了那边一眼，\n露出恍然表情又立刻转向我，\n抓着我的手把我拽起来。"],["早足の彼女に急かされて、\n仕方なく黙ったまま、\n映画を途中退席する客みたいに前屈みでついていく。","被她快步催促着，\n只好沉默地\n像中途退场的观众般弓着背跟上。"],["諸々で忘れかけてたが、\n隣の席の彼女だけでなく、\n黒衣の人物と猫も気にはなるんだけど……","差点忘了，\n不光是邻座的她，\n黑衣人和猫也很令人在意……"],["猫に関しては宮さんが何から警告されてたし、\nこれ以上周囲に顔を晒してもリスク高すぎる。","但是关于猫的事已经被宫小姐警告过，\n而且再继续在众人面前抛头露面的话风险太大了。"],["何しろ、\n己のこの格好。[l]\n隣の女子が何でお見通し＆お見逃し下さったのか？","说到底，\n自己这副模样。[l]\n旁边那女孩为何会看穿又放我一马？"],["という、\n今の僕にとって有り難いのか、\nややこしい要因が増えて厄介なのか、","总之，\n对现在的我来说不知该庆幸\n还是该因复杂因素增加而头疼。"],["微妙な属性を持った女子の登場はさておき、\n普通はこんなのばれたら色んな意味でもう。","带着微妙属性的女孩的登场暂且不提，\n正常情况下这种事被发现，不管从哪方面讲都已经完蛋了。"],["狩屋は僕を、\nてっきり舞台と反対方向、\n後方の出入り口に連れてくのかと思いきや、","原以为\n狩屋她肯定会把我带往\n与舞台相反的后方出口，"],["なんと舞台下横の、所謂校歌の歌詞――木彫りのあれ――\nが飾ってある真下の入り口に引っ張っていくのだった。","没想到竟拽着我走向舞台侧面——\n那幅刻着校歌词的木雕装饰正下方的入口。"],["しかし、暗いのと、\n狩屋が大道具だからという所為もあるのか、\nはたまた舞台終わりの余韻なのか、\nこっちに気を払う者は殆ど居なかった。","不过由于光线昏暗，\n或许也因为狩屋是道具组成员，\n又或是演出结束的余韵未消，\n几乎没人注意到我们。"],["静かに其処に入ると、","悄悄潜入那里后，"],["「ま、今日の処はさっさと帰るといいにゃわ。[l]\n……きーちゃは色々兄ぃに用あるだろうけど、[l]\nにゃんにしたって落ち着いてからにゃな。","「嘛今天你就赶紧回去吧。[l]\n……小姬肯定找哥哥有事，[l]\n但不管什喵事等安定下来再说。"],["制服もその時返せばいいから。[l]\n本人に伝えとくから心配すんな」","制服到时候再还也行。[l]\n我会转告她的别担心」"],["と、にべもなく狩屋は言った。","狩屋干脆利落地说。"],["「てて、ていうか、これは、この式は結局さ……」","「等等、话说这个仪式到底…」"],["「あ？[l]\nああ、まあ、\n――その辺はだからきーちゃと話してよ」","「啊？[l]\n啊啊，那个\n――所以都说了去和小姬谈啦」"],["「あいや、そういう事じゃなくてだな、\n――ま、まあ今はゆっくり話せる状況じゃないのは\n解ってるし端的にも説明しにくいのは確かだけど……」","「不是、我想说的不是这个\n――嘛虽然现在确实不是\n能慢慢详谈的状况…」"],["「だぁらさっきから言ってんにゃろ。[l]\nほれちゃっちゃとうごけ」","「所·以·说！[l]\n快给老娘动起来」"],["「わ、わかったって。[l]\nじゃあ、姫様ちゃんによろしく、\nお前もさんくす……なのかなあ……」","「知、知道啦。[l]\n那替我向姫様问好，\n也谢谢你…大概？」"],["「にゃんでもいーわばか。[l]\n兄ぃに感謝されてもしゃーにゃいのっ。[l]\n帰り帰り」","「喵的谁要你道谢啊蠢货。[l]\n被老哥感谢超不爽的。[l]\n快滚快滚」"],["あーそうすか。[l]\nわかったわかった。[l]\nまーお前は元々そんなに乗り気じゃなかったしな。","啊这样啊。[l]\n懂了懂了。[l]\n反正你本来就不情不愿的。"],["姫様ちゃんがいたらこんな態度もとれんかったろうが、\n仕方ない。","要是姫様在场你也不敢这态度吧，\n没办法。"],["僕もお前と顔突き合わせて真剣な……内容はアレだが、[l]\n相談なんかしたくはないっつーの。","我也不想和你面对面谈那么沉重的…内容，[l]\n那玩意儿确实够呛。"],["さぁてあとは、知狡さんの迎えの車まで何とも接触せずに乗り込めるかどうかだ。[l]\nこの身に起きた諸々の事の検討はそれから！","现在问题是怎么在不被任何人发现的情况下溜到知狡阿姨来接应的车上。[l]\n关于发生在身上的种种等上车再想！"],["知狡さんの事だから時間にはきっかり来てると思うが、\n何にしろこういうのはもう結構。","以知狡阿姨的性格肯定会准时到，\n但这种事真的受够了。"],["見知らぬ場所で一人重大な事を成さねばならないという感覚は、\n大学受験を思い出すわい。[l]\n……いいんだ、色んな意味で終わった事は。","在陌生地方独自完成重大任务的感觉，\n简直像重温高考。[l]\n…不过也好，各方面都结束了。"],["舞台裏というか舞台袖みたいな所の出口は、\nアリーナとは隔絶されてるので、\nドアを開けても光がそっちに洩れることはない。","后台出口处\n与观众席完全隔绝，\n就算开门也不会漏光。"],["狩屋はそれでもがさつな動作ではなく、\nあくまで慎重に扉を開け、\nしかし僕の手は乱暴に引いて一緒に外に出た。","狩屋虽然动作粗鲁地\n拽着我往外走，\n但开门时还是小心翼翼。"],["「一応敷地の外までは送るにゃさ。[l]\n何かあったらきーちゃに面目がたたにゃいからな！[l]\nほれ来い兄ぃ」","「至少送到校门外。[l]\n要是出岔子我可没脸见小姬！[l]\n赶紧的老哥」"],["「い、痛いですぅ先輩ぃ」","「痛痛痛，好疼啊前辈——」"],["「や、やめぃ！[l]\nなまじ似合ってんにゃから！[l]\nも、も、もうよせ！！」","「别、别这样！[l]\n偏偏还超级合适！[l]\n够、够、够了啦！！」"],["はん。[l]\nまあ僕も何とか復調してきたわ。","哼。[l]\n不过我也总算恢复些状态了。"],["或る意味ではお前の御陰だな。[l]\nそこは素直に感謝してやろう。","某种意义上多亏了你啊。[l]\n这点就老实道谢吧。"],["「じゃーな。[l]\nまたどうせあとで……あ」","「那就这样。[l]\n反正待会儿还会……啊」"],["振り向くと、\nいつの間にかあの女子も出入り口に立っていて、","一回头，\n不知何时那个女生也站在出入口处，"],["「♪」","「♪」"],["「？[l]\nまだあっこまで行くにぇ、ほれ」","「？[l]\n还没走到那边呢喵，快来」"],["僕に、\nというより狩屋に向かってにっこりと笑みを浮かべて、\n目立たないように手を顔の前でひらひらさせていた。","对着我，\n不如说是朝着狩屋露出灿烂笑容，\n悄悄在脸前轻轻晃动手掌。"],["狩屋は気付いてないのか、そのまま僕の手を引き出す。","狩屋似乎没注意到，继续拽着我的手往前走。"],["それ以上、気を回す余裕は無く、\n僕は敷地外まで狩屋に連れられて行った。","再没有多余精力去在意那些，\n我就这样被狩屋带到了场地外。"],["宮さんが喋る猫に関して知ってる素振りをしていたことにも、\n三春の蔵から持ち出した紙片に反応をしていたことにも、\n当然、気を回す余裕は無かった。","无论是宫小姐对会说话的猫表现出的了解态度，\n还是对从三春仓库带出的纸片产生的反应，\n自然都无暇顾及了。"],["雨は小雨になっていた。","雨势已转成细雨。"]],"context":[["SC_M_019.ks/index/1/text"],["SC_M_019.ks/index/3/text"],["SC_M_019.ks/index/5/text"],["SC_M_019.ks/index/7/text"],["SC_M_019.ks/index/9/text"],["SC_M_019.ks/index/11/text","SC_M_019.ks/index/21/text","SC_M_019.ks/index/98/text","SC_M_019.ks/index/359/text","SC_M_019.ks/index/573/text"],["SC_M_019.ks/index/13/text"],["SC_M_019.ks/index/15/text"],["SC_M_019.ks/index/17/text"],["SC_M_019.ks/index/19/text"],["SC_M_019.ks/index/23/text"],["SC_M_019.ks/index/25/text"],["SC_M_019.ks/index/27/text"],["SC_M_019.ks/index/29/text"],["SC_M_019.ks/index/31/text"],["SC_M_019.ks/index/33/text"],["SC_M_019.ks/index/35/text"],["SC_M_019.ks/index/37/text"],["SC_M_019.ks/index/39/text"],["SC_M_019.ks/index/41/text"],["SC_M_019.ks/index/43/text"],["SC_M_019.ks/index/45/text"],["SC_M_019.ks/index/47/text"],["SC_M_019.ks/index/49/text"],["SC_M_019.ks/index/51/text"],["SC_M_019.ks/index/53/text"],["SC_M_019.ks/index/55/text"],["SC_M_019.ks/index/57/text"],["SC_M_019.ks/index/59/text"],["SC_M_019.ks/index/62/text"],["SC_M_019.ks/index/64/text"],["SC_M_019.ks/index/66/text"],["SC_M_019.ks/index/68/text"],["SC_M_019.ks/index/70/text"],["SC_M_019.ks/index/72/text"],["SC_M_019.ks/index/74/text"],["SC_M_019.ks/index/76/text"],["SC_M_019.ks/index/78/text"],["SC_M_019.ks/index/80/text"],["SC_M_019.ks/index/82/text"],["SC_M_019.ks/index/84/text"],["SC_M_019.ks/index/86/text"],["SC_M_019.ks/index/88/text"],["SC_M_019.ks/index/90/text"],["SC_M_019.ks/index/92/text"],["SC_M_019.ks/index/94/text"],["SC_M_019.ks/index/96/text"],["SC_M_019.ks/index/100/text"],["SC_M_019.ks/index/102/text"],["SC_M_019.ks/index/104/text"],["SC_M_019.ks/index/106/