:17854}],[{"start":17880,"end":17905}],[{"start":17921,"end":17958}],[{"start":18061,"end":18090}],[{"start":18121,"end":18165}],[{"start":18195,"end":18261}],[{"start":18292,"end":18330}],[{"start":18356,"end":18367}],[{"start":18399,"end":18412}],[{"start":18422,"end":18468}],[{"start":18530,"end":18606}],[{"start":18636,"end":18651}],[{"start":18682,"end":18692}],[{"start":18722,"end":18727}],[{"start":18758,"end":18764}],[{"start":18790,"end":18812}],[{"start":18818,"end":18833}],[{"start":18844,"end":18924}],[{"start":18930,"end":18971}],[{"start":19001,"end":19004}],[{"start":19035,"end":19040}],[{"start":19064,"end":19111}],[{"start":19117,"end":19134}],[{"start":19164,"end":19238}],[{"start":19264,"end":19267}],[{"start":19297,"end":19337}],[{"start":19363,"end":19367}],[{"start":19401,"end":19435}],[{"start":19461,"end":19494}],[{"start":19502,"end":19506}],[{"start":19516,"end":19552}],[{"start":19610,"end":19620}],[{"start":19646,"end":19725}],[{"start":19764,"end":19831}],[{"start":19883,"end":19893}],[{"start":19902,"end":19905}],[{"start":19914,"end":20088}],[{"start":20114,"end":20153}],[{"start":20159,"end":20169}],[{"start":20199,"end":20247}],[{"start":20277,"end":20305}],[{"start":20335,"end":20439}],[{"start":20469,"end":20533}],[{"start":20563,"end":20717}],[{"start":20747,"end":20831}],[{"start":20861,"end":20882}],[{"start":20912,"end":20967}],[{"start":20998,"end":21088}],[{"start":21112,"end":21227}],[{"start":21257,"end":21384}],[{"start":21457,"end":21476}],[{"start":21486,"end":21522}],[{"start":21532,"end":21549}],[{"start":21555,"end":21571}],[{"start":21615,"end":21616}],[{"start":21625,"end":21626}],[{"start":21635,"end":21730}],[{"start":21756,"end":21762}],[{"start":21793,"end":21808}],[{"start":21834,"end":21845}],[{"start":21880,"end":21902}],[{"start":21908,"end":21914}],[{"start":21944,"end":22069}],[{"start":22095,"end":22111}],[{"start":22121,"end":22130}],[{"start":22140,"end":22208}],[{"start":22217,"end":22230}],[{"start":22236,"end":22252}],[{"start":22285,"end":22304}],[{"start":22360,"end":22365}],[{"start":22395,"end":22406}],[{"start":22437,"end":22444}],[{"start":22480,"end":22483}],[{"start":22491,"end":22497}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_064.ks","basename":"SC_M_064.ks","indexIds":{"「それ、\nすぐ探せるもんか？」":0,"「うーん、きぃのくれた地図じゃ、\nかなりアバウトだから、\n実地の方の印次第かなあ……」":1,"当時、確かに僕も一緒に埋め直したとは言え、\nどこまで地形が保持されてるかは定かでない。":2,"冬夏の言ってたのは、きっとこれらのことだけど、\n埋め直した事までは知らなかった筈だ。":3,"あの時、":4,"僕は視てたよ少年。":5,"うーん、十何年も残すにはあまりにも此処では心許ないな。":6,"さて、そこでだ。":7,"この子。":8,"音っていうんだよ。":9,"キミと遊びたくて先刻から視ていた。":10,"モノは相談……いや、":11,"頼みたいんだけれどね、":12,"この、音と、":13,"別の、":14,"もっと確実に後世に残せる場所に、":15,"きちんと埋め直すと言うのはどうだろうか。":16,"奇士、道具さん……が、[l]\nそう、やっぱりあの時逢ってたあの人の提案で、\n僕と、音……とで、一緒に。":17,"さっきのあの人の事なら心配いらないよ。":18,"あの人の部下──ああ、いや、お仲間にもね、念の為、":19,"了解を得てるからね。":20,"物事は、関わる人数を増やせば増やす程、":21,"混迷の様相を呈して、":22,"愉快なことになるんだよ。":23,"あの人は、敢えて自分の意思の及ばぬ要素を取り入れて、":24,"無":25,"作":26,"為":27,"性、":28,"予":29,"測":30,"不":31,"可":32,"能な":33,"出":34,"来":35,"事が、":36,"起こるのを望んでるからね。":37,"複数人の人間同士が集まり、関わると、":38,"ほんとうに、放っておいてもそれはそれは、":39,"驚く程に──。":40,"それは、人がそれぞれ意思持つ存在だからだ。":41,"自分以外が全て、等しく、自分より下な訳じゃない。[l]\nそれぞれがそれぞれの思考主体なんだ。":42,"自分以外のことは想像するしかないから、\n誤解しがちになるけれど、":43,"それぞれに意思がある。[l]\n駒なんかじゃ、ない。[l]\n背景でもその他大勢の":44,"群":45,"衆でもなく、":46,"それぞれが。":47,"無論一個一個に等しい重さで接するには、\nあまりにも人の心と体は小さいから、\n便宜上どうしても相対的な位置付けや、\nその基準のもとに思考をすることは否めないだろう。":48,"しかし、\nだからといって、":49,"建前をそのまま論拠として大義名分化は出来ない、\nその筈だ。":50,"道具さんや、\nあのひと、宮さ──否、ミルハがしようとしてるのは、\n":51,"机":52,"上":53,"の":54,"学":55,"問に等しい。":56,"現実の肉との接触が、\n言葉を用いずともそこにある何かが、":57,"僕等には──":58,"そして、それでも、\n言葉とは、何かを伝えるためにあるんだ。":59,"どうしても伝えたい何かを、\n必死に相手にわかって欲しくて、\nヒトが創り上げた尊きモノ──":60,"「その、手紙寄越した奴もなあ、\n何でこんな七面倒な事をしたもんか、\n他にどうとでも遣りようがあったろうがよ」":61,"「きぃ……おん……」":62,"にしいしおんっていうの。":63,"……あのこが、きぃだった、のだな。":64,"まこちゃん、一緒に遊んだってば！！[l]\n　　ニコ上のお兄ちゃんって、覚えてるもん。":65,"確かに僕は二個上で、一緒に遊んでいた。[l]\n同じ日に、矢張り二個下の冬夏とも。":66,"嘘ではなかった。":67,"だが玄ノ森に来て、\n再会した彼奴は、\nどうして、\n●の格好をしてた、否、してるのか。":68,"道具さんの一人称が『僕』だったから、\n彼奴も引っ張られてそう称してたのかと思ったが、\n彼奴は●、いや、……。":69,"あの時西石音と名乗ったあの子が、\n何故、\n今は西石貴奴と名乗って、\n僕との、過去の記憶を保ちながら、\n何故、":70,"このなまえはきらい、":71,"ほんとうになりたいものがあるから、":72,"きっと、":73,"ああ、そうだった、":74,"ＸＸになったら、":75,"西石貴奴と名乗るのだと、":76,"オト──":77,"於":78,"菟、[l]\n　　即ち猫は、[l]\n　　養蚕に於いて、蚕を害する鼠を補食するものとして、[l]\n　　つまりキヌを護る者として重宝されたという。":79,"音は":80,"隠にかかり、[l]隠は":81,"鬼に繋がる。":82,"きぃ。":83,"この子は●にして●、不安定で欠けているが故に、[l]\n　　何かを渇望し前へと走り続ける進化の":84,"魁。[l]\n　　悔いるも留まるも許されぬ、[l]\n　　玖威":85,"禍を":86,"留の子。":87,"僕に一体何が出来るのか、\nそれは分からないけれど、\n或る意味で彼奴は、僕とおなじ、":88,"忌まれ、己自身も":89,"下":90,"心に苛まれる、『身":91,"盗りの生":92,"やし』──":93,"だから、僕に出来る事があるのなら、":94,"わたしたち、[l]\n　　ずっと、[l]\n　　友達だよね？":95,"僕は、":96,"まこちゃんとせっかくともだちになれたのに。":97,"それに姫様ちゃん、狩屋、\nそして、冬夏、":98,"だぁれ？":99,"ぼく？[l]\n　　ぼくは、\n　　いー、\n　　いー、\n　　いーくぼまこと……":100,"じゃ、いーちゃんね。":101,"冬夏は、[l]\nあの時、[l]\n人の子として初めて僕が、\n飯窪の領内から外界に出たあの日に、\n初めて出逢い、話した存在。":102,"漸く肉を得て世に生まれ落つより遙かイニシエに、\nうっすらと覚えにある、\n古巣──Lu=Leの魔女にそっくりだった、\n……だからというわけではないけれど、[l]\n僕が、あのとき彼女に、\n":103,"郷 ":104,"愁のような、\nミルハや他の取り巻きとは違う、\n起源的な繋がりのような、\n言い様のない切ない想いを抱いたのは、[l]\n……それも、[l]\n八相という、\n僕の断片の継承者達だったからなのかも知れないが、":105,"だからか、冬夏の方も僕にすごく懐いていた。[l]\n初回を含め二度しか逢ってなかったのに、[l]\n僕等は、":106,"とうかはね、いーちゃんとけっこんする！":107,"それはいいね。[l]\n　　キミ達二人なら、いい子を産むだろうな、\n　　とてもいい。":108,"ぼくも、":109,"あのひとの兄の思惑は、\n今にして思えば何となく察しもつこうが、\n僕は、\nそういう理屈とは別に、":110,"とうかと。":111,"じゃ、一緒に君たちの手紙でも入れてみるかい？[l]\n　　へえ、そっちの子は……この子が、":112,"あわわわわいっちゃだめーーー！！":113,"姫様ちゃんには秘密にしてたのだったか、":114,"ははは、いいじゃないか。[l]\n　　お似合いだよ？[l]\n　　折角だから今約束してしまえば、え？":115,"しかし、\nきっとキヅいていた、":116,"きーちゃん？":117,"…ゎかります":118,"あの二人の確執の根がそこにあるのかは、\nわからないけれど、":119,"わたしのことわかりませんか。":120,"再会するまで、\nいや、\n再会してからさえも、\n僕の方は、\nまともに気付けずにいた……[l]\nあの兄の所為でも自分自身の所為でもあるけれど、\n今はただ、……。":121,"尤も、\nあの子等の事は或る意味で最も重要なタブーでもあって、":122,"今回の『":123,"劇』が始まるまでは、\n真っ先に忘れ去るべき事項でもあった。[l]\nそれは僕にとってというよりも、\nあのひと達にとっての都合、\nという意味合いが大きかった訳だが、":124,"その為かどうかは──考えたくはないが、":125,"僕と彼女等の出逢いを覆い、\n十数年かけて糊塗された僕の記憶の上に、\nまるで駄目押しのように、\n確実に上書きするかのように、\nあのひとと僕は、\n知らぬ者同士のように、\n出逢わされ──その":126,"実再会だった訳だが、":127,"僕は、\n……きっとあのひとの思惑通りに、[l]\nあのひとに、\n魅入られた。":128,"ぼくはあなたをすきになった。":129,"あなたのことは信用してなかった筈なのに。":130,"故に、なんの仕込みでもなく、\n純粋にあなたに惹かれたと言えるのかも、\nしれない、\nついこの間まで、\nこの感情がそうだと──すきなのだと確信はせずとも、\n心のどこかではいつだってあなたとのかかわりが、\nとても嬉しく、\nあなたと共に居られることが、\n心地よく、":131,"でも、":132,"私ねぇ、\n　　まことさんのこと好きだよ。":133,"違うよ。":134,"あんなやわい意味じゃないよ。":135,"あなたがすき。[l]\n　　すきです。[l]\n　　まことさんがすき。":136,"きらい？[l]\n　　だめ？私じゃあなたのになれない？[l]\n　　他にすきなひと居るの？[l]\n　　あっ、宮さま？":137,"あいのこくはくすらさせて貰えずに。":138,"それ以前に、\nすきだという自覚すらも、\n無かった訳で、":139,"そうなんだと、自分で思ったのも、\nあなたに突き放されてから後だったし、":140,"だから、\n伝えたかった筈の思いは、\n伝えるより前に、":141,"沢山の感情を通り過ぎ、\nずたずたに引き裂いて──":142,"はじめは恭しく、\n想いは恋に、\n急を告げられ、恐れて、\n悲しんで、\nそれから怒り、憎悪し、\n忌み嫌いたくとも、":143,"それでも、":144,"………。":145,"だから、":146,"だから、\n身の置き所が分からなくて、\n混乱し、\n迷走した、":147,"でも今は──":148,"全部思い出した今でも、[l]\n別にあなたを憎んじゃいない。":149,"ただ、言えなかった事を、[l]\n伝えたい、[l]\nそして、[l]\n姫様ちゃんや、[l]\n狩屋や、[l]\nきぃ……音や、[l]\nそして冬夏にも、":150,"あなた、[l]\n宮さんにも、":151,"……祭が終わったら、[l]\n　　また会おうよみんなで、\n　　ねっ？":152,"にゃ、にゃによ、\n　　そんな寂しそうな顔しにゃいでよぅ！[l]\n　　じゃ、じゃあ、\n　　いいや、ま、電話でもメールでも、\n　　キンキュウならいつでもよこして、\n　　可能なら相手したげっから、\n　　わかった？いいよね？":153,"あいたい。":154,"「……おい、[l]\n大丈夫か？」":155,"「あ？[l]\n──あ、すまん」":156,"「まあ状況的にゃー仕方ないがな。[l]\n幾らお前自身の中身に色々進展があったにせよ、\nいきなり絶好調のテンションで来られたらそれは、\n……そういや、いーくん、[l]\n大体、丸１日分は飲まず食わずだろうが」":157,"「ああ、それに関しては何とか、\nそれに、\n下手に喰うと眠くなるし……」":158,"「祭の最中に何かしようってんなら、\n逆に今のウチだけどな、\nま、兎に角今はモノをみつけ──\nあ、」":159,"「？」":160,"「悪いが、":161,"月":162,"吼":163,"狼は使えないぜ、\nいよいよになったら仕様がねーけど、\nできればかれおんは、」":164,"もとより追われる僕や、\n部外者の筈の大神は兎も角、\n彼女は……チノ嬢に話をつけたらしいとは言え、[l]\nあちら側に属する人間だ。[l]\nこちらと同調して動くことは明確な裏切りを意味する、":165,"それへの報復を大神は危惧しているのだろう。[l]\n黙ってやんわり離脱するのと、\n明瞭に意思表示をするのでは、\n相手の容赦の度合いにも影響があろう、\nどっちがよりいいのかは相手によりけり、\nいやいや、そもそもそんな社会人の心得的な価値観とか、\nそういうのが通じるひとかどうかは知らないけど……[l]\nともあれ、\n事を無為に荒立てる必要もない。":166,"「分かってる、\n大丈夫、すぐわかる……はずだ。[l]\nもしあの兄の──そして周辺が仕込んでるなら、\n僕にそれが渡らないような事はない……と思う」":167,"道具さんの意思は分からないが、\nあの兄の意図は、\nあのときに、僕は、\nだから、":168,"彼処には、\n彼処に埋めたのは、":169,"さいごのソウビ。":170,"僕と冬夏が署名した、":171,"この子は今、\n　　永い眠りについてるけれど、\n　　目覚めたときはきっと、\n　　キミのトモダチになってくれる、\n　　だから、":172,"RolePlayingGame（役を演じる遊戯）には、":173,"最強の装備、最後の切り札、":174,"がツキものなんだ。":175,"「":176,"Sea":177,"l\"O\"と、\nそのheartにこめたタマが、」":178,"僕等のともだちが、\nめざめをまってる、\n奥津城で、\n白の城で。":179,"「……それってばよ、[l]\nあれらにとっちゃ目的が食い違ってねーか？[l]\nあの兄貴が、溺愛する妹の障害になるようなもんを、\nん、まさか罠──」":180,"「いや、合ってる、\nというよりも、\nそれが、それこそが、」":181,"そうか、キミ、もう出来るハズだよ？[l]\n　　カミを遺すウタもペンも、つかいかたをしってるだろ？":182,"君等ふたりはいずれもボク等の裔、\n　　幾世代をも超えて今ここに、\n　　カミあわさる、":183,"三春と飯窪の名において、":184,"クチガタき我が朋のネコダマを、":185,"３ハル、Ｅ凹、":186,"l\"O\"きものにかきくわえなさい、":187,"め、くち、そしてねこのひげ。":188,"３：Ｅ":189,"……それは猫の『":190,"王』に連なりしもの──":191,"そのとき僕は、[l]\nはじめて、":192,"あの兄の持っていた『何か』のかけらを、\nあの兄が●●や●●とともに抱いていたらしい、\n決意と共に。":193,"飯窪真言という、[l]\nかつてあれらの身内であり、[l]\n魔眼の刺し手としてLu=Leの敵となり、[l]\nイツワと相打ちになった挙げ句、[l]\nその身を奪われた肉の一族の裔と、":194,"三春冬夏という、[l]\nLu=Leの中心だったリデルの血族、[l]\nドレミリアの裔、":195,"そんな僕等の未来を視越したかのように、\nあの兄が、僕に託した事がある。":196,"「……遠回りにっていうか、[l]\n抽象的にすぎて、\n言ってた事はいまだにちゃんと理解出来たかは疑問だけど……」":197,"きっとあの兄は、\n妹の事を、":198,"……と、[l]\n大神は吐き捨てるように、\n僕と視線を合わさずに、":199,"「……相変わらずあの兄貴はワかんねぇ。[l]\n何が粋だか知らねえが、\n言わずとも通じる事が格好いいってのも、\n時と場合によるだわさ。[l]\n……俺みたいなのが言うのもアレだけどな、」":200,"そう言った。[l]\nそして続ける。":201,"「イキがるっていうのはさ、イーくん。[l]\nぶっちゃけ俺は嫌いなんだよ。[l]\nコトバを使わず相手の意図を探れるモノが言う事じゃないが、\n自己満足で誰も得をしない、自己犠牲への自己陶酔、\n痩せ我慢さ。[l]\n視てる方が辛くなるだけだ」":202,"「言葉では……伝わらないものも、ある」":203,"「まーね。[l]\nただ融通を利かせろってことだよ。[l]\nまあ、その辺の匙加減が個人の個性とやらかも知れないがな。[l]\n口に出さない方が効果的な場合もあれば、\nがつんと言葉にした方が効果的な場合もあるわさ。[l]\n杓子定規に、黙って行動で示すのが粋って価値観は、\n時に人を不幸にすんだよ。[l]\nそれでもいいという自覚が、粋ってものかもしんねーがな、\nま、いずれ好きか嫌いかってトコに帰結しちまう、\n而してそこに留意するか無視するか、\nそこが、」":204,"ＣとＤとの落差、\n敷衍して……は無いかもだが、[l]\nＸとＹの温度差でもある。":205,"大神は苦々しく言い放つ。[l]\nそして再び続けた。":206,"「兎も角、\nもういーくんは決めたんだろう。[l]\nあれの言いなりには──」":207,"ちがうよ。":208,"さっきお前が言ったとおり、\n言葉では伝わらない事もある裏で、\n言葉でないと伝わらないモノもある。":209,"黙ってコトバも交わさずに、\nゴカイし合ったまま、憎み合うのは違うと、\nそう思っただけだ。":210,"僕はあのひとに、\n僕の想いを伝えにいくんだ。[l]\nその為に、\nあのひとのところへいくんだよ。":211,"コトバを使って意図を伝え合うのが、\nヒトの、":212,"他とは違う、好い所だ、そうだろ？":213,"僕がそう言うと、":214,"「コトバ使うが故に生じる誤解もごまんとあるけどな」":215,"と奴は皮肉った。":216,"わかってるよ、と僕も嗤い返す。":217,"「にしてもあれだな、\nこんな時間になっても、\n何の接触をしてこないってのは相変わらず妙だが、\nま、もしかすると、\n今なら逃げられるのかもな。[l]\nでもそれはヤなんだろ？」":218,"「……そうだな」":219,"「ケジメって言い方が合うかどうかは、\nいーくん次第だけどもな、\nあの萌え店長とは色々、\n白黒はっきりさせとかないとな。[l]\nでないと、\n今後必ず、\nあれを思い出す度に、\n延々とあれを憎み続ける事になるだろうからな」":220,"……きっと、そうなんだろう。":221,"「あの兄貴の思惑が何かは知らないが、\n足掻ける足がかりになるんなら、\n藁でも掴もうってか、\n早いとこそのブツをだな」":222,"「それがどうにも、\n……彼奴絵心ないなぁ、[l]\nぜんっぜんわからん」":223,"「それか地形ごと変わっちまってるかだよな」":224,"「でも、\nめじるし付けたのは最近って事だろ、\n地形の変化は関係無い」":225,"「……ま、[l]\nこの遅延も、\n雫様による何かの布石だと思うとするか……[l]\nかれおん、だいじょぶか？」":226,"「え、ええ、だいじょぶデス」":227,"「無理しなさんなよ。[l]\n発見の遅れっつーよりも、\n連中の動向に対して後手になるのが問題なんだよな……」":228,"「……手分けして探すのとどっちがリスク少ないだろな？」":229,"「……今のいーくんを単体でおくのはちと気が進まないからのう」":230,"「じゃあしょうがないか……」":231,"「あ、あの、私が──」":232,"「いや、まだいい、何とかする」":233,"「ええ、僕等が何とか」":234,"「で、でも……」":235,"しかし、\nようやくその場所を発見した頃には、\nかなり時間を喰っていた。[l]\nともあれ、\nきぃのくれた手紙にあった、\n目印が確かにそこに、\nそうと思って探さねば気付かぬように、\nある。[l]\n後は掘り出さねばならないが、\n周囲は大分暗くなっていて、\n僕等も疲労と緊張感で早い所食事と休憩が必要な状況だった。":236,"「……ごめん、２人とも……こんなに、[l]\n手こずるとは……」":237,"「あとは掘ってのお楽しみってとこだろ。[l]\n取り敢えず場所確定さえすりゃ後はなんとか……[l]\nなるんだよな？」":238,"「……ああ、たぶん」":239,"「あーん、何とも自信のねぇオコトバだなあ。[l]\nつーか、\nやっぱおかしいな」":240,"「？なにが」":241,"「俺等３人がこうやって、\n体力も神経もごっそり磨り減る程に、\nたーーーっぷり時間かけてしもうたにも関わらず、\n何で向こうさん、\n動きも何にもないんだ？」":242,"「……なんでデショウね」":243,"「泳がされてる……？[l]\n奴等の中でこっちにかまける余裕も無い何かが起きた…？[l]\nあーもう、\n……いや、俺もかれおんもまだ温存せねば、[l]\n下手に検索かける方が奴等の思う壺、という事も」":244,"「……卑下する訳じゃないけど、[l]\nやっぱり──\nなんだかんだいって僕に関する事は優先順位が低かった、\nて事じゃないかな……」":245,"「……いえ、それは、[l]\n──」":246,"「……まあ、[l]\n今お迎えに来られても実際困るしな。[l]\n何にしても想像しか出来ないのはアレだなあ」":247,"「アレ？」":248,"「善し悪しは兎も角も、\n分かってる未来を待つ方が、覚悟や心の準備が出来るだけマシ、\nてこと。[l]\nまあ悪い結果を待つ場合とか、\nその期間が長いとじわじわ来る厭さ加減はあるが、\n俺個人としちゃ、\n先行きが未確定のまま宙ぶらりんのまま焦らされる方が、\n精神的にくるな……」":249,"「箱を開けるまで中身が分からないのがイヤで、\n箱を開けて中を確定させたのが僕等の始祖……だったかな」":250,"「そのイヤさを知ってるからこそ、\nこっちにも仕掛けて来るってか。[l]\n意図的であれば相当陰険じゃのう」":251,"「……箱の中に残り世に放たれなかったのは前兆（omen）であって、[l]\nつまり先のコトが一切予知出来なくなったコトが、\n即ち「希望」だと、[l]\nあの、上司から聞いたことが」":252,"「……若干急な転換スねかれおん。[l]\n少しばかり話の筋がずれてますが」":253,"「あうあ、すみません……あっ、[l]\n取り敢えず食べて、休んで、\nそれから掘りましょうか」":254,"「ですかね……[l]\nこの時間まで何も無いということは、\n多分、もう僕の事は」":255,"……どうでも、いいのかな。":256,"「……メールのレス待ちする片思い男子みたいな顔、[l]\nしてるぜいーくん。[l]\nこっちから玉砕しに行くって決めたんじゃけえ、\n今は逆に何も無い事の方を祈りたまえ」":257,"「なっ、\n玉砕って何だよ、\n僕ぁ、」":258,"「飯を仕入れに行くにも３人一緒じゃなきゃ危ないからな、\nとっとと行こうぜ。[l]\n此処に留守番置いてく訳にもいかんし、\n２人とも、はっきりと場所覚えたか？」":259,"「あっ、ハイっ」":260,"「あ、ああ」":261,"「胸騒ぎがまるでしねえ、というざわざわ感があんだよな……[l]\nまあいいや、行こか」":262,"僕等は栄養補給と休憩をし、\n閉まりかけていたホームセンターを近場でみつけ、\nシャベルに加え念のため懐中電灯も購入し現場に戻り、\n落ち着いてから、掘り出し作業に入った。":263,"やはり、あのひとたちからのアプローチはその間、\n一切無かった。":264,"「奇しくも、最早人目を気にする時間帯じゃない。[l]\n始めようか」":265,"シャベルは２本だけ購入していたので、\nかれお嬢には周囲に気を配って貰って、\n僕と大神でその場を掘り進めた。":266,"が、\n如何に年月が経とうと子供の所行、\n或いはなにがしかの意思があったものか──\n大した労もかけずにそのモノに辿り着いた。":267,"「箱、はこ、ハコね……、[l]\nほれ、いーくん」":268,"「………」":269,"出て来たのは、\nブリキの様な箱、\n力を入れて蓋を開けると、":270,"「………！」":271,"その中にみっしりと詰まる白い猫の縫いぐるみ──\nの、ようなもの。":272,"確かに、あのときのもの、\n『あのときのまま』だ。":273,"あれから十数年経っているにも関わらず、\nまるで劣化した様子のないそれの、":274,"「汚れひとつないとは……[l]\nこれ自体は何らかのprot-einか……？[l]\nとなるってーと」":275,"その中に、\n僕等のカミが、":276,"やくそくのあかしが。":277,"「おきるじかんだよ、」":278,"──シロ。":279,"「白の城、[l]しろのしろ、\nシを忘れるな、[l]\nMeMentoMori、[l]\nM3EW。[l]\nつくりませよみませEpitaph……」":280,"Run E。":281,"身、[l]\n笑む、[l]\nSeal\"O\"のしろ、\n十ノ飯食と産土の城。":282,"これはハカである。":283,"口は飯のヒトの為に、":284,"しのめの具足、[l]ホウキなり。":285,"偽具。":286,"M3EW\nEpitaph":287,"しをおもえ、[l]しをわすれるな。":288,"くちルより最後の壮美を。":289,"きのやまうかならずかならず、[l]\nカミあわさる、":290,"三春と飯窪の名において、[l]\nクチガタき我が朋のネコダマを、[l]\n３ハル、[l]Ｅ凹、[l]\nSeal\"O\"きものにかきくわえます、[l]\nめ、[l]くち、[l]そしてねこのひげ。[l]\n３：Ｅ、[l]\nそれは猫の『王』に連なりしもののみすがた、\nすばらしき壮美、[l]双美、[l]装備。":291,"意、":292,"閉じるワが名はいつわ。":293,"「……これが、」":294,"「司書長の……いえ、」":295,"「これが、僕の、僕達の、」":296,"あの兄の望みを叶える為に仕込まれた、":297,"ＣＡ":298,"Ｔ……だよ」":299,"シロはハコから立ち上がって、\n僕の方へと近づく、\nすると、":300,"「！？」":301,"──気がつくと[l]\n僕の頸には、白いチョーカーが巻かれていた。":302,"「……こりゃあ、知らない仕様だな……[l]\nこれが件の１３番目……だとすると、[l]\n……ん？[l]\nいや、……」":303,"「これ…って、[l]\nLinkableForm……？[l]\nいえ、精精試験運用版……かしら……[l]\nでも、十数年前の段階で、\n第一、それって……」":304,"……２人は驚きつつも、[l]\n何か思う所があるようで、呟いているのが聞こえたが、":305,"僕は、\nまた気が遠く、":306,"「………っ」":307,"まだ、[l]あとは、[l]\n具足とIgを、":308,"と、[l]そこまで考えて、[l]\n眼の前が真っ白に、[l]なって、":309,"「よう、[l]\nいーくんは本当によく寝る子だなあ」":310,"「……？[l]\nあ？[l]\nどこだここは？[l]\n何があった？」":311,"「此処は例のレンタカーん中。[l]\n例のモノを装備したいーくんは人事不省に陥って、\n今の今まで寝てた、[l]のだよ」":312,"「まじか……[l]なんだって僕はそんなんばっか、[l]\nっておい、」":313,"慌てて時刻を確認した。":314,"日付が変わろうとしている。":315,"とうとう、[l]\n祭の日だ。[l]\n冬夏達の本祭儀は更に夜中になるとはいえ、":316,"「……ちょっと待て、[l]\n今こうしていられるって事はやっぱり、\nあのひと……向こうからの、[l]\n何の動きもない……んだな？」":317,"「……幸か不幸か、その通りだ」":318,"「……彼女さんは？」":319,"「手洗い」":320,"「ああ……」":321,"僕は身体を起こし、\n座席に座り直す。":322,"安心と脱力、\nかすかに":323,"燻る……[l]これは不満、[l]\nなんだろうか、\nそういった雑多な感情が、\n寝起きの僕の中で、[l]\n整理も着かず渦巻いていた。":324,"ふと窓の外に視軸を移すと、\n真っ暗闇の中をかれお嬢が戻ってくるのが視えた。":325,"「お」":326,"「……？」":327,"つい其処まで戻って来ていながら、\n電話があったようで、\n車の中に入ってこない。":328,"車の外から、話す声が聞こえてきた。":329,"「あっ！？[l]\nえ、な、なんでしょうか……[l]\nはっ？！[l]\nsearch要請ですか？！[l]\nで、でも──」":330,"……？":331,"「わ、わかりました、\n少々お待ちください、\n電話は切らずに──」":332,"すると、":333,"「？[l]\n──あっ？！[l]\nかれおん、なにを、」":334,"かれお嬢は大神にウインクしつつ、\n指でＯＫサインを示すと、":335,"ぼう……":336,"今でこそ普通に、冷静に知覚出来るが、\n彼女のネコガミがそこに──":337,"「月吼狼を、なんで」":338,"しかし彼女からの返答はなかった。[l]\n大神は気が気でないようだが、\n今し方の彼女のサインを信じたのか、\n黙って事の成り行きを視守る。":339,"数分、否、数秒、数十秒だろうか、\n暫く立ち惚けていたように視えた彼女は、\nふいに焦ったような顔をして電話に語りかけた。":340,"「……みっ、[l]『":341,"検索に":342,"引っ掛』かりません、[l]\nいません、あの四人が、\n消失……いえ、[l]その、[l]\n視えない点が不自然に在るわけではないので、[l]\nジャムと言うよりはディスガイズの方か、それとも、[l]\n……あ、[l]それ以前の話です、[l]ね、[l]\nこ、[l]この状況が起こってる時点で、[l]言えるのは、」":343,"そこまで言うと、\nすぐに静かになり、\n挨拶をして電話を切った。":344,"車に乗り込んでくる。":345,"「向こうで緊急事態が、\nくぁるてっ──あの、\n向こうで顔合わせしたあの４人が、」":346,"「げ、あれら関係ってかよ。[l]\n何があった？」":347,"「検索頼まれたんでフェンリロス、\n出したんですけど、\nみ、みっかんないんです、\n普通有り得ない事、というか、\n有り得る場合が示す事柄がデスね、\nあの、ましかりなななな」":348,"「落ち着け。[l]\nそれはこっちに影響ある事か？[l]\nてかそれ以前に、\nいーくんの件はどーなってる？」":349,"「でっ、電話してきたのはあの、\nち──のサンでしたので、\nワザと言わなかったのカモですが、\nそちらに関しては何も……[l]\nで、\nもし彼女等４人が独断、\n或いはGMに唆されて動いてるとなりますと、\nこちらも勿論、\n『狩り』の標的になる可能性が」":350,"「よりにもよって実戦闘担当の連中にかぁ～～～[l]っもう、\nいーくんの覚醒イベント後だったのが不幸中の幸いだ。[l]\nスロタラスモルトは動いてないな？」":351,"「あっ、向こうの人達には今のところ動きは」":352,"「うし、\nいーくん、\nこれでNK連中まで動いて来たら眼も当てられねーぞ、\nとっとと、」":353,"「わかった、\nあとはお前の言う所の最終装備の調達──\n飯窪本家に移動しよう。[l]\n知狡さんに連絡……は、ギリギリまでしない方が、[l]\n良いかな」":354,"あの人のクソ真面目さが、\nこの場合一体どうなるのか、\n見当もつかない。[l]\nあの日も、あのひとの言うがまま、のようでもあったし、\nそうでなくても、\n迂闊に巻き込んだりするのは本意ではない。":355,"「よし、\nじゃ、移動開始。[l]\n俺が運転すっからよう、\n２人とも念の為後部座席に行っててくれるか。[l]\nあと効果あるかどうかは知らんが、\nなるたけ姿勢を低く保て──あっ、\nいーくん、ナビに場所入力頼む」":356,"そして、\n首に熱を感じながら、":357,"僕等の緊張感、早鐘のような鼓動に反して、\n車は静かに走り出した。":358,"ナビの声が場違いに時折車内に響く。":359,"途中、突然大神が前を向いたまま、":360,"木":361,"乃":362,"伊取りが木乃伊になるじゃないが、\nかいぶつのフリしてるうちに、\nかいぶつになっちゃった、なんて結末だけは回避してくれよ。[l]\n劇的に後味が悪いからな、あういうのは」":363,"そう言った。":364,"「……例えがよく判らないけど」":365,"僕は、前の大神に向け、":366,"「──もし僕に何かあったら、諸々宜しく頼む」":367,"そう返した。":368,"「そっくりそのまま戻すぜその言葉。[l]\nてか、いーくんがその手の死亡フラグを口にするとだな、\nシャレにならなくなりそうでアレなんだよ。[l]\nま、[l]\nなんとかならぁ、\n俺もお前もやりたい事があんだからな」":369,"この場合、『Ｙの欲動』に頼っても":370,"罰は当たらんだろ、":371,"大神は独り言のように、最後にそう付け加えた。[l]\n僕の横のかれお嬢は、\n一瞬慌てふためくような所作をして、\n心":372,"做しか紅潮した顔を伏せた。":373,"僕がその意味に思索を巡らす寸前、":374,"「……！[l]\n電話、きた、」":375,"「あっ？」":376,"「ど、どちらさまから」":377,"「……これは」":378,"飯窪、":379,"知狡さん──":380},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_064.ks","relPath":"/data/scenario/SC_M_064.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":368,"length":381,"percent":96.58792650918635},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[86,1]},"/data/scenario/SC_M_065.ks":{"data":[["「あの、\n俺が言うのも何ですが、\nほんとに大丈夫スか、\n視た感じかなり……」","「那个，\n虽然由我来说有点奇怪，\n真的没问题吗，\n看起来相当……」"],["「心配感謝する、\nだが、大丈夫だ、\n否、倒れてなど居られない、\nそんな状況ではない……のだ」","「感谢关心，\n但没问题，\n不，根本不能倒下，\n现在不是那种状况……啊」"],["「……でもやっぱり、[l]\nその、あのひとの……[l]\n001:GMナンバーと何かあったんですか……？」","「……可果然还是，[l]\n那个，那个人的……[l]\n001:GM编号是不是出什么事了……？」"],["「……」",""],["「あ、俺の事は気になさらず、\n現状は別として、大本の方、\nウラの事情は大体把握してますし」","「啊我的事不必在意，\n现状另当别论，幕后的大人物那边，\n暗中的情况我大致都掌握了」"],["「いや、\nそんなつもりではないんだ、\n茶黒の","「不、\n我并非那个意思、\n茶黑的"],["首。[l]\nただ──」","首级。[l]\n只是──」"],["「今回の事はいつにもまして判らない事が多過ぎて、\n私自身も整理がついてない……というのが、[l]\n正直な所なんだ。[l]\nあの人は確かに私の前に現れた、\n──真然名無、あの方の考えと行動は、\n或る意味で司書長の思惑そのものでもある、\nだから、\n余計に、\n否、[l]\n","「这次的事有太多超出常理之处、\n连我自己都理不清头绪……这、[l]\n就是我的真实状态。[l]\n那人确实出现在我面前、\n──真然名无，那位的思想与行动、\n某种意义上正是司书长所谋划的蓝图、\n所以、\n反而、\n不、[l]\n"],["……私に今出来る事は、[l]\n今私がしている事だ。[l]\n私がこうして復帰出来ている事が、\n或る種の証明になるだろう、が、[l]\n","……我现在能做的、[l]\n就是此刻正在做的事。[l]\n我能够这样重返岗位、\n本身或许就是某种证明、但、[l]\n"],["それ以外の事は、説明が──出来ない」","除此之外的事、恕我──无法说明」"],["「それは、\n言葉通りの意味で？[l]\nそれとも、意図的な隠蔽スか？[l]\nまあ、口に出して言っちゃってる時点でアレですけど、\n……悪く取らないで欲しいんですが、[l]\n貴女もかれおんの上司と同じで、\n『いい人』に視えますけど。[l]\nかれおんの今回の行動も看過してくれてますし、\nそれなら──」","「这是、\n字面意思吗？[l]\n还是刻意隐瞒呢？[l]\n嘛、既然都说出口了倒也罢了、\n……希望你别误会、[l]\n你和卡蕾欧的上司一样、\n看起来像个『老好人』。[l]\n连卡蕾欧这次的越界行为都包容了、\n既然如此──」"],["「……語るべきでないものは、ある、[l]\n今はそれしか言えない、\nただ、それでも私は、\n………、[l]\n","「……存在不可言说之事、[l]\n此刻我只能说到这里、\n但即便如此、我仍、\n………、[l]\n"],["あの甥を、愛してる。[l]\n本心だ。[l]\nあれは、飯窪真言、[l]私の妹現実のただ一人の息子、[l]\n","深爱着那个外甥。[l]\n此心昭昭。[l]\n那孩子、饭洼真言、[l]我妹妹现实唯一的儿子、[l]\n"],["そうだろう？」","对吧？」"],["「此処に来たときの奴の告白を聞いた上での、\nその台詞でしょ。[l]\n愚問ですよ。[l]\n彼奴は、\nやっとジシンをみつけたんです。[l]\n魂の双子、心のトモとして、\n取り敢えずは俺もその点は喜んでますし、\n伯母としての貴女のその感情は、\n僭越な言い様スけどね、僕のみこんだ通りです、\n大事にして欲しい。[l]\nですが、\nだからこそ、\n………、[l]\n……いあ、いいす」","「在听过那小子来此时的告白后、\n才说这种台词吧。[l]\n多此一问。[l]\n那家伙、\n终于找到了自我。[l]\n作为灵魂双子、心灵之友、\n至少这点上我也由衷高兴、\n你作为伯母的那份感情、\n虽说僭越、正如我所料、\n望你珍视。[l]\n但是、\n正因如此、\n………、[l]\n……啊、不必了」"],["「言葉以外のことで伝えるのが、今なんでしょ、\nこの場合は。[l]\n俺もですね、どっちかだけには偏りたくないんで。[l]\nこれ以上の追求は止します。[l]\nただ、」","「现在需要用言语之外的方式传达吧、\n就这种情况而言。[l]\n我呢、也不想偏袒任何一方。[l]\n就此停止追问。[l]\n只是、」"],["「言いたい事は分かる。[l]\nあの子を不幸にはしない、\n少なくともあの子を悲しませるようなことは、[l]\nそんな事に私がそれに手を貸すことは──無い。[l]\nもし私が約束を","「我明白你想说什么。[l]\n不会让那孩子不幸、\n至少绝不会做出令那孩子伤心的事、[l]\n更遑论为此推波助澜──绝无可能。[l]\n若我违背"],["違えたら、[l]\n","承诺、[l]\n"],["遠慮仮借無く、我々を──私を、阻止するがいい、\nオウト」","不必顾忌、尽管阻止我们──阻止我、\n欧托」"],["「いっやあ～～～、\nそれぁ買い被りって奴で……[l]\n俺如きじゃ貴女方を止めるなんてとてもとても。[l]\nいーくんのフォローが精一杯すね。[l]\n貴女達の中にはどうにも相手にしたくない面子が、\nごまんといますし、\nあの萌え店長も勿論ですが、\nそっちは、\n最終的にやっぱりいーくん自身に、\n片ぁ付けて貰わなきゃいけない訳で」","「哎呀呀～～～、\n那可就太高估我啦……[l]\n凭我这种货色怎么可能拦得住您呢。[l]\n能给饭君打打辅助就是极限咯。[l]\n您那边有好几个我根本不想招惹的家伙，\n多到数不过来，\n那位萌系店长自然不用说，\n说到底\n最后终究得靠饭君本人\n亲自解决才行呐」"],["「……店長の本気、ってまだ知らないんデスけど、[l]\nやっぱり凄いんでしょうか、\nもし修羅場になったりしたらその、\nあの、彼は大丈夫でしょうか……」","「……虽然还没见识过店长动真格的样子，[l]\n果然还是很厉害吧，\n万一演变成修罗场的话，\n那个、他应该没问题吧……」"],["「まあ、その時の為の具足だわな、\n効果が如何ほどかは知らねど……」","「嘛，所以才准备了这副铠甲啊，\n虽然不清楚能发挥多少效果……」"],["「魔眼の刺し手に限らず……[l]\n我々の正装は……prot-ein、[l]\nＣＡＴによって作成されるモノだ。[l]\n刺し手の正装は、\nその役割の特性──つまり単独での『狩り』を想定する為、\n他と比べ或る程度の防御を付与される。[l]\n宮さんの本気に対して防御力を示せるかは、\n……私にも分からないが、[l]\n元々黒のイツワは白のミルハと双璧をなすに足る存在、\nの筈だろう」","「不仅是魔眼杀手……[l]\n我们的正装……prot-ein，[l]\n都是由CAT制造的。[l]\n刺客的正装，\n基于其职责特性──即预设需要单独进行『狩猎』，\n会比其他类型多赋予一定防御性能。[l]\n能否扛住宫小姐的全力攻击，\n……我也不得而知，[l]\n但原本黑色的伊兹瓦理应与白色的米尔哈并驾齐驱，\n本该如此才对」"],["「あの兄貴の","「那位老哥"],["贔","三"],["屓の分が、\nパワーバランスを完全に崩してるでしょうがね……」","偏心偏到\n彻底破坏平衡就是了……」"],["「……。[l]\n魔眼の刺し手は──\n黄金の四ツ眼の仮面を被り……[l]\n黒き衣と紅き","「……。[l]\n魔眼杀手──\n戴着黄金四目假面……[l]\n身披黑衣与赤红"],["裳を纏い……[l]\n矛をもち、\n敵を駆逐、する、もの、\n敵とは即ちLu=Leの魔女、\nそのＣＡＴだ。[l]\n元より同じ存在の我等と彼女等にとって、\n魔眼の刺し手は即ち同等に脅威である、といえる」","裳裾……[l]\n手持长矛，\n驱逐、敌人、之物，\n所谓敌人即是Lu=Le魔女，\n及其CAT。[l]\n对于同源而生的我们与她们而言，\n魔眼杀手可谓同等的威胁」"],["「魔眼の刺し手って、\nＣＡＴを紙封するだけモノじゃないんですか？[l]\nEnderは確か……」","「魔眼杀手不是\n只管把CAT封进纸里的存在吗？[l]\nEnder应该是……」"],["「……まだ勉強が足りてないか、[l]\n雨山。[l]\n尾張のあれは狩猟、つまり獲物を得るのが主目的だ。[l]\n遣い手の去就と関係なく、ＣＡＴを奪い紙に封じる役。[l]\nそれだけのモノだ。[l]\n四重奏団のように補助、捕縛、場の展開、[l]\nそれぞれがあってこそ機能する、[l]\n四人揃わねば限りなく無力に近い存在なんだ。[l]\nそれに対して──[l]\n魔眼の刺し手は、[l]\n","「……学艺不精啊，[l]\n雨山。[l]\n尾张那边是狩猎，以获取猎物为主要目的。[l]\n无关使用者去向，只管夺取并封印CAT的职位。[l]\n仅此而已。[l]\n像四重奏团那样需要辅助、拘捕、场地控制[l]\n各司其职才能发挥作用，[l]\n缺一人就近乎废物的存在。[l]\n相比之下──[l]\n魔眼杀手，[l]\n"],["文字通り『魔眼を潰す』のだ。[l]\nＣＡＴとの繋がりを断ち、\n遣い手の魔眼質自体を一時的にとは言え失効させる。[l]\n敵を無力化させ、\nその上で、紙封を行う。[l]\n単独で魔女達を殲滅する為に、\nひとりでタつべく仕込まれた男の魔女、\nそれがarchetypeにして唯一の、\n魔眼の刺し手、だと聞いている」","字面意义上是『摧毁魔眼』。[l]\n斩断与CAT的联系，\n令使用者的魔眼资质暂时失效。[l]\n先使敌人无力化，\n再进行纸封。[l]\n为独自歼灭魔女们，\n被培养成单枪匹马作战的男性魔女，\n作为原型亦是唯一，\n听闻那就是魔眼杀手」"],["「……天狗に対するテングか……[l]\nつまり『第三者の眼、第三者の視点』だな」","「……针对天狗的天狗吗……[l]\n也就是『第三方之眼，第三方视角』呢」"],["「『Moon=Calf』たる存在は我々のうちでも生まれず久しい、\nと真然名無も言っていたし、\nコストは兎も角もリスクの面で問題があり、\n今の形態、四重奏団のような方式にシフトしたんだそうだ。[l]\nソロに器用貧乏な能力を付与するよりも、\n特化した面子でＰＴ組んだ方が良いとの判断……らしいがな。[l]\n結局その場合でも、\n誰かが欠けてしまえばどうにもならぬ、\nどちらも一長一短だったのだ。[l]\nそこに、あの子が生まれた──」","「『Moon=Calf』这样的存在即便在我们之中也久未诞生，\n真然名无也曾这么说过，\n成本姑且不论，风险层面存在问题，\n据说现已转变为类似四重奏团的形态。[l]\n与其赋予独奏者华而不实的能力，\n不如组建特长明确的团队……似乎是这么判断的。[l]\n但即便采用这种方式，\n一旦有人缺席就束手无策，\n两者各有利弊。[l]\n就在这时，那孩子诞生了──」"],["「ただの男子ではなく、\nその内にイツワのPHASE:10、イーハをもって、っすか」","「并非普通男性，\n而是体内蕴藏着伊兹瓦PHASE:10、伊哈的存在，对吧」"],["「……我等飯窪はその為に、[l]\n居たのだ。[l]\nただ、永い間に本義がどう移ろったのか、\n或いは不変のままなのか、\nお前のように永代に渡り在り続けた訳ではない私には、\nもう、\n知る由もない。[l]\n私はただ、愚直に、\n自分の属する世界……否、世間の中で、[l]\nただ真面目に誠実で、行儀良くあれ、\nそう努めてきただけだ。[l]\n真に賢き妹と違ってな」","「……我们饭洼一族，[l]\n正是为此而存在。[l]\n只是历经漫长岁月后，不知根本教义是否已然变迁，\n抑或亘古未变，\n对于不像你这般永恒存在的我而言，\n早已\n无从知晓。[l]\n我只是愚直地，\n在自己所属的世界……不，在这俗世中，[l]\n努力做个认真诚实、彬彬有礼之人，\n仅此而已。[l]\n与真正聪慧的妹妹不同」"],["「んー、まあ、\n思い詰めない事ですよ。[l]\n俺にしたってそーすけどね、\n永く在れば良いって訳でも無いですし。[l]\n短いのよりは経験値が確実に溜まりますが、\nそれを如何に振り分けるかが肝要なのであって、\nそこ次第です結局は」","「嗯——嘛，\n别太钻牛角尖。[l]\n虽然我也没资格说这话，\n活得久未必就是好事。[l]\n虽然比短命能积累更多经验值，\n但关键在于如何分配运用，\n终究取决于这点」"],["「そう、だな……[l]\nそうか、矢張り……ああ、[l]\nいや──成る程な」","「确实……[l]\n是吗，果然……啊，[l]\n不──原来如此」"],["「？」",""],["「そうだ、\n雨山、オウト、\n知っているかも知れないが、\nどうやらこの玄ノ森に潜在……潜伏、[l]\nしているらしい、\n八相殺しの犯人……がだ」","「对了，\n雨山，欧托，\n你们或许已经知道，\n似乎有八相杀手潜伏在玄之森……[l]\n暗中活动，\n那家伙……」"],["「G、GW？」",""],["「そもそも尾張が其奴と交戦したから、\nややこしくなったんだぞ。[l]\nそこまでは聞いてないのか」","「说到底是因为尾张和那家伙交战，\n事情才变得复杂。[l]\n这部分你还没听说吗」"],["「いえ、\nあ………っ、[l]\n聞いて、たような」","「不，\n啊………[l]\n好像，听说过」"],["「……言ってたろ、[l]\n野放しになってるってあの上司さんが」","「……不是说过了吗，[l]\n那个上司说放任不管的」"],["「あ゛っ、言ってましたっ」","「啊！确实说过！」"],["「………。[l]\nそのミに直にＣＡＴの力を宿し、\n視えるのとは別の感得の仕方でそれを行使する、\nそれが『身盗りの生やし』、GreenWoodと呼ばれる、\n先刻のとは別の男魔女、\n放置自体は司書長の言によるものだったが、\n実害を被った今、どうなるものかは知れない」","「………。[l]\n将CAT之力直接寄宿于肉体，\n以超越视觉的感知方式驱动力量，\n此即『窃身育成者』、被称为GreenWood的，\n不同于先前的另一名男魔女，\n虽然放任政策出自司库长之意，\n但如今造成实际危害，后果难料」"],["「……彼奴、もしや」","「……那家伙，莫非」"],["「それに、\nもし真言が宮さん……ミルハと、[l]\n穏やかでない遣り取りになった場合、\nヒトに受肉し、\n自律しているミルハにとっては、\n魔眼質失効は無意味だろう、\n別途ＣＡＴがあるに越したことはないが、\nキリアケ程度で意味があるかどうかは──」","「而且，\n如果真言和宫小姐……米尔哈，[l]\n发生了不愉快的争执，\n对于获得人类肉身、\n保持独立意识的米尔哈来说，\n魔眼质失效应该毫无意义吧，\n虽然另有CAT会更稳妥，\n但仅靠雾明程度是否有效果──」"],["「おあ？」","「啊咧？」"],["「のあっ」","「呜啊」"],["「………まこと」","「………真言」"],["「お待たせ、\nシロを手懐ける……っていうか、[l]\n操作感に馴れるのに手間取って」","「久等了，\n驯服白……或者说，[l]\n适应操作手感花了点时间」"],["「それが……シロか」","「这就是……白吗」"],["「刺し手としての仕込みとは違って、\nこっちは僕も初だし、\n流石にぶっつけ本番って訳にもいかないと思って、\nでも、もう何とかいけそう……だと思う」","「和作为刺客的训练不同，\n这方面我也是初次尝试，\n果然没法直接硬着头皮上，\n不过现在应该差不多……能行了」"],["「……明確に形而下に顕れる型、[l]\nは珍しいよな？[l]\nかれおん、知狡さん」","「……明确具现在物理层面的形态，[l]\n很罕见吧？[l]\n卡蕾欧，知狡阿姨」"],["「……WCLのアーカイブの中でも、[l]\nフル稼働もなしにこれだけ、\nっていうのはまず──」","「……即使在WCL的档案里，[l]\n无需完全启动就能达到这种程度，\n这种情况也几乎──」"],["「受肉の依代が残る、\n紙封前段階のＣＡＴの在り方に似てはいるが、\n……言い方が難しいな、……」","「与保留着受肉凭依体的、\n纸封前阶段CAT的存在形式相似，\n……难以准确描述呢……」"],["「やっぱり、\n……強いて言うならLinkableFormの在り方に──」","「果然还是，\n……勉强要说的话更接近LinkableForm的──」"],["「あの、\nまあその辺は気にしなくていいんじゃないかな、\n仕組みは分からなくてもラジオは聴ける……んだし。[l]\n感得するのが肝要だって」","「那个，\n这部分不用太在意吧，\n就像不懂原理也能听收音机……嘛。[l]\n重点在于实际感受啦」"],["「あ？[l]\n相変わらずアナクロだなあ。[l]\nパソコン、せめてテレビとかで例えてくれるか。[l]\nそれに、\nハードウェアもソフトウェアも、\n仕組みは知ってるに越したことは……」","「哈？[l]\n还是这么老派啊你。[l]\n至少用电脑、电视什么的举例啦。[l]\n再说了，\n无论是硬件还是软件，\n了解构造总没坏处……」"],["「そういう意味じゃ、\n僕も記述設計から調整まで絡んだ……事になるし、[l]\n兎に角シロに関しては問題ないよ。[l]\n","「从这个角度说，\n我也参与了从记述设计到调整的……部分工作，[l]\n总之白这边没问题。[l]\n"],["仮面","面具"],["の方は、今はまだ、\n本起動無理かなあ……[l]\n暴発したら大変だし──」","那边目前还，\n没法正式启动吧……[l]\n万一暴走就麻烦了──」"],["「ちょ、待て、\n俺は兎も角こちらのお二人さんの為にもそら、\n気をつけろよマジで」","「等、等等，\n我无所谓但为了这边两位着想，\n你可得认真点啊真的」"],["「──と言うわけで、\nキリアケは知狡さんが持っててください。[l]\n確か、知狡さんが管理してるんでしたよね？」","「──综上所述，\n雾明就交给知狡阿姨保管。[l]\n记得是由知狡阿姨管理的对吧？」"],["「あ、ああ、まあそうだが……[l]\n私には……」","「啊、啊啊，话是这么说……[l]\n但我实在……」"],["「僕にはシロがいるし、\nそれに、」","「我有白了，\n况且，」"],["「ああ、宮さんには、\nキリアケでは荷が勝つだろうな……[l]\nだが、………。[l]\n……","「确实，对宫小姐来说，\n雾明的负担可能太重了……[l]\n不过，………。[l]\n……"],["現","现"],["実……私は……」","其实……我……」"],["「シロなら、\n何とかなる確証は？」","「关于白，\n有把握能控制住吗？」"],["「……正直言って、[l]\nそれは何とも言えない、\nけど……[l]\nああ、それより、\n先刻の話じゃないけど、\n迂闊に僕に近づくと巻き添え喰らわすかも知れないから、\n僕はこれから単独で動こうと思う」","「……老实说，[l]\n那实在不好说，\n不过……[l]\n啊，比起那个，\n虽然刚才没提，\n随便靠近我的话可能会被牵连，\n我打算接下来单独行动」"],["「……ま、[l]\n勝率１０割じゃなきゃ告れない訳じゃなし、\n俺はフォローとして適当に周り","「……嘛，[l]\n又不是非得胜率100%才能告白，\n我会作为后援在附近"],["彷","彷"],["徨いてらぁ、\nあ、告白の邪魔はしねーし出歯亀するつもりもないからよ。[l]\n心置きなく玉砕して来い」","随便晃悠啦，\n啊、不会妨碍告白也不会偷看的。[l]\n放心去壮烈牺牲吧」"],["「だっ、からお前なあ……[l]\n真面目な話、冬夏達八相の方を寧ろ、\nフォローというか、守って欲しい。[l]\n彼女達は、\nきっと何も知らないんだろうし……[l]\nまあ、非道いことにならないようにする為に、\n僕は行くんだけど、\n何があるかは分からないし、\nその、」","「所、所以说你啊……[l]\n说正经的，反倒希望你们多关照、\n或者说多保护冬夏她们八相。[l]\n她们啊，\n肯定什么都不知道吧……[l]\n呃，虽然我会去防止事情变得太残酷，\n但毕竟，\n不知道会发生什么，\n那个……」"],["「あーもう言わんでいいさ、\nそういや抑えられてたＹのよ……も、[l]\nもう開放されたんだったか、\n女子関係に多少執着も出てくるのが健全じゃわい」","「啊—不用再说啦，\n说起来被控制住的Y也……[l]\n已经解放了吧，\n对女孩子多少有点执着才健康嘛」"],["「……何のことだかさっぱりわからんけど……」","「……完全听不懂你在说什么……」"],["「……え、えーと」","「……呃，那个」"],["「……あれらも一枚岩とは限らんぞ、[l]\nそこは気をつけてくれ」","「……那些家伙未必铁板一块，[l]\n这点要小心」"],["「……それは承知してます。[l]\nでも、すまん、頼む大神」","「……这我明白。[l]\n但是，抱歉，拜托了大神」"],["「分かってるっての。[l]\n重々気をつけるし。[l]\n俺だって此処で散るつもりは更更無いしな、\nな、かれおん」","「我都明白啦。[l]\n会超级小心的。[l]\n老子也压根没打算死在这种地方，\n对吧，卡蕾欧」"],["「はいっ？[l]\nは、ハイっ」","「啊咧？[l]\n是、是的！」"],["「ありがとう。[l]\nえーと、[l]\n","「谢谢你。[l]\n那个……[l]\n"],["悪い、すみません、[l]\nちょっと、一旦寝たい……」","抱歉、对不起、[l]\n让我稍微睡会儿……」"],["「またかよ？[l]\nてかお前、\n折角着替えたのによう」","「又来？[l]\n话说你，\n明明好不容易才换好衣服的喂」"],["「……覚醒による記憶回復、急激な情報流入を、[l]\n睡眠による脳内整理で処理しようとしてるのだろう。[l]\nそれに昔からこの子は、\n厭な事があっても数日寝れば忘れる子だった」","「……她正试图通过睡眠整理大脑，[l]\n来处理觉醒导致的记忆恢复和信息洪流吧。[l]\n而且这孩子从以前开始，\n遇到讨厌的事只要睡几天就能忘掉」"],["「ああ、\nまあ、そういう事もありますかいね」","「啊，\n嘛，原来还有这种操作啊」"],["「小難しい理屈は分かりませんが……[l]\nそうかも……知れないです……」","「虽然听不懂那些复杂理论……[l]\n或许……是这样吧……」"],["「着替えをどうするかは任せるが、\nお前が寝てる間は、\n私が、何としてもこの場は守ろう。[l]\nそれに祭儀に向かうとすれば、\nどちらにしても真夜中になるしな、\nそうでなくても昼間は祭の人出でごった返している、\n本起動フハイの負荷を少しでも減らすために、\n宮さんも──\n既に狩り場に出たとの連絡は入っているが、\n恐らく夜までは……[l]\n少なくとも派手に動く事はないだろう。[l]\nとなれば、\n夜に行動する為にも今は休むが得策かも知れん。[l]\nそっちの二人もだ、そして真言の事、……頼む。[l]\n私ではキリアケがあろうと、\n大した力になれそうにない……」","「换装的事就交给你决定了，\n在你睡觉期间，\n我会无论如何守住这里的。[l]\n再说要前往祭仪的话，\n无论如何都得等到半夜，\n就算不去白天也会被祭典人潮挤得水泄不通，\n为了尽量减轻本启动负荷，\n宫小姐也──\n虽然接到通知说已经去了猎场，\n但估计入夜前……[l]\n至少不会有大动作吧。[l]\n既然如此，\n为夜间行动养精蓄锐或许是上策。[l]\n那边两位也是，还有真言的事……拜托了。[l]\n就算我有觉醒能力，\n恐怕也帮不上大忙……」"],["「俺は構いませんが、\nもし昼間の内から何かあったらすぐ言ってくださいよ。[l]\nお一人でどうこうしようなんて思わんとってください」","「我没问题，\n但要是白天发生什么就立刻告诉我。[l]\n可别想着独自逞强啊」"],["「……ああ」","「……啊」"],["「……大丈夫すか？[l]\n寧ろ貴女が休むべきじゃ」","「……真的不要紧吗？[l]\n反倒是你该休息才对」"],["「いや、問題ない。[l]\n余計な心配かけてすまない……[l]\nさ、\n君等が休める準備をする、\n暫く待ってくれるか」","「不，没问题。[l]\n让你多虑了很抱歉……[l]\n好了，\n我去准备你们休息的地方，\n稍等片刻可以吗」"],["「あっ、お手伝い──」","「啊，我来帮忙──」"],["「面識の無いオウトならまだしも、\n雨山が居るのが知れるのは問題があるだろう、\n一人でやれるよ、\nこの地下で３人で待っていろ」","「要是素不相识的欧托还罢了，\n被知道雨山在这里会有麻烦吧，\n我一个人能搞定，\n你们三个就在地下室等着」"],["「やんわりヘルプ要請されたような気がしますけど、\nどうしますかい」","「感觉被委婉地拒绝了帮忙请求，\n怎么办好呢」"],["「ん？[l]\nあ、ああ、今のは言葉の綾だ、\n無論お前も、\n誰かに会わせずに済むに越したことはないからな。[l]\n兎に角大人しく此処にいるんだ」","「嗯？[l]\n啊、啊啊刚才那是修辞啦，\n当然你也是，\n能避免见人就最好不过了。[l]\n总之乖乖待在这儿」"],["「……ごめん……ありがとう……[l]\n知狡さん……」","「……对不起……谢谢你……[l]\n知狡阿姨……」"],["「ふっ。[l]\n家族に遠慮なぞ、\nするもんじゃない、そうだろう」","「呵。[l]\n自家人还客套什么，\n没必要对吧」"],["「……ええ……」","「……嗯……」"],["生きていくなかで、[l]\n　生きていこうとするなら、[l]\n　どうしても戦わなければならないときがある、[l]\n　何者をも傷付けずに済むのなら\n  その方が良いに決まってるけれど、[l]\n　この最悪の箱庭は、[l]\n　それを赦してくれない。","只要活着，[l]\n　只要想继续活下去，[l]\n　就难免会有不得不战斗的时候，[l]\n　若能不伤害任何人\n  那当然再好不过，[l]\n　但这个最恶劣的箱庭世界，[l]\n　不会允许这种奢望。"],["だが、だからといって、[l]\n　それを大義名分に掲げ、[l]\n　無意味に敵を作り、[l]\n　無自覚なものを巻き込み争いごとをなすのはどうだろう。","可是即便如此，[l]\n　若以此为正当理由，[l]\n　无谓树敌，[l]\n　将不自觉者卷入纷争又算什么呢。"],["ゲームは、ルールに則って行うものだ。[l]\n　無秩序な争いにおいて被るのであろう、[l]\n　互いの傷を最小限に抑えるために、[l]\n　基準を設け、[l]\n　ルールをつくり、[l]\n　","游戏就该遵守规则进行。[l]\n　为避免无序争斗造成的，[l]\n　彼此伤害最小化，[l]\n　才设立基准，[l]\n　制定规则，[l]\n　"],["勝","胜"],["ち","与"],["と","如此"],["負","负"],["け","往"],["い","役"],["う","负"],["結果を想定し、[l]\n　行われるもの、じゃないんだろうか。","结果是可以预见的，[l]\n　但事情并非按预期发展吧。"],["僕は、","我、"],["あなたをとめたい、[l]\n　むやみな憎み合いの連鎖を止めるためにも。","想要阻止你，[l]\n　也是为了斩断这无谓的憎恨连锁。"],["絶対に零に出来なくとも、[l]\n　それに近づけるように、[l]\n　拮抗する力があったって、[l]\n　おおきな善意があったって、いい筈だ。","即便无法彻底归零，[l]\n　也要尽可能接近，[l]\n　就算存在对抗的力量，[l]\n　哪怕怀抱巨大的善意，也是可以的吧。"],["バランスの保たれた平常というのは、[l]\n　静止した状態ではなく、[l]\n　全てが動き走り続け拮抗してこその、[l]\n　おとしどころとしての相なのだ、と思う。","所谓保持平衡的常态，[l]\n　并非静止的状态，[l]\n　而是一切持续运动对抗后，[l]\n　最终达到的妥协点，我是这么想的。"],["最悪の箱庭でも、そこがきっとみつけられる。","即便在最恶劣的微观世界里，也一定能找到那个点。"],["そして、[l]\n　きっと僕の把握していない、[l]\n　想像すらしていないところに、[l]\n　まだ無自覚な演者がいて、[l]\n　憎しみや悲しみを吐いているのだろう。","然后，[l]\n　肯定还有我未能察觉、[l]\n　甚至从未设想过的角落，[l]\n　存在着无意识的表演者，[l]\n　正在倾吐着憎恨与悲伤吧。"],["『たたかいあうことは進歩の源泉でもあるが、[l]\n　にくしみあうことは誰の得にもならない』","『相互争斗虽是进步的源泉，[l]\n　但彼此憎恨对谁都没有益处』"],["だから、","所以，"],["貴女とはたたかうけれど、[l]\n　憎くはない、","虽然会与你战斗，[l]\n　但并不憎恨你，"],["そのあとにたとえわかれが、破局が訪れたとしても、[l]\n　貴女のことは、","即便之后迎来分别或破灭的结局，[l]\n　对于你，"],["好きだけど、[l]\n　嫌いだから。","我喜欢着，[l]\n　却也讨厌着。"],["愛しくもないけど、[l]\n　厭うてもないから。","虽非珍视之人，[l]\n　却也不曾厌恶。"],["……実際に眼にしたら、[l]\n　きっと、[l]\n　そんな理屈は吹っ飛ぶって、[l]\n　そうも思うよ。[l]\n　冷静でいられるかどうかは、[l]\n　正直自信はないさ、","……实际见到你的话，[l]\n　想必，[l]\n　这些道理都会烟消云散，[l]\n　我也有这样的预感。[l]\n　能否保持冷静，[l]\n　老实说没有自信，"],["でも、[l]\n　これから貴女と会って、[l]\n　互いに我を通し合うたたかいに、[l]\n　赴く自分に後悔は、","但是，[l]\n　接下来与你相见，[l]\n　在彼此坚持己见的战斗中，[l]\n　我不会后悔。"],["ないよ。","所以希望我们双方，"],["だからお互い、[l]\n　遠慮無しで、[l]\n　本音から、","都不必客气，[l]\n　坦诚相见，[l]\n　让我与你，"],["僕とあなた、二人の在り方に、[l]\n　決着をつけさせてほしい。","为我们两人的存在方式，[l]\n　做个了断。"],["せめてそれくらいのことには、","至少这点小事，"],["相手してくれるとうれしいよ、","希望你能奉陪，我会很开心。"],["宮さん。","宫小姐"]],"context":[["SC_M_065.ks/index/1/text"],["SC_M_065.ks/index/3/text"],["SC_M_065.ks/index/5/text"],["SC_M_065.ks/index/7/text","SC_M_065.ks/index/15/text","SC_M_065.ks/index/37/text","SC_M_065.ks/index/39/text","SC_M_065.ks/index/85/text","SC_M_065.ks/index/93/text","SC_M_065.ks/index/158/text","SC_M_065.ks/index/223/text","SC_M_065.ks/index/225/text"],["SC_M_065.ks/index/9/text"],["SC_M_065.ks/index/11/text"],["SC_M_065.ks/index/13/text"],["SC_M_065.ks/index/17/text"],["SC_M_065.ks/index/20/text"],["SC_M_065.ks/index/23/text"],["SC_M_065.ks/index/25/text"],["SC_M_065.ks/index/27/text"],["SC_M_065.ks/index/30/text"],["SC_M_065.ks/index/33/text"],["SC_M_065.ks/index/35/text"],["SC_M_065.ks/index/41/text"],["SC_M_065.ks/index/43/text"],["SC_M_065.ks/index/45/text"],["SC_M_065.ks/index/48/text"],["SC_M_065.ks/index/50/text"],["SC_M_065.ks/index/52/text"],["SC_M_065.ks/index/54/text"],["SC_M_065.ks/index/56/text"],["SC_M_065.ks/index/58/text"],["SC_M_065.ks/index/60/text"],["SC_M_065.ks/index/62/text"],["SC_M_065.ks/index/64/text"],["SC_M_065.ks/index/66/text"],["SC_M_065.ks/index/68/text"],["SC_M_065.ks/index/70/text"],["SC_M_065.ks/index/73/text"],["SC_M_065.ks/index/75/text"],["SC_M_065.ks/index/77/text"],["SC_M_065.ks/index/79/text"],["SC_M_065.ks/index/81/text"],["SC_M_065.ks/index/83/text"],["SC_M_065.ks/index/87/text"],["SC_M_065.ks/index/89/text","SC_M_065.ks/index/109/text"],["SC_M_065.ks/index/91/text"],["SC_M_065.ks/index/95/text"],["SC_M_065.ks/index/97/text"],["SC_M_065.ks/index/99/text"],["SC_M_065.ks/index/101/text"],["SC_M_065.ks/index/103/text"],["SC_M_065.ks/index/105/text"],["SC_M_065.ks/index/107/text"],["SC_M_065.ks/index/111/text"],["SC_M_065.ks/index/113/text"],["SC_M_065.ks/index/115/text"],["SC_M_065.ks/index/117/text"],["SC_M_065.ks/index/119/text"],["SC_M_065.ks/index/121/text"],["SC_M_065.ks/index/123/text"],["SC_M_065.ks/index/125/text"],["SC_M_065.ks/index/127/text"],["SC_M_065.ks/index/129/text"],["SC_M_065.ks/index/131/text"],["SC_M_065.ks/index/133/text"],["SC_M_065.ks/index/135/text"],["SC_M_065.ks/index/137/text"],["SC_M_065.ks/index/140/text"],["SC_M_065.ks/index/142/text"],["SC_M_065.ks/index/144/text"],["SC_M_065.ks/index/146/text"],["SC_M_065.ks/index/148/text"],["SC_M_065.ks/index/150/text"],["SC_M_065.ks/index/152/text"],["SC_M_065.ks/index/154/text"],["SC_M_065.ks/index/156/text"],["SC_M_065.ks/index/160/text"],["SC_M_065.ks/index/162/text"],["SC_M_065.ks/index/164/text"],["SC_M_065.ks/index/166/text"],["SC_M_065.ks/index/168/text"],["SC_M_065.ks/index/170/text"],["SC_M_065.ks/index/172/text"],["SC_M_065.ks/index/174/text"],["SC_M_065.ks/index/176/text"],["SC_M_065.ks/index/178/text"],["SC_M_065.ks/index/180/text"],["SC_M_065.ks/index/182/text"],["SC_M_065.ks/index/184/text"],["SC_M_065.ks/index/186/text"],["SC_M_065.ks/index/189/text"],["SC_M_065.ks/index/191/text"],["SC_M_065.ks/index/193/text"],["SC_M_065.ks/index/195/text"],["SC_M_065.ks/index/197/text"],["SC_M_065.ks/index/199/text"],["SC_M_065.ks/index/201/text"],["SC_M_065.ks/index/203/text"],["SC_M_065.ks/index/205/text"],["SC_M_065.ks/index/207/text"],["SC_M_065.ks/index/209/text"],["SC_M_065.ks/index/211/text"],["SC_M_065.ks/index/213/text"],["SC_M_065.ks/index/215/text"],["SC_M_065.ks/index/217/text"],["SC_M_065.ks/index/219/text"],["SC_M_065.ks/index/221/text"],["SC_M_065.ks/index/227/text"],["SC_M_065.ks/index/229/text"],["SC_M_065.ks/index/231/text"],["SC_M_065.ks/index/233/text"],["SC_M_065.ks/index/235/text"],["SC_M_065.ks/index/237/text","SC_M_065.ks/index/243/text"],["SC_M_065.ks/index/239/text"],["SC_M_065.ks/index/241/text"],["SC_M_065.ks/index/245/text"],["SC_M_065.ks/index/247/text"],["SC_M_065.ks/index/249/text"],["SC_M_065.ks/index/251/text"],["SC_M_065.ks/index/253/text"],["SC_M_065.ks/index/255/text"],["SC_M_065.ks/index/257/text"],["SC_M_065.ks/index/259/text"],["SC_M_065.ks/index/261/text"],["SC_M_065.ks/index/263/text"],["SC_M_065.ks/index/265/text"],["SC_M_065.ks/index/267/text"],["SC_M_065.ks/index/269/text"],["SC_M_065.ks/index/271/text"],["SC_M_065.ks/index/273/text"],["SC_M_065.ks/index/275/text"],["SC_M_065.ks/index/277/text"],["SC_M_065.ks/index/279/text"],["SC_M_065.ks/index/281/text"],["SC_M_065.ks/index/283/text"],["SC_M_065.ks/index/285/text"],["SC_M_065.ks/index/287/text"],["SC_M_065.ks/index/289/text"]],"tags":[],"parameters":[[{"start":156,"end":206}],[{"start":269,"end":327}],[{"start":357,"end":417}],[{"start":447,"end":451},{"start":650,"end":654},{"start":1802,"end":1806},{"start":1836,"end":1840},{"start":4683,"end":4687},{"start":4945,"end":4949},{"start":7232,"end":7236},{"start":9931,"end":9935},{"start":9965,"end":9969}],[{"start":481,"end":534}],[{"start":564,"end":594}],[{"start":605,"end":620}],[{"start":712,"end":877}],[{"start":912,"end":989}],[{"start":1021,"end":1039}],[{"start":1069,"end":1248}],[{"start":1306,"end":1370}],[{"start":1405,"end":1465}],[{"start":1500,"end":1507}],[{"start":1537,"end":1772}],[{"start":1870,"end":1967}],[{"start":2025,"end":2127}],[{"start":2137,"end":2146}],[{"start":2181,"end":2213}],[{"start":2243,"end":2440}],[{"start":2470,"end":2556}],[{"start":2586,"end":2623}],[{"start":2653,"end":2875}],[{"start":2905,"end":2911}],[{"start":2921,"end":2922}],[{"start":2931,"end":2965}],[{"start":2995,"end":3049}],[{"start":3060,"end":3181}],[{"start":3211,"end":3266}],[{"start":3343,"end":3566}],[{"start":3596,"end":3780}],[{"start":3839,"end":3882}],[{"start":3912,"end":4161}],[{"start":4191,"end":4236}],[{"start":4266,"end":4486}],[{"start":4516,"end":4653}],[{"start":4717,"end":4762}],[{"start":4792,"end":4795},{"start":5497,"end":5500}],[{"start":4825,"end":4915}],[{"start":4979,"end":4986}],[{"start":5016,"end":5072}],[{"start":5102,"end":5134}],[{"start":5164,"end":5199}],[{"start":5229,"end":5242}],[{"start":5272,"end":5427}],[{"start":5457,"end":5467}],[{"start":5530,"end":5679}],[{"start":5709,"end":5714}],[{"start":5744,"end":5749}],[{"start":5779,"end":5787}],[{"start":5870,"end":5919}],[{"start":5949,"end":5959}],[{"start":5990,"end":6074}],[{"start":6104,"end":6152}],[{"start":6182,"end":6236}],[{"start":6266,"end":6321}],[{"start":6351,"end":6391}],[{"start":6422,"end":6502}],[{"start":6532,"end":6641}],[{"start":6672,"end":6738}],[{"start":6751,"end":6753}],[{"start":6762,"end":6806}],[{"start":6836,"end":6884}],[{"start":6915,"end":6978}],[{"start":7008,"end":7036}],[{"start":7067,"end":7088}],[{"start":7118,"end":7174}],[{"start":7184,"end":7185}],[{"start":7194,"end":7202}],[{"start":7266,"end":7287}],[{"start":7318,"end":7439}],[{"start":7469,"end":7521}],[{"start":7531,"end":7532}],[{"start":7541,"end":7599}],[{"start":7630,"end":7792}],[{"start":7822,"end":7906}],[{"start":7937,"end":7959}],[{"start":7989,"end":7998}],[{"start":8028,"end":8064}],[{"start":8095,"end":8128}],[{"start":8158,"end":8225}],[{"start":8255,"end":8274}],[{"start":8305,"end":8328}],[{"start":8384,"end":8414}],[{"start":8444,"end":8479}],[{"start":8509,"end":8608}],[{"start":8638,"end":8664}],[{"start":8695,"end":8735}],[{"start":8765,"end":9101}],[{"start":9131,"end":9204}],[{"start":9234,"end":9240}],[{"start":9270,"end":9299}],[{"start":9329,"end":9402}],[{"start":9432,"end":9443}],[{"start":9473,"end":9547}],[{"start":9577,"end":9614}],[{"start":9644,"end":9731}],[{"start":9762,"end":9792}],[{"start":9822,"end":9862}],[{"start":9893,"end":9901}],[{"start":10068,"end":10212}],[{"start":10219,"end":10303}],[{"start":10310,"end":10418}],[{"start":10430,"end":10431}],[{"start":10440,"end":10441}],[{"start":10450,"end":10451},{"start":10480,"end":10481}],[{"start":10460,"end":10461}],[{"start":10470,"end":10471}],[{"start":10490,"end":10491}],[{"start":10500,"end":10501}],[{"start":10510,"end":10543}],[{"start":10550,"end":10553}],[{"start":10564,"end":10602}],[{"start":10609,"end":10689}],[{"start":10696,"end":10787}],[{"start":10794,"end":10815}],[{"start":10822,"end":10919}],[{"start":10926,"end":10975}],[{"start":10986,"end":10990}],[{"start":11001,"end":11028}],[{"start":11039,"end":11079}],[{"start":11090,"end":11111}],[{"start":11118,"end":11145}],[{"start":11152,"end":11254}],[{"start":11265,"end":11330}],[{"start":11341,"end":11345}],[{"start":11352,"end":11388}],[{"start":11399,"end":11434}],[{"start":11445,"end":11459}],[{"start":11468,"end":11482}],[{"start":11493,"end":11497}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_065.ks","basename":"SC_M_065.ks","indexIds":{"「あの、\n俺が言うのも何ですが、\nほんとに大丈夫スか、\n視た感じかなり……」":0,"「心配感謝する、\nだが、大丈夫だ、\n否、倒れてなど居られない、\nそんな状況ではない……のだ」":1,"「……でもやっぱり、[l]\nその、あのひとの……[l]\n001:GMナンバーと何かあったんですか……？」":2,"「……」":3,"「あ、俺の事は気になさらず、\n現状は別として、大本の方、\nウラの事情は大体把握してますし」":4,"「いや、\nそんなつもりではないんだ、\n茶黒の":5,"首。[l]\nただ──」":6,"「今回の事はいつにもまして判らない事が多過ぎて、\n私自身も整理がついてない……というのが、[l]\n正直な所なんだ。[l]\nあの人は確かに私の前に現れた、\n──真然名無、あの方の考えと行動は、\n或る意味で司書長の思惑そのものでもある、\nだから、\n余計に、\n否、[l]\n":7,"……私に今出来る事は、[l]\n今私がしている事だ。[l]\n私がこうして復帰出来ている事が、\n或る種の証明になるだろう、が、[l]\n":8,"それ以外の事は、説明が──出来ない」":9,"「それは、\n言葉通りの意味で？[l]\nそれとも、意図的な隠蔽スか？[l]\nまあ、口に出して言っちゃってる時点でアレですけど、\n……悪く取らないで欲しいんですが、[l]\n貴女もかれおんの上司と同じで、\n『いい人』に視えますけど。[l]\nかれおんの今回の行動も看過してくれてますし、\nそれなら──」":10,"「……語るべきでないものは、ある、[l]\n今はそれしか言えない、\nただ、それでも私は、\n………、[l]\n":11,"あの甥を、愛してる。[l]\n本心だ。[l]\nあれは、飯窪真言、[l]私の妹現実のただ一人の息子、[l]\n":12,"そうだろう？」":13,"「此処に来たときの奴の告白を聞いた上での、\nその台詞でしょ。[l]\n愚問ですよ。[l]\n彼奴は、\nやっとジシンをみつけたんです。[l]\n魂の双子、心のトモとして、\n取り敢えずは俺もその点は喜んでますし、\n伯母としての貴女のその感情は、\n僭越な言い様スけどね、僕のみこんだ通りです、\n大事にして欲しい。[l]\nですが、\nだからこそ、\n………、[l]\n……いあ、いいす」":14,"「言葉以外のことで伝えるのが、今なんでしょ、\nこの場合は。[l]\n俺もですね、どっちかだけには偏りたくないんで。[l]\nこれ以上の追求は止します。[l]\nただ、」":15,"「言いたい事は分かる。[l]\nあの子を不幸にはしない、\n少なくともあの子を悲しませるようなことは、[l]\nそんな事に私がそれに手を貸すことは──無い。[l]\nもし私が約束を":16,"違えたら、[l]\n":17,"遠慮仮借無く、我々を──私を、阻止するがいい、\nオウト」":18,"「いっやあ～～～、\nそれぁ買い被りって奴で……[l]\n俺如きじゃ貴女方を止めるなんてとてもとても。[l]\nいーくんのフォローが精一杯すね。[l]\n貴女達の中にはどうにも相手にしたくない面子が、\nごまんといますし、\nあの萌え店長も勿論ですが、\nそっちは、\n最終的にやっぱりいーくん自身に、\n片ぁ付けて貰わなきゃいけない訳で」":19,"「……店長の本気、ってまだ知らないんデスけど、[l]\nやっぱり凄いんでしょうか、\nもし修羅場になったりしたらその、\nあの、彼は大丈夫でしょうか……」":20,"「まあ、その時の為の具足だわな、\n効果が如何ほどかは知らねど……」":21,"「魔眼の刺し手に限らず……[l]\n我々の正装は……prot-ein、[l]\nＣＡＴによって作成されるモノだ。[l]\n刺し手の正装は、\nその役割の特性──つまり単独での『狩り』を想定する為、\n他と比べ或る程度の防御を付与される。[l]\n宮さんの本気に対して防御力を示せるかは、\n……私にも分からないが、[l]\n元々黒のイツワは白のミルハと双璧をなすに足る存在、\nの筈だろう」":22,"「あの兄貴の":23,"贔":24,"屓の分が、\nパワーバランスを完全に崩してるでしょうがね……」":25,"「……。[l]\n魔眼の刺し手は──\n黄金の四ツ眼の仮面を被り……[l]\n黒き衣と紅き":26,"裳を纏い……[l]\n矛をもち、\n敵を駆逐、する、もの、\n敵とは即ちLu=Leの魔女、\nそのＣＡＴだ。[l]\n元より同じ存在の我等と彼女等にとって、\n魔眼の刺し手は即ち同等に脅威である、といえる」":27,"「魔眼の刺し手って、\nＣＡＴを紙封するだけモノじゃないんですか？[l]\nEnderは確か……」":28,"「……まだ勉強が足りてないか、[l]\n雨山。[l]\n尾張のあれは狩猟、つまり獲物を得るのが主目的だ。[l]\n遣い手の去就と関係なく、ＣＡＴを奪い紙に封じる役。[l]\nそれだけのモノだ。[l]\n四重奏団のように補助、捕縛、場の展開、[l]\nそれぞれがあってこそ機能する、[l]\n四人揃わねば限りなく無力に近い存在なんだ。[l]\nそれに対して──[l]\n魔眼の刺し手は、[l]\n":29,"文字通り『魔眼を潰す』のだ。[l]\nＣＡＴとの繋がりを断ち、\n遣い手の魔眼質自体を一時的にとは言え失効させる。[l]\n敵を無力化させ、\nその上で、紙封を行う。[l]\n単独で魔女達を殲滅する為に、\nひとりでタつべく仕込まれた男の魔女、\nそれがarchetypeにして唯一の、\n魔眼の刺し手、だと聞いている」":30,"「……天狗に対するテングか……[l]\nつまり『第三者の眼、第三者の視点』だな」":31,"「『Moon=Calf』たる存在は我々のうちでも生まれず久しい、\nと真然名無も言っていたし、\nコストは兎も角もリスクの面で問題があり、\n今の形態、四重奏団のような方式にシフトしたんだそうだ。[l]\nソロに器用貧乏な能力を付与するよりも、\n特化した面子でＰＴ組んだ方が良いとの判断……らしいがな。[l]\n結局その場合でも、\n誰かが欠けてしまえばどうにもならぬ、\nどちらも一長一短だったのだ。[l]\nそこに、あの子が生まれた──」":32,"「ただの男子ではなく、\nその内にイツワのPHASE:10、イーハをもって、っすか」":33,"「……我等飯窪はその為に、[l]\n居たのだ。[l]\nただ、永い間に本義がどう移ろったのか、\n或いは不変のままなのか、\nお前のように永代に渡り在り続けた訳ではない私には、\nもう、\n知る由もない。[l]\n私はただ、愚直に、\n自分の属する世界……否、世間の中で、[l]\nただ真面目に誠実で、行儀良くあれ、\nそう努めてきただけだ。[l]\n真に賢き妹と違ってな」":34,"「んー、まあ、\n思い詰めない事ですよ。[l]\n俺にしたってそーすけどね、\n永く在れば良いって訳でも無いですし。[l]\n短いのよりは経験値が確実に溜まりますが、\nそれを如何に振り分けるかが肝要なのであって、\nそこ次第です結局は」":35,"「そう、だな……[l]\nそうか、矢張り……ああ、[l]\nいや──成る程な」":36,"「？」":37,"「そうだ、\n雨山、オウト、\n知っているかも知れないが、\nどうやらこの玄ノ森に潜在……潜伏、[l]\nしているらしい、\n八相殺しの犯人……がだ」":38,"「G、GW？」":39,"「そもそも尾張が其奴と交戦したから、\nややこしくなったんだぞ。[l]\nそこまでは聞いてないのか」":40,"「いえ、\nあ………っ、[l]\n聞いて、たような」":41,"「……言ってたろ、[l]\n野放しになってるってあの上司さんが」":42,"「あ゛っ、言ってましたっ」":43,"「………。[l]\nそのミに直にＣＡＴの力を宿し、\n視えるのとは別の感得の仕方でそれを行使する、\nそれが『身盗りの生やし』、GreenWoodと呼ばれる、\n先刻のとは別の男魔女、\n放置自体は司書長の言によるものだったが、\n実害を被った今、どうなるものかは知れない」":44,"「……彼奴、もしや」":45,"「それに、\nもし真言が宮さん……ミルハと、[l]\n穏やかでない遣り取りになった場合、\nヒトに受肉し、\n自律しているミルハにとっては、\n魔眼質失効は無意味だろう、\n別途ＣＡＴがあるに越したことはないが、\nキリアケ程度で意味があるかどうかは──」":46,"「おあ？」":47,"「のあっ」":48,"「………まこと」":49,"「お待たせ、\nシロを手懐ける……っていうか、[l]\n操作感に馴れるのに手間取って」":50,"「それが……シロか」":51,"「刺し手としての仕込みとは違って、\nこっちは僕も初だし、\n流石にぶっつけ本番って訳にもいかないと思って、\nでも、もう何とかいけそう……だと思う」":52,"「……明確に形而下に顕れる型、[l]\nは珍しいよな？[l]\nかれおん、知狡さん」":53,"「……WCLのアーカイブの中でも、[l]\nフル稼働もなしにこれだけ、\nっていうのはまず──」":54,"「受肉の依代が残る、\n紙封前段階のＣＡＴの在り方に似てはいるが、\n……言い方が難しいな、……」":55,"「やっぱり、\n……強いて言うならLinkableFormの在り方に──」":56,"「あの、\nまあその辺は気にしなくていいんじゃないかな、\n仕組みは分からなくてもラジオは聴ける……んだし。[l]\n感得するのが肝要だって」":57,"「あ？[l]\n相変わらずアナクロだなあ。[l]\nパソコン、せめてテレビとかで例えてくれるか。[l]\nそれに、\nハードウェアもソフトウェアも、\n仕組みは知ってるに越したことは……」":58,"「そういう意味じゃ、\n僕も記述設計から調整まで絡んだ……事になるし、[l]\n兎に角シロに関しては問題ないよ。[l]\n":59,"仮面":60,"の方は、今はまだ、\n本起動無理かなあ……[l]\n暴発したら大変だし──」":61,"「ちょ、待て、\n俺は兎も角こちらのお二人さんの為にもそら、\n気をつけろよマジで」":62,"「──と言うわけで、\nキリアケは知狡さんが持っててください。[l]\n確か、知狡さんが管理してるんでしたよね？」":63,"「あ、ああ、まあそうだが……[l]\n私には……」":64,"「僕にはシロがいるし、\nそれに、」":65,"「ああ、宮さんには、\nキリアケでは荷が勝つだろうな……[l]\nだが、………。[l]\n……":66,"現":67,"実……私は……」":68,"「シロなら、\n何とかなる確証は？」":69,"「……正直言って、[l]\nそれは何とも言えない、\nけど……[l]\nああ、それより、\n先刻の話じゃないけど、\n迂闊に僕に近づくと巻き添え喰らわすかも知れないから、\n僕はこれから単独で動こうと思う」":70,"「……ま、[l]\n勝率１０割じゃなきゃ告れない訳じゃなし、\n俺はフォローとして適当に周り":71,"彷":72,"徨いてらぁ、\nあ、告白の邪魔はしねーし出歯亀するつもりもないからよ。[l]\n心置きなく玉砕して来い」":73,"「だっ、からお前なあ……[l]\n真面目な話、冬夏達八相の方を寧ろ、\nフォローというか、守って欲しい。[l]\n彼女達は、\nきっと何も知らないんだろうし……[l]\nまあ、非道いことにならないようにする為に、\n僕は行くんだけど、\n何があるかは分からないし、\nその、」":74,"「あーもう言わんでいいさ、\nそういや抑えられてたＹのよ……も、[l]\nもう開放されたんだったか、\n女子関係に多少執着も出てくるのが健全じゃわい」":75,"「……何のことだかさっぱりわからんけど……」":76,"「……え、えーと」":77,"「……あれらも一枚岩とは限らんぞ、[l]\nそこは気をつけてくれ」":78,"「……それは承知してます。[l]\nでも、すまん、頼む大神」":79,"「分かってるっての。[l]\n重々気をつけるし。[l]\n俺だって此処で散るつもりは更更無いしな、\nな、かれおん」":80,"「はいっ？[l]\nは、ハイっ」":81,"「ありがとう。[l]\nえーと、[l]\n":82,"悪い、すみません、[l]\nちょっと、一旦寝たい……」":83,"「またかよ？[l]\nてかお前、\n折角着替えたのによう」":84,"「……覚醒による記憶回復、急激な情報流入を、[l]\n睡眠による脳内整理で処理しようとしてるのだろう。[l]\nそれに昔からこの子は、\n厭な事があっても数日寝れば忘れる子だった」":85,"「ああ、\nまあ、そういう事もありますかいね」":86,"「小難しい理屈は分かりませんが……[l]\nそうかも……知れないです……」":87,"「着替えをどうするかは任せるが、\nお前が寝てる間は、\n私が、何としてもこの場は守ろう。[l]\nそれに祭儀に向かうとすれば、\nどちらにしても真夜中になるしな、\nそうでなくても昼間は祭の人出でごった返している、\n本起動フハイの負荷を少しでも減らすために、\n宮さんも──\n既に狩り場に出たとの連絡は入っているが、\n恐らく夜までは……[l]\n少なくとも派手に動く事はないだろう。[l]\nとなれば、\n夜に行動する為にも今は休むが得策かも知れん。[l]\nそっちの二人もだ、そして真言の事、……頼む。[l]\n私ではキリアケがあろうと、\n大した力になれそうにない……」":88,"「俺は構いませんが、\nもし昼間の内から何かあったらすぐ言ってくださいよ。[l]\nお一人でどうこうしようなんて思わんとってください」":89,"「……ああ」":90,"「……大丈夫すか？[l]\n寧ろ貴女が休むべきじゃ」":91,"「いや、問題ない。[l]\n余計な心配かけてすまない……[l]\nさ、\n君等が休める準備をする、\n暫く待ってくれるか」":92,"「あっ、お手伝い──」":93,"「面識の無いオウトならまだしも、\n雨山が居るのが知れるのは問題があるだろう、\n一人でやれるよ、\nこの地下で３人で待っていろ」":94,"「やんわりヘルプ要請されたような気がしますけど、\nどうしますかい」":95,"「ん？[l]\nあ、ああ、今のは言葉の綾だ、\n無論お前も、\n誰かに会わせずに済むに越したことはないからな。[l]\n兎に角大人しく此処にいるんだ」":96,"「……ごめん……ありがとう……[l]\n知狡さん……」":97,"「ふっ。[l]\n家族に遠慮なぞ、\nするもんじゃない、そうだろう」":98,"「……ええ……」":99,"生きていくなかで、[l]\n　生きていこうとするなら、[l]\n　どうしても戦わなければならないときがある、[l]\n　何者をも傷付けずに済むのなら\n  その方が良いに決まってるけれど、[l]\n　この最悪の箱庭は、[l]\n　それを赦してくれない。":100,"だが、だからといって、[l]\n　それを大義名分に掲げ、[l]\n　無意味に敵を作り、[l]\n　無自覚なものを巻き込み争いごとをなすのはどうだろう。":101,"ゲームは、ルールに則って行うものだ。[l]\n　無秩序な争いにおいて被るのであろう、[l]\n　互いの傷を最小限に抑えるために、[l]\n　基準を設け、[l]\n　ルールをつくり、[l]\n　":102,"勝":103,"ち":104,"と":105,"負":106,"け":107,"い":108,"う":109,"結果を想定し、[l]\n　行われるもの、じゃないんだろうか。":110,"僕は、":111,"あなたをとめたい、[l]\n　むやみな憎み合いの連鎖を止めるためにも。":112,"絶対に零に出来なくとも、[l]\n　それに近づけるように、[l]\n　拮抗する力があったって、[l]\n　おおきな善意があったって、いい筈だ。":113,"バランスの保たれた平常というのは、[l]\n　静止した状態ではなく、[l]\n　全てが動き走り続け拮抗してこその、[l]\n　おとしどころとしての相なのだ、と思う。":114,"最悪の箱庭でも、そこがきっとみつけられる。":115,"そして、[l]\n　きっと僕の把握していない、[l]\n　想像すらしていないところに、[l]\n　まだ無自覚な演者がいて、[l]\n　憎しみや悲しみを吐いているのだろう。":116,"『たたかいあうことは進歩の源泉でもあるが、[l]\n　にくしみあうことは誰の得にもならない』":117,"だから、":118,"貴女とはたたかうけれど、[l]\n　憎くはない、":119,"そのあとにたとえわかれが、破局が訪れたとしても、[l]\n　貴女のことは、":120,"好きだけど、[l]\n　嫌いだから。":121,"愛しくもないけど、[l]\n　厭うてもないから。":122,"……実際に眼にしたら、[l]\n　きっと、[l]\n　そんな理屈は吹っ飛ぶって、[l]\n　そうも思うよ。[l]\n　冷静でいられるかどうかは、[l]\n　正直自信はないさ、":123,"でも、[l]\n　これから貴女と会って、[l]\n　互いに我を通し合うたたかいに、[l]\n　赴く自分に後悔は、":124,"ないよ。":125,"だからお互い、[l]\n　遠慮無しで、[l]\n　本音から、":126,"僕とあなた、二人の在り方に、[l]\n　決着をつけさせてほしい。":127,"せめてそれくらいのことには、":128,"相手してくれるとうれしいよ、":129,"宮さん。":130},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_065.ks","relPath":"/data/scenario/SC_M_065.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":128,"length":131,"percent":97.70992366412213},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[22,0]},"/data/scenario/SC_M_066.ks":{"data":[["さて……","那么……"],["お祭り騒ぎの前に、\n返して貰わねばならないものがある……か。","在庆典狂欢之前，\n有件必须讨回的东西……对吧？"],["音や彼の御陰で、\n場所は既に判っている。","托音和他的福，\n地点已经掌握了。"],["「ごきげんよう。[l]\n時間が無いので用件のみを」","「日安。[l]\n时间紧迫就直入主题了」"],["「おや、\n驚いた。[l]\nどうしたのかな。[l]\n大丈夫なのかね、こんな所に来て」","「哎呀，\n真意外。[l]\n这是怎么了？[l]\n不要紧吗，跑到这种地方来」"],["「これを渡しておきましょう」","「先把这个交给你吧」"],["「……大黒？[l]\nおいおい、\n人が悪いなぁナナ。[l]\n何処で、いつの間に」","「……大黑？[l]\n喂喂，\n真够坏心眼的啊名无。[l]\n什么时候，在哪得手的」"],["「貴女方の、能無し当主の知らぬ間に。[l]\n誰でも出来ることです」","「就在贵方那位无能当家眼皮底下。[l]\n谁都能轻易办到哦」"],["「言いますなぁ。[l]\n確か冬夏君も探し出せずにいたのでしょうに──\nああ、そもそも……[l]\nてことは、祭儀用に持っていってる筈の、\n向こうにはフェイクが？[l]\n彼方に居るのはのぎか殿じゃあるまいし、\n只の紙ではないんでしょうが」","「瞧您说的。[l]\n冬夏君不也一直没能找到吗──\n啊，说起来……[l]\n也就是说，本该带去祭仪用的\n对面拿到的是赝品？[l]\n在那边的总不会是希香大人吧\n虽然不单纯是张纸」"],["「単に普通でないだけですよ。[l]\n反応するだけで中身のない、\nダミー、モックアップのようなものです。[l]\nそれよりも手短に、と言った筈ですが」","「只是不太普通罢了。[l]\n空有反应没有内容的\n就像假人、模型之类的东西。[l]\n比起这个，不是说好长话短说吗」"],["「ま、訊くなと言うなら問いませんがね。[l]\n僕等の試験紙の方はどうするのかな？[l]\n今のうちに確保しようと思っていた所だが、\n……これがあるなら事後処理の一環で構わないか」","「嘛，既然不让问那就不提了。[l]\n我们这边的试纸要怎么处理？[l]\n本想着趁现在去回收\n……既然有这个就当善后环节也行吧」"],["「そういう事です。[l]\nもう一人、邪な御当主がいらっしゃるでしょう。[l]\n渡したそれはベロアのために──」","「正是如此。[l]\n不是还有位邪门当主在嘛。[l]\n交付之物是为了贝萝娅──」"],["「わかってるよ。[l]\n本来ならば、\n決められたシナリオ通り進むのは興醒めだが……[l]\nここは我慢のしどころだな。[l]\nうちのお","「知道啦。[l]\n本来按既定剧本走\n是挺扫兴的……[l]\n不过现在得忍着点。[l]\n我家那"],["上は恐らく期待に違わぬ動きをするんだろうさ。[l]\nベロアの事は任せてくれ給え」","位上头估计会如预期行动吧。[l]\n贝萝娅的事就拜托您了」"],["「現地で渡すのでは確実性に欠けましたのでね。[l]\nでは頼みます。[l]\nヨキヨルを」","「在当地转交确实不够稳妥。[l]\n那就劳您费心。[l]\n夜安」"],["「よき夜を、ナナ」","「晚安，名无」"],["………。[l]\n永かったなあ、此処まで。","………。[l]\n走到这一步可真漫长啊。"],["報われるか、それとも報いか。[l]\nムクイの音よ、\n派手に、ナれ。","会得到回报，还是遭到报应。[l]\n无奎之音啊\n尽情绽放吧。"],["愉悦の劇に、うつくしく──","为愉悦的戏剧献上华美──"]],"context":[["SC_M_066.ks/index/1/text"],["SC_M_066.ks/index/3/text"],["SC_M_066.ks/index/5/text"],["SC_M_066.ks/index/7/text"],["SC_M_066.ks/index/9/text"],["SC_M_066.ks/index/11/text"],["SC_M_066.ks/index/13/text"],["SC_M_066.ks/index/15/text"],["SC_M_066.ks/index/17/text"],["SC_M_066.ks/index/19/text"],["SC_M_066.ks/index/21/text"],["SC_M_066.ks/index/23/text"],["SC_M_066.ks/index/25/text"],["SC_M_066.ks/index/27/text"],["SC_M_066.ks/index/29/text"],["SC_M_066.ks/index/31/text"],["SC_M_066.ks/index/33/text"],["SC_M_066.ks/index/35/text"],["SC_M_066.ks/index/37/text"]],"tags":[],"parameters":[[{"start":153,"end":157}],[{"start":163,"end":197}],[{"start":203,"end":227}],[{"start":285,"end":314}],[{"start":345,"end":398}],[{"start":429,"end":443}],[{"start":474,"end":525}],[{"start":556,"end":593}],[{"start":624,"end":765}],[{"start":796,"end":881}],[{"start":912,"end":1012}],[{"start":1043,"end":1106}],[{"start":1137,"end":1219}],[{"start":1229,"end":1273}],[{"start":1304,"end":1355}],[{"start":1386,"end":1395}],[{"start":1457,"end":1481}],[{"start":1487,"end":1528}],[{"start":1534,"end":1547}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_066.ks","basename":"SC_M_066.ks","indexIds":{"さて……":0,"お祭り騒ぎの前に、\n返して貰わねばならないものがある……か。":1,"音や彼の御陰で、\n場所は既に判っている。":2,"「ごきげんよう。[l]\n時間が無いので用件のみを」":3,"「おや、\n驚いた。[l]\nどうしたのかな。[l]\n大丈夫なのかね、こんな所に来て」":4,"「これを渡しておきましょう」":5,"「……大黒？[l]\nおいおい、\n人が悪いなぁナナ。[l]\n何処で、いつの間に」":6,"「貴女方の、能無し当主の知らぬ間に。[l]\n誰でも出来ることです」":7,"「言いますなぁ。[l]\n確か冬夏君も探し出せずにいたのでしょうに──\nああ、そもそも……[l]\nてことは、祭儀用に持っていってる筈の、\n向こうにはフェイクが？[l]\n彼方に居るのはのぎか殿じゃあるまいし、\n只の紙ではないんでしょうが」":8,"「単に普通でないだけですよ。[l]\n反応するだけで中身のない、\nダミー、モックアップのようなものです。[l]\nそれよりも手短に、と言った筈ですが」":9,"「ま、訊くなと言うなら問いませんがね。[l]\n僕等の試験紙の方はどうするのかな？[l]\n今のうちに確保しようと思っていた所だが、\n……これがあるなら事後処理の一環で構わないか」":10,"「そういう事です。[l]\nもう一人、邪な御当主がいらっしゃるでしょう。[l]\n渡したそれはベロアのために──」":11,"「わかってるよ。[l]\n本来ならば、\n決められたシナリオ通り進むのは興醒めだが……[l]\nここは我慢のしどころだな。[l]\nうちのお":12,"上は恐らく期待に違わぬ動きをするんだろうさ。[l]\nベロアの事は任せてくれ給え」":13,"「現地で渡すのでは確実性に欠けましたのでね。[l]\nでは頼みます。[l]\nヨキヨルを」":14,"「よき夜を、ナナ」":15,"………。[l]\n永かったなあ、此処まで。":16,"報われるか、それとも報いか。[l]\nムクイの音よ、\n派手に、ナれ。":17,"愉悦の劇に、うつくしく──":18},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_066.ks","relPath":"/data/scenario/SC_M_066.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":19,"length":19,"percent":100},"cellInfo":[]},"/data/scenario/SC_M_067.ks":{"data":[["「遅いわよ、\n何がすぐに追いつく、よ。[l]\n祭儀儀礼なんだから進行に滞りがあるのは拙いのよ」","「太慢了\n说什么马上追上来。[l]\n祭礼仪礼最忌讳流程出纰漏」"],["「御免御免。[l]\nま、時間には間に合ってるだろ。[l]\n祭の所為か、一部道路状況に難があってね。[l]\n車が思うように進まなかったのだよ。[l]\n予想よりは時を喰ったが、\n式に支障はないよ」","「抱歉抱歉。[l]\n反正没耽误正点。[l]\n祭典搞得部分路段状况不佳[l]\n车子实在开不顺。[l]\n比预计多花了些时间\n但仪式不会受影响」"],["「あのねえ、\nこういうのは結果論じゃなくて、\n姿勢態度の問題なのよ、\nそれにこんな時間まで混んでたっての？[l]\nあんたは……」","「我说啊\n这种事不该看结果论\n是态度问题好吗\n再说这个点还堵车？[l]\n你真是……」"],["「おいおい、\nそんなに興奮しなさんな。[l]\n今のミコの身体にはきついだろう」","「哎呀呀\n别这么激动嘛。[l]\n现在卑尊的身体会吃不消」"],["「あんたがそうさせてるんでしょう……[l]\nはあ……[l]\n早く、皆と合流するわよ、\nあの方含めて全員準備出来てるのよ。[l]\nあとはあんたと私だけ」","「还不是因为你……[l]\n哈啊……[l]\n快点去和大家汇合啦\n包括那位全员都准备好了[l]\n就差你和我」"],["「",""],["善","善"],["哉善哉。[l]\nじゃ、早速動こうか」","哉善哉。[l]\n那就赶紧动身」"],["「……何か……きた」","「……有什么……来了」"],["「え？[l]\nあ、遅れてたあの二人じゃ」","「诶？[l]\n啊、是迟到的那两人吧」"],["「……そう……？」","「……是吗……？」"],["「違うわけが、あ、ほら」","「才不是啦，啊，你看」"],["「……」",""],["「あらあら、ようよう来はりましたなぁ。[l]\nおふたりとも、お疲れ様です」","「哎呀哎呀，可算来了呢。[l]\n两位都辛苦啦」"],["「やあやあ、お待たせして申し訳ない皆様、[l]\nこれで全員──[l]揃いました次第で。","「哎呀呀，让各位久等实在抱歉，[l]\n这下全员──[l]都到齐了。"],["いざやいざ、","来吧来吧，"],["永きに[l]待ち焦がれた[l]我等が祭儀を[l]始めん！」","让我们开启[l]期盼已久[l]的[l]神圣祭仪！」"],["「馬鹿、何大声出してん──」","「白痴，喊什么喊──」"],["ひゅーーーっ、","咻————，"],["ざす！！！！！！","嚓！！！！！！"],["「？？？！！！？！」",""],["「おまえ──」","「你这──」"],["「にゃ、こっ、」","「喵、呜、」"],["「ふぅぅぅぅぅぅーーーーーっ、\nふぅぅぅぅぅぅーーーーーっ」","「呼呜呜呜呜呜——————，\n呼呜呜呜呜呜——————」"],["「なっ、えっ？」","「怎、咦？」"],["「あかん、ちょっ、\n魔女殿、冬夏ちゃん、こっちですぅ」","「不行、等等、\n魔女大人、冬夏酱、快过来这边」"],["がっ！！！！！！","嘎！！！！！！"],["「がぁ──っ！！！」","「嘎啊──！！！」"],["「………克杖」","「………克杖」"],["「ひ、ひぃ？！」","「噫、噫？！」"],["「限解お願い」","「请求限解」"],["「あえっ？！[l]\nうっ、うんっ」","「啊诶？！[l]\n呜、嗯」"],["「ふぅぅぅぅぅぅーーーーーっ……」","「呼呜呜呜呜呜——————……」"],["「……おまえ、[l]\n……気持ち悪い」","「……你这家伙，[l]\n……真恶心」"],["「！！！！！！」",""],["おぁああああああああああああああああああん。","呜啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊。"],["「げっ、","「呕、"],["限","限"],["解マル、ミャ？」","解完成，喵？」"],["「ワゥ」","「汪呜」"],["「有効時間……其方の任意、ミャ？」","「有效时间……随您心意，喵？」"],["「がぁあああああああっっ！！！！！！」","「嘎啊啊啊啊啊啊啊！！！！！！」"],["「すっかり……[l]失念してたわ、[l]\nあの時補足し損ねて、\nそれっきり、\n放置してたなんて、迂闊過ぎたのよ」","「完全……[l]忘记了呢，[l]\n那时候没能抓住，\n之后就，\n一直放任不管，实在太粗心了」"],["「いや全く驚いた。[l]\n他のみんなは？」","「真是令人吃惊。[l]\n其他人呢？」"],["「あの二人以外は多分、\n一緒に」","「除了那两个人之外大概，\n都在一起」"],["「ミコは此処に居ろ。[l]\n或る意味ではキミさえ居れば、\nこの場は何とかなるし、\n僕は彼女等の様子を確認してくる」","「卑尊留在这里。[l]\n某种意义上只要有你在，\n这个场面就能稳住，\n我去确认她们的情况」"],["「なっ、何言って、\n何かあったら、\nあんただってロクに対処なんか、」","「你、说什么呢，\n要是出什么事，\n你一个人根本没法好好应付，」"],["「いいから。[l]\nそんな場合ではない」","「别说了。[l]\n现在不是说这个的时候」"],["「ちょっ、待ちなさ──」","「等、等一下──」"],["「……何処に行った……？」","「……去哪了……？」"],["「……み、みうしなった……」","「……跟、跟丢了……」"],["「……あ」","「……啊」"],["「え、えっ？[l]\nいた？！」","「咦、咦？[l]\n在哪儿？！」"],["「まことさんが」","「是真言先生」"],["「はっ？[l]\n兄ぃが？[l]\n兄ぃがどうしたのっ」","「哈？[l]\n老哥？[l]\n老哥怎么了啦」"],["「……克杖、[l]\n真言さんと合流して限解──サポートお願い。[l]\nさっきの奴は私が何とかする」","「……克杖，[l]\n和真言汇合后限解──请求支援。[l]\n刚才那家伙我来处理」"],["「えっ？！[l]\nな、なにいってるの、\n兄ぃが居るの？何処に？[l]\nそれに独りでって──」","「诶？！[l]\n你、你在说什么，\n老哥在？在哪里？[l]\n而且一个人怎么──」"],["「此処に向かってる、真言さん。[l]\nやっと、……だから、[l]\nあとは、\nあの、邪魔者を消すだけ。[l]\n克杖は、足手まといなの」","「正往这边来的，是真言。[l]\n终于、……所以、[l]\n接下来、\n只要、把那个碍事的家伙消灭掉。[l]\n克杖你、会成为累赘的」"],["「……！」",""],["「……わかって。[l]\n今私が本気出したら、克杖傷付けるかも知れない、\nそんな事は、\nしたくないの」","「……我明白。[l]\n现在如果我动真格的话，可能会伤到克杖、\n那种事、\n我不想做」"],["「で、でも……」","「可、可是……」"],["「真言さんの力になってあげて、\n私の分まで」","「请你去帮真言的力量、\n连同我的份一起」"],["「？！[l]\nだっ、だめだよきーちゃ、\nヘンな事言わないでよっ、\n無茶しちゃだめっ！！」","「？！[l]\n不、不行啊小姬、\n别说这种奇怪的话、\n不许乱来！！」"],["「大丈夫、\n必ずみんなで、\nまことさんと──\nだから、わかって」","「没关系的、\n大家一定会、\n和真言先生一起──\n所以、请理解」"],["「……きっ、[l]\n………」","「……呜、[l]\n………」"],["「──ごめん、行く。[l]\nぐずぐずしてると逃げられちゃう」","「──抱歉，我走了。[l]\n再磨蹭的话就要被逃掉了」"],["「あっ、\nぜ、ぜっ、\n絶対だからね？[l]\nあ、兄ぃの事はまかしといて！！！[l]\nだから、」","「啊、\n绝、绝对、\n要说到做到哦？[l]\n啊、哥哥的事就交给你了！！！[l]\n所以、」"],["「──ありがとう」","「──谢谢你」"],["「ぜったい、\nみんなでまたっ──！！！」","「绝对、\n要和大家再聚首──！！！」"],["びゅうっ。","咻。"],["「……もし私が駄目でも、[l]\n克杖、\nあなたがかわりにあのひとの──」","「……就算我失败了、[l]\n克杖、\n请你代替我守护那个人──」"],["「……きーちゃぁ……[l]\nあ、兄ぃ、どう、しよう……？[l]\nほんとに、兄ぃが？[l]\nど、どういうことなの……っ、[l]\n………、[l]\nほ、\n他のみんなは……？」","「……小姬啊……[l]\n啊、哥哥、怎么办、怎么办……？[l]\n真的是、哥哥吗？[l]\n这、这到底是怎么回事啊……、[l]\n………、[l]\n其、\n其他人呢……？」"],["どくん。","咚。"],["「……痛っ」","「……好痛」"],["「……まことさん……？」","「……是真先生……？」"]],"context":[["SC_M_067.ks/index/1/text"],["SC_M_067.ks/index/3/text"],["SC_M_067.ks/index/5/text"],["SC_M_067.ks/index/7/text"],["SC_M_067.ks/index/9/text"],["SC_M_067.ks/index/11/text"],["SC_M_067.ks/index/13/text"],["SC_M_067.ks/index/15/text"],["SC_M_067.ks/index/17/text"],["SC_M_067.ks/index/19/text"],["SC_M_067.ks/index/21/text"],["SC_M_067.ks/index/23/text"],["SC_M_067.ks/index/25/text","SC_M_067.ks/index/154/text"],["SC_M_067.ks/index/27/text"],["SC_M_067.ks/index/29/text"],["SC_M_067.ks/index/31/text"],["SC_M_067.ks/index/33/text"],["SC_M_067.ks/index/35/text"],["SC_M_067.ks/index/37/text"],["SC_M_067.ks/index/39/text"],["SC_M_067.ks/index/41/text"],["SC_M_067.ks/index/43/text"],["SC_M_067.ks/index/45/text"],["SC_M_067.ks/index/47/text"],["SC_M_067.ks/index/49/text"],["SC_M_067.ks/index/51/text"],["SC_M_067.ks/index/53/text"],["SC_M_067.ks/index/55/text"],["SC_M_067.ks/index/57/text"],["SC_M_067.ks/index/59/text"],["SC_M_067.ks/index/61/text"],["SC_M_067.ks/index/63/text"],["SC_M_067.ks/index/65/text"],["SC_M_067.ks/index/67/text"],["SC_M_067.ks/index/69/text"],["SC_M_067.ks/index/71/text"],["SC_M_067.ks/index/73/text"],["SC_M_067.ks/index/75/text"],["SC_M_067.ks/index/77/text"],["SC_M_067.ks/index/79/text","SC_M_067.ks/index/83/text"],["SC_M_067.ks/index/81/text"],["SC_M_067.ks/index/85/text"],["SC_M_067.ks/index/87/text"],["SC_M_067.ks/index/89/text"],["SC_M_067.ks/index/91/text"],["SC_M_067.ks/index/93/text"],["SC_M_067.ks/index/95/text"],["SC_M_067.ks/index/97/text"],["SC_M_067.ks/index/99/text"],["SC_M_067.ks/index/101/text"],["SC_M_067.ks/index/103/text"],["SC_M_067.ks/index/105/text"],["SC_M_067.ks/index/107/text"],["SC_M_067.ks/index/109/text"],["SC_M_067.ks/index/111/text"],["SC_M_067.ks/index/113/text"],["SC_M_067.ks/index/115/text"],["SC_M_067.ks/index/117/text"],["SC_M_067.ks/index/119/text"],["SC_M_067.ks/index/121/text"],["SC_M_067.ks/index/123/text"],["SC_M_067.ks/index/125/text"],["SC_M_067.ks/index/127/text"],["SC_M_067.ks/index/129/text"],["SC_M_067.ks/index/131/text"],["SC_M_067.ks/index/133/text"],["SC_M_067.ks/index/135/text"],["SC_M_067.ks/index/137/text"],["SC_M_067.ks/index/139/text"],["SC_M_067.ks/index/141/text"],["SC_M_067.ks/index/144/text"],["SC_M_067.ks/index/146/text"],["SC_M_067.ks/index/148/text","SC_M_067.ks/index/152/text","SC_M_067.ks/index/156/text"],["SC_M_067.ks/index/150/text"],["SC_M_067.ks/index/158/text"]],"tags":[],"parameters":[[{"start":165,"end":220}],[{"start":251,"end":367}],[{"start":397,"end":477}],[{"start":508,"end":555}],[{"start":585,"end":676}],[{"start":707,"end":708}],[{"start":718,"end":719}],[{"start":729,"end":751}],[{"start":839,"end":849}],[{"start":879,"end":903}],[{"start":933,"end":942}],[{"start":972,"end":984}],[{"start":1012,"end":1016},{"start":5541,"end":5545}],[{"start":1043,"end":1084}],[{"start":1187,"end":1234}],[{"start":1266,"end":1272}],[{"start":1306,"end":1335}],[{"start":1388,"end":1402}],[{"start":1438,"end":1445}],[{"start":1530,"end":1538}],[{"start":1632,"end":1642}],[{"start":1672,"end":1679}],[{"start":1709,"end":1717}],[{"start":1748,"end":1782}],[{"start":1812,"end":1820}],[{"start":1847,"end":1878}],[{"start":1912,"end":1920}],[{"start":1998,"end":2008}],[{"start":2125,"end":2132}],[{"start":2164,"end":2172}],[{"start":2202,"end":2209}],[{"start":2239,"end":2260}],[{"start":2317,"end":2334}],[{"start":2392,"end":2415}],[{"start":2472,"end":2480}],[{"start":2545,"end":2567}],[{"start":2642,"end":2646}],[{"start":2656,"end":2657}],[{"start":2666,"end":2674}],[{"start":2704,"end":2708},{"start":2785,"end":2789}],[{"start":2738,"end":2755}],[{"start":2848,"end":2867}],[{"start":3017,"end":3085}],[{"start":3116,"end":3141}],[{"start":3171,"end":3191}],[{"start":3222,"end":3291}],[{"start":3321,"end":3363}],[{"start":3394,"end":3418}],[{"start":3448,"end":3460}],[{"start":3587,"end":3600}],[{"start":3630,"end":3644}],[{"start":3703,"end":3708}],[{"start":3738,"end":3757}],[{"start":3787,"end":3795}],[{"start":3825,"end":3859}],[{"start":3917,"end":3974}],[{"start":4004,"end":4062}],[{"start":4092,"end":4174}],[{"start":4204,"end":4209}],[{"start":4239,"end":4301}],[{"start":4331,"end":4339}],[{"start":4369,"end":4395}],[{"start":4425,"end":4481}],[{"start":4511,"end":4555}],[{"start":4585,"end":4603}],[{"start":4633,"end":4667}],[{"start":4697,"end":4760}],[{"start":4790,"end":4799}],[{"start":4852,"end":4876}],[{"start":4939,"end":4942}],[{"start":4985,"end":5029}],[{"start":5121,"end":5229}],[{"start":5314,"end":5318},{"start":5463,"end":5467},{"start":5608,"end":5612}],[{"start":5394,"end":5400}],[{"start":5686,"end":5698}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_067.ks","basename":"SC_M_067.ks","indexIds":{"「遅いわよ、\n何がすぐに追いつく、よ。[l]\n祭儀儀礼なんだから進行に滞りがあるのは拙いのよ」":0,"「御免御免。[l]\nま、時間には間に合ってるだろ。[l]\n祭の所為か、一部道路状況に難があってね。[l]\n車が思うように進まなかったのだよ。[l]\n予想よりは時を喰ったが、\n式に支障はないよ」":1,"「あのねえ、\nこういうのは結果論じゃなくて、\n姿勢態度の問題なのよ、\nそれにこんな時間まで混んでたっての？[l]\nあんたは……」":2,"「おいおい、\nそんなに興奮しなさんな。[l]\n今のミコの身体にはきついだろう」":3,"「あんたがそうさせてるんでしょう……[l]\nはあ……[l]\n早く、皆と合流するわよ、\nあの方含めて全員準備出来てるのよ。[l]\nあとはあんたと私だけ」":4,"「":5,"善":6,"哉善哉。[l]\nじゃ、早速動こうか」":7,"「……何か……きた」":8,"「え？[l]\nあ、遅れてたあの二人じゃ」":9,"「……そう……？」":10,"「違うわけが、あ、ほら」":11,"「……」":12,"「あらあら、ようよう来はりましたなぁ。[l]\nおふたりとも、お疲れ様です」":13,"「やあやあ、お待たせして申し訳ない皆様、[l]\nこれで全員──[l]揃いました次第で。":14,"いざやいざ、":15,"永きに[l]待ち焦がれた[l]我等が祭儀を[l]始めん！」":16,"「馬鹿、何大声出してん──」":17,"ひゅーーーっ、":18,"ざす！！！！！！":19,"「？？？！！！？！」":20,"「おまえ──」":21,"「にゃ、こっ、」":22,"「ふぅぅぅぅぅぅーーーーーっ、\nふぅぅぅぅぅぅーーーーーっ」":23,"「なっ、えっ？」":24,"「あかん、ちょっ、\n魔女殿、冬夏ちゃん、こっちですぅ」":25,"がっ！！！！！！":26,"「がぁ──っ！！！」":27,"「………克杖」":28,"「ひ、ひぃ？！」":29,"「限解お願い」":30,"「あえっ？！[l]\nうっ、うんっ」":31,"「ふぅぅぅぅぅぅーーーーーっ……」":32,"「……おまえ、[l]\n……気持ち悪い」":33,"「！！！！！！」":34,"おぁああああああああああああああああああん。":35,"「げっ、":36,"限":37,"解マル、ミャ？」":38,"「ワゥ」":39,"「有効時間……其方の任意、ミャ？」":40,"「がぁあああああああっっ！！！！！！」":41,"「すっかり……[l]失念してたわ、[l]\nあの時補足し損ねて、\nそれっきり、\n放置してたなんて、迂闊過ぎたのよ」":42,"「いや全く驚いた。[l]\n他のみんなは？」":43,"「あの二人以外は多分、\n一緒に」":44,"「ミコは此処に居ろ。[l]\n或る意味ではキミさえ居れば、\nこの場は何とかなるし、\n僕は彼女等の様子を確認してくる」":45,"「なっ、何言って、\n何かあったら、\nあんただってロクに対処なんか、」":46,"「いいから。[l]\nそんな場合ではない」":47,"「ちょっ、待ちなさ──」":48,"「……何処に行った……？」":49,"「……み、みうしなった……」":50,"「……あ」":51,"「え、えっ？[l]\nいた？！」":52,"「まことさんが」":53,"「はっ？[l]\n兄ぃが？[l]\n兄ぃがどうしたのっ」":54,"「……克杖、[l]\n真言さんと合流して限解──サポートお願い。[l]\nさっきの奴は私が何とかする」":55,"「えっ？！[l]\nな、なにいってるの、\n兄ぃが居るの？何処に？[l]\nそれに独りでって──」":56,"「此処に向かってる、真言さん。[l]\nやっと、……だから、[l]\nあとは、\nあの、邪魔者を消すだけ。[l]\n克杖は、足手まといなの」":57,"「……！」":58,"「……わかって。[l]\n今私が本気出したら、克杖傷付けるかも知れない、\nそんな事は、\nしたくないの」":59,"「で、でも……」":60,"「真言さんの力になってあげて、\n私の分まで」":61,"「？！[l]\nだっ、だめだよきーちゃ、\nヘンな事言わないでよっ、\n無茶しちゃだめっ！！」":62,"「大丈夫、\n必ずみんなで、\nまことさんと──\nだから、わかって」":63,"「……きっ、[l]\n………」":64,"「──ごめん、行く。[l]\nぐずぐずしてると逃げられちゃう」":65,"「あっ、\nぜ、ぜっ、\n絶対だからね？[l]\nあ、兄ぃの事はまかしといて！！！[l]\nだから、」":66,"「──ありがとう」":67,"「ぜったい、\nみんなでまたっ──！！！」":68,"びゅうっ。":69,"「……もし私が駄目でも、[l]\n克杖、\nあなたがかわりにあのひとの──」":70,"「……きーちゃぁ……[l]\nあ、兄ぃ、どう、しよう……？[l]\nほんとに、兄ぃが？[l]\nど、どういうことなの……っ、[l]\n………、[l]\nほ、\n他のみんなは……？」":71,"どくん。":72,"「……痛っ」":73,"「……まことさん……？」":74},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_067.ks","relPath":"/data/scenario/SC_M_067.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":70,"length":75,"percent":93.33333333333333},"cellInfo":[]},"/data/scenario/SC_M_068.ks":{"data":[["「な、[l]なんやねん、[l]\nさっきの、[l]\nヒトなんか？[l]\nむ、[l]むちゃくちゃやばい感じやって、[l]\n今もめっさざわざわする、[l]首筋緊張しとる、\n痛いくらいや、[l]\nあ、[l]あかん、脚ふ、[l]震えて、[l]心臓もバクバクいっとるし」","「搞、[l]搞什么啊、[l]\n刚才的、[l]\n是人吗？[l]\n超、[l]超级不妙的感觉啊、[l]\n现在也超级毛骨悚然的、[l]后颈都绷紧了、\n痛得要命、[l]\n不、[l]不行、腿在、[l]发抖、[l]心脏也砰砰直跳」"],["「落ち着いて、\n深呼吸しいな。[l]\n姫様ちゃん達がなんとかしてくれますよぅ」","「冷静点、\n深呼吸啦。[l]\n姫様她们会想办法的啦」"],["「あんなん、[l]\nだってこっちでうちらの身内を、\nこ、[l]こ、[l]ころしたやつちゃうの？！[l]\nあんな、[l]\nあんなん、\nいやや、[l]うち、[l]もう、[l]\nいややぁってぇーーー！！！」","「那种东西、[l]\n可是在咱们地盘上杀了、\n咱、[l]咱、[l]咱们同伴的家伙啊？！[l]\n那样的、[l]\n那种东西、\n不要啊、[l]我、[l]已经、[l]\n不要啊呜哇啊啊啊──！！！」"],["「大丈夫よぅ、\nええ子やから大人しくしぃ？[l]\nほら、冬夏ちゃんみたいにどっしり構えぇな。[l]\nええ女はこういう時でも狼狽えんもんですよぅ」","「没关系的啦，\n乖孩子要老老实实待着哦？[l]\n你看，要像冬夏酱那样沉住气嘛。[l]\n好女人这种时候也不会慌慌张张的啦」"],["「……」",""],["「そ、[l]そんなこというたってな、\nうちこんなんきいてへんし、[l]\nう、[l]うちらころされるんか？[l]\nし、[l]しぬんはいやや、うちそんなんいやや、\nこわい、[l]こわいよぅ」","「可、[l]可你这么说，\n人家根本听不懂啊，[l]\n呜、[l]我们会被杀掉吗？[l]\n不、[l]不要死、人家不要这样、\n好可怕、[l]好可怕啦」"],["「ええ加減にしなさい。[l]\nあんたがそんなに怯えてもうたら、\nこちらも不安がられてまうでしょ。[l]\n今はすっかり価無ちゃんとおんなじ、\n身体の方は御子様なんですから」","「适可而止吧。[l]\n你要是这么害怕的话，\n连我们都会跟着不安的。[l]\n现在你和价无酱完全一样，\n身体都是幼童状态啊」"],["「……気遣い無用です。[l]\nその娘は真に子供、致し方ないでしょう。[l]\n兎に角今は、\nあの二人に任せるしかありませんね。[l]\nベロアを迎撃に出すには、\nあまりにもこの子は──」","「……不必费心。[l]\n那姑娘确实是个孩子，情有可原。[l]\n总之现在，\n只能交给那两个人了。[l]\n要派贝萝娅去迎击的话，\n这孩子实在太过──」"],["「……ごめんなさい、[l]\nベロアがこんなじゃなきゃ、\nあんなモノ、どうとでも……」","「……对不起、[l]\n要不是贝萝娅变成这样、\n那种东西、明明可以随便解决……」"],["「あなたは悪くないわ。[l]\nそれより今はトウカを、\n護らねばなりません。[l]\n何としてでも」","「不是你的错。[l]\n现在更重要的是保护冬夏、\n必须保护好她。[l]\n无论如何都要」"],["「ほんなら、\n取り敢えず社に避難しましょか？[l]\n地下通路のが近いですかいねぃ……」","「那咱们、\n先躲到神社里咋样？[l]\n走地下通道比较近噻……」"],["「何処へでも、\nより安全な方へ」","「无论去哪里、\n只要更安全就行」"],["「じゃあ地下の方ですかなあ……[l]\n社いうても古い木造ですしねぃ、\n堅固な訳でもなんでもあらしませんわ。[l]\nじゃあ、冬夏ちゃんお任せしてもよろしでしょか？[l]\nお二人にはそこに、\n事態が落ち着くまで隠れてもろうて」","「那就走地下呗……[l]\n虽说神社也是老木头房子噻、\n根本谈不上有多结实。[l]\n那冬夏酱就拜托你咯？[l]\n你们俩就在那儿、\n躲到事情平息为止噻」"],["「貴女方はどうするのです」","「您几位要怎么办」"],["「今更いうまでもありません、\nお二人を護るんが、\n我々の存在意義でしょぅ？[l]\nうちと価無ちゃんなら、\n多少はあん二人の力添えになれます、\nうちらも、\nあれに対処してきますよって」","「事到如今就不必多说了、\n保护您二位、\n正是我们存在的意义对吧？」[l]\n我和价无酱的话、\n多少能给您俩当个帮手、\n我们也会、\n去解决那玩意儿的」"],["「へっ？！[l]\nた、[l]たいしょってなに？[l]\nう、[l]うちはあかんよ、\n絶対無理やって、\nいやや、[l]うちも」","「诶？！[l]\n对、[l]对手是啥？[l]\n不、[l]我不行的、\n绝对办不到、\n不要、[l]我也不要」"],["「あんねえ、\nクイもほんまやったら対外敵要員なんよ。[l]\n遣り方も知ってるでしょうに」","「那个啊、\n奎原本就是对外敌专职人员嘛。[l]\n处理方法你也清楚的吧」"],["「ほ、ほんなんいうたかて、\nう、うぇ、ひっ、くっ」","「就、就算你这么说、\n呜、呜诶、噫、咕」"],["「あまり無理をさせずとも構いませんよ。[l]\nその子も共に──」","「不必太过勉强这孩子也无妨。[l]\n让那孩子也一起──」"],["「……さよぅですか。[l]\nしかたないですなぁ。[l]\nほな急いでこの子ぉも連れて──」","「……这样啊。[l]\n那也没办法呢。[l]\n那就赶紧把这孩子也带上──」"],["「あ、[l]あかん。[l]\nた、[l]立てへんねん、\n歩かれへんて、[l]も、[l]もう、[l]\n動きたない……」","「啊、[l]不行。[l]\n站、[l]站不起来、\n走不动了、[l]已、[l]已经、[l]\n不想动了……」"],["「我が儘言うてる場合やないですがな。[l]\n","「现在可不是任性的时候。[l]\n"],["負ぶっていこにも、\nうちらみんなこんな","就算要背着你走、\n我们也都"],["態やし、\nまさに","这副模样、\n简直"],["猫の手じゃ、\nとてもとても借りられんわね」","连猫爪子、\n都根本借不到力啊」"],["「そ、[l]そやベロア、一緒におって、\nうち、[l]あかんて、\nお、おねがいや」","「对、[l]对了贝萝娅、和我一起、\n我、[l]不行了、\n求、求你了」"],["「え？！[l]\nだ、だめだよカナ、\nベロアは今こそ、マスターと一緒にいなきゃ……」","「诶？！[l]\n不、不行的卡娜、\n贝萝娅现在必须和主人在一起……」"],["「私の事なら心配要りません。[l]\n此処でその娘、守っておあげ」","「我的事不必担心。[l]\n请在这里守护那个女孩」"],["「で、でもっ」","「但、但是」"],["「さ、いつさっきのんが来るか判りませんよって、\n急ぎましょ」","「刚、刚才那些家伙不知何时会再来、\n快走吧」"],["「その子が落ち着いたら、\n一緒に私の所までいらっしゃい。[l]\n必ず無事に私の許に還るのですよ」","「等那孩子平静下来、\n就带她一起来我这儿。[l]\n必定会让你们平安回到我身边」"],["「お二人を届けたらうちもすぐ、\n戻って来ますからねぃ。[l]\nあんさんがたも大人しく、隠れてるんですよぅ」","「把两位送到后我马上、\n就会回来。[l]\n你们也要乖乖躲好哦」"],["「マスターミリアム、\nどうか、どうかお気をつけて──」","「主人米莉安姆、\n请务必、务必小心──」"],["「……いやや、こんなんはいやや、[l]\nか、[l]帰りたい、\nもう」","「……不要、我不要这样、[l]\n想、[l]想回家、\n现在就要」"],["「痛い、痛いよカナ、\n力抜いて……ん」","「好痛、好痛啊卡娜、\n放松力气……嗯」"],["「お待たせしましたぁ、\n……無事なようですな？」","「久等了、\n……看来平安无事？」"],["「さっきのは今のところ視てない。[l]\nそれよりカナが全然、\n痛てて、\n何とかしろっ」","「目前没看到刚才那些家伙。[l]\n倒是卡娜完全、\n痛痛痛、\n快想办法啊」"],["「あああ、[l]は、[l]はよう、\nなんとかしてぇ、[l]もう、」","「啊啊啊、[l]快、[l]快点、\n想想办法啊、[l]真是的、」"],["ばちぃん。","啪叽。"],["「！？」",""],["「……ひっ、[l]ぐ……」","「……呜、[l]咕……」"],["「ええ加減だまらっしゃい、[l]\nいっつまでもうだうだうだうだみっともない」","「给我适可而止、[l]\n一直哭哭啼啼的太难看了」"],["「……センリ……[l]なんてことを、」","「……选律……[l]你怎么能、」"],["「ぐっ……[l]ひぐぅっ……」","「咕……[l]呜咕……」"],["「そうそう、良い子ですやんか、価無ちゃんは。[l]\nやればちゃぁんと出来ますもんねぇ？[l]\nそれにしても」","「对对、价无真是好孩子呢。[l]\n认真做的话明明能做得很好嘛？[l]\n话说回来」"],["「ええ具合によう事が起きてくれはりましたわぁ……[l]\n正直もっと、[l]\nずっと手こずるかと思ってましてん。[l]\nかなりの面倒も、覚悟しとったんですよぅ。[l]\nそしたら巧い具合に、ねえ？[l]\n価無ちゃんだけでなく、冬夏ちゃんの方も、\nこれはまさに──」","「事情进展得意外顺利呢……[l]\n老实说还以为、[l]\n会耗费更多工夫。[l]\n本来都做好面对大麻烦的准备了。[l]\n结果刚好凑巧、对吧？[l]\n不仅是价无、连冬夏也、\n这简直就是──」"],["「？[l]\n何だと？[l]\n何て言った？」","「？[l]\n你说什么？[l]\n刚才说什么？」"],["「いぃえぇ。[l]\nそれより──こういう時こそ、\nぶぶづけ……[l]いえ、[l]\nかゆ、[l]くいたいですねぃ、[l]\n","「不～要～嘛～。[l]\n比起那个──这种时候才更应该、\n噗噜噗噜……[l]不对、[l]\n好饿、[l]想吃东西了呢、[l]\n"],["価","价"],["有。[l]\nちがいますか価無ちゃん？」","有。[l]\n我说得不对吗价无酱？」"],["「……か、[l]かか、[l]\nかゆ、[l]くう[l]ん……？」","「……饿、[l]饿饿、[l]\n好饿、[l]吃[l]嗯……？」"],["身と魂盗り合い武者、[l]鎖腐りて茅ノ輪が忌の空──","窃身盗魂相争者，[l]锈锁缠身茅草轮忌日天──"],["「？[l]\nカナ？[l]\nいきなり何を」","「？[l]\n卡娜？[l]\n突然说什么呢」"],["「な、[l]何故今クイを出すんだよ、[l]カナ」","「为、[l]为什么现在放出奎啊、[l]卡娜」"],["「おなか、へったわ」","「肚子、饿扁了啦」"],["ばぐん！！！","吧唧！！！"],["「……！！！」",""],["「にげたらあかんて……」","「逃掉的话可不行哦……」"],["「あいつ、\nやっぱり、\nくそっ、何処に行った！！[l]\n前から仕込んでたのか！[l]\nカナに不正操作を仕込んだんだな！！！[l]\n何処だッあの女、」","「那家伙、\n果然、\n可恶、跑哪儿去了！！[l]\n早就设好局了吗！[l]\n给卡娜动了手脚对吧！！！[l]\n那个女人在哪儿、」"],["「おなか、[l]すいたんよ」","「肚子、[l]饿扁了啦」"],["「くっ！！[l]\nカナ！！！[l]\nやめろっ、やめてよッ」","「呜！！[l]\n卡娜！！！[l]\n住手、快住手啊」"],["「おいしそうや……」","「看起来好美味啊……」"],["「……ちくしょう、[l]\nマスター、\n……っ」","「……可恶、[l]\n主人、\n……」"],["「くわしてぇなぁ……[l]痛くせんから……」","「让我咬一口嘛……[l]不会弄疼你的……」"],["ぼぎっ。","嘎嘣。"],["「……ゴメン、[l]カナ、[l]ナルベククルシマヌヨウニ、」","「……对不起、[l]卡娜、[l]但愿你能原谅我、」"],["ぎゅるるるぐるぐるぐるごどぼ。","咕噜咕噜咕咚哐当。"],["「……がほっ」","「……咳噗」"],["「ダ……[l]ガ………[l]ッ……[l]\nゲ……」","「大……[l]概………[l]了……[l]\n吧……」"],["「トモったら、何してるのよ、\n大丈夫なの？みんな……」","「小智你在干什么呀、\n没事吧？大家……」"],["がさり。","沙啦。"],["「！！[l]\n……？？！！」",""],["じゃり。","沙沙。"],["「……オァァン」","「……呜啊啊」"],["「…………っ！、…………ッ？」","「…………呜！、…………嗯？」"],["「………ゼェ[l]ェ[l]ェ[l]ェ[l]ェ[l]ェ[l]…[l]…[l]…[l]\nバァ[l]ァ[l]ァ[l]ァ[l]ァ[l]ァ[l]ァ[l]…[l]…[l]…」","「………哈[l]啊[l]啊[l]啊[l]啊[l]啊[l]…[l]…[l]…[l]\n呜[l]啊[l]啊[l]啊[l]啊[l]啊[l]啊[l]…[l]…[l]…」"],["「……………、[l]……………」",""],["「……コニ[l]イルナ……？」","「……在[l]这里吗……？」"],["「…………ッ！、」","「…………呃！、」"],["「……ベロア[l]ダヨ……」","「……是贝萝娅[l]哦……」"],["「………っ？[l]\n──べ、[l]ベロア？[l]\nこ、[l]声が、[l]いえ、[l]そ、[l]──」","「………咦？[l]\n──绒、[l]绒布？[l]\n这、[l]声音、[l]不对、[l]那、[l]──」"],["「ひぃっ？！」","「噫呀？！」"],["「……ベロアヲ[l]ナオシテ……[l]ナオシテイマスグ……」","「……正在[l]修复贝萝娅……[l]马上就修好……」"],["「い、[l]いや、[l]いやぁ、[l]ひっ」","「不、[l]不要、[l]不要啊、[l]咿」"],["「……ヤルンダ、[l]カノウナ[l]カギリ、[l]\nナント…[l]シテモ………[l]ヤッテモラウゾ……ッ」","「……雅伦达，[l]可能的[l]极限，[l]\n无论如何…[l]都要………[l]给我办到……」"],["「た、[l]たすけ、[l]\nと、[l]トモっ」","「救、[l]救救我、[l]\n朋、[l]朋酱」"]],"context":[["SC_M_068.ks/index/1/text"],["SC_M_068.ks/index/3/text"],["SC_M_068.ks/index/5/text"],["SC_M_068.ks/index/7/text"],["SC_M_068.ks/index/9/text","SC_M_068.ks/index/92/text"],["SC_M_068.ks/index/11/text"],["SC_M_068.ks/index/13/text"],["SC_M_068.ks/index/15/text"],["SC_M_068.ks/index/17/text"],["SC_M_068.ks/index/19/text"],["SC_M_068.ks/index/21/text"],["SC_M_068.ks/index/23/text"],["SC_M_068.ks/index/25/text"],["SC_M_068.ks/index/27/text"],["SC_M_068.ks/index/29/text"],["SC_M_068.ks/index/31/text"],["SC_M_068.ks/index/33/text"],["SC_M_068.ks/index/35/text"],["SC_M_068.ks/index/37/text"],["SC_M_068.ks/index/39/text"],["SC_M_068.ks/index/41/text"],["SC_M_068.ks/index/43/text"],["SC_M_068.ks/index/46/text"],["SC_M_068.ks/index/48/text"],["SC_M_068.ks/index/50/text"],["SC_M_068.ks/index/52/text"],["SC_M_068.ks/index/54/text"],["SC_M_068.ks/index/56/text"],["SC_M_068.ks/index/58/text"],["SC_M_068.ks/index/60/text"],["SC_M_068.ks/index/62/text"],["SC_M_068.ks/index/64/text"],["SC_M_068.ks/index/66/text"],["SC_M_068.ks/index/68/text"],["SC_M_068.ks/index/70/text"],["SC_M_068.ks/index/72/text"],["SC_M_068.ks/index/74/text"],["SC_M_068.ks/index/76/text"],["SC_M_068.ks/index/78/text"],["SC_M_068.ks/index/80/text"],["SC_M_068.ks/index/82/text"],["SC_M_068.ks/index/84/text"],["SC_M_068.ks/index/86/text"],["SC_M_068.ks/index/88/text"],["SC_M_068.ks/index/90/text"],["SC_M_068.ks/index/94/text"],["SC_M_068.ks/index/96/text"],["SC_M_068.ks/index/98/text"],["SC_M_068.ks/index/101/text"],["SC_M_068.ks/index/103/text"],["SC_M_068.ks/index/105/text"],["SC_M_068.ks/index/107/text"],["SC_M_068.ks/index/109/text"],["SC_M_068.ks/index/111/text"],["SC_M_068.ks/index/113/text"],["SC_M_068.ks/index/115/text"],["SC_M_068.ks/index/117/text"],["SC_M_068.ks/index/119/text"],["SC_M_068.ks/index/121/text"],["SC_M_068.ks/index/123/text"],["SC_M_068.ks/index/125/text"],["SC_M_068.ks/index/127/text"],["SC_M_068.ks/index/129/text"],["SC_M_068.ks/index/131/text"],["SC_M_068.ks/index/133/text"],["SC_M_068.ks/index/135/text"],["SC_M_068.ks/index/137/text"],["SC_M_068.ks/index/139/text"],["SC_M_068.ks/index/141/text"],["SC_M_068.ks/index/143/text"],["SC_M_068.ks/index/145/text"],["SC_M_068.ks/index/147/text"],["SC_M_068.ks/index/149/text"],["SC_M_068.ks/index/151/text"],["SC_M_068.ks/index/153/text"],["SC_M_068.ks/index/155/text"],["SC_M_068.ks/index/157/text"],["SC_M_068.ks/index/159/text"],["SC_M_068.ks/index/161/text"],["SC_M_068.ks/index/163/text"],["SC_M_068.ks/index/165/text"],["SC_M_068.ks/index/167/text"],["SC_M_068.ks/index/169/text"],["SC_M_068.ks/index/171/text"],["SC_M_068.ks/index/173/text"],["SC_M_068.ks/index/175/text"]],"tags":[],"parameters":[[{"start":232,"end":385}],[{"start":412,"end":459}],[{"start":487,"end":611}],[{"start":638,"end":722}],[{"start":751,"end":755},{"start":3824,"end":3828}],[{"start":783,"end":892}],[{"start":919,"end":1020}],[{"start":1050,"end":1161}],[{"start":1189,"end":1239}],[{"start":1269,"end":1329}],[{"start":1356,"end":1407}],[{"start":1437,"end":1457}],[{"start":1484,"end":1615}],[{"start":1645,"end":1658}],[{"start":1685,"end":1800}],[{"start":1828,"end":1905}],[{"start":1932,"end":1984}],[{"start":2012,"end":2041}],[{"start":2071,"end":2107}],[{"start":2134,"end":2186}],[{"start":2214,"end":2283}],[{"start":2310,"end":2332}],[{"start":2345,"end":2368}],[{"start":2378,"end":2390}],[{"start":2401,"end":2426}],[{"start":2454,"end":2502}],[{"start":2530,"end":2579}],[{"start":2609,"end":2645}],[{"start":2673,"end":2680}],[{"start":2707,"end":2741}],[{"start":2800,"end":2856}],[{"start":2883,"end":2944}],[{"start":2972,"end":3003}],[{"start":3073,"end":3115}],[{"start":3143,"end":3166}],[{"start":3193,"end":3221}],[{"start":3249,"end":3304}],[{"start":3332,"end":3369}],[{"start":3425,"end":3430}],[{"start":3473,"end":3477}],[{"start":3535,"end":3548}],[{"start":3575,"end":3617}],[{"start":3645,"end":3664}],[{"start":3692,"end":3707}],[{"start":3734,"end":3796}],[{"start":3878,"end":4032}],[{"start":4060,"end":4089}],[{"start":4116,"end":4188}],[{"start":4201,"end":4202}],[{"start":4211,"end":4234}],[{"start":4285,"end":4320}],[{"start":4385,"end":4411}],[{"start":4454,"end":4482}],[{"start":4544,"end":4568}],[{"start":4596,"end":4606}],[{"start":4642,"end":4648}],[{"start":4741,"end":4748}],[{"start":4776,"end":4788}],[{"start":4816,"end":4910}],[{"start":4938,"end":4952}],[{"start":4980,"end":5017}],[{"start":5045,"end":5055}],[{"start":5083,"end":5114}],[{"start":5142,"end":5164}],[{"start":5249,"end":5253}],[{"start":5324,"end":5354}],[{"start":5435,"end":5450}],[{"start":5493,"end":5500}],[{"start":5562,"end":5591}],[{"start":5736,"end":5767}],[{"start":5803,"end":5807}],[{"start":5854,"end":5872}],[{"start":5908,"end":5912}],[{"start":5958,"end":5966}],[{"start":5996,"end":6011}],[{"start":6042,"end":6127}],[{"start":6157,"end":6173}],[{"start":6204,"end":6219}],[{"start":6249,"end":6258}],[{"start":6289,"end":6303}],[{"start":6333,"end":6391}],[{"start":6453,"end":6460}],[{"start":6510,"end":6540}],[{"start":6570,"end":6592}],[{"start":6648,"end":6705}],[{"start":6735,"end":6762}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_068.ks","basename":"SC_M_068.ks","indexIds":{"「な、[l]なんやねん、[l]\nさっきの、[l]\nヒトなんか？[l]\nむ、[l]むちゃくちゃやばい感じやって、[l]\n今もめっさざわざわする、[l]首筋緊張しとる、\n痛いくらいや、[l]\nあ、[l]あかん、脚ふ、[l]震えて、[l]心臓もバクバクいっとるし」":0,"「落ち着いて、\n深呼吸しいな。[l]\n姫様ちゃん達がなんとかしてくれますよぅ」":1,"「あんなん、[l]\nだってこっちでうちらの身内を、\nこ、[l]こ、[l]ころしたやつちゃうの？！[l]\nあんな、[l]\nあんなん、\nいやや、[l]うち、[l]もう、[l]\nいややぁってぇーーー！！！」":2,"「大丈夫よぅ、\nええ子やから大人しくしぃ？[l]\nほら、冬夏ちゃんみたいにどっしり構えぇな。[l]\nええ女はこういう時でも狼狽えんもんですよぅ」":3,"「……」":4,"「そ、[l]そんなこというたってな、\nうちこんなんきいてへんし、[l]\nう、[l]うちらころされるんか？[l]\nし、[l]しぬんはいやや、うちそんなんいやや、\nこわい、[l]こわいよぅ」":5,"「ええ加減にしなさい。[l]\nあんたがそんなに怯えてもうたら、\nこちらも不安がられてまうでしょ。[l]\n今はすっかり価無ちゃんとおんなじ、\n身体の方は御子様なんですから」":6,"「……気遣い無用です。[l]\nその娘は真に子供、致し方ないでしょう。[l]\n兎に角今は、\nあの二人に任せるしかありませんね。[l]\nベロアを迎撃に出すには、\nあまりにもこの子は──」":7,"「……ごめんなさい、[l]\nベロアがこんなじゃなきゃ、\nあんなモノ、どうとでも……」":8,"「あなたは悪くないわ。[l]\nそれより今はトウカを、\n護らねばなりません。[l]\n何としてでも」":9,"「ほんなら、\n取り敢えず社に避難しましょか？[l]\n地下通路のが近いですかいねぃ……」":10,"「何処へでも、\nより安全な方へ」":11,"「じゃあ地下の方ですかなあ……[l]\n社いうても古い木造ですしねぃ、\n堅固な訳でもなんでもあらしませんわ。[l]\nじゃあ、冬夏ちゃんお任せしてもよろしでしょか？[l]\nお二人にはそこに、\n事態が落ち着くまで隠れてもろうて」":12,"「貴女方はどうするのです」":13,"「今更いうまでもありません、\nお二人を護るんが、\n我々の存在意義でしょぅ？[l]\nうちと価無ちゃんなら、\n多少はあん二人の力添えになれます、\nうちらも、\nあれに対処してきますよって」":14,"「へっ？！[l]\nた、[l]たいしょってなに？[l]\nう、[l]うちはあかんよ、\n絶対無理やって、\nいやや、[l]うちも」":15,"「あんねえ、\nクイもほんまやったら対外敵要員なんよ。[l]\n遣り方も知ってるでしょうに」":16,"「ほ、ほんなんいうたかて、\nう、うぇ、ひっ、くっ」":17,"「あまり無理をさせずとも構いませんよ。[l]\nその子も共に──」":18,"「……さよぅですか。[l]\nしかたないですなぁ。[l]\nほな急いでこの子ぉも連れて──」":19,"「あ、[l]あかん。[l]\nた、[l]立てへんねん、\n歩かれへんて、[l]も、[l]もう、[l]\n動きたない……」":20,"「我が儘言うてる場合やないですがな。[l]\n":21,"負ぶっていこにも、\nうちらみんなこんな":22,"態やし、\nまさに":23,"猫の手じゃ、\nとてもとても借りられんわね」":24,"「そ、[l]そやベロア、一緒におって、\nうち、[l]あかんて、\nお、おねがいや」":25,"「え？！[l]\nだ、だめだよカナ、\nベロアは今こそ、マスターと一緒にいなきゃ……」":26,"「私の事なら心配要りません。[l]\n此処でその娘、守っておあげ」":27,"「で、でもっ」":28,"「さ、いつさっきのんが来るか判りませんよって、\n急ぎましょ」":29,"「その子が落ち着いたら、\n一緒に私の所までいらっしゃい。[l]\n必ず無事に私の許に還るのですよ」":30,"「お二人を届けたらうちもすぐ、\n戻って来ますからねぃ。[l]\nあんさんがたも大人しく、隠れてるんですよぅ」":31,"「マスターミリアム、\nどうか、どうかお気をつけて──」":32,"「……いやや、こんなんはいやや、[l]\nか、[l]帰りたい、\nもう」":33,"「痛い、痛いよカナ、\n力抜いて……ん」":34,"「お待たせしましたぁ、\n……無事なようですな？」":35,"「さっきのは今のところ視てない。[l]\nそれよりカナが全然、\n痛てて、\n何とかしろっ」":36,"「あああ、[l]は、[l]はよう、\nなんとかしてぇ、[l]もう、」":37,"ばちぃん。":38,"「！？」":39,"「……ひっ、[l]ぐ……」":40,"「ええ加減だまらっしゃい、[l]\nいっつまでもうだうだうだうだみっともない」":41,"「……センリ……[l]なんてことを、」":42,"「ぐっ……[l]ひぐぅっ……」":43,"「そうそう、良い子ですやんか、価無ちゃんは。[l]\nやればちゃぁんと出来ますもんねぇ？[l]\nそれにしても」":44,"「ええ具合によう事が起きてくれはりましたわぁ……[l]\n正直もっと、[l]\nずっと手こずるかと思ってましてん。[l]\nかなりの面倒も、覚悟しとったんですよぅ。[l]\nそしたら巧い具合に、ねえ？[l]\n価無ちゃんだけでなく、冬夏ちゃんの方も、\nこれはまさに──」":45,"「？[l]\n何だと？[l]\n何て言った？」":46,"「いぃえぇ。[l]\nそれより──こういう時こそ、\nぶぶづけ……[l]いえ、[l]\nかゆ、[l]くいたいですねぃ、[l]\n":47,"価":48,"有。[l]\nちがいますか価無ちゃん？」":49,"「……か、[l]かか、[l]\nかゆ、[l]くう[l]ん……？」":50,"身と魂盗り合い武者、[l]鎖腐りて茅ノ輪が忌の空──":51,"「？[l]\nカナ？[l]\nいきなり何を」":52,"「な、[l]何故今クイを出すんだよ、[l]カナ」":53,"「おなか、へったわ」":54,"ばぐん！！！":55,"「……！！！」":56,"「にげたらあかんて……」":57,"「あいつ、\nやっぱり、\nくそっ、何処に行った！！[l]\n前から仕込んでたのか！[l]\nカナに不正操作を仕込んだんだな！！！[l]\n何処だッあの女、」":58,"「おなか、[l]すいたんよ」":59,"「くっ！！[l]\nカナ！！！[l]\nやめろっ、やめてよッ」":60,"「おいしそうや……」":61,"「……ちくしょう、[l]\nマスター、\n……っ」":62,"「くわしてぇなぁ……[l]痛くせんから……」":63,"ぼぎっ。":64,"「……ゴメン、[l]カナ、[l]ナルベククルシマヌヨウニ、」":65,"ぎゅるるるぐるぐるぐるごどぼ。":66,"「……がほっ」":67,"「ダ……[l]ガ………[l]ッ……[l]\nゲ……」":68,"「トモったら、何してるのよ、\n大丈夫なの？みんな……」":69,"がさり。":70,"「！！[l]\n……？？！！」":71,"じゃり。":72,"「……オァァン」":73,"「…………っ！、…………ッ？」":74,"「………ゼェ[l]ェ[l]ェ[l]ェ[l]ェ[l]ェ[l]…[l]…[l]…[l]\nバァ[l]ァ[l]ァ[l]ァ[l]ァ[l]ァ[l]ァ[l]…[l]…[l]…」":75,"「……………、[l]……………」":76,"「……コニ[l]イルナ……？」":77,"「…………ッ！、」":78,"「……ベロア[l]ダヨ……」":79,"「………っ？[l]\n──べ、[l]ベロア？[l]\nこ、[l]声が、[l]いえ、[l]そ、[l]──」":80,"「ひぃっ？！」":81,"「……ベロアヲ[l]ナオシテ……[l]ナオシテイマスグ……」":82,"「い、[l]いや、[l]いやぁ、[l]ひっ」":83,"「……ヤルンダ、[l]カノウナ[l]カギリ、[l]\nナント…[l]シテモ………[l]ヤッテモラウゾ……ッ」":84,"「た、[l]たすけ、[l]\nと、[l]トモっ」":85},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_068.ks","relPath":"/data/scenario/SC_M_068.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":81,"length":86,"percent":94.18604651162791},"cellInfo":[]},"/data/scenario/SC_M_069.ks":{"data":[["「……おいで、トウカ」","「……过来吧，冬夏」"],["「……」",""],["「貴女は何があっても、[l]\nこの私が守るわ、[l]何に変えても」","「无论发生什么、[l]\n我都会守护你、[l]不惜一切代价」"],["「それにしても……本当に貴女は、[l]\n","「话说回来……你真的、[l]\n"],["ドレ","多"],["ミリ","米"],["アに瓜二つ──[l]\nこれも何かの意思……[l]\nかも知れないわね……」","和姐姐一模一样──[l]\n这也是某种意志……[l]\n说不定呢……」"],["「……おねえさま」","「……姐姐大人」"],["「どうしたの？」","「出什么事了？」"],["「……わたしになにをのぞんでいるの？」","「……你对我有什么期望？」"],["「………。[l]\n私がしたいのは、[l]\nあれらへの復讐よ。[l]\nそして、[l]\nあのひとの作り上げた私達の居場所を、[l]\nセカイに再び取り戻すこと。[l]\nあのひとの遺した貴女が私と共に居てこそ、[l]\nそれは成される意義がある」","「………。[l]\n我想做的，[l]\n是向那些家伙复仇。[l]\n然后，[l]\n要把那个人为我们打造的容身之处，[l]\n从这个世界重新夺回来。[l]\n唯有那个人的遗物——你与我同在，[l]\n这件事才有意义」"],["「……だから、オトコがにくいの？」","「……所以，你才讨厌男人？」"],["「？[l]\n──そうよ。[l]\nあの男の●が全てを狂わせたのよ、\nあの兄妹は絶対に、[l]\n……絶対に、[l]\n赦すものかっ」","「？[l]\n──没错。[l]\n那个男人的●毁了一切，\n那对兄妹绝对、[l]\n……绝对、[l]\n不可饶恕」"],["「……だから、オンナじゃなきゃだめなの？」","「……所以，必须是女人才行？」"],["「そうよ！[l]\n男は胤さえ貰えば後は用無し。[l]\nそれに貴女が居る今となっては……[l]\n私達の間には──[l]既に不要なモノね。[l]\nイヤらしい、[l]穢れた存在、[l]\n『Ｙの欲動』に振り回されて、[l]\n冷静な判断も合理的な思索も出来ない、[l]\n自尊心や栄達、[l]自己顕示、[l]\n真の優先順位を狂わす感情で充ち満ちている、[l]\n出来損ないで危うい、[l]\n争いの種をまき散らすだけの、[l]\nあんなもの、[l]\n声を聞くのも、\n顔を視るのも御免だわ！」","「当然！[l]\n男人不过是借种工具。[l]\n况且现在有了你……[l]\n我们之间──[l]已经不需要那种东西了。[l]\n下流的、[l]污秽的存在，[l]\n被『Y的欲望』操控着，[l]\n既无法冷静判断也不能理性思考，[l]\n充斥着自尊心与功名欲、[l]自我炫耀、[l]\n被扭曲的优先级感情，[l]\n残缺而危险的，[l]\n只会散布争斗火种的，[l]\n那种东西，[l]\n连声音都不想听，\n连脸都不想见！」"],["「……だから、[l]\nわたしたちに●●させてきたの？」","「……所以、[l]\n才让我们●●的吗？」"],["「そうよ、貴女を、貴女の血を守る為よ。[l]\n私達がこんなことになったのは何もかも、\nあの男、[l]カルロサの所為よ、\nあの方と同じリデルの血統でありながら、\nああ思い出すだに腹立たしや、[l]\nあの、[l]あんな男に！[l]\n彼奴さえ居なければ！！」","「没错，为了保护你，保护你的血脉。[l]\n我们会变成这样全都是、\n那个男人、[l]卡尔罗萨的错，\n明明和那位大人流着相同的利德尔之血，\n啊啊光是回想就怒火中烧，[l]\n那个、[l]那种男人！[l]\n要是没有他就好了！！」"],["「……ふふふ。[l]\nでも、[l]貴女が居ればもう、[l]いいの。[l]\n永かったけれど、[l]\n漸く時が満ちた。[l]\nある人物が助勢してくれたの、\n再興の準備は出来ているわ、[l]\n昔の同胞も、新たな仲間も居るのよ、\nあとはもう、[l]\n今の外の騒乱が収まりさえすれば──」","「……呵呵呵。[l]\n不过、[l]有你在就、[l]够了。[l]\n虽然漫长，[l]\n但时机终于成熟了。[l]\n有位人物相助，\n复兴的准备已完成，[l]\n昔日的同胞和新的同伴都在，\n接下来只要、[l]\n等外界骚乱平息──」"],["「……そのための、[l]\n……ああ、[l]\n貴女は私の、だい──」","「……为此才、[l]\n……啊啊、[l]\n你就是我的、宝──」"],["「？[l]\nなんですって？」","「？[l]\n你说什么？」"],["どす。","咚。"],["「……？[l]\nな──[l]に？」","「……？[l]\n什──[l]么？」"],["「……ふようなもの？[l]いらぬもの？」","「……无用的东西？[l]多余的东西？」"],["「……なに、[l]をしたの……？[l]\nい、[l]いた──」","「……你做了、[l]什么……？[l]\n好、[l]痛──」"],["「……それはあなたもおなじでしょ」","「……你不也一样吗」"],["「……そ、れは、どこ……に、隠し持って……[l]\nそんな、」","「……那、个、藏在……哪、里了……[l]\n怎么会、」"],["「……",""],["睡","眠"],["臥ノ","卧之"],["神はjoinをツき刺しタてるもの」","神是用来join刺穿的东西」"],["「ぐっ……[l]\nそ……[l]う……、[l]\nirregularな[l]……prot－[l]ein……[l]？……っ、」","「咕……[l]\n原……[l]来……、[l]\nirregular的[l]……prot－[l]ein……[l]？……呃、」"],["「……邪なる魔者は……[l]現世にタチいる事なかれ……」","「……邪恶魔物……[l]不得存于现世……」"],["「……っ、[l]成る程……[l]そういう……[l]事……[l]\nセ、センリの、[l]……仕業……[l]ね？[l]\n貴女は……[l]何も……っ、」","「……呃、[l]原来如此……[l]这么……[l]回事……[l]\n选、选律的、[l]……搞的鬼……[l]对吧？[l]\n你……[l]什么……都没、」"],["「……我執に囚われた……[l]","「……被执念囚禁的……[l]"],["澱……[l]\n貴女のアイが全てを狂わせている……[l]\n……ふるきものはきえて、[l]なくなれ、[l]\nあたらしきもののいしずえとなれ」","沉淀……[l]\n你的爱把一切都搅乱了……[l]\n……旧物当消逝、[l]不复存在、[l]\n化为新事物的基石吧」"],["「……く、[l]\nわたしとした……ことが……[l]\nなんたる醜態……、[l]\nベロ…[l]ア……っ」","「……咳、[l]\n我居然……落到这般……[l]\n何等丑态……、[l]\n贝罗…[l]啊……呃」"],["「……～～♪、[l]\n……～～♪、[l]\n……ミズハグム……♪[l]\n……ミ……ノメ…♪」","「……～～♪、[l]\n……～～♪、[l]\n……水叶咕姆……♪[l]\n……御……之女…♪」"],["「……おや」","「……哎呀」"],["「……ドウトモ……？[l]\nオマエモウラギリモノカ？」","「……斗乙女……？[l]\n你小子也是被诅咒的家伙吗？」"],["「？[l]\n何の事だね。[l]\nナナから聞いてないのか、僕は──」","「？[l]\n说什么呢。[l]\n名无没告诉你吗，我可是──」"],["「……シッテイル、[l]\nデハヤハリ……センリガヒトリデシタノダナ、[l]\nカナマデマキコンデ──」","「……早就知道、[l]\n果然……选律是独自行动的吧、[l]\n连价无都被卷进来──」"],["「センリ？[l]\nあの婆様が何か","「选律？[l]\n那老太婆干了"],["為","装"],["出かしたのか？[l]\nまあ、全動してるキミを視れば、\nある程度の推測は立つが、\nそれに価無君までとはどういう──」","什么好事？[l]\n嘛，看到全力暴走的你、\n大致也能猜到几分、\n但连价无君都牵扯进来是怎么回事──」"],["「オマエ、ホンキデキイテルンダロウナ？[l]\n……ナナノコトガナケレバ、[l]\nオマエモシンヨウニタルニンゲンデハナイガ──\n……まあいい、[l]\nドウトモには色々借りがあるからナ。[l]\nカナを止めるのに全動してしまって一気に崩壊が……」","「你、是认真的对吧？[l]\n……要不是因为七那件事，[l]\n你小子也算不上值得信任的人类啊──\n……算了，[l]\n毕竟我欠斗乙女不少人情。[l]\n为了阻止加奈动用全部力量导致瞬间崩溃……」"],["「詳しい説明を訊きたい所だが、\n取り敢えずこれを渡しておこうか、\nこれがオオクロだ。[l]\nまずは痛々しいキミの……ん？」","「虽然想听详细说明、\n总之先把这个交给你吧、\n这是大黑。[l]\n先治治你惨不忍睹的……嗯？」"],["「……？[l]\nどうしタ」","「……？[l]\n怎么了」"],["「……キミが言う程には、崩壊も多くなく視えるが──」","「……看起来崩溃程度没你说的那么严重──」"],["「……ヒミコに施術を頼んだからナ。[l]\n可能な限りで処置を頼んダ」","「……拜托卑尊做了应急处理。[l]\n让她尽可能做了急救」"],["「……なんだって？」","「……你说什么？」"],["「残るチカラ全てを出させタ」","「让她用尽了剩余全部力量」"],["「……っ、[l]\n馬鹿な、そんな事をしたら、\nあの子は既に限界を超えてたんだぞ、」","「……呃、[l]\n混蛋、那么做的话、\n那孩子早就超过极限了啊、」"],["「……アレには悪い事をしたガ、[l]\nそれこそ限界はこちらも同じダ。[l]\nマスターを護る為だ、仕方なかっタ」","「……对不住那家伙、[l]\n但我们这边也到极限了。[l]\n为了守护主人、不得已而为之」"],["「……死んだのか」","「……死了吗」"],["「もう少し、\nドウトモと会うのが早ければ良かったかも知れないが、\n遅かったナ。[l]\n","「要是能再早点、\n和斗乙女见面或许会更好，\n可惜太迟了。[l]\n"],["こ","这"],["れはありがたく貰っておくガ」","份心意我就心怀感激收下了」"],["「……ミコはどうした？[l]\nそのまま置いてきたのか」","「……卑尊怎么样了？[l]\n就这样丢在那里了吗」"],["「喰うわけにも行かないからナ、\n紙だけはベロアが回収したゾ」","「毕竟也没法吃掉，\n只有纸条被贝萝娅回收了」"],["「……価無君は」","「……价无君呢」"],["「ああ、そしてクイもナ。[l]\nカナは気絶してるだけダ。[l]\nああ、その場に置いてきてはしまったガ……[l]\nドウトモはどうする気ダ」","「啊对了，还有奎也是。[l]\n加奈只是昏过去而已。[l]\n啊、虽然把她丢在原地了……[l]\n斗乙女你打算怎么办」"],["「……[l]僕はこのまま顛末を視届けるよ。[l]\nまだすることもあるしね。[l]\n価無君も介抱しなければならないだろうし」","「……[l]我会亲眼见证结局。[l]\n还有事情要做呢。[l]\n也必须照顾价无君吧」"],["「ベロアは残りをこれから回収に行ク、\nドウトモ、キサムラは預けておこう、\nが、勘違いするなヨ。[l]\nそれがマスターの意思でもあるからダ。[l]\nあの馬鹿女のように、\n裏切ろうなどとは決して思わぬ事ダ。[l]\nオマエまで無くすのはベロアにとっても、\n都合が悪イ。[l]\nただ、それだけのこト。[l]\n努々忘れるナ──」","「贝萝娅这就去回收剩下的部分，\n总之，奇萨姆拉就暂时寄放在这里，\n但是，可别搞错了。[l]\n这也是主人的意思。[l]\n可别像那个蠢女人一样，\n动什么背叛的念头。[l]\n连你都失去的话，对贝萝娅来说，\n也很困扰。[l]\n仅此而已。[l]\n千万别忘了──」"],["「……わかっているさ」","「……我明白的」"],["「じゃあ、カナの事は頼んだゾ。[l]\nあの子も……大事な同胞だからナ。[l]\nベロアはこれからマスターの所へ向かウ、\nそしてセンリには、\n……きついお仕置きダ」","「那就拜托你照顾卡娜了。[l]\n那孩子也是……重要的同胞啊。[l]\n贝萝娅现在要去主人那里，\n至于选律，\n……可得好好惩罚一番」"],["「……精精気をつけ給え。[l]\n後でまた会おう。[l]\nミリアムに宜しくな」","「……务必小心。[l]\n回头见。[l]\n代我向米莉安姆问好」"],["「……如何に覚悟を決めていようと……[l]\n自分以外に累が及んだ時は、[l]\nどうしようも、[l]ないな──[l]\nいつだって……[l]他人の痛みの方が、[l]\n痛いな、[l]ミコ？[l]\n","「……不管下了多大的决心……[l]\n当连累到他人的时候，[l]\n就真的，[l]没办法了──[l]\n无论何时……[l]别人的痛苦，[l]\n反而更痛呢，[l]卑尊？[l]\n"],["苦しいな。[l]\n………。[l]\n………。[l]\n","真难受啊。[l]\n………。[l]\n………。[l]\n"],["独","独"],["りで","里」"],["遊","妓"],["ん","嗯"],["でるつもりでも、\nセカイはゲーム程甘くはないな。[l]\nいつの間にか、[l]\n否、[l]どうあっても他人をかかずらわせずには済まないのが、[l]\nこのセカイだったな。[l]\n識っていたつもりだったが──」","就算打算出去、\n世界可没游戏那么天真啊。[l]\n不知不觉间、[l]\n不、[l]无论如何都免不了把他人卷进来的、[l]\n就是这个世界啊。[l]\n本以为早就明白了──」"],["それでも、[l]\n　僕は進むよ。[l]\n　今更キミに対しての、[l]\n　どんな詫びにも意味はない、[l]\n　だから、[l]\n　存分に恨んでくれ、[l]蔑んでくれ、[l]\n　それでも進む、[l]揺るがぬこの僕の意思、[l]\n　悪いが、[l]そこは曲がることはないよ。[l]\n　それが僕だからな。[l]\n　昔から、[l]そしてこれからも。[l]\n　背負う覚悟で来たんだからな。[l]\n　業だろうと咎だろうと。","即便如此，[l]\n　我也要继续前进。[l]\n　事到如今对你，[l]\n　任何道歉都已没有意义，[l]\n　所以，[l]\n　尽管尽情地恨我吧、[l]蔑视我吧，[l]\n　我仍会前进、[l]这坚定不移的意志，[l]\n　抱歉、[l]这点绝不会让步。[l]\n　因为这就是我。[l]\n　从过去、[l]到未来都是。[l]\n　本就是带着觉悟来的。[l]\n　无论是罪业还是过错。"],["「──じゃあ、[l]\nさよならだ、[l]ミコ」","「──那么，[l]\n永别了、[l]卑尊」"],["「マスターーーーーーッ！！！」","「主人——————！！！」"],["「……！[l]\nこの子を傷付けてはなりません……ッ！！！」","「……！[l]\n不许伤害这孩子……！！！」"],["「………」",""],["「……？[l]\n何があったの？[l]\nまさか、トウカまでセンリに」","「……？[l]\n发生什么了？[l]\n难道连冬香都被选律」"],["「今はもう、大丈夫よ……[l]\n気を失ってるだけ……[l]\nあなたも、その様子では、何か──[l]あったのね？」","「现在已经不要紧了……[l]\n只是昏过去了……[l]\n看你这副模样，莫非也──[l]遭遇了什么？」"],["「……カナがセンリに不正操作されてた、[l]\n……やっぱりトウカもなんだね？[l]\n……？！[l]\nマスター、血がっ」","「……卡娜被选律不正操作了，[l]\n……果然冬香也是吗？[l]\n……？！[l]\n主人，你在流血」"],["「このくらい……大した事はないわ……[l]\nあなたこそ大丈夫なの？[l]\nそんな姿で……」","「这种程度……不算什么……[l]\n你才真的不要紧吗？[l]\n这副模样……」"],["「ベロアは大丈夫、カミも回収して、きたし、\n少しなら、……っ、[l]マスターの怪我も」","「贝萝娅没事，神器也回收了，\n这点小伤……[l]主人的伤势也」"],["「無理しないで、\n血止め程度で構わない……[l]\nそれより、\nトウカ……」","「别勉强，\n简单止血就好……[l]\n更重要的是，\n冬香……」"],["「恐らく、本来の自我が抵抗したのね、[l]\nタマズサの不正操作をはね除けるなんて、\nその御陰で、[l]\n私も１度刺されただけで済んだけれど、[l]\nこの子が──[l]\n……まさか、近くに──[l]げほっ、[l]げほっ」","「恐怕是原本的自我在抵抗吧，[l]\n竟能摆脱塔玛祖莎的不正操作，\n托她的福，[l]\n我只被刺中一次就脱险了，[l]\n但这孩子──[l]\n……难道附近有──[l]咳咳、[l]咳咳」"],["「マスター、しっかり、\nクソッ、\n今処置を」","「主人，振作点，\n可恶，\n立刻处理伤口」"],["「……私とこの子は、[l]\nナナの所へ向かうわ……[l]\n此処へ来てる筈の、新たな同胞、\n私達もすぐには動けないけど──\n落ち着いたらね……あなたも一緒に、」","「……我和这孩子，[l]\n会先去名无那里……[l]\n本该抵达的新同胞们，\n虽然我们现在行动不便──\n等稳定下来后……你也一起来吧」"],["「……ベロアは、[l]\nセンリを探すよ、あいつだけは今、絶対に」","「……贝萝娅，[l]\n要去找选律，唯独那家伙现在必须解决」"],["「……ベロア」","「……贝萝娅」"],["「こんな事になった以上、\nもう祭儀は関係ないよ。[l]\nマスターは元に戻ったんだから、\n取り敢えず最低限の目的は……達したでしょ」","「既然事已至此，\n祭仪什么的都无所谓了。[l]\n主人既然已经恢复原状，\n至少最低限度的目的……已经达成了吧」"],["「でも、ベロア、」","「但是，贝萝娅，」"],["「センリ、あの女だけは、\nここで片を付けねば禍根を遺すことになる、\n悪いメは今、早い内に何としても摘んでおかなきゃ……[l]\nそれがどんなに大事かってことは、\nマスターもよく知ってる筈だよ」","「选律，只有那个女人，\n若不在此了断就会留下祸根，\n恶之芽必须趁早摘除……[l]\n这件事有多重要，\n主人你应该最清楚才对」"],["「だからベロアはカミを出来る限り回収して、\nあいつを処理して、\nそれから、\nナナやドウトモ達と合流を」","「所以贝萝娅要尽可能回收神纸、\n把那家伙处理掉、\n然后、\n和名无还有道吾他们汇合」"],["「……その状態では、[l]\n居るかも知れない白の連中とはまともに渡り合えないわ。[l]\n……出来るだけ、静かに事を成すのよ」","「……以那种状态、[l]\n可能存在的白之众根本没法正面抗衡。[l]\n……尽量安静地完成任务吧」"],["「ありがとうマスター。[l]\n………、[l]\nマスター、\nいざとなったらトウカは放っておいてでも、[l]\nマスターだけでも──」","「谢谢主人。[l]\n………、[l]\n主人、\n万一情况紧急就算抛下桃花、[l]\n至少您一定要──」"],["「駄目よ、この子は──」","「不行哦，这孩子──」"],["「その子はドレミリアじゃない、\n分かってるでしょう、[l]\nお願いだから、[l]\n大事なものを履き違えないで、[l]\n優先順位を正しく視定めて。[l]\n約束してよ、マスター、[l]\n貴女だけは、[l]\nなんとしてでも生き残ると」","「那孩子不是德蕾米莉娅、\n你明明知道的、[l]\n求你了、[l]\n别把重要的事情搞混、[l]\n正确认清优先顺序。[l]\n答应我好吗，主人、[l]\n只有您、[l]\n无论如何都要活下去」"],["「…………」",""],["「……………………。[l]\nわかったわ。[l]\n何としても生き残る、\nその点に関しては約束しましょう。[l]\nその代わり、」","「……………………。[l]\n知道了。[l]\n无论如何都会活下去、\n这点我可以保证。[l]\n作为交换、」"],["「……？」",""],["「あなたも必ず戻ってくるのよ、\n私のもとに」","「你也一定要回来、\n回到我身边」"],["「……勿論さ、[l]\nマスターミリアム」","「……当然、[l]\n主人米莉安姆」"],["「……ベロア、[l]ごめんなさいね」","「……贝萝娅、[l]对不起呢」"],["「……もう、済んだ頃ですかね？[l]\n物騒なんがいるよって、\nあんまりぼやぼやもしてられませんのに、」","「……差不多该结束了吧？[l]\n都说有危险分子在、\n可没工夫慢悠悠耗着呢，」"],["ばぐ。","吧唧。"],["もぐもぐもぐもぐもぐもぐもぐもぐもぐもぐ。","吧唧吧唧吧唧吧唧吧唧吧唧吧唧吧唧吧唧。"],["「……不味イ」","「……难吃」"],["べっ。","呸。"],["「………がぼっ」","「………咕噗」"],["「……冷静になって……[l]考えてみたんだ……[l]センリ……」","「……冷静下来……[l]仔细想想……[l]选律……」"],["「げばっ、[l]………どふっ」","「呕噗、[l]………噗呃」"],["「……思えば……[l]カミを奪った上で……[l]\n生かしておくのが……[l]オマエにとっては……[l]\nこの上ない……[l]バツだ……[l]そうだナ？[l]\n簡単に……[l]終わりにするなど……[l]あまりにも……[l]\n●●●●ない……[l]話だっタ……」","「……回想起来……[l]夺走神纸之后……[l]\n让你活着……[l]对你来说……[l]\n才是……[l]最残酷的……[l]惩罚对吧？[l]\n轻易……[l]让你死掉……[l]未免太……[l]\n●●●●便宜……[l]你了……」"],["「………ごぶ」","「………咕嘟」"],["「残りの……[l]人生……[l]無力な凡俗として……[l]\nダラダラと、[l]生きながらえるがいイ……[l]\nそれとも……[l]その前に……[l]襲撃者……に……[l]\nみつかるか……[l]ナ？」","「剩下的……[l]人生……[l]作为无力的凡人……[l]\n苟延残喘地、[l]活着才对吧……[l]\n还是说……[l]在那之前……[l]就会被袭击者……[l]\n找到呢……[l]？」"],["「……もう気を失うとは……[l]あっけない……[l]\nわめき声……[l]くらいは……[l]聞いても……[l]良かったガ……[l]\n","「……居然直接昏过去……[l]真没劲……[l]\n至少……[l]让我听听……[l]惨叫声……[l]也好啊……[l]\n"],["そんなことよりモ……[l]あとは……[l]？」","比起那个……[l]接下来……[l]？」"],["………",""],["「……？[l]\nなんだ……？[l]\n……白の連中……？[l]\n居る……[l]のか……[l]彼奴等が……[l]此処に？[l]\nしかも……[l]これは……[l]み、[l]みる──」[l]\n[l]","「……？[l]\n什么……？[l]\n……白之众……？[l]\n在……[l]吗……[l]那些家伙……[l]在这里？[l]\n而且……[l]这是……[l]看、[l]看着──」[l]\n[l]"]],"context":[["SC_M_069.ks/index/1/text"],["SC_M_069.ks/index/3/text","SC_M_069.ks/index/7/text","SC_M_069.ks/index/195/text"],["SC_M_069.ks/index/5/text"],["SC_M_069.ks/index/9/text"],["SC_M_069.ks/index/12/text"],["SC_M_069.ks/index/14/text"],["SC_M_069.ks/index/16/text"],["SC_M_069.ks/index/18/text","SC_M_069.ks/index/38/text"],["SC_M_069.ks/index/20/text"],["SC_M_069.ks/index/22/text"],["SC_M_069.ks/index/24/text"],["SC_M_069.ks/index/26/text"],["SC_M_069.ks/index/28/text"],["SC_M_069.ks/index/30/text"],["SC_M_069.ks/index/32/text"],["SC_M_069.ks/index/34/text"],["SC_M_069.ks/index/36/text"],["SC_M_069.ks/index/40/text"],["SC_M_069.ks/index/42/text"],["SC_M_069.ks/index/44/text"],["SC_M_069.ks/index/46/text"],["SC_M_069.ks/index/48/text"],["SC_M_069.ks/index/50/text"],["SC_M_069.ks/index/52/text"],["SC_M_069.ks/index/54/text"],["SC_M_069.ks/index/56/text"],["SC_M_069.ks/index/58/text"],["SC_M_069.ks/index/60/text"],["SC_M_069.ks/index/62/text"],["SC_M_069.ks/index/64/text"],["SC_M_069.ks/index/66/text"],["SC_M_069.ks/index/68/text"],["SC_M_069.ks/index/70/text"],["SC_M_069.ks/index/72/text"],["SC_M_069.ks/index/74/text"],["SC_M_069.ks/index/76/text"],["SC_M_069.ks/index/78/text"],["SC_M_069.ks/index/80/text"],["SC_M_069.ks/index/82/text"],["SC_M_069.ks/index/84/text"],["SC_M_069.ks/index/86/text"],["SC_M_069.ks/index/88/text"],["SC_M_069.ks/index/90/text"],["SC_M_069.ks/index/92/text"],["SC_M_069.ks/index/94/text"],["SC_M_069.ks/index/96/text"],["SC_M_069.ks/index/98/text"],["SC_M_069.ks/index/100/text"],["SC_M_069.ks/index/102/text"],["SC_M_069.ks/index/104/text"],["SC_M_069.ks/index/106/text"],["SC_M_069.ks/index/108/text"],["SC_M_069.ks/index/110/text"],["SC_M_069.ks/index/112/text"],["SC_M_069.ks/index/114/text"],["SC_M_069.ks/index/117/text"],["SC_M_069.ks/index/119/text"],["SC_M_069.ks/index/121/text"],["SC_M_069.ks/index/123/text"],["SC_M_069.ks/index/125/text"],["SC_M_069.ks/index/127/text"],["SC_M_069.ks/index/129/text"],["SC_M_069.ks/index/131/text"],["SC_M_069.ks/index/133/text"],["SC_M_069.ks/index/135/text"],["SC_M_069.k