"start":23875,"end":23926}],[{"start":24000,"end":24112}],[{"start":24176,"end":24224}],[{"start":24262,"end":24269}],[{"start":24343,"end":24350}],[{"start":24388,"end":24401}],[{"start":24413,"end":24417}],[{"start":24429,"end":24439}],[{"start":24483,"end":24841}],[{"start":24849,"end":24852}],[{"start":24896,"end":24908}],[{"start":24914,"end":24970}],[{"start":25006,"end":25013},{"start":25021,"end":25028}],[{"start":25034,"end":25063}],[{"start":25071,"end":25083}],[{"start":25091,"end":25104}],[{"start":25142,"end":25152}],[{"start":25158,"end":25189}],[{"start":25225,"end":25273}],[{"start":25309,"end":25326}],[{"start":25332,"end":25344}],[{"start":25354,"end":25363}],[{"start":25373,"end":25384}],[{"start":25394,"end":25400},{"start":25549,"end":25555}],[{"start":25476,"end":25485}],[{"start":25567,"end":25571}],[{"start":25631,"end":25633}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_074.ks","basename":"SC_M_074.ks","indexIds":{"びょおおう………":0,"「……」":1,"ぞぞ。":2,"「……まちがいなく、これは──」":3,"ミ・オロキャラ":4,"タサナサコネ・ワ。[l]\n　　ミ・ナサコネカヤコノロキ":5,"ャタサツコネキャラタサ・ワ。":6,"「……っ、……」":7,"ミ・キャキャラキャ":8,"タサキャキャラ・ワ？[l]\n　　ミ・カヤツォロコネ":9,"タサナサメカヤ・ワ。":10,"「……この、感じ、忘れるものか、」":11,"「……あいつの声──」":12,"んむ？[l]\n　　おお、[l]すっかりあの頃の様に、[l]\n　　元通り可憐で高貴な風情じゃないか。[l]\n　　戻り":13,"序でに、[l]\n　　あの時の恥辱もはっきりと甦ったんじゃないか、[l]\n　　私のこの姿を視て──":14,"「……クララ……、[l]ミルハ……！」":15,"「声が出ない訳でも無いだろうに、[l]\n返事してくれてもいいだろ。[l]\nま、[l]そんな怖い顔されれば、[l]\n今の君がどんな心情かは聞くまでもなし、[l]\nあの時のように、[l]\nビビって即逃げする気は無さそうで安心だ──\nんむ？[l]\nケルベ＝ロア、[l]随分やつれたな？[l]\nそんな有様で、[l]\nどうこうできるとでも、」":16,"「……ひっ」":17,"「──思ってる？[l]\nＡＡが出来るのならば、\nそこの女より先にお前を修繕すべきだったろうに。[l]\n相変わらず優先順位の付け方がなってないな」":18,"「よりにもよって、」":19,"「っ！」":20,"「お前などに優先順位の事を責められたくはないですね、\nミルハ。[l]\n憐れな●●の分際で」":21,"「随分とこの國の言葉も巧くなったね、\n女王様。[l]\n八相程度の連中に":22,"縋った甲斐もあったじゃないか。[l]\nいやいや感服の至り、\n感嘆に値するよ。[l]\n拍手を贈らせて貰おう」":23,"ぱちぱちぱち。":24,"「……くだらない挑発、[l]\n有り触れたお定まりの文句ね。[l]\nお前こそ相変わらずの上辺":25,"繕い、\n真心を語る術持たぬ、[l]\n……本当に憐れな●●」":26,"「再度お定まりの文句で恐縮だが、\n褒め言葉として受け取らせて貰うよ。[l]\nともあれ、[l]\nその永き過程は、\nさぞや辛かったろうな、[l]だが」":27,"「ぐっ…………」":28,"ぞぞぞぞ。":29,"「ここで終わりだ。[l]\nどう強がったところで女王様、[l]\n貴女に抗う術は無いのが現実だ。[l]\nさて、ただの無力な少女は放っておいて──[l]\nケルベ＝ロア、\n":30,"その封紙、返して貰うよ。[l]\n私の大事な、」":31,"びょおおおおおおおううううううう………":32,"「……？！[l]\nんだあれァ」":33,"「──んむ、[l]\nそこにいるのは……[l]\nＧＷかな？」":34,"「あれが元締とかいう奴か？[l]\n":35,"ぼやけて……[l]よくわかンねェけど……」":36,"「……？[l]\nあいつ、":37,"余":38,"所":39,"視してるよ、\nマスター、\n今の内にに、[l]逃げ、隠れようっ」":40,"「やっぱり、[l]あいつには勝てないよっ、\nこ、[l]こわいよ、[l]こわいけど、[l]\nそれは冷静ってことなんだ、[l]\n確かに怒りで恐怖を忘れる事は出来るけど、\nそれは無謀と紙一重なんだ、[l]\n生き残る者は……[l]勝とうが負けようが、[l]\n争いをするよりも、\n争い自体を避けた者の子孫。[l]\n勝てないのなら負けなければ良い、\nつまり──[l]\n怖いと感じた時に逃亡を選択した──[l]生き延びた者の、\n末裔でもあるんだよっ、\nだから、恥じる必要もないし、[l]\nと、[l]とにかく生き残らなければ何の意味もないっ」":41,"「生き残る事だけが、ただ在る事だけが、[l]\n全てに優先するか否か、[l]\nそれをこの永い間私はずっと考えてきた、[l]\n今、[l]あの、[l]全ての元凶を眼前にして、[l]\n私はっ──[l]\n":42,"……くっ……[l]\nナナめ……何処で何をしてるのっ」":43,"「幾らアテがあるって言ったって、\nナナも白の連中の、[l]\n中枢中の中枢に居た人間だよっ？[l]\n本当に信用できるか知れた物じゃない、\nましてやこんな正念場に、\n全てを賭けるだけの価値があるとは思えないっ！[l]\n三十六計逃げるに如かずとも言うでしょう、\n死んだらシマイだっ！」":44,"「……るせないの、[l]赦せないのよ、[l]\nどうしても、[l]\nあの、[l]女っ──！！！！」":45,"「大丈夫だよマスター、\nベロア達はただ在るだけじゃない、[l]\n円環ではなく螺旋を描く。[l]\nぐるぐる自分の尻尾を追って回り続ける訳じゃない、\n自分の尻尾を咬んで永遠を表す訳でもない、[l]\n永遠回帰（ewige Wiederkunft）からの脱却それこそが、[l]\nベロア達を喚び降ろした始祖アリスの意思だ！[l]\nヒトにとってよきものとは不自然なものなんだよ、[l]\n努力なしには前に進むも、[l]\n否、[l]その場に留まる事さえ赦されないのがこのセカイ、[l]\nベロア達はその為の、[l]助けであり友だ！[l]\nベロアは、必ず、[l]\n必ず次のステージへと進む、マスターを助ける！！！！[l]\nそしてマスターにも新しき世界を、":46,"人":47,"生を、\n歩んで欲しいんだよ、[l]\nそのためにも今はっ」":48,"「──おなじ、ことを繰り返さないこと……？[l]\n":49,"わたしは、………、[l]\nわたしはただ──」":50,"「……なンかこっちの方視てねェかあいつ、[l]\nん、向こうに居ンのは先刻の──」":51,"「……んむー、[l]\n何の抵抗も出来そうにない彼奴等より、\nＧＷと遊んだ方が愉しそうかな……[l]\nあっちはチノ達に任せるか。[l]\nあの女達もまだ姿を現さないし、\n少し派手に暴れた方が、」":52,"びゅっ、":53,"「あれ？[l]\nげっ、眼が合──」":54,"ぴたり。":55,"「ぶっわ、がっ！！」":56,"「いいかも。[l]\n":57,"やあ、[l]\nご一緒しても宜しいですか？[l]\n──あれ、[l]\n……名前、何て言うのかな？」":58,"「おっ、おまえ、\nだっ、」":59,"「まあいいか名前は。[l]\nオンゲじゃあるまいし、\nこの場合名乗り合うのもヘンだよね。[l]\nマナーは大事だけど、\n":60,"礼":61,"儀":62,"作":63,"法は場を弁えないと、\nただ滑稽で意味不明な愚挙だもんねえ。[l]\nシキタリやマツリとは往々にして、[l]\n":64,"お馬鹿映像として扱われるきらいがあるでしょぉ？[l]\n取り扱う側の意図次第でさ？」":65,"「──っ？[l]\n～～っ？？！」":66,"「げに恐ろしきは他人の視線、第三者の眼。[l]\n当事者以外の冷静な視界、\n主観に逃げ込む事を赦さぬ客観視点が、\n固き意思を":67,"挫き":68,"穿つ":69,"鏨となる。[l]\n鏡を視詰めよ、おきよゲシュ":70,"タルト崩壊──[l]\nそれが魔眼の刺し手の原理の一部……[l]\nそういえば、[l]\n":71,"……もうっ、まだ来ないのかなっ？」":72,"「な、何言ってんだこいつあ……？」":73,"「早くしないとこのコが無駄に甚振られるのにっ。[l]\n……んむー、[l]\nミリアムベロアのセットよりはいいけど……[l]\nそれでも大したレベルじゃないなあ。[l]\n限解もされてない様だし……[l]\nこないだ喰った、\nフロシルクの縛鎖を使える程度ってとこか。[l]\nあ、[l]あーあー、[l]ごめごめ、[l]\n心配要らないよ？[l]\nこっちも攻撃方面の出力下げるし、[l]\n":74,"愉しく遊ぼうじゃないの。[l]\n":75,"本命が来るまでウォームアップ、\nあっとその前に」":76,"しゅうううううう………":77,"「…っ、やばいっ！！！」":78,"「っ？！」":79,"びゅ、":80,"どす。":81,"「ぎぁ！！！」":82,"「アンカーだけ打たして貰ったよ。[l]\n視失った挙げ句エリア移動されると、\n再発見が超面倒だからね。[l]\n逆に言えば、もう逃げても構わないんだけど。[l]\nまあ……節度を守ってくれさえすればだけど」":83,"「ぎっ、ぎぎぎぎぎ……」":84,"「わ、私のっ、[l]\n私の所為で、[l]\nご、[l]ごめんなさい、[l]\n":85,"あ、あの女……っ！！！！」":86,"「い、いいから、\nとにかくここからにげようっ、\nナナと合流すれば何とか抜く手立てもある筈、\nそうでしょ？」":87,"「ああ……ベロア……[l]\nごめんなさいごめんなさいごめんなさいごめんなさい……」":88,"「……マスターがちゃんとした判断が出来る人なら、[l]\nあのときだって──そして今のこの状況もなかったよね。[l]\nいひひ……[l]\nだから、いいんだ、\nでも、これからは、\n失敗をも糧に、前へ、上へ、進んで欲しい、\nお願い、マスター」":89,"「……わかったわ──[l]枷になる過去は……[l]\nどんなに暖かくても、[l]懐かしくても、[l]\n捨てがたくても、大切でも、[l]\n何よりも大事な筈の今を護れないのなら、──」":90,"「んむ、やっぱアンカー外しも出来ない有様か。[l]\n取り敢えずはおｋだな。[l]\nどっちにしてもフハイ全動してるからには、\nどうなったって、\n面倒なだけで逃げ場自体は無いに等しいし？[l]\n──あ、[l]ごめ、[l]\n":91,"お待たせ」":92,"ごっ。":93,"「うが──」":94,"ばきばきばきばきっ！！！！！！":95,"「あーうー、[l]\nまだ強いか。[l]\nでもガードはきちんとされたから……[l]\nこっちが不意さえ打たなきゃあ、\n少しは遣り合えるかな？かな？」":96,"「い、いっでぇえあっッ、\nぎ、ぐ、ぐっ、げほっ、が、はッ」":97,"「回復手段が無さそうだからその辺りは手心加えなきゃか、\nんむ？」":98,"ざわ……":99,"さぁあぁぁぁぁぁぁ………":100,"「──ミリアム達は逃げたと。[l]\nんじゃ後は、チノにアンカー情報あげてぇ、\nこいついびりながらまこくんを……[l]\nんむ？[l]\nチノが連れてくるのかな？[l]\nまあ順番はどうでもいいや、[l]\n":101,"だんだん愉しくなって」":102,"ぴぃーーーーん、":103,"「？！！？、[l]\nちっ、」":104,"ぶぅん！":105,"ごづっ、ぐしゃ！！":106,"「きたしっ。[l]\nおー、そうそう。[l]\nｇｊｇｊ＞＜ｂ、\nガードってのはそうやってするのさ」":107,"「いっ、[l]ぎ、[l]て、[l]めっぇえ[l]え[l]え[l]え[l]え[l]え[l]え[l]え、」":108,"ごん！！":109,"「まあガードに対しては、\n削りも無効技も、[l]\nガード硬直解けるより速いモーションキャンセルからの追撃も、[l]\nこっちは出来るんだけど、」":110,"「でぁやっ！！！」":111,"すかっ！":112,"「ちっ、[l]……ぐっ」":113,"「ヒトが戯れで行う狩りってのはね、\nハンターが絶対的に優位な事が前提でしょ。[l]\nタマの取り合いをするような、\n野生動物が食料を得る為の、\n所謂肉食獣のする狩りじゃなし、[l]\n『自分がやられるかも知れない』状況じゃ、\n普通はしないわさ。[l]\n自身は死のリスクを負わず、[l]\n相手を負かし":114,"仆す事を愉しむ、[l]\n残酷な遊戯、[l]\nま、釣りみたいなもんなのかな？[l]\nちがうかな？[l]\nどっちにしても、\n鬼ごっこにしろかくれんぼにしろ、[l]\n追う者追われる者、[l]\nその２者の関係性のゲームだろ？」":115,"ぼご。":116,"「げほっ、げほ、\n……がっは、べっ」":117,"「相手と合意の上な訳じゃないしね、\n喰う為の行為でも無し、[l]\nアソビにしちゃ相手のリスクが高過ぎて、\n単なる●●●と思われても仕様がない部分があるな」":118,"「て、[l]めェが、いう……[l]ことかッ、[l]\nそんくれェは……[l]ごぼっ、[l]\nわかんぞこら……[l]ッ……[l]！」":119,"「でもま、[l]鬼ごっこ等は、\n鬼を『感染す』事で、つまり、[l]\n立場の入れ替えを行う事で平等性を保ち、\n且つ優位性を保とうとする側とそれを奪う側、[l]\nその攻守の駆け引きを生じさせる事で、\n遊戯として成り立ってるんだろうけどね。[l]\nまあ相手の意思を汲むなんて事は、\nヒトくらいしかしてない事だしね、[l]\n植物から細菌、ウィルスにしたって、\n争いをしない有機存在なぞ無い訳でさ。[l]\n草食動物だって♀を巡って♂同士の戦いも在る事だし、\nニンゲンのイメージなんて得手勝手で、[l]\nその時々で都合の良いモノが選択されているだけ、\nプロパガンダもいいとこだ……[l]が、[l]\nヒト同士に於いて通用してる分には、\n種レベルでの文化の問題もあるし、[l]\nま、[l]何しろヒト以外のモノは、\n真にはどう感じていようとも、[l]\n『文句を言えない』から」":120,"「てめェの……っ、」":121,"べき。":122,"「ええと、キミは知らないかもだけど、\n今言ったような、[l]\nプレイヤーと":123,"敵しかいないゲーム、\nそれとは別に、[l]\nプレイヤー同士が対戦するゲーム、[l]\nいずれにしても、[l]\n昔はゲームをしようにも、[l]\nプレイヤーを集めるのが大変でね、[l]\n多人数の時間も場所も確保した上で、\nすべき処理も煩雑なので技量も必要な、[l]\nそう言う有能なＧＭ（ゲームマスター）も居ないと、[l]\n中々愉しい……[l]特に":124,"劇は出来なかった訳。[l]\nそこに現れたコンピューターゲームは、[l]\n汎用性は欠くものの、\n今言ってきた負担や、\n多人数のスケジューリングを不要に出来る……[l]\n要するに、\nゲームを":125,"ス":126,"タ":127,"ン":128,"ド":129,"ア":130,"ロ":131,"ー":132,"ンへと、[l]\n進化──[l]そう言って良いのかはアレだけど、\nそういう流れへと動かせた。[l]\n……言っても分かんないだろうから端折ってるし、[l]\n多分に恣意的な話だけどね。[l]\nまあそれはそれとして……[l]うひひ。[l]\nえーとなんだっけ？」":133,"「──っく、[l]\nちっくし」":134,"「あー、思い出した。[l]\n":135,"──ところが、\n昨今になって、[l]\nまたぞろ積極的に他人と関わり合おうとする、\nそれ前提のコンピュータ制御ゲームの台頭、[l]\n場合によってはソロ不可ＰＴ強制とか、\n愉快な方向に動いてるようだね。[l]\n":136,"面白いねぇ」":137,"「……[l]～～～～～[l]！[l]！[l]！[l]！[l]！[l]！」":138,"「ただ、先刻も言ったけどね、[l]\n多人数と遊ぼうっていうなら、\nどうあっても環境次第、左右されるんだよ、[l]\nヒトが大好きな平等性とはまるで懸け離れてるな。[l]\n例えばネットインフラだって、[l]\n……この辺じゃ全然じゃん？[l]\n携帯電話の電波も入らないしっ。[l]\nま、[l]\n遣り方の一つではあるだろうが、\n私はキライ。[l]\n":139,"たかが余暇活動に、他人の力が必須ってどういう事さ。[l]\nソロでも攻略可能、他人の手借りたら楽になる、\n程度が好きだね私は」":140,"「ぐっ！[l]……っは、[l]はぁッ、[l]はぁッ、[l]ぎぎ……」":141,"「で、結局の所私の場合、ゲームとは、[l]\n只の暇潰し、憂さ晴らし。[l]\nだから、[l]\n":142,"強大で理不尽な敵を苦労してやっつける喜びとか、[l]\n面倒な手順を解き明かすとか、[l]\n他者とプレイしないとリストが埋まらないとか、[l]\nそういったね、[l]\n自分だけの力じゃどうしようもないやつとか、[l]\nゴールの喜びを底上げするための、[l]\n前準備としての強制ストレスを与えられるようなのは、[l]\n私にとって、」":143,"「ひ、[l]ぐっ……」":144,"「":145,"暇":146,"活動としては成り立ってない訳。[l]\n勿論、そういうゲームを否定してる訳じゃないよ？[l]\nソロ以外で先刻みたいな事いってたらだめなひとだし、\nプレイしててハマるのは案外、\nそういうのだったりするしね……[l]\nま、[l]\n結局は好みの問題、\nそれこそゲームなんてスキかキライで選ぶものだろ？[l]\nああ、そうだ、[l]\n兄様はどっちかというとそちら側に傾倒してるし、\nだから──[l]\nごめんごめん、本気に受け取んないでね？[l]\n":147,"……ってほら、[l]こうやってさぁ、[l]\n無意味な内容の長広舌をふるってる間に、\n何とか少しでも回復しなよ、[l]\nっていう情けな訳よね。[l]\n優しいでしょぉ？」":148,"「勝……[l]手抜かしやがッてッ[l]……！[l]\nこの……[l]カス………[l]め……！！！！！！」":149,"「んむー、だってキミが、[l]\n無理に立ち上がろうとするからさ、[l]\n親切で寝かしてあげてたのに。[l]\nそれに──[l]\n猫は獲物をいたぶっちゃうの、\n視たことない？[l]\nもぐらとか鼠とか、[l]\n生かさず殺さず、[l]\n玩具みたいに、」":150,"ざっ！":151,"「……！！[l]\nぎっぃぃいいいい……[l]\nてめぇはぁッ……！！！！！！」":152,"「ひゅーぅ、ナイス避け」":153,"「……窮鼠……[l]猫を噛む……[l]って言葉……[l]\n知らねェのか……？[l]\n勉強……[l]足りてねェな……[l]\n俺ァ……[l]逃げる気なんざ……[l]ねぇからな……[l]\n先刻から聞いてりゃ、[l]\n……よくわかんねェが、[l]\nムカつく事いってんだろッ……！[l]\nせいぜい──」":154,"ぐずっ。":155,"「っぎ、いがあああああ！！！！！！」":156,"「ほう、今のも良いな。[l]\nだいぶ良い動きに、限解も無いのに大したモンだ。[l]\nそれとも遅効か劣化prot－einでも使ってたか？[l]\nどっちにしろ、」":157,"「でらっ！！！」":158,"ぶん！":159,"「焼け石に水だけどね。[l]\nそれは『お互いにとって』残念だけど。[l]\nんむ、[l]\nキミにとっちゃまさに、[l]\n猫の手も借りたい状況ってとこ、かな？」":160,"うひひひひ。":161,"「怒り、而して冷静であること、\nエンジンは暖めないといけないけども、[l]\nオーバーヒートしては本末転倒。[l]\n回路や機構はあくまで冷静に。[l]\nそれでいて、[l]\n燃料自体は熱く、激しく燃えるものが望ましい。[l]\n血は頭に上らすのではなく、\n総身に行き渡らせねばね」":162,"「だらっ！！！！！！」":163,"すかっ。":164,"「だから、[l]\nキミのようなのは、」":165,"「ぎらあッ！！！！！！」":166,"「こうやって、[l]\n爽快な筈のアクションゲームですら、\n苛苛する羽目になるんだよ。[l]\nアクションてのはボタン連打するもん、[l]\nみたいな認識で、\nガードしないでひたすら飛び込み迎撃される系？[l]\n超反応設定ＮＰＣ相手じゃなくても、\nそんなプレイで勝つのは難しいよ。[l]\n先刻のは戯言だから矛盾した事言うけどね、\nアクションゲームほどに、\n操作には反射神経や精密さ、\n戦術には先読みやら心理作戦、\nそういう繊細さが要求されんの。[l]\n視た眼の印象通りただ乱暴に感情ぶちまけるのとは、\n真反対の嗜み方だわさ。[l]\nシューティングだってそう、[l]\n弾幕避けるも照準合わせも、\n雑なプレイじゃ出来やしない、\n寧ろロープレのがボタン連打ゲーだよ」":167,"「っっっっせえええええええ！！！！！！」":168,"……すかっ。":169,"「ぜは、[l]ぜは、[l]ぜあ、[l]げあ、[l]……っ、[l]がふ、[l]\nげほげほっ」":170,"「ま、[l]\n今私が、\nとある理由でイラっとキてるのは認めるよ。[l]\nホントはこういうの趣味じゃないんだけど」":171,"「……はぁ、[l]……はぁ、[l]……は……[l]っ、」":172,"「ストレスは発散するに限るからね……[l]\nそうそう、而して、\nこれもまた燃料になり得るモノだ。[l]\n反作用って知ってる？」":173,"「……っかにしてンのかてめェは……っ、[l]\nさっきからべらべらしゃべくって、」":174,"「幾ら歩こうとしても、\n地面に跳ね返す力がなきゃ、\n一歩も前に進めないってことさ。[l]\nストレス無く乳母日傘でのんべんだらりと暮らしてる奴に、\n行動力や推進力なんかあると思うかい？[l]\n一部の植物は踏まれ、刺激される事で成長物質が出て、\n強く伸びるっていうしね。[l]\n重力があればこそ骨の強度も筋力もつく……[l]\nキミもどうやらそういった反抗心みたいなモノが、\n何らかの『逆向きの要素』が、\nその行動の源泉にあるようだけど」":175,"「………ハッ」":176,"「素質はある。[l]\n曲がりなりにも●●くんの身体の一部を":177,"身":178,"盗った存在、[l]\n遣り方が拙いだけでフロスの縛鎖も遣えてる、\nだから、」":179,"「……なに？[l]\nなにくんだと──」":180,"「まあ──\nあとは車や自転車の運転と同じく、\n":181,"骨を掴めば何てことはない。[l]\nある点を乗り越えさえすれば、\nきっとよきプレイヤーになれるだろう。[l]\nよき師に巡り会って、\n早々にボタン連打プレイから脱却する事だな」":182,"「…………んなんだ…………めェは………」":183,"「んむ、\nそう、その調子。[l]\n負けたくないとか、\nあいつむかつくとか、\n実はそういう燃料は事欠かないのが、\nこの最悪の箱庭たるセカイ。[l]\n例えばスロタラスモルトはまさに先の構造理念、\n対象が●●であればあるほど威力……威力？[l]\nまあいいや、返す力は高まるからね、\n逆に言えば平穏な環境下ではアレの力は無いに等しい、\nでも……[l]\nそんな絶対安定状況は、\nヒトの世で生きてれば有り得ないと分かるだろ？[l]\n兄様もやらしい設計にしたものだよ。[l]\nまあ、私はその点、\n繰り返すようだけど、\n他人が攻略……リスト埋めも含めてだけど、[l]\nそのフラグ担ってるのは耐えられないからさ、\nソロで全てストレス無く遊べるように、\nして貰ってるの」":184,"「……ぅだ………」":185,"「んむ？」":186,"「……そうだ、[l]\n足りねェもンがあるからこそ、[l]\n人は渇望し、[l]その穴ァ埋めようと、[l]強く、[l]\n強くッ……」":187,"「んむ」":188,"「──なるんだッ！！！！！！」":189,"「ごっは……」":190,"「プレイヤーが──」":191,"どしゃっ。":192,"「腕を上げたり工夫したりすれば、\n何とか勝てるような、\nわざと解法や隙を設けてあるような、[l]\n──今まで説明してあげたような、[l]\n御行儀の良いゲームを私達はしてる訳じゃ、[l]\n残念ながら無いからね。[l]\n範囲攻撃も無茶な当たり判定も自動回復も、\nその気になればこっちはそうカスタム出来るよ。[l]\nまあ、[l]\n":193,"単に調整不足でマゾくなってる訳じゃな──[l]\n":194,"てか私は別にラスボスじゃないっつーの！」":195,"「がはっ、[l]お、[l]げぇぇぇぇ……、[l]\nごぼっ、[l]ごふっ」":196,"「だからこっち主観で視れば、\n単にレベルが違うだけの話でね。[l]\n普通、[l]\n下位クエの敵が上位装備のプレイヤーに、\nまともに抗しうるバランス調整はないからさ」":197,"「あ゛[l]あ゛[l]あああああッ！！！」":198,"ばぐん、":199,"がちん、":200,"「無論こちらの攻撃の出力は下げてあるけど、\n例えば──キミの攻撃が２０として、\n防御１００にはダメージ通らない、\n単純にそれだけの事だね。[l]\n今みたいにPHASE:6、\n咬もうったって、\n歯が通らないんだよこの場合。[l]\n6しかないキミでは丸呑み出来る訳も無し、\n寧ろそんな事したら死活問題の筈だったかな？」":201,"「あぐぁうあッ、[l]ああがああがあああがが！！！！！！」":202,"「……にしてもおっそい！[l]\nチノも手こずってる？[l]\n話すネタもごちゃごちゃになってきて、\nしかもほとんど独り言みたいじゃんっ、\nいい加減早く来てくれないと、\n●●しちゃうよ、\nまこくん」":203,"「──な……ンだと？[l]\nま、」":204,"「宮はもうアキちゃいますよ、\nこんな雑魚じゃやっぱ手応えもないし、[l]\nんむ、[l]\nアキた、[l]もう飽きた。[l]\n":205,"あーきたー。[l]\nゲームだったら、[l]\nセーブしないで電源落としたいくらい？[l]的な？[l]\nなんて」":206,"「まててめェ、\n今なんて言った、誰のなま──」":207,"「ま、いいや。[l]\n最後に教えたげようか。[l]\n知ってる？[l]\nゲームにはね、[l]まま、":208,"絶対勝てないイベント戦というのがあるのよぉ」":209,"ぼぅ……":210,"「えと、\nお相手ありがとうございました、\nじゃあ、おつです（＾ヮ＾）ノシ」":211,"「の、のし？」":212,"「──」":213,"……んだ？":214,"耳鳴り……？[l]\n　　何にも、[l]\n　　聞こえねぇ……":215,"……そんで……[l]\n　　熱い、[l]\n　　眼の前が真っ赤で……":216,"……あ？[l]\n　　飛んでる？[l]\n　　周りがすげぇゆっくりに……":217,"やばい、[l]トびそう……[l]\n　　わんわん頭ん中が……[l]\n　　鳴りまくって……":218,"「……ああーぁあぁあぁ、[l]\nそうか、\n成る程ね、[l]\nキミは──」":219,"ぱきん、ぐしゃっ。":220,"……んて言った？[l]\n　　って、[l]\n　　あれ何かあんまり痛くないな、[l]\n　　まだ何かゆっくりだし、":221,"あれ……勉強した気がする……[l]\n　　痛みは通常、危機的状況回避の為の警告の意味合いで……[l]\n　　回避どころじゃない、[l]\n　　そんなコトをしても遅いような、[l]\n　　致命的なダメージを受けた時は……[l]\n　　脳内物質がばーっと出て、[l]\n　　そんで……それとは別に、[l]\n　　何とか対処しようと頭の回転が……[l]\n　　処理がすごい速くなって相対的に周囲は遅く、[l]\n　　……マンガの中の話と思ってたけど……":222,"そうか……あとは、[l]\n　　痛過ぎて……[l]\n　　気を失うか……":223,"しぬか……":224,"「誰の入れ知恵か知らないが、\n多分キミがイツワの断片をクイ合わせたところで、[l]\nそれとこれとは──[l]\nキミが完全な●になるかどうかは関係ないぞ」":225,"……？[l]\n　　わたしにはなしかけてる？":226,"「だから、[l]\n幾らキミが、[l]\n●であるキミが、[l]\nまこくんを●●でも──」":227,"まこ……ちゃん、[l]\n　　やっぱりまこちゃんの名前を、":228,"……ああ、わたしさ、[l]\n　　あのときからずっと●●だったのだわ。[l]\n　　でも、":229,"「……ま、[l]\n選ぶかどうかはまこくん次第だけど。[l]\n分が悪いのは否めないな。[l]\nというより、\n手段と目的を取り違えてるんじゃね、[l]\n──んむ、全く悪いヤツも居たもんだ」":230,"……わるくない、[l]\n　　わるいのはわたし、[l]\n　　むくい、[l]むくい、":231,"──そうなの？":232,"「─────」":233,"あ、もうなにもきこえない。":234,"なんか、":235,"ねるときみたいだわ、":236,"それとは別の本心がね最近ま\nこちゃんと再会してから抑え\nらんないのだわ何かムジュン\nしてる？気にしないでね頭悪[l]\nいから私とにかくね私なんか\nじゃだからねあーあーもうね\n頭悪いからさ何書きたいのか\nもわかんないけどさ話せば早\nいんだろうけど祭忙しくてで\nも祭終わったらきっとああさ\nっきも書いたねこれ頭悪いか\nらさ私こんななのだわだから\n何か間違ったことしようとし\nてたらバカって叱って止めて\nほしいよそうでないと私バカ\nだからさいけないことをしそ\nうでイヤなのだわ早くちゃん\nとしたひとになりたいそれか\nねまこちゃんが冬夏ともしい\nややっぱ言わないわえへへ。":237,"あー、":238,"あいたいよーまこちゃん。":239,"私はそんな二人をみられれば\nまこちゃんたちふたりならば\nさそれなら許せると思うのだ\nわ。":240,"あいたいよう。":241,"まあでもそこは最後の意地だ\nからさ冬夏にはひみつ。":242,"なんでこうなったんだろ？":243,"いっぱい、いけないことを、":244,"しちゃったからかな？":245,"あとはあれだわ他にも色々言\nいたいこともあったけどさ、":246,"だからあやまったり──\n　　いいたいこと──がいっぱい──\n　　あるの──に──":247,"やっぱ、墓場まで持っていくのだわ。":248,"そのほうがかっこいいし？":249,"ひみつは大事よね。":250,"ミステリアスってやつ？":251,"──────":252,"「………んむ──」":253,"────":254,"──":255},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_074.ks","relPath":"/data/scenario/SC_M_074.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":247,"length":256,"percent":96.484375},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[88,1]},"/data/scenario/SC_M_075.ks":{"data":[["間一髪、","千钧一发，"],["と言って良いのかどうか。","不知该不该这么说。"],["状況の詳細を把握するより前に、\n","在掌握详细状况之前，\n"],["宮さん……モードは既にミルハの……あれは、[l]\n中位（Mode:Medium）か？[l]\n兎に角、その振り下ろされた紅腕の先に、\n何者かの存在を","宫小姐……模式已经是米尔哈的……那个，[l]\n中位模式（Mode:Medium）吗？[l]\n总之，在那挥落的红腕前端，\n察觉到某人存在的"],["視","视"],["咎めた僕は、","我，"],["思わず割って入っていた。","下意识冲了进去。"],["其処に横たわってるのは、[l]\n","横陈在那里的，[l]\n"],["襤","破"],["褸","烂"],["屑のようになって、[l]\nぴくりとも動かない、","如碎屑般，[l]\n纹丝不动的，"],["「……お。[l]\nおおおおおっ？[l]\nおおおおおおおお！！」","「……哦。[l]\n哦哦哦哦哦？[l]\n哦哦哦哦哦哦！！」"],["「……お、そかった？[l]\nのか？[l]\nというか、\nなんでお前が宮さんと、」","「……哦、得救了？[l]\n吗？[l]\n话说，\n为什么你会和宫小姐，」"],["「すごい！[l]\nすごぉい！！[l]\n全然気付かなかった！！！[l]\nどういう技？[l]\n宮に気付かせないでここまで接近するなんて、」","「好厉害！[l]\n好厉害！！[l]\n完全没注意到！！！[l]\n这是什么招式？[l]\n居然能不被宫发现就接近到这种距离，」"],["「僕が分かるか？！[l]\nお前っ、[l]音だよなっ？[l]\n西石音、[l]つーか──」","「我哪知道啊？！[l]\n你这家伙、[l]是音对吧？[l]\n西石音、[l]不对──」"],["「──」",""],["僕の、[l]\n鼓動が早鐘を打つ、[l]\nどくどくと脈打つ血流が、[l]\n頭の中を駆け巡り、","我的、[l]\n心跳如擂鼓、[l]\n咚咚脉动的血流、[l]\n在脑海中奔涌、"],["一瞬気が遠くなった──","瞬间意识远去──"],["「んむっ、シカトですか。[l]\nこんなになるまで待たせておいて、\nその仕打ちは酷いですっ。[l]\nそこのそれだって、」","「嗯唔、要无视我吗。[l]\n让人等到这种地步、\n这种对待太过分了啦。[l]\n那边的那个也是，」"],["音……きぃ……が、[l]\nなぜ、","音……小贵……为什么、[l]\n为何、"],["「まこくんがもうちょーーっと早く、\n宮の所に来て呉れてれば、\nこんなにならずに済んだのに」","「要是小真能再早一点、\n赶到宫那里的话、\n就不会变成这样了」"],["聞こえてくる言葉に僕は、\n頭が真っ白になって、","听着传来的话语、\n我的大脑一片空白、"],["「──んたがっ！！！」","「──呜哇！！！」"],["「ダマレ若僧」","「闭嘴小鬼」"],["「あぁっ？！」","「啊？！」"],["「早とちりにも程があるぞ。[l]\nマンガかキミは。[l]\nそんな雑魚、わざわざ殺す訳がないだろ」","「你也太性急了吧。[l]\n你是漫画角色吗。[l]\n这种杂鱼怎么可能特意去杀」"],["「？！[l]\nはっ？！！」","「？！[l]\n哈？！！」"],["「大事なまこくんのオトモダチを、\n……まあ、[l]\nまこくんを怒らせる為の──\n本気出さす餌にしても良かったけどね、\nこれがまた、\nまこくんとは別の意味で特殊なんだよね。[l]\n遣りようによってはまだ使いようもあるし、\nこれも","「重要的小真的朋友、\n……嘛、[l]\n虽然当激怒小真的──\n诱饵也不错、\n但这家伙、\n和小真是不同意义上的特殊呢。[l]\n用对方法还能派上用场、\n这种"],["蒐","收"],["集","集"],["者の","人"],["性というかな、\nそういう","的习性吧、\n把这样"],["貴","贵"],["重","重"],["存","要"],["在をばっさり切り捨てるのも、\nなかなか抵抗があるですよ。[l]\nただ、」","存在一刀两断、\n果然还是会有抵触呢。[l]\n只是、」"],["飽きたので。","我腻了。"],["「戦闘フェイズを終了させたわけです。[l]\nまこくんが来なかったら、\nチノに強制改宗でもして貰おうと思ってたの。[l]\nわかった？」","「所以结束战斗阶段了。[l]\n要是小真没来、\n本来打算让千乃强制改宗的。[l]\n明白？」"],["……宮さんは、[l]\n何でもないことを話すみたいに、\nそしてまるで、[l]\n駄駄を捏ねるコドモに言い聞かせるように、\nつまり、[l]\n優しさと冷静さ、[l]\nそれに少しの苛立ちを込めて、[l]\n僕に語り続けた。","……宫小姐、[l]\n像在说无关紧要的事般、\n又仿佛、[l]\n在哄闹别扭的孩子般、\n也就是说、[l]\n带着温柔与冷静、[l]\n以及些许焦躁、[l]\n继续对我说着。"],["「……あなたは……[l]いったい何が……」","「……你……[l]到底想……」"],["「んむ？[l]\n目的だの何だの、そういうのはどうだってね、\nなんだっていいじゃないですか。[l]\nああ、[l]\nそれとそこのそれね、[l]\nどうやらまこくんのことが、」","「嗯唔？[l]\n目的什么的那些东西怎样都好，\n怎样都无所谓吧。[l]\n啊啊，[l]\n还有那边的那个呢，[l]\n看来是小真的事情，」"],["「……いいです、知ってます。[l]\nでも黙っててください」","「……够了，我知道。[l]\n但请你保持沉默」"],["──",""],["漸く、","终于，"],["……混乱が収まった僕は、[l]\n宮さんの暴言……挑発のつもりなのか本心なのか、[l]\nそれを努めて聞き流しながら、","……从混乱中恢复过来的我，[l]\n对宫小姐的暴言……不知是挑衅还是真心话，[l]\n努力当作耳边风的同时，"],["傍らの音──きぃに視線を移した。","将视线移向身旁的声响──小贵。"],["よく眼を凝らせば、\n確かに、[l]\n息はしているようだった。[l]\nだが、……。","若仔细凝视，\n确实，[l]\n似乎还有呼吸。[l]\n但是，……。"],["「んむー、仕返しされたっ。[l]\nその言い方だと、\n『全部分かっ』た上での発言ですね？[l]\n……もし本人から、[l]\n『ほんとうのこと』を告白されてたら、\nどうするつもりだったのかな？」","「嗯唔─，被报复了。[l]\n这种说法，\n是『全都明白』之后才说的吧？[l]\n……如果本人，[l]\n坦白『真相』的话，\n你原本打算怎么做？」"],["………。",""],["──彼奴は、[l]\n自分で分かってた、\nでも我慢するつもりでいた、[l]\n墓場まで持っていくって書いていた──","──那家伙，[l]\n自己心里清楚，\n却打算忍耐下去，[l]\n说要带进坟墓里──"],["冬夏が、あんな事をする程に忌み嫌っていた、[l]\n姫様ちゃんがしたのと同じようなこと、[l]\n『してはならないこと』をした、[l]\nその報いという自責の念なのかも知れない、","冬夏之所以做出那种事，是因为极度厌恶，[l]\n姫様做过类似的事，[l]\n做了『不该做的事』，[l]\n或许这是报应般的自责念头，"],["それとも、[l]\n冬夏の想いを慮った上での、\n友人への優しさだったのかも知れない、","又或者，[l]\n是体谅冬夏的心情后，\n对朋友的温柔也说不定，"],["或いは全く知る由もない、\n彼奴自身の問題、理由があったのかも知れない、","也可能完全无从知晓，\n是那家伙自身的问题、另有缘由，"],["それでも、","即便如此，"],["それでも尚、あふれ出る、\n抑えがたい感情が、[l]\nそれが僕等の逃れ難き衝動、","即便如此仍满溢而出，\n难以抑制的感情，[l]\n这便是我们无法逃避的冲动，"],["Ｙの欲動……","Y的欲动……"],["それは、","那时候，"],["優先順位を狂わせ、[l]\nそして治まると決まって訪れる後悔や虚脱、\nなのに、[l]それなのに、[l]\nおわるまでは、きづくことのできない、","扰乱了优先顺序，[l]\n平息后必定降临的后悔与虚脱，\n可是，[l]即便如此，[l]\n直到结束前都无法察觉，"],["………、",""],["貴女方にはきっとわからない……！","您一定不会明白……！"],["「……どうって、──」","「……说什么，──」"],["僕の様な者が想像するのも烏滸がましい、\n壮絶な苦しみや葛藤や、[l]\nそれこそ想像もつかない……否、[l]\n想像する行為すら拒絶されて然るべき、\nきっとそんな、","像我这样的人妄想揣测也太不自量力，\n那种惨烈的痛苦与挣扎，[l]\n根本无从想象……不，[l]\n连想象的行为本身都应当被拒绝，\n肯定是那样，"],["それでも彼奴は、","即便如此那家伙，"],["きぃは、","小贵，"],["「……関係ないでしょう今は、[l]\nいえ、あなたには」","「……现在没关系了吧，[l]\n不，是对您来说」"],["僕はそう言ったけれど、\n半ば八つ当たりだった。","我虽然这么说了，\n却有一半是在迁怒。"],["実際、[l]\nもし、話す機会が与えられたとしても、\n僕はきぃに何を言えたのだろう。","实际上，[l]\n就算给予倾诉的机会，\n我又能对小贵说什么呢。"],["僕には、","我，"],["わからない……","不明白……"],["宮さんはそんな僕のこころを視透かすように、\n話し続ける。","宫小姐仿佛看透我这般心思，\n继续说着。"],["「関係ないって？[l]\nふぅーん。[l]\nまーいいです。[l]\n","「说没关系吗？[l]\n哼—嗯。[l]\n嘛—算了。[l]\n"],["でもま、ほら、\nアイはね、平等なんて言葉からは、\nかなーり懸け離れたものでしょお」","不过嘛，你看，\n爱这家伙啊，和所谓平等这种词，\n可是相—当—遥远的东西哦」"],["「……？」",""],["「この世から憎しみや争いを無くそうと思ったら、\n愛も否定しなきゃならないという矛盾ね。[l]\nアイは全てを狂わすものですよ。[l]\n単純に、\nひとりの人間を複数人が同時に好きになったら？[l]\nその逆でも良いけど」","「要想消除世上的憎恨与争斗，\n就不得不否定爱这种矛盾呢。[l]\n爱会让一切失控哦。[l]\n简单来说，\n如果多个人同时喜欢上同一个人？[l]\n反过来也成立啦」"],["「……」",""],["「愛し合う者、恋人同士になるというコトが、\nある種の契約──同時には他人とそういう関係を築かない、\nという、少なくとも現在この國で道徳観念、\n美徳とされるその構造ある限りは、\n必ず誰かが選ばれる、或いは誰も選ばれない、\n取捨選択されてしまうでしょうに。[l]\n平等──つまりは、\n『いつでもだれとでも』いい、\nという形式をとらないかぎりは、」","「相爱之人成为恋人这件事，\n本质是某种契约——约定不同时与他人建立这种关系，\n至少在当今这个国家的道德观念中，\n只要这种被视为美德的结构存在，\n就必然有人被选中，或是无人被选，\n终究会面临取舍选择吧。[l]\n所谓平等——也就是说，\n除非采取『随时与任何人』都可以，\n这种形式才行呢」"],["「アイ故に、起きる悲しみ。[l]\n誰も、悪くするつもりがなくとも。[l]\n所謂悪念がこの世から消えたとしても、\n選ばれないモノはこうやって存在し続ける。[l]\nそうでなくしたいなら、\n契約で縛るような関係性の構造も、\n否定せざるを得ないのかな？[l]\nと言うよりもね、\nあ、そうそう、\n単数だろうと複数だろうと、\n言い寄ってきた相手が好みじゃなくて、\nそいつに好かれる事自体がイヤ、\nって場合も勿論あるでしょ。[l]\nそだそだ、どうこういうそれ以前の問題だよねこれは」","「因爱而生的悲伤。[l]\n即便谁都没想作恶。[l]\n就算所谓的恶意从世上消失，\n不被选择之物也会这样持续存在。[l]\n若想改变这种状况，\n就必须连这种用契约约束的关系结构，\n也一并否定才行吧？[l]\n或者说啊，\n啊对了对了，\n不管对象是单个还是多个，\n要是来追求的人不合自己口味，\n光是被人喜欢就觉得很恶心，\n这种情况当然也存在啦。[l]\n对对对，这根本是更早阶段的问题嘛」"],["「……それは何かの言い訳なんでしょうか？[l]\n先手を打ったおつもりで？」","「……这是在找什么借口吗？[l]\n自以为抢占先机了？」"],["自分でも何を言ってるのか、\n理路整然したものとは懸け離れてると、\nそれは分かっていたけれど、\n口を衝いて出た言葉はそれだった。","虽然自己也明白，\n这些话根本谈不上条理分明，\n但脱口而出的，\n偏偏就是这些。"],["これじゃまるで、\n……相変わらず僕は……","这样简直像是，\n……我还是老样子……"],["「べぇつにぃ。[l]\n一般論のつもりですけど？[l]\n仮に『争い』は無くっても、\n辛いことや悲しいこと、\nヤな気分って無くならないね、\nというあくまでも一例ですよ。[l]\nというかさぁ、[l]\n","「才~没~有~呢。[l]\n只是在说普遍现象而已啦？[l]\n就算没有『争斗』，\n痛苦的事悲伤的事，\n不爽的心情也不会消失呢，\n这不过是其中一例罢了。[l]\n话说回来啊，[l]\n"],["まこくんだって、[l]今、[l]\n……人のこと言える？」","小真你自己，[l]现在，[l]\n……有资格说别人？」"],["「それはどういう──」","「你这话什么意思——」"],["「あれだけ仕込んだのに、\n宮だけを●●●と思ってたのに……」","「明明做了那么多准备，\n却只把宫当作●●●来看……」"],["さぁああぁぁぁぁぁぁ…………","啊啊啊啊啊啊啊…………"],["ざわ……ざわざわざわざわ…………","嘈杂……嘈杂嘈杂嘈杂…………"],["その時一陣の夜風が吹き抜けて、","这时一阵夜风呼啸而过，"],["あのひとが何と言ったのかは解らなかった。","没能听清那个人说了什么。"],["風が止むと、\nこっちを視て、\n宮さんはにこりと笑った。","风停之后，\n望向这边，\n宫小姐嫣然一笑。"],["「ま、そのうちチノでも来るでしょ。[l]\nそこのそれ、処置頼めば？[l]\n……結局独りで来たんですもんね？[l]\n宮に会う為にね？」","「嘛，反正千乃迟早也会来的吧。[l]\n那边的那个，能帮忙处理下？[l]\n……结果还是一个人来了呢？[l]\n为了见宫小姐对吧？」"],["最後の言葉が、\nあのひとらしからぬ、\n何かすがるような感じがしたので。","最后那句话，\n不像是那个人会说的，\n总觉得带着点求救的味道。"],["僕はつい今までのあのひとの、\n傍若無人な言い様を忘れて、","我不由得忘记了至今为止\n那个人旁若无人的说话方式，"],["「そうです」","「是的」"],["明瞭とそう、口にした。","清晰地如此说道。"],["「そっか……[l]\n嬉しいです」","「这样啊……[l]\n我很开心」"],["「……そりゃ、どうも……」","「……那可真是，多谢……」"],["僕の頭の中で、[l]\n激しく思考の作用反作用が。[l]\n激しい歓喜と、[l]\n自己防衛の為の疑心暗鬼、","在我的脑海里，[l]\n激烈的思考正反作用在碰撞。[l]\n强烈的欢喜，[l]\n与自我防卫产生的疑神疑鬼，"],["ぼくだってうれしいけれど、[l]\nこのひとのことばをうのみにしては、[l]\nまにうけてしまっては、","虽然我也很高兴，[l]\n但如果全盘接受这个人的话，[l]\n轻易相信的话，"],["……きっと傷付くんだ。","……一定会受伤的。"],["だけれど、","不过，"],["「で、[l]\nどうするか、きめた？」","「那，[l]\n决定好要怎么办了吗？」"],["………問いに対する、","………对于这个提问，"],["『その問い方に対する』返答は、","『针对提问方式』的回应，"],["僕の中の色んな要素と違っていたから、","与我内心的各种要素都不同，"],["思考が、脳が空転して、","思考、大脑一片空白，"],["………臨戦態勢をとったままのシロを鎮めた。","………让保持临战状态的白冷静了下来。"],["「──あなたの言うように、[l]\n","「──我不会像你说的那样，[l]\n"],["八",""],["相達を滅ぼして、\nカミを取り戻そうとは、[l]\n思いません」","去消灭相达们，\n夺回神明，[l]\n没有这种想法」"],["「ほう」","「哦」"],["「あなたがそうしようとするなら、[l]\n僕があなたを止めます」","「如果你执意要这么做，[l]\n我会阻止你」"],["「ほうほう」","「哦哦」"],["「………」",""],["「いいんじゃない？[l]\n結局、\n愉しければ、私はどちらでも。[l]\n獲物はなんだっていいの。[l]\n生きさえ良ければ。[l]\nま、\n止めることが出来るかどうかは、[l]\n──残念ながらアレだけど？」","「不也挺好？[l]\n反正，\n只要开心，我怎样都行。[l]\n猎物是什么都无所谓。[l]\n只要能活着就好。[l]\n嘛，\n至于能不能阻止得了，[l]\n──可惜就另当别论了？」"],["ざわ………………","嘈杂………………"],["「それにしても──」","「话虽如此──」"],["先程から吹いているような、\n少し強めの風があるくらいで、","除了刚才开始就吹着的，\n稍微有点强的风之外，"],["「やけに静かです……ね、[l]\nもっとこう、[l]\n──あの時の六母屋の地下みたく、\n『最後の舞台』が大仰に用意されてるのかと思ってました」","「异常安静呢……[l]\n还以为会更有[l]\n──像那时六母屋地下那样的，\n『最终舞台』大张旗鼓的准备」"],["途中で冬夏と狩屋に会ってある程度の事情を知り、\n今ここできぃを確認して、\n……行動の真意は知れねども、[l]\nどうやら宮さんが何かする以前に、\n事が起きてしまったらしいこと、","中途遇见冬夏和狩屋知道了部分情况，\n现在在这里确认了小贵，\n……虽然行动的真实意图尚不明确，[l]\n但似乎在宫小姐采取行动前，\n事情就已经发生了的样子，"],["つまり、\n恐らくは予定が大幅に狂った──或いは、[l]\n……宮さんの事だから、[l]\nそもそもが行き当たりばったりで、\n結局お粗末になったってだけの、\nそういう事なのかも知れないけれど、","也就是说，\n恐怕计划已经彻底乱套了──或者说，[l]\n……按宫小姐的作风，[l]\n本来就是个随心所欲的人，\n最后搞砸了也是理所当然，\n虽然可能是这么回事，"],["──そういえば、八相が散り散りばらばらって事は、\n今頃道具さんや、\n姫様ちゃんはどうなっているんだろう……？[l]\n大神が来てるなら、フォローしてくれてるといいけど……","──话说回来，八相四分五裂的话，\n现在道具小姐和、\n姫様酱不知道怎么样了……？[l]\n如果大神在的话，希望他能帮忙照应下……"],["「なぁに言ってるんですか。[l]\nまこくんが速攻話を決めてれば、\n役者もちゃぁんと揃い踏み、\n豪華なイベント起こせたのに。[l]\n自業自得というものですよ」","「在说什么呀。[l]\n要是小真早点敲定方案的话，\n演员们就能整齐亮相，\n办成豪华活动了呢。[l]\n这叫自作自受哦」"],["……じゃあ、[l]\n僕のあの彷徨も、\n或る意味良かったって、言えるのかな……","……那么，[l]\n我的那次徘徊，\n某种意义上也算是好事吧……"],["「それに──[l]\nらすとばとぅだからって、\n派手派手しいばっかりじゃ能がないし。[l]\n最後の決着は、[l]\nアイ対する二つの存在が、[l]\n色んな思いを込めて粛々と遣り合う、[l]\n切なく苦しい、戦いのヒアイを噛み締めながらの、[l]\n葛藤に満ちたものであっても、[l]\n良いんじゃないの？[l]\n誰にも理解されないまま、\nお互いにくだらないと、間違っていると分かっていても、\n戦って決着をつけなければならない──\n","「而且──[l]\n因为是last battle就一味追求华丽，\n反而显得很没品呢。[l]\n最后的决战，[l]\n让针对爱的两个存在，[l]\n怀着各种思绪庄严对决，[l]\n在咀嚼着悲伤痛苦的战斗悲情的同时，[l]\n充满纠葛的结局，[l]\n不也挺好吗？[l]\n即使不被任何人理解，\n即使明知彼此都很愚蠢且错误，\n也必须通过战斗来做个了断──\n"],["遊","妓"],["戯としては兎も角、\n","作为戏剧姑且不论，\n"],["戯","的"],["曲としてはそういうのもありでしょぉ？[l]\n敵を倒して気分スッキリ、[l]\nそんなのに該当するような敵らしい敵、[l]\n悪悪しい悪の","作为歌曲这种设定也不错吧？[l]\n打倒敌人神清气爽，[l]\n像这样值得打倒的典型敌人，[l]\n穷凶极恶的"],["親","大"],["玉なんか、[l]\n中々居ないよぉ？」","反派，[l]\n现实中可不多见哟？」"],["……。[l]\nそれには少し異論を唱えたくなるけど……","……。[l]\n虽然对此我有点不同意见……"],["そんな僕の","无视我的"],["黙りを無視して、\n宮さんは、","沉默，\n宫小姐继续道，"],["「それにね、\nこの國ではね、[l]\n昔からバッドエンドの方が受けるんですよ？[l]\n知ってるでしょぉキミなら？[l]\n今じゃあっちに","「再说了，\n在这个国家啊，[l]\n自古以来悲剧结局更受欢迎哦？[l]\n你应该知道的吧？[l]\n现在那边都"],["気","疯"],["触れちゃって、[l]\n悲劇の原作モノですら無理矢理ハッピーな終わりにしたり、\nま、勿論その逆、[l]\n死をかたりさえすれば感動、[l]みたいな風潮もあるですがね、\nいずれそれらしい記号があれば、[l]\nヒトの感情は簡単に動いちゃうもんだし、\n別に恥じることではないですけど、[l]うひひ」","魔了，[l]\n连悲剧原作都要强行改成快乐结局，\n嘛，当然也有反过来，[l]\n只要涉及死亡就能感动人[l]的风潮呢，\n反正只要找到合适的符号，[l]\n人类的感情很容易被调动，\n这也没什么好羞愧的，[l]嘻嘻」"],["徐々に僕に近づきながら、","一边说着一边慢慢靠近我，"],["「──年寄りは、[l]\nそのオハナシの要素、記号に対して、[l]\n長生きした分経験も多くて、[l]その中には、[l]\n該当する類似記憶も多くなるから涙もろくなるだけ、[l]\n自分で勝手に自分の類似記憶と関連付けて、\n勝手に自分の中で物語りを想像してそれに励起されてる、[l]\nそういうことかな。[l]\nだから、[l]\n──昨今はメディアが氾濫してるからね、\n小さい頃から実体験以外の情報があるからだろうか、[l]\n簡単に●●とか言うことも出来る。[l]\nそうでなくても最近は、\n物事に対する評価が『最高』とか『最低』とか、[l]\n何でもかんでも超とかカリスマとか神とかつけてみたり、[l]\nＭＡＸ両極端で評するじゃん。[l]\n雑多に氾濫する情報を効率的に取捨選択するために、\n手早く○×振り分ける為の行為かもですが、\nんむ？[l]\nそれとも、敢えて全部同じにして、[l]\n差別してません、みんな平等に仲良しこよし、[l]\nって言いたいのかな？[l]\nその割には優勝とか金メダルとか、\nスポーツに限ってはヘンな精神論振りかざして、\nみんな熱くなるよねぇ。[l]\nま、色んな意見があるのは構わないでしょうけど、\nそれぞれが勝手に思ってればいいだけでしょうに、\nうひひ、[l]\n私達のような年寄りから視ますとね、\n結局価値を愚弄してるように視えて悲しいです」","「──老人家啊，[l]\n对那些故事要素、符号之类的，[l]\n活得久经验也多，[l]其中，[l]\n符合的类似记忆也多起来才会变得爱哭，[l]\n擅自把自己的类似记忆关联起来，\n自顾自地在脑海里想象故事并因此兴奋，[l]\n就是这么回事吧。[l]\n所以说，[l]\n──最近媒体泛滥嘛，\n大概因为从小就有实际体验以外的信息吧，[l]\n轻易就能说出●●这种话。[l]\n就算不是这样最近也，\n对事物的评价动不动就『最棒』或『最烂』，[l]\n什么都加上超啊教主啊神啊之类的，[l]\n全用MAX两极分化来评判对吧。[l]\n为了高效筛选庞杂泛滥的信息，\n或许是为了快速划分○×的行为，\n嗯唔？[l]\n又或者，故意全都一视同仁，[l]\n宣称没有歧视、大家平等和睦相处，[l]\n是想表达这个吗？[l]\n可偏偏对冠军啊金牌什么的，\n唯独在体育领域高举奇怪的精神论，\n大家不都热血沸腾嘛。[l]\n嘛，有各种意见也无所谓啦，\n各自爱怎么想都行呗，\n嘻嘻，[l]\n从我们这种老人家看来啊，\n总觉得像是在愚弄价值很可悲呢」"],["と、","这时、"],["嘯いた。","嗤笑道。"],["「……道具さん並に話が逸れてきましたよ。[l]\n……僕は、」","「……都跑题跑得和道具小姐有一拼了。[l]\n……我呢，」"],["「誰だっけそれ？[l]\nそれより、」","「那是谁来着？[l]\n比起那个，」"],["と宮さんが僕の発言を遮った。","宫小姐打断了我的话。"],["「♂♀がこれから","「♂♀接下来要"],["眼","眼"],["合いをって時に、\nギャラリーがわんさといたらやりにくいでしょぉ？[l]\nそれとも、[l]\n……まさかまこくん、[l]\n視られながらの方が燃えるとか」","合体的时候，\n围观群众乌泱泱的话会很难办吧？[l]\n还是说，[l]\n……难道小真，[l]\n被看着反而更来劲？」"],["「──。[l]\n確かに僕は、\n二人以上と同時に会話するのが苦手です。[l]\n集団の中で、自我を押し出して主張するのがキライです。[l]\n対象がブレて集中出来ませんから。[l]\n話すなら、話す相手が定まってないと、\n集団に属するなら、自分の立ち位置が確定してないと、\n僕は落ち着かない、どうしていいかわからない、\nでも、」","「──。[l]\n确实我，\n很不擅长同时和两人以上对话。[l]\n讨厌在群体中突出自我主张。[l]\n因为对象模糊会无法集中。[l]\n要说话的话，对象不明确就，\n要属于群体的话，自己的定位不确定就，\n我会不安、不知所措、\n但是，」"],["これからは。","从今往后。"],["まるであなたたちのようで皮肉だけど、\nそういう相対的な構造よりももっとヨキものが、\nあるのだと。[l]\nそれはあなたたちや彼女達との関わりで気付いた、\n今更ながら、\nでもまだ手遅れでないのなら、","虽然讽刺得和你们如出一辙，\n但存在着比那种相对结构更美好的事物，\n我是这么认为的。[l]\n这是通过与你们和她们的相处才察觉到的，\n事到如今，\n但如果还来得及的话，"],["「僕はヒトのなかで、\n何が良いのか迷いながら生きていきます。[l]\n白と黒、[l]\n全てがはっきりと振り分けられぬがこの世界です。[l]\nスキかキライかでモノを視るのは避けられなくとも、\n全てが計算や法則で出来ている世界であれ、\nそう割り切って、[l]\n──悲しみも喜びも超越した振りをするよりは、\n素直に、時に姑息、そういう曖昧さを併せ持ち、\n清濁併せ呑みながらも、\n善悪なんてものは存在しないと知りながら、\nそれでも善きものとして在ろうと思う、\nそう思うことが出来る、\nヒトとしてそういう健全な、」","「我在人类之中，\n一边迷茫着什么是好的，一边活下去。[l]\n白与黑，[l]\n这就是个无法截然划分的世界。[l]\n即便无法避免用喜欢或讨厌的眼光看待事物，\n就算世界是由计算与法则构成的，\n与其这样一刀切地，[l]\n──装作超越悲伤与喜悦的样子，\n不如坦率地、偶尔狡猾地，保有这种暧昧，\n在兼容清浊的同时，\n明知善恶之类并不存在，\n却仍想作为善者存在，\n能够这样想的，\n作为人类这样健全的，」"],["大神のような、","像大神那样的，"],["Ｃとは違う、Ｄ──","与C不同的，D──"],["「なぁんか、\nスルーされたっぽくてアレですね、[l]\nすっごい宮がすべったみたいでヤな感じです。[l]\n前のまこくんだったら──[l]\n……ってあれ？[l]\n今更だけどどっち？[l]\nまこくん……？[l]\nで合ってる？のかな？」","「总觉得，\n好像被无视了有点那个呢，[l]\n超级像宫搞砸了的感觉真糟糕。[l]\n要是以前的小真的话──[l]\n……啊咧？[l]\n现在才问是哪边？[l]\n小真……？[l]\n这样对吗？大概？」"],["「僕は、僕です。[l]\nミルハ……宮さん。[l]\nあなた──と僕が、勘違いしてただけで」","「我就是我。[l]\n米尔哈……宫小姐。[l]\n只是你──和我，搞错了而已」"],["「んむ？[l]\n勘違い？」","「嗯？[l]\n搞错了？」"],["「……ここで詳しく説明すんのも場違いですが、[l]\n僕はイツワのイーハであり飯窪真言です。[l]\n上書きでも仮置きでもなんでもなく、\n単に忘れていた、それだけです。[l]\n僕はずっと──あの時から今までも、\nずっと僕のままでした」","「……在这里详细说明也不太合适，[l]\n我是伊兹瓦的伊哈，也是饭洼真言。[l]\n既不是覆盖也不是暂存，\n只是忘记了，仅此而已。[l]\n我一直──从那时到现在，\n都始终是我自己」"],["そして無論、言い出さなかったけれども、[l]\n僕があなたを信用してなかったという証、[l]\nそしてあなたの兄さんの、[l]\n……否、[l]それこそこのひとには言える事ではない。","当然，虽然没说出口，[l]\n这也是我不信任你的证据，[l]\n还有你哥哥的，[l]\n……不，[l]这些事本不该对这个人说。"],["「……あははははは」","「……啊哈哈哈」"],["「イツワ……否、[l]\nまこくんらしいと言えばまこくんらしいですね。[l]\nあははは、うひひ……[l]\nそして、」","「伊兹瓦……不，[l]\n要说像小真也确实像小真呢。[l]\n啊哈哈，呜嘻嘻……[l]\n然后，」"],["「雫のフラグ立ての一環でもあるってとこかな。[l]\n三重偉大は顕現──[l]した訳だ」","「也算是为雫立flag的一环吧。[l]\n三重伟大显现──[l]就是这么回事」"],["「……いえ、[l]\n加えて魔眼の刺し手でもある僕は、\nさしずめ四重偉大とでも言いましょうか、\nこの四ツ目の仮面のように」","「……不，[l]\n再加上作为魔眼杀手的我，\n或许该说是四重伟大吧，\n就像这四目假面一样」"],["「んむ？[l]\nお、そうなる？[l]\nあ！[l]\nそれで思い出したっ。[l]\n","「嗯？[l]\n哦，是这样吗？[l]\n啊！[l]\n这么说我想起来了。[l]\n"],["四重奏団の連中、一体──ってあれ？[l]\nそれ、似てるけど、\nキリアケじゃ……ない？[l]\nおよ？」","四重奏团那群人，到底──啊咧？[l]\n那个，虽然很像，\n不是雾明……吗？[l]\n咦？」"],["「……何を今更的な話に、[l]\n急に沢山気付き出しましたね……[l]\nそれも、最強の白ミルハの余裕がなせる業ですか」","「……现在才说这种话，[l]\n突然注意到好多事呢……[l]\n这也是最强白米尔哈的余裕使然吧」"],["「んむ、まっねー。[l]\nそういう訳で説明はしなくても結構だけど。[l]\n何であろうと軽くいなしてあげるから。[l]\n大体、まこくんは、\n『ソフトウェアを遣う事』は出来ても、\n設計技術的な話分かんないだろし」","「嗯唔，真哥。[l]\n所以说不解释也没关系啦。[l]\n不管什么事我都会轻松应付过去的。[l]\n反正小真你啊，\n『使用软件』倒是能做到，\n但设计技术之类的话题根本不懂吧」"],["「……ええ、[l]\nまあ、仰る通り」","「……是啊，[l]\n嘛，您说得对」"],["──そう、[l]\n僕はアナクロ趣味なんだ、[l]\nあなたや大神と特に違うところは、[l]\n例えば、[l]\n僕はパソコンが苦手、いや、厭うてるといってもいい。[l]\n自分で把握できる、掌握できる領域を越えたツールを使うのは、\n落ち着かないというか、\nだから、","──没错，[l]\n我就是个复古爱好者，[l]\n和你还有大神特别不同的地方在于，[l]\n比如说，[l]\n我不擅长电脑，不，应该说厌恶更准确。[l]\n使用超出自己理解范围、掌控范围的工具，\n该说是心神不宁吧，\n所以，"],["ＣＡＴのチカラにも執着はない。","我对CAT的力量也没有执念。"],["僕がデータより実際の書籍が好きというのも、\n趣味嗜好云々よりもそういうのが根底に在るのかも知れない、\n勿論、\nあれば便利で効率的であろうことも承知してる、\nそれにアナログだったり単純なもの、\n物理的に在るモノならば掌握出来るというのも、\n思い込み、幻想に過ぎない、\nでも、[l]\n僕には合わないんだよ、\n僕自身がこういう思考をするのも、\nヒトの肉を持ちたる故かも知れない、\n自分の関知してない、出来ない所で、\n何かが起きてるというのは、\n不安で仕方なくって、","比起数据我更喜欢实体书这件事，\n与其说是兴趣偏好，可能更源于这种底层逻辑，\n当然，\n我也知道有那些会更方便高效，\n而且模拟信号或单纯的东西，\n认为物理存在的事物就能掌控，\n也不过是妄想和幻觉，\n但是，[l]\n就是不适合我啊，\n我自己会产生这种想法，\n或许正是因为拥有人类血肉之躯吧，\n在无法感知、\n无法触及的领域发生着什么，\n这种不安简直难以忍受，"],["……そう言えば、想像力は諸刃の剣だと、[l]\nそういう言葉もあった、","……这么说来，想象力是把双刃剑，[l]\n好像也有这种说法，"],["だから、","所以，"],["だから、[l]\n直接話を、言葉を僕自身の口から伝えたくて、\nきた。","所以，[l]\n我才想亲自用话语、\n当面传达。"],["「そろそろ、\n立ち話も飽きてきた？[l]\n２人でミリアムでも追っかけるって手もあるけど、\n何やら思い詰めてますねまこくん？[l]\nその様子じゃ、[l]\n私とどーおしても、シたいのかな？[l]\nいいよぉ、\nじゃーあぁ、\nその謎のＣＡＴがどんなもんか、\nみせてみてくださいな♪」","「差不多，\n站着聊也腻了吧？[l]\n虽然也可以两个人去追米莉安姆，\n但小真你好像特别执着呢？[l]\n看这架势，[l]\n无论如何都想和我doi吗？[l]\n可以哟～\n那就～\n让我见识见识\n那个神秘的CAT到底有多厉害吧♪」"],["「……わかりました。[l]\nでも、\nその前に、」","「……明白了。[l]\n但是，\n在那之前，」"],["その前に。","在那之前。"],["勿論、","当然，"],["もちろんっ、","当然啦，"],["「勿論返事は分かってるけどっ、\nこれだけはどうしても、\nはっきり言っておきたいんだよっ」","「当然知道你会答应啦，\n唯独这件事\n无论如何都想先说清楚啊」"],["「？[l]\nなんでしょう」","「？[l]\n什么呢」"],["「すきです──」","「喜欢你──」"],["「僕は貴女が好きだ、[l]\n痛い程大好きだ、[l]\n再会したときからずっと貴女が、\n貴女だけが、[l]\n好きでした。[l]\n貴女の事を考えるだけで、\n胸を締め付けられた、[l]\n貴女と会えない時は辛かった、\n相手にして貰えた時はそれだけで、[l]\n尻尾があれば千切れる程に振ってたと思う、\nそれくらいに、[l]\nそれくらいにっ、[l]\n……貴女が大好きでした」","「我喜欢你、[l]\n喜欢到心痛的地步、[l]\n从重逢的那一刻起就一直是你、\n只有你、[l]\n让我喜欢。[l]\n光是想到你的事、\n胸口就像被紧紧揪住、[l]\n见不到你的时候痛苦难耐、\n能得到你回应的时候、[l]\n要是有尾巴都会摇到断掉、\n就是这般、[l]\n就是这般、[l]\n……我曾深爱着你」"],["「……[l]それはどうも」","「……[l]那可真是」"],["「でも、今はもう、」","「但现在、」"],["キライです。[l]\n　　顔も視たくないし声も聞きたくありません。[l]\n　　貴女は僕の最も軽蔑する類の存在の中のひとりです。","我讨厌你。[l]\n　　脸不想看声音也不想听。[l]\n　　你是我最鄙视的那类人之一。"],["「僕は、」","「我、」"],["あなたのことが、[l]\n　　だいきらいだ。","对你、[l]\n　　讨厌至极。"],["「……はー……[l]\nすっきりしました」","「……哈……[l]\n痛快多了」"],["「で？[l]\nキミの中だけでのケジメはついた訳ね？[l]\nもういい？」","「所以？[l]\n你单方面了结完了？[l]\n可以了吗？」"],["「ケジメ……そう、[l]\nケジメですよ。[l]\n僕等","「了结……对、[l]\n就是要了结。[l]\n我们"],["男には、[l]Ｙの保持者には、\n貴女方には絶対にワからない、[l]\n","男人、[l]Y染色体持有者、\n是你们绝对无法理解的、[l]\n"],["どうしようもない抑え","无法抑制的"],["難い、[l]\n外に出さなきゃ溢れてしまうような、[l]\n熱い","难以、[l]\n不释放就会满溢而出的、[l]\n炽热"],["滾りがあるんですっ、\nたとえ","冲动啊、\n即便"],["詰られようがっ、」","被嘲笑也罢、」"],["ぎゃいぃぃぃーーーん","嘎咿咿咿咿——"],["「軽蔑されようがっ、\nはっきりと立ち位置を確定させなきゃ、\nいらぬ想像に身を苛まれるからっ、」","「就算被鄙视、\n也必须明确立场、\n否则会被多余的想象折磨、」"],["ぼすっ！！！","咚！！！"],["「貴女方は遊びのつもりでしてるかも知れないですが、[l]\nそんなちょっかいに、[l]\n心身削らされてまで、[l]\n付き合わされるのは、[l]\nもう金輪際御免なんですっ！！！」","「你们或许觉得这只是游戏、[l]\n但为了这种、[l]\n消磨身心的、[l]\n无聊把戏、[l]\n我再也不要奉陪了！！！」"],["ぶあぁん！！","呜哇！！"],["「……あーあ、[l]\n地雷踏みですよね、\nこういうのは」","「……啊啊、[l]\n踩到地雷了呢、\n这种话题」"],["「は？！」","「哈？！」"],["「いいです。[l]\n言ってワカルようなら、\nそんな地雷をそもそも踏まないし」","「无所谓。[l]\n要是能说通、\n一开始就不会踩地雷」"],["「……っ」","「……呜」"],["……恐ろしく、[l]\nイヤな気分になる。[l]\n先程からのシロとの攻撃も、[l]\n避けられるか防がれてる。[l]\nが、何より精神面に、\n今の言葉は、","……令人毛骨悚然、[l]\n极度不快。[l]\n方才与白刃的交锋、[l]\n还能躲避或格挡。[l]\n但此刻的话语、\n却冰冷而深刻地、"],["冷たく、深々と、刺さった。","刺穿了精神防线。"],["「大体、まこくんが言ってる事は、[l]\nそれはそっちの都合というか勝手な感想でしょぉ？[l]\n宮が、\n好きになってと一言でも頼みましたか？」","「大体、小真说的话、[l]\n那不过是你那边的借口或者说任性感想吧？[l]\n宫、\n有说过一句要你喜欢上我吗？」"],["「……自分の都合の良い所では論理を持ち出して、[l]\nそれ以外では自分の望む結果を満たすために、\nあらゆる不条理を貫く癖に……」","「……在自己方便的时候就搬出逻辑、[l]\n其他时候为了达成自己期望的结果、\n明明有贯彻所有无理取闹的毛病……」"],["「んむ？[l]\n何か言いたいの？[l]\nほんとなら、\nとっくにウザいの一言で終わらせてるよまこくん？[l]\n他の女子に言ってたら、\n怖がられるよドン引きされるよ？[l]\n止しなよこういうの。[l]\n無粋もいいとこだしさぁ。[l]\nキミならワカルと思ってこう説明もしてあげてるけど、\n本来ならば、一蹴されておわりだよ？[l]\n兎に角こっちはね、\n","「嗯唔？[l]\n想说什么吗？[l]\n要是真的、\n早就用一句'烦死了'结束对话了哦小真？[l]\n对其他女生说这种话、\n会被害怕会被嫌弃的哦？[l]\n适可而止吧这种把戏。[l]\n不识趣也要有个限度啊。[l]\n因为觉得是你能理解才这样解释的、\n本来嘛、应该直接一脚踢开就完事了哦？[l]\n总之我们这边啊、\n"],["自","自"],["己","自身"],["満","满"],["足に付き合うような、[l]\n","足才没空陪你玩、[l]\n"],["優","优"],["し","穿"],["く","柔"],["暖かい","温暖"],["理","理"],["想","想"],["の","的"],["女","性也说过、"],["性でも何でもないの」","性之类的东西根本不存在」"],["しぃーーーーーん……","咝——————……"],["僕は、","我、"],["肩の力をすっと抜いた。","肩膀的力道突然卸去。"],["あなたこそ、","你才是、"],["僕の地雷を踏んで踏んで、[l]\n踏みまくってるんだ宮さん。","在疯狂踩我雷区的、[l]\n宫小姐。"],["「──ええ、そりゃそうでしょうね、\nわかってます。[l]\nそう思います。[l]\n貴女方……いえ、あなたは、[l]\n自分の思うとおりの、望むかたちより先への、\n想定外の侵入は、[l]\n断固拒否してくるんですもんね、[l]\nでもそれはこちらとてそうだと思います、\nお互い様のことだと思います、[l]\nそれを遣り過ごしたり諦めたりしながら、\n世の中の♂♀は、\n何とかやっていってるんだろって思うけど、[l]\nそれを","「──哎哎，确实是这样呢、\n我明白的。[l]\n我也这么想。[l]\n您……不、你、[l]\n对于超出自己预想、先于期望形式的、\n意外侵入、[l]\n都会坚决拒绝呢、[l]\n但我觉得这边也是一样、\n彼此彼此的事情、[l]\n大家不都是互相妥协着放弃着、\n世间男女、\n才能勉强维持下去的吧、[l]\n但"],["許せないのがきっと貴女なんだ、\nですから、」","无法容忍这点的肯定是你、\n所以说、」"],["──息が、\n詰まりそうで。[l]\n涙が出そうなくらいに。","──呼吸、\n快要窒息的程度。[l]\n几乎要哭出来的程度。"],["だから僕は一瞬間を空けた。[l]\n素早く大きく、冷たい息を吸い込んだ。","所以我刻意停顿了一瞬。[l]\n迅速而深深地吸了口冰冷空气。"],["「……まあ、そういうことで、[l]\n貴女への想いは、今言葉にして、\nジイでも何でもどう受け取って貰っても結構、\n大体ぶちまけました。[l]\nこれからは、\n………、[l]\n愚痴はもう言いません。[l]\n今言った通り、これからは、\n──冷静な思考、\nお仕事の……いえ、[l]\n","「……嘛、总之、[l]\n对你的心意、现在用语言、\n就算被当成老头唠叨怎样理解都随便、\n基本都倒干净了。[l]\n从今往后、\n………、[l]\n牢骚不会再说了。[l]\n就像刚才说的、今后、\n──是冷静思考、\n工作……不、[l]\n"],["お●●●の時間です、\nミルハ」","是●●●的时间了、\n米尔哈」"],["「……は？」","「……哈？」"],["宮さんは、\n急に叫んだ。","宫小姐突然\n大声喊了起来。"],["「何も聞こうとしなかったくせにっ、\n保身の自己完結って訳だ、[l]\n♂ってのはほんっとにだっせぇなあ、\nだから結局──」","「明明什么都没想听我说，\n不过是自我保全的漂亮话，[l]\n♂这种生物真是逊爆了，\n所以到头来──」"],["「聞くまでもっ、\nないでしょっ、\nあなたは──」","「根本没必要\n听你说，\n因为你──」"],["ぎあーーーーーぁぁん","嘎啊啊啊啊啊"],["……今更っ、[l]\n今更勝手な事をっ！","……事到如今、[l]\n事到如今还这么任性！"],["愚痴はもう言わないって言ったけど、\n言ったけど！！！","虽然说过不会再抱怨了、\n虽然说过！！！"],["「……ちっ、[l]\nそれにっ、[l]\n無粋結構、\n僕は野暮の極みのようなもんですからねっ、[l]\n何しろ生まれはこんな北の地、\n妖怪をあしらった旅館の経営者が親族、\n粋なんてモノは糞喰らえ、なんです、[l]\nミエやなんだのや、[l]知ったことか、[l]\nあなたが勝手に設えたテストの、[l]\n採点なんかされたくはない！！！[l]\n僕の行為に正解不正解を判定して、\n地雷がどうとか、[l]\nそれはこっちの台詞だ！！」","「……切、[l]\n再说了、[l]\n风雅免谈、\n我就是个俗到骨子里的家伙、[l]\n毕竟出生在这北方穷乡僻壤、\n亲戚是经营妖怪旅馆的、\n风雅什么的吃屎去吧、[l]\n什么见鬼的体面啊、[l]关我屁事、[l]\n你自己擅自搞出来的测试、[l]\n谁要你评分啊！！！[l]\n对我的行为指手画脚、\n说什么踩雷不踩雷的、[l]\n那是我要说的！！」"],["「ついてない格好をつけてみたところで、\n結局自分の想定の外側から責められるのが怖いんだろ！[l]\n予防線張っといて傷付かないようにしたいだけなんだろ！」","「就算摆出副倒霉相、\n说到底不就是怕被超出预想的状况打击吗！[l]\n提前设好防线不就是不想受伤吗！」"],["「貴女だっ……て！[l]\nそうだろうが！！！[l]\n粋だ何だって言って、言い訳にしか聞こえねえんだよ！！！[l]\nはっきりキライと言ってさえくれりゃ、」","「是你……啊！[l]\n没错吧！！！[l]\n说什么风流不风流的，听起来全他妈是借口！！！[l]\n哪怕你干脆说讨厌我，」"],["……ながく苦しむ事もなかったのに……っ！！！","……也不用痛苦这么久……啊！！！"],["「キライではないですよ」","「不是讨厌哦」"],["……。",""],["「でも♂♀の……[l]\n","「但要说能否成为♂♀的……[l]\n"],[" 伴"," 伴"],["侶の関係になれるかって言ったら、\n答えは","伴侣关系的话，\n答案是"],["Ｎ ",""],["ｏ」",""],["わかってる、わかってるけど、","我知道的，虽然知道，"],["「兎も角さあ、\n理由とか心情とか、[l]\n得手勝手に解釈されたままだとこっちだって不本意だっての。[l]\nさっき自分で言ってたようだけど、\n私は私の深ぁい理由で、\nまこくんとは、できま──」","「总之啊，\n理由啊心情啊，[l]\n被擅自解读的话我这边也很不情愿啊。[l]\n虽然刚才你自己也说过，\n我出于自己深刻的理由，\n和小真是没法──」"],["「いちいち言わないでいいですっ。[l]\nまともにぶつけ合うには、\n♂と♀では","「不用——说明白了。[l]\n要正面对决的话，\n♂和♀之间"],["式が違い過ぎる、[l]\n何から何まで、\n会話ですら同じステージで行われていない！[l]\n価値観の優先順位も情報整理の仕方も取捨選択も、\n肉のレベルから違う僕と貴女では、」","公式差太多了、[l]\n从里到外、\n就连对话都不在同一个次元！[l]\n价值观的优先级也好信息整理方式也好取舍标准也好、\n从肉体层面就不同的我和妳之间、」"],["──自分を、世界を、\n虚構をそうと承知で己から騙されていかなけれりゃ、","──若不主动欺骗自己与世界、\n明知虚构却甘愿沉溺其中、"],["つらいだけの、\nかなしいだけの、\n冷徹で無慈悲なこの、\n最悪の箱庭で、\n","就只剩下痛苦、\n只剩下悲伤、\n在这冰冷无情的、\n最恶劣的箱庭里、\n"],["界を","将境界"],["維","维"],["持する為、\nそれだけの為に相争って存続しようとする意思存在として、[l]\n『眼をもつ主観』として\n未来永劫誰かが『そこ』に在るためになら、[l]\nどんな悲しみも苦しみも許容するこの、","为了持有，\n仅仅为此而作为相互斗争谋求存续的意志存在，[l]\n作为『拥有眼睛的主观』\n若为让谁永远存在于『那里』，[l]\n连任何悲伤痛苦都能容许的这个，"],["世界で生きていくのはきついのに、","要在世界活下去明明很辛苦，"],["「噛み合わない会話ですらも、\n貴女の中では、\n自己、そして自分の意見がしっかりと中心に据えられているから、\n何にも支障がない、\n僕等のように社会との相対的な位置で己を測る遣り方では、\n到底太刀打ちの出来ない武装ですよね！[l]\n決めた事項ありきで構築されるその論理は、\n僕のように『話せばワカル』という幻想を抱くモノにとって、\n理屈や論理や社会の中で生きてきた論法では、……っ」","「就连无法契合的对话，\n在你之中，\n因为自我和自己的意见都牢牢占据着中心，\n所以毫无妨碍，\n像我们这样用与社会相对的位置来衡量自己的方式，\n根本是无法抗衡的武装呢！[l]\n以既定事项为前提构建的那套逻辑，\n对于像我这样抱着『说了就能懂』幻想的人来说，\n用道理或逻辑或社会生存法则来应对的话，……」"],["ぜったいにつなぎ止めることは、\nましてや射止めることなんて、","绝对无法维系住，\n更别说抓住了，"],["──できない……っ！！！！","──做不到……！！！！"],["「……ヒートアップしてきたなぁまこくん。[l]\nちょと偏見に満ちた危険な言い方だぞ。[l]\n♀は♀で恐ろしく面倒な──ニンゲン関係、\n世間というのがあるからね。[l]\n♂が河原で殴り合って友情育むような単純な構造じゃ、\nないのだよ？[l]\nアナタガタとは別にね、\n肉体的な色々もあるにせよ、\nそっちを知ってれば今のまこくんの言葉、\nそうそう言えるものではない筈だよ。[l]\nそれに。[l]\n♂は♂でケモノのようにボスとそれ以外、\nというヒエラルキー構造で、\nキミの言う所の社会内部の相対的な立ち位置を、\n測る遣り方で自分の価値やなんやを夢想するのだろ。[l]\nだから、\n自分という絶対中心が無いから、\n社会の内部における相対的位相、\n立ち位置が、\nずれたり崩れたりしただけで、\nあっさり駄目になるのが君等だろうよ」","「……热血上涌了呢小真。[l]\n这可是充满偏见的危险发言哦。[l]\n♀有♀特有的可怕麻烦──人际关系，\n毕竟存在着世俗眼光啊。[l]\n♂在河滩打架培养友情那种简单结构，\n可不存在吧？[l]\n和你们那边不同呢，\n虽说也有肉体层面的各种因素，\n但若了解那边的情况，小真现在这番话，\n本不该能说得这么轻巧才对。[l]\n再说了。[l]\n♂有♂特有的野兽般首领与从属，\n这种等级结构，\n不就是用你所说的社会内部相对位置，\n来衡量自我价值之类的吗。[l]\n所以，\n正因为没有绝对中心的自我，\n只要在社会内部的相对相位，\n所处位置，\n发生偏移或崩塌，\n就会轻易完蛋的不正是你们吗」"],["「……それはそうでしょう。[l]\n全部が全部そうだとか違うとか、\n今そんな話をした所で詮無いので止しますが、\n要するに優劣を付けるものでは無いにせよ、\n違うって事でしょう、\n僕等は。[l]\nでも、」","「……确实如此。[l]\n并非所有都这样或那样，\n现在讨论这个也无济于事就到此为止，\n总之虽不是要分优劣，\n但就是不同对吧，\n我们。[l]\n但是，」"],["──それでも。","──即便如此。"],["「僕等はお互いを、\nそうやって、違いを誤解したまま、[l]\n絶対に解り合えないまま、[l]\nだからこそ、\n解らないのが当たり前なのなら、」","「我们彼此，\n就这样带着误解的差异，[l]\n永远无法相互理解，[l]\n正因如此，\n若说不理解才是理所当然的话，」"],["……いや、こんなことを語っても意味がない。","……不，说这些也没意义。"],["「んー」","「嗯──」"],["「……なんでも、ありません、[l]\n言うのは止めました。[l]\n……ええ、[l]\n──僕等は単なる配偶子のバリエーション、\nパターンを増やす為だけにつくられた、\n不確定性の種だ！[l]\nＹは有意識視界存在のＶを増やし、\nどうあっても先へ残そうとする為の予防線に過ぎない。[l]\nきっと本来であればＸＸだけで事足りてたのでしょう、\n魔眼質者に♂が著しく少ないのも、\n実はその辺が関係してるんじゃないですかね……っ！」","「……没什么，[l]\n我不说了。[l]\n……是啊，[l]\n──我们不过是配子的变体，\n仅为增加模式而被创造的，\n不确定性的种子！[l]\nY只是为增加有意识视界存在V，\n无论如何都要延续下去的预防线罢了。[l]\n本来单靠XX应该就足够了吧，\n魔眼质者中♂数量显著稀少，\n其实不就与此有关吗……！」"],["「……私が言うのも何だけど、[l]\n何の話してるのだろうか、今これ」","「……由我来说可能不太合适，[l]\n我们现在到底在谈什么啊」"],["「うそうそ。[l]\n私も伊達に永く在る訳じゃ無し、\n貴方の言わんとしてる事は、\nま、\n解らないとは言わないよ。[l]\nでも、」","「哎呀哎呀。[l]\n我也不是白白活了这么久，\n你想表达的意思，\n嘛，\n倒不是说不明白。[l]\n但是，」"],["「私は貴方を好きではあるけれど、\nそういう存在は貴方だけとは限らないし、\nその点を縛るつもりもない。[l]\n良いなあと思えば、\n私は誰とでも●るし、\nそれこそまこくん、\nまこくんは要するに●たいだけじゃないのかな？[l]\n先刻からＹがどうとか言ってるし」","「我虽然喜欢你，\n但这样的存在并不限定于你一人，\n也没打算束缚这点。[l]\n只要觉得不错，\n我和谁都能●，\n说到底小真，\n小真不也只是想●而已吗？[l]\n从刚才就一直在说什么Y不Y的」"],["「……それは、」","「……那是，」"],["「……ま、[l]\nとは言っても？[l]\n今までは●るに値する相手なんか、\nまるで居なかったですからね。[l]\n兄様は別格としても──\nまこくんが初めてそう思わせた●なのは確かです。[l]\nそこは悦んで良いですよ。[l]\nただ、──」","「……嘛，[l]\n话虽如此？[l]\n但至今为止值得●的对象，\n根本就没出现过呢。[l]\n兄长大人另当别论──\n小真确实是第一个让我产生这种想法的●。[l]\n这点你大可得意哦。[l]\n只不过，──」"],["「キミはヒトとして、\n健全に生きたいと言ったな？[l]\nと言うことは、[l]\n","「你说过作为人类，\n想要健全地活着对吧？[l]\n既然如此，[l]\n"],["綾目やそこのＧＷは、\nオトモダチはどうする気だ？[l]\n両方とも──」","绫目和那边的GW，\n打算怎么处置你的伙伴们？[l]\n两边都是──」"],["●●●●●だぞ。","●●●●●哦。"],["「ヒトとして生きるなら、\n当然このままにしてはおけないな？[l]\nかといって、\n償わせるにも、\n誰が信じる？[l]\nあれらの所業を」","「若要作为人类生存，\n当然不能放任现状吧？[l]\n但话说回来，\n就算要赎罪，\n谁会相信？[l]\n那些人的所作所为」"],["「……",""],["私","我"],["達の、[l]\n下に来い、\nまこくん。[l]\nそうすれば綾目だろうと其処のそれだろうと、\nそう、[l]\n","臣服于，[l]\n我们之下吧，\n小真。[l]\n这样无论是绫目还是那边的家伙，\n没错，[l]\n"],["三 ",""],["春の","就连春之"],["娘だろうと、\n好きなように保護も処置もしてやろう。[l]\n今更彼女達を殲滅しろなんて言わないよ。[l]\nだから、[l]\n……私の","少女也能，\n随你高兴地保护或处置。[l]\n事到如今不会要你歼灭她们啦。[l]\n所以，[l]\n……成为我的"],["小","家"],["姓になれ」","族吧」"],["「…[l]…[l]…[l]…[l]…[l]…[l]…[l]…[l]…」",""],["「………………」",""],["「……今は、」","「……现在，」"],["「うん」","「嗯」"],["「……脳が、[l]空転して、[l]\n判断が、[l]出来ません。[l]\nでも、」","「……脑子，[l]空转着，[l]\n无法，[l]做出判断。[l]\n但是，」"],["「僕は貴女と──[l]貴女の言葉で言うなら\n","「我必须和你──[l]用你的说法就是\n"],["ばなきゃいけない、\nそうでしょう。[l]\nだから、[l]\n……僕が負かされたら、[l]\n………貴女の言うとおりにします。[l]\nその代わり、[l]彼女達の事も、[l]\n宜しくお願いします。[l]\nでも、僕が勝ったなら──」","●才行，\n对吧。[l]\n所以，[l]\n……如果我输了，[l]\n………就按你说的做。[l]\n作为交换，[l]她们的事也，[l]\n拜托你关照了。[l]\n但如果我赢了──」"],["「……自我を通す為に、[l]\n彼女達に償いを強いる、\nそういうこと？」","「……为了贯彻自我、[l]\n强迫她们赎罪、\n就是这么回事？」"],["「…………………………」",""],["「………ま、[l]\nいいです。[l]\nまこくんが勝つ前提の話をしても、\n無意味極まりないですし？[l]\nそれに、\n言いましたが、\nヒトの法で償わせるには、状況が状況です」","「………嘛、[l]\n可以啊。[l]\n就算讨论小真获胜的前提、\n也毫无意义吧？[l]\n再说了、\n我说过的、\n要用人类的法律来赎罪、这状况根本不可能」"],["「そう……ですね。[l]\nまずは、\n貴女を負かしてから──です」","「确实……呢。[l]\n首先得、\n把你打败之后──再说」"],["……正直、","……说实话、"],["宮さんの問いには、[l]\nどうあっても、\n答えられるとは思えなかった。","对于宫小姐的质问、[l]\n无论如何、\n我都觉得自己无法回答。"],["そして、[l]\n我が身の力……","而且、[l]\n我自身的力量……"],["都","都"],["合","市"],["よ","的"],["フ","意"],["ラ","拉"],["グ","格"],["た","纳"],["て","塔"],["る","尔"],["在、[l]\n","现在、[l]\n"],["そ","那"],["強引","只能"],["に","从"],["決着","强行"],["を","了"],["つ","结"],["け","往"],["在の、[l]\nその力の発揮を切に、","在的、[l]\n迫切渴望、"],["切に願うしかなかった。","能发挥出那份力量。"],["……イーハとしての自分を思い出しても、[l]\n結局は、[l]\n流され型主人公のまま、なんだな、僕は……","……即便回想起作为伊哈的自己、[l]\n说到底、[l]\n我终究还是个随波逐流型的主角啊……"],["「んむっ、\nわかりました。[l]\nじゃあそろそろ、[l]\n","「嗯唔、\n明白啦。[l]\n那差不多该、[l]\n"],["お互いモヤモヤは水に流して、うひひ、」","把彼此的芥蒂抛进水里、嘻嘻、」"],["遊びましょう。","开始玩吧。"],["「なんだかんだ言っても、\nまこくんにしか、[l]\n──宮の相手、出来ないんですからね？」","「不管怎么说、\n能当宫小姐对手的、[l]\n──只有小真呢？」"],["「……あはは」","「……啊哈哈」"],["僭越ながら。","恕我僭越。"],["光栄です。","深感荣幸。"],["そう、やっぱり、[l]\n直接会って、[l]視て、[l]話してると、[l]\nむかついて、[l]悲しくて、[l]……でも嬉しくて、","果然啊、[l]\n直接见面、[l]看着、[l]交谈着、[l]\n就会恼火、[l]悲伤、[l]……却又开心、"],["僕は憎み合いたくない、[l]だから、[l]さよなら\n　　嫌いだけど、[l]憎んではいません。","我不想互相憎恨、[l]所以、[l]再见\n　　虽然讨厌、[l]但并没有恨你。"],["そんな冷静で御行儀の良い、\n垢抜けた思考は、[l]\n会ってしまったらすぐに飛んでしまったけれど、","那种冷静又彬彬有礼的、\n脱俗的思考方式、[l]\n在见面瞬间就烟消云散了、"],["♂♀のことなんて、[l]\nロジカルと最もかけ離れたところにある事項、[l]\nエロスだろうとなんだろうと、[l]\n本能により近い所にある精神活動だろう。","男女之事啊、[l]\n本就是最不讲逻辑的东西、[l]\n无论情色与否、[l]\n都是更接近本能的精神活动吧。"],["僕等はＹの欲動には逆らい難く、[l]\nそれに振り回される憐れな存在。","我们难以抗拒Y的冲动、[l]\n是被其摆布的可怜存在。"],["だから。","所以。"],["そうであるがゆえに、[l]断ち切ろうとつとめよう。","正因如此，[l]才要竭力斩断。"],["必死で──。","拼死也要──。"],["「……本気、出してくれるんすね、僕程度相手に」","「……居然对我这种货色动真格啊」"],["──眼前に立ち顕れるは、\n白のミルハの","──赫然显现于眼前的\n是纯白的米尔哈"],["全","完"],["動","动"],[" 様"," 整"],["式、[l]\n『大いなる紅き眼と白をまとう災』。","形态、[l]\n『披覆纯白之红瞳大灾』。"],["「あ、ただ、コトを始め……やりあう前に」","「啊不过，在开打……交手之前」"],["「んむ？[l]\nなんですか」","「嗯？[l]\n怎么啦」"],["「取り敢えず音を避難させてくださると、\n僕も遠慮せずにやれるんですけど」","「如果能先把音小姐转移到安全处，\n我就能放开手脚了」"],["「……おおう、[l]\n結構放置してたけど大丈夫かな？[l]\nお？」","「……哎呀，[l]\n一直把她晾着没问题吗？[l]\n喂？」"],["「？」",""],["「じゃすとたいみん。[l]\nおーい、こっち」","「Just timing.[l]\n喂——这边」"],["「あ」","「啊」"],["宮さんが僕の後方に向けて手を振るので、\n不思議に思い振り向くと、","宫小姐朝我后方挥手，\n我疑惑地回头望去，"],["チノ嬢が","只见千乃小姐"],["彼","那"],["Ｃ",""],["Ａ",""],["Ｔと共に、","与T一同，"],["今し方現れた所だった。","刚刚现身于此。"],["チノ嬢は僕を視て一瞬止まったようだが、\nそれだけだ。[l]\nお互いに話すことも無かった。[l]\n","千乃小姐看见我时似乎停顿了一瞬，\n仅此而已。[l]\n彼此都未发一言。[l]\n"],["彼女はすぐに宮さんと何やら会話を始め、\n音はチノ嬢と共に何処かへ消えた。","她立刻与宫小姐交谈起来，\n音小姐随千乃消失在某处。"],["それを視ながら、\n僕の心にある思考が去来する。","凝视着这一幕，\n有个念头在我心头萦绕。"],["──僕が、\n彼女に言わないまま、\nどうしても宮さんと戦わねばならない理由が、\nもうひとつある、","──还有\n一个我未曾告诉她、\n不得不与宫小姐交战的理由，\n那便是"],["最後に言われた、\nあのひとの双子の兄に。[l]\nそのことばが。","最后被告知的\n关于那个人双胞胎兄长的话语。[l]\n那句话是——"],["ボクには妹がいる、[l]\n　　最も愛する存在。","我有个妹妹，[l]\n　　是最深爱的存在。"],["でも、●●●●すぎた。","但是，●●●●过头了。"],["「おさなきものにはお仕置きを、[l]\nしなきゃいけない時がある──」","「对不懂事的孩子[l]\n有时候必须给予惩罚──」"],["強くなるというのは、","所谓变强"],["完","若已"],["す","并"],["るというのは、","非意味着"],["負けや失敗を知らない綺麗な存在のままで居ることじゃない。","永远保持不知失败为何物的完美姿态。"],["バッドエンド含めて、リストは埋めねばならない。","必须连bad end一起填满清单。"],["不可能の文字がない辞書は、","没有「不可能」这个词的词典，"],["不完全なんだ。","是不完整的。"],["それをなすのが──","能做到这点才算是──"],["「ほんとにすげぇゲーマーってことでしょ、[l]\n宮さん」","「这才是真正的顶级玩家对吧，[l]\n宫小姐」"],["……正直僕には理解の及ばない、世界だけどっ！","……虽然这世界对我而言还难以理解！"],["それこそ大神なら──","若是大神的话──"],["大神、どうなってるんだろう……","大神现在怎样了……"],["「おまたせ」","「久等了」"],["……宮さんが、[l]\n僕の前に再び立つ。","……宫小姐[l]\n再度立于我面前。"],["暗き山中、夜の闇の中、\n宮さんの白き紅きその姿は、","在幽暗山间，夜色深处，\n宫小姐那红白交织的身影，"],["懐かしき、畏れを呼び起こす、\nかつて敵対していた時そのままの、","唤起令人怀念的恐惧，\n恰如昔日敌对时的模样，"],["──うつくしくいとおしいすがた。","──美丽又惹人怜惜的姿态。"],["「……だるいデモはスキップされちゃいますからね。[l]\nさ、[l]もう我慢の限界、[l]\nはやく──」","「……无聊的DEMO可是会被跳过的哦。[l]\n来、[l]已经到忍耐极限了，[l]\n快点──」"],["こいっ！","你这家伙！"],["「……ふぅーーーー──」","「……呼～～～～──」"],["さあ、","好了，"],["ここからは、","从现在开始，"],["純粋にたたかうあいてどうし、","就是纯粹的战斗对手之间，"],["たたかって、","相互厮杀，"],["あなたを負かします。","直到把你打败。"],["「全力で、宮さん……っ！」","「全力以赴吧，宫小姐……！」"],["無敗というのは強さじゃない、[l]\n　　負けの恐怖を知らないと言うことは","所谓不败并非强大，[l]\n　　不知败北恐惧为何物"],["脆さは、時に致命的なんだよ。","这种脆弱有时是致命的。"],["弱さを知るものが優しさを知る、\n　　そういうお為ごかしを言うつもりはないよ。","知晓软弱之人才能懂得温柔，\n　　但我可没打算说这种漂亮话。"],["おとなになってからの麻疹は、\n　　重篤になり兼ねない。","成年后得麻疹的话，\n　　很可能会恶化成重症。"],["●としてもう少し早く気付くべきだった。[l]\n　　他にいるであろう本当の敵性体に、\n　　本番で負かされる前に、","●本该更早察觉到的。[l]\n　　在可能存在的真正敌性体面前，\n　　在正式对决中落败之前，"],["キミという最もあれに近づけ得る存在に、","就托付给你这个最接近那个的存在吧。"],["託そう。","希望你能明白"],["自分で出来ない歯痒さを、どうかわかって欲しい、","这种力不从心的焦躁感，"],["あのこを宜しく頼む、","那孩子就拜托你了，"],["飯","饭"],["窪","洼"],["真","真"],["言。","言。"],["あのなあカルロサ。","我说啊卡尔罗萨。"],["あんたの言ってる事は相変わらず過保護で、[l]\n自分勝手で、[l]\n駄目押しに他人を巻き込みまくるっていう、[l]\n極め付きに傍迷惑な話だよ。","你说的话还是那么过度保护，[l]\n又自私自利，[l]\n最后还要把别人卷进来，[l]\n简直是最极品的给人添麻烦。"],["でもそれを承諾したのも、[l]僕の、[l]僕自身の決断だ。","但答应这件事的，[l]也是，[l]我自己的决定。"],["今、こうしてあのひとと遣り合える役を、[l]\nあんな昔から割り振ってくれた事にだけは、[l]\n感謝してるよ。","现在能像这样担任和她交手的角色，[l]\n光是早在当年就分配好这件事，[l]\n我就很感激了。"],["だから精精、","所以尽管"],["あんたの望みが叶う事を祈っててくれ。","祈祷你的愿望实现吧。"],["猫の王の封印、[l]\n","猫之王的封印，[l]\n"],["僕","仆"],["と","如此"],["冬","冬"],["夏のこめしもの、","夏之供物，"],["「",""],["Seal",""],["\"O\"、[l]\nいくぞ！！！！！！！！！！」","\"O\"，[l]\n上了！！！！！！！！！！」"]],"context":[["SC_M_075.ks/index/1/text"],["SC_M_075.ks/index/3/text"],["SC_M_075.ks/index/5/text"],["SC_M_075.ks/index/8/text"],["SC_M_075.ks/index/10/text","SC_M_075.ks/index/549/text"],["SC_M_075.ks/index/12/text"],["SC_M_075.ks/index/14/text"],["SC_M_075.ks/index/16/text"],["SC_M_075.ks/index/19/text"],["SC_M_075.ks/index/21/text"],["SC_M_075.ks/index/23/text"],["SC_M_075.ks/index/25/text"],["SC_M_075.ks/index/27/text"],["SC_M_075.ks/index/29/text"],["SC_M_075.ks/index/31/text"],["SC_M_075.ks/index/33/text"],["SC_M_075.ks/index/35/text"],["SC_M_075.ks/index/37/text"],["SC_M_075.ks/index/39/text"],["SC_M_075.ks/index/41/text"],["SC_M_075.ks/index/43/text"],["SC_M_075.ks/index/45/text"],["SC_M_075.ks/index/47/text"],["SC_M_075.ks/index/49/text"],["SC_M_075.ks/index/51/text"],["SC_M_075.ks/index/53/text"],["SC_M_075.ks/index/55/text"],["SC_M_075.ks/index/57/text"],["SC_M_075.ks/index/59/text"],["SC_M_075.ks/index/61/text"],["SC_M_075.ks/index/63/text"],["SC_M_075.ks/index/65/text"],["SC_M_075.ks/index/67/text"],["SC_M_075.ks/index/69/text"],["SC_M_075.ks/index/71/text","SC_M_075.ks/index/680/text","SC_M_075.ks/index/705/text"],["SC_M_075.ks/index/73/text"],["SC_M_075.ks/index/75/text"],["SC_M_075.ks/index/77/text"],["SC_M_075.ks/index/79/text"],["SC_M_075.ks/index/81/text"],["SC_M_075.ks/index/83/text"],["SC_M_075.ks/index/85/text"],["SC_M_075.ks/index/87/text"],["SC_M_075.ks/index/89/text"],["SC_M_075.ks/index/91/text"],["SC_M_075.ks/index/93/text"],["SC_M_075.ks/index/95/text"],["SC_M_075.ks/index/97/text"],["SC_M_075.ks/index/99/text","SC_M_075.ks/index/215/text","SC_M_075.ks/index/217/text","SC_M_075.ks/index/589/text"],["SC_M_075.ks/index/101/text"],["SC_M_075.ks/index/103/text"],["SC_M_075.ks/index/105/text"]