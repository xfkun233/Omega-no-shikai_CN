end":27899}],[{"start":27936,"end":27951}],[{"start":27957,"end":27970}],[{"start":27976,"end":27998}],[{"start":28070,"end":28075}],[{"start":28081,"end":28090}],[{"start":28127,"end":28140}],[{"start":28174,"end":28200}],[{"start":28206,"end":28222}],[{"start":28228,"end":28245}],[{"start":28317,"end":28333}],[{"start":28375,"end":28385}],[{"start":28456,"end":28468}],[{"start":28474,"end":28480}],[{"start":28542,"end":28551}],[{"start":28557,"end":28565}],[{"start":28571,"end":28583}],[{"start":28597,"end":28604}],[{"start":28610,"end":28631}],[{"start":28637,"end":28643}],[{"start":28657,"end":28678}],[{"start":28684,"end":28695}],[{"start":28701,"end":28716}],[{"start":28722,"end":28738}],[{"start":28744,"end":28746}],[{"start":28830,"end":28862}],[{"start":28868,"end":28888}],[{"start":28925,"end":28964}],[{"start":28970,"end":29006}],[{"start":29012,"end":29025}],[{"start":29089,"end":29095}],[{"start":29101,"end":29113}],[{"start":29119,"end":29142}],[{"start":29148,"end":29160}],[{"start":29197,"end":29247}],[{"start":29253,"end":29260}],[{"start":29266,"end":29279}],[{"start":29313,"end":29340}],[{"start":29346,"end":29350}],[{"start":29412,"end":29417}],[{"start":29423,"end":29448}],[{"start":29454,"end":29467}],[{"start":29473,"end":29497}],[{"start":29534,"end":29560}],[{"start":29566,"end":29576}],[{"start":29582,"end":29590}],[{"start":29626,"end":29643}],[{"start":29649,"end":29657}],[{"start":29663,"end":29673}],[{"start":29707,"end":29714}],[{"start":29720,"end":29769}],[{"start":29805,"end":29819}],[{"start":29825,"end":29842}],[{"start":29856,"end":29866}],[{"start":29872,"end":29903}],[{"start":30003,"end":30032}],[{"start":30038,"end":30045}],[{"start":30059,"end":30094}],[{"start":30108,"end":30150}],[{"start":30164,"end":30197}],[{"start":30211,"end":30259}],[{"start":30273,"end":30287}],[{"start":30293,"end":30306}],[{"start":30312,"end":30331}],[{"start":30345,"end":30361}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_005.ks","basename":"SC_M_005.ks","indexIds":{"目が覚めた。":0,"初日だったし、神経高ぶって眠りが浅くなるんではと\n思っていたが、\n部屋の時計を見るとすでに午前九時を回っていた。":1,"夕べ就寝直前に宮さんと話し合い、\n午前中には三春の家に行く予定――僕一人だけど――だったので、\nさっさと支度をすることにする。":2,"入浴し損ねたので、シャワーを浴びる時間も必要だし。":3,"旅行先でいっつも思うことだが、\n知らないところで目が覚めると違和感あるなあ。":4,"ま、長期滞在になるんだろうし嫌でも慣れることだろう。[l]\n宮さんが入ってこないうちに着替えよう。":5,"「ご飯が先ぃ～？[l]\nお風呂が先ぃ～？[l]\nそれとも…てまこくん、":6,"ノリ悪いなあ」":7,"「…おはようございます。[l]\n朝からどんなテンションなんですか。":8,"現実的な話で言わせて貰えば、\n朝食の後でシャワーを浴びたいんですけど」":9,"「んむー。今日から別行動だっていうのにつれないです。":10,"愛がないすねまこくん。":11,"ダメ人間すねまこくん」":12,"愛がどうこう言うんだったら、誰か付き添い付けてくれるなりの\nフォローをして欲しい。[l]\nもっとも顔割れしてない人間は僕だけなので、\nどうしようもないんだが。[l]\n昨日三春のお嬢様と目が合いはしたが、\nまさか覚えられてるってことはない…よなあ。":13,"結局、まずは試しに、一見余所者の僕が旅行中の好事家を装って、\n三春家にご神体閲覧のお伺いをしてみることにしたのだった。[l]\n一応嘘は言ってない。言ってないことがあるだけだ。[l]\n望みは薄いが、出来ることからやっていく精神で。[l]\n後々の行動に支障を来さないかどうかが心配ではあるが、\n宮さんも知狡さんも特に反対しなかったので、\n今日は一人で行動決定。":14,"「それより…[l]\n今日の朝飯大丈夫でしょうね」":15,"「…と思います…[l]\nきつく言いつけましたから…」":16,"真面目が取り柄の知狡さんは、\nちゃんと宮さんの言いつけを守って、\n今後一切料理には手を出さないことにしたらしい。":17,"その誓いの証として、どうやったんだかまっぷたつに折れた包丁を、昨夜宮さんに献上しに行ったという。":18,"…ともあれ、今後は調理場のまかないが出るということのようだ。[l]\n本家泊まりを選択してたらどうなっていたんだか…":19,"さっぱりとした日本食の朝食を久々に堪能し、\n腹ごなしのちにシャワー。":20,"さすがに逗留してる間中大浴場に入る訳にもいかないので、\n従業員が使ってるらしいスタッフオンリーの方である。":21,"水質としては一緒だから、効能は得られるはずなんだが、\nバスタブ＆シャワーノズル、小さな個室というだけで、\n失礼な言いぐさだけれども有難味など毛ほども無くなってしまう。":22,"逆に言えばロケーションさえ整えれば水道水だろうがなんだろうが、その気になれるんだろうな。":23,"偽薬効果偽薬効果。[l]\n昨日の知狡さんの台詞じゃないが、\n個人の気持ちの持ちようさなあ。":24,"さーて、やっとすっきりした気がする。[l]\n部屋へ戻って準備開始。":25,"ロビーに行く前に『白沢』に来て、宮さんに挨拶をする。":26,"「じゃ行ってきます。[l]\nまた今夜」":27,"「はい。気を付けて。[l]\nじゃあ…」":28,"「おでかけのちゅー？[l]\nしちゃろうか？」":29,"「んむぅ！？[l]\nまこくんのえっちめ！！[l]\n":30,"ばいばいーっだ！！」":31,"ぱたたた…と走り去る宮さん。":32,"先手を打つに限るよ。":33,"なんというか…もう。[l]\n僕だって健全な男子なんだということを\n忘れないで頂きたい。":34,"さて、昨日とはうって変わって今日はいい天気だ。[l]\n出かけよう。":35,"お昼時を避けたほうが礼儀なんだろうが、\n一直線に三春家に向かうのもどうかと思い、":36,"そこらの人にそれとなく蔵や祭、\n『月狂跳』に関連しそうな話やネタを聞きつつ過ごした。":37,"普通なら喪中やら何やらで接触は憚れるのかも知れなかったが、\n密葬だとか言ってたしどうなってるのか分からない。":38,"いっそ普通の通夜とかなら焼香装って潜入できるのにな。[l]\n――と、潜入してどうする。":39,"少なくとも現時点ではそれが目的ではない。[l]\nとりあえず観光マップみたいなパンフレットは旅館で貰ったので、それと土地感覚を一致させつつうろうろする。":40,"後でちゃんとした地図は買おう。[l]\nパンフ見ながら歩いた時点で、\n幼少時の記憶なんか全く使えない事が判明したし。":41,"というかそもそも記憶自体がほっとんどないのだから当然なんだが。[l]\n実地でうろつけば思い出すかと思ったのだが、\n見通しは甘かったようだ。":42,"元来旅行好きな僕としては、\nこういう田舎観光地を歩くというのは大変に気分がいい。[l]\n仕事とはいえ今のところは気楽なもんだ。":43,"あとで廻ってみたい名所やら結構あるし、\nちょっとテンションあがってきたぞ。[l]\nもの凄い静かーだけどな…":44,"レンタカー屋もないのに、\n一人旅行者が車を運転してるのもどうかと思ったので、\nひたすら徒歩で回ってるんだが、\n…せめて自転車にしとくべきだったか。":45,"いや、それでも本末転倒じゃん。[l]\n一人車旅とか言い張って素直に旅館から車借りれば良かったかな…[l]\nああ、それもあまり三春家行くに関しては良い方法ではないな。":46,"バス停くらい権力で玄関前につくっとけよ、と思ったのだが、それも無いらしい。[l]\nご立派な自家用車があるのでバス風情なんて乗らんと言うことか。":47,"いいや、どうせもうそろそろだ。[l]\n玄ノ森の繁華の中心は旅館近くであり、\n三春家は駅前のようにほとんど寂れたような所にあるらしい。":48,"正確には、玄ノ森は六母屋近辺以外には街らしいものはなくて、散村状態の田舎町の所々に、観光地と公共施設が点在するような状況である。":49,"三春家も有力者とはいえ、格別周囲が賑わうような立地にはない、ということだった。[l]\nそう、目の前のような山の麓、田圃のど真ん中みたいな所。":50,"おお、何とか…昼飯時よりは前に着けたようだ。[l]\nちょっと緊張してくる。[l]\n何となく、尻ポケットの携帯を確認しつつ、\nまずは周囲を歩き始めた。":51,"でかい屋敷のぐるりを完全に囲む白壁、\n２，３メートルほどの高さと思われるそれらから更に高く、\nくだんの蔵、その瓦屋根、":52,"そして何故か赤い丸太のような――\n鳥居か？[l]\n形状が色々決まってるのは本で知ってるが、\n具体的な事までは覚えてなかった。":53,"ただ、何か違和感を感じたのは確かだ。[l]\nおそらく普通の形式ではないのだろう。":54,"そして敷地内にこういうものがあるとは、屋敷神という奴かな？[l]\n例の神社は山中にあるはずだし。[l]\nにしてはでかい。僕が知ってるのはせいぜい祠くらいの規模だ。":55,"と、\n歩きながら視線を正面に戻すと、\nそこにぱっと見高校生くらいと思われる、しかし私服の女子がいた。":56,"晴れてるとはいえ、肩が大きく出ていて、\n少々見た目寒そうな格好である。":57,"知狡さんのように、地元民にとってこの程度の気温は、\n寒い内に入らないということか、はたまた、\n宮さんみたいに女子のやせ我慢なのか。":58,"じっと敷地内、というより塀に囲まれてるから、\n今まで僕が見てたようにそこから覗く鳥居や屋根を見てる、ように見える。":59,"単に立ってるだけなのかも知れないが、\n周囲に何もないこの場所で、バス停でもない人の家の前に\nただ立ってるということは普通ないだろう。":60,"となれば、":61,"「あの、すみません…[l]\nここの家の方…ですか？」":62,"話しかけてみた。[l]\n違ってても用事のある人間だろうし、\n何らかの話を聞けるかも知れない。":63,"しかしその娘は集中していたのか、\n結構驚かれてしまった。":64,"「――え、わっなに、びっくりしたよ！[l]\nど、どちらさま？！」":65,"「あ、ああどうもすみません、\n旅行中の者なんですけど、\nいいく――」":66,"…あー、名字は念のため伏せといたほうがいいのだろうか。":67,"「――ん、そう、いーくんと呼ばれてます者でして、\n本名は真言、『まことをいう』と書いて\n『まこと』です。はじめまして」":68,"明確な虚偽を言うのも問題有りそうだったので、\n無理矢理誤魔化す僕。[l]\n名字黙ってるだけだから良いでしょう。[l]\n大神は僕を（たまに）いーくんと呼ぶもんね。":69,"「ふええ、いーくんですか。[l]\n":70,"こんにちはおにいさん。[l]\nわたし、":71,"西":72,"石":73,"貴":74,"奴っていいます。[l]\n":75,"ああとね、この家の人間じゃないよ。[l]\nあっちの――」":76,"西石さん…ちゃんか、は、[l]\n僕の来た方とは逆を指さして言う。":77,"「":78,"長 ":79,"久 診療所っていう小さな所で\nバイトしてるのさ。[l]\nそこはここと関係あるけど、\n":80,"わたし個人は他人なのだわ」":81,"はあ、そうですか。[l]\nそこで急に西石ちゃんの視線がギロリとこちらを見据えた。[l]\n":82,"睨まれたというより、異常なまでに興味津々といった風だったので、そういう擬音になってしまう。":83,"実際、不審がられてる反応じゃないようだ。[l]\n将来のゴシップ大好きおばはん候補生か…[l]\nちょっと身が退ける僕。":84,"「おにいさんここに何か用？」":85,"「え？[l]\nああ、えーとですね、\nそもそもここに旅行に来たのはこの、\n三春家ですか？[l]\nの蔵を見せていただきた」":86,"「まこちゃんだよ！！」":87,"「いというのが、え、うえぇ？」":88,"彼女は突然僕を真正面に見据え、\n大声を上げた。[l]\nび、びっくりするでしょう、というかまこちゃん？？[l]\n僕のことですカ？":89,"「まこと、真言、まこちゃんだよ！！[l]\nね！！[l]\n覚えてないっ？！[l]\n貴奴だよ、貴奴だってば！！」":90,"玄ノ森のほとんどの場所で記憶を想起できなかった僕の\n空転脳では、残念ながら期待にお応えできそうに\nありません…[l]\n誰だっけ――？":91,"「た、確かに僕は昔――」":92,"…言って良いのだろうか？[l]\n飯窪の名を出さなきゃ問題ないか。[l]\nこの娘の事の方が気になる。[l]\n向こうの勘違いかも知れないし、\n結局確認がてら返答した。":93,"「ここに居たかも知れないけど、\n学校に上がる前に引っ越してて、\n君の知ってる人かどうかは」":94,"「だってわたしも隣町から来てるのさ。[l]\n昔はここ居たんけど。そんとき会ってさ、[l]\n二人とも小さい内にここ出ちゃったんだよ。[l]\nそりゃ覚えてないはずさ。[l]\n":95,"まこちゃん今いくつ？」":96,"「…こないだで二十歳に」":97,"「やっぱそうだ。":98,"私１８。ほら、わたし二つ下だもんね。":99,"でも覚えてるよ。":100,"まこちゃん、一緒に遊んだってば！！":101,"ニコ上のお兄ちゃんって、覚えてるもん」":102,"そこで、僕の空転脳が唐突にキーワードに反応した。":103,"そうだ。[l]\n確かに、\nここに居たあのとき、\n二つ下の女の子がいた。":104,"名前も顔も覚えていないが、\nその『二つ下の女の子』というファクターだけには、覚えがある。":105,"目の前のこの娘がそうかどうかは、\n申し訳ない事に正直わからないが、\n頭のどこかにそのファクターが引っかかっているし、\n過去に合致する状況があったことは間違いない。":106,"記憶の埋め込みではないのは確かだと思う。[l]\nだが…":107,"「いやー懐かしいっていうか、\nすっかり変わっちゃってて感慨もなにもないね！[l]\n":108,"あっははは！！」":109,"「あ、あはは…[l]\n僕の方はまだ完全にマッチしたわけじゃないけど、\n確かにニコ下の女の子に知り合いは居た覚えがあるよ」":110,"「ふええ？[l]\nまこちゃんひっどい人なのさ！！[l]\n":111,"ま、今回に限り許すだわ。":112,"泊まりで来てるのかな？」":113,"ん、まあね…と、あやふやに応える僕。":114,"「とりあえずひさ…しぶり？にしとこうか…[l]\nこんにちは宜しく、ええと」":115,"「『きぃ』でいいよ。ちゃんとかさんとかいらない」":116,"昔みたいにさ、と笑う彼女。":117,"八重歯が光る。":118,"「あー…、じゃあ、きぃ。[l]\n僕この家に用事があるから、ほんと名残惜しいけども今日の所は…」":119,"いまだ社交辞令美辞麗句の域も\n脱せないぎこちない会話になるが致し方なしだ。":120,"こういう事にそういうものを求めるのも何だが、\n信用に足る証拠は今の所ないのだ。[l]\n…僕も大学で関東出てからは色々見てるしな。":121,"当たり障りのないところで、ここは一旦お流れにしたい所なんだが。[l]\nあんまり騒がれても困るし、と思っていたら、\n案の定というか、中から、外を不審がる声がしてきた。":122,"やべえ。[l]\nここで睨まれると面倒だと言われてるし、\nどうしよう。[l]\nしかも標的中の標的たる三春家に敵視されたら目も当てられない。[l]\n宮さんに会わす顔もない。":123,"「どちら様？[l]\n先程から大声をあげてらっしゃるけど、\n当家にご用がおあり？」":124,"名乗っていないにも関わらず、\n私がここの主、と言わんばかりのオーラを発する、\n黒服の女性が、屋敷から顔を出した。[l]\n玄関から門扉までは結構距離があるのだが、\n大きな声でもないのに、通る声がまるで突き刺すようだ。":125,"「え、あ…その、ですね」":126,"「うちはこういった家ですから、\nあなた方のような不遜な客人もままいらっしゃいますけれど、\nだからといって寛容な対応を施しているわけではありません。[l]\n見たところ余所からいらした方のようですが…、[l]\nあら」":127,"そこでその女性はきぃを見て――\nってもうこの呼び方に順応してしまったが、\nやや驚いた風の表情を見せた。":128,"「あなたたしか、診療所のお手伝いの方ですね？そうでしょう？」":129,"「はい、西石と言います。[l]\n長久診療所でお世話になってます」":130,"「あそこは今大変でしょうに、\nこんな時間こんな所で何をなさってるの？[l]\n":131,"卑":132,"尊さんが戻るのはまだもう少し先でしょう」":133,"「あのー、その事で言づて頼まれたんですわたし。[l]\n卑尊さん明後日に戻るそうです」":134,"「ああ、そう。それを言いにわざわざいらしたの。[l]\n電話は使えなかったのかしら？」":135,"「お昼の買い出しついでに来たので」":136,"「………。[l]\nお二人はお知り合いなの？そちらも隣町のお方？」":137,"「ああ、僕は単なる旅行者なんですが、\n本、古書の類を見るのが趣味でして、\nなんでもこちらの」":138,"「三春の書蔵は個人の所蔵です。[l]\n申し訳ないけれど一般には公開しておりません。[l]\n神社は聖域ゆえ、定められた神職のものしか立ち入りは出来ません。":139,"それに――今私どもは色々と立て込んでおりますの。[l]\n家の者も皆忙しいですし、\n何もお相手できることはありませんのよ。[l]\nどうかお引き取り下さいな。":140,"ここ玄ノ森には他にたくさん見るところも御座います。[l]\nそちらをご紹介致しますわ。":141,"ああ、書蔵といえばもう一カ所、\n飯窪という家が玄ノ森には御座いますが、\nあちらもきっとお断りになるでしょうね。":142,"是非、他の名所をごゆっくりと堪能下されば、\n玄ノ森の者、三春家の者として嬉しいですわ。":143,"あら、そういえば申し遅れましたね、\n私はこの三春家の現当主の、\n三春のぎかと申します。[l]\n":144,"初めまして」":145,"言い切る前に全てを察したのか、\n言葉を挟む間すら与えてくれずに、\nまさに一気呵成、一方的に言われてしまった。":146,"「あ、ああそうですか、そうですよね。[l]\nあと何でもここのお祭りが…」":147,"「――ええ、ちょっとした事情がありまして、\n今年はまだ準備が滞っておりますが、\n楽しみにしてくださる皆様の為にも、\n予定通りに行えるよう玄ノ森をあげて尽力いたしておりますわ。[l]\nもし機会がおありでしたらそちらも是非」":148,"………。[l]\nまあ、裏事情をある程度知っている僕としては、\n多少空々しさを感じないでもないが、\n一見さんにいきなり殺人事件の話を切り出すのも\n不自然――この女性がそれこそゴシップ大好きおばはんだったら\n別だが――だろうし、\n事実と違う事を言われたわけではない。[l]\nむしろ予定通りの祭日程を目指してるらしいという事が分かった訳だ。[l]\n宮さんが言っていたように、\nそのために色々と方々に圧力を掛けるというのだろうか。[l]\n人死にが出てるというのに、だ。":149,"「そ、そうですね。[l]\nお祭りは是非見たいと思ってますので、\nどうか頑張ってください。[l]\nではお騒がせしました。[l]\n失礼します」":150,"「あ、まこちゃんわたしも行くのだわ。[l]\n":151,"では卑尊さんのこと確かにお伝えしましたので。":152,"失礼します」":153,"「わかりました。[l]\nではお二人とも、ごきげんよう」":154,"あはは、えへへ、とぎこちなく愛想笑いをしつつ、\n僕はその場を去った。[l]\nきぃも後をついてくる。[l]\nまた騒がれても困るので、三春の屋敷からはなるべく離れた、\n自動販売機小屋（？）に移動した。":155,"さて、何とか、僕の心配してた程には怪しまれることはなく済んだようだ。[l]\n僕らの本命は御神体な訳で、蔵のほうはあまり気にしてなかったんだが、一緒くたに拒否されたということは、思いの外、三春家の所蔵物に近づこうという輩は多いということか。":156,"まあ、神社にもし安置してないとすれば、\n紙の御神体は書蔵にあると思うのは自然な流れではあるか。":157,"実際にそんな単純な話なら、\nわざわざ宮さんらが調査することでもないだろうから、\n本当は別のところにあるのだろう。":158,"が、六母屋に来るマニアな客とかはあくまでアマチュアだろうし、\nそういう人種を毎度相手にしてた所為で、怪しい人物慣れしてたのかもな。[l]\nある意味ナイスだ知狡さん。":159,"とはいえ、予想はしていたが完全に玉砕状態である。[l]\nあとは結局当初の予定通り祭の開催を待つか、\n宮さんから言われた調査を地味にしていくしかないな。":160,"話の流れでとりあえず、\n彼女――西石貴奴の身許はどうやら確かなようだと分かったので、\n昔のことはさておき、これで多少は打ち解けられる…かな。[l]\n疑っていたらきりがない。":161,"「まこちゃんまこちゃん」":162,"「あそこの蔵の中が見たいんだよね？」":163,"え？[l]\nいやどちらかというと御神体の調査が目的で、\n蔵の中が見たいというのはその目的達成の一過程であり…[l]\nじゃなく、あまり真の目的は話したくない。[l]\nので、やや曖昧に頷いた。":164,"「あそこのお嬢様、\nちょっと知ってる仲なのだわ」":165,"三春家のお嬢様？[l]\n昨日見かけた金髪の眼帯少女。[l]\n知り合いだって？":166,"「今呼んでみようかな、\n出るかな携帯………出ないのだわ。[l]\n":167,"学校明日からだし習い事かな？\nしょうがないメールしとこ」":168,"僕が止める間もなく、\n彼女はピピピとメールを打っていく。[l]\nおお、二つしか違わないのに今時の若者だなあ。[l]\nや、田舎だからって見くびってた訳ではない。[l]\n単に僕がアナクロでアナログな…[l]\nまあいいや。[l]\n宮さんにしろ大神にしろ、周りはそういうの\n得意なんだがなー。":169,"と、彼女がぱちんと携帯を閉じた。[l]\n送信終了したらしい。":170,"「協力を要請したのさ」":171,"結局僕の意志とは関係なく、三春のお嬢様と渡りがつく…[l]\nかも知れないことになってしまった。":172,"「え、えーと、\nよくわからないけど礼は言っとくよ、\nありがとうございます…」":173,"「もし習い事だと、\n最中は電源切って先生が預かってるからさ、\n返事は来るとしても夕方なのだわ。[l]\n":174,"だいじょぶ、読んだらすぐ返事くれるよ":175,"冬":176,"夏は」":177,"トウカというのか。[l]\n三春冬夏。[l]\nなるほど。":178,"「そのかわり、\nもし冬夏が協力してくれる時は、\nわたしも一緒に行くからね？[l]\n":179,"一遍見たかったのだわわたしもあの中。":180,"てか、だから協力したの。":181,"つまりさ前提条件よ？わたし連れてくのは」":182,"「は？[l]\nそれは聞いてないけども、\nそりゃ構わないよ。[l]\nというより、\nきぃ…の御陰だし、見知らぬお嬢様と二人だけって[l]\n訳にもいかないし、\n君さえよけりゃむしろお願いしたいくらい…」":183,"「ふええ、ほんと！！[l]\n":184,"じゃぜったい冬夏にうんと言わせるさ。　":185,"良かったまこちゃん、\n":186,"さっすがわたしが目を付けただけはあるのだわ」":187,"と、僕の手をがっしと握るきぃ。[l]\nもう僕は彼女をそう呼ぶことにした。[l]\nニシイシって言いにくいし。":188,"「それはどうも…[l]\nそうか、明日始業式か。[l]\nでもきぃは隣町の学校なんだよね？」":189,"「わたし高校は行ってないのさ。[l]\n家にお金ないの」":190,"ああ、そうなのか。[l]\n気まずいことを訊いてしまった。":191,"「貧乏だけど携帯は持ってるから番号教えて」":192,"わたしのはこれ、と教わった番号をメモリーに入れる。[l]\n「というより家に電話が引いてないんだわ」と言って\nあっはは、と自虐的というよりはあっけらかんと笑うきぃ。":193,"携帯オンリーと据え置き契約、\nどっちが高くつくんだろうな？と計算する間もなく、[l]\n彼女は横で話し続ける。":194,"「じゃ返事来たら連絡するよ。[l]\nあ、ワン切りで待ち合わせにしよう。[l]\n着信みてわたしだったら、":195,"えーとどこがいいか…」":196,"相手の内面を想像する余地無く、\n話がとりあえず進行していくので、\n僕としてはもはや委ねるのみだ。[l]\n脳も空転し出してるな…":197,"「土産屋があるんだわ。[l]\nそこもね、三春の関係者のとこだけど、\nそこにしよう。[l]\n冬夏の行き場が近いのさ。[l]\n":198,"そういやまこちゃんどこ泊まってる？」":199,"「ああ、六母屋ってところ」":200,"「ふええ、じゃあやっぱりそこだね。[l]\n地図ある？[l]\nそうここ。[l]\n『":201,"嘉":202,"多":203,"里":204,"辺":205,"茶":206,"屋』だね。[l]\n":207,"ここに来て欲しいのだわ」":208,"「了解。[l]\n着信きたら向かうよ」":209,"そこでそのまま何となく会話が弾んだ。[l]\nというか途中で切り上げにくくて、\nだらだら話してたようなもんだが。":210,"「わたしと同い年でさ、\nすっごいブロンドで青い眼なのさ。[l]\nほんとに外人みたいよ、ぱっと見」":211,"ああ、知狡さんからも聞いていたがやっぱりそうか。[l]\n昨日ここに着いた時に見たのが、\n三春家の娘だ。":212,"「美人かどうかは個人の好みだからさ、\n言わないけどね」":213,"僕が宮さんを評した時に思ったような事を言うきぃ。[l]\nで、結局きぃ自身が冬夏嬢をどう評してるかは言わないのであった。[l]\n言ったら言ったで本心かどうかもわからんけど。[l]\n女子っておそろしいなあ…":214,"「あ、もう見たんだ？[l]\nどうよまこちゃん的には？」":215,"「うえ？[l]\nや、ちらっと見ただけだから何ともね…[l]\nまあ、何か引っかかるモノはあったけど…」":216,"それで言ったら目の前のこの娘もそうである。[l]\nふーん、と割とあっさりその話題は通過された。[l]\n女子のその辺の感覚、ほんとに分かりません。[l]\n話題ふるだけふってそれかよ。":217,"「多分『カクセイイデン』と見たね、わたし。[l]\n学校行ってないけど難しい言葉知ってるでしょ？[l]\nバイト柄ちゃんと勉強したんだから」":218,"さっき見た母親がごく普通の邦人だったから、\n父親が外つ國の人でない限りは、\nまあそれか突然変異か何かだろうなあ。":219,"アルビノは全然違うし…[l]\nで、その父親もまごうことなき邦人だそうだ。":220,"しかし、隔世遺伝とすれば、\n三春家かその婿――ここは代々当主は女、婿取りするらしい――\nの中に、かつて金髪碧眼の人種がいたということになる。":221,"…多分その辺も教えてくれないだろうし、[l]\nそもそも別に知らなくても良いことだ。[l]\nそれとも宮さんか知狡さんが知ってるかな？":222,"「腫れ物にさわるみたいな扱いしないほうがいいよ。":223,"…またちょっと難しい言葉使ってみた、":224,"あっはは！":225,"冬夏はすっごいサバサバしてるのさ。":226,"多分向こうが気ぃ遣って自分から見た目の事は言ってくるよ。":227,"だからまこちゃんも素直に反応することさ。":228,"ああもーさっきの御当主、お母様とは大違い。":229,"家とは仲悪いんだわ、冬夏。":230,"だからわたしみたいなんのとも付き合ってくれるけど」":231,"あのババアのせいで家に入れて貰ったことはないのさ、\nときぃは憤慨した。[l]\n八重歯がまた光る。[l]\n何かというと瞬きせずにものを凝視するので、\nたまに怖く見えますよきぃ。":232,"「育ちが良いからお嬢様ふうの立ち振る舞いではあるけどさ、\n因習しきたりとか大っ嫌いって言ってたよ。[l]\n家にあんなでかい鳥居とか立ってるし、\n玄ノ森では祭の――」":233,"ぐぅぅぅぅぅぅううぅっ。":234,"「………」":235,"「？？？」":236,"なにいまの？":237,"「ご、ごめん！[l]\nおなかの虫がなったのさ。[l]\n":238,"やだ、もうっちょっと超恥ずかしいのだわっ！」":239,"「あ、ごめん、長話しすぎたね。[l]\nきぃもお使いで来てるのに…[l]\nそうかだから、今から一緒にご飯――\nというわけにもいかないんだ？」":240,"「ごめん折角だし昼ご飯一緒に食べたいんだけどさ、\n診療所のほうがまだごたごたして、\n":241,"今から買い出ししてお昼戻らないといけないのだわ」":242,"「わかった。[l]\nじゃ後で色々お礼も兼ねて、どこかで食事する？[l]\nつまりは奢るよってことなんだけど…」":243,"「ふえええええほんっっっとにっっ！！？？？？":244,"まこちゃんまじ！！！？？？？":245,"わたしにも貧乏人のプライドがあるけど\n":246,"その手の施しには遠慮しないよっ？？？！！！」":247,"どういうプライドなんだろう…[l]\n宮さんの謎のエロ意地のようなもんかな…":248,"「ああ、まあ、いいよ。[l]\nそのかわり店とか知らないから、\nきぃが選んでくれる？[l]\n美味い所紹介がてら」":249,"「お任せさ！！[l]\n冬夏も知らないような所に連れてってあげるのだわ。[l]\n安くて量があってそこそこの味のイカス店！！！」":250,"や、味ももう少し吟味して頂きたいのですが…":251,"「ああもうっ、\nまこちゃん愛してるよっ！！":252,"食べられるものなら食べたいくらいさっっ！！！":253,"キミは最高の男なのだわ！！！":254,"だーい好きまこちゃん！！！」":255,"おいおい、涎出てますよー。":256,"とそこで、":257,"「おわっ！！」":258,"うれしさ大炸裂といった感じで、\nきぃが突然僕に抱きついてきた。":259,"ひ、ひええ。":260,"しかもなにげに力強いぞ。":261,"い、い、痛いくらいだ。":262,"嬉しいとか考える前に、混乱と痛みが先行して、":263,"只ひたすらあわてる。":264,"「ぜっったいだよ。[l]\n嘘ついたら冬夏の話もなしさ。[l]\n二人してまこちゃんの邪魔してやるのだわ」":265,"身体をぱっと離して、えらく真剣な眼で僕に念を押す彼女。[l]\nいてててて…[l]\n宮さんの逆セクハラのせいで、\nせっかくの女子とのふれあいにも昔のようなドキドキが\n無くなってる気がする…それはそれでやばいよなあ…[l]\nま。ともあれ、食い物の恨みは恐ろしいし、[l]\n約束を反故にする理由もないから安心したまえ。":266,"「わかったって。約束は守るよ。[l]\nじゃ着信待ってる、それまでに土産屋の場所確認しとくから。[l]\nそれじゃあ、お使い頑張って」":267,"「うんっ！！":268,"ほんとに今日、\nまこちゃんに会えてよかったのさ。":269,"カミサマに感謝なのだわ」":270,"じゃあとで、と、\nすたすた向こうに歩み去るきぃ。[l]\n手を振って見送る僕。[l]\nって歩きだったのか、彼女。":271,"まあ、これで心強いサポーターが出来たということなのかな…[l]\n少なくとも三春の内部の人間と繋がりがもてるのならば、\nそれは有用だろう。[l]\nたった今母親には突っ慳貪にされたし、\nまだどうなるかはわからないが。":272,"さーて、緊張と事態の急転ですっかり意識の外だったが、\nきぃの腹の虫がなったとおり、もう昼飯の時間帯だ。[l]\n身体が完全に空腹を訴えておりますよ。[l]\n脳が空転し出す前…もうしてるけど、ご飯を食おう。[l]\nしかし、飯どころはまだ目星付けてなかったんだよなー。[l]\n昨日のラーメン屋は歩いていける距離じゃないし、\n旅館に戻るのもなんだし。[l]\n三春家の立地がこうなると恨めしいわ…[l]\nとにかく店のあるとこまで戻らないことには。[l]\n観光スポットまで行けば何とかなるんだろうが、\n最悪国道沿いに出てコンビニ探そう。":273,"あ、そういや彼女、買い出しついでと言ってたな。[l]\nということは店が向こうにはあるんだ。[l]\nしかし――\nどうみてもこの道しばらくは何もないですよ？[l]\nついでで行ける距離にほんとに店あるか？[l]\n単に電話代ケチったんじゃないですか？":274,"…しばし煩悶。[l]\nいかん、もう空腹による脳空転で判断能力がやばめだ。[l]\n安全策とる、戻るに決定。[l]\n途中あったら速攻入ろう…[l]\nとりあえずはここの自販機で何かを…ぐうう……":275,"昼飯も食し、土産屋『":276,"屋』の場所も確認した。":277,"茶屋、というかこの土産屋は、\n一階部分が売店、二階部分では、\n土地の古老、語り部が民芸話をするという、\n名前そのまんまの店だった。[l]\n時間つぶしに二階に行こうとも思ったが、\n公演時間が決まってるうえ料金もかかるし、\n携帯の着信待ちの身としてもあまりよろしくない\n気がしたのでスルーした。":278,"旅館に戻っても良かったけども、\nいい加減一日中歩いたので、今更移動などする気力はない。[l]\nこの茶屋近くで待たせて貰いますよ、へっへっへ。":279,"と思って、小さい本屋で、\n当初から買う予定だった地図と、\nある有名詩人の詩集を購入し、\n土産屋近くの公園のベンチでそれらを読みながら連絡を待った。[l]\n大学生…ではもうないが、高校出ると、長期休暇とか、[l]\n年度始まりとかよく分からなくなってくるなー。[l]\nサラリーマンとかはそうでもないんだろうけど。[l]\n最後の春休みね、今日は。":280,"…この詩集ちょっと面白いな。[l]\n作者の名前はいろんな本に出てくるから知ってはいたが、\nその作品を読むのは初めてだ。[l]\n時代が古めなので、今だとややヤバげな表現が出てくるが、\n全体的にちょっと僕好みの雰囲気である。[l]\nふーん、はまりそう…":281,"と思いもかけず良本との出会いの御陰で、\nきぃからの連絡が来るまでの時間は有意義に過ごせた。[l]\n彼女からの着信は３時過ぎだった。":282,"「というわけれ、\nひょうは会えなはっらんですけどね、\nんぐ、明日、明日。[l]\n三春のお嬢様と会う約束しました。[l]\n始業式終わってから」":283,"「まこくん、ベタ過ぎて言いたくないですけど、\nもの食べながら喋らないでください。[l]\n":284,"にしても、その西石って娘気になるなぁ…」":285,"いつまでも着信が鳴り続けたので電話に出たところ、\n結局、きぃからの連絡は、\n冬夏嬢から返事は来たものの、\n会えるのは明日なので今日の集合はなし、ということだった。":286,"時間帯が半端で店が開いておらず、\n奢るのは明日のその時で良いと言われたので、\nその後、宿に戻って夜まで過ごし、\nどこからか戻ってきた宮さんに今日のあらましを報告したのだった。":287,"流れで宮さんの部屋でこうして夕飯を食している。":288,"勿論、知狡さんの料理ではなく、\n料理人さんたちのまかないだ。":289,"全然美味いです。ベリナイス。":290,"「にしいし、西石。んむ～――」":291,"知狡さんの記憶も僕と大差はなく、\n近い歳の女子と遊んでいたらしい、\n程度の事実は確認できたものの、\n彼女が実際にそうなのかは分からずじまいだった。":292,"「ニシイシって字面に覚えはあるみたいでしたけど、\n知狡は。[l]\n昔何かはあったのかなぁ…」":293,"「まあ三春とも知り合いのようでしたし、\n身許はちゃんとしてるんでしょうけど。[l]\nそういやその診療所も土産屋も、\n例の系列だか関係者だって…」":294,"「んむ？[l]\n":295,"あ、そうですね。":296,"長久診療所は、三春家の専門というかかかりつけというか、\n何故かずっとそうらしいですね。":297,"もっと大きいちゃんとした病院は玄ノ森の中央にもありますけど、\n何故か三春達はそこを使うらしいですよ。":298,"女子の世襲でやってて、[ruby text=\"ナガ\"]永[ruby text=\"ヒサ\"]久家というんですが」":299,"その字を変えて長久、転じてチョウキュウ診療所と称している、\nということだった。":300,"「聞いてないかもですが、\n例の殺人事件で殺されたのが、ここの先生ですね」":301,"聞いてない。[l]\n聞いてないが、あそこが大変で誰だかが戻ってくるとか来ないとか、\nそういう話を、きぃが確かにしていたな。[l]\nそのことだったのか。":302,"「ついでに言うと、\nまこくんが紹介された土産屋『嘉多里辺茶屋』もですね、\n綾目家という家がやってるんですが、\nここの主――女性ですけど――が殺されたもう一人なんです」":303,"「…はい？[l]\nえ、ええ？[l]\nきぃが言うにはそこも三春の関係者だと…」":304,"「んむ？":305,"そんなこと言ってたんですか？":306,"……んむー、じゃそうなんでしょうね」":307,"ってこれは関連性を見出さずには居られないでしょうに。":308,"素人考えですか？":309,"「まこくんが思ってることは、ま、\nみんな思ったんでしょうね。":310,"だから他の三春の系列、\n狩屋とか、あと知狡が言うには関西にも三家ほどいるらしいですが、\n警備警戒強化してるぽいですけど。":311,"結局は全部三春が仕切ってるのかなあ、\n何故か事件の発覚は抑えようとしてますね。":312,"どうしても祭は予定通り行いたい気配はあると聞いてます。":313,"うひひ、宮たちにとっては好都合ですね。":314,"不謹慎ですけどね」":315,"僕も三春の当主から直々に聞いている。":316,"神事は神事だし、現世の都合でスケジュールをいじるなんて出来ない\nのかも知れないが、":317,"昔ならいざ知らず今の世でもそれが通るものだろうか。":318,"信仰絡みなら、ままあるものだろうか。":319,"「西の三家も祭となれば全家がここに集合するわけで、\n毎年の事なのに、旅程とか変更面倒くさいでしょうしね。":320,"普通に事件が解決してくれるに越したことはないでしょうが、\n":321,"いざとなればどうでるか…」":322,"あの、今思ったんですが、\n祭は予定通り強行される目算が高いのならば、":323,"やっぱり僕は大学辞めてまでこんな前入りしてなくても\n良かったんではないでしょうか。":324,"「んむ！？":325,"いえｿﾝﾅｺﾄﾊﾅｲﾃﾞｽﾖ?":326,"ほらえーと…":327,"ん！あ、まこくん！！」":328,"「な、なんすか！？」":329,"「んむ、そうですた！":330,"忘れてないですよね、\n":331,"今日こそ混浴ですよ？":332,"露天風呂♪」":333,"ごまかしやがったな…大学に関しては済んだことだしいいけどさ…":334,"てか混浴まだ本気だったか宮さん。":335,"水着持参は伊達じゃないということか…":336,"「あ、あのねえ…」":337,"「ゆうべはお預けだったんですからイヤとは\n言わせません。":338,"水着は知狡が用意してくれるそうですから～」":339,"「ああ～もう、分かりましたよ。":340,"今晩だけですよ、今晩だけ。":341,"じゃちょっと腹ごなしするまで待ってください」":342,"「わーい★":343,"背中流しっこです」":344,"「うええ～するんすか～…」":345,"それは、身体的接触はちょっと、いくら宮さん相手でも、":346,"………身体が反応しそうだなあ……":347,"気まずいことになんなきゃいいけど…":348,"「全身洗いっこでもいいですよ～。":349,"うひひ、ぬるぬるー」":350,"それは絶対に却下します。":351,"教育的指導！":352,"客だーれもいない。":353,"二人っきりです。":354,"これは良いのか悪いのか…":355,"先に僕が入り、":356,"水着に着替えた宮さんが後から来るという事に":357,"なっている。":358,"露天風呂、旅行結構してるけど初めてかもだ。":359,"なんか落ち着かないな。":360,"宮さん待ちというのもあるけど…":361,"何故か仁王立ちになってしまう僕。":362,"と、":363,"「さーさまこくん、\nお背中お流し致しますぅ～ってなんだ、":364,"ビキニパンツじゃないじゃないですかぁ～」":365,"「あのね宮さん、\n旅館の売店に、混浴用だってビキニパンツ売ってますか？":366,"…や、詳しくは僕も知らないですけど、\n変な事期待しないで下さい。":367,"エロですね、スケベですね」":368,"「んむ～っ。":369,"知狡も気が利かないなっ！":370,"スク水とそれじゃ割に合わないです。ずるいです。":371,"差分払って欲しいです～」":372,"「全部脱いで見せられるものなら見せてあげますけどね、\nあの看板とおりここは水着着用ですから。":373,"残念ですなあ。":374,"ルールには従わないとねぇ」":375,"スパイじみた行為をしようとしている人間の言ではないな…":376,"あはは。":377,"「んむー？":378,"それはルール無用の場所ならおーけーということかな？":379,"うひひ、言ったなまこくん！":380,"後でどんだけ大人になったか、見せて貰おうか！！」":381,"「そんな場所と機会があれば見せてやろうじゃないのよ！":382,"あればな、あれば！！":383,"ふははは！！！」":384,"「後でぇ、宮の部屋に来てくれるぅ？":385,"まこくうぅ～ん★":386,"みゃおみゃお～ん♪」":387,"…そうきたか。":388,"反応しそうになる身体を精神力で必死に押さえつけながら、\n極力軽蔑のこもった眼で見てやった。":389,"「んむぅ、わかりましたよぉ。":390,"ほんとまこくんはつれないですなー。":391,"ま、戯言はここまで。":392,"ちゃんと背中流してあげますから、\nこっち来てください」":393,"―――結局、\n何事もないまま、普通に混浴しました。":394,"あたりまえだ。":395,"つーか、からかう気のない時の宮さんなんて、\n醒めたもんなんだ。":396,"こっちが変にその気を出して近づこうもんなら、\n超ブルーになること必至である。":397,"明日の話を少ししてから湯から上がり、\n各々の部屋に戻った。":398,"…ええ、正直、\nちょっと身体は反応しておりましたけど、\n今夜はおとなしく寝まス。":399,"そしてなるべく早く忘れよう。":400,"今後のことを考えますとね。":401,"まともに顔を見られないのも困るのでね。":402,"では、\nおやすみなさい…":403},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_005.ks","relPath":"/data/scenario/SC_M_005.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":404,"length":404,"percent":100},"cellInfo":[null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"t":"HU","v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"t":"HU"}],[null,{"t":"HU","v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,[null,{"v":1,"t":"HU"}],null,null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[361,1],"note":"完成"},"/data/scenario/SC_M_006.ks":{"data":[["茶屋の前のベンチに座っていると、\nきぃがやってきた。","坐在茶屋前的长椅上时，\n小贵过来了。"],["「おっはよう、まこちゃん。","「早啊~真酱。"],["今日もいい天気さ。","今天也是好天气呢。"],["春の日差しになってきたのだわ」","已经是春天的阳光了哟」"],["「おっはようというかこんちはというか、\n天気はいいな今日も。","「说早上好还是该说午安呢，\n今天天气确实不错。"],["まだ僕的には肌寒いけど…\nともあれ新学期の始まりって感じはするかな…」","不过我觉得还有点冷…\n总之能感受到新学期开始了呢…」"],["中央あたりの感覚だと始業式入学式には桜、\nというイメージだが、\nここいらではまだ満開という訳にもいかない。","按中部地区的常识开学典礼该有樱花，\n大家都是这么想的，\n但这边还没到满开的时候。"],["何しろ梅雨が明けずに夏が終わることもある\nらしいし。","毕竟听说有时候连梅雨都没结束夏天就过去了\n呢。"],["今日は玄ノ森の高校の新年度始業式で、\n２年と３年がぞろぞろ登校しているのを、\n朝から見かける。","今天是玄之森高中的新学期开学日，\n从早上就看见\n二年级和三年级学生成群结队去上学。"],["きぃと同い年らしい三春冬夏は、\n今年度から新三年生の一人だそうだ。","和小贵同岁的三春冬夏，\n听说从这学期开始就是新高三生了。"],["「今日はバイトも休んできたからさ、\n","「今天我连打工都请假了，\n"],["みんなでいい店行こうね。","大家一起去好店吧。"],["ま、冬夏は一緒じゃなくても構わないけど」","啊 就算不和冬夏一起也没关系啦」"],["おおい、それは本末転倒なのだわ…","喂喂 这完全本末倒置了啊…"],["「なんてね。","「开玩笑的。"],["午前中で終わりだっていうからさ、\nみんなでお昼、丁度良いのだわ。","因为上午就结束了嘛，\n正好大家一起吃午饭。"],["他の学生共の来ない穴場教えたげるよ」","告诉你们本地学生都不知道的宝藏店铺哟」"],["「お前隣町から来てるのに、\n地元学生も知らないとこ知ってるのか？」","「你不是从邻镇来的吗，\n居然知道本地学生都不清楚的店？」"],["不味いから客居ない、とかじゃないだろうな…","该不会是因为难吃所以没客人吧…"],["安さと量が価値基準らしいし、ちょっと不安だぞ。","听说那家店主打便宜量大，稍微有点不安啊。"],["不味い飯は知狡さんのでもうおなかいっぱいですよ？","难吃的饭在知狡阿姨那儿已经吃到饱了哦？"],["「舐めて貰っては困るなまこちゃん。","「别小看我啊真酱。"],["食いに関してはこのきぃは妥協はしないよ。","在吃这件事上我小贵绝不妥协。"],["バイト先でも情報収集は欠かさないのさ。","打工时也一直在收集情报呢。"],["見てるがいいのだわ」","你就瞧好吧」"],["「あ、そう…","「啊、这样…"],["昨日も言ったけど、\n多少値が張っても構わないから、味のいいとこ頼むよ…」","虽然昨天也说过了，\n贵点没关系但一定要选味道好的店啊…」"],["「ふええ、\n味の善し悪しなんて個人の主観でしかないさ。","「呜诶~\n味道好坏本来就是主观判断嘛。"],["それぞれの価値観で、\nおんなじものでも１８０°評価は変わることもあるし、\n保証はできないのだわ」","根据个人价值观，\n对同一样东西的评价可能180°大转弯，\n我可不能保证哟」"],["冬夏に食わせたら美味しいって言ってたけどね、\nと言うきぃ。","不过给冬夏吃的话她应该会说好吃吧，\n小贵补充道。"],["ま、まあ、それを信じよう。","嘛、嘛啊，就信你一回。"],["にしてもどっかで聞いたような話だな。","不过总觉得在哪听过类似的话。"],["――ああ、知狡さんが一昨日、橋の上で似たようなことを言っていた。","――啊对了，知狡阿姨前天在桥上说过差不多的话。"],["…流行ってんのか？流行語大賞？","…这是在流行什么吗？流行语大赏？"],["というかそれで初日に酷い目にあってまーす。","话说就因为这样第一天就倒了大霉啊ー。"],["「学校に直で僕らが行くと、\nやっぱおかしいんだろうな」","「直接由我们去学校的话，\n果然会很奇怪吧」"],["「そりゃそうさ。","「那当然啦。"],["余所者二人、若い男女が三春のお嬢様を待ちかまえてたら、\n怪しすぎなのだわ。","两个外乡人、年轻男女蹲守三春家的大小姐，\n也太可疑了。"],["わたしだけならまだしもねー」","光是我一个人还好说呢ー」"],["「『噂になると恥ずかしいし…』的状況か…」","「『要是变成传闻多难为情啊…』这种状况吗…」"],["「ふええ？","「呜诶？"],["何それ？」","啥玩意儿？」"],["「いや？なんでもないですよ？」","「没？没什么啦？」"],["大学入って知り合った頃、大神から借りたそっち系ゲームのネタでした。","是大学刚认识那会儿从大神那儿借来的那类游戏的梗。"],["分かんないわな、そりゃ。","你肯定不懂啦，那种东西。"],["「あ、やば！」","「啊糟了！」"],["「んあ？どうした？？」","「嗯啊？怎么了？？」"],["「…ごめんまこちゃん、\n携帯充電し忘れてたのさ。","「…抱歉真酱，\n手机忘记充电了。"],["冬夏からの連絡受けられないのだわ」","接不到冬夏的联络了呢」"],["「おおい…","「喂喂…"],["あ、でも此処で待ってれば来るわけだろ？","啊不过在这等着她总会来吧？"],["来たら謝りゃいいんでは？」","来了再道歉不就好了？」"],["「まあ、そうだけど…","「话是这么说…"],["まこちゃんの携帯から電話…","用真酱的手机打电话…"],["してみる？」","试试看？」"],["「や、いきなりは…","「别、突然打过去…"],["予定の時間まで待って、明らかに来ない時とかの\n最終手段にしよう。","等到约定时间，明显不会来的时候\n再作为最终手段吧。"],["そこまで神経質になること…ないよな？","没必要…这么神经质吧？"],["冬夏さんそういう人？」","冬夏小姐是会计较这种事的人？」"],["「んや、だいじょぶだと思うのだわ。","「不啦，我觉得没问题的呢。"],["じゃそうしよう。あと３０分くらいだね」","那就这样吧。还有三十分钟左右呢」"],["二人で昨日の公園に移動し、\n冬夏嬢の姿を探しながら待機することにした。","两人移动到昨天的公园，\n决定边寻找冬夏小姐的身影边等待。"],["ああ、まっ昼間になるとさすがにあったかい感じになるな。","啊，大中午的果然暖和起来了。"],["眠くなる…","好困…"],["夕べはちょっと…目が冴えてしまったので、\n疲労が取れてないのだろう。","昨晚稍微…清醒过头了，\n疲劳还没恢复吧。"],["「なあ、きぃ、ちょっとだけ寝ていいか？」","「呐，小贵，稍微睡会儿行不？」"],["いいつつ僕は既にベンチに横になり始める。","说着我已经在长椅上躺平。"],["知らないよ、冬夏が急に来ても。","管他呢，就算冬夏突然来了。"],["まあ来たら起こすさ、\n携帯一応貸しといて？」","来了就叫醒我呗，\n手机先借你？」"],["了解了解、と寝っ転がった体勢で貴奴に携帯を渡す。","了解了解，保持着躺平的姿势把手机递给贵奴。"],["「じゃちょっとその辺まで見てくるさ。","「那我去附近转转。"],["ゆっくり寝てるがいいのだわ」","你好好睡吧」"],["はーい…と言いつつ、春の陽気の中僕は…","好ー的…话音未落，我在春日和煦中…"],["眠りに………","坠入………"],["夢。","梦。"],["夢を見ていたのか。","是在做梦吗。"],["玄ノ森に居た頃の僕と、","在玄之森时的我，"],["二つ歳下の少女がいる―――","和年纪小两岁的少女―――"],["僕らは、","我们，"],["紙、","纸，"],["神、","神，"],["月、","月，"],["猫、","猫，"],["猫？","猫？"],["ねこ？","猫？"],["ねこがどうした？","猫怎么了？"],["ねころんで？","是睡着了吗？"],["「――ああ？」","「――啊？」"],["目が覚めた。","睁开了眼睛。"],["が、\n様子が変だ。","但，\n情况不对劲。"],["目の前に貴奴が居る、こっちを見て笑っている。","贵奴就在眼前，正对着我笑。"],["いやそれより、","不对比起这个，"],["この側頭部に感じる、","这侧头部感觉到的、"],["柔らかい感触はなんだ。","柔软触感是什么。"],["身体の右側を下にしていたので、\n左手で確認してみる。","因为身体右侧朝下躺着、\n就用左手确认看看。"],["温かい、","温热的、"],["布、","布料、"],["肉感、","肉感、"],["吐息、","吐息、"],["脈動、","脉动、"],["――まて。","――等等。"],["「うああ？？？","「呜哇？？？"],["ああああああ？？！！」","啊啊啊啊啊？？！！」"],["これは膝枕というしろものだ！！！！","这根本就是膝枕啊！！！！"],["だっ！だれかの太股を枕に、\n僕は寝てたぞ？？！！","靠！居然把别人的大腿当枕头、\n我就这么睡着了吗？？！！"],["きぃでもない！！！","才不是小贵！！！"],["おぼつかない動作で太股の主を見上げると、","用不稳的动作仰望着大腿的主人，"],["「ぷっ！","「噗！"],["――っははははは！」","――哈哈哈！」"],["屈託無く笑い声を上げる少女が。","无忧无虑发出笑声的少女。"],["春の陽光を照らし輝く、\n長きブロンド。","被春日阳光照耀得闪闪发亮的，\n长长的金发。"],["左目はガーゼで覆われているが、\n残る右眼は蒼き瞳。","左眼虽然被纱布遮住，\n但剩下的右眼是苍蓝瞳孔。"],["制服に身を包んだ、","身穿制服的，"],["「私の脚、寝心地良かったかな？","「我的腿，躺着舒服吗？"],["まことさん。","真言先生。"],["はじめまして、\n私が」","初次见面，\n我是」"],["「あっはははは！","「啊哈哈哈！"],["ごめんまこちゃん！！」","对不起啦小真！！」"],["あああああ。","啊啊啊啊。"],["きぃの笑い声も遠く聞こえる。","小贵的笑声也从远处传来。"],["僕を膝枕していたこの少女こそが、","让我膝枕的这位少女正是，"],["@r@r","@r@r"],["「三春冬夏です」@l","「三春冬夏」@l"]],"context":[["SC_M_006.ks/index/1/text"],["SC_M_006.ks/index/3/text"],["SC_M_006.ks/index/5/text"],["SC_M_006.ks/index/7/text"],["SC_M_006.ks/index/9/text"],["SC_M_006.ks/index/11/text"],["SC_M_006.ks/index/13/text"],["SC_M_006.ks/index/15/text"],["SC_M_006.ks/index/17/text"],["SC_M_006.ks/index/19/text"],["SC_M_006.ks/index/21/text"],["SC_M_006.ks/index/24/text"],["SC_M_006.ks/index/26/text"],["SC_M_006.ks/index/28/text"],["SC_M_006.ks/index/30/text"],["SC_M_006.ks/index/33/text"],["SC_M_006.ks/index/35/text"],["SC_M_006.ks/index/37/text"],["SC_M_006.ks/index/39/text"],["SC_M_006.ks/index/41/text"],["SC_M_006.ks/index/43/text"],["SC_M_006.ks/index/45/text"],["SC_M_006.ks/index/47/text"],["SC_M_006.ks/index/49/text"],["SC_M_006.ks/index/51/text"],["SC_M_006.ks/index/53/text"],["SC_M_006.ks/index/55/text"],["SC_M_006.ks/index/57/text"],["SC_M_006.ks/index/59/text"],["SC_M_006.ks/index/61/text"],["SC_M_006.ks/index/63/text"],["SC_M_006.ks/index/65/text"],["SC_M_006.ks/index/67/text"],["SC_M_006.ks/index/69/text"],["SC_M_006.ks/index/71/text"],["SC_M_006.ks/index/73/text"],["SC_M_006.ks/index/75/text"],["SC_M_006.ks/index/77/text"],["SC_M_006.ks/index/79/text"],["SC_M_006.ks/index/81/text"],["SC_M_006.ks/index/83/text","SC_M_006.ks/index/138/text"],["SC_M_006.ks/index/85/text"],["SC_M_006.ks/index/87/text"],["SC_M_006.ks/index/89/text"],["SC_M_006.ks/index/91/text"],["SC_M_006.ks/index/93/text"],["SC_M_006.ks/index/95/text"],["SC_M_006.ks/index/97/text"],["SC_M_006.ks/index/99/text"],["SC_M_006.ks/index/101/text"],["SC_M_006.ks/index/103/text"],["SC_M_00