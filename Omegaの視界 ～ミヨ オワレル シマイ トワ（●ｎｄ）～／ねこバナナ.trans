nd":4213}],[{"start":4219,"end":4229}],[{"start":4265,"end":4285}],[{"start":4291,"end":4333}],[{"start":4339,"end":4373}],[{"start":4437,"end":4464}],[{"start":4470,"end":4476}],[{"start":4482,"end":4498}],[{"start":4504,"end":4515}],[{"start":4521,"end":4525}],[{"start":4561,"end":4567}],[{"start":4628,"end":4632},{"start":5270,"end":5274}],[{"start":4638,"end":4655}],[{"start":4661,"end":4702}],[{"start":4708,"end":4720}],[{"start":4726,"end":4752}],[{"start":4791,"end":4801}],[{"start":4807,"end":4830}],[{"start":4866,"end":4900}],[{"start":4964,"end":4985}],[{"start":4991,"end":5012}],[{"start":5024,"end":5031}],[{"start":5037,"end":5093}],[{"start":5105,"end":5129}],[{"start":5135,"end":5143}],[{"start":5149,"end":5159}],[{"start":5165,"end":5179}],[{"start":5280,"end":5295}],[{"start":5301,"end":5311}],[{"start":5356,"end":5362}],[{"start":5368,"end":5410}],[{"start":5416,"end":5442}],[{"start":5448,"end":5491}],[{"start":5555,"end":5558}],[{"start":5564,"end":5618}],[{"start":5624,"end":5637}],[{"start":5673,"end":5683}],[{"start":5701,"end":5710}],[{"start":5716,"end":5756}],[{"start":5762,"end":5786}],[{"start":5804,"end":5812}],[{"start":5818,"end":5847}],[{"start":5853,"end":5894}],[{"start":5900,"end":5924}],[{"start":5963,"end":5969}],[{"start":5975,"end":5989}],[{"start":5995,"end":6003}],[{"start":6009,"end":6020}],[{"start":6026,"end":6045}],[{"start":6082,"end":6097}],[{"start":6103,"end":6115}],[{"start":6183,"end":6199}],[{"start":6205,"end":6220}],[{"start":6226,"end":6244}],[{"start":6282,"end":6290}],[{"start":6326,"end":6367}],[{"start":6373,"end":6387}],[{"start":6393,"end":6417}],[{"start":6423,"end":6438}],[{"start":6444,"end":6465}],[{"start":6471,"end":6476}],[{"start":6482,"end":6539}],[{"start":6578,"end":6603}],[{"start":6609,"end":6615}],[{"start":6683,"end":6687}],[{"start":6693,"end":6701}],[{"start":6739,"end":6755}],[{"start":6791,"end":6797}],[{"start":6803,"end":6827}],[{"start":6833,"end":6844}],[{"start":6881,"end":6894}],[{"start":6900,"end":6913}],[{"start":6949,"end":6958}],[{"start":6964,"end":6984}],[{"start":7022,"end":7043}],[{"start":7079,"end":7111}],[{"start":7117,"end":7134}],[{"start":7171,"end":7177}],[{"start":7183,"end":7197}],[{"start":7203,"end":7220}],[{"start":7226,"end":7250}],[{"start":7256,"end":7278}],[{"start":7314,"end":7321}],[{"start":7327,"end":7333}],[{"start":7372,"end":7392}],[{"start":7398,"end":7451}],[{"start":7457,"end":7467}],[{"start":7503,"end":7572}],[{"start":7578,"end":7595}],[{"start":7634,"end":7691}],[{"start":7737,"end":7747}],[{"start":7753,"end":7764}],[{"start":7800,"end":7808}],[{"start":7814,"end":7840}],[{"start":7933,"end":7941}],[{"start":7947,"end":7959}],[{"start":7997,"end":8015}],[{"start":8081,"end":8101}],[{"start":8137,"end":8175}],[{"start":8214,"end":8225}],[{"start":8231,"end":8240}],[{"start":8246,"end":8257}],[{"start":8294,"end":8300}],[{"start":8306,"end":8341}],[{"start":8347,"end":8376}],[{"start":8382,"end":8406}],[{"start":8474,"end":8494}],[{"start":8500,"end":8534}],[{"start":8570,"end":8582}],[{"start":8621,"end":8626}],[{"start":8632,"end":8656}],[{"start":8662,"end":8682}],[{"start":8688,"end":8707}],[{"start":8743,"end":8763}],[{"start":8769,"end":8791}],[{"start":8797,"end":8847}],[{"start":8853,"end":8855}],[{"start":8861,"end":8868}],[{"start":8874,"end":8900}],[{"start":8906,"end":8923}],[{"start":8929,"end":8966}],[{"start":8972,"end":8984}],[{"start":9002,"end":9019}],[{"start":9025,"end":9057}],[{"start":9075,"end":9083}],[{"start":9101,"end":9119}],[{"start":9137,"end":9154}],[{"start":9172,"end":9179}],[{"start":9197,"end":9207}],[{"start":9213,"end":9226}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_007.ks","basename":"SC_M_007.ks","indexIds":{"「もう、いつまでもむつけてないでさ、\n機嫌なおして欲しいのだわ」":0,"「そうだよまことさん。":1,"あ。なんなら脚といわずもっといい感触のところ、\n思う存分さわってもらっても良いけど。":2,"ねえ？どうする？」":3,"――まったく、\n面目ないというかなんというか。":4,"立つ瀬がないというか。":5,"完全に揶われてる。":6,"初回の一撃で主導権は握られてしまった。":7,"端からこっちにはそんなもん無いわけだが、\nこんなとこにまできてまた女子に弄ばれる運命とは…":8,"遊ばれるのは宮さんで馴れ――いや、十分だ。":9,"「もういいって…":10,"そういう逆セクハラはもう日常茶飯事なんだ…\nですよ僕は。":11,"これ以上女性不信の元を植え付けないでくれますか。":12,"それよりもちょっと、\nお話したいことがあるんですが――」":13,"「あー、\n丁寧語なんかやめてほしいな。":14,"年上なんだから。":15,"きぃとも砕けて話してるんでしょ？」":16,"「そうさまこちゃん、\nわたしと冬夏同い年だよ。":17,"これで冬夏にだけ他人行儀だったら\nわたしだけ酷い扱いなのだわ」":18,"格差社会の闇がこんな所にもあるのさ、\nと泣き真似をするきぃであった。":19,"あのな…":20,"「わかりまし…じゃない、\nあー、わかったよ。":21,"きぃ一人だけならともかく、\n僕は基本的に女性には丁寧語を使ってる日常なの。":22,"切り替えが難しいんだよ」":23,"「ふふ、":24,"まあ私もね、\n家の中では良家の令嬢たれと強要されてるから。":25,"気持ち分かるよ。":26,"よろしくてよお母様、なあんて喋ってるんだ。":27,"肩凝っちゃうよ？":28,"じゃあせめて私たちだけでいるときは」":29,"素直な自分を出そうよ。":30,"と冬夏嬢が、顔を近づけてきて言った。":31,"青い瞳が一つ、金の髪の波うつ動きを伴い迫る――":32,"「あ、ああ。":33,"そうですか。":34,"ま、僕の場合、もはや鯱張ってるほうが素なんです…\nなんだけどね。":35,"努力するよ。":36,"にしても」":37,"きぃと同い年だったのな。":38,"とはいえ物腰はさすがに違う。":39,"人をあしらうオーラというか、\n本人は嫌がるかもだが、先日会った冬夏嬢の母上殿、\nのぎかさんに通じるものがある。":40,"宮さんとはまた別の感じ。":41,"「とにかく。":42,"ほぼ初対面の女子といきなりフランクに喋れるほどには、\n僕も若くもなければ老成もしてないって事。":43,"純粋に緊張してんです、だよ」":44,"そう。":45,"大体にして、今のこの状況は何。":46,"僕らは今公園のベンチに３人で座っているのだが、\n何故君らは僕を真ん中に据えるんですか。":47,"そうでなくてもあれだけ恥ずかしい紹介のされ方をし、\nむつける――むくれる、の意らしいが――わけではなく、\n単純に赤面してまともに顔を見られないというか\n喋ることができないでいたのだった。":48,"冬夏の…この容姿の件に関して気を遣うどころではない。":49,"そういう意味では、\n普通に紹介されるよりは良かったのかもだが。":50,"「へーえ。":51,"まことさん彼女さんとかいるのかな？":52,"いいなーえろえろだ」":53,"ざーんねん、":54,"と言われても！":55,"「や、え、えろって…":56,"違うちがう！":57,"てか女子が何言ってるデスカ！":58,"僕ぁ彼女も居ないしエロでもない！」":59,"…いくら宮さんのセクハラには耐性があるとはいえ、\n（少なくとも外見上）年の頃が、\nより近い女子二人相手となると少々話が違う。":60,"ちょと刺激が強すぎます。":61,"僕が旧態依然としてるだけなのか？":62,"今ってこんな世の中？":63,"「ふええ？":64,"じゃ誰にされてるのさ、セクハラ？":65,"大人の会話なのだわ」":66,"「え？":67,"ああまあ、職場の上司とでも言おうかな…":68,"そこにこれ以上引っ掛かんなくてもいいよきぃ。":69,"そんなことよりも、冬夏さん、」":70,"「冬夏」":71,"「…うー、":72,"冬夏。":73,"いきなりで不躾なんだけども、\nその眼はどうしたの？":74,"『ものもらい』かなにか？」":75,"「あー。":76,"そうさ。":77,"私も聞いてないのだわ。":78,"どしたの」":79,"「ん？":80,"ああ。":81,"ま、":82,"そんなとこ。":83,"気にしないで」":84,"あ、ちょっと歯切れ悪いな。":85,"いかな冬夏でもあまり触れて欲しくないとこだったか。":86,"話題転換に無難なネタのつもりだったんだけど…":87,"んー、まだ距離感掴めないなー。":88,"うう、失態だった。":89,"こちとら緊張もしてるし、空腹でも眠くもないのに、\n脳は空転してるのだ。":90,"少々気をしっかり持たねば。":91,"ま、それより本題。":92,"と彼女の方から話題の方向転換は為された。":93,"きぃは『ふーん？』といった感じで、\n例のぎろりとした眼で冬夏を凝視していたが、\nそれ以上の追求はしなかった。":94,"「実は":95,"卑":96,"尊さんだけど」":97,"「あー。明日来るって聞いてるさ。":98,"それ伝えに冬夏ん家行ったのだわ」":99,"「聞いたよ母様に。":100,"あの人、きぃのこといつまでたっても覚えないね。":101,"初見みたいな反応したんでしょ？":102,"自分に得になる人間以外眼中にないんだ、あの人にとって。":103,"まったく――」":104,"「いいよいいよ。":105,"覚えられても逆に厄介そうだしさ。":106,"気にしてないのだわ」":107,"ごめんね、と言いながら冬夏は話を続ける。":108,"ほぼ、僕を挟んで二人の会話になってるが、\nとりあえず要所で頷いたりしておく。":109,"…だから、\n言葉を発する度そんなに僕に密着せんで頂けますか。":110,"「実は今、あもう晴れたのかな？西の方、大雨なんだって。":111,"春の嵐だね。":112,"それで昨日新幹線とまったみたい。":113,"一日遅れるんだってさ。":114,"つまり」":115,"明日、土曜。":116,"「そう。":117,"で、母様が直々に迎えに行くみたい。":118,"卑尊さんは中央で一日泊まって、\n迎え行って戻ってくるのは実際は日曜なんだ。":119,"ふふ、ここ田舎だからね。":120,"まことさんも体験したと思うけど、移動時間かかるのね」":121,"「ああ、そりゃもう。":122,"中央から朝に出発して、着いたの昼過ぎだったよ」":123,"飯を食う＋旅館までの行程を入れれば、\n完全に夕方だったけど。":124,"「母様も今回は珍しく自分で出向くんだよね。":125,"なんか私の眼の事で焦ってるみたいだけどね。":126,"あ、聞いてる？":127,"そう、卑尊さんは診療所の人で、\nそこはずっと主治医っていうか、\nうちの専属みたいになってるんだ。":128,"他の病院には私を診せたくないみたいでね、母様も。":129,"その診療所が今、":130,"――ま、色々あって。":131,"まだこんな痛々しい姿なわけ」":132,"そこでわたしバイトしてるのさ。":133,"言ったよまこちゃん」":134,"聞いてます。":135,"そこがほぼ三春家専属で、今回死人が出たのもそこだと、\n宮さんから聞いている。":136,"一応知らぬ振りを装い、さも初耳のように反応しておく。":137,"てか、仮にまともに診療所が稼動してても、\nそうそうすぐには全快しないでしょう。":138,"「で。":139,"綾目とか狩屋の家にも用があるとかで、\nそれは出発前の話だけど、\n結構長めに母様は家空けるの。":140,"他の家人とかは居るけど…」":141,"まあ多分大丈夫だね。":142,"と、冬夏は言った。":143,"しばらく続きを待ったが、\n彼女は笑みを浮かべたまま会話はそこで途切れた。":144,"…その自信の根拠は、特に説明してくれないんだな。":145,"と、思い出した。":146,"知狡さんに、調査前に本家の用を済ませたいと言われてたっけ。":147,"丁度良いと言って良いのか、とりあえず、\nギリギリではあるが一日空くわけだ。":148,"この会談が終わったら即知狡さんに連絡しなくては。":149,"「なるほど。":150,"じゃあ大体はそういう感じか…":151,"詳しいことは――":152,"何か食べながらにする？":153,"それとも人いないし此処の方がいいかな」":154,"「ちょっと待って、まことさん。":155,"まず携帯番号交換しよう」":156,"「あ、わたし持ったままだったね。":157,"はいまこちゃん。これ返すのさ。":158,"着信とか待ち受けとか何も見てないから":159,"安心するのだわ」":160,"そうわざわざ断られると、\n逆に見られたと思わざるを得ないでしょうが、きぃ。":161,"待ち受けなんてあれだぞおい。":162,"設定変えただけで…削除はしてなかったんだからな。":163,"や、だってこの携帯借り物だし！":164,"決して変な意味で残してた訳じゃないですよ？":165,"ま、まあ。":166,"ともあれ、実際あれが見られてたなら、\nきぃももっとドン引きしてるだろうから、\nここは信用しとくよ…":167,"「あれ、つーか、さっききぃが冬夏に連絡してないの？":168,"この携帯で」":169,"「ふえ？":170,"あ、そうなのさ。":171,"履歴登録すればそれで済むのだわ」":172,"そういえば。":173,"冬夏は知らない番号からでも、電話に出るタイプか…":174,"大神とはえらい違いだ。":175,"「なるほどね。ありがとう。":176,"で、どうしようかな？きぃ」":177,"「ん？平気なのさ。":178,"どうせお客なんか人っ子一人いないのだわ。":179,"きぃをナめて貰っては困ると言ったはずだよ」":180,"その辺のことも折り込み済みなのさ、\nと言ってるんだが…。":181,"それはおいほんとに美味い店なのか。":182,"「だってさ。":183,"ま、平日といえば平日だしね。":184,"他の学生はね、久しぶりの再会だし。":185,"みんなもっとプレイスポット的な所？に行ってるよ。":186,"カラオケあーんどボウリング、お決まりコース」":187,"田舎だからね。":188,"とまた笑う。":189,"「んーまあ中央の方もそんなもんだけどね？":190,"僕も色んなとこ旅行したけどさ、\n要は情報入手の速度と頻度の環境が、\n整っているか否かだよ。":191,"中央と地方の違いは」":192,"個人で能動的にアンテナを張る事は勿論肝要なわけだが、\n受動的に入ってくる領域の情報を受信出来るかどうかが、\n大きな差違だ。":193,"と、大神はよく言っておりましたよ。":194,"「痛々しいローカル番組は中央にも同レベルのが山程あるし、\nだから田舎がどうとか気にしないでいいんでない？」":195,"別に気にしてないよ？":196,"人多いところ嫌いだし」":197,"あ、そうですか。":198,"思わず僕の個人的趣向を語ってしまったじゃないですか。":199,"「行こう行こう。":200,"もう食べながらでいいさ。":201,"そのためのぉ！お食事会合でしょおー？":202,"もうほらみてよ手が震えだしてるのだわ…」":203,"きぃがもうおかしなテンションになり、\n両手をこっちに突き出して来る。":204,"「おおう低血糖症かよ。":205,"じゃもう行こうか。":206,"冬夏も、じゃ、宜しく」":207,"「ただ、ま。":208,"今のうち言って置くけど、\n私も詳しく全部知ってる訳じゃないよ？":209,"あの蔵に関しては……必要最低限の事しか教えられてないんだ。":210,"手引き役が出来るくらいで基本的にはきぃ達と一緒」":211,"「まさにそこが大事だったんだからいいさ。":212,"なんかあったとしても、\n逃げ足は速い方だから安心するのだわ」":213,"あのな、僕はどうなるよ。":214,"「僕は――":215,"…まあこうも急に話が進むとは思ってなかったから。":216,"今回特に成果がなくても、別に想定内だし。":217,"だからあんまり責任も感じなくていいよ」":218,"前半はともかく、これは勿論本心ではない。":219,"ここでモノが見つかれば用事はほぼ済むのだし。":220,"きぃにはまだ、「中が見たい」と言ってあるだけで、\n特定のモノを探している事も曖昧にしてある。":221,"ん？":222,"と、いうより。":223,"きぃも中が見たいから、こういう事態になったのだよな。":224,"彼女にも、目的があるということか？":225,"それとも単なる好奇心か、或いは、\n僕と同じように何かを探している？":226,"…後者は考えすぎかなあ。":227,"と、冬夏がベンチから立ち上がった。":228,"こちらを見ずに小さな声で、\n微かに呟いたのが聞こえた――":229,"ただとにかく――":230,"私はヤソウのシュから逃れたいんだ――":231,"そのためのハカイなら躊躇はしない。":232,"そう聞こえた。":233,"きぃがまたあの眼で、":234,"じっと彼女を凝視していた。":235},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_007.ks","relPath":"/data/scenario/SC_M_007.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":236,"length":236,"percent":100},"cellInfo":[[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],null,null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[97,1],"note":"完成"},"/data/scenario/SC_M_008.ks":{"data":[["「あー、まあなかなかいいんでないの？","「啊——嘛不是挺不错的吗？"],["こういう風情は嫌いじゃないよ」","这种风情我倒不讨厌呢」"],["多少今時の建築物ではあるものの、\n明らかに民家の一階を改装したような大衆食堂、","虽说是多少带点现代风格的建筑物，\n但明显是把民宅一楼改装成的大众食堂，"],["というか定食屋？","或者说套餐店？"],["二階は完全に居住空間である。","二楼完全是居住空间。"],["洗濯物ばりばり干してあるし。","晾晒的衣物都哗啦啦挂着呢。"],["当人らの意図は伺い知れないのであくまで主観だが、\nどうみても外装に気を遣った感はない。が、\n中央の方にある、人為的隠れ家的な処とは違う、\n計算がないところが好ましい。","由于无法揣测当事人意图所以纯属主观感受，\n怎么看都不觉得外装修费过心思。不过，\n和中央地带那些人工打造的隐秘居所不同，\n这种未经算计的感觉反而讨喜。"],["穴場、と言ってしまうと、\nどうもメディアによる操作感ありの\nイメージになってしまうので言いたくはないが。","要说成是宝藏店铺的话，\n总觉得会变成媒体炒作出来的\n那种形象所以不太想说。"],["「あんまり小洒落た所似合わなそうだもんね。","「毕竟你看起来就不太适合去那种小资情调的地方呢。"],["似合わないっていうか苦手そう」","与其说不适合倒像会浑身不自在」"],["「…どうせ似合わないよ僕には。","「…反正我肯定不适合啦。"],["いいんだ別に。","无所谓了。"],["そういうとこの客層は苦手だしね」","再说我也应付不来那种店的客群」"],["人混みとかコンパが嫌いな僕が、\n今風の店になんか行ける訳がない。","像我这种讨厌人群和应酬的人，\n怎么可能去得了时髦店铺。"],["だいたい小洒落てる＝美味いという訳でも無いし。","说到底装修小资≠好吃啊。"],["むしろ、","倒不如说，"],["「物食べるのに、\n周りや何やに色々気遣うのは面倒なんだよ。","「吃饭还要\n在意周围环境什么的太麻烦了。"],["店員さんもお爺ちゃんお婆ちゃんみたいなのだと、\nより結構」","店员要是老爷爷老奶奶那样的，\n反而更好」"],["と言ってやった。","我这么说道。"],["大神曰く、\nそれは僕が主として同年代に対して変にコンプレックスを\n持っているのではないか、ということだが。","大神说，\n这大概是因为我对同龄人有着微妙的\n自卑心理。"],["つまりは、同世代を生きる者として、\n時勢に乗れてない（と、思いこんでる）自分を無意識に恥じてる\n結果じゃないか、ということらしい。","换言之就是作为同世代生活者，\n潜意识里羞耻于没能跟上潮流（自以为）的\n结果。"],["オタやってるとそういうことは良くある、とも言ってたけど。","他还说宅男常有这种心态。"],["価値観なんて好きか嫌いかだから、それを突き通せるか否かで、\n人間関係や他人の評価も有る程度固まるんだと。","价值观无非是喜不喜欢的问题，能否贯彻这点\n会很大程度上决定人际关系和他人评价。"],["…なんか知狡さんが橋の上で言ってた事と似てるな。","…和知狡阿姨在桥上说过的话有点像呢。"],["まあいいや。","算了不管了。"],["――実際のところ、理由なんてどうとでも後付できる訳で、\n僕自身は、\n入力された情報に対しての出力がこうであるとしか言いようがない。","――实际上理由什么的随时都能编，\n对我自身而言，\n只能说输入的信息产生的输出就是这样。"],["嫌いなの、人混みとか、面倒なのが。","就是讨厌啊，人挤人还有麻烦事。"],["「やっぱりねー。","「果然啊。"],["中央でもそんなだったんだ？」","在中央区也这样？」"],["悪かったですな。","真是抱歉呢。"],["更に言い訳するならば、\n宮さんとこのバイトで多少稼ぎがあったとはいえ、\n本だのの購入費にあてつつ旅行代にも回していれば、\n食事も学食とか、","要再辩解的话，\n虽然在宫小姐那边打工赚了点钱，\n但既要买书又要攒旅行费，\n吃饭基本不是食堂就是"],["まさに目の前のようなのに入り浸るを得ないわけで、\n結果高そうな店なんか行くことは殆どなかったさ。","眼前这种店不得不常驻，\n结果几乎没去过看起来贵的店。"],["それ以前に、この辺には小洒落た店なんかないだろ？","再说了这附近根本没什么小资店吧？"],["あるのか？","有吗？"],["「なるほど、私の田舎者としての偏見だったか。","「原来如此，是我乡下人的偏见吗。"],["中央の大学生ともなれば、\nさぞや…って、ああもう社会人だっけ？","中央区的大学生的话，\n想必…啊对了已经是社会人了？"],["職場の上司からセクハラされてるんだよね」","正被职场上司性骚扰来着」"],["………。","………。"],["そういう話は聞き流しておいて頂きたかったんですが…","这种话题本来希望您当耳旁风…"],["ここは素知らぬ振りをして話を進める。","这里就装作没听见继续话题。"],["「まあどこも半々じゃないのかな。","「嘛哪边都半斤八两吧。"],["大学生なんてボンボンか苦学生、みたいなところあるし。","大学生不是公子哥就是穷学生，差不多就这两种吧。"],["田舎だろうが中央だろうがその辺は…","不管是乡下还是中央都差不多…"],["まーきぃにも小洒落た処にしてくれと言ったわけじゃなし、\n肝心なのは味だ味」","嘛~我也没要求小贵整那种花里胡哨的店，\n关键是味道啊味道」"],["「だから、個人の味覚次第だから、","「所以我说了，这取决于个人口味，"],["保証は出来ないって言ったよ。","没法保证合你胃口啦。"],["でもま、自信はあるけどね。とにかく入るのだわ」","不过嘛，我还是有自信的。总之快进来吧」"],["こちらの返事を待たずにドアを開け、","小贵不等我们回应就推开了门，"],["振り向くきぃ。","回过头来。"],["もう待ちきれないかい。","已经等不及了吗。"],["冬夏は来たことあるらしく、さっさと中へと入る。","冬夏似乎来过，麻利地走进店里。"],["ああ、そういや味知ってるんだもんな。","啊对哦，她知道味道来着。"],["体験済みなわけだ。","算是体验过的人。"],["「あ、まこちゃんここ食券制だから、\nほらこっち来るのだわ」","「啊，小真这里是餐券制，\n来来这边啦」"],["「はいはい。","「知道啦知道啦。"],["僕の奢りですからねーっと、\nどうれ…」","今天我请客所以——\n来选吧…」"],["食券自販機にはボタンがずらりと並んでいる。","餐券贩卖机上密密麻麻排满按钮。"],["基本らしきメニューが、更に並や大盛りなど、\n量に分かれていくつかと、\n単品兼トッピングメニューが多数、\nボタン部の紙に手書きで書いてあった。","基础菜单分为普通份和大份等，\n不同分量有好几种，\n还有大量单品兼配料菜单，\n都是手写在按钮部位的纸片上。"],["基本メニューは大体３００～５００円で、\n単品は１００円前後で色々ある。","基础菜单大概300~500日元，\n单品100日元左右种类很多。"],["まあ格別バカ安か、と言われると微妙なラインだな。","要说特别便宜倒也谈不上，算是微妙的价格区间吧。"],["と思いつつ、きぃに五千円札を渡す。","边想边递给小贵五千日元钞票。"],["「ま、今回はこの範囲でご自由に。","「嘛，这次就随你在这个范围内挑。"],["で良いかいきぃ？」","这样可以吧小贵？」"],["「ふおお！","「呜哇！"],["まじ！！","真的假的！！"],["やた！！！","太好啦！！！"],["先にまこちゃんと冬夏選ぶさ、","先让小真和冬夏选，"],["残金わたしが消化するのだわ！！」","剩下的钱我来解决！！」"],["お前そんな、俺らの意見を聞いてから…","喂你这家伙，好歹先问问我们…"],["って冬夏を見ると、彼女はさも当然のように、\n動じることなく自分の分を選びに入っている。","看向冬夏时，她正理所当然般\n面不改色地挑选自己那份。"],["…いつもの事なのか、こんな事でがっつく程\n困っていないのか……","…是习以为常了，还是说\n并没拮据到要这么狼吞虎咽……"],["「………まあいいけどな。","「………算了随你吧。"],["しかし、仮に僕らが千円分くらいずつとしても、\n…食えるのかお前？","不过就算我们每人只吃一千日元左右，\n…你吃得完吗？"],["別に全額消費せんでも……」","不用全部花光也行啦……」"],["「いいからいいから。","「安啦安啦。"],["早く選ぶさ。","你们快选。"],["余計な心配ご無用なのだわ」","别瞎操心啦」"],["「うん、この子食べるよー。","「嗯，这孩子能吃完哦—"],["仮にね、１万出してもその分食べると思うな」","就算拿出一万日元她也能吃掉对应分量呢」"],["――うそーん。","――骗人的吧。"],["と、とりあえず五千円にしといて良かった。","总、总之幸好只给了五千。"],["ほんとかどうかは、まだ半信半疑だが、\n冬夏の眼も口振りも大真面目、全く巫山戯てない。","虽然还半信半疑，\n但冬夏的眼神和语气都极其认真，完全没在开玩笑。"],["「ら、らじゃー。","「那、那么—"],["え、えーとじゃ僕はどうしようかな。","呃—我该选什么呢。"],["何かオススメある？」","有什么推荐吗？」"],["きぃに問うてみる。","试着询问小贵。"],["「ううん、まこちゃんて食べれるほう？","「唔嗯，小真你饭量大吗？"],["並でも結構な量あるからさ、\nまずはノーマルのこれ、\n","普通份量就挺多的，\n建议先试试这个基础款，\n"],["いってみるといいのだわ」","保险起见啦」"],["そういってきぃが指さしたのは、『肉野菜丼・並』","小贵指着『肉菜盖饭・普通』说道"],["まあ、読んで字の如くだろう。","嘛，看名字就知道是什么了。"],["変なメニューはあとで一人の時に頼むとして、\nまずはそれを頼む事にする。","奇怪的菜单等独自来时再尝试，\n这次就先点这个吧。"],["「あでも最初は小盛りのほうがいいかなあ…」","「啊不过刚开始还是点小份比较好吧…」"],["おい、押してもうたがな。","喂，已经点了啊，说太晚了。"],["てかそんなに多いんか。","话说量有那么多吗。"],["まあ、とはいえだ。","嘛，不过话说回来。"],["こんなだが僕とて育ち盛り食べ盛り？の男子である。","即便如此我也是正值发育期能吃能喝的？男生啊。"],["多少の量には対応できるだろ。","这点量应该没问题吧。"],["「私これね。","「我选这个。"],["今回は…ふふ。","这次…呵呵。"],["こんな愉快な人を紹介してくれた事だし。","毕竟介绍了这么有趣的人给我。"],["きぃにいっぱい食べさせたげよう」","想让小贵多吃点呢」"],["冬夏が選んだのは、\n『野菜丼・小盛り』","冬夏选择的是\n『蔬菜盖饭・小份』"],["という、一番安い基本メニュー１枚だった。","这个最便宜的基础菜单。"],["野菜丼たって鳥唐揚ついてるらしいけど。","虽说是蔬菜盖饭好像也配有炸鸡块。"],["「さっすが冬夏、\nわかってるのだわ」","「不愧是冬夏\n很懂嘛」"],["「じゃとっとと席つこうか…」","「那赶紧找座位吧…」"],["なんかもうぐったりです………","已经累瘫了………"],["周りを見渡すと、昼時をやや過ぎているせいか、\n客はまばらだ。","环顾四周，或许因为刚过午餐高峰\n客人稀稀落落的。"],["きぃが言っただけあって、\n学生らしき層は殆どいない。","正如小贵所说\n几乎看不到学生模样的人。"],["「いわば長距離運転手さん御用達なのさ。","「可以说是长途司机们的定点餐馆。"],["あとは工事の人達とかよく来てるのだわ」","还有就是工地的人经常来呢」"],["「あときぃが、さっきああは言ったけどね、\n学生達でいっぱいになる時間帯もあるんだよね。","「啊还有小贵虽然刚才那么说\n其实也有挤满学生的时间段哦。"],["うちの高校含めて近隣の運動部で」","包括我们高中附近的运动社团」"],["ただそれは練習後の夕方とからしく、\n昼や、今日の始業式のような日は別らしい。","不过那好像是傍晚训练结束后\n中午或是像今天开学典礼的日子就另当别论了。"],["「ふーん…それなりにタイミングみないといけないわけな。","「唔…看来要挑对时机才行。"],["と言うことは、\nきぃも別に顔馴染みとかっていう訳ではないんだな？」","这么说来\n小贵你其实也不算这里的熟客吧？」"],["「まー、色んな時間帯行ってるしね。","「嘛，我来的时间段比较分散。"],["ここはバイトの人多いし、","这里打工的人又多"],["顔を覚えられなくて便利さ」","记不住长相反而方便」"],["仕事中はともかく、わたし服いっつも同じのだから、\n恥ずかしいのだわ。","工作时另当别论，我平时总穿同一件衣服\n会很难为情的。"],["ときぃは言った。","小贵这么说道。"],["そういうことね。","原来如此。"],["一瞬物騒な事を連想してしまっただろうが。","虽然一瞬间联想到危险的事情。"],["それにね、ときぃは続ける。","而且啊，小贵继续说着。"],["「鬱陶しいしょ常連だからって話しかけられると？」","「被当成常客而烦人地搭话很讨厌吧？」"],["まあ、わからんでもないけどな。","嘛，倒也不是不能理解。"],["ちょっと毒舌だなきぃ。","小贵还挺毒舌的嘛。"],["「まあな…","「是啊…"],["僕は旅行中、新幹線で隣り合った見知らぬお婆さんと、\n目的地まで３時間近く喋り続けた男だけどな。","我旅行时可是在新干线和陌生老太太\n聊了近三个小时直到目的地的男人。"],["じゃ床屋で話しかけられたりするのも嫌そうだな」","看来你连理发时被搭话都会嫌烦呢」"],["「あんねーそれも探し回ったさ！","「那个啊也是千挑万选的！"],["安くて腕がよくて客に話しかけない処。","要找价格便宜技术好还不和客人闲聊的店。"],["これはなかなか骨が折れたのだわ…」","可费了不少功夫呢…」"],["「そういえば新学期早々面倒な行事があるんだよね。","「说起来新学期刚开始就有麻烦的活动吧。"],["運動会？","运动会？"],["体育祭だっけ？","体育祭来着？"],["球技大会だっけか？」","还是球类大赛？」"],["「あー、わたしに聞かれても分かんないけど、\n確かそうじゃない？","「啊—问我也不知道啦\n好像是吧？"],["ふああ、今日朝早くて眠いのだわ」","哈啊，今天起太早好困啊」"],["うちの母さんもそうだったけど、\n女性は何故こうも咬み合わない会話を齟齬なく…\nと言う訳ではないな、\n指摘し合う事無く続けられるのだろう。","虽然我妈也这样\n为什么女性总能毫无违和地进行这种鸡同鸭讲…\n倒也不是\n不用互相指正就能持续下去的对话呢。"],["ごーいんぐまいうぇい。","Going my way。"],["にしたって、\n互いにそれを突っ込まないのがすげえ。","就算是这样，\n彼此都不戳破这点才叫绝。"],["目の前で展開されてる二人の会話は、\nまだ通じてる方だが、\n母さんより上の世代あたり同士の会話は、\n端から見て不思議でしょうがなかった覚えがある。","眼前这两人展开的对话，\n好歹还算能沟通，\n但老妈那辈人之间的对话，\n记得小时候看着总觉得不可思议极了。"],["…一般論というにはサンプル少なすぎだけど。","…虽然作为普遍案例样本量实在太少。"],["ところで冬夏さん、\n制服のまま来て臭いとか大丈夫か？","话说冬夏小姐，\n穿制服来这种油腻腻的店没关系吗？"],["どうにもこの店油っぽいんですけど…","总觉得这家店油烟味超重…"],["「ん？","「嗯？"],["大丈夫だよ。","没问题的。"],["替えはあるし帰ったら洗濯するから。","有替换衣服而且回去就会洗。"],["それに」","再说了」"],["あれもあるから、","还有那个啦，"],["と言いながら、身体にスプレーする所作をする冬夏。","边说边做出往身上喷喷雾动作的冬夏。"],["名前が出てこないらしく、代名詞を連呼している。","似乎想不起产品名，只好不停用代指。"],["恐らく香水だの、臭い消しか何か持ってるってことだろう。","大概是带了香水或者除味剂之类的东西吧。"],["成る程ねー。","原来如此啊ー。"],["と、本題には入らず、\n取り敢えずはぐだぐだどうでもいい話をしていた。","就这样没进入正题，\n暂且先东拉西扯些无关紧要的话。"],["多少他の処より待ち時間が長い感じではあったが、\nそれは僕がいつもゴゴイチとかの、\n早い店ばっかり行ってる所為かも知れない。","感觉比其他店等餐时间稍长些，\n可能因为我一向都去五五壹这类\n上菜超快的店吧。"],["やがて料理がきた。","不久料理上来了。"],["「…おおい。","「…喂喂。"],["おおおおい。","喂喂喂喂。"],["なんですかこれは」","这是什么情况」"],["あの。","那个。"],["まず器が丼です。","首先容器居然是碗。"],["しかも所謂牛丼だののより何まわりもでかい。","而且比什么牛肉饭用的碗要大上好几圈。"],["というかこれラーメン用器じゃねえの？","话说这根本是拉面碗吧？"],["それにご飯やら野菜やら肉だののおかずが、\nごそっと盛られているのですよ。","再加上米饭啊蔬菜啊肉类配菜什么的，\n全都堆得跟小山似的。"],["僕のは並だからか、満載ではなく、\n器に対して半分程度の盛りなんだが、\n目の前のきぃのは…って、","我点的普通份量所以还没堆满，\n大概只装了碗的一半高度，\n但眼前小贵的…等等，"],["げ！","靠！"],["「あ？","「啊？"],["ちょとまてきぃお前、\n食えんのそれ？","慢着小贵你，\n真能吃完那玩意？"],["うあ、まてまてまて、\nおいおいおい」","哇等等等等，\n喂喂喂」"],["「ふええ？","「呜诶？"],["どうしたのさ？","怎么了嘛？"],["あ、ま、驚くかなこれは。","啊、那、这个确实会吓到人呢。"],["初心者には刺激が強すぎるのだわ」","对新手来说刺激太强了哟」"],["冬夏も僕も単品だったので、\n二人でほぼ千円近くだろ、\n単純にきぃは僕らの４倍の値段分食うわけだ。","我和冬夏都只点了单品，\n两人加起来还不到一千日元，\n简单来说小贵要吃下价值我们四倍价钱的食物。"],["で、大盛りがこれか…","所以特大量就是这规格吗…"],["ぱっと見、丼からあふれる程に盛ってる訳ではないので、\n一瞬ふうん？とか思うのだが、\nラーメンドンブリの大きさに、\n普通に見えるように盛ってるわけですこれが。","乍看倒没有满到碗沿那么夸张，\n会让人瞬间产生不过如此的错觉，\n但配合这个拉面海碗的尺寸，\n其实已经堆出普通碗的视觉效果了。"],["相対的に当然そりゃあそれなりの量になってるし、\n大体きぃはトッピングも結構追加してるのだった。","相对而言分量自然相当可观，\n而且小贵还加了不少配料。"],["そして、何よりも、\nそれが一つじゃない。","更关键的是，\n这玩意不止一碗。"],["複数個なんですけど！","有好几碗啊！"],["…店員もそら間違えて僕の前に丼置いていくよ……","…难怪店员会搞错把碗放我面前……"],["「んじゃま、取り敢えずえー、乾杯？","「那姑且先、呃、干杯？"],["ただの水だけどっ」","虽然只是白开水啦」"],["「まことさんとの出会いに乾杯ー」","「为与真言先生的相遇干杯ー」"],["唖然とする僕を余所に、\nきぃが場を仕切っていく。","不顾目瞪口呆的我，\n小贵自顾自掌控起场面。"],["こいつはもう既に食いに集中しつつあり、\n気がそぞろであるのが丸分かり。","这家伙已经只顾着埋头猛吃了，\n心不在焉的样子完全写在脸上。"],["しかし冬夏も特に異議を唱えず、淡々と従っていく。","但冬夏也没提出异议，只是默默跟着行动。"],["しょうがないな…","真拿你没办法…"],["「…かんぱーい」","「…干杯」"],["ちーん。","叮。"],["これ以上出費がないと分かってるからいいものの、\n今後きぃと食いに来ることあるときゃ心しておこう…","好在知道不会再有额外开销，\n不过下次和小贵来吃饭时可得留个心眼…"],["「それではいただきます…」","「那我开动了…」"],["ぱき。","咔嚓。"],["御","把"],["手","手里的"],["元を口に銜えておっさんのように割ると、","筷子像大叔那样叼在嘴里掰开，"],["「あー、話進めといて構わないよ？","「啊—，你们继续聊不用管我？"],["わたしあそこの中に入れてくれたらそんでいいからさ。","只要让我进到那个里面就满足啦。"],["じゃ、お二人さん、お任せするのだわ」","那就拜托你们两位咯」"],["と言い放ち、","这么宣布后，"],["食事、というか摂食を開始した。","开始了进食——或者说饲料摄取行为。"],["「――うわー、","「――呜哇，"],["テレビみてえだ…」","简直像在看电视购物…」"],["そんなにがっついてるわけではないのに、\nみるみるうちに減っていく料理。","明明没有狼吞虎咽，\n菜肴却以肉眼可见的速度消失。"],["いつもお腹空かしてるからとかそういうレベルでは\n無いなこれ。","这已经超出平常肚子饿的程度\n太多了。"],["単純にこいつが大食いなんだ…","纯粹就是这家伙太能吃…"],["――と、とりあえず僕も食べることにする。","――那、那我也先开动吧。"],["これ以上見てるとそれだけで満腹なりそうだ。","再看下去光看就饱了。"],["そして冬夏と話進めようにも、","正想和冬夏继续话题，"],["「話は食べちゃってからでいいでしょ。","「等吃完再说啦。"],["きぃは私達と多分同じくらいに食べ終わるとみた」","小贵应该会和我们差不多时间吃完」"],["だとさ。","她这么说。"],["…まあ、目の前を見る限り疑問を挟む余地はないので、\n従いますとも冬夏御嬢様。","…也罢，眼见为实确实不容置疑，\n遵命冬夏大小姐。"],["「あー、","「啊—"],["まー、","嗯—"],["美味いわ。","好吃。"],["ただちょっと量がさ、\n多すぎるんではないかしら…」","就是量这个嘛，\n是不是有点太多了…」"],["実際口をつけると、\n見た目から想像した以上にボリュウムがある。","实际尝起来，\n比看起来的分量还要扎实。"],["野菜類、海藻類、卵に肉etc、そしてご飯。","蔬菜类、海藻类、鸡蛋和肉等等，还有米饭。"],["うあ、納豆とバナナ（丸々１本）も付いてました…","呜啊，连纳豆和香蕉（整根）都有…"],["最初は格別安いとは思わなかったが、\nこの量にしてその価格、\n相対的には格安なわけな。","起初没觉得特别便宜，\n但以这个分量对应价格，\n相对而言确实划算。"],["コストパフォーマンスは確かに良いなー。","性价比确实很高啊—。"],["あくまで、食べ切れた場合は、だけど…","当然，前提是能吃完的话…"],["きぃの大盛りは当然として、\n僕の並盛りもかなりということは分かった。","小贵的大份自不必说，\n我的普通份量也相当可观。"],["次来るとしたら小盛りで十分だなこりゃ。","下次来点小份就够了。"],["あとちっと油っこいかなー。","另外稍微有点油腻啊—。"],["もう少し歳いったら、小盛りにしても食える気しないぜ…","等年纪再大点，怕是连小份都吃不消咯…"],["「私はこういうの家では出されないからなー。","「我在家可吃不到这种。"],["体型維持がどうのって煩いんだよね。","整天唠叨什么体型管理的烦死了。"],["母様も年頃の女子に何言ってるんだか」","母亲大人对青春期女生说这些像话吗」"],["一旦箸を置き、\n自分の胸や腰をむんずとつかむ冬夏。","暂时放下筷子，\n冬夏突然用力掐住自己的胸和腰。"],["男子の前ではやめてそれ…","在男生面前别这样…"],["思わず眼を逸らす。","我不由移开视线。"],["「なんかすごい神経質なんだよ。","「她在这方面超级神经质。"],["私の外観に関して異常に拘る。","对我的外表异常执着。"],["モデルにでもしたいのかってのよ」","简直像要培养模特似的」"],["「んーまあ、","「嗯—这个嘛，"],["僕には何とも…","我也不好评价…"],["でもあれだ、綺麗に越したことはないし…」","不过嘛，漂亮点总没坏处…」"],["私みたいなの、まことさんの好みなのかな？","像我这样的…会是真言喜欢的类型吗？"],["なら母様の言いつけも少しは積極的に聞けるかなー」","那母亲大人的吩咐也能稍微积极听进去点了吧—」"],["「うあ？","「呜啊？"],["や、ちが！","不、不是！"],["ちがっていうかその、","不是那个意思该说是…"],["いいい一般論の話だって！！」","这这这是在说普遍情况啦！！」"],["だー。","唉—"],["その手の揶いはもうええて…","这种揶揄已经够够的了…"],["女子てのはおっかねえ…","女孩子真可怕…"],["「あーでも私胸ないんだよね。","「啊—不过我胸很小呢。"],["それでもいい？","这样也行吗？"],["あでも、まことさんがどうにかしてくれれば大きく…」","啊不过、要是真言想办法的话说不定能变大…」"],["「…年頃の女子ならそんなこと口にするんじゃ\nありません！","「…正经姑娘家不该说这种\n不知羞耻的话！"],["つーかきぃ、お前も何とか言え…って」","话说小贵、你也该说点什么吧…喂」"],["きぃは聞こえてるのかどうか、\n何のフォローもしてくれない。","不知小贵有没有在听，\n完全没帮我打圆场。"],["一緒になって僕を揶ってるのか、\nはたまた食事に集中してるのか…","是跟着一起捉弄我呢，\n还是专心在吃饭呢…"],["――多分後者だなこれは。","――多半是后者吧。"],["僕が一人で赤面してる内に、\n冬夏は綺麗に食べ終えつつあった。","就在我独自面红耳赤的时候，\n冬夏已经优雅地吃完了。"],["さすが、すまーとに食されましたなあ。","不愧是吃得干干净净呢。"],["米の一粒も残ってない。","连一粒米都没剩下。"],["きぃの場合は『喰い尽くす』って感じだけれど。","不过小贵这边该说是『风卷残云』吧。"],["気付くと、きぃもあんだけの量をほぼ食べ終えており、\n結局僕だけがまだ食べ終わっていない。","回过神来发现小贵也快把那份量惊人的食物消灭完毕，\n结果只剩我还没吃完。"],["…多いんだよ単純に。きぃは別格すぎる。","…单纯就是量太多。小贵根本是例外。"],["どうせ食えないと思ったので、\nバナナはきぃにあげた。","反正肯定吃不完，\n就把香蕉给了小贵。"],["当然のようにあっさり胃に収めてみせるきい。","她果然轻轻松松就塞进了胃里。"],["お前って…","你这家伙…"],["「ふああ食べた食べた。","「呼啊吃饱饱。"],["ごっちそうさまーまこちゃん！","多谢款待—小真！"],["ほんとにありがとなのだわっ！！」","真的超级感谢啦！！」"],["「ごちそうさまでした」","「多谢款待」"],["「いえいえどういたしまして」","「哪里哪里不用客气」"],["食器も下げられ、とりあえず一段落。","餐具也收走了，总算告一段落。"],["幸い店内に僕らの他客はいなくなり、\n有線だけが流れる午後。","幸好店里除了我们已没有其他客人，\n只有背景音乐流淌的午后。"],["さて、いよいよ具体的な話に入ろうか。","那么，该切入正题了吧。"],["「えーと、さっきも言ったけど、\n今回はきぃが話を強引に進めてくれたから、\n何もかも急なんだよねえ。","「那个、虽然刚才也说过，\n这次因为小贵强行推进话题，\n所有事情都太突然了呢。"],["済し崩しだもんなこの成り行き。","简直就是赶鸭子上架嘛这状况。"],["お前どこまで話したの？","你到底说到哪一步了？"],["というかきぃも何か目的あったんだろ？」","话说小贵你也有什么目的吧？」"],["さすがにいきなり御神体の話を振るのは抵抗があるし、\nとりあえずきぃをダシに様子見するか。","突然提起御神体的话题还是有点抵触，\n先拿小贵当借口探探口风好了。"],["思えばそもそも、門前払いをくらった時点で、\n僕は蔵の中を見るのにそんなに積極的ではなかったのだ。","仔细想想最初被拒之门外时，\n我对查看仓库内部其实并没这么积极。"],["きぃの強行ともいうべき積極的行動の故に今、\nこんな状況になってるんだしな。","都是因为小贵堪称强硬的积极行动，\n现在才会变成这样啊。"],["あーんとね、\nま、うん。","呃—那个，\n嘛，嗯。"],["見たかっただけさ。","就是想看看而已。"],["入れてくんないから。","谁让你们不让进。"],["好奇心と反発心てやつ？」","好奇心和逆反心理作祟？」"],["「お前も勢いで言ったのかよ…","「你也是脑子一热才说的啊…"],["自分連れてくのが前提条件とか言ってたろ」","明明还说什么带你进去是前提条件」"],["「いいじゃないのさ。","「有什么关系嘛。"],["只働きはしたくなかっただけなのだわ。","只是不想白干活而已。"],["貧乏人の意地、転んでも只では起きない！」","穷人的骨气，摔倒也要抓把沙！」"],["あ、そうなの…","啊、这样啊…"],["ここに来る前に考えた事はやはり取り越し苦労か。","来之前担心的事果然是多虑了。"],["別に疑った訳ではないが、\nいやそれにしても。","倒也不是怀疑什么，\n不过话说回来。"],["「へええ…","「诶诶…"],["その割には速攻行動起こしてた気が…」","可你明明立刻就采取行动了吧…」"],["「あのねえ――","「我说啊――"],["わたし的には昔馴染みのまこちゃんの為に\n好意で骨折ったんだからさ、\nも少ししゃきっとしてよね。","人家可是看在和老朋友真酱的交情上\n好心帮忙的哎，\n你倒是给我打起精神来啊。"],["趣味なんでしょ？","是兴趣对吧？"],["古本見るのが」","看旧书的爱好」"],["「骨折ってくれたのは感謝してるけどな…","「帮忙的事我很感谢啦…"],["お前自分で只働き嫌だって言ったばっかだろ。","你自己刚才还说不想白干活吧。"],["ああ飯奢られて元は取ったのか…","啊原来靠蹭饭就回本了吗…"],["あと、\n古本っていうと字義的には間違っちゃいないんだろうけど、\n何かイメージ違うぞ…","还有，\n虽然从字面上说旧书这个词确实没错，\n但总觉得印象对不上啊…"],["ま、それはそれとしてそういうことだよ。","嘛，总之就是这么回事。"],["趣味で旅行しながらそういったモノを\n見て歩いてるんだよね僕」","我旅行时会顺带\n看看这类东西当兴趣」"],["半分程は真実だが、基本的にはその場凌ぎ、\n建前十割と言っても過言じゃない。","虽然有一半是真话，但基本是临时编的，\n说全是场面话也不为过。"],["少々嘘臭くなるのも詮無きこと。","难免会显得有点可疑。"],["だが、とりあえずは気取られることはなかったようで、\n冬夏はあっさり流して言った。","不过暂时似乎没被察觉，\n冬夏干脆地接话道。"],["「成る程ね。","「原来如此。"],["そういえば学生じゃないんだったね」","说起来你已经不是学生了呢」"],["「…まあ、正確にはついこないだまでは僕だって\n大学生だったんだけど。","「…准确说直到前不久\n我也还是大学生。"],["さっき言ったとおり職場の上司にセクハラされながら\n働いて旅費稼ぎしてるわけ」","就像刚才说的，边被职场上司性骚扰\n边打工攒旅费」"],["「ふうん。","「哼嗯。"],["ま、いいけど」","嘛，算了」"],["…今更なんでそんな眼で見るですか。","…为什么现在要用这种眼神看我。"],["「あのね実際のところ、\n私も大層な目的無くたって付き合うつもりだったし。","「其实呢，\n就算没什么正经理由我也会陪你的。"],["いいか面倒な話は。手順だけ話そう」","麻烦事就别提了。只说流程吧」"],["結局、来る前に話された事とほぼ大差のない内容ではあったが、\n他にきちんと具体的な待ち合わせ場所や時間、連絡方法等を決めた。","结果和来之前说的内容大同小异，\n只是具体约定了碰面地点、时间和联络方式。"],["といっても、冬夏の家人が手薄に…というとあれだが、\n要するに例の母様達が家を空け、蔵のセキュリティが甘くなったときに冬夏が携帯で連絡をくれるだけ。","虽说冬夏家里人手不足…这么说可能不太恰当，\n总之就是当那位母亲大人不在家、仓库守备薄弱时冬夏会发消息通知。"],["それまで僕ときぃが近場で待機ということになった。","在那之前我和小贵就在附近待机。"],["さすがに正面玄関から大手を振って突入という訳にはいかないが、その辺りも冬夏が何とかしてくれるらしい。","当然不可能大摇大摆从正门闯进去，这方面冬夏似乎会想办法。"],["さて、目的をぼやかしている以上、\nそれとなく探してみる他どうしようもない。","既然目的含糊不清，\n也只能暗中调查了。"],["幸いモノのサンプルは、宮さんの例の資料で分かってるし、\nきぃが居れば冬夏の注意も分散するだろう。","幸好从宫小姐的资料里知道物品样本特征，\n有小贵在也能分散冬夏注意力。"],["協力的態度でいてくれるとはいえ、\n冬夏にわざわざ本当の目的を教える理由は、\n今のところ無い。","虽然她态度很配合，\n但眼下没有理由\n向冬夏坦白真实目的。"],["「それで、\nさっきも言ったとおり、\n私に出来ること、\n特に中では何もないと思うから。","「所以说，\n就像刚才提到的，\n我能做的事、\n尤其在仓库里基本派不上用场。"],["精々、見つかった時の言い逃れくらいだね。","顶多就是被发现时帮忙找借口罢了。"],["で」","然后」"],["「ああうん。","「啊嗯。"],["で。","然后。"],["で？」","所以？」"],["「その危険性も更に減ずる方法があるんだなあ…","「其实还有更能降低风险的办法哦…"],["聞きたい？」","要听吗？」"],["…何やら加虐的というか悪戯めいた笑みを口許に浮かべながら、\n僕を視る冬夏。","…冬夏嘴角浮现出近乎施虐的恶作剧笑容，\n直勾勾盯着我。"],["何か不穏だ。","感觉不太妙。"],["宮さんがよく僕に見せる表情と同様の気配を感じる。","就宫小姐经常对我露出的那种表情。"],["「…厭な予感がぷんぷんするけど一応聞いとこうか」","「…虽然有不祥的预感但还是姑且听听吧」"],["「あのねえ、\n二人にもこの制服着て貰って、同級生の振りしてもらうの」","「那个啊，\n想让你们俩也穿上这身制服，假装是同班同学」"],["「ふええ、いいねそれ。","「呜诶，这个主意不错。"],["予備あるんだ？","有备用制服吗？"],["まこちゃん似合いそうだわ」","小真穿起来应该很合适呢」"],["「は！？","「哈！？"],["女子制服かよ！！","女生制服啊！！"],["同級生って事ならガクランで構わないだろ！！」","既然是同班同学穿男生立领制服不就行了吗！！」"],["「駄目だよ。","「不行哦。"],["男子連れ込みは別の意味で警戒されるし、\n第一ガクランなんて持ってないもんねー」","带男生进去会引起另一种意义的怀疑，\n再说了我们根本没有男生制服嘛ー」"],["駄目だ駄目だ。","不行不行。"],["却下します。","驳回。"],["保険というより揶われてるだけと判断しました。","这根本不是保险措施纯粹是在捉弄人吧。"],["「残念」","「遗憾」"],["「なのだわ」","「就是的说」"],["「君達…","「你们…"],["いいやもう…出ようか…」","算了…我们走吧…」"],["ふう。","呼。"],["あとは知狡さんに事の成り行きを伝えて、\n本家の用とやらをこなさなくてはならない。","之后要向知狡阿姨说明事情经过，\n还得处理本家交代的工作。"],["食券制だから既に会計も済んでいるので、\nそのまま僕らは店を出た。","因为是餐券制所以已经结过账了，\n我们就这样离开了店铺。"],["「ふああ、改めてごちそうさまでしたっ。","「哈啊～再次感谢款待。"],["わたし食い溜めできない体質だけど、\n満腹感は久々に味わえたのさ。","虽然我是吃不胖的体质，\n但好久没体验过这种饱腹感了。"],["ありがとなのだわ」","多谢了的说」"],["「今後また来るかどうかは別として、\n良い店紹介してもらってこちらこそ。","「虽然不知道以后还会不会再来，\n能介绍这么好的店是我该道谢。"],["話も進んだしじゃあ日曜にまた」","事情也谈妥了那就周日见」"],["「私も愉快な邂逅が出来てとても好かったよ。","「我也很愉快能遇到这么投缘的人。"],["ま、今日のところは精々大人しくして\n母様を油断させとかないとね。","嘛，今天姑且先安分点\n得让母亲大人放松警惕才行。"],["ご飯御馳走様でした」","多谢款待」"],["店の前で、別れの挨拶の為しばし立ち止まる僕ら。","我们在店门前驻足道别。"],["店内が油ぽかったので清々しい。","店里油烟味太重，外面空气真清爽。"],["ウーロン茶飲みたいなー。","好想喝乌龙茶啊ー。"],["「じゃ、わたし用があるから帰るのさ。","「那我有事先回去啦。"],["あとは二人で宜しくやってね～♪」","剩下的事你们俩好好处理吧～♪」"],["「勿論そのつもりです。","「当然会的。"],["じゃあねきぃ。","再见啦小贵。"],["今日はありがとう」","今天谢谢你」"],["食べた直後とは思えない、軽い足取りできぃは立ち去った。","小贵迈着轻快的步伐离去，完全不像刚吃饱的样子。"],["冬夏の言葉を聞き逃し、ろくなリアクションもとらず、\nしばし呆然と見送った後、\nふと気になった事を問おうと僕は口を開いた。","我漏听了冬夏的话，也没能好好回应，\n呆望着小贵离开后，\n突然想起件事便开口问道。"],["「ところで、\n今更なんだけど、\n君等一体どういう関係――」","「话说，\n虽然现在问有点晚，\n你们到底是什么关――」"],["「え？","「诶？"],["なに？…――」","什么？…――」"],["微笑みつつ振り向いた冬夏の目線の焦点が、\n表情の変化を伴って僕の後方へと遷移する。","冬夏微笑着转头时，目光焦点突然产生变化，\n表情骤变地看向我身后。"],["急に僕の袖がぐいと引かれた。","突然，我的袖子被猛地拽了一下。"]],"context":[["SC_M_008.ks/index/1/text"],["SC_M_008.ks/index/3/text"],["SC_M_008.ks/index/5/text"],["SC_M_008.ks/index/7/text"],["SC_M_008.ks/index/9/text"],["SC_M_008.ks/index/11/text"],["SC_M_008.ks/index/13/text"],["SC_M_008.ks/index/15/text"],["SC_M_008.ks/index/17/text"],["SC_M_008.ks/index/19/text"],["SC_M_008.ks/index/21/text"],["SC_M_008.ks/index/23/text"],["SC_M_008.ks/index/25/text"],["SC_M_008.ks/index/27/text"],["SC_M_008.ks/index/29/text"],["SC_M_008.ks/index/31/text"],["SC_M_008.ks/index/33/text"],["SC_M_008.ks/index/35/text"],["SC_M_008.ks/index/37/text"],["SC_M_008.ks/index/39/text"],["SC_M_008.ks/index/41/text"],["SC_M_008.ks/index/43/text"],["SC_M_008.ks/index/45/text"],["SC_M_008.ks/index/47/text"],["SC_M_008.ks/index/49/text"],["SC_M_008.ks/index/51/text"],["SC_M_008.ks/index/53/text"],["SC_M_008.ks/index/55/text"],["SC_M_008.ks/index/57/text"],["SC_M_008.ks/index/59/text"],["SC_M_008.ks/index/61/text"],["SC_M_008.ks/index/63/text"],["SC_M_008.ks/index/65/text"],["SC_M_008.ks/index/67/text"],["SC_M_008.ks/index/69/text"],["SC_M_008.ks/index/71/text"],["SC_M_008.ks/index/73/text"],["SC_M_008.ks/index/75/text"],["SC_M_008.ks/index/