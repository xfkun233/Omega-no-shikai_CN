t":1884,"end":1938}],[{"start":1977,"end":2024}],[{"start":2064,"end":2124}],[{"start":2163,"end":2166}],[{"start":2206,"end":2216}],[{"start":2280,"end":2494}],[{"start":2569,"end":2617}],[{"start":2657,"end":2683}],[{"start":2717,"end":2794}],[{"start":2869,"end":2896}],[{"start":2936,"end":2957}],[{"start":2997,"end":3029}],[{"start":3063,"end":3112}],[{"start":3187,"end":3229}],[{"start":3269,"end":3308}],[{"start":3383,"end":3399}],[{"start":3439,"end":3455}],[{"start":3489,"end":3498}],[{"start":3573,"end":3631}],[{"start":3665,"end":3745}],[{"start":3853,"end":3937}],[{"start":4014,"end":4104}],[{"start":4235,"end":4297}],[{"start":4337,"end":4347}],[{"start":4386,"end":4495}],[{"start":4529,"end":4592}],[{"start":4608,"end":4616}],[{"start":4760,"end":4797}],[{"start":4870,"end":4902}],[{"start":4942,"end":4985}],[{"start":5058,"end":5089}],[{"start":5162,"end":5226}],[{"start":5260,"end":5305}],[{"start":5378,"end":5395}],[{"start":5429,"end":5448}],[{"start":5521,"end":5576}],[{"start":5616,"end":5696}],[{"start":5769,"end":5825}],[{"start":5859,"end":5883}],[{"start":5956,"end":5983}],[{"start":6023,"end":6047}],[{"start":6089,"end":6099}],[{"start":6176,"end":6197}],[{"start":6231,"end":6292}],[{"start":6448,"end":6536}],[{"start":6576,"end":6661}],[{"start":6695,"end":6754}],[{"start":6827,"end":6932}],[{"start":6944,"end":6975}],[{"start":6987,"end":7031}],[{"start":7079,"end":7090}],[{"start":7124,"end":7136}],[{"start":7176,"end":7255}],[{"start":7267,"end":7303}],[{"start":7376,"end":7425}],[{"start":7493,"end":7591}],[{"start":7631,"end":7667}],[{"start":7740,"end":7749}],[{"start":7789,"end":7811}],[{"start":7853,"end":7858}],[{"start":7892,"end":7912}],[{"start":7975,"end":8034}],[{"start":8074,"end":8100}],[{"start":8134,"end":8214}],[{"start":8228,"end":8327}],[{"start":8341,"end":8410}],[{"start":8424,"end":8461}],[{"start":8501,"end":8529}],[{"start":8606,"end":8749}],[{"start":8789,"end":8816}],[{"start":8928,"end":8960}],[{"start":8994,"end":9058}],[{"start":9133,"end":9150}],[{"start":9162,"end":9164}],[{"start":9177,"end":9179}],[{"start":9192,"end":9219}],[{"start":9253,"end":9283}],[{"start":9389,"end":9436}],[{"start":9448,"end":9516}],[{"start":9528,"end":9605}],[{"start":9637,"end":9694}],[{"start":9706,"end":9772}],[{"start":9784,"end":9875}],[{"start":9887,"end":9937}],[{"start":10042,"end":10111}],[{"start":10123,"end":10157}],[{"start":10169,"end":10246}],[{"start":10286,"end":10362}],[{"start":10474,"end":10505}],[{"start":10545,"end":10560}],[{"start":10632,"end":10692}],[{"start":10767,"end":10814}],[{"start":10854,"end":10883}],[{"start":10895,"end":10963}],[{"start":11003,"end":11053}],[{"start":11087,"end":11185}],[{"start":11197,"end":11203}],[{"start":11215,"end":11309}],[{"start":11325,"end":11378}],[{"start":11453,"end":11568}],[{"start":11608,"end":11619}],[{"start":11694,"end":11802}],[{"start":11842,"end":11857}],[{"start":11897,"end":11980}],[{"start":12055,"end":12126}],[{"start":12166,"end":12181}],[{"start":12215,"end":12294}],[{"start":12308,"end":12363}],[{"start":12438,"end":12498}],[{"start":12538,"end":12547}],[{"start":12581,"end":12628}],[{"start":12668,"end":12715}],[{"start":12790,"end":12803}],[{"start":12893,"end":12913}],[{"start":12951,"end":12956},{"start":13091,"end":13096}],[{"start":13020,"end":13051}],[{"start":13163,"end":13199}],[{"start":13244,"end":13311}],[{"start":13325,"end":13382}],[{"start":13396,"end":13469}],[{"start":13485,"end":13497}],[{"start":13589,"end":13595}],[{"start":13629,"end":13677}],[{"start":13717,"end":13760}],[{"start":13800,"end":13922}],[{"start":13938,"end":14072}],[{"start":14112,"end":14149}],[{"start":14183,"end":14239}],[{"start":14277,"end":14284}],[{"start":14316,"end":14336}],[{"start":14374,"end":14413}],[{"start":14447,"end":14500}],[{"start":14540,"end":14607}],[{"start":14619,"end":14686}],[{"start":14726,"end":14752}],[{"start":14786,"end":14805}],[{"start":14845,"end":14884}],[{"start":14898,"end":14964}],[{"start":15004,"end":15011}],[{"start":15045,"end":15200}],[{"start":15282,"end":15496}],[{"start":15512,"end":15579}],[{"start":15591,"end":15627}],[{"start":15639,"end":15721}],[{"start":15735,"end":15833}],[{"start":15927,"end":15940}],[{"start":15980,"end":15997}],[{"start":16036,"end":16114}],[{"start":16154,"end":16165}],[{"start":16197,"end":16246}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_004.ks","basename":"SC_M_004.ks","indexIds":{"局地的な疲労に誘発された突発的な睡眠は、\n少なくとも僕の場合は五分やそこらで事足りてしまうようで、":0,"ラーメン屋から本家までの車中のうたた寝だけで、\n僕は覚醒してしまった。[l]\n大体その後本家で挨拶とかしてれば\nもう眠気なんか飛んでまうわ。":1,"さて今は…だいたい五時か。[l]\n北の地でこの季節では、まだ陽もそんなに長くないのか\n結構暗くなってきてる。":2,"街明かりというものが単純に少ないのもあるんだろうが、\nその御陰で、星空は相当すごいのだ。":3,"真冬時なんか気持ち悪いくらいに星だらけの空を眺望できる。[l]\nここじゃない北の地に旅行に行ったときはそれはもう、\n総毛立ちしたものだ。[l]\n西南だと田舎でもあまりそういう経験したことないんだが。":4,"ああ、月がもう見えるな。":5,"「なんか、月の模様って猫に見えません？[l]\n兎の餅つきとかでなく」":6,"僕は前から思っていた事を口にした。":7,"「んむ？[l]\nなんですか突然」":8,"「いや、深い意味はないんですがね…[l]\n僕はよく『ねこざんまい』から夜間自転車で帰りますから、\n月はしょっちゅう見てるんです。[l]\nそのうちそういう風に見えて来ちゃって」":9,"ま、今日は満月でもなければ、まだ明るい内だし、\n説明が難しい。":10,"「猫。猫ねえ。[l]\nいいですねえ。猫。[l]\n古来、世界各地で月ともそれなりに関係は深いですしね。[l]\n諺とかでもね」":11,"「ですねえ。[l]\nだから無意識的に据わりがいいと思ったのかも知れませんが。[l]\nま、戯言です。[l]\n聞き流してください」":12,"「真言は猫好きなのか？[l]\n覚えてるかどうか知らないが、\n玄ノ森は猫に縁深き土地だぞ。":13,"本、即ち紙をかじる鼠を退治する益獣として\n大事にされてきたからな」":14,"ああ、そういう話もあったですか。[l]\n昔、養蚕絡みでそういう話があったのを何かの本で\n読んだ気がします。":15,"玄ノ森で特別そういう扱いだったかは、\n仰せの通り記憶にないけど。":16,"「だってまこくん、\n『ねこざんまい』の側の山に神社があるでしょう。[l]\nあれもその関係ですよ」":17,"「そこまでは知らないですって、\n僕あそこに通ってまだ一年ですもん。[l]\nそんな神社あった事すら初耳ですよ…[l]\nおああーっ！」":18,"思わず奇声を上げてしまったが、\nそれもやんぬるかな、\n目の前にとうとう知狡さんの旅館『六母屋』が\n見えてきたからである。[l]\n今までとは違い、ここは記憶が鮮明に呼び起こされた為だ。":19,"それにしてもうわー全く変わってないな！[l]\nちょっとテンション上がる！[l]\nなつかし！！":20,"「んむう、びっくりするでしょまこくん。[l]\nまあいいです。[l]\n到着～ぅ」":21,"「お疲れ、二人とも。[l]\n入り口で停めるから降りてロビーで待っててくれるか。[l]\n車庫入れしてくる」":22,"「ん」":23,"「わかりましたーっ」":24,"外観こそ記憶にあるが、従業員さん達は勿論別だ。[l]\nが、僕は彼らには見覚えはないのに、\n向こうは僕の幼少時を知ってるふうの人も\n何人かいたようで、\nそして当然向こうは事情を知らされているようなので、\nロビーでとりあえず歓待された。[l]\nしかしこちらとしては、申し訳ないが彼らを全く存じ上げないのだった。[l]\nとにかく荷物をあらかた預けてソファーで知狡さんを待つ僕ら。":25,"「改めてお疲れ、そしてようこそ。[l]\n早速部屋に案内しよう。[l]\n別々のな」":26,"「それはもういいですよ…[l]\n当然でしょ」":27,"歩き出す知狡さんについて僕らも動き出す。[l]\n階上に上がるのだろう、エレベーターに乗り込んだ。[l]\n「閉」を押しながら宮さんがごねる。":28,"「んむーっ？！[l]\nつれないなあっ！[l]\n":29,"くそ、お風呂は絶対一緒に入ったる、うひひ」":30,"「何の意地ですか…[l]\n人を助平呼ばわりしたくせに…」":31,"しかもスク水とやら着用でだろ。[l]\n大神あたりは泣いて喜びそうなシチュエーションだけど。":32,"「まあ風呂の方は混浴と銘打ってる以上、\n私には抑止できる理由がないからな…」":33,"「はいはい分かりました。[l]\nじっくり見てやらあ、スク水とやらをぉ」":34,"「うお、開き直ったにゃ？[l]\n":35,"うひひ、とっぷり誘惑したるぜぇ」":36,"だから何の意地だ…":37,"「露天だから声にも気を付けてくださいよ、宮さん。[l]\n警備は万全ですが、こちらから外に漏れ聞こえることは」":38,"知狡さんもどういう心配の仕方だ…[l]\nこの人も真面目が過ぎて、ある意味言動がギャグと化してるし。[l]\nと、彼女がある部屋の前で立ち止まった。":39,"「さ、ここだな。[l]\n真言の部屋は。[l]\nエレベーターすぐ近くだから覚えやすかろう。[l]\n自販機もあるが…すまないが勿論有料、自腹で頼む」":40,"「勿論です…ってか水とか茶ばっか飲むつもりですけどね。[l]\nこっちの水は美味いんで。[l]\nええと部屋番号…じゃなくて名前か。[l]\n…うあ？『火車』？」":41,"え、えらい物騒な名前でないか？[l]\nひのくるま？[l]\nや、まてよ。[l]\nどっかで見た字面だぞ。":42,"「『かしゃ』、だな」":43,"「妖怪ですよ妖怪。[l]\n玄ノ森に限らずにこの地方、\n民俗学系の観光資源で売ってるし観光客にも通りが良いのです。[l]\nマニア垂涎。[l]\n宿泊部屋の名前がオール妖怪の旅館『六母屋』！」":44,"………。[l]\nや、やはりそうか。[l]\n幼少時は宿泊部屋なんか来なかったし、\n字が読めなかったから…":45,"と、いうことは…":46,"「あ、あっちの部屋は\n『姥が火』で、\nこっちが『鳴家』…」":47,"「同じフロアには\n『生霊』『死霊』『幽霊』もありますな」":48,"「どっかの階には『邪魅』とか『おとろし』とかあるんだ？[l]\nおっかないよ…」":49,"「ちゃんと『日の出』とか、最上階に『宝船』とかもありますよ？」":50,"「さっき真言が猫好きだと分かったし、偶然だが丁度いいだろう。[l]\n生憎一階の『猫又』は埋まってるんだ。人気があってな」":51,"それはちょっと無理がありませんか…[l]\n大体そこまで好きと言った覚えはないです…":52,"「『五徳猫』も最上階ですからねー」":53,"単に人気がない部屋が空いてたんでしょ…":54,"「いや真言、物好きな人種は結構全国にいるんだ。[l]\n『逢魔時』なんかを指定でくる客もいるんだからな」":55,"「…まあ僕もお二人と話が通じてる時点で物好きの一人ですけど。[l]\nいいですよわかりました…[l]\n――部屋に絵が飾ってあるとかないですよね？」":56,"「先代含め昔からやりたかったらしいが、\nいろんな問題があってそれは無い。[l]\n安心するがいい」":57,"やろうとはしたんだ…『姑獲鳥』とか夜怖そうだな…":58,"「はいはいまこくん、次は宮の部屋にご案内ーっ。[l]\n":59,"いつでも来られるように覚えてくださいよ？うひひ。":60,"『白沢』でしたね？」":61,"「そうです。[l]\n結構上の階で」":62,"………。[l]\n僕みたいな人間にとっては部屋番号よりも、\nこっちのほうが嫌でも覚えはするだろうな、覚えは…":63,"旅館とはいえ結構高層なこの建物だが、\n部屋の内装自体は『和』でばりばりなので、\n上層に行くほど景色との違和感が出る。[l]\n今いるこの『白沢』もそうだ。":64,"「おおー、\nもう暗いからあんまりよくわかんないですが、\n晴れた昼間なんかすごそうですね、展望が。[l]\nすごい変な気分ですけど内装とのギャップで」":65,"返事がなかったので振り向いてみると、\n宮さんはうろうろと畳の上を歩き回りながら\n何事かつぶやいていた。":66,"「猫、猫は洋の東西を問わず怪しきものとされてきた。[l]\n人の死体にかかずらう所作のせいで、\n死、葬儀には昔から関連づけられる。[l]\n瞳孔の拡縮は満ち欠けに喩えられて月にも関係が深い。":67,"養蚕の守護。[l]\n猫の女神。[l]\n猫の王。":68,"魔女の使い魔。[l]\n九つの魂を持つ。[l]\n善き白き猫、不吉な黒き猫。":69,"猫は――いいですねぇ」":70,"と、突然僕に振ってきた。":71,"「はい？　あ、前半よく聞こえなかったんですが、[l]\nもういいですって僕の猫好きの話は。[l]\nというかだからそんな格別好きなわけではないし。":72,"まあ…いいはいいと思いますよ。[l]\n僕は犬よりは猫派ですから」":73,"「蠱物としても太古から特別な扱いされてる、って話ですよ。[l]\n世界的、普遍的な規模でね」":74,"みやーおぅと、猫っぽく手招きして見せる宮さん。[l]\nああ、この人なんか今更ながら猫っぽいな。[l]\n典型的な猫顔（？）だし。[l]\n自分のことを宮宮いうもんだから尚更だ。":75,"「干支からはあぶれてますけどね。[l]\n架空動物が入ってるのに」":76,"「んむー？[l]\n":77,"うひひ、竜も鼠も猫に狩られる運命ですよーだ。":78,"なんてね」":79,"窓の桟にぽふっと腰掛けて、こちらを見る。":80,"「さっきの『火車』で思い出したのでちょっと思索に\n耽ってみました。[l]\nさて今後の事ですが。[l]\n":81,"お酒が入ると面倒なのでご飯の前に軽く話しておきます」":82,"この場合、宮さんではなく僕の飲酒だ。[l]\n宮さんも、もしかするともう飲める齢かも知れないが、\n少なくとも僕の前でそういうことをしたことはない。":83,"以前「宮は飲めないんですぅ」と言われたことがあるも、[l]\nどっちの意味かわからんし。[l]\nちなみに僕は四月の生まれなので、先日ようやく、\n法的に飲酒を許される身となった。":84,"ま、しかしあれだ、この前の大神とかれお嬢との飲み会が\nあったように、今までもたまーに、口を湿らす程度にね。[l]\nあはは。":85,"ちなみに僕は全く強くない。下戸も下戸。\nハイになるのが楽しいだけ。":86,"「ああ、はい。[l]\nまず例の三春家とやらに？」":87,"「んー…、[l]\nそれはやってはみますがほぼ無駄でしょうね。[l]\n葬式はしたようですから捜査に一段落はついたかも\nしれませんが事件が解決したのではないですし、\nもみ消しにかかるにしても祭がいつになるかは、\n現状不明です。[l]\nなので」":88,"「ええ。[l]\nだらだら観光してきてね☆と？」":89,"「んむう残念。[l]\nまこくんにはお仕事を与えましょう」":90,"うえ。[l]\nお仕事、嫌な言葉ですこと。[l]\nまあ無為に過ごして気の引ける日々を過ごすよりは\nましか。":91,"「前に説明しましたが、\n『":92,"月 ":93,"狂 ":94,"跳 』とは飯窪が探してるある特定の資料群の総称ですが」":95,"そう聞いている。[l]\n今回のそもそもがそれなのだ。":96,"「具体的に言います。[l]\n蠱物としての猫に関する伝承、文献、それこそ洋の東西問わず。":97,"古代においては『猫の女神』、\n中世西洋では『魔女の猫』として、\n東洋、特にこの辺りの國では伝承上『猫鬼』と呼ばれる魔猫。":98,"屍を操り九つの生命を持つ死に近しい存在。[l]\nそういった伝説伝承の類の記述や図像を飯窪は集めていて、\nそれを宮達は『月狂跳』と呼びます」":99,"猫鬼とは、メジャーではないが確かに昔本で見た覚えがある。[l]\nそういった系の話だったかどうかは微妙だが。":100,"他はそっち系ではまあ普遍のネタではあるが、\n羅列されると確かに猫というのはなかなかにオカルトめいた扱いには事欠かないのだな。":101,"しっかし飯窪本家、なにゆえそんな事をしてるんだ。[l]\n本好きだけでなく、猫も大好きだというのか。[l]\nそしてどこをどういじるとそれが『月狂跳』という呼び名になる？":102,"と、まだ宮さんの説明は続いていた。[l]\nはいはい思考中断。面倒くさいことはしないんだ僕は。":103,"「ここ玄ノ森は書蔵守というくらいでしたから、\n昔から鼠対策に猫は珍重されていて…という話は\nさっき知狡がしていた通りです。":104,"その手の資料足り得るものが祭の他にもあるとは\n思いませんか？":105,"飯窪がこの地に落ち着いたのは三春ほどは古くない\nですし、取りこぼしや三春の『隠し』がどこかに\nある可能性は、十分とはいえませんがあります」":106,"「分かりましたよ。[l]\nどうせ知狡さんの僕に対する援助の名目と一緒でしょ。[l]\n只で飯は食わせないが、やらせることはガキの使い――」":107,"「うひひ、折角宮が真面目に盛り上げようと思ったのにー。[l]\n":108,"事実を言っちゃ興ざめですよぅ」":109,"別段問題ないけどさ。[l]\n大学まで辞めてまでここに来て、\n何もしないでいる方がよほどプレッシャーだよ。":110,"「でもあながちあり得ない話ではないですから。[l]\nそれと玄ノ森の――有力者の家々、\n":111,"つまりくだんの三春の系列にはそれなりに気を遣ってください。":112,"女子だらけの家系で華やかではありますが、\nこんな小さな町でトップに睨まれると面倒ですからね。[l]\n努々心してください」":113,"「おっかないですなあ。[l]\nま、気を付けます。[l]\nそうかー女子だらけ、ねえ…」":114,"さっきのブロンド少女を筆頭に、という訳か。[l]\nそういや飯窪も、直系の男子である僕はレアだそうだし、\n…なんか水にへんなもんでも混じってんじゃないのか、[l]\nこの辺て。":115,"美味いのに。":116,"それこそ猫の呪いとかだったら嫌だな。[l]\n『三毛猫の雄』の話もあるしな。[l]\nあれは遺伝の関係か何かだったと思うが、\nああ、そういう物理的な原因も考えられるか。":117,"と、また思索に入りかけた僕の耳に宮さんの声が届く。[l]\n毎度の事ながら僕はあっさり思考中断する。":118,"「まーまー、真面目に調査しようと思ってたら、\nはじめからかれおに頼んでますからっ。[l]\nまこくんは気負わずお仕事してください。[l]\n祭の日程が確定するまではさしあたってそれで。[l]\nあとね…」":119,"「はい、なんでしょ？」":120,"「そういった訳で、しばらくは昼間、宮とまこくん別行動です。[l]\n宮もちょっとすることがあるんで。[l]\n夕飯は六母屋で食べるしそれからはここ、『白沢』に居ますから、\n何かしら進展あったら、んむ、":121,"無くても夜なら来て構いません」":122,"「じゃ、今日は僕軽く散歩でもしてきますよ。[l]\nもう暗いですけど、その辺の河川敷うろつくだけなんで。[l]\n昼間は座りっぱなしで足腰固まっちゃって」":123,"「あ、じゃ今のうちに携帯。これです。[l]\n滞在中はこれで。[l]\n宮とか旅館とか、主要な番号はメモリーに入れときましたから」":124,"「ああ、ありがとうございます」":125,"最近の過剰とも言えるスタイリッシュさなどとは無縁の\n旧世代の機種だったが、最新機種のサービス内容では、\n逆にここでは使えないのだから仕方ない。":126,"どうせ借り物だし、誰に色気を振りまくでもないし、\nまるで問題はない。[l]\n素直に受け取った。":127,"「寂しくなって電話してきても、さっきの通り昼間は相手できるか\nわかんないですけど、泣かないでねまこくん？[l]\n":128,"夜には会えるから」":129,"メールと写メくらいは使えるそうだし、\nいざという時にはメールしてくださいという宮さん。":130,"「はいはい。[l]\nせいぜい気張りますよ。[l]\nじゃあ宮さん、行ってきます」":131,"「んむ、いってらっさーい」":132,"部屋を出て、なにげに携帯を開いてみると、":133,"「………」":134,"宮さんの体操着＋ブルマ姿の写真が待ち受け画面に設定されていた。":135,"僕は黙って待ち受けをデフォルトに設定し直し、\nロビーへ向かった。":136,"当然だがやっぱ寒いわ。[l]\n真冬だったらどれだけ下がるのか、ここの気温。[l]\n…うう、３０分くらい歩いたら戻ろう。":137,"１０分もすると、\n来るときにも見た大きめの橋があったので、\n歩道の欄干に寄りかかり遠くを見渡した。":138,"ほとんどシルエットでわからないが、\n昼間の曇りは晴れたらしく、夕焼けが美しい。[l]\nもう少しすれば、満天の星空が拝めるのだろう。":139,"と、そこに人影があった。":140,"「…真言か」":141,"先ほどまでとは違い、ラフな服に何故かエプロン姿の知狡さんが、\nそこに立っていたのだった。":142,"「知狡さんでしたか、びっくりしましたよ。[l]\n…半袖すげえ寒そうなんですが」":143,"「ん？[l]\nもう春だぞ。この程度どうということはない。[l]\nそれに、今日の夕餉には私も一品くらい振る舞おうと\n思ってな。[l]\nちょっとばかり奮闘したのさ。[l]\nそれでちょっとクールダウンしに来た」":144,"さらっと言うが、地元民でもそれはどうなの。[l]\n山には雪とか残ってるのに。[l]\nそれはさておきへえ、知狡さんが。料理。[l]\n母さんの場合は、慣れ親しんだとはいえ決して美味い部類では\nなかったが、果たして姉たる知狡さんはどうなのか。":145,"「へえ、楽しみですね。[l]\n奮闘って表現が若干気になりますけど」":146,"あはは、と笑う僕を、\nいつもの真面目なままの視線で知狡さんが\n見ている。[l]\nそして、":147,"「なあ、真言」":148,"と幾分張りつめたトーンで僕の名を呼んだ。":149,"「この世界に――ヒトの世に生きるのは、\nなかなかに面倒なことだと思う」":150,"は？[l]\nい、いきなり深淵なテーマですか？[l]\n…ど、どう反応していいのか分からない。":151,"「…物事もなるようにしかならん。[l]\nだがそれでも、\n諾々と流されるに任せるか抗うか、\n想うのは個人個人だ。":152,"お前がいかなる価値を以て世界を視るか、\nそれ次第だ。[l]\n同時に全ての他人が各々の眼を以て世界を視ているとしてもだ」":153,"「…何かあったんですか？[l]\n知狡さん…」":154,"あからさまに逃げだが、そう言ってみた。":155,"「…ふ。[l]\n何でもないさ。[l]\n少々愚痴ってみただけだ。":156,"さ、夕飯にしよう。[l]\n明日からは旅館モノではなく普段の食事になるからな。[l]\n今宵のうちに存分に堪能しておけ」":157,"「は、はあ…」":158,"結局知狡さんの真意は分からずじまいだったが、\n追求しても始まらない。[l]\n気にはなるが、本人がシーンシフトしたんだからそれに従う事にする。[l]\nそう、そろそろ僕もまた腹が減って、\n脳が空転しだしてしまうし。[l]\n星が見え出した空を見ながら、僕ら二人は旅館へ戻った。":159,"夕餉は豪華で、普通に客として頼んだらいくらかかるのか\n怖くなるくらい大変に美味だった。[l]\nたった一つの点を除いては。[l]\nなんという料理名かももはや意味はない。記憶にもない。[l]\n詳しい描写は避けるが（筆舌に尽くし難しともいう）、\n知狡さんがわざわざ奮闘して作ってくれた一品、\nそれこそがまさに究極の汚点、\nあやうくすべてを台無しにしかけた恐ろしき代物だったのだ。":160,"旅館の人間だ、という先入観が、\n致命的な錯覚を僕に与えていたらしい。[l]\n普通、宿泊場の料理は料理人がつくるもんだ。":161,"知狡さんみたいなトップの役職の人間が手がけることなんかそうそうないんだ。":162,"気付くのが遅かった！[l]\n母さんの料理を上から見るような発言するもんだから、\nてっきり違うのかと思ったら、\n結局似たもの姉妹じゃないかよ。":163,"いや、食えるだけ母さんのがマシだ。[l]\nこのことは宮さんすらも知らなかったらしく、\n僕ら二人は悶絶しつづけ、残りの料理でなんとか\n相殺しようと必死に喰いまくったのだった。":164,"「ちゃんと味見はしたぞ…」":165,"「その事実の方が問題ありますよ…」":166,"「んむぅーっ、もうっ知狡は今後一切料理禁止！[l]\nもし旅館でこれだしたら営業に関わりますよ。[l]\n禁止禁止！知狡はエプロン禁止ーっ！！」":167,"「申し訳有りません…」":168,"今夜は美味い料理と温泉、と思っていたが、\nこういった訳で風呂はお預けになったとさ。[l]\n":169},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_004.ks","relPath":"/data/scenario/SC_M_004.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":170,"length":170,"percent":100},"cellInfo":[[null,{"v":1}],null,[null,{"v":1}],null,[null,{"t":"HU","v":1}],null,null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,null,[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,null,null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1}],null,[null,{"v":1}],null,null,[null,{"v":1}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1,"t":"HU"}],null,[null,{"v":1}],null,null,[null,{"v":1}],null,[null,{"v":1}],null,null,null,null,null,[null,{"t":"HU","v":1}],[null,{"v":1}],null,null,null,[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],[null,{"v":1}],null,[null,{"v":1}],[null,{"v":1}],null,null,null,null,[null,{"v":1}],null,null,null,null,null,null,null,[null,{"v":1}],[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[102,1],"note":"完成"},"/data/scenario/SC_M_005.ks":{"data":[["目が覚めた。","睁开了眼睛。"],["初日だったし、神経高ぶって眠りが浅くなるんではと\n思っていたが、\n部屋の時計を見るとすでに午前九時を回っていた。","本以为首日会因神经亢奋而浅眠，\n但看向房间时钟时，\n发现已过上午九点。"],["夕べ就寝直前に宮さんと話し合い、\n午前中には三春の家に行く予定――僕一人だけど――だったので、\nさっさと支度をすることにする。","昨夜睡前与宫小姐商定，\n计划上午前往三春家――虽然只有我独自前往――\n于是决定尽快准备。"],["入浴し損ねたので、シャワーを浴びる時間も必要だし。","因为没洗成澡，还得花时间冲个淋浴。"],["旅行先でいっつも思うことだが、\n知らないところで目が覚めると違和感あるなあ。","在旅行地总是会这么想，\n在陌生地方醒来总觉得怪怪的。"],["ま、長期滞在になるんだろうし嫌でも慣れることだろう。[l]\n宮さんが入ってこないうちに着替えよう。","嘛，反正要长住下去，不习惯也得习惯吧。[l]\n趁宫小姐还没进来赶紧换衣服。"],["「ご飯が先ぃ～？[l]\nお風呂が先ぃ～？[l]\nそれとも…てまこくん、","「先吃饭饭～？[l]\n先洗澡澡～？[l]\n还是说…喂小真，"],["ノリ悪いなあ」","真没劲啊」"],["「…おはようございます。[l]\n朝からどんなテンションなんですか。","「…早上好。[l]\n大清早的您这什么兴致啊。"],["現実的な話で言わせて貰えば、\n朝食の後でシャワーを浴びたいんですけど」","说点现实的，\n我想吃完早饭再冲澡」"],["「んむー。今日から別行動だっていうのにつれないです。","「唔嗯～。明明从今天开始就分头行动了还这么冷淡。"],["愛がないすねまこくん。","小真没有爱呢。"],["ダメ人間すねまこくん」","小真是人渣呢」"],["愛がどうこう言うんだったら、誰か付き添い付けてくれるなりの\nフォローをして欲しい。[l]\nもっとも顔割れしてない人間は僕だけなので、\nどうしようもないんだが。[l]\n昨日三春のお嬢様と目が合いはしたが、\nまさか覚えられてるってことはない…よなあ。","要说爱不爱的话，好歹派个人陪着\n给点支援啊。[l]\n不过脸没暴露的就我一个，\n也没办法就是了。[l]\n昨天虽然和三春家大小姐对上眼了，\n总不至于被记住了吧…应该。"],["結局、まずは試しに、一見余所者の僕が旅行中の好事家を装って、\n三春家にご神体閲覧のお伺いをしてみることにしたのだった。[l]\n一応嘘は言ってない。言ってないことがあるだけだ。[l]\n望みは薄いが、出来ることからやっていく精神で。[l]\n後々の行動に支障を来さないかどうかが心配ではあるが、\n宮さんも知狡さんも特に反対しなかったので、\n今日は一人で行動決定。","最终决定先试试看，让我这个外人假装成旅行中的收藏家，\n去三春家请求参观神体。[l]\n倒也不算说谎。只是没全说而已。[l]\n希望渺茫，但抱着能做多少做多少的心态。[l]\n虽然担心会不会影响后续行动，\n但宫小姐和知狡阿姨都没反对，\n今天就单独行动。"],["「それより…[l]\n今日の朝飯大丈夫でしょうね」","「比起那个…[l]\n今天的早饭没问题吧」"],["「…と思います…[l]\nきつく言いつけましたから…」","「…应该…[l]\n已经严厉叮嘱过了…」"],["真面目が取り柄の知狡さんは、\nちゃんと宮さんの言いつけを守って、\n今後一切料理には手を出さないことにしたらしい。","以认真著称的知狡阿姨，\n似乎乖乖听了宫小姐的话，\n决定今后再也不碰厨具了。"],["その誓いの証として、どうやったんだかまっぷたつに折れた包丁を、昨夜宮さんに献上しに行ったという。","作为誓约证明，昨晚还把不知怎么折断的菜刀献给宫小姐。"],["…ともあれ、今後は調理場のまかないが出るということのようだ。[l]\n本家泊まりを選択してたらどうなっていたんだか…","…总之以后好像能吃员工食堂了。[l]\n要是选了住本家会怎样啊…"],["さっぱりとした日本食の朝食を久々に堪能し、\n腹ごなしのちにシャワー。","久违地享用了清爽的和式早餐，\n消食后冲澡。"],["さすがに逗留してる間中大浴場に入る訳にもいかないので、\n従業員が使ってるらしいスタッフオンリーの方である。","毕竟不可能滞留期间一直泡大浴场，\n用的是员工专用的小浴室。"],["水質としては一緒だから、効能は得られるはずなんだが、\nバスタブ＆シャワーノズル、小さな個室というだけで、\n失礼な言いぐさだけれども有難味など毛ほども無くなってしまう。","水质都一样应该有效果，\n但只有浴缸&花洒的小单间，\n说难听点根本毫无感恩之心。"],["逆に言えばロケーションさえ整えれば水道水だろうがなんだろうが、その気になれるんだろうな。","反过来说只要环境到位，自来水什么的将就下也行吧。"],["偽薬効果偽薬効果。[l]\n昨日の知狡さんの台詞じゃないが、\n個人の気持ちの持ちようさなあ。","安慰剂效应安慰剂效应。[l]\n虽然不是知狡阿姨昨天的台词，\n全看个人心态啊。"],["さーて、やっとすっきりした気がする。[l]\n部屋へ戻って準備開始。","好——总算神清气爽了。[l]\n回房开始准备。"],["ロビーに行く前に『白沢』に来て、宮さんに挨拶をする。","去大堂前先到『白泽』和宫小姐打招呼。"],["「じゃ行ってきます。[l]\nまた今夜」","「那我走了。[l]\n晚上见」"],["「はい。気を付けて。[l]\nじゃあ…」","「好的。路上小心。[l]\n那就…」"],["「おでかけのちゅー？[l]\nしちゃろうか？」","「出门前的啾～？[l]\n要不要来一个？」"],["「んむぅ！？[l]\nまこくんのえっちめ！！[l]\n","「唔嗯！？[l]\n小真好色！！[l]\n"],["ばいばいーっだ！！」","拜拜啦！！」"],["ぱたたた…と走り去る宮さん。","宫小姐啪嗒啪嗒跑走了。"],["先手を打つに限るよ。","果然要先发制人啊。"],["なんというか…もう。[l]\n僕だって健全な男子なんだということを\n忘れないで頂きたい。","该怎么说呢…真是的。[l]\n希望你们别忘了\n我也是个健全的男生这件事。"],["さて、昨日とはうって変わって今日はいい天気だ。[l]\n出かけよう。","好了，和昨天截然不同今天是个好天气。[l]\n出门吧。"],["お昼時を避けたほうが礼儀なんだろうが、\n一直線に三春家に向かうのもどうかと思い、","虽然避开午饭时间比较合乎礼节，\n但觉得直奔三春家也不太妥当，"],["そこらの人にそれとなく蔵や祭、\n『月狂跳』に関連しそうな話やネタを聞きつつ過ごした。","就一边向当地人旁敲侧击打听仓库、祭祀\n以及可能与『月狂跳』相关的传闻，一边消磨时间。"],["普通なら喪中やら何やらで接触は憚れるのかも知れなかったが、\n密葬だとか言ってたしどうなってるのか分からない。","按理说守丧期间可能忌讳接触外人，\n但他们说是密葬所以搞不清状况。"],["いっそ普通の通夜とかなら焼香装って潜入できるのにな。[l]\n――と、潜入してどうする。","要是普通守夜的话还能假装上香混进去呢。[l]\n――话说混进去要干嘛。"],["少なくとも現時点ではそれが目的ではない。[l]\nとりあえず観光マップみたいなパンフレットは旅館で貰ったので、それと土地感覚を一致させつつうろうろする。","至少现阶段这不是目的。[l]\n总之先在旅馆拿了观光手册之类的宣传页，边对照实地感觉边闲逛。"],["後でちゃんとした地図は買おう。[l]\nパンフ見ながら歩いた時点で、\n幼少時の記憶なんか全く使えない事が判明したし。","回头再买张正经地图吧。[l]\n刚对照手册走两步就发现\n童年记忆完全派不上用场。"],["というかそもそも記憶自体がほっとんどないのだから当然なんだが。[l]\n実地でうろつけば思い出すかと思ったのだが、\n見通しは甘かったようだ。","或者说本来几乎就没留下什么记忆也是理所当然。[l]\n本以为实地走走能想起来，\n看来是太乐观了。"],["元来旅行好きな僕としては、\nこういう田舎観光地を歩くというのは大変に気分がいい。[l]\n仕事とはいえ今のところは気楽なもんだ。","作为天生喜欢旅行的人，\n漫步这种乡下观光地实在心旷神怡。[l]\n虽说是工作但目前还挺轻松。"],["あとで廻ってみたい名所やら結構あるし、\nちょっとテンションあがってきたぞ。[l]\nもの凄い静かーだけどな…","想之后逛的名胜也不少，\n情绪有点高涨起来了。[l]\n虽然安静得吓人…"],["レンタカー屋もないのに、\n一人旅行者が車を運転してるのもどうかと思ったので、\nひたすら徒歩で回ってるんだが、\n…せめて自転車にしとくべきだったか。","明明连租车行都没有，\n觉得独行游客开车也挺奇怪，\n就全程徒步移动，\n…至少该租辆自行车的。"],["いや、それでも本末転倒じゃん。[l]\n一人車旅とか言い張って素直に旅館から車借りれば良かったかな…[l]\nああ、それもあまり三春家行くに関しては良い方法ではないな。","不，那样反而本末倒置吧。[l]\n或许该坚持说是自驾游老实向旅馆借车…[l]\n啊，那也不是去三春家的好办法。"],["バス停くらい権力で玄関前につくっとけよ、と思ったのだが、それも無いらしい。[l]\nご立派な自家用車があるのでバス風情なんて乗らんと言うことか。","明明靠权势在门前设个公交站就行，结果也没有。[l]\n是说有豪华私家车就不屑坐公交吗。"],["いいや、どうせもうそろそろだ。[l]\n玄ノ森の繁華の中心は旅館近くであり、\n三春家は駅前のようにほとんど寂れたような所にあるらしい。","算了，反正快到了。[l]\n玄之森的繁华中心在旅馆附近，\n三春家则像站前商业街般几乎荒废了。"],["正確には、玄ノ森は六母屋近辺以外には街らしいものはなくて、散村状態の田舎町の所々に、観光地と公共施設が点在するような状況である。","准确说玄之森除了六母屋周边根本没有像样的街道，是散村状态的乡下小镇，各处零星分布着景点和公共设施。"],["三春家も有力者とはいえ、格別周囲が賑わうような立地にはない、ということだった。[l]\nそう、目の前のような山の麓、田圃のど真ん中みたいな所。","三春家虽是权贵，宅邸位置也并非特别热闹。[l]\n没错，就是眼前这种山脚、稻田正中央的地方。"],["おお、何とか…昼飯時よりは前に着けたようだ。[l]\nちょっと緊張してくる。[l]\n何となく、尻ポケットの携帯を確認しつつ、\nまずは周囲を歩き始めた。","噢，总算…赶在午饭前到了。[l]\n开始有点紧张了。[l]\n下意识摸了摸后裤袋确认手机，\n先绕着周围走起来。"],["でかい屋敷のぐるりを完全に囲む白壁、\n２，３メートルほどの高さと思われるそれらから更に高く、\nくだんの蔵、その瓦屋根、","大宅外围全被白色高墙环绕，\n那些约两三米的墙后更高处，\n是那个著名的仓库瓦顶，"],["そして何故か赤い丸太のような――\n鳥居か？[l]\n形状が色々決まってるのは本で知ってるが、\n具体的な事までは覚えてなかった。","以及不知为何的红色圆木状――\n鸟居？[l]\n知道书上说形状有各种制式，\n但具体细节记不清了。"],["ただ、何か違和感を感じたのは確かだ。[l]\nおそらく普通の形式ではないのだろう。","不过确实感到某种违和感。[l]\n恐怕不是普通形制吧。"],["そして敷地内にこういうものがあるとは、屋敷神という奴かな？[l]\n例の神社は山中にあるはずだし。[l]\nにしてはでかい。僕が知ってるのはせいぜい祠くらいの規模だ。","然后在宅邸内有这种东西，是所谓的屋敷神吗？[l]\n按说之前提到的那座神社应该是在山里。[l]\n但规模也太大了。我知道的最多也就是小祠堂的程度。"],["と、\n歩きながら視線を正面に戻すと、\nそこにぱっと見高校生くらいと思われる、しかし私服の女子がいた。","说着，\n一边走一边将视线转回前方，\n那里站着一个乍看像是高中生的、穿着便服的女孩。"],["晴れてるとはいえ、肩が大きく出ていて、\n少々見た目寒そうな格好である。","虽说天气晴朗，但她肩膀大面积裸露，\n看起来有点冷飕飕的打扮。"],["知狡さんのように、地元民にとってこの程度の気温は、\n寒い内に入らないということか、はたまた、\n宮さんみたいに女子のやせ我慢なのか。","是像知狡阿姨那样，对当地人来说这种气温\n根本算不上寒冷呢，还是说，\n像宫小姐那样女生为了好看在硬撑呢。"],["じっと敷地内、というより塀に囲まれてるから、\n今まで僕が見てたようにそこから覗く鳥居や屋根を見てる、ように見える。","她一动不动地望着宅邸内——更准确说是被围墙包围的区域，\n就像我刚才那样看着从里面露出的鸟居和屋顶。"],["単に立ってるだけなのかも知れないが、\n周囲に何もないこの場所で、バス停でもない人の家の前に\nただ立ってるということは普通ないだろう。","也可能只是单纯站着发呆，\n但在这个空无一物的地方，既非公交站又非别人家门前，\n普通不会有人傻站着吧。"],["となれば、","既然如此，"],["「あの、すみません…[l]\nここの家の方…ですか？」","「那个，打扰一下…[l]\n您是这户人家的人…吗？」"],["話しかけてみた。[l]\n違ってても用事のある人間だろうし、\n何らかの話を聞けるかも知れない。","试着搭了话。[l]\n就算认错人也是有事的吧，\n说不定能打听到些什么。"],["しかしその娘は集中していたのか、\n結構驚かれてしまった。","但那姑娘可能太专注了，\n被结结实实吓了一跳。"],["「――え、わっなに、びっくりしたよ！[l]\nど、どちらさま？！」","「――咦、哇啊什么啊，吓死我了！[l]\n您、您是哪位？！」"],["「あ、ああどうもすみません、\n旅行中の者なんですけど、\nいいく――」","「啊、啊啊不好意思，\n我是个旅行者，\n叫饭――」"],["…あー、名字は念のため伏せといたほうがいいのだろうか。","…啊—，姓氏是不是该保险起见先瞒着。"],["「――ん、そう、いーくんと呼ばれてます者でして、\n本名は真言、『まことをいう』と書いて\n『まこと』です。はじめまして」","「――嗯、那个、大家都叫我饭君，\n本名是真言，写作『说真话』的\n『真言』。初次见面」"],["明確な虚偽を言うのも問題有りそうだったので、\n無理矢理誤魔化す僕。[l]\n名字黙ってるだけだから良いでしょう。[l]\n大神は僕を（たまに）いーくんと呼ぶもんね。","因为觉得说完全假的也有问题，\n硬着头皮糊弄过去的我。[l]\n只是不说姓氏应该没关系吧。[l]\n大神他（偶尔）会叫我饭君嘛。"],["「ふええ、いーくんですか。[l]\n","「呼诶，是饭君啊。[l]\n"],["こんにちはおにいさん。[l]\nわたし、","你好呀大哥哥。[l]\n我叫"],["西","西"],["石","石"],["貴","贵"],["奴っていいます。[l]\n","奴哦[l]\n"],["ああとね、この家の人間じゃないよ。[l]\nあっちの――」","还有呀，我不是这家里的人啦。[l]\n是那边的――」"],["西石さん…ちゃんか、は、[l]\n僕の来た方とは逆を指さして言う。","西石…是小西吧，哈、[l]\n她指着与我来的相反方向说道。"],["「","「"],["長 ","我在一家叫长"],["久 診療所っていう小さな所で\nバイトしてるのさ。[l]\nそこはここと関係あるけど、\n","久诊疗所的小地方\n打着工呢。[l]\n那儿和这儿有点关系，\n"],["わたし個人は他人なのだわ」","不过我个人就是个外人啊」"],["はあ、そうですか。[l]\nそこで急に西石ちゃんの視線がギロリとこちらを見据えた。[l]\n","哈啊，这样啊。[l]\n就在这时，小西石的视线突然‘咻’地一下死死盯住了我。[l]\n"],["睨まれたというより、異常なまでに興味津々といった風だったので、そういう擬音になってしまう。","与其说是被瞪视，不如说是异常兴致勃勃的样子，所以才会有这种拟声词。"],["実際、不審がられてる反応じゃないようだ。[l]\n将来のゴシップ大好きおばはん候補生か…[l]\nちょっと身が退ける僕。","实际上，看起来并没有被怀疑的反应呢。[l]\n未来的八卦狂热大婶候补生吗…[l]\n我不由自主地往后退了退。"],["「おにいさんここに何か用？」","「大哥哥你在这儿有什么事吗？」"],["「え？[l]\nああ、えーとですね、\nそもそもここに旅行に来たのはこの、\n三春家ですか？[l]\nの蔵を見せていただきた」","「咦？[l]\n啊、那个——\n其实我来这里旅行是为了参观\n三春家[l]\n的仓库」"],["「まこちゃんだよ！！」","「是小真啊！！」"],["「いというのが、え、うえぇ？」","「我是说、呃、诶诶？」"],["彼女は突然僕を真正面に見据え、\n大声を上げた。[l]\nび、びっくりするでしょう、というかまこちゃん？？[l]\n僕のことですカ？","她突然直勾勾盯着我\n大声喊起来。[l]\n吓、吓死人了、话说小真？？[l]\n是在叫我吗？"],["「まこと、真言、まこちゃんだよ！！[l]\nね！！[l]\n覚えてないっ？！[l]\n貴奴だよ、貴奴だってば！！」","「真言、真言、是小真啊！！[l]\n对吧！！[l]\n不记得了吗？！[l]\n我是贵奴啊、都说是贵奴啦！！」"],["玄ノ森のほとんどの場所で記憶を想起できなかった僕の\n空転脳では、残念ながら期待にお応えできそうに\nありません…[l]\n誰だっけ――？","在玄之森大部分地方都回忆不起记忆的我的\n空转大脑恐怕很难\n满足你的期待…[l]\n谁来着――？"],["「た、確かに僕は昔――」","「确、确实我以前――」"],["…言って良いのだろうか？[l]\n飯窪の名を出さなきゃ問題ないか。[l]\nこの娘の事の方が気になる。[l]\n向こうの勘違いかも知れないし、\n結局確認がてら返答した。","…该说出来吗？[l]\n不提饭洼的名字应该没问题吧。[l]\n更在意这姑娘的事。[l]\n说不定是对方搞错了\n最终我还是边确认边回答。"],["「ここに居たかも知れないけど、\n学校に上がる前に引っ越してて、\n君の知ってる人かどうかは」","「可能确实在这里住过\n但上小学前就搬走了\n是不是你认识的人就——」"],["「だってわたしも隣町から来てるのさ。[l]\n昔はここ居たんけど。そんとき会ってさ、[l]\n二人とも小さい内にここ出ちゃったんだよ。[l]\nそりゃ覚えてないはずさ。[l]\n","「因为人家也是从邻镇来的啦。[l]\n以前住这儿。那时候见过面[l]\n咱俩都是很小就离开这里了。[l]\n难怪不记得呢。[l]\n"],["まこちゃん今いくつ？」","小真现在多大？」"],["「…こないだで二十歳に」","「…刚满二十」"],["「やっぱそうだ。","「果然没错。"],["私１８。ほら、わたし二つ下だもんね。","我18。看嘛、我比你小两岁呢。"],["でも覚えてるよ。","但我可记得哦。"],["まこちゃん、一緒に遊んだってば！！","和小真一起玩过的！！"],["ニコ上のお兄ちゃんって、覚えてるもん」","大两岁的哥哥的事、我都记得呢」"],["そこで、僕の空転脳が唐突にキーワードに反応した。","这时、我空转的大脑突然对关键词产生了反应。"],["そうだ。[l]\n確かに、\nここに居たあのとき、\n二つ下の女の子がいた。","对了。[l]\n确实\n住在这里的时候\n有个小两岁的女孩。"],["名前も顔も覚えていないが、\nその『二つ下の女の子』というファクターだけには、覚えがある。","虽然记不清名字和长相\n但对『小两岁的女孩』这个要素还有印象。"],["目の前のこの娘がそうかどうかは、\n申し訳ない事に正直わからないが、\n頭のどこかにそのファクターが引っかかっているし、\n過去に合致する状況があったことは間違いない。","至于眼前这姑娘是不是她\n很抱歉说实话我不确定\n但脑内某处确实卡着这个要素\n过去存在过相符的情况是肯定的。"],["記憶の埋め込みではないのは確かだと思う。[l]\nだが…","应该不是记忆植入。[l]\n不过…"],["「いやー懐かしいっていうか、\nすっかり変わっちゃってて感慨もなにもないね！[l]\n","「哎呀要说怀念吧\n完全变了样根本感慨不起来呢！[l]\n"],["あっははは！！」","啊哈哈哈！！」"],["「あ、あはは…[l]\n僕の方はまだ完全にマッチしたわけじゃないけど、\n確かにニコ下の女の子に知り合いは居た覚えがあるよ」","「啊、啊哈哈…[l]\n我这边还没完全对上号\n不过确实记得认识过小两岁的妹妹」"],["「ふええ？[l]\nまこちゃんひっどい人なのさ！！[l]\n","「呜诶？[l]\n小真太过分啦！！[l]\n"],["ま、今回に限り許すだわ。","嘛、这次就特别原谅你。"],["泊まりで来てるのかな？」","是来住宿的吗？」"],["ん、まあね…と、あやふやに応える僕。","嗯、算是吧…我含糊其辞地回答。"],["「とりあえずひさ…しぶり？にしとこうか…[l]\nこんにちは宜しく、ええと」","「总之好久…不见？就这么说吧…[l]\n你好请多关照，那个」"],["「『きぃ』でいいよ。ちゃんとかさんとかいらない」","「叫『小贵』就行。不用加什么小姐或女士」"],["昔みたいにさ、と笑う彼女。","她笑着说，就像从前那样。"],["八重歯が光る。","虎牙闪闪发亮。"],["「あー…、じゃあ、きぃ。[l]\n僕この家に用事があるから、ほんと名残惜しいけども今日の所は…」","「啊…那、小贵。[l]\n我找这家人有事，虽然真的很舍不得但今天就…」"],["いまだ社交辞令美辞麗句の域も\n脱せないぎこちない会話になるが致し方なしだ。","至今仍停留在社交辞令漂亮话的层面\n难免变成这种生硬的对话。"],["こういう事にそういうものを求めるのも何だが、\n信用に足る証拠は今の所ないのだ。[l]\n…僕も大学で関東出てからは色々見てるしな。","虽然在这种事上追求那种东西也很奇怪，\n但目前并没有值得信赖的证据。[l]\n…我自从大学去了关东也见识了不少。"],["当たり障りのないところで、ここは一旦お流れにしたい所なんだが。[l]\nあんまり騒がれても困るし、と思っていたら、\n案の定というか、中から、外を不審がる声がしてきた。","本想在不触及敏感话题的情况下就此打住。[l]\n正想着闹太大也很麻烦时，\n果然不出所料，屋里传来怀疑外面动静的声音。"],["やべえ。[l]\nここで睨まれると面倒だと言われてるし、\nどうしよう。[l]\nしかも標的中の標的たる三春家に敵視されたら目も当てられない。[l]\n宮さんに会わす顔もない。","糟了。[l]\n据说在这里被盯上会很棘手，\n怎么办。[l]\n更何况要是被目标中的目标三春家敌视可就惨不忍睹了。[l]\n也没脸见宫小姐了。"],["「どちら様？[l]\n先程から大声をあげてらっしゃるけど、\n当家にご用がおあり？」","「哪位？[l]\n从刚才起就在大声喧哗，\n找我们家有事？」"],["名乗っていないにも関わらず、\n私がここの主、と言わんばかりのオーラを発する、\n黒服の女性が、屋敷から顔を出した。[l]\n玄関から門扉までは結構距離があるのだが、\n大きな声でもないのに、通る声がまるで突き刺すようだ。","尽管尚未自报家门，\n却散发着仿佛在宣称自己是这里主人的气场，\n一名黑衣女性从宅邸里探出头来。[l]\n从玄关到大门的距离相当远，\n明明不是很大的声音，却清晰得仿佛能刺穿耳膜。"],["「え、あ…その、ですね」","「呃，啊…那个，是这样」"],["「うちはこういった家ですから、\nあなた方のような不遜な客人もままいらっしゃいますけれど、\nだからといって寛容な対応を施しているわけではありません。[l]\n見たところ余所からいらした方のようですが…、[l]\nあら」","「因为我们家是这样的门户，\n偶尔也会遇到像您这样无礼的访客，\n但并不意味着我们会采取宽容的态度。[l]\n看您像是外地来的…[l]\n哎呀」"],["そこでその女性はきぃを見て――\nってもうこの呼び方に順応してしまったが、\nやや驚いた風の表情を見せた。","这时那女性看到小贵――\n虽然我已经完全适应这个称呼了，\n她脸上露出略显惊讶的表情。"],["「あなたたしか、診療所のお手伝いの方ですね？そうでしょう？」","「您应该是在诊所帮忙的那位吧？没错吧？」"],["「はい、西石と言います。[l]\n長久診療所でお世話になってます」","「是的，我叫西石。[l]\n在长久诊所工作」"],["「あそこは今大変でしょうに、\nこんな時間こんな所で何をなさってるの？[l]\n","「那边现在应该很忙吧，\n这个时间在这里做什么？[l]\n"],["卑","卑"],["尊さんが戻るのはまだもう少し先でしょう」","尊小姐应该还要过些时候才回来」"],["「あのー、その事で言づて頼まれたんですわたし。[l]\n卑尊さん明後日に戻るそうです」","「那个，我就是受托来转达这件事的。[l]\n听说卑尊小姐后天回来」"],["「ああ、そう。それを言いにわざわざいらしたの。[l]\n電話は使えなかったのかしら？」","「啊，这样。特意为这事跑一趟。[l]\n不能打电话吗？」"],["「お昼の買い出しついでに来たので」","「趁着午休采购顺路过来的」"],["「………。[l]\nお二人はお知り合いなの？そちらも隣町のお方？」","「………。[l]\n两位是熟人吗？这位也是邻镇的人？」"],["「ああ、僕は単なる旅行者なんですが、\n本、古書の類を見るのが趣味でして、\nなんでもこちらの」","「啊，我只是个普通游客，\n爱好是看些旧书古籍之类的，\n听说这里的」"],["「三春の書蔵は個人の所蔵です。[l]\n申し訳ないけれど一般には公開しておりません。[l]\n神社は聖域ゆえ、定められた神職のものしか立ち入りは出来ません。","「三春家的藏书是私人收藏。[l]\n很抱歉不对外开放。[l]\n神社是圣域，只有规定的神职人员才能进入。"],["それに――今私どもは色々と立て込んでおりますの。[l]\n家の者も皆忙しいですし、\n何もお相手できることはありませんのよ。[l]\nどうかお引き取り下さいな。","而且――我们现在事务繁忙。[l]\n家里人也都很忙，\n实在没空招待您。[l]\n请回吧。"],["ここ玄ノ森には他にたくさん見るところも御座います。[l]\nそちらをご紹介致しますわ。","这玄之森还有其他许多可看之处。[l]\n我可以为您介绍那些地方。」"],["ああ、書蔵といえばもう一カ所、\n飯窪という家が玄ノ森には御座いますが、\nあちらもきっとお断りになるでしょうね。","啊，说到书库还有一处，\n玄之森有个叫饭洼的人家，\n但那边肯定也会拒绝吧。"],["是非、他の名所をごゆっくりと堪能下されば、\n玄ノ森の者、三春家の者として嬉しいですわ。","请务必慢慢享受其他名胜，\n作为玄之森的人、三春家的人我会很高兴呢。"],["あら、そういえば申し遅れましたね、\n私はこの三春家の現当主の、\n三春のぎかと申します。[l]\n","哎呀，说起来还没自我介绍呢，\n我是现任三春家当主的，\n名叫三春希香。[l]\n"],["初めまして」","初次见面」"],["言い切る前に全てを察したのか、\n言葉を挟む間すら与えてくれずに、\nまさに一気呵成、一方的に言われてしまった。","仿佛在说完前就已洞悉一切，\n连插话的间隙都不给，\n简直一气呵成单方面说完了。"],["「あ、ああそうですか、そうですよね。[l]\nあと何でもここのお祭りが…」","「啊、啊啊这样啊，确实呢。[l]\n还有这里的祭典好像...」"],["「――ええ、ちょっとした事情がありまして、\n今年はまだ準備が滞っておりますが、\n楽しみにしてくださる皆様の為にも、\n予定通りに行えるよう玄ノ森をあげて尽力いたしておりますわ。[l]\nもし機会がおありでしたらそちらも是非」","「――嗯，有些特殊原因，\n今年准备还有些滞后，\n但为了期待祭典的各位，\n整个玄之森都在努力按原计划筹备呢。[l]\n若有机会也请务必来看看」"],["………。[l]\nまあ、裏事情をある程度知っている僕としては、\n多少空々しさを感じないでもないが、\n一見さんにいきなり殺人事件の話を切り出すのも\n不自然――この女性がそれこそゴシップ大好きおばはんだったら\n別だが――だろうし、\n事実と違う事を言われたわけではない。[l]\nむしろ予定通りの祭日程を目指してるらしいという事が分かった訳だ。[l]\n宮さんが言っていたように、\nそのために色々と方々に圧力を掛けるというのだろうか。[l]\n人死にが出てるというのに、だ。","………。[l]\n嘛，作为知道些内情的我，\n多少觉得有点假大空，\n但突然对陌生人提起杀人事件\n也太不自然――除非这女人是超爱八卦的阿姨\n另当别论――总之，\n她说的倒也不算假话。[l]\n反而确认了祭典似乎确实要如期举办。[l]\n就像宫小姐说的，\n为此才四处施压的吧。[l]\n明明都出人命了。"],["「そ、そうですね。[l]\nお祭りは是非見たいと思ってますので、\nどうか頑張ってください。[l]\nではお騒がせしました。[l]\n失礼します」","「是、是啊。[l]\n祭典我很想看看，\n请加油。[l]\n打扰了。[l]\n告辞」"],["「あ、まこちゃんわたしも行くのだわ。[l]\n","「啊，小真我也要走了。[l]\n"],["では卑尊さんのこと確かにお伝えしましたので。","卑尊女士的事确实转达了。"],["失礼します」","失礼了」"],["「わかりました。[l]\nではお二人とも、ごきげんよう」","「明白了。[l]\n那二位请慢走」"],["あはは、えへへ、とぎこちなく愛想笑いをしつつ、\n僕はその場を去った。[l]\nきぃも後をついてくる。[l]\nまた騒がれても困るので、三春の屋敷からはなるべく離れた、\n自動販売機小屋（？）に移動した。","哈哈、嘿嘿地挤出僵硬笑容，\n我离开了那里。[l]\n小贵也跟了过来。[l]\n为避免再惹麻烦，我们远离三春宅邸，\n躲进自动贩卖机亭（？）。"],["さて、何とか、僕の心配してた程には怪しまれることはなく済んだようだ。[l]\n僕らの本命は御神体な訳で、蔵のほうはあまり気にしてなかったんだが、一緒くたに拒否されたということは、思いの外、三春家の所蔵物に近づこうという輩は多いということか。","总之比我担心的顺利，没被怀疑。[l]\n我们真正的目标是神体，本不在意书库，但被一并拒绝说明想接近三春家藏品的人意外地多。"],["まあ、神社にもし安置してないとすれば、\n紙の御神体は書蔵にあると思うのは自然な流れではあるか。","也是，如果神社里没有，\n自然会认为纸质神体在书库。"],["実際にそんな単純な話なら、\nわざわざ宮さんらが調査することでもないだろうから、\n本当は別のところにあるのだろう。","若真这么简单，\n宫小姐他们也不必专门调查，\n应该藏在别处。"],["が、六母屋に来るマニアな客とかはあくまでアマチュアだろうし、\nそういう人種を毎度相手にしてた所為で、怪しい人物慣れしてたのかもな。[l]\nある意味ナイスだ知狡さん。","不过六母屋的狂热客人终究是外行，\n可能因常应付这类人，对可疑分子都习以为常了。[l]\n某种意义上干得好啊知狡阿姨。"],["とはいえ、予想はしていたが完全に玉砕状態である。[l]\nあとは結局当初の予定通り祭の開催を待つか、\n宮さんから言われた調査を地味にしていくしかないな。","虽早有预料但还是惨败。[l]\n要么按原计划等祭典开始，\n要么老实按宫小姐说的继续调查。"],["話の流れでとりあえず、\n彼女――西石貴奴の身許はどうやら確かなようだと分かったので、\n昔のことはさておき、これで多少は打ち解けられる…かな。[l]\n疑っていたらきりがない。","谈话中至少确认了，\n她――西石贵奴的身份应该没问题，\n往事暂且不提，这下能稍微敞开心扉...吧。[l]\n怀疑起来就没完没了。"],["「まこちゃんまこちゃん」","「小真小真」"],["「あそこの蔵の中が見たいんだよね？」","「你想看那个书库里面吧？」"],["え？[l]\nいやどちらかというと御神体の調査が目的で、\n蔵の中が見たいというのはその目的達成の一過程であり…[l]\nじゃなく、あまり真の目的は話したくない。[l]\nので、やや曖昧に頷いた。","啊？[l]\n硬要说的话主要是来调查神体的，\n想看仓库只是达成目的的一个环节…[l]\n不对，其实不太想透露真实目的。[l]\n于是略显暧昧地点了点头。"],["「あそこのお嬢様、\nちょっと知ってる仲なのだわ」","「那位大小姐啊，\n和我有点交情呢」"],["三春家のお嬢様？[l]\n昨日見かけた金髪の眼帯少女。[l]\n知り合いだって？","三春家的大小姐？[l]\n昨天见过的金发独眼罩少女。[l]\n你们认识？"],["「今呼んでみようかな、\n出るかな携帯………出ないのだわ。[l]\n","「要不现在叫她过来，\n手机能接通吗………不行呢。[l]\n"],["学校明日からだし習い事かな？\nしょうがないメールしとこ」","明天开学可能在上课？\n没办法先发邮件吧」"],["僕が止める間もなく、\n彼女はピピピとメールを打っていく。[l]\nおお、二つしか違わないのに今時の若者だなあ。[l]\nや、田舎だからって見くびってた訳ではない。[l]\n単に僕がアナクロでアナログな…[l]\nまあいいや。[l]\n宮さんにしろ大神にしろ、周りはそういうの\n得意なんだがなー。","没等我阻拦，\n她就哔哔哔地打起邮件。[l]\n哇哦，明明只差两岁却这么时髦。[l]\n倒不是看不起乡下地方。[l]\n纯粹是我太落伍又老派…[l]\n算了无所谓。[l]\n不管是宫小姐还是大神，身边人都很擅长这个\n呢——"],["と、彼女がぱちんと携帯を閉じた。[l]\n送信終了したらしい。","说着她啪嗒合上手机。[l]\n看来发送完毕了。"],["「協力を要請したのさ」","「我请她帮忙啦」"],["結局僕の意志とは関係なく、三春のお嬢様と渡りがつく…[l]\nかも知れないことになってしまった。","结果不管我意愿如何，都要和三春家大小姐打交道…[l]\n的局面了。"],["「え、えーと、\nよくわからないけど礼は言っとくよ、\nありがとうございます…」","「呃、那个——\n虽然不太明白总之先道谢，\n非常感谢…」"],["「もし習い事だと、\n最中は電源切って先生が預かってるからさ、\n返事は来るとしても夕方なのだわ。[l]\n","「如果在上培训班的话，\n上课期间手机会被老师保管，\n就算回信也要傍晚呢。[l]\n"],["だいじょぶ、読んだらすぐ返事くれるよ","放心啦，冬夏她呀，看到就会"],["冬","立刻"],["夏は」","回复的」"],["トウカというのか。[l]\n三春冬夏。[l]\nなるほど。","原来叫冬夏啊。[l]\n三春冬夏。[l]\n原来如此。"],["「そのかわり、\nもし冬夏が協力してくれる時は、\nわたしも一緒に行くからね？[l]\n","「不过呢，\n要是冬夏答应帮忙的话，\n我也要跟着去哦？[l]\n"],["一遍見たかったのだわわたしもあの中。","我也超想看看仓库里面。"],["てか、だから協力したの。","不如说这才是帮忙的理由。"],["つまりさ前提条件よ？わたし連れてくのは」","所以这是前提条件懂吗？必须带上我」"],["「は？[l]\nそれは聞いてないけども、\nそりゃ構わないよ。[l]\nというより、\nきぃ…の御陰だし、見知らぬお嬢様と二人だけって[l]\n訳にもいかないし、\n君さえよけりゃむしろお願いしたいくらい…」","「哈？[l]\n这我可没听说，\n不过无所谓啦。[l]\n倒不如说，\n托小贵…的福，单独和陌生大小姐相处[l]\n反而更尴尬，\n你肯来我求之不得…」"],["「ふええ、ほんと！！[l]\n","「哇真的吗！！[l]\n"],["じゃぜったい冬夏にうんと言わせるさ。　","那我绝对会让冬夏答应的。　"],["良かったまこちゃん、\n","太好了呢小真，\n"],["さっすがわたしが目を付けただけはあるのだわ」","不愧是我看上的人」"],["と、僕の手をがっしと握るきぃ。[l]\nもう僕は彼女をそう呼ぶことにした。[l]\nニシイシって言いにくいし。","小贵说着紧紧握住我的手。[l]\n我已经决定这么称呼她了。[l]\n西石叫起来太拗口。"],["「それはどうも…[l]\nそうか、明日始業式か。[l]\nでもきぃは隣町の学校なんだよね？」","「真是多谢…[l]\n对了，明天开学典礼吧？[l]\n但小贵是邻镇学校的？」"],["「わたし高校は行ってないのさ。[l]\n家にお金ないの」","「我没上高中啦。[l]\n家里穷嘛」"],["ああ、そうなのか。[l]\n気まずいことを訊いてしまった。","啊、这样啊。[l]\n问了尴尬的问题。"],["「貧乏だけど携帯は持ってるから番号教えて」","「虽然穷但有手机所以告诉我号码吧」"],["わたしのはこれ、と教わった番号をメモリーに入れる。[l]\n「というより家に電話が引いてないんだわ」と言って\nあっはは、と自虐的というよりはあっけらかんと笑うきぃ。","输入她告诉我的号码存进通讯录。[l]\n「不如说家里根本没装固定电话」说着\n小贵哈哈笑着，倒不是自嘲更像是没心没肺的笑。"],["携帯オンリーと据え置き契約、\nどっちが高くつくんだろうな？と計算する間もなく、[l]\n彼女は横で話し続ける。","只用手机和固话套餐\n哪个更贵呢？还没等我算清楚[l]\n她就在旁边继续说着。"],["「じゃ返事来たら連絡するよ。[l]\nあ、ワン切りで待ち合わせにしよう。[l]\n着信みてわたしだったら、","「那收到回复就联系你。[l]\n啊、用响一声来电当暗号吧。[l]\n看到来电显示是我的话"],["えーとどこがいいか…」","呃该约哪里呢…」"],["相手の内面を想像する余地無く、\n話がとりあえず進行していくので、\n僕としてはもはや委ねるのみだ。[l]\n脳も空転し出してるな…","根本没空揣测对方心思\n话题就这么自顾自推进着\n我也只能听之任之了。[l]\n脑子也开始放空了啊…"],["「土産屋があるんだわ。[l]\nそこもね、三春の関係者のとこだけど、\nそこにしよう。[l]\n冬夏の行き場が近いのさ。[l]\n","「有家土特产店。[l]\n那里也是和三春家有关联的地方\n就定那儿吧。[l]\n离冬夏的落脚点近。[l]\n"],["そういやまこちゃんどこ泊まってる？」","话说真住哪儿来着？」"],["「ああ、六母屋ってところ」","「啊、叫六母屋的地方」"],["「ふええ、じゃあやっぱりそこだね。[l]\n地図ある？[l]\nそうここ。[l]\n『","「呜哇、果然还是那里呢。[l]\n有地图吗？[l]\n对就这里。[l]\n『"],["嘉","嘉"],["多","多"],["里","里"],["辺","边"],["茶","茶"],["屋』だね。[l]\n","屋』对吧。[l]\n"],["ここに来て欲しいのだわ」","希望你来这里」"],["「了解。[l]\n着信きたら向かうよ」","「了解。[l]\n来电了就过去」"],["そこでそのまま何となく会話が弾んだ。[l]\nというか途中で切り上げにくくて、\nだらだら話してたようなもんだが。","之后对话莫名就热络起来。[l]\n或者说中途不好打断\n就这么东拉西扯聊着。"],["「わたしと同い年でさ、\nすっごいブロンドで青い眼なのさ。[l]\nほんとに外人みたいよ、ぱっと見」","「和我同岁呢\n金发碧眼超级明显的。[l]\n乍看真的像外国人哦」"],["ああ、知狡さんからも聞いていたがやっぱりそうか。[l]\n昨日ここに着いた時に見たのが、\n三春家の娘だ。","啊、听知狡阿姨说过果然是这样。[l]\n昨天刚到这儿时看到的\n就是三春家的女儿。"],["「美人かどうかは個人の好みだからさ、\n言わないけどね」","「是不是美人要看个人喜好啦\n不过我不评价哦」"],["僕が宮さんを評した時に思ったような事を言うきぃ。[l]\nで、結局きぃ自身が冬夏嬢をどう評してるかは言わないのであった。[l]\n言ったら言ったで本心かどうかもわからんけど。[l]\n女子っておそろしいなあ…","小贵说着和我评价宫小姐时如出一辙的话。[l]\n结果她到底怎么评价冬夏小姐的终究没说出口。[l]\n就算说了也不知道是不是真心话。[l]\n女孩子真可怕啊…"],["「あ、もう見たんだ？[l]\nどうよまこちゃん的には？」","「啊、已经见过了？[l]\n真觉得怎么样？」"],["「うえ？[l]\nや、ちらっと見ただけだから何ともね…[l]\nまあ、何か引っかかるモノはあったけど…」","「诶？[l]\n就、就瞥了一眼说不上来…[l]\n不过确实有点在意的地方…」"],["それで言ったら目の前のこの娘もそうである。[l]\nふーん、と割とあっさりその話題は通過された。[l]\n女子のその辺の感覚、ほんとに分かりません。[l]\n話題ふるだけふってそれかよ。","要说的话眼前这姑娘也是同类型。[l]\n哼嗯、这个话题意外轻松就过去了。[l]\n女生这种微妙的感觉实在搞不懂。[l]\n抛话题就这？"],["「多分『カクセイイデン』と見たね、わたし。[l]\n学校行ってないけど難しい言葉知ってるでしょ？[l]\nバイト柄ちゃんと勉強したんだから」","「我记得应该是叫『隔代遗传』吧。[l]\n我虽然没上学但难懂的词还是知道的吧？[l]\n因为打工的缘故可是好好学过的」"],["さっき見た母親がごく普通の邦人だったから、\n父親が外つ國の人でない限りは、\nまあそれか突然変異か何かだろうなあ。","刚才看到的那位母亲是极其普通的日本人，\n只要父亲不是外国人，\n那大概就是基因突变之类的吧。"],["アルビノは全然違うし…[l]\nで、その父親もまごうことなき邦人だそうだ。","白化病就完全不一样了…[l]\n然后，据说那个父亲也是地道的日本人。"],["しかし、隔世遺伝とすれば、\n三春家かその婿――ここは代々当主は女、婿取りするらしい――\nの中に、かつて金髪碧眼の人種がいたということになる。","但是，如果是隔代遗传的话，\n就意味着三春家或者其女婿――这里历代当家都是女性，似乎是招婿――\n当中曾经有过金发碧眼的人种。"],["…多分その辺も教えてくれないだろうし、[l]\nそもそも別に知らなくても良いことだ。[l]\nそれとも宮さんか知狡さんが知ってるかな？","…大概这些也不会告诉我，[l]\n本来也不是非知道不可的事。[l]\n或者宫小姐或知狡阿姨可能知道？"],["「腫れ物にさわるみたいな扱いしないほうがいいよ。","「最好不要像对待易碎品那样小心翼翼。"],["…またちょっと難しい言葉使ってみた、","…又用了稍微难一点的词，"],["あっはは！","啊哈哈！"],["冬夏はすっごいサバサバしてるのさ。","冬夏可是超级干脆的人哦。"],["多分向こうが気ぃ遣って自分から見た目の事は言ってくるよ。","大概对方会体贴地主动提起外貌的事。"],["だからまこちゃんも素直に反応することさ。","所以真也坦率地反应就好。"],["ああもーさっきの御当主、お母様とは大違い。","啊真是的，她和刚才的当家、母亲大人完全不同。"],["家とは仲悪いんだわ、冬夏。","冬夏和家里关系不好啦。"],["だからわたしみたいなんのとも付き合ってくれるけど」","所以才会和我这样的人来往」"],["あのババアのせいで家に入れて貰ったことはないのさ、\nときぃは憤慨した。[l]\n八重歯がまた光る。[l]\n何かというと瞬きせずにものを凝視するので、\nたまに怖く見えますよきぃ。","都是因为那个老太婆才没被允许进家门，\n小贵愤愤地说。[l]\n虎牙又闪闪发亮。[l]\n因为动不动就目不转睛地盯着人看，\n偶尔会显得很可怕哦小贵。"],["「育ちが良いからお嬢様ふうの立ち振る舞いではあるけどさ、\n因習しきたりとか大っ嫌いって言ってたよ。[l]\n家にあんなでかい鳥居とか立ってるし、\n玄ノ森では祭の――」","「虽然教养良好所以有大小姐的举止，\n但她说过最讨厌陈规陋习了。[l]\n家里还立着那么大的鸟居，\n在玄之森祭典――」"],["ぐぅぅぅぅぅぅううぅっ。","咕呜呜呜呜呜呜。"],["「………」","「………」"],["「？？？」","「？？？」"],["なにいまの？","刚才什么声音？"],["「ご、ごめん！[l]\nおなかの虫がなったのさ。[l]\n","「对、对不起！[l]\n是肚子里的虫在叫。[l]\n"],["やだ、もうっちょっと超恥ずかしいのだわっ！」","讨厌，超级丢脸啦！」"],["「あ、ごめん、長話しすぎたね。[l]\nきぃもお使いで来てるのに…[l]\nそうかだから、今から一緒にご飯――\nというわけにもいかないんだ？」","「啊抱歉，说得太久了。[l]\n小贵也是来办事的…[l]\n对了所以，现在一起吃饭――\n这样也不行吗？」"],["「ごめん折角だし昼ご飯一緒に食べたいんだけどさ、\n診療所のほうがまだごたごたして、\n","「抱歉难得机会想一起吃午饭，\n但诊所那边还乱糟糟的，\n"],["今から買い出ししてお昼戻らないといけないのだわ」","现在得去采购中午回不来了啦」"],["「わかった。[l]\nじゃ後で色々お礼も兼ねて、どこかで食事する？[l]\nつまりは奢るよってことなんだけど…」","「知道了。[l]\n那之后找个地方吃饭顺便道谢？[l]\n就是说我来请客…」"],["「ふえええええほんっっっとにっっ！！？？？？","「呜诶诶诶诶真的吗！！？？？？"],["まこちゃんまじ！！！？？？？","真你真的！！！？？？？"],["わたしにも貧乏人のプライドがあるけど\n","虽然穷人也有自尊心\n"],["その手の施しには遠慮しないよっ？？？！！！」","但这种施舍我可不会客气哦？？？！！！」"],["どういうプライドなんだろう…[l]\n宮さんの謎のエロ意地のようなもんかな…","这算什么自尊心啊…[l]\n大概和宫小姐莫名其妙的色情倔强差不多吧…"],["「ああ、まあ、いいよ。[l]\nそのかわり店とか知らないから、\nきぃが選んでくれる？[l]\n美味い所紹介がてら」","「啊，嗯，好啊。[l]\n不过我不熟悉店铺，\n小贵来选可以吗？[l]\n顺便介绍好吃的店」"],["「お任せさ！！[l]\n冬夏も知らないような所に連れてってあげるのだわ。[l]\n安くて量があってそこそこの味のイカス店！！！」","「包在我身上！！[l]\n带你去连冬夏都不知道的好地方。[l]\n便宜量大味道还不错的超棒店铺！！！」"],["や、味ももう少し吟味して頂きたいのですが…","那个，味道希望能再讲究一点…"],["「ああもうっ、\nまこちゃん愛してるよっ！！","「啊真是的，\n我最爱真你啦！！"],["食べられるものなら食べたいくらいさっっ！！！","好吃到想把你吃掉的程度啦！！"],["キミは最高の男なのだわ！！！","你是最棒的男人！！"],["だーい好きまこちゃん！！！」","最——喜欢真啦！！！」"],["おいおい、涎出てますよー。","喂喂，口水流出来了哦—。"],["とそこで、","就在那时，"],["「おわっ！！」","「哇啊！！」"],["うれしさ大炸裂といった感じで、\nきぃが突然僕に抱きついてきた。","仿佛喜悦大爆发一般，\n小贵突然扑过来抱住了我。"],["ひ、ひええ。","呜、呜诶诶。"],["しかもなにげに力強いぞ。","而且莫名地力气好大。"],["い、い、痛いくらいだ。","痛、痛、痛得要命。"],["嬉しいとか考える前に、混乱と痛みが先行して、","还没来得及感到高兴，混乱和疼痛就先袭来，"],["只ひたすらあわてる。","只能一个劲地慌张。"],["「ぜっったいだよ。[l]\n嘘ついたら冬夏の話もなしさ。[l]\n二人してまこちゃんの邪魔してやるのだわ」","「绝对要遵守哦。[l]\n要是说谎的话冬夏的事也免谈。[l]\n我们俩会一起妨碍小真的」"],["身体をぱっと離して、えらく真剣な眼で僕に念を押す彼女。[l]\nいてててて…[l]\n宮さんの逆セクハラのせいで、\nせっかくの女子とのふれあいにも昔のようなドキドキが\n無くなってる気がする…それはそれでやばいよなあ…[l]\nま。ともあれ、食い物の恨みは恐ろしいし、[l]\n約束を反故にする理由もないから安心したまえ。","她猛地松开身体，用极其认真的眼神向我强调。[l]\n痛痛痛痛…[l]\n因为宫小姐的逆向性骚扰，\n总觉得好不容易和女生的接触也失去了从前那种心跳加速的感觉\n这样下去可不妙啊…[l]\n嘛。总之，食物的怨恨很可怕，[l]\n我也没有毁约的理由就放心吧。"],["「わかったって。約束は守るよ。[l]\nじゃ着信待ってる、それまでに土産屋の場所確認しとくから。[l]\nそれじゃあ、お使い頑張って」","「知道啦。会遵守约定的。[l]\n那我等你的消息，趁这期间先去确认土产店的位置。[l]\n那就加油跑腿吧」"],["「うんっ！！","「嗯！！"],["ほんとに今日、\nまこちゃんに会えてよかったのさ。","今天能见到\n小真真的太好了。"],["カミサマに感謝なのだわ」","要感谢神明大人呢」"],["じゃあとで、と、\nすたすた向こうに歩み去るきぃ。[l]\n手を振って見送る僕。[l]\nって歩きだったのか、彼女。","回头见，说完\n小贵啪嗒啪嗒地朝对面走去。[l]\n我挥手目送着她。[l]\n原来她是用走的啊。"],["まあ、これで心強いサポーターが出来たということなのかな…[l]\n少なくとも三春の内部の人間と繋がりがもてるのならば、\nそれは有用だろう。[l]\nたった今母親には突っ慳貪にされたし、\nまだどうなるかはわからないが。","嘛，这样就算是有了可靠的支援者吧…[l]\n至少如果能和三春的内部人员建立联系，\n应该会很有用。[l]\n只不过刚才被她母亲冷淡地回绝了，\n接下来会怎样还不好说。"],["さーて、緊張と事態の急転ですっかり意識の外だったが、\nきぃの腹の虫がなったとおり、もう昼飯の時間帯だ。[l]\n身体が完全に空腹を訴えておりますよ。[l]\n脳が空転し出す前…もうしてるけど、ご飯を食おう。[l]\nしかし、飯どころはまだ目星付けてなかったんだよなー。[l]\n昨日のラーメン屋は歩いていける距離じゃないし、\n旅館に戻るのもなんだし。[l]\n三春家の立地がこうなると恨めしいわ…[l]\nとにかく店のあるとこまで戻らないことには。[l]\n観光スポットまで行けば何とかなるんだろうが、\n最悪国道沿いに出てコンビニ探そう。","好嘞——由于紧张和事态急转，完全没注意到，\n正如小贵肚子叫的那样，已经到了午饭时间。[l]\n身体正在强烈抗议饥饿呢。[l]\n在脑子彻底空转前…虽然已经开始了，赶紧吃饭吧。[l]\n但吃饭的地方还没找好啊—[l]\n昨天的拉面店步行到不了，\n回旅馆又有点那啥。[l]\n三春家这地理位置真是让人恨得牙痒…[l]\n总之不先回到有店铺的地方就没辙。[l]\n走到观光景点应该总有办法，\n最坏就沿着国道找便利店吧。"],["あ、そういや彼女、買い出しついでと言ってたな。[l]\nということは店が向こうにはあるんだ。[l]\nしかし――\nどうみてもこの道しばらくは何もないですよ？[l]\nついでで行ける距離にほんとに店あるか？[l]\n単に電話代ケチったんじゃないですか？","啊对了，她刚才说是顺道采购来着。[l]\n也就是说对面有店铺？[l]\n但是――\n怎么看这条路短期内啥都没有吧？[l]\n顺路能到的距离真有店吗？[l]\n该不会单纯是为了省电话费吧？"],["…しばし煩悶。[l]\nいかん、もう空腹による脳空転で判断能力がやばめだ。[l]\n安全策とる、戻るに決定。[l]\n途中あったら速攻入ろう…[l]\nとりあえずはここの自販機で何かを…ぐうう……","…短暂烦恼。[l]\n不行，已经因为饥饿导致脑空转，判断力岌岌可危。[l]\n采取安全策略，决定往回走。[l]\n中途有店就立刻冲进去…[l]\n总之先在这边的自动贩卖机买点什么…咕呜呜……"],["昼飯も食し、土産屋『","吃完午饭，也确认了土产店『"],["屋』の場所も確認した。","屋』的位置。"],["茶屋、というかこの土産屋は、\n一階部分が売店、二階部分では、\n土地の古老、語り部が民芸話をするという、\n名前そのまんまの店だった。[l]\n時間つぶしに二階に行こうとも思ったが、\n公演時間が決まってるうえ料金もかかるし、\n携帯の着信待ちの身としてもあまりよろしくない\n気がしたのでスルーした。","说是茶屋、其实就是这家土产店，\n一楼部分是卖场、二楼部分则是，\n由当地老人、说书人讲述民间故事的，\n完全名副其实的店铺。[l]\n虽然也想过为了消磨时间上二楼看看，\n但演出时间固定还要收费，\n对于正在等电话的我来说也不太合适\n所以就放弃了。"],["旅館に戻っても良かったけども、\nいい加減一日中歩いたので、今更移動などする気力はない。[l]\nこの茶屋近くで待たせて貰いますよ、へっへっへ。","回旅馆也不是不行，\n不过毕竟走了一整天实在没力气再移动了。[l]\n就在这茶屋附近等着吧嘿嘿嘿。"],["と思って、小さい本屋で、\n当初から買う予定だった地図と、\nある有名詩人の詩集を購入し、\n土産屋近くの公園のベンチでそれらを読みながら連絡を待った。[l]\n大学生…ではもうないが、高校出ると、長期休暇とか、[l]\n年度始まりとかよく分からなくなってくるなー。[l]\nサラリーマンとかはそうでもないんだろうけど。[l]\n最後の春休みね、今日は。","这么想着、在小书店里，\n买了原本就打算要的地图、\n和某位著名诗人的诗集，\n坐在土产店附近公园长椅上边看边等联络。[l]\n大学生…虽然已经不是了、但高中毕业后就对长假啊、[l]\n学年起始之类的时间概念越来越模糊了呢—[l]\n上班族应该没这种困扰吧。[l]\n今天可是最后的春假了哦。"],["…この詩集ちょっと面白いな。[l]\n作者の名前はいろんな本に出てくるから知ってはいたが、\nその作品を読むのは初めてだ。[l]\n時代が古めなので、今だとややヤバげな表現が出てくるが、\n全体的にちょっと僕好みの雰囲気である。[l]\nふーん、はまりそう…","…这本诗集还挺有意思的。[l]\n作者名字在很多书里都见过所以知道，\n但读他的作品还是第一次。[l]\n因为年代较早、现在看有些表达略危险，\n但整体氛围还挺对我胃口的。[l]\n唔嗯、有点上瘾…"],["と思いもかけず良本との出会いの御陰で、\nきぃからの連絡が来るまでの時間は有意義に過ごせた。[l]\n彼女からの着信は３時過ぎだった。","多亏意外邂逅这本好书，\n等小贵来电的时间也变得有意义了。[l]\n她的电话是三点多打来的。"],["「というわけれ、\nひょうは会えなはっらんですけどね、\nんぐ、明日、明日。[l]\n三春のお嬢様と会う約束しました。[l]\n始業式終わってから」","「所以说、\n今天见不到啦、\n唔咕、明天、明天。[l]\n和三春家大小姐约好了。[l]\n开学典礼结束后」"],["「まこくん、ベタ過ぎて言いたくないですけど、\nもの食べながら喋らないでください。[l]\n","「小真、虽然老套到不想说、\n但请不要边吃东西边说话。[l]\n"],["にしても、その西石って娘気になるなぁ…」","不过那个西石家的姑娘很让人在意啊…」"],["いつまでも着信が鳴り続けたので電話に出たところ、\n結局、きぃからの連絡は、\n冬夏嬢から返事は来たものの、\n会えるのは明日なので今日の集合はなし、ということだった。","因为来电一直响就接了电话、\n结果小贵带来的消息是、\n虽然冬夏小姐给了回复、\n但见面要等到明天所以今天不用集合了。"],["時間帯が半端で店が開いておらず、\n奢るのは明日のその時で良いと言われたので、\nその後、宿に戻って夜まで過ごし、\nどこからか戻ってきた宮さんに今日のあらましを報告したのだった。","因为时间尴尬店铺都没开、\n她说请客可以等到明天见面时再说，\n之后回到旅馆待到晚上、\n向不知从哪儿回来的宫小姐汇报了今天的情况。"],["流れで宮さんの部屋でこうして夕飯を食している。","顺理成章就在宫小姐房间这样吃起了晚饭。"],["勿論、知狡さんの料理ではなく、\n料理人さんたちのまかないだ。","当然不是知狡阿姨做的、\n是厨师们的员工餐。"],["全然美味いです。ベリナイス。","超级好吃。Very nice。"],["「にしいし、西石。んむ～――」","「西石、西石。嗯唔～――」"],["知狡さんの記憶も僕と大差はなく、\n近い歳の女子と遊んでいたらしい、\n程度の事実は確認できたものの、\n彼女が実際にそうなのかは分からずじまいだった。","知狡阿姨的记忆和我差不多、\n只确认到她和同龄女生玩过、\n这种程度的事实、\n最终也没弄清她是否真是那个人。"],["「ニシイシって字面に覚えはあるみたいでしたけど、\n知狡は。[l]\n昔何かはあったのかなぁ…」","「对'西石'这两个字好像有印象、\n知狡阿姨说。[l]\n过去可能发生过什么吧…」"],["「まあ三春とも知り合いのようでしたし、\n身許はちゃんとしてるんでしょうけど。[l]\nそういやその診療所も土産屋も、\n例の系列だか関係者だって…」","「不过既然和三春家也认识、\n身份应该没问题吧。[l]\n说起来那家诊所和土产店、\n好像都是那个派系的相关人士来着…」"],["「んむ？[l]\n","「嗯唔？[l]\n"],["あ、そうですね。","啊、是的。"],["長久診療所は、三春家の専門というかかかりつけというか、\n何故かずっとそうらしいですね。","长久诊所算是三春家的专属医疗机构、\n不知道为什么从古至今都这样呢。"],["もっと大きいちゃんとした病院は玄ノ森の中央にもありますけど、\n何故か三春達はそこを使うらしいですよ。","虽然玄之森市中心也有更大更正规的医院，\n但三春他们不知为何似乎更常去那家（诊所）看病呢。"],["女子の世襲でやってて、[ruby text=\"ナガ\"]永[ruby text=\"ヒサ\"]久家というんですが」","是由女性世袭经营的，叫做永久家」"],["その字を変えて長久、転じてチョウキュウ診療所と称している、\nということだった。","后来改字为长久，转称为长久诊疗所，\n就是这么回事。"],["「聞いてないかもですが、\n例の殺人事件で殺されたのが、ここの先生ですね」","「你可能没听说，\n之前那起杀人案的被害者就是这里的医生哦」"],["聞いてない。[l]\n聞いてないが、あそこが大変で誰だかが戻ってくるとか来ないとか、\nそういう話を、きぃが確かにしていたな。[l]\nそのことだったのか。","没听说。[l]\n虽然没听说，但那边好像乱成一团，还有什么人要回来不回来的，\n小贵确实提起过这种事呢。[l]\n原来是指这个啊。"],["「ついでに言うと、\nまこくんが紹介された土産屋『嘉多里辺茶屋』もですね、\n綾目家という家がやってるんですが、\nここの主――女性ですけど――が殺されたもう一人なんです」","「顺带一提，\n介绍小真去的土产店『嘉多里边茶屋』呢，\n是由叫绫目家的家族经营的，\n那里的店主――虽然是女性――就是另一个被害人哦」"],["「…はい？[l]\nえ、ええ？[l]\nきぃが言うにはそこも三春の関係者だと…」","「…啊？[l]\n诶，诶诶？[l]\n小贵说那里也是和三春有关联的…」"],["「んむ？","「嗯唔？"],["そんなこと言ってたんですか？","她说过这种话吗？"],["……んむー、じゃそうなんでしょうね」","……嗯唔——那就是这么回事吧」"],["ってこれは関連性を見出さずには居られないでしょうに。","这怎么想都有关联性吧。"],["素人考えですか？","是外行人的想法吗？"],["「まこくんが思ってることは、ま、\nみんな思ったんでしょうね。","「小真想到的事嘛，\n大家应该都想到了吧。"],["だから他の三春の系列、\n狩屋とか、あと知狡が言うには関西にも三家ほどいるらしいですが、\n警備警戒強化してるぽいですけど。","所以其他三春派系的，\n像是狩屋家，还有听知狡说关西也有三家左右，\n好像都加强了警备呢。"],["結局は全部三春が仕切ってるのかなあ、\n何故か事件の発覚は抑えようとしてますね。","说到底可能全是三春在掌控吧，\n不知为何在压制案件曝光呢。"],["どうしても祭は予定通り行いたい気配はあると聞いてます。","听说无论如何都想按原计划举办祭典。"],["うひひ、宮たちにとっては好都合ですね。","嘻嘻，对我们来说正合心意呢。"],["不謹慎ですけどね」","虽然不太谨慎就是了」"],["僕も三春の当主から直々に聞いている。","我也直接从三春当家那里听说了。"],["神事は神事だし、現世の都合でスケジュールをいじるなんて出来ない\nのかも知れないが、","神事终究是神事，或许不能因为现世的情况就更改日程\n也说不定，"],["昔ならいざ知らず今の世でもそれが通るものだろうか。","但放在古代还行，如今这个时代还能这样吗。"],["信仰絡みなら、ままあるものだろうか。","涉及信仰的话，或许确实常有这种事吧。"],["「西の三家も祭となれば全家がここに集合するわけで、\n毎年の事なのに、旅程とか変更面倒くさいでしょうしね。","「西边的三家遇到祭典时全族都会聚集过来，\n虽说年年如此，但改行程什么的很麻烦吧。"],["普通に事件が解決してくれるに越したことはないでしょうが、\n","当然能顺利解决事件最好不过，\n"],["いざとなればどうでるか…」","但万一的话就…」"],["あの、今思ったんですが、\n祭は予定通り強行される目算が高いのならば、","那个，我刚想到，\n如果祭典大概率会强行按计划举行的话，"],["やっぱり僕は大学辞めてまでこんな前入りしてなくても\n良かったんではないでしょうか。","那我其实没必要连大学都退学就提前过来\n不是吗。"],["「んむ！？","「嗯唔！？"],["いえｿﾝﾅｺﾄﾊﾅｲﾃﾞｽﾖ?","没这回事啦！"],["ほらえーと…","你看那个…"],["ん！あ、まこくん！！」","啊！小真！！」"],["「な、なんすか！？」","「怎、怎么了！？」"],["「んむ、そうですた！","「嗯唔，想起来了！"],["忘れてないですよね、\n","你没忘记吧，\n"],["今日こそ混浴ですよ？","今天可是要混浴哦？"],["露天風呂♪」","露天温泉♪」"],["ごまかしやがったな…大学に関しては済んだことだしいいけどさ…","居然糊弄过去…大学的事就算了…"],["てか混浴まだ本気だったか宮さん。","话说混浴居然是认真的吗宫小姐。"],["水着持参は伊達じゃないということか…","带泳装来不是装样子啊…"],["「あ、あのねえ…」","「啊，那个…」"],["「ゆうべはお預けだったんですからイヤとは\n言わせません。","「昨晚已经延期了所以这次\n不许拒绝。"],["水着は知狡が用意してくれるそうですから～」","泳装听说知狡会帮忙准备哦～」"],["「ああ～もう、分かりましたよ。","「啊～知道啦知道啦。"],["今晩だけですよ、今晩だけ。","就今晚哦，就今晚。"],["じゃちょっと腹ごなしするまで待ってください」","那请稍等片刻让我消消食」"],["「わーい★","「哇～★"],["背中流しっこです」","来互相搓背吧」"],["「うええ～するんすか～…」","「呜诶～真要这样吗～…」"],["それは、身体的接触はちょっと、いくら宮さん相手でも、","这、身体接触还是有点、就算对象是宫小姐、"],["………身体が反応しそうだなあ……","………身体好像会有反应啊……"],["気まずいことになんなきゃいいけど…","但愿别变得尴尬…"],["「全身洗いっこでもいいですよ～。","「全身互相搓洗也可以哦～"],["うひひ、ぬるぬるー」","嘿嘿，滑溜溜～」"],["それは絶対に却下します。","这个绝对要驳回。"],["教育的指導！","教育指导！"],["客だーれもいない。","客人一个都没有。"],["二人っきりです。","就我们两个人。"],["これは良いのか悪いのか…","这算好事还是坏事呢…"],["先に僕が入り、","由我先进入、"],["水着に着替えた宮さんが後から来るという事に","换好泳装的宫小姐随后再来"],["なっている。","这么定了。"],["露天風呂、旅行結構してるけど初めてかもだ。","露天温泉，虽然经常旅行但可能是第一次泡。"],["なんか落ち着かないな。","总觉得静不下心。"],["宮さん待ちというのもあるけど…","也有在等宫小姐的缘故…"],["何故か仁王立ちになってしまう僕。","不知为何站成仁王姿势的我。"],["と、","这时、"],["「さーさまこくん、\nお背中お流し致しますぅ～ってなんだ、","「来～真酱、\n让姐姐帮你搓背哟～什么嘛、"],["ビキニパンツじゃないじゃないですかぁ～」","这不是比基尼泳裤嘛～」"],["「あのね宮さん、\n旅館の売店に、混浴用だってビキニパンツ売ってますか？","「那个啊宫小姐、\n旅馆小卖部会卖混浴专用的比基尼泳裤吗？"],["…や、詳しくは僕も知らないですけど、\n変な事期待しないで下さい。","…嘛、具体我也不清楚、\n请不要期待奇怪的事情。"],["エロですね、スケベですね」","好色哦，下流哦」"],["「んむ～っ。","「嗯唔～"],["知狡も気が利かないなっ！","知狡也太不会来事儿了！"],["スク水とそれじゃ割に合わないです。ずるいです。","和学校泳装比起来太不公平了。狡猾。"],["差分払って欲しいです～」","要补差价才行～」"],["「全部脱いで見せられるものなら見せてあげますけどね、\nあの看板とおりここは水着着用ですから。","「要是能全脱下来给你看倒也无所谓、\n但正如招牌所写这里是必须穿泳衣的。"],["残念ですなあ。","真遗憾呢。"],["ルールには従わないとねぇ」","必须遵守规则呢」"],["スパイじみた行為をしようとしている人間の言ではないな…","这可不像是企图搞间谍活动的人会说的话…"],["あはは。","啊哈哈。"],["「んむー？","「嗯唔～？"],["それはルール無用の場所ならおーけーということかな？","意思是无规则限制的地方就可以吗？"],["うひひ、言ったなまこくん！","嘿嘿，这可是你说的真酱！"],["後でどんだけ大人になったか、見せて貰おうか！！」","待会就让我看看你成长了多少吧！！」"],["「そんな場所と機会があれば見せてやろうじゃないのよ！","「要是有那种地方和机会就让你见识下又何妨！"],["あればな、あれば！！","有的话啦，有的话！！"],["ふははは！！！」","呼哈哈哈！！！」"],["「後でぇ、宮の部屋に来てくれるぅ？","「待会儿呀～来宫的房间好不好？"],["まこくうぅ～ん★","真酱呜嗯～★"],["みゃおみゃお～ん♪」","喵呜喵呜～♪」"],["…そうきたか。","…来这招啊。"],["反応しそうになる身体を精神力で必死に押さえつけながら、\n極力軽蔑のこもった眼で見てやった。","拼命用精神力压制着快要起反应的身体、\n尽可能用充满轻蔑的眼神瞪过去。"],["「んむぅ、わかりましたよぉ。","「嗯唔～知道啦。"],["ほんとまこくんはつれないですなー。","真酱真是冷淡呢～"],["ま、戯言はここまで。","嘛，玩笑就开到这儿。"],["ちゃんと背中流してあげますから、\nこっち来てください」","会好好帮你搓背的、\n请过来这边」"],["―――結局、\n何事もないまま、普通に混浴しました。","―――结果、\n什么都没发生，普通地混浴了。"],["あたりまえだ。","理所当然。"],["つーか、からかう気のない時の宮さんなんて、\n醒めたもんなんだ。","话说，不捉弄人时的宫小姐、\n其实挺正经的。"],["こっちが変にその気を出して近づこうもんなら、\n超ブルーになること必至である。","要是我这边鬼迷心窍地主动靠近的话，\n对方肯定会变得超级冷淡的。"],["明日の話を少ししてから湯から上がり、\n各々の部屋に戻った。","聊了会儿明天的事就离开浴池，\n各自回房去了。"],["…ええ、正直、\nちょっと身体は反応しておりましたけど、\n今夜はおとなしく寝まス。","…嗯、老实说、\n身体是有点反应啦、\n今晚会乖乖睡觉的。"],["そしてなるべく早く忘れよう。","然后尽快忘掉吧。"],["今後のことを考えますとね。","毕竟要考虑今后的事嘛。"],["まともに顔を見られないのも困るのでね。","总不能连正常对视都做不到吧。"],["では、\nおやすみなさい…","那么，\n晚安…"]],"context":[["SC_M_005.ks/index/1/text"],["SC_M_005.ks/index/3/text"],["SC_M_005.ks/index/5/text"],["SC_M_005.ks/index/7/text"],["SC_M_005.ks/index/9/text"],["SC_M_005.ks/index/11/text"],["SC_M_005.ks/index/13/text"],["SC_M_005.ks/index/16/text"],["SC_M_005.ks/index/18/text"],["SC_M_005.ks/index/20/text"],["SC_M_005.ks/index/22/text"],["SC_M_005.ks/index/24/text"],["SC_M_005.ks/index/26/text"],["SC_M_005.ks/index/28/text"],["SC_M_005.ks/index/30/text"],["SC_M_005.ks/index/32/text"],["SC_M_005.ks/index/34/text"],["SC_M_005.ks/index/36/text"],["SC_M_005.ks/index/38/text"],["SC_M_005.ks/index/40/text"],["SC_M_005.ks/index/42/text"],["SC_M_005.ks/index/44/text"],["SC_M_005.ks/index/46/text"],["SC_M_0