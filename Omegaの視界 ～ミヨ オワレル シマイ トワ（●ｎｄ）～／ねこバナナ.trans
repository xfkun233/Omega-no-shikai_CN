[{"start":2223,"end":2250}],[{"start":2256,"end":2300}],[{"start":2306,"end":2334}],[{"start":2340,"end":2395}],[{"start":2401,"end":2414}],[{"start":2420,"end":2468}],[{"start":2478,"end":2498}],[{"start":2504,"end":2537}],[{"start":2547,"end":2577}],[{"start":2583,"end":2612}],[{"start":2622,"end":2646}],[{"start":2656,"end":2680}],[{"start":2686,"end":2726}],[{"start":2732,"end":2745},{"start":2989,"end":3002}],[{"start":2751,"end":2807}],[{"start":2813,"end":2827}],[{"start":2833,"end":2867}],[{"start":2877,"end":2891}],[{"start":2897,"end":2922}],[{"start":2928,"end":2979}],[{"start":3008,"end":3070}],[{"start":3078,"end":3111}],[{"start":3117,"end":3154}],[{"start":3160,"end":3189}],[{"start":3200,"end":3208}],[{"start":3216,"end":3256}],[{"start":3262,"end":3282}],[{"start":3292,"end":3309}],[{"start":3315,"end":3326}],[{"start":3332,"end":3341}],[{"start":3347,"end":3398}],[{"start":3404,"end":3419}],[{"start":3425,"end":3437}],[{"start":3447,"end":3464}],[{"start":3470,"end":3487}],[{"start":3497,"end":3503}],[{"start":3509,"end":3520}],[{"start":3530,"end":3537}],[{"start":3543,"end":3560}],[{"start":3580,"end":3591}],[{"start":3597,"end":3611}],[{"start":3617,"end":3628}],[{"start":3638,"end":3663}],[{"start":3669,"end":3685}],[{"start":3691,"end":3707}],[{"start":3713,"end":3722}],[{"start":3728,"end":3739}],[{"start":3745,"end":3750}],[{"start":3756,"end":3765}],[{"start":3785,"end":3788}],[{"start":3794,"end":3835},{"start":3902,"end":3943},{"start":3967,"end":4008}],[{"start":3843,"end":3879}],[{"start":3889,"end":3894}],[{"start":3953,"end":3959}],[{"start":4018,"end":4028}],[{"start":4038,"end":4043}],[{"start":4051,"end":4088}],[{"start":4098,"end":4103}],[{"start":4111,"end":4142}],[{"start":4152,"end":4167}],[{"start":4175,"end":4206}],[{"start":4216,"end":4223}],[{"start":4231,"end":4275}],[{"start":4281,"end":4288}],[{"start":4294,"end":4298}],[{"start":4304,"end":4312}],[{"start":4318,"end":4327}],[{"start":4333,"end":4365}],[{"start":4371,"end":4381}],[{"start":4387,"end":4414}],[{"start":4422,"end":4450}],[{"start":4458,"end":4489}],[{"start":4497,"end":4520}],[{"start":4528,"end":4531}],[{"start":4537,"end":4568}],[{"start":4574,"end":4583}],[{"start":4589,"end":4634}],[{"start":4640,"end":4690}],[{"start":4696,"end":4724}],[{"start":4730,"end":4763}],[{"start":4773,"end":4795}],[{"start":4801,"end":4853}],[{"start":4859,"end":4901}],[{"start":4911,"end":4936}],[{"start":4942,"end":4976}],[{"start":4982,"end":4991}],[{"start":4997,"end":5038}],[{"start":5046,"end":5093}],[{"start":5099,"end":5149}],[{"start":5159,"end":5185}],[{"start":5191,"end":5230}],[{"start":5236,"end":5243}],[{"start":5249,"end":5280}],[{"start":5290,"end":5295}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_059.ks","basename":"SC_M_059.ks","indexIds":{"\n\n\n\n\n──cogito, ergo sum":0,"……は？":1,"\n\n\n\n\n──われおもう、ゆえにわれありと":2,"彼のヒトは述べた。":3,"……ああ……":4,"……僕が……どんなに…………ても……":5,"……セカイはただ在り続け……居ても居なくても……":6,"\n\n\n\n\n──なら、\n　　なぜ観測主体が必要なんだ？[l]\n　　イキモノが概ね排他的に生き延びようとするのは何故だ？":7,"………。":8,"\n\n\n\n\n──観測主体が居なければ、セカイは無いも同じだからさ、\n　　その位置にどんな主体がこようが、\n　　視る眼が存在を確認さえしてくれれば、":9,"……はこのなかに……みえたのは……違う、逆か……":10,"\n\n\n\n\n──肉を纏いし思考存在がそのただ只管に肉の生存に執着し、\n　　相争うこの最悪の箱庭の中で、\n　　取り敢えずはヒトが、その役を担うに都合が良かった……[l]\n　　或いは逆に、否、その辺りを考えると、\n　　a question of which came first, \n    the chicken or the egg──":11,"\n\n\n\n\n──なので置いておこうか。[l]\n　　兎に角、始祖アリスの思惑はさておき、\n　　奴等がＣＡＴと呼ぶ\n    我等が肉としてヒトとの親和性の高きには、\n　　そういった背景があるのだろうな、":12,"\n\n\n\n\n　　勿論、ワガミの事とはいえ":13,"天":14,"地の":15,"理、\n　　己で全て把握出来てる訳じゃない、\n    寧ろ自分の事こそ分からないもの。":16,"……自分が何かなんて……誰にもわかってない……":17,"\n\n\n\n\n──鏡を視るのは恐ろしい。[l]\n　　本来意識する事なき第三の眼、第三の視界と、\n　　己のそれを重ね合わすモノだからな。[l]\n　　げに恐ろしき邪眼魔眼とは\n    冷静で主観とはかけ離れた客観視点の事、\n　　補正の一切無い自分を視ることは、ときに、":18,"……自我崩壊……を引き起こし……":19,"\n\n\n\n\n──強固な自己暗示で騙し続けようと、\n　　それは逃避でしかない、崩壊と同じ事、つまり失効する。[l]\n　　ＣＡＴは狭窄した視野も思考も望まない。[l]\n　　ＣＡＴとの繋がりは断たれる。":20,"……魔眼を刺すとは……シカクの…………ュタ………ウカ……":21,"\n\n\n\n\n──そうでない繋がりを模索されている気配があるが、\n　　今の処は関係ない。[l]\n　　キかない場合は物理的に接触を断つ術もそうでない遣り方も、\n　　あれらによって仕込まれているからね。[l]\n　　われにできることは、説明のならぬものだ。[l]\n　　われが、われだ。":22,"……そうか……それで……なんの話だったっけな……":23,"\n\n\n\n\n──トコトワにその思考回路の内容問わず、\n　　観測者としてのみの役さえこなせれば、\n　　セカイは存続すると、その為に、\n　　その為だけに思考存在は生きることを赦されて……否、[l]\n    強制されていると、[l]\n　　思えるか？":24,"……そんなことは……ぼくらが……考えることでは……":25,"\n\n\n\n\n──謙譲の美よりも\n    在り続ける為に他を排しても構わない方が、\n　　よきみちと思えるか？":26,"……わざわざ選ぶ必要なんか……確定させる必要なんか……":27,"\n\n\n\n\n──いきるのは基本的に余裕のないものなんだ、\n　　だが、だからといって\n　　そうでない思考存在が存在可能である以上、\n　　それは可能性としての選択肢としてあっても構わない、\n　　ということだ、\n　　ＣからＤへと移相せんとわれらは──":28,"……保留で……いいんだって……迷うくらいで……丁度……":29,"\n\n\n\n\n──しかしそれはいまさらどうでもいい。":30,"……やっぱそうじゃん……ケースバイケースの……なかで……":31,"\n\n\n\n\n──自身にとって最善を選ぶのが、魔眼質というものの一端だな。":32,"……僕が……何を選ぶと……":33,"\n\n\n\n\n──ただ、雫は、またややこしいしな、我ながら、":34,"……その選択自体が……結果そのものを……":35,"\n\n\n\n\n──●●●●て、":36,"……トーカ……カリヤ……ヤソウ……の……オン…………ナ……？":37,"\n\n\n\n\n──どの":38,"倫であれわれわれは、いくことに、なるさ、だから、":39,"……ひとつに……いや……そうでない選択……が……":40,"\n\n\n\n\n──彼女等にイキてキクことだ。":41,"……あの……ひと……は……":42,"\n\n\n\n\n──あ、このこ、ディ………それともラ……か？肉、クタイ、故の、":43,"……あの……ひと……は……！":44,"\n\n\n\n\n──イトし……否、":45,"厭──アレは、！それよりも、":46,"……あんなでも…………われ……は……ぼく……は……":47,"\n\n\n\n\n──ミカワ故に、アサクともミツにつながりたがるこの、":48,"\n\n\n\n\n──あのひと、\n　　………。[l]\n　　ミルハ、そうだな、":49,"\n\n\n\n　　　二つの選択があると？":50,"\n\n\n\n\n　　　　いや、ちがうよ。":51,"\n\n\n\n　　　設問からして":52,"謬っている場合、":53,"\n\n\n　　選択すべき解答を探して懊悩するなぞ無駄だろう。":54,"\n\n　ああそうだろうさ、":55,"われがアレを信用する訳、無いだろ？":56,"……キライじゃないが、":57,"信用とは別、だよ。":58,"モノゴトを縦割りでカテゴライズして勝手に期待するのは●●だと、\nアレ自身が言ってる事なんだぜ。":59,"アイと、ワイは別モノだからさ。":60,"l●ve、アイかオーか、":61,"アレが視てる者は猫の王……なんだ。":62,"われは、わかってた、そんなことは、":63,"……猫の王？":64,"だから、視ぬフリをし、":65,"……Ｏのしろ？":66,"それでも、ああ、だからか、結局は、":67,"単に●いだけだったな。":68,"……MeMentoMori？":69,"今や彼女は僕等の●──":70,"……おもいだしかけているのにそんな雑念は要らない、":71,"イカリは、視界を狭める、からな。":72,"……ああ、われでないたいおんが、":73,"…クタイをかさね、":74,"よりしろ……きもの……":75,"かりや……":76,"からだ、かさね──":77,"……。":78,"\n\n\n\n\n\n\n（まこと、）":79,"\n\n\n\n\n──波の音がきこえる、":80,"かあさん、":81,"きりあけて、":82,"ぼくはだいじょうぶ、":83,"ちゃんと、":84,"\n\n\n\n\n──信じてなかったから、":85,"そなえて、":86,"\n\n\n\n\n──おいた、":87,"だから、かあさん、あそんでよ、":88,"\n\n\n\n\n──そうだ、":89,"めかくしして、":90,"\n\n\n\n\n──めかくしおにさん、てのなるほうへ。":91,"眼隠鬼サン……":92,"童歌……":93,"うたはまほう……":94,"うた……にした……":95,"\n\n\n\n\n──うた……？":96,"オトのなるほうへ……":97,"\n\n\n　　己を一に、白を二に、":98,"\n\n\n　　小さき音が刀からなる、":99,"\n\n\n　　その日、牛のごとき角しほん、":100,"\n\n\n　　余り１３……":101,"……？":102,"\n\n\n\n\n──………？":103,"……そのこころは？":104,"\n\n\n\n\n──まだか、というか、……あたたかいな。":105,"\n\n\n\n\n\n\n\n（まこと、さん……）":106,"……気が散る……ああ…このあたたかさに……埋もれたい……":107,"\n\n\n\n\n──ついでにさ、":108,"……まぐわうとは……眼を合わすと……カく……":109,"\n\n\n\n\n\n\n\n（ま……ことさぁん……）":110,"\n\n\n\n\n──まだ、なにかわすれているだろ、":111,"……やわらかく……あたたかい……にく……からだ……":112,"\n\n\n\n\n──…ガミのこと、":113,"……なな……は……":114,"\n\n\n\n\n──もう少しだ、もう少しなのに、":115,"\n\n\n\n\n\n\n\n（……ぃ……）":116,"\n\n\n\n\n──自分で設定したパスワードを、忘れてしまう事が、":117,"……あるな……password……アイ……コトバ……":118,"\n\n\n\n\n──掴むまではあとすこし……":119,"…なんだっけ、":120,"\n\n\n\n\n──すべて、":121,"おもい……":122},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_059.ks","relPath":"/data/scenario/SC_M_059.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":117,"length":123,"percent":95.1219512195122},"cellInfo":[]},"/data/scenario/SC_M_060.ks":{"data":[["「……おもい……重い……」","「……回忆……好重……」"],["……重いって。","……真的好重。"],["めがさめると、","当眼睛睁开时，"],["……連日の疲労の為だけではないだろう、[l]\n身体が物凄く重い……[l]\nかなり気怠い気分で、\n二度寝をしたい衝動に襲われながら、\nいや、そういうんじゃなくないか、なんだこの重いのは……[l]\nという疑問、\n布団にしては、いや、\nそもそも此処は何処で、\nああ、車で寝てたんだった、前の日も、","……应该不只是连日疲劳的缘故，[l]\n身体沉重得离谱……[l]\n带着相当倦怠的心情，\n虽然被想要睡回笼觉的冲动侵袭着，\n不对，应该不是这样吧，这种沉重感是怎么回事……[l]\n这样的疑问，\n说是被子也不太对，不对，\n说到底这里是哪里，\n啊对了，是在车里睡着了，前一天也是，"],["……まだ眼が開けられない……","……还是睁不开眼……"],["全く頭が働かん……","完全没法思考……"],["………。",""],["うーーん……身体はあったかいが、[l]\n足先や顔に当たる冷気、\nそして、何だかもしゃもしゃしたものが、\n","唔——……身体倒是暖烘烘的，[l]\n但脚尖和脸上感受到的寒气，\n还有，不知为何毛茸茸的东西，\n"],["擽ったいったらないなぁ……[l]\nこれって……","痒得受不了啊……[l]\n这是……"],["「……カミのケ…………髪の毛？[l]\n","「……头发的触…………头发？[l]\n"],["っっ（っおあくぁぐ！！！）」","唔（呜哇啊啊啊！！！）」"],["大声を出しそうになるのを何とか抑え込みっ、\nって、あ？！なにこれ！！","拼命忍住差点脱口而出的惊叫，\n等等，啊？！这是什么情况！！"],["完全に正面向き合う形で抱き合う形で、\nいや、正確には此奴が一方的に抱き付いてる型であるが、\nうぇ？！[l]\n何で何がどうなってこの形？？！！！","完全正面对峙的拥抱姿势，\n不，准确说是这家伙单方面缠上来的状态，\n诶？！[l]\n为什么怎么会变成这样？？！！！"],["「！！？？」",""],["僕が、下で、奴が、上に、","我在下面，那家伙在上面，"],["いや、うそ、あれ？[l]\nまさか夢……じゃないな、[l]\nなにこの状況？！","不，等等，咦？[l]\n该不会是梦……看来不是，[l]\n这什么状况？！"],["「……えーーーーーーと……っ」","「……呃——————……」"],["はっ！","哈！"],["声を殺したつもりだったが、\n此奴ももぞもぞ動き出す。","本想憋住声音，\n但这家伙也开始蠕动了。"],["僕は全く動けずに、息も止めて身体を硬くしているしかなかった。","我完全动弹不得，只能屏住呼吸全身僵硬。"],["「………」",""],["「………！？」",""],["……幸い、まだ起きるには至らなかったらしく、[l]\n奴はまた寝息を立て始めた……[l]\n……え、幸いなのか？[l]\nど、どう転んでもこれは、\n一悶着、無いわけが、","……幸好，她似乎还没完全醒来，[l]\n又开始发出熟睡的呼吸声……[l]\n……呃，这算幸运吗？[l]\n不、不管怎么看这情况，\n绝对会引发一场骚动，"],["「（……こ、こいつ……おま、[l]\n……なんなんだよこれ……）」","「（……这、这家伙……喂，[l]\n……搞什么啊这是……）」"],["脚も腕も完全に絡んでいて、\n起こさずに、ほ、どけるかこれ……？[l]\nかと言ってこのまま此奴が起きたら、\nどう、なる？！[l]\nや、もちろんこのままでも困るけども、\nこんな、ご、誤解され──","手脚都被完全缠住，\n在不弄醒她的情况下，能、能挣脱吗……？[l]\n话说要是就这样让她醒了，\n会、会怎样？！[l]\n当、当然保持现状也很糟糕，\n但要是被、被误认为——"],["誤解？[l]\n誤解だよな。[l]\n誤解じゃないなんてことは、\nや、逃げようとしてる訳じゃない、\nただ少なくとも記憶は、\n……まあ、僕のそれがアテにならないのは重々承知してるけど、","误会？[l]\n是误会对吧。[l]\n要说不是误会的话，\n不、不是要逃避责任，\n只是至少我的记忆里，\n……嘛，虽然我很清楚自己的记忆靠不住，"],["「（……なんだこれ？！なんだこの状況？！[l]\nもっとなにかこう、","「（……什么情况？！这到底怎么回事？！[l]\n应该还有更合理的解释，"],["深","深"],["刻な感じで僕等、\n……色々、あったんじゃ……いや、[l]\nいいやそれは、と、それよりこれ、\nどうしよう……）」","在这种紧迫的感觉中我们，\n……发生了各种事……不，[l]\n不对那个是，比起那个现在，\n该怎么办……）"],["冷静に考えて、今はど、どうしようもないな……[l]\nいっそ寝直して、\n此奴に先に起きて貰おうか、とも思ったけど、\nこっから二度寝は流石に無理が……[l]\nああああ、ね、寝たふりでいいのか、\n取り敢えず、眼、眼は瞑っとこう。","冷静想想，现在根，根本无计可施……[l]\n干脆重新睡一觉，\n虽然想过让这家伙先起床，\n但这种情况再睡回笼觉实在勉强……[l]\n啊啊啊，装、装睡能行吗，\n总之先闭，闭上眼睛吧。"],["や、まあ、此奴が上で或る意味良かった、\n逆だったらばそれはもう、その前段階がどうこうでなく、\nその時点で弁解の余地なしだったけども、\nと、取り敢えずこの状況は此奴が自発的にせんと成り立たんからな！","不、不过，这家伙在上面某种意义上算好事，\n要是反过来那就真的，连前因后果都不用纠结，\n当场就会变成百口莫辩的状况，\n总之这局面必须是这家伙主动才能成立啊！"],["……一旦落ち着こう。","……先冷静下来。"],["夕べ一緒に寝たのは確かだが……[l]\n寒かったし、\n此奴の寝相の問題だろし、\n恐らくずっとこの体勢だった訳じゃないだろうし、\nそもそも別に、変な事ぁ、","昨晚确实是一起睡的……[l]\n因为太冷了，\n加上这家伙睡相有问题，\n应该不是一直保持这个姿势的，\n说到底本来也没什么，奇怪的事——"],["「……んー……ぅにぃー……」","「……嗯……呜咿……」"],["──しっかと強めにしがみついて来る狩屋。","──狩屋紧紧搂抱过来的力度相当强。"],["そっと眼を開けてみる。","悄悄睁开眼。"],["……まだ起きはしないようだが、[l]\n呼吸の度に何となく覚醒の度合いが強まってる……か？[l]\nそれより、その吸ったり吐いたりの動きが伝わって、\nお前、どうしたらいいんだよ。[l]\n寝相というか、無意識的な行動として、\n此奴って普段抱き枕生活なのかしらん、と思いつつ、\n顔を覗き……いあ、視ないようにしよう……","……看来还没醒，[l]\n但每次呼吸似乎都让清醒程度加深……？[l]\n更重要的是，那呼吸引发的动静传递过来，\n喂，我该怎么办啊。[l]\n说是睡相，更像是无意识行为，\n一边想着这家伙平时该不会抱着抱枕睡觉吧，\n一边偷瞄她的脸……还、还是别看比较好……"],["「……んっ……ん～～～、[l]\n………んーーー……」","「……嗯……嗯～～～，[l]\n………嗯——」"],["「………！！！[l]\n……………、[l]\n…………、[l]\n………？[l]\n……………ふは………」","「……！！！[l]\n……………，[l]\n…………，[l]\n………？[l]\n……………呼哈………"],["別に悪いことをしてる訳じゃないが、\nどうしたって身体は固くなる。[l]\n……呼吸すら止めていた事に気付き、[l]\n僕は静かに、\n顔を逸らせて息を吐いた。","虽然没做什么亏心事，\n身体还是不由自主地僵硬。[l]\n……发现自己连呼吸都屏住了，[l]\n我轻轻\n别过脸呼出一口气。"],["──お前ほんとに、\n起きた時、\n自分で色々処理せえよ。","──你这家伙啊，\n等醒来的时候，\n自己想办法善后吧。"],["僕のせいじゃ無いかんな……たぶん……","应该不是我的错吧……大概……"],["「（……今、何時だ？）」","「（……现在几点了？）」"],["顔を逸らしついでに車の外を視る……が、[l]\n体勢的によくわからない。[l]\nただ、\n外からはどうやら蒼白い……灰色めいた薄明かりが、[l]\n車内に射し込んでいるようだった。[l]\n昼か夜かも判らない……いや、流石に夜ではないか……[l]\nただ、なんだろう、この感じは──","借着转头看向车外……但[l]\n姿势限制看不清楚。[l]\n不过\n外面似乎有苍白的……接近灰色的微光，[l]\n照进了车厢里。[l]\n分不清是白天黑夜……不，应该不是晚上……[l]\n但这种感觉到底是——"],["そうか、雪が降って、\nもう止んではいるようだけれども……","对了，下过雪，\n虽然现在已经停了……"],["まだ、寒いな……","还是好冷……"],["「（ちくしょう……こいつ……あったけえなあもう……）」","「（可恶……这家伙……也太暖和了吧……）」"],["奴が重なってる所は、\nまるで、","被她压住的地方，\n简直像"],["「（……",""],["涎垂らすなよ……）」","别流口水啊……）"],["いや、そうでなく、\nうーーーん……","不，不是这个意思，\n唔————嗯……"],["──冬夏もあのひとも、\n思えばここまでじゃなかったな……[l]\n……姫様ちゃんやきぃが抱き付いてきた事はあれど、[l]\nいや、だからどうだっていうわけではないが、","──冬夏和那个人，\n回想起来本不该走到这地步的……[l]\n……虽然姫様和小贵也曾抱上来过，[l]\n不、所以这也没什么大不了的，"],["まあ、でも此奴も、\n八相のひとり、ネコガミつかうもの……[l]\n僕の、\n本当のカラダがどうとか、その影響なのかな──\n冬夏は昔の事が何か気になってるようだったけど、","不过话说回来这家伙，\n也是八相之一、使用猫神之力的……[l]\n我的、\n真正身体怎样了、是受其影响吗──\n冬夏似乎对过去的事有些在意，"],["……そもそもみんな、[l]\n僕ではなくて、","……说到底大家、[l]\n都不是冲着我、"],["……そういうことなのかな──","……是这么回事吗──"],["そう思うと、急に、","这么一想突然、"],["「……っ……」","「……呜……」"],["なみだが、","泪水、"],["「……にぃ……兄ぃ……[l]\nま……こと……さん……じゃなきゃ……[l]\nだめ………たしは……[l]\nずっと…………しょ……」","「……哥……哥哥……[l]\n不……不是诚……先生的话……[l]\n不行………我……[l]\n一直…………」"],["………？",""],["「……ジシンを……ぁもて……」","「……自……己……」"],["「……起きたか？起きてるのか？」","「……醒了吗？醒着吗？」"],["──寝言だな。","──是说梦话啊。"],["……と、ぎゅーーーっ……と此奴のしがみつく力が強まっていく。[l]\n身体の動きも激しくなり、\nいで、いででで、","……接着、嗯——……这家伙的搂抱力道越来越强。[l]\n身体动作也激烈起来，\n疼疼疼疼、"],["「……ぬーーーーん……[l]\n……っはふっ、[l]\nんーーーー？」","「……嗯——……[l]\n……哈呼、[l]\n嗯——？」"],["今度こそ、お、起きたか？","这次总该、醒、醒了吧？"],["あ、慌てて眼を閉じて寝たふりを──","啊、慌忙闭眼装睡──"],["「………にぃーん……にゃにこれ？[l]\nあー、あー、あー。[l]\nそか、そだった。[l]\nあぅ、兄ぃ、おはようございまふぁー……」","「………喵呜……这是啥？[l]\n啊—、啊—、啊—。[l]\n噢、是这样啊。[l]\n呜喵、哥哥、早上好呀呼啊——……」"],["……まだ眼は完全に開いてないようだが、[l]\nそれでも何だか状況は把握してる模様の狩屋。[l]\nえ、その上でのこのアクションすか？！[l]\nまあ、何もないが故だろうけど！！","……眼睛似乎还没完全睁开、[l]\n但狩屋看起来已经掌握了状况。[l]\n喂、明知如此还来这出？！[l]\n嘛、不过是因为无事发生罢了！！"],["と言うわけで、\n寝たふりはし損ねたものの、\n取り敢えず騒ぎにはならないぽいので、","总之、\n虽然装睡失败了、\n但暂时不会闹出大动静的样子、"],["「……お、おはようございます」","「……早、早上好」"],["と挨拶を返した。","姑且回了问候。"],["しかし体勢は変わらないままで。[l]\n僕の胸の上から顔をみあげる形で、","但姿势依然没变。[l]\n从我胸口抬起脸、"],["「……ないてる？」","「……在哭？」"],["まだ片眼しか開いてないのだけれど、\nその眼でじっと僕を視ながら言った。","虽然只睁开了一只眼、\n却用那只眼直盯着我说。"],["「えあ？[l]\nあ、あー。[l]\nいやあれよ、あ、欠伸の涙だっつの！！！！[l]\nというかお前、え？！」","「诶啊？[l]\n啊、啊—。[l]\n不是那个啦、是打哈欠的眼泪啦！！！！[l]\n话说你啊、哈？！」"],["誤魔化しつつ話題を転換しようと、\n現状について色々苦言を呈そうと思い立つも、\n突っ込むべき所にしても一体、\nどう言えば良い物か、\n結局フリーズするしかない僕を余所に、","边糊弄边试图转移话题、\n正想对现状提出各种抗议、\n但该从哪儿吐槽起、\n到底该怎么说、\n最终只能僵在原地的我身旁、"],["「あーぁそう……[l]\nちっと頭動くまで待って……[l]\nさむい……うぉおーぬくいし……ねたい……」","「啊—这样啊……[l]\n等我脑子转过来……[l]\n好冷……呜哇好暖和……想睡……」"],["顔をぐりぐり擦り付けんな！[l]\n僕ぁ枕じゃないですにょって！！","别用脸蹭来蹭去啊！[l]\n我又不是枕头喵！！"],["てかお前ほんとに状況把握してるか？[l]\n寝惚けてないか？[l]\n誰かと間違ってないか？","话说你真的搞清楚状况了吗？[l]\n该不会还在犯迷糊吧？[l]\n没认错人吗？"],["と、\nまた半開きの眼でこっちを視る狩屋。[l]\n数秒そうしてたから、\n確実に、僕を確認してない訳はないのだけれど、\n狩屋はまた顔を埋めて寝りの体勢に入ったので、","说、\n狩屋又用半睁的眼瞥向这边。[l]\n保持这个状态好几秒，\n按理说不可能没确认是我，\n但狩屋又把脸埋回去摆出睡觉姿势，"],["「や、まて、\n寝なさんなよ、\nもういま何時だと……何時だ？」","「喂、等等、\n别睡啊、\n现在都几点了……到底几点？」"],["と突っ込みつつ自問自答する。","边吐槽边自问自答。"],["此奴も起きた事だし、二度寝させないという意味も込みで、\n遠慮無く身体を動かして──すっかり固くなってたな我が身体、\n携帯電話で時間を確認する。[l]\nそういやアラームもセットしないで寝たんだな。[l]\n莫迦みたいに寝過ごしてる可能性も無くはないな……","既然这家伙也醒了，本着不让他再睡回笼觉的打算，\n我毫不客气地活动身体──才发现自己全身都僵了，\n用手机确认时间。[l]\n说起来我都没设闹钟就睡了。[l]\n搞不好会像傻子一样睡过头……"],["「着信……もメールも無しで、[l]\nえー、\n……昼の零時半だってよお前さん」","「既没来电……也没邮件，[l]\n呃、\n……中午十二点半啊喂」"],["「んにぁー？[l]\nああもういい加減……ぇで呼べぁいいのに……[l]\nんっ、んんんんん～～～～～～、\n……トイレ行ってくる」","「嗯喵～？[l]\n啊真是的……明明叫人家小狩就好……[l]\n唔嗯，嗯嗯嗯嗯～～～～～～，\n……我去趟厕所」"],["よく判らん難癖をつけた後、\n漸く身体を起こし伸びをして、\n奴はそう言った。","在发出莫名其妙的抱怨后，\n总算撑起身体伸了个懒腰，\n那家伙这么说道。"],["「おう、いてらー、\nその服は取り敢えず羽織ってって構わん……」","「哦、慢走、\n至少先把那件外套披上……」"],["「うんありあおう……[l]\nふわあぁ……うんしょ」","「嗯谢啦……[l]\n哈啊～～……嘿咻」"],["立ち上が……と言っても天井低いので腰折だが……ると、[l]\n髪ほどいてたの忘れてた、\n一瞬別人かと思ったこいつ、脅かすなよ。","站起身……虽说天花板太低得弯着腰……之后，[l]\n忘记之前把头发放下来了，\n一瞬间以为是谁呢这家伙，别吓人啊。"],["数回眼を","眨巴了"],["瞬かせて、\n狩屋は危なっかしく車から出て行った。","几下眼睛，\n狩屋摇摇晃晃地爬出车子。"],["ドアを開けた時に入り込んだ、\n外気が今は心地良い。","开门时涌进来的\n室外空气现在格外舒适。"],["それに急に身体が軽くなった所為か、\n何か変な感じだな……","或许因为身体突然变轻了，\n总觉得哪里怪怪的……"],["にしても──","话说回来──"],["夕べは一体なんだったのか、\n奇妙な夢をみてたような気もするけど、\n覚醒と同時に殆ど飛んでしまった。","昨晚到底怎么回事，\n好像做了个奇怪的梦，\n但醒来时几乎全忘光了。"],["「……独りになるとやっぱまだ眠いな眠くなるな……」","「……独处时果然还是犯困啊会犯困啊……」"],["しかし、\n何か忘れてるような気がする──のはいつものことだが、\nそれでも尚、どうも引っ掛かってることが、","可是、\n总觉得忘了什么──虽然经常这样，\n但这次特别耿耿于怀，"],["「……駄目だ、空腹時と眠い時は、[l]\nまともな思考が……いや、寧ろ……」","「……不行，又饿又困的时候，[l]\n根本没法正常思考……不对，应该说……」"],["──浅い階層は不活性になり、より本義的な回路が、","──浅层思维会停滞，更本质的回路"],["つまり人情とか思いやりとか気を遣うとかそういった、","比如人情味啊体贴啊顾虑啊这类东西"],["──優先順位が通常と異なり、より本能的に、","──优先级会和平时不同，更趋于本能"],["だから、そういう時に人と話すと、ずけずけと、","所以这种时候和人说话会口无遮拦地"],["──エゴが丸出しになるから、","──暴露出自私的本性"],["コミュニケーションするには最も不向きなコンディションであって、\nだから僕は、","是最不适合沟通的状态\n所以我才"],["「……だからもう今脳が空転しっぱなしなんだって……」","「……所以说现在脑子根本转不动啦……」"],["いかん、\n──外に出るか。[l]\n風に当たってシャッキリすべえ。[l]\nトイレは……別にしたくはないけど、[l]\n顔くらいは洗いたい。[l]\n彼奴が来るまでは戸締まりが気になるので、\n車を離れられないが。[l]\n締め出しとくとまた文句言われそうだし……","不行、\n──得出去透口气。[l]\n让风吹醒脑子才行。[l]\n厕所……倒不是非上不可、[l]\n但至少想洗把脸。[l]\n在那家伙到来前得注意锁门、\n所以没法离开车子。[l]\n要是锁在外面肯定又要被唠叨……"],["「すっかり晴れたな……」","「完全放晴了呢……」"],["正確に言うなら、\n雪は止んでいたけれど、\n空の半分程はまだ銀色のままだ。","准确来说，\n雪虽然停了，\n但天空还有一半左右仍是银色的。"],["肌に感じる空気は、\n流石に未だ寒い──寒いと言っても相対的な話で、\n雪は既に、\n日陰には多少積もったまま溶け残ってはいたものの、\n殆どはその姿を消して、雨上がりのように、\n辺りに水溜まりとしてその残骸を残すのみ。","肌肤感受到的空气，\n果然还是冷——虽说冷也是相对而言，\n雪已经，\n虽说背阴处还残留着些许未融化的积雪，\n但大部分都已消失不见，如同雨过天晴般，\n只在周围留下水洼作为其残骸。"],["どうやら僕等が寝てる間に、\n気温も一般的なこの時期の範疇まで、\n──この北の地ではそれでも肌寒かったけど、\n戻ったということか。[l]\nというか昨日が特別過ぎたんだけど……","看来在我们睡觉的时候，\n气温也回到了\n——在这北方之地依然凉飕飕的\n这个季节的正常范围吧。[l]\n或者说昨天实在太反常了……"],["「さむい、ねむい、はらへった、\nだるい、つらい、きつい、えーーーーーと、\nなんだっけな、\nなにをしなくちゃいけないんだったか、\n………、[l]\n………？[l]\nああ、……しんどいな……」","「好冷、好困、肚子饿、\n乏力、难受、痛苦、呃——————、\n想说什么来着、\n必须做什么事情来着、\n………、[l]\n………？[l]\n啊啊、……累死了……」"],["僕の頭の中は今何やら真っ二つになっているようで、\nまさにこの空の感じだな、と薄ぼんやりと思っていた。[l]\n恐らくは外気と体温の間に出来た急な温度差による、\n錯覚のようなものなんだろうが、\n──そう、だからすぐに、\n治まるだろう。","我的脑子现在好像被劈成了两半、\n迷迷糊糊想着简直和这片天空的感觉一模一样。[l]\n大概是外界的冷空气和体温之间形成的急剧温差、\n导致的某种错觉吧、\n──没错、所以很快、\n就会平复的。"],["なんだろう、何というかまるで、\n風邪薬でも飲んだ後のような、\n……あれだな、落ち着くまでは車の運転しない方がいいな。[l]\n……そんな余裕が──[l]\n──ここでじっとしてるだけという、\n選択の余地があればだが……","怎么回事呢、该怎么说就像、\n吃了感冒药之后的那种、\n……就是啊、在平静下来之前最好别开车。[l]\n……这种余裕──[l]\n──如果能选择就这样、\n一动不动待着的话……"],["「でも何故か……妙な安定を何処かで……[l]\n感じてるのはなんでだ……？」","「但为什么……会在某处感受到、[l]\n诡异的安定感呢……？」"],["腹が据わったとか、\n自暴自棄……捨て鉢の境地に至った感じとも違う、[l]\n──絶対的な●●●。","肚子已经定下来了之类的，\n和自暴自弃……破罐子破摔的感觉也不同，[l]\n──绝对的●●●。"],["恐怖も不安も、生命活動を脅かすものへの感情ではあるが、\n僕等は要するに未知に恐怖するんだ。[l]\nワカラナイものが怖いんだ。[l]\nレスが無いのが厭なのも、\n待つのがつらいのも、\n或る意味でその一環なのかも知れないな。","恐惧也好不安也罢，虽然都是对威胁生命活动的情绪，\n说到底我们害怕的是未知。[l]\n害怕的是搞不懂的东西。[l]\n讨厌没有回复，\n等待很煎熬，\n某种意义上或许也是其中一环吧。"],["逆に言えば、","反过来说，"],["「ただいもー……[l]\n完全に昼だよにぇー……[l]\nこんなに寝たの久しぶりにゃもおわっ」","「我肥来啦……[l]\n完全是大白天了捏……[l]\n好久没睡这么久了喵呜哇」"],["びゅおぅ、と強めの海風が吹いた。[l]\n……海風と断じて良いかはあれだけど、[l]\nそれはまだ結ってない奴の髪を","「咻呜」地刮来一阵强劲的海风。[l]\n……虽然断言这是海风可能有点那啥，[l]\n它吹散了那个还没扎头发的家伙的"],["靡かせて、\n同時に僕の、","发丝，\n同时把"],["「うっわあんだこれ」","「呜哇什么鬼」"],["僕の眼にゴミをいでででで。","我的眼睛里吹进了沙沙沙沙沙。"],["「あによ大丈夫？[l]\nあ、はいこれありーでした」","「哥你没事吧？[l]\n啊、嗯这个给你饭」"],["「いっでで、ああ、どうも……」","「呜哇哇、啊啊、谢谢……」"],["奴の差し出した上着を受け取った時点で、\n何の思考をしていたか……なんだっけな。","接过那家伙递来的外套时，\n当时在想什么来着……完全忘了。"],["それにしても、\n相変わらずというかそういうもんなのか、\nこっちが肩肘張りすぎてるだけなのか、\n例によって拍子抜けというか何というか、\n慌てたりなんだり、\n自意識過剰に思い悩んで対応に苦慮して右往左往、\n","不过话说回来，\n该说是老样子还是本就如此，\n或者只是我自己太紧张了，\n像往常一样泄了气或者说不上来，\n慌慌张张的，\n过度自我意识导致应对时手忙脚乱，\n"],["──するのはいつも♂なんだ。[l]\n","──每次都是♂这样。[l]\n"],["ま、此奴とは事実何もありゃしない、し、\n別に良いんだけどさあ、\nどの距離感が『普通』なのか、僕には、","嘛、和这家伙确实啥也没发生、也、\n没什么大不了的啦，\n但对我来说、到底哪种距离感才算『正常』，"],["「ごはんどうしよう？[l]\n視てきたけど、平日だしすっかすかだったよそこ」","「午饭咋整？[l]\n刚去看了、工作日空荡荡的」"],["……奴の声で、僕の愚考はあっさりとシフトを許す。[l]\nコンディション云々以前に、\nまあ僕ぁそういう奴だわな、流され流され生きてるんだな……[l]\nいや、だからといってここでわざわざネガティヴに陥るのもきついから、\n慌てて眼の前の問題に集中する、ことにする。","……他的声音让我轻易中断了胡思乱想。[l]\n在考虑状态之前，\n反正我就是这种人啦、随波逐流地活着……[l]\n不、但特地为此陷入负面情绪也很累，\n我决定先集中解决眼前问题。"],["「──ん？[l]\nあ、あー、飯なぁ、どうすべえかなあ……[l]\n──すっかすか？[l]\n昼時にゃのにか？」","「──嗯？[l]\n啊、呃ー、吃饭啊、该咋办呢……[l]\n──空荡荡？[l]\n大中午的？」"],["「昼時にゃのによ」","「大中午的哟」"],["「空いてるなら好都合じゃないん……ああ、[l]\n","「有空位不是正好嘛……啊、[l]\n"],["人","人"],["気がないかもか」","可能没食欲吧」"],["「オフィス街でも学生街でもにゃいし、\n量も品数もその、\n殆どファストフード店レベルだったし、\n人気がどうとか言う前に食事処の選択肢としては」","「既不是商务区也不是学生区，\n菜量和种类都、\n基本是快餐店水准，\n在讨论人气之前作为用餐选择就……」"],["「あーん、そもそも比較にならんかつまり。[l]\n激烈に美味い何かがあれば別として、\nってそれは望むべくもないわな……[l]\n要するに客の多寡は判断材料にならない訳だろ、\nまあ、すぐ喰えるという意味では少ない方が──」","「啊ーn、根本没法比嘛。[l]\n除非有特别惊艳的美食，\n不过那也不现实……[l]\n总之客流量不能作为判断标准吧，\n嘛、能快速吃上倒是人少更好──」"],["「強いて言えば海産物絡みが多いのと、\n謎のおすすめすいーつがあっちのコーナーに……」","「硬要说的话海鲜类比较多，\n还有谜之推荐甜点在那边角落……」"],["此奴もまだ寝惚けてるのか、\nどの内容に対してのレスなんだかその発言、\n少々ズレてる気がするが。[l]\n取り敢えず此処で会話の精密さをどうこうしても詮無いので、\n整合性を失わない程度の返しで応じる。","这家伙也没睡醒吧，\n这番发言对应的是哪段内容，\n感觉有点跑题。[l]\n总之现在纠结对话精准度也没用，\n我尽量用不破坏连贯性的方式回应。"],["「あー、海産は魚以外はちっと駄目だなあ……[l]\nてかお前はどうしたいよ」","「啊ー、海鲜除了鱼类都不太行……[l]\n话说你想吃啥」"],["「ういはにゃんでもおけーにぇす」","「咱啥都行喵」"],["「……どっか移動するか？」","「……要换地方吗？」"],["「にゃんでもー」","「都行喵ー」"],["「や、お前がいいんなら僕はそこで構わんのだよ、\n一応気を遣ってだな……」","「不、你ok的话我无所谓，\n只是客气下……」"],["「……あんま今ものごと考えたくにゃいから」","「……现在不太想动脑喵」"],["「……そら僕だって一緒だっつの。[l]\nじゃーそこにすんぜ」","「……我也一样啦。[l]\n那就这儿吧」"],["「らにゃー」","「好喵ー」"],["準備やら、僕の用足しを済ませると、\n僕等は二人して其処に向かう──","准备好东西、办完我的事后，\n我们俩朝那里走去──"],["……ほんとに僕等、一体何してるんだろうか。","……我们到底在干嘛啊。"],["という疑問というか、\nこれでいいのか？という、[l]\n反省……というか、焦りのようなものは常に頭にある。[l]\nそれは、例の妙な安定と、奇妙に両立して心にある、\nしかし、いや、だからか、","这种疑问或者说，\n这样真的好吗？的[l]\n反省……或者说焦虑一直萦绕心头。[l]\n它与那种诡异的安定感奇妙共存着，\n但是、不、或许正因如此，"],["それでも、","即便如此，"],["今日はどうする？[l]\nこれからどうする？","今天要怎么办？[l]\n接下来要怎么办？"],["とは、何故か問えない。","为何、却问不出口。"],["それこそ気を遣っての──\nいや、僕自身が、\n今独りにされるのを、","那才叫多管闲事──\n不、是我自己、\n现在害怕被独自、"],["恐れているのか……もしれないが……","抛下吧……或许……"],["………。[l]\n独りは……、[l]\n………。","………。[l]\n独自一人……、[l]\n………。"],["──問題には直面しなければ、","──不直面问题的话、"],["わかってはいるけれど、","虽然心里明白、"],["──今は未だ、","──但现在仍然、"],["いかんいかんいかん、\nだから腹減りは駄目だって、\n思考の制御がきかなくなって一旦転がり出すと、\nまるでボーリングのた──","不行不行不行、\n所以说肚子饿就是不行啊、\n一旦思维失控开始翻滚、\n简直像保龄球似──"],["「兄ぃ、兄ぃてば、\nまた放心してますかー」","「老哥、老哥喂、\n又在发呆吗ー」"],["「……すまん、[l]\nはらがへりすーぎたー」","「……抱歉、[l]\n肚子饿ー过头ー了ー」"],["「……ふらふらふらふら危なっかしいつーか、[l]\n気が気でないったらにゃいよもう、\nほれいくよばかっ」","「……摇摇晃晃晃晃悠悠危险得要命、[l]\n看得我心惊肉跳真是的、\n喏走啦笨蛋」"],["「いっで、わ、わかったひとりで歩けっからっ」","「呜哇、知、知道了能自己走啦」"],["腕を引かれて道の駅の食堂エリア的なとこに入ると、\n狩屋の表現通り、\n田舎大型スーパーの中にあるファストフード店的な","被拽着手臂走进道之驿的食堂区域时、\n正如狩屋描述的那样、\n像是乡下大型超市里的快餐店般的"],["佇まい。[l]\nラーメンカレーたこ焼き鯛焼きソフトクリーム等々的な。","氛围。[l]\n拉面咖喱章鱼烧鲷鱼烧冰淇淋等等之类的。"],["みかねた狩屋が注文その他手続きをするというので、\n少しでも飯っぽいものと思って叉焼麺を、と伝える。","看不下去的狩屋说要负责点单和其他手续、\n我便说要叉烧面权当稍微像样的食物。"],["そしてぼーっと外を視ていた。[l]\nおもい、だるい、つらいきついしんどいねむいさむい、\nそういったネガティヴな感情……というか感想が、[l]\n混淆としてぐるぐるぐるぐる止めどなく思考の中を回る。","然后呆呆望着窗外。[l]\n沉重、倦怠、痛苦难受疲惫困倦乏味、\n这些负面情绪……或者说感想、[l]\n混杂着咕噜咕噜咕噜不停在脑海里打转。"],["はらがへった、\nはらが、\nくい、くいものくいてえ。","肚子饿了、\n肚子、\n吃、想吃东西想吃。"],["……やばい、そんなに喰ってないつもりじゃなかったけど、[l]\n連日の無理が祟ってるのか、\nどうも、あたまんなかがわやくちゃに……","……糟了、本来没觉得吃得那么少、[l]\n可能是连日勉强自己的报应、\n总觉得、脑子里乱七八糟……"],["「ほい、水」","「喏、水」"],["「ああ、さんくす」","「啊，三克油」"],["奴はどうやら塩ラーメンらしかった。","她那份似乎是盐味拉面。"],["こっちに来た時食べに行った、\nあのラーメン屋に比べるのは酷というものだが、\n……まあ、[l]\n空腹も手伝ってか、\n数分後には特に不足不満もなく食し終える。","虽然拿来和刚来时去过的那家\n拉面店比较有点过分、\n……不过、[l]\n或许因为空腹感加成、\n几分钟后便吃得干干净净毫无怨言。"],["無言というでもなく、\n他愛もない会話を交えつつ、\n……矢張り肝心なところには何も触れず、[l]\n──人前ということもあって、\nこうして僕等は遅い朝食を摂った。","倒也不是全程沉默、\n穿插着些无聊的对话、\n……果然关键部分只字未提、[l]\n──或许因为有人在场的缘故、\n我们就这样吃了顿迟来的早餐。"],["が、矢張り腹が相当空いてたのだか、\n安かったのもあってたこ焼きを２人で分ける前提で、\n追加で頼んでみる。[l]\n奴も夕べはああ言ってたが、\n昼過ぎたとは言え就寝前じゃなし、\nこれから活動帯だしそんなに問題じゃないだろう。","不过果然因为饿得厉害、\n加上价格便宜就以两人分食为前提、\n又追加点了章鱼烧。[l]\n虽说她昨晚那么说了、\n但毕竟不是临睡前而是午后、\n接下来是活动时间应该问题不大。"],["鯛焼きも捨て","鲷鱼烧也舍不得"],["難かったけど、\n","扔掉、\n"],["件のお勧めスイーツ……要するに、[l]\nご当地果物入りソフトクリームだったが、\nそっちも喰おうぜと決めていたので今回はスルーした。[l]\n奴もこっちはすんなりＯＫだった。[l]\nまあ、甘いものは別腹……特に女子は本当に胃が拡張するとかしないとか、[l]\nだし、\n実際問題、\n甘いもの、糖分を脳に補給しておきたかったのだろう、\n僕等二人ともが。[l]\n思考するにも精神的に諸問題を乗り切るにも、\nまずは身体が大事、つまりは食が重要だった。[l]\n特に今はそう思う。[l]\n空腹自体が、何も無くとも鬱を呼び込むことだってある……","那件推荐的甜点……说白了，[l]\n就是加了当地水果的软冰淇淋，\n不过这次决定先吃别的就跳过了。[l]\n那家伙也爽快地同意了。[l]\n反正甜食是另一个胃……尤其是女生好像真的会胃扩张什么的，[l]\n而且，\n实际问题在于，\n我们俩都想给大脑补充糖分吧，\n毕竟。[l]\n无论是思考还是克服精神上的各种问题，\n身体才是本钱，说白了就是吃最重要。[l]\n特别是现在更这么觉得。[l]\n空腹本身就算没事也可能招致抑郁……"],["再び負の思考に囚われそうになるのを振り切って、\n奴に爪楊枝を渡した。","我甩开即将陷入负面思维的念头，\n把牙签递给他。"],["「ほれ」","「喏」"],["「ありー」","「谢啦」"],["爪楊枝はちっさいので指が触れあうが、\nもうそういうのはどうでもいい。[l]\n奴も格別なにも反応ないし。[l]\n僕も格別思うことはない。","因为牙签太短手指碰到了，\n但这种事已经无所谓了。[l]\n他也没什么特别反应。[l]\n我也没特别在意。"],["ド正面に向かい合い、\n紙皿１０個入りのたこ焼きをつつく。[l]\n揚げパン系駄目でもこれは良いんだな……[l]\nわからんでもないけど……って、","我们正对着面，\n戳着装在十连纸盒里的章鱼烧。[l]\n油炸面包不行但这个倒可以……[l]\n也不是不能理解……等等，"],["……ド正面？[l]\nいや、それは最前からずっとそうなんだが、\nそういやお前、\n昨日の『視るな』っていうのはどうした？[l]\n割とずっと視合ってるんだが……","……正对面？[l]\n不，从最开始就一直这样，\n话说你，\n昨天说的『别看』是怎么回事？[l]\n明明一直互相看着啊……"],["「んー？」","「嗯——？」"],["「……いや、……あ？」","「……没，……啊？」"],["「なに」","「干嘛」"],["「……や、にゃんでも……」","「……呀，没啥……」"],["本人がどうもないなら敢えて突っ込む事もないか……","既然本人觉得没事那也不用深究吧……"],["「んー、……」","「唔——……」"],["「どうした」","「怎么了」"],["「なんか、ういも吹っ切れたというか、\nワかったっていうか、\nまーそのあれよ、\nいいじゃんべつに」","「怎么说呢，感觉豁然开朗了，\n或者说想通了，\n嘛就是那个啦，\n无所谓啦」"],["「……僕は何も言ってないけどまー、[l]\nお前が良いと思うならそれはそれで、\n良いんじゃないか……[l]\nどっちにしてもその、\n良かった……な、[l]\nで、いいのか？」","「……我什么都没说不过嘛，[l]\n你觉得好的话那也行，\n挺好的不是吗……[l]\n反正那个，\n太好了……吧，[l]\n这样就行？」"],["「うん、夕べでいろいろ、感じられたから……[l]\nありがと」","「嗯，昨晚感受到很多……[l]\n谢啦」"],["「……まあ、[l]\nよくわからんけど……そりゃあ何より」","「……嘛，[l]\n虽然不太明白……总之再好不过」"],["……んっ？","……嗯？"],["「……んあ？」","「……啊咧？」"],["「……いや、え？[l]\n……ってお前、もう自分の分喰い終わりかい」","「……没，咦？[l]\n……喂你已经吃完自己那份了？」"],["「兄ぃがぼーとして遅いんにゃってば、\n何かやたらと動き止めるし、\nや、いーけどさ、\nアイスまでの腹ごなし時間になるからういは。[l]\nゆっくりどうぞ」","「因为大哥发愣太慢了喵，\n动不动就停下动作，\n嘛，饭倒是无所谓，\n正好当吃冰淇淋前的消食时间啦。[l]\n您慢慢吃」"],["「……そんなに停止してたか、いかんいかん、[l]\nいかんなあ……」","「……我停顿了那么久吗，不行不行，[l]\n真不行啊……」"],["「いーからゆっくり喰いなって」","「饭就慢慢吃啦」"],["「……ああ、まあ、[l]\n適当に喰うよ……」","「……啊啊，嘛，[l]\n随便吃点吧……」"],["気のせいか、考え過ぎか、\nそれこそ自意識過剰なのか、\nどうも夕べ……否、起きてからか、","是错觉吗，还是想太多，\n或者说根本就是自我意识过剩，\n总觉得昨晚……不对，起床之后，"],["……なんかいつもと違うくないか？[l]\n寝起きだからか？[l]\nいかにこんな感じの仲とは言え、\n出会って間もない奴の事をどうこう言うのもあれだし、\n諸事情というか状況を鑑みて、\n普段とは違っていたって当然と言えば当然なんだが、\nなんというか、\n修学旅行中の朝の、\n同級生の生活面を知った時のような気まずい違和感、\nいや、それともちょっと違うな……","……是不是和平时不太一样？[l]\n因为是刚睡醒吗？[l]\n虽说我们确实是这种关系，\n对刚认识不久的家伙指手画脚也不太合适，\n考虑到各种原因或者说状况，\n和平时不同也是理所当然的，\n但该怎么说呢，\n就像修学旅行早上，\n了解到同学生活习惯时那种尴尬的违和感，\n不，可能又有点不一样……"],["何か、\nどこがどうというか、\nほんとに印象というか、感じた事だが、","总觉得，\n具体也说不上来，\n纯粹是印象或者说感觉吧，"],["──姫様ちゃんの感じが、","──姫様的感觉，"],["「にぇ、……うい、ちゃんと慰められた？[l]\n兄ぃを」","「诶，……那个，好好安慰过了？[l]\n哥哥」"],["と、唐突に奴が言った。[l]\n視線はこちらを直視して、いる。","那家伙突然这么说道。[l]\n视线正直勾勾地盯着这边。"],["「あ、ああ、そうだ……な……」","「啊，啊啊，是啊……呢……」"],["──少なくとも、１日、遣り過ごさせて呉れたという意味で、\n慰めになったのは確かだ、と思う。[l]\nただ、はっきりうんそうです、と言うのも妙な具合だし、\nかといって否定するのもおかしいので、\n曖昧に頷いていると、","──至少让我熬过了一天这点，\n确实算是被安慰到了，我想。[l]\n不过，直接说\"是的\"也很奇怪，\n但否定的话也不对劲，\n正含糊地点头时，"],["「貸し、ぷらす」","「欠债，plus」"],["「……はっ？[l]\nおま、\nお互い様じゃないのか今回は」","「……哈？[l]\n你这，\n这次不是互相帮忙吗」"],["「あはーん」","「啊哈ー」"],["「誤魔化すな……まあ、いいや、[l]\n引っ張るネタでもないし。[l]\nあぐんぐ」","「别糊弄……算了，无所谓，[l]\n也不是什么值得纠缠的事。[l]\n啊呜咕」"],["矢張り様子が変というか、\nよくわからんテンションだったので、\nスルーして残りを平らげた。","果然状态很怪，\n总之是种难以形容的氛围，\n我便无视着吃完了剩下的。"],["奴が言ったので、\n一旦海を視に砂浜に出て腹ごなししてから、\n車に帰りしなにソフトを買う事になった。","因为那家伙说了，\n我们决定先去沙滩看海消食，\n回车上时再买冰淇淋。"],["砂浜は雪の名残など皆無で、[l]\nあのときと同じように、","沙滩上早已没有雪的痕迹，[l]\n和那时候一样，"],["……否応無しに、[l]\n冬夏と来たときを想い出す。[l]\n別に悪い事をしてるわけでもないだろうに、\n何故か","……不由自主地，[l]\n想起和冬夏一起来的情形。[l]\n明明也没做什么坏事，\n却莫名"],["背","背"],["徳い気持ちに包まれる。","被罪恶感包围。"],["それが冬夏に対してのなのか、\n此奴に対してのなのか、\n──それとも、","不知是对冬夏，\n还是对这家伙，\n──亦或是，"],["……否、気のせいだと思う。","……不，应该是错觉吧。"],["「……おーい」","「……喂」"],["「まさか水に入ったりはしないよな？」","「你不会要下水吧？」"],["「ぉあ゛っ？！[l]\n","「呜哇？！[l]\n"],["するわけにゃいじゃん？！[l]\nするわけにゃいじゃん！！[l]\n","怎么可能下啊？！[l]\n怎么可能下啊！！[l]\n"],["ばっかじゃにゃいの？！」","你傻吗？！」"],["にゃんで２度言うかはさておき、\nお前もそうやって","暂且不论为什么要说两遍，\n你也这样"],["然も当然のように言うが、\n前例を知ってるからさ……","说得理所当然，\n但可是有前车之鉴啊……"],["「まー、[l]\nお前さんはなんつーか、[l]\n常識人だよな……[l]\nいや、良い意味でよ」","「嘛—[l]\n你这家伙该怎么说呢[l]\n是个常识人吧……[l]\n不 是褒义的意思啦」"],["色んな意味でわかりやす……いや、[l]\n他が分かり難いだけで、\nあくまで相対的にという意味だが、\nそれでも、[l]\n他人を気に掛ける事が出来るのは、[l]\n……そういうとまるで他が自己中のようだけども、[l]\n","从各种意义上都很好懂……不对[l]\n只是其他人太难懂了\n说到底只是相对而言的意思\n即便如此[l]\n能关心他人这件事[l]\n……这么说好像其他人都是自我中心似的[l]\n"],["──あながち否定出来ないのも確かだしなあ。","──不过确实没法完全否定呢"],["……はっ？","……哈？"],["「っさいなぁ、[l]\nちっと元気になったと思ったら減らず口ばっか、[l]\n","「烦死了[l]\n刚觉得你稍微精神点就满嘴废话[l]\n"],["ばぁーか、ばか兄ぃ」","笨——蛋 笨蛋老哥」"],["「いや、褒めてんだよまじで、\n……普通が良いよ普通が、[l]\n可もなく不可もなし、\nああいやその、お前をばかにしてんじゃないぜ、\n僕はその、そうやって、普通に、波風なく、[l]\n静かに暮らしたい、[l]\nんだよ……」","「没 我认真的在夸你\n……普通就很好 普通最棒[l]\n无可无不可\n啊不是 那个 不是在贬低你啦\n我是说 那个 就想这样 普普通通 不起波澜地[l]\n安静过日子[l]\n就行……」"],["「……じじくさいのう」","「……老头子似的」"],["しかし、本心でもある。","但这也是真心话"],["起伏のない毎日でもいい、[l]\n大きく昇る喜びがあっても、[l]\nそこから大きく沈むのは、[l]\nもう疲れる、[l]\nそれよりはいい……","平淡的日常也不错[l]\n就算有冲上云霄的喜悦[l]\n随之而来的坠落感[l]\n实在太累人了[l]\n相比之下现在更好……"],["道具さんのような生き方は、[l]\n僕には向いてない。[l]\n起こる出来事をゲームのイベントよろしく愉しむなんて、[l]\n僕には","像道具小姐那样的活法[l]\n不适合我[l]\n把发生的事当成游戏事件来享受什么的[l]\n对我来说"],["瑣","琐"],["事ですら一個一個が重い現実で、","每件事都是沉重的现实"],["──相手方にいちいち感情移入してしまう傾向もあり、","──而且容易对每个对象都产生共情"],["受け流すのも下手なのに、","又不擅长敷衍了事"],["──敵をしっかりと敵と認定する場面もあるから、","──有些场合还必须明确认定对方是敌人"],["とても、そんなことは、","所以绝对"],["──そのために強くなること。","──为此必须变强"],["それに、","而且，"],["──解決にはときに、[l]\n\n\n──根源の消去が必要に、","──有时候解决问题[l]\n\n\n──需要消除根源"],["……こわい、[l]\nいや、ちがうのか、","……好可怕[l]\n不 或许不对"],["──気弱になってるのか、[l]\n\n\n──その逆か、","──是我变得懦弱了吗[l]\n\n\n──还是恰恰相反"],["いずれこの世界にいる以上、覚悟と、行動は、[l]\nしかしそれでも、","既然活在这个世界 觉悟和行动[l]\n但即便如此"],["……兎に角、静かにありたい、[l]\n今はこころからそう思う。","……总之 想要平静生活[l]\n现在打从心底这么想"],["「じじいで結構……[l]\n子供のままで全う出来る渡世ならまだしも、[l]\nいつまでも餓鬼で居られないなら、[l]\nとっとと隠居して暮らせればって、[l]\nそう思うことぁある、のは事実さ、[l]\nいーんだよ僕は、どうせアナクロじゃし」","「老头子也无所谓……[l]\n要是能永远保持童真过完一生倒也罢[l]\n既然没法永远当个小鬼[l]\n不如早点隐居过日子[l]\n偶尔会这么想 这是事实[l]\n没关系啦我 反正已经落伍了」"],["──実際あれらは、それ以外の期間を引き延ばす為の、","──实际上那些都是为了延长其他阶段"],["……そんなのは、僕には、合わない……","……那种方式 不适合我……"],["「ま、わっかるっけどおー。[l]\nその気持ちも。[l]\nういだってさ、\n別に、あに……っと、[l]\n","「嘛 我懂啦—[l]\n这种心情[l]\n其实我也\n并不是 哥……那个[l]\n"],["あ、[l]ごめ、電話」","啊 [l]抱歉 电话」"],["「ん、あ、ああいいよ」","「嗯 啊 啊啊没事」"],["着信は聞こえてたので頷き、通話を促す。","听到来电铃声后点头示意对方接听"],["相変わらず僕の言を聞いていたのかいないのか、\nレスポンス的に、\n殆どの部分をすっ飛ばされた感は否めないが、","还是一如既往不知道有没有在听我说话，\n从回应来看，\n感觉大部分内容都被跳过了，"],["……僕は何となく奴から離れて、[l]\n会話が耳に入らないようにした。","……我下意识地和那家伙拉开距离，[l]\n让对话传不进耳朵。"],["数分とかからず奴の通話は終わり、\n僕の近くまで寄ってきた奴が言う。","没过几分钟那家伙就结束了通话，\n凑到我身边开口说道。"],["「トモさんからだった。[l]\nきーちゃが、\n取り合えずその、\n落ち着いたみたい。[l]\n……うん」","「是阿智打来的。[l]\n小姬她，\n总之那个，\n好像冷静下来了。[l]\n……嗯」"],["「そうか、良かったな……[l]\nあ、\nと──」","「这样啊，太好了……[l]\n啊，\n话说──」"],["……うか、冬夏の、","……不对，冬夏的，"],["いや、言わないってことは、\n今の電話では特に何も、言われなかったんだろう。","不，既然没说出口，\n刚才的电话里应该没提到什么特别的事吧。"],["そういえば姫様ちゃんの調子も、\n今までどうだったのかをあまり、\n具体的には聞かされてなかったけれど、\n何かやっぱりあったって事なんだろう、","说起来姫様的情况，\n之前具体怎么样，\n虽然没详细被告知，\n但果然还是发生了什么吧，"],["とは言え、取り敢えずは──落ち着いたって事なら、\n……そうか、つまり、此奴も此処に居る理由が、[l]\nなくなったって事だな、\nいや、\nいいこと、なんだけれど、\n──●●●●●ない。[l]\n………だめだ、だめだだめだ、[l]\nなんだその思考は……","不过既然说暂时──冷静下来了，\n……这样啊，也就是说这家伙留在这里的理由，[l]\n也不存在了，\n不，\n虽然是好事，\n──●●●●●不行。[l]\n………不行，不行不行不行，[l]\n这算什么想法啊……"],["独り頭の中で仕切り直して、\n狩屋に訊いた。","独自在脑海里重整思绪后，\n我问狩屋。"],["「ああ、まあ、\nで、\nどうすんだ。[l]\n帰るのか？」","「啊，那个，\n然后，\n怎么办。[l]\n要回去吗？」"],["「トモさんは、\nまだ構わないって言ったけど、[l]\n","「阿智说，\n暂时不用管他，[l]\n"],["……もう、戻るね、[l]\n流石に３日以上はその、着替えも無いし、その、[l]\n","……还是回去吧，[l]\n毕竟都超过三天没换衣服了，那个，[l]\n"],["色々多方面で問題が、あはは……[l]\n","各方面都有问题呢，啊哈哈……[l]\n"],["あーまー、[l]\n","啊—嘛—，[l]\n"],["きーちゃの様子、みときたいし」","也想看看小姬的情况」"],["「そうか、や、止める気は無いし……[l]\n別に気にせんでいい……[l]\n……ああ、いろいろありがとうな。[l]\n結局こっちは何も出来なかった気がするけど……[l]\nあ、\nアイスどうする？」","「这样啊，那个，我也没打算拦你……[l]\n不用在意我这边……[l]\n……啊，总之多谢了。[l]\n虽然感觉这边什么都没帮上忙……[l]\n啊，\n冰淇淋怎么办？」"],["「あー………、[l]\nどしよう」","「啊—………，[l]\n咋整呢」"],["何故かそこで、\n小首を傾げ僕を凝視した後、","不知为何这时，\n她歪着头凝视我片刻后，"],["「それくらいはいけるよ。[l]\nてかここで拒否ったら、\n兄ぃへこみそうにゃし」","「这点程度没问题啦。[l]\n不如说要是现在拒绝，\n老哥会超受打击喵」"],["……まあ、[l]\n予定というモノは、\n立てた以上中止されるとへこむのは確かだが、\nお前にまで憐れまれるとこう、\n相乗効果で余計にあれだぞ。","……嘛，[l]\n计划这种东西，\n既然制定了被取消确实会让人沮丧，\n但连你都要同情的话，\n叠加效果会让人更难受啊。"],["「まあ、\nちょっとは心に余力が出来たし……[l]\n何より兄ぃにも元気になってもらわにゃー」","「不过，\n心里稍微有余裕了……[l]\n最重要的是老哥也要打起精神来喵」"],["「おめーに高々アイス食同伴されたってな……」","「就算陪你这家伙吃个冰淇淋又怎样……」"],["「え、………。[l]\n","「诶、………。[l]\n"],["ばっ、[l]\n兄ぃわばかか！！！」","笨、[l]\n哥哥是笨蛋！！！」"],["「は？[l]\nいや、お前、いだだだだ」","「哈？[l]\n不、你这家伙、疼疼疼疼」"],["それはそれ以上だったら元気になるって意味、","那意思是超过那个程度就会打起精神来，"],["[l]\n[l]\n……じゃねえよ！[l]\nえろい方向に深読んで俺を殴打すな！！","[l]\n[l]\n……才不是啦！[l]\n别往色情方向过度解读还殴打我！！"],["「……我慢しろばか、[l]\n","「……忍着点笨蛋，[l]\n"],["じゃーいこうにぇー」","那就出发喵～」"],["「我慢の意味がわかんねえけどな……[l]\nっとによう……」","「完全不懂忍是啥意思……[l]\n总之先……」"],["釈然としないまま、\nしかし、\nありふれたこの感じに安堵しながら、\n──そしてこの後来るであろう揺り戻しに、\nやはり何処かで","虽然仍有些想不通，\n但是，\n对这司空见惯的感觉感到安心时，\n──同时也为即将到来的情绪反弹，\n依然在某个角落"],["戦きながら、\n僕等は砂浜を後にした。","颤抖着，\n我们离开了沙滩。"],["微妙に高いそのソフトを買って、\n二人して舐めながら車に戻った。","买了那个略贵的甜筒，\n两人边舔边回到车上。"],["こういう時に、甘いものは矢張りいい。[l]\nほんとに凹んだ時は味なんか分からなくなるけど、\n僕もまだ、味覚が鈍磨する程ではないらしい……否、[l]\n──此奴に慰められたが故だと思ってやるか。[l]\nとにかく、\nまだちゃんと甘い、旨いと感じる事が出来る。[l]\nそういう目的だったとは言え、\n脳の空転もおかげで大分ましになった気になれた。","这种时候甜食果然很棒。[l]\n真正消沉时根本尝不出味道，\n看来我还没迟钝到味觉麻痹的地步……不对，[l]\n──就当是托这家伙安慰的福吧。[l]\n总之，\n还能真切感受到甜味和美味。[l]\n虽说本意在此，\n多亏如此大脑空转的状态也缓解不少。"],["狩屋の話だと、\n姫様ちゃんは冬夏の……三春の家に居るらしかった。[l]\n一応車で送ろうかと言ってみたが、\n拒否された。[l]\n僕としても、矢張り今彼女等の……しかも本拠に、[l]\n近づくのは、まだ色々と気後れする部分が多すぎた。[l]\nだから、逢う時同様、僕にとっては助かったと言えるけど、","据狩屋所说，\n姫様好像待在冬夏的……三春家。[l]\n试探性问了要不要开车送她，\n被拒绝了。[l]\n对我来说，现在靠近她们……尤其是大本营，[l]\n果然还是有太多踌躇之处。[l]\n所以和见面时一样算是帮了我，"],["そしたら、\nまた独りか。","这样一来，\n又剩我一人了吗。"],["……ふと奴を視ると、[l]\n奴は現金なもので、\n──責めはしないが、\nソフトを喰い終わる頃には、\nもう気が","……突然瞥见那家伙，[l]\n这家伙倒是现实得很，\n──虽然不会责备她，\n但甜筒快吃完时，\n她已经"],["漫ろになってた。[l]\nそれでもいよいよ別れしな、\n彼奴は","心不在焉了。[l]\n即便如此临别之际，\n那家伙"],["饒舌に、喋り出した。","突然话多起来。"],["「なんちゅーかさ、\nこっちも色々立て込んでくるから、\nしばらくこういうの難しいかもだけど、\n私はミカタだよ、兄ぃ、\nねこのことだけじゃなくて……[l]\nああもうにゃんか言葉浮かばにゃいな、\n……ん、そう、[l]\nきーちゃがね、\nこういうのは感得するものだって、\nだから、\nその、\n……えいっ」","「该怎么说呢，\n我这边也要开始忙了，\n暂时可能很难这样见面，\n但我是站在哥哥这边的，\n不只是作为猫娘……[l]\n啊真是的想不出合适的话喵，\n……嗯、对了，[l]\n小姬说过，\n这种事要靠心领神会，\n所以，\n那个，\n……嘿」"],["ばんっ。","砰。"],["「いっ──でぇよ！」","「好──痛耶！」"],["何故か突然奴は、\n僕の肩をがっしと掴んでこっちを向かせた。[l]\n車の席だから少々無理くりで、\n──そして誰かさんのように、\n流石に照れがあったのか、\n視線は合わせずにもう一度肩を強く","不知为何他突然\n用力抓住我的肩膀把我转过来。[l]\n在车座上难免有些勉强，\n──然后像某人那样，\n果然还是有点害羞吧，\n没对上视线就再次重重地"],["叩いて、\nそのまま一瞬服の袖を握りしめ、\nそしてすぐ手を離した。","拍了拍肩，\n随即短暂地攥住我的衣袖，\n又立刻松开了手。"],["「……っかってるはずだよ、[l]\n視えるんなら、\nだいじょぶだよ、\n兄ぃは、」","「……应该明白的吧，[l]\n既然能看见的话，\n没问题的，\n哥哥，」"],["──……。",""],["「おなじものを視てるなら、\nういらとも色々、うん、まあ、\nまあね、色々、\nなかま……友達……にゃ、[l]\nち、知人としてこれからもさ、\n付き合ってけるよ、\n少なくともうい個人は、\n………」","「如果看着同样的东西，\n和唯良也可以各种，嗯，那个，\n那个嘛，各种，\n同伴……朋友……喵，[l]\n作、作为熟人今后也，\n能继续交往下去哦，\n至少唯个人是，\n………」"],["「……あによ」","「……讨厌啦」"],["「変な意味に取んにゃよ！[l]\n少なくとも、うい個人は、\n兄ぃのことすきっだから、\n……っ、げふげふ、ごほっ、[l]\nえほっ、えふぁ」","「别往奇怪的方向想喵！[l]\n至少，唯个人是，\n最喜欢哥哥了，\n……呜、咳咳、呕咳、[l]\n呃咳、呃啊」"],["「",""],["噎せなさんな、\nおちつい──」","别呛着了，\n冷静──」"],["「こっ！[l]\nこれからもずっとさ！！[l]\nもっと、もっと話すことだってあるだろしさ、[l]\nせっ、[l]\nせっかく、」","「这！[l]\n从今往后永远都是啊！！[l]\n还有、还有更多要聊的事对吧，[l]\n难、[l]\n难得，」"],["知り合って間もないのに、ここまで近く、\nそんなのはじ──","明明才认识不久，就能这么亲近，\n这样的开──"],["と聞こえたような気がしたが、\nそわそわとしていて落ち着かないのは、\n端から視ても分かり易すぎるくらい分かった……[l]\nつまり、早く姫様ちゃんの所に行きたいのだろうと、\nそう思って、[l]\n僕は奴の話を止めて、\nさっさと行きなよと、そう言った。","似乎听到了这样的词，\n但看他坐立不安的样子，\n连旁观者都看得一清二楚……[l]\n总之，大概是急着想去姫様那边吧，\n这么想着，[l]\n我打断他的话，\n说了句快去吧。"],["一呼吸置き、やや落ち着いた後、\n再び口を開く。","稍作停顿平复呼吸后，\n再次开口。"],["「………ごめん、なさい。[l]\n………まっ、[l]\n……祭が終わったら、[l]\nまた会おうよみんなで、\nねっ？」","「………对不起。[l]\n………嘛，[l]\n……等祭典结束后，[l]\n大家再一起聚吧，\n好吗？」"],["「……まつり……」","「……祭典……」"],["「にゃ、にゃによ、\nそんな寂しそうな顔しにゃいでよぅ！[l]\n","「喵、喵什么啦，\n别摆出那么寂寞的表情喵！[l]\n"],["じゃ、じゃあ、\nいいや、ま、電話でもメールでも、\nキンキュウならいつでもよこして、\n可能なら相手したげっから、\nわかった？いいよね？[l]\nじゃね、\nほんとに、ありがとうございました！」","那、那，\n不对，嘛，电话邮件都行，\n紧急情况随时联系，\n可能的话我会陪你，\n明白？可以吧？[l]\n再见，\n真的，非常感谢！」"],["僕に車を降りる間を与えることなく、\n狩屋は、ばだむ、とドアを閉め振り返ることなく、\n足早に立ち去っていった。","没给我下车的时间，\n狩屋砰地关上车门头也不回，\n快步离去了。"],["ぐだぐだ後引くのはヤだったんだろうが、\n……いや、いいんだ。[l]\nありがとう。","虽然不想拖拖拉拉地纠缠不清，\n……不，没事的。[l]\n谢谢。"],["「みんなで……祭が終わったら……[l]\n祭が終わったら、……か」","「等大家……祭典结束后……[l]\n祭典结束后……吗」"],["……僕だって。[l]\nそうしたい、","……我也是。[l]\n想这样做的，"],["……此奴も、[l]\n姫様ちゃんとも、[l]\n在夜ちゃんとも、[l]\n道具さん……とも、[l]\n……冬夏とも、","……这家伙也是，[l]\n姫様也是，[l]\n在夜也是，[l]\n道具小姐……也是，[l]\n……冬夏也是，"],["──きっと、","──明明一定，"],["……なれるのに。","……能实现的。"],["「………すぅーー……、[l]\nはぁーー……」","「………呼————……，[l]\n哈————……」"],["深呼吸がまるで、\n溜息のようで、","深呼吸简直像，\n叹息一般，"],["「……昼間だってのに、[l]\n耳鳴りがするくらいに閑かで、\n……」","「……明明是白天，[l]\n却寂静得耳鸣，\n……」"],["独りになると、矢張り落差が、\n膨らんだものが","独处时果然落差感，\n膨胀的东西"],["萎むような、\n絶頂からどん底へ墜ちるような、","像萎缩般，\n从巅峰坠入谷底般，"],["\n\n\n戻りが、","\n\n\n反弹来得，"],["\n\n\n急に、","\n\n\n突然，"],["\n\n\nきた。","\n\n\n猛烈。"],["「──さびしいかお…か、さびしい、[l]\nああ、さびしいな……さびしい……、[l]\nさびしい………」","「──寂寞的表情吗…不，寂寞的，[l]\n啊，好寂寞……寂寞……，[l]\n寂寞………」"],["この耐えられない、祭りの後の感覚、[l]\n上気が一気に覚まされる、[l]\n冷や水を浴びせられたかのように、","这难以忍受的、祭典后的空虚感，[l]\n高涨的情绪骤然冷却，[l]\n如同被泼了冷水，"],["みせつけられる現実、[l]\n逃げられない事実、[l]\n向き合わねばならぬ問題、","被迫直视的现实，[l]\n无法逃避的事实，[l]\n必须面对的问题，"],["──忘れていたものとの再会は、","──与遗忘之物的重逢，"],["途","是"],["轍もなく、[l]\nつらい。","毫无缓冲地，[l]\n令人痛苦。"],["これが、ヤだったんだ、これが、[l]\n……なまじ上げ幅が大きいと、[l]\n揺り戻しはより一層大きく、","就是这个，我害怕的就是这个，[l]\n……正因为情绪波动太大，[l]\n反噬就更加剧烈，"],["………痛い。","………好痛。"],["……冬夏も、[l]\nすぐその場のノリでしでかした行為を後悔してたっけ、[l]\n……少し違う気もする、けど、","……冬夏也是，[l]\n总因一时冲动而后悔自己的行为，[l]\n……感觉又有点不同，不过，"],["とうか──？","冬夏——？"],["ああ、","啊啊，"],["いたい、あいたい……","好痛，好痛啊……"],["──誰に、","──该去找谁，"],["だれ、だれって、………。","谁，找谁呢，………。"],["──逢いに行くと？直面する覚悟はまだ、それに、","──说要主动去见？可还没做好面对的准备，再说，"],["そんなものは向こう次第だ、僕が如何に腹を","那取决于对方意愿，无论我如何下定"],["括ろうと、","决心，"],["──焦らされるのはうんざりとはいえ、","──虽然焦灼等待令人厌烦，"],["待つのはイヤだって僕が言ったところで、","但就算我说不想等，"],["──自分と他の関係性である限り\n    ペースを強要するのは支配的に過ぎる、","──只要涉及自己与他人的关系\n    强行掌控节奏就太过专制，"],["僕自身に出来る事と出来ない事がある、","我有能做到和做不到的事，"],["──他者が選択及び決定権を持つコトガラに於いては特に、","──尤其在他人拥有选择及决定权的事情上，"],["……知ってるさ、知ってるよ。","……我明白的，当然明白。"],["だけど、[l]\n僕は●●だから、[l]\nこんなときにどうすれば、[l]\nなにをしたら、","但是，[l]\n因为我是●●，[l]\n这种时候该怎么办，[l]\n该做什么，"],["「………なにしてるんだ僕は」","「………我在干什么啊」"],["今更だけど、[l]\n結局のところ、","虽然现在才说，[l]\n说到底，"],["何も進展してない……のだ。","毫无进展……呢。"],["──と、いうよりも、","──或者说，"],["狩屋との逢瀬……おうせ？[l]\n違う、[l]\n会って話をした事は、[l]\n確かに気を紛らわせては呉れたが、[l]\n根本的な解決には、[l]\n……少なくとも僕にとっては、[l]\nなってない。","与狩屋的幽会……幽会？[l]\n不对，[l]\n虽然见面交谈这件事，[l]\n确实帮我分散了注意力，[l]\n但对于根本问题的解决，[l]\n……至少对我来说，[l]\n毫无帮助。"],["とは言え、仮に、\n真面目に問題を語り合ったところで、[l]\nお互いどんどん気が","话虽如此，即便\n我们认真讨论问题，[l]\n双方的情绪只会"],["鬱いで、[l]\n二人分が乗算されて無駄に滅入っていただろう。[l]\n前にもこう思ったような気がするが、[l]\n鬱屈した感情、負の話題は、[l]\n他人に話す事によって発散される場合と、[l]\n逆に相手を引きずり込んで両者が打ち沈む場合がある。[l]\n勿論相手に負の感情を、ケガレのように擦り付け、[l]\n","越来越阴郁，[l]\n两人的负面情绪相乘导致白白消沉下去吧。[l]\n之前似乎也有过类似想法，[l]\n抑郁的情绪、消极的话题，[l]\n有时候通过向他人倾诉能获得宣泄，[l]\n但反过来也可能拖累对方导致双方一起陷入低谷。[l]\n当然若将负面情绪像污秽般涂抹给对方，[l]\n"],["伝","传"],["染してしまった気になって、[l]\n自分だけはスッキリする場合もあろうが、[l]\n出歯亀根性や野次馬根性、[l]\n他者の不幸に浮き浮き出来る類の人種なら兎も角、[l]\n僕と、[l]\n道具さんから連絡が来るまでの狩屋では、[l]\nとてもじゃないが、","染上了这种情绪后，[l]\n或许只有自己能感到畅快，[l]\n但偷窥癖或凑热闹的心态、[l]\n能从他人不幸中获得快感的这类人暂且不论，[l]\n在我和、[l]\n道具小姐联系上狩屋之前，[l]\n实在、"],["耐えられるものではなかった。","难以忍受。"],["話してしまってすっとする類の内容でもないし、\n何よりも相争えと言われている当事者同士、[l]\n……それとも、[l]\n話し合えば、[l]\n何か、良い方法でもみいだせたの……だろうか。","这也不是那种说出来就能释怀的内容，\n更何况当事人还被要求互相争斗，[l]\n……又或者、[l]\n如果好好谈谈、[l]\n说不定能找到什么、更好的方法……呢？"],["──カリヤとアヤメは、","──卡利亚和阿娅梅、"],["確か、\n…………。","我记得、\n…………。"],["駄目だ。[l]\n分からない。","不行。[l]\n想不明白。"],["思考の速度も、集中も、[l]\n緩急が激しくて、[l]\nとても十全とはいえ、ない、[l]\n熱くなっても冷めても、[l]\n","思考的速度也好，专注力也罢，[l]\n起伏都太过剧烈，[l]\n实在称不上，周全、[l]\n无论发热还是冷却，[l]\n"],["制","制\": \"控"],["御がきかないから、[l]\nどちらであろうと一旦転ぼうものなら、","都控制不住，[l]\n所以无论哪种状态一旦跌倒的话，"],["暴走、どうあれ","暴走、总之"],["碌な事には……","都没好下场……"],["……ねむくなってきた……のもあるが、[l]\n張り詰めていた気が緩んだの、かな……","……虽然也有点……犯困了……[l]\n大概是紧绷的神经松懈了吧……"],["そのまま、[l]\n僕は、[l]\n暗くなるまで、[l]\n何処へも行かず、車の中で","就这样，[l]\n我，[l]\n直到天色变暗，[l]\n哪儿都没去，在车里"],["微","微"],["睡んでいた。","睡着了。"],["眠かったのも気の緩みもそうだけど、","犯困和松懈确实都是原因，"],["疲れていたのと、[l]\n腹が満たされたのと、[l]\n……何より起きていると、[l]\n暗い思考に囚われてどうにかなりそうだったからだった。","因为疲惫不堪，[l]\n因为填饱了肚子，[l]\n……更重要的是如果醒着的话，[l]\n就会被阴暗的思绪困住快要崩溃。"],["事態の進展、解決に向けての思索は、[l]\nどうしてもモードが入らない、","关于事态进展和解决之道的思考，[l]\n无论如何都进入不了状态，"],["──というよりも、","──或者说，"],["相変わらずアタマのどこかを確実に占拠している、","依然确凿地占据着脑海某处，"],["──●●●",""],["という安定感が、僕を繋ぎ止めている、","这种安定感将我维系着，"],["──掴むことさえ出来れば、","──只要能抓住的话，"],["何とかなるのだと、[l]\n……あ、そうだ、","总会有办法的，[l]\n……啊对了，"],["──オオカミと話をしなければ、","──必须和狼谈谈，"],["……大神？[l]\nああ、落ち着いたら、連絡しようと、[l]\nしてたような、してないような……","……大神？[l]\n啊啊，等冷静下来后要联系，[l]\n好像想过又好像没想……"],["──とにもかくにも、","──总而言之，"],["もう睡魔に勝てそうもない、[l]\n空腹時と眠い時は、他人と会話してはいけない……んだ……[l]\nだから……[l]\n","已经敌不过睡魔了，[l]\n空腹和犯困时不该和别人交谈……的……[l]\n所以……[l]\n"],["──起きたら、","──等醒来后，"],["大神に……連絡しよう……","要联系……大神……"],["「………ん」","「………嗯」"],["急に、覚醒した。","突然清醒了。"],["視るまでもなく、\nすっかり外は暗くなっていて、\n時間帯がそうなのか、交通量が増してるとみえて、\n家路に急いでいるのであろう沢山の車が通る音が、\n確かに大きく聞こえていた。","无需张望，\n外面已完全暗下来，\n不知是时段原因还是车流量增加，\n急着回家的车流声，\n确实听得很清楚。"],["が、それで起こされたという実感はない。","但并没有因此被吵醒的实感。"],["アラームをセットしておいて、\n鳴る直前に起きた時のような、\nあの時間感覚の矛盾、\n虫の知らせ……というよりも、[l]\n神経過敏の所為なんだろうが、","明明设了闹钟，\n却在响起前就醒来时的那种，\n时间感的错乱，\n虫子的预感……不如说是，[l]\n神经敏感导致的吧，"],["「……？[l]\nなんだろうな、」","「……？[l]\n怎么回事啊，」"],["意味は無いとは思っていたけれど、\nざわざわした感覚に背中を押されて、\n急な動きで外に出た。","虽然觉得毫无意义，\n却被躁动感推着后背，\n猛地冲到了外面。"],["瞬間、","瞬间，"],["「あ？[l]\nあー、そこか。[l]\nいたぜかれおん、おったおった、\nよーう久し振りだな」","「啊？[l]\n啊——，在那儿啊。[l]\n这不是卡蕾欧嘛，在的在的，\n好久不见啦」"],["後ろから、\nよく聞き知った声が、","身后传来，\n熟悉的声音，"],["「……あ？なんで、お前が、」","「……啊？为什么，你会，」"],["──大神雪鳴の声がした。","──是大神雪鸣的声音。"]],"context":[["SC_M_060.ks/index/1/text"],["SC_M_060.ks/index/3/text"],["SC_M_060.ks/index/5/text"],["SC_M_060.ks/index/7/text"],["SC_M_060.ks/index/9/text"],["SC_M_060.ks/index/11/text"],["SC_M_060.ks/index/13/text","SC_M_060.ks/index/113/text","SC_M_060.ks/index/117/text","SC_M_060.ks/index/121/text","SC_M_060.ks/index/123/text","SC_M_060.ks/index/125/text","SC_M_060.ks/index/342/text","SC_M_060.ks/index/701/text","SC_M_060.ks/index/703/text","SC_M_060.ks/index/705/text","SC_M_060.ks/index/763/text","SC_M_060.ks/index/809/text"],["SC_M_060.ks/index/15/text"],["SC_M_060.ks/index/18/text"],["SC_M_060.ks/index/20/text"],["SC_M_060.ks/index/23/text"],["SC_M_060.ks/index/25/text"],["SC_M_060.ks/index/27/text"],["SC_M_060.ks/index/29/text"],["SC_M_060.ks/index/31/text"],["SC_M_060.ks/index/33/text"],["SC_M_060.ks/index/35/text"],["SC_M_060.ks/index/37/text"],["SC_M_060.ks/index/39/text"],["SC_M_060.ks/index/41/text"],["SC_M_060.ks/index/43/text","SC_M_060.ks/index/53/text","SC_M_060.ks/index/107/text","SC_M_060.ks/index/141/text"],["SC_M_060.ks/index/45/text"],["SC_M_060.ks/index/47/text"],["SC_M_060.ks/index/49/text"],["SC_M_060.ks/index/51/text"],["SC_M_060.ks/index/55/text"],["SC_M_060.ks/index/57/text"],["SC_M_060.ks/index/59/text"],["SC_M_060.ks/index/61/text"],["SC_M_060.ks/index/63/text"],["SC_M_060.ks/index/65/text"],["SC_M_060.ks/index/67/text"],["SC_M_060.ks/index/69/text"],["SC_M_060.ks/index/71/text"],["SC_M_060.ks/index/73/text"],["SC_M_060.ks/index/75/text"],["SC_M_060.ks/index/77/text"],["SC_M_060.ks/index/79/text"],["SC_M_060.ks/index/81/text"],["SC_M_060.ks/index/83/text"],["SC_M_060.ks/index/85/text"],["SC_M_060.ks/index/87/text"],["SC_M_060.ks/index/89/text"],["SC_M_060.ks/index/91/text"],["SC_M_060.ks/index/93/text"],["SC_M_060.ks/index/95/text"],["SC_M_060.ks/index/97/text"],["SC_M_060.ks/index/99/text"],["SC_M_060.ks/index/101/text"],["SC_M_060.ks/index/103/text"],["SC_M_060.ks/index/105/text"],["SC_M_060.ks/index/109/text"],["SC_M_060.ks/index/111/text"],["SC_M_060.ks/index/115/text"],["SC_M_060.ks/index/119/text"],["SC_M_060.ks/index/127/text"],["SC_M_060.ks/index/129/text"],["SC_M_060.ks/index/131/text"],["SC_M_060.ks/index/133/text"],["SC_M_060.ks/index/135/text"],["SC_M_060.ks/index/137/text"],["SC_M_060.ks/index/139/text"],["SC_M_060.ks/index/1