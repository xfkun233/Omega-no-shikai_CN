6179,"end":6197}],[{"start":6226,"end":6275}],[{"start":6301,"end":6387}],[{"start":6395,"end":6478}],[{"start":6507,"end":6518}],[{"start":6550,"end":6559}],[{"start":6588,"end":6598}],[{"start":6628,"end":6667}],[{"start":6699,"end":6757}],[{"start":6786,"end":6832}],[{"start":6858,"end":6879}],[{"start":6911,"end":6933}],[{"start":6962,"end":6997}],[{"start":7023,"end":7068}],[{"start":7098,"end":7176}],[{"start":7208,"end":7257}],[{"start":7286,"end":7339}],[{"start":7365,"end":7367}],[{"start":7375,"end":7400}],[{"start":7408,"end":7433}],[{"start":7462,"end":7476}],[{"start":7527,"end":7586}],[{"start":7643,"end":7658}],[{"start":7690,"end":7712}],[{"start":7742,"end":7754}],[{"start":7780,"end":7797}],[{"start":7851,"end":7872}],[{"start":7898,"end":7916}],[{"start":7973,"end":8057}],[{"start":8089,"end":8131}],[{"start":8139,"end":8187}],[{"start":8213,"end":8260}],[{"start":8317,"end":8367}],[{"start":8430,"end":8447}],[{"start":8484,"end":8505}],[{"start":8561,"end":8597}],[{"start":8623,"end":8671}],[{"start":8728,"end":8763}],[{"start":8826,"end":8850}],[{"start":8882,"end":8935}],[{"start":8998,"end":9024}],[{"start":9081,"end":9092}],[{"start":9155,"end":9172}],[{"start":9198,"end":9210}],[{"start":9267,"end":9331}],[{"start":9394,"end":9400}],[{"start":9426,"end":9433}],[{"start":9465,"end":9515}],[{"start":9524,"end":9526}],[{"start":9552,"end":9576}],[{"start":9584,"end":9615}],[{"start":9644,"end":9671}],[{"start":9697,"end":9718}],[{"start":9807,"end":9830}],[{"start":9838,"end":9881}],[{"start":9915,"end":9954}],[{"start":10017,"end":10039}],[{"start":10071,"end":10100}],[{"start":10126,"end":10212}],[{"start":10266,"end":10310}],[{"start":10365,"end":10368},{"start":10400,"end":10403}],[{"start":10429,"end":10437}],[{"start":10494,"end":10522}],[{"start":10554,"end":10562}],[{"start":10588,"end":10606}],[{"start":10614,"end":10628}],[{"start":10691,"end":10725}],[{"start":10782,"end":10796}],[{"start":10830,"end":10875}],[{"start":10907,"end":10931}],[{"start":10991,"end":11028}],[{"start":11082,"end":11108}],[{"start":11140,"end":11223}],[{"start":11286,"end":11294}],[{"start":11348,"end":11369}],[{"start":11401,"end":11430}],[{"start":11462,"end":11485}],[{"start":11548,"end":11559}],[{"start":11596,"end":11608}],[{"start":11653,"end":11708}],[{"start":11716,"end":11757}],[{"start":11820,"end":11850}],[{"start":11876,"end":11902}],[{"start":11910,"end":11949}],[{"start":11957,"end":11975}],[{"start":11983,"end":11999}],[{"start":12007,"end":12016}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_046.ks","basename":"SC_M_046.ks","indexIds":{"「ふぇぇ、何かすごいひっさしぶりだねぇまこちゃん。[l]\n色々心配かけて悪かったのだわ、\n元気だった？」":0,"「いや、\nどっちかっていうと僕の方が体調崩しまくりだからな……[l]\nこないだも点滴とか世話になったし」":1,"「真言さんたら一昨日倒れて丸１日寝てたんだから……って、[l]\n":2,"言ったか私。":3,"まあそんなだからね、\n寧ろきぃの方が元気よね、\n食欲もすっかりいつもの通りだし」":4,"「食は全ての基本っすよ":5,"姉さん！[l]\n":6,"まあ何にしてもほんと、\nお見舞いの品もありがたく戴きましたので、\n":7,"ありがとうねまこちゃん」":8,"「……まあ、今回も色々持ってきてるんだけどな。[l]\n足りるかどうか分からんけど……」":9,"きぃの家……というか部屋か、を、[l]\n直に訪れるのは矢張り":10,"憚られるという事で、\n恐らく近くなんだと思うが、\n軽食屋か喫茶店かという風情の小さな店で落ち合った僕等。":11,"車での道行きにきぃへの土産を大量に買い込んで、\nそれこそこの店がガラ空きだったから良い様なものの、":12,"ちょっと引かれるかも、くらいの量を、\n冬夏と一緒に持ってきたのだが、\nきぃは苦もなく受け取ったのであった。":13,"それは食欲の為せる":14,"業なのか、\nバイトで":15,"培った腕力なのか。":16,"いずれ僕等は呆れ半分に感心しつつ、\nこの店でも食事を奢る訳です。":17,"「ここってよく来るの？」":18,"「んー、\nあんまり来ないけどさ、\n":19,"前一回来た時にすっごい美味しかったのだわ。":20,"なのに客少ないんだよねぇ……[l]\nだからわたしの味覚の問題あるかもだけど」":21,"「ふーん。[l]\nそれって道具さんと来たってこと？」":22,"「……多分そうかなあ。[l]\n値段は……ふつう？[l]\n":23,"格別安くはないのだわ。[l]\nだからわたしが自分から１人だけでは来ないと思う」":24,"「ま、早く頼もか。[l]\n朝御飯抜いてきたんだから私達」":25,"そう、何となくきぃに合わそう……と思ったわけでもないが、[l]\nこっちも腹減らしてみるかという話で、":26,"僕は運転する関係上、\nちょっとビタミン飲料飲んだけれど、\n基本ご飯らしいご飯は食べずに来たのだった。":27,"「うぇっへっへっへ」":28,"４人がけのテーブル席、\nソファ側にきぃとお土産の荷物、\n椅子側に僕と冬夏が並んで座ってたのだが、\n突如きぃが僕等を見比べて気味悪く笑った。":29,"「……何その笑い？」":30,"「冬夏ったらさ、\nまこちゃんと会ってから":31,"大":32,"分砕けてきてるんだわ。[l]\n言葉遣いとかわたしと居る時よりかなりゆるゆる。":33,"話し方なんかすっかり、ねえ？[l]\n":34,"わたしじゃ心の囲いは壊せなかったかぁ～。[l]\n":35,"あーもー妬けるねこれ！あっついあっつい」":36,"「いっ！[l]\n家に！！[l]\n帰ってないからちょっとそんなかんじなんだってば！！[l]\nあ、ほら、真言さんが困るでしょそんな今言ったら」":37,"「押したいのか遠慮したいのか良い感じに慌ててるねえー。[l]\nもう色々言ったりしたりしてるんだしょー？":38,"にしてもなー、まこちゃんと会わせる前はさ、\n幾らさばさばったってまだ全然つんけんだったんだねェ？":39,"それともあれさ、\n二人っきりだと出せる本当の私ってやつだわ？」":40,"「いぃーっから！[l]\nそそそそういう話題わ！！":41,"あ、あんたそんなふうに思ってたの？！[l]\nほら、お土産あげないわよ！！！[l]\n":42,"返して貰うわよ！！！！」":43,"「は、それは困るのさ。[l]\n……がっつり大人しくするのだわ」":44,"強制力なんて無いだろうに、効果覿面だなあ……":45,"「それより、きぃも真言さんに御礼あるんじゃなかった？」":46,"「んー、\n帰り際に渡すつもりなのさ。":47,"今だとちょっと間が悪いというか──\n":48,"あ、別に冬夏の恋路を邪魔するもんじゃないから\n心配は無用なのだわ」":49,"「……だぁっからっ、……それもういいっての」":50,"「まあまあ喧嘩はお":51,"止めなさい。[l]\nきぃも別に気を遣わなくていいんだけど、\nそんなに」":52,"「ふぇえ、まあ、お察しの通りろくな物はないんでさ、\n感謝の手紙的な？[l]\n後で１人になったら読んで欲しいのだわ。[l]\nああ、冬夏ってば、だからラブレターとかじゃないからさ」":53,"「……あぁーあ、そっか、お土産、いらないんだ？」":54,"「ふええっ！[l]\nも、もう言いませんごめんなさいお土産ください冬夏さまぁん」":55,"先程から君等は一体何してるのかね……":56,"そんなこんなで、\n良い時間になったにも関わらず客の来ないこの店、\n存分に食べ、話し、笑い、":57,"数日前までの疑念をすっかり忘れるくらいの、":58,"愉しい時間を過ごした。":59,"疑念ついでに、\n今朝って、すごい寝覚めが悪かった気がするんだけど……":60,"何故かはもう覚えてない。[l]\nまあわざわざ嫌な気分を思い出すこともないので、\nそのまま放置です。":61,"客が居ないとは言え何も頼まずに長居は失礼……":62,"否、きぃの分を相当頼みはしたんだけれど、\n兎も角、そこそこの時間が経ったので店を出るも、\nきぃの荷物を":63,"鑑みて一旦適当な場所まで送る事にし、\n３人で車に乗り込む。":64,"「なんか、\nほんとに私達って、\n小さい時さぁ、揃って会ってるんじゃないかなー。":65,"最近知り合ったにしてはさ、\n馴染み方が違うよね、あはははは」":66,"冬夏が助手席に乗り込みながら、\n心底嬉しそうにそう言った。":67,"そんな事言うとまたきぃがいらぬツッコミするんじゃ、\nと思ったが、\n先程の釘刺しが効いてるのか無言のきぃ。":68,"「まあ、\n一応、まだ確証無いまでも、\nその可能性があるわけだよねぇ、\n僕等それぞれに？":69,"全員がどうかはまあ少なくとも僕の記憶には……[l]\nや、当てにならんけどさ」":70,"「──きっと、\n……そうさ。[l]\nそうだわ」":71,"「なに、しんみりしてる？[l]\n病み上がりには染み入る話だったかしら」":72,"「……ん、[l]\nそう、かもね。[l]\n何か涙腺が」":73,"そう言って鼻をすするきぃ。[l]\nミラーで確認すると、確かに眼が赤くなってるかも。":74,"「わたしってこんなだから、\nひととのこういう付き合いとかさ、憬れ強いっていうか、\nそういうのに飢えてるんだぁ。":75,"ほんとに……嬉しいよ２人にまた……」":76,"「幾ら腹へりキャラだからって、\nなんでもかんでもそんな飢えなくてもさ、\nああごめんごめん、\n泣かないでぇ～」":77,"冬夏は後部座席に身を乗り出し頭を撫でる。":78,"「ええはなしや……そうか……？」":79,"１人ボケツッコミをしながらエンジンをかける僕。[l]\nまあ僕まで話に乗っかって変に深刻な空気にするのも、\n余計に":80,"居た":81,"堪れない気がして……":82,"「……たし、満たされなくて、何しても、[l]\nわたしどれがほんとの自分か分かんなくなるしさぁ、\nその、いろいろ仕事もしてるとさぁ……」":83,"「ああもう泣かない泣かない、\nだぁいじょうぶ、\nいっぱい食べれば少なくともお腹は満たされる！":84,"あは、\nね？[l]\nお土産もいっぱいあるし、":85,"私も真言さんも、\nきぃのトモダチなんだからさ、\nそんなになる前にさ、\n遠慮しないで色々言ってくれれば良いよー。":86,"よね？[l]\n真言さん」":87,"「えあ、おおう、もっ、勿論。[l]\n可能な範囲でなら飯くらい奢るし……」":88,"なんか本格的に空気が微妙になりそう？":89,"「……ふぇえ。[l]\n２人とも、\nほんとに……ありがとう……ぐず、ございまず……」":90,"あうあ、\nこここういうシチュエーションには馴れてないので、\n無駄に焦る……かと思いきや、[l]\n自己防衛機構が働いたのか、やけに冷静になっていく僕。":91,"その甲斐あってか、\n来しなに買って手つかずだった缶コーヒーが、\nドリンクホルダーに差しっぱなしだったのを思い出し、\n黙ってそれを後ろに手渡す。":92,"「……あう、いいの？」":93,"「おお。いいよお」":94,"「いだだぎまず……」":95,"「んとに、すっかり感激屋になっちゃって、\n体調も崩してみるもんよねー」":96,"「それはどうだろうなあ……[l]\nまあいいや、じゃ出発するよ？[l]\n場所分からんから教えてくれい」":97,"「……ふぇ、ええとね、[l]\n駐車場を左折で出てぇ、\n次の信号までまっずぐ」":98,"……ぱっと視た感じ、信号なんか視えねえぞ？":99,"「……きぃ、お前結構な距離今日歩いてきた？」":100,"「……お腹いっぱい食べられるように、[l]\nえへへへへへへぇ」":101,"まじかい。[l]\nてか復活早いな。[l]\n湿っぽくされるよりは良いけど……":102,"「やっぱそなんだ。[l]\n昨日と全然違うよねここ？[l]\nあんまり来ないから勘違いかなーって思ってたけど、\nほんとに遠かったんだね」":103,"「まああれなら、\n土産喰ってても良いしな……[l]\n道さえちゃんと教えてくれりゃ」":104,"「おけおけ、\nいあ、食べるのも我慢するさ。[l]\nじっくり長く愉しまねば勿体ないのだ……」":105,"わ、":106,"と続け、ないんだ。[l]\n別にええけど……":107,"ともあれ数分も走ると、信号のある交差点が出て来た。":108,"「それをー、右折なのだわー」":109,"曲がると、\n大きめではあるが、\nテナント募集の張り紙のある空き店舗の駐車場が、\n先方に視える。":110,"「そこの駐車場お願いしまーす」":111,"「らじゃー。[l]\nよっしょと……」":112,"「ふすー……ふすー……」":113,"冬夏、静かと思ったら寝てたのかい。":114,"「お、\n冬夏寝てるうちにこれ渡す」":115,"ああ、\nなんか手紙とかいう。":116,"「別に冬夏に気遣う内容じゃないけど……[l]\nなんとなくさ。[l]\nま、どっちにしろ１人の時に読むのだわ。[l]\n色々こう、差し障りのない時に」":117,"「分かったって。[l]\nま、さっきも言ったけど僕等に対しては遠慮しなさんな。":118,"僕も友人少ないし、\n……コドモの頃からのトモダチ、なんだよな？[l]\n僕等はさ」":119,"そう信じたいよ、という願望……なのか、[l]\n念を押すように僕は思わずそう言っていた。":120,"「……そうだよ。[l]\nわたしたちは、\nわたしはまこちゃんが、\nはじめての」":121,"「んーああー、寝てた！私？[l]\n":122,"あうあう。[l]\nえ、ここどこ？」":123,"「お、おはよう冬夏さん。[l]\n目的地周辺です、お疲れ様でした」":124,"何となくそうしなければならない気がして、\n気付かれないよう手紙をポケットにさっと仕舞う。":125,"「そういえば道具さんから聞いたけど、\n祭は予定通りやるって？」":126,"「……そうなんだ。[l]\n私は知らない」":127,"「ああ、僕も聞いたよ、\n一応僕も目的はそれだから、\n良かったと言えば良かったんだけど──」":128,"「……そっか、[l]\n真言さんそもそも……」":129,"「うちには帰んない？」":130,"「……ん。[l]\nまだ、」":131,"──せめて誕生日までは、":132,"「道具さんも言ってたけど、\n祭までには大人しく戻った方が良いってさ。[l]\nわたしも……今回に限ってはそう思う」":133,"「……んー」":134,"うっ、空気が、":135,"「ま、まあ、こんなこと言うのも何だけども、\n今早急に決めることもないよ、\n少なくとも":136,"姫」":137,"様ちゃん達が強制連行とやらに打って出ないうちは、":138,"ん？[l]\nそれじゃ駄目か、\nと思ってる内に。":139,"「よしゃー！[l]\nこれでしばらくは保つ！！」":140,"がっさがっさと土産の袋を車から降ろすきぃ。":141,"「というわけで、\n決めるのは冬夏だわ。":142,"わたしも難しいことはわからん！！[l]\n思うままにいってみるがよろしいかと？！":143,"どんな未来が待っていようと、\n覚悟の上で！自己責任でお願いします！！」":144,"「……はは、[l]\n……ん、ごめん」":145,"「んじゃ、\nほんとは家まで送ってあげたいけど……」":146,"何とか空気は大丈夫そうだが、\n我ながら危うく地雷を踏みそうになってた？[l]\nもしかして。[l]\nという意識のもと誤魔化し誤魔化し、無難な事を言う。":147,"「いいのいいの、\n自分で言ったことだしさ。[l]\n……ねえおふたりさん」":148,"「？」":149,"神妙になる僕等。":150,"「わたしたち、\nずっと、\n友達だよね？」":151,"「そら、まあ、」":152,"それはどうかなあ、なぁーんちゃって♪":153,"と茶化すのも頭をよぎったが。":154,"「ほんとの親友はそんなの口で確認しなくても！[l]\nねえ？」":155,"「……時と場合によるんだわ。":156,"でも、\nありがと、\nほんとに愉しかった。[l]\nまた……遊んでね」":157,"「お前の場合は飯奢るのがメインだろうけどな……」":158,"「私も愉しかったよー。[l]\nまた、家にも行くから。お土産持って」":159,"「うん……じゃ、２人とも気をつけて帰るといいのだわ」":160,"「……なんか映画とか漫画とかの、[l]\n死亡フラグ立ったキャラみたいな空気出すなって。[l]\nちゃんと喰って寝とけよ、\n病み上がりなんだから」":161,"「死亡ふらぐ？」":162,"「あはは、まこちゃんよりは元気さ。[l]\n":163,"じゃ、ほんとにありがとね。[l]\nまた──今度ね」":164,"「おうー。お疲れー。[l]\nまたなー」":165,"「ばいばいー。[l]\n":166,"……死亡ふらぐって何？」":167,"大量の土産……食材を抱えて、[l]\nきぃは帰って行った。[l]\n足取りは──しっかりしてるな。":168,"一応視えなくなるまで視送りつつ、\nその間、冬夏に死亡フラグ云々の説明をし。":169,"「成る程ねー……[l]\nあるあるネタみたいな事かな」":170,"そんなどうでもいい話をしつつ、\n宿に戻った。":171,"夕方の朱が、何故か心を締め付けて、\n僕は今朝の気持ち悪さを思い出した。":172,"……運転手だし車酔いじゃないよな……":173,"一度思い出してしまった不快感は、":174,"何故か後を引く──":175},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_046.ks","relPath":"/data/scenario/SC_M_046.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":175,"length":176,"percent":99.43181818181817},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1,"t":"HU"}]],"cacheResetOnChange":{},"lastSelectedCell":[34,1]},"/data/scenario/SC_M_047.ks":{"data":[["@r昨日、\nえーと１７日の月曜。","@r昨天，\n呃17号周一。"],["@rまだ本調子じゃなかったのか、\n冬夏と一緒の入浴が何かしら影響してたのか、\n一昨日のきぃとの快気祝いから戻ってから、\nどうも気分の悪いのが納まらず、\n僕は昨日一日、宮さんの了解を得て殆ど床についていたのだった。","@r可能还没完全恢复，\n又或是和冬夏共浴产生了什么影响，\n从前天和小贵的病愈庆祝回来开始，\n总觉得恶心的感觉迟迟不退，\n昨天一整天我都得到宫小姐许可基本卧床休息。"],["@rタイミング的に大変申し訳なかったが、\nここで","@r时机上实在很抱歉，\n但比起"],["拗らせて肝心の本番に響くよりは、\nと言うことで大事を取らせて貰ったのだけれど、\n正直心苦しい。","硬撑影响到关键演出，\n所以选择了谨慎行事，\n说实话心里过意不去。"],["@rしかして宮さんの方はと言えば、\n大して問題視していない御様子で、\nチノ嬢と仕事の話があるとかであんまり構ってくれなかった……[l]\nいや、構うってなによ。[l]\nや、僕がこんなになって忙しいのかもしんないし。[l]\n……どうでもいいやな。","@r至于宫小姐那边，\n看起来并没太当回事，\n说是和千乃小姐有工作要谈就没怎么管我……[l]\n啊不是，管我算啥。[l]\n不过，我这样可能确实让她很忙吧。[l]\n……无所谓了。"],["@r夜半、\n更に気分が悪くなって眼が覚めた。","@r半夜，\n恶心加重醒了过来。"],["@r知狡さんに連絡すると何やらどたばたしてるようで、\nかなり深刻な顔をして僕の様子を視に来てくれたが、","@r联系知狡阿姨时那边似乎手忙脚乱，\n她板着相当严肃的脸过来查看我的状况，"],["@rまあ、深刻なのはいつもの事だしなこのひとは。","@r不过这人平时就总这么严肃啦。"],["@rと思って苦笑いしつつ、\nそんななのに更に知狡さんは、\nビンとかでなく、錠剤を３粒はだかのまま持って来ていたり、\n何やらその慌てっ振りというか、\nそのギャップにまた吹いたりしたけど、\n錠剤は大変に効き目があったようで、\nすぐに気分は良くなった。","@r这么想着苦笑的功夫，\n结果知狡阿姨居然\n没拿药瓶而是直接抓着三颗裸药片过来，\n那种慌慌张张的样子\n又让我笑出声，\n不过药片效果倒是立竿见影，\n很快就舒服多了。"],["@r気分が悪かったのであまり明瞭ではないが、\n錠剤もなんか漢方ちっくというか、\n手作りっぽかった気がするので、\n自家製の何か、自然薬みたいなのだったのかも知れない。","@r因为不舒服记忆不太清晰，\n但药片像是中药那种，\n感觉像是手工制作的，\n可能是自制的什么天然药物吧。"],["@rこのまま今晩は大人しくして寝ていろ、\n絶対に起きてくるな。","@r今晚就这样老老实实睡觉，\n绝对不准起床。"],["@rと強く念を押され、\nその真面目さにまた笑いつつ、\n眠りに落ちた。","@r被这样严厉叮嘱着，\n又因那份认真劲儿而发笑，\n我坠入了梦乡。"],["@rちなみに冬夏は普通に朝から学校行って、\nやっぱりこの宿に帰ってきたらしい。[l]\n祭が決定されたけども、\nまだ戻るつもりないのだろうかな……","@r顺带一提冬夏像往常一样早晨就去学校了，\n结果似乎还是回到了这个住处。[l]\n虽然祭典已经确定要举办，\n但大概还没打算回来吧……"],["@r携帯電話を確認してみるが、\n今のところ姫様ちゃん達から連絡はない。","@r试着查看了手机，\n目前还没有姫様她们发来的联络。"],["で、今日。","然后，今天。"],["薬の御陰か、\n僕の体調不良は取り敢えず快復してる……と思う。","托药物的福，\n我的身体不适暂且算是康复了……大概。"],["前科があるから絶対に大丈夫とは言えないが、\n無理しなければ──混浴したりとか──、\n大丈夫であろうと思われた。","因为有前科所以不敢说绝对没问题，\n只要不过度勉强──比如混浴什么的──，\n应该不会有事吧。"],["前聞いてた通り、\n今日４月１８日は、\n冬夏達の学校の開校記念日とやらで休みらしく、","正如之前听说的，\n今天4月18日，\n似乎是冬夏她们学校的建校纪念日所以放假，"],["心配して朝僕の部屋に来た冬夏は、\n僕の無事を確認するや否や、\nやや神妙な面持ちで、","早上担心地来我房间的冬夏，\n刚确认完我平安无事，\n就露出略显郑重的表情，"],["「今日、行きたい所あるんだけど、\nだめ？[l]\nむり？[l]\nあの、ちょっと話すだけでいいんだ。","「今天有个想去的地方，\n不行吗？[l]\n很勉强？[l]\n那个、只说说话就好。"],["遊んだりとかそう言うんじゃないから……[l]\nあ、遊ぶ方が良いならそれでもいいけど……」","不是要玩啊什么的……[l]\n啊、如果玩比较合适的话那样也行……」"],["と、ご提案。","如此提议道。"],["「んー、まあ、遊ぶのはあれとして、\n話すだけなら大丈夫でしょう、けども、\nどこかそういう、行きたい場所があるってことね？[l]\n前みたいに海とか寒いとこじゃ……」","「嗯─、嘛、玩的事先放一边，\n只是说话的话应该没问题，不过，\n就是说有某个特别想去的地方对吧？[l]\n不会又像之前那样是海边之类寒冷的地方吧……」"],["「ん、\n海じゃない。[l]\n逆、だね。","「嗯，\n不是海边。[l]\n相反，呢。"],["山の中。だからその、[l]\n寒さはそれなりかも……だけど、[l]\n天気は？","在山里。所以那个，[l]\n可能会有点冷……不过，[l]\n天气怎样？"],["ん、晴れてるね。[l]\n多分だいじょぶ」","嗯，是晴天呢。[l]\n大概没问题」"],["窓の外を確認すると、\n確かに暖かそうな雰囲気ではあるね。[l]\n北の方とは言え４月も中旬だしな、\nそういう日もぼちぼち出始めるのう。","望向窗外确认，\n确实透着暖融融的气息。[l]\n虽说地处北方但毕竟已是四月中旬，\n这样的日子也渐渐多起来了呐。"],["「じゃあ、一応宮さんに訊いてみる。[l]\n……大体どの辺？[l]\n遠い？」","「那先问问宫小姐吧。[l]\n……大概在哪个方位？[l]\n远吗？」"],["「えっとね、\n一応、部分的に……なのかな？[l]\nうちの私有地なんだけど、神社」","「那个呢，\n应该算是……部分私有地吧？[l]\n是我家的私有地，神社」"],["九抱山玄森神社。","九抱山玄森神社。"],["「……ぅあ。[l]\nもしかして祭の──」","「……呜啊。[l]\n难道是祭典的──」"],["「そっか。[l]\n祭観光に来たんだったら知ってるよね。","「这样啊。[l]\n既然是来观光祭典的话应该知道吧。"],["ん。[l]\nその神社。[l]\nだから、ちょっと遠い……かな。","嗯。[l]\n就是那个神社。[l]\n所以，可能有点远……吧。"],["直線距離なら、碁石松原よりは近いと思うけど、\n坂道上るから。[l]\nあと、他校は普通に平日登校日だし」","直线距离的话，比碁石松原要近些，\n但要爬坡。[l]\n另外，其他学校今天都是正常上课日」"],["窓の外を眺めながら、\n何故か憂いの籠もった声、仕草でそう言う冬夏。","一边望着窗外、\n冬夏用莫名带着忧郁的声音和动作这么说着。"],["これは、\nもしかして、\nいや、でも御神体の場所は冬夏も知らないって言ってたし、","该不会、\n难道、\n不、但冬夏说过她也不知道御神体的位置、"],["だが、祭儀の場所を前もって知っておけるのはチャンスか……[l]\n斎場の方は知ってるし、","但是，能提前知道祭祀地点是个机会吗……[l]\n斋场的位置我是知道的，"],["──ああ、","──啊啊，"],["そこまで思考して、\nあまりに打算的な自分が、ものすごく厭になった。","思考到这一步，\n对如此精于算计的自己，感到无比厌恶。"],["当初の目的、今自分が此処に居る理由、\nそういうものを凌駕する程の、\n彼女等に対する感情移入、罪悪感、","最初的目地、如今我在此的理由、\n足以凌驾这些的、\n对她们产生的共情、罪恶感、"],["僕は、","我、"],["さいあくだ──","真是差劲──"],["「──いいよ、行こう。[l]\n話きくよ、そこで」","「──没关系，去吧。[l]\n我会听你说的，在那里」"],["「ほんと？[l]\nありがと、でも、\n……無理しないでね」","「真的？[l]\n谢谢你，不过、\n……别勉强自己哦」"],["「大丈夫、\nじゃ、宮さんに訊いてくるから、\n……ロビーで待つ？」","「没问题、\n那我现在去问宫小姐、\n……在大厅等吗？」"],["「ん？[l]\nう、うん。[l]\nああああの、あのね朝御飯食べた？」","「嗯？[l]\n啊、嗯。[l]\n那那那个、我说你吃早饭了吗？」"],["「え、まだ。[l]\n出る前がいい？[l]\n出先にしようか？」","「诶、还没。[l]\n出发前比较好？[l]\n要不在外面解决？」"],["「えええとね、\nあ、先連絡してきて、\nそれまでに考える……って電話で？[l]\n宮さまに確認て」","「呃呃那个、\n啊、先联系一下、\n在那之前考虑……电话里说？[l]\n和宫大人确认下」"],["「……うーん、[l]\n一応行ってくる、かな、\n冬夏もその方が時間できそうだし」","「……嗯——[l]\n姑且去一趟吧、大概、\n冬夏那样时间也比较好安排」"],["「ん、\nあー、そ、そうだね、わかったー。[l]\n──、","「嗯、\n啊——是、是啊、知道啦——[l]\n──、"],["……じゃ、ロビーで待ってます。[l]\nそれまでに決めとくね。[l]\nあ、駄目って言われたら……？」","……那、我在大厅等着。[l]\n在那之前会决定好的。[l]\n啊、要是被拒绝的话……？」"],["「あ。[l]\n……や、[l]\n多分大丈夫じゃないかなあ……[l]\nばたばたはしてたけど何かあれば言ってくるだろうし」","「啊。[l]\n……应、[l]\n大概没问题吧……[l]\n虽然手忙脚乱但有事会联系我们的」"],["今回に関して言えば、\n仕事にも関係するかもだし……","就这次来说，\n可能和工作也有关……"],["仕事……","仕事……"],["「訊いてくる。[l]\nじゃあまた後で」","「我去问问。[l]\n那待会儿见」"],["「まことさんっ、」","「真言先生、」"],["「うあい？」","「呜哎？」"],["「……あ、[l]\nん、\n呼んでみただけ。[l]\nあはは」","「……啊、[l]\n嗯、\n只是试着叫叫。[l]\n啊哈哈」"],["「あはは……[l]\nあっはっはっは……」","「啊哈哈……[l]\n啊哈哈哈……」"],["「ごめん。[l]\nいってらっしゃい。[l]\nロビーで待ってるね」","「抱歉。[l]\n路上小心。[l]\n我在大厅等你哦」"],["「じゃ、\n鍵しないといけないから出ましょか」","「那、\n得锁门了咱们出去吧」"],["「はぁい」","「好——」"],["冬夏とエレベーターで別れ、\n僕は宮さんの部屋に向う。","与冬夏在电梯分别后，\n我朝宫小姐的房间走去。"],["何故か、気もそぞろに、\n僕はエレベーターのボタンを意味無く連打した。","不知为何心神不宁地，\n我无意义地连按着电梯按钮。"],["「宮さん……[l]\n居ますか？」","「宫小姐……[l]\n在吗？」"],["「おはようございます。[l]\nお身体の調子は良いようですね？[l]\n安心しました、薬がちゃんと効いたようで」","「早上好。[l]\n您身体状况似乎不错呢？[l]\n太好了，看来药效发挥得很好」"],["「あ、おはようございます……[l]\nあの」","「啊，早上好……[l]\n那个」"],["「大変心苦しいのですが、\n昨晩から少々、大きな動きが──","「虽然非常过意不去，\n但从昨晚开始有些，大动作——"],["少々？大きな？[l]\nどっちでもいいんですが、\n敢えて言うなら大きな動きがありまして、\n今その処理に追われてます店長は。","有些？大动作？[l]\n其实都无所谓，\n硬要说的话是有大动作，\n现在店长正忙着处理。"],["斯くいうワタシもヘルプしないといけませんでね。[l]\n取り敢えず現時点ではまだ、アナタにして貰える事もないですが──","如你所见我这边也得去帮忙。[l]\n总之现阶段暂时，还没有需要您协助的事——"],["ああ、今チズルが来るでしょうから、\n話があるのでしたら彼女にお願いします。[l]\n仕事絡みでもプライベートでも、\n判断し対応出来ますのでご心配なく」","啊对了，小知马上会过来，\n有事的话请直接拜托她。[l]\n无论是工作相关还是私事，\n她都能判断处理请放心」"],["「あ、……そうですか、[l]\nすみません邪魔して……」","「啊、……这样啊，[l]\n抱歉打扰了……」"],["「……いえ。[l]\n店長が必ずアナタを必要とする事態になるでしょう。[l]\nそれまでは、\nそちらこそご自愛を。","「……不会。[l]\n店长迟早会遇到必须依靠您的状况。[l]\n在那之前，\n请您务必保重。"],["くれぐれも、\nTake care of yourself.","千万要，\nTake care of yourself."],["では失礼します」","先告辞了」"],["「あ、\n……？[l]\n僕を必要と……？","「啊，\n……？[l]\n必须依靠我……？"],["大きな動きって、何が、\nあ、知狡さん」","所谓大动作，到底是什么，\n啊，知狡阿姨」"],["「ああ、\nおはよう。[l]\n大丈夫か？[l]\n顔色は……良さそうだが」","「啊啊，\n早啊。[l]\n没事吧？[l]\n脸色……倒还行」"],["「御陰様でなんとか大丈夫です、\nええと今なにか、」","「托您的福还算撑得住，\n那个现在好像，」"],["「ん、まあな。[l]\nま、今はまだお前が気にすることはない。[l]\n何か用か？」","「嗯，算是吧。[l]\n不过现在还轮不到你操心。[l]\n找我有事？」"],["「え？[l]\nあ、ああ、あの、","「咦？[l]\n啊、啊、那个，"],["今日学校が休みとかで、\n冬夏がその、\n例の山の例の神社に行きたいと──」","今天学校放假所以，\n冬夏她那个，\n想去那座山上的神社——」"],["「九抱山玄森神社──にか？[l]\n祭の実行が決まったと聞いているが、\n何か関係が、\nあるのか？」","「九抱山玄森神社——吗？[l]\n听说祭典筹备已经定下来了，\n莫非有什么，\n关联？」"],["「よくは分かりませんが、\n話があるとか……","「具体不太清楚，\n说是有话要谈……"],["僕としてはその、複雑ですが、\n……色んな意味で、複雑なんですが、[l]\nもしかしたらこれで、」","我个人来说吧，该说是复杂，\n……各种意义上都很复杂，[l]\n说不定这次能，」"],["「………。[l]\n連絡だけちゃんと取れるようにしろ。","「………。[l]\n至少保持通讯畅通。」"],["何かあったらすぐ──体調の事も含めてだぞ、\n連絡を寄越せ。[l]\n今私くらいしか動けないかも知れないが、\nすぐに迎えに行く」","要是有什么情况立刻——包括身体状况也是啊，\n给我联系。[l]\n现在可能只有我能行动了，\n会立刻去接你」"],["「分かりました……[l]\n基本的には話があるとかだそうなんで、\n何事もないとは思いますけど」","「知道了……[l]\n基本上好像是有话要说的样子，\n虽然我觉得应该不会有什么事」"],["「み──宮さん……は今手が離せない、[l]\nもう聞いたな？[l]\nだからその、\n無事に戻って来るんだ。必ず」","「宫——宫小姐……现在抽不开身，[l]\n已经听说了吧？[l]\n所以说那个，\n要平安回来。一定要」"],["「はははは、相変わらず深刻過ぎますって。[l]\nええ、それは勿論、ちゃんと帰ってきます。[l]\n何かあったら連絡しますから。","「哈哈哈，您还是一如既往太严肃啦。[l]\n嗯，那是当然，会好好回来的。[l]\n有什么情况会联系的。"],["じゃ、宮さんにも宜しく伝えてください。[l]\n行ってきます」","那，也请代我向宫小姐问好。[l]\n我出发了」"],["「……気をつけてな」","「……小心点」"],["宮さんの顔くらい、視てから出掛けたかった。","本来想至少看看宫小姐的脸再出门的。"],["とかいうこととかじゃない筈だが！","虽然应该不是这种意思啦！"],["何となく、\nやはり落ち着かない。[l]\nそんな自分の心を振り切るように、\n僕は知狡さんに背を向けて、ロビーへと向かった。","总觉得，\n还是静不下心。[l]\n像是要甩开这样的心情一般，\n我背对知狡阿姨，朝大厅走去。"],["車中では、\n冬夏は何故か黙りがちで、\n先日の喋りまくりテンションとは明らかに、\n別人のように違って静かだった。","在车里，\n冬夏不知为何很沉默，\n和前几天滔滔不绝的状态明显\n判若两人般安静。"],["時折言葉を発するも、\nすぐ会話が途切れて続かないというか、\n心ここにあらずな返答だったりで、\n前のドライブを知ってるだけに心配になる。","偶尔开口说话，\n对话也马上中断无法继续，\n或是心不在焉地回答，\n正因为知道她上次兜风时的样子才更担心。"],["何かあるなら言って欲しかったので、\n空気を敢えて読まずに突っ込んでみた。","希望她有事能说出来，\n便故意不察言观色直接问了。"],["「あの……[l]\n今あんまし話さないけども、\n何か調子悪いとか？[l]\n話す事があるわけでしょ色々と？[l]\nこの車中で話さないって事は──」","「那个……[l]\n现在不怎么说话，\n是身体不舒服吗？[l]\n是有话要说对吧各种方面？[l]\n不在车里说这件事——」"],["「ん、\nんー。[l]\nその、着いたら話す。","「嗯，\n嗯——。[l]\n那个，到了再说。"],["あ、ごめん、\nそんなに静かだった私？[l]\nその話す事まとめてて頭いっぱいだー、\n……ごめん」","啊，抱歉，\n我这么安静吗？[l]\n因为要说的东西太多脑子塞满了——\n……对不起」"],["「ああ、成る程ね……[l]\nまあ無理せずに──\nそうだ、何かラジオでもかける？","「啊，原来如此……[l]\n总之别勉强——\n对了，要放点广播什么的吗？"],["すっかり頭から飛んでたけど、\n車にはカーステレオってもんが……」","完全忘了这茬，\n车上不是有车载音响这种东西……」"],["「……っぷはは。[l]\n真言さん、\nやっぱいいいなー真言さん。[l]\nいいなー……」","「……噗哈哈。[l]\n真言先生，\n果然最喜欢真言先生了。[l]\n最喜欢啦……」"],["格別狙ったとか気を遣った訳ではなくって、\n完全なる素だったんだけども、\nまあ喜んで……喜んで？、[l]\nくれたようで良かった良かった。","倒不是特意讨好或顾虑什么，\n完全是自然反应，\n不过能让她开心……开心？[l]\n就好就好。"],["「……なんだかさっぱり分からんけども、[l]\nまあ僕なんぞ笑われてなんぼよね……[l]\nそういうポジションだもんねもう」","「……虽然完全搞不懂，[l]\n不过我被笑话也是理所当然吧……[l]\n已经是这种定位了呢」"],["「ん？[l]\nっははははは！","「嗯？[l]\n噗哈哈哈哈！"],["ま、そだよね。[l]\nあはははは！[l]\nかわいそ、あはははは！」","嘛、也是呢。[l]\n啊哈哈哈！[l]\n好可怜、啊哈哈哈！」"],["「……なんだかさっぱり分からんけども」","「……虽然完全搞不懂怎么回事」"],["どれくらい走ったのか、\n冬夏に言われるがままに道を進み、\n看板に書かれた九抱山までの距離も１０㎞を切った頃、","不知跑了多久，\n被冬夏带着沿路前行，\n当指示牌显示距九抱山距离已不足10公里时，"],["窓の外にはその威容を誇る──ある種の異様さをも不思議と感じる──かの山が、眼に視えて近くなっているのを確認出来る。","窗外那座彰显威容——甚至带着某种令人莫名感到诡异的异常感——的山峦，已清晰可见地迫近眼前。"],["玄ノ森に来た日に遠く視えていたあの山と、\n同じとは思えない程に、\n眼前に迫るこの霊峰霊山は──","与初到玄之森时远眺所见的那座山，\n简直判若两地，\n此刻逼近眼前的灵峰圣山——"],["きっと先入観や気のせいだろうけれど、\n不気味なくらい、\n何かがいる、まさに生命の塊たるその、\n","虽说是先入为主或心理作用，\n却诡异地令人觉得，\n仿佛有某种存在、堪称生命聚合体的，\n"],["魁","庞然巨物"],["偉とでも言うべき圧倒的質量感、","或者说具有压倒性质量感的伟岸存在，"],["遠くから視たのでは只の輪郭だった筈の稜線が、\n樹木の一本一本が確認出来る程に近寄るだけで、","远望时本应只是轮廓的山脊线，\n近到能看清每一棵树木的距离时，"],["景色とは風景とは、\nヒトの傲慢な主観に過ぎないと思い知らされる、\n全て書き割りなどではない、\n全てが自我持つものの集積──","才让人醒悟所谓景致风光，\n不过是人类傲慢的主观臆断，\n绝非布景板般的死物，\n万物皆是拥有自我意识的集合体——"],["「まーことさーん？」","「真～言～先～生？」"],["「んなっ。げほごはっ。[l]\nご、ごめ、今ちょっと浸ってた……」","「呜哇。咳咳。[l]\n对、对不起，刚才有点走神……」"],["「？」",""],["小首を傾げる冬夏。","冬夏歪着小脑袋。"],["「いや、なんでもないす。[l]\nな、なんでございましょ」","「没、没啥。[l]\n您、您有何贵干」"],["「ん？[l]\nあ、\nえーとね、\n駐車場、私達の専用だからすっごい分かりにくいんだけど。","「嗯？[l]\n啊，\n那个呢，\n停车场是专用区域所以特别难找。"],["それで神社にも結構歩くから、\n何か飲み物とか買って行った方が良いかなって。[l]\n真言さんの体調もあるし……」","而且去神社还要走挺远，\n我在想要不要买点饮料带着。[l]\n毕竟真言先生身体也不太舒服……」"],["「なるへそ」","「原来如此」"],["「で、そんなだからね、\n店も近くに全然無いから。[l]\n途中でコンビニ入った方がいいね」","「所以呢，\n这附近根本没啥店铺。[l]\n中途还是去趟便利店比较好」"],["「あいよぅ。[l]\nじゃ、\nあああああれか、あそこに入るますっ」","「好嘞～[l]\n那，\n啊啊啊就是那个吧、要进那边对吧」"],["「あはは、\nどぞどぞ、入るますってくださいあははっ」","「啊哈哈，\n请请请、说什么要进啊哈哈哈」"],["これまたわざとじゃないんだが……[l]\nもういいです。","这倒也不是故意的……[l]\n算了算了。"],["駐車場に入りエンジンを切る。[l]\n何にしても愉しんでくれてるならそれに越した事は、","驶入停车场熄火。[l]\n总之她开心比什么都强，"],["………。",""],["ちらと視た冬夏の顔は、\nやはりどうにも憂いて視える、\n思い詰めてる、","瞥见冬夏的脸上，\n果然还是透着忧虑，\n心事重重的，"],["なんだろうか。","怎么回事呢。"],["指定の場所が件の神社だったので、\n祭、或いは御神体に関わる話なのか、\nとも思った訳だが、\n告白の返事とかを迫られるんだろか？","既然目的地是那座神社，\n或许与祭祀或神体有关，\n虽这么猜测过，\n但该不会是要逼我答复告白？"],["当初の約束の、冬夏の誕生日まではまだだけども、\n待てなくなったか時が経って心変わりでもしたのか──","虽说当初约定要等到冬夏生日那天，\n是她等不及了还是变心了——"],["「ん？[l]\nなぁに？」","「嗯？[l]\n怎么啦？」"],["はっ。[l]\n思わず視詰めてた。[l]\n僕が我に返ると、冬夏も急に気付いたかのように顔を赤くし、\n慌てふためいて言った。","呃。[l]\n不自觉盯太久了。[l]\n等我回过神，冬夏也突然察觉似地涨红脸，\n慌慌张张地开口。"],["「えっと、その、あはは。[l]\nあの、そのね。[l]\n私買ってくるけど。","「呃、那个、啊哈哈。[l]\n那个、我说啊。[l]\n我去买吧。"],["真言さん乗ってて良いよ？[l]\n何がいい？」","真言先生坐着就好？[l]\n要什么？」"],["と、\n今にも車降りる勢いに。","说着，\n摆出立刻就要下车的架势。"],["「や、寧ろ僕が行くから冬夏乗っててよ。[l]\nこういうときくらい男子が……」","「不、不如我去吧冬夏你坐着。[l]\n这种时候该让男生……」"],["「だぁかぁらぁ～、\n私にそういうのって無意味だし。[l]\nいーから何要るの。ほれ。言え。言いなさい」","「所～以～说～，\n对我搞这套没意义的。[l]\n饭你快说要啥。喏。说啊。快说」"],["「……ええーと、[l]\nじゃあレモン的なビタミン的なペットボトル飲料と、\n１００円レベルの甘いもの……チョコでいいや、[l]\nあとレーション的な何か」","「……呃——[l]\n那就柠檬系维生素系的瓶装饮料，\n100日元左右的甜食……巧克力就行，[l]\n还有野战口粮之类的」"],["「ええっ？えええっと、[l]\nれれれーしょん？？」","「诶？那个——[l]\n野野野战口粮？？」"],["「あ、ごめん、所謂、一日分のカロリーだの栄養をこれで！[l]\nみたいな固形食物……」","「啊、抱歉、就是那种号称一天所需热量营养[l]\n的固态食物……」"],["商品名が出てこねえ……[l]\nレーションが出てなんでそっちが出ないか僕のアタマ。","商品名想不起来……[l]\n能想起野战口粮却想不起这个我脑子。"],["「ああーあ、\nああ、はい、はいはい。[l]\nあといい？」","「啊——\n啊、好、好好。[l]\n还有呢？」"],["しかし冬夏は何かしら解答に行き当たったようで、\n１人納得の御様子。","但冬夏似乎想到了什么答案，\n独自露出恍然大悟的表情。"],["「うん、僕はそんなで……」","「嗯，我就这些……」"],["「じゃ行ってくるね」","「那我去啦」"],["「いってらー」","「路上小心」"],["「いてきまー」","「我走啦」"],["……空元気に視えてしょうがない……","……强装开朗的样子看得人难受……"],["それともそれは僕の方なんだろうか。","又或者那其实是我这边的心情？"],["僕は──","我——"],["「僕は、","「我啊，"],["体力とか、","体力什么的，"],["無い方だけど、","虽然不太行，"],["それ抜きにしたって、","但就算不说这个，"],["え？","咦？"],["冬夏、よく、","冬夏你居然，"],["スカートで、","穿着裙子，"],["来ようと、","就敢，"],["思ったね、","来啊，"],["これ、","这算，"],["道かいな？」","路吗？」"],["斎場の方もあれだったが、\nこっちは更に野趣溢れる味わい。","殡仪馆那边也够呛，\n这边更是充满野趣。"],["「まともな道もあるけど、\n平坦な分遠くなるんだよね。","「正经路也有，\n但平坦就意味着绕远。"],["なんかね、\n大人数が一気に来られないようにとか、\nそういう配慮？[l]\n知らないけど。","怎么说呢，\n像是为了防止大批人同时涌入，\n这种考量？[l]\n我也不清楚。"],["蔵の中とか、何気にそう言う警戒はしてるんだよね、\nうち昔から」","仓库之类的地方意外地都有这种警戒，\n我家自古就这样」"],["何か荷物とか資材とか、\n絶対無理だと思う。[l]\n空輸でも無い限り、\n少なくとも文明の利器という奴はほぼ拒まれるんでないか。","搬运货物资材之类的，\n绝对不可能吧。[l]\n除非空运，\n文明利器在这里基本都被拒之门外。"],["それなりの","光靠"],["人","人"],["足つかわにゃ到底、\nいや、専門でないから分からないけども、\nロープウェーとかケーブルカーも無いようだし、\nそういう意味じゃ距離も短いし斎場はまだ何とかなったけど……","腿根本不行，\n不、外行不太懂，\n缆车索道之类的好像也没有，\n从这个意义上说距离短些的殡仪馆还算好办……"],["「まあ、\n馴れてるって言えば馴れてるけど、\n真言さん病み上がりだからじゃない？","「嘛、\n要说习惯也确实习惯了，\n不过真言先生是病刚好才这样吧？"],["まだ寒いから、\n草とかそんなに酷くはないでしょ。","现在天气还冷，\n草丛什么的应该没那么夸张。"],["これ夏場とかだと結構厳しい。[l]\n虫とかまむしとかわんさと出るよ」","这要是夏天可就够呛了。[l]\n虫子啊毒蛇啊会成群冒出来哦」"],["ああ、なんか、","啊、那个、"],["宮さんが、\n来る時の新幹線で、","宫小姐、\n来的时候在新干线上、"],["そんな事を、\n行ってたような、","好像、\n说过类似、"],["「病み上がり心配してる割に、","「嘴上说着担心病人、"],["そもそもこんな所に、","结果把人带到、"],["連れて来たのは、","这种地方来、"],["何か、","为什么，"],["矛盾してない？」","不是自相矛盾吗？」"],["「んー、ごめんっ。[l]\n私で大丈夫だから男子なら平気と思ったんだよね。","「嗯——抱歉啦。[l]\n我觉得自己没问题的话男生肯定更没事嘛。"],["というかね、\nここ歩くのは体力というよりも、\nコツがいるんだと思う」","或者说啊、\n走这段路与其说是拼体力、\n不如说是要掌握诀窍」"],["まあ、\n靴が運動靴なだけで、\nスカートでも何とかなってるもんなあ、\n大体八相……三春の眷属達、そのお偉い方は殆どが女性──？","也是、\n只要穿运动鞋、\n就算穿裙子也能应付呢、\n毕竟八相……三春的眷属们，那些大人物基本都是女性——？"],["と、","这时、"],["急に楽になった。","突然轻松起来了。"],["「あれ、\n急に、\n何か楽に」","「咦、\n突然、\n感觉轻松好多」"],["「所々、\n踊り場みたいに平らっぽくなるからね。[l]\nま、もう少し。[l]\n疲れたら言ってね」","「有些路段、\n会像休息平台那样变平坦啦。[l]\n嘛、再坚持会儿。[l]\n累了要告诉我哦」"],["「御陰様で何とかだいじょぶそうだけど……[l]\n此処って野生動物出たりしないの？」","「托您的福暂时还撑得住……[l]\n这地方不会有野生动物出没吧？」"],["先日の件を思い出し、\n……今まで忘れてたのが不思議だが、[l]\n急に怖くなり、\n訊いてみると、","想起前几天的事、\n……现在才发觉忘了这茬真是奇怪、[l]\n突然害怕起来、\n试着询问后、"],["「季節的には……まあ大丈夫かな……[l]\n一応熊笛持ってるし、\nん、だいじょぶ」","「这个季节……应该没问题吧……[l]\n反正带着防熊哨、\n嗯、没问题的」"],["とのこと、\nここで僕が不安を煽る訳にもいかないし、\n確証は無けれども、\n地元民を信じよう……","听到她这么说、\n我也不好再渲染不安情绪、\n虽然没法确定、\n还是相信本地人吧……"],["「あ、次穴の中入るから」","「啊、接下来要进洞穴了」"],["「あな？！」","「洞穴？！」"],["「あー、\nだいじょぶ、観光鍾乳洞みたいに最低限の整備はされてるし。[l]\n関係者以外は入れないし……多分気付きもしない。","「啊——\n没事的，像观光钟乳洞那样做过最低限度整修。[l]\n而且非相关人员进不去……多半根本发现不了。"],["入れば判るけど、まあ表行くよりずっと快適。[l]\n閉所恐怖症じゃなきゃね。[l]\n蔵、大丈夫だったし大丈夫だよね？」","进去就知道了，比走外面舒服多了。[l]\n只要没有幽闭恐惧症。[l]\n小藏上次都没事，这次肯定没问题吧？」"],["「うん……それは、だいじょうぶ……」","「嗯……那个、没问题……」"],["「じゃあ、ここ今開けるね。[l]\n結界解かなきゃ」","「那我现在开门啦。[l]\n得先解除结界」"],["斎場の時の道具さんと同じ事を言い、\n斎場の時と同じようにそこに配備されていた『結界』を、\nごそごそ取り出した鍵らしきものを使って開けた。","说着和斋场那时道具小姐相同的话、\n用那把窸窸窣窣掏出来的疑似钥匙的物件、\n打开了部署在那里的『结界』。"],["僕がまたも神妙にそれを視ていると、","当我再次肃然注视着这一幕时、"],["「んじゃ、こっち」","「好、这边请」"],["と言いながら再び『結界』を閉じる。","她边说边重新关闭了『结界』。"],["しばらく歩くと、\n突き当たりではなく、\nまたしても道の途中、\n真横の繁みに突然入っていく。","走了一会儿，\n并非尽头处，\n又在道路中途，\n突然拐进侧边的树丛。"],["汚い戸板のようなモノがいくつか無造作に立てかけ……いや、[l]\n放置されてるような、\n視た感じ不法投棄現場のような場所だったが、","几块像是脏木板的物件随意斜靠着……不对，[l]\n更像是被弃置的，\n乍看像是非法垃圾场的场所，"],["それを","但"],["除けると、\n確かに小さな空間があった。","拨开那些后，\n确实有个小空间。"],["中に入るとエアロックのような二重扉構造の小部屋で、\n奥と続く扉は確かに人工物だし、\nそこにも鎖と錠前の封印はなされている。[l]\n一見、危険立ち入り禁止、と視えなくもない。","进去后是个类似气闸室的双层门小房间，\n深处相连的门明显是人造物，\n那里也挂着锁链与锁头的封印。[l]\n乍看之下，说是危险禁入区也不为过。"],["「先刻説明した通り、一応電気は通ってるはず。[l]\nライトは持ったけどね。[l]\n天井は低いところあるし、\n足下濡れてると思うから上下に気をつけて。","「刚才说过，理论上应该通电的。[l]\n不过我带了照明。[l]\n有些地方天花板很低，\n脚下估计会湿滑，注意头顶和脚下。"],["基本的には立ったまま歩いていけるけど、\n分岐が無い訳じゃないから、\nちゃんとついてきてね」","基本上站着走就行，\n但也不是没有岔路，\n要好好跟着哦」"],["「りょ、了解……」","「明、明白……」"],["一応、彼女等にしか知らされてない、\n現場へのショートカットなんだと。","看来这是只告知她们\n的现场捷径。"],["蔵の中といい、\n何だってこんな、\n何を隠そうとしてるのか、","无论是仓库里，\n还是这种\n刻意隐藏的布置，"],["「だから、\nまともな道行くよりはずっと早くて楽なんだけど……[l]\nあ、あれ地底湖ね。[l]\nこっちは何か化石」","「所以说\n比走正经路快多了也轻松多了……[l]\n啊，那个是地下湖哦。[l]\n这边好像是化石」"],["「へ、へぇ～……」","「哇、哇～……」"],["確かに何か水が真っ青に視える綺麗な地底湖？や、[l]\nよく分からない何かの化石やら、\n石筍やら鍾乳石やらある種の芸術的様相を呈した岩の壁など、","确实能看到某种泛着靛蓝的美丽地下湖？还有[l]\n不明真身的化石、\n石笋钟乳石之类呈现艺术风貌的岩壁，"],["それこそ観光地にすればそれなりのスポットになるであろうその穴を、あくまで通路として、","这洞窟要是开发成观光景点绝对能火，如今却只当作通道，"],["緊張や疲れであまり覚えてないけど、\nともあれ、","因紧张疲劳记忆模糊，\n总之"],["その後も僕等は、\n僕が一方的にひーひー言ったり励まされたりして、\nどんだけ時間が経ったものか、","后来我们\n基本是我单方面鬼叫和被鼓励，\n不知过了多久，"],["何とか目的地に着いた、ようだ。","总算抵达了目的地。"],["「お疲れさまー」","「辛苦啦—」"],["「おつかれ……」","「辛苦了……」"],["「とりあえずちょっと休もう。[l]\nはい、これ」","「先稍微休息下。[l]\n给，这个」"],["「さんくす……」","「谢啦……」"],["山頂なのか中腹なのか、\n樹木が天蓋のように上空を覆っている為に、\n標高もよく分からない地点、","不知是山顶还是山腰，\n因树冠遮蔽天空，\n连海拔都难以判断，"],["そんななので、\n眼下を視下ろせる状況でもなし、\n達成感に乏しい登山であった。","导致\n也无法俯瞰风景，\n成了缺乏成就感的登山。"],["久々に地上に出たのに、\n音以外での差異をそれ程感じなかったのはその所為か。","虽久违回到地面，\n却感受不到明显差异，大概正因如此。"],["そりゃ、\n余所から視えない秘儀をするという意味では、\n非常に有用な地ではあろうが、","当然，\n作为举行隐秘仪式的场所\n确实非常理想，"],["まあなあ……[l]\n下手すれば当日、\n此処に再来せねばならないのか……","不过啊……[l]\n搞不好当天\n还得再来这儿……"],["罪悪感云々以前に、\n単純にしんどそう……[l]\nもし此処に御神体があれば、\n色々話は変わって来るのだが……","在说什么罪恶感之前，\n单纯就觉得好累……[l]\n如果这里供奉着神体的话，\n情况就会大不相同了……"],["蔵の中に無かったとは言え、\n幾らこの場所が、来るのに困難な道程とは言え、\nこんな所に無防備に置いてあるとは到底、","虽说仓库里没有找到，\n就算来这个地方的路途再怎么艰难，\n也不可能毫无防备地放在这种地方吧，"],["「まことさん」","「真言」"],["「え？[l]\nあ、うん」","「诶？[l]\n啊、嗯」"],["「ここね、\n分かると思うけど、\n簡単には他のひとが来られないし、\n……うちの管理してるとこだし、","「这里啊，\n你应该也明白，\n其他人轻易进不来，\n……而且是我们家管理的地盘，"],["ちなみにね、さい──祭の時は、\nもっと上の方で色々儀式があるけど、\nここは社があるだけ、中継地点」","顺便说哦，祭——祭典的时候，\n虽然在上层会举行各种仪式，\n这里只有个小神社，算是中转站」"],["奥の院──というか、祭儀場は更に上か……","奥之院——或者说祭祀场还在更上面吧……"],["「とはいっても、\nこの辺りでも既に余所の人は\n入ってはいけないコトになってるから、\n完全に２人きりになれるのね。","「不过话说回来，\n光是这附近就已经\n禁止外人进入了，\n所以能完全独处呢。"],["だからここで話そうと思ったの。[l]\nごめんなさい、面倒かけて」","所以才想在这儿谈。[l]\n抱歉，给你添麻烦了」"],["「え？[l]\nいや、それは別に大丈夫だけども、\n２人きりって言うか、\nもっと楽な、他にそんな場所幾らでも」","「诶？[l]\n不，那倒没什么关系啦，\n与其说是独处，\n明明有更轻松的、其他无数合适的地方」"],["「私達──三春の家はね、\nその……普通じゃないの」","「我们——三春家啊，\n那个……不太正常」"],["「聞いてないし……って、[l]\nは？[l]\n普通じゃないってそれは、\nつまり実力者権力者って意味じゃ」","「没听说过啊……等等，[l]\n哈？[l]\n你说不太正常是指，\n就是实力派掌权者的意思咯？」"],["「……まあ、[l]\nその原因っていうか理由っていうか由来っていうか……","「……嘛，[l]\n要说原因啦理由啦渊源啦……"],["あは、\n私のこの姿がまず普通じゃないんだけどー。[l]\nあははは……」","啊哈，\n首先我这样子就不太正常呢——[l]\n啊哈哈哈……」"],["「……んー、」","「……嗯——」"],["「えとね。[l]\n今から私、\nコクハクします。","「那个啊。[l]\n我现在要，\n告白了。"],["貴方に言わなきゃならないこと、\n秘密にしてたこと、\nしてほしいこと、","必须告诉你的事，\n一直隐瞒的事，\n希望你做的事，"],["もしそれで、\n貴方が私を拒絶するなら、」","如果因此，\n你拒绝我的话，」"],["わたし、すべてをあきらめる。","我，就会放弃一切。"],["「えーと、\nそれって」","「呃——\n那个是」"],["「ん？[l]\nこないだの誕生日約束とは、\n実は別。[l]\n分っかりにくいよね、あはは。","「嗯？[l]\n和之前的生日约定，\n其实是两回事。[l]\n很难懂吧，啊哈哈。"],["まーそのね、\n此処で拒否られても、\n真言さんちゃんと下まで送るから。","嘛——那个啊，\n就算在这里被拒绝，\n我也会好好把真言送到山下的。"],["置いてったりしないから安心して。[l]\n真言さんが──厭じゃなきゃ」","不会丢下你不管的放心啦。[l]\n只要真言你——不嫌弃的话」"],["「え……？」","「诶……？」"],["「私、会ったときから、\n何となく貴方はそうなんじゃないかって、\n感じてた。","「我啊，从见面时起，\n就隐约觉得你可能是这样的人，\n有这种感觉。"],["感得っていうの？[l]\nま、その、びびっときたってやつかなあ……[l]\n世の女の子がよく言うそれとも、ちょっと違うんだけど、\nいや、いっしょかな……」","是叫感应吗？[l]\n嘛、那个、就是突然触电般的感觉吧……[l]\n和普通女孩子常说的那种有点不一样，\n不、或许一样吧……」"],["「………か、んとく…？」","「………感、觉……？」"],["「蔵の中でさ、\nなんか真言さんもワカってたっぽいから、\nそれでやっぱりそうなのかな、とか思ったり」","「在仓库里的时候啊，\n感觉真言先生好像也‘懂’的样子，\n所以就在想该不会真是那样吧」"],["「……ワ、カル…？」","「……懂、得……？」"],["「マガンシツはタイシツでもあるけど、\nセイシンコウゾウによるところも大きく無視出来ない、\n……んだって。","「魔眼质虽然是胎质，\n但很大程度上也取决于精神构造不能忽视，\n……据说呢。"],["真言さん、私の話よく聞いてくれたし、\nその、よくある幻想かもだけど、\n理解も、してくれてたかな、て……」","真言先生很认真听我说话，\n虽然可能是常见的幻想，\n但感觉他也有在、理解我……」"],["「……ま、がんしつ……」","「……魔、眼质……」"],["「と、兎に角ね、\nほんとは確証もてるまで、\n黙ってようかと迷ってたんだけど──」","「总、总之呢，\n其实本来犹豫要不要等拿到确证，\n再保持沉默的──」"],["「……な、なんの……だろ……？」","「……到、到底是……什么……？」"],["「砂の城のこと、\nまだ思い出してないよね」","「关于沙之城的，\n你还没想起来吧」"],["「すなのしろ……シロノシロ？」","「沙之城……城之城？」"],["「白の城、しろのしろ、\nシを忘れるな、\nMeMentoMori、\nM3EW。","「白之城堡，纯白之堡，\n勿忘死亡，\nMeMentoMori，\nM3EW。"],["つくりませよみませEpitaph……」","莫造莫读Epitaph……」"],["「え？[l]\nあ？[l]\nそれは、\n何処かで──」","「咦？[l]\n啊？[l]\n那个、\n在何处──」"],["冬夏はにこり、と微笑んで、","冬夏嫣然一笑、"],["ミ・タサキャラタサキャラミャルタサキャラタサキャラメキャミャル、タサキャラコネタサキャラナサメコネカヤミャルタサナサ・ワ","米・塔萨卡拉塔萨卡拉喵鲁塔萨卡拉塔萨卡拉喵卡米喵鲁、塔萨卡拉科内塔萨卡拉纳萨梅科内卡亚喵鲁塔萨纳萨・哇"],["これは、\nあの謎言語──","这是、\n那个谜语──"],["「出て来てミハル、\n──禁級読紙」","「现身吧米哈尔、\n──禁级读纸」"],["「出て……？[l]\nキンキュウ……って」","「出来……？[l]\n禁级……是说」"],["三春？[l]\n誰かが他に、此処に──","三春？[l]\n还有别人、在此处──"],["「……っ痛」","「……好痛」"],["「……っ？！」","「……欸？！」"],["@rなにかが、\nいる、","@r有什么东西、\n存在着、"],["\nそこになにかがいる、","\n那里有什么东西存在着、"],["\nあたまに印象がながれてくる、","\n脑海中流淌过印象、"],["\n繋がれ、","\n被连接着、"],["我等が友人、","我们的友人、"],["恍惚もたらせ、","带来恍惚、"],["\nＣ、",""],["\nＡ、",""],["\nＴ、",""],["\n──究極の美の体現、アイらしいけもの","\n──究极之美的体现、名为爱的野兽"],["\n──このセカイを楽しくいきる手助けをしてくれるトモダチ","\n──在这个世界快乐生活的帮手朋友"],["\n──ね、こ、","\n──呐、来、"],["\nあ、","\n啊、"],["\n首が、","\n脖子、"],["「……！」",""],["冬夏のそばに、","在冬夏的身边、"],["\n僕にも、","\n对我也是、"],["\nそこに、","\n在那里、"],["\nなにかがいる、","\n有什么东西存在着、"],["\n首が熱い、","\n脖子好烫、"],["\n心がさざめく……","\n心在骚动……"],["@r水は戻ら──","@r水不会倒流──"],["「視える？[l]\nほんとは大黒も一緒なのが本当なんだって、\nでも、こないだ蔵の中でも私の知らないとこに移されてた。","「看得见吗？[l]\n其实大黑本来也是一起的，\n但之前被移到仓库里我不知道的地方了。"],["だから、\n今はこのこだけ」","所以，\n现在只有这孩子」"],["「オオクロ……ご、しんたい」","「大黑……呜、真身」"],["「そう。[l]\nただね、\nほんとうは、\n全部で八つ、なの。","「没错。[l]\n不过啊，\n实际上，\n总共有八个。"],["大黒はその中のひとはしらに過ぎない。[l]\nネコガミは私達七家に伝わる八つのカミ」","大黑不过是其中最初的一位。[l]\n猫神是我们七家相传的八位神明」"],["「……な、な」","「……怎、怎么可能」"],["「きっと、視えるはずなんだ、真言さん、","「一定能看见的，真言先生，"],["あのときのあのこなら、\nわたしとやくそくしたあのひとなら、\n……視えないはずないもん。","如果是那时候的那个孩子，\n如果是和我约定过的那个人，\n……不可能看不见的。"],["ほら、やっぱり、」","你看，果然吧，」"],["「ああ、こ、」","「啊、这、」"],["\n首が熱い、熱い、熱い、こ、れ、は、","\n脖子好烫、好烫、好烫、这、是、"],["\n神使乃八舞のあ、の、あれなのか、","\n神使乃八舞的、那、那个吗，"],["\n",""],["あのとき、","那时候，"],["視たような、","好像看见过的，"],["やっぱりいるのか、","果然存在吗，"],["\n視えてる、","\n看得见，"],["\n視える、","\n能看见，"],["「やっぱり、視えてる、んだね？」","「果然，能看见对吧？」"],["ヤッパリアナタダ。","果然是你啊。"],["「…こっ、……こ、[l]\n視える、これは、」","「…这、……这、[l]\n看得见，这是，」"],["ヤッパリコノコカ。","果然是这种感觉啊。"],["気のせいでもなんでもなかった、","不是错觉也不是别的，"],["何かが視えていたんだ、今までも。","确实有什么被看见了，一直以来。"],["それが、","那就是，"],["「これが、\nミハル……？」","「这就是，\n米哈尔……？」"],["大神、\n@rお前に視えてるのも、\n@rこういうのなのか……？","大神，\n@r你能看见的也是，\n@r这样的东西吗……？"],["@rこんなものが、\n@rセカイに、","@r这样的存在，\n@r在世界上，"],["「……良かったぁ。[l]\nわたし、……わたしっ」","「……太好了。[l]\n我、……我」"],["「あ、と、とうか、\nやっぱ」","「啊、冬、冬夏，\n果然」"],["がしっ。","啪嗒。"],["冬夏が僕の腕を掴む。","冬夏抓住了我的手臂。"],["痛いくらいに強く、","用力到发疼的程度，"],["決して離すまいと僕のウデヲ、","仿佛绝不让我挣脱般钳住我的手腕，"],["「お願いだから怖がらないで、\nお願いだから、逃げないで、\nお願いだからちゃんとこれを視て──」","「求求你别害怕，\n求求你别逃走，\n求求你好好看着这个──」"],["「だ、大丈夫、逃げようとかそんなじゃない、か、ら──」","「没、没事的，不会逃的、所、所以──」"],["冬夏の手を包むように握り返して、\nそれを直視する。","我回握住冬夏的手，\n直视着它。"],["@r印象がまたなだれこんできて、","@r印象再次如潮水般涌来，"],["\nこれハ、","\n此乃，"],["\nミハル、","\n米哈尔，"],["\nミハルモノ、","\n米哈尔之物，"],["\nヒメモテマモルモノ、","\n姬守护之物，"],["\nそして、","\n而，"],["\nワレハイシキノカイ\nガゴトクスナワチカシャ、","\n吾乃意识之界\n伪语近邻者，"],["ム","无"],["ク","口"],["ロ","者"],["アヤツルタマタルソンザイ、","阿夜鹤玉足存在、"],["アイズタルヒキガネハウブメ","爱津垂引金发霉"],["「………とり、」","「………鸟儿，」"],["「……とり？」","「……鸟儿？」"],["「トリック……じゃない……よね？[l]\nこれは僕が何度か、\nおなじ、\nものを、」","「不是TRICK……对吧？[l]\n这是我第几次，\n看见，\n同样的，"],["「視えてるよ、\n真言さん、\n私達はおなじものをみてる、\nそう、\nこれが、」","「能看见哦，\n真言先生，\n我们看见的是同样的东西，\n没错，\n这就是，」"],["@r　　　　　八相のネコガミ。","@r　　　　　八相的猫神。"],["「八相の……ねこがみ」","「八相的……猫神」"],["冬夏がそこで貧血でも起こしたように倒れ込んだ。","冬夏像贫血发作般突然倒下。"],["「冬夏っ！！」","「冬夏！！」"],["慌てて抱き留め支える。","慌忙抱住支撑住她。"],["「えへへ……[l]\nちょっと疲れた」","「诶嘿嘿……[l]\n稍微有点累」"],["力なく笑うが、\n次の瞬間、\n力ががくっと抜けるのが分かる。[l]\nしっかりと抱いて支えるが、","无力地笑着，\n下一秒，\n能感觉到力气突然流失。[l]\n紧紧抱住支撑着她，"],["「あ……[l]\nん、\n大丈夫。[l]\nえへへへ、また抱きしめて貰っちゃった」","「啊……[l]\n嗯，\n没事。[l]\n嘿嘿嘿，又被你抱住了呢」"],["「冗談はいいから、\n休もう、少し。[l]\nだ、大分僕も落ち着いた……から……","「先别开玩笑了，\n休息下吧，一会儿。[l]\n我、我也稍微冷静下来了……所以……"],["何というか、\n思ったほど、\nあれ？[l]\n不思議じゃないっていうか、","该怎么说，\n比想象中，\n咦？[l]\n倒不觉得不可思议，"],["本の読み過ぎかも知れないけど、\nそういうのもアリか、って\n何か普通じゃないのを視る友人も１人いるしさ……」","可能是书看太多了，\n觉得这种情况也有可能，\n毕竟我也有个能看见非常之物的朋友……」"],["──取り敢えずは他人には言わない方が身の為じゃないか、と思うがな。","──暂时别告诉外人比较好吧，为安全着想。"],["しかし、\n向こうから言い出されては、\nこんなコクハクされてしまっては、","但是，\n对方主动提起，\n被这样坦白的话，"],["それに、\n今は、\nとても、","况且，\n现在，\n非常，"],["穏やかだ。","平静。"],["安心……感というよりは、","与其说是安心感……"],["これが当然、とでも言うような、","不如说是理所当然，"],["不思議な気持ち……","奇妙的心情……"],["それとも、単なる精神の防衛機構なのだろうか。","又或者，只是心理防御机制吧。"],["「ほんと？[l]\n真言さん……\n順応早いね……さすが……","「真的？[l]\n真言先生……\n适应得真快……不愧是……"],["私の見込んだひと、\nあのときのこ……だよね……」","我看中的人，\n就是那时候的……对吧……」"],["「正直、僕もはっきり思い出せてないから、\nごめん、断言は出来ないけど、\n視えてる、のは本当、だから。","「老实说我也记不太清了，\n抱歉，没法断言，\n但能看见是真的。"],["とりあえずこれで冬夏を拒絶したりはしない……[l]\n今までも多分何度か視てる……と思うし」","至少这样就不会拒绝冬夏了……[l]\n之前应该也看见过好几次……我想」"],["「……ほんと？[l]\n他のは……まさか……あいつ」","「……真的？[l]\n其他的……难道……那家伙」"],["僕の最後の言葉で、急に険しくなる冬夏。[l]\n何か誤解をしてる、……否、してないにしても、[l]\nあまり良い空気ではない。","因我最后那句话，冬夏的神情突然变得险恶。[l]\n似乎产生了什么误解……不，即便没有误解，[l]\n气氛也明显不对劲。"],["「え、あ、いや、\nこんなはっきりしたのじゃなくて、\nそう、冬夏達のじゃないと思う、","「哎、啊、不是、\n不是这么明确的东西、\n应该不是冬夏你们那种、"],["今まで経験として、へんなものが、視えてたりしたことが、\nあるってだけ、","只是至今为止作为经验，偶尔会、看到些、\n奇怪的东西、"],["『あいつ』が誰かは知らないけども、そこは多分勘違いしてる」","虽然不知道『那家伙』是谁，但这部分你大概误会了」"],["今までの経験っていうのが、\n極めて短期的であるという以外は概ねそのまま語ってるつもりだ。[l]\nあいつ……と、冬夏が言うからには、[l]\n恐らく──","所谓至今为止的经验、\n除了时间跨度极短之外，其他部分我都是照实说的。[l]\n既然冬夏用『那家伙』来称呼、[l]\n恐怕──"],["「あ……そうなんだ。[l]\nへー、\nじゃあ、やっぱり強いんだ、資質が。[l]\nきっと。","「啊……这样啊。[l]\n嘿～、\n那果然是有很强的资质呢。[l]\n肯定是的。"],["もしあのときの男の子なら、\nん、頷けるんだけど。[l]\nまだそこははっきりしない訳ね？」","如果是那时候的男孩子、\n嗯，倒是能理解。[l]\n不过这部分还没完全确定对吧？」"],["「ま、まあそうなるね……[l]\nところで、そのミハル？ネコガミ？[l]\nって、一体何なの……っていう質問は、[l]\nしてもいいんだろか。","「嘛、嘛算是吧……[l]\n话说那个米哈尔？猫神？[l]\n到底是什么东西……这种问题、[l]\n可以问吗。"],["あとやっぱり……他の……道具さん達も……？」","还有果然……其他……道具小姐她们也……？」"],["そう、","没错，"],["式の時に横にいたのは、","仪式时站在旁边的、"],["……八相の西部仕切り、玉梓選律、とか言っていた。","……说是西部八相主管，玉梓选律什么的。"],["ということは恐らく、視えていた『あれ』も、","这么看来，当时看到的『那个』、"],["そして、","接着"],["斎場に行く途中で、","去斋场的路上、"],["あんな事態になっても彼女達が平気だったのは、","发生那种状况她们还若无其事、"],["姫様ちゃんと狩屋も──","姫様和狩屋也──"],["という事なの……か？","就是这么回事……吗？"],["道具さん卑尊さん、","道具小姐卑尊小姐、"],["後は、まだ会ってない、玖威の人間、","另外还没见过的，玖威家的人、"],["七家に八つのカミ……","七家八柱神……"],["御神体……オオクロ……","御神体……大黑……"],["「……一応、秘密ね。[l]\n私達だけの。[l]\n家の因習とかは気にしないけど、\nこんなの他の人に知れたら面倒。","「……姑且算是秘密哦。[l]\n只属于我们的。[l]\n虽然不在乎家规习俗、\n但被外人知道会很麻烦。"],["面倒はもう、この容姿で十分だから。[l]\nあ、宮さまになら、秘密守ってくれるって約束した上でなら、……いいよ。[l]\n多分あのひとも、ワカってくれる、くれてると、おもう」","光这副模样就已经够麻烦了。[l]\n啊，如果是宫大人的话，只要他承诺保密……可以告诉你。[l]\n那个人应该、会理解的、我觉得他、能理解」"],["「わかった……」","「明白了……」"],["飯窪の仕事と直結してる以上、\nそれがどういう結果を招くかは、\n後で１人で考えねばならない。","既然与饭洼的工作直接相关、\n可能引发的后果、\n必须事后独自考量。"],["しかし、冬夏はそう言ってるけれど、\nそもそも信じるだろうかこんな話を。[l]\n大神ならまだしも、\nああ、宮さんも逆に喜びそうな話なのかもな……","不过，虽然冬夏这么说、\n这种说辞本身真的可信吗。[l]\n大神倒也罢了、\n啊，说不定宫小姐反而会高兴……"],["「火を知らないひとにのっての火、\n青銅器に対する鉄器、\n素手に対する重装備、\nそういうもの。","「对不知火者而言的火、\n青铜器时代的铁器、\n徒手面对重装甲、\n就是这类东西。"],["他に対しての優位を保ち得る、\n……危険な、その気になれば……を……せる、[l]\n言うことは聞かないし、\n代償は求められるけど、","能保持对他者的绝对优势、\n……危险的、若有意愿甚至能……的、[l]\n不会听从命令、\n需要付出代价、"],["それでも今のヒトの世の中でチカラを握るには十分なのかもね。[l]\n母様を視てればそれはわかる」","但在当今人类社会掌握话语权已经足够了吧。[l]\n看过母亲大人就明白了」"],["本来、視える資質にはそういう凡俗さは伴わないのが常だって、\nトモさんは言ってたけど。","原本具备『视』资质的人不该沾染这种世俗气、\n智小姐这么说过。"],["そう冬夏は付け加えた。","冬夏又补充道。"],["「ご先祖様が、\nあんまり出来が良くなかったって、\nそれでも三春が八相の頭領なのは──」","「老祖宗们，\n虽然本事都不咋地，\n但三春家依然是八相的首领──」"],["ばさばさばさばさっ！","啪嗒啪嗒啪嗒啪嗒！"],["「とりっ？！？！？！？！？！？！？！？！」","「鸟吗？！？！？！？！？！？！？！？！」"],["たたたぶんと、ととと、鳥かなにかが！！！！！！！！","大大概概是是是、是鸟还是什么的！！！！！！！！"],["「び、っくりしたぁ……」","「吓、吓死我了啦……」"],["「っくりしたよねぇ……ぇあははは……[l]\n","「真是吓坏了呢……啊哈哈哈……[l]\n"],["……あ、[l]\nじゃあね、","……啊，[l]\n那就这样，"],["やっぱり誕生日、お返事貰うときに、\nもっと色々話す。[l]\nあの海岸でね。[l]\nしろのしろの事も説明しやすいと思うし。","果然还是等生日那天收到回复时，\n再聊更多事情吧。[l]\n就在那个海岸边。[l]\n解释白之白的事也会容易些。"],["あ……まあ、そのね、返事次第では気まずいかもだけど、[l]\n","啊……不过嘛，那个，要看回复可能会尴尬，[l]\n"],["ん、私は気にしないよ？[l]\nその辺割り切れるからだいじょぶ、\n……多分」","嗯，我无所谓哦？[l]\n这方面我很想得开的所以没关系，\n……大概」"],["「……えーと、」","「……呃—，」"],["「っていうかさ、\n単純に帰りの時間計算して、\nそろそろ戻らないといけないかなと。","「话说啊，\n单纯计算回去的时间的话，\n差不多该回去了吧。"],["暗くなっちゃうし、\n明日一応学校だし」","天也要黑了，\n明天还得上学呢」"],["まあ、そうかも知らんけども、\nしかし、本番は確か夜な訳でしょ？[l]\n昼なのか？[l]\nどっちにしても構成員は女子だらけ……","嘛，或许是这样吧，\n不过，正式活动应该是在晚上对吧？[l]\n难道是白天？[l]\n不管怎样成员全是女孩子……"],["まあ、その、ネコガミのチカラ……でどうにかするんだろうか。[l]\nまだ具体的なチカラは分からないし、\nそれは誕生日に教えて貰うという話になった以上、\n何とも言えないが、","呃，那个，靠猫神的力量……总会有办法的吧。[l]\n具体是什么力量还不清楚，\n既然说好生日那天才会告诉我们，\n现在也不好说什么，"],["にしても、","不过、"],["飯窪家が探していたカミサマは、\n本家にしろ宮さんにしろ、\nそれがそういうものだと、\n知ってる……訳はないよな？","饭洼家一直在寻找的神明大人，\n无论是本家还是宫小姐，\n如果她们早就知道\n事情会变成这样……怎么可能呢？"],["単なる資料として、書痴としての興味、だよな？","纯粹是作为资料，作为书呆子的兴趣而已吧？"],["宮さん、知狡さん、母さん、……きぃ、","宫小姐、知狡阿姨、妈妈、……小贵，"],["これをこれとわかって探していたとしたら、","要是她们明知如此还刻意寻找的话，"],["がさっ。","沙沙。"],["「ん？」","「嗯？」"],["「また……鳥？」","「又是……鸟？」"],["違った。","搞错了。"],["ひとだった。","是人。"],["姿をみせたのは。","现出身形的。"],["「……お邪魔します」","「……打扰了」"],["場の空気が、\n冬夏の","场内的空气，\n冬夏的"],["纏う雰囲気が、","周身萦绕的氛围，"],["変わった。","骤然改变。"],["一気に張り詰める。","瞬间紧绷起来。"],["さっき鳥が飛び立ったのは、","刚才鸟儿振翅飞走，"],["彼女が来たからだったのかそれとも──","是因为她的到来还是说──"],["「キサマ…[l]\n何で、居るの。[l]\n克杖？[l]\nどうせ克杖も居るんでしょ？」","「你这家伙…[l]\n为什么，会在这里。[l]\n克杖？[l]\n反正克杖也在对吧？」"],["「今日は私ひとりです。[l]\nあなたこそ何故此処に、とは問いません。[l]\n真言さんもいらっしゃるようですし」","「今天就我一个人。[l]\n反倒不会问您为何在此。[l]\n毕竟真言先生似乎也在场」"],["「……ふぅん珍しい。[l]\n今大事な時期でしょうに、\n２人揃ってないなんて、母様に怒られるんじゃないかしら。[l]\n真面目な貴女にとってあのひとの命令は絶対でしょうに」","「……哼～真稀奇。[l]\n现在明明是重要时期，\n两个人却都不在，母亲大人会生气的吧。[l]\n「对认真的你来说那个人的命令是绝对的才对吧」"],["「今が大事な時期という自覚はおありなんですね」","「看来您也自觉现在正是重要时期呢」"],["「あんた達にとってはって意味でね。[l]\n私には関係ない」","「对你们来说是这个意思啦。[l]\n与我无关」"],["「そうでしょうね。[l]\n克杖はそろそろ結果が分かるので置いてきました。[l]\n私もすぐ帰ります。卑尊さんのところに」","「也是呢。[l]\n克杖那边很快就能知道结果了，所以先让她待着。[l]\n我也马上要回去。去卑尊那儿」"],["冬夏が何故かそこで、開いている方だけだが──眼を剥いた。","冬夏不知为何突然瞪大双眼——虽然只有睁着的那只眼。"],["「……キサマ」","「……你这家伙」"],["「まだ、\nどっちかは分かりませんので、\n私が役に立てるかどうかは」","「还、\n不知道是哪边呢、\n我能不能派上用场」"],["なんだ？[l]\n何の話をしてるんだ？[l]\n狩屋の結果？","啥？[l]\n在说什么啊？[l]\n狩屋的结果？"],["だが、僕は黙って視てるしかない、\nとても入り込める空気じゃない──","但我只能沉默地看着、\n根本插不进话——"],["「………そろそろ結果が？」","「………快出结果了？」"],["「こういうのは１０割言い切れませんので、\n私も目安、予定予測を聞いてるだけです。[l]\n貴女が家を空けてる間にも、\n時間も、事態も進んでるんです。","「这种事没法说十成把握、\n我也只是听个预估预测。[l]\n在你离开家的时候、\n时间和事态都在推进。"],["全ては常に動いていて、\nその場に留まりたければその倍動かねばなりません。[l]\n全ては、\n全てはサイコウノ──」","一切都在不断运动中，\n若想停留在原地就必须以双倍速度奔跑。[l]\n一切都是，\n一切都是最棒的──」"],["「わかんないこと話してんじゃないっ！！」","「别在这说些听不懂的话！！」"],["──冬夏が激昂した。","——冬夏暴怒了。"],["僕は硬直して、\n背筋を怖気が走る。[l]\n全身が冷や汗で濡れて気持ち悪い。","我僵在原地、\n脊背窜过一阵战栗。[l]\n浑身冷汗黏糊糊的真恶心。"],["姫様ちゃんも様子が変だ。[l]\nこんなにも冬夏を挑発……挑発にしか視えない、[l]\nそんな事をする","姫様也不太对劲。[l]\n这么明显地挑衅冬夏……根本就是在挑衅、[l]\n会做这种事"],["娘なのか？","的姑娘吗？"],["相手が冬夏だからか？[l]\nだから冬夏は姫様ちゃんがきらいなのか？","因为对方是冬夏？[l]\n所以冬夏才讨厌姫様？"],["どっちが、\nどっちを、\nどう思ってこうなってるんだ？","到底是哪边、\n到底对哪边、\n怀着什么想法变成这样的？"],["ああ、","啊啊，"],["首が熱い。","脖子发烫。"],["「冬夏さんは判らないんですか。[l]\nこの人がなんなのか、","「冬夏小姐不明白吗。[l]\n这个人究竟是什么、"],["私達八相の","我们八相的"],["少","少"],["女が、\n何のために今まで居たのか、\n今、この時にこの場に揃うのは何故か──」","女人、\n至今为止存在的意义、\n为何此刻会齐聚于此——」"],["このひと？","这个人？"],["「判るもんかっ！[l]\nあんたに視えるものなんか視たくもない！！[l]\nあんたが信じるものなんか信じたくもない！！","「明白个鬼！[l]\n谁要看你能看见的东西！！[l]\n谁要信你相信的东西！！"],["知ったことか！！！[l]\n知らない！！！[l]\n知らないってば！！！","关我屁事！！！[l]\n不知道！！！[l]\n说了不知道啊！！！"],["あんたなんか、あんたなんか早く帰りなさい！！！[l]\n帰れ！！！」","你这种人、你这种人赶紧回去！！！[l]\n滚！！！」"],["僕がなんだっていう？","我能说什么？"],["「そうですか。[l]\n統領の血を継がされながら、\n実のところは第二相の分際である貴女達三春には、\n所詮荷が勝ちすぎる事でした、ね」","「这样啊。[l]\n虽继承了统领之血、\n实则不过是第二相分际的你们三春家、\n终究是负担过重了呢」"],["「そんな序列なんて知らないってば！[l]\nそんなものはどうだっていいんだ！[l]\nそんなのためになんでもするあんたたちとはちがう！！[l]\nこのひとは──」","「说了不知道什么序列！[l]\n那种东西怎样都无所谓！[l]\n和你们这种为达目的不择手段的家伙不一样！！[l]\n这个人——」"],["僕の方を振り向いて止まる、\n僕にも視えることを、\n姫様ちゃんに言いたくないのか。","转身朝我停下脚步，\n明明连我都能看见的事，\n却不想告诉姫様吗。"],["僕は、\n僕は、\n僕は、","我，\n我，\n我，"],["……僕は？","……我？"],["「てっきり私は、\nこの人の事が判っていて近づいたのかと――\nやはり買い被りすぎというものでした」","「还以为我是、\n看透了这个人才接近的――\n果然是高估了呢」"],["話し方は平坦で冷静だが、否、だからこそ、\n姫様ちゃんは明らかに挑発──\nつまり冬夏に対して悪意の籠もった言を吐き続ける。","语气平淡而冷静，不、正因如此，\n姫様显然是在挑衅──\n持续对冬夏释放着充满恶意的言语。"],["僕は、\nどちらの肩入れをするでもなく、\nただ","我，\n既不偏袒任何一方，\n只是"],["只","只"],["管に居たたまれなくなって、\n思わず声を発した。","在管中待不下去、\n不由得发出了声音。"],["「ま、待ってくれ二人とも、とにかく落ち着いてくれ、\n何の話かさっぱりだけども、まず――」","「等、等等你们两个，总之先冷静下来、\n虽然完全搞不清状况，但首先――」"],["「前から話そうとしていたこと、\n丁度良いので今、話します。[l]\n克杖には後で話ますので」","「之前就想说的事、\n现在正好告诉你。[l]\n克杖那边我会稍后说明」"],["「え、は？」","「诶，啊？」"],["「なんのこと？」","「什么意思？」"],["「真言さんからはトーノニオイがする」","「真言身上有股托诺的味道」"],["……？",""],["「……トオノ？」","「……托诺？」"],["とうの？透の？遠野？","透野？远野？"],["──トーノ？","──托诺？"],["冬夏も何事か把握できてないようだった。[l]\n僕も何のことかさっぱりわからない、\nそんな僕等を余所に、\n姫様ちゃんは淡々と続ける。","冬夏似乎也没搞清楚状况。[l]\n我也完全不明白怎么回事，\n就在我们一头雾水时，\n姫様继续淡淡地说道。"],["「でも。[l]\n私達の様な魔眼の者というより、\nアヤメやミハルのような、そうですね、ベロアに\nとても近い」","「不过。[l]\n与其说是像我们这样的魔眼持有者，\n不如说更像阿娅梅或米哈尔那种，嗯，非常接近\n贝萝娅的存在」"],["「……やめろ、キサマ。[l]\n黙れ。[l]\n意味分かんないし」","「……住口，你这家伙。[l]\n闭嘴。[l]\n根本听不懂」"],["「な…何を云ってるんだよ姫様ちゃん？」","「你...你在说什么啊姫様？」"],["マガン？","魔眼？"],["魔眼……か？","魔眼……吗？"],["アヤメ、とは恐らく綾目、彼女の家のネコガミ、","阿娅梅应该是指绫目，她家的猫神、"],["だが、……ベロアとは？","但是，……贝萝娅是？"],["「あなたがねこのようにみえます」","「你看上去像猫呢」"],["──。",""],["───？",""],["「な──んて言ったの？[l]\nよくわからな」","「你刚──说什么？[l]\n完全不明白」"],["「貴方はトーノイーハなんでしょう？」","「你是托诺·伊哈对吧？」"],["っ！","呃！"],["首が、","脖子、"],["くすぶるように、","像灼烧般、"],["熱くて、","发烫、"],["「違うんですか、いとしいひと──」","「不是吗，亲爱的――」"],["それどころじゃ、","现在不是纠结这个的时候、"],["「意味分かんないっ！！！もう、[l]\n喋るなって云ってるんだぁっ！！！！！！！！」","「听不懂啊！！！都说了、[l]\n给我闭嘴啊啊啊啊啊啊！！！！！！！！」"],["のうがくうてんする、","脑袋嗡嗡作响、"],["「冬夏ちゃん、\nもう少し話し方に気をつけないと駄目だよ、\n御嬢様なんだから」","「冬夏，\n说话要注意分寸才行，\n你可是大小姐啊」"],["そ、の、台詞は──","那、句、台词是――"],["「………ぁ」","「………啊」"],["「私が怒られる」","「该生气的是我」"],["「………っ、」","「………」"],["「懐かしいですね。[l]\n昔はよくこうして──」","「真令人怀念呢。[l]\n以前经常这样──」"],["「きー、ちゃ、ん？」","「姬、样？」"],["それは、","那时候，"],["「？！」",""],["あのときだれがいたっけ？","都有谁在场来着？"],["「冬夏さんもミハルに訊いてみるが善いのに。[l]\nこの人に惹かれる懐かしさがワカルはずなのに。[l]\n冬夏さんが、のぎかさんに黙ったままミハルをツいだのも知ってますよ。","「冬夏小姐也该去问问米哈尔才对吧。[l]\n明明能理解被这个人吸引的怀念感才对。[l]\n我也知道冬夏小姐瞒着希香小姐偷偷饲养米哈尔的事哦。"],["あのひとには言ってませんから安心してください。[l]\nあのひとは言わなければ気付かない程度の小物だもの。[l]\nそれに貴女だって、この」","因为没告诉那个人所以请放心。[l]\n毕竟那个人迟钝到不说就不会发现这种小事的程度。[l]\n而且您自己不也——」"],["のぎかさん……冬夏の母さんに黙って……？","希香小姐……冬夏的母亲也瞒着……？"],["「し、らないっ！[l]\n私は私の意志でまことさんを好きなの！！[l]\n私以外の何かの所為なんかじゃないっ！！！」","「才、才不是！[l]\n我是凭自己的意志喜欢真言先生的！！[l]\n绝不是受其他任何因素影响！！！」"],["冬夏を蔑むように眼を半眼にすると、\n僕の方を向いて姫様ちゃんが言う、","当姫様用轻蔑的眼神半眯着眼看向冬夏时，\n转向我这边开口说道，"],["「まことさん、このひとは何も分からないんです。[l]\n今ののぎかさんと同じようにご先祖が、\nとても低能であらせられたので」","「真言先生，这个人什么都不懂。[l]\n就像现在的希香小姐一样，\n她家的祖先也愚蠢得令人发指」"],["姫様ちゃんが僕のすぐ眼の前に立つ、","姫様站到离我极近的位置，"],["そして、頸を、ぼくのくびを──","然后，把脖颈，我的脖颈——"],["「姫様ぁ！[l]\nうるさい！！[l]\nいいかげんにしろ！！！[l]\nまことさんから離れろ！！！」","「姫様！[l]\n吵死了！！[l]\n给我适可而止！！！[l]\n快从真言先生身边离开！！！」"],["姫様ちゃんはゆるゆると僕の頸に両手を、","姫様酱慢悠悠地将双手环上我的脖颈，"],["「冬夏さんのいう『好き』がどれだけ脆弱なのか、\n本人も知ってて誤魔化してるのか、\n私の知る所ではありませんが、\nそれとあなたは無関係ですし」","「冬夏小姐所说的‘喜欢』究竟有多么脆弱，\n是本人心知肚明却故意蒙混，\n这我并不清楚，\n但与你毫无关系」"],["そして上目遣いに僕を視て、","接着抬眼凝视着我，"],["「まことさん、\nいま、わかりました、\n鈴が付けられていたのですね」","「真言先生，\n现在，我明白了，\n原来挂着铃铛呢」"],["と言うや、","话音刚落，"],["ぶつ。","咚。"],["何かが千切れる音がして──","某种撕裂声响起──"],["「……ぅわああああああっ！！！」","「……呜啊啊啊啊啊！！！」"],["くすぶっていた、","闷燃着的，"],["熱く、","滚烫，"],["熱い、","炽热，"],["走馬燈のようなめまぐるしい感覚、\n怒濤のようになにかが、","走马灯般天旋地转的感官，\n怒涛般汹涌的某种东西，"],["「んむ？」","「嗯唔？」"],["「……斬られた？」","「……被斩了？」"],["「prot-ein:Chokerが無効化……否、[l]\nハカイか？」","「prot-ein:Choker失效……不，[l]\n是HAKAI吗？」"],["「のようですね。[l]\nただ、あくまで緩衝器のようなものですし、\nChokerの失効自体は急を要する事態では\nありません、\n問題はそのシチュエーションで──」","「好像是这样呢。[l]\n不过，说到底只是个缓冲器之类的存在，\nChoker失效本身并非紧急事态\n，\n问题在于那种情境下──」"],["？？？",""],["？？！",""],["？！！",""],["！！！",""],["な、ば、","啊、呃、"],["やはり、姫様ちゃんも、","果然，姫様也是，"],["「私もアヤメもほら、\n視えるでしょう。[l]\n私達は――\nあなた、のものです」","「我和阿娅梅你看\n都能看见吧。[l]\n我们是――\n属于你的存在」"],["このこもわたしもまことさんと、","这孩子和我都想和真言"],["「ひとつになりたがってる――」","「融为一体――」"],["何か言ってるのがきこえるが、\nもうそれどころではなくからだがあつくてたまらぬのだ","能听见他们在说着什么，\n但已经无暇顾及因为身体热得受不了"],["「四重奏団とGWの件もあるし、\nいよいよ決めなきゃいけないか。[l]\nまあ、決めさせてあげてもいいが……」","「还有四重奏团和GW的事\n差不多该做决定了吧。[l]\n嘛，让你来决定也行……」"],["「一応準備その他に時間を要しますのでね、\n帰ってきたら","「毕竟还需要时间准备其他事项，\n等回来后"],["暫くは……[l]\nそうですね、週明けを目処に、\nそれまでは」","暂时……[l]\n这样吧，以下周为期限，\n在此之前」"],["「カゴに入れておく、ね。[l]\n知狡にキリアケの準備急がせて」","「先关进笼子里吧。[l]\n让知狡赶紧准备雾明」"],["「……了解しました」","「……明白了」"],["「ああもう、\n兄様","「啊啊真是的，\n哥哥"],["赦してくれるかなぁ？」","能原谅我吗？」"],["「それは勿論、」","「那是当然，」"],["ぱぁん。","啪。"],["「、……これ以上何かしたら赦さない」","「……再敢做多余的事绝不饶恕」"],["眼を真っ赤にし、\n冬夏が姫様ちゃんの頬を張った。","双眼通红地，\n冬夏扇了姫様一耳光。"],["その音で、","那声响让"],["僕も我に返った。","我也回过神来。"],["からだは……なんともない。","身体……倒没异常。"],["あたまも、混乱はしてるがだいじょうぶだ。","脑子虽然混乱但还撑得住。"],["だが、","可是，"],["宮さんから貰ったお守り、","宫小姐给的护身符、"],["チョーカーが……","项圈……"],["「…ごめんなさい」","「…对不起」"],["「……………帰りなさい。[l]\n●●●●しが」","「……………回去吧。[l]\n●●●●欲」"],["「え？」","「诶？」"],["何て言った？","刚才说什么？"],["「分かりました。[l]\n言う通り帰ります。[l]\nでは冬夏御嬢様、\n最後にお伝えしておきますが」","「明白了。[l]\n这就按您说的回去。[l]\n那么冬夏大小姐，\n最后再提醒您一句」"],["「………」",""],["「貴女自身が言った通り、\n貴女がどうなろうと正直私はどうでもいいんですけれど、","「正如您自己所说，\n您变成怎样我其实无所谓，"],["真言さんの為にも、\n前言いましたけど、\n祭儀には出て貰う。","但为了真言先生，\n虽然之前提过，\n请务必出席祭仪。"],["祭儀１週間前までに戻らなければ……分かってますね？」","若祭仪一周前未归……您懂的吧？」"],["「これ、最後通牒です。[l]\n逆に言えば何事も無くお戻りになれば、\n何の問題もありませんから。[l]\n勿論私もそれを望みます」","「这是最后通牒。[l]\n反过来说只要平安回来，\n就不会有任何问题。[l]\n当然我也希望如此」"],["最後通牒……？","最后通牒……？"],["道具さんの言っていた、","道具小姐提过的，"],["手荒な手段──","强硬手段──"],["まさか、ネコガミとは、","难道猫神和"],["アヤメとは、","阿娅梅都"],["「まことさん、ではまたです。[l]\n克杖のことも──冬夏さんも、\n……まだ、なにも視えてないようなので。[l]\nよろしくおねがいします」","「真言先生，后会有期。[l]\n克杖的事──冬夏小姐也，\n……看来还什么都没察觉到。[l]\n拜托您了」"],["@r姫様ちゃんはいつものように、\nはにかむかのように、恥じらうように、\n僕に向かってそう言って、","@r姫様像往常那样，\n带著腼腆羞涩的神情，\n对我说完这句话后，"],["@r冬夏を","@r瞥了"],["一",""],["瞥して、また山を独り降りていった。","冬夏一眼，独自下山去了。"],["@r………、",""],["@r僕の為とはなんだ？","@r为我又是什么意思？"],["@rトーノイーハとはなんだ？","@r托诺伊哈是什么？"],["@r僕がネコガミを視られるのと関係がある？","@r我能看见猫神与此有关？"],["@r……動悸がまだ激しい。","@r……心跳仍旧剧烈。"],["@r冬夏は、\n肩を上下させ、\n顔を覆ってしゃがみ込んだ。","@r冬夏\n肩膀颤动著，\n捂脸蹲了下去。"],["@r僕は千切れたチョーカーを拾い上げ、","@r我捡起断裂的项圈，"],["@r──何故だ。","@r──为什么。"],["@r僕が感じているこの感情は、","@r我所感受到的这种感情，"],["@r昂揚感？","@r亢奋感？"],["@rいや、なんだ？","@r不，是什么？"],["@r混乱はしているが、\nあってしかるべきマイナスの感情が、\n冬夏への同情すらも、\nいや、決して、何も感じない訳じゃない、","@r虽然很混乱，\n本应存在的负面情绪，\n甚至对冬夏的同情，\n不，绝不是什么都感觉不到，"],["しかし、\nどちらかといえば、\n昂揚ですら、","但是，\n硬要说的话，\n连亢奋，"],["そう、平坦だ、\nフラットなんだよ、\nこころがたいらなんだよ。","对，是平淡的，\n是平坦的啊，\n内心是平坦的啊。"],["「きっ……！[l]\nと、きっと、ショック状態なんだ、\nそうだ、そうだよな、","「呜……！[l]\n一、一定是受到冲击了，\n没错，肯定是这样，"],["おかしい、おかしい、こんなのは……[l]\n冬夏っ」","不对劲，不对劲，这种事……[l]\n冬夏」"],["声に出して自分に言い聞かせ、\n冬夏の元へ走った。","我出声说服自己，\n朝冬夏跑去。"],["「……くしょう、ちくしょう……」","「……可恶，该死的……」"],["「冬夏、」","「冬夏，」"],["──なにも言葉がない、","──什么话都说不出来，"],["なんていえばいい？","该说什么好？"],["「………ごめん。[l]\n最悪……最悪だよね、あんな姿、私、[l]\n最悪……」","「………对不起。[l]\n最糟……最糟了对吧，那种样子，我，[l]\n最糟了……」"],["「大丈夫、気にしてない……[l]\nネコガミ……ミハル紹介されたよりは、[l]\n驚いたけど……」","「没关系，我不在意……[l]\n猫神……比起被介绍的米哈尔，[l]\n虽然很吃惊……」"],["「……ぷっ、[l]\nあはは、あはは……」","「……噗，[l]\n啊哈哈，啊哈哈……」"],["「……うん」","「……嗯」"],["「……やっぱ真言さんだ、ね……[l]\nん、それ、いいよ……[l]\n冗談でも本気でも……","「……果然是真言先生呢，[l]\n嗯，那样，挺好的……[l]\n不管是玩笑还是真心……"],["私にとっては、\nプラス要因、だもん」","对我来说，\n都是积极因素嘛」"],["「私、こんな人間なの。[l]\nだから──」","「我就是这样的人。[l]\n所以──」"],["感極まる冬夏を視て、\n僕にもまだヒトを思いやる感情があることを確認するように、","看着情绪激动的冬夏，\n仿佛要确认自己仍保有体恤他人的感情，"],["──そうでもしなけりゃこの奇妙な程冷静な感じが自分でも恐ろしいから、声をかけた。","──不这么做的话连自己都会害怕这种异常的冷静，我开口了。"],["冬夏の独白を遮るように、\n彼女に言った。","像是要打断冬夏的自言自语，\n我对她说。"],["「いいよ、大丈夫、\n誰にだってある、","「可以了，没关系，\n谁都会有的，"],["表だって裏だって、\n僕にだって、\nだから、そんなことで冬夏を嫌ったりしないから」","表面也好背面也好，\n就连我也有，\n所以不会因为这种事讨厌冬夏的」"],["──ケレド、","──虽然，"],["「……ん、[l]\nん、\nん。","「……嗯，[l]\n嗯，\n嗯。"],["……ごめん。[l]\nだいじょぶ。[l]\nもうだいじょぶ。[l]\nこんなことで止まってらんない」","……对不起。[l]\n没关系。[l]\n已经没关系了。[l]\n不能因为这种事停下脚步」"],["「……何か、[l]\n食べようか。","「……要不要，[l]\n吃点东西。"],["個人的な経験だけど、\nお腹が減ると、\n感情って簡単に揺らぐから……」","虽然只是个人经验，\n肚子饿的时候，\n感情很容易动摇……」"],["「そだね。[l]\nうっし！！","「是啊。[l]\n好嘞！！"],["じゃ、\n買ったやつ食べよ。[l]\nはい！そうしよう！」","那、\n把买的东西吃掉吧。[l]\n嗯！就这么办！」"],["@rそして、","@r然后、"],["@r姫様ちゃんと帰路を一緒にはなりたくかろうな、\nというのを無言のうちに察して、\n僕等は此処でこのまま少しの間、時間を潰すことにした。","@r大概姫様酱也不想和我同路回家吧、\n在无言中察觉到这点、\n我们决定就这样在这里消磨一会儿时间。"],["@r２人とも、空回りした会話を続けて、\n……実際、実のある事、話す事は無かった。","@r两人继续着空洞的对话、\n……实际上，根本没什么实质性内容可聊。"],["@rネコガミの事も、\n冬夏と姫様ちゃんの事も、\n姫様ちゃんが言っていた僕の事も。","@r关于猫神的事、\n冬夏和姫様酱的事、\n还有姫様酱提到的关于我的事。"],["@r一瞬無言の間が出来たとき、","@r当短暂的沉默降临时、"],["@r隣り合って座っていた冬夏が僕の肩に顔を押しつけて、","@r并排坐着的冬夏把脸埋进我的肩膀、"],["@r多分泣いてる。","@r大概在哭。"],["@rでも、","@r但是、"],["@r僕は黙って身を任せるしか、任させるしかなかった。","@r我只能沉默着任由她，也只能让她这样依靠。"],["@rどんな言葉も、","@r任何言语、"],["@rどんな行為も、","@r任何举动、"],["@r僕から冬夏にすることはなかった。","@r我都无法对冬夏做。"],["@rできなかった。","@r做不到。"],["@r僕は、","@r我只想、"],["\n早く、","\n快点、"],["\n宮さんに、アイ──","\n见到宫小姐，见到爱──"]],"context":[["SC_M_047.ks/index/1/text"],["SC_M_047.ks/index/3/text"],["SC_M_047.ks/index/5/text"],["SC_M_047.ks/index/7/text"],["SC_M_047.ks/index/9/text"],["SC_M_047.ks/index/11/text"],["SC_M_047.ks/index/13/text"],["SC_M_047.ks/index/15/text"],["SC_M_047.ks/index/17/text"],["SC_M_047.ks/index/19/text"],["SC_M_047.ks/index/21/text"],["SC_M_047.ks/index/23/text"],["SC_M_047.ks/index/25/text"],["SC_M_047.ks/index/27/text"],["SC_M_047.ks/index/29/text"],["SC_M_047.ks/index/31/text"],["SC_M_047.ks/index/33/text"],["SC_M_047.ks/index/35/text"],["SC_M_047.ks/index/37/text"],["SC_M_047.ks/index/39/text"],["SC_M_047.ks/index/41/text"],["SC_M_047.ks/index/43/text"],["SC_M_047.ks/index/45/text"],["SC_M_047.ks/index/47/text"],["SC_M_047.ks/index/49/text"],["SC_M_047.ks/index/51/text"],["SC_M_047.ks/index/53/text"],["SC_M_047.ks/index/55/text"],["SC_M_047.ks/index/57/text"],["SC_M_047.ks/index/59/text"],["SC_M_047.ks/index/61/text"],["SC_M_047.ks/index/63/text"],["SC_M_047.ks/index/65/text"],["SC_M_047.ks/index/67/text"],["SC_M_047.ks/index/69/text"],["SC_M_047.ks/index/71/text"],["SC_M_047.ks/index/73/text"],["SC_M_047.ks/index/75/text"],["SC_M_047.ks/index/77/text"],["SC_M_047.ks/index/79/text"],["SC_M_047.ks/index/81/text"],["SC_M_047.ks/index/83/text"