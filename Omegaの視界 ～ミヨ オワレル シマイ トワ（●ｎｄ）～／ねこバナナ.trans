],[{"start":10250,"end":10257}],[{"start":10288,"end":10298}],[{"start":10328,"end":10359}],[{"start":10390,"end":10486}],[{"start":10539,"end":10550}],[{"start":10615,"end":10620}],[{"start":10668,"end":10707}],[{"start":10827,"end":10882}],[{"start":10918,"end":10927}],[{"start":10974,"end":10999}],[{"start":11055,"end":11066}],[{"start":11115,"end":11187}],[{"start":11221,"end":11225}],[{"start":11231,"end":11236}],[{"start":11281,"end":11291}],[{"start":11404,"end":11413}],[{"start":11443,"end":11459}]],"encoding":"shift-jis","detectedEncoding":"shift-jis","filename":"SC_M_071.ks","basename":"SC_M_071.ks","indexIds":{"「……」":0,"ざぁ…………っ………":1,"びゅお………おぅ……":2,"ひぃーーーー………":3,"「……ふっ」":4,"じゃじゃじゃじゃじゃりっ！":5,"「……やっと来た」":6,"しゅるるるるるるるっ":7,"「……何してたの」":8,"「ああン？[l]\nてめェに教える義理ァねェだろ。[l]\nそれにまるでこっちを待ってたみてェな物言いじゃねェかよ」":9,"「……待ってたし、探してた」":10,"「んだと？」":11,"「邪魔者は早急に、排除しなきゃいけないから」":12,"「はァん」":13,"じゃっ。":14,"「……おまえが、[l]\n母様達を●●たんでしょ」":15,"「………。[l]\nだから？[l]\nてめェの口からそういう事が言えンのかよ。[l]\n俺を責められンのかよ？」":16,"「……おまえは……あのひとと同じ感じがするくせに……[l]\n私達と同じ感じがするくせに……[l]\nどこかが全然違う……[l]\nなんなんだおまえ、\nそれが、そこが●●●●い──」":17,"「あ？[l]\n何つった？[l]\nまーいいやさ。[l]\nこちとら動くたんびに腹ァ減るからよぅ、\nとっととおッぱじめるか、\n":18,"お":19,"食":20,"事":21,"会をさ」":22,"「……今まで他のみんなの所に居たんじゃないの……？」":23,"「そのつもりだったけどな。[l]\nまずは独り、ピンポイントで狙った奴が居たが、\nそしたらそいつァ、手ぶらでいやがった。[l]\nこの祭ァ人もカミも揃うってェから来たのによ、\n何で持ってネェんだッ！[l]\nま、俺だってな、\n不味いもんは好き好んでクイたくはねェ、\nがたがた震えて使いモンになんなくなってたから、\n放ってきたが──」":24,"「……誰のこと……？」":25,"「ミにもならねェモノ喰ってももたれるだけだかンな。[l]\n危うくあン時と同じ、無駄骨折るとこだったぜ」":26,"「……あの時と、同じ……？[l]\n無駄骨……？」":27,"「つーわけでだ、\nそいつのカミ、\n誰が持ってったか、知ってたら言いな」":28,"「……おまえが知る意味、ない」":29,"「あァ？[l]\n調子乗ンじゃねェぞ。[l]\n面倒手間さえ気にしなけりゃ、\n自力で必ず探し出すだけの話だぞこら。[l]\n腹減ると頭空転すっからな、\n最強苛ついたテンションでてめェなぶるってんだこっちは。[l]\nそれが厭ならとっとと言えってのさ。[l]\nま、\n……知らねェなら御愁傷様だわ。[l]\nてめェは──持ってるな？」":30,"「………」":31,"「まァその":32,"態視りゃ聞くまでもねェわな。[l]\n知ってるのとは大分違ってるが、\nもし強くなってンなら俺にとっては好都合だわ。[l]\n大人しく、\n喰われ──」":33,"「……るぃ……厭だ……」":34,"「？[l]\n震えてンのか」":35,"「おまえは……気持ち悪い……[l]\n気持ち悪いぞおまえ……[l]\n何でだ……？[l]\n何でこんなに……おまえが……[l]\n厭だ……おまえは厭だ……私はおまえが厭だ……[l]\nあのひとに……[l]\nまことさんに……まとわりつくな……！！！！」":36,"「あ？」":37,"ざっ！！":38,"「…ッ！[l]\nはや、」":39,"ひぃーーーーーー……よぉーーーーー……":40,"「……●●してやる、●●して、●●して、──」":41,"「……イヤな音立てやがる、[l]\nクソが、\nこの鎖つかうのも腹減るっつのに、\n余計な──おわっ！！！」":42,"じゃっ！！":43,"「ひゅっ」":44,"「ってあっくっ」":45,"ざん！！":46,"「っんだコイツ、\n普通じゃねぇッ──って、あ？」":47,"「ほぅっ」":48,"じゃぐり、じゃばっ、":49,"「っ、っ、ッぶねぇっ」":50,"「ち、こないだのコイツがあってっ、\n良かったぜ、っ、ぐ、おおおおらああああ、\nあぁっ！！！！！！」":51,"ぶぅん！！！":52,"ざさっ、ばきばきばきばき……":53,"「くそが……[l]\nあの":54,"刃に触るのは避けてぇし、\n面倒くせェなぁもう！！[l]\nさァて、\nどこいきやがっ」":55,"ぎぃぃいっぃぃいぃいぃいいいいいいん。":56,"「？[l]\n？[l]\nあっ、\n上か！！」":57,"「………あぁヤァメぇ……っ[l]\nい………ってぇ………っ」":58,"「……に、にぎぎぎぎぎぎぎっぎぎぎ！！！！！！」":59,"かふぁ。":60,"「！[l]\nふっくっ」":61,"ひゅっ、":62,"ざっ。":63,"「……ちっ、[l]\nいくらか削られたかっ」":64,"「……気持ち悪い、気持ち悪い、[l]\n気持ち悪い気持ち悪い気持ち悪いきもちわるい……っ」":65,"「ああもう、こんなじゃどんどん腹減るわ……[l]\nてめェさえ、\nてめェさえ攻略すりゃ、\n他の連中なんざただの」":66,"びゅ！！！":67,"「っっっ！！！！？？？[l]\nきゃぁあああっ」":68,"どぉーーーーーーーーん………":69,"「畜生……刺さらなかった……っ」":70,"「……ってェな……[l]\nいってええなああ、\n痛ってえええええええええだろおおおが\n！！！！！！！！！！！！」":71,"ぶわ！":72,"「…」":73,"「人が話してる時になんてことしやが」":74,"「関係ないし」":75,"「……また──刺さらないし……」":76,"しーーーーーーーーん………":77,"ざわざわざわ……":78,"「………あ……[l]\nタマズサ……無くなってたら……[l]\n後処理どうするんだろう……」":79,"「まあ……いいか……跡形もなく……[l]\nいえ……あのひととひとつになればそんなことすら」":80,"ざわ……":81,"「……はやく終わらせよう……[l]\nこんな茶番……面倒なだ……け……？」":82,"ざわ、":83,"「……？[l]\n………、[l]\n……？[l]\nおまえ、おん──」":84,"「……なにさ？[l]\n私、なにかおかしい？[l]\nそんなに、\nじっと視やがって、」":85,"\n\n\n\n\n　　失礼なやつなのだわ。":86,"「？！、[l]\n？！」":87,"しゅるるるるる、":88,"ぎりりりりりりりりりりり……":89,"「──こういうの、なんつったけな？[l]\n詰み？[l]\nチェックメイト？[l]\nいいかげん腹減りも度が過ぎてさ、\nよくわからないんだわ」":90,"「ぎ、ぎぎぎぐぐぐぐ」":91,"「……まあどっちでもいいわさ。[l]\nこれで、もう、シマイだわなァ。[l]\nあん時の奴らのコレも、役に立つじゃんよ。[l]\nやられた時ゃムカっとしたが」":92,"「ふんっ！！[l]\nふぅあっ、ぐうううううううううう、\nああああああああああ！！！！！！！！！！」":93,"「さぁ、さっき喰い損ねてこちとら、\n相当オツムにキてンだよッ、\n覚悟はいいか、てめぇのその腕ごと、\nカミぁ貰うぜ。[l]\n運がよけりゃぁ、\n死なずに済むだろ、\n事が済む前でも後でも──抵抗しねえ":94,"場":95,"合わぁ、\nだけどナ」":96,"「ぎぎぎぎぎっぎぎぎ、あぐう、ああああぐうううううう！！[l]\nた、た、あああ、」":97,"「……もうこっちもつかれてっから……[l]\n余計な手間取らすナヨ。[l]\nにしたって、\n残りの連中も薄情なこった、ナア？」":98,"かふ、":99,"「ぁあアーーー」":100,"「AAAhiiioooooppppprsssstt（はこたちきりすかしのくちなわ）！！！[l]\nミをすててこそうかぶせもあれそはいまぞ、\nじラドばくラドのとうやのに、[l]\nしき！！！！！！！！！！」":101,"「──ァ？」":102,"ばぎん、":103,"「ひぎっ！！！！！！！！！！」":104,"ばしゅあああああ………":105,"「ナ…ンだと？[l]\nバ──、\nばかかてめェは、\nそんなに、」":106,"「！！！！、[l]\nっ！！！！、[l]\n………っっっ！！！！！！」":107,"「……んなにイヤだってかよ」":108,"「……ぐうう………[l]う[l]う[l]う[l]う[l]う[l]う……」":109,"「当て付けか？[l]\nどうせ今から、すぐ探してみっけるだけだぞ。[l]\nそんなことに、\nそこまでする意味ァ──」":110,"「……まえは……ヤだ……[l]\n…ことさんの……っ！[l]\nぐううううううぎぎぎぎっ、\n……になんか……させっ、させっ、[l]\nるかぁっ！[l]\nさせないっ、\nあぐ、あぎ、いぎぎぎぎぎいぃぃーーーーっっ、\nひふ、ひ、ぃ、はっ、かはっ」":111,"「……関係ねェし」":112,"どしゃっ！":113,"「がっ──は」":114,"「……いいザマだわ」":115,"「はーっ、はーっ、はーっ、\nいっ、ぐぅううううーーー」":116,"「てめェはもう用無しだ。[l]\nムかつくが嬲るヒマもねェし──\n運が良かったなァ、\n放置だてめェは。[l]\nじゃァな。[l]\n独り寂しくそこでクタバレ」":117,"「ふ、ひ、ぎぃっ──」":118,"じゃりっ。":119,"「余計な悪足掻きしやがって……[l]\n飛んでったモノぉ探さにゃぁ……」":120,"「はっ、はっ、はっ、はっ、はっ、\n………ぐぐぐぐっ、ふー、ふー、[l]\nぎっ、ぎぎぎいいいい」":121,"ざわざわざわ………":122,"「……まっ、……と、さん、[l]\n……？」":123,"ざわざわざわざわ………":124,"「まこと、さん？[l]\n……ぐううっ、[l]\nま、ことさんの……か……んじ……、[l]\nま、ことさん、まことさぁ、ん、」":125,"ざわっ…":126,"じゃりっ、":127,"「…………ぐぅっ、」":128,"「……これは──」":129,"「……まことさん………………？」":130},"extension":".ks","lineBreak":"\n","path":"/data/scenario/SC_M_071.ks","relPath":"/data/scenario/SC_M_071.ks","type":"","originalFormat":"KAG's .ks File","dirname":"/data/scenario","indexIsBuilt":false,"progress":{"translated":127,"length":131,"percent":96.94656488549617},"cellInfo":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[null,{"v":1}]],"cacheResetOnChange":{},"lastSelectedCell":[79,1]},"/data/scenario/SC_M_072.ks":{"data":[["「……今更後悔もクソもないけどよ」","「……现在后悔也屁用没有就是了」"],["「なんだ」","「怎么」"],["「どんな事情があろうとも、\nこういうのは苦手……ってか、[l]\n尻の据わりが悪いっつーのか？[l]\nいや、事情はわかってんだけどさ」","「不管有什么理由、\n这种事儿我不擅长……或者说、[l]\n屁股坐不住的感觉？[l]\n不、理由我是明白啦」"],["「まあな。[l]\nだが事情も事情、\nオトナの事情って奴だな。[l]\n込み込み覚悟の上だろう」","「是啊。[l]\n但理由归理由、\n所谓大人的理由嘛。[l]\n早就做好心理准备了吧」"],["「その深ぇ事情がなぁ……[l]\nGM様の言うことをどうこうってワケじゃないけど」","「那深奥的理由啊……[l]\n倒不是说要对GM大人的话指手画脚」"],["「そうさな……[l]\nま、そうでなくても思い起こせば、\npatron（後ろ盾）が変わるなんて事は、\n永い事無かったからな。[l]\n落ち着かない気持ちは分かる」","「是啊……[l]\n嘛、就算不是这样回想起来、\npatron（靠山）更换这种事、\n很久没发生过了。[l]\n心神不宁的感觉我能理解」"],["「そんな安穏とした感想で済むかよ。[l]\n……ああ、[l]\n●●になるってのは気分がよくねーなあ。[l]\n何よりも、」","「怎么可能用这么轻松的感想就带过。[l]\n……啊啊、[l]\n变成●●的感觉真不爽啊。[l]\n比什么都、」"],["「今、必須フラグも立てない内に、\n……出喰わそうものなら、[l]\n全てはおじゃんだろうな。[l]\nさりとて旗を立てるは我々の役割じゃない。[l]\nまだ、\n大人しくしなければならない時なのに──」","「现在、连必须旗帜都还没竖起的时刻，\n……要是贸然出手的话，[l]\n一切就完蛋了吧。[l]\n但话说回来竖旗也不是我们的职责。[l]\n明明还、\n是必须保持安静的时刻──」"],["「Ironがまたぞろどっかに消えたってか」","「听说Iron又不知跑哪儿去了」"],["「いや、一応行き先も用件も承知してる、\n前のように失踪した訳じゃない。[l]\nただ、──」","「不、姑且知道去向和事由，\n不像以前那样是失踪。[l]\n只是、──」"],["「……お嬢をこっちに放置したまんま──ってのぁ、[l]\n面倒な事になりそうだなあ……」","「……把大小姐就这么丢在这儿──这事儿啊，[l]\n感觉会变得超麻烦啊……」"],["だぁーーーーーーっくしゅっぅおあ！！！","哒啊啊啊啊啊——阿嚏！！！"],["「ずずず……風邪っぽいなぁ、[l]\n急に寒くなったりこんな山ん中に連れてこられたり、\n……ストレスマックスくらったりで免疫系も弱まったかっ！[l]\n頭もぼーっとするっ、\nあああああああああ、\n考えんのめんどくせーーーーーーー！！！」","「吸溜吸溜……好像感冒了，[l]\n突然变冷又被带到这种深山里，\n……加上压力爆表导致免疫系统也弱了吧！[l]\n脑袋也晕乎乎的，\n啊啊啊啊啊啊啊，\n思考什么的烦死了————！！！」"],["「……お嬢、もう少し静かにクシャミしなって。[l]\nそれと独り言の方もよ」","「……大小姐，打喷嚏时请再安静点。[l]\n还有自言自语也是」"],["「かんがえっんのめんどきゅせーーーって、\n言ったろいま！！！[l]\nじでーーーっと黙ってたら気が狂う！！！[l]\n折角思う存分遊べると思ったのにっ、\nアイはどっかに行くし風邪引くし待機待機待機言われるしっ、\n結局前と何も変わんねーーーだろおおおが！！！」","「思考什么的烦死惹——\n不是刚说过吗！！！[l]\n要是一直——————闭嘴会疯掉的！！！[l]\n明明以为终于能尽情玩耍了，\n爱又不知跑哪儿去还感冒还被念叨待机待机待机，\n结果根本和以前没任何区别嘛啊啊啊！！！」"],["「……辛抱しなって、今が我慢の為所なんだから」","「……请忍耐，现在正是咬牙坚持的时候」"],["「……こんな、[l]\nこんな、\nこんなうぜーおあずけ耐えれっかよ！？！[l]\n狂う、くるう、くるーーーーーーーーぅあ？」","「……这种、[l]\n这种、\n这种烦死人的等待谁受得了啊！？！[l]\n要疯、要疯、要疯——————了吗？」"],["「？」",""],["「──。[l]\nなんかくる、くる、くるぞ」","「──。[l]\n有什么要来了、要来了、要来了」"],["「なんだと」","「你说什么」"],["「！！！[l]\n旧式っ！[l]\n試作品っ！！[l]\n時代遅れっ！！！[l]\nそこのてめーだっ！！！！！！！！！」","「！！！[l]\n旧型号！[l]\n试作机！！[l]\n过时货！！！[l]\n那边那个就是你！！！！！！！！！」"],["「ば、何で呼び止めるよっ──あ」","「等、为什么叫住我啊——啊」"],["「……うゎ」","「……呜哇」"],["「──随分大きな声がしたと思ったら──」","「──刚才听到超大的动静——」"],["「や──べえぞ、やべぇよな？[l]\nおい──」","「糟——糕了、糟糕了吧？[l]\n喂——」"],["「……あっ、お嬢、待──」","「……啊、大小姐、等等——」"],["「──あの時の、４人……１人いないな……[l]\nどっちにしてもつまりこれは、\n近くに、……」","「──那时候的、4人……少了1个……[l]\n总之这意味着，\n就在附近、……」"],["「っんだその格好はっ？！！[l]\n超だせーな！！！[l]\nちょっと","「靠那什么打扮啊？！！[l]\n土爆了！！！[l]\n稍微"],["面かせ！[l]\nこっち来い！！！」","露个脸！[l]\n给我过来！！！」"],["「……え？」","「……诶？」"],["「こ、いつ、\nほんとに出やがった、\nしかも、」","「这、这家伙、\n真的出现了，\n而且、」"],["「Ｗ－ＭＯｄｅ、だな、前とは違う……というよりも、[l]\n本来の──」","「W－MOde、呢、和之前不同……或者说，[l]\n原本的──」"],["「み、視りゃ分かる、\nでもありゃ、\nな、なんだあれぁ、あのＣＡＴ、知らねーぞ」","「看、看就知道，\n但那玩意儿，\n那、那是什么啊那个CAT、从没见过啊」"],["「今更何しに此処に来たんだっ！！！[l]\nあのまま逃げ腐れてりゃーーー良かったのにっ、\nおめーが出張ると面白くないんだっ！！！[l]\n眼障りなんだよっ、\n邪魔なんだよっっ！！！」","「事到如今你还来这儿干嘛！！！[l]\n像那样夹着尾巴逃跑不就好了——\n你这家伙出场可就不好玩了！！！[l]\n看着就碍眼，\n烦死了！！！」"],["「……ああ、キミは……『後輩』…かな。[l]\nいや、量産型とでも言うべきか──」","「……啊，你是……『后辈』…吧。[l]\n不，或许该说是量产型——」"],["「あにっ？！」","「哥？！」"],["「……あちらさん、[l]\n完全に不機嫌だぞ、\nお嬢、刺激するな……って遅いかぁ……」","「……那位，[l]\n已经完全不高兴了，\n大小姐，别刺激她……不过好像晚了……」"],["「……これも何たらのシナリオ通りって奴かな、[l]\n腹括らんといかんぞこれは」","「……这该不会也是什么剧本安排吧，[l]\n得做好觉悟才行」"],["「……それに体調も良くなさそうだし、[l]\n君こそ帰って寝てたら良いんじゃ、ないかな、\nそっちの２人、そう思わない？」","「……而且你看起来身体也不太好，[l]\n不如说该回去睡觉的是你吧，\n那边两位不这么觉得？」"],["「？！な、」","「？！什、」"],["「……そうできるものならそうしてるが、」","「……能那样的话早就那样了，」"],["「っざけんな！！！[l]\nこちとらここんとこフラストレーションまみれなんだよっ、\n憂さ晴らしだ！！！[l]\nおめーが相手しろ！！！[l]\nその義務があるっ！！！」","「开什么玩笑！！！[l]\n我们这段时间可是积压了一肚子火啊，\n这是泄愤！！！[l]\n你给我当对手！！！[l]\n这是你的义务！！！」"],["「……。[l]\nそんなことより、\nあのひと──宮さんは？[l]\n貴女方が居るって事は、\nこの辺にいるんでしょう」","「……。[l]\n比起那个，\n那个人——宫小姐呢？[l]\n既然你们在这儿，\n她应该就在附近吧」"],["「人の話をきけぇっ！！！[l]\nつーかしらねーよミルハの事なんざ！！！[l]\nボクらが何で此処に居るかわかってねーよーだな、」","「给老子听人说话啊！！！[l]\n谁知道米尔哈那家伙在哪啊！！！[l]\n我们连自己为啥在这儿都不清楚，」"],["「お嬢！[l]\nそこまでだ。[l]\nそこの彼、久しいな、覚えてるぞ」","「大小姐！[l]\n到此为止。[l]\n那边的先生，好久不见，我可记得你」"],["「……それはどうも、[l]\nこちらもそちらのことは──色々と」","「……承蒙惦记，[l]\n我们也对您——记忆犹新」"],["「あっんで邪魔すんだっ！[l]\nもがっ」","「少在那儿碍事！[l]\n放手」"],["「そいつは恐縮。[l]\nで、いきなりですまんが、\nミルハは此処に居ない、[l]\n──否、此処に居るのだろうが、我々は無関係だ、\n詳細は知らない。[l]\nだから、」","「那可不敢当。[l]\n不过突然打断很抱歉，\n米尔哈不在这里，[l]\n——不，或许在但与我们无关，\n详情不知。[l]\n所以，」"],["「このちっこいのの事は無視してくれっか。[l]\n最初の暴言は変わってあたしが謝るから」","「能无视这小不点吗。[l]\n刚才的粗话我替她道歉」"],["「今更もがっ、\n何をぐっ、\nボク等はっ」","「现在才挣扎，\n搞什么鬼，\n我们可是」"],["「なんで懲りねーかなこの御方はっ、\nあの２人も何だって──」","「这位大人怎么就不长记性啊，\n那两人也是凭什么——」"],["「行って──良いのかな？」","「可以——走了吗？」"],["「ああ、そ──」","「啊，请——」"],["「あっぷ、\n待てこら！！！[l]\nサクラもアルコもすっこんでろ！！！[l]\n待て旧式！！！[l]\nボクがてめーを今潰す！！！」","「啊噗，\n给我站住！！！[l]\n樱和阿露子都退后！！！[l]\n停下老古董！！！[l]\n我现在就碾碎你！！！」"],["「いっででで、暴れんな、無茶言うな」","「哇呀呀别闹，别说胡话」"],["「お嬢はソロではどうしようも──」","「大小姐单打独斗的话根本——」"],["「……宮さん相手なら兎も角、[l]\n貴女方を無力化することは、簡単に出来るよ。[l]\n知ってる──[l]んでしょう、僕の事は」","「……若是宫小姐还另当别论，[l]\n但要解决你的话，易如反掌。[l]\n你知道的——[l]关于我的事」"],["「…っな、」","「…什、」"],["「しらねぇーーーーーーーよ！！！[l]\nそれにてめー、ボクが量産型だぁ？！！[l]\n量産型ってのは前例の悪しき部分を改良して出来る、\nより良きもの、デバッグ済み、完成型、\n即ち『正式』なんだっ！！！[l]\nラフな下描きで叩き台の、\n","「不知道啊啊啊啊啊啊啊！！！[l]\n再说了你这混蛋，说老子是量产型？！！[l]\n量产型可是改良前代缺陷部分才诞生的，\n更优秀的、调试完毕的完成品，\n就是所谓的『正式版』啊！！[l]\n区区草稿阶段的试验品、\n"],["没","废"],["書の分際ででけぇ口叩くんじゃねぇよ！！！」","案也敢在这大放厥词！！！」"],["「うーん……[l]\n僕は貴女方じゃなく、\nあのひとに用があるだけなんだよ。[l]\n正直貴女方には興味無いし、\n……舞台裏や楽屋を覗くような気まずい真似も、[l]\n御免だ。[l]\nそっちの２人も、だから多くを語らないんだろうし」","「唔嗯……[l]\n我找的不是你，\n只是和那个人有事要谈。[l]\n说实话对你没兴趣，\n……也不想做偷窥后台化妆间这种尴尬事，[l]\n恕不奉陪。[l]\n那边两位应该也是同样想法才保持沉默的吧」"],["「Deus ex machina風情が殊勝なこと言うじゃねーかよ！[l]\nでもな、\nこっちも我慢の限界なんだっ！！！[l]\nどっちが上か教えたらぁ！！！」","「区区机械降神装什么清高！[l]\n不过啊，\n老子这边也忍到极限了！！[l]\n这就让你明白谁才是上位者！！！」"],["「で……でうすえ、きな？[l]\n──ああ、キカイジカケのカミか。[l]\nそうなら寧ろ幸いだ……」","「机……机械降神？[l]\n──啊，机械装置的神明啊。[l]\n若是如此反倒求之不得……」"],["「この状況でわざわざ事を荒立てんなよっ、\nそもそもコイツは──」","「这种状况就别故意挑事了，\n说到底这家伙──」"],["「テキだこいつはっ！！！[l]\n狩る！狩るんだっ、封じなくともいっくらでも！[l]\n叩きのめしたらぁ！！！」","「是敌人啊这家伙！！[l]\n狩猎！必须狩猎，就算不封印也能无限复活！[l]\n直接揍到趴下就完事了！！！」"],["「お嬢！[l]\n先日も未定義相手にエラー起こしたというに、\n同じ轍を踏む気か、\nいい加減に──」","「大小姐！[l]\n前几天才因为攻击未定义对象引发错误，\n现在又要重蹈覆辙吗，\n适可而──」"],["「",""],["何もかんもアップデートしただろぉが！！！[l]\n丁度いい、アッパー版の実験台だっ、\nいいから離せ──」","早就全部更新过了啊混蛋！！[l]\n正好当高阶版的测试对象，\n快给我松手──」"],["「敵とか味方とか、」","「敌人或同伴，」"],["「！」",""],["「上とか下とか、\nそういうのは君等も、」","「上位或下位，\n这些概念你们不也，」"],["「…」",""],["「蔑むべき価値観じゃなかったっけ？[l]\n永い時間の末に宗旨替えでも……[l]\n否、違うか、\n君等は常に、\n何者に対しても上位に立ち続けるべく、\nそう在りたいのだから、」","「曾经嗤之以鼻的吗？[l]\n漫长岁月后突然改变信条……[l]\n不、不对，\n你们始终渴望着，\n对任何存在都保持绝对上位，\n永远维持这般姿态吧，」"],["「あー？」","「哈啊？」"],["「そもそも敵味方上下は関係ないんだね。[l]\n狩人と獲物、絶対的な立ち位置、\nそれを保持した前提での……[l]\nあとはスキかキライか、[l]\n──自己完結してる分には、\n僕も何も言うつもりは無いけれど、\n他者に対して我を通そうというのなら、[l]\n……まあ、何があったか知らないけれど、[l]\n僕も僕の","「看来敌我上下都无所谓呢。[l]\n猎人与猎物，绝对的立场，\n在维持这个前提的基础上……[l]\n剩下的只是喜好问题，[l]\n──若是自我满足倒也罢，\n我本不想多说什么，\n但若要将自我意志强加于人，[l]\n……虽然不知发生过什么，[l]\n我也只能"],["側の覚悟を以て、応じるしかないよ。[l]\nどうあれ最初は──我を張り合うしかないんだろうしね。[l]\nただ──」","以我方觉悟来应对了。[l]\n总之最初阶段──只能互相较劲吧。[l]\n不过──」"],["みぃーーーーーーーーーん……","咿咿咿咿咿咿咿咿咿咿……"],["「……今、僕は手心を加えられるような心境じゃ、[l]\nないよ。[l]\nそれでも、\nやるの？」","「……现在的我，可没有[l]\n手下留情的闲心。[l]\n即便如此，\n还要继续吗？」"],["「……ど、どうすんだ、この場合」","「……这、这种情况该怎么办」"],["「縛鎖も仮","「束缚锁链也暂"],["修","时"],["繕したて、[l]\nアイも居ない、[l]\n選択の余地なんて本来ならば──」","刚修补好的，[l]\n爱也不在、[l]\n本来就没有选择的余地──」"],["「……いーい覚悟じゃねーか、[l]\nすぐに後悔させてやら、」","「……饭饭觉悟不错嘛、[l]\n马上就会让你后悔的，」"],["「放っておいてくれないなら、\n貴女方を止めるしかないんだけど、\nいいのかな」","「如果不肯放过我的话、\n就只能阻止贵小姐了、\n这样可以吗」"],["「ちょ、まっ」","「等、等等」"],["ばちん。","啪嚓。"],["「──」",""],["ぺたん。","啪嗒。"],["「──ってあ、[l]\n返事を聞く前だったのに……[l]\nミスった」","「──啊咧、[l]\n明明还没听到回答……[l]\n失手了」"],["「あっ？？！[l]\nおま、\nなっ、なにしやがっ」","「啊？？！[l]\n你这、\n干、干什么啊」"],["「ごめん、暴発しちゃった。[l]\nでもまあ……大した出力じゃなかったし、[l]\n廃になる程深刻じゃないかな、多分。[l]\nんー、\n封紙をしてる間はないから、\nＣＡＴは放っておくけど、\nもう邪魔しないでほしい、\nそして、\n言っておくけど」","「抱歉，走火了。[l]\n不过嘛……输出功率也不大、[l]\n应该不至于报废那么严重吧，大概。[l]\n嗯ー、\n没时间贴封条了、\nCAT就放着不管、\n希望别再妨碍我、\n还有、\n事先声明」"],["「──っ？！？」","「──哈？！？」"],["「苛ついてるのは、\nこっちも同じだって事──[l]\n他人の心なんか絶対に分かることはないけれど……[l]\nそれでも、\n想像する努力はした方がいいと、思うよ。[l]\n無知の知か……[l]\nあらゆるミカタを得た上で、\n多面を視てなお、貫かんとするならば、\n反作用の覚悟も必要故に、\n開き直るのも時と場合を選んだ方が──賢明だ」","「烦躁的心情、\n这边也是一样的──[l]\n虽然绝对无法理解他人的心思……[l]\n即便如此、\n我觉得努力去想象会比较好。[l]\n无知之知吗……[l]\n在获得所有视角之后、\n若仍要贯彻己见、\n就必须做好反作用的觉悟、\n破罐破摔也要选对时机场合──才够明智」"],["「あああ、ううう、」","「啊啊啊，呜呜呜、」"],["しーん……","寂静……"],["「………」",""],["「君も言ってたようにさ、\nタスク実行中に邪魔が入るのって、\nイヤだろ？[l]\n精神衛生上宜しくないし……[l]\n……ああ、でも、[l]\n君等の御陰で、\nいい緊張","「就像你说的、\n执行任务时被打扰、\n很讨厌吧？[l]\n对精神健康也不好……[l]\n……啊，不过、[l]\n托你们的福、\n紧绷的神经"],["解しにはなったよ、\nその点は──[l]ありがとう」","倒是放松下来了、\n这点──[l]多谢了」"],["「──さて、\n何かが引っ掛かるけど……[l]\n兎に角、\nあのひとのところに行かなきゃ」","「──那么、\n虽然有些在意的事……[l]\n总之、\n必须去那个人那里」"],["みゅいーーーーーーん。","咻咻咻咻咻咻。"],["「………、[l]\n………、[l]\n………っくしょうっ、」","「………、[l]\n………、[l]\n………可恶、」"],["ざわ……","沙沙……"],["ざわざわ……","嘈杂……"],["──がさり。","──沙啦。"],["「──おや、\nあれに行き逢ったのですか、\nどれ……」","「──哎呀、\n遇到那个了吗、\n哪个……」"],["「──ぅ、あ」","「──呜、啊」"],["「──……」",""],["「………あれも慈悲深いこと、[l]\n眼眩まし程度で済ませていった上、\nＣＡＴも手つかず……[l]\nとは言え、\n当分は使い物にならないでしょうけれどね、\nほら、しゃんとなさい」","「………那家伙也算慈悲为怀，[l]\n只是弄晕了事，\n连CAT都没碰……[l]\n不过，\n短期内应该派不上用场了吧，\n来，振作点」"],["「──っはっ、げほっ、がはっ」","「──哈、咳咳、嘎哈」"],["「──……うっ、ごほ」","「──……呜、咳咳」"],["「……っ、の野郎、……」","「……靠、混蛋……」"],["「……ぐ、ぐぅぅ、あああっ」","「……呜、呜呜呜、啊啊啊」"],["「そうそう、[l]\n貴女は、[l]\n別ですよEnder。[l]\nああ、……そのような為体でも案ずる事はありません。[l]\nそのためのLinkableForm、\n","「对对，[l]\n你呀，[l]\n是例外哦Ender。[l]\n啊……这副模样也不必担心。[l]\n为此准备的LinkableForm，\n"],["台","要"],["本通りに劇が進んでくれれば──\n出番はすぐに来てしまいますからね」","只要剧情按计划推进──\n马上就会轮到你的戏份了」"]],"context":[["SC_M_072.ks/index/1/text"],["SC_M_072.ks/index/3/text"],["SC_M_072.ks/index/5/text"],["SC_M_072.ks/index/7/text"],["SC_M_072.ks/index/9/text"],["SC_M_072.ks/index/11/text"],["SC_M_072.ks/index/13/text"],["SC_M_072.ks/index/15/text"],["SC_M_072.ks/index/17/text"],["SC_M_072.ks/index/19/text"],["SC_M_072.ks/index/21/text"],["SC_M_072.ks/index/23/text"],["SC_M_072.ks/index/25/text"],["SC_M_072.ks/index/27/text"],["SC_M_072.ks/index/29/text"],["SC_M_072.ks/index/31/text"],["SC_M_072.ks/index/33/text"],["SC_M_072.ks/index/35/text"],["SC_M_072.ks/index/37/text"],["SC_M_072.ks/index/39/text"],["SC_M_072.ks/index/41/text"],["SC_M_072.ks/index/43/text"],["SC_M_072.ks/index/45/text"],["SC_M_072.ks/index/47/text"],["SC_M_072.ks/index/49/text"],["SC_M_072.ks/index/51/text"],["SC_M_072.ks/index/53/text"],["SC_M_072.ks/index/55/text"],["SC_M_072.ks/index/57/text"],["SC_M_072.ks/index/59/text"],["SC_M_072.ks/index/61/text"],["SC_M_072.ks/index/63/text"],["SC_M_072.ks/index/65/text"],["SC_M_072.ks/index/67/text"],["SC_M_072.ks/index/69/text"],["SC_M_072.ks/index/71/text"],["SC_M_072.ks/index/73/text"],["SC_M_072.ks/index/75/text"],["SC_M_072.ks/index/77/text"],["SC_M_072.ks/index/79/text"],["SC_M_072.ks/index/81/text"],["SC_M_072.ks/index/83/text"],["SC_M_072.ks/index/85/text"],["SC_M_072.ks/index/87/text"],["SC_M_072.ks/index/89/text"],["SC_M_072.ks/index/91/text"],["SC_M_072.ks/index/93/text"],["SC_M_072.ks/index/95/te