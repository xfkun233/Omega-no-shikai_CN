;SubT『あなにえや』
*SC_waf_007|『あなにえや』
@sub_title img=SC_waf_007
@name_no ;　名前欄消去
@mes_all
@clickskip enabled=flase
@playbgm storage=m10 loop=no
@img_bg_trans img=img_bg_b
@staffrollinit
@font size=20

@staffrolltext x=100 y=500 text="──ナルデアナ・ドルミナ、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="銀眼銀髪の男に救われ、生涯彼を追い求めた魔の女、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="くろきひとみの女性。"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="始まりの『雫』、"
@staffrolltext x=100 y=50 text="波紋を呼び起こし、アリスのねこ喚び降ろし、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="うたうたい、オトをヨむに長け、"
@staffrolltext x=100 y=50 text="ミャアイにアイされたつきのもうしご──"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="いまは、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="すべてはカきシルされてカミにホウじられている。"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="蚕のように、猫に守られ繭に包まれ、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="Luna、Duo、I、狼の子、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="朔望と策謀のエンにヒかれて、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="鬼の頭に刀用いてヨみガエれ、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="丑、虎、兎、蛙、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="そして猫、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="ツキモノのオサ、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="カるもののおさが、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="ハモンをまつハコニワの門ひらかれる。"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="金髪碧眼の裔、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="タケきトリのヒメ、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="黒雲の奥、日の出の閃光、"
@staffrolltext x=100 y=50 text="明だろうと暗だろうと、"
@staffrolltext x=100 y=50 text="視界をサエギるものであるぞ、"
@staffrolltext x=100 y=50 text="こころしたまえ、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="それでもなお、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="金白銀黒のヤクは揺らぎつづけてコンセキはコトナるもの。"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="空虚枯殻骸故辛狩仮"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="　　　『〜』"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="幕間の幕間──ＣＯＬＯＲ、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="さて色を失うや、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="すなわち白　透と　黒より冥いつきづきが、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="オーづメをもとめんとまうのです。"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="いずれガブリとオトがして──"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="う　ひひ、"
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text=""
@staffrolltext x=100 y=50 text="……美哉。"

@staffrollstart height=6000 time=170000

@wait time=5000
@img_bg_trans img=vis__col_018 time=1000

@wait time=148000

@staffrolluninit

@waitclick

;了

@eval exp="sf.SC_waf_007=1"
@jump storage="first_color.ks"



